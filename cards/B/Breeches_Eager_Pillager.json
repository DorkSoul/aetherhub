{
  "name": "Breeches, Eager Pillager",
  "mana_cost": "{2}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Goblin", "Pirate"],
  "power": 3,
  "toughness": 3,
  "keywords": ["FirstStrike"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "subtypes": ["Pirate"], "controller": "You" } },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "once_each_turn": true,
          "modes": [
            {
              "text": "Create a Treasure token.",
              "effects": [ { "type": "CreateToken", "token": "Treasure", "n": { "type": "Fixed", "n": 1 } } ]
            },
            {
              "text": "Target creature can't block this turn.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [
                    { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
                  ],
                  "effects": [
                    { "type": "GrantKeyword", "keyword": "CantBlock", "duration": "UntilEndOfTurn", "what": { "type": "Target", "idx": 0 } }
                  ]
                }
              ]
            },
            {
              "text": "Exile the top card of your library. You may play it this turn.",
              "effects": [
                {
                  "type": "LookAtTop",
                  "who": { "type": "You" },
                  "n": { "type": "Fixed", "n": 1 },
                  "take": 1,
                  "all": true,
                  "filter": {},
                  "to": "Exile",
                  "rest": "Library"
                },
                { "type": "GrantPlayFromExile", "what": { "type": "Remembered" }, "window": "ThisTurn" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "First strike\nWhenever a Pirate you control attacks, choose one that hasn't been chosen this turn —\n• Create a Treasure token.\n• Target creature can't block this turn.\n• Exile the top card of your library. You may play it this turn."
}
