{
  "name": "Break the Spell",
  "mana_cost": "{W}",
  "types": ["Instant"],
  "abilities": [
    { "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Enchantment"] } }, "min": 1, "max": 1 } ],
      "effects": [
        { "type": "If",
          "cond": { "type": "AnyOf", "cs": [
            { "type": "TargetIs", "idx": 0, "filter": { "controller": "You" } },
            { "type": "TargetIs", "idx": 0, "filter": { "token": true } }
          ] },
          "then": [
            { "type": "Destroy", "what": { "type": "Target", "idx": 0 }, "remember": true },
            { "type": "If",
              "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Ge", "n": 1 } },
              "then": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ],
              "else": [] }
          ],
          "else": [ { "type": "Destroy", "what": { "type": "Target", "idx": 0 } } ]
        }
      ] }
  ],
  "oracle_text": "Destroy target enchantment. If a permanent you controlled or a token was destroyed this way, draw a card."
}
