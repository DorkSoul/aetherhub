{
  "name": "Boros Fury-Shield",
  "mana_cost": "{2}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "any_of": [ { "attacking": true }, { "blocking": true } ] } }, "label": "target attacking or blocking creature" }
      ],
      "effects": [
        { "type": "PreventDamage", "from": { "type": "Target", "idx": 0 }, "combat_only": true },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "R" }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [
            { "type": "DealDamage", "source": { "type": "This" }, "to": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "amount": { "type": "PowerOf", "of": { "type": "Target", "idx": 0 } } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Prevent all combat damage that would be dealt by target attacking or blocking creature this turn. If {R} was spent to cast this spell, Boros Fury-Shield deals damage to that creature's controller equal to the creature's power."
}
