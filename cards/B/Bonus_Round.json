{
  "name": "Bonus Round",
  "mana_cost": "{1}{R}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "AddTrigger",
          "trigger": { "type": "SpellCast", "by": "Any", "filter": { "types": ["Instant", "Sorcery"] } },
          "until": "EndOfTurn",
          "effects": [
            {
              "type": "CopySpell",
              "what": { "type": "TriggerSource" },
              "new_targets": true,
              "by": { "type": "TriggerPlayer" }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Until end of turn, whenever a player casts an instant or sorcery spell, that player copies it and may choose new targets for the copy."
}
