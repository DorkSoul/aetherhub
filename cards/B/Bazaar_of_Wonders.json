{
  "name": "Bazaar of Wonders",
  "mana_cost": "{3}{U}{U}",
  "supertypes": ["World"],
  "types": ["Enchantment"],
  "colors": ["U"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Move", "what": { "type": "AllOfPlayer", "player": { "type": "EachPlayer" }, "zone": "Graveyard", "filter": {} }, "to": "Exile" }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "filter": {}, "by": "Any" },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "AnyOf",
            "cs": [
              {
                "type": "Compare",
                "a": { "type": "Count", "zone": "Graveyard", "filter": { "same_name_as": { "type": "TriggerObject" } } },
                "cmp": { "op": "Ge", "n": 1 }
              },
              {
                "type": "Compare",
                "a": { "type": "Count", "filter": { "token": false, "same_name_as": { "type": "TriggerObject" } } },
                "cmp": { "op": "Ge", "n": 1 }
              }
            ]
          },
          "then": [ { "type": "CounterSpell", "what": { "type": "TriggerObject" } } ]
        }
      ]
    }
  ],
  "oracle_text": "When this enchantment enters, exile all graveyards.\nWhenever a player casts a spell, counter it if a card with the same name is in a graveyard or a nontoken permanent with the same name is on the battlefield."
