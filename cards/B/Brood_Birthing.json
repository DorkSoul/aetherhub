{
  "name": "Brood Birthing",
  "mana_cost": "{1}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "who": { "type": "You" },
            "at_least": 1,
            "filter": { "subtypes": ["Eldrazi", "Spawn"], "controller": "You" }
          },
          "then": [{ "type": "CreateToken", "token": "Eldrazi Spawn", "n": { "type": "Fixed", "n": 3 } }],
          "else": [{ "type": "CreateToken", "token": "Eldrazi Spawn", "n": { "type": "Fixed", "n": 1 } }]
        }
      ]
    }
  ],
  "oracle_text": "If you control an Eldrazi Spawn, create three 0/1 colorless Eldrazi Spawn creature tokens. They have \"Sacrifice this token: Add {C}.\" Otherwise, create one of those tokens."
}
