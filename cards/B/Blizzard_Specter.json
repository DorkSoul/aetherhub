{
  "name": "Blizzard Specter",
  "mana_cost": "{2}{U}{B}",
  "types": ["Creature"],
  "supertypes": ["Snow"],
  "subtypes": ["Specter"],
  "power": 2,
  "toughness": 3,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "CombatDamageToPlayer", "filter": { "this": true } },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "modes": [
            {
              "text": "That player returns a permanent they control to its owner's hand.",
              "effects": [
                {
                  "type": "Choose",
                  "who": { "type": "TriggerPlayer" },
                  "zone": "Battlefield",
                  "filter": { "controller": "You" },
                  "min": 1,
                  "max": 1,
                  "then": [ { "type": "Bounce", "what": { "type": "Remembered" } } ]
                }
              ]
            },
            {
              "text": "That player discards a card.",
              "effects": [
                { "type": "Discard", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhenever this creature deals combat damage to a player, choose one —\n• That player returns a permanent they control to its owner's hand.\n• That player discards a card."
}
