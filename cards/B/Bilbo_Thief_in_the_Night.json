{
  "name": "Bilbo, Thief in the Night",
  "mana_cost": "{1}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Halfling", "Rogue"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Static",
      "effect": { "type": "CostChange", "filter": {}, "whose": "You", "generic": -1, "not_from": "Hand" }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "any_of": [ { "types": ["Artifact"] }, { "types": ["Instant"] }, { "types": ["Sorcery"] } ] },
          "min": 0,
          "max": 1,
          "then": [
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "types": ["Artifact"] } },
              "then": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": true, "pay": true } ],
              "else": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": true, "pay": true, "exile_after": true } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Spells you cast from anywhere other than your hand cost {1} less to cast.\nWhenever Bilbo attacks, you may cast an artifact, instant, or sorcery spell from your graveyard. If an instant or sorcery spell cast this way would be put into your graveyard, exile it instead."
}
