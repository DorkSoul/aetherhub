{
  "name": "Boggart Mischief",
  "mana_cost": "{2}{B}",
  "types": ["Enchantment", "Kindred"],
  "subtypes": ["Goblin"],
  "colors": ["B"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "filter": { "types": ["Creature"], "controller": "You" },
          "min": 1,
          "max": 1,
          "then": [
            { "type": "AddCounters", "what": { "type": "Remembered" }, "kind": "MinusOneMinusOne", "n": { "type": "Fixed", "n": 1 } },
            { "type": "CreateToken", "token": "Goblin 1-1 Black Red", "n": { "type": "Fixed", "n": 2 } }
          ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "types": ["Creature"], "subtypes": ["Goblin"], "controller": "You" } },
      "effects": [
        { "type": "LoseLife", "who": { "type": "EachOpponent" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
      ]
    }
  ],
  "oracle_text": "When this enchantment enters, you may blight 1. If you do, create two 1/1 black and red Goblin creature tokens. (To blight 1, put a -1/-1 counter on a creature you control.)\nWhenever a Goblin creature you control dies, each opponent loses 1 life and you gain 1 life."
}
