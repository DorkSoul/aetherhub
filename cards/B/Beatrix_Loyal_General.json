{
  "name": "Beatrix, Loyal General",
  "mana_cost": "{4}{W}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Soldier"],
  "power": 4,
  "toughness": 4,
  "keywords": ["Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat", "whose": "You" },
      "optional": true,
      "targets": [{ "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "min": 1, "max": 1, "label": "target creature you control" }],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "filter": { "subtypes": ["Equipment"], "controller": "You" },
          "min": 0,
          "max": 99,
          "then": [
            {
              "type": "ForEach",
              "objects": { "type": "Remembered" },
              "effects": [{ "type": "Attach", "what": { "type": "Remembered" }, "to": { "type": "Target", "idx": 0 } }]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Vigilance (Attacking doesn't cause this creature to tap.)\nAt the beginning of combat on your turn, you may attach any number of Equipment you control to target creature you control."
