{
  "name": "Borderland Explorer",
  "mana_cost": "{1}{G}",
  "types": ["Creature"],
  "subtypes": ["Elf", "Scout"],
  "power": 3,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "EntersBattlefield",
        "filter": { "this": true }
      },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "EachPlayer" },
          "effects": [
            {
              "type": "May",
              "who": { "type": "EachObject" },
              "effects": [
                {
                  "type": "Discard",
                  "who": { "type": "EachObject" },
                  "n": { "type": "Fixed", "n": 1 }
                },
                {
                  "type": "If",
                  "cond": {
                    "type": "Compare",
                    "a": { "type": "RememberedCount" },
                    "cmp": { "op": "Ge", "n": 1 }
                  },
                  "then": [
                    {
                      "type": "SearchLibrary",
                      "who": { "type": "EachObject" },
                      "filter": {
                        "types": ["Land"],
                        "supertypes": ["Basic"]
                      },
                      "n": { "type": "Fixed", "n": 1 },
                      "to": "Hand"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When Borderland Explorer enters, each player may discard a card. Each player who discarded a card this way may search their library for a basic land card, reveal it, put it into their hand, then shuffle."
}
