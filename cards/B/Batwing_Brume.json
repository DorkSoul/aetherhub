{
  "name": "Batwing Brume",
  "mana_cost": "{1}{W/B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "W" }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [ { "type": "PreventDamage", "combat_only": true } ]
        },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "B" }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [
            {
              "type": "ForEach",
              "objects": { "type": "EachPlayer" },
              "effects": [
                {
                  "type": "LoseLife",
                  "who": { "type": "EachObject" },
                  "n": { "type": "Count", "filter": { "types": ["Creature"], "attacking": true }, "zone": "Battlefield", "player": { "type": "EachObject" } }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Prevent all combat damage that would be dealt this turn if {W} was spent to cast this spell. Each player loses 1 life for each attacking creature they control if {B} was spent to cast this spell. (Do both if {W}{B} was spent.)"
}
