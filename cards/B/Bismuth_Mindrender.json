{
  "name": "Bismuth Mindrender",
  "mana_cost": "{3}{B}",
  "types": ["Creature"],
  "subtypes": ["Eldrazi"],
  "power": 4,
  "toughness": 3,
  "keywords": ["Menace"],
  "abilities": [
    {
      "type": "Static",
      "effect": { "type": "SetColors", "affects": { "this": true }, "colors": [] }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "CombatDamageToPlayer", "filter": { "this": true } },
      "effects": [
        {
          "type": "RevealUntil",
          "who": { "type": "TriggerPlayer" },
          "filter": { "not_types": ["Land"] },
          "to": "Exile",
          "rest": "Exile"
        },
        {
          "type": "May",
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "Compare",
                "a": {
                  "type": "Minus",
                  "a": { "type": "LifeOf", "who": { "type": "You" } },
                  "b": { "type": "ManaValueOf", "of": { "type": "Remembered" } }
                },
                "cmp": { "op": "Ge", "n": 0 }
              },
              "then": [
                { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "ManaValueOf", "of": { "type": "Remembered" } } },
                { "type": "CastFree", "what": { "type": "Remembered" }, "may": false }
              ],
              "else": []
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Devoid (This card has no color.)\nMenace\nWhenever Bismuth Mindrender deals combat damage to a player, that player exiles cards from the top of their library until they exile a nonland card. You may cast that card by paying life equal to the spell's mana value rather than paying its mana cost."
}
