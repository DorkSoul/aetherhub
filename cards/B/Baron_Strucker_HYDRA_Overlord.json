      "optional": true,
      "once_per_turn": true,
      "effects": [
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Discard", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "ForEach",
          "objects": { "type": "Remembered" },
          "effects": [
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "not_types": ["Land"] } },
