{
  "name": "Battlefield Improvisation",
  "mana_cost": "{1}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature", "min": 1, "max": 1 } ],
      "effects": [
        { "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": 2 }, "toughness": { "type": "Fixed", "n": 2 }, "duration": "UntilEndOfTurn" },
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "attacking": true } },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Battlefield",
              "filter": { "subtypes": ["Equipment"], "controller": "You" },
              "min": 0,
              "max": 99,
              "then": [ { "type": "Attach", "what": { "type": "Remembered" }, "to": { "type": "Target", "idx": 0 } } ]
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Target creature gets +2/+2 until end of turn. If that creature is attacking, you may attach any number of Equipment you control to it."
}
