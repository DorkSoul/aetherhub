{
  "name": "Blood Money",
  "mana_cost": "{5}{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Destroy",
          "what": { "type": "All", "filter": { "types": ["Creature"] } },
          "remember": true
        },
        {
          "type": "ForEach",
          "objects": { "type": "Remembered" },
          "effects": [
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "token": false } },
              "then": [
                { "type": "CreateToken", "token": "Treasure", "n": { "type": "Fixed", "n": 1 }, "tapped": true }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Destroy all creatures. For each nontoken creature destroyed this way, you create a tapped Treasure token."
}
