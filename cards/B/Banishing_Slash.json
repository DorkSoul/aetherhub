{
  "name": "Banishing Slash",
  "mana_cost": "{W}{W}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": {
              "any_of": [
                { "types": ["Artifact"] },
                { "types": ["Enchantment"] },
                { "types": ["Creature"], "tapped": true }
              ]
            }
          },
          "min": 0,
          "max": 1,
          "label": "up to one target artifact, enchantment, or tapped creature"
        }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": {
            "type": "All",
            "cs": [
              { "type": "Control", "at_least": 1, "filter": { "types": ["Artifact"] }, "who": { "type": "You" } },
              { "type": "Control", "at_least": 1, "filter": { "types": ["Enchantment"] }, "who": { "type": "You" } }
            ]
          },
          "then": [ { "type": "CreateToken", "token": "Samurai 2-2 Vigilance" } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Destroy up to one target artifact, enchantment, or tapped creature. Then if you control an artifact and an enchantment, create a 2/2 white Samurai creature token with vigilance."
}
