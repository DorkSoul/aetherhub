{
  "name": "Bloodchief Ascension",
  "mana_cost": "{B}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "Any" },
      "optional": true,
      "condition": {
        "type": "ForSomePlayer",
        "who": { "type": "EachOpponent" },
        "cond": {
          "type": "Compare",
          "a": { "type": "LifeLostThisTurn", "who": { "type": "You" } },
          "cmp": { "op": "Ge", "n": 2 }
        }
      },
      "effects": [{ "type": "AddCounters", "what": { "type": "This" }, "kind": "Quest", "n": { "type": "Fixed", "n": 1 } }]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "ChangesZone",
        "filter": { "owner": "Opponent", "token": false },
        "from": null,
        "to": "Graveyard"
      },
      "optional": true,
      "condition": {
        "type": "Compare",
        "a": { "type": "CountersOn", "kind": "Quest", "of": { "type": "This" } },
        "cmp": { "op": "Ge", "n": 3 }
      },
      "effects": [
        { "type": "LoseLife", "who": { "type": "OwnerOf", "of": { "type": "TriggerObject" } }, "n": { "type": "Fixed", "n": 2 } },
        { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } }
      ]
    }
  ],
  "oracle_text": "At the beginning of each end step, if an opponent lost 2 or more life this turn, you may put a quest counter on this enchantment. (Damage causes loss of life.)\nWhenever a card is put into an opponent's graveyard from anywhere, if this enchantment has three or more quest counters on it, you may have that player lose 2 life. If you do, you gain 2 life."
}
