{
  "name": "Barrin's Spite",
  "mana_cost": "{2}{U}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "first target creature" },
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controlled_by": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } } } }, "label": "second target creature controlled by the same player", "distinct": true }
      ],
      "effects": [
        { "type": "If",
          "cond": { "type": "All", "cs": [
            { "type": "TargetIs", "idx": 0, "filter": { "types": ["Creature"] } },
            { "type": "TargetIs", "idx": 1, "filter": { "types": ["Creature"] } } ] },
          "then": [
            { "type": "May", "who": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } },
              "effects": [
                { "type": "Sacrifice", "who": { "type": "Target", "idx": 0 } },
                { "type": "Bounce", "what": { "type": "Target", "idx": 1 } } ],
              "otherwise": [
                { "type": "Sacrifice", "who": { "type": "Target", "idx": 1 } },
                { "type": "Bounce", "what": { "type": "Target", "idx": 0 } } ] }
          ],
          "else": [ { "type": "Sacrifice", "who": { "type": "Targets" } } ] }
      ]
    }
  ],
  "oracle_text": "Choose two target creatures controlled by the same player. Their controller chooses and sacrifices one of them. Return the other to its owner's hand."
}
