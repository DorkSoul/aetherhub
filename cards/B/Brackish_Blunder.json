{
  "name": "Brackish Blunder",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "label": "target creature"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "tapped": true } },
          "then": [
            { "type": "CreateToken", "token": "Map", "n": { "type": "Fixed", "n": 1 } }
          ]
        },
        { "type": "Bounce", "what": { "type": "Target", "idx": 0 } }
      ]
    }
  ],
  "oracle_text": "Return target creature to its owner's hand. If it was tapped, create a Map token. (It's an artifact with \"{1}, {T}, Sacrifice this token: Target creature you control explores. Activate only as a sorcery.\")"
}
