{
  "name": "Breathstealer's Crypt",
  "mana_cost": "{2}{U}{B}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "Draw",
        "who": "Any",
        "instead": [
          {
            "type": "RevealUntil",
            "who": { "type": "TriggerPlayer" },
            "filter": {},
            "count": { "type": "Fixed", "n": 1 },
            "to": "Hand",
            "rest": "Library"
          },
          {
            "type": "If",
            "cond": {
              "type": "RememberedIs",
              "filter": { "types": ["Creature"] }
            },
            "then": [
              {
                "type": "Unless",
                "payer": { "type": "TriggerPlayer" },
                "cost": [{ "type": "PayLife", "n": 3 }],
                "effects": [
                  {
                    "type": "Move",
                    "what": { "type": "Remembered" },
                    "from": "Hand",
                    "to": "Graveyard",
                    "discard": true
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "oracle_text": "If a player would draw a card, instead they draw a card and reveal it. If it's a creature card, that player discards it unless they pay 3 life."
}
