{
  "name": "Galadriel of Lothlórien",
  "mana_cost": "{1}{G}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Elf", "Noble"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "RingTempts", "who": "You" },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "SelIs",
            "what": { "type": "RingBearer" },
            "filter": { "other": true }
          },
          "then": [
            { "type": "Scry", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } }
          ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Scried", "who": "You", "surveil": false },
      "effects": [
        {
          "type": "May",
          "effects": [
            { "type": "RevealTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
            {
              "type": "If",
              "cond": {
                "type": "SelIs",
                "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 },
                "filter": { "types": ["Land"] }
              },
              "then": [
                {
                  "type": "Move",
                  "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 },
                  "to": "Battlefield",
                  "tapped": true
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever the Ring tempts you, if you chose a creature other than Galadriel as your Ring-bearer, scry 3.\nWhenever you scry, you may reveal the top card of your library. If a land card is revealed this way, put it onto the battlefield tapped."
}
