{
  "name": "Grave Researcher // Reanimate",
  "mana_cost": "{2}{B}",
  "types": ["Creature"],
  "subtypes": ["Troll", "Warlock"],
  "power": 3,
  "toughness": 3,
  "layout": "Prepare",
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "You" },
      "effects": [
        { "type": "Surveil", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "Count", "filter": { "types": ["Creature"] }, "zone": "Graveyard", "player": { "type": "You" } },
            "cmp": { "op": "Ge", "n": 3 }
          },
          "then": [ { "type": "BecomePrepared", "what": { "type": "This" } } ],
          "else": []
        }
      ]
    }
