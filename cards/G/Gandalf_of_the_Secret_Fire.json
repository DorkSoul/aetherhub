{
  "name": "Gandalf of the Secret Fire",
  "mana_cost": "{1}{U}{R}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Avatar", "Wizard"],
  "colors": ["R", "U", "W"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": { "types": ["Instant", "Sorcery"], "cast_from": "Hand" }
      },
      "condition": { "type": "OpponentsTurn" },
      "effects": [
        {
          "type": "AddReplacement",
          "what": {
            "type": "ZoneChange",
            "from": "Stack",
            "to": "Graveyard",
            "instead": "Exile",
            "bind_to": { "type": "TriggerObject" },
            "once": true,
            "on_resolve": true,
            "then": [
              { "type": "Remember", "what": { "type": "TriggerObject" } },
              { "type": "AddCounters", "kind": "Time", "n": { "type": "Fixed", "n": 3 }, "what": { "type": "Remembered" } },
              {
                "type": "If",
                "cond": {
                  "type": "Not",
                  "c": { "type": "SelIs", "what": { "type": "Remembered" }, "filter": { "has_keyword_word": "Suspend" } }
                },
                "then": [ { "type": "GrantSuspend", "what": { "type": "Remembered" } } ]
              }
            ]
          }
        }
      ]
    }
  ],
  "oracle_text": "Whenever you cast an instant or sorcery spell from your hand during an opponent's turn, exile that card with three time counters on it instead of putting it into your graveyard as it resolves. Then if the exiled card doesn't have suspend, it gains suspend. (At the beginning of your upkeep, remove a time counter from that card. When the last is removed, you may play it without paying its mana cost.)"
}
