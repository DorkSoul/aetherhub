{
  "name": "Galvanize",
  "mana_cost": "{1}{R}",
  "types": ["Instant"],
  "colors": ["R"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "CardsDrawnThisTurn", "who": { "type": "You" } },
            "cmp": { "n": 2, "op": "Ge" }
          },
          "then": [
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 5 }, "to": { "type": "Target", "idx": 0 } }
          ],
          "else": [
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 3 }, "to": { "type": "Target", "idx": 0 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Galvanize deals 3 damage to target creature. If you've drawn two or more cards this turn, Galvanize deals 5 damage to that creature instead."
