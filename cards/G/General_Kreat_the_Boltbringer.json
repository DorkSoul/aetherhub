{
  "name": "General Kreat, the Boltbringer",
  "mana_cost": "{2}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Goblin", "Soldier"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "Attacks",
        "filter": { "subtypes": ["Goblin"], "controller": "You" },
        "batched": true, "one_per_declaration": true
      },
      "effects": [
        {
          "type": "CreateToken",
          "token": "Goblin",
          "controller": { "type": "You" },
          "tapped": true,
          "attacking": true
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "EntersBattlefield",
        "filter": { "types": ["Creature"], "controller": "You", "other": true }
      },
      "effects": [
        {
          "type": "DealDamage",
          "to": { "type": "EachOpponent" },
          "amount": { "type": "Fixed", "n": 1 }
        }
      ]
    }
  ],
  "oracle_text": "Whenever one or more Goblins you control attack, create a 1/1 red Goblin creature token that's tapped and attacking.\nWhenever another creature you control enters, General Kreat deals 1 damage to each opponent."
}
