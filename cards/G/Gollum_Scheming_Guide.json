{
  "name": "Gollum, Scheming Guide",
  "mana_cost": "{1}{B}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Halfling", "Horror"],
  "power": 2,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        { "type": "RearrangeTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } },
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "modes": [
            { "text": "Choose land.", "effects": [ { "type": "AddCounters", "what": { "type": "This" }, "kind": "Marker", "n": { "type": "Fixed", "n": 1 } } ] },
            { "text": "Choose nonland.", "effects": [ { "type": "AddCounters", "what": { "type": "This" }, "kind": "Glyph", "n": { "type": "Fixed", "n": 1 } } ] }
          ]
        },
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "chooser": { "type": "EachOpponent" },
          "modes": [
            {
              "text": "Guess the top card is the chosen kind.",
              "effects": [
                {
                  "type": "If",
                  "cond": {
                    "type": "AnyOf",
                    "cs": [
                      { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Marker", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "types": ["Land"] } } ] },
                      { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Glyph", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "not_types": ["Land"] } } ] }
                    ]
                  },
                  "then": [ { "type": "RemoveFromCombat", "what": { "type": "This" } } ],
                  "else": []
                },
                {
                  "type": "If",
                  "cond": {
                    "type": "Not",
                    "c": {
                      "type": "AnyOf",
                      "cs": [
                        { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Marker", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "types": ["Land"] } } ] },
                        { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Glyph", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "not_types": ["Land"] } } ] }
                      ]
                    }
                  },
                  "then": [
                    { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
                    { "type": "GrantKeyword", "what": { "type": "This" }, "keyword": "Unblockable", "duration": "UntilEndOfTurn" }
                  ],
                  "else": []
                }
              ]
            },
            {
              "text": "Guess the top card is not the chosen kind.",
              "effects": [
                {
                  "type": "If",
                  "cond": {
                    "type": "AnyOf",
                    "cs": [
                      { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Marker", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "not_types": ["Land"] } } ] },
                      { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Glyph", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "types": ["Land"] } } ] }
                    ]
                  },
                  "then": [ { "type": "RemoveFromCombat", "what": { "type": "This" } } ],
                  "else": []
                },
                {
                  "type": "If",
                  "cond": {
                    "type": "Not",
                    "c": {
                      "type": "AnyOf",
                      "cs": [
                        { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Marker", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "not_types": ["Land"] } } ] },
                        { "type": "All", "cs": [ { "type": "SourceHasCounter", "kind": "Glyph", "at_least": 1 }, { "type": "SelIs", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "filter": { "types": ["Land"] } } ] }
                      ]
                    }
                  },
                  "then": [
                    { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
                    { "type": "GrantKeyword", "what": { "type": "This" }, "keyword": "Unblockable", "duration": "UntilEndOfTurn" }
                  ],
                  "else": []
                }
              ]
            }
          ]
        },
        { "type": "RemoveCounters", "kind": "Marker", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "This" } },
        { "type": "RemoveCounters", "kind": "Glyph", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "This" } }
      ]
    }
  ],
  "oracle_text": "Whenever Gollum, Scheming Guide attacks, look at the top two cards of your library, put them back in any order, then choose land or nonland. An opponent guesses whether the top card of your library is the chosen kind. Reveal that card. If they guessed right, remove Gollum from combat. Otherwise, you draw a card and Gollum can't be blocked this turn."
}
