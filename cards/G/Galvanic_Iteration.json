{
  "name": "Galvanic Iteration",
  "mana_cost": "{U}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "AddTrigger",
          "trigger": {
            "type": "SpellCast",
            "by": "You",
            "filter": { "any_of": [ { "types": ["Instant"] }, { "types": ["Sorcery"] } ] }
          },
          "effects": [ { "type": "CopySpell", "what": { "type": "TriggerObject" }, "new_targets": true } ],
          "once": true,
          "until": "EndOfTurn"
        }
      ]
    },
    {
      "type": "AlternativeCost",
      "cost": [ { "type": "Mana", "cost": "{1}{U}{R}" } ],
      "from": "Graveyard",
      "exile_after": true
    }
  ],
  "oracle_text": "When you next cast an instant or sorcery spell this turn, copy that spell. You may choose new targets for the copy.\nFlashback {1}{U}{R} (You may cast this card from your graveyard for its flashback cost. Then exile it.)"
}
