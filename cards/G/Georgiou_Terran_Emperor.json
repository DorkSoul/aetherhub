{
  "name": "Georgiou, Terran Emperor",
  "mana_cost": "{4}{B}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Rogue", "Noble"],
  "power": 4,
  "toughness": 6,
  "abilities": [
    { "type": "Static", "effect": { "type": "NoLoseAtZeroLife", "who": "You" } },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "effects": [
        { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } },
        { "type": "Draw", "who": { "type": "You" } },
        {
          "type": "If",
          "cond": { "type": "LifeAtMost", "n": 0, "who": { "type": "You" } },
          "then": [ { "type": "CreateToken", "token": "Officer", "n": { "type": "Fixed", "n": 10 }, "controller": { "type": "You" } } ]
        }
      ]
    }
  ],
  "oracle_text": "You don't lose the game for having 0 or less life.\nAt the beginning of your end step, you lose 3 life and draw a card. Then if your life total is 0 or less, create ten 1/1 red Officer creature tokens."
}
