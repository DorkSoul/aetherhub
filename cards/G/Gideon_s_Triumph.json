{
  "name": "Gideon's Triumph",
  "mana_cost": "{1}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Planeswalker"], "subtypes": ["Gideon"] }, "at_least": 1 },
          "then": [
            {
              "type": "Sacrifice",
              "who": { "type": "Target", "idx": 0 },
              "filter": { "any_of": [ { "types": ["Creature"], "attacked_this_turn": true }, { "types": ["Creature"], "blocked_this_turn": true } ] },
              "n": { "type": "Fixed", "n": 2 }
            }
          ],
          "else": [
            {
              "type": "Sacrifice",
              "who": { "type": "Target", "idx": 0 },
              "filter": { "any_of": [ { "types": ["Creature"], "attacked_this_turn": true }, { "types": ["Creature"], "blocked_this_turn": true } ] },
              "n": { "type": "Fixed", "n": 1 }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Target opponent sacrifices a creature of their choice that attacked or blocked this turn. If you control a Gideon planeswalker, that player sacrifices two of those creatures of their choice instead."
}
