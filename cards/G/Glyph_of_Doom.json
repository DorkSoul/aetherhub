{
  "name": "Glyph of Doom",
  "mana_cost": "{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "subtypes": ["Wall"] } },
          "label": "target Wall creature"
        }
      ],
      "effects": [
        { "type": "Remember", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "AddTrigger",
          "trigger": { "type": "EndOfCombat" },
          "once": true,
          "until": "EndOfTurn",
          "effects": [
            { "type": "StoreRemembered", "slot": 0 },
            { "type": "Destroy", "what": { "type": "All", "filter": { "types": ["Creature"], "blocked_by_stored": 0 }, "zone": "Battlefield" } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose target Wall creature. At this turn's next end of combat, destroy all creatures that were blocked by that creature this turn."
}
