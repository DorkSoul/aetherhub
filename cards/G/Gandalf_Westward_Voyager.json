{
  "name": "Gandalf, Westward Voyager",
  "mana_cost": "{3}{G}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Avatar", "Wizard"],
  "power": 5,
  "toughness": 5,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": { "mana_value": { "op": "Ge", "n": 5 } }
      },
      "effects": [
        { "type": "RevealTop", "who": { "type": "EachOpponent" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": {
              "type": "Count",
              "filter": {
                "among_remembered": true,
                "shares_card_type_with": { "type": "TriggerObject" }
              },
              "zone": "Library"
            },
            "cmp": { "op": "Ge", "n": 1 }
          },
          "then": [
            { "type": "CopySpell", "what": { "type": "TriggerObject" }, "new_targets": true },
            { "type": "Draw", "who": { "type": "EachOpponent" }, "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": [
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever you cast a spell with mana value 5 or greater, each opponent reveals the top card of their library. If any of those cards shares a card type with that spell, copy that spell, you may choose new targets for the copy, and each opponent draws a card. Otherwise, you draw a card. (A copy of a permanent spell becomes a token.)"
}
