{
  "name": "Graceful Takedown",
  "mana_cost": "{1}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } },
          "min": 1,
          "max": 1,
          "label": "target creature you don't control"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You", "enchanted": true } },
          "min": 0,
          "max": 255,
          "label": "any number of target enchanted creatures you control"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } },
          "min": 0,
          "max": 1,
          "distinct": true,
          "label": "up to one other target creature you control"
        }
      ],
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "Targets" },
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "SelIs",
                "what": { "type": "Remembered" },
                "filter": { "controller": "You", "types": ["Creature"] }
              },
              "then": [
                {
                  "type": "DealDamage",
                  "source": { "type": "Remembered" },
                  "amount": { "type": "PowerOf", "of": { "type": "Remembered" } },
                  "to": { "type": "Target", "idx": 0 }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Any number of target enchanted creatures you control and up to one other target creature you control each deal damage equal to their power to target creature you don't control."
}
