{
  "name": "Gandalf the Grey",
  "mana_cost": "{3}{U}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Avatar", "Wizard"],
  "colors": ["U", "R"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "You", "filter": { "types": ["Instant", "Sorcery"] } },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "once_ever": true,
          "modes": [
            {
              "text": "You may tap or untap target permanent.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [{ "what": { "type": "Permanent", "filter": {} }, "label": "target permanent" }],
                  "effects": [
                    {
                      "type": "ChooseModes",
                      "choose_min": 0,
                      "choose_max": 1,
                      "modes": [
                        { "text": "Tap it.", "effects": [{ "type": "Tap", "what": { "type": "Target", "idx": 0 } }] },
                        { "text": "Untap it.", "effects": [{ "type": "Untap", "what": { "type": "Target", "idx": 0 } }] }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "Gandalf deals 3 damage to each opponent.",
              "effects": [{ "type": "DealDamage", "to": { "type": "EachOpponent" }, "amount": { "type": "Fixed", "n": 3 } }]
            },
            {
              "text": "Copy target instant or sorcery spell you control. You may choose new targets for the copy.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [{ "what": { "type": "Spell", "filter": { "types": ["Instant", "Sorcery"], "controller": "You" } }, "label": "target instant or sorcery spell you control" }],
                  "effects": [{ "type": "CopySpell", "what": { "type": "Target", "idx": 0 }, "new_targets": true }]
                }
              ]
            },
            {
              "text": "Put Gandalf on top of its owner's library.",
              "effects": [{ "type": "Move", "what": { "type": "This" }, "to": "Library", "top_of_library": true }]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever you cast an instant or sorcery spell, choose one that hasn't been chosen —\n• You may tap or untap target permanent.\n• Gandalf deals 3 damage to each opponent.\n• Copy target instant or sorcery spell you control. You may choose new targets for the copy.\n• Put Gandalf on top of its owner's library."
}
