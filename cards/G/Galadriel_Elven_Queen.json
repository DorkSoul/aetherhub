{
  "name": "Galadriel, Elven-Queen",
  "mana_cost": "{2}{G}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Elf", "Noble"],
  "colors": ["G", "U"],
  "power": 4,
  "toughness": 5,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat", "whose": "You" },
      "condition": {
        "type": "Compare",
        "a": { "type": "EnteredThisTurn", "who": { "type": "You" }, "subtypes": ["Elf"], "other": true },
        "cmp": { "op": "Ge", "n": 1 }
      },
      "effects": [
        { "type": "Vote", "options": ["dominion", "guidance"] },
        {
          "type": "If",
          "cond": { "type": "MostVotes", "option": 0, "strict": true },
          "then": [
            { "type": "RingTempts" },
            { "type": "AddCounters", "what": { "type": "RingBearer" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": [
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Will of the council — At the beginning of combat on your turn, if another Elf entered the battlefield under your control this turn, starting with you, each player votes for dominion or guidance. If dominion gets more votes, the Ring tempts you, then you put a +1/+1 counter on your Ring-bearer. If guidance gets more votes or the vote is tied, draw a card."
}
