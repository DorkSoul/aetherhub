    { "type": "Triggered", "trigger": { "type": "SpellCast", "filter": { "this": true }, "by": "You" }, "condition": { "type": "Kicked" }, "effects": [ { "type": "CopySpell", "what": { "type": "TriggerSource" }, "new_targets": true } ], "from": "Stack" },
    {
