          "else": [
            { "type": "DealDamage", "to": { "type": "Target", "idx": 0 }, "amount": { "type": "Fixed", "n": 1 } },
            { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
