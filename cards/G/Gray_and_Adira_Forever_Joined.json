{
  "name": "Gray and Adira, Forever Joined",
  "mana_cost": "{2}{U/R}{U/R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Trill", "Human", "Officer"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    { "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat", "whose": "You" },
      "condition": { "type": "CastThisTurn", "at_least": 1, "filter": { "not_types":["Creature"] } },
      "targets": [{ "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" }],
      "effects": [
        { "type": "CopyPermanent", "what": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 1 },
          "except": [{ "type": "NotLegendary" }, { "type": "AddKeyword", "keyword": "Haste" }] },
        { "type": "Delayed", "at": "NextEndStep",
          "effects": [{ "type": "Sacrifice", "who": { "type": "Remembered" }, "n": { "type": "Fixed", "n": 1 } }] }
      ]
    }
  ],
  "oracle_text": "At the beginning of combat on your turn, if you've cast a noncreature spell this turn, create a token that's a copy of target creature you control, except it isn't legendary. It gains haste until end of turn. Sacrifice it at the beginning of the next end step."
}
