{
  "name": "Genestealer Patriarch",
  "mana_cost": "{4}{U}",
  "types": ["Creature"],
  "subtypes": ["Tyranid"],
  "power": 4,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controlled_by": { "type": "DefendingPlayer" } } },
          "label": "target creature defending player controls"
        }
      ],
      "effects": [
        { "type": "AddCounters", "kind": "Infection", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Target", "idx": 0 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "types": ["Creature"], "has_counter": "Infection" } },
      "effects": [
        {
          "type": "CopyPermanent",
          "what": { "type": "TriggerObject" },
          "except": [{ "type": "AddSubtype", "subtype": "Tyranid" }]
        }
      ]
    }
  ],
  "oracle_text": "Genestealer's Kiss — Whenever this creature attacks, put an infection counter on target creature defending player controls.\nChildren of the Cult — Whenever a creature with an infection counter on it dies, you create a token that's a copy of that creature, except it's a Tyranid in addition to its other types."
}
