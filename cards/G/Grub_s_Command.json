          ]
        },
        {
          "text": "Creatures target player controls get +1/+1 and gain haste until end of turn.",
          "targets": [
            { "what": { "type": "Player", "filter": "Any" }, "label": "target player" }
          ],
          "effects": [
            {
              "type": "Pump",
              "what": { "type": "All", "filter": { "types": ["Creature"], "controlled_by": { "type": "Target", "idx": 0 } } },
              "power": { "type": "Fixed", "n": 1 },
              "toughness": { "type": "Fixed", "n": 1 },
              "duration": "UntilEndOfTurn"
            },
            {
              "type": "GrantKeyword",
              "what": { "type": "All", "filter": { "types": ["Creature"], "controlled_by": { "type": "Target", "idx": 0 } } },
              "keyword": "Haste",
              "duration": "UntilEndOfTurn"
            }
          ]
        },
        {
          "text": "Destroy target artifact or creature.",
          "targets": [
            { "what": { "type": "Permanent", "filter": { "types": ["Artifact", "Creature"] } }, "label": "target artifact or creature" }
