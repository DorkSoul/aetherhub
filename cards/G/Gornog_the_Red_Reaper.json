{
  "name": "Gornog, the Red Reaper",
  "mana_cost": "{2}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Minotaur", "Warrior"],
  "colors": ["R"],
  "power": 2,
  "toughness": 3,
  "keywords": ["Haste"],
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "CantBlockAttackers",
        "affects": { "types": ["Creature"], "subtypes": ["Coward"] },
        "attacker": { "types": ["Creature"], "subtypes": ["Warrior"] }
      }
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "Attacks",
        "filter": { "types": ["Creature"], "subtypes": ["Warrior"], "controller": "You" },
        "batched": true,
        "player_only": true
      },
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": { "types": ["Creature"], "controller": "TriggerPlayer" }
          },
          "label": "target creature that player controls"
        }
      ],
      "effects": [
        {
          "type": "SetSubtypesOfKind",
          "what": { "type": "Target", "idx": 0 },
          "kind": "Creature",
          "subtypes": ["Coward"],
          "duration": "Forever"
        }
      ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "Modify",
        "affects": { "types": ["Creature"], "subtypes": ["Warrior"], "controller": "You", "attacking": true },
        "power": { "type": "Count", "filter": { "types": ["Creature"], "subtypes": ["Coward"], "controller": "Opponent" } },
        "toughness": { "type": "Fixed", "n": 0 }
      }
    }
  ],
  "oracle_text": "Haste\nCowards can't block Warriors.\nWhenever one or more Warriors you control attack a player, target creature that player controls becomes a Coward.\nAttacking Warriors you control get +X/+0, where X is the number of Cowards your opponents control."
}
