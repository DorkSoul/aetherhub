{
  "name": "Haunting Imitation",
  "mana_cost": "{2}{U}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "RevealTop", "who": { "type": "EachPlayer" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "CopyPermanent",
          "what": { "type": "All", "filter": { "types": ["Creature"], "among_remembered": true }, "zone": "Library" },
          "except": [
            { "type": "SetPT", "power": 1, "toughness": 1 },
            { "type": "AddSubtype", "subtype": "Spirit" },
            { "type": "AddKeyword", "keyword": "Flying" }
          ]
        },
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "AnyRememberedIs", "filter": { "types": ["Creature"] } } },
          "then": [ { "type": "Move", "what": { "type": "This" }, "from": "Stack", "to": "Hand" } ]
        }
      ]
    }
  ],
  "oracle_text": "Each player reveals the top card of their library. For each creature card revealed this way, create a token that's a copy of that card, except it's 1/1, it's a Spirit in addition to its other types, and it has flying. If no creature cards were revealed this way, return Haunting Imitation to its owner's hand."
}
