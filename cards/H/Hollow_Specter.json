                {
                  "type": "Choose",
                  "who": { "type": "You" },
                  "from": { "type": "TriggerPlayer" },
                  "zone": "Hand",
                  "filter": { "among_remembered": true },
                  "min": 1,
                  "max": 1,
                  "then": [
                    { "type": "Move", "what": { "type": "Remembered" }, "to": "Graveyard", "discard": true }
