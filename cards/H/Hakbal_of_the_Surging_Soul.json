{
  "name": "Hakbal of the Surging Soul",
  "mana_cost": "{2}{G}{U}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Merfolk", "Scout"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat", "whose": "You" },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "All", "filter": { "types": ["Creature"], "subtypes": ["Merfolk"], "controller": "You" } },
          "effects": [ { "type": "Explore", "what": { "type": "EachObject" } } ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        { "type": "ClearRemembered" },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Hand",
          "filter": { "types": ["Land"] },
          "min": 0,
          "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ]
        },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Eq", "n": 0 } },
          "then": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ]
        }
      ]
    }
  ],
  "oracle_text": "At the beginning of combat on your turn, each Merfolk creature you control explores. (Reveal the top card of your library. Put that card into your hand if it's a land. Otherwise, put a +1/+1 counter on the exploring creature, then put the card back or put it into your graveyard.)\nWhenever Hakbal attacks, you may put a land card from your hand onto the battlefield. If you don't, draw a card."
}
