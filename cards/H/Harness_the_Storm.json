{
  "name": "Harness the Storm",
  "mana_cost": "{2}{R}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": {
          "any_of": [ { "types": ["Instant"], "cast_from": "Hand" }, { "types": ["Sorcery"], "cast_from": "Hand" } ]
        }
      },
      "optional": true,
      "targets": [
        {
          "what": {
            "type": "CardIn",
            "zone": "Graveyard",
            "whose": "You",
            "filter": { "same_name_as": { "type": "TriggerSource" } }
          },
          "label": "target card with the same name as that spell in your graveyard"
        }
      ],
      "effects": [
        { "type": "CastFree", "what": { "type": "Target", "idx": 0 }, "pay": true }
      ]
    }
  ],
  "oracle_text": "Whenever you cast an instant or sorcery spell from your hand, you may cast target card with the same name as that spell from your graveyard. (You still pay its costs.)"
}
