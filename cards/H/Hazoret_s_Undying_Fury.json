    {
      "type": "Spell",
      "effects": [
        { "type": "Shuffle", "who": { "type": "You" } },
        { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 4 }, "filter": {}, "take": 4, "rest": "Library", "all": true, "to": "Exile" },
        { "type": "StoreRemembered", "slot": 0, "append": false },
        { "type": "Choose", "who": { "type": "You" }, "zone": "Exile", "filter": { "among_stored": 0, "not_types": ["Land"], "mana_value": { "op": "Le", "n": 5 } }, "min": 0, "max": 4,
          "then": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": false } ] },
        { "type": "LandsDontUntapNext" }
      ]
    }
  ]
