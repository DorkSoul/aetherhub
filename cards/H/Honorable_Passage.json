{
  "name": "Honorable Passage",
  "mana_cost": "{1}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "also_zones": ["Stack", "Command"],
          "filter": {},
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "AddReplacement",
              "what": {
                "type": "Damage",
                "source": { "colors": ["R"] },
                "prevent": true,
                "once": true,
                "bind_source": { "type": "Remembered" },
                "then": [
                  {
                    "type": "DealDamage",
                    "amount": { "type": "EventAmount" },
                    "source": { "type": "This" },
                    "to": { "type": "ControllerOf", "of": { "type": "TriggerSource" } }
                  }
                ]
              }
            },
            {
              "type": "AddReplacement",
              "what": {
                "type": "Damage",
                "source": { "not_colors": ["R"] },
                "prevent": true,
                "once": true,
                "bind_source": { "type": "Remembered" }
              }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "The next time a source of your choice would deal damage to any target this turn, prevent that damage. If damage from a red source is prevented this way, Honorable Passage deals that much damage to the source's controller."
}
