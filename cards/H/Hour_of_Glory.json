{
  "name": "Hour of Glory",
  "mana_cost": "{3}{B}",
  "types": ["Instant"],
  "colors": ["B"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "label": "target creature"
        }
      ],
      "effects": [
        {
          "type": "Exile",
          "what": { "type": "Target", "idx": 0 }
        },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "subtypes": ["God"] } },
          "then": [
            {
              "type": "Move",
              "what": {
                "type": "AllOfPlayer",
                "player": { "type": "ControllerOf", "of": { "type": "Remembered" } },
                "zone": "Hand",
                "filter": { "same_name_as": { "type": "Remembered" } }
              },
              "to": "Exile"
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile target creature. If that creature was a God, its controller reveals their hand and exiles all cards from it with the same name as that creature."
