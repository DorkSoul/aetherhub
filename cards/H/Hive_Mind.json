{
  "name": "Hive Mind",
  "mana_cost": "{5}{U}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "Any", "filter": { "types": ["Instant", "Sorcery"] } },
      "effects": [
        {
          "type": "ForEachPlayer",
          "players": { "type": "EachOpponentOfTriggerPlayer" },
          "effects": [
            {
              "type": "CopySpell",
              "what": { "type": "TriggerSource" },
              "by": { "type": "EachObject" },
              "new_targets": true
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever a player casts an instant or sorcery spell, each other player copies that spell. Each of those players may choose new targets for their copy."
}
