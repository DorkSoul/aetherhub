{
  "name": "Horrific Assault",
  "mana_cost": "{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" },
        { "what": { "type": "Permanent", "filter": { "any_of": [ { "types": ["Creature"] }, { "types": ["Planeswalker"] } ], "controller": "Opponent" } }, "label": "target creature or planeswalker you don't control" }
      ],
      "effects": [
        { "type": "Bite", "a": { "type": "Target", "idx": 0 }, "b": { "type": "Target", "idx": 1 } },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "subtypes": ["Eldrazi"] } },
          "then": [ { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Target creature you control deals damage equal to its power to target creature or planeswalker you don't control. If you control an Eldrazi, you gain 3 life."
}
