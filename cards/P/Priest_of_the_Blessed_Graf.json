{
  "name": "Priest of the Blessed Graf",
  "mana_cost": "{2}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "colors": ["W"],
  "power": 1,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "EachOpponent" },
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "CompareAmounts",
                "a": {
                  "type": "Count",
                  "filter": { "types": ["Land"] },
                  "zone": "Battlefield",
                  "player": { "type": "EachObject" }
                },
                "op": "Gt",
                "b": {
                  "type": "Count",
                  "filter": { "types": ["Land"] },
                  "zone": "Battlefield",
                  "player": { "type": "You" }
                }
              },
              "then": [
                { "type": "CreateToken", "token": "Spirit 1-1 White Flying", "n": { "type": "Fixed", "n": 1 } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "At the beginning of your end step, create X 1/1 white Spirit creature tokens with flying, where X is the number of opponents who control more lands than you."
}
