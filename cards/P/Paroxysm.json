{
  "name": "Paroxysm",
  "mana_cost": "{1}{R}",
  "types": ["Enchantment"],
  "subtypes": ["Aura"],
  "abilities": [
    { "type": "Attach", "to": { "types": ["Creature"] } },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "condition": {
        "type": "Control",
        "who": { "type": "TriggerPlayer" },
        "filter": { "attached_by_source": true, "types": ["Creature"] },
        "at_least": 1
      },
      "effects": [
        { "type": "RevealTop", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": {
            "type": "SelIs",
            "what": { "type": "TopOfLibrary", "who": { "type": "TriggerPlayer" }, "n": 1 },
            "filter": { "types": ["Land"] }
          },
          "then": [ { "type": "Destroy", "what": { "type": "Enchanted" } } ],
          "else": [
            { "type": "Pump", "what": { "type": "Enchanted" }, "power": { "type": "Fixed", "n": 3 }, "toughness": { "type": "Fixed", "n": 3 }, "duration": "UntilEndOfTurn" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Enchant creature\nAt the beginning of the upkeep of enchanted creature's controller, that player reveals the top card of their library. If that card is a land card, destroy that creature. Otherwise, it gets +3/+3 until end of turn."
}
