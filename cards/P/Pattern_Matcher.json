 "subtypes": ["Golem"],
 "power": 3,
 "toughness": 3,
 "abilities": [
  {"type": "Triggered", "trigger": {"type": "EntersBattlefield", "filter": {"this": true}},
   "effects": [
    {"type": "Choose", "who": {"type": "You"}, "zone": "Battlefield",
     "filter": {"types": ["Creature"], "controller": "You", "other": true}, "min": 0, "max": 1,
