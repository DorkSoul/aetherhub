      {"type": "SearchLibrary", "who": {"type": "You"}, "filter": {"same_name_as": {"type": "Remembered"}}, "reveal": true, "shuffle": true}
     ]}
   ]}
 ],
 "oracle_text": "When this creature enters, you may search your library for a card with the same name as another creature you control, reveal it, put it into your hand, then shuffle."
