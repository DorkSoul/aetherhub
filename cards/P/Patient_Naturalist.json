{
  "name": "Patient Naturalist",
  "mana_cost": "{2}{G}",
  "types": ["Creature"],
  "subtypes": ["Human", "Scout"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "Count", "filter": { "among_remembered": true, "types": ["Land"] }, "zone": "Graveyard" }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Graveyard",
              "filter": { "among_remembered": true, "types": ["Land"] },
              "min": 1,
              "max": 1,
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" } ]
            }
          ],
          "else": [ { "type": "CreateToken", "token": "Treasure", "n": { "type": "Fixed", "n": 1 } } ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, mill three cards. Put a land card from among the milled cards into your hand. If you can't, create a Treasure token. (To mill three cards, put the top three cards of your library into your graveyard.)"
}
