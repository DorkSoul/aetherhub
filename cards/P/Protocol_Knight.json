{
  "name": "Protocol Knight",
  "mana_cost": "{3}{U}",
  "types": ["Creature"],
  "subtypes": ["Human", "Knight"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } },
          "label": "target creature an opponent controls"
        }
      ],
      "effects": [
        { "type": "Tap", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "who": { "type": "You" },
            "filter": { "subtypes": ["Knight"], "other": true },
            "at_least": 1
          },
          "then": [
            { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "Stun", "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, tap target creature an opponent controls. Put a stun counter on that creature if you control another Knight. (If a permanent with a stun counter would become untapped, remove one from it instead.)"
}
