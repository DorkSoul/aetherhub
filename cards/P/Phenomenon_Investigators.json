{
  "name": "Phenomenon Investigators",
  "mana_cost": "{2}{U}{B}",
  "types": ["Creature"],
  "subtypes": ["Human", "Detective"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "ChooseNumber", "who": { "type": "You" }, "min": 1, "max": 2 } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "types": ["Creature"], "controller": "You", "token": false } },
      "condition": { "type": "Compare", "a": { "type": "ChosenNumber" }, "cmp": { "op": "Eq", "n": 1 } },
      "effects": [ { "type": "CreateToken", "token": "Horror 2-2 Black Enchantment", "n": { "type": "Fixed", "n": 1 } } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "condition": { "type": "Compare", "a": { "type": "ChosenNumber" }, "cmp": { "op": "Eq", "n": 2 } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "filter": { "not_types": ["Land"], "owner": "You" },
          "min": 0,
          "max": 1,
          "then": [
            { "type": "Bounce", "what": { "type": "Remembered" } },
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "RememberedCount" } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "As this creature enters, choose Believe or Doubt.\n• Believe — Whenever a nontoken creature you control dies, create a 2/2 black Horror enchantment creature token.\n• Doubt — At the beginning of your end step, you may return a nonland permanent you own to your hand. If you do, draw a card."
}
