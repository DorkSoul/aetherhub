{
  "name": "Predict",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Player", "filter": "Any" }, "label": "target player" } ],
      "effects": [
        { "type": "ChooseCardName", "kind": "Any" },
        { "type": "Mill", "n": { "type": "Fixed", "n": 1 }, "who": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "chosen_name": true } },
          "then": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } } ],
          "else": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ]
        }
      ]
    }
  ],
  "oracle_text": "Choose a card name, then target player mills a card. If a card with the chosen name was milled this way, you draw two cards. Otherwise, you draw a card."
}
