{
  "name": "Power Pack",
  "mana_cost": "{1}{R}{G}{W}{U}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Human", "Hero"],
  "power": 4,
  "toughness": 4,
  "keywords": ["Flying", "Vigilance", "Trample", "Haste"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "types": ["Instant", "Sorcery"] },
          "min": 1,
          "max": 1,
          "random": true,
          "then": [
            { "type": "Exile", "what": { "type": "Remembered" } },
            {
              "type": "Delayed",
              "at": "NextYourUpkeep",
              "effects": [
                { "type": "CastFree", "what": { "type": "Remembered" }, "may": true, "exile_after": true }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Flying, vigilance, trample, haste\nWhenever Power Pack deals combat damage to a player, exile target instant or sorcery card from your graveyard chosen at random. At the beginning of your next upkeep, you may cast that card without paying its mana cost. If that spell would be put into your graveyard, exile it instead."
}
