{
  "name": "Primal Surge",
  "mana_cost": "{8}{G}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "RepeatWhile",
          "cond": { "type": "SelIs", "what": { "type": "Remembered" }, "filter": { "entered_this_turn": true } },
          "max": 255,
          "effects": [
            { "type": "ClearRemembered" },
            {
              "type": "Move",
              "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 },
              "to": "Exile",
              "remember": true
            },
            {
              "type": "If",
              "cond": { "type": "SelIs", "what": { "type": "Remembered" }, "filter": { "types": ["Artifact", "Battle", "Creature", "Enchantment", "Land", "Planeswalker"] } },
              "then": [
                {
                  "type": "May",
                  "effects": [
                    { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "remember": true }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile the top card of your library. If it's a permanent card, you may put it onto the battlefield. If you do, repeat this process."
}
