{
  "name": "Pavel Chekov, First Posting",
  "mana_cost": "{2}{G}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Pilot"],
  "power": 1,
  "toughness": 4,
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "Draw",
        "who": "You",
        "optional": true,
        "instead": [
          {
            "type": "ChooseModes",
            "choose_min": 1,
            "choose_max": 1,
            "modes": [
              {
                "text": "Land",
                "effects": [
                  {
                    "type": "RevealUntil",
                    "who": { "type": "You" },
                    "filter": { "types": ["Land"] },
                    "count": { "type": "Fixed", "n": 1 },
                    "to": "Hand",
                    "rest": "Library",
                    "rest_random": true
                  }
                ]
              },
              {
                "text": "Nonland",
                "effects": [
                  {
                    "type": "RevealUntil",
                    "who": { "type": "You" },
                    "filter": { "not_types": ["Land"] },
                    "count": { "type": "Fixed", "n": 1 },
                    "to": "Hand",
                    "rest": "Library",
                    "rest_random": true
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "oracle_text": "If you would draw a card, you may instead choose land or nonland and reveal cards from the top of your library until you reveal a card of the chosen kind. Put that card into your hand and put all other cards revealed this way on the bottom of your library in a random order."
}
