{
  "name": "Power of Persuasion",
  "mana_cost": "{2}{U}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } }, "label": "target creature an opponent controls" }
      ],
      "effects": [
        {
          "type": "RollDie",
          "sides": 20,
          "outcomes": [
            { "min": 1, "max": 9, "effects": [ { "type": "Bounce", "what": { "type": "Target", "idx": 0 } } ] },
            { "min": 10, "max": 19, "effects": [ { "type": "OwnerChoosesLibraryPosition", "what": { "type": "Target", "idx": 0 } } ] },
            {
              "min": 20, "max": 20,
              "effects": [
                { "type": "GainControl", "what": { "type": "Target", "idx": 0 }, "duration": "Forever" },
                {
                  "type": "Delayed",
                  "at": "NextYourUpkeep",
                  "effects": [
                    {
                      "type": "Delayed",
                      "at": "NextEndStep",
                      "effects": [
                        { "type": "GainControl", "what": { "type": "Target", "idx": 0 }, "to": { "type": "OwnerOf", "of": { "type": "Target", "idx": 0 } }, "duration": "Forever" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose target creature an opponent controls, then roll a d20.\n1—9 | Return it to its owner's hand.\n10—19 | Its owner puts it on their choice of the top or bottom of their library.\n20 | Gain control of it until the end of your next turn."
}
