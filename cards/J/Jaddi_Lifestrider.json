{
  "name": "Jaddi Lifestrider",
  "mana_cost": "{4}{G}",
  "types": ["Creature"],
  "subtypes": ["Elemental"],
  "power": 2,
  "toughness": 8,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "filter": { "types": ["Creature"], "controller": "You", "tapped": false },
          "min": 0,
          "max": 255,
          "then": [
            { "type": "Tap", "what": { "type": "Remembered" } },
            { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Times", "a": { "type": "RememberedCount" }, "b": { "type": "Fixed", "n": 2 } } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you may tap any number of untapped creatures you control. You gain 2 life for each creature tapped this way."
}
