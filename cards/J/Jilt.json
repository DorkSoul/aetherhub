{
  "name": "Jilt",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    { "type": "Kicker", "cost": [{ "type": "Mana", "cost": "{1}{R}" }] },
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "when_kicked": true,
          "distinct": true,
          "label": "another target creature",
          "min": 1,
          "max": 1
        }
      ],
      "effects": [
        { "type": "Bounce", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [
            { "type": "DealDamage", "to": { "type": "Target", "idx": 1 }, "amount": { "type": "Fixed", "n": 2 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Kicker {1}{R} (You may pay an additional {1}{R} as you cast this spell.)\nReturn target creature to its owner's hand. If this spell was kicked, it deals 2 damage to another target creature."
}
