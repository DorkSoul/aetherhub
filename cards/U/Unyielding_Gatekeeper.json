{
  "name": "Unyielding Gatekeeper",
  "mana_cost": "{1}{W}",
  "types": ["Creature"],
  "subtypes": ["Elephant", "Cleric"],
  "colors": ["W"],
  "power": 3,
  "toughness": 2,
  "abilities": [
    { "type": "Morph", "cost": "{1}{W}", "disguise": true },
    {
      "type": "Triggered",
      "trigger": { "type": "TurnedFaceUp", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "other": true, "not_types": ["Land"] } },
          "label": "another target nonland permanent"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "controller": "You" } },
          "then": [
            { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "tapped": true, "under_your_control": true }
          ],
          "else": [
            { "type": "CreateToken", "token": "Detective", "controller": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "n": { "type": "Fixed", "n": 1 } },
            { "type": "Exile", "what": { "type": "Target", "idx": 0 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Disguise {1}{W} (You may cast this card face down for {3} as a 2/2 creature with ward {2}. Turn it face up any time for its disguise cost.)\nWhen this creature is turned face up, exile another target nonland permanent. If you controlled it, return it to the battlefield tapped. Otherwise, its controller creates a 2/2 white and blue Detective creature token."
}
