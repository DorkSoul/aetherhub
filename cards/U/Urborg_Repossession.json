{
  "name": "Urborg Repossession",
  "mana_cost": "{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [{ "type": "Mana", "cost": "{1}{G}" }]
    },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Creature"] }, "whose": "You" },
