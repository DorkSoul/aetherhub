        }
      ],
      "effects": [
        { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" },
        { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } },
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [ { "type": "Move", "what": { "type": "Target", "idx": 1 }, "to": "Hand" } ],
          "else": []
