{
  "name": "Ultron, Artificial Malevolence",
  "mana_cost": "{3}",
  "supertypes": ["Legendary"],
  "types": ["Artifact", "Creature"],
  "subtypes": ["Robot", "Villain"],
  "power": 2,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "EntersBattlefield",
        "filter": {
          "types": ["Artifact"],
          "token": false,
          "other": true,
          "controller": "You"
        }
      },
      "effects": [
        {
          "type": "MayPay",
          "payer": {"type": "You"},
          "cost": [{"type": "Mana", "cost": "{2}"}],
          "effects": [
            {
              "type": "CopyPermanent",
              "what": {"type": "TriggerObject"},
              "n": {"type": "Fixed", "n": 1}
            },
            {
              "type": "If",
              "cond": {
                "type": "RememberedIs",
                "filter": {"not_types": ["Creature"]}
              },
              "then": [
                {
                  "type": "Animate",
                  "what": {"type": "Remembered"},
                  "duration": "Forever",
                  "add_types": ["Creature"],
                  "add_subtypes": ["Robot", "Villain"],
                  "power": 2,
                  "toughness": 2
                }
              ],
              "else": []
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever another nontoken artifact you control enters, you may pay {2}. If you do, create a token that's a copy of it. If the token isn't a creature, it becomes a 2/2 Robot Villain creature in addition to its other types."
}
