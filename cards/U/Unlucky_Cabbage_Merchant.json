{
  "name": "Unlucky Cabbage Merchant",
  "mana_cost": "{1}{G}",
  "types": ["Creature"],
  "subtypes": ["Human", "Citizen"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "CreateToken", "token": "Food", "n": { "type": "Fixed", "n": 1 }, "controller": { "type": "You" } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "Sacrificed",
        "filter": { "subtypes": ["Food"], "controller": "You" }
      },
      "optional": true,
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": { "types": ["Land"], "supertypes": ["Basic"] },
          "n": { "type": "Fixed", "n": 1 },
          "to": "Battlefield",
          "tapped": true,
          "shuffle": false
        },
        {
          "type": "If",
          "cond": {
            "type": "AnyOf",
            "cs": [
              { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Ge", "n": 1 } },
              {
                "type": "Compare",
                "a": { "type": "Count", "filter": { "types": ["Land"], "supertypes": ["Basic"] }, "zone": "Library", "player": { "type": "You" } },
                "cmp": { "op": "Eq", "n": 0 }
              }
            ]
          },
          "then": [
            { "type": "Move", "what": { "type": "This" }, "to": "Library" },
            { "type": "Shuffle", "who": { "type": "You" } }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, create a Food token. (It's an artifact with \"{2}, {T}, Sacrifice this token: You gain 3 life.\")\nWhenever you sacrifice a Food, you may search your library for a basic land card and put it onto the battlefield tapped. If you search your library this way, put this creature on the bottom of its owner's library, then shuffle."
}
