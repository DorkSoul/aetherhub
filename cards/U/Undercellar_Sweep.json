{
  "name": "Undercellar Sweep",
  "mana_cost": "{4}{W}",
  "types": ["Enchantment"],
  "colors": ["W"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "TakeInitiative", "who": { "type": "You" } } ]
