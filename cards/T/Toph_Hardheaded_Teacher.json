{
  "name": "Toph, Hardheaded Teacher",
  "mana_cost": "{2}{R}{G}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Warrior", "Ally"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": {
            "type": "CardIn",
            "zone": "Graveyard",
            "filter": { "any_of": [ { "types": ["Instant"] }, { "types": ["Sorcery"] } ] },
            "whose": "You"
          },
          "label": "target instant or sorcery card in your graveyard"
        }
      ],
      "effects": [
        {
          "type": "MayPay",
          "payer": { "type": "You" },
          "cost": [ { "type": "Discard", "filter": {}, "n": 1 } ],
          "effects": [ { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" } ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "You", "filter": { "not_subtypes": ["Lesson"] } },
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Land"], "controller": "You" } }, "label": "target land you control" }
      ],
      "effects": [
        { "type": "Earthbend", "what": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "You", "filter": { "subtypes": ["Lesson"] } },
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Land"], "controller": "You" } }, "label": "target land you control" }
      ],
      "effects": [
        { "type": "Earthbend", "what": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 2 } }
      ]
    }
  ],
  "oracle_text": "When Toph enters, you may discard a card. If you do, return target instant or sorcery card from your graveyard to your hand.\nWhenever you cast a spell, earthbend 1. If that spell is a Lesson, put an additional +1/+1 counter on that land. (Target land you control becomes a 0/0 creature with haste that's still a land. Put a +1/+1 counter on it. When it dies or is exiled, return it to the battlefield tapped.)"
}
