    {
      "type": "Activated",
      "cost": [{ "type": "Crew", "power": 1 }],
      "effects": [{ "type": "Animate", "what": { "type": "This" }, "add_types": ["Creature"], "duration": "UntilEndOfTurn" }]
    }
