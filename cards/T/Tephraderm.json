{
  "name": "Tephraderm",
  "mana_cost": "{4}{R}",
  "types": ["Creature"],
  "subtypes": ["Beast"],
  "colors": ["R"],
  "power": 4,
  "toughness": 5,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "IsDealtDamage", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "TriggerSource" }, "filter": { "types": ["Creature"] } },
          "then": [{ "type": "DealDamage", "source": { "type": "This" }, "to": { "type": "TriggerSource" }, "amount": { "type": "EventAmount" } }],
          "else": []
        },
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "TriggerSource" }, "filter": { "any_of": [{ "types": ["Instant"] }, { "types": ["Sorcery"] }] } },
          "then": [{ "type": "DealDamage", "source": { "type": "This" }, "to": { "type": "ControllerOf", "of": { "type": "TriggerSource" } }, "amount": { "type": "EventAmount" } }],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Whenever a creature deals damage to this creature, this creature deals that much damage to that creature.\nWhenever a spell deals damage to this creature, this creature deals that much damage to that spell's controller."
}
