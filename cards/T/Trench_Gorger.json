            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "n": 1, "op": "Ge" } },
              "then": [
                { "type": "SetBasePT", "what": { "type": "This" }, "power": { "type": "RememberedCount" }, "toughness": { "type": "RememberedCount" }, "duration": "Forever" }
              ]
            }
          ]
        }
      ]
