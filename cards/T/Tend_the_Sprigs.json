              "zone": "Battlefield"
            },
            "cmp": { "op": "Ge", "n": 7 }
          },
          "then": [
            { "type": "CreateToken", "token": "Treefolk 3-4 Reach", "n": { "type": "Fixed", "n": 1 } }
