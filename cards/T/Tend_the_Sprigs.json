{
  "name": "Tend the Sprigs",
  "mana_cost": "{2}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": { "types": ["Land"], "supertypes": ["Basic"] },
          "n": { "type": "Fixed", "n": 1 },
          "to": "Battlefield",
          "tapped": true,
          "shuffle": true
        },
        {
          "type": "If",
