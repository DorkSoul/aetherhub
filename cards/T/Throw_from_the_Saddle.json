{
  "name": "Throw from the Saddle",
  "mana_cost": "{1}{G}",
  "types": ["Sorcery"],
  "abilities": [
    { "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" },
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } }, "label": "target creature you don't control" }
      ],
      "effects": [
        { "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "subtypes": ["Mount"] } },
          "then": [ { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } } ],
          "else": [ { "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": 1 }, "toughness": { "type": "Fixed", "n": 1 }, "duration": "UntilEndOfTurn" } ] },
        { "type": "DealDamage", "amount": { "type": "PowerOf", "of": { "type": "Target", "idx": 0 } }, "source": { "type": "Target", "idx": 0 }, "to": { "type": "Target", "idx": 1 } }
      ] }
