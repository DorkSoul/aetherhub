{
  "name": "Tuktuk Scrapper",
  "mana_cost": "{3}{R}",
  "types": ["Creature"],
  "subtypes": ["Goblin", "Artificer", "Ally"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "EntersBattlefield",
        "filter": { "any_of": [ { "this": true }, { "subtypes": ["Ally"], "controller": "You", "other": true } ] }
      },
      "optional": true,
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Artifact"] } }, "min": 1, "max": 1 }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 }, "remember": true },
        { "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "Remembered" }, "filter": {} },
          "then": [
            { "type": "DealDamage",
              "amount": { "type": "Count", "filter": { "subtypes": ["Ally"], "controller": "You" } },
              "to": { "type": "ControllerOf", "of": { "type": "Remembered" } } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever this creature or another Ally you control enters, you may destroy target artifact. If that artifact is put into a graveyard this way, this creature deals damage to that artifact's controller equal to the number of Allies you control."
