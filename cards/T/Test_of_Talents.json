{
  "name": "Test of Talents",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Spell", "filter": { "types": ["Instant", "Sorcery"] } }, "label": "target instant or sorcery spell" } ],
      "effects": [
        { "type": "CounterSpell", "what": { "type": "Target", "idx": 0 } },
        { "type": "ExileFromZones", "who": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "zones": ["Graveyard", "Library"], "filter": { "same_name_as": { "type": "Target", "idx": 0 } } },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "from": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } },
          "zone": "Hand",
          "filter": { "same_name_as": { "type": "Target", "idx": 0 } },
          "min": 0,
          "max": 255,
          "then": [
            { "type": "Exile", "what": { "type": "Remembered" } },
            { "type": "Draw", "who": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "n": { "type": "RememberedCount" } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Counter target instant or sorcery spell. Search its controller's graveyard, hand, and library for any number of cards with the same name as that spell and exile them. That player shuffles, then draws a card for each card exiled from their hand this way."
