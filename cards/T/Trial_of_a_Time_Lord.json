{
  "name": "Trial of a Time Lord",
  "mana_cost": "{1}{W}{W}",
  "types": ["Enchantment"],
  "subtypes": ["Saga"],
  "abilities": [
    {
      "type": "Saga",
      "chapters": [
        {
          "numbers": [1, 2, 3],
          "targets": [
            {
              "what": {
                "type": "Permanent",
