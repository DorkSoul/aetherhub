{
  "name": "Traumatic Revelation",
  "mana_cost": "{1}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Player", "filter": "Opponent" },
          "label": "target opponent"
        }
      ],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "from": { "type": "Target", "idx": 0 },
          "zone": "Hand",
          "filter": { "types": ["Creature", "Battle"] },
          "min": 0,
          "max": 1,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Graveyard", "discard": true }
          ]
        },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "n": 0, "op": "Eq" } },
          "then": [
            { "type": "CreateToken", "token": "Incubator" },
            {
              "type": "AddCounters",
              "what": { "type": "Remembered" },
              "kind": "PlusOnePlusOne",
              "n": { "type": "Fixed", "n": 3 }
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Target opponent reveals their hand. You may choose a creature or battle card from it. If you do, that player discards that card. If you don't, incubate 3. (Create an Incubator token with three +1/+1 counters on it and \"{2}: Transform this token.\" It transforms into a 0/0 Phyrexian artifact creature.)"
}
