{
  "name": "Tunnel Vision",
  "mana_cost": "{5}{U}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Player", "filter": "Any" }, "label": "target player" } ],
      "effects": [
        { "type": "ChooseCardName", "kind": "Any" },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "Count", "filter": { "chosen_name": true }, "zone": "Library", "player": { "type": "Target", "idx": 0 } },
            "cmp": { "op": "Ge", "n": 1 }
          },
          "then": [
            {
              "type": "RevealUntil",
              "who": { "type": "Target", "idx": 0 },
              "filter": { "chosen_name": true },
              "count": { "type": "Fixed", "n": 1 },
              "to": "Exile",
              "rest": "Graveyard"
            },
            { "type": "Move", "what": { "type": "Remembered" }, "from": "Exile", "to": "Library", "top_of_library": true }
          ],
          "else": [
            { "type": "Shuffle", "who": { "type": "Target", "idx": 0 } }
