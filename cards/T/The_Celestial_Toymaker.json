{
  "name": "The Celestial Toymaker",
  "mana_cost": "{W}{U}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Rogue", "Artificer"],
  "power": 2,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        { "type": "NotePileOrGuess" },
        {
          "type": "LookAtTop",
          "who": { "type": "You" },
          "n": { "type": "Fixed", "n": 3 },
          "filter": {},
          "take": 3,
          "must": true,
          "to": "Exile",
          "rest": "Exile"
        },
        { "type": "StoreRemembered", "slot": 1 },
        { "type": "ClearRemembered" },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Exile",
          "filter": { "among_stored": 1 },
          "min": 0,
          "max": 3,
          "then": [
            { "type": "StoreRemembered", "slot": 0 },
            {
              "type": "May",
              "who": { "type": "DefendingPlayer" },
              "effects": [
                { "type": "Move", "what": { "type": "Stored", "slot": 0 }, "to": "Hand" }
              ],
              "otherwise": [
                {
                  "type": "Move",
                  "what": {
                    "type": "AllOfPlayer",
                    "player": { "type": "You" },
                    "zone": "Exile",
                    "filter": { "among_stored": 1, "not_among_stored": 0 }
                  },
                  "to": "Hand"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "Any" },
      "effects": [
        {
          "type": "LoseLife",
          "who": { "type": "EachOpponent" },
          "n": { "type": "Times", "a": { "type": "PileGuessAbilitiesThisTurn" }, "b": { "type": "Fixed", "n": 2 } }
        }
      ]
    }
  ],
  "oracle_text": "Whenever The Celestial Toymaker attacks, look at the top three cards of your library. Exile any number of them in a face-down pile and the rest in a face-up pile. Defending player chooses one of those piles. Put that pile into your hand.\nAt the beginning of each end step, each opponent loses 2 life for each spell or ability that caused one or more players to guess or to group cards or permanents into a pile this turn."
}
