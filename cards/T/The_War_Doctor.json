{
  "name": "The War Doctor",
  "mana_cost": "{2}{R}{W}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Time Lord", "Doctor"],
  "power": 3,
  "toughness": 5,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "PhasesOut", "filter": { "other": true } },
      "batched": true,
      "effects": [
        { "type": "AddCounters", "what": { "type": "This" }, "kind": "Time", "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "ChangesZone", "filter": { "other": true, "token": false }, "to": "Exile" },
      "batched": true,
      "effects": [
        { "type": "AddCounters", "what": { "type": "This" }, "kind": "Time", "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "AnyTarget" }, "label": "any target" }
      ],
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "Target", "idx": 0 },
          "effects": [
            {
              "type": "AddReplacement",
              "what": { "type": "ZoneChange", "from": "Battlefield", "to": "Graveyard", "instead": "Exile", "filter": { "among_remembered": true } }
            }
          ]
        },
        {
          "type": "DealDamage",
          "amount": { "type": "CountersOn", "kind": "Time", "of": { "type": "This" } },
          "to": { "type": "Target", "idx": 0 }
        }
      ]
    }
  ],
  "oracle_text": "Whenever one or more other permanents phase out and whenever one or more other cards are put into exile from anywhere, put a time counter on The War Doctor.\nWhenever The War Doctor attacks, it deals damage equal to the number of time counters on it to any target. If a creature dealt damage this way would die this turn, exile it instead."
}
