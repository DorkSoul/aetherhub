{
  "name": "The Flood of Mars",
  "mana_cost": "{2}{U}{U}",
  "types": ["Creature"],
  "subtypes": ["Alien", "Zombie", "Horror"],
  "power": 3,
  "toughness": 3,
  "keywords": ["Islandwalk"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": { "any_of": [ { "types": ["Creature"] }, { "types": ["Land"] } ], "other": true }
          },
          "label": "another target creature or land"
        }
      ],
      "effects": [
        {
          "type": "AddCounters",
          "kind": "Flood",
          "n": { "type": "Fixed", "n": 1 },
          "what": { "type": "Target", "idx": 0 }
        },
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "types": ["Creature"] } },
          "then": [
            {
              "type": "BecomeCopy",
              "what": { "type": "Target", "idx": 0 },
              "of": { "type": "This" },
              "duration": "Forever"
            }
          ]
        },
        {
          "type": "If",
          "cond": {
            "type": "All",
            "cs": [
              { "type": "TargetIs", "idx": 0, "filter": { "types": ["Land"] } },
              { "type": "Not", "c": { "type": "TargetIs", "idx": 0, "filter": { "types": ["Creature"] } } }
            ]
          },
          "then": [
            {
              "type": "Animate",
              "what": { "type": "Target", "idx": 0 },
              "duration": "Forever",
              "add_subtypes": ["Island"]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Islandwalk (This creature can't be blocked as long as defending player controls an Island.)\nWater Always Wins — Whenever this creature attacks, put a flood counter on another target creature or land. If it's a creature, it becomes a copy of this creature. If it's a land, it becomes an Island in addition to its other types."
}
