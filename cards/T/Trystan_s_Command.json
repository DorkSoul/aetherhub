        {
          "text": "Return one or two target permanent cards from your graveyard to your hand.",
          "targets": [ { "what": { "type": "CardIn", "zone": "Graveyard", "whose": "You", "filter": { "types": ["Artifact", "Battle", "Creature", "Enchantment", "Land", "Planeswalker"] } }, "min": 1, "max": 2, "label": "one or two permanent cards in your graveyard" } ],
          "effects": [ { "type": "Move", "what": { "type": "Targets" }, "to": "Hand" } ]
        },
        {
          "text": "Destroy target creature or enchantment.",
          "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature", "Enchantment"] } }, "label": "target creature or enchantment" } ],
          "effects": [ { "type": "Destroy", "what": { "type": "Target", "idx": 0 } } ]
