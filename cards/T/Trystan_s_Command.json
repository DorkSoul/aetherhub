{
  "name": "Trystan's Command",
  "mana_cost": "{4}{B}{G}",
  "types": ["Kindred", "Sorcery"],
  "subtypes": ["Elf"],
  "abilities": [
    {
      "type": "Modal",
      "choose_min": 2,
      "choose_max": 2,
      "modes": [
        {
          "text": "Create a token that's a copy of target Elf you control.",
