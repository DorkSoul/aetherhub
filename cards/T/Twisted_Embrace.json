{
  "name": "Twisted Embrace",
  "mana_cost": "{2}{B}{B}",
  "types": ["Enchantment"],
  "subtypes": ["Aura"],
  "abilities": [
    {
      "type": "Attach",
      "to": {
        "any_of": [
          { "types": ["Artifact"], "controller": "You" },
          { "types": ["Creature"], "controller": "You" }
        ]
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": {
