            }
          },
          "label": "target creature or planeswalker an opponent controls"
        }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } }
      ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "Modify",
        "affects": { "attached_by_source": true, "types": ["Creature"] },
        "power": { "type": "Fixed", "n": 1 },
        "toughness": { "type": "Fixed", "n": 1 }
      }
    }
  ],
  "oracle_text": "Enchant artifact or creature you control\nWhen this Aura enters, destroy target creature or planeswalker an opponent controls.\nAs long as enchanted permanent is a creature, it gets +1/+1."
