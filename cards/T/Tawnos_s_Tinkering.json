{
  "name": "Tawnos's Tinkering",
  "mana_cost": "{3}{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "controller": "You", "any_of": [{ "types": ["Artifact"] }, { "types": ["Creature"] }, { "types": ["Land"] }] } },
          "label": "target artifact, creature, or land you control"
        }
      ],
      "effects": [
        { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 } },
        { "type": "Untap", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "TargetIs", "filter": { "types": ["Creature"] }, "idx": 0 } },
          "then": [
            { "type": "Animate", "what": { "type": "Target", "idx": 0 }, "power": 0, "toughness": 0, "add_types": ["Creature"], "duration": "Forever" }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Put two +1/+1 counters on target artifact, creature, or land you control. Untap that permanent. If it isn't a creature, it becomes a 0/0 creature in addition to its other types."
}
