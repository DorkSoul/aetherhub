{
  "name": "The Queen of Dale",
  "mana_cost": "{1}{W}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Human", "Noble"],
  "power": 2,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "Opponent", "filter": { "not_types": ["Creature"] } },
      "condition": {
        "type": "All",
        "cs": [
          { "type": "CastThisTurn", "at_least": 1, "filter": { "not_types": ["Creature"], "controller": "Opponent" } },
          { "type": "Not", "c": { "type": "CastThisTurn", "at_least": 2, "filter": { "not_types": ["Creature"], "controller": "Opponent" } } }
        ]
      },
      "effects": [
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Discard", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "not_types": ["Land"] } },
          "then": [ { "type": "CreateToken", "token": "Human Soldier", "n": { "type": "Fixed", "n": 1 } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Whenever an opponent casts their first noncreature spell each turn, you recruit. (Draw a card, then discard a card. If you discarded a nonland card, create a 1/1 white Human Soldier creature token.)"
}
