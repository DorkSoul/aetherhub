{
  "name": "Thor, God of Thunder",
  "mana_cost": "{3}{R}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["God", "Warrior", "Hero"],
  "power": 5,
  "toughness": 5,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": {
            "type": "CardIn",
            "zone": "Graveyard",
            "whose": "You",
            "filter": {
              "any_of": [
                { "types": ["Instant"] },
                { "types": ["Sorcery"] },
                { "subtypes": ["Equipment"] }
              ]
            }
          },
          "label": "target Equipment, instant, or sorcery card in your graveyard"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "GrantPlayFromExile",
          "what": { "type": "Remembered" },
          "window": "EndOfYourNextTurn"
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": { "not_types": ["Creature"] }
      },
      "targets": [
        { "what": { "type": "AnyTarget" }, "label": "any target" }
      ],
      "effects": [
        {
          "type": "DealDamage",
          "source": { "type": "This" },
          "to": { "type": "Target", "idx": 0 },
          "amount": { "type": "ManaValueOf", "of": { "type": "TriggerObject" } }
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhen Thor enters, exile target Equipment, instant, or sorcery card from your graveyard. Until the end of your next turn, you may play that card.\nWhenever you cast a noncreature spell, Thor deals damage equal to that spell's mana value to any target."
}
