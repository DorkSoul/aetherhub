{
  "name": "Toph, Earthbending Master",
  "mana_cost": "{3}{G}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Warrior", "Ally"],
  "power": 2,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Landfall" },
      "effects": [
        { "type": "AddCounters", "kind": "Experience", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "You" } }
