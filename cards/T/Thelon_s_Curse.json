{
  "name": "Thelon's Curse",
  "mana_cost": "{G}{G}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "DoesntUntap",
        "filter": { "types": ["Creature"], "colors": ["U"] }
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "effects": [
        {
          "type": "ForEach",
          "objects": {
            "type": "All",
            "filter": {
              "types": ["Creature"],
              "colors": ["U"],
              "tapped": true,
              "controlled_by": { "type": "TriggerPlayer" }
            },
            "zone": "Battlefield"
          },
          "effects": [
            {
              "type": "MayPay",
              "payer": { "type": "TriggerPlayer" },
              "cost": [{ "type": "Mana", "cost": "{U}" }],
              "effects": [
                { "type": "Untap", "what": { "type": "EachObject" } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Blue creatures don't untap during their controllers' untap steps.\nAt the beginning of each player's upkeep, that player may choose any number of tapped blue creatures they control and pay {U} for each creature chosen this way. If the player does, untap those creatures."
}
