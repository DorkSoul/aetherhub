{
  "name": "Talion, the Kindly Lord",
  "mana_cost": "{2}{U}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Faerie", "Noble"],
  "colors": ["U", "B"],
  "power": 3,
  "toughness": 4,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "ChooseNumber", "who": { "type": "You" }, "min": 1, "max": 10 }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "Opponent",
        "filter": {
          "any_of": [
            { "mana_value_vs": { "op": "Eq", "amount": { "type": "ChosenNumber" } } },
            { "power_vs": { "op": "Eq", "amount": { "type": "ChosenNumber" } } },
            { "toughness_vs": { "op": "Eq", "amount": { "type": "ChosenNumber" } } }
          ]
        }
      },
      "effects": [
        { "type": "LoseLife", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 2 } },
        { "type": "Draw", "who": { "type": "You" } }
      ]
    }
  ],
  "oracle_text": "Flying\nAs Talion, the Kindly Lord enters, choose a number between 1 and 10.\nWhenever an opponent casts a spell with mana value, power, or toughness equal to the chosen number, that player loses 2 life and you draw a card."
}
