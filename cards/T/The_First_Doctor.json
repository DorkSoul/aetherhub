      "effects": [
        {
          "type": "May",
          "effects": [
            {
              "type": "SearchLibrary",
              "who": { "type": "You" },
              "filter": { "name": "TARDIS" },
              "n": { "type": "Fixed", "n": 1 },
              "to": "Hand",
              "reveal": true,
              "shuffle": true
            }
          ]
        },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "RememberedCount" },
            "cmp": { "op": "Eq", "n": 0 }
          },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Graveyard",
              "filter": { "name": "TARDIS", "owner": "You" },
              "min": 0,
              "max": 1,
              "then": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" }
              ]
            }
          ],
          "else": []
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": { "keywords": ["Cascade"] }
      },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact", "Creature"] } },
          "label": "target artifact or creature"
        }
      ],
      "effects": [
        { "type": "AddCounters", "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Target", "idx": 0 } }
      ]
    }
