{
  "name": "Thoughtweft Trio",
  "mana_cost": "{2}{W}{W}",
  "types": ["Creature"],
  "subtypes": ["Kithkin", "Soldier"],
  "power": 5,
  "toughness": 5,
  "keywords": ["FirstStrike", "Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "subtypes": ["Kithkin"], "other": true, "controller": "You" }, "at_least": 1 },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Battlefield",
              "filter": { "subtypes": ["Kithkin"], "other": true, "controller": "You" },
              "min": 1,
              "max": 1,
              "then": [ { "type": "Exile", "what": { "type": "Remembered" }, "until_source_leaves": true } ]
            }
          ],
          "else": [
            { "type": "Sacrifice", "who": { "type": "This" }, "filter": { "this": true }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "CanBlockExtra", "affects": { "this": true }, "extra": 0 }
    }
  ],
  "oracle_text": "First strike, vigilance\nChampion a Kithkin (When this enters, sacrifice it unless you exile another Kithkin you control. When this leaves the battlefield, that card returns to the battlefield.)\nThis creature can block any number of creatures."
}
