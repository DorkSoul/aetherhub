{
  "name": "Tamiyo's Compleation",
  "mana_cost": "{3}{U}",
  "types": ["Enchantment"],
  "subtypes": ["Aura"],
  "keywords": ["Flash"],
  "abilities": [
    {
      "type": "Attach",
      "to": { "any_of": [{ "types": ["Artifact"] }, { "types": ["Creature"] }, { "types": ["Planeswalker"] }] }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Tap", "what": { "type": "Enchanted" } },
        { "type": "Unattach", "what": { "type": "Enchanted" } }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "RemoveAbilities", "affects": { "attached_by_source": true } }
    },
    {
      "type": "Static",
      "effect": { "type": "DoesntUntap", "filter": { "attached_by_source": true } }
    }
  ],
  "oracle_text": "Flash\nEnchant artifact, creature, or planeswalker\nWhen this Aura enters, tap enchanted permanent. If it's an Equipment, unattach it.\nEnchanted permanent loses all abilities and doesn't untap during its controller's untap step."
}
