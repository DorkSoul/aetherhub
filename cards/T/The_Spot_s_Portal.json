{
  "name": "The Spot's Portal",
  "mana_cost": "{2}{B}",
  "types": ["Instant"],
  "colors": ["B"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library" },
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "Control", "who": { "type": "You" }, "filter": { "subtypes": ["Villain"], "controller": "You" }, "at_least": 1 } },
          "then": [ { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Put target creature on the bottom of its owner's library. You lose 2 life unless you control a Villain."
}
