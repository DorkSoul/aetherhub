{
  "name": "Taken by Nightmares",
  "mana_cost": "{2}{B}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "label": "target creature"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Enchantment"] }, "at_least": 1 },
          "then": [
            { "type": "Scry", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile target creature. If you control an enchantment, scry 2."
}
