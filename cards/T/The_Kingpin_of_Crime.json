{
  "name": "The Kingpin of Crime",
  "mana_cost": "{1}{W}{B}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Human", "Villain"],
  "colors": ["W", "B"],
  "power": 1,
  "toughness": 5,
  "keywords": ["Extort"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "Attacks",
        "batched": true, "one_per_declaration": true,
        "filter": { "types": ["Creature"], "controller": "You" }
      },
      "effects": [
        {
          "type": "MayPay",
          "payer": { "type": "You" },
          "cost": [{ "type": "PayLife", "n": 2 }],
          "effects": [
            {
              "type": "ForEach",
              "objects": { "type": "All", "filter": { "types": ["Creature"], "controller": "You" }, "zone": "Battlefield" },
              "effects": [
                {
                  "type": "If",
                  "cond": {
                    "type": "CompareAmounts",
                    "a": { "type": "ToughnessOf", "of": { "type": "Remembered" } },
                    "b": { "type": "PowerOf", "of": { "type": "Remembered" } },
                    "op": "Gt"
                  },
                  "then": [
                    {
                      "type": "GrantStatic",
                      "what": { "type": "Remembered" },
                      "duration": "UntilEndOfTurn",
                      "effect": { "type": "CombatDamageByToughness", "affects": { "this": true } }
                    }
                  ],
                  "else": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Extort (Whenever you cast a spell, you may pay {W/B}. If you do, each opponent loses 1 life and you gain that much life.)\nWhenever you attack, you may pay 2 life. If you do, until end of turn, creatures you control with toughness greater than their power assign combat damage equal to their toughness rather than their power."
}
