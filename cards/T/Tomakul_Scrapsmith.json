{
  "name": "Tomakul Scrapsmith",
  "mana_cost": "{2}{R}",
  "types": ["Creature"],
  "subtypes": ["Human", "Artificer"],
  "colors": ["R"],
  "power": 2,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } },
        {
          "type": "May",
          "effects": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Graveyard",
              "filter": { "among_remembered": true, "types": ["Artifact"] },
