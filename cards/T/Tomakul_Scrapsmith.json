          ]
        },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "Count", "filter": { "among_remembered": true }, "zone": "Hand", "player": { "type": "You" } },
            "cmp": { "op": "Eq", "n": 0 }
          },
          "then": [{ "type": "AddCounters", "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "This" } }],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, mill three cards. You may put an artifact card from among the cards milled this way into your hand. If you don't, put a +1/+1 counter on this creature. (To mill a card, put the top card of your library into your graveyard.)"
