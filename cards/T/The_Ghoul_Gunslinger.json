{
  "name": "The Ghoul, Gunslinger",
  "mana_cost": "{1}{B}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Zombie", "Mutant", "Rogue"],
  "power": 2,
  "toughness": 3,
  "keywords": ["FirstStrike"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "Dies",
        "filter": {
          "any_of": [
            { "this": true },
            { "types": ["Creature"], "subtypes": ["Zombie"], "controller": "You", "other": true, "token": false },
            { "types": ["Creature"], "subtypes": ["Mutant"], "controller": "You", "other": true, "token": false }
          ]
        }
      },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "modes": [
            {
              "text": "Target opponent gets two rad counters.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [ { "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" } ],
                  "effects": [ { "type": "AddCounters", "kind": "Rad", "what": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 2 } } ]
                }
              ]
            },
            {
              "text": "Target yourself gets two rad counters. Create a Treasure token.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [ { "what": { "type": "Player", "filter": "You" }, "label": "you" } ],
                  "effects": [
                    { "type": "AddCounters", "kind": "Rad", "what": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 2 } },
                    { "type": "CreateToken", "token": "Treasure", "n": { "type": "Fixed", "n": 1 } }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "First strike\nWhenever The Ghoul or another nontoken Zombie or Mutant you control dies, target player gets two rad counters. If that player is you, create a Treasure token."
}
