{
  "name": "Temporal Distortion",
  "mana_cost": "{3}{U}{U}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "BecomesTapped",
        "filter": { "any_of": [{ "types": ["Creature"] }, { "types": ["Land"] }] }
      },
      "effects": [
        { "type": "AddCounters", "what": { "type": "TriggerObject" }, "kind": "Hourglass", "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "DoesntUntap", "filter": { "has_counter": "Hourglass" } }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "effects": [
        {
          "type": "RemoveCounters",
          "what": { "type": "All", "filter": { "has_counter": "Hourglass", "controlled_by": { "type": "TriggerPlayer" } }, "zone": "Battlefield" },
          "kind": "Hourglass",
          "n": { "type": "Fixed", "n": 999 }
        }
      ]
    }
  ],
  "oracle_text": "Whenever a creature or land becomes tapped, put an hourglass counter on it.\nEach permanent with an hourglass counter on it doesn't untap during its controller's untap step.\nAt the beginning of each player's upkeep, remove all hourglass counters from permanents that player controls."
}
