{
  "name": "T'Chaka, Venerable King",
  "mana_cost": "{G}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Noble", "Hero"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } },
        {
          "type": "May",
          "effects": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Graveyard",
              "filter": { "among_remembered": true, "any_of": [ { "types": ["Artifact"] }, { "types": ["Land"] } ] },
              "min": 1,
              "max": 1,
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" } ]
            }
          ]
        }
      ]
    },
    {
      "type": "Activated",
      "from": "Graveyard",
      "cost": [ { "type": "Mana", "cost": "{3}" }, { "type": "ExileSelf" } ],
      "condition": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "commander": true, "owner": "You" } },
      "effects": [ { "type": "BecomeMonarch", "who": { "type": "You" } } ]
    }
  ],
  "oracle_text": "When T'Chaka enters, mill three cards, then you may put an artifact or land card from among the milled cards into your hand.\n{3}, Exile this card from your graveyard: You become the monarch. Activate only if you control your commander."
}
