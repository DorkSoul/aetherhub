{
  "name": "Tidus, Yuna's Guardian",
  "mana_cost": "{G}{W}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Warrior"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat", "whose": "You" },
      "optional": true,
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } },
          "label": "target creature you control (counter is moved from it)"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } },
          "label": "a second target creature you control (receives the counter)"
        }
      ],
      "effects": [
        {
          "type": "MoveCounters",
          "from": { "type": "Target", "idx": 0 },
          "to": { "type": "Target", "idx": 1 },
          "kind": null,
          "n": { "type": "Fixed", "n": 1 }
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "CombatDamageToPlayer",
        "batched": true,
        "filter": { "types": ["Creature"], "controller": "You", "has_any_counter": true }
      },
      "optional": true,
      "once_per_turn": true,
      "effects": [
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Proliferate" }
      ]
    }
  ],
  "oracle_text": "At the beginning of combat on your turn, you may move a counter from target creature you control onto a second target creature you control.\nCheer — Whenever one or more creatures you control with counters on them deal combat damage to a player, you may draw a card and proliferate. Do this only once each turn."
}
