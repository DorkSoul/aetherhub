{
  "name": "Tymaret Calls the Dead",
  "mana_cost": "{2}{B}",
  "types": ["Enchantment"],
  "subtypes": ["Saga"],
  "abilities": [
    {
      "type": "Saga",
      "chapters": [
        {
          "numbers": [1, 2],
          "effects": [
            { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } },
            {
              "type": "May",
              "effects": [
                {
                  "type": "Choose",
                  "who": { "type": "You" },
                  "zone": "Graveyard",
                  "filter": {
                    "any_of": [
                      { "types": ["Creature"], "owner": "You" },
                      { "types": ["Enchantment"], "owner": "You" }
                    ]
                  },
                  "min": 1,
                  "max": 1,
                  "then": [
                    { "type": "Exile", "what": { "type": "Remembered" } },
                    { "type": "CreateToken", "token": "Zombie", "n": { "type": "Fixed", "n": 1 } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "numbers": [3],
          "effects": [
            {
              "type": "GainLife",
              "who": { "type": "You" },
              "n": { "type": "Count", "filter": { "types": ["Creature"], "subtypes": ["Zombie"], "controller": "You" } }
            },
            {
              "type": "Scry",
              "who": { "type": "You" },
              "n": { "type": "Count", "filter": { "types": ["Creature"], "subtypes": ["Zombie"], "controller": "You" } }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\nI, II — Mill three cards. Then you may exile a creature or enchantment card from your graveyard. If you do, create a 2/2 black Zombie creature token.\nIII — You gain X life and scry X, where X is the number of Zombies you control."
}
