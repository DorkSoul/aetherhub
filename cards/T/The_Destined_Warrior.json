{
  "name": "The Destined Warrior",
  "mana_cost": "{1}{W}{U}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Warrior"],
  "power": 3,
  "toughness": 3,
  "keywords": ["FirstStrike", "Vigilance", "Menace"],
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "CostChange",
        "filter": {
          "any_of": [
            { "subtypes": ["Cleric"] },
            { "subtypes": ["Rogue"] },
            { "subtypes": ["Warrior"] },
            { "subtypes": ["Wizard"] }
          ],
          "types": ["Creature"]
        },
        "whose": "You",
        "generic": -1
      }
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "BeginningOfStep",
        "step": "BeginCombat",
        "whose": "You"
      },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "PartySize", "who": { "type": "You" } }, "cmp": { "op": "Eq", "n": 4 } },
          "then": [
            { "type": "Pump", "what": { "type": "All", "filter": { "types": ["Creature"], "controller": "You" }, "zone": "Battlefield" }, "power": { "type": "Fixed", "n": 3 }, "toughness": { "type": "Fixed", "n": 0 }, "duration": "UntilEndOfTurn" }
          ],
          "else": [
            { "type": "Pump", "what": { "type": "All", "filter": { "types": ["Creature"], "controller": "You" }, "zone": "Battlefield" }, "power": { "type": "Fixed", "n": 1 }, "toughness": { "type": "Fixed", "n": 0 }, "duration": "UntilEndOfTurn" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "First strike, vigilance, menace\nCleric, Rogue, Warrior, and Wizard spells you cast cost {1} less to cast.\nAt the beginning of combat on your turn, creatures you control get +1/+0 until end of turn. If you have a full party, creatures you control get +3/+0 until end of turn instead."
}
