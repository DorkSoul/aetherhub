{
  "name": "Traveling Plague",
  "mana_cost": "{3}{B}{B}",
  "types": ["Enchantment"],
  "subtypes": ["Aura"],
  "abilities": [
    { "type": "Attach", "to": { "types": ["Creature"] } },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "effects": [ { "type": "AddCounters", "what": { "type": "This" }, "kind": "Plague", "n": { "type": "Fixed", "n": 1 } } ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "EnchantedGets",
        "power": { "type": "Minus", "a": { "type": "Fixed", "n": 0 }, "b": { "type": "CountersOn", "kind": "Plague", "of": { "type": "This" } } },
        "toughness": { "type": "Minus", "a": { "type": "Fixed", "n": 0 }, "b": { "type": "CountersOn", "kind": "Plague", "of": { "type": "This" } } }
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "LeavesBattlefield", "filter": { "attached_by_source": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "ControllerOf", "of": { "type": "TriggerObject" } },
          "zone": "Battlefield",
          "filter": { "types": ["Creature"] },
          "min": 1,
          "max": 1,
          "then": [
            { "type": "Move", "what": { "type": "This" }, "from": "Graveyard", "to": "Battlefield" },
            { "type": "Attach", "what": { "type": "This" }, "to": { "type": "Remembered" } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Enchant creature\nAt the beginning of each upkeep, put a plague counter on this Aura.\nEnchanted creature gets -1/-1 for each plague counter on this Aura.\nWhen enchanted creature leaves the battlefield, that creature's controller returns this Aura from its owner's graveyard to the battlefield."
