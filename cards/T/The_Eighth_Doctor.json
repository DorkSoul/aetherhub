{
  "name": "The Eighth Doctor",
  "mana_cost": "{4}{W}{U}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Time Lord", "Doctor"],
  "colors": ["W", "U"],
  "power": 4,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } } ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "MayPlayFrom",
        "zone": "Graveyard",
        "filter": {
          "types": ["Land", "Artifact", "Creature", "Enchantment", "Planeswalker", "Battle"],
          "any_of": [ { "types": ["Artifact"] }, { "supertypes": ["Legendary"] }, { "subtypes": ["Saga"] } ]
