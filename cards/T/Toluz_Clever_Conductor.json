{
  "name": "Toluz, Clever Conductor",
  "mana_cost": "{W/U}{U}{U/B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Rogue"],
  "power": 3,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Discard", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "not_types": ["Land"] } },
          "then": [ { "type": "AddCounters", "what": { "type": "This" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } } ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Discards", "who": "You" },
      "effects": [
        { "type": "Exile", "what": { "type": "TriggerObject" } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "this": true } },
      "effects": [
        { "type": "Move", "what": { "type": "ExiledWithThis" }, "to": "Hand" }
      ]
    }
  ],
  "oracle_text": "When Toluz, Clever Conductor enters, it connives. (Draw a card, then discard a card. If you discarded a nonland card, put a +1/+1 counter on this creature.)\nWhenever you discard one or more cards, exile them from your graveyard.\nWhen Toluz dies, put the cards exiled with it into their owner's hand."
}
