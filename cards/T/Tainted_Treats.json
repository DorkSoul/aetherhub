{
  "name": "Tainted Treats",
  "mana_cost": "{1}{B}{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact", "Creature"] } },
          "label": "target artifact or creature"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "ManaValueOf", "of": { "type": "Target", "idx": 0 } }, "cmp": { "op": "Le", "n": 4 } },
          "then": [
            { "type": "CreateToken", "token": "Food", "n": { "type": "Fixed", "n": 1 } }
          ]
        },
        {
          "type": "Destroy",
          "what": { "type": "Target", "idx": 0 }
        }
      ]
    }
  ],
  "oracle_text": "Destroy target artifact or creature. If its mana value was 4 or less, create a Food token. (It's an artifact with \"{2}, {T}, Sacrifice this token: You gain 3 life.\")"
}
