{
  "name": "Thought-Stalker Warlock",
  "mana_cost": "{2}{B}",
  "types": ["Creature"],
  "subtypes": ["Lizard", "Warlock"],
  "power": 2,
  "toughness": 2,
  "keywords": ["Menace"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "LifeLostThisTurn", "who": { "type": "Target", "idx": 0 } }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "from": { "type": "Target", "idx": 0 },
              "zone": "Hand",
              "min": 1,
              "max": 1,
              "filter": { "not_types": ["Land"] },
              "then": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Graveyard", "discard": true }
              ]
            }
          ],
          "else": [
            { "type": "Discard", "who": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Menace (This creature can't be blocked except by two or more creatures.)\nWhen this creature enters, choose target opponent. If they lost life this turn, they reveal their hand, you choose a nonland card from it, and they discard that card. Otherwise, they discard a card."
}
