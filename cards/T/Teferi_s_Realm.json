{
  "name": "Teferi's Realm",
  "mana_cost": "{1}{U}{U}",
  "types": ["Enchantment"],
  "supertypes": ["World"],
  "abilities": [
    { "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "effects": [
        { "type": "May", "who": { "type": "TriggerPlayer" },
          "effects": [ { "type": "PhaseOut", "what": { "type": "All", "filter": { "types": ["Artifact"], "token": false } } } ],
          "otherwise": [
            { "type": "May", "who": { "type": "TriggerPlayer" },
              "effects": [ { "type": "PhaseOut", "what": { "type": "All", "filter": { "types": ["Creature"], "token": false } } } ],
              "otherwise": [
                { "type": "May", "who": { "type": "TriggerPlayer" },
                  "effects": [ { "type": "PhaseOut", "what": { "type": "All", "filter": { "types": ["Land"], "token": false } } } ],
                  "otherwise": [ { "type": "PhaseOut", "what": { "type": "All", "filter": { "types": ["Enchantment"], "not_subtypes": ["Aura"], "token": false } } } ] } ] } ] }
      ] }
  ],
  "oracle_text": "At the beginning of each player's upkeep, that player chooses artifact, creature, land, or non-Aura enchantment. All nontoken permanents of that type phase out. (While they're phased out, they're treated as though they don't exist. Each one phases in before its controller untaps during their next untap step.)"
}
