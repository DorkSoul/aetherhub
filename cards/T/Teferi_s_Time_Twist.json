{
  "name": "Teferi's Time Twist",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "controller": "You" } }, "label": "target permanent you control" } ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "Delayed",
          "at": "NextEndStep",
          "effects": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "remember": true },
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "types": ["Creature"] } },
              "then": [ { "type": "AddCounters", "what": { "type": "Remembered" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } } ],
              "else": []
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile target permanent you control. Return that card to the battlefield under its owner's control at the beginning of the next end step. If it enters as a creature, it enters with an additional +1/+1 counter on it."
}
