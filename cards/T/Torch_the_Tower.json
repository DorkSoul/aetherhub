{
  "name": "Torch the Tower",
  "mana_cost": "{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [{ "type": "Sacrifice", "n": 1, "filter": { "controller": "You", "any_of": [ { "types": ["Artifact"] }, { "types": ["Enchantment"] }, { "token": true } ] } }],
      "multi": false
    },
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature", "Planeswalker"] } }, "label": "target creature or planeswalker" }
      ],
      "effects": [
        { "type": "ExileInsteadOfDying", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 3 }, "to": { "type": "Target", "idx": 0 }, "source": { "type": "This" } },
            { "type": "Scry", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": [
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 2 }, "to": { "type": "Target", "idx": 0 }, "source": { "type": "This" } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Bargain (You may sacrifice an artifact, enchantment, or token as you cast this spell.)\nTorch the Tower deals 2 damage to target creature or planeswalker. If this spell was bargained, instead it deals 3 damage to that permanent and you scry 1.\nIf a permanent dealt damage by Torch the Tower would die this turn, exile it instead."
}
