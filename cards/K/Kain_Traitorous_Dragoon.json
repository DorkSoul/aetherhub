{
  "name": "Kain, Traitorous Dragoon",
  "mana_cost": "{2}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Knight"],
  "power": 2,
  "toughness": 4,
  "abilities": [
    {
      "type": "Static",
      "effect": { "type": "GrantKeyword", "affects": { "this": true }, "keyword": "Flying" },
      "condition": { "type": "YourTurn" }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "DealsDamage", "combat": true, "to": "Player", "filter": { "this": true } },
      "effects": [
        { "type": "GainControl", "what": { "type": "This" }, "to": { "type": "TriggerPlayer" }, "duration": "Forever" },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "TriggerPlayer" }, "filter": { "this": true }, "at_least": 1 },
          "then": [
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "EventAmount" } },
            { "type": "CreateToken", "token": "Treasure", "tapped": true, "n": { "type": "EventAmount" } },
            { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "EventAmount" } }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Jump — During your turn, Kain has flying.\nWhenever Kain deals combat damage to a player, that player gains control of Kain. If they do, you draw that many cards, create that many tapped Treasure tokens, then lose that much life."
}
