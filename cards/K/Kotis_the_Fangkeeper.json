{
  "name": "Kotis, the Fangkeeper",
  "mana_cost": "{1}{B}{G}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Zombie", "Warrior"],
  "power": 2,
  "toughness": 1,
  "keywords": ["Indestructible"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "CombatDamageToPlayer", "filter": { "this": true } },
      "effects": [
        {
          "type": "LookAtTop",
          "who": { "type": "TriggerPlayer" },
          "n": { "type": "EventAmount" },
          "filter": {},
          "take": 0,
          "all": true,
          "rest": "Library",
          "to": "Exile"
        },
        {
          "type": "ForEach",
          "objects": { "type": "Remembered" },
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "CompareAmounts",
                "a": { "type": "ManaValueOf", "of": { "type": "EachObject" } },
                "op": "Le",
                "b": { "type": "EventAmount" }
              },
              "then": [ { "type": "CastFree", "what": { "type": "EachObject" }, "may": true } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Indestructible\nWhenever Kotis deals combat damage to a player, exile the top X cards of their library, where X is the amount of damage dealt. You may cast any number of spells with mana value X or less from among them without paying their mana costs."
}
