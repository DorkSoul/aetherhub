{
  "name": "Kenessos, Priest of Thassa",
  "mana_cost": "{1}{U}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Merfolk", "Cleric"],
  "power": 1,
  "toughness": 3,
  "abilities": [
    { "type": "Replace", "what": { "type": "Scry", "who": "You", "add": 1 } },
    {
      "type": "Activated",
      "cost": [ { "type": "Mana", "cost": "{3}{G/U}" } ],
      "effects": [
        {
          "type": "LookAtTop",
          "who": { "type": "You" },
          "n": { "type": "Fixed", "n": 1 },
          "filter": {
            "types": ["Creature"],
            "any_of": [ { "subtypes": ["Kraken"] }, { "subtypes": ["Leviathan"] }, { "subtypes": ["Octopus"] }, { "subtypes": ["Serpent"] } ]
          },
          "take": 1,
          "must": false,
          "to": "Battlefield",
          "rest": "Library",
          "keep_on_top": true
        },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "among_remembered": true } },
          "then": [],
          "else": [
            {
              "type": "May",
              "effects": [ { "type": "Move", "what": { "type": "TopOfLibrary", "who": { "type": "You" } }, "to": "Library" } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "If you would scry a number of cards, scry that many cards plus one instead.\n{3}{G/U}: Look at the top card of your library. If it's a Kraken, Leviathan, Octopus, or Serpent creature card, you may put it onto the battlefield. If you don't put the card onto the battlefield, you may put it on the bottom of your library."
}
