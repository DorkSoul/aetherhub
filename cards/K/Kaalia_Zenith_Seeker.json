{
  "name": "Kaalia, Zenith Seeker",
  "mana_cost": "{R}{W}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Cleric"],
  "power": 3,
  "toughness": 3,
  "keywords": ["Flying", "Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 6 }, "filter": {}, "take": 6, "all": true, "to": "Exile", "rest": "Library" },
        { "type": "Choose", "who": { "type": "You" }, "zone": "Exile", "filter": { "exiled_with_this": true, "subtypes": ["Angel"] }, "min": 0, "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "from": "Exile", "to": "Hand" } ] },
        { "type": "Choose", "who": { "type": "You" }, "zone": "Exile", "filter": { "exiled_with_this": true, "subtypes": ["Demon"] }, "min": 0, "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "from": "Exile", "to": "Hand" } ] },
        { "type": "Choose", "who": { "type": "You" }, "zone": "Exile", "filter": { "exiled_with_this": true, "subtypes": ["Dragon"] }, "min": 0, "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "from": "Exile", "to": "Hand" } ] },
        { "type": "Move", "what": { "type": "ExiledWithThis" }, "from": "Exile", "to": "Library", "top_of_library": true, "remember": true },
        { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "RememberedCount" }, "filter": {}, "take": 0, "rest": "Library", "random_rest": true }
      ]
    }
  ],
  "oracle_text": "Flying, vigilance\nWhen Kaalia enters, look at the top six cards of your library. You may reveal an Angel card, a Demon card, and/or a Dragon card from among them and put them into your hand. Put the rest on the bottom of your library in a random order."
}
