{
  "name": "Kolodin, Triumph Caster",
  "mana_cost": "{R}{W}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Human", "Pilot"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "GrantKeyword",
        "affects": {
          "controller": "You",
          "any_of": [
            {"subtypes": ["Mount"]},
            {"subtypes": ["Vehicle"]}
          ]
        },
        "keyword": "Haste"
      }
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "EntersBattlefield",
        "filter": {"controller": "You", "subtypes": ["Mount"]}
      },
      "effects": [
        {"type": "SaddleTargets", "what": {"type": "TriggerObject"}}
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "EntersBattlefield",
        "filter": {"controller": "You", "subtypes": ["Vehicle"]}
      },
      "effects": [
        {
          "type": "Animate",
          "what": {"type": "TriggerObject"},
          "add_types": ["Artifact", "Creature"],
          "duration": "UntilEndOfTurn"
        }
      ]
    }
  ],
  "oracle_text": "Mounts and Vehicles you control have haste.\nWhenever a Mount you control enters, it becomes saddled until end of turn.\nWhenever a Vehicle you control enters, it becomes an artifact creature until end of turn."
}
