{
  "name": "Kor Dirge",
  "mana_cost": "{2}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" },
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "another target creature", "distinct": true }
      ],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "PreventDamage",
              "to": { "type": "Target", "idx": 0 },
              "from": { "type": "Remembered" },
              "redirect_to": { "type": "Target", "idx": 1 }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "All damage that would be dealt this turn to target creature you control by a source of your choice is dealt to another target creature instead."
}
