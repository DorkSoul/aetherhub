{
  "name": "Kaalia of the Vast",
  "mana_cost": "{1}{R}{W}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Cleric"],
  "power": 2,
  "toughness": 2,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "Attacks",
        "filter": { "this": true },
        "player_only": true,
        "at_opponent": true
      },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Hand",
          "min": 0,
          "max": 1,
          "filter": {
            "types": ["Creature"],
            "any_of": [
              { "subtypes": ["Angel"] },
              { "subtypes": ["Demon"] },
              { "subtypes": ["Dragon"] }
            ]
          },
          "then": [
            {
              "type": "Move",
              "what": { "type": "Remembered" },
              "to": "Battlefield",
              "tapped": true,
              "attacking": true
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhenever Kaalia attacks an opponent, you may put an Angel, Demon, or Dragon creature card from your hand onto the battlefield tapped and attacking that opponent."
}
