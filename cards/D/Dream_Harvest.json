{
  "name": "Dream Harvest",
  "mana_cost": "{5}{U/B}{U/B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "ForEachPlayer", "players": { "type": "EachOpponent" }, "effects": [
          { "type": "ClearRemembered" },
          { "type": "StoreRemembered", "slot": 0 },
          { "type": "RepeatWhile",
            "cond": { "type": "Compare",
                      "a": { "type": "TotalManaValue", "filter": { "among_stored": 0 }, "zone": "Exile" },
                      "cmp": { "op": "Lt", "n": 5 } },
            "max": 255,
            "effects": [
              { "type": "Move", "what": { "type": "TopOfLibrary", "who": { "type": "EachObject" }, "n": 1 },
                "to": "Exile", "remember": true },
              { "type": "StoreRemembered", "slot": 0, "append": true }
            ] },
          { "type": "GrantPlayFromExile", "what": { "type": "Stored", "slot": 0 },
            "by": { "type": "You" }, "window": "ThisTurn", "free": true }
        ] }
      ]
    }
  ],
  "oracle_text": "Each opponent exiles cards from the top of their library until they have exiled cards with total mana value 5 or greater this way. Until end of turn, you may cast cards exiled this way without paying their mana costs."
