{
  "name": "Don't Blink",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "AddReplacement",
          "what": {
            "type": "ZoneChange",
            "from": "Exile",
            "to": "Battlefield",
            "instead": "Library",
            "filter": { "types": ["Creature"] },
            "then": [ { "type": "Shuffle", "who": { "type": "TriggerPlayer" } } ]
          }
        },
        {
          "type": "AddReplacement",
          "what": {
            "type": "ZoneChange",
            "from": "Stack",
            "to": "Battlefield",
            "instead": "Library",
            "filter": { "types": ["Creature"], "cast_from": "Exile" },
            "then": [ { "type": "Shuffle", "who": { "type": "TriggerPlayer" } } ]
          }
        }
      ]
    },
    {
      "type": "Activated",
      "from": "Hand",
      "cost": [ { "type": "Mana", "cost": "{2}" }, { "type": "DiscardSelf" } ],
      "effects": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ]
    }
  ],
  "keywords": ["Cycling"],
  "oracle_text": "Until end of turn, if one or more creatures would enter from exile or after being cast from exile, their owners shuffle them into their libraries instead.\nCycling {2} ({2}, Discard this card: Draw a card.)"
}
