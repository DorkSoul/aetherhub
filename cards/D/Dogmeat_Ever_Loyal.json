{
  "name": "Dogmeat, Ever Loyal",
  "mana_cost": "{R}{G}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Dog"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Mill", "n": { "type": "Fixed", "n": 5 }, "who": { "type": "You" } },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "any_of": [ { "subtypes": ["Aura"] }, { "subtypes": ["Equipment"] } ], "owner": "You" },
          "min": 1,
          "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "from": "Graveyard", "to": "Hand" } ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "Attacks",
        "filter": { "types": ["Creature"], "controller": "You", "enchanted_or_equipped": true }
      },
      "effects": [ { "type": "CreateToken", "token": "Junk", "n": { "type": "Fixed", "n": 1 } } ]
    }
  ],
  "oracle_text": "When Dogmeat enters, mill five cards, then return an Aura or Equipment card from your graveyard to your hand.\nWhenever a creature you control that's enchanted or equipped attacks, create a Junk token. (It's an artifact with \"{T}, Sacrifice this token: Exile the top card of your library. You may play that card this turn. Activate only as a sorcery.\")"
}
