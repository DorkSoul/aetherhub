{
  "name": "Desolation Angel",
  "mana_cost": "{3}{B}{B}",
  "types": ["Creature"],
  "subtypes": ["Angel"],
  "power": 5,
  "toughness": 4,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [{ "type": "Mana", "cost": "{W}{W}" }]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [
            {
              "type": "Destroy",
              "what": { "type": "All", "filter": { "types": ["Land"] }, "zone": "Battlefield" }
            }
          ],
          "else": [
            {
              "type": "Destroy",
              "what": { "type": "All", "filter": { "types": ["Land"], "controller": "You" }, "zone": "Battlefield" }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Kicker {W}{W} (You may pay an additional {W}{W} as you cast this spell.)\nFlying\nWhen this creature enters, destroy all lands you control. If it was kicked, destroy all lands instead."
