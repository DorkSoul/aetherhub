{
  "name": "Daring Archaeologist",
  "mana_cost": "{3}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Artificer"],
  "colors": ["W"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Artifact"] }, "whose": "You" },
          "label": "target artifact card in your graveyard"
        }
      ],
      "effects": [{ "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" }]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": {
          "any_of": [
            { "types": ["Artifact"] },
            { "supertypes": ["Legendary"] },
            { "subtypes": ["Saga"] }
          ]
        }
      },
      "effects": [
        {
          "type": "AddCounters",
          "kind": "PlusOnePlusOne",
          "n": { "type": "Fixed", "n": 1 },
          "what": { "type": "This" }
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you may return target artifact card from your graveyard to your hand.\nWhenever you cast a historic spell, put a +1/+1 counter on this creature. (Artifacts, legendaries, and Sagas are historic.)"
}
