{
  "name": "Dream Tides",
  "mana_cost": "{2}{U}{U}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Static",
      "effect": { "type": "DoesntUntap", "filter": { "types": ["Creature"] } }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "TriggerPlayer" },
          "zone": "Battlefield",
          "filter": { "types": ["Creature"], "tapped": true, "not_colors": ["G"], "controller": "You" },
          "min": 0,
          "max": 255,
          "then": [
            {
              "type": "ForEach",
              "objects": { "type": "Remembered" },
              "effects": [
                {
                  "type": "MayPay",
                  "payer": { "type": "TriggerPlayer" },
                  "cost": [ { "type": "Mana", "cost": "{2}" } ],
                  "effects": [
                    { "type": "Untap", "what": { "type": "EachObject" } }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Creatures don't untap during their controllers' untap steps.\nAt the beginning of each player's upkeep, that player may choose any number of tapped nongreen creatures they control and pay {2} for each creature chosen this way. If the player does, untap those creatures."
}
