{
  "name": "Delayed Blast Fireball",
  "mana_cost": "{1}{R}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": { "type": "CastFrom", "zone": "Exile" },
          "then": [
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 5 }, "to": { "type": "EachOpponent" } },
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 5 }, "to": { "type": "All", "filter": { "types": ["Creature"], "controller": "Opponent" }, "zone": "Battlefield" } }
