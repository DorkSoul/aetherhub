{
  "name": "Dead Ringers",
  "mana_cost": "{4}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "not_colors": ["B"] } },
          "label": "target nonblack creature"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "not_colors": ["B"] } },
          "distinct": true,
          "label": "another target nonblack creature"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "All",
            "cs": [
              {
                "type": "AnyOf",
                "cs": [
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "colors": ["W"] } }, { "type": "TargetIs", "idx": 1, "filter": { "colors": ["W"] } } ] },
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "not_colors": ["W"] } }, { "type": "TargetIs", "idx": 1, "filter": { "not_colors": ["W"] } } ] }
                ]
              },
              {
                "type": "AnyOf",
                "cs": [
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "colors": ["U"] } }, { "type": "TargetIs", "idx": 1, "filter": { "colors": ["U"] } } ] },
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "not_colors": ["U"] } }, { "type": "TargetIs", "idx": 1, "filter": { "not_colors": ["U"] } } ] }
                ]
              },
              {
                "type": "AnyOf",
                "cs": [
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "colors": ["B"] } }, { "type": "TargetIs", "idx": 1, "filter": { "colors": ["B"] } } ] },
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "not_colors": ["B"] } }, { "type": "TargetIs", "idx": 1, "filter": { "not_colors": ["B"] } } ] }
                ]
              },
              {
                "type": "AnyOf",
                "cs": [
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "colors": ["R"] } }, { "type": "TargetIs", "idx": 1, "filter": { "colors": ["R"] } } ] },
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "not_colors": ["R"] } }, { "type": "TargetIs", "idx": 1, "filter": { "not_colors": ["R"] } } ] }
                ]
              },
              {
                "type": "AnyOf",
                "cs": [
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "colors": ["G"] } }, { "type": "TargetIs", "idx": 1, "filter": { "colors": ["G"] } } ] },
                  { "type": "All", "cs": [ { "type": "TargetIs", "idx": 0, "filter": { "not_colors": ["G"] } }, { "type": "TargetIs", "idx": 1, "filter": { "not_colors": ["G"] } } ] }
                ]
              }
            ]
          },
          "then": [
            { "type": "Destroy", "what": { "type": "Target", "idx": 0 }, "no_regeneration": true },
            { "type": "Destroy", "what": { "type": "Target", "idx": 1 }, "no_regeneration": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Destroy two target nonblack creatures unless either one is a color the other isn't. They can't be regenerated."
}
