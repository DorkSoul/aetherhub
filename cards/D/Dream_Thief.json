{
  "name": "Dream Thief",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "subtypes": ["Faerie", "Rogue"],
  "power": 2,
  "toughness": 1,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "AnyOf",
            "cs": [
              { "type": "CastThisTurn", "filter": { "colors": ["U"] }, "at_least": 2 },
              {
                "type": "All",
                "cs": [
                  { "type": "CastThisTurn", "filter": { "colors": ["U"] }, "at_least": 1 },
                  { "type": "Not", "c": { "type": "CastThisTurn", "filter": { "this": true }, "at_least": 1 } }
                ]
              }
            ]
          },
          "then": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhen this creature enters, draw a card if you've cast another blue spell this turn."
}
