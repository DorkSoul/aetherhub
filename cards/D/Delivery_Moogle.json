{
  "name": "Delivery Moogle",
  "mana_cost": "{3}{W}",
  "types": ["Creature"],
  "subtypes": ["Moogle"],
  "power": 3,
  "toughness": 2,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Library",
          "filter": { "types": ["Artifact"], "mana_value": { "op": "Le", "n": 2 } },
          "min": 0,
          "max": 1,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" },
            {
              "type": "If",
              "cond": { "type": "SelIs", "what": { "type": "Remembered" }, "filter": {} },
              "then": [{ "type": "Shuffle", "who": { "type": "You" } }]
            }
          ]
        },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "types": ["Artifact"], "mana_value": { "op": "Le", "n": 2 } },
          "min": 0,
          "max": 1,
          "then": [{ "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" }]
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhen this creature enters, search your library and/or graveyard for an artifact card with mana value 2 or less, reveal it, and put it into your hand. If you search your library this way, shuffle."
}
