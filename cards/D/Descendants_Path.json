{
  "name": "Descendants' Path",
  "mana_cost": "{2}{G}",
  "types": ["Enchantment"],
  "colors": ["G"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "You" },
      "effects": [
        { "type": "RevealTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": {
            "type": "SelIs",
            "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 },
            "filter": {
              "types": ["Creature"],
              "shares_type_with": { "type": "All", "filter": { "types": ["Creature"], "controller": "You" } }
            }
          },
          "then": [
            { "type": "CastFree", "what": { "type": "Remembered" }, "may": true, "decline_to_bottom": true }
          ],
          "else": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Library" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "At the beginning of your upkeep, reveal the top card of your library. If it's a creature card that shares a creature type with a creature you control, you may cast it without paying its mana cost. If you don't cast it, put it on the bottom of your library."
}
