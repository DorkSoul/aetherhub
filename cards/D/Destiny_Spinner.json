{
  "name": "Destiny Spinner",
  "mana_cost": "{1}{G}",
  "types": ["Enchantment", "Creature"],
  "subtypes": ["Human"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "CantBeCountered",
        "filter": {
          "any_of": [
            { "types": ["Creature"], "controller": "You" },
            { "types": ["Enchantment"], "controller": "You" }
          ]
        }
      }
    },
    {
      "type": "Activated",
      "cost": [{ "type": "Mana", "cost": "{3}{G}" }],
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": { "types": ["Land"], "controller": "You" }
          },
          "label": "target land you control"
        }
      ],
      "effects": [
        {
          "type": "Animate",
          "what": { "type": "Target", "idx": 0 },
          "duration": "UntilEndOfTurn",
          "add_types": ["Creature"],
          "add_subtypes": ["Elemental"],
          "keywords": ["Trample", "Haste"]
        },
        {
          "type": "SetBasePT",
          "what": { "type": "Target", "idx": 0 },
          "power": { "type": "Count", "filter": { "types": ["Enchantment"], "controller": "You" }, "zone": "Battlefield" },
          "toughness": { "type": "Count", "filter": { "types": ["Enchantment"], "controller": "You" }, "zone": "Battlefield" },
          "duration": "UntilEndOfTurn"
        }
      ]
    }
  ],
  "oracle_text": "Creature and enchantment spells you control can't be countered.\n{3}{G}: Target land you control becomes an X/X Elemental creature with trample and haste until end of turn, where X is the number of enchantments you control. It's still a land."
}
