{
  "name": "Donal, Herald of Wings",
  "mana_cost": "{2}{U}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Wizard"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": { "types": ["Creature"], "keywords": ["Flying"], "not_supertypes": ["Legendary"] }
      },
      "optional": true,
      "once_per_turn": true,
      "effects": [
        {
          "type": "CopySpell",
          "what": { "type": "TriggerObject" },
          "except": [
            { "type": "AddSubtype", "subtype": "Spirit" },
            { "type": "SetPT", "power": 1, "toughness": 1 }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever you cast a nonlegendary creature spell with flying, you may copy it, except the copy is a 1/1 Spirit in addition to its other types. Do this only once each turn. (The copy becomes a token.)"
}
