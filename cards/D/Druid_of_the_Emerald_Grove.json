{
  "name": "Druid of the Emerald Grove",
  "mana_cost": "{3}{G}",
  "types": ["Creature"],
  "subtypes": ["Dwarf", "Druid"],
  "colors": ["G"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": { "types": ["Land"], "supertypes": ["Basic"] },
          "n": { "type": "Fixed", "n": 2 },
          "to": "Exile",
          "reveal": true,
          "shuffle": true
        },
        {
          "type": "RollDie",
          "sides": 20,
          "outcomes": [
            {
              "min": 1,
              "max": 9,
              "effects": [
                { "type": "Move", "what": { "type": "ExiledWithThis" }, "from": "Exile", "to": "Hand" }
              ]
            },
            {
              "min": 10,
              "max": 19,
              "effects": [
                {
                  "type": "Choose",
                  "who": { "type": "You" },
                  "zone": "Exile",
                  "filter": { "exiled_with_this": true },
                  "min": 1,
                  "max": 1,
                  "then": [
                    { "type": "Move", "what": { "type": "Remembered" }, "from": "Exile", "to": "Battlefield", "tapped": true }
                  ]
                },
                { "type": "Move", "what": { "type": "ExiledWithThis" }, "from": "Exile", "to": "Hand" }
              ]
            },
            {
              "min": 20,
              "max": 20,
              "effects": [
                { "type": "Move", "what": { "type": "ExiledWithThis" }, "from": "Exile", "to": "Battlefield", "tapped": true }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, search your library for up to two basic land cards and reveal them, then roll a d20.\n1–9 | Put those cards into your hand, then shuffle.\n10–19 | Put one of those cards onto the battlefield tapped and the other into your hand, then shuffle.\n20+ | Put those cards onto the battlefield tapped, then shuffle."
}
