{
  "name": "Dack Fayden, Helping Hand",
  "mana_cost": "{4}{W}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Advisor"],
  "power": 4,
  "toughness": 6,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "RevealUntil",
          "who": { "type": "You" },
          "filter": { "types": ["Creature"] },
          "count": { "type": "OpponentCount" },
          "to": "Battlefield",
          "rest": "Library"
        },
        { "type": "StoreRemembered", "slot": 1 },
        { "type": "Shuffle", "who": { "type": "You" } },
        { "type": "Goad", "what": { "type": "Stored", "slot": 1 }, "forever": true },
        {
          "type": "ForEach",
          "objects": { "type": "Stored", "slot": 1 },
          "effects": [
            { "type": "ChoosePlayer", "who": { "type": "You" }, "opponent": true, "exclude": { "type": "ControllerOf", "of": { "type": "Stored", "slot": 1 } } },
            { "type": "GainControl", "what": { "type": "EachObject" }, "to": { "type": "ChosenPlayer" }, "duration": "Forever" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When Dack Fayden enters, reveal cards from the top of your library until you reveal X creature cards, where X is the number of opponents you have. Put those creature cards onto the battlefield, then shuffle. They're goaded for the rest of the game. For each of those permanents, choose a different opponent. Each opponent gains control of the permanent for which they were chosen."
}
