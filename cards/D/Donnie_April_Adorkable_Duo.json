                  "effects": [
                    { "type": "Draw", "who": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 2 } },
                    {
                      "type": "Choose",
                      "who": { "type": "Target", "idx": 1 },
                      "zone": "Graveyard",
                      "from": { "type": "Target", "idx": 1 },
                      "filter": { "types": ["Artifact", "Instant", "Sorcery"] },
                      "min": 1,
                      "max": 1,
                      "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" } ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When Donnie & April enter, choose one or both. Each mode must target a different player.\n• Target player draws two cards.\n• Target player returns an artifact, instant, or sorcery card from their graveyard to their hand."
