{
  "name": "Dragon's Disciple",
  "mana_cost": "{1}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Monk"],
  "power": 1,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "who": { "type": "You" },
            "filter": { "subtypes": ["Dragon"], "controller": "You" },
            "at_least": 1
          },
          "then": [
            { "type": "AddCounters", "kind": "PlusOnePlusOne", "what": { "type": "This" }, "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": [
            {
              "type": "MayPay",
              "payer": { "type": "You" },
              "cost": [ { "type": "Reveal", "filter": { "subtypes": ["Dragon"] } } ],
              "effects": [
                { "type": "AddCounters", "kind": "PlusOnePlusOne", "what": { "type": "This" }, "n": { "type": "Fixed", "n": 1 } }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "GrantAbility",
        "affects": { "subtypes": ["Dragon"], "controller": "You" },
        "ability": { "type": "Ward", "cost": [ { "type": "Mana", "cost": "{1}" } ] }
      }
    }
  ],
  "oracle_text": "As this creature enters, you may reveal a Dragon card from your hand. If you do or if you control a Dragon, this creature enters with a +1/+1 counter on it.\nDragons you control have ward {1}. (Whenever a Dragon you control becomes the target of a spell or ability an opponent controls, counter it unless that player pays {1}.)"
}
