{
  "name": "Disorienting Choice",
  "mana_cost": "{3}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": {
              "any_of": [
                { "types": ["Artifact"], "controller": "Opponent" },
                { "types": ["Enchantment"], "controller": "Opponent" }
              ]
            }
          },
          "min": 0,
          "max": 1,
          "per_opponent": true,
          "label": "up to one artifact or enchantment each opponent controls"
        }
      ],
      "effects": [
        { "type": "ClearRemembered" },
        { "type": "ForEach", "objects": { "type": "Targets" }, "effects": [
          { "type": "StoreRemembered", "slot": 1, "append": true }
        ] },
        { "type": "ForEach", "objects": { "type": "Targets" }, "effects": [
          { "type": "May", "who": { "type": "ControllerOf", "of": { "type": "Remembered" } },
            "effects": [ { "type": "StoreRemembered", "slot": 0, "append": true } ] }
        ] },
        { "type": "Exile", "what": { "type": "Stored", "slot": 0 } },
        { "type": "If",
          "cond": { "type": "Compare",
            "a": { "type": "Count", "filter": { "among_stored": 1 }, "zone": "Battlefield" },
            "cmp": { "op": "Ge", "n": 1 } },
          "then": [
            { "type": "SearchLibrary", "who": { "type": "You" }, "filter": { "types": ["Land"] },
              "n": { "type": "Count", "filter": { "among_stored": 1 }, "zone": "Battlefield" },
              "to": "Battlefield", "tapped": true, "shuffle": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "For each opponent, choose up to one target artifact or enchantment that player controls. For each permanent chosen this way, its controller may exile it. Then if one or more of the chosen permanents are still on the battlefield, you search your library for up to that many land cards, put them onto the battlefield tapped, then shuffle."
}
