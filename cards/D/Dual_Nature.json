{
  "name": "Dual Nature",
  "mana_cost": "{4}{G}{G}",
  "types": ["Enchantment"],
  "colors": ["G"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "types": ["Creature"], "token": false } },
      "effects": [
        { "type": "CopyPermanent", "what": { "type": "TriggerObject" }, "n": { "type": "Fixed", "n": 1 }, "by": { "type": "ControllerOf", "of": { "type": "TriggerObject" } } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "LeavesBattlefield", "filter": { "types": ["Creature"], "token": false } },
      "effects": [
        { "type": "Exile", "what": { "type": "All", "filter": { "token": true, "same_name_as": { "type": "TriggerObject" } }, "zone": "Battlefield" } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "LeavesBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Exile", "what": { "type": "All", "filter": { "token": true, "created_by_source": true }, "zone": "Battlefield" } }
      ]
    }
  ],
  "oracle_text": "Whenever a nontoken creature enters, its controller creates a token that's a copy of that creature.\nWhenever a nontoken creature leaves the battlefield, exile all tokens with the same name as that creature.\nWhen this enchantment leaves the battlefield, exile all tokens created with this enchantment."
}
