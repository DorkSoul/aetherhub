{
  "name": "Dire Tactics",
  "mana_cost": "{W}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" } ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "subtypes": ["Human"] } } },
          "then": [
            { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "ToughnessOf", "of": { "type": "Target", "idx": 0 } } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile target creature. If you don't control a Human, you lose life equal to that creature's toughness."
}
