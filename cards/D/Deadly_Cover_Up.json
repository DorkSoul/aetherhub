{
  "name": "Deadly Cover-Up",
  "mana_cost": "{3}{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    { "type": "Kicker", "cost": [ { "type": "CollectEvidence", "n": 6 } ], "multi": false },
    { "type": "Spell",
      "effects": [
        { "type": "Destroy", "what": { "type": "All", "filter": { "types": ["Creature"] } } },
        { "type": "If",
          "cond": { "type": "Kicked" },
          "then": [
            { "type": "Choose", "who": { "type": "You" }, "from": { "type": "EachOpponent" }, "zone": "Graveyard",
              "filter": { "controller": "Any" }, "min": 1, "max": 1,
              "then": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Exile", "remember": true },
                { "type": "ForEach", "objects": { "type": "Remembered" }, "effects": [
                  { "type": "ExileFromZones", "who": { "type": "OwnerOf", "of": { "type": "EachObject" } },
                    "zones": ["Graveyard"], "filter": { "same_name_as": { "type": "EachObject" } }, "max": null },
                  { "type": "ExileFromZones", "who": { "type": "OwnerOf", "of": { "type": "EachObject" } },
                    "zones": ["Library"], "filter": { "same_name_as": { "type": "EachObject" } }, "max": null },
                  { "type": "ExileFromZones", "who": { "type": "OwnerOf", "of": { "type": "EachObject" } },
                    "zones": ["Hand"], "filter": { "same_name_as": { "type": "EachObject" } }, "max": null },
                  { "type": "Draw", "who": { "type": "OwnerOf", "of": { "type": "EachObject" } }, "n": { "type": "RememberedCount" } }
                ] }
              ] }
          ] }
      ] }
  ],
  "oracle_text": "As an additional cost to cast this spell, you may collect evidence 6.\nDestroy all creatures. If evidence was collected, exile a card from an opponent's graveyard. Then search its owner's graveyard, hand, and library for any number of cards with that name and exile them. That player shuffles, then draws a card for each card exiled from their hand this way."
}
