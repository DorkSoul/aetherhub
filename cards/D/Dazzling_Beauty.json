{
  "name": "Dazzling Beauty",
  "mana_cost": "{2}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "CastOnlyIf",
      "condition": { "type": "InStep", "step": "DeclareBlockers" }
    },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "attacking": true, "unblocked": true } },
          "label": "target unblocked attacking creature"
        }
      ],
      "effects": [
        { "type": "BecomeBlocked", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "Delayed",
          "at": "NextUpkeep",
          "effects": [
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Cast this spell only during the declare blockers step.\nTarget unblocked attacking creature becomes blocked. (This spell works on creatures that can't be blocked.)\nDraw a card at the beginning of the next turn's upkeep."
