{
  "name": "Decoy Gambit",
  "mana_cost": "{2}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "min": 0,
          "max": 1,
          "per_opponent": true,
          "label": "up to one creature each opponent controls"
        }
      ],
      "effects": [
        { "type": "ClearRemembered" },
        { "type": "StoreRemembered", "slot": 0, "append": false },
        { "type": "StoreRemembered", "slot": 1, "append": false },
        {
          "type": "ForEach",
          "objects": { "type": "Targets" },
          "effects": [
            {
              "type": "May",
              "who": { "type": "ControllerOf", "of": { "type": "EachObject" } },
              "effects": [ { "type": "StoreRemembered", "slot": 0, "append": true } ],
              "otherwise": [ { "type": "StoreRemembered", "slot": 1, "append": true } ]
            }
          ]
        },
        {
          "type": "Draw",
          "who": { "type": "You" },
          "n": { "type": "CountSel", "of": { "type": "Stored", "slot": 0 } }
        },
        { "type": "Move", "what": { "type": "Stored", "slot": 1 }, "to": "Hand" }
      ]
    }
  ],
  "oracle_text": "For each opponent, choose up to one target creature that player controls, then return that creature to its owner's hand unless its controller has you draw a card."
}
