{
  "name": "Divergent Transformations",
  "mana_cost": "{6}{R}",
  "types": ["Instant"],
  "keywords": ["Undaunted"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "min": 2, "max": 2, "label": "two target creatures" }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Targets" } },
        {
          "type": "ForEach",
          "objects": { "type": "Targets" },
          "effects": [
            {
              "type": "RevealUntil",
              "who": { "type": "ControllerOf", "of": { "type": "EachObject" } },
              "filter": { "types": ["Creature"] },
              "to": "Battlefield",
              "rest": "Library",
              "rest_random": true
            },
            { "type": "Shuffle", "who": { "type": "ControllerOf", "of": { "type": "EachObject" } } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Undaunted (This spell costs {1} less to cast for each opponent.)\nExile two target creatures. For each of those creatures, its controller reveals cards from the top of their library until they reveal a creature card, puts that card onto the battlefield, then shuffles the rest into their library."
}
