{
  "name": "District Guide",
  "mana_cost": "{2}{G}",
  "types": ["Creature"],
  "subtypes": ["Elf", "Scout"],
  "colors": ["G"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": { "any_of": [ { "types": ["Land"], "supertypes": ["Basic"] }, { "subtypes": ["Gate"] } ] },
          "n": { "type": "Fixed", "n": 1 },
          "to": "Hand",
          "reveal": true,
          "shuffle": true
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you may search your library for a basic land card or Gate card, reveal it, put it into your hand, then shuffle."
}
