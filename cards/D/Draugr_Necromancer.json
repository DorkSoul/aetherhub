{
  "name": "Draugr Necromancer",
  "mana_cost": "{3}{B}",
  "types": ["Creature"],
  "supertypes": ["Snow"],
  "subtypes": ["Zombie", "Cleric"],
  "power": 4,
  "toughness": 4,
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "ZoneChange",
        "filter": { "types": ["Creature"], "controller": "Opponent", "token": false },
        "from": "Battlefield",
        "to": "Graveyard",
        "instead": "Exile",
        "then": [ { "type": "AddCounters", "what": { "type": "TriggerObject" }, "kind": "Ice", "n": { "type": "Fixed", "n": 1 } } ]
      }
    },
    {
      "type": "Static",
      "effect": {
        "type": "MayPlayFrom",
        "zone": "Exile",
        "filter": { "not_types": ["Land"], "owner": "Opponent", "has_counter": "Ice" }
      }
    },
    {
      "type": "Static",
      "effect": {
        "type": "SpendSnowManaAsAnyColor",
        "filter": { "owner": "Opponent", "has_counter": "Ice" }
      }
    }
  ],
  "oracle_text": "If a nontoken creature an opponent controls would die, exile that card with an ice counter on it instead.\nYou may cast spells from among cards in exile your opponents own with ice counters on them, and you may spend mana from snow sources as though it were mana of any color to cast those spells."
}
