{
  "name": "Runeforge Champion",
  "mana_cost": "{2}{W}",
  "types": ["Creature"],
  "subtypes": ["Dwarf", "Warrior"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Library",
          "filter": { "subtypes": ["Rune"], "owner": "You" },
          "min": 0,
          "max": 1,
          "then": [
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "n": 1, "op": "Ge" } },
              "then": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" },
                { "type": "Shuffle", "who": { "type": "You" } }
              ]
            }
          ]
        },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "subtypes": ["Rune"], "owner": "You" },
          "min": 0,
          "max": 1,
          "then": [
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "n": 1, "op": "Ge" } },
              "then": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "AlternativeManaCost",
        "filter": { "subtypes": ["Rune"] },
        "whose": "You",
        "cost": "{1}"
      }
    }
  ],
  "oracle_text": "When this creature enters, you may search your library and/or graveyard for a Rune card, reveal it, and put it into your hand. If you search your library this way, shuffle.\nYou may pay {1} rather than pay the mana cost for Rune spells you cast."
}
