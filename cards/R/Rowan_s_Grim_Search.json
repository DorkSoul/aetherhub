{
  "name": "Rowan's Grim Search",
  "mana_cost": "{2}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [
        { "type": "Sacrifice", "filter": { "controller": "You", "any_of": [ { "types": ["Artifact"] }, { "types": ["Enchantment"] }, { "token": true } ] }, "n": 1 }
      ]
    },
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [
            { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 4 }, "filter": {}, "take": 2, "must": false, "to": "Library", "rest": "Graveyard", "keep_on_top": false }
          ],
          "else": []
        },
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } },
        { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } }
      ]
    }
  ],
  "oracle_text": "Bargain (You may sacrifice an artifact, enchantment, or token as you cast this spell.)\nIf this spell was bargained, look at the top four cards of your library, then put up to two of them back on top of your library in any order and the rest into your graveyard.\nYou draw two cards and you lose 2 life."
}
