{
  "name": "Rewrite History",
  "mana_cost": "{2}{U}",
  "types": ["Enchantment"],
  "subtypes": ["Plan"],
  "colors": ["U"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BecomesTapped", "filter": { "types": ["Creature"], "controller": "You" } },
      "batched": true,
      "effects": [
        { "type": "DrawThenDiscard", "draw": { "type": "Fixed", "n": 1 }, "discard": { "type": "Fixed", "n": 1 }, "who": { "type": "You" } },
        { "type": "AddCounters", "what": { "type": "This" }, "kind": "Plan", "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "CounterAdded", "filter": { "this": true }, "kind": "Plan" },
      "condition": { "type": "SourceHasCounter", "at_least": 4, "kind": "Plan" },
      "effects": [
