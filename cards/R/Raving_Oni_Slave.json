          "cond": { "type": "Not", "c": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "subtypes": ["Demon"], "controller": "You" } } },
          "then": [ { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } } ]
