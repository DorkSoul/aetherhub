{
  "name": "Reflective Golem",
  "mana_cost": "{3}",
  "types": ["Artifact", "Creature"],
  "subtypes": ["Golem"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
