{
  "name": "Regent's Authority",
  "mana_cost": "{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [{ "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "any_of": [{ "all_types": ["Enchantment", "Creature"] }, { "supertypes": ["Legendary"] }] } },
          "then": [
            { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } },
            { "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": 1 }, "toughness": { "type": "Fixed", "n": 1 }, "duration": "UntilEndOfTurn" }
          ],
          "else": [
            { "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": 2 }, "toughness": { "type": "Fixed", "n": 2 }, "duration": "UntilEndOfTurn" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Target creature gets +2/+2 until end of turn. If it's an enchantment creature or legendary creature, instead put a +1/+1 counter on it and it gets +1/+1 until end of turn."
}
