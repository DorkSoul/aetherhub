{
  "name": "Reckless Handling",
  "mana_cost": "{1}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": { "types": ["Artifact"] },
          "n": { "type": "Fixed", "n": 1 },
          "to": "Hand",
          "shuffle": true
        },
        { "type": "Discard", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 }, "random": true },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "types": ["Artifact"] } },
          "then": [ { "type": "DealDamage", "amount": { "type": "Fixed", "n": 2 }, "source": { "type": "This" }, "to": { "type": "EachOpponent" } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Search your library for an artifact card, reveal it, put it into your hand, shuffle, then discard a card at random. If an artifact card was discarded this way, Reckless Handling deals 2 damage to each opponent."
}
