{
  "name": "Rushing River",
  "mana_cost": "{2}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [
        { "type": "Sacrifice", "n": 1, "filter": { "controller": "You", "types": ["Land"] } }
      ]
    },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "not_types": ["Land"] } },
          "label": "target nonland permanent"
        },
        {
          "what": { "type": "Permanent", "filter": { "not_types": ["Land"] } },
          "distinct": true,
          "when_kicked": true,
          "label": "another target nonland permanent (if kicked)"
        }
      ],
      "effects": [
        { "type": "Bounce", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [ { "type": "Bounce", "what": { "type": "Target", "idx": 1 } } ]
        }
      ]
    }
  ],
  "oracle_text": "Kicker—Sacrifice a land. (You may sacrifice a land in addition to any other costs as you cast this spell.)\nReturn target nonland permanent to its owner's hand. If this spell was kicked, return another target nonland permanent to its owner's hand."
}
