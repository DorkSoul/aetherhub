{
  "name": "Rosecot Knight",
  "mana_cost": "{4}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Knight"],
  "power": 3,
  "toughness": 4,
  "keywords": ["Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "LookAtTop",
          "who": { "type": "You" },
          "n": { "type": "Fixed", "n": 6 },
          "filter": { "any_of": [{ "types": ["Artifact"] }, { "types": ["Enchantment"] }] },
          "take": 1,
          "to": "Hand",
          "rest": "Library",
          "random_rest": true,
          "keep_on_top": false,
          "must": false,
          "all": false,
          "tapped": false
        },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "Count", "filter": { "among_remembered": true }, "zone": "Hand" }, "cmp": { "op": "Eq", "n": 0 } },
          "then": [{ "type": "AddCounters", "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "This" } }],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Vigilance\nWhen this creature enters, look at the top six cards of your library. You may reveal an artifact or enchantment card from among them and put it into your hand. Put the rest on the bottom of your library in a random order. If you didn't put a card into your hand this way, put a +1/+1 counter on this creature."
}
