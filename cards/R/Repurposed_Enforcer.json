{
  "name": "Repurposed Enforcer",
  "mana_cost": "{1}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Soldier"],
  "power": 3,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Not",
            "c": {
              "type": "Control",
              "who": { "type": "You" },
              "filter": { "token": true, "types": ["Planeswalker"], "subtypes": ["Jace"] },
              "at_least": 1
            }
          },
          "then": [
            { "type": "CreateToken", "token": "Jace" }
          ]
        },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "filter": { "token": true, "types": ["Planeswalker"], "subtypes": ["Jace"], "controller": "You" },
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "AddCounters",
              "what": { "type": "Remembered" },
              "kind": "Loyalty",
              "n": { "type": "Count", "filter": { "types": ["Creature"], "controller": "You" }, "zone": "Battlefield" }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever this creature attacks, empower Jace X, where X is the number of creatures you control. (Put that many loyalty counters on a Jace token you control. If you don't control one, first create a blue Jace planeswalker token with \"[−1]: Surveil 1\" and \"[−3]: Draw a card.\")"
}
