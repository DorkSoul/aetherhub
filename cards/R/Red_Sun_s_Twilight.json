{
  "name": "Red Sun's Twilight",
  "mana_cost": "{X}{R}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Artifact"] } }, "min": 0, "max_x": true, "label": "up to X target artifacts" }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Targets" }, "remember": true },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "X" }, "cmp": { "op": "Ge", "n": 5 } },
          "then": [
            { "type": "CopyPermanent", "what": { "type": "Remembered" }, "n": { "type": "Fixed", "n": 1 }, "except": [{ "type": "AddKeyword", "keyword": "Haste" }] },
            { "type": "Delayed", "at": "NextEndStep", "effects": [{ "type": "Exile", "what": { "type": "Remembered" } }] }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Destroy up to X target artifacts. If X is 5 or more, for each artifact destroyed this way, create a token that's a copy of it. Those tokens gain haste. Exile them at the beginning of the next end step."
