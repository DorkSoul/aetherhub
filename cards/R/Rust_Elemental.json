{
  "name": "Rust Elemental",
  "mana_cost": "{4}",
  "types": ["Artifact", "Creature"],
  "subtypes": ["Elemental"],
  "power": 4,
  "toughness": 4,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "You" },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "who": { "type": "You" },
            "at_least": 1,
            "filter": { "types": ["Artifact"], "other": true, "controller": "You" }
          },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Battlefield",
              "filter": { "types": ["Artifact"], "other": true, "controller": "You" },
              "min": 1,
              "max": 1,
              "then": [ { "type": "Sacrifice", "who": { "type": "Remembered" } } ]
            }
          ],
          "else": [
            { "type": "Tap", "what": { "type": "This" } },
            { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 4 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Flying\nAt the beginning of your upkeep, sacrifice another artifact. If you can't, tap this creature and you lose 4 life."
}
