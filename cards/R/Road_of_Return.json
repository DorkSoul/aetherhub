{
  "name": "Road of Return",
  "mana_cost": "{G}{G}",
  "types": ["Sorcery"],
  "abilities": [
    { "type": "Entwine", "cost": [ { "type": "Mana", "cost": "{2}" } ] },
    {
      "type": "Modal",
      "choose_min": 1,
      "choose_max": 1,
      "modes": [
        {
          "text": "Return target permanent card from your graveyard to your hand.",
          "targets": [
            {
              "what": {
                "type": "CardIn",
                "zone": "Graveyard",
                "filter": {
                  "any_of": [
                    { "types": ["Artifact"] },
                    { "types": ["Battle"] },
                    { "types": ["Creature"] },
                    { "types": ["Enchantment"] },
                    { "types": ["Land"] },
                    { "types": ["Planeswalker"] }
                  ]
                },
                "whose": "You"
              },
              "min": 1,
              "max": 1,
              "label": "target permanent card in your graveyard"
            }
          ],
          "effects": [
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" }
          ]
        },
        {
          "text": "Put your commander into your hand from the command zone.",
          "effects": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Command",
              "filter": { "commander": true, "owner": "You" },
              "min": 1,
              "max": 1,
              "then": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose one —\n• Return target permanent card from your graveyard to your hand.\n• Put your commander into your hand from the command zone.\nEntwine {2} (Choose both if you pay the entwine cost.)"
}
