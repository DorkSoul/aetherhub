{
  "name": "Rofellos's Gift",
  "mana_cost": "{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "Choose", "who": { "type": "You" }, "zone": "Hand", "min": 0, "max": 99,
          "filter": { "colors": ["G"] },
          "then": [
            { "type": "Reveal", "what": { "type": "Remembered" } },
            { "type": "ForEach", "objects": { "type": "Remembered" }, "effects": [
              { "type": "Choose", "who": { "type": "You" }, "zone": "Graveyard", "min": 1, "max": 1,
