{
  "name": "Return to Dust",
  "mana_cost": "{2}{W}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "any_of": [ { "types": ["Artifact"] }, { "types": ["Enchantment"] } ] } }, "min": 1, "max": 1, "label": "target artifact or enchantment" },
        { "what": { "type": "Permanent", "filter": { "any_of": [ { "types": ["Artifact"] }, { "types": ["Enchantment"] } ] } }, "min": 0, "max": 1, "distinct": true, "label": "up to one other target artifact or enchantment" }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": {
            "type": "All",
            "cs": [
              { "type": "YourTurn" },
              { "type": "AnyOf", "cs": [ { "type": "InStep", "step": "Main1" }, { "type": "InStep", "step": "Main2" } ] },
              { "type": "WasCast" }
            ]
          },
          "then": [
            { "type": "Exile", "what": { "type": "Target", "idx": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile target artifact or enchantment. If you cast this spell during your main phase, you may exile up to one other target artifact or enchantment."
}
