{
  "name": "Ryan Sinclair",
  "mana_cost": "{2}{R}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Human"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        {
          "type": "RevealUntil",
          "who": { "type": "You" },
          "filter": { "not_types": ["Land"] },
          "count": { "type": "Fixed", "n": 1 },
          "to": "Exile",
          "tapped": false,
          "rest": "Library",
          "rest_random": true
        },
        {
          "type": "If",
          "cond": {
            "type": "RememberedIs",
            "filter": { "mana_value_vs": { "op": "Le", "amount": { "type": "PowerOf", "of": { "type": "This" } } } }
          },
          "then": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": true, "decline_to_bottom": true } ],
          "else": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Library", "from": "Exile" } ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever Ryan attacks, exile cards from the top of your library until you exile a nonland card. You may cast the exiled card without paying its mana cost if it's a spell with mana value less than or equal to Ryan's power. Put the exiled cards not cast this way on the bottom of your library in a random order.\nDoctor's companion (You can have two commanders if the other is the Doctor.)"
}
