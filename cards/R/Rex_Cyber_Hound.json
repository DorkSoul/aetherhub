{
  "name": "Rex, Cyber-Hound",
  "mana_cost": "{1}{W}{U}",
  "types": ["Artifact", "Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Robot", "Dog"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "effects": [
        { "type": "Mill", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 2 } },
        { "type": "GainEnergy", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } }
      ]
    },
    {
      "type": "Activated",
      "cost": [{ "type": "PayEnergy", "n": 2 }],
      "timing": "Sorcery",
      "targets": [{ "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Creature"] }, "whose": "Any" }, "label": "target creature card in a graveyard" }],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "Brain", "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "GrantAbilitiesFrom", "affects": { "this": true }, "from": { "type": "All", "filter": { "has_counter": "Brain" }, "zone": "Exile" } }
    }
  ],
  "oracle_text": "Whenever Rex deals combat damage to a player, they mill two cards and you get {E}{E} (two energy counters).\nPay {E}{E}: Choose target creature card in a graveyard. Exile it with a brain counter on it. Activate only as a sorcery.\nRex has all activated abilities of all cards in exile with brain counters on them."
}
