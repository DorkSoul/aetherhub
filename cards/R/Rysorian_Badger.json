        { "type": "If",
          "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [ { "type": "PreventDamage", "from": { "type": "This" }, "combat_only": true } ],
          "else": [] }
