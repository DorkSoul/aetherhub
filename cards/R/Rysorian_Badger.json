{
  "name": "Rysorian Badger",
  "mana_cost": "{2}{G}",
  "types": ["Creature"],
  "subtypes": ["Badger"],
  "power": 2, "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "AttackerUnblocked", "filter": { "this": true } },
