{
  "name": "Resourceful Return",
  "mana_cost": "{1}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Creature"] }, "whose": "You" },
          "label": "target creature card in your graveyard"
        }
      ],
      "effects": [
        { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand", "from": "Graveyard" },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Artifact"] }, "at_least": 1 },
          "then": [
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Return target creature card from your graveyard to your hand. If you control an artifact, draw a card."
}
