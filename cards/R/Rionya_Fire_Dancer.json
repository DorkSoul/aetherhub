{
  "name": "Rionya, Fire Dancer",
  "mana_cost": "{3}{R}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Wizard"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat", "whose": "You" },
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You", "other": true } }, "label": "another target creature you control" }
      ],
      "effects": [
        {
          "type": "CopyPermanent",
          "what": { "type": "Target", "idx": 0 },
          "n": {
            "type": "Plus",
            "a": { "type": "Fixed", "n": 1 },
            "b": { "type": "SpellsCastWhere", "filter": { "types": ["Instant", "Sorcery"], "controller": "You" } }
          },
          "except": [ { "type": "AddKeyword", "keyword": "Haste" } ]
        },
        {
          "type": "Delayed",
          "at": "NextEndStep",
          "effects": [ { "type": "Exile", "what": { "type": "Remembered" } } ]
        }
      ]
    }
  ],
  "oracle_text": "At the beginning of combat on your turn, create X tokens that are copies of another target creature you control, where X is one plus the number of instant and sorcery spells you've cast this turn. They gain haste. Exile them at the beginning of the next end step."
}
