{
  "name": "Repeated Reverberation",
  "mana_cost": "{2}{R}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "AddTrigger",
          "trigger": { "type": "SpellCast", "by": "You", "filter": { "types": ["Instant"] } },
          "also": [
            { "type": "SpellCast", "by": "You", "filter": { "types": ["Sorcery"] } },
            { "type": "AbilityActivated", "by": "You", "filter": {}, "loyalty": true }
          ],
          "once": true,
          "until": "EndOfTurn",
          "effects": [
            { "type": "CopySpell", "what": { "type": "TriggerObject" }, "new_targets": true },
            { "type": "CopySpell", "what": { "type": "TriggerObject" }, "new_targets": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When you next cast an instant spell, cast a sorcery spell, or activate a loyalty ability this turn, copy that spell or ability twice. You may choose new targets for the copies."
