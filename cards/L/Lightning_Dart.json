{
  "name": "Lightning Dart",
  "mana_cost": "{1}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "AnyOf",
            "cs": [
              { "type": "TargetIs", "idx": 0, "filter": { "colors": ["W"] } },
              { "type": "TargetIs", "idx": 0, "filter": { "colors": ["U"] } }
            ]
          },
          "then": [
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 4 }, "to": { "type": "Target", "idx": 0 } }
          ],
          "else": [
            { "type": "DealDamage", "amount": { "type": "Fixed", "n": 1 }, "to": { "type": "Target", "idx": 0 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Lightning Dart deals 1 damage to target creature. If that creature is white or blue, Lightning Dart deals 4 damage to it instead."
}
