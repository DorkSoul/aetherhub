{
  "name": "Lair of the Ashen Idol",
  "types": ["Plane"],
  "subtypes": ["Azgol"],
  "abilities": [
    {
      "type": "Triggered",
      "from": "Command",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "You" },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "types": ["Creature"] } },
          "then": [ { "type": "Sacrifice", "who": { "type": "You" }, "filter": { "types": ["Creature"] }, "n": { "type": "Fixed", "n": 1 } } ],
          "else": [ { "type": "Planeswalk" } ]
        }
      ]
    },
    {
      "type": "Triggered",
      "from": "Command",
      "trigger": { "type": "RollsChaos" },
      "targets": [ { "what": { "type": "Player", "filter": "Any" }, "min": 0, "max": 99, "label": "any number of target players" } ],
      "effects": [
        { "type": "ForEachPlayer", "players": { "type": "Targets" }, "effects": [
          { "type": "CreateToken", "token": "Zombie", "n": { "type": "Fixed", "n": 1 }, "controller": { "type": "EachObject" } }
        ] }
      ]
    }
  ],
  "oracle_text": "At the beginning of your upkeep, sacrifice a creature. If you can't, planeswalk.\nWhenever chaos ensues, any number of target players each create a 2/2 black Zombie creature token."
}
