{
  "name": "Lost Legacy",
  "mana_cost": "{1}{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Player", "filter": "Any" }, "label": "target player" } ],
      "effects": [
        { "type": "ChooseCardName", "kind": "NonartifactNonland" },
        { "type": "Choose", "who": { "type": "You" }, "from": { "type": "Target", "idx": 0 }, "zone": "Graveyard",
          "filter": { "chosen_name": true }, "min": 0, "max": 255,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Exile" } ] },
        { "type": "Choose", "who": { "type": "You" }, "from": { "type": "Target", "idx": 0 }, "zone": "Library",
          "filter": { "chosen_name": true }, "min": 0, "max": 255,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Exile" } ] },
        { "type": "Shuffle", "who": { "type": "Target", "idx": 0 } },
        { "type": "Choose", "who": { "type": "You" }, "from": { "type": "Target", "idx": 0 }, "zone": "Hand",
          "filter": { "chosen_name": true }, "min": 0, "max": 255,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Exile" },
            { "type": "Draw", "who": { "type": "Target", "idx": 0 }, "n": { "type": "RememberedCount" } }
          ] }
      ]
    }
  ],
  "oracle_text": "Choose a nonartifact, nonland card name. Search target player's graveyard, hand, and library for any number of cards with that name and exile them. That player shuffles, then draws a card for each card exiled from their hand this way."
}
