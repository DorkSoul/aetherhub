{
  "name": "Longstalk Brawl",
  "mana_cost": "{G}",
  "types": ["Sorcery"],
  "abilities": [
    { "type": "Kicker", "cost": [] },
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" },
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } }, "label": "target creature you don't control" }
      ],
      "effects": [
        { "type": "If", "cond": { "type": "Kicked" }, "then": [ { "type": "CreateToken", "token": "Fish", "tapped": true, "n": { "type": "Fixed", "n": 1 }, "controller": { "type": "EachOpponent" } } ] },
        { "type": "If", "cond": { "type": "Kicked" }, "then": [ { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } } ] },
        { "type": "Fight", "a": { "type": "Target", "idx": 0 }, "b": { "type": "Target", "idx": 1 } }
      ]
