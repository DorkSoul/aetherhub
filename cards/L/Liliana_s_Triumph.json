      "effects": [
        { "type": "Sacrifice", "who": { "type": "EachOpponent" }, "filter": { "types": ["Creature"] }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Planeswalker"], "subtypes": ["Liliana"] }, "at_least": 1 },
          "then": [{ "type": "Discard", "who": { "type": "EachOpponent" }, "n": { "type": "Fixed", "n": 1 } }],
          "else": []
        }
