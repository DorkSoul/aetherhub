{
  "name": "Liliana's Defeat",
  "mana_cost": "{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "colors": ["B"], "any_of": [ { "types": ["Creature"] }, { "types": ["Planeswalker"] } ] } },
          "label": "target black creature or black planeswalker"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "types": ["Planeswalker"], "subtypes": ["Liliana"] } },
          "then": [ { "type": "LoseLife", "who": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "n": { "type": "Fixed", "n": 3 } } ],
          "else": []
        },
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } }
      ]
    }
  ],
  "oracle_text": "Destroy target black creature or black planeswalker. If that permanent was a Liliana planeswalker, her controller loses 3 life."
}
