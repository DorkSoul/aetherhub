{
  "name": "Lo and Li, Twin Tutors",
  "mana_cost": "{4}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Advisor"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": { "any_of": [ { "subtypes": ["Lesson"] }, { "subtypes": ["Noble"] } ] },
          "n": { "type": "Fixed", "n": 1 },
          "to": "Hand",
          "reveal": true,
          "shuffle": true
        }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "GrantKeyword", "affects": { "subtypes": ["Noble"], "controller": "You" }, "keyword": "Lifelink" }
    },
    {
      "type": "Static",
      "effect": { "type": "GrantKeyword", "affects": { "subtypes": ["Lesson"], "controller": "You" }, "keyword": "Lifelink" }
    }
  ],
  "oracle_text": "When Lo and Li enter, search your library for a Lesson or Noble card, reveal it, put it into your hand, then shuffle.\nNoble creatures you control and Lesson spells you control have lifelink."
}
