{
  "name": "Loki, the Deceiver",
  "mana_cost": "{1}{U}{B}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["God", "Sorcerer", "Villain"],
  "power": 4,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "subtypes": ["Villain"], "controller": "You", "other": true } },
          "label": "another target Villain you control"
        }
      ],
      "effects": [
        {
          "type": "CopyPermanent",
          "what": { "type": "Target", "idx": 0 },
          "n": { "type": "Fixed", "n": 1 },
          "tapped": true,
          "attacking": true,
          "except": [
            { "type": "NotLegendary" },
            { "type": "AddSubtype", "subtype": "Illusion" }
          ]
        },
        {
          "type": "Delayed",
          "at": "NextEndStep",
          "effects": [ { "type": "Sacrifice", "who": { "type": "Remembered" } } ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "CombatDamageToPlayer",
        "batched": true,
        "filter": { "subtypes": ["Villain"], "controller": "You" }
      },
      "effects": [
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
      ]
    }
  ],
  "oracle_text": "Whenever Loki attacks, create a tapped and attacking token that's a copy of another target Villain you control, except it isn't legendary and it's an Illusion in addition to its other types. Sacrifice that token at the beginning of the next end step.\nWhenever one or more Villains you control deal combat damage to a player, draw a card."
}
