{
  "name": "Lost in the Woods",
  "mana_cost": "{3}{G}{G}",
  "types": ["Enchantment"],
  "abilities": [
    { "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "attacking_you": true } },
      "effects": [
        { "type": "RevealUntil", "who": { "type": "You" }, "filter": {}, "count": { "type": "Fixed", "n": 1 }, "to": "Exile", "rest": "Library" },
        { "type": "If", "cond": { "type": "RememberedIs", "filter": { "subtypes": ["Forest"] } },
          "then": [ { "type": "RemoveFromCombat", "what": { "type": "TriggerSource" } } ] },
        { "type": "Move", "what": { "type": "Remembered" }, "to": "Library" }
      ] }
  ],
  "oracle_text": "Whenever a creature attacks you or a planeswalker you control, reveal the top card of your library. If it's a Forest card, remove that creature from combat. Then put the revealed card on the bottom of your library."
}
