{
  "name": "Zuko's Conviction",
  "mana_cost": "{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [{ "type": "Mana", "cost": "{4}" }],
      "multi": false
    },
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "CardIn",
            "zone": "Graveyard",
            "filter": { "types": ["Creature"] },
            "whose": "You"
          },
          "min": 1,
          "max": 1,
          "label": "target creature card in your graveyard"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Battlefield", "tapped": true }
          ],
          "else": [
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Kicker {4} (You may pay an additional {4} as you cast this spell.)\nReturn target creature card from your graveyard to your hand. If this spell was kicked, instead put that card onto the battlefield tapped."
}
