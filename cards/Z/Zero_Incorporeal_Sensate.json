{
  "name": "Zero, Incorporeal Sensate",
  "mana_cost": "{1}{W/B}{W/B}",
  "types": ["Artifact", "Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Medusan", "Scientist"],
  "power": 2,
  "toughness": 2,
  "keywords": ["Lifelink"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" }
      ],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "from": { "type": "Target", "idx": 0 },
          "zone": "Hand",
          "min": 0,
          "max": 1,
          "filter": { "not_types": ["Land"] },
          "then": [
            { "type": "Exile", "what": { "type": "Remembered" } },
            {
              "type": "GrantPlayFromExile",
              "what": { "type": "Remembered" },
              "window": "Forever",
              "by": { "type": "OwnerOf", "of": { "type": "Remembered" } },
              "extra_generic": 2
            }
          ]
        }
      ],
      "optional": false
    }
  ],
  "oracle_text": "Lifelink\nWhen Zero enters, look at target opponent's hand. You may exile a nonland card from it. For as long as that card remains exiled, its owner may play it. A spell cast this way costs {2} more to cast."
}
