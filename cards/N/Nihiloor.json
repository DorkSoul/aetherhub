      "effects": [
        { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } },
        { "type": "LoseLife", "who": { "type": "OwnerOf", "of": { "type": "TriggerSource" } }, "n": { "type": "Fixed", "n": 2 } }
