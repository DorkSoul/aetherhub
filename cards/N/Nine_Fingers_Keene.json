          ],
          "else": [
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Eq", "n": 1 } },
              "then": [ { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 8 }, "filter": {}, "take": 0, "rest": "Library", "random_rest": true } ],
              "else": [ { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 9 }, "filter": {}, "take": 0, "rest": "Library", "random_rest": true } ]
