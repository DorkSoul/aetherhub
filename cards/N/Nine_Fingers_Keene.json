          "then": [
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Eq", "n": 1 } },
              "then": [ { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 8 }, "filter": {}, "take": 8, "all": true, "rest": "Library", "to": "Hand" } ],
              "else": [ { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 9 }, "filter": {}, "take": 9, "all": true, "rest": "Library", "to": "Hand" } ]
