{
  "name": "Nemesis Trap",
  "mana_cost": "{4}{B}{B}",
  "types": ["Instant"],
  "subtypes": ["Trap"],
  "abilities": [
    {
      "type": "AlternativeCost",
      "cost": [ { "type": "Mana", "cost": "{B}{B}" } ],
      "condition": {
        "type": "Control",
        "who": { "type": "EachPlayer" },
        "at_least": 1,
        "filter": { "types": ["Creature"], "colors": ["W"], "attacking": true }
      },
      "exile_after": false
    },
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "attacking": true } }, "label": "target attacking creature" }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        { "type": "CopyPermanent", "what": { "type": "Remembered" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Delayed", "at": "NextEndStep", "effects": [ { "type": "Exile", "what": { "type": "Remembered" } } ] }
      ]
    }
  ],
  "oracle_text": "If a white creature is attacking, you may pay {B}{B} rather than pay this spell's mana cost.\nExile target attacking creature. Create a token that's a copy of that creature. Exile it at the beginning of the next end step."
}
