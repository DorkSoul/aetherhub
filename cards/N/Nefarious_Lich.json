{
  "name": "Nefarious Lich",
  "mana_cost": "{B}{B}{B}{B}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "Damage",
        "source": {},
        "to": "You",
        "prevent": true,
        "then": [
          {
            "type": "If",
            "cond": {
              "type": "CompareAmounts",
              "a": { "type": "Count", "filter": {}, "zone": "Graveyard", "player": { "type": "You" } },
              "op": "Lt",
              "b": { "type": "EventAmount" }
            },
            "then": [ { "type": "LoseGame", "who": { "type": "You" } } ],
            "else": [
              {
                "type": "Choose",
                "who": { "type": "You" },
                "zone": "Graveyard",
                "filter": {},
                "min_amount": { "type": "EventAmount" },
                "max_amount": { "type": "EventAmount" },
                "then": [ { "type": "Exile", "what": { "type": "Remembered" } } ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Replace",
      "what": {
        "type": "GainLife",
        "who": "You",
        "instead": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "EventAmount" } } ]
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "LeavesBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "LoseGame", "who": { "type": "You" } } ]
