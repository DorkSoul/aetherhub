{
  "name": "Najal, the Storm Runner",
  "mana_cost": "{2}{U}{U}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Efreet", "Wizard"],
  "power": 5,
  "toughness": 4,
  "abilities": [
    {
      "type": "Static",
      "effect": { "type": "CastAsThoughFlash", "filter": { "types": ["Sorcery"] }, "whose": "You" }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        {
          "type": "MayPay",
          "payer": { "type": "You" },
          "cost": [ { "type": "Mana", "cost": "{2}" } ],
          "effects": [
            {
              "type": "AddTrigger",
              "trigger": { "type": "SpellCast", "by": "You", "filter": { "types": ["Instant", "Sorcery"] } },
              "once": true,
              "effects": [ { "type": "CopySpell", "what": { "type": "TriggerSource" }, "new_targets": true } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "You may cast sorcery spells as though they had flash.\nWhenever Najal, the Storm Runner attacks, you may pay {2}. If you do, when you next cast an instant or sorcery spell this turn, copy it. You may choose new targets for the copy."
