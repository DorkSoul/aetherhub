{
  "name": "Nyla, Shirshu Sleuth",
  "mana_cost": "{4}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Mole", "Beast"],
  "power": 4,
  "toughness": 5,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
