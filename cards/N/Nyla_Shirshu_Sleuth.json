          "min": 0,
          "max": 1,
          "label": "up to one target creature card from your graveyard"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "ManaValueOf", "of": { "type": "Remembered" } } },
        { "type": "CreateToken", "token": "Clue", "n": { "type": "ManaValueOf", "of": { "type": "Remembered" } } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
