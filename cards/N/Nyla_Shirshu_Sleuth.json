            "zone": "Exile",
            "filter": { "exiled_with_this": true },
            "whose": "Any"
          },
          "min": 1,
          "max": 1,
          "label": "target card exiled with Nyla"
        }
      ],
      "effects": [
        { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" }
