{
  "name": "Nissa, Leyline Tamer",
  "mana_cost": "{3}{W}{U}{B}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Elf", "Wizard"],
  "power": 5,
  "toughness": 5,
  "keywords": ["Deathtouch", "Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "types": ["Land"], "controller": "You" } },
      "effects": [
        { "type": "Draw", "who": { "type": "You" } },
        {
          "type": "If",
          "cond": {
            "type": "Not",
            "c": { "type": "SourceHasCounter", "kind": "Stash", "at_least": 1 }
          },
          "then": [
            { "type": "AddCounters", "what": { "type": "This" }, "kind": "Stash", "n": { "type": "Fixed", "n": 1 } },
            {
              "type": "Delayed",
              "at": "EndOfTurn",
              "effects": [
                { "type": "RemoveCounters", "what": { "type": "This" }, "kind": "Stash", "n": { "type": "Fixed", "n": 1 } }
              ]
            },
            {
              "type": "RevealUntil",
              "who": { "type": "You" },
              "filter": { "types": ["Creature"] },
              "count": { "type": "Fixed", "n": 1 },
              "to": "Battlefield",
              "rest": "Library",
              "rest_random": true
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Deathtouch, vigilance\nLandfall — Whenever a land you control enters, draw a card. Then if this is the first time this ability has resolved this turn, reveal cards from the top of your library until you reveal a creature card. Put that card onto the battlefield and the rest on the bottom of your library in a random order."
}
