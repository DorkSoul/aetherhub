{
  "name": "Noble Benefactor",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "this": true } },
      "effects": [
        {
          "type": "ForEachPlayer",
          "players": { "type": "EachPlayer" },
          "effects": [
            {
              "type": "SearchLibrary",
              "who": { "type": "EachObject" },
              "filter": {},
              "n": { "type": "Fixed", "n": 1 },
              "to": "Hand",
              "shuffle": false,
              "by_owner": true
            },
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Ge", "n": 1 } },
              "then": [ { "type": "Shuffle", "who": { "type": "EachObject" } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature dies, each player may search their library for a card and put that card into their hand. Then each player who searched their library this way shuffles."
}
