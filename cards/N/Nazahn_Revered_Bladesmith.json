{
  "name": "Nazahn, Revered Bladesmith",
  "mana_cost": "{4}{G}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Cat", "Artificer"],
  "power": 5,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Library",
          "filter": { "subtypes": ["Equipment"] },
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "name": "Hammer of Nazahn" } },
              "then": [{ "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "from": "Library" }],
              "else": [{ "type": "Move", "what": { "type": "Remembered" }, "to": "Hand", "from": "Library" }]
            }
          ]
        },
        { "type": "Shuffle", "who": { "type": "You" } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "equipped": true, "controller": "You" } },
      "optional": true,
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } }, "label": "creature defending player controls" }
      ],
      "effects": [{ "type": "Tap", "what": { "type": "Target", "idx": 0 } }]
    }
  ],
  "oracle_text": "When Nazahn enters, search your library for an Equipment card and reveal it. If you reveal a card named Hammer of Nazahn this way, put it onto the battlefield. Otherwise, put that card into your hand. Then shuffle.\nWhenever an equipped creature you control attacks, you may tap target creature defending player controls."
}
