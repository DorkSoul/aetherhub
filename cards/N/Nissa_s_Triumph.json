{
  "name": "Nissa's Triumph",
  "mana_cost": "{G}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "at_least": 1,
            "who": { "type": "You" },
            "filter": { "types": ["Planeswalker"], "subtypes": ["Nissa"] }
          },
          "then": [
            { "type": "SearchLibrary", "who": { "type": "You" }, "filter": { "types": ["Land"] }, "n": { "type": "Fixed", "n": 3 }, "to": "Hand", "reveal": true, "shuffle": true }
          ],
          "else": [
            { "type": "SearchLibrary", "who": { "type": "You" }, "filter": { "types": ["Land"], "subtypes": ["Forest"], "supertypes": ["Basic"] }, "n": { "type": "Fixed", "n": 2 }, "to": "Hand", "reveal": true, "shuffle": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Search your library for up to two basic Forest cards. If you control a Nissa planeswalker, instead search your library for up to three land cards. Reveal those cards, put them into your hand, then shuffle."
}
