{
  "name": "Nissa's Defeat",
  "mana_cost": "{2}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": {
              "any_of": [
                { "subtypes": ["Forest"] },
                { "types": ["Enchantment"], "colors": ["G"] },
                { "types": ["Planeswalker"], "colors": ["G"] }
              ]
            }
          },
          "label": "target Forest, green enchantment, or green planeswalker"
        }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "subtypes": ["Nissa"], "types": ["Planeswalker"] } },
          "then": [
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Destroy target Forest, green enchantment, or green planeswalker. If that permanent was a Nissa planeswalker, draw a card."
