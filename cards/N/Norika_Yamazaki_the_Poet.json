{
  "name": "Norika Yamazaki, the Poet",
  "mana_cost": "{2}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Samurai"],
  "power": 3,
  "toughness": 2,
  "keywords": ["Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "AttacksAlone",
        "filter": {
          "any_of": [
            { "subtypes": ["Samurai"], "controller": "You" },
            { "subtypes": ["Warrior"], "controller": "You" }
          ]
        }
      },
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Enchantment"] }, "whose": "You" },
          "label": "target enchantment card in your graveyard"
        }
      ],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "types": ["Enchantment"], "owner": "You", "same_name_as": { "type": "Target", "idx": 0 } },
          "min": 1,
          "max": 1,
          "then": [ { "type": "MayPlayThisTurn", "zone": "Graveyard", "filter": { "among_remembered": true } } ]
        }
      ]
    }
  ],
  "oracle_text": "Vigilance\nWhenever a Samurai or Warrior you control attacks alone, you may cast target enchantment card from your graveyard this turn."
}
