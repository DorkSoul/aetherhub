{
  "name": "Melee",
  "mana_cost": "{4}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "CastOnlyIf",
      "condition": {
        "type": "All",
        "cs": [
          { "type": "YourTurn" },
          { "type": "AnyOf", "cs": [ { "type": "InStep", "step": "BeginCombat" }, { "type": "InStep", "step": "DeclareAttackers" } ] }
        ]
      }
    },
    {
      "type": "Spell",
      "effects": [
        { "type": "ChooseBlocks", "who": { "type": "EachPlayer" } },
        {
          "type": "AddTrigger",
          "trigger": { "type": "AttackerUnblocked", "filter": { "types": ["Creature"] } },
          "effects": [
            { "type": "Untap", "what": { "type": "TriggerSource" } },
            { "type": "RemoveFromCombat", "what": { "type": "TriggerSource" } }
          ],
          "until": "EndOfCombat"
        }
      ]
    }
  ],
  "oracle_text": "Cast this spell only during combat on your turn before blockers are declared.\nYou choose which creatures block this combat and how those creatures block.\nWhenever a creature attacks and isn't blocked this combat, untap it and remove it from combat."
}
