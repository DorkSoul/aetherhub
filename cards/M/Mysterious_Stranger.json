{
  "name": "Mysterious Stranger",
  "mana_cost": "{2}{R}{R}",
  "types": ["Creature"],
  "subtypes": ["Human", "Rogue"],
  "power": 3,
  "toughness": 2,
  "keywords": ["Flash"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Instant", "Sorcery"] }, "whose": "You" },
          "min": 0,
          "max": 1,
          "label": "target instant or sorcery card in your graveyard"
        },
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Instant", "Sorcery"] }, "whose": "Opponent" },
          "min": 0,
          "max": 1,
          "label": "target instant or sorcery card in an opponent's graveyard"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Targets" } },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "n": 2, "op": "Ge" } },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Exile",
              "filter": { "among_remembered": true },
              "random": true,
              "min": 1,
              "max": 1,
              "then": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": true, "copy": true } ]
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Flash\nWhen Mysterious Stranger enters, for each graveyard with an instant or sorcery card in it, exile target instant or sorcery card from that graveyard. If two or more cards are exiled this way, choose one of them at random and copy it. You may cast the copy without paying its mana cost."
}
