{
  "name": "Mathise, Surge Channeler",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Elf", "Shaman", "Sorcerer"],
  "power": 1,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "You",
        "filter": { "types": ["Instant", "Sorcery"], "mana_value": { "op": "Ge", "n": 3 } }
      },
      "effects": [
        {
          "type": "RollDie",
          "sides": 20,
          "outcomes": [
            { "min": 1, "max": 9, "effects": [ { "type": "Draw", "who": { "type": "EachPlayer" }, "n": { "type": "Fixed", "n": 1 } } ] },
            { "min": 10, "max": 19, "effects": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ] },
            { "min": 20, "max": 20, "effects": [ { "type": "CopySpell", "what": { "type": "TriggerObject" }, "new_targets": true } ] }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever you cast an instant or sorcery spell with mana value 3 or greater, roll a d20.\n1-9 | Each player draws a card.\n10-19 | You draw a card.\n20 | Copy that spell. You may choose new targets for the copy."
