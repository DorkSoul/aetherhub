{
  "name": "Mirror Mockery",
  "mana_cost": "{1}{U}",
  "types": ["Enchantment"],
  "subtypes": ["Aura"],
  "abilities": [
    { "type": "Attach", "to": { "types": ["Creature"] } },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "attached_by_source": true } },
      "optional": true,
      "effects": [
        { "type": "CopyPermanent", "what": { "type": "AttachedTo" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "Delayed",
          "at": "EndOfCombat",
          "effects": [ { "type": "Exile", "what": { "type": "Remembered" } } ]
