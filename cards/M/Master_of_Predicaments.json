{
  "name": "Master of Predicaments",
  "mana_cost": "{3}{U}{U}",
  "types": ["Creature"],
  "subtypes": ["Sphinx"],
  "power": 4,
  "toughness": 4,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "CombatDamageToPlayer", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Hand",
          "min": 1,
          "max": 1,
          "then": [
            { "type": "ChooseNumber", "who": { "type": "TriggerPlayer" }, "min": 0, "max": 1 },
            {
              "type": "If",
              "cond": {
                "type": "All",
                "cs": [
                  {
                    "type": "AnyOf",
                    "cs": [
                      {
                        "type": "All",
                        "cs": [
                          { "type": "Compare", "a": { "type": "ChosenNumber" }, "cmp": { "op": "Eq", "n": 1 } },
                          { "type": "RememberedIs", "filter": { "mana_value": { "op": "Le", "n": 4 } } }
                        ]
                      },
                      {
                        "type": "All",
                        "cs": [
                          { "type": "Compare", "a": { "type": "ChosenNumber" }, "cmp": { "op": "Eq", "n": 0 } },
                          { "type": "RememberedIs", "filter": { "mana_value": { "op": "Gt", "n": 4 } } }
                        ]
                      }
                    ]
                  },
                  { "type": "RememberedIs", "filter": { "not_types": ["Land"] } }
                ]
              },
              "then": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": true } ],
              "else": []
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhenever Master of Predicaments deals combat damage to a player, choose a card in your hand. That player guesses whether the card's mana value is greater than 4. If the player guessed wrong, you may cast the card without paying its mana cost."
}
