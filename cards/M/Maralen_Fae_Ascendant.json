{
  "name": "Maralen, Fae Ascendant",
  "mana_cost": "{2}{B}{G}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Elf", "Faerie", "Noble"],
  "colors": ["B", "G", "U"],
  "power": 4,
  "toughness": 5,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "any_of": [{ "subtypes": ["Elf"], "controller": "You" }, { "subtypes": ["Faerie"], "controller": "You" }] } },
      "targets": [{ "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" }],
      "effects": [{ "type": "ExileTopOfLibrary", "who": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 2 } }]
    },
    {
      "type": "Static",
      "effect": {
        "type": "MayPlayFrom",
        "zone": "Exile",
        "filter": {
          "exiled_with_this": true,
          "exiled_this_turn": true,
          "not_types": ["Land"],
          "mana_value_vs": {
            "op": "Le",
            "amount": { "type": "Count", "filter": { "any_of": [{ "subtypes": ["Elf"], "controller": "You" }, { "subtypes": ["Faerie"], "controller": "You" }] }, "zone": "Battlefield" }
          }
        },
        "once_per_turn": true,
        "free": true
      }
    }
  ],
  "oracle_text": "Flying\nWhenever Maralen or another Elf or Faerie you control enters, exile the top two cards of target opponent's library.\nOnce each turn, you may cast a spell with mana value less than or equal to the number of Elves and Faeries you control from among cards exiled with Maralen this turn without paying its mana cost."
}
