{
  "name": "Mikey & Mona, Mutant Sitters",
  "mana_cost": "{2}{G}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Mutant", "Ninja", "Turtle", "Lizard"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 2,
          "modes": [
            {
              "text": "Target player chooses a creature they control and puts two +1/+1 counters on it.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [ { "what": { "type": "Player", "filter": "Any" }, "label": "target player", "distinct_modes": true } ],
                  "effects": [
                    {
                      "type": "Choose",
                      "who": { "type": "Target", "idx": 0 },
                      "zone": "Battlefield",
                      "filter": { "types": ["Creature"], "controlled_by": { "type": "Target", "idx": 0 } },
                      "min": 1,
                      "max": 1,
                      "then": [
                        { "type": "AddCounters", "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 }, "what": { "type": "Remembered" } }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "Target player returns a creature or land card from their graveyard to their hand.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [ { "what": { "type": "Player", "filter": "Any" }, "label": "target player", "distinct_modes": true } ],
                  "effects": [
                    {
                      "type": "Choose",
                      "who": { "type": "Target", "idx": 0 },
                      "from": { "type": "Target", "idx": 0 },
                      "zone": "Graveyard",
                      "filter": { "types": ["Creature", "Land"] },
                      "min": 1,
                      "max": 1,
                      "then": [
                        { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When Mikey & Mona enter, choose one or both. Each mode must target a different player.\n• Target player chooses a creature they control and puts two +1/+1 counters on it.\n• Target player returns a creature or land card from their graveyard to their hand."
}
