{
  "name": "Mythos of Nethroi",
  "mana_cost": "{2}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": { "not_types": ["Land"] }
          },
          "label": "target nonland permanent"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "AnyOf",
            "cs": [
              { "type": "SelIs", "what": { "type": "Target", "idx": 0 }, "filter": { "types": ["Creature"] } },
              {
                "type": "All",
                "cs": [
                  { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "G" }, "cmp": { "op": "Ge", "n": 1 } },
                  { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "W" }, "cmp": { "op": "Ge", "n": 1 } }
                ]
              }
            ]
          },
          "then": [
            { "type": "Destroy", "what": { "type": "Target", "idx": 0 } }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Destroy target nonland permanent if it's a creature or if {G}{W} was spent to cast this spell."
}
