{
  "name": "Mana Sculpt",
  "mana_cost": "{1}{U}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Spell", "filter": {} }, "label": "target spell" } ],
      "effects": [
        { "type": "CounterSpell", "what": { "type": "Target", "idx": 0 }, "remember": true },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "types": ["Creature"], "subtypes": ["Wizard"], "controller": "You" } },
          "then": [
            {
              "type": "If",
              "cond": { "type": "All", "cs": [
                { "type": "YourTurn" },
                { "type": "AnyOf", "cs": [
                  { "type": "InStep", "step": "Main1" },
                  { "type": "InStep", "step": "BeginCombat" },
                  { "type": "InStep", "step": "DeclareAttackers" },
                  { "type": "InStep", "step": "DeclareBlockers" },
                  { "type": "InStep", "step": "FirstStrikeDamage" },
                  { "type": "InStep", "step": "CombatDamage" },
                  { "type": "InStep", "step": "EndCombat" }
                ] } ] },
              "then": [
                { "type": "AddTrigger", "trigger": { "type": "BeginningOfStep", "step": "Main2", "whose": "You" }, "once": true, "until": "Forever",
                  "effects": [ { "type": "AddMana", "mana": [ { "t": "Scaled", "m": "C", "amount": { "type": "ManaSpent", "of": { "type": "Remembered" } } } ] } ] }
              ],
              "else": [
                { "type": "AddTrigger", "trigger": { "type": "BeginningOfStep", "step": "Main1", "whose": "You" }, "once": true, "until": "Forever",
                  "effects": [ { "type": "AddMana", "mana": [ { "t": "Scaled", "m": "C", "amount": { "type": "ManaSpent", "of": { "type": "Remembered" } } } ] } ] }
              ]
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Counter target spell. If you control a Wizard, add an amount of {C} equal to the amount of mana spent to cast that spell at the beginning of your next main phase."
}
