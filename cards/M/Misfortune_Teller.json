{
  "name": "Misfortune Teller",
  "mana_cost": "{3}{B}",
  "types": ["Creature"],
  "subtypes": ["Human", "Warlock"],
  "power": 3,
  "toughness": 1,
  "keywords": ["Deathtouch"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [{ "what": { "type": "CardIn", "zone": "Graveyard", "filter": {}, "whose": "Any" }, "label": "target card from a graveyard" }],
      "effects": [
        { "type": "If", "cond": { "type": "TargetIs", "filter": { "types": ["Creature"] }, "idx": 0 }, "then": [{ "type": "CreateToken", "token": "Rogue 2-2 Black", "n": { "type": "Fixed", "n": 1 } }], "else": [] },
        { "type": "If", "cond": { "type": "TargetIs", "filter": { "types": ["Land"] }, "idx": 0 }, "then": [{ "type": "CreateToken", "token": "Treasure", "n": { "type": "Fixed", "n": 1 } }], "else": [] },
        { "type": "If", "cond": { "type": "All", "cs": [{ "type": "Not", "c": { "type": "TargetIs", "filter": { "types": ["Creature"] }, "idx": 0 } }, { "type": "Not", "c": { "type": "TargetIs", "filter": { "types": ["Land"] }, "idx": 0 } }] }, "then": [{ "type": "GainLife", "n": { "type": "Fixed", "n": 3 }, "who": { "type": "You" } }], "else": [] },
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "targets": [{ "what": { "type": "CardIn", "zone": "Graveyard", "filter": {}, "whose": "Any" }, "label": "target card from a graveyard" }],
      "effects": [
        { "type": "If", "cond": { "type": "TargetIs", "filter": { "types": ["Creature"] }, "idx": 0 }, "then": [{ "type": "CreateToken", "token": "Rogue 2-2 Black", "n": { "type": "Fixed", "n": 1 } }], "else": [] },
        { "type": "If", "cond": { "type": "TargetIs", "filter": { "types": ["Land"] }, "idx": 0 }, "then": [{ "type": "CreateToken", "token": "Treasure", "n": { "type": "Fixed", "n": 1 } }], "else": [] },
        { "type": "If", "cond": { "type": "All", "cs": [{ "type": "Not", "c": { "type": "TargetIs", "filter": { "types": ["Creature"] }, "idx": 0 } }, { "type": "Not", "c": { "type": "TargetIs", "filter": { "types": ["Land"] }, "idx": 0 } }] }, "then": [{ "type": "GainLife", "n": { "type": "Fixed", "n": 3 }, "who": { "type": "You" } }], "else": [] },
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } }
      ]
    }
  ],
  "oracle_text": "Deathtouch\nWhenever this creature enters or deals combat damage to a player, exile target card from a graveyard. If it was a creature card, create a 2/2 black Rogue creature token. If it was a land card, create a Treasure token. Otherwise, you gain 3 life."
