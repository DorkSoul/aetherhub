{
  "name": "Mog, Moogle Warrior",
  "mana_cost": "{1}{R}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Moogle", "Warrior"],
  "power": 1,
  "toughness": 2,
  "keywords": ["Lifelink"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "effects": [
        { "type": "ClearRemembered" },
        {
          "type": "Choose",
          "who": { "type": "EachPlayer" },
          "zone": "Hand",
          "filter": {},
          "min": 0,
          "max": 1,
          "accumulate": true,
          "then": []
        },
        { "type": "DiscardRemembered" },
        { "type": "StoreRemembered", "slot": 0, "append": false },
        { "type": "Draw", "who": { "type": "OwnersOf", "of": { "type": "Remembered" } }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "AnyRememberedIs", "filter": { "types": ["Creature"] } },
          "then": [ { "type": "CreateToken", "token": "Moogle 1-2 Lifelink", "n": { "type": "Fixed", "n": 1 } } ]
        },
        { "type": "Remember", "what": { "type": "Stored", "slot": 0 } },
        {
          "type": "If",
          "cond": { "type": "AnyRememberedIs", "filter": { "not_types": ["Creature"] } },
          "then": [
            {
              "type": "AddCounters",
              "what": { "type": "All", "filter": { "subtypes": ["Moogle"], "controller": "You" } },
              "kind": "PlusOnePlusOne",
              "n": { "type": "Fixed", "n": 1 }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Lifelink\nDance — At the beginning of your end step, each player may discard a card. Each player who discarded a card this way draws a card. If a creature card was discarded this way, you create a 1/2 white Moogle creature token with lifelink. Then if a noncreature card was discarded this way, put a +1/+1 counter on each Moogle you control."
}
