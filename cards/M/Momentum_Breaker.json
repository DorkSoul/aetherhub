{
  "name": "Momentum Breaker",
  "mana_cost": "{1}{B}",
  "types": ["Enchantment"],
  "abilities": [
    { "type": "StartYourEngines" },
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "EachOpponent" },
          "effects": [
            {
              "type": "If",
              "cond": { "type": "Control", "who": { "type": "EachObject" }, "filter": { "any_of": [ { "types": ["Creature"] }, { "types": ["Artifact"], "subtypes": ["Vehicle"] } ] }, "at_least": 1 },
              "then": [
                { "type": "Sacrifice", "who": { "type": "EachObject" }, "filter": { "any_of": [ { "types": ["Creature"] }, { "types": ["Artifact"], "subtypes": ["Vehicle"] } ] }, "n": { "type": "Fixed", "n": 1 } }
              ],
              "else": [
                { "type": "Discard", "who": { "type": "EachObject" }, "n": { "type": "Fixed", "n": 1 } }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Activated",
      "cost": [ { "type": "Mana", "cost": "{2}" }, { "type": "SacrificeSelf" } ],
      "effects": [ { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Speed", "who": { "type": "You" } } } ]
    }
  ],
  "oracle_text": "Start your engines! (If you have no speed, it starts at 1. It increases once on each of your turns when an opponent loses life. Max speed is 4.)\nWhen this enchantment enters, each opponent sacrifices a creature or Vehicle of their choice. Each opponent who can't discards a card.\n{2}, Sacrifice this enchantment: You gain life equal to your speed."
}
