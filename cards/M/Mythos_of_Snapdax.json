{
  "name": "Mythos of Snapdax",
  "mana_cost": "{2}{W}{W}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "ForEachPlayer",
          "players": { "type": "EachPlayer" },
          "effects": [
            { "type": "ClearRemembered" },
            {
              "type": "If",
              "cond": {
                "type": "All",
                "cs": [
                  { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "B" }, "cmp": { "op": "Ge", "n": 1 } },
                  { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "R" }, "cmp": { "op": "Ge", "n": 1 } }
                ]
              },
              "then": [
                {
                  "type": "Choose", "who": { "type": "You" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Artifact"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                },
                {
                  "type": "Choose", "who": { "type": "You" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Creature"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                },
                {
                  "type": "Choose", "who": { "type": "You" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Enchantment"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                },
                {
                  "type": "Choose", "who": { "type": "You" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Planeswalker"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                }
              ],
              "else": [
                {
                  "type": "Choose", "who": { "type": "EachObject" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Artifact"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                },
                {
                  "type": "Choose", "who": { "type": "EachObject" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Creature"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                },
                {
                  "type": "Choose", "who": { "type": "EachObject" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Enchantment"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                },
                {
                  "type": "Choose", "who": { "type": "EachObject" }, "zone": "Battlefield", "min": 1, "max": 1, "accumulate": true,
                  "filter": { "types": ["Planeswalker"], "not_types": ["Land"], "controlled_by": { "type": "EachObject" } }, "then": []
                }
              ]
            },
            {
              "type": "Sacrifice",
              "who": { "type": "EachObject" },
              "filter": { "not_types": ["Land"], "controlled_by": { "type": "EachObject" }, "not_among_remembered": true },
              "n": { "type": "Fixed", "n": 99 }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Each player chooses an artifact, a creature, an enchantment, and a planeswalker from among the nonland permanents they control, then sacrifices the rest. If {B}{R} was spent to cast this spell, you choose the permanents for each player instead."
}
