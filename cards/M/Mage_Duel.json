{
  "name": "Mage Duel",
  "mana_cost": "{2}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "CostChange",
        "filter": { "this": true },
        "whose": "You",
        "generic": -2,
        "per": { "type": "Fixed", "n": 1 }
      },
      "condition": {
        "type": "CastThisTurn",
        "at_least": 1,
        "filter": { "any_of": [ { "types": ["Instant"] }, { "types": ["Sorcery"] } ] }
