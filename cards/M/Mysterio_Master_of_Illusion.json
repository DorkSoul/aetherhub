{
  "name": "Mysterio, Master of Illusion",
  "mana_cost": "{3}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Villain"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "CreateToken",
          "token": "Illusion Villain",
          "controller": { "type": "You" },
          "n": { "type": "Count", "filter": { "subtypes": ["Villain"], "token": false, "controller": "You" }, "zone": "Battlefield" }
        },
        {
          "type": "AddTrigger",
          "trigger": { "type": "LeavesBattlefield", "filter": { "this": true } },
          "effects": [ { "type": "Exile", "what": { "type": "Remembered" } } ],
          "once": true,
          "until": "Forever"
        }
      ]
    }
  ],
  "oracle_text": "When Mysterio enters, create a 3/3 blue Illusion Villain creature token for each nontoken Villain you control. Exile those tokens when Mysterio leaves the battlefield."
}
