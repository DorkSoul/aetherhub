{
  "name": "Mage Hunters' Onslaught",
  "mana_cost": "{2}{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "any_of": [ { "types": ["Creature"] }, { "types": ["Planeswalker"] } ] } }, "label": "creature or planeswalker" }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "AddTrigger",
          "trigger": { "type": "Blocks", "filter": {} },
          "effects": [ { "type": "LoseLife", "who": { "type": "ControllerOf", "of": { "type": "TriggerSource" } }, "n": { "type": "Fixed", "n": 1 } } ],
          "until": "EndOfTurn"
        }
      ]
    }
  ],
  "oracle_text": "Destroy target creature or planeswalker.\nWhenever a creature blocks this turn, its controller loses 1 life."
}
