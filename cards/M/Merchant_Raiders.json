{
  "name": "Merchant Raiders",
  "mana_cost": "{3}{U}",
  "types": ["Creature"],
  "subtypes": ["Human", "Pirate"],
  "power": 2,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "any_of": [ { "this": true }, { "types": ["Creature"], "subtypes": ["Pirate"], "controller": "You", "other": true } ] } },
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "min": 0, "max": 1, "label": "up to one target creature" } ],
      "effects": [
        { "type": "Tap", "what": { "type": "Target", "idx": 0 } },
        { "type": "If", "cond": { "type": "Control", "at_least": 1, "filter": { "this": true }, "who": { "type": "You" } },
          "then": [ { "type": "GrantStatic", "what": { "type": "Target", "idx": 0 }, "effect": { "type": "GrantAbility", "affects": {}, "ability": { "type": "Static", "effect": { "type": "DoesntUntap", "filter": { "this": true } } } }, "duration": "WhileSourceControlled" } ] }
      ]
    }
  ],
  "oracle_text": "Whenever this creature or another Pirate you control enters, tap up to one target creature. That creature doesn't untap during its controller's untap step for as long as you control this creature."
