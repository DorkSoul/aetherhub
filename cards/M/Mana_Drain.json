                  ]
                }
              ]
            }
          ],
          "else": [
            {
              "type": "AddTrigger",
              "trigger": { "type": "BeginningOfStep", "step": "Main1", "whose": "You" },
              "once": true,
              "until": "Forever",
              "effects": [
                {
                  "type": "AddMana",
                  "mana": [
                    {
                      "t": "Scaled",
                      "m": "C",
                      "amount": { "type": "ManaValueOf", "of": { "type": "Target", "idx": 0 } }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
