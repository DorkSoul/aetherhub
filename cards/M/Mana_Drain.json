                  { "type": "InStep", "step": "CombatDamage" },
                  { "type": "InStep", "step": "EndCombat" }
                ]
              }
            ]
          },
          "then": [
            {
              "type": "AddTrigger",
              "trigger": { "type": "BeginningOfStep", "step": "Main2", "whose": "You" },
              "once": true,
              "until": "EndOfTurn",
              "effects": [
                {
                  "type": "AddMana",
                  "mana": [
                    {
                      "t": "Scaled",
                      "m": "C",
                      "amount": { "type": "ManaValueOf", "of": { "type": "Target", "idx": 0 } }
