{
  "name": "Extraordinary Journey",
  "mana_cost": "{X}{X}{U}{U}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "min": 0,
          "max_x": true,
          "label": "up to X target creatures"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Targets" } },
        {
          "type": "GrantPlayFromExile",
          "what": { "type": "Remembered" },
          "window": "Forever",
          "by": { "type": "OwnerOf", "of": { "type": "Remembered" } }
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "ChangesZone",
        "filter": {
          "types": ["Creature"],
          "token": false,
          "any_of": [{ "entered_from": "Exile" }, { "cast_from": "Exile" }]
        },
        "to": "Battlefield"
      },
      "batched": true,
      "once_per_turn": true,
      "effects": [{ "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }]
    }
  ],
  "oracle_text": "When this enchantment enters, exile up to X target creatures. For each of those cards, its owner may play it for as long as it remains exiled.\nWhenever one or more nontoken creatures enter, if one or more of them entered from exile or was cast from exile, you draw a card. This ability triggers only once each turn."
}
