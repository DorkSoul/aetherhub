{
  "name": "Embermouth Sentinel",
  "mana_cost": "{2}",
  "types": ["Artifact", "Creature"],
  "subtypes": ["Chimera"],
  "power": 2,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": { "types": ["Land"], "supertypes": ["Basic"] },
          "n": { "type": "Fixed", "n": 1 },
          "to": "Library",
          "reveal": true,
          "shuffle": false
        },
        { "type": "Shuffle", "who": { "type": "You" } },
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "who": { "type": "You" },
            "filter": { "subtypes": ["Dragon"], "controller": "You" },
            "at_least": 1
          },
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "tapped": true }
          ],
          "else": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Library", "top_of_library": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you may search your library for a basic land card, reveal it, then shuffle and put that card on top. If you control a Dragon, put that card onto the battlefield tapped instead."
}
