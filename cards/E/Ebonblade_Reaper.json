{
  "name": "Ebonblade Reaper",
  "mana_cost": "{2}{B}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "colors": ["B"],
  "power": 1,
  "toughness": 1,
  "abilities": [
    { "type": "Morph", "cost": "{3}{B}{B}" },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        { "type": "LoseLife", "who": { "type": "You" },
          "n": { "type": "Half", "round_up": true,
                 "a": { "type": "Max", "a": { "type": "LifeOf", "who": { "type": "You" } }, "b": { "type": "Fixed", "n": 0 } } } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "effects": [
        { "type": "LoseLife", "who": { "type": "TriggerPlayer" },
          "n": { "type": "Half", "round_up": true,
                 "a": { "type": "Max", "a": { "type": "LifeOf", "who": { "type": "TriggerPlayer" } }, "b": { "type": "Fixed", "n": 0 } } } }
      ]
    }
  ],
  "oracle_text": "Whenever this creature attacks, you lose half your life, rounded up.\nWhenever this creature deals combat damage to a player, that player loses half their life, rounded up.\nMorph {3}{B}{B} (You may cast this card face down as a 2/2 creature for {3}. Turn it face up any time for its morph cost.)"
}
