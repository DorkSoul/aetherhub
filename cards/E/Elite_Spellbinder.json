{
  "name": "Elite Spellbinder",
  "mana_cost": "{2}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "power": 3,
  "toughness": 1,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" }
      ],
      "effects": [
        { "type": "LookAtHand", "who": { "type": "Target", "idx": 0 } },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "from": { "type": "Target", "idx": 0 },
          "zone": "Hand",
          "filter": { "not_types": ["Land"] },
          "min": 0,
          "max": 1,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Exile", "remember": true },
            {
              "type": "GrantPlayFromExile",
              "what": { "type": "Remembered" },
              "window": "Forever",
              "by": { "type": "OwnerOf", "of": { "type": "Remembered" } }
            }
          ]
        }
      ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "CostChange",
        "filter": { "exiled_with_this": true },
        "whose": "Opponent",
        "generic": 2
      }
    }
  ],
  "oracle_text": "Flying\nWhen Elite Spellbinder enters, look at target opponent's hand. You may exile a nonland card from it. For as long as that card remains exiled, its owner may play it. A spell cast this way costs {2} more to cast."
}
