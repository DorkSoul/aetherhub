      "trigger": { "type": "SpellCast", "filter": { "types": ["Instant", "Sorcery"], "token": false }, "by": "Any" },
      "effects": [
        { "type": "Move", "what": { "type": "TriggerObject" }, "to": "Exile" },
        {
          "type": "ForEach",
          "objects": { "type": "All", "filter": { "types": ["Instant", "Sorcery"], "exiled_with_this": true }, "zone": "Exile" },
          "effects": [
            { "type": "CastFree", "what": { "type": "EachObject" }, "may": true, "copy": true, "by": { "type": "TriggerPlayer" } }
          ]
        }
      ]
    }
