{
  "name": "Ensign Pavel Chekov",
  "mana_cost": "{3}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Pilot"],
  "power": 1,
  "toughness": 5,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ForEachPlayer",
          "players": { "type": "EachOpponent" },
          "effects": [
            { "type": "ClearRemembered" },
            {
              "type": "LookAtTop",
              "who": { "type": "EachObject" },
              "n": { "type": "DistinctNames", "filter": { "types": ["Land"], "controller": "You" } },
              "filter": {},
              "take": 0,
              "all": true,
              "to": "Exile",
              "rest": "Library"
            },
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Exile",
              "from": { "type": "EachObject" },
              "filter": { "types": ["Land"], "among_remembered": true },
              "min": 1,
              "max": 1,
              "then": [
                { "type": "GrantPlayFromExile", "what": { "type": "Remembered" }, "window": "Forever" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Strange new worlds — When Ensign Chekov enters, each opponent exiles the top X cards of their library, where X is the number of differently named lands you control. For each opponent, choose a land card that player owns exiled this way. You may play the chosen cards for as long as they remain exiled."
}
