{
  "name": "Explorer's Cache",
  "mana_cost": "{1}{G}",
  "types": ["Artifact"],
  "abilities": [
    { "type": "EntersWithCounters", "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 } },
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "types": ["Creature"], "controller": "You", "has_counter": "PlusOnePlusOne" } },
      "effects": [{ "type": "AddCounters", "what": { "type": "This" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } }]
    },
    {
      "type": "Activated",
      "cost": [{ "type": "Tap" }],
      "timing": "Sorcery",
      "targets": [{ "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "SourceHasCounter", "kind": "PlusOnePlusOne", "at_least": 1 },
          "then": [
            { "type": "RemoveCounters", "what": { "type": "This" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } },
            { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "This artifact enters with two +1/+1 counters on it.\nWhenever a creature you control with a +1/+1 counter on it dies, put a +1/+1 counter on this artifact.\n{T}: Move a +1/+1 counter from this artifact onto target creature. Activate only as a sorcery."
}
