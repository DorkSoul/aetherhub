{
  "name": "Ezio Auditore da Firenze",
  "mana_cost": "{1}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Assassin"],
  "power": 3,
  "toughness": 2,
  "keywords": ["Menace"],
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "AlternativeManaCost",
        "filter": { "subtypes": ["Assassin"] },
        "whose": "You",
        "cost": "{B}{B}"
      },
      "condition": {
        "type": "DealtCombatDamageThisTurn",
        "filter": {
          "any_of": [
            { "types": ["Creature"], "subtypes": ["Assassin"], "controller": "You" },
            { "commander": true, "controller": "You" }
          ]
        }
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "LifeOf", "who": { "type": "TriggerPlayer" } },
            "cmp": { "op": "Le", "n": 10 }
          },
          "then": [
            {
              "type": "MayPay",
              "payer": { "type": "You" },
              "cost": [{ "type": "Mana", "cost": "{W}{U}{B}{R}{G}" }],
              "effects": [{ "type": "LoseGame", "who": { "type": "TriggerPlayer" } }]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Menace\nAssassin spells you cast have freerunning {B}{B}. (You may cast a spell for its freerunning cost if you dealt combat damage to a player this turn with an Assassin or commander.)\nWhenever Ezio deals combat damage to a player, you may pay {W}{U}{B}{R}{G} if that player has 10 or less life. When you do, that player loses the game."
}
