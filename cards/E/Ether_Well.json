{
  "name": "Ether Well",
  "mana_cost": "{3}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library", "top_of_library": true, "remember": true },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "colors": ["R"] } },
          "then": [
            {
              "type": "May",
              "effects": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Library", "from": "Library" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Put target creature on top of its owner's library. If that creature is red, you may put it on the bottom of its owner's library instead."
}
