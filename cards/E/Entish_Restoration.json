{
  "name": "Entish Restoration",
  "mana_cost": "{2}{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "Sacrifice", "who": { "type": "You" }, "filter": { "types": ["Land"], "controller": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Creature"], "controller": "You", "power": { "op": "Ge", "n": 4 } }, "at_least": 1 },
          "then": [ { "type": "SearchLibrary", "who": { "type": "You" }, "filter": { "types": ["Land"], "supertypes": ["Basic"] }, "n": { "type": "Fixed", "n": 3 }, "to": "Battlefield", "tapped": true, "shuffle": true } ],
          "else": [ { "type": "SearchLibrary", "who": { "type": "You" }, "filter": { "types": ["Land"], "supertypes": ["Basic"] }, "n": { "type": "Fixed", "n": 2 }, "to": "Battlefield", "tapped": true, "shuffle": true } ]
        }
      ]
    }
  ],
  "oracle_text": "Sacrifice a land. Search your library for up to two basic land cards, put them onto the battlefield tapped, then shuffle. If you control a creature with power 4 or greater, instead search your library for up to three basic land cards, put them onto the battlefield tapped, then shuffle."
