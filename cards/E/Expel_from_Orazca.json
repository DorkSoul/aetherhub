{
  "name": "Expel from Orazca",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "not_types": ["Land"] } }, "label": "target nonland permanent" } ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "CityBlessing" },
          "then": [
            {
              "type": "ChooseModes",
              "choose_min": 1,
              "choose_max": 1,
              "modes": [
                { "text": "Return it to its owner's hand", "effects": [ { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" } ] },
                { "text": "Put it on top of its owner's library", "effects": [ { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library", "top_of_library": true } ] }
              ]
            }
          ],
          "else": [ { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" } ]
        }
      ]
    }
  ],
  "oracle_text": "Ascend (If you control ten or more permanents, you get the city's blessing for the rest of the game.)\nReturn target nonland permanent to its owner's hand. If you have the city's blessing, you may put that permanent on top of its owner's library instead."
}
