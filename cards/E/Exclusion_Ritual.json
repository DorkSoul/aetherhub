{
  "name": "Exclusion Ritual",
  "mana_cost": "{4}{W}{W}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "not_types": ["Land"] } },
          "label": "nonland permanent"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } }
      ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "CantCastCards",
        "who": "Any",
        "filter": { "same_name_as": { "type": "ExiledWithThis" } }
      }
    }
  ],
  "oracle_text": "Imprint — When this enchantment enters, exile target nonland permanent.\nPlayers can't cast spells with the same name as the exiled card."
}
