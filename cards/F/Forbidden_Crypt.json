{
  "name": "Forbidden Crypt",
  "mana_cost": "{3}{B}{B}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "Draw",
        "who": "You",
        "instead": [
          {
            "type": "If",
            "cond": { "type": "Compare", "a": { "type": "GraveyardSize", "who": { "type": "You" } }, "cmp": { "op": "Eq", "n": 0 } },
            "then": [ { "type": "LoseGame", "who": { "type": "You" } } ],
            "else": [
              {
                "type": "Choose",
                "who": { "type": "You" },
                "zone": "Graveyard",
                "filter": { "owner": "You" },
                "min": 1,
                "max": 1,
                "then": [ { "type": "Move", "what": { "type": "Remembered" }, "from": "Graveyard", "to": "Hand" } ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "Replace",
      "what": {
        "type": "ZoneChange",
        "to": "Graveyard",
        "instead": "Exile",
        "whose": "You",
        "filter": { "token": false }
      }
    }
  ],
  "oracle_text": "If you would draw a card, return a card from your graveyard to your hand instead. If you can't, you lose the game.\nIf a card would be put into your graveyard from anywhere, exile that card instead."
}
