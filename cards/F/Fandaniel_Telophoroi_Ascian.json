{
  "name": "Fandaniel, Telophoroi Ascian",
  "mana_cost": "{4}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Elder", "Wizard"],
  "power": 4,
  "toughness": 5,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "You", "filter": { "any_of": [{ "types": ["Instant"] }, { "types": ["Sorcery"] }] } },
      "effects": [
        { "type": "Surveil", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "effects": [
        {
          "type": "ForEachPlayer",
          "players": { "type": "EachOpponent" },
          "effects": [
            {
              "type": "Unless",
              "payer": { "type": "EachObject" },
              "cost": [{ "type": "Sacrifice", "filter": { "types": ["Creature"], "token": false, "controller": "Opponent" }, "n": 1 }],
              "effects": [
                { "type": "LoseLife", "who": { "type": "EachObject" }, "n": { "type": "Times", "a": { "type": "Fixed", "n": 2 }, "b": { "type": "Count", "filter": { "any_of": [{ "types": ["Instant"] }, { "types": ["Sorcery"] }], "owner": "You" }, "zone": "Graveyard" } } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever you cast an instant or sorcery spell, surveil 1.\nAt the beginning of your end step, each opponent may sacrifice a nontoken creature of their choice. Each opponent who doesn't loses 2 life for each instant and sorcery card in your graveyard."
