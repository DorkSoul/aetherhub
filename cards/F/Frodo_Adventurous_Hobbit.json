{
  "name": "Frodo, Adventurous Hobbit",
  "mana_cost": "{W}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Halfling", "Scout"],
  "power": 1,
  "toughness": 3,
  "keywords": ["Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Player", "filter": "Any" }, "label": "target player" }
      ],
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "Target", "idx": 0 },
          "by_owner": true,
          "filter": { "name": "Sam, Loyal Attendant" },
          "n": { "type": "Fixed", "n": 1 },
          "to": "Hand",
          "reveal": true,
          "shuffle": true
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "condition": { "type": "Compare", "a": { "type": "LifeGainedThisTurn", "who": { "type": "You" } }, "cmp": { "op": "Ge", "n": 3 } },
      "effects": [
        { "type": "RingTempts" },
        {
          "type": "If",
          "cond": { "type": "All", "cs": [ { "type": "IsRingBearer" }, { "type": "RingTempted", "at_least": 2 } ] },
          "then": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Partner with Sam, Loyal Attendant (When this creature enters, target player may put Sam, Loyal Attendant into their hand from their library, then shuffle.)\nVigilance\nWhenever Frodo attacks, if you gained 3 or more life this turn, the Ring tempts you. Then if Frodo is your Ring-bearer and the Ring has tempted you two or more times this game, draw a card."
}
