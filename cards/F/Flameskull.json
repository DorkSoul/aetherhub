{
  "name": "Flameskull",
  "mana_cost": "{1}{R}{R}",
  "types": ["Creature"],
  "subtypes": ["Skeleton"],
  "colors": ["R"],
  "power": 3,
  "toughness": 1,
  "keywords": ["Flying", "CantBlock"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "this": true } },
      "effects": [
        { "type": "Move", "what": { "type": "This" }, "from": "Graveyard", "to": "Exile", "remember": true },
        {
          "type": "If",
          "cond": { "type": "AnyRememberedIs", "filter": {} },
          "then": [
            { "type": "StoreRemembered", "slot": 0 },
            { "type": "ExileTopOfLibrary", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
            { "type": "StoreRemembered", "slot": 0, "append": true },
            { "type": "GrantPlayFromExile", "what": { "type": "Stored", "slot": 0 }, "window": "EndOfYourNextTurn", "one": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Flying\nThis creature can't block.\nRejuvenation — When this creature dies, exile it. If you do, exile the top card of your library. Until the end of your next turn, you may play one of those cards. (If you cast Flameskull this way, you can't play the other card, and vice versa.)"
}
