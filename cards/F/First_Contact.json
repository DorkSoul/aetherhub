{
  "name": "First Contact",
  "mana_cost": "{1}{G}",
  "types": ["Instant"],
  "colors": ["G"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Mill",
          "who": { "type": "You" },
          "n": { "type": "Fixed", "n": 4 }
        },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": {
            "any_of": [
