        {
          "type": "If",
          "cond": {
            "type": "CompareAmounts",
            "a": { "type": "SpellsCastThisGame", "who": { "type": "You" } },
            "op": "Eq",
            "b": { "type": "Fixed", "n": 1 }
          },
          "then": [
            {
              "type": "GainLife",
              "who": { "type": "You" },
              "n": { "type": "Fixed", "n": 2 }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Mill four cards. You may put a permanent card from among them into your hand. If this spell is the first spell you've cast this game, you gain 2 life. (To mill four cards, put the top four cards of your library into your graveyard.)"
