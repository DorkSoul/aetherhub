{
  "name": "Fiery Gambit",
  "mana_cost": "{2}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" } ],
      "effects": [
        { "type": "ResetFlipTally" },
        {
          "type": "RepeatWhile",
          "cond": { "type": "All", "cs": [ { "type": "LastFlipWon" }, { "type": "LastCostPaid" } ] },
          "max": 40,
          "effects": [
            {
              "type": "FlipCoin",
              "win": [ { "type": "MayPay", "payer": { "type": "You" }, "cost": [], "effects": [] } ],
              "lose": []
            }
          ]
        },
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "FlipLost" } },
          "then": [
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "FlipsWon" }, "cmp": { "op": "Ge", "n": 1 } },
              "then": [ { "type": "DealDamage", "to": { "type": "Target", "idx": 0 }, "amount": { "type": "Fixed", "n": 3 } } ],
              "else": []
            },
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "FlipsWon" }, "cmp": { "op": "Ge", "n": 2 } },
              "then": [ { "type": "DealDamage", "to": { "type": "EachOpponent" }, "amount": { "type": "Fixed", "n": 6 } } ],
              "else": []
            },
            {
              "type": "If",
              "cond": { "type": "Compare", "a": { "type": "FlipsWon" }, "cmp": { "op": "Ge", "n": 3 } },
              "then": [
                { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 9 } },
                { "type": "Untap", "what": { "type": "All", "filter": { "types": ["Land"], "controller": "You" } } }
              ],
              "else": []
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Flip a coin until you lose a flip or choose to stop flipping. If you lose a flip, Fiery Gambit has no effect. If you win one or more flips, Fiery Gambit deals 3 damage to target creature. If you win two or more flips, Fiery Gambit deals 6 damage to each opponent. If you win three or more flips, draw nine cards and untap all lands you control."
}
