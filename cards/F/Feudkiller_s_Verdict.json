{
  "name": "Feudkiller's Verdict",
  "mana_cost": "{4}{W}{W}",
  "types": ["Kindred", "Sorcery"],
  "subtypes": ["Giant"],
  "colors": ["W"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 10 } },
        { "type": "ForEach", "objects": { "type": "EachOpponent" },
          "effects": [
            { "type": "If",
              "cond": { "type": "All", "cs": [
                { "type": "CompareAmounts", "a": { "type": "LifeOf", "who": { "type": "You" } }, "op": "Gt", "b": { "type": "LifeOf", "who": { "type": "EachObject" } } },
                { "type": "Not", "c": { "type": "Control", "who": { "type": "You" }, "at_least": 1,
                    "filter": { "token": true, "subtypes": ["Giant", "Warrior"], "entered_this_turn": true } } }
              ] },
              "then": [ { "type": "CreateToken", "token": "Giant Warrior 5-5 White" } ] }
          ] }
      ]
    }
  ],
  "oracle_text": "You gain 10 life. Then if you have more life than an opponent, create a 5/5 white Giant Warrior creature token."
}
