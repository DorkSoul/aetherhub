{
  "name": "Fraying Line",
  "mana_cost": "{4}",
  "types": ["Artifact"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" }
      ],
      "effects": [
        { "type": "AddCounters", "kind": "Rope", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Target", "idx": 0 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "effects": [
        {
          "type": "Unless",
          "payer": { "type": "TriggerPlayer" },
          "cost": [ { "type": "Mana", "cost": "{2}" } ],
          "effects": [
            { "type": "Exile", "what": { "type": "This" } },
            {
              "type": "ForEach",
              "objects": { "type": "All", "filter": { "types": ["Creature"] }, "zone": "Battlefield" },
              "effects": [
                {
                  "type": "If",
                  "cond": { "type": "Compare", "a": { "type": "CountersOn", "kind": "Rope", "of": { "type": "EachObject" } }, "cmp": { "op": "Eq", "n": 0 } },
                  "then": [ { "type": "Exile", "what": { "type": "EachObject" } } ]
                }
              ]
            },
            {
              "type": "ForEach",
              "objects": { "type": "All", "filter": { "types": ["Creature"] }, "zone": "Battlefield" },
              "effects": [
                { "type": "RemoveCounters", "kind": "Rope", "n": { "type": "CountersOn", "kind": "Rope", "of": { "type": "EachObject" } }, "what": { "type": "EachObject" } }
              ]
            }
          ],
          "if_paid": [
            {
              "type": "Choose",
              "who": { "type": "TriggerPlayer" },
              "zone": "Battlefield",
              "filter": { "types": ["Creature"], "controller": "You" },
              "min": 1,
              "max": 1,
              "then": [
                { "type": "AddCounters", "kind": "Rope", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Remembered" } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this artifact enters, put a rope counter on target creature you control.\nAt the beginning of each player's upkeep, that player may pay {2}. If they do, they put a rope counter on a creature they control. Otherwise, exile this artifact and each creature without a rope counter on it, then remove all rope counters from all creatures."
}
