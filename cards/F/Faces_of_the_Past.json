{
  "name": "Faces of the Past",
  "mana_cost": "{2}{U}",
  "types": ["Enchantment"],
  "colors": ["U"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "Dies",
        "filter": { "types": ["Creature"] }
      },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "modes": [
            {
              "text": "Tap all untapped creatures that share a creature type with it",
              "effects": [
                {
                  "type": "Tap",
                  "what": {
                    "type": "All",
                    "filter": {
                      "types": ["Creature"],
                      "tapped": false,
                      "shares_type_with": { "type": "TriggerObject" }
                    },
                    "zone": "Battlefield"
                  }
                }
              ]
            },
            {
              "text": "Untap all tapped creatures that share a creature type with it",
              "effects": [
                {
                  "type": "Untap",
                  "what": {
                    "type": "All",
                    "filter": {
                      "types": ["Creature"],
                      "tapped": true,
                      "shares_type_with": { "type": "TriggerObject" }
                    },
                    "zone": "Battlefield"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever a creature dies, tap all untapped creatures that share a creature type with it or untap all tapped creatures that share a creature type with it."
}
