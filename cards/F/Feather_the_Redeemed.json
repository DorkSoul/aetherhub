{
  "name": "Feather, the Redeemed",
  "mana_cost": "{R}{W}{W}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Angel"],
  "colors": ["R", "W"],
  "power": 3,
  "toughness": 4,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCastTargets",
        "filter": { "types": ["Instant", "Sorcery"], "controller": "You" },
        "by": "You",
        "target": { "types": ["Creature"], "controller": "You" }
      },
      "effects": [
        {
          "type": "AddReplacement",
          "what": {
            "type": "ZoneChange",
            "from": "Stack",
            "to": "Graveyard",
            "instead": "Exile",
            "bind_to": { "type": "TriggerObject" },
            "once": true,
            "on_resolve": true,
            "then": [
              { "type": "Remember", "what": { "type": "TriggerObject" } },
              {
                "type": "Delayed",
                "at": "NextEndStep",
                "effects": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" } ]
              }
            ]
          }
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhenever you cast an instant or sorcery spell that targets a creature you control, exile that card instead of putting it into your graveyard as it resolves. If you do, return it to your hand at the beginning of the next end step."
}
