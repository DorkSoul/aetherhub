{
  "name": "Fang-Druid Summoner",
  "mana_cost": "{3}{G}",
  "types": ["Creature"],
  "subtypes": ["Ape", "Druid"],
  "power": 2,
  "toughness": 4,
  "keywords": ["Reach"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "May",
          "effects": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Graveyard",
              "filter": { "types": ["Creature"], "no_abilities": true, "controller": "You" },
              "min": 0,
              "max": 1,
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand", "remember": true } ]
            }
          ]
        },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "n": 0, "op": "Eq" } },
          "then": [
            {
              "type": "May",
              "effects": [
                {
                  "type": "SearchLibrary",
                  "who": { "type": "You" },
                  "filter": { "types": ["Creature"], "no_abilities": true, "controller": "You" },
                  "n": { "type": "Fixed", "n": 1 },
                  "to": "Hand",
                  "shuffle": true
                }
              ]
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Reach\nWhen this creature enters, you may search your library and/or graveyard for a creature card with no abilities, reveal it, and put it into your hand. If you search your library this way, shuffle."
}
