{
  "name": "Wave of Vitriol",
  "mana_cost": "{5}{G}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Sacrifice",
          "who": {
            "type": "All",
            "filter": { "any_of": [ { "types": ["Artifact"] }, { "types": ["Enchantment"] }, { "types": ["Land"], "not_supertypes": ["Basic"] } ] },
            "zone": "Battlefield"
          }
        },
        { "type": "StoreRemembered", "slot": 0 },
        {
          "type": "ForEachPlayer",
          "players": { "type": "EachPlayer" },
          "effects": [
            {
              "type": "Repeat",
              "n": { "type": "LeftBattlefieldControlledBy", "of": { "type": "Stored", "slot": 0 }, "who": { "type": "EachObject" }, "filter": { "types": ["Land"] } },
              "effects": [
                {
                  "type": "SearchLibrary",
                  "who": { "type": "EachObject" },
                  "filter": { "supertypes": ["Basic"], "types": ["Land"] },
                  "to": "Battlefield",
                  "tapped": true,
                  "shuffle": false,
                  "by_owner": true
                }
              ]
            },
            {
              "type": "If",
              "cond": {
                "type": "Compare",
                "a": { "type": "LeftBattlefieldControlledBy", "of": { "type": "Stored", "slot": 0 }, "who": { "type": "EachObject" }, "filter": { "types": ["Land"] } },
                "cmp": { "op": "Ge", "n": 1 }
              },
              "then": [ { "type": "Shuffle", "who": { "type": "EachObject" } } ],
              "else": []
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Each player sacrifices all artifacts, enchantments, and nonbasic lands they control. For each land sacrificed this way, its controller may search their library for a basic land card and put it onto the battlefield tapped. Then each player who searched their library this way shuffles."
}
