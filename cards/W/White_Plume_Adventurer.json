{
  "name": "White Plume Adventurer",
  "mana_cost": "{2}{W}",
  "types": ["Creature"],
  "subtypes": ["Orc", "Cleric"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "TakeInitiative", "who": { "type": "You" } } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Opponent" },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "CompletedDungeon", "at_least": 1 },
          "then": [
            { "type": "Untap", "what": { "type": "All", "filter": { "types": ["Creature"], "controller": "You" }, "zone": "Battlefield" } }
          ],
          "else": [
            {
              "type": "Choose", "who": { "type": "You" }, "zone": "Battlefield",
              "filter": { "types": ["Creature"], "controller": "You" }, "min": 1, "max": 1,
              "then": [ { "type": "Untap", "what": { "type": "Remembered" } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you take the initiative.\nAt the beginning of each opponent's upkeep, untap a creature you control. If you've completed a dungeon, untap all creatures you control instead."
}
