      "amount": { "type": "Count", "filter": { "types": ["Land"], "supertypes": ["Snow"], "controller": "You" }, "zone": "Battlefield" }
    },
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "attacking": true } }, "max_x": true, "exact_x": true, "label": "X target attacking creatures" }
