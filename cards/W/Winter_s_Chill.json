  "colors": ["U"],
  "abilities": [
    {
      "type": "CastOnlyIf",
      "condition": { "type": "AnyOf", "cs": [ { "type": "InStep", "step": "BeginCombat" }, { "type": "InStep", "step": "DeclareAttackers" } ] }
    },
    {
