{
  "name": "Wyll's Reversal",
  "mana_cost": "{2}{R}",
  "types": ["Instant"],
  "colors": ["R"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "StackObject", "filter": { "spell_has_targets": true } }, "label": "target spell or ability with one or more targets" }
      ],
      "effects": [
        {
          "type": "RollDie",
          "sides": 20,
          "outcomes": [
            {
              "min": 1,
              "max": 20,
              "effects": [
                { "type": "ChangeTargets", "what": { "type": "Target", "idx": 0 } },
                {
                  "type": "If",
                  "cond": {
                    "type": "Compare",
                    "a": { "type": "Plus", "a": { "type": "DieRoll" }, "b": { "type": "HighestPower", "filter": { "types": ["Creature"], "controller": "You" } } },
                    "cmp": { "op": "Ge", "n": 15 }
                  },
                  "then": [ { "type": "CopySpell", "what": { "type": "Target", "idx": 0 }, "new_targets": true } ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose target spell or ability with one or more targets. Roll a d20 and add the greatest power among creatures you control.\n1—14 | You may choose new targets for that spell or ability.\n15+ | You may choose new targets for that spell or ability. Then copy it. You may choose new targets for the copy."
}
