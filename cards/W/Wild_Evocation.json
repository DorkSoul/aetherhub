{
  "name": "Wild Evocation",
  "mana_cost": "{5}{R}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Any" },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "TriggerPlayer" },
          "zone": "Hand",
          "from": { "type": "TriggerPlayer" },
          "filter": {},
          "min": 1,
          "max": 1,
          "random": true,
          "then": [
            { "type": "Reveal", "what": { "type": "Remembered" } },
            {
              "type": "If",
              "cond": { "type": "SelIs", "what": { "type": "Remembered" }, "filter": { "types": ["Land"] } },
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ],
              "else": [ { "type": "CastFree", "what": { "type": "Remembered" }, "by": { "type": "TriggerPlayer" } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "At the beginning of each player's upkeep, that player reveals a card at random from their hand. If it's a land card, the player puts it onto the battlefield. Otherwise, the player casts it without paying its mana cost if able."
