{
  "name": "Wick, the Whorled Mind",
  "mana_cost": "{3}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Rat", "Warlock"],
  "colors": ["B"],
  "power": 2,
  "toughness": 4,
  "abilities": [
    { "type": "Triggered",
      "trigger": { "type": "EntersBattlefield",
        "filter": { "any_of": [{ "this": true }, { "subtypes": ["Rat"], "controller": "You", "other": true }] } },
      "effects": [{ "type": "If",
        "cond": { "type": "Not", "c": { "type": "Control", "who": { "type": "You" },
          "filter": { "subtypes": ["Snail"], "controller": "You" }, "at_least": 1 } },
        "then": [{ "type": "CreateToken", "token": "Snail", "n": { "type": "Fixed", "n": 1 } }],
        "else": [{ "type": "Choose", "who": { "type": "You" }, "zone": "Battlefield", "min": 1, "max": 1,
          "filter": { "subtypes": ["Snail"], "controller": "You" },
          "then": [{ "type": "AddCounters", "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 },
            "what": { "type": "Remembered" } }] }] }] },
    { "type": "Activated",
      "cost": [{ "type": "Mana", "cost": "{U}{B}{R}" },
        { "type": "Sacrifice", "filter": { "subtypes": ["Snail"], "controller": "You" }, "n": 1 }],
      "effects": [
        { "type": "DealDamage", "amount": { "type": "PowerOf", "of": { "type": "TriggerObject" } },
          "source": { "type": "This" }, "to": { "type": "EachOpponent" } },
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "PowerOf", "of": { "type": "TriggerObject" } } }
      ] }
  ],
  "oracle_text": "Whenever Wick or another Rat you control enters, create a 1/1 black Snail creature token if you don't control a Snail. Otherwise, put a +1/+1 counter on a Snail you control.\n{U}{B}{R}, Sacrifice a Snail: Wick deals damage equal to the sacrificed creature's power to each opponent. Then draw cards equal to the sacrificed creature's power."
}
