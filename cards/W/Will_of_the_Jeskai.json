{
  "name": "Will of the Jeskai",
  "mana_cost": "{3}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Modal",
      "choose_min": 1,
      "choose_max": 1,
      "max_if": [
        { "type": "Control", "who": { "type": "You" }, "filter": { "commander": true }, "at_least": 1 },
        2
      ],
      "modes": [
        {
          "text": "Each player may discard their hand and draw five cards.",
          "effects": [
            {
              "type": "ForEachPlayer",
              "players": { "type": "EachPlayer" },
              "effects": [
                {
                  "type": "May",
                  "who": { "type": "EachObject" },
                  "effects": [
                    { "type": "Discard", "who": { "type": "EachObject" }, "n": { "type": "Fixed", "n": 99 } },
                    { "type": "Draw", "who": { "type": "EachObject" }, "n": { "type": "Fixed", "n": 5 } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Each instant and sorcery card in your graveyard gains flashback until end of turn. The flashback cost is equal to its mana cost.",
          "effects": [
            {
              "type": "Remember",
              "what": {
                "type": "All",
                "zone": "Graveyard",
                "filter": { "types": ["Instant", "Sorcery"], "owner": "You" }
              }
            },
            {
              "type": "MayPlayThisTurn",
              "zone": "Graveyard",
              "filter": { "among_remembered": true }
            },
            {
              "type": "AddReplacement",
              "what": {
                "type": "ZoneChange",
                "from": "Stack",
                "to": "Graveyard",
                "instead": "Exile",
                "filter": { "types": ["Instant", "Sorcery"], "cast_from": "Graveyard" }
              }
            },
            {
              "type": "AddReplacement",
              "what": {
                "type": "ZoneChange",
                "from": "Stack",
                "to": "Hand",
                "instead": "Exile",
                "filter": { "types": ["Instant", "Sorcery"], "cast_from": "Graveyard" }
              }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose one. If you control a commander as you cast this spell, you may choose both instead.\n• Each player may discard their hand and draw five cards.\n• Each instant and sorcery card in your graveyard gains flashback until end of turn. The flashback cost is equal to its mana cost."
}
