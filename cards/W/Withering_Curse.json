{
  "name": "Withering Curse",
  "mana_cost": "{1}{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "LifeGainedThisTurn", "who": { "type": "You" } }, "cmp": { "op": "Ge", "n": 1 } },
