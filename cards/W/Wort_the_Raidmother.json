{
  "name": "Wort, the Raidmother",
  "mana_cost": "{4}{R/G}{R/G}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Goblin", "Shaman"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "CreateToken", "token": "Goblin Warrior 1-1 Red Green", "n": { "type": "Fixed", "n": 2 } }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "GrantConspire", "affects": { "types": ["Instant", "Sorcery"], "colors": ["R", "G"] } }
