    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "You", "filter": { "types": ["Instant", "Sorcery"], "colors": ["R", "G"] } },
      "effects": [
        {
          "type": "Repeat",
          "n": { "type": "KickCount" },
          "effects": [{ "type": "CopySpell", "what": { "type": "TriggerSource" }, "new_targets": true }]
        }
      ]
    }
