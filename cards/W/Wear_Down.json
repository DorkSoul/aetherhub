{
  "name": "Wear Down",
  "mana_cost": "{1}{G}",
  "types": ["Sorcery"],
  "colors": ["G"],
  "abilities": [
    { "type": "Kicker", "cost": [] },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact", "Enchantment"] } },
          "label": "target artifact or enchantment"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact", "Enchantment"] } },
          "distinct": true,
          "when_kicked": true,
          "label": "second target artifact or enchantment (only if the gift was promised)"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [ { "type": "Draw", "who": { "type": "EachOpponent" } } ]
        },
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [ { "type": "Destroy", "what": { "type": "Target", "idx": 1 } } ]
        }
      ]
    }
  ],
  "oracle_text": "Gift a card (You may promise an opponent a gift as you cast this spell. If you do, they draw a card before its other effects.)\nDestroy target artifact or enchantment. If the gift was promised, instead destroy two target artifacts and/or enchantments."
}
