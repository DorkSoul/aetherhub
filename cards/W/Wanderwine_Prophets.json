{
  "name": "Wanderwine Prophets",
  "mana_cost": "{4}{U}{U}",
  "types": ["Creature"],
  "subtypes": ["Merfolk", "Wizard"],
  "colors": ["U"],
  "power": 4,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "subtypes": ["Merfolk"], "other": true, "controller": "You" }, "at_least": 1 },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Battlefield",
              "filter": { "subtypes": ["Merfolk"], "other": true, "controller": "You" },
              "min": 1,
              "max": 1,
              "then": [ { "type": "Exile", "what": { "type": "Remembered" }, "until_source_leaves": true } ]
            }
          ],
          "else": [ { "type": "Sacrifice", "who": { "type": "This" }, "filter": { "this": true }, "n": { "type": "Fixed", "n": 1 } } ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "effects": [
        {
          "type": "MayPay",
          "payer": { "type": "You" },
          "cost": [ { "type": "Sacrifice", "filter": { "subtypes": ["Merfolk"], "controller": "You" }, "n": 1 } ],
          "effects": [ { "type": "ExtraTurn", "who": { "type": "You" } } ]
        }
      ]
    }
  ],
  "oracle_text": "Champion a Merfolk (When this enters, sacrifice it unless you exile another Merfolk you control. When this leaves the battlefield, that card returns to the battlefield.)\nWhenever this creature deals combat damage to a player, you may sacrifice a Merfolk. If you do, take an extra turn after this one."
}
