{
  "name": "Wormfang Crab",
  "mana_cost": "{3}{U}",
  "types": ["Creature"],
  "subtypes": ["Nightmare", "Crab"],
  "power": 3,
  "toughness": 6,
  "keywords": ["Unblockable"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "EachOpponent" },
          "zone": "Battlefield",
          "filter": { "controller": "Opponent", "other": true },
          "min": 1,
          "max": 1,
          "then": [
            { "type": "Exile", "what": { "type": "Remembered" }, "until_source_leaves": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "This creature can't be blocked.\nWhen this creature enters, an opponent chooses a permanent you control other than this creature and exiles it.\nWhen this creature leaves the battlefield, return the exiled card to the battlefield under its owner's control."
