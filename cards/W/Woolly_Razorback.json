      "what": {
        "type": "Damage",
        "source": { "this": true },
        "combat": true,
        "prevent": true
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Blocks", "once": true, "filter": { "this": true } },
      "effects": [
        { "type": "RemoveCounters", "what": { "type": "This" }, "kind": "Ice", "n": { "type": "Fixed", "n": 1 } }
