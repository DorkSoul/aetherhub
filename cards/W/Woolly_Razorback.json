{
  "name": "Woolly Razorback",
  "mana_cost": "{2}{W}{W}",
  "types": ["Creature"],
  "subtypes": ["Boar", "Beast"],
  "power": 7,
  "toughness": 7,
  "abilities": [
    {
      "type": "EntersWithCounters",
      "kind": "Ice",
      "n": { "type": "Fixed", "n": 3 }
    },
    {
