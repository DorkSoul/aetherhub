{
  "name": "Orim's Thunder",
  "mana_cost": "{2}{W}",
  "types": ["Instant"],
  "abilities": [
    { "type": "Kicker", "cost": [{ "type": "Mana", "cost": "{R}" }] },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact", "Enchantment"] } },
          "label": "target artifact or enchantment"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "when_kicked": true,
          "label": "target creature (kicked only)"
        }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [
            {
              "type": "DealDamage",
              "source": { "type": "This" },
              "to": { "type": "Target", "idx": 1 },
              "amount": { "type": "ManaValueOf", "of": { "type": "Target", "idx": 0 } }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Kicker {R} (You may pay an additional {R} as you cast this spell.)\nDestroy target artifact or enchantment. If this spell was kicked, it deals damage equal to that permanent's mana value to target creature."
}
