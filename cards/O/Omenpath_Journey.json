{
  "name": "Omenpath Journey",
  "mana_cost": "{3}{G}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Library",
          "filter": { "types": ["Land"], "owner": "You" },
          "min": 0,
          "max": 5,
          "distinct": "Name",
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Exile" }
          ]
        },
        { "type": "Shuffle", "who": { "type": "You" } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Exile",
          "filter": { "exiled_with_this": true },
          "min": 1,
          "max": 1,
          "random": true,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "tapped": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this enchantment enters, search your library for up to five land cards that have different names, exile them, then shuffle.\nAt the beginning of your end step, choose a card at random exiled with this enchantment and put it onto the battlefield tapped."
}
