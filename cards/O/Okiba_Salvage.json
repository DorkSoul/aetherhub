            "cs": [
              { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Artifact"], "controller": "You" }, "at_least": 1 },
              { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Enchantment"], "controller": "You" }, "at_least": 1 }
            ]
          },
          "then": [
            { "type": "AddCounters", "what": { "type": "Remembered" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 } }
