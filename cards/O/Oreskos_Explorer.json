{
  "name": "Oreskos Explorer",
  "mana_cost": "{1}{W}",
  "types": ["Creature"],
  "subtypes": ["Cat", "Scout"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "EachOpponent" },
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "CompareAmounts",
                "a": { "type": "Count", "filter": { "types": ["Land"] }, "zone": "Battlefield", "player": { "type": "EachObject" } },
                "op": "Gt",
                "b": { "type": "Count", "filter": { "types": ["Land"] }, "zone": "Battlefield", "player": { "type": "You" } }
              },
              "then": [
                {
                  "type": "SearchLibrary",
                  "who": { "type": "You" },
                  "filter": { "subtypes": ["Plains"] },
                  "n": { "type": "Fixed", "n": 1 },
                  "to": "Hand",
                  "reveal": true,
                  "shuffle": true
                }
              ],
              "else": []
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, search your library for up to X Plains cards, where X is the number of players who control more lands than you. Reveal those cards, put them into your hand, then shuffle."
}
