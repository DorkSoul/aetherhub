{
  "name": "Overload",
  "mana_cost": "{R}",
  "types": ["Instant"],
  "abilities": [
    { "type": "Kicker", "cost": [{ "type": "Mana", "cost": "{2}" }] },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact"], "mana_value": { "op": "Le", "n": 2 } } },
          "when_kicked": false,
          "label": "target artifact with mana value 2 or less"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact"], "mana_value": { "op": "Le", "n": 5 } } },
          "when_kicked": true,
          "label": "target artifact with mana value 5 or less (kicked only)"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [ { "type": "Destroy", "what": { "type": "Target", "idx": 1 } } ],
          "else": [ { "type": "Destroy", "what": { "type": "Target", "idx": 0 } } ]
        }
      ]
    }
  ],
  "oracle_text": "Kicker {2} (You may pay an additional {2} as you cast this spell.)\nDestroy target artifact if its mana value is 2 or less. If this spell was kicked, destroy that artifact if its mana value is 5 or less instead."
