{
  "name": "Olivia's Midnight Ambush",
  "mana_cost": "{1}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" } ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "IsNight" },
          "then": [ { "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": -13 }, "toughness": { "type": "Fixed", "n": -13 }, "duration": "UntilEndOfTurn" } ],
          "else": [ { "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": -2 }, "toughness": { "type": "Fixed", "n": -2 }, "duration": "UntilEndOfTurn" } ]
        }
      ]
    }
  ],
  "oracle_text": "Target creature gets -2/-2 until end of turn. If it's night, that creature gets -13/-13 until end of turn instead."
}
