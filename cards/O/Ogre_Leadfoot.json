{
  "name": "Ogre Leadfoot",
  "mana_cost": "{4}{R}",
  "types": ["Creature"],
  "subtypes": ["Ogre"],
  "colors": ["R"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BecomesBlocked", "filter": { "this": true }, "by_each": true },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "TriggerObject" },
          "effects": [
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "all_types": ["Artifact", "Creature"] } },
              "then": [ { "type": "Destroy", "what": { "type": "Remembered" } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever this creature becomes blocked by an artifact creature, destroy that creature."
}
