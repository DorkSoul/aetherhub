{
  "name": "Overwrite the Multiverse",
  "mana_cost": "{4}{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Planeswalker"], "subtypes": ["Jace"], "token": true, "controller": "You" }, "at_least": 1 } },
          "then": [ { "type": "CreateToken", "token": "Jace" } ],
          "else": []
        },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "filter": { "types": ["Planeswalker"], "subtypes": ["Jace"], "token": true, "controller": "You" },
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "ForEach",
              "objects": { "type": "Remembered" },
              "effects": [
                { "type": "Exile", "what": { "type": "All", "filter": { "types": ["Creature"] }, "zone": "Battlefield" } },
                { "type": "AddCounters", "what": { "type": "EachObject" }, "kind": "Loyalty", "n": { "type": "RememberedCount" } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile all creatures. Empower Jace X, where X is the number of creatures exiled this way. (Put that many loyalty counters on a Jace token you control. If you don't control one, first create a blue Jace planeswalker token with \"[−1]: Surveil 1\" and \"[−3]: Draw a card.\")"
}
