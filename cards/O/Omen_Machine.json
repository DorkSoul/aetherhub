{
  "name": "Omen Machine",
  "mana_cost": "{6}",
  "types": ["Artifact"],
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "Draw",
        "who": "Any",
        "instead": [ { "type": "Nothing" } ]
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Draw", "whose": "Any" },
      "effects": [
        { "type": "LookAtTop", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 },
          "filter": {}, "all": true, "take": 1, "to": "Exile", "rest": "Library" },
        { "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "types": ["Land"] } },
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ],
          "else": [ { "type": "CastFree", "what": { "type": "Remembered" }, "by": { "type": "TriggerPlayer" } } ] }
      ]
    }
  ],
  "oracle_text": "Players can't draw cards.\nAt the beginning of each player's draw step, that player exiles the top card of their library. If it's a land card, the player puts it onto the battlefield. Otherwise, the player casts it without paying its mana cost if able."
}
