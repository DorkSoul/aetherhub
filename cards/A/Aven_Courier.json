{
  "name": "Aven Courier",
  "mana_cost": "{1}{U}",
  "types": ["Creature"],
  "subtypes": ["Bird", "Advisor"],
  "power": 1,
  "toughness": 1,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Permanent", "filter": { "controller": "You" } }, "label": "target permanent you control" }
      ],
      "effects": [
        {
          "type": "ChooseCounterKindAdd",
          "among": { "type": "All", "filter": { "controller": "You", "has_any_counter": true } },
          "to": { "type": "Target", "idx": 0 }
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhenever this creature attacks, choose a counter on a permanent you control. Put a counter of that kind on target permanent you control if it doesn't have a counter of that kind on it."
}
