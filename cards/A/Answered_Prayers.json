{
  "name": "Answered Prayers",
  "mana_cost": "{1}{W}{W}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "types": ["Creature"], "controller": "You" } },
      "effects": [
        { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": {
            "type": "Not",
            "c": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "this": true, "types": ["Creature"] } }
          },
          "then": [
            {
              "type": "Animate",
              "what": { "type": "This" },
              "duration": "UntilEndOfTurn",
              "add_types": ["Creature"],
              "add_subtypes": ["Angel"],
              "power": 3,
              "toughness": 3,
              "keywords": ["Flying"]
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Whenever a creature you control enters, you gain 1 life. If this enchantment isn't a creature, it becomes a 3/3 Angel creature with flying in addition to its other types until end of turn."
}
