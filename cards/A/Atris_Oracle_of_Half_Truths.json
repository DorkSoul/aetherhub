{
  "name": "Atris, Oracle of Half-Truths",
  "mana_cost": "{2}{U}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Advisor"],
  "power": 3,
  "toughness": 2,
  "keywords": ["Menace"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [ { "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" } ],
      "effects": [
        { "type": "RevealUntil", "who": { "type": "You" }, "filter": {}, "count": { "type": "Fixed", "n": 3 }, "to": "Exile", "rest": "Library" },
        {
          "type": "Choose",
          "who": { "type": "Target", "idx": 0 },
          "zone": "Exile",
          "filter": { "among_remembered": true },
          "min": 0,
          "max": 3,
          "from": { "type": "You" },
          "then": [
            {
              "type": "May",
              "who": { "type": "You" },
              "effects": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" },
                { "type": "Move", "what": { "type": "ExiledWithThis" }, "to": "Graveyard" }
              ],
              "otherwise": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Graveyard" },
                { "type": "Move", "what": { "type": "ExiledWithThis" }, "to": "Hand" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Menace\nWhen Atris enters, target opponent looks at the top three cards of your library and separates them into a face-down pile and a face-up pile. Put one pile into your hand and the other into your graveyard."
}
