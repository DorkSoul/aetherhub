{
  "name": "Aphelia, Viper Whisperer",
  "mana_cost": "{1}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Gorgon", "Assassin"],
  "power": 1,
  "toughness": 3,
  "keywords": ["Deathtouch"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        {
          "type": "MayPay",
          "payer": { "type": "You" },
          "cost": [{ "type": "Mana", "cost": "{1}{B/G}" }],
          "effects": [
            { "type": "CreateToken", "token": "Snake 1-1 Black Deathtouch", "controller": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    },
    {
      "type": "Activated",
      "cost": [{ "type": "Mana", "cost": "{4}{B}" }],
      "effects": [
        {
          "type": "AddTrigger",
          "trigger": {
            "type": "CombatDamageToPlayer",
            "batched": true,
            "filter": {
              "controller": "You",
              "any_of": [{ "subtypes": ["Gorgon"] }, { "subtypes": ["Snake"] }]
            }
          },
          "effects": [
            {
              "type": "LoseLife",
              "who": { "type": "TriggerPlayer" },
              "n": {
                "type": "Half",
                "a": { "type": "LifeOf", "who": { "type": "TriggerPlayer" } },
                "round_up": true
              }
            }
          ],
          "until": "EndOfTurn"
        }
      ]
    }
  ],
  "oracle_text": "Deathtouch\nWhenever Aphelia attacks, you may pay {1}{B/G}. If you do, create a 1/1 black Snake creature token with deathtouch.\n{4}{B}: Until end of turn, whenever one or more Gorgons and/or Snakes you control deal combat damage to a player, that player loses half their life, rounded up."
}
