{
  "name": "Arachne, Psionic Weaver",
  "mana_cost": "{2}{W}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Spider", "Human", "Hero"],
  "colors": ["W"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "AlternativeCost",
      "cost": [
        { "type": "Mana", "cost": "{W}" },
        { "type": "ReturnToHand", "filter": { "types": ["Creature"], "controller": "You", "tapped": true }, "n": 1 }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
