      "effects": [
        { "type": "LookAtHand", "who": { "type": "Target", "idx": 0 } },
        { "type": "ChooseCardType", "who": { "type": "You" }, "excluding": ["Creature"] }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "CostChange", "filter": { "chosen_type": true }, "generic": 1, "whose": "Any" }
    }
  ],
  "oracle_text": "Web-slinging {W} (You may cast this spell for {W} if you also return a tapped creature you control to its owner's hand.)\nAs Arachne enters, look at an opponent's hand, then choose a card type other than creature.\nSpells of the chosen type cost {1} more to cast."
}
