{
  "name": "Argoth, Sanctum of Nature",
  "types": ["Land"],
  "abilities": [
    { "type": "EntersTapped",
      "unless": { "type": "Control", "who": { "type": "You" }, "at_least": 1,
        "filter": { "types": ["Creature"], "supertypes": ["Legendary"], "colors": ["G"], "controller": "You" } } },
    { "type": "Activated", "cost": [{ "type": "Tap" }],
      "effects": [{ "type": "AddMana", "mana": [{ "t": "Fixed", "m": "G", "n": 1 }] }] },
    { "type": "Activated", "timing": "Sorcery",
      "cost": [{ "type": "Mana", "cost": "{2}{G}{G}" }, { "type": "Tap" }],
      "effects": [
        { "type": "CreateToken", "token": "Bear" },
        { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 } }
      ] }
  ],
  "oracle_text": "This land enters tapped unless you control a legendary green creature.\n{T}: Add {G}.\n{2}{G}{G}, {T}: Create a 2/2 green Bear creature token, then mill three cards. Activate only as a sorcery.\n(Melds with Titania, Voice of Gaea.)"
}
