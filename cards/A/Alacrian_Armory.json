{
  "name": "Alacrian Armory",
  "mana_cost": "{3}{W}",
  "types": ["Artifact"],
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "Modify",
        "affects": { "types": ["Creature"], "controller": "You" },
        "power": { "type": "Fixed", "n": 0 },
        "toughness": { "type": "Fixed", "n": 1 }
      }
    },
    {
      "type": "Static",
      "effect": {
        "type": "GrantKeyword",
        "affects": { "types": ["Creature"], "controller": "You" },
        "keyword": "Vigilance"
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat", "whose": "You" },
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": {
              "any_of": [
                { "subtypes": ["Mount"], "controller": "You" },
                { "subtypes": ["Vehicle"], "controller": "You" }
              ]
            }
          },
          "min": 0,
          "max": 1,
          "label": "target Mount or Vehicle you control"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "Target", "idx": 0 }, "filter": { "subtypes": ["Mount"] } },
          "then": [ { "type": "SaddleTargets", "what": { "type": "Target", "idx": 0 } } ]
        },
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "Target", "idx": 0 }, "filter": { "subtypes": ["Vehicle"] } },
          "then": [
            {
              "type": "Animate",
              "what": { "type": "Target", "idx": 0 },
              "add_types": ["Artifact", "Creature"],
              "duration": "UntilEndOfTurn"
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Creatures you control get +0/+1 and have vigilance.\nAt the beginning of combat on your turn, choose up to one target Mount or Vehicle you control. Until end of turn, that permanent becomes saddled if it's a Mount and becomes an artifact creature if it's a Vehicle."
}
