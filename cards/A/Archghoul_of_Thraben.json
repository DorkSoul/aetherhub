{
  "name": "Archghoul of Thraben",
  "mana_cost": "{2}{B}",
  "types": ["Creature"],
  "subtypes": ["Zombie", "Cleric"],
  "power": 3,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "Dies",
        "filter": { "any_of": [{ "this": true }, { "subtypes": ["Zombie"], "controller": "You", "other": true }] }
      },
      "effects": [
        {
          "type": "May",
          "effects": [
            {
              "type": "LookAtTop",
              "who": { "type": "You" },
              "n": { "type": "Fixed", "n": 1 },
              "filter": { "subtypes": ["Zombie"] },
              "take": 1,
              "must": true,
              "rest": "Library",
              "keep_on_top": true
            }
          ]
        },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Eq", "n": 0 } },
          "then": [
            {
              "type": "May",
              "effects": [
                { "type": "Move", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "to": "Graveyard" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever this creature or another Zombie you control dies, look at the top card of your library. If it's a Zombie card, you may reveal it and put it into your hand. If you don't put the card into your hand, you may put it into your graveyard."
}
