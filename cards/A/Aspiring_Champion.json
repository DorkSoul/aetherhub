{
  "name": "Aspiring Champion",
  "mana_cost": "{3}{R}",
  "types": ["Creature"],
  "subtypes": ["Astartes", "Warrior"],
  "power": 3,
  "toughness": 3,
  "keywords": ["Menace"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "DealsCombatDamage",
        "filter": { "this": true },
        "to": "Player"
      },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "who": { "type": "You" },
            "filter": { "this": true },
            "at_least": 1
          },
          "then": [
            {
              "type": "Sacrifice",
              "who": { "type": "You" },
              "filter": { "this": true },
              "n": { "type": "Fixed", "n": 1 }
            },
            {
              "type": "RevealUntil",
              "who": { "type": "You" },
              "filter": { "types": ["Creature"] },
              "count": { "type": "Fixed", "n": 1 },
              "to": "Battlefield",
              "rest": "Library",
              "rest_random": true
            },
            {
              "type": "If",
              "cond": {
                "type": "RememberedIs",
                "filter": { "subtypes": ["Demon"] }
              },
              "then": [
                {
                  "type": "DealDamage",
                  "amount": { "type": "PowerOf", "of": { "type": "Remembered" } },
                  "to": { "type": "EachOpponent" }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Menace\nRuinous Ascension — When this creature deals combat damage to a player, sacrifice it. If you do, reveal cards from the top of your library until you reveal a creature card. Put that card onto the battlefield, then shuffle the rest into your library. If that creature is a Demon, it deals damage equal to its power to each opponent."
}
