{
  "name": "Ardent Dustspeaker",
  "mana_cost": "{4}{R}",
  "types": ["Creature"],
  "subtypes": ["Minotaur", "Shaman"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "optional": true,
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "any_of": [ { "types": ["Instant"] }, { "types": ["Sorcery"] } ], "owner": "You" },
          "min": 1,
          "max": 1,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Library" },
            { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 }, "take": 2, "all": true, "filter": {}, "to": "Exile", "rest": "Library" },
            { "type": "GrantPlayFromExile", "what": { "type": "Remembered" }, "window": "ThisTurn" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever this creature attacks, you may put an instant or sorcery card from your graveyard on the bottom of your library. If you do, exile the top two cards of your library. You may play those cards this turn."
}
