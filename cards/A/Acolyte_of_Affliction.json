{
  "name": "Acolyte of Affliction",
  "mana_cost": "{2}{B}{G}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } },
        {
          "type": "May",
          "effects": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Graveyard",
              "filter": { "any_of": [ { "types": ["Artifact"] }, { "types": ["Creature"] }, { "types": ["Enchantment"] }, { "types": ["Land"] }, { "types": ["Planeswalker"] } ] },
              "min": 1,
              "max": 1,
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, mill two cards, then you may return a permanent card from your graveyard to your hand."
}
