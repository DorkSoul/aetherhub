 "types": ["Instant"],
 "abilities": [
  {
   "type": "Modal",
   "choose_min": 1,
   "choose_max": 1,
   "modes": [
    {
     "text": "Search your library for a creature or land card and reveal it. Put it onto the battlefield tapped if it's a land card. Otherwise, put it into your hand. Then shuffle.",
     "effects": [
      {
       "type": "Choose",
       "who": {"type": "You"},
       "zone": "Library",
       "filter": {"any_of": [{"types": ["Creature"]}, {"types": ["Land"]}], "owner": "You"},
       "min": 1,
       "max": 1,
       "then": [
        {
         "type": "If",
         "cond": {"type": "RememberedIs", "filter": {"types": ["Land"]}},
         "then": [
          {"type": "Move", "what": {"type": "Remembered"}, "to": "Battlefield", "tapped": true}
         ],
         "else": [
          {"type": "Move", "what": {"type": "Remembered"}, "to": "Hand"}
         ]
        }
       ]
      },
      {"type": "Shuffle", "who": {"type": "You"}}
     ]
    },
    {
     "text": "Put a +1/+1 counter on target creature you control. It deals damage equal to its power to target creature you don't control.",
     "targets": [
      {"what": {"type": "Permanent", "filter": {"types": ["Creature"], "controller": "You"}}, "label": "creature you control"},
      {"what": {"type": "Permanent", "filter": {"types": ["Creature"], "controller": "Opponent"}}, "label": "creature you don't control"}
     ],
     "effects": [
      {"type": "AddCounters", "kind": "PlusOnePlusOne", "n": {"type": "Fixed", "n": 1}, "what": {"type": "Target", "idx": 0}},
      {"type": "DealDamage", "amount": {"type": "PowerOf", "of": {"type": "Target", "idx": 0}}, "source": {"type": "Target", "idx": 0}, "to": {"type": "Target", "idx": 1}}
     ]
    },
    {
     "text": "Exile target artifact or enchantment.",
     "targets": [
      {"what": {"type": "Permanent", "filter": {"any_of": [{"types": ["Artifact"]}, {"types": ["Enchantment"]}]}}, "label": "target artifact or enchantment"}
     ],
     "effects": [
      {"type": "Exile", "what": {"type": "Target", "idx": 0}}
     ]
    }
   ]
  }
 ],
 "oracle_text": "Choose one —\n• Search your library for a creature or land card and reveal it. Put it onto the battlefield tapped if it's a land card. Otherwise, put it into your hand. Then shuffle.\n• Put a +1/+1 counter on target creature you control. It deals damage equal to its power to target creature you don't control.\n• Exile target artifact or enchantment."
