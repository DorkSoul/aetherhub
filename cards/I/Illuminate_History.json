{
  "name": "Illuminate History",
  "mana_cost": "{2}{R}{R}",
  "types": ["Sorcery"],
  "subtypes": ["Lesson"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "Choose", "who": { "type": "You" }, "zone": "Hand", "min": 0, "max": 255,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Graveyard", "discard": true, "remember": true }
          ] },
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "RememberedCount" } },
        { "type": "If",
          "cond": { "type": "Compare", "a": { "type": "GraveyardSize", "who": { "type": "You" } }, "cmp": { "op": "Ge", "n": 7 } },
          "then": [ { "type": "CreateToken", "token": "Spirit 3-2 Red White" } ] }
      ]
    }
  ],
  "oracle_text": "Discard any number of cards, then draw that many cards. Then if there are seven or more cards in your graveyard, create a 3/2 red and white Spirit creature token."
}
