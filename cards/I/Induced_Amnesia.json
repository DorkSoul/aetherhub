{
  "name": "Induced Amnesia",
  "mana_cost": "{2}{U}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Player", "filter": "Any" }, "label": "target player" }
      ],
      "effects": [
        {
          "type": "Exile",
          "what": { "type": "AllOfPlayer", "player": { "type": "Target", "idx": 0 }, "zone": "Hand" },
          "face_down": true
        },
        {
          "type": "Draw",
          "who": { "type": "Target", "idx": 0 },
          "n": { "type": "Count", "filter": { "exiled_with_this": true }, "zone": "Exile" }
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "ChangesZone", "filter": { "this": true }, "from": "Battlefield", "to": "Graveyard" },
      "effects": [
        { "type": "Move", "what": { "type": "ExiledWithThis" }, "to": "Hand" }
      ]
    }
  ],
  "oracle_text": "When this enchantment enters, target player exiles all cards from their hand face down, then draws that many cards.\nWhen this enchantment is put into a graveyard from the battlefield, return the exiled cards to their owner's hand."
}
