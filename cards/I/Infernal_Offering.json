{
  "name": "Infernal Offering",
  "mana_cost": "{4}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "ChoosePlayer", "who": { "type": "You" }, "opponent": true },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Creature"] }, "at_least": 1 },
          "then": [
            { "type": "Sacrifice", "who": { "type": "You" }, "filter": { "types": ["Creature"] }, "n": { "type": "Fixed", "n": 1 } },
            { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } }
          ]
        },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "ChosenPlayer" }, "filter": { "types": ["Creature"] }, "at_least": 1 },
          "then": [
            { "type": "Sacrifice", "who": { "type": "ChosenPlayer" }, "filter": { "types": ["Creature"] }, "n": { "type": "Fixed", "n": 1 } },
            { "type": "Draw", "who": { "type": "ChosenPlayer" }, "n": { "type": "Fixed", "n": 2 } }
          ]
        },
        { "type": "ChoosePlayer", "who": { "type": "You" }, "opponent": true },
        {
          "type": "Choose", "who": { "type": "You" }, "zone": "Graveyard", "filter": { "types": ["Creature"] }, "min": 1, "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "from": "Graveyard", "to": "Battlefield" } ]
        },
        {
          "type": "Choose", "who": { "type": "ChosenPlayer" }, "zone": "Graveyard", "filter": { "types": ["Creature"] }, "min": 1, "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "from": "Graveyard", "to": "Battlefield" } ]
        }
      ]
    }
  ],
  "oracle_text": "Choose an opponent. You and that player each sacrifice a creature. Each player who sacrificed a creature this way draws two cards.\nChoose an opponent. Return a creature card from your graveyard to the battlefield, then that player returns a creature card from their graveyard to the battlefield."
}
