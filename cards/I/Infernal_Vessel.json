      "effects": [
        { "type": "Move", "what": { "type": "This" }, "from": "Graveyard", "to": "Battlefield", "remember": true },
        { "type": "AddCounters", "what": { "type": "Remembered" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 } },
