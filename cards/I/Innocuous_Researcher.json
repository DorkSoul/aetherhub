{
  "name": "Innocuous Researcher",
  "mana_cost": "{3}{G}",
  "types": ["Creature"],
  "subtypes": ["Centaur", "Detective"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        { "type": "RevealTop", "who": { "type": "EachPlayer" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Investigate", "n": { "type": "Count", "filter": { "among_remembered": true, "not_types": ["Land"] }, "zone": "Library" } },
        { "type": "Draw", "who": { "type": "EachPlayer" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "ClearRemembered" }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "optional": true,
      "effects": [
        { "type": "Untap", "what": { "type": "All", "filter": { "types": ["Land"], "controller": "You" }, "zone": "Battlefield" } },
        { "type": "Restrict", "who": { "type": "You" }, "what": "CantCast", "duration": "UntilYourNextTurn" }
      ]
    }
  ],
  "oracle_text": "Parley — Whenever this creature attacks, each player reveals the top card of their library. For each nonland card revealed this way, you investigate. Then each player draws a card.\nAt the beginning of your end step, you may untap all lands you control. If you do, you can't cast spells until your next turn."
}
