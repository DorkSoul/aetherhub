{
  "name": "Invasive Maneuvers",
  "mana_cost": "{1}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": { "types": ["Creature"] }
          },
          "label": "target creature"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Control",
            "who": { "type": "You" },
            "at_least": 1,
            "filter": { "subtypes": ["Spacecraft"] }
          },
          "then": [
            { "type": "DealDamage", "to": { "type": "Target", "idx": 0 }, "amount": { "type": "Fixed", "n": 5 } }
          ],
          "else": [
            { "type": "DealDamage", "to": { "type": "Target", "idx": 0 }, "amount": { "type": "Fixed", "n": 3 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Invasive Maneuvers deals 3 damage to target creature. It deals 5 damage instead if you control a Spacecraft."
