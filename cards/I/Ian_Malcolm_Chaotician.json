{
  "name": "Ian Malcolm, Chaotician",
  "mana_cost": "{1}{U}{R}",
  "supertypes": ["Legendary"],
  "types": ["Creature"],
  "subtypes": ["Human", "Scientist"],
  "colors": ["U", "R"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Draws", "who": "Any", "nth_this_turn": 2 },
      "effects": [
        { "type": "ExileTopOfLibrary", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 } }
      ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "MayPlayFrom",
        "zone": "Exile",
        "active_player": true,
        "filter": { "exiled_with_this": true, "owner": "Opponent", "not_types": ["Land"] }
      }
    },
    {
      "type": "Static",
      "effect": {
        "type": "SpendManaAsAnyType",
        "whose": "Any",
        "filter": { "exiled_with_this": true },
        "abilities": false
      }
    }
  ],
  "oracle_text": "Whenever a player draws their second card each turn, that player exiles the top card of their library.\nDuring each player's turn, that player may cast a spell from among the cards they don't own exiled with Ian Malcolm, and mana of any type can be spent to cast it."
}
