[
 { "name": "gaining life for the first time in a turn prepares the creature; the copy then drains 2",
   "players": [ { "battlefield": ["Leech Collector // Bloodletting", {"name": "Pest 1-1 Attack Lifegain", "sick": false}, "Swamp"] }, {} ],
   "steps": [ { "attack": [ { "card": "Pest 1-1 Attack Lifegain", "at": "p1" } ] }, { "resolve": true }, { "resolve": true },
              { "advance_to": "Main2" },
              { "cast": "Bloodletting" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 21 }, { "life": 17 } ] } },
 { "name": "an unprepared creature's spell copy cannot be cast",
   "players": [ { "battlefield": ["Leech Collector // Bloodletting", "Swamp"] }, {} ],
   "steps": [ { "cast": "Bloodletting", "illegal": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "the spell cannot be cast from hand",
   "players": [ { "hand": ["Leech Collector // Bloodletting"], "battlefield": ["Swamp", "Swamp"] }, {} ],
   "steps": [ { "cast": "Bloodletting", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Leech Collector // Bloodletting"] }, { "life": 20 } ] } },
 { "name": "ruling: the prepared copy stays in exile across turns while the creature stays prepared",
   "players": [ { "battlefield": ["Leech Collector // Bloodletting", {"name": "Pest 1-1 Attack Lifegain", "sick": false}, "Swamp"] }, {} ],
   "steps": [ { "attack": [ { "card": "Pest 1-1 Attack Lifegain", "at": "p1" } ] }, { "resolve": true }, { "resolve": true },
              { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "life": 21, "exile": ["Bloodletting"], "battlefield_has": ["Leech Collector // Bloodletting"] }, {} ] } },
 { "name": "ruling: a second lifegain in a later turn does not prepare it again or make a second copy in exile",
   "players": [ { "battlefield": ["Leech Collector // Bloodletting", {"name": "Pest 1-1 Attack Lifegain", "sick": false}, "Swamp"] }, {} ],
   "steps": [ { "attack": [ { "card": "Pest 1-1 Attack Lifegain", "at": "p1" } ] }, { "resolve": true }, { "resolve": true },
              { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Pest 1-1 Attack Lifegain", "at": "p1" } ] }, { "resolve": true }, { "resolve": true },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 22, "exile": ["Bloodletting"] }, {} ] } }
]
