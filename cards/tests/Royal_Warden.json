[
  {"name": "ETB creates two tapped Necron Warrior tokens",
   "players": [{"hand": ["Royal Warden"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"]}, {}],
   "steps": [{"cast": "Royal Warden"}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Royal Warden", "Necron Warrior 2-2"]}, {}]}},
  {"name": "unearth from the graveyard returns it with the ETB tokens; exiled at end step",
   "players": [{"graveyard": ["Royal Warden"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]}, {}],
   "steps": [{"activate": "Royal Warden", "ability": 0}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Royal Warden", "Necron Warrior 2-2"]}, {}]}},
  {"name": "unearth: the returned Warden is exiled at the beginning of the end step, the tokens stay",
   "players": [{"graveyard": ["Royal Warden"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]}, {}],
   "steps": [{"activate": "Royal Warden", "ability": 0}, {"resolve": true}, {"resolve": true}, {"advance_to": "End"}],
   "expect": {"players": [{"exile": ["Royal Warden"], "battlefield_has": ["Necron Warrior 2-2"], "battlefield_lacks": ["Royal Warden"]}, {}]}},
  {"name": "unearth: a Murder on the returned Warden exiles it instead of putting it in the graveyard",
   "players": [{"graveyard": ["Royal Warden"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]}, {"hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"]}],
   "steps": [{"activate": "Royal Warden", "ability": 0}, {"resolve": true}, {"resolve": true}, {"pass": true}, {"cast": "Murder", "player": 1, "targets": ["Royal Warden"]}, {"resolve": true}],
   "expect": {"players": [{"exile": ["Royal Warden"], "battlefield_has": ["Necron Warrior 2-2"]}, {"graveyard_has": ["Murder"]}]}},
  {"name": "unearth gives haste: the returned Warden attacks the turn it comes back for 3",
   "players": [{"graveyard": ["Royal Warden"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]}, {}],
   "steps": [{"activate": "Royal Warden", "ability": 0}, {"resolve": true}, {"resolve": true}, {"attack": [{"card": "Royal Warden", "at": "p1"}]}, {"advance_to": "Main2"}],
   "expect": {"players": [{"battlefield_has": ["Royal Warden"]}, {"life": 17}]}},
  {"name": "ruling: Stifle counters the unearth ability, so the Warden stays in the graveyard",
   "players": [{"graveyard": ["Royal Warden"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]}, {"hand": ["Stifle"], "battlefield": ["Island"]}],
   "steps": [{"activate": "Royal Warden", "ability": 0}, {"pass": true}, {"cast": "Stifle", "player": 1, "targets": [{"stack": "Royal Warden"}]}, {"resolve": true}],
   "expect": {"players": [{"graveyard_has": ["Royal Warden"], "battlefield_lacks": ["Royal Warden"]}, {"graveyard_has": ["Stifle"]}]}},
  {"name": "ruling: Cancel cannot target an unearth ability, since it is not a spell",
   "players": [{"graveyard": ["Royal Warden"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]}, {"hand": ["Cancel"], "battlefield": ["Island", "Island", "Island"]}],
   "steps": [{"activate": "Royal Warden", "ability": 0}, {"pass": true}, {"cast": "Cancel", "player": 1, "targets": [{"stack": "Royal Warden"}], "illegal": true}],
   "expect": {"players": [{"graveyard_has": ["Royal Warden"]}, {"hand": ["Cancel"]}]}}
]
