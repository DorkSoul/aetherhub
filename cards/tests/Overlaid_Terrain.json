[
  {
    "name": "all lands you control are sacrificed as it enters",
    "players": [
      { "hand": ["Overlaid Terrain"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Island"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [ { "cast": "Overlaid Terrain" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield": ["Overlaid Terrain"], "graveyard": ["Forest", "Forest", "Forest", "Forest", "Island"] },
        { "battlefield": ["Mountain"] }
      ]
    }
  },
  {
    "name": "lands you control tap for two mana of any one color",
    "players": [
      { "hand": ["Overlaid Terrain", "Swamp"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [ { "cast": "Overlaid Terrain" }, { "resolve": true }, { "play_land": "Swamp" }, { "tap_for_mana": "Swamp", "color": "B" } ],
    "expect": {
      "players": [
        { "battlefield": ["Overlaid Terrain", "Swamp"], "pool": { "B": 2 } },
        {}
      ]
    }
  },
  {
    "name": "opponent's lands are not sacrificed",
    "players": [
      { "hand": ["Overlaid Terrain"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Mountain", "Island"] }
    ],
    "steps": [ { "cast": "Overlaid Terrain" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield": ["Mountain", "Island"] } ] }
  },
  {
    "name": "ruling: an untapped land is sacrificed before the enchantment enters, so its two-mana ability is never usable",
    "players": [
      { "hand": ["Overlaid Terrain"], "battlefield": ["Forest", "Forest", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [ { "cast": "Overlaid Terrain" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield": ["Overlaid Terrain"], "graveyard": ["Forest", "Forest", "Island", "Island", "Island"], "pool": { "U": 0 } },
        {}
      ]
    }
  }
]
