[
  {
    "name": "destroys an opponent's land; its controller fetches a basic",
    "players": [
      {
        "battlefield": [
          "Ghost Quarter"
        ]
      },
      {
        "battlefield": [
          "Forest"
        ],
        "library": [
          "Mountain",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Ghost Quarter",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true,
          "Island"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Ghost Quarter"
          ],
          "battlefield": []
        },
        {
          "graveyard": [
            "Forest"
          ],
          "battlefield": [
            "Island"
          ]
        }
      ]
    }
  },
  {
    "name": "the controller may decline to search",
    "players": [
      {
        "battlefield": [
          "Ghost Quarter"
        ]
      },
      {
        "battlefield": [
          "Forest"
        ],
        "library": [
          "Mountain",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Ghost Quarter",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Ghost Quarter"
          ]
        },
        {
          "graveyard": [
            "Forest"
          ],
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "taps for colorless",
    "players": [
      {
        "battlefield": [
          "Ghost Quarter"
        ],
        "hand": [
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sol Ring"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Ghost Quarter",
            "Sol Ring"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: targeting Ghost Quarter with its own ability: the ability fizzles and there is no search",
    "players": [ { "battlefield": ["Ghost Quarter"] }, {} ],
    "steps": [
      { "activate": "Ghost Quarter", "targets": ["Ghost Quarter"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Ghost Quarter"], "library_count": 20 }, {} ] }
  },
  {
    "name": "ruling: the targeted land is gone in response: the ability does nothing and its controller does not search",
    "players": [
      { "battlefield": ["Ghost Quarter"] },
      { "battlefield": ["Plains", "Ghost Quarter"] }
    ],
    "steps": [
      { "activate": "Ghost Quarter", "targets": ["p1:Plains"] },
      { "pass": true },
      { "activate": "Ghost Quarter", "player": 1, "targets": ["p1:Plains"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Ghost Quarter"] },
        { "graveyard_has": ["Plains", "Ghost Quarter"], "battlefield_lacks": ["Plains"], "library_count": 20 }
      ]
    }
  }
]