[
  {
    "name": "destroys two different target lands",
    "players": [
      {
        "hand": [
          "Rain of Salt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Forest",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Rain of Salt",
        "targets": [
          "Forest",
          "Island"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Rain of Salt"
          ]
        },
        {
          "graveyard": [
            "Forest",
            "Island"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a single target is not enough, two different lands are required",
    "players": [
      { "hand": ["Rain of Salt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest", "Island"] }
    ],
    "steps": [ { "cast": "Rain of Salt", "targets": ["Forest"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Rain of Salt"] }, { "battlefield_has": ["Forest", "Island"] } ] }
  },
  {
    "name": "ruling: the same land cannot be targeted twice",
    "players": [
      { "hand": ["Rain of Salt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest", "Island"] }
    ],
    "steps": [ { "cast": "Rain of Salt", "targets": ["Forest", "Forest"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Rain of Salt"] }, { "battlefield_has": ["Forest", "Island"] } ] }
  }
]
