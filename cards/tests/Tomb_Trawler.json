[
  {
    "name": "{2}: puts a card from your graveyard on the bottom of your library",
    "players": [ { "battlefield": ["Tomb Trawler", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Tomb Trawler" }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": [], "library_count": 21, "battlefield_has": ["Tomb Trawler"] }, {} ]
    }
  },
  {
    "name": "empty graveyard: no legal activation",
    "players": [ { "battlefield": ["Tomb Trawler", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Tomb Trawler", "illegal": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tomb Trawler"] }, {} ]
    }
  }
]
