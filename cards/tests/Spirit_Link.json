  {
    "name": "damage dealt to a blocker also counts; damage taken does not",
    "players": [
      {
        "hand": [
          "Spirit Link"
        ],
        "battlefield": [
          "Plains",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Spirit Link",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Hill Giant",
            "attacker": "Grizzly Bears"
          }
        ],
        "player": 1
      },
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 22,
          "graveyard_has": [
            "Grizzly Bears"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: a non-combat ping from the enchanted creature also gains life",
    "players": [ { "hand": ["Spirit Link"], "battlefield": ["Plains", "Prodigal Sorcerer"] }, {} ],
    "steps": [
      { "cast": "Spirit Link", "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "activate": "Prodigal Sorcerer", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 21 }, { "life": 19 } ] }
  },
  {
    "name": "ruling: the enchanted creature's damage kills its controller first, so no life is gained",
    "players": [ { "hand": ["Spirit Link"], "battlefield": ["Plains", "Prodigal Sorcerer"], "life": 1 }, {} ],
    "steps": [
      { "cast": "Spirit Link", "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "activate": "Prodigal Sorcerer", "ability": 0, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "winner": 1, "players": [ { "life": 0 }, { "life": 20 } ] }
  }
]