[
  {
    "name": "ruling: if the chosen target is illegal on resolution, Spider Food does nothing and creates no Food",
    "players": [
      { "hand": ["Spider Food", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Mountain"] },
      { "battlefield": ["Spectral Sailor"] }
    ],
    "steps": [
      { "cast": "Spider Food", "targets": ["Spectral Sailor"] },
      { "cast": "Lightning Bolt", "targets": ["Spectral Sailor"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Spider Food", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Mountain"] },
        { "graveyard_has": ["Spectral Sailor"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "ruling: a Food can't be sacrificed to pay both its own ability and Maraleaf Rider's",
    "players": [
      { "battlefield": ["Maraleaf Rider", "Food", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Food", "ability": 0 },
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Maraleaf Rider"], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "battlefield": ["Maraleaf Rider", "Forest", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Food is an artifact, never a creature, so creature-only removal can't target it",
    "players": [
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Food"] }
    ],
    "steps": [
      { "cast": "Doom Blade", "targets": ["Food"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Doom Blade"] },
        { "battlefield_has": ["Food"] }
      ]
    }
  },
  {
    "name": "destroys a creature with flying and creates a Food",
    "players": [
      {
        "hand": [
          "Spider Food"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Spider Food",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Spider Food"
          ],
          "battlefield_has": [
            "Food"
          ]
        },
        {
          "graveyard_has": [
            "Serra Angel"
          ]
        }
      ]
    }
  },
  {
    "name": "with no target chosen it still creates a Food",
    "players": [
      {
        "hand": [
          "Spider Food"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Spider Food"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Food"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  }
]
