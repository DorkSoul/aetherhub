[
  {
    "name": "ETB creates a 2/2 Zombie with decayed",
    "players": [
      { "hand": ["Falcon Abomination"], "battlefield": ["Plains", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Falcon Abomination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Falcon Abomination", "Zombie 2-2 Decayed"] },
        {}
      ]
    }
  },
  {
    "name": "decayed token can't block",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Zombie 2-2 Decayed"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Zombie 2-2 Decayed", "attacker": "Grizzly Bears" } ], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "decayed token that attacks is sacrificed at end of combat",
    "players": [
      { "battlefield": ["Zombie 2-2 Decayed"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Zombie 2-2 Decayed", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "EndCombat" }
    ],
    "expect": {
      "players": [ { "battlefield": [] }, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: decayed creates no attack requirement, a token that does not attack survives",
    "players": [
      { "battlefield": ["Zombie 2-2 Decayed"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Zombie 2-2 Decayed"] }, { "life": 20 } ]
    }
  }
]
