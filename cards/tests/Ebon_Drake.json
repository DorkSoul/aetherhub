[
  { "name": "you lose 1 life when you cast a spell",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Ebon Drake", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 19 }, { "life": 17 } ]
    }
  },
  { "name": "you lose 1 life when an opponent casts a spell",
    "players": [ { "battlefield": ["Ebon Drake"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 19 }, { "life": 17 } ]
    }
  },
  { "name": "ruling: the trigger fires for spells cast by either player in one game",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Ebon Drake", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 15 }, { "life": 17 } ]
    }
  }
]
