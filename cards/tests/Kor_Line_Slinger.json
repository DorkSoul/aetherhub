[
 {
  "name": "taps target creature with power 3 or less",
  "players": [
   {
    "battlefield": [
     "Kor Line-Slinger"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Kor Line-Slinger",
    "ability": 0,
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true,
    "Kor Line-Slinger": true
   },
   "players": [
    {},
    {
     "battlefield_has": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "can tap a creature with exactly power 3",
  "players": [
   {
    "battlefield": [
     "Kor Line-Slinger"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Kor Line-Slinger",
    "ability": 0,
    "targets": [
     "Hill Giant"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Hill Giant": true
   },
   "players": [
    {},
    {
     "battlefield_has": [
      "Hill Giant"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: power is checked again on resolution, so a pump in response makes the target illegal",
  "players": [
   { "battlefield": ["Kor Line-Slinger"] },
   { "hand": ["Giant Growth"], "battlefield": ["Hill Giant", "Forest"] }
  ],
  "steps": [
   { "activate": "Kor Line-Slinger", "ability": 0, "targets": ["Hill Giant"] },
   { "pass": true },
   { "cast": "Giant Growth", "targets": ["Hill Giant"], "player": 1 },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, { "battlefield_has": ["Hill Giant"] }],
   "tapped": { "Hill Giant": false }
  }
 },
 {
  "name": "cannot target a creature with power 4 or more",
  "players": [
   { "battlefield": ["Kor Line-Slinger"] },
   { "battlefield": ["Rushwood Elemental"] }
  ],
  "steps": [
   { "activate": "Kor Line-Slinger", "ability": 0, "targets": ["Rushwood Elemental"], "illegal": true }
  ],
  "expect": {
   "players": [{}, { "battlefield_has": ["Rushwood Elemental"] }]
  }
 }
]