[
  {
    "name": "enchanted creature gets +2/-1",
    "players": [
      { "hand": ["Infectious Rage"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Infectious Rage", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 1] },
      "attached": { "Infectious Rage": "Grizzly Bears" }
    }
  },
  {
    "name": "when the enchanted creature dies the Aura returns attached to another creature",
    "players": [
      { "hand": ["Infectious Rage"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Infectious Rage", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Terror", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Infectious Rage": "Hill Giant" },
      "pt": { "Hill Giant": [5, 2] },
      "players": [ { "graveyard": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "a creature with protection from red can't be chosen",
    "players": [
      { "hand": ["Infectious Rage"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp", "Soltari Priest", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Infectious Rage", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Terror", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Infectious Rage": "Hill Giant" }
    }
  },
  {
    "name": "no other creature: the Aura stays in the graveyard",
    "players": [
      { "hand": ["Infectious Rage"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Infectious Rage", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Terror", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears", "Infectious Rage"] }, {} ]
    }
  },
  {
    "name": "ruling: cannot return to a creature with protection from red (the only candidate), so it stays in the graveyard",
    "players": [
      { "hand": ["Infectious Rage"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp", "Silver Knight"] }
    ],
    "steps": [
      { "cast": "Infectious Rage", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Terror", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears", "Infectious Rage"] }, { "battlefield_has": ["Silver Knight"] } ]
    }
  },
  {
    "name": "ruling: returns attached to a shroud creature without targeting it",
    "players": [
      { "hand": ["Infectious Rage"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp", "Mist Leopard"] }
    ],
    "steps": [
      { "cast": "Infectious Rage", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Terror", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Infectious Rage": "Mist Leopard" },
      "pt": { "Mist Leopard": [5, 1] },
      "players": [ { "graveyard": ["Grizzly Bears"] }, {} ]
    }
  }
]
