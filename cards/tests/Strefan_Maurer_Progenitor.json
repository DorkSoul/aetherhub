[
  {
    "name": "end step: one Blood token for the opponent who lost life",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Strefan, Maurer Progenitor", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Blood"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "end step: a Blood token for each player who lost life, including yourself",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Strefan, Maurer Progenitor", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Blood", "Blood"], "life": 17 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "end step: nobody lost life, no Blood token",
    "players": [
      { "battlefield": ["Strefan, Maurer Progenitor"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Blood"] },
        {}
      ]
    }
  },
  {
    "name": "attack: sacrifice two Blood tokens to put a Vampire from hand attacking",
    "players": [
      { "hand": ["Vampire Nighthawk"], "battlefield": ["Strefan, Maurer Progenitor", "Blood", "Blood"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Strefan, Maurer Progenitor", "at": "p1" } ] },
      { "block": [], "answers": [true, ["Vampire Nighthawk"]] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Strefan, Maurer Progenitor", "Vampire Nighthawk", "Blood"], "life": 22 },
        { "life": 15 }
      ]
    }
  },
  {
    "name": "attack: only one Blood token, the Vampire stays in hand",
    "players": [
      { "hand": ["Vampire Nighthawk"], "battlefield": ["Strefan, Maurer Progenitor", "Blood"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Strefan, Maurer Progenitor", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "hand": ["Vampire Nighthawk"], "battlefield": ["Strefan, Maurer Progenitor", "Blood", "Blood"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: a player who lost life and regained the same amount still counts as having lost life",
    "players": [
      { "hand": ["Lightning Helix"], "battlefield": ["Strefan, Maurer Progenitor", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Helix", "targets": ["p0"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Blood"], "life": 20 },
        { "life": 20 }
      ]
    }
  }
]
