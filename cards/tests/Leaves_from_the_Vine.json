[
  { "name": "chapter I: mill three and create a Food",
    "players": [ { "hand": ["Leaves from the Vine"], "battlefield": ["Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Leaves from the Vine" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 17, "battlefield_has": ["Leaves from the Vine", "Food"] }, {} ] } },
  { "name": "chapter II: up to two target creatures you control get a +1/+1 counter",
    "players": [ { "battlefield": [ { "name": "Leaves from the Vine", "counters": { "lore": 1 } }, "Grizzly Bears", "Hill Giant" ] }, { "battlefield": ["Air Elemental"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3], "Hill Giant": [4, 4], "Air Elemental": [4, 4] } } },
  { "name": "chapter III: draws a card if there is a creature card in your graveyard",
    "players": [ { "battlefield": [ { "name": "Leaves from the Vine", "counters": { "lore": 2 } } ], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] } },
  { "name": "chapter III: no creature or Lesson in graveyard, no draw",
    "players": [ { "battlefield": [ { "name": "Leaves from the Vine", "counters": { "lore": 2 } } ], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "ruling: a Food sacrificed for Maraleaf Rider cannot also pay for the Food's own ability",
    "players": [ { "battlefield": ["Forest", "Forest", "Food", "Maraleaf Rider", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Food", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Food"], "life": 20 }, {} ] } },
  { "name": "ruling: Food is not a creature type, so a Food artifact card in the graveyard does not enable the chapter III draw",
    "players": [ { "battlefield": [ { "name": "Leaves from the Vine", "counters": { "lore": 2 } } ], "graveyard": ["Lembas"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } }
]
