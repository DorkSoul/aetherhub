[
  { "name": "gaining 2 life this turn makes it prepared at the second main phase; Sign in Blood draws two and loses two",
    "players": [ { "hand": ["Lightning Helix"], "battlefield": ["Scheming Silvertongue // Sign in Blood", "Mountain", "Plains", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true },
               { "advance_to": "Main2" }, { "resolve": true },
               { "cast": "Sign in Blood", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "hand_count": 2 }, { "life": 17 } ] } },
  { "name": "without gaining 2 life the ability does not trigger, so Sign in Blood cannot be cast",
    "players": [ { "battlefield": ["Scheming Silvertongue // Sign in Blood", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "cast": "Sign in Blood", "targets": ["p0"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "ruling: life gained during the second main phase is too late to make it prepared",
    "players": [ { "hand": ["Lightning Helix"], "battlefield": ["Scheming Silvertongue // Sign in Blood", "Mountain", "Plains"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true },
               { "cast": "Sign in Blood", "targets": ["p0"], "illegal": true } ],
    "expect": { "players": [ { "life": 23 }, { "life": 17 } ] } },
  { "name": "ruling: becoming prepared while already prepared makes no second copy in exile",
    "players": [ { "hand": ["Lightning Helix", "Lightning Helix"], "battlefield": ["Scheming Silvertongue // Sign in Blood", "Mountain", "Plains", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true },
               { "advance_to": "Main2" }, { "resolve": true },
               { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" },
               { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true },
               { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Sign in Blood"], "life": 26 }, { "life": 14 } ] } },
  { "name": "ruling: a prepare creature in the graveyard is still a creature card (Raise Dead can return it)",
    "players": [ { "hand": ["Raise Dead"], "graveyard": ["Scheming Silvertongue // Sign in Blood"], "battlefield": ["Swamp"] }, {} ],
    "steps": [ { "cast": "Raise Dead", "targets": ["Scheming Silvertongue // Sign in Blood"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Scheming Silvertongue // Sign in Blood"] }, {} ] } }
]
