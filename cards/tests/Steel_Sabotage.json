[
  {
    "name": "mode 1: counters target artifact spell",
    "players": [
      { "hand": ["Steel Sabotage", "Steel Wall"], "battlefield": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Steel Wall" },
      { "cast": "Steel Sabotage", "targets": [{ "stack": "Steel Wall" }], "answers": [0] },
