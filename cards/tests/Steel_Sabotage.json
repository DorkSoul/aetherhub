    ],
    "expect": {
      "players": [ { "graveyard": ["Steel Sabotage", "Steel Wall"] }, {} ]
    }
  },
  {
    "name": "mode 2: returns target artifact to its owner's hand",
    "players": [
      { "hand": ["Steel Sabotage"], "battlefield": ["Island"] },
      { "battlefield": ["Steel Wall"] }
    ],
    "steps": [
      { "cast": "Steel Sabotage", "targets": ["Steel Wall"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Steel Sabotage"] }, { "hand": ["Steel Wall"] } ]
    }
  },
  {
    "name": "ruling: the counter mode cannot target an artifact on the battlefield",
    "players": [
      { "hand": ["Steel Sabotage"], "battlefield": ["Island"] },
      { "battlefield": ["Steel Wall"] }
    ],
    "steps": [
      { "cast": "Steel Sabotage", "targets": ["Steel Wall"], "answers": [0], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Steel Sabotage"] }, { "battlefield_has": ["Steel Wall"] } ]
    }
  },
  {
    "name": "ruling: the return mode cannot target an artifact spell on the stack",
    "players": [
      { "hand": ["Steel Sabotage", "Steel Wall"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Steel Wall" },
      { "cast": "Steel Sabotage", "targets": [{ "stack": "Steel Wall" }], "answers": [1], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Steel Sabotage"], "battlefield_lacks": ["Steel Wall"] }, {} ]
    }
  }
]
