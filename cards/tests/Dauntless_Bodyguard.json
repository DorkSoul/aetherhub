[
  {
    "name": "the only other creature is chosen; sacrificing gives it indestructible",
    "players": [
      { "hand": ["Dauntless Bodyguard"], "battlefield": ["Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Dauntless Bodyguard" },
      { "resolve": true },
      { "activate": "Dauntless Bodyguard", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Indestructible"] },
      "players": [ { "graveyard": ["Dauntless Bodyguard"] }, {} ]
    }
  },
  {
    "name": "with several creatures the chosen one gets indestructible, the others do not",
    "players": [
      { "hand": ["Dauntless Bodyguard"], "battlefield": ["Plains", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Dauntless Bodyguard" },
      { "resolve": true, "answers": [["Hill Giant"]] },
      { "activate": "Dauntless Bodyguard", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Hill Giant": ["Indestructible"], "Grizzly Bears": [] }
    }
  },
  {
    "name": "the chosen creature survives lethal damage after the Bodyguard was sacrificed",
    "players": [
      { "hand": ["Dauntless Bodyguard"], "battlefield": ["Plains", { "name": "Hill Giant", "sick": false }] },
      { "battlefield": ["Craw Wurm"] }
    ],
    "steps": [
      { "cast": "Dauntless Bodyguard" },
      { "resolve": true },
      { "activate": "Dauntless Bodyguard", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Craw Wurm", "attacker": "Hill Giant" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield": ["Hill Giant", "Plains"], "graveyard": ["Dauntless Bodyguard"] }, { "battlefield": ["Craw Wurm"] } ] }
  },
  {
    "name": "with no other creature the sacrifice still works and nothing gains indestructible",
    "players": [
      { "hand": ["Dauntless Bodyguard"], "battlefield": ["Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dauntless Bodyguard" },
      { "resolve": true },
      { "activate": "Dauntless Bodyguard", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "keywords": { "Grizzly Bears": [] }, "players": [ { "graveyard": ["Dauntless Bodyguard"] }, {} ] }
  },
  {
    "name": "ruling: the chosen creature left the battlefield, so sacrificing gives no creature indestructible",
    "players": [
      { "hand": ["Dauntless Bodyguard", "Lightning Bolt"], "battlefield": ["Plains", "Mountain", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Dauntless Bodyguard" },
      { "resolve": true, "answers": [["Grizzly Bears"]] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Dauntless Bodyguard", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Hill Giant": [] },
      "players": [ { "graveyard": ["Dauntless Bodyguard", "Lightning Bolt", "Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ]
    }
  }
]
