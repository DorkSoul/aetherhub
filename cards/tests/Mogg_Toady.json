[
  {
    "name": "can't attack when the defending player controls as many creatures",
    "players": [ { "battlefield": ["Mogg Toady"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Mogg Toady", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "can attack when controlling more creatures than the defending player",
    "players": [ { "battlefield": ["Mogg Toady", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Mogg Toady", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "can't block when its controller doesn't control more creatures than the attacker",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Mogg Toady"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Mogg Toady", "attacker": "Grizzly Bears" } ], "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "can block when its controller controls more creatures than the attacker",
    "players": [ { "battlefield": ["Hill Giant"] }, { "battlefield": ["Mogg Toady", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Mogg Toady", "attacker": "Hill Giant" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "with as many creatures as the defender its attack is dropped; a companion still hits (2 damage)",
    "players": [ { "battlefield": ["Mogg Toady", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Mogg Toady", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "with as many creatures as the attacker it can't block; the attacker it would block gets through (3 damage)",
    "players": [ { "battlefield": ["Hill Giant", "Grizzly Bears"] }, { "battlefield": ["Mogg Toady", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Mogg Toady", "attacker": "Hill Giant" }, { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  }
]
