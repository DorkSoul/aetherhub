[
  { "name": "attacking creature makes a tapped and attacking 4/4 Angel, exiled at end of combat",
    "players": [ { "hand": ["Invocation of Saint Traft"], "battlefield": ["Plains", "Island", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Invocation of Saint Traft", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Angel 4-4"] }, { "life": 14 } ] } },
  { "name": "no attack means no Angel",
    "players": [ { "hand": ["Invocation of Saint Traft"], "battlefield": ["Plains", "Island", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Invocation of Saint Traft", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Angel 4-4"], "battlefield_has": ["Grizzly Bears"] }, { "life": 20 } ] } },
  { "name": "ruling: the Angel is still exiled at end of combat even if the enchanted creature dies in combat",
    "players": [ { "hand": ["Invocation of Saint Traft"], "battlefield": ["Plains", "Island", "Swamp", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Invocation of Saint Traft", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Angel 4-4", "Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] }, { "life": 16 } ] } }
]
