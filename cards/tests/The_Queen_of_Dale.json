[
  {
    "name": "opponent's first noncreature spell: you recruit a nonland card and get a Human Soldier",
    "players": [
      { "battlefield": ["The Queen of Dale"], "library": ["Grizzly Bears"] },
      { "battlefield": ["Mountain"], "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"], "battlefield_has": ["The Queen of Dale", "Human Soldier"], "life": 17 },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "recruiting a land card makes no token",
    "players": [
      { "battlefield": ["The Queen of Dale"], "library": ["Island"] },
      { "battlefield": ["Mountain"], "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Island"], "battlefield": ["The Queen of Dale"], "life": 17 },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "only the opponent's first noncreature spell each turn triggers",
    "players": [
      { "battlefield": ["The Queen of Dale"], "library": ["Grizzly Bears", "Island"] },
      { "battlefield": ["Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt"] }
    ],
    "steps": [
      { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "resolve": true },
      { "resolve": true },
      { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 1, "life": 14 },
        { "graveyard": ["Lightning Bolt", "Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: an opponent's noncreature spell cast before The Queen entered does not count (no recruit later that turn)",
    "players": [
      { "hand": ["The Queen of Dale"], "battlefield": ["Plains", "Plains"], "library": ["Grizzly Bears", "Island"] },
      { "battlefield": ["Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt"] }
    ],
    "steps": [
      { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "resolve": true },
      { "cast": "The Queen of Dale" },
      { "resolve": true },
      { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 2, "life": 14, "battlefield_has": ["The Queen of Dale"] },
        { "graveyard": ["Lightning Bolt", "Lightning Bolt"] }
      ]
    }
  }
]
