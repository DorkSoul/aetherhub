[
 {
  "name": "a spell with cycling can be cast from the graveyard",
  "players": [ { "hand": ["Abandoned Sarcophagus"], "graveyard": ["Akroma's Blessing"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
  "steps": [ { "cast": "Abandoned Sarcophagus" }, { "resolve": true }, { "cast": "Akroma's Blessing" }, { "resolve": true, "answers": ["W"] } ],
  "expect": { "players": [ { "graveyard": [], "exile": ["Akroma's Blessing"] }, {} ] }
 },
 {
  "name": "a spell without cycling cannot be cast from the graveyard",
  "players": [ { "graveyard": ["Lightning Bolt"], "battlefield": ["Abandoned Sarcophagus", "Mountain"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, {} ] }
 },
 {
  "name": "a cycled card goes to the graveyard",
  "players": [ { "hand": ["Akroma's Blessing"], "battlefield": ["Abandoned Sarcophagus", "Plains"], "library": ["Forest"] }, {} ],
  "steps": [ { "activate": "Akroma's Blessing", "ability": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Akroma's Blessing"], "hand": ["Forest"] }, {} ] }
 },
 {
  "name": "a cycling card discarded without cycling is exiled instead",
  "players": [ { "hand": ["Careful Study"], "battlefield": ["Abandoned Sarcophagus", "Island"], "library": ["Akroma's Blessing", "Akroma's Blessing"] }, {} ],
  "steps": [ { "cast": "Careful Study" }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Careful Study"], "exile": ["Akroma's Blessing", "Akroma's Blessing"], "hand": [] }, {} ] }
 },
 {
  "name": "a card without cycling is discarded to the graveyard as usual",
  "players": [ { "hand": ["Careful Study"], "battlefield": ["Abandoned Sarcophagus", "Island"], "library": ["Forest", "Mountain"] }, {} ],
  "steps": [ { "cast": "Careful Study" }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Careful Study", "Forest", "Mountain"], "exile": [] }, {} ] }
 },
 {
  "name": "ruling: a cycled instant can be cast from the graveyard in response to its own cycling ability",
  "players": [ { "hand": ["Akroma's Blessing"], "battlefield": ["Abandoned Sarcophagus", "Plains", "Plains", "Plains", "Plains"], "library": ["Forest"] }, {} ],
  "steps": [ { "activate": "Akroma's Blessing", "ability": 0 }, { "cast": "Akroma's Blessing" }, { "resolve": true, "answers": ["W"] } ],
  "expect": { "players": [ { "graveyard": [], "exile": ["Akroma's Blessing"], "hand": ["Forest"] }, {} ] }
 },
 {
  "name": "ruling: a cycling card in the graveyard cannot be cycled from there",
  "players": [ { "hand": ["Abandoned Sarcophagus"], "graveyard": ["Akroma's Blessing"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
  "steps": [ { "cast": "Abandoned Sarcophagus" }, { "resolve": true }, { "activate": "Akroma's Blessing", "ability": 0, "illegal": true } ],
  "expect": { "players": [ { "graveyard": ["Akroma's Blessing"], "exile": [] }, {} ] }
 }
]
