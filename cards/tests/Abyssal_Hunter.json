[
  {
    "name": "taps target creature and deals damage equal to its power to it",
    "players": [ { "battlefield": ["Swamp", "Abyssal Hunter"] }, { "battlefield": ["Elite Vanguard"] } ],
    "steps": [
      { "activate": "Abyssal Hunter", "targets": ["Elite Vanguard"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Elite Vanguard"] } ]
    }
  },
  {
    "name": "damage is dealt by the Hunter's power; a surviving creature is tapped",
    "players": [ { "battlefield": ["Swamp", "Abyssal Hunter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Abyssal Hunter", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "cannot activate without {B}",
    "players": [ { "battlefield": ["Plains", "Abyssal Hunter"] }, { "battlefield": ["Elite Vanguard"] } ],
    "steps": [
      { "activate": "Abyssal Hunter", "targets": ["Elite Vanguard"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield": ["Elite Vanguard"] } ]
    }
  },
  {
    "name": "ruling: can target a creature that is already tapped",
    "players": [ { "battlefield": ["Swamp", "Abyssal Hunter", { "name": "Firefist Striker", "sick": false }] }, {} ],
    "steps": [
      { "attack": [ { "card": "Firefist Striker", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Abyssal Hunter", "targets": ["Firefist Striker"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Firefist Striker"] }, {} ]
    }
  }
]
