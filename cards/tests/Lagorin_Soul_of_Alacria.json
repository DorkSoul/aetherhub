[
  {
    "name": "saddled attack puts a counter on each of two Vehicles",
    "players": [
      {
        "battlefield": [
          "Lagorin, Soul of Alacria",
          "Hill Giant",
          "Bespoke Battlewagon",
          "Marshals' Pathcruiser"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lagorin, Soul of Alacria",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "attack": [{ "card": "Lagorin, Soul of Alacria", "at": "p1" }]
      },
      {
        "resolve": true,
        "targets": ["Bespoke Battlewagon", "Marshals' Pathcruiser"]
      }
    ],
    "expect": {
      "tapped": {
        "Hill Giant": true
      },
      "counters": {
        "Bespoke Battlewagon": { "PlusOnePlusOne": 1 },
        "Marshals' Pathcruiser": { "PlusOnePlusOne": 1 }
      }
    }
  },
  {
    "name": "up to two: a single target is enough",
    "players": [
      {
        "battlefield": [
          { "name": "Lagorin, Soul of Alacria", "sick": false },
          "Hill Giant",
          "Bespoke Battlewagon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lagorin, Soul of Alacria",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "attack": [{ "card": "Lagorin, Soul of Alacria", "at": "p1" }]
      },
      {
        "resolve": true,
        "targets": ["Bespoke Battlewagon"]
      }
    ],
    "expect": {
      "counters": {
        "Bespoke Battlewagon": { "PlusOnePlusOne": 1 }
      }
    }
  },
  {
    "name": "attacking without being saddled gives no counters",
    "players": [
      {
        "battlefield": [
          "Lagorin, Soul of Alacria",
          "Hill Giant",
          "Bespoke Battlewagon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [{ "card": "Lagorin, Soul of Alacria", "at": "p1" }]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Bespoke Battlewagon": { "PlusOnePlusOne": 0 }
      },
      "tapped": {
        "Hill Giant": false
      }
    }
  },
  {
    "name": "ruling: an unsaddled Mount can still attack and deal combat damage",
    "players": [
      { "battlefield": ["Lagorin, Soul of Alacria"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Lagorin, Soul of Alacria", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 19 }]
    }
  },
  {
    "name": "ruling: a Mount can be saddled again while it is already saddled",
    "players": [
      { "battlefield": ["Lagorin, Soul of Alacria", "Hill Giant", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Lagorin, Soul of Alacria", "ability": 0 },
      { "resolve": true },
      { "activate": "Lagorin, Soul of Alacria", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Hill Giant": true, "Grizzly Bears": true }
    }
  }
]
