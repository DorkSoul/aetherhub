[
  { "name": "gets +1/+1 for each creature blocking it beyond the first (two blockers)",
    "players": [ { "battlefield": ["Horrible Hordes"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Horrible Hordes", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Horrible Hordes" }, { "blocker": "Hill Giant", "attacker": "Horrible Hordes" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Horrible Hordes": [3, 3] } } },
  { "name": "three blockers give +2/+2",
    "players": [ { "battlefield": ["Horrible Hordes"] }, { "battlefield": ["Grizzly Bears", "Hill Giant", "Giant Spider"] } ],
    "steps": [
      { "attack": [ { "card": "Horrible Hordes", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Horrible Hordes" }, { "blocker": "Hill Giant", "attacker": "Horrible Hordes" }, { "blocker": "Giant Spider", "attacker": "Horrible Hordes" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Horrible Hordes": [4, 4] } } },
  { "name": "a single blocker gives no bonus",
    "players": [ { "battlefield": ["Horrible Hordes"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Horrible Hordes", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Horrible Hordes" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Horrible Hordes": [2, 2] } } }
]
