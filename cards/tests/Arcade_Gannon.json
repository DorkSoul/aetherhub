[
  {
    "name": "tap: draw then discard, and a quest counter is put on it",
    "players": [
      {
        "battlefield": [
          {
            "name": "Arcade Gannon",
            "sick": false
          }
        ],
        "library": [
          "Island",
          "Forest"
        ],
        "hand": []
      },
      {}
    ],
    "steps": [
      {
        "activate": "Arcade Gannon",
        "ability": 0
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "library_count": 1
        },
        {}
      ],
      "counters": {
        "Arcade Gannon": {
          "quest": 1
        }
      }
    }
  },
  {
    "name": "casts an artifact from the graveyard with MV <= quest counters",
    "players": [
      {
        "battlefield": [
          {
            "name": "Arcade Gannon",
            "sick": false,
            "counters": {
              "quest": 1
            }
          },
          "Plains",
          "Island",
          "Plains",
          "Island"
        ],
        "graveyard": [
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sol Ring"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Sol Ring"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "no quest counters: MV 1 artifact cannot be cast from the graveyard",
    "players": [
      {
        "battlefield": [
          {
            "name": "Arcade Gannon",
            "sick": false
          },
          "Plains",
          "Island"
        ],
        "graveyard": [
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sol Ring",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Sol Ring"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a graveyard artifact is still cast at sorcery speed (illegal during combat)",
    "players": [
      {
        "battlefield": [
          { "name": "Arcade Gannon", "sick": false, "counters": { "quest": 1 } },
          "Plains",
          "Island",
          "Plains",
          "Island"
        ],
        "graveyard": ["Sol Ring"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Sol Ring", "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Sol Ring"] }, {} ] }
  },
  {
    "name": "ruling: casting from the graveyard still requires paying the mana cost",
    "players": [
      {
        "battlefield": [ { "name": "Arcade Gannon", "sick": false, "counters": { "quest": 1 } } ],
        "graveyard": ["Sol Ring"]
      },
      {}
    ],
    "steps": [ { "cast": "Sol Ring", "illegal": true } ],
    "expect": { "players": [ { "graveyard_has": ["Sol Ring"] }, {} ] }
  }
]
