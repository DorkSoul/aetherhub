[
  {
    "name": "sacrifices itself when you control no enchantments",
    "players": [
      {
        "hand": [
          "Tethered Griffin"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Tethered Griffin"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Tethered Griffin"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "stays while you control an enchantment",
    "players": [
      {
        "hand": [
          "Tethered Griffin"
        ],
        "battlefield": [
          "Plains",
          "Terra Eternal"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Tethered Griffin"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Tethered Griffin",
            "Terra Eternal"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: gaining control of an enchantment after the trigger does not save it",
    "players": [
      { "hand": ["Tethered Griffin", "Aura Graft"], "battlefield": ["Plains", "Island", "Island"] },
      { "hand": ["Frogify"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Frogify", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Tethered Griffin" },
      { "resolve": true },
      { "cast": "Aura Graft", "targets": ["Frogify"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Tethered Griffin"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: destroying your last enchantment after the Griffin is on the battlefield sacrifices it",
    "players": [
      {
        "hand": ["Disenchant"],
        "battlefield": ["Tethered Griffin", "Terra Eternal", "Plains", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Disenchant", "targets": ["Terra Eternal"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Tethered Griffin"] },
        {}
      ]
    }
  }
]
