[
  {
    "name": "each player keeps the creatures they own: nothing changes",
    "players": [
      { "battlefield": ["Homeward Path", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Homeward Path", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Homeward Path", "Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "a creature stolen by you returns to its owner",
    "players": [
      { "hand": ["Control Magic"], "battlefield": ["Homeward Path", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Control Magic", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Homeward Path", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Homeward Path"] }, { "battlefield_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: a creature stolen by the opponent returns to its owner when the opponent's Homeward Path is used",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "hand": ["Control Magic"], "battlefield": ["Homeward Path", "Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Homeward Path", "player": 1, "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Hill Giant"] }, { "battlefield_lacks": ["Hill Giant"], "battlefield_has": ["Homeward Path"] }]
    }
  },
  {
    "name": "ruling: a token is owned by the player who put it onto the battlefield; a stolen Goblin returns to that player",
    "players": [
      { "hand": ["Krenko's Command"], "battlefield": ["Mountain", "Mountain"] },
      { "hand": ["Control Magic"], "battlefield": ["Homeward Path", "Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Krenko's Command" },
      { "resolve": true },
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Goblin"] },
      { "resolve": true },
      { "activate": "Homeward Path", "player": 1, "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Goblin"] }, { "battlefield_lacks": ["Goblin"], "battlefield_has": ["Homeward Path"] }]
    }
  }
]
