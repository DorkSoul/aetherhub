[
  {
    "name": "plays a land from the graveyard",
    "players": [
      {
        "battlefield": [
          "Icetill Explorer"
        ],
        "graveyard": [
          "Forest",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Forest"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest"
          ],
          "graveyard_has": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "nonland cards in the graveyard can't be cast",
    "players": [
      {
        "battlefield": [
          "Icetill Explorer",
          "Forest",
          "Forest"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "landfall mills a card",
    "players": [
      {
        "battlefield": [
          "Icetill Explorer"
        ],
        "hand": [
          "Forest"
        ],
        "library": [
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Forest"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest"
          ],
          "graveyard_has": [
            "Swamp"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "allows a second land drop in one turn",
    "players": [
      {
        "battlefield": [
          "Icetill Explorer"
        ],
        "hand": [
          "Forest",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Forest"
      },
      {
        "resolve": true
      },
      {
        "play_land": "Island"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest",
            "Island"
          ],
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Exploration and Icetill Explorer give three land drops in one turn",
    "players": [
      {
        "battlefield": ["Icetill Explorer", "Exploration"],
        "hand": ["Forest", "Forest", "Island"]
      },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true },
      { "play_land": "Forest" },
      { "resolve": true },
      { "play_land": "Island" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Forest", "Island", "Exploration"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: Icetill Explorer does not let you cycle a land card from the graveyard",
    "players": [
      { "battlefield": ["Icetill Explorer", "Mountain"], "graveyard": ["Forgotten Cave"] },
      {}
    ],
    "steps": [
      { "activate": "Forgotten Cave", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Forgotten Cave"] },
        {}
      ]
    }
  }
]