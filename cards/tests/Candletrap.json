[
  {
    "name": "enchanted creature has defender",
    "players": [
      { "hand": ["Candletrap"], "battlefield": ["Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Candletrap", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Defender"] }
    }
  },
  {
    "name": "combat damage dealt by the enchanted creature is prevented",
    "players": [
      { "hand": ["Candletrap"], "battlefield": ["Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Candletrap", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "coven: sacrifice to exile the enchanted creature with three different powers",
    "players": [
      { "hand": ["Candletrap"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears", "Llanowar Elves", "Hill Giant"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Candletrap", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "activate": "Candletrap", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Candletrap"] },
        { "exile": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "coven: cannot exile with only two different powers",
    "players": [
      { "hand": ["Candletrap"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears", "Llanowar Elves"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Candletrap", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "activate": "Candletrap", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Candletrap"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling: powers 2, 2 and 1 are not three different powers, so coven is not available",
    "players": [
      { "hand": ["Candletrap"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears", "Grizzly Bears", "Llanowar Elves"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Candletrap", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "activate": "Candletrap", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Candletrap"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  }
]
