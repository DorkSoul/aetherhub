[
  { "name": "ruling: the Human trigger still resolves when the multicolored spell is countered",
    "players": [ { "hand": ["Lightning Helix"], "battlefield": ["Hero of Precinct One", "Mountain", "Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Helix", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Helix" }] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hero of Precinct One", "Human"], "graveyard_has": ["Lightning Helix"] }, { "graveyard_has": ["Counterspell"] } ] } },
  { "name": "casting a multicolored spell makes a Human token",
    "players": [ { "hand": ["Heroes' Reunion"], "battlefield": ["Hero of Precinct One", "Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Heroes' Reunion", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 27, "battlefield_has": ["Hero of Precinct One", "Human"] }, {} ] } },
  { "name": "a monocolored spell makes no token",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Hero of Precinct One", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Human"] }, {} ] } }
]
