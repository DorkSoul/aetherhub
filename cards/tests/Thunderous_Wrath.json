[
  {
    "name": "deals 5 damage to any target when cast normally",
    "players": [
      { "hand": ["Thunderous Wrath"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Thunderous Wrath", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Thunderous Wrath"] },
        { "life": 15 }
      ]
    }
  },
  {
    "name": "miracle: first card drawn this turn is cast for {R} at any target",
    "players": [
      { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Thunderous Wrath", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Tormenting Voice" },
      { "resolve": true, "answers": [true], "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Thunderous Wrath", "Tormenting Voice", "Grizzly Bears"], "hand": ["Forest"] },
        { "life": 15 }
      ]
    }
  },
  {
    "name": "miracle is declined: the card stays in hand and nothing is damaged",
    "players": [
      { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Thunderous Wrath", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Tormenting Voice" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "hand": ["Thunderous Wrath", "Forest"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "no miracle when the card is not the first card drawn this turn",
    "players": [
      { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Forest", "Thunderous Wrath"] },
      {}
    ],
    "steps": [
      { "cast": "Tormenting Voice" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest", "Thunderous Wrath"] },
        { "life": 20 }
      ]
    }
  }
]
