[
 { "name": "spells cast from hand cost nothing, even expensive ones",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Omniscience"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears", "alt": 100 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "only the controller gets the free cast; the opponent must pay",
   "players": [ { "battlefield": ["Omniscience"] }, { "hand": ["Grizzly Bears"] } ],
   "steps": [ { "pass": true }, { "cast": "Grizzly Bears", "player": 1, "alt": 100, "illegal": true } ] },
 { "name": "the free-cast spell leaves the hand",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Omniscience"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears", "alt": 100 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0 }, {} ] } },
 { "name": "ruling: X is 0 when cast without paying its mana cost",
   "players": [ { "hand": ["Fireball"], "battlefield": ["Omniscience"] }, {} ],
   "steps": [ { "cast": "Fireball", "targets": ["p1"], "alt": 100 }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "ruling: sorcery-speed timing still applies on the opponent's turn",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Omniscience"] }, {} ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Grizzly Bears", "alt": 100, "illegal": true } ],
   "expect": { "turn": 2, "step": "Main1", "players": [ { "hand": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: an alternative cost cannot be chosen when casting without paying the mana cost",
   "players": [ { "hand": ["Snuff Out"], "battlefield": ["Omniscience", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Snuff Out", "alt": 100, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard_has": ["Snuff Out"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "ruling: a mandatory additional cost (discard) must still be paid",
   "players": [ { "hand": ["Tormenting Voice", "Lightning Bolt"], "battlefield": ["Omniscience"] }, {} ],
   "steps": [ { "cast": "Tormenting Voice", "alt": 100 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Lightning Bolt"] }, {} ] } },
 { "name": "ruling: free casting works right after Omniscience resolves, with no pass in between",
   "players": [ { "hand": ["Omniscience", "Grizzly Bears"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Omniscience" }, { "resolve": true }, { "cast": "Grizzly Bears", "alt": 100 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Omniscience", "Grizzly Bears"], "hand_count": 0 }, {} ] } }
]
