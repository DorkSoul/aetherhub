 { "name": "ruling: a prepared creature's Lightning Bolt copy stays in exile until cast",
   "players": [ { "hand": ["Giant Growth", "Giant Growth", "Giant Growth"], "battlefield": ["Emeritus of Conflict // Lightning Bolt", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Giant Growth", "targets": ["p0:Emeritus of Conflict // Lightning Bolt"] }, { "resolve": true },
              { "cast": "Giant Growth", "targets": ["p0:Emeritus of Conflict // Lightning Bolt"] }, { "resolve": true },
              { "cast": "Giant Growth", "targets": ["p0:Emeritus of Conflict // Lightning Bolt"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Lightning Bolt"], "battlefield_has": ["Emeritus of Conflict // Lightning Bolt"] }, {} ] } },
 { "name": "ruling: casting the Lightning Bolt copy unprepares the creature and empties exile",
   "players": [ { "hand": ["Giant Growth", "Giant Growth", "Giant Growth"], "battlefield": ["Emeritus of Conflict // Lightning Bolt", "Mountain", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Giant Growth", "targets": ["p0:Emeritus of Conflict // Lightning Bolt"] }, { "resolve": true },
              { "cast": "Giant Growth", "targets": ["p0:Emeritus of Conflict // Lightning Bolt"] }, { "resolve": true },
              { "cast": "Giant Growth", "targets": ["p0:Emeritus of Conflict // Lightning Bolt"] }, { "resolve": true }, { "resolve": true },
