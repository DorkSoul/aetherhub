 { "name": "ruling: a creature cast as your third spell does not count for its own trigger",
   "players": [ { "hand": ["Giant Growth", "Giant Growth", "Emeritus of Conflict // Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
