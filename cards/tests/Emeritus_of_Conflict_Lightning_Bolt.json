   "expect": { "players": [ { "exile": [], "battlefield_has": ["Emeritus of Conflict // Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "ruling: the prepare trigger resolves even if the third spell is countered",
   "players": [ { "hand": ["Giant Growth", "Giant Growth", "Giant Growth"], "battlefield": ["Emeritus of Conflict // Lightning Bolt", "Forest", "Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Giant Growth", "targets": ["p0:Emeritus of Conflict // Lightning Bolt"] }, { "resolve": true },
