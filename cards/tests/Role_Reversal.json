[
  {
    "name": "creature mode: control of two creatures is exchanged",
    "players": [
      { "hand": ["Role Reversal"], "battlefield": ["Island", "Island", "Mountain", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Role Reversal", "answers": [1], "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "artifact mode: control of two artifacts is exchanged",
    "players": [
      { "hand": ["Role Reversal"], "battlefield": ["Island", "Island", "Mountain", "Sol Ring"] },
      { "battlefield": ["Ornithopter"] }
    ],
    "steps": [
      { "cast": "Role Reversal", "answers": [0], "targets": ["Sol Ring", "Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Ornithopter"] }, { "battlefield_has": ["Sol Ring"] }]
    }
  },
  {
    "name": "ruling: the exchange lasts after the turn ends",
    "players": [
      { "hand": ["Role Reversal"], "battlefield": ["Island", "Island", "Mountain", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Role Reversal", "answers": [1], "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: if one target is gone on resolution, no control is exchanged",
    "players": [
      { "hand": ["Role Reversal"], "battlefield": ["Island", "Island", "Mountain", "Hill Giant"] },
      { "hand": ["Unsummon"], "battlefield": ["Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Role Reversal", "answers": [1], "targets": ["Hill Giant", "Grizzly Bears"] },
      { "pass": true },
      { "cast": "Unsummon", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Hill Giant"] }, { "hand": ["Grizzly Bears"], "graveyard": ["Unsummon"] }]
    }
  },
  {
    "name": "ruling: two permanents with the same controller: nothing happens (caster controls neither)",
    "players": [
      { "hand": ["Role Reversal"], "battlefield": ["Island", "Island", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Role Reversal", "answers": [1], "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Grizzly Bears", "Hill Giant"] }]
    }
  }
]
