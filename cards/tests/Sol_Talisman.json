    "expect": { "players": [ { "battlefield_has": ["Sol Talisman"], "exile": [] }, {} ] }
  },
  {
    "name": "ruling: countering the cast trigger leaves the card exiled with no counters, not cast",
    "players": [ { "hand": ["Sol Talisman"], "battlefield": ["Mountain"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [
      { "activate": "Sol Talisman" }, { "resolve": true },
      { "advance_to": "End" }, { "advance_to": "End" }, { "advance_to": "End" }, { "advance_to": "End" }, { "advance_to": "End" }, { "advance_to": "End" },
      { "player": 1, "pass": true }, { "pass": true },
      { "player": 1, "pass": true }, { "pass": true },
      { "player": 1, "cast": "Stifle", "targets": [ { "stack": "Sol Talisman" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Sol Talisman"], "battlefield_has": ["Mountain"] }, {} ] }
