      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Sol Talisman"], "battlefield_has": ["Mountain"] }, {} ] }
  },
  {
    "name": "ruling: countering the first suspend trigger removes no time counter",
    "players": [ { "hand": ["Sol Talisman"], "battlefield": ["Mountain"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [
      { "activate": "Sol Talisman" }, { "resolve": true },
      { "advance_to": "End" }, { "advance_to": "End" },
      { "player": 1, "pass": true }, { "pass": true },
      { "player": 1, "cast": "Stifle", "targets": [ { "stack": "Sol Talisman" } ] }, { "resolve": true },
      { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" },
