  {
    "name": "ruling: suspending exiles the card at once, without using the stack",
    "players": [ { "hand": ["Sol Talisman"], "battlefield": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Sol Talisman" } ],
    "expect": { "players": [ { "exile": ["Sol Talisman"], "battlefield_has": ["Mountain"] }, {} ] }
