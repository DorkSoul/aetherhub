  {
    "name": "ruling: suspend is only available when the card could be cast (artifact: not on an opponent's turn)",
    "players": [ {}, { "hand": ["Sol Talisman"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "player": 1, "activate": "Sol Talisman", "illegal": true } ],
    "expect": { "players": [ {}, { "hand": ["Sol Talisman"] } ] }
  },
  {
    "name": "ruling: suspending on its owner's own turn is allowed",
    "players": [ {}, { "hand": ["Sol Talisman"], "battlefield": ["Mountain"] } ],
    "steps": [ { "advance_to": "Main1" }, { "player": 1, "activate": "Sol Talisman" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "exile": ["Sol Talisman"] } ] }
  },
  {
    "name": "ruling: declining the free cast leaves Sol Talisman exiled, no longer suspended",
    "players": [ { "hand": ["Sol Talisman"], "battlefield": ["Mountain"] }, {} ],
    "steps": [
