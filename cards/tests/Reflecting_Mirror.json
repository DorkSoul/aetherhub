[
  { "name": "pays twice the spell's mana value and redirects a Bolt aimed at you to a player",
    "players": [ { "battlefield": ["Reflecting Mirror", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "activate": "Reflecting Mirror", "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true, "answers": [[1]] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Reflecting Mirror"] }, { "life": 17 } ] } },
  { "name": "a mana value 2 spell costs four: three lands are not enough",
    "players": [ { "battlefield": ["Reflecting Mirror", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Incinerate"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Incinerate", "player": 1, "targets": ["p0"] }, { "activate": "Reflecting Mirror", "targets": [{ "stack": "Incinerate" }], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Reflecting Mirror"] }, {} ] } },
  { "name": "a mana value 2 spell is redirected with four lands",
    "players": [ { "battlefield": ["Reflecting Mirror", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Incinerate"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Incinerate", "player": 1, "targets": ["p0"] }, { "activate": "Reflecting Mirror", "targets": [{ "stack": "Incinerate" }] }, { "resolve": true, "answers": [[1]] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 17 } ] } },
  { "name": "cannot target a spell that targets a creature",
    "players": [ { "battlefield": ["Reflecting Mirror", "Mountain", "Mountain", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "activate": "Reflecting Mirror", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "ruling: a spell that affects you without targeting you cannot be redirected",
    "players": [ { "battlefield": ["Reflecting Mirror", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Divination", "player": 1 }, { "activate": "Reflecting Mirror", "targets": [{ "stack": "Divination" }], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Reflecting Mirror"] }, { "graveyard": ["Divination"] } ] } }
]
