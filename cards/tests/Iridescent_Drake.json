[
  {
    "name": "puts an Aura from your graveyard onto the battlefield attached to the Drake",
    "players": [ { "hand": ["Iridescent Drake"], "graveyard": ["Flight"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Iridescent Drake" }, { "resolve": true } ],
    "expect": { "attached": { "Flight": "Iridescent Drake" }, "players": [ { "battlefield_has": ["Iridescent Drake", "Flight"], "graveyard": [] }, {} ] }
  },
  {
    "name": "takes an Aura from an opponent's graveyard and you control it",
    "players": [ { "hand": ["Iridescent Drake"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "graveyard": ["Holy Strength"] } ],
    "steps": [ { "cast": "Iridescent Drake" }, { "resolve": true } ],
    "expect": { "attached": { "Holy Strength": "Iridescent Drake" }, "pt": { "Iridescent Drake": [3, 4] }, "players": [ { "battlefield_has": ["Iridescent Drake", "Holy Strength"] }, { "graveyard": [] } ] }
  },
  {
    "name": "no Aura in any graveyard: nothing happens",
    "players": [ { "hand": ["Iridescent Drake"], "graveyard": ["Grizzly Bears"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Iridescent Drake" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Iridescent Drake"], "graveyard": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "an Aura that cannot enchant the Drake (enchant land) stays in the graveyard",
    "players": [ { "hand": ["Iridescent Drake"], "graveyard": ["Wild Growth"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Iridescent Drake" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Iridescent Drake"], "graveyard": ["Wild Growth"] }, {} ] }
  },
  {
    "name": "ruling: an Aura that cannot attach to the Drake stays in its owner's (opponent's) graveyard",
    "players": [ { "hand": ["Iridescent Drake"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "graveyard": ["Wild Growth"] } ],
    "steps": [ { "cast": "Iridescent Drake" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Iridescent Drake"], "graveyard": [] }, { "graveyard": ["Wild Growth"] } ] }
  }
]
