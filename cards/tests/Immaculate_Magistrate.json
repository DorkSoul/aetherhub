[
  {
    "name": "counters equal to Elves you control",
    "players": [
      {
        "battlefield": [
          {
            "name": "Immaculate Magistrate"
          },
          "Llanowar Elves",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Elvish Visionary"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Immaculate Magistrate",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {
          "p1p1": 2
        }
      },
      "tapped": {
        "Immaculate Magistrate": true
      }
    }
  },
  {
    "name": "opponent's Elves are not counted; can target opposing creature",
    "players": [
      {
        "battlefield": [
          {
            "name": "Immaculate Magistrate"
          }
        ]
      },
      {
        "battlefield": [
          "Elvish Visionary",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Immaculate Magistrate",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {
          "p1p1": 1
        }
      }
    }
  },
  {
    "name": "summoning sick cannot tap",
    "players": [
      {
        "battlefield": [
          {
            "name": "Immaculate Magistrate",
            "sick": true
          },
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Immaculate Magistrate",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: the target creature does not have to be an Elf",
    "players": [
      {
        "battlefield": [ { "name": "Immaculate Magistrate" }, "Grizzly Bears" ]
      },
      {}
    ],
    "steps": [
      { "activate": "Immaculate Magistrate", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 } } }
  },
  {
    "name": "ruling: the Elf count is made when the ability resolves (an Elf killed in response is not counted)",
    "players": [
      {
        "battlefield": [ { "name": "Immaculate Magistrate" }, "Llanowar Elves", "Grizzly Bears" ]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "activate": "Immaculate Magistrate", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Llanowar Elves"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ],
      "counters": { "Grizzly Bears": { "p1p1": 1 } }
    }
  }
]