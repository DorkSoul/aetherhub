[
  {
    "name": "becoming tapped (attacking) deals 1 damage to any target",
    "players": [
      { "battlefield": ["Goblin Medics"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [{ "card": "Goblin Medics", "at": "p1" }] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Grizzly Bears"], "life": 19 }]
    }
  },
  {
    "name": "no trigger without becoming tapped",
    "players": [
      { "battlefield": ["Goblin Medics"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20, "battlefield_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: the ability triggers when Goblin Medics taps to attack",
    "players": [
      { "battlefield": ["Goblin Medics"] },
      { }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [{ "card": "Goblin Medics", "at": "p1" }] },
      { "resolve": true, "targets": ["p1"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  }
]
