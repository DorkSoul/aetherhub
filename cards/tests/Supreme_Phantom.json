[
  {
    "name": "other Spirits get +1/+1, the Phantom itself does not",
    "players": [{"battlefield": ["Supreme Phantom", "Blinking Spirit", "Grizzly Bears"]}, {}],
    "steps": [],
    "expect": {"pt": {"Supreme Phantom": [1, 3], "Blinking Spirit": [3, 3], "Grizzly Bears": [2, 2]}}
  },
  {
    "name": "an opponent's Spirit does not get the bonus",
    "players": [{"battlefield": ["Supreme Phantom"]}, {"battlefield": ["Blinking Spirit"]}],
    "steps": [],
    "expect": {"pt": {"Blinking Spirit": [2, 2]}}
  },
  {
    "name": "the bonus ends when the Phantom leaves the battlefield",
    "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}, {"battlefield": ["Supreme Phantom", "Blinking Spirit"]}],
    "steps": [
      {"cast": "Lightning Bolt", "targets": ["Supreme Phantom"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [{}, {"graveyard": ["Supreme Phantom"], "battlefield_has": ["Blinking Spirit"]}],
      "pt": {"Blinking Spirit": [2, 2]}
    }
  },
  {
    "name": "ruling: nonlethal damage on a Spirit becomes lethal when the Phantom leaves",
    "players": [
      {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Supreme Phantom", "Blinking Spirit"]},
      {"battlefield": ["Grizzly Bears"]}
    ],
    "steps": [
      {"attack": [{"card": "Blinking Spirit", "at": "p1"}]},
      {"block": [{"blocker": "Grizzly Bears", "attacker": "Blinking Spirit"}]},
      {"advance_to": "Main2"},
      {"cast": "Lightning Bolt", "targets": ["Supreme Phantom"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"graveyard_has": ["Supreme Phantom", "Blinking Spirit"], "battlefield_lacks": ["Supreme Phantom", "Blinking Spirit"]},
        {"graveyard_has": ["Grizzly Bears"]}
      ]
    }
  }
]
