[
  { "name": "exile it to mill four and return a creature card from your graveyard",
    "players": [ { "battlefield": ["Tomb Fortress", "Swamp", "Swamp", "Swamp", "Plains", "Plains"], "graveyard": ["Grizzly Bears"], "library": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Tomb Fortress", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": ["Tomb Fortress"], "graveyard_has": ["Forest"] }, {} ] } },
  { "name": "enters the battlefield tapped",
    "players": [ { "hand": ["Tomb Fortress"] }, {} ],
    "steps": [ { "play_land": "Tomb Fortress" } ],
    "expect": { "players": [ { "battlefield_has": ["Tomb Fortress"] }, {} ], "tapped": { "Tomb Fortress": true } } },
  { "name": "taps for black mana",
    "players": [ { "battlefield": ["Tomb Fortress"] }, {} ],
    "steps": [ { "tap_for_mana": "Tomb Fortress" } ],
    "expect": { "players": [ { "pool": { "B": 1 } }, {} ] } },
  { "name": "ruling: the returned creature can be one of the cards just milled",
    "players": [ { "battlefield": ["Tomb Fortress", "Swamp", "Swamp", "Swamp", "Plains", "Plains"], "graveyard": ["Grizzly Bears"], "library": ["Hill Giant", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Tomb Fortress", "ability": 0 }, { "resolve": true, "answers": ["Hill Giant"] } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "exile": ["Tomb Fortress"], "graveyard_has": ["Grizzly Bears", "Forest"] }, {} ] } }
