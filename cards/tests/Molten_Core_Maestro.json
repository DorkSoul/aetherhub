[
  { "name": "one-mana instant: +1/+1 counter and no red mana",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Molten-Core Maestro"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Molten-Core Maestro": [3, 3] }, "players": [ { "pool": {} }, { "life": 17 } ] } },
  { "name": "five mana spent on an instant: +1/+1 counter and R equal to its power",
    "players": [ { "hand": ["Bury in Books"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Molten-Core Maestro"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Bury in Books", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Molten-Core Maestro": [3, 3] }, "players": [ { "pool": { "R": 3 } }, {} ] } },
  { "name": "creature spell does not trigger opus",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Plains", "Molten-Core Maestro"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Molten-Core Maestro": [2, 2] }, "players": [ { "pool": {} }, {} ] } },
  { "name": "ruling: opus still resolves when the instant it triggered on is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Molten-Core Maestro"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Molten-Core Maestro": [3, 3] }, "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Counterspell"] } ] } }
