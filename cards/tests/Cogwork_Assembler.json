[
 {
  "name": "makes a hasty token copy of a target artifact",
  "players": [
   { "battlefield": ["Cogwork Assembler", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "activate": "Cogwork Assembler", "targets": ["p1:Sol Ring"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Cogwork Assembler", "Sol Ring"] }, { "battlefield_has": ["Sol Ring"] }]
  }
 },
 {
  "name": "the token is exiled at the beginning of the next end step",
  "players": [
   { "battlefield": ["Cogwork Assembler", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "activate": "Cogwork Assembler", "targets": ["p1:Sol Ring"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Cogwork Assembler"], "battlefield_lacks": ["Sol Ring"] }, { "battlefield_has": ["Sol Ring"] }]
  }
 },
 {
  "name": "needs seven mana",
  "players": [
   { "battlefield": ["Cogwork Assembler", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "activate": "Cogwork Assembler", "targets": ["p1:Sol Ring"], "illegal": true }
  ],
  "expect": {}
 },
 {
  "name": "ruling: X is 0 in a copied Walking Ballista, so the token is a 0/0 with no counters and dies",
  "players": [
   { "battlefield": ["Cogwork Assembler", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": [{ "name": "Walking Ballista", "counters": { "p1p1": 2 } }] }
  ],
  "steps": [
   { "activate": "Cogwork Assembler", "targets": ["p1:Walking Ballista"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Cogwork Assembler"], "battlefield_lacks": ["Walking Ballista"] }, { "battlefield_has": ["Walking Ballista"] }]
  }
 },
 {
  "name": "ruling: the token copy's enters-the-battlefield trigger fires (Solemn Simulacrum fetches a basic land)",
  "players": [
   { "battlefield": ["Cogwork Assembler", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest"] },
   { "battlefield": ["Solemn Simulacrum"] }
  ],
  "steps": [
   { "activate": "Cogwork Assembler", "targets": ["p1:Solemn Simulacrum"] },
   { "resolve": true, "answers": [true, "Forest"] }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Cogwork Assembler", "Forest"] }, { "battlefield_has": ["Solemn Simulacrum"] }]
  }
 }
]
