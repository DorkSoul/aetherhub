[
  {
    "name": "taps to deal 1 damage to the opponent",
    "players": [ { "battlefield": ["Prodigal Pyromancer"] }, {} ],
    "steps": [
      { "activate": "Prodigal Pyromancer", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ],
      "tapped": { "Prodigal Pyromancer": true }
    }
  },
  {
    "name": "its 1 damage kills an X/1 creature",
    "players": [ { "battlefield": ["Prodigal Pyromancer"] }, { "battlefield": ["Typhoid Rats"] } ],
    "steps": [
      { "activate": "Prodigal Pyromancer", "ability": 0, "targets": ["Typhoid Rats"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Typhoid Rats"] } ]
    }
  },
  {
    "name": "a tapped Pyromancer cannot activate again this turn",
    "players": [ { "battlefield": ["Prodigal Pyromancer"] }, {} ],
    "steps": [
      { "activate": "Prodigal Pyromancer", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Prodigal Pyromancer", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ]
    }
  }
]
