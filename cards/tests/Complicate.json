[
  {
    "name": "cycling trigger counters when the controller cannot pay one",
    "players": [
      {
        "hand": [
          "Complicate",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "activate": "Complicate"
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Lightning Bolt",
            "Complicate"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "controller pays one and the spell resolves",
    "players": [
      {
        "hand": [
          "Complicate",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "activate": "Complicate"
      },
      {
        "resolve": true,
        "answers": [
          true,
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Complicate"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "declining the may leaves the spell alone",
    "players": [
      {
        "hand": [
          "Complicate",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "activate": "Complicate"
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Complicate"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "opponent's spell is countered when its controller cannot pay {3}",
    "players": [
      { "hand": ["Complicate"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "cast": "Complicate", "targets": [{"stack": "Lightning Bolt"}] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Complicate"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "opponent pays {3} and the spell resolves",
    "players": [
      { "hand": ["Complicate"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
      { "cast": "Complicate", "targets": [{"stack": "Lightning Bolt"}] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 17, "graveyard_has": ["Complicate"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: cycling still draws when the cycle trigger has no legal target",
    "players": [
      { "hand": ["Complicate"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Complicate" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "graveyard_has": ["Complicate"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: cycling still draws when the cycle trigger does nothing (declined)",
    "players": [
      { "hand": ["Complicate", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"], "library": ["Forest"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Complicate" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "graveyard_has": ["Complicate", "Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  }
]