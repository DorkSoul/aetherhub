[
 { "name": "all creatures lose flying, including the opponent's",
   "players": [ { "hand": ["Gravity Sphere"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Gravity Sphere" }, { "resolve": true } ],
   "expect": { "keywords": { "Serra Angel": [] }, "players": [ {}, {} ] } },
 { "name": "non-flying creatures are unaffected and nothing else changes",
   "players": [ { "hand": ["Gravity Sphere"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Gravity Sphere" }, { "resolve": true } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2], "Serra Angel": [4, 4] }, "players": [ { "battlefield_has": ["Gravity Sphere"] }, {} ] } },
 { "name": "Serra Angel without flying can be blocked by Grizzly Bears: no damage to the defender",
   "players": [ { "battlefield": ["Gravity Sphere", { "name": "Serra Angel", "sick": false }] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Serra Angel", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Serra Angel" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "ruling: a second world permanent puts the first Gravity Sphere into its owner's graveyard",
   "players": [ { "hand": ["Gravity Sphere"], "battlefield": ["Gravity Sphere", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Gravity Sphere" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Gravity Sphere"], "battlefield_has": ["Gravity Sphere"] }, {} ] } },
 { "name": "ruling: flying granted after Gravity Sphere is on the battlefield still works (Feather of Flight)",
   "players": [ { "hand": ["Feather of Flight"], "battlefield": ["Gravity Sphere", "Plains", "Island", { "name": "Grizzly Bears", "sick": false }] }, {} ],
   "steps": [ { "cast": "Feather of Flight", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "keywords": { "Grizzly Bears": ["Flying"] }, "pt": { "Grizzly Bears": [3, 2] }, "players": [ {}, {} ] } }
]
