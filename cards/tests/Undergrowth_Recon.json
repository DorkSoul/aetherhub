[
  {
    "name": "upkeep: returns a land card from graveyard tapped",
    "players": [
      {
        "battlefield": [
          "Undergrowth Recon"
        ],
        "graveyard": [
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest"
          ],
          "graveyard": []
        },
        {}
      ],
      "tapped": {
        "Forest": true
      }
    }
  },
  {
    "name": "no land in graveyard: nothing returns",
    "players": [
      {
        "battlefield": [
          "Undergrowth Recon"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Grizzly Bears"
          ],
          "graveyard": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  }
]
