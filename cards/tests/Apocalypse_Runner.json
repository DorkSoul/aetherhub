[
  {
    "name": "crewed with power 3, it becomes a creature until end of turn",
    "players": [
      {
        "battlefield": [
          "Apocalypse Runner",
          {
            "name": "Hill Giant",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Apocalypse Runner",
        "ability": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Apocalypse Runner"
          ]
        },
        {}
      ],
      "pt": {
        "Apocalypse Runner": [
          6,
          5
        ]
      },
      "tapped": {
        "Hill Giant": true
      }
    }
  },
  {
    "name": "tap: power-2-or-less creature gains lifelink and can't be blocked",
    "players": [
      {
        "battlefield": [
          "Apocalypse Runner",
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Apocalypse Runner",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "keywords": {
        "Grizzly Bears": [
          "Lifelink",
          "Unblockable"
        ]
      },
      "tapped": {
        "Apocalypse Runner": true
      }
    }
  },
  {
    "name": "tap: a creature with power 3 is not a legal target",
    "players": [
      {
        "battlefield": [
          "Apocalypse Runner",
          {
            "name": "Hill Giant",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Apocalypse Runner",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ]
    }
  },
  {
    "name": "ruling: activating after the creature was blocked does not unblock it",
    "players": [
      { "battlefield": ["Apocalypse Runner", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "activate": "Apocalypse Runner", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "ruling: lifelink and unblockable stay after the creature's power rises above 2",
    "players": [
      { "battlefield": ["Apocalypse Runner", "Skinshifter", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Apocalypse Runner", "ability": 0, "targets": ["Skinshifter"] },
      { "resolve": true },
      { "activate": "Skinshifter", "ability": 0 },
      { "resolve": true, "answers": [[0]] },
      { "attack": [ { "card": "Skinshifter", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Skinshifter" } ], "player": 1, "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 24 }, { "life": 16 } ] }
  }
]
