[
  { "name": "ruling: a persist creature that returned with a -1/-1 counter stays in the graveyard when it dies again",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Gravelgill Axeshark"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Gravelgill Axeshark"] }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Gravelgill Axeshark"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Gravelgill Axeshark"] }, {} ] } },
  { "name": "persist returns it with a -1/-1 counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Gravelgill Axeshark"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Gravelgill Axeshark"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Gravelgill Axeshark"] }, {} ], "pt": { "Gravelgill Axeshark": [2, 2] } } },
  { "name": "castable for {4} plus blue or black",
    "players": [ { "hand": ["Gravelgill Axeshark"], "battlefield": ["Island", "Island", "Island", "Island", "Swamp"] }, {} ],
    "steps": [ { "cast": "Gravelgill Axeshark" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Gravelgill Axeshark"] }, {} ], "pt": { "Gravelgill Axeshark": [3, 3] } } }
]
