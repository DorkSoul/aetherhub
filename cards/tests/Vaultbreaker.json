[
  { "name": "dash: gains haste, attacks, may discard to draw, then returns to hand at the end step",
    "players": [ { "hand": ["Vaultbreaker", "Mountain"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Vaultbreaker", "alt": 0 }, { "resolve": true },
               { "attack": [ { "card": "Vaultbreaker", "at": "p1" } ] }, { "resolve": true, "answers": [true] }, { "block": [] },
               { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Vaultbreaker", "Island"], "battlefield_lacks": ["Vaultbreaker"], "graveyard": ["Mountain"] }, { "life": 16 } ] } },
  { "name": "dash creature is still on the battlefield before the end step",
    "players": [ { "hand": ["Vaultbreaker"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Vaultbreaker", "alt": 0 }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Vaultbreaker"] }, {} ] } },
  { "name": "hard cast for {3}{R} does not get haste and stays on the battlefield",
    "players": [ { "hand": ["Vaultbreaker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Vaultbreaker" }, { "resolve": true },
               { "attack": [ { "card": "Vaultbreaker", "at": "p1" } ], "illegal": true },
               { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Vaultbreaker"] }, {} ] } },
  { "name": "dash needs {2}{R}: illegal with only two Mountains",
    "players": [ { "hand": ["Vaultbreaker"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Vaultbreaker", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Vaultbreaker"] }, {} ] } },
  { "name": "ruling: a dash spell can be countered like any creature spell",
    "players": [ { "hand": ["Vaultbreaker"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Vaultbreaker", "alt": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Vaultbreaker"], "battlefield_lacks": ["Vaultbreaker"] }, {} ] } },
  { "name": "ruling: dash creature killed before the end step stays in the graveyard",
    "players": [ { "hand": ["Vaultbreaker"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Vaultbreaker", "alt": 0 }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Vaultbreaker"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard": ["Vaultbreaker"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: dash creature that does not attack still returns to hand at the end step",
    "players": [ { "hand": ["Vaultbreaker"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Vaultbreaker", "alt": 0 }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Vaultbreaker"], "battlefield_lacks": ["Vaultbreaker"] }, {} ] } }
]
