[
  {
    "name": "sacrifice two Foods: create a 7/7 Giant token",
    "players": [
      {
        "hand": ["Giant Opportunity"],
        "battlefield": ["Forest", "Forest", "Forest", "Food", "Food"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Opportunity" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Giant 7-7 Green"],
          "battlefield_lacks": ["Food"]
        },
        {}
      ]
    }
  },
  {
    "name": "declines the sacrifice: create three Food tokens instead",
    "players": [
      {
        "hand": ["Giant Opportunity"],
        "battlefield": ["Forest", "Forest", "Forest", "Food", "Food"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Opportunity" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Food"],
          "battlefield_lacks": ["Giant 7-7 Green"]
        },
        {}
      ]
    }
  },
  {
    "name": "only one Food: cannot pay, so three Food tokens are created",
    "players": [
      {
        "hand": ["Giant Opportunity"],
        "battlefield": ["Forest", "Forest", "Forest", "Food"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Opportunity" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Food"],
          "battlefield_lacks": ["Giant 7-7 Green"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: sacrificing two of four Foods still creates only one Giant",
    "players": [
      {
        "hand": ["Giant Opportunity"],
        "battlefield": ["Forest", "Forest", "Forest", "Food", "Food", "Food", "Food"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Opportunity" },
      { "resolve": true, "answers": [true], "auto": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield": ["Forest", "Forest", "Forest", "Food", "Food", "Giant 7-7 Green"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the choice is made on resolution, so sacrificing a Food in response leaves too few to pay",
    "players": [
      {
        "hand": ["Giant Opportunity"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Food", "Food"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Opportunity" },
      { "activate": "Food" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "life": 23,
          "battlefield_has": ["Food"],
          "battlefield_lacks": ["Giant 7-7 Green"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Food means any Food artifact, so a Food creature (Tough Cookie) can be sacrificed",
    "players": [
      {
        "hand": ["Giant Opportunity"],
        "battlefield": ["Forest", "Forest", "Forest", "Tough Cookie", "Food"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Opportunity" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Giant 7-7 Green"],
          "battlefield_lacks": ["Tough Cookie", "Food"]
        },
        {}
      ]
    }
  }
]
