[
  {
    "name": "draws when an opponent casts their second spell",
    "players": [
      { "battlefield": ["Kraum, Ludevic's Opus", "Grizzly Bears"], "library": ["Island"] },
      { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Kraum, Ludevic's Opus"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Island"], "battlefield": ["Kraum, Ludevic's Opus"] },
        { "graveyard": ["Shock", "Shock"] }
      ]
    }
  },
  {
    "name": "the first spell of the turn does not draw",
    "players": [
      { "battlefield": ["Kraum, Ludevic's Opus"], "library": ["Island"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Kraum, Ludevic's Opus"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": [], "library_count": 1 }, { "graveyard": ["Shock"] }]
    }
  },
  {
    "name": "ruling: a third opponent spell in the turn draws nothing more (once per opponent per turn)",
    "players": [
      { "battlefield": ["Kraum, Ludevic's Opus"], "library": ["Island", "Swamp"] },
      { "hand": ["Shock", "Shock", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "resolve": true },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "life": 14 }, { "graveyard": ["Shock", "Shock", "Shock"] } ]
    }
  },
  {
    "name": "ruling: the trigger happens when the second spell is cast while the first is still on the stack",
    "players": [
      { "battlefield": ["Kraum, Ludevic's Opus"], "library": ["Island"] },
      { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "life": 16 }, { "graveyard": ["Shock", "Shock"] } ]
    }
  },
  {
    "name": "ruling: Kraum entering after the opponent's first spell still draws on the second",
    "players": [
      { "hand": ["Kraum, Ludevic's Opus"], "battlefield": ["Island", "Mountain", "Plains", "Plains", "Plains"], "library": ["Island"] },
      { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Kraum, Ludevic's Opus" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "battlefield_has": ["Kraum, Ludevic's Opus"] }, { "graveyard": ["Shock", "Shock"] } ]
    }
  }
]
