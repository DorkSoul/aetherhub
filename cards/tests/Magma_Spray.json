   { "hand": ["Magma Spray"], "battlefield": ["Mountain"] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "cast": "Magma Spray", "targets": ["Serra Angel"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Magma Spray"] },
