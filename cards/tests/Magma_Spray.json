   ],
   "pt": {
    "Serra Angel": [4, 4]
   }
  }
 },
 {
  "name": "ruling: a creature that dies to other damage this turn is exiled instead",
  "players": [
   { "hand": ["Magma Spray", "Disfigure"], "battlefield": ["Mountain", "Swamp"] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "cast": "Magma Spray", "targets": ["Serra Angel"] },
   { "resolve": true },
   { "cast": "Disfigure", "targets": ["Serra Angel"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Magma Spray", "Disfigure"] },
    { "exile": ["Serra Angel"] }
   ]
  }
 }
