  {
    "name": "ruling: the trigger still deals its 3 damage when the creature target becomes illegal in response",
    "players": [
      {
        "hand": ["Manticore of the Gauntlet", "Lightning Bolt"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Manticore of the Gauntlet" },
      { "resolve": true, "targets": ["p0:Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["p0:Grizzly Bears"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt", "Grizzly Bears"], "battlefield_has": ["Manticore of the Gauntlet"] },
        { "life": 17 }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: opponent has hexproof, so the trigger is removed and no -1/-1 counter is put on any creature",
    "players": [
      {
        "hand": ["Manticore of the Gauntlet"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"]
