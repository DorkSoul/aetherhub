[
  {
    "name": "opponent searches for a creature and puts it onto the battlefield",
    "players": [
      { "hand": ["Boldwyr Heavyweights"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Boldwyr Heavyweights" },
      { "resolve": true, "answers": [true, "Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boldwyr Heavyweights"] },
        { "battlefield_has": ["Grizzly Bears"], "library_count": 1 }
      ]
    }
  },
  {
    "name": "opponent may decline the search",
    "players": [
      { "hand": ["Boldwyr Heavyweights"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Boldwyr Heavyweights" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boldwyr Heavyweights"] },
        { "battlefield_lacks": ["Grizzly Bears"], "library_count": 2 }
      ]
    }
  },
  {
    "name": "every opponent gets the choice in a three-player game",
    "players": [
      { "hand": ["Boldwyr Heavyweights"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Forest", "Grizzly Bears"] },
      { "library": ["Plains", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Boldwyr Heavyweights" },
      { "resolve": true, "answers": [true, "Grizzly Bears", true, "Hill Giant"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boldwyr Heavyweights"] },
        { "battlefield_has": ["Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: a player may choose not to search at all",
    "players": [
      { "hand": ["Boldwyr Heavyweights"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Boldwyr Heavyweights" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boldwyr Heavyweights"] },
        { "battlefield_lacks": ["Grizzly Bears"], "library_count": 2 }
      ]
    }
  }
]
