[
  { "name": "attaches on entering to a creature you control and gives +1/+1",
    "players": [ { "hand": ["Baseball Bat"], "battlefield": ["Forest", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Baseball Bat" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Baseball Bat", "Grizzly Bears"] }, {} ], "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "equip {3} attaches it to another creature",
    "players": [ { "battlefield": ["Baseball Bat", "Forest", "Plains", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Baseball Bat", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "attacking with the equipped creature taps up to one target creature",
    "players": [ { "battlefield": ["Baseball Bat", "Forest", "Plains", "Swamp", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Baseball Bat", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true, "targets": ["Hill Giant"] } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Hill Giant": true } } },
  { "name": "up to one: attacking with the equipped creature with no target taps nothing",
    "players": [ { "battlefield": ["Baseball Bat", "Forest", "Plains", "Swamp", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Baseball Bat", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Hill Giant": false } } },
  { "name": "an unequipped attacker does not trigger the bat",
    "players": [ { "battlefield": ["Baseball Bat", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Hill Giant": false } } }
]
