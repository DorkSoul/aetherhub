 { "name": "the Lair's draw ability needs {B} from another source: with only the Lair it is illegal",
   "players": [ { "battlefield": [ { "name": "Grasping Shadows // Shadows' Lair", "counters": { "dread": 2 } }, "Hill Giant" ] }, {} ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "resolve": true }, { "activate": "Shadows' Lair", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Shadows' Lair"], "hand_count": 0, "life": 20 }, {} ] } },
 { "name": "ruling: the transformed Lair keeps the dread counters and the third one is added before it transforms",
   "players": [ { "battlefield": [ { "name": "Grasping Shadows // Shadows' Lair", "counters": { "dread": 2 } }, "Hill Giant" ] }, {} ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Shadows' Lair", "Hill Giant"] }, {} ], "counters": { "Shadows' Lair": { "dread": 3 } } } },
 { "name": "ruling: attacking with several creatures is not a lone attack, so no dread counter is added",
   "players": [ { "battlefield": [ { "name": "Grasping Shadows // Shadows' Lair", "counters": { "dread": 2 } }, "Hill Giant", "Grizzly Bears" ] }, {} ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] } ],
   "expect": { "players": [ { "battlefield_has": ["Grasping Shadows // Shadows' Lair"] }, {} ], "counters": { "Grasping Shadows // Shadows' Lair": { "dread": 2 } } } }
