[
 { "name": "gaining life puts a feeding counter on Nazar",
   "players": [ { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains", "Nazar, the Velvet Fang"] }, {} ],
   "steps": [ { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 23 }, { "life": 17 } ], "counters": { "Nazar, the Velvet Fang": { "feeding": 1 } } } },
 { "name": "attacking with three feeding counters: remove them to draw three and lose 3",
   "players": [ { "battlefield": [ { "name": "Nazar, the Velvet Fang", "counters": { "feeding": 3 } } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Nazar, the Velvet Fang", "at": "p1" } ] }, { "resolve": true, "answers": [true] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 17, "hand_count": 3 }, { "life": 17 } ], "counters": { "Nazar, the Velvet Fang": { "feeding": 0 } } } },
 { "name": "declining the removal keeps the counters and draws nothing",
   "players": [ { "battlefield": [ { "name": "Nazar, the Velvet Fang", "counters": { "feeding": 3 } } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Nazar, the Velvet Fang", "at": "p1" } ] }, { "resolve": true, "answers": [false] } ],
   "expect": { "players": [ { "life": 20 }, {} ], "counters": { "Nazar, the Velvet Fang": { "feeding": 3 } } } },
 { "name": "ruling: Nazar leaves before its attack trigger resolves, so the counters cannot be removed: no draw, no life loss",
   "players": [ { "battlefield": [ { "name": "Nazar, the Velvet Fang", "counters": { "feeding": 3 } } ] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "attack": [ { "card": "Nazar, the Velvet Fang", "at": "p1" } ] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Nazar, the Velvet Fang"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "hand_count": 0, "graveyard": ["Nazar, the Velvet Fang"] }, { "life": 20, "graveyard": ["Lightning Bolt"] } ] } }
]
