[
  {
    "name": "untaps your permanents during each opponent's untap step",
    "players": [
      {
        "battlefield": [
          "Seedborn Muse",
          {
            "name": "Forest",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2",
        "auto": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Seedborn Muse"
          ]
        },
        {}
      ],
      "tapped": {
        "Forest": false
      }
    }
  },
  {
    "name": "without Seedborn Muse a tapped permanent stays tapped in the opponent's untap step",
    "players": [
      {
        "battlefield": [
          {
            "name": "Forest",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2",
        "auto": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      }
    ],
    "expect": {
      "tapped": {
        "Forest": true
      }
    }
  },
  {
    "name": "ruling: Muse untaps a permanent whose text says it does not untap in its controller's untap step",
    "players": [
      {
        "battlefield": [
          "Seedborn Muse",
          { "name": "Battered Golem", "tapped": true }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main2", "auto": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Seedborn Muse", "Battered Golem"] },
        {}
      ],
      "tapped": {
        "Battered Golem": false
      }
    }
  },
  {
    "name": "ruling: all your permanents untap in the opponent's untap step, with no choice",
    "players": [
      {
        "battlefield": [
          { "name": "Seedborn Muse", "tapped": true },
          { "name": "Forest", "tapped": true },
          { "name": "Grizzly Bears", "tapped": true }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main2", "auto": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "tapped": {
        "Seedborn Muse": false,
        "Forest": false,
        "Grizzly Bears": false
      }
    }
  }
]