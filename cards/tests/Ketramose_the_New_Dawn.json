[
  {"name": "your turn: Swords to Plowshares exiling a creature from the battlefield draws a card and loses 1 life",
   "players": [{"hand": ["Swords to Plowshares"], "battlefield": ["Ketramose, the New Dawn", "Plains"], "library": ["Forest", "Mountain"]}, {"battlefield": ["Grizzly Bears"]}],
   "steps": [{"cast": "Swords to Plowshares", "targets": ["Grizzly Bears"]}, {"resolve": true}],
   "expect": {"players": [{"life": 19, "hand": ["Forest"]}, {"life": 22, "exile": ["Grizzly Bears"]}]}},
  {"name": "your turn: exiling two graveyard cards at once is one batch (one card, 1 life)",
   "players": [{"battlefield": ["Ketramose, the New Dawn", "Tormod's Crypt"], "library": ["Forest", "Mountain"]}, {"graveyard": ["Grizzly Bears", "Lightning Bolt"]}],
   "steps": [{"activate": "Tormod's Crypt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"life": 19, "hand": ["Forest"]}, {"graveyard": [], "exile": ["Grizzly Bears", "Lightning Bolt"]}]}},
  {"name": "your turn: a creature dying (graveyard, not exile) does not trigger it",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Ketramose, the New Dawn", "Mountain"], "library": ["Forest"]}, {"battlefield": ["Grizzly Bears"]}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["Grizzly Bears"]}, {"resolve": true}],
   "expect": {"players": [{"life": 20, "hand": []}, {"graveyard": ["Grizzly Bears"]}]}},
  {"name": "opponent's turn: exile from the graveyards does not trigger it",
   "players": [{"battlefield": ["Ketramose, the New Dawn"], "library": ["Forest"]}, {"battlefield": ["Tormod's Crypt"], "graveyard": ["Grizzly Bears"], "library": ["Forest", "Forest"]}],
   "steps": [{"advance_to": "Main1"}, {"player": 1, "activate": "Tormod's Crypt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"life": 20, "hand": []}, {"exile": ["Grizzly Bears", "Tormod's Crypt"]}]}},
  {"name": "with fewer than seven cards in exile Ketramose can't attack",
   "players": [{"battlefield": ["Ketramose, the New Dawn"], "exile": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"advance_to": "Main1"}, {"attack": [{"card": "Ketramose, the New Dawn", "at": "p1"}], "illegal": true}],
   "expect": {"players": [{}, {"life": 20}]}},
  {"name": "with seven cards in exile Ketramose can attack (lifelink)",
   "players": [{"battlefield": ["Ketramose, the New Dawn"], "exile": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"advance_to": "Main1"}, {"attack": [{"card": "Ketramose, the New Dawn", "at": "p1"}]}, {"block": []}, {"advance_to": "Main2"}],
   "expect": {"players": [{"life": 24}, {"life": 16}]}},
  {"name": "with fewer than seven cards in exile Ketramose can't block the attacker",
   "players": [{"battlefield": ["Hill Giant"]}, {"battlefield": ["Ketramose, the New Dawn", "Grizzly Bears"], "exile": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}],
   "steps": [{"attack": [{"card": "Hill Giant", "at": "p1"}]}, {"block": [{"blocker": "Ketramose, the New Dawn", "attacker": "Hill Giant"}]}, {"advance_to": "Main2"}],
   "expect": {"players": [{}, {"life": 17}]}},
  {"name": "with seven cards in exile Ketramose can block the attacker",
   "players": [{"battlefield": ["Hill Giant"]}, {"battlefield": ["Ketramose, the New Dawn", "Grizzly Bears"], "exile": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}],
   "steps": [{"attack": [{"card": "Hill Giant", "at": "p1"}]}, {"block": [{"blocker": "Ketramose, the New Dawn", "attacker": "Hill Giant"}]}, {"advance_to": "Main2"}],
   "expect": {"players": [{"graveyard": ["Hill Giant"]}, {}]}},
  {"name": "with fewer than seven cards in exile Ketramose is not sent to attack; a Grizzly Bears attacks alone (2 damage, not 2 + Ketramose)",
   "players": [{"hand": ["Island"], "battlefield": ["Ketramose, the New Dawn", "Grizzly Bears"], "exile": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}, {}],
   "steps": [{"attack": [{"card": "Grizzly Bears", "at": "p1"}, {"card": "Ketramose, the New Dawn", "at": "p1"}]}, {"block": []}, {"advance_to": "Main2"}],
   "expect": {"players": [{}, {"life": 18}]}},
  {"name": "ruling: exile count includes cards exiled by the opponent (3 mine + 4 theirs = 7, can attack)",
   "players": [{"battlefield": ["Ketramose, the New Dawn"], "exile": ["Forest", "Forest", "Forest"]}, {"exile": ["Forest", "Forest", "Forest", "Forest"]}],
   "steps": [{"advance_to": "Main1"}, {"advance_to": "Main1"}, {"attack": [{"card": "Ketramose, the New Dawn", "at": "p1"}]}, {"block": []}, {"advance_to": "Main2"}],
   "expect": {"players": [{"life": 24}, {"life": 16}]}}
]
