    "players": [ { "hand": ["Chaos Defiler"], "battlefield": ["Swamp", "Mountain", "Forest", "Forest", "Forest"] }, { "battlefield": ["Island", "Plains"] } ],
    "start": "Main1",
    "steps": [ { "cast": "Chaos Defiler" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Chaos Defiler"] }, { "battlefield": ["Island", "Plains"] } ] } },
  { "name": "enters: with two opponents, the indestructible choice is not the one destroyed",
    "players": [ { "hand": ["Chaos Defiler"], "battlefield": ["Swamp", "Mountain", "Forest", "Forest", "Forest"] }, { "battlefield": ["Darksteel Colossus"] }, { "battlefield": ["Grizzly Bears"] } ],
    "start": "Main1",
    "steps": [ { "cast": "Chaos Defiler" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Chaos Defiler"] }, { "battlefield_has": ["Darksteel Colossus"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "dies: when it dies the same choice and destruction happen",
    "players": [ { "hand": ["Murder"], "battlefield": ["Chaos Defiler", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "start": "Main1",
    "steps": [ { "cast": "Murder", "targets": ["Chaos Defiler"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Chaos Defiler", "Murder"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a chosen indestructible permanent is not the random one; a non-indestructible chosen permanent is destroyed",
    "players": [ { "hand": ["Chaos Defiler"], "battlefield": ["Swamp", "Mountain", "Forest", "Forest", "Forest"] }, { "battlefield": ["Darksteel Colossus", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "start": "Main1",
    "steps": [ { "cast": "Chaos Defiler" }, { "resolve": true, "answers": ["Darksteel Colossus"] } ],
    "expect": { "players": [ { "battlefield_has": ["Chaos Defiler"] }, { "battlefield_has": ["Darksteel Colossus", "Grizzly Bears"] }, { "graveyard": ["Llanowar Elves"] } ] } }
