[
  { "name": "draws a card when you cast an enchantment spell",
    "players": [ { "hand": ["Blood Moon"], "battlefield": ["Mountain", "Island", "Forest", "Dathon, His Heart Open"] }, {} ],
    "steps": [ { "cast": "Blood Moon" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, { "life": 20 } ] } },
  { "name": "a Saga spell also deals 2 damage to each opponent",
    "players": [ { "hand": ["History of Benalia"], "battlefield": ["Plains", "Plains", "Island", "Dathon, His Heart Open"] }, {} ],
    "steps": [ { "cast": "History of Benalia" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["History of Benalia"] }, { "life": 18 } ] } },
  { "name": "ruling: pay {2} to add another lore counter to a Saga you control (chapter II triggers)",
    "players": [ { "battlefield": ["Plains", "Plains", "Dathon, His Heart Open", { "name": "History of Benalia", "counters": { "lore": 1 } }] }, {} ],
    "steps": [ { "activate": "Dathon, His Heart Open", "ability": 0, "targets": ["History of Benalia"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["History of Benalia"] }, { "life": 20 } ], "counters": { "History of Benalia": { "lore": 2 } } } },
  { "name": "boundary: cannot target an enchantment an opponent controls",
    "players": [ { "battlefield": ["Plains", "Plains", "Dathon, His Heart Open"] }, { "battlefield": [ { "name": "History of Benalia", "counters": { "lore": 1 } } ] } ],
    "steps": [ { "activate": "Dathon, His Heart Open", "ability": 0, "targets": ["History of Benalia"], "illegal": true } ],
    "expect": { "counters": { "History of Benalia": { "lore": 1 } } } }
]
