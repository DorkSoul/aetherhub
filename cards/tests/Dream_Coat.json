[
  {
    "name": "choose two colors: the creature becomes exactly those",
    "players": [
      { "hand": ["Dream Coat"], "battlefield": ["Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Dream Coat", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Dream Coat" },
      { "resolve": true, "answers": [["R", "W"]] }
    ],
    "expect": {
      "attached": { "Dream Coat": "Grizzly Bears" },
      "colors": { "Grizzly Bears": ["W", "R"] }
    }
  },
  {
    "name": "a single color replaces the old one",
    "players": [
      { "hand": ["Dream Coat"], "battlefield": ["Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Dream Coat", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Dream Coat" },
      { "resolve": true, "answers": ["U"] }
    ],
    "expect": {
      "colors": { "Grizzly Bears": ["U"] }
    }
  },
  {
    "name": "only once each turn",
    "players": [
      { "hand": ["Dream Coat"], "battlefield": ["Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Dream Coat", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Dream Coat" },
      { "resolve": true, "answers": ["U"] },
      { "activate": "Dream Coat", "illegal": true }
    ],
    "expect": {
      "colors": { "Grizzly Bears": ["U"] }
    }
  },
  {
    "name": "five colors at once",
    "players": [
      { "hand": ["Dream Coat"], "battlefield": ["Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Dream Coat", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Dream Coat" },
      { "resolve": true, "answers": [["W", "U", "B", "R", "G"]] }
    ],
    "expect": {
      "colors": { "Grizzly Bears": ["W", "U", "B", "R", "G"] }
    }
  },
  {
    "name": "ruling: the colour change does not wear off at end of turn",
    "players": [ { "hand": ["Dream Coat"], "battlefield": ["Island", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Dream Coat", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Dream Coat" },
      { "resolve": true, "answers": ["U"] },
      { "advance_to": "Main1" }
    ],
    "expect": { "colors": { "Grizzly Bears": ["U"] } }
  }
]
