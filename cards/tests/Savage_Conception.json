[
  {
    "name": "creates a 3/3 Beast token",
    "players": [
      {
        "hand": ["Savage Conception"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Savage Conception" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Savage Conception"],
          "battlefield_has": ["Beast"]
        },
        {}
      ]
    }
  },
  {
    "name": "retrace from the graveyard by discarding a land",
    "players": [
      {
        "hand": ["Forest"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Savage Conception"]
      },
      {}
    ],
    "steps": [
      { "cast": "Savage Conception", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand": [],
          "graveyard": ["Forest", "Savage Conception"],
          "battlefield_has": ["Beast"]
        },
        {}
      ]
    }
  },
  {
    "name": "retrace needs a land card to discard",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Savage Conception"]
      },
      {}
    ],
    "steps": [
      { "cast": "Savage Conception", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Savage Conception"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the active player can retrace again right after it resolves",
    "players": [
      { "hand": ["Forest", "Forest"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Savage Conception"] },
      {}
    ],
    "steps": [
      { "cast": "Savage Conception", "alt": 0, "answers": [["Forest"]] },
      { "resolve": true },
      { "cast": "Savage Conception", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Forest", "Forest", "Savage Conception"], "battlefield_has": ["Beast"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: retrace follows sorcery timing, so it cannot be cast on the opponent's turn",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Savage Conception"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Savage Conception", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "graveyard": ["Savage Conception"] },
        {}
      ]
    }
  }
]
