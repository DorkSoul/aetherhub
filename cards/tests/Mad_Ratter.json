[
  {
    "name": "second card drawn this turn: create two 1/1 black Rats",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Mad Ratter", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mad Ratter", "Rat", "Rat"] }, {} ]
    }
  },
  {
    "name": "only one card drawn: no Rats",
    "players": [
      { "battlefield": ["Mad Ratter"], "library": ["Island", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Draw" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Rat"] }, {} ]
    }
  },
  {
    "name": "ruling: a card put into hand by a tutor is not a draw",
    "players": [
      { "battlefield": ["Mad Ratter", "Swamp", "Swamp"], "library": ["Demonic Tutor", "Island", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Draw" },
      { "advance_to": "Draw" },
      { "advance_to": "Main1" },
      { "cast": "Demonic Tutor" },
      { "resolve": true, "answers": ["Island"] }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "battlefield_lacks": ["Rat"] }, {} ]
    }
  },
  {
    "name": "ruling: a third card drawn in the same turn makes no more Rats",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Mad Ratter", "Island", "Island", "Island"], "library": ["Island", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Draw" },
      { "advance_to": "Draw" },
      { "advance_to": "Main1" },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 3, "battlefield": ["Mad Ratter", "Island", "Island", "Island", "Rat", "Rat"] }, {} ]
    }
  },
  {
    "name": "ruling: Mad Ratter entering after the second card does not trigger that turn",
    "players": [
      { "hand": ["Divination", "Mad Ratter"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Mad Ratter" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mad Ratter"], "battlefield_lacks": ["Rat"] }, {} ]
    }
  }
]
