[
  {
    "name": "casting a creature card that has an Adventure: +1/+1",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Garenbrig Squire", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Garenbrig Squire": [3, 3] } }
  },
  {
    "name": "casting the Adventure half (an instant) does not pump it",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Garenbrig Squire", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Garenbrig Squire": [2, 2] } }
  },
  {
    "name": "a creature spell without an Adventure does not pump it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Garenbrig Squire", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Garenbrig Squire": [2, 2] } }
  },
  {
    "name": "ruling: the trigger still resolves when the creature spell is countered",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Garenbrig Squire", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp" },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Bonecrusher Giant // Stomp" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Bonecrusher Giant // Stomp"] }, { "graveyard": ["Counterspell"] } ], "pt": { "Garenbrig Squire": [3, 3] } }
  }
]
