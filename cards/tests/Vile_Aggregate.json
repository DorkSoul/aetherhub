[
  { "name": "power equals the number of colorless creatures you control (counts itself)",
    "players": [ { "hand": ["Vile Aggregate"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Vile Aggregate" }, { "resolve": true } ],
    "expect": { "pt": { "Vile Aggregate": [1, 5] } } },
  { "name": "ingest: combat damage to a player exiles the top card of their library",
    "players": [ { "battlefield": ["Vile Aggregate"] }, {} ],
    "steps": [ { "attack": [{ "card": "Vile Aggregate", "at": "p1" }] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19, "library_count": 19 } ] } },
  { "name": "ruling: ingest exiles the top card of the library (the Bolt, not the Island below it)",
    "players": [ { "battlefield": ["Vile Aggregate"] }, { "library": ["Lightning Bolt", "Island"] } ],
    "steps": [ { "attack": [{ "card": "Vile Aggregate", "at": "p1" }] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19, "exile": ["Lightning Bolt"], "library_top": ["Island"] } ] } }
]
