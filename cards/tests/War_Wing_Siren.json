[
 { "name": "heroic: a spell that targets it puts a +1/+1 counter on it",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "War-Wing Siren"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["War-Wing Siren"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "pt": { "War-Wing Siren": [5, 7] } } },
 { "name": "a spell targeting another creature does not trigger heroic",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "War-Wing Siren", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "pt": { "War-Wing Siren": [1, 3], "Grizzly Bears": [5, 5] } } },
 { "name": "ruling: heroic trigger resolves before the spell that caused it",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "War-Wing Siren"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["War-Wing Siren"] }, { "pass": true }, { "pass": true, "player": 1 } ],
   "expect": { "stack_empty": false, "counters": { "War-Wing Siren": { "p1p1": 1 } }, "pt": { "War-Wing Siren": [2, 4] } } },
 { "name": "ruling: a copy of a heroic spell does not trigger heroic",
   "players": [ { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Forest", "Island", "Island", "War-Wing Siren"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["War-Wing Siren"] }, { "cast": "Twincast", "targets": [ { "stack": "Giant Growth" } ] }, { "resolve": true }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
   "expect": { "stack_empty": true, "counters": { "War-Wing Siren": { "p1p1": 1 } }, "pt": { "War-Wing Siren": [8, 10] } } }
]
