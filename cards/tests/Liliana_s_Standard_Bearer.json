[
  { "name": "ETB: draws a card for each creature you controlled that died this turn",
    "players": [ { "hand": ["Lightning Bolt", "Liliana's Standard Bearer"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp", "Grizzly Bears"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Liliana's Standard Bearer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Liliana's Standard Bearer"], "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Lightning Bolt", "Grizzly Bears"], "hand": ["Forest"] }, {} ] } },
  { "name": "creatures that died under an opponent's control do not count",
    "players": [ { "hand": ["Liliana's Standard Bearer"], "battlefield": ["Swamp", "Swamp", "Swamp"], "library": ["Forest", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Liliana's Standard Bearer" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Liliana's Standard Bearer"], "hand": [] }, {} ] } },
  { "name": "no creature died this turn: draws nothing",
    "players": [ { "hand": ["Liliana's Standard Bearer"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Liliana's Standard Bearer" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Liliana's Standard Bearer", "Grizzly Bears"], "hand": [] }, {} ] } },
  { "name": "ruling: X counts the Bearer itself when it dies while its ETB trigger is on the stack",
    "players": [ { "hand": ["Lightning Bolt", "Liliana's Standard Bearer"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp", "Swamp"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Liliana's Standard Bearer" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Liliana's Standard Bearer"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Liliana's Standard Bearer"], "graveyard": ["Lightning Bolt", "Liliana's Standard Bearer"], "hand": ["Forest"] }, {} ] } }
]
