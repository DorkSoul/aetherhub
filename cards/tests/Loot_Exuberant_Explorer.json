[
  { "name": "look at top six: a creature with mana value at most the lands you control goes onto the battlefield",
    "players": [ { "battlefield": ["Loot, Exuberant Explorer", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [
      { "activate": "Loot, Exuberant Explorer", "ability": 0 },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Loot, Exuberant Explorer"] }, {} ] } },
  { "name": "a noncreature card among the six is not put onto the battlefield",
    "players": [ { "battlefield": ["Loot, Exuberant Explorer", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt"] }, {} ],
    "steps": [
      { "activate": "Loot, Exuberant Explorer", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield": ["Loot, Exuberant Explorer", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "hand_count": 0 }, {} ] } },
  { "name": "may play an additional land each turn",
    "players": [ { "hand": ["Forest", "Forest"], "battlefield": ["Loot, Exuberant Explorer"] }, {} ],
    "steps": [
      { "play_land": "Forest" },
      { "play_land": "Forest" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Forest"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: Loot's extra land drop stacks with Exploration, so three lands can be played in one turn",
    "players": [ { "hand": ["Forest", "Forest", "Forest", "Forest"], "battlefield": ["Loot, Exuberant Explorer", "Exploration"] }, {} ],
    "steps": [
      { "play_land": "Forest" },
      { "play_land": "Forest" },
      { "play_land": "Forest" },
      { "play_land": "Forest", "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Forest", "Forest"], "hand_count": 1 }, {} ] } }
]
