[
  {
    "name": "equipped creature gets +1/+0 for its own Gauntlets",
    "players": [
      {
        "battlefield": [
          "Golem-Skin Gauntlets",
          "Grizzly Bears",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Golem-Skin Gauntlets",
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [3, 2]
      },
      "attached": {
        "Golem-Skin Gauntlets": "Grizzly Bears"
      }
    }
  },
  {
    "name": "unattached Gauntlets gives no bonus",
    "players": [
      {
        "battlefield": [
          "Golem-Skin Gauntlets",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Grizzly Bears": [2, 2]
      }
    }
  },
  {
    "name": "counts every Equipment attached to the equipped creature",
    "players": [
      {
        "battlefield": [
          "Golem-Skin Gauntlets",
          "Bonesplitter",
          "Grizzly Bears",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Bonesplitter",
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true },
      {
        "activate": "Golem-Skin Gauntlets",
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [6, 2]
      }
    }
  },
  {
    "name": "Equipment on another creature is not counted",
    "players": [
      {
        "battlefield": [
          "Golem-Skin Gauntlets",
          "Bonesplitter",
          "Grizzly Bears",
          "Llanowar Elves",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Bonesplitter",
        "targets": ["Llanowar Elves"]
      },
      { "resolve": true },
      {
        "activate": "Golem-Skin Gauntlets",
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [3, 2],
        "Llanowar Elves": [3, 1]
      }
    }
  },
  {
    "name": "ruling: Gauntlets counts itself, so alone it gives +1/+0 to a 1/1",
    "players": [
      {
        "battlefield": [
          "Golem-Skin Gauntlets",
          "Llanowar Elves",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Golem-Skin Gauntlets",
        "targets": ["Llanowar Elves"]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Llanowar Elves": [2, 1]
      }
    }
  },
  {
    "name": "ruling: Gauntlets bonus is added to another Equipment's bonus (Gauntlets attached first)",
    "players": [
      {
        "battlefield": [
          "Golem-Skin Gauntlets",
          "Bonesplitter",
          "Grizzly Bears",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Golem-Skin Gauntlets",
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true },
      {
        "activate": "Bonesplitter",
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [6, 2]
      }
    }
  }
]
