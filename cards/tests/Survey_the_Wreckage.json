[
  { "name": "destroys target land and creates a 1/1 red Goblin",
    "players": [ { "hand": ["Survey the Wreckage"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "cast": "Survey the Wreckage", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Goblin 1-1"] }, { "graveyard_has": ["Forest"] } ], "pt": { "Goblin 1-1": [1, 1] } } },
  { "name": "can destroy its own land and still makes the token",
    "players": [ { "hand": ["Survey the Wreckage"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Survey the Wreckage", "targets": ["Mountain"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Goblin 1-1"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: target land gone before resolution means no effects, no token",
    "players": [ { "hand": ["Survey the Wreckage"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Fissure"], "battlefield": ["Forest", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] } ],
    "steps": [ { "cast": "Survey the Wreckage", "targets": ["p1:Forest"] }, { "pass": true }, { "cast": "Fissure", "player": 1, "targets": ["p1:Forest"] }, { "pass": true }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Survey the Wreckage"], "battlefield_lacks": ["Goblin 1-1"] }, { "graveyard_has": ["Forest", "Fissure"] } ] } }
]
