[
  {
    "name": "tap: put a charge counter on target artifact",
    "players": [
      { "battlefield": [{ "name": "Coretapper", "sick": false }, "Sol Ring"] },
      {}
    ],
    "steps": [
      { "activate": "Coretapper", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Coretapper", "Sol Ring"] }, {}],
      "counters": { "Sol Ring": { "charge": 1 } },
      "tapped": { "Coretapper": true }
    }
  },
  {
    "name": "sacrifice: two charge counters on target artifact, Coretapper goes to graveyard",
    "players": [
      { "battlefield": [{ "name": "Coretapper", "sick": false }, "Sol Ring"] },
      {}
    ],
    "steps": [
      { "activate": "Coretapper", "ability": 1, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Coretapper"], "battlefield_has": ["Sol Ring"] }, {}],
      "counters": { "Sol Ring": { "charge": 2 } }
    }
  },
  {
    "name": "tap ability can't be activated while tapped",
    "players": [
      { "battlefield": [{ "name": "Coretapper", "sick": false, "tapped": true }, "Sol Ring"] },
      {}
    ],
    "steps": [
      { "activate": "Coretapper", "ability": 0, "targets": ["Sol Ring"], "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Coretapper"] }, {}],
      "counters": {}
    }
  }
]
