      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Bill Potts",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Bill Potts"
        ]
      },
      {
        "resolve": true,
        "answers": [
          "p1"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "the copy may keep its target: Bill Potts takes 3 damage twice and dies",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Bill Potts",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Bill Potts"
        ]
      },
      {
        "resolve": true,
        "answers": [
          "Bill Potts"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Bill Potts",
            "Lightning Bolt"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "it triggers only once each turn, across spells and abilities",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Bill Potts",
          "Wyluli Wolf",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Wyluli Wolf",
        "targets": [
          "Bill Potts"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Bill Potts"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Bill Potts": [
          4,
          6
        ]
      },
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ],
          "battlefield_has": [
            "Bill Potts"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "an ability that targets only Bill Potts is copied",
    "players": [
      {
        "battlefield": [
          "Bill Potts",
          "Wyluli Wolf"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Wyluli Wolf",
        "targets": [
          "Bill Potts"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Bill Potts": [
          4,
          6
        ]
      }
    }
  },
  {
    "name": "a spell that targets a different creature isn't copied",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Bill Potts",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ],
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: the trigger still happens when the spell could have targeted another creature",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Bill Potts", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Bill Potts"] },
      { "resolve": true, "answers": ["p1"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 17, "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the copy has the same X as the original: Blaze X=2 twice kills Bill Potts (toughness 4)",
    "players": [
      { "hand": ["Blaze"], "battlefield": ["Bill Potts", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Blaze", "targets": ["Bill Potts"], "answers": [2] },
      { "resolve": true, "answers": ["Bill Potts"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Blaze", "Bill Potts"] },
        { "life": 20 }
      ]
    }
  }
]