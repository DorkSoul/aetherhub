[
 {"name": "ETB taps an opposing creature and puts a stun counter on it",
  "players": [{"hand": ["Frostfist Strider"], "battlefield": ["Island", "Island", "Island", "Island", "Island"]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"cast": "Frostfist Strider"}, {"resolve": true}, {"resolve": true}],
  "expect": {"tapped": {"Grizzly Bears": true}, "counters": {"Grizzly Bears": {"stun": 1}}, "pt": {"Frostfist Strider": [4, 4]}}},
 {"name": "stun counter replaces the untap step once",
  "players": [{"hand": ["Frostfist Strider"], "battlefield": ["Island", "Island", "Island", "Island", "Island"]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"cast": "Frostfist Strider"}, {"resolve": true}, {"resolve": true}, {"advance_to": "Main1"}, {"advance_to": "Main1"}],
  "expect": {"tapped": {"Grizzly Bears": true}, "counters": {"Grizzly Bears": {"stun": 0}}}},
 {"name": "ward {2}: the caster has only 2 Swamps and cannot pay, Doom Blade is countered",
  "players": [{"battlefield": ["Frostfist Strider"]}, {"hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"]}],
  "steps": [{"pass": true}, {"cast": "Doom Blade", "player": 1, "targets": ["Frostfist Strider"]}, {"resolve": true, "auto": true}],
  "expect": {"players": [{"battlefield_has": ["Frostfist Strider"]}, {"graveyard_has": ["Doom Blade"], "life": 20}]}},
 {"name": "ward {2}: the caster pays 2 more with 4 Swamps, Doom Blade destroys the Strider",
  "players": [{"battlefield": ["Frostfist Strider"]}, {"hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]}],
  "steps": [{"pass": true}, {"cast": "Doom Blade", "player": 1, "targets": ["Frostfist Strider"]}, {"resolve": true, "auto": true}],
  "expect": {"players": [{"graveyard_has": ["Frostfist Strider"]}, {"graveyard_has": ["Doom Blade"], "life": 20}]}},
 {"name": "ruling: an already tapped creature can be targeted; it gets a stun counter and stays tapped",
  "players": [{"hand": ["Frostfist Strider"], "battlefield": ["Island", "Island", "Island", "Island", "Island"]}, {"battlefield": [{"name": "Grizzly Bears", "tapped": true}]}],
  "steps": [{"cast": "Frostfist Strider"}, {"resolve": true}, {"resolve": true}],
  "expect": {"tapped": {"Grizzly Bears": true}, "counters": {"Grizzly Bears": {"stun": 1}}}},
 {"name": "ruling: with two stun counters, only one is removed per untap step",
  "players": [{"hand": ["Frostfist Strider", "Frostfist Strider"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"cast": "Frostfist Strider"}, {"resolve": true}, {"resolve": true}, {"cast": "Frostfist Strider"}, {"resolve": true}, {"resolve": true}, {"advance_to": "Main1"}],
  "expect": {"tapped": {"Grizzly Bears": true}, "counters": {"Grizzly Bears": {"stun": 1}}}}
]
