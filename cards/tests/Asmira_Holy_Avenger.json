[
  { "name": "one of your creatures died this turn: gets a counter at the end step",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Asmira, Holy Avenger", "Grizzly Bears", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "pt": { "Asmira, Holy Avenger": [3, 4] } } },
  { "name": "no creature died this turn: no counter",
    "players": [ { "battlefield": ["Asmira, Holy Avenger"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "pt": { "Asmira, Holy Avenger": [2, 3] } } },
  { "name": "an opponent's creature dying does not count",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Asmira, Holy Avenger", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "pt": { "Asmira, Holy Avenger": [2, 3] } } },
  { "name": "ruling: a creature that died before Asmira entered still counts",
    "players": [ { "hand": ["Lightning Bolt", "Asmira, Holy Avenger"], "battlefield": ["Grizzly Bears", "Mountain", "Forest", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Asmira, Holy Avenger" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "pt": { "Asmira, Holy Avenger": [3, 4] } } }
]
