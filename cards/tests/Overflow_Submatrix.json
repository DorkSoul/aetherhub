[
 { "name": "casts an artifact creature from your graveyard, which enters with a finality counter",
   "players": [ { "graveyard": ["Juggernaut"], "battlefield": ["Overflow Submatrix", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Juggernaut" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Juggernaut"] }, {} ], "pt": { "Juggernaut": [5, 3] } } },
 { "name": "only once during your turn",
   "players": [ { "graveyard": ["Juggernaut", "Solemn Simulacrum"], "battlefield": ["Overflow Submatrix", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Juggernaut" }, { "resolve": true }, { "cast": "Solemn Simulacrum", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Juggernaut"], "battlefield_lacks": ["Solemn Simulacrum"] }, {} ] } },
 { "name": "a non-artifact creature cannot be cast from the graveyard this way",
   "players": [ { "graveyard": ["Grizzly Bears"], "battlefield": ["Overflow Submatrix", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ] } }
]
