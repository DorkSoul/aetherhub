    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": false
   }
  }
 },
 {
  "name": "ruling: the {1} and {T} costs are paid as the ability is activated, so the source and the mana are already tapped while it is on the stack",
  "players": [
   {
    "battlefield": [
     "Icy Manipulator",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Icy Manipulator",
    "targets": [
     "Grizzly Bears"
    ]
   }
  ],
  "expect": {
   "tapped": {
    "Icy Manipulator": true,
    "Island": true,
    "Grizzly Bears": false
   }
  }
 }
