 {
  "name": "taps a land",
  "players": [
   {
    "battlefield": [
     "Icy Manipulator",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Forest"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Icy Manipulator",
    "targets": [
     "Forest"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Forest": true
   }
  }
 },
 {
  "name": "needs the {1}",
  "players": [
   {
    "battlefield": [
     "Icy Manipulator"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Icy Manipulator",
    "targets": [
     "Grizzly Bears"
