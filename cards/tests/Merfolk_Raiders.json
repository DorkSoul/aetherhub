[
  {
    "name": "islandwalk: unblockable while defender controls an Island",
    "players": [
      { "battlefield": ["Merfolk Raiders"] },
      { "battlefield": ["Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Merfolk Raiders", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "no Island for the defender: Grizzly Bears can block it",
    "players": [
      { "battlefield": ["Merfolk Raiders"] },
      { "battlefield": ["Plains", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Merfolk Raiders", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Merfolk Raiders" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "phasing: phases out during its controller's untap step",
    "players": [
      { "battlefield": ["Merfolk Raiders"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Merfolk Raiders"] } ]
    }
  },
  {
    "name": "phasing: phased out creature phases back in during the next untap step",
    "players": [
      { "battlefield": ["Merfolk Raiders"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Merfolk Raiders"] } ]
    }
  }
]
