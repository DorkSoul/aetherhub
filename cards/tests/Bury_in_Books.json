[
  {
    "name": "costs {2} less when it targets an attacking creature",
    "players": [
      { "hand": ["Bury in Books"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "cast": "Bury in Books", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Bury in Books"], "battlefield_lacks": ["Grizzly Bears"], "library_count": 21 },
        {}
      ]
    }
  },
  {
    "name": "a creature that is not attacking costs the full {4}{U}",
    "players": [
      { "hand": ["Bury in Books"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Bury in Books", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Bury in Books"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: owner's library empty, the creature becomes the top (only) card",
    "players": [
      { "hand": ["Bury in Books"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": [], "exact_library": true }
    ],
    "steps": [
      { "cast": "Bury in Books", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Bury in Books"] },
        { "battlefield_lacks": ["Grizzly Bears"], "library_top": ["Grizzly Bears"], "library_count": 1 }
      ]
    }
  }
]
