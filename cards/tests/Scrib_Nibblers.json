[
  { "name": "tap: exile the top card of target player's library; a land gains you 1 life",
    "players": [ { "battlefield": ["Scrib Nibblers"] }, { "library": ["Forest"] } ],
    "steps": [ { "activate": "Scrib Nibblers", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21 }, { "library_count": 20, "exile": ["Forest"] } ] } },
  { "name": "nonland exiled: no life gained",
    "players": [ { "battlefield": ["Scrib Nibblers"] }, { "library": ["Lightning Bolt"] } ],
    "steps": [ { "activate": "Scrib Nibblers", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "library_count": 20, "exile": ["Lightning Bolt"] } ] } },
  { "name": "landfall: may untap it",
    "players": [ { "hand": ["Forest"], "battlefield": ["Scrib Nibblers"] }, { "library": ["Lightning Bolt"] } ],
    "steps": [ { "activate": "Scrib Nibblers", "ability": 0, "targets": ["p1"] }, { "resolve": true }, { "play_land": "Forest" }, { "resolve": true, "answers": [true] } ],
    "expect": { "tapped": { "Scrib Nibblers": false } } },
  { "name": "ruling: a land put onto the battlefield by a spell (Cultivate) triggers landfall",
    "players": [ { "hand": ["Cultivate"], "battlefield": ["Scrib Nibblers", "Forest", "Forest", "Forest"], "library": ["Mountain", "Island"] }, { "library": ["Lightning Bolt"] } ],
    "steps": [ { "activate": "Scrib Nibblers", "ability": 0, "targets": ["p1"] }, { "resolve": true }, { "cast": "Cultivate" }, { "resolve": true, "answers": ["Mountain", "Island", true] }, { "resolve": true } ],
    "expect": { "tapped": { "Scrib Nibblers": false, "Mountain": true } } }
]
