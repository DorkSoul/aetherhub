[
  {
    "name": "prevents the next 1 damage to the target",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Clergy en-Vec", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Clergy en-Vec", "ability": 0, "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 18 }, {} ] }
  },
  {
    "name": "tap ability cannot be used twice in a turn",
    "players": [ { "battlefield": ["Clergy en-Vec"] }, {} ],
    "steps": [
      { "activate": "Clergy en-Vec", "ability": 0, "targets": ["p0"] },
      { "resolve": true },
      { "activate": "Clergy en-Vec", "ability": 0, "targets": ["p0"], "illegal": true }
    ],
    "expect": { "players": [ { "life": 20 }, {} ] }
  }
]
