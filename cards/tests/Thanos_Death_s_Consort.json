[
  {
    "name": "gets a +1/+1 counter when another creature dies",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Thanos, Death's Consort", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Thanos, Death's Consort": { "p1p1": 1 } },
      "pt": { "Thanos, Death's Consort": [4, 4] }
    }
  },
  {
    "name": "does not trigger on its own death",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Thanos, Death's Consort", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Thanos, Death's Consort"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Thanos, Death's Consort"] }, {} ]
    }
  },
  {
    "name": "lifelink gains life equal to combat damage",
    "players": [
      { "battlefield": ["Thanos, Death's Consort"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Thanos, Death's Consort", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 23 }, { "life": 17 } ]
    }
  }
]
