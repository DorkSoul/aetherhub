[
  { "name": "a land entering makes Tam prepared; Deep Sight copy draws a card and gains 1 life, then Tam is unprepared",
    "players": [ { "hand": ["Plains"], "battlefield": ["Forest", "Island", "Tam, Observant Sequencer // Deep Sight"] }, {} ],
    "steps": [ { "play_land": "Plains" }, { "resolve": true },
               { "cast": "Deep Sight" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": [] }, {} ] } },
  { "name": "the Deep Sight copy cannot be cast from hand",
    "players": [ { "hand": ["Tam, Observant Sequencer // Deep Sight"], "battlefield": ["Forest", "Island", "Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Deep Sight", "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "a prepared Tam gives only one Deep Sight copy",
    "players": [ { "hand": ["Plains", "Mountain"], "battlefield": ["Forest", "Forest", "Island", "Island", "Tam, Observant Sequencer // Deep Sight"] }, {} ],
    "steps": [ { "play_land": "Plains" }, { "resolve": true },
               { "cast": "Deep Sight" }, { "resolve": true },
               { "cast": "Deep Sight", "illegal": true } ],
    "expect": { "players": [ { "life": 21 }, {} ] } },
  { "name": "ruling: the Deep Sight copy stays in exile while Tam is prepared, through state-based actions and the rest of the turn",
    "players": [ { "hand": ["Plains"], "battlefield": ["Forest", "Island", "Tam, Observant Sequencer // Deep Sight"] }, {} ],
    "steps": [ { "play_land": "Plains" }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "exile": ["Deep Sight"], "graveyard": [] }, {} ] } },
  { "name": "ruling: casting the prepared copy from exile removes it from exile",
    "players": [ { "hand": ["Plains"], "battlefield": ["Forest", "Island", "Tam, Observant Sequencer // Deep Sight"] }, {} ],
    "steps": [ { "play_land": "Plains" }, { "resolve": true }, { "cast": "Deep Sight" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": [], "graveyard": [] }, {} ] } }
]
