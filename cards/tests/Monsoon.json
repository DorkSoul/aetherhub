[
  {
    "name": "taps the active player's untapped Islands and deals that many damage to them",
    "players": [
      { "battlefield": ["Monsoon", "Island", "Island", "Mountain"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 18 }, { "life": 20 } ]
    }
  },
  {
    "name": "already tapped Islands are not counted and stay tapped",
    "players": [
      { "battlefield": ["Monsoon", { "name": "Island", "tapped": true }, "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 19 }, {} ],
      "tapped": { "Island": true }
    }
  },
  {
    "name": "the opponent's Islands are not tapped and take no damage at your end step",
    "players": [
      { "battlefield": ["Monsoon", "Mountain"] },
      { "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 20 } ],
      "tapped": { "Island": false }
    }
  }
]
