[
 { "name": "ruling: each player tracks speed separately (an opponent with no speed has 0)",
   "players": [ { "hand": ["Goblin Surveyor"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Goblin Surveyor" }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1 }, { "speed": 0 } ] } },
 { "name": "ruling: an opponent losing life on my turn raises my speed to 2 and nothing else changes it",
   "players": [ { "hand": ["Goblin Surveyor", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Goblin Surveyor" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 2 }, { "speed": 0, "life": 17 } ] } },
 { "name": "start your engines: speed starts at 1 when it enters",
   "players": [ { "hand": ["Goblin Surveyor"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Goblin Surveyor" }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1 }, {} ] } },
 { "name": "max speed: {3} and exile from graveyard draws a card",
   "players": [ { "graveyard": ["Goblin Surveyor"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "set_speed": 4 }, { "activate": "Goblin Surveyor", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Goblin Surveyor"], "hand_count": 1 }, {} ] } },
 { "name": "below max speed: the graveyard ability is not available",
   "players": [ { "graveyard": ["Goblin Surveyor"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "set_speed": 3 }, { "activate": "Goblin Surveyor", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Goblin Surveyor"], "hand_count": 0 }, {} ] } },
 { "name": "max speed but only two mana: not affordable",
   "players": [ { "graveyard": ["Goblin Surveyor"], "battlefield": ["Mountain", "Mountain"] }, {} ],
   "steps": [ { "set_speed": 4 }, { "activate": "Goblin Surveyor", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Goblin Surveyor"] }, {} ] } }
]
