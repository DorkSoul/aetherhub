[
  {
    "name": "prevents 1 damage to a player",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Rakalite"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rakalite"
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "returns to its owner's hand at the beginning of the end step",
    "players": [
      {
        "battlefield": [
          "Rakalite",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rakalite"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Rakalite"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "cannot activate without mana",
    "players": [
      {
        "battlefield": [
          "Rakalite"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rakalite",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Rakalite"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: destroyed before the end step, it does not return to hand",
    "players": [{"hand": ["Disenchant"], "battlefield": ["Rakalite", "Plains", "Plains", "Plains", "Plains"]}, {}],
    "steps": [{"activate": "Rakalite"}, {"resolve": true}, {"cast": "Disenchant", "targets": ["Rakalite"]}, {"resolve": true}, {"advance_to": "End"}, {"resolve": true}],
    "expect": {"players": [{"graveyard": ["Rakalite", "Disenchant"], "hand_count": 0}, {}]}
  },
  {
    "name": "ruling: can be activated any number of times; two activations prevent 2 of Bolt's 3 damage",
    "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Rakalite", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
    "steps": [{"activate": "Rakalite"}, {"resolve": true}, {"activate": "Rakalite"}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
    "expect": {"players": [{}, {"life": 19}]}
  }
]
