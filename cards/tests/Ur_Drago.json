[
  {
    "name": "swampwalk creature can be blocked by Ur-Drago while defender controls a Swamp",
    "players": [
      { "battlefield": ["Anaconda"] },
      { "battlefield": ["Swamp", "Ur-Drago"] }
    ],
    "steps": [
      { "attack": [{ "card": "Anaconda", "at": "p1" }] },
      { "block": [{ "blocker": "Ur-Drago", "attacker": "Anaconda" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "graveyard": ["Anaconda"] }, { "battlefield": ["Swamp", "Ur-Drago"], "life": 20 }]
    }
  },
  {
    "name": "mountainwalk creature is still unblockable with Ur-Drago in play (only swampwalk is affected)",
    "players": [
      { "battlefield": ["Rock Badger"] },
      { "battlefield": ["Mountain", "Ur-Drago"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rock Badger", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "ruling: Ur-Drago affects any controller's swampwalker, so a creature the defender controls can block it",
    "players": [
      { "battlefield": ["Bog Wraith", "Ur-Drago"] },
      { "battlefield": ["Swamp", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Bog Wraith", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Bog Wraith" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield": ["Bog Wraith", "Ur-Drago"] }, { "graveyard": ["Grizzly Bears"], "life": 20 }]
    }
  }
]
