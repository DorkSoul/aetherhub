   "steps": [ { "activate": "The Biblioplex", "ability": 0 }, { "resolve": true, "answers": [["Grizzly Bears"]] } ],
   "expect": { "players": [ { "hand": [], "graveyard": ["Grizzly Bears"] }, {} ] } },
 { "name": "declining both: the instant stays on top of the library",
   "players": [ { "battlefield": ["The Biblioplex", "Island", "Island"], "library": ["Lightning Bolt", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "The Biblioplex", "ability": 0 }, { "resolve": true, "answers": [[], []] } ],
   "expect": { "players": [ { "hand": [], "graveyard": [] }, {} ] } },
 { "name": "with one card in hand the ability can't be activated",
   "players": [ { "hand": ["Forest"], "battlefield": ["The Biblioplex", "Island", "Island"], "library": ["Lightning Bolt"] }, {} ],
   "steps": [ { "activate": "The Biblioplex", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Forest"] }, {} ] } },
