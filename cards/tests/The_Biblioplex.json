   "steps": [ { "activate": "The Biblioplex", "ability": 0 }, { "resolve": true, "answers": [["Lightning Bolt"]] } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"], "battlefield_has": ["The Biblioplex"] }, {} ] } },
 { "name": "a creature on top is not taken, but may be put into the graveyard",
