[
 {
  "name": "P/T equals the chosen opponent's graveyard",
  "players": [ { "hand": ["Sewer Nemesis"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "graveyard": ["Island"] }, { "graveyard": ["Forest", "Forest", "Forest"] } ],
  "steps": [ { "cast": "Sewer Nemesis" }, { "resolve": true, "answers": [1] } ],
  "expect": { "pt": { "Sewer Nemesis": [3, 3] } }
 },
 {
  "name": "choosing yourself uses your own graveyard",
  "players": [ { "hand": ["Sewer Nemesis"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "graveyard": ["Island", "Island"] }, { "graveyard": ["Forest", "Forest", "Forest"] } ],
  "steps": [ { "cast": "Sewer Nemesis" }, { "resolve": true, "answers": [0] } ],
  "expect": { "pt": { "Sewer Nemesis": [2, 2] } }
 },
 {
  "name": "the chosen player mills a card when they cast a spell",
  "players": [ { "hand": ["Sewer Nemesis", "Shock"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Mountain"], "graveyard": ["Island"] }, { } ],
  "steps": [ { "cast": "Sewer Nemesis" }, { "resolve": true, "answers": [0] }, { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Forest", "Island", "Shock"] }, { "life": 18 } ], "pt": { "Sewer Nemesis": [3, 3] } }
 },
 {
  "name": "no mill when a player other than the chosen one casts a spell",
  "players": [ { "hand": ["Sewer Nemesis", "Shock"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Mountain"] }, { "graveyard": ["Island"] } ],
  "steps": [ { "cast": "Sewer Nemesis" }, { "resolve": true, "answers": [1] }, { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Shock"] }, { "life": 18, "graveyard": ["Island"] } ], "pt": { "Sewer Nemesis": [1, 1] } }
 }
]
