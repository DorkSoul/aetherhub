    "expect": {
      "players": [
        { "battlefield_has": ["Granite Witness"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "pt": { "Granite Witness": [3, 2] },
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "turned face up: may untap target creature (mode 1)",
    "players": [
      { "hand": ["Granite Witness"], "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Granite Witness", "alt": 254 },
      { "resolve": true },
      { "activate": "Granite Witness", "ability": 0 },
