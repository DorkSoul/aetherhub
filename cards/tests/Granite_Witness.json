      {
        "hand": [
          "Granite Witness"
        ],
        "battlefield": [
          "Plains",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Granite Witness",
        "illegal": true
      }
    ]
  },
  {
    "name": "turned face up: may tap target creature (mode 0)",
