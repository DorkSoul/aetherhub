    "steps": [ { "cast": "Granite Witness", "alt": 254 }, { "activate": "Granite Witness", "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Granite Witness"] }, {} ], "pt": { "Granite Witness": [2, 2] } }
  },
  {
    "name": "ruling: face-down creature has ward 2, so a Bolt is countered when the opponent cannot pay",
