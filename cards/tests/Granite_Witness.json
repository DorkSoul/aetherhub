    "steps": [ { "cast": "Granite Witness", "alt": 254 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Granite Witness"] }, {} ], "pt": { "Granite Witness": [2, 2] }, "colors": { "Granite Witness": [] } }
  },
  {
    "name": "ruling: a face-down spell can't be turned face up while it is on the stack",
