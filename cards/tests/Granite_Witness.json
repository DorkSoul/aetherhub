    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Granite Witness"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Granite Witness"], "life": 20 }, { "graveyard": ["Lightning Bolt"], "life": 20 } ] }
  },
  {
    "name": "ruling: face-down ward 2 is paid by the opponent, and the Bolt then kills the 2/2",
    "players": [ { "battlefield": [ { "name": "Granite Witness", "face_down": true } ] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Granite Witness"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Granite Witness"] }, { "graveyard": ["Lightning Bolt"] } ] }
  },
  {
    "name": "ruling: turning a tapped face-down creature face up leaves it tapped",
    "players": [ { "battlefield": [ { "name": "Granite Witness", "face_down": true, "tapped": true }, "Plains", "Plains" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Granite Witness" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "battlefield_has": ["Granite Witness"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Granite Witness": [3, 2] }, "tapped": { "Granite Witness": true } }
  },
  {
    "name": "ruling: an Aura on a face-down creature stays attached when it is turned face up",
    "players": [ { "hand": ["Mardu Runemark"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains", { "name": "Granite Witness", "face_down": true }] }, {} ],
    "steps": [ { "cast": "Mardu Runemark", "targets": ["Granite Witness"] }, { "resolve": true }, { "activate": "Granite Witness" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "battlefield_has": ["Granite Witness", "Mardu Runemark"] }, {} ], "pt": { "Granite Witness": [5, 4] }, "attached": { "Mardu Runemark": "Granite Witness" } }
  }
]