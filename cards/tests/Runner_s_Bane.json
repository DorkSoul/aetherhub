[
  {
    "name": "taps the enchanted creature when it enters",
    "players": [ { "hand": ["Runner's Bane"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Runner's Bane", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Runner's Bane"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "cannot enchant a creature with power 4 or more",
    "players": [ { "hand": ["Runner's Bane"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Rushwood Elemental"] } ],
    "steps": [ { "cast": "Runner's Bane", "targets": ["Rushwood Elemental"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Runner's Bane"] }, {} ] }
  },
  {
    "name": "enchanted creature stays tapped through its controller's untap step",
    "players": [ { "hand": ["Runner's Bane"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Runner's Bane", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "ruling: enchanted creature pumped to power 4 or more: Runner's Bane goes to the graveyard",
    "players": [
      { "hand": ["Runner's Bane", "Giant Growth"], "battlefield": ["Island", "Island", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Runner's Bane", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Runner's Bane"] }, {}],
      "pt": { "Grizzly Bears": [5, 5] }
    }
  }
]
