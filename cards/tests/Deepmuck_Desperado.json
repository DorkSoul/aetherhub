[
  { "name": "committing a crime mills each opponent three cards",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Deepmuck Desperado"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"], "library_count": 17 } ] } },
  { "name": "the crime trigger works once each turn",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Deepmuck Desperado"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "library_count": 17 } ] } },
  { "name": "targeting only your own creature is not a crime",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Deepmuck Desperado", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "library_count": 20 } ] } },
  { "name": "ruling: the crime trigger resolves before the spell that caused it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Deepmuck Desperado"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "stack_empty": false, "players": [ {}, { "library_count": 17, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an activated ability targeting an opponent's creature is a crime",
    "players": [ { "battlefield": ["Prodigal Sorcerer", "Deepmuck Desperado"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "library_count": 17, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a countered spell that targeted an opponent still commits the crime",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Deepmuck Desperado"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Counterspell"], "battlefield_has": ["Grizzly Bears"], "library_count": 17 } ] } }
]
