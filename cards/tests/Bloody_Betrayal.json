[
  {
    "name": "steal, untap and attack with it; leave a Blood token",
    "players": [
      { "hand": ["Bloody Betrayal"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Bloody Betrayal", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Blood"] },
        { "life": 18, "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "control of the creature returns at end of turn",
    "players": [
      { "hand": ["Bloody Betrayal"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Bloody Betrayal", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Mountain", "Mountain", "Blood"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: if all targets become illegal the spell does nothing and creates no Blood token",
    "players": [
      { "hand": ["Bloody Betrayal"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Grizzly Bears", "sick": false }] }
    ],
    "steps": [
      { "cast": "Bloody Betrayal", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Blood"], "graveyard_has": ["Bloody Betrayal"] },
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  }
]
