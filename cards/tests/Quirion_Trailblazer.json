[
  { "name": "ETB: search for a basic land onto the battlefield tapped",
    "players": [ { "hand": ["Quirion Trailblazer"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Mountain", "Island"] }, {} ],
    "steps": [ { "cast": "Quirion Trailblazer" }, { "resolve": true, "answers": [true, "Mountain"] } ],
    "expect": { "players": [ { "battlefield_has": ["Mountain", "Quirion Trailblazer"] }, {} ], "tapped": { "Mountain": true } } },
  { "name": "ETB: declining the search puts no land in",
    "players": [ { "hand": ["Quirion Trailblazer"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Quirion Trailblazer" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Mountain"] }, {} ] } },
  { "name": "ruling: the search land does not use up the land drop",
    "players": [ { "hand": ["Quirion Trailblazer", "Forest"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Quirion Trailblazer" }, { "resolve": true, "answers": [true, "Mountain"] }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Mountain", "Forest", "Quirion Trailblazer"], "hand_count": 0 }, {} ] } }
]
