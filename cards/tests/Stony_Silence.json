[
  {
    "name": "artifact mana ability cannot be activated, opponents too",
    "players": [
      {
        "hand": [
          "Stony Silence"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Sol Ring"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Stony Silence"
      },
      {
        "resolve": true
      },
      {
        "pass": true
      },
      {
        "tap_for_mana": "Sol Ring",
        "player": 1,
        "illegal": true
      }
    ],
    "expect": {
      "tapped": {
        "Sol Ring": false
      }
    }
  },
  {
    "name": "creature abilities are not affected",
    "players": [
      {
        "hand": [
          "Stony Silence"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          {
            "name": "Bold Impaler",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Stony Silence"
      },
      {
        "resolve": true
      },
      {
        "activate": "Bold Impaler",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Bold Impaler": [
          3,
          2
        ]
      }
    }
  },
  {
    "name": "an artifact's non-mana activated ability (equip) is also blocked",
    "players": [
      { "hand": ["Stony Silence"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Stormbeacon Blade", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Stony Silence" },
      { "resolve": true },
      { "activate": "Stormbeacon Blade", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "ruling: an artifact's triggered ability (Stormbeacon Blade attack trigger) still triggers",
    "players": [
      { "hand": ["Stony Silence"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Stormbeacon Blade", "Grizzly Bears", "Hill Giant", "Savannah Lions"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "activate": "Stormbeacon Blade", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Stony Silence" },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" }] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "hand": ["Island"] },
        {}
      ]
    }
  }
]
