[
  {
    "name": "adds colorless and gains 1 life",
    "players": [
      {
        "battlefield": [
          "Pristine Talisman"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Pristine Talisman"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "C": 1
          },
          "life": 21
        }
      ]
    }
  },
  {
    "name": "tapped talisman cannot be tapped again",
    "players": [
      {
        "battlefield": [
          {
            "name": "Pristine Talisman",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "players": [
        {
          "life": 20
        }
      ],
      "tapped": {
        "Pristine Talisman": true
      }
    }
  },
  {
    "name": "ruling: the mana ability resolves at once, so Lightning Bolt is still the only thing on the stack",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pristine Talisman"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "tap_for_mana": "Pristine Talisman" } ],
    "expect": { "stack_empty": false, "players": [ { "life": 21, "pool": { "C": 1 } }, {} ] }
  }
]