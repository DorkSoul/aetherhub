[
  {
    "name": "sacrificed at the end step when you control no creatures (any player's turn)",
    "players": [
      { "battlefield": ["Thran Quarry"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "graveyard": ["Thran Quarry"] }, {}]
    }
  },
  {
    "name": "stays if you control a creature",
    "players": [
      { "battlefield": ["Thran Quarry", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "battlefield": ["Thran Quarry", "Llanowar Elves"] }, {}]
    }
  },
  {
    "name": "taps for any color",
    "players": [
      { "battlefield": ["Thran Quarry"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Thran Quarry", "color": "R" }
    ],
    "expect": {
      "players": [{ "pool": { "R": 1 } }, {}]
    }
  },
  {
    "name": "ruling: also sacrificed at the end step of an opponent's turn when you control no creatures",
    "players": [
      { "battlefield": ["Thran Quarry", "Llanowar Elves"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Terror", "targets": ["Llanowar Elves"], "player": 1 },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard": ["Thran Quarry", "Llanowar Elves"] }, {} ] }
  }
]
