[
  {
    "name": "enters and destroys a target artifact",
    "players": [
      { "hand": ["Hatut Zeraze Strike Force"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Arcane Signet"] }
    ],
    "steps": [
      { "cast": "Hatut Zeraze Strike Force" },
      { "resolve": true, "targets": ["Arcane Signet"] }
    ],
    "expect": { "players": [{ "battlefield_has": ["Hatut Zeraze Strike Force"] }, { "graveyard": ["Arcane Signet"] }] }
  },
  {
    "name": "up to one: the enters trigger may choose no target",
    "players": [
      { "hand": ["Hatut Zeraze Strike Force"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Arcane Signet"] }
    ],
    "steps": [
      { "cast": "Hatut Zeraze Strike Force" },
      { "resolve": true, "targets": [] }
    ],
    "expect": { "players": [{ "battlefield_has": ["Hatut Zeraze Strike Force"] }, { "battlefield_has": ["Arcane Signet"] }] }
  },
  {
    "name": "one copy for each commander cast from the command zone",
    "commander": true,
    "players": [
      {
        "command": ["Test Commander"],
        "hand": ["Hatut Zeraze Strike Force"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Plains", "Plains", "Plains", "Plains"]
      },
      { "battlefield": ["Arcane Signet"] }
    ],
    "steps": [
      { "cast": "Test Commander" },
      { "resolve": true },
      { "cast": "Hatut Zeraze Strike Force" },
      { "resolve": true, "targets": ["Arcane Signet"] }
    ],
    "expect": { "players": [{ "battlefield_has": ["Hatut Zeraze Strike Force", "Test Commander"] }, { "graveyard": ["Arcane Signet"] }] }
  }
]
