[
 {
  "name": "populate copies a creature token",
  "players": [
   {
    "hand": [
     "Raise the Alarm",
     "Wake the Reflections"
    ],
    "battlefield": [
     "Plains",
     "Plains",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Raise the Alarm"
   },
   {
    "resolve": true
   },
   {
    "cast": "Wake the Reflections"
   },
   {
    "resolve": true,
    "auto": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Soldier",
      "Soldier",
      "Soldier"
     ],
     "graveyard_has": [
      "Wake the Reflections",
      "Raise the Alarm"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "nothing happens with no creature token",
  "players": [
   {
    "hand": [
     "Wake the Reflections"
    ],
    "battlefield": [
     "Plains",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Wake the Reflections"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": [
      "Soldier"
     ],
     "graveyard_has": [
      "Wake the Reflections"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: populate copies a creature token the spell just created (Raise the Alarm, then Wake the Reflections)",
  "players": [
   {
    "hand": ["Raise the Alarm", "Wake the Reflections"],
    "battlefield": ["Plains", "Plains", "Plains"]
   },
   {}
  ],
  "steps": [
   { "cast": "Raise the Alarm" },
   { "resolve": true },
   { "cast": "Wake the Reflections" },
   { "resolve": true, "auto": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Soldier", "Soldier", "Soldier"], "graveyard_has": ["Wake the Reflections"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: with no creature token, populate does nothing (a non-token creature does not count)",
  "players": [
   {
    "hand": ["Wake the Reflections"],
    "battlefield": ["Plains", "Grizzly Bears", "Hill Giant"]
   },
   {}
  ],
  "steps": [
   { "cast": "Wake the Reflections" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Soldier"], "graveyard_has": ["Wake the Reflections"], "battlefield_has": ["Grizzly Bears", "Hill Giant"] },
    {}
   ]
  }
 }
]