[
  { "name": "enters: each opponent loses 1, you gain 1 and draw a card",
    "players": [ { "hand": ["Intimidation Campaign"], "battlefield": ["Island", "Swamp", "Plains"] }, { } ],
    "steps": [ { "cast": "Intimidation Campaign" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Intimidation Campaign"], "hand_count": 1, "life": 21 }, { "life": 19 } ] } },
  { "name": "crime (targeting an opponent's creature): may return it to hand",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Intimidation Campaign", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Intimidation Campaign"], "hand_count": 1, "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "crime: declining the optional return leaves it on the battlefield",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Intimidation Campaign", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Intimidation Campaign"], "hand_count": 0 }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "no crime (targeting only your own creature): nothing happens",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Intimidation Campaign", "Mountain", "Grizzly Bears"] }, { } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Intimidation Campaign"], "graveyard_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: the crime still counts when the spell fizzles, so the enchantment may return",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Intimidation Campaign", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Intimidation Campaign"], "hand_count": 1, "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] } }
]
