[
  {
    "name": "taps a target creature with power 3 or less",
    "players": [
      { "battlefield": ["Ephara's Warden"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Ephara's Warden", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Ephara's Warden": true }
    }
  },
  {
    "name": "cannot activate again while tapped",
    "players": [
      { "battlefield": ["Ephara's Warden", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "activate": "Ephara's Warden", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Ephara's Warden", "ability": 0, "targets": ["Hill Giant"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Hill Giant": true }
    }
  }
]
