[
  {
    "name": "another creature can attack the turn it comes in",
    "players": [
      { "battlefield": ["Frenzied Saddlebrute", { "name": "Grizzly Bears", "sick": true }] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Frenzied Saddlebrute", "Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "ruling: Saddlebrute gives no haste, a summoning-sick creature still can't use a tap ability",
    "players": [
      { "battlefield": ["Frenzied Saddlebrute", { "name": "Prodigal Sorcerer", "sick": true }] },
      {}
    ],
    "steps": [
      { "activate": "Prodigal Sorcerer", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Prodigal Sorcerer"] }, { "life": 20 }],
      "tapped": { "Prodigal Sorcerer": false }
    }
  },
  {
    "name": "without Saddlebrute a summoning-sick creature can't attack",
    "players": [
      { "battlefield": [{ "name": "Grizzly Bears", "sick": true }] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ], "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "a summoning-sick creature attacks the opponent and deals 2 damage",
    "players": [
      { "battlefield": ["Frenzied Saddlebrute", { "name": "Grizzly Bears", "sick": true }] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  }
]
