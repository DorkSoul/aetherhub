[
  {
    "name": "ruling: an opponent's blue spell still on the stack when Seedtime resolves counts as cast, so the extra turn is taken",
    "players": [
      { "hand": ["Lightning Bolt", "Seedtime"], "battlefield": ["Mountain", "Forest", "Forest"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "cast": "Seedtime" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "turn": 2,
      "players": [
        { "graveyard": ["Seedtime", "Lightning Bolt"] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "extra turn when an opponent cast a blue spell this turn",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Seedtime"
        ],
        "battlefield": [
          "Mountain",
          "Forest",
          "Forest"
        ]
      },
      {
        "hand": [
          "Counterspell"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Counterspell",
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Seedtime"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "turn": 2,
      "players": [
        {
          "graveyard": [
            "Seedtime",
            "Lightning Bolt"
          ]
        },
        {
          "graveyard": [
            "Counterspell"
          ]
        }
      ]
    }
  },
  {
    "name": "no extra turn without an opponent blue spell this turn",
    "players": [
      {
        "hand": [
          "Seedtime"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Seedtime"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "turn": 1,
      "players": [
        {
          "graveyard": [
            "Seedtime"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "cannot be cast on an opponent's turn",
    "players": [
      {
        "battlefield": [
          "Forest",
          "Forest"
        ]
      },
      {
        "hand": [
          "Seedtime"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Seedtime",
        "player": 1,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand": [
            "Seedtime"
          ]
        }
      ]
    }
  }
]
