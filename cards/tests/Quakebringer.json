[
 { "name": "upkeep trigger deals 2 damage to each opponent while on the battlefield",
   "players": [ { "battlefield": ["Quakebringer"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "upkeep trigger works from the graveyard when you control a Giant",
   "players": [ { "graveyard": ["Quakebringer"], "battlefield": ["Hill Giant"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "upkeep trigger does not work from the graveyard without a Giant",
   "players": [ { "graveyard": ["Quakebringer"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "opponents can't gain life",
   "players": [ { "battlefield": ["Quakebringer"] }, { "hand": ["Soothing Balm"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "pass": true }, { "cast": "Soothing Balm", "player": 1, "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "foretell from hand for {2} exiles it face down",
   "players": [ { "hand": ["Quakebringer"], "battlefield": ["Forest", "Forest"] }, {} ],
   "steps": [ { "activate": "Quakebringer", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Quakebringer"], "hand_count": 0 }, {} ] } },
 { "name": "foretold Quakebringer is cast for {2}{R}{R} on a later turn",
   "players": [ { "hand": ["Quakebringer"], "battlefield": ["Forest", "Forest", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Quakebringer", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" }, { "cast": "Quakebringer", "alt": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Quakebringer"] }, {} ] } },
 { "name": "foretold Quakebringer needs four mana: three lands cannot cast it",
   "players": [ { "hand": ["Quakebringer"], "battlefield": ["Forest", "Forest", "Mountain"] }, {} ],
   "steps": [ { "activate": "Quakebringer", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" }, { "cast": "Quakebringer", "alt": 0, "illegal": true } ],
   "expect": { "players": [ { "exile": ["Quakebringer"] }, {} ] } },
 { "name": "ruling: foretelling is a special action, so it can be taken in response to a spell",
   "players": [ { "hand": ["Quakebringer", "Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Quakebringer", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Quakebringer"], "graveyard_has": ["Lightning Bolt"] }, { "life": 17 } ] } },
 { "name": "ruling: a foretold creature cannot be cast on the turn it was foretold",
   "players": [ { "hand": ["Quakebringer"], "battlefield": ["Forest", "Forest", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Quakebringer", "ability": 0 }, { "resolve": true }, { "cast": "Quakebringer", "alt": 0, "illegal": true } ],
   "expect": { "players": [ { "exile": ["Quakebringer"] }, {} ] } }
]
