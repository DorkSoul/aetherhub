[
 {
  "name": "cohort taps an untapped Ally to draw and lose 1 life",
  "players": [
   { "battlefield": ["Malakir Soothsayer", "Akoum Battlesinger", "Swamp"] },
   {}
  ],
  "steps": [
   { "activate": "Malakir Soothsayer", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 19, "hand_count": 1, "battlefield_has": ["Malakir Soothsayer", "Akoum Battlesinger"] }, {} ]
  }
 },
 {
  "name": "needs another untapped Ally to pay the cost",
  "players": [
   { "battlefield": ["Malakir Soothsayer", "Grizzly Bears", "Swamp"] },
   {}
  ],
  "steps": [
   { "activate": "Malakir Soothsayer", "ability": 0, "illegal": true }
  ],
  "expect": {
   "players": [ { "life": 20, "hand_count": 0 }, {} ]
  }
 },
 {
  "name": "ruling: the tapped Ally may be summoning sick",
  "players": [ { "battlefield": ["Malakir Soothsayer", { "name": "Akoum Battlesinger", "sick": true }, "Swamp"] }, {} ],
  "steps": [ { "activate": "Malakir Soothsayer", "ability": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "life": 19, "hand_count": 1, "battlefield_has": ["Malakir Soothsayer", "Akoum Battlesinger"] }, {} ] }
 },
 {
  "name": "ruling: the Soothsayer itself must have been under your control since your last turn began",
  "players": [ { "battlefield": [ { "name": "Malakir Soothsayer", "sick": true }, "Akoum Battlesinger", "Swamp" ] }, {} ],
  "steps": [ { "activate": "Malakir Soothsayer", "ability": 0, "illegal": true } ],
  "expect": { "players": [ { "life": 20, "hand_count": 0 }, {} ] }
 }
]
