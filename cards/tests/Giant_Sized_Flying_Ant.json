[
  { "name": "tap mode taps the targeted nonland permanent",
    "players": [ { "hand": ["Giant-Sized Flying Ant"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Giant-Sized Flying Ant" },
      { "resolve": true, "answers": [0, "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } } },
  { "name": "untap mode untaps the targeted permanent",
    "players": [ { "hand": ["Giant-Sized Flying Ant"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [
      { "cast": "Giant-Sized Flying Ant" },
      { "resolve": true, "answers": [1, "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": false } } }
]
