[
 {
  "name": "blocking a non-Wall attacker destroys it at end of combat",
  "players": [
   {
    "battlefield": ["Grizzly Bears"]
   },
   {
    "battlefield": ["Thicket Basilisk"]
   }
  ],
  "steps": [
   {
    "attack": [{ "card": "Grizzly Bears", "at": "p1" }]
   },
   {
    "block": [{ "blocker": "Thicket Basilisk", "attacker": "Grizzly Bears" }]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Grizzly Bears"] },
    { "battlefield": ["Thicket Basilisk"], "life": 20 }
   ]
  }
 },
 {
  "name": "blocking a Wall does not destroy it",
  "players": [
   {
    "battlefield": ["Grizzly Bears"]
   },
   {
    "battlefield": ["Wall of Wood"]
   }
  ],
  "steps": [
   {
    "attack": [{ "card": "Grizzly Bears", "at": "p1" }]
   },
   {
    "block": [{ "blocker": "Wall of Wood", "attacker": "Grizzly Bears" }]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Grizzly Bears"] },
    { "battlefield": ["Wall of Wood"] }
   ]
  }
 },
 {
  "name": "a non-Wall blocker of this creature is destroyed at end of combat",
  "players": [
   {
    "battlefield": ["Thicket Basilisk"]
   },
   {
    "battlefield": ["Hill Giant"]
   }
  ],
  "steps": [
   {
    "attack": [{ "card": "Thicket Basilisk", "at": "p1" }]
   },
   {
    "block": [{ "blocker": "Hill Giant", "attacker": "Thicket Basilisk" }]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Thicket Basilisk"] },
    { "graveyard": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "ruling: one regeneration shield is used by combat damage, the end-of-combat destroy still kills the blocked creature",
  "players": [
   { "battlefield": [{ "name": "Drudge Skeletons", "sick": false }, "Swamp"] },
   { "battlefield": ["Thicket Basilisk"] }
  ],
  "steps": [
   { "attack": [{ "card": "Drudge Skeletons", "at": "p1" }] },
   { "block": [{ "blocker": "Thicket Basilisk", "attacker": "Drudge Skeletons" }] },
   { "activate": "Drudge Skeletons", "ability": 0 },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Drudge Skeletons"] },
    { "battlefield": ["Thicket Basilisk"], "life": 20 }
   ]
  }
 }
]
