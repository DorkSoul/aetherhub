[
  { "name": "beginning of combat switches two chosen creatures until end of turn",
    "players": [ { "battlefield": ["Inversion Behemoth", "Goblin Piker", "Giant Spider"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "targets": ["Goblin Piker", "Giant Spider"] }, { "resolve": true } ],
    "expect": { "pt": { "Goblin Piker": [1, 2], "Giant Spider": [4, 2], "Inversion Behemoth": [2, 9] } } },
  { "name": "the behemoth can switch itself",
    "players": [ { "battlefield": ["Inversion Behemoth"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "targets": ["Inversion Behemoth"] }, { "resolve": true } ],
    "expect": { "pt": { "Inversion Behemoth": [9, 2] } } },
  { "name": "choosing no targets switches nothing",
    "players": [ { "battlefield": ["Inversion Behemoth", "Goblin Piker"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" } ],
    "expect": { "pt": { "Goblin Piker": [2, 1], "Inversion Behemoth": [2, 9] } } },
  { "name": "ruling: the switch applies after a later +2/+0, so a 2/1 switched then pumped is 1/4",
    "players": [ { "hand": ["Rally the Peasants"], "battlefield": ["Inversion Behemoth", "Goblin Piker", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "targets": ["Goblin Piker"] }, { "resolve": true }, { "cast": "Rally the Peasants" }, { "resolve": true } ],
    "expect": { "pt": { "Goblin Piker": [1, 4], "Inversion Behemoth": [4, 9] } } },
  { "name": "ruling: damage stays marked, so switching a damaged creature can make it lethal",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Inversion Behemoth", "Giant Spider", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Giant Spider"] }, { "resolve": true }, { "advance_to": "BeginCombat", "targets": ["Giant Spider"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Giant Spider"], "battlefield_has": ["Inversion Behemoth"] }, {} ] } },
  { "name": "ruling: the same 3 damage does not kill the Giant Spider when nothing switches it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Inversion Behemoth", "Giant Spider", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Giant Spider"] }, { "resolve": true }, { "advance_to": "BeginCombat" } ],
    "expect": { "players": [ { "battlefield_has": ["Giant Spider"] }, {} ] } }
]
