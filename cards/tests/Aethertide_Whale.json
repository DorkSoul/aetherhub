[
  {
    "name": "enters: six energy",
    "players": [
      {
        "hand": [
          "Aethertide Whale"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Aethertide Whale"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "energy": 6
        }
      ]
    }
  },
  {
    "name": "pay four energy: return to hand",
    "players": [
      {
        "hand": [
          "Aethertide Whale"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Aethertide Whale"
      },
      {
        "resolve": true
      },
      {
        "activate": "Aethertide Whale"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "energy": 2,
          "hand": [
            "Aethertide Whale"
          ],
          "battlefield_lacks": [
            "Aethertide Whale"
          ]
        }
      ]
    }
  },
  {
    "name": "after one use, two energy is not enough",
    "players": [
      {
        "hand": [
          "Aethertide Whale"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Aethertide Whale"
      },
      {
        "resolve": true
      },
      {
        "activate": "Aethertide Whale"
      },
      {
        "resolve": true
      },
      {
        "play_land": "Island",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "energy": 2
        }
      ]
    }
  },
  {
    "name": "ruling: energy belongs to the player, so it stays after the Whale leaves and across the step",
    "players": [ { "battlefield": ["Aethertide Whale"], "energy": 6 }, {} ],
    "steps": [
      { "activate": "Aethertide Whale" },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "energy": 2, "hand": ["Aethertide Whale"], "battlefield_lacks": ["Aethertide Whale"] }, {} ] }
  },
  {
    "name": "ruling: energy counters do not go away at the end of the turn",
    "players": [ { "hand": ["Aethertide Whale"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Aethertide Whale" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": { "players": [ { "energy": 6, "battlefield_has": ["Aethertide Whale"] }, {} ] }
  },
  {
    "name": "ruling: you cannot pay more energy than you have (three energy cannot pay four)",
    "players": [ { "battlefield": ["Aethertide Whale"], "energy": 3 }, {} ],
    "steps": [
      { "activate": "Aethertide Whale", "illegal": true }
    ],
    "expect": { "players": [ { "energy": 3, "battlefield_has": ["Aethertide Whale"] }, {} ] }
  }
]