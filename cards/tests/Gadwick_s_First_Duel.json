    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "auto": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
