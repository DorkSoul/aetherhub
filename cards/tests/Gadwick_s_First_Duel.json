[
  {
    "name": "chapter I: Cursed Role on the chosen opposing creature (1/1)",
    "players": [
      { "hand": ["Gadwick's First Duel"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
