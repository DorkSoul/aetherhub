      "pt": { "Grizzly Bears": [1, 1] }
    }
  },
  {
    "name": "chapter I with no creature chosen: no Role token",
    "players": [
      { "hand": ["Gadwick's First Duel"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Gadwick's First Duel" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Gadwick's First Duel"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "chapter II (lore counter added in main phase): scry 2, bottom the Island",
    "players": [
      { "battlefield": ["Island", "Island", { "name": "Gadwick's First Duel", "counters": { "lore": 1 } }], "library": ["Forest", "Island", "Grizzly Bears", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
