      "counters": { "Gadwick's First Duel": { "lore": 2 } }
    }
  },
  {
    "name": "chapter III: the next instant or sorcery with mana value 3 or less is copied, once this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", { "name": "Gadwick's First Duel", "counters": { "lore": 2 } }] },
