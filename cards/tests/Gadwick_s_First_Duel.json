  {
    "name": "ruling: the copy can choose a new target (Bolt copy retargeted to Grizzly Bears; the original still hits the player)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", { "name": "Gadwick's First Duel", "counters": { "lore": 2 } }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": ["Grizzly Bears"] }
