[
  {
    "name": "leaving the battlefield gains its controller 2 life",
    "players": [ { "hand": ["Swords to Plowshares"], "battlefield": ["Plains"] }, { "life": 20, "battlefield": ["Tocasia's Onulet"] } ],
    "steps": [ { "cast": "Swords to Plowshares", "targets": ["Tocasia's Onulet"] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ {}, { "life": 26, "exile": ["Tocasia's Onulet"] } ]
    }
  },
  {
    "name": "unearth {3}{W}: returns with haste (battlefield) from graveyard",
    "players": [ { "graveyard": ["Tocasia's Onulet"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Tocasia's Onulet", "ability": 0 }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tocasia's Onulet"], "graveyard": [] }, {} ],
      "pt": { "Tocasia's Onulet": [4, 4] }
    }
  },
  {
    "name": "ruling: unearthed permanent is exiled at the beginning of the next end step",
    "players": [ { "graveyard": ["Tocasia's Onulet"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Tocasia's Onulet", "ability": 0 }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": {
      "players": [ { "exile": ["Tocasia's Onulet"] }, {} ]
    }
  },
  {
    "name": "ruling: unearthed permanent that would die is exiled instead",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "graveyard": ["Tocasia's Onulet"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Tocasia's Onulet", "ability": 0 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Tocasia's Onulet"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Tocasia's Onulet"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Tocasia's Onulet"] }, {} ]
    }
  },
  {
    "name": "ruling: unearth grants haste so the returned creature can attack",
    "players": [ { "graveyard": ["Tocasia's Onulet"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "activate": "Tocasia's Onulet", "ability": 0 },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Tocasia's Onulet", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    }
  }
]
