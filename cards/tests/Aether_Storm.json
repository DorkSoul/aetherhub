[
  { "name": "creature spells can't be cast by either player",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Aether Storm"] } ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] }
  },
  { "name": "non-creature spells can still be cast",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Aether Storm"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] }
  },
  { "name": "any player may pay 4 life to destroy it, without regeneration",
    "players": [ { "battlefield": ["Aether Storm"] }, {} ],
    "steps": [ { "pass": true }, { "activate": "Aether Storm", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Aether Storm"] }, { "life": 16 } ] }
  },
  { "name": "ruling: Aether Storm does not stop a creature put onto the battlefield by a spell (Reanimate)",
    "players": [ { "hand": ["Reanimate"], "battlefield": ["Swamp"], "graveyard": ["Grizzly Bears"] }, { "battlefield": ["Aether Storm"] } ],
    "steps": [ { "cast": "Reanimate", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 18, "battlefield_has": ["Grizzly Bears"] }, {} ] }
  },
  { "name": "ruling: Aether Storm stops artifact creature spells too (Ornithopter)",
    "players": [ { "hand": ["Ornithopter"] }, { "battlefield": ["Aether Storm"] } ],
    "steps": [ { "cast": "Ornithopter", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Ornithopter"] }, {} ] }
  }
]
