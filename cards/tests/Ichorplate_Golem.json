[
  {
    "name": "tapping an oil-less Scrapgorger gives it an oil counter, which Ichorplate turns into +1/+1",
    "players": [ { "battlefield": ["Ichorplate Golem", "Armored Scrapgorger"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [ { "tap_for_mana": "Armored Scrapgorger" }, { "resolve": true } ],
    "expect": { "pt": { "Armored Scrapgorger": [1, 4], "Ichorplate Golem": [2, 3] } }
  },
  {
    "name": "a creature entering without oil counters gets none",
    "players": [ { "hand": ["Savannah Lions"], "battlefield": ["Plains", "Ichorplate Golem"] }, {} ],
    "steps": [ { "cast": "Savannah Lions" }, { "resolve": true } ],
    "expect": { "pt": { "Savannah Lions": [2, 1] } }
  },
  {
    "name": "a creature you control entering with oil counters gets one more oil counter",
    "players": [ { "hand": ["Predation Steward"], "battlefield": ["Ichorplate Golem", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Predation Steward" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "counters": { "Predation Steward": { "oil": 3 } }, "pt": { "Predation Steward": [3, 3] } }
  },
  {
    "name": "an opponent's creature entering with oil counters does not trigger Ichorplate",
    "players": [ { "battlefield": ["Ichorplate Golem"] }, { "hand": ["Predation Steward"], "battlefield": ["Forest", "Forest"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "player": 1, "cast": "Predation Steward" }, { "resolve": true } ],
    "expect": { "counters": { "Predation Steward": { "oil": 2 } }, "pt": { "Predation Steward": [2, 2] } }
  },
  {
    "name": "ruling: a creature entering without oil counters never triggers Ichorplate",
    "players": [ { "hand": ["Savannah Lions"], "battlefield": ["Plains", "Ichorplate Golem"] }, {} ],
    "steps": [ { "cast": "Savannah Lions" }, { "resolve": true } ],
    "expect": { "counters": { "Savannah Lions": {} }, "pt": { "Savannah Lions": [2, 1] } }
  },
  {
    "name": "ruling: several oil counters on a creature still give only +1/+1",
    "players": [ { "hand": ["Predation Steward"], "battlefield": ["Ichorplate Golem", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Predation Steward" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "counters": { "Predation Steward": { "oil": 3 } }, "pt": { "Predation Steward": [3, 3] } }
  }
]
