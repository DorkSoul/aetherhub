[
  {
    "name": "sacrifice drains one life and gains one life",
    "players": [
      { "battlefield": ["Entropic Eidolon", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Entropic Eidolon", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "graveyard": ["Entropic Eidolon"] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "returns from the graveyard when you cast a multicolored spell",
    "players": [
      { "hand": ["Lightning Helix"], "battlefield": ["Entropic Eidolon", "Swamp", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Entropic Eidolon", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Helix", "targets": ["p1"] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Entropic Eidolon"], "graveyard": ["Lightning Helix"] },
        {}
      ]
    }
  },
  {
    "name": "does not return for a monocolored spell",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Entropic Eidolon", "Swamp", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Entropic Eidolon", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Entropic Eidolon", "Lightning Bolt"] },
        {}
      ]
    }
  }
]
