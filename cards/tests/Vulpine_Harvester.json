        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Vulpine Harvester",
            "at": "p1"
          }
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "Vulpine Harvester"
        ]
      },
