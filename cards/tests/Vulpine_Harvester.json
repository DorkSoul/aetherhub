  {
    "name": "ruling: power is checked on resolution (a pump in response returns a MV 4 artifact)",
    "players": [
      {
        "hand": [
          "Fury Charm"
        ],
        "battlefield": [
          "Vulpine Harvester",
          "Mountain",
          "Mountain"
        ],
        "graveyard": [
          "Thran Dynamo"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Vulpine Harvester",
            "at": "p1"
          }
        ]
      },
      {
        "cast": "Fury Charm",
        "answers": [
          1
        ],
        "targets": [
          "Vulpine Harvester"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Vulpine Harvester",
            "Thran Dynamo"
          ],
          "graveyard": [
            "Fury Charm"
          ]
        },
        {}
      ],
      "pt": {
        "Vulpine Harvester": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: an attacking Phyrexian removed in response still counts its last-known power",
    "players": [
      {
        "battlefield": [
          "Vulpine Harvester"
        ],
        "graveyard": [
          "Sword of Fire and Ice"
        ]
      },
      {
