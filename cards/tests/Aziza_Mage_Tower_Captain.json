  {
    "name": "ruling: the copy keeps the X of the original (Blaze X=2 is copied as 2 damage)",
    "players": [
      {
        "hand": ["Blaze"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Aziza, Mage Tower Captain", "Grizzly Bears", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Blaze", "targets": ["p1"], "answers": [2] },
      { "resolve": true, "answers": [true] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Blaze"] }, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: the copy's new target is chosen: the copy hits Hill Giant instead of the player",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Aziza, Mage Tower Captain", "Grizzly Bears", "Grizzly Bears"]
      },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": [true, "Hill Giant"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "graveyard_has": ["Hill Giant"] } ]
    }
  },
  {
    "name": "ruling: the copy is not cast, so Aziza does not trigger again for it",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Aziza, Mage Tower Captain", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"]
