      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 14 } ],
      "stack_empty": true
    }
  }
