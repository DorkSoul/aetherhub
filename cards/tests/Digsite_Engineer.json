  "steps": [{"cast": "Dimir Signet"}, {"resolve": true, "answers": [false]}, {"resolve": true}],
  "expect": {"players": [{"battlefield_has": ["Dimir Signet"], "battlefield_lacks": ["Construct"]}, {}]}},
