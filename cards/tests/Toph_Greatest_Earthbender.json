[
  { "name": "ETB earthbends X where X is the mana spent (4): target land becomes a 4/4 with double strike",
    "players": [ { "hand": ["Toph, Greatest Earthbender"], "battlefield": ["Mountain", "Forest", "Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Toph, Greatest Earthbender" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, Greatest Earthbender", "Plains"] }, {} ], "pt": { "Plains": [4, 4] }, "counters": { "Plains": { "p1p1": 4 } }, "keywords": { "Plains": ["DoubleStrike"] } } },
  { "name": "earthbent land stays a 4/4 creature after Toph leaves the battlefield",
    "players": [ { "hand": ["Toph, Greatest Earthbender", "Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest", "Plains", "Mountain"] }, {} ],
    "steps": [ { "cast": "Toph, Greatest Earthbender" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Toph, Greatest Earthbender"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Plains"], "graveyard": ["Toph, Greatest Earthbender", "Lightning Bolt"] }, {} ], "pt": { "Plains": [4, 4] } } },
  { "name": "ruling: an earthbent land keeps its mana ability, so it can pay for a W spell",
    "players": [ { "hand": ["Toph, Greatest Earthbender", "Swords to Plowshares"], "battlefield": ["Mountain", "Forest", "Island", "Island", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Toph, Greatest Earthbender" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Swords to Plowshares", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, Greatest Earthbender", "Plains"] }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a land that is already a creature can be earthbent again, getting more counters",
    "players": [ { "hand": ["Toph, Greatest Earthbender", "Badgermole Cub"], "battlefield": ["Mountain", "Forest", "Forest", "Plains", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Toph, Greatest Earthbender" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, Greatest Earthbender", "Badgermole Cub", "Plains"] }, {} ], "pt": { "Plains": [5, 5] }, "counters": { "Plains": { "p1p1": 5 } } } },
  { "name": "ruling: a land animated by earthbend that dies returns to the battlefield tapped",
    "players": [ { "hand": ["Badgermole Cub", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Badgermole Cub", "Plains"], "graveyard": ["Lightning Bolt"] }, {} ], "tapped": { "Plains": true } } },
  { "name": "ruling: a land animated by earthbend that is bounced to hand does not return to the battlefield",
    "players": [ { "hand": ["Badgermole Cub", "Unsummon"], "battlefield": ["Forest", "Plains", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Unsummon", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Badgermole Cub"], "battlefield_lacks": ["Plains"], "hand": ["Plains"] }, {} ] } }
]
