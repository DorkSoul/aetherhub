[
  { "name": "anthem: other Zombie and snow creatures you control get +1/+1, others do not",
    "players": [ { "battlefield": ["Narfi, Betrayer King", "Abattoir Ghoul", "Alpine Guide", "Grizzly Bears"] }, {} ],
    "steps": [ { "pass": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Narfi, Betrayer King": [4, 3], "Abattoir Ghoul": [4, 3], "Alpine Guide": [4, 4], "Grizzly Bears": [2, 2] } } },
  { "name": "snow mana: SSS returns it from the graveyard tapped",
    "players": [ { "graveyard": ["Narfi, Betrayer King"], "battlefield": ["Snow-Covered Swamp", "Snow-Covered Island", "Snow-Covered Forest"] }, {} ],
    "steps": [ { "activate": "Narfi, Betrayer King", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Narfi, Betrayer King"] }, {} ], "tapped": { "Narfi, Betrayer King": true } } },
  { "name": "non-snow lands cannot pay SSS",
    "players": [ { "graveyard": ["Narfi, Betrayer King"], "battlefield": ["Swamp", "Island", "Forest"] }, {} ],
    "steps": [ { "activate": "Narfi, Betrayer King", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Narfi, Betrayer King"] }, {} ] } },
  { "name": "ruling: {S} can be paid by one colourless mana from a snow source (Snow-Covered Wastes)",
    "players": [ { "graveyard": ["Narfi, Betrayer King"], "battlefield": ["Snow-Covered Wastes", "Snow-Covered Wastes", "Snow-Covered Wastes"] }, {} ],
    "steps": [ { "activate": "Narfi, Betrayer King", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Narfi, Betrayer King"] }, {} ], "tapped": { "Narfi, Betrayer King": true } } },
  { "name": "ruling: another snow Zombie gets only +1/+1 from Narfi, not +2/+2",
    "players": [ { "battlefield": ["Narfi, Betrayer King", "Draugr Necromancer"] }, {} ],
    "steps": [ { "pass": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Draugr Necromancer": [5, 5], "Narfi, Betrayer King": [4, 3] } } }
]
