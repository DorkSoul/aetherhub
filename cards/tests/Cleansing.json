   "steps": [ { "cast": "Cleansing" },
              { "resolve": true, "answers": [true, false, false, false, false, false, false] } ],
   "expect": { "players": [ { "life": 19, "graveyard_has": ["Cleansing"] }, { "life": 20 } ] } },
