 {
  "name": "when the enchanted land dies it returns to its owner's hand",
  "players": [
   {
    "hand": [
     "Vastwood Zendikon"
    ],
    "battlefield": [
     "Forest",
     "Forest",
     "Forest",
     "Forest",
     "Island"
    ]
   },
   {
    "hand": [
     "Murder"
    ],
    "battlefield": [
     "Swamp",
     "Swamp",
     "Swamp"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Vastwood Zendikon",
    "targets": [
     "Island"
    ]
   },
   {
    "resolve": true
   },
   {
    "pass": true
   },
   {
    "cast": "Murder",
    "player": 1,
    "targets": [
     "Island"
    ]
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Island"
     ],
     "graveyard": [
      "Vastwood Zendikon"
     ]
    },
    {
     "graveyard": [
      "Murder"
     ]
    }
   ]
  }
 },
 {
  "name": "enchanted Island is green",
  "players": [ { "hand": ["Vastwood Zendikon"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Island"] }, {} ],
  "steps": [ { "cast": "Vastwood Zendikon", "targets": ["Island"] }, { "resolve": true } ],
  "expect": { "colors": { "Island": ["G"] } }
 },
 {
  "name": "ruling: a pump applied after the Zendikon still applies to the 6/4",
  "players": [ { "hand": ["Vastwood Zendikon", "Thunder Strike"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Island", "Mountain", "Mountain"] }, {} ],
  "steps": [ { "cast": "Vastwood Zendikon", "targets": ["Island"] }, { "resolve": true }, { "cast": "Thunder Strike", "targets": ["Island"] }, { "resolve": true } ],
  "expect": { "pt": { "Island": [8, 4] } } },
 {
  "name": "ruling: the land becoming a creature is not a creature entering (Soul Warden does not trigger)",
  "players": [ { "hand": ["Vastwood Zendikon"], "battlefield": ["Soul Warden", "Forest", "Forest", "Forest", "Forest", "Island"] }, {} ],
  "steps": [ { "cast": "Vastwood Zendikon", "targets": ["Island"] }, { "resolve": true } ],
  "expect": { "players": [ { "life": 20 }, {} ] } }
]
