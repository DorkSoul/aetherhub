[
  { "name": "must attack each combat if able (declaring no attack is illegal)",
    "players": [ { "battlefield": ["Relentless Raptor"] }, { "battlefield": [] } ],
    "steps": [ { "attack": [], "illegal": true }, { "attack": [ { "card": "Relentless Raptor", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "must attack: declaring only the Bears still sends the Raptor too (5 damage)",
    "players": [ { "battlefield": ["Relentless Raptor", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "must block if able: declaring no block still has the Raptor block the Giant (both die)",
    "players": [ { "battlefield": ["Relentless Raptor"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Hill Giant", "at": "p0" } ] }, { "block": [], "player": 0 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "battlefield_lacks": ["Relentless Raptor"] }, { "battlefield_lacks": ["Hill Giant"] } ] } },
  { "name": "ruling: a Raptor controlled by the defending player must still block if able (Control Magic on the opponent's turn; Giant attacks, Raptor blocks, both die)",
    "players": [ { "battlefield": ["Relentless Raptor", "Hill Giant"] }, { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"], "life": 20 } ],
    "steps": [
      { "attack": [ { "card": "Relentless Raptor", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Relentless Raptor"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Relentless Raptor", "Hill Giant"] }, { "life": 17 } ] } }
]
