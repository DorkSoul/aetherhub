[
  { "name": "ruling: raising the stolen creature's power does not end the control change",
    "players": [ { "hand": ["Exert Influence"], "battlefield": ["Brine Shaman", "Island", "Island", "Island", "Island", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Exert Influence", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Brine Shaman", "ability": 0, "targets": ["Grizzly Bears"], "answers": ["Brine Shaman"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4] }, "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "two colors spent: a 2-power creature is stolen",
    "players": [ { "hand": ["Exert Influence"], "battlefield": ["Island", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Exert Influence", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { } ] } },
  { "name": "one color spent: a 4-power creature is not stolen",
    "players": [ { "hand": ["Exert Influence"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Exert Influence", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "five colors spent: power equal to the color count is stolen",
    "players": [ { "hand": ["Exert Influence"], "battlefield": ["Island", "Plains", "Swamp", "Mountain", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Exert Influence", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { } ] } }
]
