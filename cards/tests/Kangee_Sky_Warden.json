[
  { "name": "attacking creatures with flying get +2/+0",
    "players": [ { "battlefield": ["Kangee, Sky Warden", "Serra Angel"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Kangee, Sky Warden", "at": "p1" }, { "card": "Serra Angel", "at": "p1" } ] },
      { "resolve": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Kangee, Sky Warden": [5, 3], "Serra Angel": [6, 4] } } },
  { "name": "non-flying attackers are not pumped",
    "players": [ { "battlefield": ["Kangee, Sky Warden", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Kangee, Sky Warden", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Kangee, Sky Warden": [5, 3], "Grizzly Bears": [2, 2] } } },
  { "name": "blocking: Kangee blocks, blocking creatures with flying get +0/+2 (non-flying blockers not pumped)",
    "players": [ { "battlefield": ["Kangee, Sky Warden", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Kangee, Sky Warden", "attacker": "Grizzly Bears" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Kangee, Sky Warden": [3, 5], "Hill Giant": [3, 3] } } },
  { "name": "blocking: a lone Kangee block still pumps Kangee's own flying blocking status to +0/+2",
    "players": [ { "battlefield": ["Kangee, Sky Warden"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Kangee, Sky Warden", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Kangee, Sky Warden": [3, 5] } } },
  { "name": "ruling: a creature that gains flying in response to the attack trigger gets the +2/+0 when the trigger resolves",
    "players": [ { "hand": ["Feather of Flight"], "battlefield": ["Kangee, Sky Warden", "Grizzly Bears", "Plains", "Island"], "library": ["Island"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Kangee, Sky Warden", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "cast": "Feather of Flight", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Grizzly Bears": [5, 2] } } },
  { "name": "ruling: flying gained after the attack trigger resolved does not add the +2/+0 bonus",
    "players": [ { "hand": ["Feather of Flight"], "battlefield": ["Kangee, Sky Warden", "Grizzly Bears", "Plains", "Island"], "library": ["Island"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Kangee, Sky Warden", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "cast": "Feather of Flight", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Grizzly Bears": [3, 2] } } }
]
