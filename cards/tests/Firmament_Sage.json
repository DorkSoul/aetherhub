[
  {
    "name": "entering makes it day, and neither-to-day does not draw",
    "players": [
      { "hand": ["Firmament Sage"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Firmament Sage" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 0, "battlefield_has": ["Firmament Sage"] }, {}]
    }
  },
  {
    "name": "day becoming night draws a card",
    "players": [
      { "hand": ["Firmament Sage"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Firmament Sage" },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Island"], "battlefield_has": ["Firmament Sage"] }, {}],
      "turn": 3
    }
  },
  {
    "name": "ruling: day stays day when the previous active player cast a spell (no draw)",
    "players": [
      { "hand": ["Firmament Sage"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Firmament Sage" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{ "hand_count": 0, "battlefield_has": ["Firmament Sage"] }, {}],
      "turn": 2
    }
  },
  {
    "name": "ruling: night becomes day after the previous active player cast two spells (draw on each change)",
    "players": [
      { "hand": ["Firmament Sage", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Firmament Sage" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{ "hand_count": 3, "battlefield_has": ["Firmament Sage"] }, { "graveyard": ["Grizzly Bears", "Hill Giant"] }],
      "turn": 4
    }
  }
]
