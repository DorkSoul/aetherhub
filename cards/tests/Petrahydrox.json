[
 {
  "name": "targeted by a spell: returns to its owner's hand, spell fizzles",
  "players": [ { "hand": ["Shock"], "battlefield": ["Mountain"] }, { "battlefield": ["Petrahydrox"] } ],
  "steps": [ { "cast": "Shock", "targets": ["Petrahydrox"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Shock"] }, { "hand": ["Petrahydrox"], "battlefield_lacks": ["Petrahydrox"], "life": 20 } ] }
 },
 {
  "name": "a spell targeting the player does not bounce it",
  "players": [ { "hand": ["Shock"], "battlefield": ["Mountain"] }, { "battlefield": ["Petrahydrox"] } ],
  "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ {}, { "battlefield_has": ["Petrahydrox"], "life": 18 } ] }
 },
 {
  "name": "ruling: the bounce trigger resolves before the spell, so Lightning Bolt fizzles and Petrahydrox is not killed",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Petrahydrox"] } ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Petrahydrox"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "hand": ["Petrahydrox"], "battlefield_lacks": ["Petrahydrox"], "graveyard": [], "life": 20 } ] }
 },
 {
  "name": "ruling: the bounce still happens when the spell that targeted Petrahydrox is countered",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Petrahydrox"] } ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Petrahydrox"] }, { "pass": true }, { "cast": "Counterspell", "player": 1 }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "hand": ["Petrahydrox"], "battlefield_lacks": ["Petrahydrox"], "graveyard": ["Counterspell"] } ] }
 }
]
