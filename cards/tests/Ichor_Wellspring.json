[
  {
    "name": "draws when it enters",
    "players": [
      {
        "hand": [
          "Ichor Wellspring"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Ichor Wellspring"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "battlefield_has": [
            "Ichor Wellspring"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "draws when destroyed",
    "players": [
      {
        "battlefield": [
          "Ichor Wellspring"
        ]
      },
      {
        "hand": [
          "Nature's Claim"
        ],
        "battlefield": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Nature's Claim",
        "targets": [
          "Ichor Wellspring"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "graveyard": [
            "Ichor Wellspring"
          ],
          "life": 24
        },
        {
          "graveyard": [
            "Nature's Claim"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: destroyed while its enter trigger is still on the stack, it still draws when put into the graveyard",
    "players": [
      { "hand": ["Ichor Wellspring"], "battlefield": ["Island", "Island"], "library": ["Island", "Island"] },
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "cast": "Ichor Wellspring" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Ichor Wellspring"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Island", "Island"], "graveyard": ["Ichor Wellspring"] },
        { "graveyard": ["Disenchant"] }
      ]
    }
  }
]