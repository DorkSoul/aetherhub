[
  {
    "name": "blocking puts a +1/+1 counter on it",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Spincrusher"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Spincrusher", "attacker": "Grizzly Bears" }] },
      { "resolve": true },
      { "advance_to": "CombatDamage" }
    ],
    "expect": {
      "counters": { "Spincrusher": { "p1p1": 1 } },
      "pt": { "Spincrusher": [1, 3] }
    }
  },
  {
    "name": "remove a counter: can't be blocked this turn",
    "players": [
      { "battlefield": [{ "name": "Spincrusher", "counters": { "p1p1": 1 } }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Spincrusher", "ability": 0 },
      { "resolve": true },
      { "attack": [{ "card": "Spincrusher", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Spincrusher" }], "illegal": true },
      { "advance_to": "CombatDamage" }
    ],
    "expect": {
      "counters": { "Spincrusher": { "p1p1": 0 } },
      "players": [{}, { "life": 20 }]
    }
  }
]
