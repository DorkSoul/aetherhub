[
  {
    "name": "dies: token is X/X where X counts creature cards in your graveyard",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Seed Guardian"], "graveyard": ["Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Murder", "targets": ["Seed Guardian"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Elemental 0-0 G": [3, 3] },
      "players": [
        { "battlefield_has": ["Elemental 0-0 G"], "graveyard": ["Grizzly Bears", "Hill Giant", "Murder", "Seed Guardian"] },
        {}
      ]
    }
  },
  {
    "name": "dies with no other creature cards: a 1/1 token (itself counts)",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Seed Guardian"] },
      {}
    ],
    "steps": [
      { "cast": "Murder", "targets": ["Seed Guardian"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Elemental 0-0 G": [1, 1] },
      "players": [
        { "battlefield_has": ["Elemental 0-0 G"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: X is counted as the ability resolves (Seed Guardian included), and noncreature cards in the graveyard are not counted",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Seed Guardian"], "graveyard": ["Grizzly Bears", "Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "cast": "Murder", "targets": ["Seed Guardian"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Elemental 0-0 G": [2, 2] },
      "players": [
        { "battlefield_has": ["Elemental 0-0 G"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Elemental's P/T is set when created; creature cards added to the graveyard later do not change it",
    "players": [
      { "hand": ["Murder", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Seed Guardian", "Mountain"], "graveyard": ["Grizzly Bears", "Hill Giant"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Murder", "targets": ["Seed Guardian"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Elemental 0-0 G": [3, 3] },
      "players": [
        { "battlefield_has": ["Elemental 0-0 G"] },
        { "graveyard": ["Llanowar Elves"] }
      ]
    }
  }
]
