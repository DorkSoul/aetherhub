[
 { "name": "beginning of combat: target creature gets +2/+0 and firebending 2; its attack adds RR until end of combat",
   "players": [ { "battlefield": ["Fire Nation Turret", "Grizzly Bears"] }, {} ],
   "steps": [
     { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] }, { "resolve": true },
     { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true },
     { "advance_to": "EndCombat" } ],
   "expect": { "pt": { "Grizzly Bears": [4, 2] }, "players": [ { "pool": { "R": 2 } }, { "life": 16 } ] } },
 { "name": "firebending from the turret ends with the turn: no mana on a later attack",
   "players": [ { "battlefield": ["Fire Nation Turret", "Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "Main2" } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ { "pool": {} }, {} ] } },
 { "name": "{R}: adds a charge counter; without a red source it is illegal",
   "players": [ { "battlefield": ["Fire Nation Turret", "Swamp"] }, {} ],
   "steps": [ { "activate": "Fire Nation Turret", "ability": 0, "illegal": true } ],
   "expect": { "players": [ {}, {} ] } },
 { "name": "{R}: puts a charge counter on the turret",
   "players": [ { "battlefield": ["Fire Nation Turret", "Mountain"] }, {} ],
   "steps": [ { "activate": "Fire Nation Turret", "ability": 0 }, { "resolve": true } ],
   "expect": { "counters": { "Fire Nation Turret": { "charge": 1 } }, "players": [ { "battlefield_has": ["Fire Nation Turret"] }, {} ] } },
 { "name": "removing fifty charge counters: 50 damage to any target kills the targeted creature",
   "players": [ { "battlefield": [ { "name": "Fire Nation Turret", "counters": { "charge": 50 } }, "Mountain" ] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Fire Nation Turret", "ability": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Fire Nation Turret"] }, { "graveyard": ["Grizzly Bears"], "life": 20 } ] } },
 { "name": "with only 49 charge counters the 50-damage ability is illegal",
   "players": [ { "battlefield": [ { "name": "Fire Nation Turret", "counters": { "charge": 49 } }, "Swamp" ] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Fire Nation Turret", "ability": 1, "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Fire Nation Turret"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: firebending mana can still be spent after combat damage, until leaving combat",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fire Nation Turret", "Grizzly Bears"] }, {} ],
   "steps": [
     { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] }, { "resolve": true },
     { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true },
     { "advance_to": "EndCombat" },
     { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "pool": { "R": 1 }, "hand_count": 0 }, { "life": 13 } ] } },
 { "name": "ruling: each firebending instance triggers separately and adds its own mana",
   "players": [ { "battlefield": ["Fire Nation Turret", "Fire Nation Turret", "Grizzly Bears"] }, {} ],
   "steps": [
     { "advance_to": "BeginCombat", "targets": ["Grizzly Bears", "Grizzly Bears"] }, { "resolve": true },
     { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true },
     { "advance_to": "EndCombat" } ],
   "expect": { "pt": { "Grizzly Bears": [6, 2] }, "players": [ { "pool": { "R": 4 } }, { "life": 14 } ] } },
 { "name": "ruling: mana from other sources empties when moving between combat steps",
   "players": [ { "battlefield": ["Mountain", "Grizzly Bears"] }, {} ],
   "steps": [
