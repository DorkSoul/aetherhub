[
  {
    "name": "no spells last turn: transforms at upkeep into a 4/4 Butcher",
    "players": [
      {
        "battlefield": [
          {
            "name": "Lambholt Pacifist",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "pt": {
        "Lambholt Butcher": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "with a 4-power creature it can attack",
    "players": [
      {
        "battlefield": [
          {
            "name": "Lambholt Pacifist",
            "sick": false
          },
          {
            "name": "Serra Angel",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Lambholt Pacifist",
            "at": "p1"
          },
          {
            "card": "Serra Angel",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 13
        }
      ]
    }
  },
  {
    "name": "two spells last turn: Lambholt Butcher transforms back to Lambholt Pacifist at upkeep",
    "players": [ { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Lambholt Butcher", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Lambholt Pacifist": [3, 3] } }
  },
  {
    "name": "one spell last turn: Lambholt Butcher stays a 4/4",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lambholt Butcher", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "pt": { "Lambholt Butcher": [4, 4] } }
  },
  {
    "name": "cannot attack without a creature of power 4 or greater: only Grizzly Bears deals damage",
    "players": [
      { "battlefield": [{ "name": "Lambholt Pacifist", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Lambholt Pacifist", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "with a power 4 creature under our control, Lambholt Pacifist attacks too",
    "players": [
      { "battlefield": [{ "name": "Lambholt Pacifist", "sick": false }, { "name": "Craw Wurm", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Lambholt Pacifist", "at": "p1" }, { "card": "Craw Wurm", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 11 } ] }
  }
]
