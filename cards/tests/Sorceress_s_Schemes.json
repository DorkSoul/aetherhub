[
  {"name": "returns an instant from your graveyard to hand and adds {R}",
   "players": [{"hand": ["Sorceress's Schemes"], "graveyard": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Sorceress's Schemes"}, {"resolve": true}],
   "expect": {"players": [{"hand": ["Lightning Bolt"], "graveyard": ["Sorceress's Schemes"], "pool": {"R": 1}}, {}]}},
  {"name": "returns an exiled card with flashback you own to hand",
   "players": [{"hand": ["Sorceress's Schemes"], "exile": ["Bestial Incursion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Sorceress's Schemes"}, {"resolve": true}],
   "expect": {"players": [{"hand": ["Bestial Incursion"], "exile": [], "graveyard": ["Sorceress's Schemes"], "pool": {"R": 1}}, {}]}},
  {"name": "an exiled card without flashback is not a legal target",
   "players": [{"hand": ["Sorceress's Schemes"], "exile": ["Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Sorceress's Schemes", "illegal": true}],
   "expect": {"players": [{"hand": ["Sorceress's Schemes"], "exile": ["Grizzly Bears"]}, {}]}},
  {"name": "an opponent's graveyard is not a legal target",
   "players": [{"hand": ["Sorceress's Schemes"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]}, {"graveyard": ["Lightning Bolt"]}],
   "steps": [{"cast": "Sorceress's Schemes", "illegal": true}],
   "expect": {"players": [{"hand": ["Sorceress's Schemes"]}, {"graveyard": ["Lightning Bolt"]}]}},
  {"name": "flashback for {4}{R} from the graveyard, then it is exiled",
   "players": [{"graveyard": ["Sorceress's Schemes", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Sorceress's Schemes", "alt": 0}, {"resolve": true}],
   "expect": {"players": [{"hand": ["Lightning Bolt"], "exile": ["Sorceress's Schemes"], "pool": {"R": 1}}, {}]}},
  {"name": "ruling: flashback whose target is gone when it resolves fizzles and is still exiled",
   "players": [{"hand": ["Cremate"], "graveyard": ["Sorceress's Schemes", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Swamp"]}, {}],
   "steps": [{"cast": "Sorceress's Schemes", "alt": 0, "targets": ["Lightning Bolt"]}, {"cast": "Cremate", "targets": ["Lightning Bolt"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 1, "graveyard": ["Cremate"], "exile": ["Lightning Bolt", "Sorceress's Schemes"]}, {}]}},
  {"name": "ruling: a sorcery's flashback cannot be cast while another spell is on the stack",
   "players": [{"hand": ["Lightning Bolt"], "graveyard": ["Sorceress's Schemes"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"cast": "Sorceress's Schemes", "alt": 0, "illegal": true}],
   "expect": {"players": [{"hand": [], "graveyard": ["Sorceress's Schemes"]}, {"life": 20}]}}
]
