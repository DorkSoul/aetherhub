[
  {
    "name": "ETB returns an instant with cycling from the graveyard, not one without",
    "players": [
      { "hand": ["Spellpyre Phoenix"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Gallant Strike", "Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "cast": "Spellpyre Phoenix" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [
      { "battlefield_has": ["Spellpyre Phoenix"], "hand": ["Gallant Strike"], "graveyard": ["Lightning Bolt"] },
      {}
    ] }
  },
  {
    "name": "two cards cycled this turn: Phoenix returns from the graveyard at the end step",
    "players": [
      { "hand": ["Street Wraith", "Lonely Sandbar"], "battlefield": ["Island"], "graveyard": ["Spellpyre Phoenix"], "library": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Street Wraith" },
      { "resolve": true },
      { "activate": "Lonely Sandbar" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "hand": ["Forest", "Forest", "Spellpyre Phoenix"], "graveyard": ["Street Wraith", "Lonely Sandbar"] },
      {}
    ] }
  },
  {
    "name": "only one card cycled: Phoenix stays in the graveyard",
    "players": [
      { "hand": ["Street Wraith"], "graveyard": ["Spellpyre Phoenix"] },
      {}
    ],
    "steps": [
      { "activate": "Street Wraith" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [
      { "graveyard": ["Spellpyre Phoenix", "Street Wraith"], "hand_count": 1 },
      {}
    ] }
  },
  {
    "name": "ruling: cards cycled before Phoenix went to the graveyard still count at the end step",
    "players": [
      { "hand": ["Street Wraith", "Lonely Sandbar", "Lightning Bolt"], "battlefield": ["Spellpyre Phoenix", "Island", "Mountain"], "library": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Street Wraith" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Spellpyre Phoenix"] },
      { "resolve": true },
      { "activate": "Lonely Sandbar" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "hand": ["Forest", "Forest", "Spellpyre Phoenix"], "graveyard_has": ["Street Wraith", "Lightning Bolt", "Lonely Sandbar"] },
      {}
    ] }
  }
]
