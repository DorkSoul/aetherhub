[
 {
  "name": "an opponent gains control as it enters",
  "players": [
   { "hand": ["Akroan Horse"], "battlefield": ["Island","Island","Island","Island"] },
   {}
  ],
  "steps": [
   { "cast": "Akroan Horse" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_lacks": ["Akroan Horse"] }, { "battlefield_has": ["Akroan Horse"] } ]
  }
 },
 {
  "name": "its new controller's upkeep gives each opponent (the caster) a Soldier",
  "players": [
   { "hand": ["Akroan Horse"], "battlefield": ["Island","Island","Island","Island"] },
   {}
  ],
  "steps": [
   { "cast": "Akroan Horse" },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Upkeep" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Soldier 1-1 White"] }, { "battlefield_has": ["Akroan Horse"], "battlefield_lacks": ["Soldier 1-1 White"] } ]
  }
 },
 {
  "name": "no Soldier for the caster during their own upkeep before the Horse ETB (controller is opponent)",
  "players": [
   { "hand": ["Akroan Horse"], "battlefield": ["Island","Island","Island","Island"] },
   {}
  ],
  "steps": [
   { "cast": "Akroan Horse" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_lacks": ["Soldier 1-1 White"] }, { "battlefield_lacks": ["Soldier 1-1 White"] } ]
  }
 },
 {
  "name": "ruling: the ETB does not target, so an opponent with hexproof still gains control of the Horse",
  "players": [
   { "hand": ["Akroan Horse"], "battlefield": ["Island","Island","Island","Island"] },
   { "battlefield": ["Leyline of Sanctity"] }
  ],
  "steps": [
   { "cast": "Akroan Horse" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_lacks": ["Akroan Horse"] }, { "battlefield_has": ["Akroan Horse", "Leyline of Sanctity"] } ]
  }
 }
]
