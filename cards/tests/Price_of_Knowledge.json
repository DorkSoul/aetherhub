[
 {
  "name": "opponent's upkeep: damage equal to cards in their hand",
  "players": [
   { "battlefield": ["Price of Knowledge"] },
   { "hand": ["Forest", "Forest", "Forest"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 17 }
   ]
  }
 },
 {
  "name": "opponent with an empty hand takes no damage",
  "players": [
   { "battlefield": ["Price of Knowledge"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": {
   "players": [
    {},
    { "life": 20 }
   ]
  }
 },
 {
  "name": "players have no maximum hand size: 8 cards stay in hand at cleanup",
  "players": [
   { "hand": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "battlefield": ["Price of Knowledge"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep", "auto": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 8 },
    { "life": 20 }
   ]
  }
 },
 {
  "name": "ruling: hand size is counted when the upkeep trigger resolves",
  "players": [
   { "battlefield": ["Price of Knowledge"] },
   { "hand": ["Lightning Bolt", "Forest", "Forest", "Forest"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "advance_to": "Upkeep", "hold": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 17 },
    { "life": 17, "hand_count": 3 }
   ]
  }
 }
]
