 {
  "name": "a power 2+ creature cannot block it even though a power 1 creature could (damage goes through)",
  "players": [
   { "battlefield": [ { "name": "Azure Beastbinder", "sick": false }, "Hill Giant" ] },
   { "battlefield": ["Serra Angel", "Mind Stone", "Llanowar Elves"] }
  ],
  "steps": [
   { "attack": [ { "card": "Azure Beastbinder", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
   { "resolve": true, "targets": ["Mind Stone"] },
   { "block": [ { "blocker": "Serra Angel", "attacker": "Azure Beastbinder" }, { "blocker": "Llanowar Elves", "attacker": "Hill Giant" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 19, "battlefield_has": ["Serra Angel"] } ] }
 },
 {
  "name": "ruling: a creature that lost its abilities regains them when the effect ends",
  "players": [
   { "battlefield": [ { "name": "Azure Beastbinder", "sick": false } ] },
   { "battlefield": [ { "name": "Walking Ballista", "counters": { "p1p1": 2 } } ] }
  ],
  "steps": [
   { "attack": [ { "card": "Azure Beastbinder", "at": "p1" } ] },
   { "resolve": true, "targets": ["Walking Ballista"] },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "pass": true },
   { "activate": "Walking Ballista", "ability": 1, "player": 1, "targets": ["Azure Beastbinder"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20 }, {} ],
   "counters": { "Walking Ballista": { "p1p1": 1 } }
  }
 },
 {
  "name": "ruling: a later power-setting effect overwrites Azure Beastbinder's base 2/2",
  "players": [
   { "hand": ["Turn to Frog"], "battlefield": [ { "name": "Azure Beastbinder", "sick": false }, "Island", "Plains" ] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "attack": [ { "card": "Azure Beastbinder", "at": "p1" } ] },
   { "resolve": true, "targets": ["Serra Angel"] },
   { "cast": "Turn to Frog", "targets": ["Serra Angel"] },
   { "resolve": true }
  ],
  "expect": { "pt": { "Serra Angel": [1, 1] } }
 },
 {
  "name": "ruling: a blocked Azure Beastbinder stays blocked when its blocker's power grows",
  "players": [
   { "battlefield": [ { "name": "Azure Beastbinder", "sick": false } ] },
   { "hand": ["Giant Growth"], "battlefield": ["Llanowar Elves", "Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Azure Beastbinder", "at": "p1" } ] },
   { "block": [ { "blocker": "Llanowar Elves", "attacker": "Azure Beastbinder" } ] },
   { "pass": true },
   { "cast": "Giant Growth", "player": 1, "targets": ["Llanowar Elves"] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "life": 20, "graveyard": ["Azure Beastbinder"] }, { "battlefield_has": ["Llanowar Elves"] } ]
  }
 },
 {
  "name": "ruling: a pump that started before the attack still applies on top of the base 2/2",
  "players": [
   { "hand": ["Giant Growth"], "battlefield": [ { "name": "Azure Beastbinder", "sick": false }, "Forest" ] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": ["Serra Angel"] },
   { "resolve": true },
   { "attack": [ { "card": "Azure Beastbinder", "at": "p1" } ] },
   { "resolve": true, "targets": ["Serra Angel"] }
  ],
  "expect": { "pt": { "Serra Angel": [5, 5] } }
 },
 {
  "name": "ruling: a +1/+1 counter still applies on top of the base 2/2",
  "players": [
   { "battlefield": [ { "name": "Azure Beastbinder", "sick": false } ] },
   { "battlefield": [ { "name": "Serra Angel", "counters": { "p1p1": 1 } } ] }
  ],
  "steps": [
   { "attack": [ { "card": "Azure Beastbinder", "at": "p1" } ] },
   { "resolve": true, "targets": ["Serra Angel"] }
  ],
  "expect": { "pt": { "Serra Angel": [3, 3] } }
 }
]