[
 {
  "name": "attack trigger gives up-to-one target creature -1/-0 until end of turn",
  "players": [ { "battlefield": ["Ant-Man's Air Force"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "attack": [ { "card": "Ant-Man's Air Force", "at": "p1" } ] },
    { "resolve": true, "targets": ["Grizzly Bears"] }
  ],
  "expect": { "pt": { "Grizzly Bears": [1, 2] } }
 },
 {
  "name": "attack trigger with no target chosen does nothing",
  "players": [ { "battlefield": ["Ant-Man's Air Force"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "attack": [ { "card": "Ant-Man's Air Force", "at": "p1" } ] },
    { "resolve": true }
  ],
  "expect": { "pt": { "Grizzly Bears": [2, 2] } }
 }
]
