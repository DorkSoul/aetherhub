[
  {
    "name": "blitz from hand: haste, sacrificed at end step, dies and draws a card",
    "players": [
      { "hand": ["Sabin, Master Monk", "Island"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Sabin, Master Monk", "alt": 0 },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Sabin, Master Monk", "Island"], "hand_count": 1, "battlefield_lacks": ["Sabin, Master Monk"] },
        {}
      ]
    }
  },
  {
    "name": "blitz from the graveyard: discard a card as the cost, then the same blitz rules",
    "players": [
      { "hand": ["Island"], "graveyard": ["Sabin, Master Monk"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Sabin, Master Monk", "alt": 1 },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Sabin, Master Monk", "Island"], "hand_count": 1, "battlefield_lacks": ["Sabin, Master Monk"] },
        {}
      ]
    }
  },
  {
    "name": "normal cast {4}{R}: no haste trigger, stays on the battlefield, no card drawn",
    "players": [
      { "hand": ["Sabin, Master Monk"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Sabin, Master Monk" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Sabin, Master Monk"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: blitzed creature killed before the end step: one death draw, no sacrifice",
    "players": [
      { "hand": ["Sabin, Master Monk", "Island"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Sabin, Master Monk", "alt": 0 },
      { "resolve": true },
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Sabin, Master Monk"] },
      { "resolve": true, "auto": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Sabin, Master Monk", "Island"], "hand_count": 1, "battlefield_lacks": ["Sabin, Master Monk"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a blitz cast is still a spell: countering it sends Sabin to the graveyard and draws nothing",
    "players": [
      { "hand": ["Sabin, Master Monk", "Island"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Sabin, Master Monk", "alt": 0 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Sabin, Master Monk" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Sabin, Master Monk", "Island"], "hand_count": 0, "battlefield_lacks": ["Sabin, Master Monk"] },
        {}
      ]
    }
  }
]
