[
  { "name": "at end of combat destroys the blocker and the blocked attacker",
    "players": [ { "battlefield": ["Heat Stroke", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ] } },
  { "name": "an unblocked attacker and a non-combatant survive",
    "players": [ { "battlefield": ["Heat Stroke", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Savannah Lions"] } ],
    "steps": [ { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield": ["Heat Stroke", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Savannah Lions"] } ] } },
  { "name": "ruling: the destruction waits for end of combat, so the blocker is still on the battlefield after combat damage",
    "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Heat Stroke", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }] },
               { "advance_to": "CombatDamage", "auto": true },
               { "cast": "Shock", "targets": ["Hill Giant"] }, { "resolve": true },
               { "advance_to": "Main2", "auto": true } ],
    "expect": { "players": [ { "graveyard": ["Shock", "Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ] } }
]
