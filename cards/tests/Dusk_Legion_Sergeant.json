[
  { "name": "sacrifice gives persist to other nontoken Vampires until end of turn",
    "players": [ { "battlefield": ["Swamp", "Swamp", "Dusk Legion Sergeant", "Dusk Legion Zealot"] }, {} ],
    "steps": [ { "activate": "Dusk Legion Sergeant" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Dusk Legion Sergeant"], "battlefield_has": ["Dusk Legion Zealot"] }, {} ], "keywords": { "Dusk Legion Zealot": ["Persist"] } } },
  { "name": "a non-Vampire creature gains nothing",
    "players": [ { "battlefield": ["Swamp", "Swamp", "Dusk Legion Sergeant", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Dusk Legion Sergeant" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Dusk Legion Sergeant"] }, {} ] } },
  { "name": "ruling: persist returns a new object, so the Aura and the +1/+1 counter do not come back",
    "players": [ { "hand": ["Pacifism", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Swamp", "Swamp", "Swamp", "Mountain", "Dusk Legion Sergeant", { "name": "Dusk Legion Duelist", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "cast": "Pacifism", "targets": ["Dusk Legion Duelist"] }, { "resolve": true }, { "activate": "Dusk Legion Sergeant" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Dusk Legion Duelist"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dusk Legion Duelist"], "battlefield_lacks": ["Pacifism"], "graveyard_has": ["Pacifism", "Lightning Bolt", "Dusk Legion Sergeant"] }, {} ], "counters": { "Dusk Legion Duelist": { "m1m1": 1 } }, "pt": { "Dusk Legion Duelist": [1, 1] } } },
  { "name": "ruling: a creature that had -1/-1 counters does not persist back",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain", "Dusk Legion Sergeant", { "name": "Dusk Legion Duelist", "counters": { "m1m1": 1 } }] }, {} ],
    "steps": [ { "activate": "Dusk Legion Sergeant" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Dusk Legion Duelist"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Dusk Legion Duelist"], "graveyard_has": ["Dusk Legion Duelist"] }, {} ] } },
  { "name": "ruling: +1/+1 and -1/-1 counters cancel out, so persist can still return it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain", "Dusk Legion Sergeant", { "name": "Dusk Legion Duelist", "counters": { "p1p1": 1, "m1m1": 1 } }] }, {} ],
    "steps": [ { "activate": "Dusk Legion Sergeant" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Dusk Legion Duelist"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dusk Legion Duelist"], "graveyard_has": ["Dusk Legion Sergeant"] }, {} ], "counters": { "Dusk Legion Duelist": { "m1m1": 1 } }, "pt": { "Dusk Legion Duelist": [1, 1] } } }
]
