[
  {
    "name": "the equipped attacker must be blocked by an Eldrazi if able",
    "players": [ { "battlefield": ["Slayer's Cleaver", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Eldrazi Scion"] } ],
    "steps": [ { "activate": "Slayer's Cleaver", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "a non-Eldrazi doesn't have to block",
    "players": [ { "battlefield": ["Slayer's Cleaver", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Slayer's Cleaver", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] }
  },
  {
    "name": "ruling: if every Eldrazi that could block is tapped, none has to block",
    "players": [ { "battlefield": ["Slayer's Cleaver", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": [ { "name": "Eldrazi Scion", "tapped": true } ] } ],
    "steps": [ { "activate": "Slayer's Cleaver", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] }
  },
  {
    "name": "ruling: the Eldrazi requirement is only one blocker; other creatures may also block the equipped attacker",
    "players": [ { "battlefield": ["Slayer's Cleaver", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Eldrazi Scion", "Hill Giant"] } ],
    "steps": [ { "activate": "Slayer's Cleaver", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Eldrazi Scion", "attacker": "Grizzly Bears" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  }
]
