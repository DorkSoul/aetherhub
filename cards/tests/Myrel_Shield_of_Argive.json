[
  {
    "name": "attacking with only Myrel makes one Soldier token",
    "players": [
      { "battlefield": [{ "name": "Myrel, Shield of Argive", "sick": false }, "Plains"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Myrel, Shield of Argive", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Myrel, Shield of Argive", "Soldier 1-1 Colorless Artifact"] }, {}] }
  },
  {
    "name": "the token count includes the other Soldiers you control",
    "players": [
      { "battlefield": [{ "name": "Myrel, Shield of Argive", "sick": false }, { "name": "Elite Vanguard", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Myrel, Shield of Argive", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Soldier 1-1 Colorless Artifact", "Soldier 1-1 Colorless Artifact"] }, {}] }
  },
  {
    "name": "opponent cannot cast an instant on your turn (Murder on Myrel)",
    "players": [
      { "battlefield": ["Myrel, Shield of Argive", "Plains"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myrel, Shield of Argive"], "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Myrel, Shield of Argive"] }, { "hand": ["Murder"] } ] }
  },
  {
    "name": "opponent cannot activate an artifact's ability on your turn (Mystic Skull transform)",
    "players": [
      { "battlefield": ["Myrel, Shield of Argive"] },
      { "battlefield": ["Mystic Skull", "Plains", "Plains", "Plains", "Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Mystic Skull", "ability": 0, "player": 1, "illegal": true }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Mystic Skull"] } ] }
  },
  {
    "name": "ruling: an opponent's creature activated ability (Prodigal Pyromancer ping) is blocked on your turn",
    "players": [
      { "battlefield": ["Myrel, Shield of Argive", "Plains"] },
      { "battlefield": ["Prodigal Pyromancer", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Prodigal Pyromancer", "ability": 0, "player": 1, "targets": ["p0"], "illegal": true }
    ],
    "expect": { "players": [ { "life": 20 }, { "battlefield_has": ["Prodigal Pyromancer"] } ] }
  }
]
