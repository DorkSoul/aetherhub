[
  {
    "name": "sacrificed to counter a spell that targets a creature you control",
    "players": [
      { "battlefield": ["Island", "Grizzly Bears", "Hydromorph Guardian"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "activate": "Hydromorph Guardian", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Hydromorph Guardian"] },
        { "graveyard": ["Lightning Bolt"], "life": 20 }
      ]
    }
  },
  {
    "name": "cannot counter a spell that targets a creature you do not control",
    "players": [
      { "battlefield": ["Island", "Hydromorph Guardian"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "activate": "Hydromorph Guardian", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Island", "Hydromorph Guardian"] },
        { "battlefield": ["Mountain", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "cannot counter a spell that targets only a player",
    "players": [
      { "battlefield": ["Island", "Grizzly Bears", "Hydromorph Guardian"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "activate": "Hydromorph Guardian", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true }
    ],
    "expect": {
      "players": [{ "life": 20 }, { "life": 20 }]
    }
  }
]
