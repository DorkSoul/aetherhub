[
  { "name": "2 damage kills the creature; its controller takes 3 damage",
    "players": [
      { "hand": ["Searing Blood"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [ { "cast": "Searing Blood", "targets": ["Savannah Lions"] }, { "resolve": true } ],
    "expect": {
      "players": [
        {},
        { "life": 17, "graveyard": ["Savannah Lions"] }
      ]
    }
  },
  { "name": "creature that survives 2 damage: no damage to its controller",
    "players": [
      { "hand": ["Searing Blood"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [ { "cast": "Searing Blood", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": {
      "players": [
        {},
        { "life": 20, "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  { "name": "only the targeted creature's death triggers it: another creature dying does not",
    "players": [
      { "hand": ["Searing Blood", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant", "Savannah Lions"] }
    ],
    "steps": [
      { "cast": "Searing Blood", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20, "graveyard": ["Savannah Lions"], "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  { "name": "ruling: a creature hit by Searing Blood that dies later the same turn still deals 3 to its controller",
    "players": [
      { "hand": ["Searing Blood", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Searing Blood", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 17, "graveyard": ["Hill Giant"] } ] }
  }
]
