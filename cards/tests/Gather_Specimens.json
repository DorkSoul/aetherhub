[
  {
    "name": "opponent's creature enters under your control this turn",
    "players": [
      { "hand": ["Gather Specimens"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Spectral Sailor"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "cast": "Gather Specimens" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Spectral Sailor", "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Sailor"] }, { "battlefield": ["Island"] } ] }
  },
  {
    "name": "your own creatures are unaffected",
    "players": [
      { "hand": ["Gather Specimens", "Spectral Sailor"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Gather Specimens" },
      { "resolve": true },
      { "cast": "Spectral Sailor" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Sailor"] }, {} ] }
  },
  {
    "name": "ruling: a creature that entered before Gather Specimens stays under its controller",
    "players": [
      { "hand": ["Gather Specimens"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Spectral Sailor"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Spectral Sailor", "player": 1 },
      { "resolve": true },
      { "cast": "Gather Specimens" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Spectral Sailor"] }, { "battlefield_has": ["Spectral Sailor"] } ] }
  }
]
