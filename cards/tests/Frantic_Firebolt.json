[
  {
    "name": "X counts instant and sorcery cards in your graveyard (2 + 2 = 4) and kills a 3/3",
    "players": [
      {
        "hand": ["Frantic Firebolt"],
        "battlefield": ["Mountain", "Mountain", "Mountain"],
        "graveyard": ["Lightning Bolt", "Animal Magnetism"]
      },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Frantic Firebolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Frantic Firebolt", "Lightning Bolt", "Animal Magnetism"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "creature cards in your graveyard are not counted: X = 2 does not kill a 3/3",
    "players": [
      {
        "hand": ["Frantic Firebolt"],
        "battlefield": ["Mountain", "Mountain", "Mountain"],
        "graveyard": ["Grizzly Bears"]
      },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Frantic Firebolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Frantic Firebolt", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Frantic Firebolt does not count itself; with an empty graveyard X = 2 and a 3/3 survives",
    "players": [
      { "hand": ["Frantic Firebolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Frantic Firebolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Frantic Firebolt"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
