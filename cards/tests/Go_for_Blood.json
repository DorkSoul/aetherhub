[
  {
    "name": "your creature fights theirs: each deals damage equal to its power",
    "players": [
      { "hand": ["Go for Blood"], "battlefield": ["Mountain", "Mountain", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Go for Blood", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Go for Blood"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "cycling {1}: discard to draw a card",
    "players": [
      { "hand": ["Go for Blood"], "battlefield": ["Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Go for Blood", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Go for Blood"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "ruling: your creature is killed in response, so the fight does not happen and Grizzly Bears takes no damage",
    "players": [
      { "hand": ["Go for Blood", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Go for Blood", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Hill Giant"], "graveyard_has": ["Go for Blood", "Lightning Bolt", "Hill Giant"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
