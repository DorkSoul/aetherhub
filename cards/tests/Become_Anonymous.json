[
 { "name": "exiles the creature and the top two cards, then cloaks all three",
   "players": [ { "hand": ["Become Anonymous"], "battlefield": ["Grizzly Bears", "Island", "Island", "Island", "Island"],
                  "library": ["Forest", "Plains", "Swamp"] }, {} ],
   "steps": [ { "cast": "Become Anonymous" }, { "resolve": true } ],
   "expect": { "players": [ { "library_count": 1, "library_top": ["Swamp"], "exile": [], "graveyard": ["Become Anonymous"] }, {} ] } },
 { "name": "the cloaked cards are tapped 2/2 creatures",
   "players": [ { "hand": ["Become Anonymous"], "battlefield": ["Serra Angel", "Island", "Island", "Island", "Island"],
                  "library": ["Forest", "Plains", "Swamp"] }, {} ],
   "steps": [ { "cast": "Become Anonymous" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Forest", "Plains", "Serra Angel"] }, {} ],
               "tapped": { "Forest": true, "Plains": true, "Serra Angel": true },
               "pt": { "Forest": [2, 2], "Plains": [2, 2], "Serra Angel": [2, 2] } } },
 { "name": "a token creature can't be targeted",
   "players": [ { "hand": ["Become Anonymous"], "battlefield": [ { "name": "Soldier", "token": true }, "Island", "Island", "Island", "Island"],
                  "library": ["Forest", "Plains", "Swamp"] }, {} ],
   "steps": [ { "cast": "Become Anonymous", "targets": ["Soldier"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Become Anonymous"], "library_count": 3 }, {} ] } },
 { "name": "ruling: a cloaked card is colorless and has no creature types",
   "players": [ { "hand": ["Become Anonymous"], "battlefield": ["Serra Angel", "Island", "Island", "Island", "Island"],
                  "library": ["Forest", "Plains", "Swamp"] }, {} ],
   "steps": [ { "cast": "Become Anonymous" }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "colors": { "Serra Angel": [] }, "not_subtypes": { "Serra Angel": ["Angel"] }, "pt": { "Serra Angel": [2, 2] } } }
]
