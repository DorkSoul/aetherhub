[
  {
    "name": "the chosen unblocked attacker's combat damage is cut to 1",
    "players": [
      { "battlefield": ["Craw Wurm"] },
      { "battlefield": ["Forcefield", "Plains"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Craw Wurm", "at": "p1" } ] },
      { "block": [] },
      { "pass": true },
      { "activate": "Forcefield", "player": 1, "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ]
    }
  },
  {
    "name": "only the chosen creature's next damage is prevented; another unblocked attacker's damage is not",
    "players": [
      { "battlefield": ["Craw Wurm", "Hill Giant"] },
      { "battlefield": ["Forcefield", "Plains"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Craw Wurm", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "pass": true },
      { "activate": "Forcefield", "player": 1, "ability": 0 },
      { "resolve": true, "answers": ["Craw Wurm"] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: blocked trample damage is not reduced; Forcefield can only choose an unblocked creature",
    "players": [
      { "battlefield": ["Dodgy Jalopy", "Craw Wurm", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant", "Forcefield", "Plains"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Dodgy Jalopy" },
      { "resolve": true },
      { "attack": [ { "card": "Dodgy Jalopy", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Dodgy Jalopy" } ] },
      { "pass": true },
      { "activate": "Forcefield", "player": 1, "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16, "graveyard": ["Hill Giant"] } ]
    }
  }
]
