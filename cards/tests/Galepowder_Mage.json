[
 { "name": "attack exiles another creature until the end step",
   "players": [ { "battlefield": ["Galepowder Mage"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Galepowder Mage", "at": "p1" } ], "targets": ["Hill Giant"] }, { "advance_to": "End" } ],
   "expect": { "players": [ { "battlefield_has": ["Galepowder Mage"] }, { "battlefield": ["Hill Giant"], "exile": [] } ] } },
 { "name": "exiled creature is still exiled during combat",
   "players": [ { "battlefield": ["Galepowder Mage"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Galepowder Mage", "at": "p1" } ], "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield": [], "exile": ["Hill Giant"] } ] } },
 { "name": "no other creature: the trigger does nothing",
   "players": [ { "battlefield": ["Galepowder Mage"] }, {} ],
   "steps": [ { "attack": [ { "card": "Galepowder Mage", "at": "p1" } ] }, { "advance_to": "End" } ],
   "expect": { "players": [ { "battlefield_has": ["Galepowder Mage"] }, {} ] } },
 { "name": "ruling: the target can be your own creature, and it is exiled during combat",
   "players": [ { "battlefield": ["Galepowder Mage", "Grizzly Bears"] }, {} ],
   "steps": [ { "attack": [ { "card": "Galepowder Mage", "at": "p1" } ], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: with no other creature the trigger does nothing and the attack still deals damage",
   "players": [ { "battlefield": ["Galepowder Mage"] }, {} ],
   "steps": [ { "attack": [ { "card": "Galepowder Mage", "at": "p1" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Galepowder Mage"] }, { "life": 17 } ] } },
 { "name": "ruling: the exiled creature returns at the end step even after Galepowder Mage has died",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Galepowder Mage", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Galepowder Mage", "at": "p1" } ], "targets": ["Hill Giant"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Galepowder Mage"] }, { "resolve": true }, { "advance_to": "End" } ],
   "expect": { "players": [ { "graveyard_has": ["Galepowder Mage"] }, { "battlefield_has": ["Hill Giant"], "exile": [] } ] } }
]
