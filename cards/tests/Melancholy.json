[
  {
    "name": "enters tapping the enchanted creature, which then does not untap",
    "players": [
      { "hand": ["Melancholy"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Melancholy", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Melancholy": "Hill Giant" },
      "tapped": { "Hill Giant": true },
      "players": [
        { "battlefield_has": ["Melancholy"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "upkeep: paying {B} keeps the Aura",
    "players": [
      { "hand": ["Melancholy"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Melancholy", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "attached": { "Melancholy": "Hill Giant" },
      "players": [
        { "battlefield_has": ["Melancholy"] },
        {}
      ]
    }
  },
  {
    "name": "upkeep: not paying sacrifices the Aura",
    "players": [
      { "hand": ["Melancholy"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Melancholy", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Melancholy"], "battlefield_lacks": ["Melancholy"] },
        {}
      ]
    }
  },
  { "name": "tapped enchanted creature does not untap in its controller's untap step",
    "players": [
      { "hand": ["Melancholy"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Melancholy", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Hill Giant": true },
      "players": [
        { "battlefield_has": ["Melancholy"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
