[
  {
    "name": "enters tapped when both players have at least 14 life",
    "players": [
      {
        "hand": [
          "Lakeside Shack"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Lakeside Shack"
      }
    ],
    "expect": {
      "players": [
