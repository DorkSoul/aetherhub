          "battlefield_has": [
            "Lakeside Shack"
          ]
        },
        {}
      ],
      "tapped": {
        "Lakeside Shack": true
      }
    }
  },
  {
    "name": "enters untapped when an opponent has 13 or less life",
    "players": [
      {
        "hand": [
          "Lakeside Shack"
        ]
      },
      {
        "life": 13
      }
    ],
    "steps": [
      {
        "play_land": "Lakeside Shack"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Lakeside Shack"
          ]
        },
        {}
      ],
      "tapped": {
        "Lakeside Shack": false
      }
    }
  },
  {
    "name": "ruling: the controller's own life counts; at 14 with the opponent at 20 it enters tapped",
    "players": [
      { "hand": ["Lakeside Shack"], "life": 14 },
      {}
    ],
    "steps": [
      { "play_land": "Lakeside Shack" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lakeside Shack"] },
        {}
      ],
      "tapped": { "Lakeside Shack": true }
    }
  },
  {
    "name": "ruling: the controller at 13 life (opponent at 20) lets it enter untapped",
    "players": [
      { "hand": ["Lakeside Shack"], "life": 13 },
      {}
    ],
    "steps": [
      { "play_land": "Lakeside Shack" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lakeside Shack"] },
        {}
      ],
      "tapped": { "Lakeside Shack": false }
    }
