    "steps": [ { "attack": [ { "card": "Longtusk Cub", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "energy": 2 }, { "life": 18 } ] }
  },
  {
    "name": "pay EE: put a +1/+1 counter on it",
