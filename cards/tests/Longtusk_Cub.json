    "expect": { "players": [ { "energy": 0 }, {} ], "pt": { "Longtusk Cub": [3, 3] } }
  },
  {
    "name": "ruling: energy persists through the end of the turn and into the opponent's turn",
    "players": [ { "battlefield": ["Longtusk Cub"] }, {} ],
    "steps": [ { "attack": [ { "card": "Longtusk Cub", "at": "p1" } ] }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "energy": 2 }, { "life": 18 } ] }
  },
  {
    "name": "ruling: cannot pay more energy than you have",
    "players": [ { "battlefield": ["Longtusk Cub"] }, {} ],
    "steps": [ { "attack": [ { "card": "Longtusk Cub", "at": "p1" } ] }, { "advance_to": "Main2" }, { "activate": "Longtusk Cub", "ability": 0 }, { "resolve": true }, { "activate": "Longtusk Cub", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "energy": 0 }, {} ], "pt": { "Longtusk Cub": [3, 3] } }
  }
