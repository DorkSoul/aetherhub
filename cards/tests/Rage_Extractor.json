 {
  "name": "ruling: each Phyrexian symbol counts as 1 for mana value (paid with 4 life, 3 damage)",
  "players": [
   { "hand": ["Dismember"], "battlefield": ["Rage Extractor", "Swamp", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Dismember", "targets": ["Hill Giant", "p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [{ "life": 16 }, { "life": 17 }] }
 },
 {
  "name": "ruling: Phyrexian symbols paid with mana still trigger Rage Extractor (3 damage)",
  "players": [
   { "hand": ["Dismember"], "battlefield": ["Rage Extractor", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Dismember", "targets": ["Hill Giant", "p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [{ "life": 20 }, { "life": 17 }] }
 },
 {
  "name": "ruling: at 1 life you cannot pay 2 life for a Phyrexian symbol",
  "players": [
   { "hand": ["Dismember"], "battlefield": ["Rage Extractor", "Swamp", "Swamp"], "life": 1 },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Dismember", "targets": ["Hill Giant", "p1"], "illegal": true }
  ],
  "expect": { "players": [{ "hand": ["Dismember"], "life": 1 }, { "life": 20 }] }
 },
 {
  "name": "ruling: at 3 life you can pay 2 life, leaving 1",
  "players": [
   { "hand": ["Dismember"], "battlefield": ["Rage Extractor", "Swamp", "Swamp", "Grizzly Bears"], "life": 3 },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Dismember", "targets": ["Hill Giant", "p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [{ "life": 1 }, { "life": 17 }] }
 }
]