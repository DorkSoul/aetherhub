[
  { "name": "enters and then taps target creature (remove an oil counter)",
    "players": [ { "hand": ["Tamiyo's Immobilizer"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Tamiyo's Immobilizer" },
      { "resolve": true },
      { "activate": "Tamiyo's Immobilizer", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true, "Tamiyo's Immobilizer": true } } },
  { "name": "cannot activate again while tapped",
    "players": [ { "hand": ["Tamiyo's Immobilizer"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears", "Serra Angel"] } ],
    "steps": [
      { "cast": "Tamiyo's Immobilizer" },
      { "resolve": true },
      { "activate": "Tamiyo's Immobilizer", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Tamiyo's Immobilizer", "ability": 0, "targets": ["Serra Angel"], "illegal": true }
    ],
    "expect": { "tapped": { "Serra Angel": false } } }
]
