[
  {
    "name": "a permanent of yours left this turn: end step makes a Rat and a counter",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Rat King, Verminister", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Rat King, Verminister", "Rat"] }, {} ],
      "pt": { "Rat King, Verminister": [2, 2] }
    }
  },
  {
    "name": "no permanent of yours left this turn: no Rat at end step",
    "players": [
      { "battlefield": ["Rat King, Verminister", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "advance_to": "End" } ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Rat"] }, {} ],
      "pt": { "Rat King, Verminister": [1, 1] }
    }
  },
  {
    "name": "an opponent's permanent leaving does not trigger Disappear",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Rat King, Verminister"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Rat"] }, {} ],
      "pt": { "Rat King, Verminister": [1, 1] }
    }
  },
  {
    "name": "tap and sacrifice three Rats: return all same-name creature cards tapped",
    "players": [
      {
        "battlefield": ["Rat King, Verminister", "Rat", "Rat"],
        "graveyard": ["Grizzly Bears", "Grizzly Bears", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      { "activate": "Rat King, Verminister", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Grizzly Bears"], "graveyard": ["Hill Giant", "Rat King, Verminister"] },
        {}
      ],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: a permanent that left on an earlier turn does not count for this turn's Disappear",
    "players": [
      { "battlefield": ["Rat King, Verminister", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Rat"], "graveyard_has": ["Grizzly Bears"] }, {} ],
      "pt": { "Rat King, Verminister": [1, 1] }
    }
  }
]
