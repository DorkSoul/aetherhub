[
  {
    "name": "counters the spell and scries 1",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Dissolve"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "cast": "Dissolve",
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "graveyard": [
            "Dissolve"
          ]
        }
      ]
    }
  },
  {
    "name": "cannot be cast with no spell to counter",
    "players": [
      {
        "hand": [
          "Dissolve"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Dissolve",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Dissolve"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: scry 1 can keep the top card on top",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Dissolve"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Dissolve", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Dissolve"], "library_top": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: scry 1 can put the top card on the bottom",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Dissolve"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Dissolve", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [["Grizzly Bears"]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Dissolve"], "library_top": ["Island"] }
      ]
    }
  }
]
