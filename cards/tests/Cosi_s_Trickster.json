[
  {
    "name": "opponent shuffling their library lets you put a +1/+1 counter on it",
    "players": [
      {
        "hand": [
          "Winds of Change"
        ],
        "battlefield": [
          "Cosi's Trickster",
          "Mountain"
        ]
      },
      {
        "hand": [
          "Shock"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Winds of Change"
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "pt": {
        "Cosi's Trickster": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "declining the optional counter leaves it a 1/1",
    "players": [
      {
        "hand": [
          "Winds of Change"
        ],
        "battlefield": [
          "Cosi's Trickster",
          "Mountain"
        ]
      },
      {
        "hand": [
          "Shock"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Winds of Change"
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      }
    ],
    "expect": {
      "pt": {
        "Cosi's Trickster": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "ruling: cascade does not shuffle the caster's library, so the opponent's Trickster stays 1/1",
    "players": [
      { "hand": ["Bloodbraid Elf"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest"], "library": ["Forest", "Hill Giant", "Savannah Lions"] },
      { "battlefield": ["Cosi's Trickster"] }
    ],
    "steps": [
      { "cast": "Bloodbraid Elf" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bloodbraid Elf", "Savannah Lions"] }, { "battlefield_has": ["Cosi's Trickster"] } ],
      "pt": { "Cosi's Trickster": [1, 1] }
    }
  },
  {
    "name": "ruling: an opponent with a single card in library still shuffles, so the trigger works",
    "players": [
      { "battlefield": ["Cosi's Trickster"] },
      { "hand": ["Gloomfang Mauler"], "battlefield": ["Island", "Island"], "library": ["Forest"], "exact_library": true }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Gloomfang Mauler", "player": 1 },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Cosi's Trickster": [2, 2] }
    }
  },
  {
    "name": "ruling: an opponent with an empty library still shuffles, so the trigger works",
    "players": [
      { "battlefield": ["Cosi's Trickster"] },
      { "hand": ["Gloomfang Mauler"], "battlefield": ["Island", "Island"], "library": [], "exact_library": true }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Gloomfang Mauler", "player": 1 },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Cosi's Trickster": [2, 2] }
    }
  },
  {
    "name": "ruling: an opponent's shuffle from a card's shuffle text (swampcycling) triggers the Trickster",
    "players": [
      { "battlefield": ["Cosi's Trickster"] },
      { "hand": ["Gloomfang Mauler"], "battlefield": ["Island", "Island"], "library": ["Forest", "Island"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Gloomfang Mauler", "player": 1 },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Cosi's Trickster": [2, 2] }
    }
  }
]
