[
 { "name": "enters: taps target opposing creature and puts a stun counter on it",
   "players": [ { "hand": ["Deluge Virtuoso"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Deluge Virtuoso" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "Stun": 1 } } } },
 { "name": "opus: instant with one mana gives +1/+1",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island", "Island", "Deluge Virtuoso"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "pt": { "Deluge Virtuoso": [3, 3] } } },
 { "name": "opus: instant with five mana gives +2/+2",
   "players": [ { "hand": ["Bury in Books"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Deluge Virtuoso"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Bury in Books", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "pt": { "Deluge Virtuoso": [4, 4] } } },
 { "name": "creature spell does not trigger opus",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Plains", "Island", "Deluge Virtuoso"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "pt": { "Deluge Virtuoso": [2, 2] } } },
 { "name": "ruling: opus still resolves when the spell is countered",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island", "Island", "Deluge Virtuoso"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Counterspell"] } ], "pt": { "Deluge Virtuoso": [3, 3] } } }
