[
  { "name": "damage to one opponent is copied to each other opponent",
    "players": [ { "battlefield": [ { "name": "Amarant Coral", "sick": false } ] }, {}, {} ],
    "steps": [ { "attack": [ { "card": "Amarant Coral", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 }, { "life": 15 } ] } },
  { "name": "blocked: no combat damage to a player, no trigger",
    "players": [ { "battlefield": [ { "name": "Amarant Coral", "sick": false } ] }, { "battlefield": [ { "name": "Wall of Stone", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Amarant Coral", "at": "p1" } ] }, { "block": [ { "blocker": "Wall of Stone", "attacker": "Amarant Coral" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 }, { "life": 20 } ] } },
  { "name": "must attack each combat: it attacks into an empty board",
    "players": [ { "battlefield": [ { "name": "Amarant Coral", "sick": false } ] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "ruling: copied damage is not combat damage and does not trigger again (4 players)",
    "players": [ { "battlefield": [ { "name": "Amarant Coral", "sick": false } ] }, {}, {}, {} ],
    "steps": [ { "attack": [ { "card": "Amarant Coral", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 }, { "life": 15 }, { "life": 15 } ] } },
  { "name": "ruling: tapped Amarant Coral cannot attack, so no damage and no trigger",
    "players": [ { "battlefield": [ { "name": "Amarant Coral", "tapped": true, "sick": false } ] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "ruling: Amarant Coral that came under control this turn does not attack",
    "players": [ { "battlefield": [ { "name": "Amarant Coral", "sick": true } ] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] } }
]
