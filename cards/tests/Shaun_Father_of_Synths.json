[
  {
    "name": "attacking with a legendary creature creates a tapped attacking Synth copy of it",
    "players": [
      { "battlefield": [ { "name": "Shaun, Father of Synths", "sick": false }, { "name": "Brigid, Clachan's Heart", "sick": false } ] },
      {}
