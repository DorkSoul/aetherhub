[
  {
    "name": "targeting an instant spell reduces the cost to {1}{U}: two Islands counter Lightning Bolt",
    "players": [
      { "hand": ["Brush Off"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "cast": "Brush Off", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Brush Off"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "targeting a creature spell does not reduce the cost: two Islands cannot pay {2}{U}{U}",
    "players": [
      { "hand": ["Brush Off", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "cast": "Brush Off", "illegal": true, "targets": [{ "stack": "Grizzly Bears" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Brush Off"], "battlefield": ["Forest", "Forest", "Island", "Island", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Thalia's tax is added before Brush Off's reduction: {2}{U} with Thalia out, so three lands pay",
    "players": [
      { "hand": ["Brush Off"], "battlefield": ["Island", "Island", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Thalia, Guardian of Thraben"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Brush Off", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Brush Off"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: with Thalia out, two Islands cannot pay the taxed Brush Off",
    "players": [
      { "hand": ["Brush Off"], "battlefield": ["Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Thalia, Guardian of Thraben"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Brush Off", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Brush Off"], "life": 17 },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
