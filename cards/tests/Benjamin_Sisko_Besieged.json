    "players": [
      { "battlefield": ["Benjamin Sisko, Besieged", "Mountain"], "library": ["Lightning Bolt", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "illegal": true }
