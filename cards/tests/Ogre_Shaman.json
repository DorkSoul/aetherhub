[
 {
  "name": "discards a random card to deal 2 damage to the opponent",
  "players": [
   { "hand": ["Mountain"], "battlefield": ["Ogre Shaman", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Ogre Shaman", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Mountain"] }, { "life": 18 } ]
  }
 },
 {
  "name": "can't activate with an empty hand",
  "players": [
   { "battlefield": ["Ogre Shaman", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Ogre Shaman", "targets": ["p1"], "illegal": true }
  ],
  "expect": { "players": [ {}, { "life": 20 } ] }
 },
 {
  "name": "can't activate without two other mana",
  "players": [
   { "hand": ["Mountain"], "battlefield": ["Ogre Shaman", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Ogre Shaman", "targets": ["p1"], "illegal": true }
  ],
  "expect": { "players": [ { "hand": ["Mountain"] }, { "life": 20 } ] }
 }
]
