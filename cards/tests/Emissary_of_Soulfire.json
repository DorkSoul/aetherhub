[
  { "name": "enters with three energy",
    "players": [ { "hand": ["Emissary of Soulfire"], "battlefield": ["Plains", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Emissary of Soulfire" }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 3, "battlefield_has": ["Emissary of Soulfire"] }, {} ] } },
  { "name": "pay EE puts an exalted counter",
    "players": [ { "battlefield": ["Emissary of Soulfire"], "energy": 3 }, {} ],
    "steps": [ { "activate": "Emissary of Soulfire", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 1 }, {} ], "counters": { "Emissary of Soulfire": { "Exalted": 1 } } } },
  { "name": "cannot pay without energy",
    "players": [ { "battlefield": ["Emissary of Soulfire"], "energy": 1 }, {} ],
    "steps": [ { "activate": "Emissary of Soulfire", "ability": 0, "illegal": true } ],
    "expect": { "pt": { "Emissary of Soulfire": [1, 4] } } },
  { "name": "creature with exalted counter attacking alone gets +1/+1",
    "players": [ { "battlefield": ["Emissary of Soulfire", "Grizzly Bears"], "energy": 3 }, {} ],
    "steps": [ { "activate": "Emissary of Soulfire", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "two exalted counters stack and two attackers give nothing",
    "players": [ { "battlefield": ["Emissary of Soulfire", "Grizzly Bears"], "energy": 3 }, {} ],
    "steps": [ { "activate": "Emissary of Soulfire", "ability": 0, "targets": ["Emissary of Soulfire"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Emissary of Soulfire", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2], "Emissary of Soulfire": [1, 4] } } },
  { "name": "ruling: two exalted counters are two instances, so a lone attacker gets +2/+2",
    "players": [ { "battlefield": ["Emissary of Soulfire", { "name": "Grizzly Bears", "counters": { "Exalted": 2 } }] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ], "pt": { "Grizzly Bears": [4, 4] } } },
  { "name": "ruling: exalted does not trigger when two creatures attack",
    "players": [ { "battlefield": ["Emissary of Soulfire", { "name": "Grizzly Bears", "counters": { "Exalted": 1 } }, "Savannah Lions"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ], "pt": { "Grizzly Bears": [2, 2] } } }
]
