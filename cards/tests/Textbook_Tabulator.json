[
  { "name": "casting a spell that spends more mana than its power puts a +1/+1 counter on it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Textbook Tabulator", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Textbook Tabulator": [1, 4] }, "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "casting a spell that spends no mana does not trigger increment",
    "players": [ { "hand": ["Ornithopter"], "battlefield": ["Textbook Tabulator"] }, {} ],
    "steps": [ { "cast": "Ornithopter" }, { "resolve": true } ],
    "expect": { "pt": { "Textbook Tabulator": [0, 3] }, "players": [ { "battlefield_has": ["Ornithopter"] }, {} ] } },
  { "name": "spending mana equal to both power and toughness does not trigger increment",
    "players": [ { "hand": ["Grizzly Bears", "Llanowar Elves"], "battlefield": ["Textbook Tabulator", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "cast": "Llanowar Elves" }, { "resolve": true } ],
    "expect": { "pt": { "Textbook Tabulator": [1, 4] }, "players": [ { "battlefield_has": ["Llanowar Elves"] }, {} ] } },
  { "name": "ETB surveil 2: bin one of the top two, keep the other on top",
    "players": [ { "hand": ["Textbook Tabulator"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears", "Mountain"] }, {} ],
    "steps": [ { "cast": "Textbook Tabulator" }, { "resolve": true, "answers": [["Grizzly Bears"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Textbook Tabulator"], "graveyard": ["Grizzly Bears"], "library_top": ["Mountain"] }, {} ] } },
  { "name": "ETB surveil 2: keep both cards on top",
    "players": [ { "hand": ["Textbook Tabulator"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears", "Mountain"] }, {} ],
    "steps": [ { "cast": "Textbook Tabulator" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "battlefield_has": ["Textbook Tabulator"], "graveyard": [], "library_top": ["Grizzly Bears", "Mountain"] }, {} ] } },
  { "name": "ruling: increment still resolves when the spell it triggered on is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Textbook Tabulator", "Ertai, the Corrupted", "Llanowar Elves", "Mountain", "Island"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Ertai, the Corrupted", "targets": [ { "stack": "Lightning Bolt" } ], "answers": ["Llanowar Elves"] }, { "resolve": true } ],
    "expect": { "pt": { "Textbook Tabulator": [1, 4] }, "players": [ { "graveyard": ["Lightning Bolt", "Llanowar Elves"], "battlefield_has": ["Textbook Tabulator", "Ertai, the Corrupted"] }, { "life": 20 } ] } }
]
