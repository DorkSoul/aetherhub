[
  { "name": "upkeep: may put a charge counter on it",
    "players": [ { "battlefield": ["Golden Urn"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "counters": { "Golden Urn": { "charge": 1 } } } },
  { "name": "sacrifice: gain life equal to charge counters",
    "players": [ { "life": 20, "battlefield": [ { "name": "Golden Urn", "counters": { "charge": 3 } } ] }, {} ],
    "steps": [ { "activate": "Golden Urn", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 23, "graveyard": ["Golden Urn"] }, {} ] } },
  { "name": "no counters: gain no life",
    "players": [ { "life": 20, "battlefield": ["Golden Urn"] }, {} ],
    "steps": [ { "activate": "Golden Urn", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "ruling: counter added in upkeep is counted when the Urn is sacrificed later",
    "players": [ { "life": 20, "battlefield": ["Golden Urn"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true }, { "activate": "Golden Urn", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Golden Urn"] }, {} ] } }
]
