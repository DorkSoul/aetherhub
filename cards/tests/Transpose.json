[
  {
    "name": "cast from hand: draw, discard, lose 1 life and make a Wizard",
    "players": [
      {
        "hand": [
          "Transpose"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ],
        "library": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Transpose"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 19,
          "battlefield_has": [
            "Wizard 0-1"
          ],
          "exile": [
            "Transpose"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "the Wizard pings the opponent when you cast a noncreature spell",
    "players": [
      {
        "hand": [
          "Transpose",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Mountain"
        ],
        "library": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Transpose"
      },
      {
        "resolve": true,
        "answers": [
          "Grizzly Bears"
        ]
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 19
        },
        {
          "life": 16
        }
      ]
    }
  },
  {
    "name": "ruling: a countered rebound spell goes to the graveyard and does not rebound",
    "players": [
      { "hand": ["Transpose"], "battlefield": ["Swamp", "Swamp", "Swamp"], "library": ["Grizzly Bears"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Transpose" },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Transpose"], "exile": [], "hand": [], "library_top": ["Grizzly Bears"] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "ruling: declining the rebound cast leaves the card exiled",
    "players": [
      { "hand": ["Transpose"], "battlefield": ["Swamp", "Swamp", "Swamp"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Transpose" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 19, "exile": ["Transpose"], "graveyard": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Wizard's ping resolves before the Bolt that triggered it, even when the Bolt is countered",
    "players": [
      { "hand": ["Transpose", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain"], "library": ["Grizzly Bears"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Transpose" },
      { "resolve": true, "answers": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 19, "graveyard": ["Grizzly Bears", "Lightning Bolt"] },
        { "life": 19, "graveyard": ["Counterspell"] }
      ]
    }
  }
]
