[
 { "name": "at max speed: {3}, {T}, discard a card: draw a card",
   "players": [ { "hand": ["Mountain"], "battlefield": ["Avishkar Raceway", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "set_speed": 4 }, { "activate": "Avishkar Raceway", "ability": 32768 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard": ["Mountain"], "battlefield_has": ["Avishkar Raceway"] }, {} ] } },
 { "name": "without max speed the ability is not available",
   "players": [ { "hand": ["Mountain"], "battlefield": ["Avishkar Raceway", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "activate": "Avishkar Raceway", "ability": 32768, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Mountain"] }, {} ] } },
 { "name": "at max speed but without {3} to pay: not available",
   "players": [ { "hand": ["Mountain"], "battlefield": ["Avishkar Raceway", "Plains", "Plains"] }, {} ],
   "steps": [ { "set_speed": 4 }, { "activate": "Avishkar Raceway", "ability": 32768, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Mountain"] }, {} ] } },
 { "name": "playing it starts your engines: speed becomes 1",
   "players": [ { "hand": ["Avishkar Raceway"] }, {} ],
   "steps": [ { "play_land": "Avishkar Raceway" }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1, "battlefield_has": ["Avishkar Raceway"] }, {} ] } },
 { "name": "ruling: the opponent losing life on your turn raises speed, once per turn",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Avishkar Raceway", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "set_speed": 1 }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 2 }, { "life": 14 } ] } },
 { "name": "ruling: speed is per player; a player without a speed has speed 0",
   "players": [ { "battlefield": ["Avishkar Raceway"] }, { "battlefield": ["Plains"] } ],
   "steps": [ { "set_speed": 1 } ],
   "expect": { "players": [ { "speed": 1 }, { "speed": 0 } ] } }
]
