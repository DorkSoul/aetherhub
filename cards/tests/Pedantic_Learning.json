[
  {
    "name": "enchantment is castable and does nothing without a land milled",
    "players": [
      {
        "hand": [
          "Pedantic Learning"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Pedantic Learning"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Pedantic Learning"
          ],
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "surveil puts a land from library into graveyard: pay {1} to draw a card",
    "players": [
      { "hand": ["Consider"], "battlefield": ["Island", "Island", "Pedantic Learning"], "library": ["Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Consider" },
      { "resolve": true, "answers": [["Mountain"], true] }
    ],
    "expect": {
      "players": [
        { "hand_count": 2, "graveyard_has": ["Mountain"] },
        {}
      ]
    }
  },
  {
    "name": "land put into graveyard from library: declining the {1} payment draws nothing",
    "players": [
      { "hand": ["Consider"], "battlefield": ["Island", "Island", "Pedantic Learning"], "library": ["Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Consider" },
      { "resolve": true, "answers": [["Mountain"], false] }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"], "graveyard_has": ["Mountain"] },
        {}
      ]
    }
  },
  {
    "name": "nonland card put into graveyard from library does not trigger Pedantic Learning",
    "players": [
      { "hand": ["Consider"], "battlefield": ["Island", "Island", "Pedantic Learning"], "library": ["Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Consider" },
      { "resolve": true, "answers": [["Grizzly Bears"]] }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard_has": ["Grizzly Bears"] },
        {}
      ]
    }
  }
]
