[
  {
    "name": "6 damage kills a 2/2 and it is exiled instead",
    "players": [ { "hand": ["Bot Bashing Time"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Bot Bashing Time", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": ["Bot Bashing Time"] }, { "exile": ["Grizzly Bears"], "battlefield": [] } ]
    }
  },
  {
    "name": "6 damage does not kill a 0/8",
    "players": [ { "hand": ["Bot Bashing Time"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Wall of Stone"] } ],
    "steps": [ { "cast": "Bot Bashing Time", "targets": ["Wall of Stone"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Wall of Stone"] } ] }
  },
  {
    "name": "ruling: a creature that survives the 6 damage and dies later that turn is exiled instead",
    "players": [ { "hand": ["Bot Bashing Time", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Wall of Stone"] } ],
    "steps": [ { "cast": "Bot Bashing Time", "targets": ["Wall of Stone"] }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["p1:Wall of Stone"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": ["Bot Bashing Time", "Lightning Bolt"] }, { "exile": ["Wall of Stone"], "battlefield": [] } ]
    }
  }
]
