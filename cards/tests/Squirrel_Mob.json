 {
  "name": "ruling: damage stays marked, so Squirrel Mob dies when another Squirrel leaves and the damage becomes lethal",
  "players": [
   {
    "hand": ["Lightning Bolt", "Lightning Bolt"],
    "battlefield": ["Squirrel Mob", "Squirrel", "Squirrel", "Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Squirrel Mob"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Squirrel"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Squirrel Mob"], "battlefield_lacks": ["Squirrel Mob"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: boundary: with both other Squirrels still around, the 3 damage on Squirrel Mob is not lethal",
  "players": [
