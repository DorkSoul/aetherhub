[
  {
    "name": "unkicked: draw three, discard two, no target",
    "players": [
      { "hand": ["Probe"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Mountain", "Island"] },
      { "hand": ["Forest", "Mountain", "Island"] }
    ],
    "steps": [
      { "cast": "Probe" },
      { "resolve": true, "answers": [["Forest", "Mountain"]] }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "graveyard": ["Probe", "Forest", "Mountain"] }, { "hand": ["Forest", "Mountain", "Island"] } ]
    }
  },
  {
    "name": "kicked: opponent also discards two",
    "players": [
      { "hand": ["Probe"], "battlefield": ["Island", "Island", "Island", "Swamp", "Swamp"], "library": ["Forest", "Mountain", "Island"] },
      { "hand": ["Forest", "Mountain", "Island"] }
    ],
    "steps": [
      { "cast": "Probe", "answers": [true], "targets": ["p1"] },
      { "resolve": true, "answers": [["Forest", "Mountain"], ["Forest", "Mountain"]] }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "graveyard": ["Probe", "Forest", "Mountain"] }, { "hand": ["Island"], "graveyard": ["Forest", "Mountain"] } ]
    }
  },
  {
    "name": "ruling: a copy of a kicked spell is kicked (the copy also makes the opponent discard)",
    "players": [
      { "hand": ["Probe", "Twincast"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Swamp"], "library": ["Forest", "Mountain", "Island", "Forest", "Mountain", "Island"] },
      { "hand": ["Forest", "Mountain", "Island"] }
    ],
    "steps": [
      { "cast": "Probe", "answers": [true], "targets": ["p1"] },
      { "cast": "Twincast", "targets": [{ "stack": "Probe" }] },
      { "resolve": true, "answers": ["p1", ["Forest", "Mountain"], ["Forest", "Mountain"], ["Forest", "Mountain"]] }
    ],
    "expect": { "players": [ { "graveyard_has": ["Probe", "Twincast"] }, { "hand": [] } ] }
  }
]
