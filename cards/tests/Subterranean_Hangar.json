[
  {
    "name": "enters tapped; the storage ability is a tap ability that adds a storage counter",
    "players": [
      {
        "hand": [
          "Subterranean Hangar"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "play_land": "Subterranean Hangar"
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Subterranean Hangar"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "Subterranean Hangar: remove all storage counters: adds one B per counter removed",
    "players": [
      {
        "battlefield": [
          {
            "name": "Subterranean Hangar",
            "counters": {
              "storage": 3
            }
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Subterranean Hangar",
        "color": "B"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "B": 3
          }
        },
        {}
      ],
      "counters": {
        "Subterranean Hangar": {
          "storage": 0
        }
      },
      "tapped": {
        "Subterranean Hangar": true
      }
    }
  },
  {
    "name": "Subterranean Hangar: no storage counters: taps for no mana",
    "players": [
      {
        "battlefield": [
          "Subterranean Hangar"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Subterranean Hangar",
        "color": "B"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "B": 0
          }
        },
        {}
      ],
      "tapped": {
        "Subterranean Hangar": true
      }
    }
  },
  {
    "name": "tap ability puts a storage counter on the land and taps it",
    "players": [ { "battlefield": ["Subterranean Hangar"] }, {} ],
    "steps": [ { "activate": "Subterranean Hangar", "ability": 0 }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Subterranean Hangar"] }, {} ],
      "counters": { "Subterranean Hangar": { "storage": 1 } },
      "tapped": { "Subterranean Hangar": true }
    }
  },
  {
    "name": "a tapped Hangar cannot put another storage counter",
    "players": [ { "battlefield": ["Subterranean Hangar"] }, {} ],
    "steps": [
      { "activate": "Subterranean Hangar", "ability": 0 },
      { "resolve": true },
      { "activate": "Subterranean Hangar", "ability": 0, "illegal": true }
    ],
    "expect": { "counters": { "Subterranean Hangar": { "storage": 1 } } }
  },
  {
    "name": "enters tapped when played",
    "players": [ { "hand": ["Subterranean Hangar"] }, {} ],
    "steps": [ { "play_land": "Subterranean Hangar" } ],
    "expect": { "players": [ { "battlefield_has": ["Subterranean Hangar"] }, {} ], "tapped": { "Subterranean Hangar": true } }
  },
  {
    "name": "a basic land played the same way enters untapped",
    "players": [ { "hand": ["Forest"] }, {} ],
    "steps": [ { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, {} ], "tapped": { "Forest": false } }
  }
]
