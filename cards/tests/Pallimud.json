[
 { "name": "power equals the tapped lands of the chosen opponent",
   "players": [ { "hand": ["Pallimud"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                { "battlefield": [ { "name": "Island", "tapped": true }, { "name": "Island", "tapped": true }, "Forest" ] } ],
   "steps": [ { "cast": "Pallimud" },
              { "resolve": true },
              { "advance_to": "Main2" } ],
   "expect": { "pt": { "Pallimud": [2, 3] } } },
 { "name": "no tapped lands for the opponent gives power 0",
   "players": [ { "hand": ["Pallimud"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Island", "Forest"] } ],
   "steps": [ { "cast": "Pallimud" },
              { "resolve": true },
              { "advance_to": "Main2" } ],
   "expect": { "pt": { "Pallimud": [0, 3] } } }
]
