    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "ruling: target gone in response, so no damage and no life gain",
    "players": [ { "hand": ["Zenith Flare", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Island", "Island"], "graveyard": ["Bebop, Warthog Warrior"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Zenith Flare", "targets": ["Grizzly Bears"] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
