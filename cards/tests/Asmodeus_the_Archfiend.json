[
  {
    "name": "draw replacement exiles the top card face down instead of drawing",
    "players": [ { "battlefield": ["Asmodeus the Archfiend", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "activate": "Asmodeus the Archfiend", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "library_count": 13 } ]
    }
  },
  {
    "name": "return all cards exiled with Asmodeus to hand and lose that much life",
    "players": [ { "battlefield": ["Asmodeus the Archfiend", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "activate": "Asmodeus the Archfiend", "ability": 0 },
      { "resolve": true },
      { "activate": "Asmodeus the Archfiend", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 13, "hand_count": 7, "library_count": 13 } ]
    }
  },
  {
    "name": "return with no exiled cards loses no life",
    "players": [ { "battlefield": ["Asmodeus the Archfiend", "Swamp"] }, {} ],
    "steps": [
      { "activate": "Asmodeus the Archfiend", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20, "hand_count": 0 } ]
    }
  },
  {
    "name": "ruling: cards exiled with Asmodeus stay exiled after Asmodeus dies (no return to hand)",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Asmodeus the Archfiend", "Swamp", "Swamp", "Swamp", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Asmodeus the Archfiend", "ability": 0 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Asmodeus the Archfiend"] },
      { "cast": "Lightning Bolt", "targets": ["Asmodeus the Archfiend"] },
      { "cast": "Lightning Bolt", "targets": ["Asmodeus the Archfiend"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "library_count": 13, "graveyard_has": ["Asmodeus the Archfiend"] }, {} ]
    }
  }
]
