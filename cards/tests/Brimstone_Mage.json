 { "name": "level 3: tap to deal 3 damage to any target",
   "players": [ { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Brimstone Mage"] }, {} ],
   "steps": [ { "activate": "Brimstone Mage", "ability": 0 }, { "resolve": true }, { "activate": "Brimstone Mage", "ability": 0 }, { "resolve": true }, { "activate": "Brimstone Mage", "ability": 0 }, { "resolve": true }, { "activate": "Brimstone Mage", "ability": 2, "targets": ["p1"] }, { "resolve": true } ],
