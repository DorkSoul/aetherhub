   "steps": [ { "activate": "Brimstone Mage", "ability": 0 }, { "resolve": true }, { "activate": "Brimstone Mage", "ability": 2, "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "level 1 is a 2/3 (the level 1-2 base P/T static)",
