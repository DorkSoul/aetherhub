   "steps": [ { "activate": "Brimstone Mage", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Brimstone Mage": [2, 3] } } },
 { "name": "ruling: a pump effect applies to a leveler whatever its level when it started",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Brimstone Mage"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Brimstone Mage"] }, { "resolve": true }, { "activate": "Brimstone Mage", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Brimstone Mage": [5, 6] } } },
 { "name": "ruling: level up stays available at level 3 (it is not overwritten by the level abilities)",
