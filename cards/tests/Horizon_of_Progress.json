[
  {
    "name": "taps for a colour a land could produce, paying 1 life",
    "players": [{ "battlefield": ["Horizon of Progress", "Forest"] }, {}],
    "steps": [{ "tap_for_mana": "Horizon of Progress" }],
    "expect": { "players": [{ "pool": { "G": 1 }, "life": 19 }, {}] }
  },
  {
    "name": "taps for colorless when a land could produce colorless",
    "players": [{ "battlefield": ["Horizon of Progress", "Wastes"] }, {}],
    "steps": [{ "tap_for_mana": "Horizon of Progress" }],
    "expect": { "players": [{ "pool": { "C": 1 }, "life": 19 }, {}] }
  },
  {
    "name": "puts any land card from hand onto the battlefield tapped",
    "players": [
      { "hand": ["Command Tower", "Grizzly Bears"], "battlefield": ["Horizon of Progress", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [{ "activate": "Horizon of Progress" }, { "resolve": true, "answers": ["Command Tower"] }],
    "expect": {
      "players": [{ "hand": ["Grizzly Bears"], "battlefield_has": ["Command Tower"] }, {}],
      "tapped": { "Command Tower": true, "Horizon of Progress": true }
    }
  },
  {
    "name": "sacrifice to draw a card",
    "players": [{ "library": ["Island"], "battlefield": ["Horizon of Progress", "Plains"] }, {}],
    "steps": [{ "activate": "Horizon of Progress", "ability": 1 }, { "resolve": true }],
    "expect": { "players": [{ "hand": ["Island"], "graveyard": ["Horizon of Progress"] }, {}] }
  },
  {
    "name": "ruling: produces white when a Plains could produce white",
    "players": [{ "battlefield": ["Horizon of Progress", "Plains"] }, {}],
    "steps": [{ "tap_for_mana": "Horizon of Progress", "color": "W" }],
    "expect": { "players": [{ "pool": { "W": 1 }, "life": 19 }, {}] }
  },
  {
    "name": "ruling: a Spire of Industry's colour counts even while its artifact condition is unmet",
    "players": [{ "battlefield": ["Horizon of Progress", "Spire of Industry"] }, {}],
    "steps": [{ "tap_for_mana": "Horizon of Progress", "color": "R" }],
    "expect": { "players": [{ "pool": { "R": 1 }, "life": 19 }, {}] }
  }
]
