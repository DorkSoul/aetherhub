   { "hand": ["Lightning Bolt", "Grizzly Bears", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest"] },
   { "hand": ["Second Guess"], "battlefield": ["Island", "Island"] }
