[
 { "name": "entering creates a 2/2 red Soldier token with firebending 1",
   "players": [ { "hand": ["Fire Nation Occupation"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
   "steps": [ { "cast": "Fire Nation Occupation" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Fire Nation Occupation", "Soldier 2-2 Red Firebending"] }, {} ], "pt": { "Soldier 2-2 Red Firebending": [2, 2] } } },
