   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fire Nation Occupation", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Fire Nation Occupation"] }, { "life": 17 } ] } },
 { "name": "casting a spell during an opponent's turn creates a 2/2 red Soldier token with firebending 1",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fire Nation Occupation", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Fire Nation Occupation", "Soldier 2-2 Red Firebending"] }, { "life": 17 } ], "pt": { "Soldier 2-2 Red Firebending": [2, 2] } } },
 { "name": "ruling: two firebending triggers (two attackers) each add R, giving RR",
   "players": [ { "battlefield": ["Fire Nation Occupation", "Soldier 2-2 Red Firebending", "Soldier 2-2 Red Firebending"] }, {} ],
   "steps": [ { "attack": [ { "card": "Soldier 2-2 Red Firebending", "at": "p1" }, { "card": "Soldier 2-2 Red Firebending", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "players": [ { "pool": { "R": 2 } }, {} ] } },
 { "name": "ruling: firebending mana is still usable after combat damage",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fire Nation Occupation", "Soldier 2-2 Red Firebending"] }, {} ],
   "steps": [ { "attack": [ { "card": "Soldier 2-2 Red Firebending", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "CombatDamage" }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "pool": { "R": 0 } }, { "life": 15 } ] } },
 { "name": "ruling: firebending mana is lost when leaving combat (not usable in the second main phase)",
   "players": [ { "battlefield": ["Fire Nation Occupation", "Soldier 2-2 Red Firebending"] }, {} ],
   "steps": [ { "attack": [ { "card": "Soldier 2-2 Red Firebending", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": { "R": 0 } }, {} ] } },
 { "name": "ruling: firebending is a triggered ability that can be responded to; a Bolt on the attacker still lets the R be added",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fire Nation Occupation", "Soldier 2-2 Red Firebending", "Mountain"] }, {} ],
   "steps": [ { "attack": [ { "card": "Soldier 2-2 Red Firebending", "at": "p1" } ] }, { "cast": "Lightning Bolt", "targets": ["Soldier 2-2 Red Firebending"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "battlefield_lacks": ["Soldier 2-2 Red Firebending"], "pool": { "R": 1 } }, { "life": 20 } ] } },
 { "name": "ruling: other mana added during combat is lost when the step ends, firebending mana is kept",
   "players": [ { "battlefield": ["Fire Nation Occupation", "Soldier 2-2 Red Firebending", "Mountain"] }, {} ],
   "steps": [ { "attack": [ { "card": "Soldier 2-2 Red Firebending", "at": "p1" } ] }, { "resolve": true }, { "tap_for_mana": "Mountain" }, { "advance_to": "CombatDamage" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, {} ] } }
