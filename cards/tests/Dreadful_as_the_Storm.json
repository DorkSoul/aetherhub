   "players": [ { "hand": ["Dreadful as the Storm"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Dreadful as the Storm", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "command": ["The Ring 1"] }, {} ], "pt": { "Hill Giant": [5, 5] } } },
