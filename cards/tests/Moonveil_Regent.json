[
  {
    "name": "cast: discard hand, draw a card per color of the spell",
    "players": [
      { "hand": ["Lightning Bolt", "Forest", "Forest"], "library": ["Island", "Island", "Island"], "battlefield": ["Moonveil Regent", "Mountain"] },
      {}
    ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Lightning Bolt", "Forest", "Forest"] }, { "life": 17 } ] }
  },
  {
    "name": "dies: X damage where X is the number of colors among your permanents",
    "players": [
      { "battlefield": ["Moonveil Regent", "Hill Giant", "Grizzly Bears"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "cast": "Murder", "player": 1, "targets": ["Moonveil Regent"] },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": { "players": [ { "graveyard": ["Moonveil Regent"] }, { "life": 18 } ] }
  },
  {
    "name": "ruling: empty hand, you may still discard and draw one card per colour of the spell",
    "players": [
      { "hand": ["Lightning Bolt"], "library": ["Island", "Island"], "battlefield": ["Moonveil Regent", "Mountain"] },
      {}
    ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] }
  },
  {
    "name": "ruling: a colourless spell lets you discard your hand but draws no cards",
    "players": [
      { "hand": ["Ornithopter", "Forest", "Forest"], "library": ["Island"], "battlefield": ["Moonveil Regent"] },
      {}
    ],
    "steps": [ { "cast": "Ornithopter" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Forest", "Forest"], "battlefield_has": ["Ornithopter"] }, {} ] }
  },
  {
    "name": "ruling: with no coloured permanents left, the death trigger deals 0 damage (colourless only)",
    "players": [
      { "battlefield": ["Moonveil Regent", "Mountain"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Savannah Lions"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "cast": "Murder", "player": 1, "targets": ["Moonveil Regent"] },
      { "resolve": true, "targets": ["Savannah Lions"] }
    ],
    "expect": { "players": [ { "graveyard": ["Moonveil Regent"] }, { "battlefield_has": ["Savannah Lions"], "life": 20 } ] }
  }
]
