[
  {
    "name": "commander gets the granted end step trigger when a creature card went to your graveyard this turn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Cloakwood Hermit", "Mountain", "Mountain", "Forest", "Forest", "Forest", "Grizzly Bears"], "command": ["Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant", "Squirrel 1-1 Green"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "no creature card in your graveyard this turn means no squirrels",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Cloakwood Hermit", "Mountain", "Mountain", "Forest", "Forest", "Forest"], "command": ["Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant", "Cloakwood Hermit"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the granted trigger counts a creature card that hit the graveyard before the Hermit entered",
    "players": [
      { "hand": ["Lightning Bolt", "Cloakwood Hermit"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Forest", "Forest", "Forest"], "command": ["Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Cloakwood Hermit" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant", "Cloakwood Hermit", "Squirrel 1-1 Green", "Squirrel 1-1 Green"], "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] },
