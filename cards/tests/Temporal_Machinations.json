[
  {
    "name": "bounces the creature and draws when you control an artifact",
    "players": [
      { "hand": ["Temporal Machinations"], "battlefield": ["Island", "Island", "Island", "Sol Ring"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Temporal Machinations", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Temporal Machinations"] },
        { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "no artifact: bounces but draws nothing",
    "players": [
      { "hand": ["Temporal Machinations"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Temporal Machinations", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "the target is the only artifact you control: no draw after it leaves",
    "players": [
      { "hand": ["Temporal Machinations"], "battlefield": ["Island", "Island", "Island", "Ornithopter"] },
      {}
    ],
    "steps": [
      { "cast": "Temporal Machinations", "targets": ["Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "hand": ["Ornithopter"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: target gone in response, spell does not resolve and no card is drawn",
    "players": [
      { "hand": ["Temporal Machinations"], "battlefield": ["Island", "Island", "Island", "Sol Ring", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Temporal Machinations", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Temporal Machinations", "Grizzly Bears"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]
