[
  { "name": "a spell targeting it puts a +1/+1 counter on it",
    "players": [ { "hand": ["Giant Growth"], "battlefield": [{ "name": "Tenth District Legionnaire", "sick": false }, "Forest"] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Tenth District Legionnaire"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tenth District Legionnaire"] }, {} ], "counters": { "Tenth District Legionnaire": { "p1p1": 1 } } } },
  { "name": "a spell that doesn't target it does not trigger",
    "players": [ { "hand": ["Giant Growth"], "battlefield": [{ "name": "Tenth District Legionnaire", "sick": false }, { "name": "Grizzly Bears", "sick": false }, "Forest"] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tenth District Legionnaire"] }, {} ], "counters": { "Tenth District Legionnaire": { "p1p1": 0 } } } },
  { "name": "ruling: scry still happens when the counter cannot be put on the creature",
    "players": [ { "hand": ["Giant Growth"], "battlefield": [{ "name": "Tenth District Legionnaire", "sick": false }, "Forest"], "library": ["Island", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Tenth District Legionnaire"] }, { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["Tenth District Legionnaire"] }, { "resolve": true, "answers": [[0]] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "library_top": ["Grizzly Bears"], "graveyard": ["Giant Growth", "Tenth District Legionnaire"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: the trigger resolves before the spell and its counter stays even if the spell is countered",
    "players": [ { "hand": ["Giant Growth"], "battlefield": [{ "name": "Tenth District Legionnaire", "sick": false }, "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Tenth District Legionnaire"] }, { "pass": true }, { "player": 1, "cast": "Counterspell", "targets": [{ "stack": "Giant Growth" }] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tenth District Legionnaire"], "graveyard": ["Giant Growth"] }, { "graveyard": ["Counterspell"] } ], "counters": { "Tenth District Legionnaire": { "p1p1": 1 } } } }
]
