[
 { "name": "reanimates a creature card from an opponent's graveyard with a corpse counter",
   "players": [ { "hand": ["From the Catacombs"], "battlefield": ["Swamp","Swamp","Swamp","Swamp","Swamp"] }, { "graveyard": ["Hill Giant"] } ],
   "steps": [ { "cast": "From the Catacombs", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "graveyard": [] } ],
     "counters": { "Hill Giant": { "corpse": 1 } }, "pt": { "Hill Giant": [3, 3] } } },
 { "name": "the returned creature is exiled instead of dying",
   "players": [ { "hand": ["From the Catacombs", "Lightning Bolt"], "battlefield": ["Swamp","Swamp","Swamp","Swamp","Swamp","Mountain"] }, { "graveyard": ["Hill Giant"] } ],
   "steps": [ { "cast": "From the Catacombs", "targets": ["Hill Giant"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Hill Giant"] }, { "exile": ["Hill Giant"] } ] } },
 { "name": "escape from the graveyard exiles five other cards",
   "players": [ { "graveyard": ["From the Catacombs", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["Swamp","Swamp","Swamp","Swamp","Swamp"] }, { "graveyard": ["Hill Giant"] } ],
   "steps": [ { "cast": "From the Catacombs", "alt": 0, "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": [], "graveyard": ["From the Catacombs"] }, { "graveyard": [] } ], "counters": { "Hill Giant": { "corpse": 1 } } } },
 { "name": "ruling: taking the initiative with no dungeon puts Undercity and The Initiative in the command zone",
   "players": [ { "hand": ["From the Catacombs"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Hill Giant"] } ],
   "steps": [ { "cast": "From the Catacombs", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "command": ["The Initiative", "Undercity"] }, { "command": [] } ] } },
 { "name": "ruling: combat damage to the initiative holder moves the initiative to the attacking player",
   "players": [ { "hand": ["From the Catacombs"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Hill Giant"], "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "From the Catacombs", "targets": ["Hill Giant"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 }, { "pass": true, "player": 1 }, { "pass": true }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "command": ["Undercity"] }, { "command": ["The Initiative", "Undercity"] } ] } },
 { "name": "ruling: the initiative holder ventures again at the beginning of its upkeep (Secret Entrance to Forge)",
   "players": [ { "hand": ["From the Catacombs"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Hill Giant"] } ],
   "steps": [ { "cast": "From the Catacombs", "targets": ["Hill Giant"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": ["Forge"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "command": ["The Initiative", "Undercity"] }, {} ], "pt": { "Hill Giant": [5, 5] } } },
 { "name": "ruling: escape needs five other cards in the graveyard",
   "players": [ { "graveyard": ["From the Catacombs", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Hill Giant"] } ],
   "steps": [ { "cast": "From the Catacombs", "alt": 0, "targets": ["Hill Giant"], "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["From the Catacombs", "Forest", "Forest", "Forest", "Forest"] }, { "graveyard": ["Hill Giant"] } ] } },
 { "name": "ruling: escape still costs {3}{B}{B} plus the exile, so four lands are not enough",
   "players": [ { "graveyard": ["From the Catacombs", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Hill Giant"] } ],
   "steps": [ { "cast": "From the Catacombs", "alt": 0, "targets": ["Hill Giant"], "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["From the Catacombs", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "graveyard": ["Hill Giant"] } ] } },
 { "name": "ruling: the spell returns to the graveyard and can be escaped again straight away",
   "players": [ { "graveyard": ["From the Catacombs", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Hill Giant", "Grizzly Bears"] } ],
   "steps": [ { "cast": "From the Catacombs", "alt": 0, "targets": ["Hill Giant"], "auto": true }, { "resolve": true }, { "cast": "From the Catacombs", "alt": 0, "targets": ["Grizzly Bears"], "auto": true }, { "resolve": true, "answers": ["Forge"], "targets": ["Grizzly Bears"] } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant", "Grizzly Bears"], "graveyard": ["From the Catacombs"], "command": ["The Initiative", "Undercity"] }, { "graveyard": [] } ] } }
]
