[
 {"name": "counters an activated ability of an artifact",
  "players": [
   {"battlefield": ["Bonesplitter", "Grizzly Bears", "Swamp"]},
   {"hand": ["Rust"], "battlefield": ["Forest"]}],
  "steps": [
   {"activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"]},
   {"pass": true},
   {"cast": "Rust", "player": 1, "targets": [{"stack": "Bonesplitter"}]},
   {"resolve": true}],
  "expect": {"players": [{}, {"graveyard": ["Rust"]}]}},
 {"name": "does not counter an activated ability of a non-artifact",
  "players": [
   {"battlefield": ["Prodigal Pyromancer"]},
   {"hand": ["Rust"], "battlefield": ["Forest"]}],
  "steps": [
   {"activate": "Prodigal Pyromancer", "targets": ["p1"]},
   {"pass": true},
   {"cast": "Rust", "player": 1, "illegal": true, "targets": [{"stack": "Prodigal Pyromancer"}]}],
  "expect": {"players": [{}, {"hand": ["Rust"]}]}},
 {"name": "ruling: a mana ability never uses the stack, so there is nothing to target",
  "players": [
   {"battlefield": ["Sol Ring", "Forest"]},
   {"hand": ["Rust"], "battlefield": ["Forest"]}],
  "steps": [
   {"tap_for_mana": "Sol Ring", "color": "C"},
   {"pass": true},
   {"cast": "Rust", "player": 1, "illegal": true}],
  "expect": {"players": [{}, {"hand": ["Rust"]}]}},
 {"name": "does not counter a spell",
  "players": [
   {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]},
   {"hand": ["Rust"], "battlefield": ["Forest"]}],
  "steps": [
   {"cast": "Lightning Bolt", "targets": ["p1"]},
   {"pass": true},
   {"cast": "Rust", "player": 1, "illegal": true, "targets": [{"stack": "Lightning Bolt"}]}],
  "expect": {"players": [{}, {"hand": ["Rust"]}]}}
]
