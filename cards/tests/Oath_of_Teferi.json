[
 {"name": "a planeswalker can activate a loyalty ability twice, not three times",
  "players": [{"battlefield": ["Oath of Teferi", {"name": "Jace Beleren", "sick": false}]}, {}],
  "steps": [{"activate": "Jace Beleren", "ability": 0}, {"resolve": true}, {"activate": "Jace Beleren", "ability": 0}, {"resolve": true},
            {"activate": "Jace Beleren", "ability": 0, "illegal": true}],
  "expect": {"counters": {"Jace Beleren": {"loyalty": 7}}}},
 {"name": "without the Oath only one activation",
  "players": [{"battlefield": [{"name": "Jace Beleren", "sick": false}]}, {}],
  "steps": [{"activate": "Jace Beleren", "ability": 0}, {"resolve": true}, {"activate": "Jace Beleren", "ability": 0, "illegal": true}],
  "expect": {"counters": {"Jace Beleren": {"loyalty": 5}}}},
 {"name": "ETB exiles another permanent you control and returns it at the end step",
  "players": [{"hand": ["Oath of Teferi"], "battlefield": ["Plains","Plains","Plains","Island","Island","Grizzly Bears"]}, {}],
  "steps": [{"cast": "Oath of Teferi"}, {"resolve": true, "targets": ["Grizzly Bears"]}, {"resolve": true}],
  "expect": {"players": [{"exile": ["Grizzly Bears"]}, {}]}},
 {"name": "ruling: an exiled token ceases to exist and does not return at the end step",
  "players": [{"hand": ["Oath of Teferi"], "battlefield": ["Plains","Plains","Plains","Island","Island","Cat 2-2"]}, {}],
  "steps": [{"cast": "Oath of Teferi"}, {"resolve": true, "targets": ["Cat 2-2"]}, {"advance_to": "End"}],
  "expect": {"players": [{"battlefield_has": ["Oath of Teferi"], "battlefield_lacks": ["Cat 2-2"]}, {}]}},
 {"name": "ruling: with the Oath, two different loyalty abilities can be used in one turn (but not a third)",
  "players": [{"battlefield": ["Oath of Teferi", {"name": "Jace Beleren", "sick": false}]}, {}],
  "steps": [{"activate": "Jace Beleren", "ability": 0}, {"resolve": true},
            {"activate": "Jace Beleren", "ability": 1, "targets": ["p0"]}, {"resolve": true},
            {"activate": "Jace Beleren", "ability": 0, "illegal": true}],
  "expect": {"counters": {"Jace Beleren": {"loyalty": 4}}}},
 {"name": "ruling: the exiled card returns at the end step even after the Oath is destroyed",
  "players": [{"hand": ["Oath of Teferi", "Disenchant"], "battlefield": ["Plains","Plains","Plains","Plains","Plains","Island","Island","Island","Grizzly Bears"]}, {}],
  "steps": [{"cast": "Oath of Teferi"}, {"resolve": true, "targets": ["Grizzly Bears"]},
            {"cast": "Disenchant", "targets": ["Oath of Teferi"]}, {"resolve": true},
            {"advance_to": "End"}],
  "expect": {"players": [{"battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Oath of Teferi"]}, {}]}}
]
