[
  { "name": "behold a Jace from hand: counter the spell and empower a new Jace token",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Countersculpt", "Jace, the Mind Sculptor"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Countersculpt", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [0] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "hand": ["Jace, the Mind Sculptor"], "graveyard": ["Countersculpt"], "battlefield_has": ["Jace"] } ],
                "counters": { "Jace": { "loyalty": 1 } }, "stack_empty": true } },
  { "name": "no Jace: pay {1} instead, and a new Jace token is still created",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Countersculpt"], "battlefield": ["Island", "Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Countersculpt", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [1] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Countersculpt"], "battlefield_has": ["Jace"] } ],
                "counters": { "Jace": { "loyalty": 1 } }, "stack_empty": true } },
  { "name": "no Jace and only two lands: cannot pay {U}{U} plus {1}",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Countersculpt"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Countersculpt", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "illegal": true } ],
    "expect": { "players": [ {}, { "hand": ["Countersculpt"] } ], "stack_empty": false } },
  { "name": "behold the Jace you control on the battlefield: it is empowered and stays put",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Countersculpt"], "battlefield": ["Island", "Island", "Island", "Jace"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Countersculpt", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [0] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Countersculpt"], "battlefield_has": ["Jace"] } ],
                "counters": { "Jace": { "loyalty": 1 } }, "stack_empty": true } }
]
