[
  { "name": "combat damage to a player puts a quest counter on the dealing creature",
    "players": [ { "battlefield": ["Duchess, Wayward Tavernkeep", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ], "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "remove a quest counter from a permanent you control to create a Junk token",
    "players": [ { "battlefield": [ { "name": "Duchess, Wayward Tavernkeep", "counters": { "quest": 1 } }, "Swamp", "Swamp" ] }, {} ],
    "steps": [ { "activate": "Duchess, Wayward Tavernkeep", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Duchess, Wayward Tavernkeep", "Junk"] }, {} ] } },
  { "name": "no quest counter means no Junk",
    "players": [ { "battlefield": ["Duchess, Wayward Tavernkeep", "Swamp"] }, {} ],
    "steps": [ { "activate": "Duchess, Wayward Tavernkeep", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Junk"] }, {} ] } },
  { "name": "ruling: a land exiled with a Junk token can be played only in a main phase",
    "players": [ { "battlefield": [ { "name": "Duchess, Wayward Tavernkeep", "counters": { "quest": 1 } }, "Swamp" ], "library": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Duchess, Wayward Tavernkeep", "ability": 0 }, { "resolve": true }, { "activate": "Junk", "ability": 0 }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "play_land": "Mountain", "illegal": true }, { "advance_to": "Main2" }, { "play_land": "Mountain" } ],
    "expect": { "players": [ { "battlefield_has": ["Mountain"], "battlefield_lacks": ["Junk"] }, {} ] } }
]
