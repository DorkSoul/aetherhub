[
  {
    "name": "living weapon: the 0/0 Germ is equipped and becomes 0/1",
    "players": [ { "hand": ["Mortarpod"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Mortarpod" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Phyrexian Germ": [0, 1] }, "attached": { "Mortarpod": "Phyrexian Germ" } }
  },
  {
    "name": "equip {2} gives the creature +0/+1",
    "players": [ { "battlefield": ["Mortarpod", "Grizzly Bears", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Mortarpod", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 3] }, "attached": { "Mortarpod": "Grizzly Bears" } }
  },
  {
    "name": "equip needs two mana",
    "players": [ { "battlefield": ["Mortarpod", "Grizzly Bears", "Island"] }, {} ],
    "steps": [ { "activate": "Mortarpod", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "the equipped Germ can sacrifice itself to deal 1 damage to any target",
    "players": [ { "hand": ["Mortarpod"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Mortarpod" }, { "resolve": true }, { "resolve": true },
               { "activate": "Phyrexian Germ", "ability": 32768, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mortarpod"], "battlefield_lacks": ["Phyrexian Germ"] }, { "life": 19 } ] }
  },
  {
    "name": "ruling: moving the equipment off the Germ puts the 0/0 Germ into the graveyard (it ceases to exist)",
    "players": [ { "hand": ["Mortarpod"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Mortarpod" }, { "resolve": true }, { "resolve": true },
               { "activate": "Mortarpod", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mortarpod", "Grizzly Bears"], "battlefield_lacks": ["Phyrexian Germ"] }, {} ], "pt": { "Grizzly Bears": [2, 3] } }
  },
  {
    "name": "ruling: destroying the Germ leaves the Equipment on the battlefield",
    "players": [ { "hand": ["Mortarpod", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Mortarpod" }, { "resolve": true }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["Phyrexian Germ"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mortarpod"], "battlefield_lacks": ["Phyrexian Germ"], "graveyard_has": ["Lightning Bolt"] }, {} ] }
  }
]
