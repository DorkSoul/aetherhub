      {
        "hand": [
          "Wrath of God"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          {
            "name": "Plague Belcher",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Wrath of God"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Plague Belcher"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "another Zombie you control dies: each opponent loses 1 life",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Plague Belcher", "Diregraf Ghoul"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Diregraf Ghoul"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Plague Belcher"], "graveyard_has": ["Diregraf Ghoul"] }, { "life": 19 }]
    }
  },
  {
    "name": "a non-Zombie creature dying does not drain",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Plague Belcher", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Plague Belcher"], "graveyard_has": ["Grizzly Bears"] }, { "life": 20 }]
    }
  },
  {
    "name": "ruling: another Zombie dying at the same time as Plague Belcher still triggers its ability",
    "players": [
      {
        "hand": ["Wrath of God"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", { "name": "Plague Belcher", "sick": false }, "Diregraf Ghoul"]
      },
      {}
    ],
    "steps": [
      { "cast": "Wrath of God" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Plague Belcher", "Diregraf Ghoul"] }, { "life": 19 }]
    }
  }
