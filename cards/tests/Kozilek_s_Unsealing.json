[
  {
    "name": "casting a creature spell with mana value 5 creates two Eldrazi Spawn",
    "players": [ { "hand": ["Serra Angel"], "battlefield": ["Kozilek's Unsealing", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Serra Angel" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Serra Angel", "Eldrazi Spawn", "Eldrazi Spawn"] }, {} ] }
  },
  {
    "name": "a noncreature spell does not trigger it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Kozilek's Unsealing", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Eldrazi Spawn"] }, { "life": 17 } ] }
  },
  {
    "name": "casting a creature spell with mana value 7 draws three cards",
    "players": [ { "hand": ["Elderscale Wurm"], "battlefield": ["Kozilek's Unsealing", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Elderscale Wurm" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 3, "battlefield_has": ["Elderscale Wurm"] }, {} ] }
  },
  {
    "name": "a creature spell with mana value 4 makes spawn tokens and draws nothing",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Kozilek's Unsealing", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Hill Giant" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Hill Giant", "Eldrazi Spawn", "Eldrazi Spawn"] }, {} ] }
  },
  {
    "name": "ruling: the creature-cast trigger resolves even if the creature spell is countered",
    "players": [ { "hand": ["Carnifex Demon"], "battlefield": ["Kozilek's Unsealing", "Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Carnifex Demon" }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Carnifex Demon" }] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Carnifex Demon"], "battlefield_has": ["Eldrazi Spawn", "Eldrazi Spawn"] }, { "graveyard_has": ["Counterspell"] } ] }
  },
  {
    "name": "ruling: X is chosen on cast, so X=2 gives mana value 4 and makes spawn tokens",
    "players": [ { "hand": ["Walking Ballista"], "battlefield": ["Kozilek's Unsealing", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Walking Ballista", "answers": [2] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Walking Ballista", "Eldrazi Spawn", "Eldrazi Spawn"] }, {} ] }
  },
  {
    "name": "ruling: X is chosen on cast, so X=4 gives mana value 8 and draws three cards",
    "players": [ { "hand": ["Walking Ballista"], "battlefield": ["Kozilek's Unsealing", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Walking Ballista", "answers": [4] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 3, "battlefield_has": ["Walking Ballista"] }, {} ] }
  }
]
