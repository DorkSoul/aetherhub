[
  {
    "name": "a creature it blocks cannot regenerate this turn",
    "players": [ { "battlefield": ["Swamp", "Drudge Skeletons"] }, { "battlefield": ["Lim-Dûl's Cohort"] } ],
    "steps": [
      { "attack": [ { "card": "Drudge Skeletons", "at": "p1" } ] },
      { "block": [ { "blocker": "Lim-Dûl's Cohort", "attacker": "Drudge Skeletons" } ] },
      { "activate": "Drudge Skeletons", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Drudge Skeletons"] }, { "battlefield_has": ["Lim-Dûl's Cohort"] } ]
    }
  },
  {
    "name": "control: a creature blocked by an ordinary creature can still regenerate",
    "players": [ { "battlefield": ["Swamp", "Drudge Skeletons"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Drudge Skeletons", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Drudge Skeletons" } ] },
      { "activate": "Drudge Skeletons", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Drudge Skeletons"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Drudge Skeletons": true }
    }
  },
  {
    "name": "becomes blocked by a creature: the blocker cannot regenerate this turn",
    "players": [ { "battlefield": ["Swamp", "Lim-Dûl's Cohort"] }, { "battlefield": ["Swamp", "Drudge Skeletons"] } ],
    "steps": [
      { "attack": [ { "card": "Lim-Dûl's Cohort", "at": "p1" } ] },
      { "block": [ { "blocker": "Drudge Skeletons", "attacker": "Lim-Dûl's Cohort" } ] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Drudge Skeletons", "ability": 0, "player": 1 },
      { "resolve": true, "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Lim-Dûl's Cohort"] }, { "graveyard_has": ["Drudge Skeletons"] } ]
    }
  },
  {
    "name": "control: an ordinary attacker blocked by Drudge Skeletons can still regenerate it",
    "players": [ { "battlefield": ["Swamp", "Grizzly Bears"] }, { "battlefield": ["Swamp", "Drudge Skeletons"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Drudge Skeletons", "attacker": "Grizzly Bears" } ] },
      { "pass": true },
      { "activate": "Drudge Skeletons", "ability": 0, "player": 1 },
      { "resolve": true, "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Drudge Skeletons"] } ]
    }
  }
]
