[
  {
    "name": "becomes unblockable when you own a card in exile",
    "players": [
      { "battlefield": ["Dreadlight Monstrosity", "Island", "Island", "Island", "Island", "Island"], "exile": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Dreadlight Monstrosity" },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Dreadlight Monstrosity": ["Unblockable"] }
    }
  },
  {
    "name": "cannot activate when the only exiled card is an opponent's",
    "players": [
      { "battlefield": ["Dreadlight Monstrosity", "Island", "Island", "Island", "Island", "Island"] },
      { "exile": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Dreadlight Monstrosity", "illegal": true }
    ],
    "expect": {
      "keywords": { "Dreadlight Monstrosity": [] }
    }
  },
  {
    "name": "ward {2}: the opponent has only 2 Plains, cannot pay the extra 2, Swords is countered and the Monstrosity stays",
    "players": [
      { "battlefield": ["Dreadlight Monstrosity"] },
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Swords to Plowshares", "targets": ["Dreadlight Monstrosity"], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Dreadlight Monstrosity"] }, { "graveyard_has": ["Swords to Plowshares"] } ] }
  },
  {
    "name": "ward {2}: the opponent pays 2 more with three Plains, Swords exiles the Monstrosity",
    "players": [
      { "battlefield": ["Dreadlight Monstrosity"] },
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Swords to Plowshares", "targets": ["Dreadlight Monstrosity"], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Dreadlight Monstrosity"] }, { "graveyard_has": ["Swords to Plowshares"] } ] }
  }
]
