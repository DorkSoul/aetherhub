[
  {
    "name": "exiles a creature; its controller creates a Clue",
    "players": [
      { "hand": ["Zuko's Exile"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Zuko's Exile", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Zuko's Exile"] },
        { "exile": ["Grizzly Bears"], "battlefield_has": ["Clue"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "a land is not a legal target",
    "players": [
      { "hand": ["Zuko's Exile"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Zuko's Exile", "targets": ["Forest"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Zuko's Exile"] }, { "battlefield_has": ["Forest"] } ]
    }
  },
  {
    "name": "ruling: the Clue token can be sacrificed for {2} to draw a card",
    "players": [
      { "hand": ["Zuko's Exile"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Zuko's Exile", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Clue", "player": 1, "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Zuko's Exile"] },
        { "hand_count": 1, "battlefield_lacks": ["Clue", "Grizzly Bears"], "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the Clue from Zuko's Exile is not an investigate (opponent's Erdwal Illuminator does not trigger)",
    "players": [
      { "hand": ["Zuko's Exile"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Erdwal Illuminator"] }
    ],
    "steps": [
      { "cast": "Zuko's Exile", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Zuko's Exile"] },
        { "battlefield": ["Erdwal Illuminator", "Clue"] }
      ]
    }
  }
]
