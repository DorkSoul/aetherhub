[
 {
  "name": "noncreature spell makes a Monk and pumps via prowess",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Monastery Mentor",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
