    ]
   }
  }
 },
 {
  "name": "ruling: playing a land does not trigger prowess",
  "players": [
   { "hand": ["Forest"], "battlefield": ["Monastery Mentor"] },
   {}
  ],
  "steps": [
   { "play_land": "Forest" }
  ],
  "expect": {
   "players": [ { "battlefield_lacks": ["Monk 1-1 Prowess"] }, {} ],
   "pt": { "Monastery Mentor": [2, 2] }
  }
 },
 {
  "name": "ruling: an artifact creature spell does not trigger prowess or make a Monk",
  "players": [
   { "hand": ["Ornithopter"], "battlefield": ["Monastery Mentor"] },
   {}
  ],
  "steps": [
   { "cast": "Ornithopter" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Ornithopter"], "battlefield_lacks": ["Monk 1-1 Prowess"] }, {} ],
   "pt": { "Monastery Mentor": [2, 2] }
  }
 },
 {
  "name": "ruling: prowess still resolves when the noncreature spell is countered",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Monastery Mentor", "Mountain"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Shock", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Shock" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Monastery Mentor", "Monk 1-1 Prowess"], "graveyard_has": ["Shock"] },
    { "life": 20, "graveyard_has": ["Counterspell"] }
   ],
   "pt": { "Monastery Mentor": [3, 3] }
  }
 },
 {
  "name": "ruling: the Monk made by a spell does not get that spell's prowess trigger",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Monastery Mentor", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ {}, { "life": 17 } ],
   "pt": { "Monk 1-1 Prowess": [1, 1] }
  }
 }
]