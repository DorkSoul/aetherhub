   {
    "hand": [
     "Grizzly Bears"
    ],
    "battlefield": [
     "Monastery Mentor",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Grizzly Bears"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": [
      "Monk 1-1 Prowess"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "Monk token has prowess too",
  "players": [
   {
    "hand": [
     "Giant Growth"
    ],
    "battlefield": [
     "Monk 1-1 Prowess",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Giant Growth",
    "targets": [
     "Monk 1-1 Prowess"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {}
   ],
   "pt": {
