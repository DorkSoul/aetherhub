[
  {
    "name": "a token copy of each creature the target player controls, with haste",
    "players": [
      { "hand": ["Face Yourself"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Face Yourself", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears", "Hill Giant"] }, { "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ]
    }
  },
  {
    "name": "the copies are sacrificed at the end step",
    "players": [
      { "hand": ["Face Yourself"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Face Yourself", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Grizzly Bears", "Hill Giant"] }, { "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ]
    }
  }
]
