[
  {
    "name": "copies an instant that targets you, the copy keeps its target",
    "players": [
      { "battlefield": ["Mirror Sheen", "Island", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "activate": "Mirror Sheen", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [[0]] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 14 }, { "life": 20 }]
    }
  },
  {
    "name": "cannot copy a spell that does not target you",
    "players": [
      { "battlefield": ["Mirror Sheen", "Island", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p1"] },
      { "activate": "Mirror Sheen", "ability": 0, "illegal": true }
    ]
  },
  {
    "name": "ruling: you may copy your own spell that targets you",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mirror Sheen", "Island", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "activate": "Mirror Sheen", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [[0]] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 14 }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: the copy can be given a new target you choose",
    "players": [
      { "battlefield": ["Mirror Sheen", "Island", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "activate": "Mirror Sheen", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [[1]] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 17 }, { "life": 17 } ]
    }
  }
]
