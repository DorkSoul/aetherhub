[
  {
    "name": "combat damage to a blocking creature puts a -1/-1 counter and drains",
    "players": [
      {
        "battlefield": ["Obelisk Spider"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "attack": [ { "card": "Obelisk Spider", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Obelisk Spider" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 21 },
        { "life": 19, "battlefield": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "combat damage to a player puts no counter and does not drain",
    "players": [
      {
        "battlefield": ["Obelisk Spider"]
      },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Obelisk Spider", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "ruling: the blocker is killed by the Spider's damage, so the counter trigger does nothing and there is no drain",
    "players": [
      { "battlefield": ["Obelisk Spider"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [ { "card": "Obelisk Spider", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Obelisk Spider" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 20, "graveyard": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: the -1/-1 counter makes damage already marked on the blocker lethal (Grizzly Bears dies)",
    "players": [
      { "battlefield": ["Obelisk Spider"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Obelisk Spider", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Obelisk Spider" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 21 },
        { "life": 19, "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: Spider dies in the same combat damage step, so its last ability does not trigger (no drain)",
    "players": [
      { "battlefield": ["Obelisk Spider"] },
      { "battlefield": ["Craw Wurm"] }
    ],
    "steps": [
      { "attack": [ { "card": "Obelisk Spider", "at": "p1" } ] },
      { "block": [ { "blocker": "Craw Wurm", "attacker": "Obelisk Spider" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard": ["Obelisk Spider"] },
        { "life": 20, "battlefield": ["Craw Wurm"] }
      ],
      "pt": { "Craw Wurm": [5, 3] },
      "counters": { "Craw Wurm": { "MinusOneMinusOne": 1 } }
    }
  }
]
