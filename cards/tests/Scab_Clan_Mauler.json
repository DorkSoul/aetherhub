[
  { "name": "no damage to an opponent this turn: enters as a 1/1",
    "players": [ { "hand": ["Scab-Clan Mauler"], "battlefield": ["Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Scab-Clan Mauler" }, { "resolve": true } ],
    "expect": { "pt": { "Scab-Clan Mauler": [1, 1] } } },
  { "name": "an opponent was dealt damage this turn: enters with two +1/+1 counters (3/3)",
    "players": [ { "hand": ["Lightning Bolt", "Scab-Clan Mauler"], "battlefield": ["Mountain", "Mountain", "Forest"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Scab-Clan Mauler" }, { "resolve": true }
    ],
    "expect": { "pt": { "Scab-Clan Mauler": [3, 3] }, "players": [ {}, { "life": 17 } ] } },
  { "name": "damage to a creature does not count (1/1)",
    "players": [ { "hand": ["Lightning Bolt", "Scab-Clan Mauler"], "battlefield": ["Mountain", "Mountain", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Scab-Clan Mauler" }, { "resolve": true }
    ],
    "expect": { "pt": { "Scab-Clan Mauler": [1, 1] } } },
  { "name": "damage to yourself does not count (1/1)",
    "players": [ { "hand": ["Lightning Bolt", "Scab-Clan Mauler"], "battlefield": ["Mountain", "Mountain", "Forest"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true },
      { "cast": "Scab-Clan Mauler" }, { "resolve": true }
    ],
    "expect": { "pt": { "Scab-Clan Mauler": [1, 1] } } }
]
