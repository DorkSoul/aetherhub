   {
    "hand": [
     "Shock"
    ],
    "battlefield": [
     "Tithe Drinker",
     "Mountain",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Shock",
    "targets": [
     "p1"
    ]
