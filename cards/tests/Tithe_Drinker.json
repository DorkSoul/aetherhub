 {
  "name": "ruling: each extort trigger can be paid once, so two Tithe Drinkers drain twice",
  "players": [ { "hand": ["Shock"], "battlefield": ["Tithe Drinker", "Tithe Drinker", "Mountain", "Plains", "Plains"] }, {} ],
  "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true, "answers": [true, true], "auto": true } ],
  "expect": { "players": [ { "life": 22 }, { "life": 16 } ] }
 },
 {
  "name": "ruling: extort still resolves when the spell that triggered it is countered",
  "players": [ { "hand": ["Shock"], "battlefield": ["Tithe Drinker", "Mountain", "Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
  "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Shock" } ] }, { "resolve": true, "answers": [true] } ],
  "expect": { "players": [ { "life": 21, "graveyard": ["Shock"] }, { "life": 19, "graveyard": ["Counterspell"] } ] }
 },
 {
  "name": "ruling: an opponent whose life total cannot change gives no extort life",
  "players": [ { "hand": ["Shock"], "battlefield": ["Tithe Drinker", "Mountain", "Plains"] }, { "battlefield": ["Platinum Emperion"] } ],
  "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true, "answers": [true], "auto": true } ],
  "expect": { "players": [ { "life": 20 }, { "life": 20 } ] }
 }
]
