[
  { "name": "an opponent casting an instant turns it into a 4/4 Ape",
    "players": [ { "battlefield": ["Hidden Gibbons"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, {} ], "pt": { "Hidden Gibbons": [4, 4] } } },
  { "name": "your own instant does not trigger it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hidden Gibbons"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "ruling: it becomes a creature even if the instant is countered",
    "players": [ { "hand": ["Counterspell"], "battlefield": ["Hidden Gibbons", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] }, { "player": 1, "pass": true }, { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Counterspell"] }, { "life": 20, "graveyard_has": ["Lightning Bolt"] } ], "pt": { "Hidden Gibbons": [4, 4] } } },
  { "name": "ruling: it is a creature before the cast spell resolves (trigger resolves first)",
    "players": [ { "battlefield": ["Hidden Gibbons"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] }, { "player": 1, "pass": true }, { "pass": true } ],
    "expect": { "players": [ { "life": 20 }, {} ], "stack_empty": false, "pt": { "Hidden Gibbons": [4, 4] } } },
  { "name": "ruling: animated on the opponent's turn, it can attack on your next turn",
    "players": [ { "battlefield": ["Hidden Gibbons"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] }, { "player": 1, "pass": true }, { "pass": true }, { "player": 1, "pass": true }, { "pass": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Hidden Gibbons", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 17 }, { "life": 16 } ] } }
]
