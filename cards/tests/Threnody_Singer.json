[
  { "name": "enters and gives an opposing creature -X/-0 where X is your devotion to blue",
    "players": [ { "hand": ["Threnody Singer"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Threnody Singer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [1, 2] } } },
  { "name": "devotion counts other blue permanents",
    "players": [ { "hand": ["Threnody Singer"], "battlefield": ["Island", "Island", "Mulldrifter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Threnody Singer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [0, 2] } } },
  { "name": "ruling: an Aura I control on an opponent's creature counts toward my devotion",
    "players": [ { "hand": ["Claustrophobia", "Threnody Singer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Claustrophobia", "targets": ["Serra Angel"] }, { "resolve": true }, { "resolve": true }, { "cast": "Threnody Singer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Serra Angel": [1, 4] } } },
  { "name": "ruling: X is fixed when the trigger resolves; a later Aura on the creature does not change it",
    "players": [ { "hand": ["Threnody Singer", "Claustrophobia"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Threnody Singer" }, { "resolve": true }, { "resolve": true }, { "cast": "Claustrophobia", "targets": ["Serra Angel"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Serra Angel": [3, 4] } } },
  { "name": "ruling: generic mana in a permanent's cost (Wurmcoil Engine) does not count toward devotion",
    "players": [ { "hand": ["Threnody Singer"], "battlefield": ["Wurmcoil Engine", "Island", "Island"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Threnody Singer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Serra Angel": [3, 4] } } }
]
