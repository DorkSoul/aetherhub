[
  {
    "name": "unblocked combat damage to a player puts a +1/+1 counter on it",
    "players": [
      { "battlefield": ["Stromkirk Noble"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Stromkirk Noble", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 19 }],
      "counters": { "Stromkirk Noble": { "p1p1": 1 } },
      "pt": { "Stromkirk Noble": [2, 2] }
    }
  },
  {
    "name": "cannot be blocked by Humans: the Human has no legal block",
    "players": [
      { "battlefield": ["Stromkirk Noble"] },
      { "battlefield": ["Elite Vanguard"] }
    ],
    "steps": [
      { "attack": [{ "card": "Stromkirk Noble", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 19 }],
      "counters": { "Stromkirk Noble": { "p1p1": 1 } }
    }
  },
  {
    "name": "cannot be blocked by Humans: the Human's block is dropped, the other attacker is blocked",
    "players": [
      { "battlefield": ["Stromkirk Noble", "Grizzly Bears"] },
      { "battlefield": ["Elite Vanguard", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Stromkirk Noble", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Elite Vanguard", "attacker": "Stromkirk Noble" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 19 }],
      "counters": { "Stromkirk Noble": { "p1p1": 1 } }
    }
  }
]
