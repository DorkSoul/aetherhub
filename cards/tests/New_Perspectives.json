[
  {
    "name": "when it enters, draw three cards",
    "players": [
      { "hand": ["New Perspectives"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "New Perspectives" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 3 }, {} ] }
  },
  {
    "name": "with seven or more cards in hand, cycling costs {0}",
    "players": [
      { "hand": ["Aura Extraction", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["New Perspectives"] },
      {}
    ],
    "steps": [
      { "activate": "Aura Extraction", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Aura Extraction"], "hand_count": 7 }, {} ] }
  },
  {
    "name": "a colored cycling cost is also {0}",
    "players": [
      { "hand": ["Lonely Sandbar", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["New Perspectives"] },
      {}
    ],
    "steps": [
      { "activate": "Lonely Sandbar", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Lonely Sandbar"], "hand_count": 7 }, {} ] }
  },
  {
    "name": "with six cards in hand cycling costs its normal cost",
    "players": [
      { "hand": ["Aura Extraction", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["New Perspectives"] },
      {}
    ],
    "steps": [
      { "activate": "Aura Extraction", "ability": 0, "illegal": true }
    ],
    "expect": { "players": [ { "hand_count": 6 }, {} ] }
  },
  {
    "name": "the opponent's cycling is not free",
    "players": [
      { "battlefield": ["New Perspectives"] },
      { "hand": ["Aura Extraction", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Aura Extraction", "player": 1, "ability": 0, "illegal": true }
    ],
    "expect": { "players": [ {}, { "hand_count": 7 } ] }
  },
  {
    "name": "ruling: the card being cycled counts toward the seven cards in hand (six others plus the cycler)",
    "players": [
      { "hand": ["Aura Extraction", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["New Perspectives"] },
      {}
    ],
    "steps": [
      { "activate": "Aura Extraction", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Aura Extraction"], "hand_count": 7 }, {} ] }
  },
  {
    "name": "ruling: the alternate cost still discards the card with cycling (it goes to the graveyard, no mana spent)",
    "players": [
      { "hand": ["Aura Extraction", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["New Perspectives"] },
      {}
    ],
    "steps": [
      { "activate": "Aura Extraction", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Aura Extraction"], "hand_count": 7, "battlefield_has": ["New Perspectives"] }, {} ] }
  },
  {
    "name": "ruling: basic landcycling gets the alternate {0} cost with seven cards in hand",
    "players": [
      { "hand": ["Mongoose Lizard", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["New Perspectives"], "library": ["Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Mongoose Lizard", "ability": 0 },
      { "resolve": true, "answers": ["Mountain"] }
    ],
    "expect": { "players": [ { "graveyard": ["Mongoose Lizard"], "hand_count": 7, "library_count": 20 }, {} ] }
  }
]
