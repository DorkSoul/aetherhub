[
  { "name": "single-target instant on my creature is copied, copy may retarget",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Grizzly Bears", "Leyline of Resonance"] }, {} ],
    "steps": [
      {"cast": "Giant Growth", "targets": ["Grizzly Bears"]},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [8, 8] } } },
  { "name": "spell targeting an opponent's creature is not copied",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Leyline of Resonance"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      {"cast": "Giant Growth", "targets": ["Hill Giant"]},
      {"resolve": true}
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Hill Giant": [6, 6] } } },
  { "name": "in the opening hand it begins the game on the battlefield",
    "players": [ { "hand": ["Leyline of Resonance"] }, {} ],
    "steps": [],
    "expect": { "players": [ { "battlefield_has": ["Leyline of Resonance"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: the copy may be given new targets (Hill Giant instead of Grizzly Bears)",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Leyline of Resonance", "Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [
      {"cast": "Giant Growth", "targets": ["Grizzly Bears"]},
      {"resolve": true, "answers": ["Hill Giant"]},
      {"resolve": true}
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [5, 5], "Hill Giant": [6, 6] } } },
  { "name": "ruling: the copy has the same X as the original spell",
    "players": [ { "hand": ["Frantic Confrontation"], "battlefield": ["Mountain", "Mountain", "Mountain", "Leyline of Resonance", "Grizzly Bears"] }, {} ],
    "steps": [
      {"cast": "Frantic Confrontation", "targets": ["Grizzly Bears"], "answers": [2]},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [6, 2] } } }
]
