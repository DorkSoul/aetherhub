[
  { "name": "creates three 2/2 white Knight tokens",
    "players": [ { "hand": ["Waylay"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Waylay" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Knight 2-2 White"], "graveyard": ["Waylay"] } ], "pt": { "Knight 2-2 White": [2, 2] } } },
  { "name": "the Knights are still on the battlefield at the end step",
    "players": [ { "hand": ["Waylay"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Waylay" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Knight 2-2 White"] } ] } },
  { "name": "the Knights are exiled at the beginning of the cleanup step",
    "players": [ { "hand": ["Waylay"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Waylay" }, { "resolve": true }, { "advance_to": "Cleanup", "auto": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Knight 2-2 White"] } ] } },
  { "name": "another spell resolving later in the turn does not stop the Knights from being exiled at cleanup",
    "players": [ { "hand": ["Waylay"], "battlefield": ["Plains", "Plains", "Plains"] }, { "hand": ["Time and Tide"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Waylay" }, { "resolve": true }, { "pass": true }, { "cast": "Time and Tide", "player": 1 }, { "resolve": true }, { "advance_to": "Cleanup", "auto": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Knight 2-2 White"] }, {} ] } }
]
