[
  { "name": "when it dies, the top card of the library is exiled",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Sizzling Changeling", "Mountain"], "library": ["Plains", "Island"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Sizzling Changeling"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Plains"] }, {} ] } },
  { "name": "the exiled card can be played as a land this turn",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Sizzling Changeling", "Mountain"], "library": ["Plains", "Island"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Sizzling Changeling"] },
      { "resolve": true },
      { "resolve": true },
      { "play_land": "Plains" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Plains"], "exile": [] }, {} ] } },
  { "name": "ruling: an exiled creature card is cast at sorcery speed, so it is illegal in combat",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Sizzling Changeling", "Mountain", "Forest", "Forest"], "library": ["Grizzly Bears", "Island"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Sizzling Changeling"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "cast": "Grizzly Bears", "illegal": true },
      { "advance_to": "Main2" },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": [] }, {} ] } }
]
