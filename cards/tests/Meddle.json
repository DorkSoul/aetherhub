[
  { "name": "redirects a creature-targeting spell to another creature",
    "players": [ { "hand": ["Meddle"], "battlefield": ["Island", "Island", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "cast": "Meddle", "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true, "answers": [[0]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Hill Giant"] } ] } },
  { "name": "with no other creature the target stays (a player is never offered)",
    "players": [ { "hand": ["Meddle"], "battlefield": ["Island", "Island", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "cast": "Meddle", "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "a spell targeting a player cannot be targeted",
    "players": [ { "hand": ["Meddle"], "battlefield": ["Island", "Island", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "cast": "Meddle", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "ruling: a spell with a creature target and a player target can't be redirected",
    "players": [ { "hand": ["Meddle"], "battlefield": ["Island", "Island", "Grizzly Bears"] }, { "hand": ["Deal Gone Bad"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Deal Gone Bad", "player": 1, "targets": ["p1", "Grizzly Bears"] }, { "cast": "Meddle", "targets": [{ "stack": "Deal Gone Bad" }], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Island", "Island"] }, { "graveyard_has": ["Deal Gone Bad"], "library_count": 17 } ] } }
]
