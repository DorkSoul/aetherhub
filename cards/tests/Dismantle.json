[
  {
    "name": "charge counters moved to own artifact",
    "players": [
      { "hand": ["Dismantle"], "battlefield": ["Mountain", "Forest", "Island", "Mind Stone"] },
      { "battlefield": [{ "name": "Sol Ring", "counters": { "p1p1": 2, "charge": 1 } }] }
    ],
    "steps": [
      { "cast": "Dismantle", "targets": ["Sol Ring"] },
      { "resolve": true, "answers": [["Mind Stone"], 1] }
    ],
    "expect": {
      "counters": { "Mind Stone": { "charge": 3 } },
      "players": [
        { "battlefield_has": ["Mind Stone"] },
        { "graveyard_has": ["Sol Ring"] }
      ]
    }
  },
  {
    "name": "plus one counters",
    "players": [
      { "hand": ["Dismantle"], "battlefield": ["Mountain", "Forest", "Island", "Mind Stone"] },
      { "battlefield": [{ "name": "Sol Ring", "counters": { "charge": 2 } }] }
    ],
    "steps": [
      { "cast": "Dismantle", "targets": ["Sol Ring"] },
      { "resolve": true, "answers": [["Mind Stone"], 0] }
    ],
    "expect": {
      "counters": { "Mind Stone": { "p1p1": 2 } },
      "players": [
        { "battlefield_has": ["Mind Stone"] },
        { "graveyard_has": ["Sol Ring"] }
      ]
    }
  },
  {
    "name": "ruling: an indestructible target is not destroyed, but counters still go on my artifact",
    "players": [
      { "hand": ["Dismantle"], "battlefield": ["Mountain", "Forest", "Island", "Mind Stone"] },
      { "battlefield": [{ "name": "Darksteel Myr", "counters": { "p1p1": 2 } }] }
    ],
    "steps": [
      { "cast": "Dismantle", "targets": ["Darksteel Myr"] },
      { "resolve": true, "answers": [["Mind Stone"], 0] }
    ],
    "expect": {
      "counters": { "Mind Stone": { "p1p1": 2 } },
      "players": [
        { "battlefield_has": ["Mind Stone"] },
        { "battlefield_has": ["Darksteel Myr"] }
      ]
    }
  }
]
