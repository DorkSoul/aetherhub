      { "attack": [ { "card": "Dalkovan Packbeasts", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Dalkovan Packbeasts"], "battlefield_lacks": ["Warrior 1-1 R"] }, { "life": 17 } ]
    }
