  {
    "name": "does not create Warriors unless it attacks",
    "players": [ { "battlefield": ["Dalkovan Packbeasts"] }, {} ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Warrior 1-1 R"] }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: the Warriors enter attacking without being declared, so Hellrider triggers only for the Packbeasts (1 + 3 damage)",
    "players": [ { "battlefield": ["Dalkovan Packbeasts", "Hellrider"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Dalkovan Packbeasts", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Dalkovan Packbeasts", "Hellrider"] }, { "life": 16 } ]
    }
  }
