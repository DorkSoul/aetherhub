 {
  "name": "ruling: two different enchantments with the same name can both be targeted and destroyed",
  "players": [
   { "hand": ["Peace and Quiet"], "battlefield": ["Plains", "Plains"] },
   { "battlefield": ["Breeding Pit", "Breeding Pit"] }
  ],
  "steps": [
   { "cast": "Peace and Quiet", "targets": ["Breeding Pit", "Breeding Pit"] },
   { "resolve": true }
  ],
  "expect": {
