[
  {
    "name": "end step copy only if a permanent was sacrificed this turn",
    "players": [
      {
        "battlefield": [
          "Phoenix Fleet Airship"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Phoenix Fleet Airship"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "sacrificed a permanent this turn: token copy at end step",
    "players": [
      {
        "battlefield": [
          "Phoenix Fleet Airship",
          "Viscera Seer",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Viscera Seer",
        "answers": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true,
        "auto": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Phoenix Fleet Airship",
            "Phoenix Fleet Airship",
            "Viscera Seer"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "crew 1 makes it a creature until end of turn: it can attack",
    "players": [ { "battlefield": ["Phoenix Fleet Airship", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Phoenix Fleet Airship", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Phoenix Fleet Airship", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ], "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "crew needs a creature to tap: illegal without one",
    "players": [ { "battlefield": ["Phoenix Fleet Airship"] }, {} ],
    "steps": [ { "activate": "Phoenix Fleet Airship", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Phoenix Fleet Airship"] }, {} ] }
  },
  {
    "name": "eight named copies make each one a creature that can attack",
    "players": [
      { "battlefield": ["Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Phoenix Fleet Airship", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "seven named copies: not a creature, so it cannot attack",
    "players": [
      { "battlefield": ["Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Phoenix Fleet Airship", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Phoenix Fleet Airship", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: the token copy has the Airship's end-step trigger, so it copies again on a later turn",
    "players": [
      {
        "battlefield": ["Phoenix Fleet Airship", "Viscera Seer", "Grizzly Bears", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "Viscera Seer", "answers": ["Grizzly Bears"] },
      { "resolve": true, "auto": true },
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "activate": "Viscera Seer", "answers": ["Grizzly Bears"] },
      { "resolve": true, "auto": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Phoenix Fleet Airship",
            "Phoenix Fleet Airship",
            "Phoenix Fleet Airship",
            "Phoenix Fleet Airship",
            "Viscera Seer"
          ]
        },
        {}
      ]
    }
  }
]
