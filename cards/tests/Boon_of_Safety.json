[
  {
    "name": "shield counter prevents the next damage and scry 1 happens",
    "players": [
      { "hand": ["Boon of Safety"], "battlefield": ["Plains", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Boon of Safety", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] }],
      "counters": { "Grizzly Bears": { "shield": 0 } }
    }
  },
  {
    "name": "ruling: with two shield counters, damage is prevented and only one counter is removed",
    "players": [
      { "hand": ["Boon of Safety", "Boon of Safety"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Boon of Safety", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Boon of Safety", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] }],
      "counters": { "Grizzly Bears": { "shield": 1 } }
    }
  }
]
