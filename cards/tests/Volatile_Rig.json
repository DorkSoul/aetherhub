[
  {
    "name": "losing the flip after being dealt damage sacrifices it",
    "seed": 1,
    "players": [
      { "battlefield": ["Volatile Rig"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Volatile Rig"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Volatile Rig"] }, {}]
    }
  },
  {
    "name": "winning the flip after being dealt damage keeps it",
    "seed": 3,
    "players": [
      { "battlefield": ["Volatile Rig"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Volatile Rig"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Volatile Rig"] }, {}]
    }
  },
  {
    "name": "attacks each combat if able: with no attack declared it still hits the opponent for 4",
    "players": [
      { "battlefield": ["Volatile Rig"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  },
  {
    "name": "ruling: dealt damage by two blockers at once triggers once: one coin flip, won, so it survives",
    "seed": 3,
    "players": [
      { "battlefield": ["Volatile Rig"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Volatile Rig", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Volatile Rig" }, { "blocker": "Llanowar Elves", "attacker": "Volatile Rig" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Volatile Rig"] }, {}]
    }
  }
]
