[
  {
    "name": "combat damage to an opponent is dealt again to each other opponent",
    "players": [
      { "battlefield": [ { "name": "Hydra Omnivore", "sick": false } ] },
      {},
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hydra Omnivore", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 12 },
        { "life": 12 }
      ]
    }
  },
  {
    "name": "blocked Hydra Omnivore deals no combat damage to players, so no extra damage",
    "players": [
      { "battlefield": [ { "name": "Hydra Omnivore", "sick": false } ] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hydra Omnivore", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hydra Omnivore" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "attacking the third player: the second opponent is dealt the same damage",
    "players": [
      { "battlefield": [ { "name": "Hydra Omnivore", "sick": false } ] },
      {},
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hydra Omnivore", "at": "p2" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 12 },
        { "life": 12 }
      ]
    }
  },
  {
    "name": "ruling: the trigger's damage is not combat damage, so it does not trigger Hydra Omnivore again (the attacked opponent is hit only once)",
    "players": [
      { "battlefield": [ { "name": "Hydra Omnivore", "sick": false } ] },
      {},
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hydra Omnivore", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 12 },
        { "life": 12 }
      ]
    }
  }
]
