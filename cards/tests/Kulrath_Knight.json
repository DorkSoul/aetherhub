[
  {
    "name": "opposing creature with a counter cannot attack",
    "players": [
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 1 } }], "life": 20 },
      { "battlefield": ["Kulrath Knight"], "life": 20 }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "life": 20 }, { "life": 20 }]
    }
  },
  {
    "name": "opposing creature without counters can attack and is blocked by Kulrath",
    "players": [
      { "battlefield": ["Grizzly Bears"], "life": 20 },
      { "battlefield": ["Kulrath Knight"], "life": 20 }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Kulrath Knight", "attacker": "Grizzly Bears" }] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "graveyard": ["Grizzly Bears"] }, { "battlefield": ["Kulrath Knight"], "life": 20 }]
    }
  },
  {
    "name": "opposing creature with a +1/+1 counter cannot block: Hill Giant is unblocked",
    "players": [
      { "battlefield": ["Kulrath Knight", "Hill Giant"] },
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 1 } }, "Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 17, "battlefield_has": ["Grizzly Bears", "Llanowar Elves"] } ]
    }
  },
  {
    "name": "a blocker without counters can still block Hill Giant",
    "players": [
      { "battlefield": ["Kulrath Knight", "Hill Giant"] },
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 1 } }, "Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Llanowar Elves", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20, "graveyard_has": ["Llanowar Elves"] } ]
    }
  },
  {
    "name": "ruling: any kind of counter (here a charge counter) stops an opposing creature from blocking",
    "players": [
      { "battlefield": ["Kulrath Knight", "Hill Giant"] },
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "charge": 1 } }, "Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 17, "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
