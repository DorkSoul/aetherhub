[
  {
    "name": "gaining life puts a counter on each Cleric you control, not on other creatures",
    "players": [
      { "hand": ["Lightning Helix"], "battlefield": ["Minwu, White Mage", "Mountain", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Helix", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Minwu, White Mage": { "p1p1": 1 }, "Grizzly Bears": { "p1p1": 0 } },
      "players": [
        { "life": 23 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "its own lifelink damage gains life and triggers it",
    "players": [
      { "battlefield": ["Minwu, White Mage"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Minwu, White Mage", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Minwu, White Mage": { "p1p1": 1 } },
      "players": [
        { "life": 23 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: two lifelink creatures dealing combat damage together each trigger Minwu",
    "players": [
      { "battlefield": ["Minwu, White Mage", "Markov Purifier"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Minwu, White Mage", "at": "p1" }, { "card": "Markov Purifier", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Minwu, White Mage": { "p1p1": 2 }, "Markov Purifier": { "p1p1": 2 } },
      "pt": { "Minwu, White Mage": [5, 5] },
      "players": [
        { "life": 25 },
        { "life": 15 }
      ]
    }
  }
]
