  "name": "ruling: a countered spell still gives Ramos its counter (colors from the spell)",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Ramos, Dragon Engine", "Mountain"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }], "player": 1 },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Ramos, Dragon Engine": { "p1p1": 1 } },
   "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 20 } ]
  }
 },
