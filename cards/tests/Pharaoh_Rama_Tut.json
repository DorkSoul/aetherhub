[
  {
    "name": "connive after a noncreature spell: discarding a land gives no counter",
    "players": [
      { "hand": ["Lightning Bolt", "Mountain"], "battlefield": ["Pharaoh Rama-Tut", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": ["Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Pharaoh Rama-Tut": [4, 4] },
      "players": [ {}, { "graveyard_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "connive after a noncreature spell: discarding a nonland card puts a +1/+1 counter",
    "players": [
      { "hand": ["Lightning Bolt", "Grizzly Bears"], "battlefield": ["Pharaoh Rama-Tut", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Pharaoh Rama-Tut": [5, 5] },
      "counters": { "Pharaoh Rama-Tut": { "p1p1": 1 } }
    }
  },
  {
    "name": "a creature spell does not trigger connive",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Pharaoh Rama-Tut", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Pharaoh Rama-Tut": [4, 4] },
      "players": [ { "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "ward {2}: opponent has only 1 spare mana, cannot pay, Disfigure is countered",
    "players": [ { "battlefield": ["Pharaoh Rama-Tut"] }, { "hand": ["Disfigure"], "battlefield": ["Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Disfigure", "player": 1, "targets": ["Pharaoh Rama-Tut"] }, { "resolve": true, "auto": true } ],
    "expect": { "pt": { "Pharaoh Rama-Tut": [4, 4] }, "players": [ { "battlefield_has": ["Pharaoh Rama-Tut"] }, { "graveyard_has": ["Disfigure"] } ] }
  },
  {
    "name": "ward {2}: opponent pays 2, Disfigure resolves and gives -2/-2",
    "players": [ { "battlefield": ["Pharaoh Rama-Tut"] }, { "hand": ["Disfigure"], "battlefield": ["Swamp", "Swamp", "Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Disfigure", "player": 1, "targets": ["Pharaoh Rama-Tut"] }, { "resolve": true, "auto": true } ],
    "expect": { "pt": { "Pharaoh Rama-Tut": [2, 2] }, "players": [ { "battlefield_has": ["Pharaoh Rama-Tut"] }, { "graveyard_has": ["Disfigure"] } ] }
  }
]
