  },
  {
    "name": "ruling: the Mage Hunter trigger resolves before the Bolt that caused it",
    "players": [
      { "battlefield": ["Mage Hunter", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
