[
  {
    "name": "exchanges control of two lands",
    "players": [
      { "hand": ["Shifting Borders"], "battlefield": ["Island", "Island", "Island", "Island", "Plains"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Shifting Borders", "targets": ["Plains", "Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Forest"], "battlefield_lacks": ["Plains"], "hand": [] },
        { "battlefield_has": ["Plains"], "battlefield_lacks": ["Forest"] }
      ]
    }
  },
  {
    "name": "splice onto Blind with Anger: the land swap happens too",
    "players": [
      { "hand": ["Blind with Anger", "Shifting Borders"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "cast": "Blind with Anger", "targets": ["Plains", "Forest", "Grizzly Bears"], "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Forest"], "hand": ["Shifting Borders"] },
        { "battlefield_has": ["Plains"], "battlefield_lacks": ["Forest"] }
      ]
    }
  },
  {
    "name": "declining the splice: no land swap, Shifting Borders stays in hand",
    "players": [
      { "hand": ["Blind with Anger", "Shifting Borders"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "cast": "Blind with Anger", "targets": ["Grizzly Bears"], "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Plains"], "hand": ["Shifting Borders"] },
        { "battlefield_has": ["Forest"] }
      ]
    }
  },
  {
    "name": "ruling: if a target land is destroyed in response, the exchange does not occur at all",
    "players": [
      { "hand": ["Shifting Borders"], "battlefield": ["Island", "Island", "Island", "Island", "Plains"] },
      { "hand": ["Assassin's Trophy"], "battlefield": ["Swamp", "Forest"] }
    ],
    "steps": [
      { "cast": "Shifting Borders", "targets": ["Plains", "Forest"] },
      { "cast": "Assassin's Trophy", "player": 1, "targets": ["Plains"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Shifting Borders", "Plains"], "battlefield_lacks": ["Forest"] },
        { "battlefield_has": ["Forest"], "graveyard": ["Assassin's Trophy"] }
      ]
    }
  },
  {
    "name": "ruling: two copies of Shifting Borders each splice once onto the same spell, both exchanges happen",
    "players": [
      { "hand": ["Blind with Anger", "Shifting Borders", "Shifting Borders"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Plains", "Forest"] }
    ],
    "steps": [
      { "cast": "Blind with Anger", "targets": ["Plains", "Island", "Forest", "Mountain", "Grizzly Bears"], "answers": [true, true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Plains", "Forest", "Grizzly Bears"], "hand": ["Shifting Borders", "Shifting Borders"] },
        { "battlefield_has": ["Island", "Mountain"], "battlefield_lacks": ["Plains", "Forest"] }
      ]
    }
  }
]
