[
  {
    "name": "single target gets -4/-0",
    "players": [
      {
        "hand": [
          "Downsize"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Downsize",
        "targets": [
          "p1:Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          -2,
          2
        ]
      }
    }
  },
  {
    "name": "overload: each creature you don't control gets -4/-0",
    "players": [
      {
        "hand": [
          "Downsize"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Downsize",
        "alt": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          -2,
          2
        ],
        "Llanowar Elves": [
          -3,
          1
        ]
      }
    }
  },
  {
    "name": "ruling: without overload the spell has a single target, so the other creature is unaffected",
    "players": [
      { "hand": ["Downsize"], "battlefield": ["Island"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Downsize", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [-2, 2], "Llanowar Elves": [1, 1] }
    }
  }
]
