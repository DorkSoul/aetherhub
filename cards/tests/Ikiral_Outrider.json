[
 {
  "name": "level up once: 2/6 with vigilance",
  "players": [
   {
    "battlefield": [
     "Ikiral Outrider",
     "Plains",
     "Plains",
     "Plains",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Ikiral Outrider"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Ikiral Outrider": {
     "level": 1
    }
   },
   "pt": {
    "Ikiral Outrider": [
     2,
     6
    ]
   },
   "keywords": {
    "Ikiral Outrider": [
     "Vigilance"
    ]
   }
  }
 },
 {
  "name": "level 4 is a 3/10 vigilance",
  "players": [
   {
    "battlefield": [
     {
      "name": "Ikiral Outrider",
      "counters": {
       "level": 4
      }
     }
    ]
   },
   {}
  ],
  "steps": [],
  "expect": {
   "pt": {
    "Ikiral Outrider": [
     3,
     10
    ]
   },
   "keywords": {
    "Ikiral Outrider": [
     "Vigilance"
    ]
   }
  }
 },
 {
  "name": "ruling: +1/+1 counters apply whenever they were put on, so two counters make the level-1 Outrider 4/8",
  "players": [ { "battlefield": [ { "name": "Ikiral Outrider", "counters": { "p1p1": 2 } }, "Plains", "Plains", "Plains", "Plains" ] }, {} ],
  "steps": [ { "activate": "Ikiral Outrider" }, { "resolve": true } ],
  "expect": { "pt": { "Ikiral Outrider": [4, 8] } }
 },
 {
  "name": "ruling: Vampire Hexmage removes the level counters, so the Outrider is back to its level-0 1/2",
  "players": [ { "battlefield": [ { "name": "Ikiral Outrider", "counters": { "level": 4 } }, "Vampire Hexmage" ] }, {} ],
  "steps": [ { "activate": "Vampire Hexmage", "targets": ["Ikiral Outrider"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard_has": ["Vampire Hexmage"] }, {} ], "pt": { "Ikiral Outrider": [1, 2] } }
 },
 {
  "name": "ruling: the level up ability is still there at level 4 (level 5 is still 3/10 vigilance)",
  "players": [ { "battlefield": [ { "name": "Ikiral Outrider", "counters": { "level": 4 } }, "Plains", "Plains", "Plains", "Plains" ] }, {} ],
  "steps": [ { "activate": "Ikiral Outrider" }, { "resolve": true } ],
  "expect": { "counters": { "Ikiral Outrider": { "level": 5 } }, "pt": { "Ikiral Outrider": [3, 10] }, "keywords": { "Ikiral Outrider": ["Vigilance"] } }
 }
]