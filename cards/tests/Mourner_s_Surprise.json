[
  {
    "name": "returns a creature card from your graveyard to hand and makes a Mercenary",
    "players": [
      { "hand": ["Mourner's Surprise"], "battlefield": ["Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Mourner's Surprise", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"], "graveyard": ["Mourner's Surprise"], "battlefield": ["Swamp", "Swamp", "Mercenary 1-1"] },
        {}
      ]
    }
  },
  {
    "name": "choosing no target still makes the Mercenary",
    "players": [
      { "hand": ["Mourner's Surprise"], "battlefield": ["Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Mourner's Surprise" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears", "Mourner's Surprise"], "battlefield": ["Swamp", "Swamp", "Mercenary 1-1"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: chosen creature card is gone at resolution, so nothing happens and no Mercenary is made",
    "players": [
      { "hand": ["Mourner's Surprise"], "battlefield": ["Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] },
      { "battlefield": ["Tormod's Crypt"] }
    ],
    "steps": [
      { "cast": "Mourner's Surprise", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "activate": "Tormod's Crypt", "player": 1, "ability": 0, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Grizzly Bears"], "graveyard": ["Mourner's Surprise"], "battlefield_lacks": ["Mercenary 1-1"], "hand_count": 0 },
        { "graveyard": ["Tormod's Crypt"] }
      ]
    }
  }
]
