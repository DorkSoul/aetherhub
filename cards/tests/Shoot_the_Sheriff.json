[
 { "name": "destroys a non-outlaw creature",
   "players": [ { "hand": ["Shoot the Sheriff"], "battlefield": ["Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [
     { "cast": "Shoot the Sheriff", "targets": ["Grizzly Bears"] },
     { "resolve": true }
   ],
   "expect": { "players": [ { "graveyard": ["Shoot the Sheriff"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "cannot target an outlaw (Pirate)",
   "players": [ { "hand": ["Shoot the Sheriff"], "battlefield": ["Swamp", "Swamp"] }, { "battlefield": ["Reef Pirates"] } ],
   "steps": [
     { "cast": "Shoot the Sheriff", "illegal": true }
   ],
   "expect": { "players": [ { "hand": ["Shoot the Sheriff"] }, { "battlefield": ["Reef Pirates"] } ] } },
 { "name": "ruling: a Mercenary (the deputy's creature type is an outlaw type) cannot be targeted",
   "players": [ { "hand": ["Shoot the Sheriff"], "battlefield": ["Swamp", "Swamp"] }, { "battlefield": ["Bog Smugglers"] } ],
   "steps": [ { "cast": "Shoot the Sheriff", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Shoot the Sheriff"] }, { "battlefield_has": ["Bog Smugglers"] } ] } },
 { "name": "boundary: with a Mercenary on the battlefield, a non-outlaw creature is still a legal target",
   "players": [ { "hand": ["Shoot the Sheriff"], "battlefield": ["Swamp", "Swamp"] }, { "battlefield": ["Bog Smugglers", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Shoot the Sheriff", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Shoot the Sheriff"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Bog Smugglers"] } ] } },
 { "name": "ruling: a creature with two outlaw types (Assassin, Mercenary) is still an outlaw",
   "players": [ { "hand": ["Shoot the Sheriff"], "battlefield": ["Swamp", "Swamp"] }, { "battlefield": ["Silent Assassin"] } ],
   "steps": [ { "cast": "Shoot the Sheriff", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Shoot the Sheriff"] }, { "battlefield_has": ["Silent Assassin"] } ] } },
 { "name": "boundary: a two-outlaw-type creature survives when a non-outlaw is the target",
   "players": [ { "hand": ["Shoot the Sheriff"], "battlefield": ["Swamp", "Swamp"] }, { "battlefield": ["Silent Assassin", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Shoot the Sheriff", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Shoot the Sheriff"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Silent Assassin"] } ] } }
]
