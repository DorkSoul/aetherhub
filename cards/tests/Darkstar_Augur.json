[
  {
    "name": "reveals, takes the card and loses life equal to its mana value",
    "players": [
      {
        "battlefield": [
          "Darkstar Augur"
        ],
        "library": [
          "Serra Angel",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 15,
          "hand": [
            "Serra Angel"
          ]
        }
      ],
      "keywords": {
        "Darkstar Augur": [
          "Flying"
        ]
      }
    }
  },
  {
    "name": "a land costs no life",
    "players": [
      {
        "battlefield": [
          "Darkstar Augur"
        ],
        "library": [
          "Island",
          "Serra Angel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20,
          "hand": [
            "Island"
          ]
        }
      ]
    }
  },
  {
    "name": "offspring {B} paid: a 1/1 token copy also enters",
    "players": [
      {
        "hand": [
          "Darkstar Augur"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Darkstar Augur",
        "answers": [
          true
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Darkstar Augur",
            "Darkstar Augur"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "offspring not paid: only the original enters",
    "players": [
      {
        "hand": [
          "Darkstar Augur"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Darkstar Augur"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Darkstar Augur",
            "Swamp",
            "Swamp",
            "Swamp"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a countered creature spell with offspring makes no token",
    "players": [
      { "hand": ["Darkstar Augur"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Darkstar Augur", "answers": [true] },
      { "cast": "Counterspell", "targets": [{ "stack": "Darkstar Augur" }], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Darkstar Augur"], "battlefield_lacks": ["Darkstar Augur"] }, {} ] }
  },
  {
    "name": "ruling: the offspring token is not cast, so Ramos gets only the spell's counter",
    "players": [
      { "hand": ["Darkstar Augur"], "battlefield": ["Ramos, Dragon Engine", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [ { "cast": "Darkstar Augur", "answers": [true] }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "counters": { "Ramos, Dragon Engine": { "p1p1": 1 } },
      "players": [ { "battlefield_has": ["Darkstar Augur", "Darkstar Augur"] }, {} ]
    }
  },
  {
    "name": "ruling: an {X} card revealed from the library counts X as 0 (Fireball {X}{R} has mana value 1)",
    "players": [ { "battlefield": ["Darkstar Augur"], "library": ["Fireball"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "auto": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 19, "hand": ["Fireball"] }, {} ] }
  }
]
