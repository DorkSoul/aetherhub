[
 {
  "name": "enters with two +1/+1 counters",
  "players": [ { "hand": ["Anthroplasm"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
  "steps": [ { "cast": "Anthroplasm" }, { "resolve": true } ],
  "expect": { "pt": { "Anthroplasm": [2, 2] }, "counters": { "Anthroplasm": { "p1p1": 2 } } }
 },
 {
  "name": "{X},{T}: replaces its counters with X counters",
  "players": [ { "battlefield": [ { "name": "Anthroplasm", "counters": { "p1p1": 2 } }, "Island", "Island", "Island" ] }, {} ],
  "steps": [
    { "activate": "Anthroplasm", "ability": 0, "answers": [3] },
    { "resolve": true }
  ],
  "expect": { "pt": { "Anthroplasm": [3, 3] }, "counters": { "Anthroplasm": { "p1p1": 3 } } }
 },
 {
  "name": "X of 0 leaves it 0/0 and it dies",
  "players": [ { "battlefield": [ { "name": "Anthroplasm", "counters": { "p1p1": 2 } }, "Island" ] }, {} ],
  "steps": [
    { "activate": "Anthroplasm", "ability": 0, "answers": [0] },
    { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Anthroplasm"] } ] }
 },
 {
  "name": "ruling: counters are removed and re-added in one resolution, so the 0/0 moment does not kill it",
  "players": [ { "battlefield": [ { "name": "Anthroplasm", "counters": { "p1p1": 2 } }, "Island" ] }, {} ],
  "steps": [
    { "activate": "Anthroplasm", "ability": 0, "answers": [1] },
    { "resolve": true }
  ],
  "expect": { "pt": { "Anthroplasm": [1, 1] }, "counters": { "Anthroplasm": { "p1p1": 1 } } }
 }
