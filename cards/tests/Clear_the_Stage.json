[
  {
    "name": "-3/-3 kills a creature without a power 4 creature",
    "players": [ { "hand": ["Clear the Stage"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Clear the Stage", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Clear the Stage"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] }
  },
  {
    "name": "with a power 4 creature you may return a creature card from your graveyard",
    "players": [
      { "hand": ["Clear the Stage"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Serra Angel"], "graveyard": ["Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "cast": "Clear the Stage", "targets": ["Hill Giant", "Grizzly Bears"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, { "battlefield_lacks": ["Hill Giant"] } ] }
  },
  {
    "name": "ruling: the power 4 check sees the -3/-3 already applied: our Serra Angel becomes 1/1, so nothing returns",
    "players": [
      { "hand": ["Clear the Stage"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Serra Angel"], "graveyard": ["Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "cast": "Clear the Stage", "targets": ["Serra Angel", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Clear the Stage", "Grizzly Bears"], "battlefield_has": ["Serra Angel"] },
        {}
      ],
      "pt": { "Serra Angel": [1, 1] }
    }
  },
  {
    "name": "ruling: if the first target is killed in response, the graveyard target is still returned",
    "players": [
      { "hand": ["Clear the Stage"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Serra Angel"], "graveyard": ["Hill Giant"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Clear the Stage", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "hand": ["Hill Giant"], "battlefield_has": ["Serra Angel"] },
        { "graveyard_has": ["Lightning Bolt", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the graveyard target may be chosen with no power 4 creature, and it is not returned",
    "players": [
      { "hand": ["Clear the Stage"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Prodigal Pyromancer"], "graveyard": ["Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Clear the Stage", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Clear the Stage", "Hill Giant"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]
