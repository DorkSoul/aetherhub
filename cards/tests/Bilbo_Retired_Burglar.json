[
  { "name": "entering the battlefield makes the Ring tempt you (Bilbo, the only creature, becomes the Ring-bearer)",
    "players": [ { "hand": ["Bilbo, Retired Burglar"], "battlefield": ["Island", "Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Bilbo, Retired Burglar" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bilbo, Retired Burglar"], "command": ["The Ring 1"] }, {} ] } },
  { "name": "dealing combat damage to a player creates a Treasure token",
    "players": [ { "battlefield": ["Bilbo, Retired Burglar"] }, {} ],
    "steps": [ { "attack": [ { "card": "Bilbo, Retired Burglar", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure"] }, { "life": 19 } ] } },
  { "name": "combat damage to a blocker creates no Treasure",
    "players": [ { "battlefield": ["Bilbo, Retired Burglar"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Bilbo, Retired Burglar", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Bilbo, Retired Burglar" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Treasure"] }, {} ] } },
  { "name": "leaving the battlefield makes the Ring tempt you (Grizzly Bears stays as Ring-bearer)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Bilbo, Retired Burglar", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Bilbo, Retired Burglar"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Bilbo, Retired Burglar"], "command": ["The Ring 1"] }, {} ] } },
  { "name": "another creature dying does not make the Ring tempt you",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Bilbo, Retired Burglar", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bilbo, Retired Burglar"], "command": [] }, {} ] } },
  { "name": "ruling: Ring tempts you with no creature left (Bilbo itself dies): the Ring emblem is still created",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Bilbo, Retired Burglar"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Bilbo, Retired Burglar"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Bilbo, Retired Burglar"], "command": ["The Ring 1"] }, {} ] } }
]
