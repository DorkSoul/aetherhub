[
 { "name": "creates a 2/3 Minotaur when it enters",
   "players": [ { "hand": ["Sethron, Hurloon General"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Sethron, Hurloon General" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Sethron, Hurloon General", "Minotaur 2-3 Red"] }, {} ] } },
 { "name": "pump gives Minotaurs +1/+0, menace and haste until end of turn",
   "players": [ { "battlefield": ["Sethron, Hurloon General", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Sethron, Hurloon General" }, { "resolve": true } ],
   "expect": { "pt": { "Sethron, Hurloon General": [5, 4] },
     "keywords": { "Sethron, Hurloon General": ["Menace", "Haste"] } } },
 { "name": "another nontoken Minotaur entering creates a 2/3 Minotaur token",
   "players": [ { "hand": ["Hurloon Minotaur"], "battlefield": ["Sethron, Hurloon General", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Hurloon Minotaur" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hurloon Minotaur", "Minotaur 2-3 Red"] }, {} ] } },
 { "name": "a non-Minotaur creature entering creates no token",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Sethron, Hurloon General", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Minotaur 2-3 Red"] }, {} ] } }
]
