[
  {
    "name": "target opponent shuffles graveyard into library, then you draw",
    "players": [
      { "hand": ["Clear the Mind"], "battlefield": ["Island", "Island", "Island"] },
      { "graveyard": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Clear the Mind", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Clear the Mind"] },
        { "graveyard": [], "library_count": 22 }
      ]
    }
  },
  {
    "name": "targeting yourself leaves Clear the Mind as the only card in your graveyard",
    "players": [
      { "hand": ["Clear the Mind"], "battlefield": ["Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Clear the Mind", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Clear the Mind"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: targeting yourself leaves Clear the Mind as the only card in your graveyard after it resolves",
    "players": [
      { "hand": ["Clear the Mind"], "battlefield": ["Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Clear the Mind", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Clear the Mind"], "library_count": 20 },
        {}
      ]
    }
  },
  {
    "name": "ruling: a target player with an empty graveyard is still valid: their library is shuffled and you draw",
    "players": [
      { "hand": ["Clear the Mind"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Clear the Mind", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Clear the Mind"] },
        { "graveyard": [], "library_count": 20 }
      ]
    }
  }
]
