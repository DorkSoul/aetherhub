[
  {
    "name": "without a Gideon, opponent sacrifices the one creature that blocked",
    "players": [
      { "hand": ["Gideon's Triumph"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "cast": "Gideon's Triumph", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Gideon's Triumph"] },
        { "graveyard": ["Savannah Lions"] }
      ]
    }
  },
  {
    "name": "a creature that neither attacked nor blocked is not sacrificed",
    "players": [
      { "hand": ["Gideon's Triumph"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Gideon's Triumph", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Gideon's Triumph"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "with a Gideon planeswalker, opponent sacrifices two of the creatures that blocked",
    "players": [
      { "hand": ["Gideon's Triumph"], "battlefield": ["Plains", "Plains", "Gideon, Ally of Zendikar", "Grizzly Bears"] },
      { "battlefield": ["Savannah Lions", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "cast": "Gideon's Triumph", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Gideon's Triumph"] },
        { "graveyard": ["Savannah Lions", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: after combat damage, a creature that blocked and died is not sacrificed; a non-blocker stays",
    "players": [
      { "hand": ["Gideon's Triumph"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Savannah Lions", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "advance_to": "Main2" },
      { "cast": "Gideon's Triumph", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Gideon's Triumph", "Grizzly Bears"] },
        { "graveyard": ["Savannah Lions"], "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
