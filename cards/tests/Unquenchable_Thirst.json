[
  { "name": "with a Desert: enchanted creature is tapped when the Aura enters",
    "players": [ { "hand": ["Unquenchable Thirst"], "battlefield": ["Island", "Island", "Desert"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Unquenchable Thirst" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } } },
  { "name": "without a Desert: no tap",
    "players": [ { "hand": ["Unquenchable Thirst"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Unquenchable Thirst" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": false } } },
  { "name": "Desert tap: the enchanted creature stays tapped through its controller's untap step",
    "players": [ { "hand": ["Unquenchable Thirst"], "battlefield": ["Island", "Island", "Desert"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Unquenchable Thirst" }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } } },
  { "name": "ruling: two Deserts give the same result as one (enchanted creature is tapped)",
    "players": [ { "hand": ["Unquenchable Thirst"], "battlefield": ["Island", "Island", "Desert", "Desert"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Unquenchable Thirst" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } } }
]
