[
  { "name": "enters and draws a card",
    "players": [ { "hand": ["Haru-Onna"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Haru-Onna" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Haru-Onna"] }, {} ] } },
  { "name": "returns to hand when you cast a Spirit spell",
    "players": [ { "hand": ["Chapel Geist"], "battlefield": ["Haru-Onna", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Chapel Geist" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand": ["Haru-Onna"], "battlefield_has": ["Chapel Geist"] }, {} ] } },
  { "name": "a non-Spirit spell does not return it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Haru-Onna", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Haru-Onna", "Grizzly Bears"] }, {} ] } }
]
