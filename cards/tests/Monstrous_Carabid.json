 {
  "name": "ruling: Stifle can counter the cycling ability (no card drawn)",
  "players": [
   { "hand": ["Monstrous Carabid"], "battlefield": ["Swamp"] },
   { "hand": ["Stifle"], "battlefield": ["Island"] }
  ],
  "steps": [
   { "activate": "Monstrous Carabid" },
   { "pass": true },
   { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Monstrous Carabid" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Monstrous Carabid"], "hand_count": 0 },
    { "graveyard": ["Stifle"] }
   ]
  }
 },
 {
  "name": "ruling: a spell counter (Remove Soul) cannot target cycling; the draw still happens",
  "players": [
   { "hand": ["Monstrous Carabid"], "battlefield": ["Swamp"] },
   { "hand": ["Remove Soul"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "activate": "Monstrous Carabid" },
   { "pass": true },
   { "cast": "Remove Soul", "player": 1, "targets": [ { "stack": "Monstrous Carabid" } ], "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Monstrous Carabid"], "hand_count": 1 },
    { "hand": ["Remove Soul"] }
   ]
  }
 }
