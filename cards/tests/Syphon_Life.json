[
  { "name": "cast from hand: target player loses 2 and you gain 2",
    "players": [ { "hand": ["Syphon Life"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Syphon Life", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "graveyard": ["Syphon Life"] }, { "life": 18 } ] } },
  { "name": "retrace: cast from graveyard by discarding a land; it returns to the graveyard",
    "players": [ { "graveyard": ["Syphon Life"], "hand": ["Forest"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Syphon Life", "alt": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "hand_count": 0, "graveyard_has": ["Syphon Life", "Forest"] }, { "life": 18 } ] } },
  { "name": "retrace needs a land card to discard",
    "players": [ { "graveyard": ["Syphon Life"], "hand": ["Grizzly Bears"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Syphon Life", "alt": 0, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Syphon Life"] }, { "life": 20 } ] } },
  { "name": "ruling: the active player can retrace again right after the first one resolves",
    "players": [ { "graveyard": ["Syphon Life"], "hand": ["Forest", "Forest"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Syphon Life", "alt": 0, "targets": ["p1"], "answers": ["Forest"] }, { "resolve": true }, { "cast": "Syphon Life", "alt": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 24, "hand_count": 0, "graveyard_has": ["Syphon Life", "Forest", "Forest"] }, { "life": 16 } ] } },
  { "name": "ruling: retrace is still paid with its mana cost in addition to discarding a land",
    "players": [ { "graveyard": ["Syphon Life"], "hand": ["Forest"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Syphon Life", "alt": 0, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Syphon Life"], "hand": ["Forest"], "life": 20 }, { "life": 20 } ] } }
