[
  { "name": "level 8: protection from everything, so a sorcery-speed Aura cannot target it",
    "players": [ { "battlefield": [ { "name": "Hexdrinker", "counters": { "Level": 8 } } ] }, { "hand": ["Pacifism"], "battlefield": ["Plains", "Plains"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "cast": "Pacifism", "targets": ["Hexdrinker"], "player": 1, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hexdrinker"] }, { "hand_count": 2 } ] } },
  { "name": "level 3 makes it a 4/4 with protection from instants",
