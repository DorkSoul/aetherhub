    "steps": [ { "pass": true }, { "cast": "Terror", "targets": ["Hexdrinker"], "player": 1, "illegal": true } ],
    "expect": { "pt": { "Hexdrinker": [4, 4] } } },
  { "name": "level 8 makes it a 6/6",
    "players": [ { "battlefield": [ { "name": "Hexdrinker", "counters": { "Level": 8 } } ] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "pt": { "Hexdrinker": [6, 6] } } },
  { "name": "at level 0 it is a 2/1 with no protection",
    "players": [ { "battlefield": ["Hexdrinker"] }, { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Terror", "targets": ["Hexdrinker"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Hexdrinker"] }, { "graveyard": ["Terror"] } ] } },
 { "name": "level up {1} adds a level counter each time",
   "players": [ { "battlefield": ["Hexdrinker", "Forest", "Forest"] }, {} ],
   "steps": [ { "activate": "Hexdrinker", "ability": 0 }, { "resolve": true }, { "activate": "Hexdrinker", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hexdrinker"] }, {} ], "counters": { "Hexdrinker": { "Level": 2 } }, "pt": { "Hexdrinker": [2, 1] } } },
 { "name": "level up needs {1}: no mana means it is illegal",
   "players": [ { "battlefield": ["Hexdrinker"] }, {} ],
   "steps": [ { "activate": "Hexdrinker", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hexdrinker"] }, {} ], "counters": { "Hexdrinker": { "Level": 0 } } } },
 { "name": "level up is sorcery speed: illegal on the opponent's turn",
   "players": [ { "battlefield": ["Hexdrinker", "Forest", "Forest"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "pass": true, "player": 1 }, { "activate": "Hexdrinker", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hexdrinker"] }, {} ], "counters": { "Hexdrinker": { "Level": 0 } } } },
 { "name": "ruling: protection from instants does not stop a sorcery-speed Aura at level 3",
   "players": [ { "battlefield": [ { "name": "Hexdrinker", "counters": { "Level": 3 } } ] }, { "hand": ["Pacifism"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "cast": "Pacifism", "targets": ["Hexdrinker"], "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hexdrinker"] }, { "hand_count": 1 } ], "attached": { "Pacifism": "Hexdrinker" } } },
 { "name": "ruling: protection from everything at level 8 means it can't be blocked",
   "players": [ { "battlefield": [ { "name": "Hexdrinker", "counters": { "Level": 8 } } ] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Hexdrinker", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hexdrinker" } ], "illegal": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Hexdrinker"] }, { "life": 14, "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: at level 7 it is still a 4/4 with protection from instants",
   "players": [ { "battlefield": [ { "name": "Hexdrinker", "counters": { "Level": 7 } } ] }, { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] } ],
   "steps": [ { "pass": true }, { "cast": "Terror", "targets": ["Hexdrinker"], "player": 1, "illegal": true } ],
   "expect": { "pt": { "Hexdrinker": [4, 4] } } }
