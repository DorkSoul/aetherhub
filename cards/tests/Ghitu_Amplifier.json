   { "resolve": true, "answers": [1] }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Ghitu Amplifier", "Ghitu Amplifier"] }, { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"], "hand": ["Grizzly Bears"] } ]
  }
