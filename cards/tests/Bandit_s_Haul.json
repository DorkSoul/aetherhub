[
  { "name": "committing a crime puts a loot counter on it",
    "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Bandit's Haul"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Shock", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "counters": { "Bandit's Haul": { "loot": 1 } } } },
  { "name": "only one loot counter per turn even with several crimes",
    "players": [ { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain", "Bandit's Haul"] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Shock", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true }, { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "counters": { "Bandit's Haul": { "loot": 1 } } } },
  { "name": "targeting only your own creature is not a crime",
    "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Bandit's Haul", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "counters": { "Bandit's Haul": { "loot": 0 } } } },
  { "name": "{2},{T}, remove two loot counters: draw a card",
    "players": [ { "battlefield": [{ "name": "Bandit's Haul", "sick": false, "counters": { "loot": 2 } }, "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Bandit's Haul", "ability": 0 }, { "resolve": true } ],
    "expect": { "counters": { "Bandit's Haul": { "loot": 0 } }, "players": [ { "hand_count": 1 }, {} ], "tapped": { "Bandit's Haul": true } } },
  { "name": "ruling: targeting an opponent player is a crime",
    "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Bandit's Haul"] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "counters": { "Bandit's Haul": { "loot": 1 } }, "players": [ {}, { "life": 18 } ] } },
  { "name": "ruling: the crime is committed on cast, so the counter stays when the spell is countered",
    "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Bandit's Haul"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Hill Giant"] } ],
    "steps": [ { "cast": "Shock", "targets": ["Hill Giant"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Shock" }] }, { "resolve": true } ],
    "expect": { "counters": { "Bandit's Haul": { "loot": 1 } }, "players": [ { "graveyard": ["Shock"] }, { "graveyard": ["Counterspell"], "battlefield_has": ["Hill Giant"] } ] } }
]
