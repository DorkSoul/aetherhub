[
 { "name": "tap an artifact as the additional cost to counter a spell",
   "players": [ { "hand": ["Disruption Protocol"], "battlefield": ["Island", "Island", "Ornithopter"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
              { "cast": "Disruption Protocol", "targets": [{ "stack": "Lightning Bolt" }], "answers": [0] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "graveyard_has": ["Lightning Bolt"] } ], "tapped": { "Ornithopter": true } } },
 { "name": "pay {1} as the additional cost instead",
   "players": [ { "hand": ["Disruption Protocol"], "battlefield": ["Island", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
              { "cast": "Disruption Protocol", "targets": [{ "stack": "Lightning Bolt" }], "answers": [1] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "graveyard_has": ["Lightning Bolt"] } ] } },
 { "name": "no artifact and no spare mana: cannot cast",
   "players": [ { "hand": ["Disruption Protocol"], "battlefield": ["Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
              { "cast": "Disruption Protocol", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Disruption Protocol"] }, {} ] } }
]
