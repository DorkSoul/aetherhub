[
  {
    "name": "targeted creature can't block Duct Crawler this turn",
    "players": [
      { "battlefield": ["Duct Crawler", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Duct Crawler", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Duct Crawler", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Duct Crawler" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19, "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "the restriction only applies to Duct Crawler as the attacker",
    "players": [
      { "battlefield": ["Duct Crawler", "Hill Giant", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Duct Crawler", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Duct Crawler", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19, "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "an untargeted creature can still block Duct Crawler",
    "players": [
      { "battlefield": ["Duct Crawler", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Duct Crawler", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Duct Crawler", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Duct Crawler" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20, "battlefield_has": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  }
]
