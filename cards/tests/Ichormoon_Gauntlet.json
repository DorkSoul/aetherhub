[
 {
  "name": "noncreature spell adds a second counter of the only kind",
  "players": [
   {
    "hand": ["Shock"],
    "battlefield": ["Mountain", "Ichormoon Gauntlet", { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 1 } }]
   },
   {}
  ],
  "steps": [
   { "cast": "Shock", "targets": ["p1", "Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [{}, { "life": 18 }], "counters": { "Grizzly Bears": { "PlusOnePlusOne": 2 } } }
 },
 {
  "name": "with two kinds the controller chooses which gets the counter",
  "players": [
   {
    "hand": ["Shock"],
    "battlefield": ["Mountain", "Ichormoon Gauntlet", { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 1, "Charge": 1 } }]
   },
   {}
  ],
  "steps": [
   { "cast": "Shock", "targets": ["p1", "Grizzly Bears"] },
   { "resolve": true, "answers": ["Charge"] },
   { "resolve": true }
  ],
  "expect": { "counters": { "Grizzly Bears": { "PlusOnePlusOne": 1, "Charge": 2 } } }
 },
 {
  "name": "a creature spell does not trigger it",
  "players": [
   {
    "hand": ["Grizzly Bears"],
    "battlefield": ["Forest", "Forest", "Ichormoon Gauntlet", { "name": "Runeclaw Bear", "counters": { "PlusOnePlusOne": 1 } }]
   },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": { "counters": { "Runeclaw Bear": { "PlusOnePlusOne": 1 } } }
 },
 {
