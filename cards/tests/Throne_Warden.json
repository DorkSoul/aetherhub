[
  { "name": "end step as the monarch: +1/+1 counter",
    "players": [ { "hand": ["Regal Behemoth"], "battlefield": ["Throne Warden", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Regal Behemoth" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "pt": { "Throne Warden": [ 3, 3 ] } } },
  { "name": "end step without the monarch: no counter",
    "players": [ { "battlefield": ["Throne Warden"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "pt": { "Throne Warden": [ 2, 2 ] } } },
  { "name": "monarch draws a card at the beginning of their end step",
    "players": [ { "hand": ["Regal Behemoth"], "battlefield": ["Throne Warden", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Regal Behemoth" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "pt": { "Throne Warden": [ 3, 3 ] }, "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "ruling: combat damage to the monarch makes the attacker the monarch, so no counter at your next end step",
    "players": [ { "hand": ["Regal Behemoth"], "battlefield": ["Throne Warden", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Regal Behemoth" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 }, { "block": [], "player": 0 }, { "advance_to": "Main2" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "End" } ],
    "expect": { "pt": { "Throne Warden": [ 3, 3 ] } } }
]
