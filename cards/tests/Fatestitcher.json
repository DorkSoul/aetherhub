  "expect": {"tapped": {"Grizzly Bears": true}}
 },
 {"name": "untap another target permanent",
  "players": [{"battlefield": [{"name": "Fatestitcher", "sick": false}]}, {"battlefield": [{"name": "Grizzly Bears", "tapped": true}]}],
  "steps": [
