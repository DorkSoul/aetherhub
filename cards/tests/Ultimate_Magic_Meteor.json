[
  { "name": "cast from hand: 7 damage to each creature, nothing destroyed",
    "players": [ { "hand": ["Ultimate Magic: Meteor"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Hill Giant", "Sol Ring", "Island"] } ],
    "steps": [ { "cast": "Ultimate Magic: Meteor" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Ultimate Magic: Meteor", "Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "battlefield_has": ["Sol Ring", "Island"] } ] } },
  { "name": "foretold and cast from exile: chosen opponent artifact or land is destroyed",
    "players": [ { "hand": ["Ultimate Magic: Meteor"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Sol Ring", "Island", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Ultimate Magic: Meteor", "ability": 0 }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Ultimate Magic: Meteor", "alt": 0 }, { "resolve": true, "answers": ["Sol Ring"] } ],
    "expect": { "players": [ { "exile": [] }, { "graveyard": ["Sol Ring", "Grizzly Bears"], "battlefield_has": ["Island"] } ] } },
  { "name": "from exile: only the opponent's own artifacts and lands are candidates",
    "players": [ { "hand": ["Ultimate Magic: Meteor"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Sol Ring"] },
                 { "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Ultimate Magic: Meteor", "ability": 0 }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Ultimate Magic: Meteor", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sol Ring"] }, { "graveyard": ["Island"] } ] } },
  { "name": "ruling: a foretold card cannot be cast on the turn it was foretold",
    "players": [ { "hand": ["Ultimate Magic: Meteor"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Ultimate Magic: Meteor", "ability": 0 }, { "resolve": true }, { "cast": "Ultimate Magic: Meteor", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Ultimate Magic: Meteor"] }, {} ] } },
  { "name": "ruling: foretelling is a special action that can be taken in response to a spell",
    "players": [ { "hand": ["Ultimate Magic: Meteor", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "activate": "Ultimate Magic: Meteor", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Ultimate Magic: Meteor"], "hand_count": 0 }, { "life": 18 } ] } }
]
