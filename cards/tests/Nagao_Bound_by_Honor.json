[
  {
    "name": "attacking pumps Samurai you control including itself",
    "players": [
      { "battlefield": ["Nagao, Bound by Honor"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Nagao, Bound by Honor", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Nagao, Bound by Honor": [4, 4] }
    }
  },
  {
    "name": "bushido adds +1/+1 when it becomes blocked",
    "players": [
      { "battlefield": ["Nagao, Bound by Honor"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Nagao, Bound by Honor", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Nagao, Bound by Honor" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Nagao, Bound by Honor": [5, 5] }
    }
  },
  {
    "name": "blocking pumps Nagao with bushido 1",
    "players": [
      { "battlefield": ["Nagao, Bound by Honor"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Nagao, Bound by Honor", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Nagao, Bound by Honor": [4, 4] }
    }
  },
  {
    "name": "not blocking: Nagao gets no bushido bonus",
    "players": [
      { "battlefield": ["Nagao, Bound by Honor"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Nagao, Bound by Honor": [3, 3] }
    }
  }
]
