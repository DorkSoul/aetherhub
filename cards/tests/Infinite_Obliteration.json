[
  {
    "name": "exiles the chosen creature name from the opponent's graveyard, hand and library, keeping other cards",
    "players": [
      { "hand": ["Infinite Obliteration"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears", "Forest"], "graveyard": ["Grizzly Bears"], "library": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "cast": "Infinite Obliteration", "targets": ["p1"] },
      { "resolve": true, "answers": ["Grizzly Bears", [0], [0], [0]] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Infinite Obliteration"] }, { "hand": ["Forest"], "hand_count": 1, "graveyard": [], "exile": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] } ]
    }
  },
  {
    "name": "any number: choosing none exiles nothing",
    "players": [
      { "hand": ["Infinite Obliteration"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears"], "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Infinite Obliteration", "targets": ["p1"] },
      { "resolve": true, "answers": ["Grizzly Bears", [], []] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Infinite Obliteration"] }, { "hand": ["Grizzly Bears"], "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "a card with another name is not exiled",
    "players": [
      { "hand": ["Infinite Obliteration"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
      { "hand": ["Forest"], "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "cast": "Infinite Obliteration", "targets": ["p1"] },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Infinite Obliteration"] }, { "hand": ["Forest"], "graveyard": ["Lightning Bolt"] } ]
    }
  }
]
