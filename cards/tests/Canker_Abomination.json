[
  { "name": "enters with a -1/-1 counter for each creature the opponent controls",
    "players": [ { "hand": ["Canker Abomination"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest"] },
                 { "battlefield": ["Grizzly Bears", "Savannah Lions", "Llanowar Elves"] } ],
    "steps": [ { "cast": "Canker Abomination" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Canker Abomination"] }, {} ],
                "counters": { "Canker Abomination": { "m1m1": 3 } },
                "pt": { "Canker Abomination": [3, 3] } } },
  { "name": "only the chosen opponent's creatures count, not the controller's",
    "players": [ { "hand": ["Canker Abomination"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] },
                 { "battlefield": ["Savannah Lions"] } ],
    "steps": [ { "cast": "Canker Abomination" }, { "resolve": true } ],
    "expect": { "counters": { "Canker Abomination": { "m1m1": 1 } },
                "pt": { "Canker Abomination": [5, 5] } } },
  { "name": "no creatures on the opponent's side: enters as a 6/6",
    "players": [ { "hand": ["Canker Abomination"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Canker Abomination" }, { "resolve": true } ],
    "expect": { "pt": { "Canker Abomination": [6, 6] } } },
  { "name": "needs four mana",
    "players": [ { "hand": ["Canker Abomination"], "battlefield": ["Swamp", "Swamp", "Forest"] }, {} ],
    "steps": [ { "cast": "Canker Abomination", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Canker Abomination"] }, {} ] } }
]
