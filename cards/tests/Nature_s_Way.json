   ],
   "keywords": { "Hill Giant": ["Vigilance", "Trample"] }
  }
 },
 {
  "name": "needs a creature you control as well as a creature you don't control",
  "players": [
   { "hand": ["Nature's Way"], "battlefield": ["Forest", "Forest"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Nature's Way", "illegal": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Nature's Way"] },
    { "battlefield": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: if the creature you don't control is gone when it resolves, no damage is dealt",
  "players": [
   { "hand": ["Nature's Way"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Knight of Meadowgrain"] }
  ],
  "steps": [
   { "cast": "Nature's Way", "targets": ["Grizzly Bears", "Knight of Meadowgrain"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Nature's Way", "Grizzly Bears"] },
    { "battlefield_has": ["Knight of Meadowgrain"], "graveyard_has": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: if the creature you don't control is illegal, your creature still gains vigilance and trample",
  "players": [
   { "hand": ["Nature's Way"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Knight of Meadowgrain"] }
  ],
  "steps": [
   { "cast": "Nature's Way", "targets": ["Grizzly Bears", "Knight of Meadowgrain"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Knight of Meadowgrain"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20, "battlefield_has": ["Grizzly Bears"] },
    { "graveyard_has": ["Lightning Bolt", "Knight of Meadowgrain"] }
   ],
   "keywords": { "Grizzly Bears": ["Vigilance", "Trample"] }
  }
 }
]
