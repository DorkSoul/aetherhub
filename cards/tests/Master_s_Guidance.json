[
  {
    "name": "two legendary attackers put counters on up to two attacking creatures",
    "players": [
      {
        "battlefield": [
          "Master's Guidance",
          "Marwyn, the Clearcutter",
          "Marwyn, the Preserver"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Marwyn, the Clearcutter",
            "at": "p1"
          },
          {
            "card": "Marwyn, the Preserver",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true,
        "targets": [
          "Marwyn, the Clearcutter",
          "Marwyn, the Preserver"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Marwyn, the Clearcutter": {
          "p1p1": 1
        },
        "Marwyn, the Preserver": {
          "p1p1": 1
        }
      },
      "pt": {
        "Marwyn, the Clearcutter": [
          3,
          2
        ],
        "Marwyn, the Preserver": [
          4,
          3
        ]
      }
    }
  },
  {
    "name": "one legendary attacker is not enough",
    "players": [
      {
        "battlefield": [
          "Master's Guidance",
          "Marwyn, the Clearcutter",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Marwyn, the Clearcutter",
            "at": "p1"
          },
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "pt": {
        "Marwyn, the Clearcutter": [
          2,
          1
        ]
      },
      "counters": {}
    }
  },
  {
    "name": "at your end step draw a card if you control a creature with power 4 or greater",
    "players": [
      {
        "battlefield": [
          "Master's Guidance",
          "Serra Angel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: counters may go on any two attacking creatures, not only legendary ones",
    "players": [
      { "battlefield": ["Master's Guidance", "Marwyn, the Clearcutter", "Marwyn, the Preserver", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Marwyn, the Clearcutter", "at": "p1" }, { "card": "Marwyn, the Preserver", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "targets": ["Marwyn, the Clearcutter", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Marwyn, the Clearcutter": { "p1p1": 1 }, "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
