[
 {
  "name": "opponent pays the mana cost: spell countered",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
   { "battlefield": ["Ice Cave", "Mountain"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 20 } ] }
 },
 {
  "name": "opponent declines: the spell resolves",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
   { "battlefield": ["Ice Cave", "Mountain"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true, "answers": [false] }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] }
 },
 {
  "name": "opponent cannot pay: no question, spell resolves",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
   { "battlefield": ["Ice Cave"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] }
 },
 {
  "name": "ruling: cost increases do not count; the opponent pays only the printed {R}",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] },
   { "battlefield": ["Ice Cave", "Mountain", "Thalia, Guardian of Thraben"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 20 } ] }
 }
]
