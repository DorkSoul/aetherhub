[
  {
    "name": "creatures without flying have reach: a ground creature can block an attacking flier",
    "players": [
      { "hand": ["Chaosphere"], "battlefield": ["Mountain", "Plains", "Plains", "Serra Angel"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Chaosphere" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Serra Angel", "at": "p1" }] },
      { "block": [{ "blocker": "Llanowar Elves", "attacker": "Serra Angel" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chaosphere", "Serra Angel"] },
        { "graveyard": ["Llanowar Elves"], "life": 20 }
      ]
    }
  },
  {
    "name": "without Chaosphere a ground creature cannot block a flier",
    "players": [
      { "battlefield": ["Serra Angel"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Serra Angel", "at": "p1" }] },
      { "block": [{ "blocker": "Llanowar Elves", "attacker": "Serra Angel" }], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Serra Angel"] },
        { "battlefield_has": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "a creature with flying cannot block a creature without flying",
    "players": [
      { "hand": ["Chaosphere"], "battlefield": ["Mountain", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Chaosphere" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Serra Angel", "attacker": "Grizzly Bears" }], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chaosphere", "Grizzly Bears"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "world rule: a second world permanent puts Chaosphere into the graveyard",
    "players": [
      { "hand": ["Chaosphere", "Gravity Sphere"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Plains", "Plains"] },
      { }
    ],
    "steps": [
      { "cast": "Chaosphere" },
      { "resolve": true },
      { "cast": "Gravity Sphere" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Chaosphere"], "battlefield_has": ["Gravity Sphere"] },
        { }
      ]
    }
  },
  {
    "name": "a flier cannot block a creature without flying: Serra Angel's block is dropped, Llanowar Elves blocks",
    "players": [
      { "hand": ["Chaosphere"], "battlefield": ["Mountain", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Serra Angel", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Chaosphere" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Serra Angel", "attacker": "Grizzly Bears" }, { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chaosphere", "Grizzly Bears"], "life": 20 },
        { "graveyard": ["Llanowar Elves"], "battlefield_has": ["Serra Angel"], "life": 20 }
      ]
    }
  }
]
