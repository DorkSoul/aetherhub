[
 {
  "name": "tap puts an oil counter on it",
  "players": [ { "battlefield": ["Rustvine Cultivator"] }, {} ],
  "steps": [ { "activate": "Rustvine Cultivator", "ability": 0 }, { "resolve": true } ],
  "expect": {
   "tapped": { "Rustvine Cultivator": true }
  }
 },
 {
  "name": "removing the oil counter untaps target land",
  "players": [ { "battlefield": ["Rustvine Cultivator", "Forest"] }, {} ],
  "steps": [
   { "activate": "Rustvine Cultivator", "ability": 0 },
   { "resolve": true },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "tap_for_mana": "Forest" },
   { "activate": "Rustvine Cultivator", "ability": 1, "targets": ["Forest"] },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Rustvine Cultivator": true, "Forest": false }
  }
 },
 {
  "name": "cannot untap a land without an oil counter",
  "players": [ { "battlefield": [ "Rustvine Cultivator", "Forest" ] }, {} ],
  "steps": [
   { "tap_for_mana": "Forest" },
   { "activate": "Rustvine Cultivator", "ability": 1, "targets": ["Forest"], "illegal": true }
  ],
  "expect": {
   "tapped": { "Forest": true, "Rustvine Cultivator": false }
  }
 }
]
