[
  {
    "name": "{3} makes base power 4 and grants trample until end of turn",
    "players": [
      { "battlefield": ["Turtle-Duck", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Turtle-Duck", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Turtle-Duck": [4, 4] },
      "players": [ { "battlefield_has": ["Turtle-Duck"] }, {} ]
    }
  },
  {
    "name": "needs three mana to activate",
    "players": [
      { "battlefield": ["Turtle-Duck", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Turtle-Duck", "ability": 0, "illegal": true }
    ],
    "expect": {
      "pt": { "Turtle-Duck": [0, 4] }
    }
  },
  {
    "name": "base power 4 reverts at cleanup",
    "players": [
      { "battlefield": ["Turtle-Duck", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Turtle-Duck", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Cleanup", "auto": true }
    ],
    "expect": {
      "pt": { "Turtle-Duck": [0, 4] }
    }
  },
  {
    "name": "ruling: a +3/+3 pump is applied whether it started before the base-power set (pump first)",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Turtle-Duck", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Turtle-Duck"] },
      { "resolve": true },
      { "activate": "Turtle-Duck", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Turtle-Duck": [7, 7] }
    }
  },
  {
    "name": "ruling: a +3/+3 pump is applied whether it started before the base-power set (base power set first)",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Turtle-Duck", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Turtle-Duck", "ability": 0 },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Turtle-Duck"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Turtle-Duck": [7, 7] }
    }
  }
]
