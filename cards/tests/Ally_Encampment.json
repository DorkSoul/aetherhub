[
  {
    "name": "sacrifice: returns target Ally you control to hand",
    "players": [ { "battlefield": ["Ally Encampment", "Affa Protector", "Island"] }, {} ],
    "steps": [
      { "activate": "Ally Encampment", "ability": 0, "targets": ["Affa Protector"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Affa Protector"], "battlefield_lacks": ["Ally Encampment", "Affa Protector"] }, {} ]
    }
  },
  {
    "name": "sacrifice ability needs a target Ally you control",
    "players": [ { "battlefield": ["Ally Encampment", "Island", "Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Ally Encampment", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Ally Encampment", "Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: the sacrifice ability cannot target an Ally in the graveyard",
    "players": [ { "battlefield": ["Ally Encampment", "Island"], "graveyard": ["Affa Protector"] }, {} ],
    "steps": [ { "activate": "Ally Encampment", "ability": 0, "targets": ["Affa Protector"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Affa Protector"], "battlefield_has": ["Ally Encampment"] }, {} ] }
  },
  {
    "name": "ruling: Ally Encampment's restricted white mana pays for an Ally spell",
    "players": [ { "hand": ["Affa Protector"], "battlefield": ["Ally Encampment", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Affa Protector" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Affa Protector"], "hand_count": 0 }, {} ] }
  },
  {
    "name": "ruling: Ally Encampment's restricted mana cannot pay for a non-Ally spell",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Ally Encampment"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "life": 20 } ] }
  }
]
