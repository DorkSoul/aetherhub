[
  {
    "name": "ETB returns target artifact or enchantment to its owner's hand",
    "players": [
      { "hand": ["Stern Proctor"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Darksteel Ingot"] }
    ],
    "steps": [
      { "cast": "Stern Proctor" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Stern Proctor"] }, { "battlefield_lacks": ["Darksteel Ingot"], "hand_count": 1 }]
    }
  },
  {
    "name": "no artifact or enchantment on the battlefield: enters and nothing happens",
    "players": [
      { "hand": ["Stern Proctor"], "battlefield": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Stern Proctor" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Stern Proctor"] }, {}]
    }
  },
  {
    "name": "ruling: your own artifact is a legal target and must be returned when it is the only one",
    "players": [
      { "hand": ["Stern Proctor"], "battlefield": ["Island", "Island", "Darksteel Ingot"] },
      {}
    ],
    "steps": [
      { "cast": "Stern Proctor" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Stern Proctor"], "battlefield_lacks": ["Darksteel Ingot"], "hand_count": 1 }, {}]
    }
  }
]
