[
  { "name": "changes the target of an opponent's Arcane spell to its own controller",
    "players": [ { "hand": ["Sideswipe"], "battlefield": ["Mountain", "Mountain"] },
                 { "hand": ["Gaze of Adamaro", "Grizzly Bears", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp"] } ],
    "steps": [ { "pass": true },
               { "cast": "Gaze of Adamaro", "player": 1, "targets": ["p0"] },
               { "cast": "Sideswipe", "targets": [ { "stack": "Gaze of Adamaro" } ] },
               { "resolve": true, "answers": [ [1] ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
  { "name": "keeping the current target leaves the Arcane spell unchanged",
    "players": [ { "hand": ["Sideswipe", "Island"], "battlefield": ["Mountain", "Mountain"] },
                 { "hand": ["Gaze of Adamaro"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp"] } ],
    "steps": [ { "pass": true },
               { "cast": "Gaze of Adamaro", "player": 1, "targets": ["p0"] },
               { "cast": "Sideswipe", "targets": [ { "stack": "Gaze of Adamaro" } ] },
               { "resolve": true, "answers": [ [0] ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 19 }, { "life": 20 } ] } },
  { "name": "a non-Arcane spell cannot be targeted",
    "players": [ { "hand": ["Sideswipe"], "battlefield": ["Mountain", "Mountain"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
               { "cast": "Sideswipe", "targets": [ { "stack": "Lightning Bolt" } ], "illegal": true } ],
    "expect": {} }
]
