      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Dan Lewis"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Sol Ring"] }, {} ],
