    "name": "ruling: an equipped artifact can be re-equipped to another creature you control",
    "players": [
      { "battlefield": ["Dan Lewis", "Sol Ring", "Grizzly Bears", "Hill Giant", "Plains", "Plains"] },
      {}
    ],
    "steps": [
