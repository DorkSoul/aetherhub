[
  { "name": "attack trigger: target creature can't block this turn",
    "players": [ { "battlefield": ["Goblin Heelcutter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Goblin Heelcutter", "at": "p1" } ] }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Goblin Heelcutter" } ], "illegal": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "dash: haste, attacks, then returns to hand at the end step",
    "players": [ { "hand": ["Goblin Heelcutter"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Goblin Heelcutter", "alt": 0 }, { "resolve": true }, { "attack": [ { "card": "Goblin Heelcutter", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Goblin Heelcutter"], "battlefield_lacks": ["Goblin Heelcutter"] }, { "life": 17 } ] } },
  { "name": "hard cast has no haste and stays on the battlefield",
    "players": [ { "hand": ["Goblin Heelcutter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Goblin Heelcutter" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Goblin Heelcutter"] }, {} ] } },
  { "name": "ruling: dash creature need not attack; it still returns at the end step",
    "players": [ { "hand": ["Goblin Heelcutter"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Goblin Heelcutter", "alt": 0 }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Goblin Heelcutter"], "battlefield_lacks": ["Goblin Heelcutter"] }, { "life": 20 } ] } },
  { "name": "ruling: dash creature that dies before the return resolves stays in the graveyard",
    "players": [ { "hand": ["Goblin Heelcutter", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Goblin Heelcutter", "alt": 0 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Goblin Heelcutter"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard_has": ["Goblin Heelcutter"], "battlefield_lacks": ["Goblin Heelcutter"] }, {} ] } }
