[
  {
    "name": "casting an instant gives +1/+0 until end of turn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Fire Urchin", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 17 }],
      "pt": { "Fire Urchin": [2, 3] }
    }
  },
  {
    "name": "casting a creature spell does not trigger it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", { "name": "Fire Urchin", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Fire Urchin": [1, 3] }
    }
  },
  {
    "name": "ruling: the trigger resolves even when the instant that caused it is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Fire Urchin", "sick": false }] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt"] }, { "life": 20, "graveyard": ["Counterspell"] }],
      "pt": { "Fire Urchin": [2, 3] },
      "stack_empty": true
    }
  }
]
