[
  {
    "name": "parley: each nonland card revealed pumps attacking creatures, then each player draws",
    "players": [
      { "battlefield": ["Woodvine Elemental", "Grizzly Bears"], "library": ["Grizzly Bears"] },
      { "library": ["Lightning Bolt"] }
    ],
    "steps": [
      { "attack": [{ "card": "Woodvine Elemental", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Woodvine Elemental": [6, 6], "Grizzly Bears": [4, 4] },
      "players": [{ "hand_count": 1 }, { "hand_count": 1, "life": 10 }]
    }
  },
  {
    "name": "a land revealed on one side and a nonland on the other: only one +1/+1",
    "players": [
      { "battlefield": ["Woodvine Elemental", "Grizzly Bears"], "library": ["Grizzly Bears"] },
      { "library": ["Forest"] }
    ],
    "steps": [
      { "attack": [{ "card": "Woodvine Elemental", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Woodvine Elemental": [5, 5], "Grizzly Bears": [2, 2] },
      "players": [{ "hand_count": 1 }, { "hand_count": 1 }]
    }
  },
  {
    "name": "only lands revealed: no pump, but everyone still draws",
    "players": [
      { "battlefield": ["Woodvine Elemental"], "library": ["Forest"] },
      { "library": ["Forest"] }
    ],
    "steps": [
      { "attack": [{ "card": "Woodvine Elemental", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Woodvine Elemental": [4, 4] },
      "players": [{ "hand_count": 1 }, { "hand_count": 1 }]
    }
  },
  {
    "name": "ruling: each player draws the card revealed from the top of their library",
    "players": [
      { "battlefield": ["Woodvine Elemental"], "library": ["Forest", "Grizzly Bears"] },
      { "library": ["Forest", "Lightning Bolt"] }
    ],
    "steps": [
      { "attack": [{ "card": "Woodvine Elemental", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "library_top": ["Grizzly Bears"] },
        { "hand": ["Forest"], "library_top": ["Lightning Bolt"] }
      ]
    }
  }
]
