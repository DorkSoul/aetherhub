  {
    "name": "ruling: an opponent's creature does not count, so it must sacrifice itself",
    "players": [
      { "hand": ["Kjeldoran Dead"], "battlefield": ["Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Kjeldoran Dead" },
