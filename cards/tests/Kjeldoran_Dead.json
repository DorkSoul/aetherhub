  {
    "name": "ruling: the sacrifice is a trigger, so the creature is still on the battlefield while it is on the stack",
    "players": [
      { "hand": ["Kjeldoran Dead"], "battlefield": ["Swamp", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Kjeldoran Dead" },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "stack_empty": false,
      "players": [
        { "battlefield_has": ["Kjeldoran Dead", "Grizzly Bears"] },
        {}
      ]
    }
