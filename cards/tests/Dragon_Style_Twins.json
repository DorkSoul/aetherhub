[
  {
    "name": "double strike deals damage twice when unblocked",
    "players": [
      {
        "battlefield": [
          "Dragon-Style Twins"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Dragon-Style Twins",
            "at": "p1"
          }
        ]
      },
      {
        "pass": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 14
        }
      ]
    }
  },
  {
    "name": "prowess from a noncreature spell",
    "players": [
      {
        "battlefield": [
          "Dragon-Style Twins",
          "Mountain"
        ],
        "hand": [
          "Lightning Bolt"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Dragon-Style Twins": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: prowess still resolves when the noncreature spell that caused it is countered",
    "players": [
      {
        "battlefield": ["Dragon-Style Twins", "Mountain"],
        "hand": ["Lightning Bolt"]
      },
      {
        "battlefield": ["Island", "Island", "Grizzly Bears"],
        "hand": ["Counterspell"]
      }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Counterspell"], "battlefield_has": ["Grizzly Bears"] }
      ],
      "pt": {
        "Dragon-Style Twins": [4, 4]
      }
    }
  },
  {
    "name": "ruling: playing a land does not trigger prowess",
    "players": [
      {
        "hand": ["Mountain"],
        "battlefield": ["Dragon-Style Twins"]
      },
      {}
    ],
    "steps": [
      { "play_land": "Mountain" }
    ],
    "expect": {
      "pt": {
        "Dragon-Style Twins": [3, 3]
      }
    }
  },
  {
    "name": "ruling: casting a creature spell does not trigger prowess",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Dragon-Style Twins", "Forest", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Dragon-Style Twins": [3, 3]
      }
    }
  }
]
