[
  {
    "name": "tapping an unenchanted land adds only its own mana",
    "players": [
      {
        "hand": [
          "Verdant Haven"
        ],
        "battlefield": [
          "Forest",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Plains",
        "color": "W"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "W": 1
          }
        },
        {}
      ]
    }
  },
  {
    "name": "Verdant Haven cannot enchant a nonland permanent",
    "players": [
      {
        "hand": [
          "Verdant Haven"
        ],
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Verdant Haven",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Verdant Haven"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "enchanted land: ETB gains 2 life; tapping it adds an extra mana of any color",
    "players": [
      {
        "hand": ["Verdant Haven", "Lightning Bolt"],
        "battlefield": ["Forest", "Swamp", "Mountain", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Verdant Haven", "targets": ["Mountain"] },
      { "resolve": true },
      { "resolve": true },
      { "tap_for_mana": "Mountain", "color": "R" }
    ],
    "expect": {
      "players": [
        { "life": 22, "pool": { "R": 2 } },
        {}
      ]
    }
  },
  {
    "name": "ruling: the enchanted land is destroyed in response; Verdant Haven fizzles, so it does not enter and its life gain does not trigger",
    "players": [ { "hand": ["Verdant Haven"], "battlefield": ["Forest", "Swamp", "Plains"] }, { "hand": ["Fissure"], "battlefield": ["Mountain", "Mountain", "Island", "Island", "Island"] } ],
    "steps": [ { "cast": "Verdant Haven", "targets": ["Plains"] }, { "pass": true }, { "cast": "Fissure", "player": 1, "targets": ["Plains"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Verdant Haven", "Plains"], "battlefield_lacks": ["Verdant Haven"] }, { "graveyard_has": ["Fissure"] } ] }
  }
]