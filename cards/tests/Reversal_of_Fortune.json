[
  { "name": "copies an instant from the opponent's hand and casts the copy free",
    "players": [ { "hand": ["Reversal of Fortune"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Island"] }, { "hand": ["Divination", "Grizzly Bears"] } ],
    "steps": [
      { "cast": "Reversal of Fortune", "targets": ["p1"] },
      { "resolve": true, "answers": [["Divination"], true] }
    ],
    "expect": {
      "players": [
        { "hand_count": 2, "graveyard": ["Reversal of Fortune"] },
        { "hand": ["Divination", "Grizzly Bears"], "graveyard": [] }
      ]
    } },
  { "name": "no instant or sorcery in the opponent's hand: nothing is copied",
    "players": [ { "hand": ["Reversal of Fortune"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Island"] }, { "hand": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Reversal of Fortune", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Reversal of Fortune"] },
        { "hand": ["Grizzly Bears"] }
      ]
    } },
  { "name": "ruling: declining to cast the copy draws nothing and the copy ceases to exist",
    "players": [ { "hand": ["Reversal of Fortune"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Island"] }, { "hand": ["Divination", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Reversal of Fortune", "targets": ["p1"] }, { "resolve": true, "answers": [["Divination"], false] } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Reversal of Fortune"] }, { "hand": ["Divination", "Grizzly Bears"], "graveyard": [] } ] } },
  { "name": "ruling: choosing no card to copy creates no copy and casts nothing",
    "players": [ { "hand": ["Reversal of Fortune"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Island"] }, { "hand": ["Divination", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Reversal of Fortune", "targets": ["p1"] }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "hand_count": 0 }, { "hand": ["Divination", "Grizzly Bears"] } ] } }
]
