[
 { "name": "domain of 5 puts a counter on Zar itself when it becomes tapped by attacking",
   "players": [ { "battlefield": ["Plains", "Island", "Swamp", "Mountain", "Forest", "Zar Ojanen, Scion of Efrava"] }, {} ],
   "steps": [ { "attack": [ { "card": "Zar Ojanen, Scion of Efrava", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "pt": { "Zar Ojanen, Scion of Efrava": [5, 5] } } },
 { "name": "only creatures with toughness below the domain get a counter",
   "players": [ { "battlefield": ["Plains", "Island", "Forest", "Zar Ojanen, Scion of Efrava", "Grizzly Bears", "Hill Giant"] }, {} ],
   "steps": [ { "attack": [ { "card": "Zar Ojanen, Scion of Efrava", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "pt": { "Grizzly Bears": [3, 3], "Hill Giant": [3, 3], "Zar Ojanen, Scion of Efrava": [4, 4] } } },
 { "name": "ruling: domain counts basic land types, not lands (three Plains and an Island is domain 2)",
   "players": [ { "battlefield": ["Plains", "Plains", "Plains", "Island", "Zar Ojanen, Scion of Efrava", "Grizzly Bears"] }, {} ],
   "steps": [ { "attack": [ { "card": "Zar Ojanen, Scion of Efrava", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2], "Zar Ojanen, Scion of Efrava": [4, 4] } } },
 { "name": "ruling: non-basic land types such as Desert do not count toward domain",
   "players": [ { "battlefield": ["Plains", "Island", "Desert", "Zar Ojanen, Scion of Efrava", "Grizzly Bears"] }, {} ],
   "steps": [ { "attack": [ { "card": "Zar Ojanen, Scion of Efrava", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] } } }
]
