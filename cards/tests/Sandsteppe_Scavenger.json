[
  {
    "name": "bolster 2 goes on the least-toughness creature",
    "players": [ { "hand": ["Sandsteppe Scavenger"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Llanowar Elves"] }, {} ],
    "steps": [ { "cast": "Sandsteppe Scavenger" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "counters": { "Llanowar Elves": { "p1p1": 2 } }, "pt": { "Llanowar Elves": [3, 3], "Sandsteppe Scavenger": [2, 2] } }
  },
  {
    "name": "bolster 2 with no other creature puts two counters on itself",
    "players": [ { "hand": ["Sandsteppe Scavenger"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Sandsteppe Scavenger" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Sandsteppe Scavenger": [4, 4] } }
  },
  {
    "name": "ruling: bolster still resolves after the Scavenger left, using the creature with least toughness then",
    "players": [ { "hand": ["Sandsteppe Scavenger", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Llanowar Elves"] }, {} ],
    "steps": [
      { "cast": "Sandsteppe Scavenger" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Sandsteppe Scavenger"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Sandsteppe Scavenger"] }, {} ],
      "counters": { "Llanowar Elves": { "p1p1": 2 } },
      "pt": { "Llanowar Elves": [3, 3] }
    }
  }
]
