[
  {
    "name": "enters: 4 damage to each opponent",
    "players": [
      { "hand": ["Fear of Burning Alive"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
