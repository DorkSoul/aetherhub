      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Fear of Burning Alive"] },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "delirium: noncombat damage to an opponent is dealt again to their creature",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Fear of Burning Alive"],
        "graveyard": ["Divination", "Grizzly Bears", "Mountain", "Doom Blade"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the delirium trigger deals the damage dealt (3 from Bolt), not a fixed 4",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Fear of Burning Alive"],
        "graveyard": ["Divination", "Grizzly Bears", "Mountain", "Doom Blade"]
      },
      { "battlefield": ["Fear of Burning Alive"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "battlefield_has": ["Fear of Burning Alive"] }
      ]
    }
  },
  {
    "name": "ruling: combat damage is not noncombat, so delirium does not trigger",
    "players": [
      {
        "battlefield": ["Fear of Burning Alive"],
        "graveyard": ["Divination", "Grizzly Bears", "Mountain", "Doom Blade"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Fear of Burning Alive", "at": "p1" } ] },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 16, "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
