 {
  "name": "raid: exile the top two, keep the chosen one playable",
  "players": [
   {
    "hand": [
     "Strongbox Raider"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain",
     "Grizzly Bears"
    ],
    "library": [
     "Island",
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "advance_to": "Main2"
   },
   {
    "cast": "Strongbox Raider"
   },
   {
    "resolve": true,
    "answers": [
     [
      "Island"
     ]
    ]
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Strongbox Raider"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: a land exiled by raid can be played in your main phase with an empty stack",
  "players": [ { "hand": ["Strongbox Raider"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Island", "Hill Giant"] }, {} ],
  "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" }, { "cast": "Strongbox Raider" }, { "resolve": true, "answers": [["Island"]] }, { "play_land": "Island" } ],
  "expect": { "players": [ { "battlefield_has": ["Strongbox Raider", "Island"] }, {} ] }
 },
 {
  "name": "ruling: a land exiled by raid cannot be played during the opponent's turn",
  "players": [ { "hand": ["Strongbox Raider"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Island", "Hill Giant"] }, {} ],
  "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" }, { "cast": "Strongbox Raider" }, { "resolve": true, "answers": [["Island"]] }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "play_land": "Island", "illegal": true } ],
  "expect": { "players": [ { "battlefield_lacks": ["Island"] }, {} ] }
 },
 {
  "name": "ruling: raid still counts when the attacking creature died in combat",
  "players": [ { "hand": ["Strongbox Raider"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Island", "Hill Giant"] }, { "battlefield": ["Hill Giant"] } ],
  "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 }, { "advance_to": "Main2" }, { "cast": "Strongbox Raider" }, { "resolve": true, "answers": [["Island"]] }, { "play_land": "Island" } ],
  "expect": { "players": [ { "battlefield_has": ["Strongbox Raider", "Island"], "graveyard": ["Grizzly Bears"] }, {} ] }
 }
]
