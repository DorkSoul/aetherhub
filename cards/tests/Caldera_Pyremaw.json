   "expect": { "players": [ {}, { "life": 20 } ], "pt": { "Caldera Pyremaw": [3, 3] } } },
 { "name": "ruling: if Pyremaw leaves in response to its trigger, its last power is the damage",
   "players": [
     { "hand": ["Lightning Bolt"], "battlefield": ["Caldera Pyremaw", "Mountain"] },
