[
  { "name": "counters a spell and reveals its controller's hand",
    "players": [ { "hand": ["Lay Bare"], "battlefield": ["Island", "Island", "Island", "Island"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
               { "cast": "Lay Bare", "targets": [ { "stack": "Lightning Bolt" } ] },
               { "resolve": true },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lay Bare"], "battlefield_has": ["Island"] },
                             { "graveyard_has": ["Lightning Bolt"] } ] } },
  { "name": "can't be cast without a spell to counter",
    "players": [ { "hand": ["Lay Bare"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Lay Bare", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Lay Bare"] }, {} ] } }
]
