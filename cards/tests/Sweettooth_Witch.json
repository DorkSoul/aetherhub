[
  {
    "name": "enters and creates a Food token",
    "players": [
      {
        "hand": [
          "Sweettooth Witch"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sweettooth Witch"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Sweettooth Witch",
            "Food"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "sacrifice a Food: target player loses 2 life",
    "players": [
      {
        "battlefield": [
          "Sweettooth Witch",
          "Swamp",
          "Swamp",
          "Bagel and Schmear"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sweettooth Witch",
        "ability": 0,
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Bagel and Schmear"
          ],
          "battlefield_has": [
            "Sweettooth Witch"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "the ability needs a Food to sacrifice",
    "players": [
      {
        "battlefield": [
          "Sweettooth Witch",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sweettooth Witch",
        "ability": 0,
        "targets": [
          "p1"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: a Food can only be sacrificed once, so a second activation needs another Food",
    "players": [
      { "battlefield": ["Sweettooth Witch", "Swamp", "Swamp", "Swamp", "Swamp", "Bagel and Schmear"] },
      {}
    ],
    "steps": [
      { "activate": "Sweettooth Witch", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Sweettooth Witch", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Bagel and Schmear"] },
        { "life": 18 }
      ]
    }
  }
