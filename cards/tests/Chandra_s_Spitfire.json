[
 { "name": "noncombat damage to opponent gives +3/+0 until end of turn",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Chandra's Spitfire", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Chandra's Spitfire": [4, 3] } } },
 { "name": "noncombat damage to a creature does not trigger it",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Chandra's Spitfire", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "pt": { "Chandra's Spitfire": [1, 3] } } },
 { "name": "combat damage to opponent does not trigger it",
   "players": [ { "battlefield": ["Chandra's Spitfire"] }, {} ],
   "steps": [ { "attack": [ { "card": "Chandra's Spitfire", "at": "p1" } ] }, { "pass": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 19 } ], "pt": { "Chandra's Spitfire": [1, 3] } } },
 { "name": "ruling: a noncombat Bolt cast during combat pumps Spitfire, so its combat damage is 4",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Chandra's Spitfire", "Mountain"] }, {} ],
   "steps": [ { "attack": [ { "card": "Chandra's Spitfire", "at": "p1" } ] }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 13 } ], "pt": { "Chandra's Spitfire": [4, 3] } } },
 { "name": "ruling: each noncombat damage event triggers once, so two Bolts give +6/+0",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Chandra's Spitfire", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 14 } ], "pt": { "Chandra's Spitfire": [7, 3] } } }
