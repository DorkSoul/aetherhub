[
  {
    "name": "ETB destroys a Swamp an opponent controls",
    "players": [
      { "hand": ["Marshdrinker Giant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Swamp", "Island"] }
    ],
    "steps": [
      { "cast": "Marshdrinker Giant" },
      { "resolve": true, "targets": ["Swamp"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Marshdrinker Giant"] },
        { "graveyard_has": ["Swamp"], "battlefield_has": ["Island"] }
      ]
    }
  },
  {
    "name": "cannot target a Forest",
    "players": [
      { "hand": ["Marshdrinker Giant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Marshdrinker Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield_has": ["Forest"] }
      ]
    }
  }
]
