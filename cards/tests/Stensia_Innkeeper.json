[
  {
    "name": "ETB taps target opposing land; it does not untap during its controller's next untap step",
    "players": [
      { "hand": ["Stensia Innkeeper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Stensia Innkeeper" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [{}, {}],
      "tapped": { "Forest": true }
    }
  },
  {
    "name": "the land untaps in the untap step after the skipped one",
    "players": [
      { "hand": ["Stensia Innkeeper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Stensia Innkeeper" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [{}, {}],
      "tapped": { "Forest": false }
    }
  }
]
