   { "resolve": true, "answers": [true] },
   { "cast": "Secrets of the Golden City", "alt": 100, "illegal": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["The Fugitive Doctor"], "graveyard": ["Secrets of the Golden City"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: a sorcery granted flashback can be cast in the second main phase, and is then exiled",
  "players": [
   { "battlefield": ["The Fugitive Doctor", "Clue", "Mountain", "Forest", "Forest", "Forest"], "graveyard": ["Secrets of the Golden City"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "The Fugitive Doctor", "at": "p1" } ] },
   { "resolve": true, "answers": [true] },
   { "advance_to": "Main2" },
   { "cast": "Secrets of the Golden City", "alt": 100 },
   { "resolve": true }
