[
  {
    "name": "outlast: {1}{W}, tap: put a +1/+1 counter on it",
    "players": [{ "battlefield": ["Salt Road Patrol", "Plains", "Plains"] }, {}],
    "steps": [{ "activate": "Salt Road Patrol" }, { "resolve": true }],
    "expect": {
      "players": [{ "battlefield_has": ["Salt Road Patrol"] }, {}],
      "counters": { "Salt Road Patrol": { "p1p1": 1 } },
      "pt": { "Salt Road Patrol": [3, 6] },
      "tapped": { "Salt Road Patrol": true }
    }
  },
  {
    "name": "outlast needs {1}{W} to pay",
    "players": [{ "battlefield": ["Salt Road Patrol", "Plains"] }, {}],
    "steps": [{ "activate": "Salt Road Patrol", "illegal": true }],
    "expect": { "players": [{}, {}], "counters": {} }
  },
  {
    "name": "outlast cannot be activated again while tapped",
    "players": [{ "battlefield": ["Salt Road Patrol", "Plains", "Plains", "Plains", "Plains"] }, {}],
    "steps": [{ "activate": "Salt Road Patrol" }, { "resolve": true }, { "activate": "Salt Road Patrol", "illegal": true }],
    "expect": { "players": [{}, {}], "counters": { "Salt Road Patrol": { "p1p1": 1 } } }
  },
  {
    "name": "ruling: outlast needs the creature under your control since your turn began (summoning sick cannot tap for it)",
    "players": [{ "hand": ["Salt Road Patrol"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {}],
    "steps": [
      { "cast": "Salt Road Patrol" },
      { "resolve": true },
      { "activate": "Salt Road Patrol", "illegal": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Salt Road Patrol"] }, {}], "counters": {}, "tapped": { "Salt Road Patrol": false } }
  }
]
