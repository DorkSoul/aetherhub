[
  { "name": "enters with three ice counters, 7/7 with defender",
    "players": [ { "hand": ["Woolly Razorback"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Woolly Razorback" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Woolly Razorback"] }, {} ],
                "counters": { "Woolly Razorback": { "ice": 3 } },
                "pt": { "Woolly Razorback": [7, 7] },
                "keywords": { "Woolly Razorback": ["Defender"] } } },
  { "name": "cannot attack while it has an ice counter (defender)",
    "players": [ { "battlefield": [ { "name": "Woolly Razorback", "counters": { "ice": 2 } } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Woolly Razorback", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, {} ] } },
  { "name": "blocking removes an ice counter; its combat damage is prevented",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": [ { "name": "Woolly Razorback", "counters": { "ice": 3 } } ] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Woolly Razorback", "attacker": "Grizzly Bears" } ] },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Woolly Razorback"] } ],
                "counters": { "Woolly Razorback": { "ice": 2 } } } },
  { "name": "ruling: last ice counter removed on block, so that combat's damage is no longer prevented",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": [ { "name": "Woolly Razorback", "counters": { "ice": 1 } } ] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Woolly Razorback", "attacker": "Grizzly Bears" } ] },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"] }, { "battlefield_has": ["Woolly Razorback"] } ],
                "counters": { "Woolly Razorback": { "ice": 0 } } } }
]
