[
  { "name": "exiles a noncreature nonland card from your graveyard",
    "players": [ { "hand": ["Practiced Scrollsmith"], "battlefield": ["Mountain", "Mountain", "Plains"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Practiced Scrollsmith" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Lightning Bolt"], "graveyard": [] }, {} ] } },
  { "name": "creature cards in your graveyard are not targeted",
    "players": [ { "hand": ["Practiced Scrollsmith"], "battlefield": ["Mountain", "Mountain", "Plains"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Practiced Scrollsmith" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": [], "graveyard": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: an exiled sorcery can be cast only in a main phase with an empty stack",
    "players": [ { "hand": ["Practiced Scrollsmith"], "battlefield": ["Mountain", "Mountain", "Plains", "Island", "Island"], "graveyard": ["Hands of Binding"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Practiced Scrollsmith" }, { "resolve": true }, { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "cast": "Hands of Binding", "targets": ["Grizzly Bears"], "illegal": true },
      { "advance_to": "Main2" },
      { "cast": "Hands of Binding", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Hands of Binding"], "exile": [] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } } }
]
