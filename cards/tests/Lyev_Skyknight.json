[
  {
    "name": "ETB detains the only opposing creature: it can't block Hill Giant",
    "players": [
      { "hand": ["Lyev Skyknight"], "battlefield": ["Plains", "Island", "Island", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lyev Skyknight" },
      { "resolve": true },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "detained nonland permanent stays on the battlefield (no removal)",
    "players": [
      { "hand": ["Lyev Skyknight"], "battlefield": ["Plains", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lyev Skyknight" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Lyev Skyknight"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: a detained creature's triggered abilities still trigger (Attuned Hunter grows when its controller's Gravedigger returns a card on their turn)",
    "players": [
      { "hand": ["Lyev Skyknight"], "battlefield": ["Plains", "Island", "Island"] },
      { "hand": ["Gravedigger"], "graveyard": ["Grizzly Bears"], "battlefield": ["Attuned Hunter", "Swamp", "Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Lyev Skyknight" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "player": 1, "cast": "Gravedigger" },
      { "player": 1, "resolve": true, "answers": [true] },
      { "player": 1, "resolve": true },
      { "player": 1, "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Attuned Hunter", "Gravedigger"] } ],
      "counters": { "Attuned Hunter": { "p1p1": 1 } }
    }
  },
  {
    "name": "ruling: a detained permanent's activated ability cannot be activated, even by its controller",
    "players": [
      { "hand": ["Lyev Skyknight"], "battlefield": ["Plains", "Island", "Island"] },
      { "battlefield": ["Witching Well", "Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lyev Skyknight" },
      { "resolve": true },
      { "pass": true },
      { "activate": "Witching Well", "ability": 0, "player": 1, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Lyev Skyknight"] }, { "battlefield_has": ["Witching Well"] } ]
    }
  }
]
