[
  {
    "name": "opponent's creature that would die is exiled and I create a 2/2 Wolf",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Head of the Hunt", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Head of the Hunt", "Wolf"], "graveyard": ["Lightning Bolt"] },
        { "exile": ["Grizzly Bears"], "graveyard": [] }
      ]
    }
  },
  {
    "name": "boundary: my own creature that dies still goes to the graveyard and no Wolf is made",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Head of the Hunt", "Grizzly Bears", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Head of the Hunt"], "battlefield_lacks": ["Wolf"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] },
        { "exile": [] }
      ]
    }
  },
  {
    "name": "ruling: a creature card an opponent discards still goes to their graveyard, not exile",
    "players": [
      { "hand": ["Hymn to Tourach"], "battlefield": ["Head of the Hunt", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Hymn to Tourach", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Head of the Hunt"] },
        { "hand": [], "graveyard": ["Grizzly Bears"], "exile": [] }
      ]
    }
  }
]
