[
  { "name": "foretell exiles it face down for {2}",
    "players": [ { "hand": ["Augury Raven"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Augury Raven", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Augury Raven"], "hand_count": 0 }, {} ] } },
  { "name": "foretold card cannot be cast the same turn",
    "players": [ { "hand": ["Augury Raven"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Augury Raven", "ability": 0 }, { "resolve": true }, { "cast": "Augury Raven", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Augury Raven"] }, {} ] } },
  { "name": "foretold card is cast for {1}{U} on a later turn",
    "players": [ { "hand": ["Augury Raven"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Augury Raven", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Augury Raven", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Augury Raven"] }, {} ] } },
  { "name": "cannot foretell with only one land (costs {2})",
    "players": [ { "hand": ["Augury Raven"], "battlefield": ["Island"] }, {} ],
    "steps": [ { "activate": "Augury Raven", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Augury Raven"] }, {} ] } },
  { "name": "ruling: foretelling is a special action usable in response to a spell",
    "players": [ { "hand": ["Augury Raven", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Augury Raven", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Augury Raven"], "hand_count": 0 }, { "life": 17 } ] } },
  { "name": "ruling: a foretold creature cannot be cast during the opponent's turn",
    "players": [ { "hand": ["Augury Raven"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Augury Raven", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Augury Raven", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Augury Raven"] }, {} ] } }
]
