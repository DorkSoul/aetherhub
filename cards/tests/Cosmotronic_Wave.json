[
  {
    "name": "1 damage to each creature opponents control",
    "players": [
      { "hand": ["Cosmotronic Wave"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Llanowar Elves", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cosmotronic Wave" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Cosmotronic Wave"] },
        { "graveyard": ["Llanowar Elves"], "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "creatures opponents control can't block this turn",
    "players": [
      { "hand": ["Cosmotronic Wave"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cosmotronic Wave" },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18, "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: a creature that came under the opponent's control after Wave resolved still can't block",
    "players": [
      { "hand": ["Cosmotronic Wave"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "hand": ["Hushwing Gryff"], "battlefield": ["Plains", "Plains", "Plains"] }
    ],
    "steps": [
      { "cast": "Cosmotronic Wave" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Hushwing Gryff", "player": 1 },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hushwing Gryff", "attacker": "Grizzly Bears" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18, "battlefield_has": ["Hushwing Gryff"] } ] }
  }
]
