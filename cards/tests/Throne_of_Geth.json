[
  {
    "name": "sacrifices itself to proliferate counters",
    "players": [
      {
        "battlefield": [
          "Throne of Geth",
          {
            "name": "Grizzly Bears",
            "counters": {
              "p1p1": 1
            }
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Throne of Geth",
        "targets": []
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Throne of Geth"
          ]
        },
        {}
      ],
      "counters": {
        "Grizzly Bears": {
          "p1p1": 2
        }
      }
    }
  },
  {
    "name": "ruling: an opponent's creature with a counter can be chosen and gets another",
    "players": [
      { "battlefield": ["Throne of Geth"] },
      { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } } ] }
    ],
    "steps": [
      { "activate": "Throne of Geth", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Throne of Geth"] }, {} ],
      "counters": { "Grizzly Bears": { "p1p1": 2 } }
    }
  },
  {
    "name": "ruling: choosing only some permanents with counters leaves the others alone",
    "players": [
      { "battlefield": [
          "Throne of Geth",
          { "name": "Grizzly Bears", "counters": { "p1p1": 1 } },
          { "name": "Savannah Lions", "counters": { "p1p1": 1 } }
      ] },
      {}
    ],
    "steps": [
      { "activate": "Throne of Geth", "targets": [] },
      { "resolve": true, "answers": [ ["Savannah Lions"] ] }
    ],
    "expect": {
      "players": [ {}, {} ],
      "counters": { "Grizzly Bears": { "p1p1": 1 }, "Savannah Lions": { "p1p1": 2 } }
    }
  },
  {
    "name": "ruling: a 'whenever you proliferate' trigger fires even when nothing is chosen",
    "players": [
      { "battlefield": ["Throne of Geth", "Ezuri, Stalker of Spheres", { "name": "Savannah Lions", "counters": { "p1p1": 1 } }] },
      {}
    ],
    "steps": [
      { "activate": "Throne of Geth", "targets": [] },
      { "resolve": true, "answers": [ [] ] }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, {} ],
      "counters": { "Savannah Lions": { "p1p1": 1 } }
    }
  },
  {
    "name": "ruling: a player chosen for proliferate gets one of each counter kind it has",
    "players": [
      { "battlefield": ["Throne of Geth"] },
      { "energy": 2, "poison": 1 }
    ],
    "steps": [
      { "activate": "Throne of Geth", "targets": [] },
      { "resolve": true, "answers": [ [0] ] }
    ],
    "expect": {
      "players": [ {}, { "energy": 3, "poison": 2 } ]
    }
  },
  {
    "name": "ruling: +1/+1 and -1/-1 counters on the same permanent are removed in pairs",
    "players": [
      { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 2, "m1m1": 1 } } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "counters": { "Grizzly Bears": { "p1p1": 1, "m1m1": 0 } },
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
