[
 {
  "name": "T: each player mills a card",
  "players": [ { "battlefield": ["Ghoulcaller's Bell"] }, {} ],
  "steps": [ { "activate": "Ghoulcaller's Bell" }, { "resolve": true } ],
  "expect": { "players": [ { "library_count": 19 }, { "library_count": 19 } ], "tapped": { "Ghoulcaller's Bell": true } }
 },
 {
  "name": "cannot be activated again while tapped",
  "players": [ { "battlefield": ["Ghoulcaller's Bell"] }, {} ],
  "steps": [
   { "activate": "Ghoulcaller's Bell" },
   { "resolve": true },
   { "activate": "Ghoulcaller's Bell", "illegal": true }
  ],
  "expect": { "players": [ { "library_count": 19 }, { "library_count": 19 } ] }
 }
]
