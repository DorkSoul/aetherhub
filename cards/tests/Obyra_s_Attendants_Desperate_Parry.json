    "steps": [ { "cast": "Obyra's Attendants // Desperate Parry", "face": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [-2, 2] }, "players": [ { "exile": ["Obyra's Attendants // Desperate Parry"] }, {} ] } },
  { "name": "the adventure half cannot be cast with one land",
