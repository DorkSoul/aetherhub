    "steps": [ { "cast": "Obyra's Attendants // Desperate Parry", "face": true, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Obyra's Attendants // Desperate Parry"] }, {} ] } },
  { "name": "ruling: an Adventure spell that fizzles goes to the graveyard, not exile",
    "players": [ { "hand": ["Obyra's Attendants // Desperate Parry"], "battlefield": ["Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Obyra's Attendants // Desperate Parry", "face": true, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Obyra's Attendants // Desperate Parry"], "exile": [] }, {} ] } },
  { "name": "ruling: the creature half is castable from exile after the Adventure resolves",
    "players": [ { "hand": ["Obyra's Attendants // Desperate Parry"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Obyra's Attendants // Desperate Parry", "face": true, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Obyra's Attendants // Desperate Parry" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Obyra's Attendants // Desperate Parry"], "exile": [] }, {} ] } },
  { "name": "ruling: the creature cast from exile still follows sorcery timing (not on the opponent's turn)",
    "players": [ { "hand": ["Obyra's Attendants // Desperate Parry"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Obyra's Attendants // Desperate Parry", "face": true, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Obyra's Attendants // Desperate Parry", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Obyra's Attendants // Desperate Parry"] }, {} ] } }
