    "steps": [ { "cast": "Obyra's Attendants // Desperate Parry" }, { "resolve": true } ],
    "expect": { "pt": { "Obyra's Attendants // Desperate Parry": [3, 4] }, "keywords": { "Obyra's Attendants // Desperate Parry": ["Flying"] } } },
