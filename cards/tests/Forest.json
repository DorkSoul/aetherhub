[
  {
    "name": "can be played as a land drop",
    "players": [ { "hand": ["Forest"] }, {} ],
    "steps": [ { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, {} ] }
  },
  {
    "name": "taps for green mana to pay a green cost",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "two Islands cannot pay for a green cost",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] }
  }
]
