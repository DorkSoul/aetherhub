[
  { "name": "attacks when the defending player controls an Island",
    "players": [ { "battlefield": [{ "name": "Island Fish Jasconius", "sick": false }, "Island"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [{ "card": "Island Fish Jasconius", "at": "p1" }], "answers": [false] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 14 } ] } },
  { "name": "stays tapped when you decline to pay UUU in upkeep",
    "players": [ { "battlefield": [{ "name": "Island Fish Jasconius", "sick": false }, "Island", "Island", "Island"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [{ "card": "Island Fish Jasconius", "at": "p1" }], "answers": [false] }, { "block": [] }, { "advance_to": "Main2" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
    "expect": { "turn": 3, "tapped": { "Island Fish Jasconius": true } } },
  { "name": "untaps when you pay UUU in upkeep",
    "players": [ { "battlefield": [{ "name": "Island Fish Jasconius", "sick": false }, "Island", "Island", "Island"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [{ "card": "Island Fish Jasconius", "at": "p1" }], "answers": [false] }, { "block": [] }, { "advance_to": "Main2" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
    "expect": { "turn": 3, "tapped": { "Island Fish Jasconius": false } } },
  { "name": "sacrificed when you control no Islands",
    "players": [ { "battlefield": ["Island Fish Jasconius"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Island Fish Jasconius"] }, {} ] } },
  { "name": "can't attack a player who controls no Island: Jasconius is dropped, Grizzly Bears still hits for 2",
    "players": [ { "battlefield": [{ "name": "Island Fish Jasconius", "sick": false }, "Island", { "name": "Grizzly Bears", "sick": false }] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [{ "card": "Island Fish Jasconius", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }], "answers": [false] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ], "tapped": { "Island Fish Jasconius": false, "Grizzly Bears": true } } }
]
