[
  { "name": "opponent's spell targets a permanent you control: you may draw",
    "players": [ { "battlefield": ["Battle Mammoth"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Battle Mammoth"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "your own spell targeting your permanent does not trigger it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Battle Mammoth"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Battle Mammoth"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Lightning Bolt"] }, {} ] } },
  { "name": "opponent's spell targeting their own creature does not trigger it",
    "players": [ { "battlefield": ["Battle Mammoth"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } },
  { "name": "foretell exiles it face down for {2}",
    "players": [ { "hand": ["Battle Mammoth"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Battle Mammoth", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Battle Mammoth"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: foretell is a special action, so you can take it in response to your own spell",
    "players": [ { "hand": ["Lightning Bolt", "Battle Mammoth"], "battlefield": ["Mountain", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Battle Mammoth", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Battle Mammoth"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
  { "name": "ruling: a foretold card cannot be cast on the turn it was foretold, but can on a later turn for its foretell cost",
    "players": [ { "hand": ["Battle Mammoth"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Battle Mammoth", "ability": 0 },
      { "resolve": true },
      { "cast": "Battle Mammoth", "illegal": true },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "cast": "Battle Mammoth" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Battle Mammoth"], "exile": [] }, {} ] } },
  { "name": "ruling: you choose whether to draw as the trigger resolves (declining draws nothing)",
    "players": [ { "battlefield": ["Battle Mammoth"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Battle Mammoth"] }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Battle Mammoth"] }, { "graveyard": ["Lightning Bolt"] } ] } }
]
