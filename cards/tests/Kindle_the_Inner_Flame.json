[
  {
    "name": "flashback with three Elementals beheld",
    "players": [
      { "graveyard": ["Kindle the Inner Flame"], "battlefield": ["Fire Elemental", "Earth Elemental", "Air Elemental", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Kindle the Inner Flame", "alt": 0, "targets": ["Fire Elemental"] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "exile": ["Kindle the Inner Flame"], "battlefield_has": ["Fire Elemental", "Fire Elemental"] }, {}] }
  },
  {
    "name": "two Elementals are not enough to flash it back",
    "players": [
      { "graveyard": ["Kindle the Inner Flame"], "battlefield": ["Fire Elemental", "Earth Elemental", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [{ "cast": "Kindle the Inner Flame", "alt": 0, "targets": ["Fire Elemental"], "illegal": true }],
    "expect": { "players": [{ "graveyard": ["Kindle the Inner Flame"] }, {}] }
  },
  {
    "name": "an Elemental card in hand counts as a beheld Elemental",
    "players": [
      { "hand": ["Air Elemental"], "graveyard": ["Kindle the Inner Flame"], "battlefield": ["Fire Elemental", "Earth Elemental", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Kindle the Inner Flame", "alt": 0, "targets": ["Fire Elemental"] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "exile": ["Kindle the Inner Flame"] }, {}] }
  },
  {
    "name": "ruling: a non-Elemental creature card in hand cannot be revealed to behold",
    "players": [
      { "hand": ["Grizzly Bears"], "graveyard": ["Kindle the Inner Flame"], "battlefield": ["Fire Elemental", "Earth Elemental", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [{ "cast": "Kindle the Inner Flame", "alt": 0, "targets": ["Fire Elemental"], "illegal": true }],
    "expect": { "players": [{ "graveyard": ["Kindle the Inner Flame"], "hand": ["Grizzly Bears"] }, {}] }
  },
  {
    "name": "ruling: the copy's enters ability (Kor Skyfisher) triggers when the token enters",
    "players": [
      { "hand": ["Kindle the Inner Flame"], "battlefield": ["Kor Skyfisher", "Mountain", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Kindle the Inner Flame", "targets": ["Kor Skyfisher"] },
      { "resolve": true, "answers": ["Mountain"] }
    ],
    "expect": { "players": [{ "hand": ["Mountain"], "battlefield_has": ["Kor Skyfisher", "Forest"] }, {}] }
  },
  {
    "name": "ruling: flashback is sorcery speed, so it cannot be cast on the opponent's turn",
    "players": [
      { "graveyard": ["Kindle the Inner Flame"], "battlefield": ["Fire Elemental", "Earth Elemental", "Air Elemental", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Kindle the Inner Flame", "alt": 0, "targets": ["Fire Elemental"], "illegal": true }
    ],
    "expect": { "players": [{ "graveyard": ["Kindle the Inner Flame"] }, {}] }
  }
]
