[
  {
    "name": "dies to Lightning Bolt and its controller draws a card",
    "players": [ { "battlefield": ["Runewing"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Runewing"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Runewing"], "hand_count": 1 }, { "graveyard": ["Lightning Bolt"] } ] }
  },
  {
    "name": "bolt aimed at the opponent does not draw",
    "players": [ { "battlefield": ["Runewing"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Runewing"], "hand_count": 0 }, {} ] }
  }
]
