   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Autarch Mammoth", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Autarch Mammoth", "Pilot 1-1 Colorless"] }, {} ], "tapped": { "Pilot 1-1 Colorless": false } } },
