  {
    "name": "ruling: devoid makes the card colorless, so Hydroblast (counter a red spell) cannot counter it",
    "players": [
      { "hand": ["Transgress the Mind"], "battlefield": ["Swamp", "Swamp"] },
      { "hand": ["Hill Giant", "Hydroblast"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "cast": "Transgress the Mind", "targets": ["p1"] },
      { "pass": true },
      { "player": 1, "cast": "Hydroblast", "targets": [ { "stack": "Transgress the Mind" } ], "answers": [0] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Transgress the Mind"] }, { "exile": ["Hill Giant"], "graveyard_has": ["Hydroblast"] } ] }
  },
  {
    "name": "ruling: another effect can make the devoid card red (Painter's Servant); then it is just red and Hydroblast counters it",
    "players": [
      { "hand": ["Painter's Servant", "Transgress the Mind"], "battlefield": ["Forest", "Forest", "Swamp", "Swamp"] },
      { "hand": ["Hill Giant", "Hydroblast"], "battlefield": ["Island"] }
    ],
    "steps": [
