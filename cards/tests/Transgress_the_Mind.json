      { "resolve": true, "answers": ["R"] },
      { "cast": "Transgress the Mind", "targets": ["p1"] },
      { "pass": true },
      { "player": 1, "cast": "Hydroblast", "targets": [ { "stack": "Transgress the Mind" } ], "answers": [0] },
