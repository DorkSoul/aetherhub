[
  {
    "name": "taps Merrow Wavebreakers and untaps it to gain flying",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          {
            "name": "Merrow Wavebreakers",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Merrow Wavebreakers"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "keywords": {
        "Merrow Wavebreakers": [
          "Flying"
        ]
      },
      "tapped": {
        "Merrow Wavebreakers": false
      }
    }
  },
  {
    "name": "cannot activate while untapped",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          "Merrow Wavebreakers"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Merrow Wavebreakers",
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: a summoning-sick creature cannot use its untap ability",
    "players": [ { "battlefield": ["Island", "Island", { "name": "Merrow Wavebreakers", "tapped": true, "sick": true }] }, {} ],
    "steps": [ { "activate": "Merrow Wavebreakers", "illegal": true } ],
    "expect": { "tapped": { "Merrow Wavebreakers": true }, "players": [ {}, {} ] }
  },
  {
    "name": "ruling: the untap cost is paid immediately, before the ability resolves",
    "players": [ { "battlefield": ["Island", "Island", { "name": "Merrow Wavebreakers", "tapped": true }] }, {} ],
    "steps": [ { "activate": "Merrow Wavebreakers" } ],
    "expect": { "tapped": { "Merrow Wavebreakers": false } }
  }
]
