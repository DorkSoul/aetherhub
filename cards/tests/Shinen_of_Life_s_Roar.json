      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [], "illegal": true },
      { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears", "Shinen of Life's Roar"] },
        { "graveyard_has": ["Savannah Lions"] }
      ]
    }
  },
  {
