      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "hand_count": 2 },
        { "battlefield_has": ["Savannah Lions"], "life": 18 }
      ]
    }
  },
  {
    "name": "MustBlock on the battlefield: the able Savannah Lions must block Shinen, so both die and Bears deals 2",
    "players": [
      { "battlefield": ["Shinen of Life's Roar", "Grizzly Bears"] },
