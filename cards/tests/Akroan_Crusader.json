[
  {
    "name": "a spell that targets it makes a red Soldier with haste",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Akroan Crusader",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Giant Growth",
        "targets": [
          "Akroan Crusader"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Akroan Crusader",
            "Soldier 1-1 Red Haste"
          ]
        },
        {}
      ],
      "keywords": {
        "Soldier 1-1 Red Haste": [
          "Haste"
        ]
      },
      "pt": {
        "Akroan Crusader": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "an opponent's spell that targets it makes no token",
    "players": [
      {
        "battlefield": [
          "Akroan Crusader"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Akroan Crusader"
        ],
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Akroan Crusader"
          ],
          "battlefield_lacks": [
            "Soldier 1-1 Red Haste"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: heroic trigger resolves before Giant Growth, which is still on the stack",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Akroan Crusader", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Giant Growth", "targets": ["Akroan Crusader"] },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ { "battlefield_has": ["Akroan Crusader", "Soldier 1-1 Red Haste"] }, {} ],
      "pt": { "Akroan Crusader": [1, 1] }
    }
  },
  {
    "name": "ruling: a copy of a spell retargeted onto it makes no Soldier token",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Akroan Crusader", "Forest", { "name": "Rimefire Torque", "counters": { "Charge": 3 } }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1", "answers": ["Bear"] },
      { "advance_to": "Main1" },
      { "activate": "Rimefire Torque" },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "resolve": true, "answers": [["Akroan Crusader"]] }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Soldier 1-1 Red Haste"] }, {} ],
      "pt": { "Akroan Crusader": [4, 4], "Grizzly Bears": [5, 5] }
    }
  }
]
