[
  {
    "name": "after gaining 4 life, Serra Angel's generic cost is reduced by 4 this turn (castable for WW)",
    "players": [
      { "hand": ["Sacred Nectar", "Serra Angel"], "battlefield": [{ "name": "Will, Scion of Peace", "sick": false }, "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Sacred Nectar" },
      { "resolve": true },
      { "activate": "Will, Scion of Peace" },
      { "resolve": true },
      { "cast": "Serra Angel" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Will, Scion of Peace", "Plains", "Plains", "Plains", "Plains", "Serra Angel"] },
        {}
      ]
    }
  },
  {
    "name": "gaining no life reduces nothing: Serra Angel cannot be cast with two Plains",
    "players": [
      { "hand": ["Serra Angel"], "battlefield": [{ "name": "Will, Scion of Peace", "sick": false }, "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Will, Scion of Peace" },
      { "resolve": true },
      { "cast": "Serra Angel", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Serra Angel"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Will's reduction only lowers generic mana; with 6 life gained, Serra Angel still needs WW",
    "players": [
      { "hand": ["Revitalize", "Revitalize", "Serra Angel"], "battlefield": [{ "name": "Will, Scion of Peace", "sick": false }, "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Revitalize" },
      { "resolve": true },
      { "cast": "Revitalize" },
      { "resolve": true },
      { "activate": "Will, Scion of Peace" },
      { "resolve": true },
      { "cast": "Serra Angel", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Will, Scion of Peace"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: only life gained counts, so lost life does not reduce the cost",
    "players": [
      { "hand": ["Revitalize", "Lightning Bolt", "Serra Angel"], "battlefield": [{ "name": "Will, Scion of Peace", "sick": false }, "Plains", "Plains", "Plains", "Mountain", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true },
      { "tap_for_mana": "Swamp" },
      { "cast": "Revitalize" },
      { "resolve": true },
      { "activate": "Will, Scion of Peace" },
      { "resolve": true },
      { "cast": "Serra Angel" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield_has": ["Serra Angel", "Will, Scion of Peace"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the amount is determined on resolution, so life gained in response counts",
    "players": [
      { "hand": ["Revitalize", "Serra Angel"], "battlefield": [{ "name": "Will, Scion of Peace", "sick": false }, "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Will, Scion of Peace" },
      { "cast": "Revitalize" },
      { "resolve": true },
      { "cast": "Serra Angel" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Serra Angel", "Will, Scion of Peace"] },
        {}
      ]
    }
  }
