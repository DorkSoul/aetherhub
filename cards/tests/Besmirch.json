[
  { "name": "gain control, untap and haste until end of turn",
    "players": [ { "hand": ["Besmirch"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Besmirch", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] } ],
                "tapped": { "Grizzly Bears": false },
                "keywords": { "Grizzly Bears": ["Haste"] } } },
  { "name": "control returns to the owner at end of turn",
    "players": [ { "hand": ["Besmirch"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Besmirch", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "advance_to": "End" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: gaining control of a creature does not take the Equipment attached to it",
    "players": [ { "hand": ["Besmirch"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                 { "hand": ["Sage's Nouliths"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Main1" }, { "cast": "Sage's Nouliths", "player": 1 }, { "resolve": true }, { "resolve": true },
               { "advance_to": "End" }, { "advance_to": "Main1" }, { "cast": "Besmirch", "targets": ["Hero"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hero"], "battlefield_lacks": ["Sage's Nouliths"] }, { "battlefield_has": ["Sage's Nouliths"] } ],
                "attached": { "Sage's Nouliths": "Hero" } } },
  { "name": "ruling: Besmirch can target a creature you already control",
    "players": [ { "hand": ["Besmirch"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [ { "cast": "Besmirch", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Besmirch"] }, {} ],
                "keywords": { "Grizzly Bears": ["Haste"] } } }
]
