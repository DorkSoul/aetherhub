[
 { "name": "destroys target enchantment and draws a card",
   "players": [ { "hand": ["Aura Blast"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Blight Mound"] } ],
   "steps": [ { "cast": "Aura Blast", "targets": ["Blight Mound"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard": ["Aura Blast"] }, { "graveyard": ["Blight Mound"] } ] } },
 { "name": "no enchantment on the battlefield: cannot be cast",
   "players": [ { "hand": ["Aura Blast"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Aura Blast", "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Aura Blast"] }, { "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "ruling: a countered Aura Blast does not draw a card",
   "players": [ { "hand": ["Aura Blast"], "battlefield": ["Plains", "Plains"] }, { "hand": ["Cancel"], "battlefield": ["Blight Mound", "Island", "Island", "Island"] } ],
   "steps": [ { "cast": "Aura Blast", "targets": ["Blight Mound"] }, { "pass": true }, { "player": 1, "cast": "Cancel", "targets": [{ "stack": "Aura Blast" }] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": [], "graveyard": ["Aura Blast"] }, { "graveyard": ["Cancel"], "battlefield_has": ["Blight Mound"] } ] } }
