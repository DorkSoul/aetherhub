      {}
    ],
    "steps": [
      { "cast": "Slickshot Lockpicker" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "cast": "Divination", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Divination"] },
