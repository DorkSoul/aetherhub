  {
    "name": "plot pays {2}{U} and exiles the card from hand",
    "players": [ { "hand": ["Slickshot Lockpicker"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Slickshot Lockpicker", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Slickshot Lockpicker"], "hand_count": 0 }, {} ] }
  },
  {
    "name": "plotted card is cast for no mana on a later turn",
    "players": [ { "hand": ["Slickshot Lockpicker"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Slickshot Lockpicker", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" }, { "cast": "Slickshot Lockpicker", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Slickshot Lockpicker"] }, {} ] }
  },
  {
    "name": "plot needs {2}{U}: with only two Islands the card stays in hand",
    "players": [ { "hand": ["Slickshot Lockpicker"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Slickshot Lockpicker", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Slickshot Lockpicker"] }, {} ] }
  },
  {
    "name": "ruling: a card plotted this turn cannot be cast for free until a later turn",
    "players": [ { "hand": ["Slickshot Lockpicker"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Slickshot Lockpicker", "ability": 0 },
      { "resolve": true },
      { "cast": "Slickshot Lockpicker", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "exile": ["Slickshot Lockpicker"], "battlefield_lacks": ["Slickshot Lockpicker"] }, {} ] }
  },
  {
    "name": "ruling: flashback X spell lets you choose X when casting it (Fireball X=2 deals 2)",
    "players": [
      {
        "hand": ["Slickshot Lockpicker"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island"],
        "graveyard": ["Fireball"]
      },
      {}
    ],
    "steps": [
      { "cast": "Slickshot Lockpicker" },
      { "resolve": true },
      { "cast": "Fireball", "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Fireball"], "graveyard": [] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: a sorcery cast with flashback still needs sorcery timing (illegal in combat)",
    "players": [
      {
        "hand": ["Slickshot Lockpicker"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Mountain"],
