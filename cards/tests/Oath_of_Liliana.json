[
  {
    "name": "ETB: opponent sacrifices their only creature",
    "players": [
      { "hand": ["Oath of Liliana"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Oath of Liliana" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Oath of Liliana"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "end step: token when a planeswalker entered under your control this turn",
    "players": [
      { "hand": ["Jace, the Mind Sculptor"], "battlefield": ["Oath of Liliana", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Jace, the Mind Sculptor" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Oath of Liliana", "Jace, the Mind Sculptor", "Zombie"] }, {} ]
    }
  },
  {
    "name": "end step: no token when no planeswalker entered this turn",
    "players": [
      { "battlefield": ["Oath of Liliana"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Oath of Liliana"], "battlefield_lacks": ["Zombie"] }, {} ]
    }
  },
  {
    "name": "ruling: two planeswalkers entering this turn still make only one Zombie",
    "players": [
      { "hand": ["Jace, the Mind Sculptor", "Jace, the Mind Sculptor"], "battlefield": ["Oath of Liliana", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Jace, the Mind Sculptor" },
      { "resolve": true },
      { "cast": "Jace, the Mind Sculptor" },
      { "resolve": true, "auto": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield": ["Oath of Liliana", "Jace, the Mind Sculptor", "Zombie", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Jace, the Mind Sculptor"] }, {} ]
    }
  },
  {
    "name": "ruling: Oath entering after the planeswalker still makes a Zombie at end step",
    "players": [
      { "hand": ["Jace, the Mind Sculptor", "Oath of Liliana"], "battlefield": ["Island", "Island", "Island", "Island", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Jace, the Mind Sculptor" },
      { "resolve": true },
      { "cast": "Oath of Liliana" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Oath of Liliana", "Jace, the Mind Sculptor", "Zombie"] }, {} ]
    }
  },
  {
    "name": "ruling: a second Oath still triggers its enters ability (legend rule then removes one)",
    "players": [
      { "hand": ["Oath of Liliana"], "battlefield": ["Oath of Liliana", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Oath of Liliana" },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Oath of Liliana"], "graveyard_has": ["Oath of Liliana"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
