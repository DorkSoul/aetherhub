[
 {
  "name": "ETB manifest dread twice, then a draw for each face-down creature that entered",
  "players": [
   { "hand": [ "They Came from the Pipes" ], "battlefield": [ "Island", "Island", "Island", "Island", "Island" ], "library": [ "Grizzly Bears", "Llanowar Elves", "Giant Spider", "Hill Giant", "Plains", "Island" ] },
   {}
  ],
  "steps": [
   { "cast": "They Came from the Pipes" },
   { "resolve": true, "answers": [ "Grizzly Bears", "Giant Spider" ] }
  ],
  "expect": {
   "players": [ { "hand_count": 2, "graveyard_has": [ "Llanowar Elves", "Hill Giant" ], "battlefield_has": [ "They Came from the Pipes" ] }, {} ]
  }
 },
 {
  "name": "a face-up creature entering does not draw (negative)",
  "players": [
   { "hand": [ "Grizzly Bears" ], "battlefield": [ "They Came from the Pipes", "Forest", "Forest" ] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 0, "battlefield_has": [ "Grizzly Bears", "They Came from the Pipes" ] }, {} ]
  }
 },
 { "name": "ruling: turning a face-down creature face up is a special action (no stack) and does not change whether it is tapped",
   "players": [ { "battlefield": [ { "name": "Hill Giant", "face_down": true, "tapped": true }, "Mountain", "Forest", "Forest", "Forest" ] }, {} ],
   "steps": [ { "activate": "Hill Giant" } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, {} ], "pt": { "Hill Giant": [3, 3] }, "tapped": { "Hill Giant": true }, "stack_empty": true } },
 { "name": "ruling: turning a face-down creature face up is not an enters-the-battlefield event: They Came from the Pipes does not draw",
   "players": [ { "battlefield": [ "They Came from the Pipes", { "name": "Hill Giant", "face_down": true }, "Mountain", "Forest", "Forest", "Forest" ] }, {} ],
   "steps": [ { "activate": "Hill Giant" } ],
   "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Hill Giant", "They Came from the Pipes"] }, {} ], "pt": { "Hill Giant": [3, 3] } } },
 { "name": "ruling: a face-down instant cannot be turned face up (it is not a creature card)",
   "players": [ { "battlefield": [ { "name": "Lightning Bolt", "face_down": true }, "Mountain", "Mountain" ] }, {} ],
   "steps": [ { "activate": "Lightning Bolt", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Lightning Bolt"] }, {} ] } }
]
