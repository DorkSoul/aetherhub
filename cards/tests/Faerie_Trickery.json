[
  {
    "name": "counters a non-Faerie spell and exiles it",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Faerie Trickery"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "player": 1, "cast": "Faerie Trickery", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "exile": ["Lightning Bolt"], "graveyard": [] },
        { "life": 20, "graveyard": ["Faerie Trickery"] }
      ]
    }
  },
  {
    "name": "cannot counter a Faerie spell",
    "players": [
      { "hand": ["Faerie Noble"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "hand": ["Faerie Trickery"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Faerie Noble" },
      { "pass": true },
      { "player": 1, "cast": "Faerie Trickery", "targets": [{ "stack": "Faerie Noble" }], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Faerie Noble"] },
        { "hand": ["Faerie Trickery"] }
      ]
    }
  },
  {
    "name": "ruling: kindred is a card type counted in graveyards (Tarmogoyf: Kindred + Instant = 2/3)",
    "players": [
      { "battlefield": ["Tarmogoyf"], "graveyard": ["Faerie Trickery", "Lightning Bolt"] },
      {}
    ],
    "steps": [],
    "expect": { "pt": { "Tarmogoyf": [2, 3] } }
  }
]
