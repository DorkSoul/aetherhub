[
  { "name": "{2}{B}, {T}: exiles up to three target cards from one graveyard",
    "players": [ { "battlefield": ["Carrion Beetles", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ],
    "steps": [
      { "activate": "Carrion Beetles", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Carrion Beetles"] }, { "graveyard": [], "exile": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ] }
  },
  { "name": "a set spanning two graveyards keeps only the first owner's cards",
    "players": [ { "battlefield": ["Carrion Beetles", "Swamp", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Carrion Beetles", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "exile": [] } ] }
  },
  { "name": "needs {T}: a second activation in the same turn is illegal",
    "players": [ { "battlefield": ["Carrion Beetles", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [
      { "activate": "Carrion Beetles", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Carrion Beetles", "ability": 0, "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Carrion Beetles"] }, { "graveyard": ["Hill Giant"], "exile": ["Grizzly Bears"] } ] }
  },
  { "name": "ruling: announcing a single target exiles just that card",
    "players": [ { "battlefield": ["Carrion Beetles", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ],
    "steps": [ { "activate": "Carrion Beetles", "ability": 0, "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Carrion Beetles"] }, { "graveyard": ["Grizzly Bears", "Lightning Bolt"], "exile": ["Hill Giant"] } ] } },
  { "name": "ruling: choosing zero targets still activates the ability but exiles nothing",
    "players": [ { "battlefield": ["Carrion Beetles", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "activate": "Carrion Beetles", "ability": 0, "targets": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Carrion Beetles"] }, { "graveyard": ["Grizzly Bears", "Hill Giant"], "exile": [] } ] } }
]
