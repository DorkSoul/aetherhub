[
  {
    "name": "is exiled when another creature enters",
    "players": [{ "hand": ["Grizzly Bears"], "battlefield": ["Saltskitter", "Forest", "Forest"] }, {}],
    "steps": [{ "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true }],
    "expect": { "players": [{ "exile": ["Saltskitter"], "battlefield_has": ["Grizzly Bears"] }, {}] }
  },
  {
    "name": "returns to the battlefield at the beginning of the next end step",
    "players": [{ "hand": ["Grizzly Bears"], "battlefield": ["Saltskitter", "Forest", "Forest"] }, {}],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Saltskitter"], "exile": [] }, {}] }
  },
  {
    "name": "a land entering does not trigger it",
    "players": [{ "hand": ["Forest"], "battlefield": ["Saltskitter"] }, {}],
    "steps": [{ "play_land": "Forest" }],
    "expect": { "players": [{ "battlefield_has": ["Saltskitter"] }, {}] }
  },
  {
    "name": "ruling: a creature entering in the end step keeps Saltskitter exiled through the opponent's turn",
    "players": [{ "hand": ["Spectral Sailor"], "battlefield": ["Saltskitter", "Island"] }, {}],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Spectral Sailor" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": { "players": [{ "exile": ["Saltskitter"] }, {}] }
  },
  {
    "name": "ruling: Saltskitter returns only at the beginning of the following turn's end step",
    "players": [{ "hand": ["Spectral Sailor"], "battlefield": ["Saltskitter", "Island"] }, {}],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Spectral Sailor" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Saltskitter"], "exile": [] }, {}] }
  }
]
