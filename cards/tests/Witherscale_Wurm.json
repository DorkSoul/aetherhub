[
  {
    "name": "blocker gains wither: its damage puts -1/-1 counters on the Wurm",
    "players": [
      { "battlefield": [{ "name": "Witherscale Wurm", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Witherscale Wurm", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Witherscale Wurm" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Witherscale Wurm": [7, 7] },
      "players": [{}, { "graveyard": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "damage to the opponent removes all -1/-1 counters",
    "players": [
      { "battlefield": [{ "name": "Witherscale Wurm", "sick": false, "counters": { "m1m1": 2 } }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Witherscale Wurm", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Witherscale Wurm": [9, 9] },
      "counters": { "Witherscale Wurm": { "m1m1": 0 } },
      "players": [{}, { "life": 13 }]
    }
  },
  {
    "name": "blocking a creature gives it wither: its damage puts -1/-1 counters on the Wurm",
    "players": [
      { "battlefield": [{ "name": "Witherscale Wurm", "sick": false }] },
      { "battlefield": [{ "name": "Grizzly Bears", "sick": false }] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p0" }], "player": 1 },
      { "block": [{ "blocker": "Witherscale Wurm", "attacker": "Grizzly Bears" }], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Witherscale Wurm": [7, 7] },
      "counters": { "Witherscale Wurm": { "m1m1": 2 } },
      "players": [{ "battlefield_has": ["Witherscale Wurm"] }, { "graveyard": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "an attacker the Wurm does not block gets no wither",
    "players": [
      { "battlefield": [{ "name": "Witherscale Wurm", "sick": false }] },
      { "battlefield": [{ "name": "Grizzly Bears", "sick": false }] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p0" }], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Witherscale Wurm": [9, 9] },
      "players": [{ "life": 18 }, { "battlefield_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: noncombat damage from the Wurm (Origin of Thor chapter III) also removes its -1/-1 counters",
    "players": [
      {
        "hand": ["Origin of Thor"],
        "battlefield": [{ "name": "Witherscale Wurm", "sick": false, "counters": { "m1m1": 2 } }, "Mountain", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Origin of Thor" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "targets": ["Witherscale Wurm"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Witherscale Wurm": [9, 9] },
      "counters": { "Witherscale Wurm": { "m1m1": 0 } },
      "players": [{}, { "life": 13 }]
    }
  },
  {
    "name": "ruling: the Wurm's first ability gives wither to the blocker, not to the Wurm: Wall of Stone takes no -1/-1 counters",
    "players": [
      { "battlefield": [{ "name": "Witherscale Wurm", "sick": false, "counters": { "m1m1": 3 } }] },
      { "battlefield": ["Wall of Stone"] }
    ],
    "steps": [
      { "attack": [{ "card": "Witherscale Wurm", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Stone", "attacker": "Witherscale Wurm" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Witherscale Wurm": [6, 6], "Wall of Stone": [0, 8] },
      "counters": { "Wall of Stone": { "m1m1": 0 } },
      "players": [{}, { "battlefield_has": ["Wall of Stone"] }]
    }
  }
]
