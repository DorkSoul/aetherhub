  ],
  "steps": [
    {"activate": "Millstone", "targets": ["p1"]},
    {"resolve": true},
    {"activate": "The Master, Transcendent", "targets": ["Grizzly Bears"]},
    {"resolve": true},
    {"cast": "Giant Growth", "targets": ["Grizzly Bears"]},
    {"resolve": true}
  ],
  "expect": {"players": [{"battlefield_has": ["Grizzly Bears"]}, {}], "pt": {"Grizzly Bears": [6, 6]}}},
 {"name": "ruling: rad counters stay on the player through the end step (they leave only when an effect removes them)",
  "players": [{"battlefield": ["The Master, Transcendent"]}, {"rad": 2}],
  "steps": [{"advance_to": "End"}],
  "expect": {"players": [{}, {"rad": 2}]}},
 {"name": "ruling: the rad mill belongs to the active player: at your precombat main you mill your own rad count",
