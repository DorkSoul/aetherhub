 {"name": "ruling: effects that change power/toughness still apply to the reanimated creature (Giant Growth makes the 3/3 Mutant a 6/6)",
  "players": [
    {"hand": ["Giant Growth"], "battlefield": ["The Master, Transcendent", "Millstone", "Island", "Island", "Forest"]},
