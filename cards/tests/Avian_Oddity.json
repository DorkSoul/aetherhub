    "steps": [ { "activate": "Avian Oddity" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Avian Oddity"] }, {} ], "keywords": { "Grizzly Bears": [] } }
