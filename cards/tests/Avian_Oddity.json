[
  {
    "name": "cycling draws a card and puts a flying counter on a creature you control",
    "players": [ { "hand": ["Avian Oddity"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Avian Oddity" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": ["Avian Oddity"] }, {} ],
      "keywords": { "Grizzly Bears": ["Flying"] }
    }
  },
  {
    "name": "cycling with no creature to target still draws",
    "players": [ { "hand": ["Avian Oddity"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Avian Oddity" }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": ["Avian Oddity"] }, {} ]
    }
  },
  {
    "name": "cannot be cycled with only two lands",
    "players": [ { "hand": ["Avian Oddity"], "battlefield": ["Island", "Island"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Avian Oddity", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Avian Oddity"] }, {} ] }
