[
  { "name": "a player attacking with three creatures makes you draw a card",
    "players": [ { "battlefield": ["Aurelia, the Law Above", "Grizzly Bears", "Hill Giant"], "library": ["Plains"] }, {} ],
    "steps": [ { "attack": [{ "card": "Aurelia, the Law Above", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Plains"], "life": 20 }, { "life": 11 } ] } },
  { "name": "two attackers do not trigger the draw",
    "players": [ { "battlefield": ["Aurelia, the Law Above", "Grizzly Bears"], "library": ["Plains"] }, {} ],
    "steps": [ { "attack": [{ "card": "Aurelia, the Law Above", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand_count": 0, "life": 20 }, { "life": 14 } ] } },
  { "name": "five attackers: 3 damage to each opponent and you gain 3 life",
    "players": [ { "battlefield": ["Aurelia, the Law Above", "Grizzly Bears", "Hill Giant", "Savannah Lions", "Llanowar Elves"], "library": ["Plains"] }, {} ],
    "steps": [ { "attack": [{ "card": "Aurelia, the Law Above", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 23 }, { "life": 5 } ] } },
  { "name": "ruling: attacker removed in response to the 3-attacker trigger: the draw still happens",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Aurelia, the Law Above", "Grizzly Bears", "Hill Giant"], "library": ["Plains"] }, {} ],
    "steps": [ { "attack": [{ "card": "Aurelia, the Law Above", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Plains"], "life": 20 }, { "life": 13 } ] } },
  { "name": "ruling: attacker removed in response to the 5-attacker trigger: damage and life gain still happen",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Aurelia, the Law Above", "Grizzly Bears", "Hill Giant", "Savannah Lions", "Llanowar Elves"], "library": ["Plains"] }, {} ],
    "steps": [ { "attack": [{ "card": "Aurelia, the Law Above", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" }] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Plains"], "life": 23 }, { "life": 7 } ] } }
]
