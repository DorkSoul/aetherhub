[
  { "name": "enters: target creature an opponent controls gets -1/-1 until end of turn",
    "players": [ { "hand": ["Tooth Collector"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Tooth Collector" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tooth Collector"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [1, 1] } } },
  { "name": "delirium (four card types in graveyard): at each opponent's upkeep, -1/-1 to a creature that opponent controls",
    "players": [ { "battlefield": ["Tooth Collector"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Divination", "Abzan Banner"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [1, 1] } } },
  { "name": "no delirium (three card types): the upkeep trigger does not happen",
    "players": [ { "battlefield": ["Tooth Collector"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Divination"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: many cards of only three types (creature, instant, sorcery) do not enable delirium",
    "players": [ { "battlefield": ["Tooth Collector"], "graveyard": ["Grizzly Bears", "Ghitu Amplifier", "Lightning Bolt", "Divination", "Igneous Inspiration"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: a basic land counts as a fourth card type (land) and enables delirium",
    "players": [ { "battlefield": ["Tooth Collector"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Divination", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [1, 1] } } }
]
