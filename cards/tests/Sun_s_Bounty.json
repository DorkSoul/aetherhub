[
  {
    "name": "gain 4 life",
    "players": [
      { "hand": ["Sun's Bounty"], "battlefield": ["Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Sun's Bounty" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 24, "graveyard": ["Sun's Bounty"] }, {} ] }
  },
  {
    "name": "recover: paying {1}{W} returns Sun's Bounty to hand when your creature dies",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Plains", "Plains", "Grizzly Bears"],
        "graveyard": ["Sun's Bounty"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ { "hand": ["Sun's Bounty"], "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }, {} ] }
  },
  {
    "name": "recover: declining exiles Sun's Bounty",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Plains", "Plains", "Grizzly Bears"],
        "graveyard": ["Sun's Bounty"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ { "hand_count": 0, "exile": ["Sun's Bounty"] }, {} ] }
  },
  {
    "name": "opponent's creature dying does not trigger recover",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"],
        "graveyard": ["Sun's Bounty"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Sun's Bounty", "Lightning Bolt"] }, {} ] }
  }
]
