[
  {
    "name": "championing a Faerie exiles it and taps all lands of the targeted player",
    "players": [
      { "hand": ["Mistbind Clique"], "battlefield": ["Island", "Island", "Island", "Island", "Marsh Flitter"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Mistbind Clique" },
      { "resolve": true, "answers": [true, 1] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mistbind Clique"], "battlefield_lacks": ["Marsh Flitter"], "exile": ["Marsh Flitter"] },
        { "battlefield_has": ["Forest"] }
      ],
      "tapped": { "Forest": true }
    }
  },
  {
    "name": "declining to champion sacrifices Mistbind Clique and leaves the Faerie",
    "players": [
      { "hand": ["Mistbind Clique"], "battlefield": ["Island", "Island", "Island", "Island", "Marsh Flitter"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Mistbind Clique" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Marsh Flitter"], "battlefield_lacks": ["Mistbind Clique"], "graveyard_has": ["Mistbind Clique"] },
        {}
      ]
    }
  },
  {
    "name": "no other Faerie to exile means Mistbind Clique is sacrificed",
    "players": [
      { "hand": ["Mistbind Clique"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Mistbind Clique" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Mistbind Clique"], "graveyard_has": ["Mistbind Clique"] },
        {}
      ]
    }
  },
  {
    "name": "removing Mistbind Clique returns the championed Faerie",
    "players": [
      { "hand": ["Mistbind Clique", "Doom Blade"], "battlefield": ["Island", "Island", "Island", "Island", "Swamp", "Swamp", "Marsh Flitter"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Mistbind Clique" },
      { "resolve": true, "answers": [true, 1] },
      { "cast": "Doom Blade", "targets": ["Mistbind Clique"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Marsh Flitter"], "graveyard_has": ["Mistbind Clique"] },
        {}
      ]
    }
  }
]
