[
  {
    "name": "exiling a creature card puts a +1/+1 counter on a creature you control",
    "players": [
      { "battlefield": ["Agatha's Soul Cauldron", "Grizzly Bears"] },
      { "graveyard": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Agatha's Soul Cauldron", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 } }, "pt": { "Grizzly Bears": [3, 3] }, "players": [ {}, { "graveyard": [], "exile": ["Hill Giant"] } ] }
  },
  {
    "name": "exiling a noncreature card gives no counter",
    "players": [
      { "battlefield": ["Agatha's Soul Cauldron", "Grizzly Bears"] },
      { "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Agatha's Soul Cauldron", "targets": ["Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ {}, { "exile": ["Lightning Bolt"] } ] }
  },
  {
    "name": "a creature with a +1/+1 counter has the activated abilities of exiled creature cards",
    "players": [
      { "battlefield": ["Agatha's Soul Cauldron", "Grizzly Bears"] },
      { "graveyard": ["Prodigal Sorcerer"] }
    ],
    "steps": [
      { "activate": "Agatha's Soul Cauldron", "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true }, "players": [ {}, { "life": 19 } ] }
  },
  {
    "name": "mana of any color pays for creature abilities",
    "players": [
      { "battlefield": ["Agatha's Soul Cauldron", "Shivan Dragon", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Shivan Dragon" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Shivan Dragon": [6, 5] } }
  },
  {
    "name": "ruling: a granted ability is treated as printed on the creature that has the counter",
    "players": [
      { "battlefield": ["Agatha's Soul Cauldron", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "graveyard": ["Argothian Sprite"] }
    ],
    "steps": [
      { "activate": "Agatha's Soul Cauldron", "targets": ["Argothian Sprite"] },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 3 } }, "pt": { "Grizzly Bears": [5, 5] } }
  }
]
