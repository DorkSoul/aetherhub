[
  { "name": "two Spirit spells cast: two ki counters, so at the end step it may flip into Azamuki",
    "players": [ { "battlefield": ["Cunning Bandit // Azamuki, Treachery Incarnate", "Island", "Swamp", "Island", "Swamp"], "hand": ["Dimir Infiltrator", "Skulking Ghost"] }, {} ],
    "steps": [ { "cast": "Dimir Infiltrator" }, { "resolve": true, "answers": [true] }, { "cast": "Skulking Ghost" }, { "resolve": true, "answers": [true] }, { "advance_to": "End", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Azamuki, Treachery Incarnate", "Dimir Infiltrator", "Skulking Ghost"] }, {} ], "pt": { "Azamuki, Treachery Incarnate": [5, 2] } } },
  { "name": "a non-Spirit, non-Arcane spell adds no ki counter: one Spirit spell is not enough to flip",
    "players": [ { "battlefield": ["Cunning Bandit // Azamuki, Treachery Incarnate", "Island", "Swamp", "Mountain"], "hand": ["Dimir Infiltrator", "Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Dimir Infiltrator" }, { "resolve": true, "answers": [true] }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Cunning Bandit // Azamuki, Treachery Incarnate"], "graveyard_has": ["Lightning Bolt"] }, { "life": 17 } ] } },
  { "name": "no ki counters at the end step: no flip",
    "players": [ { "battlefield": ["Cunning Bandit // Azamuki, Treachery Incarnate"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Cunning Bandit // Azamuki, Treachery Incarnate"] }, {} ] } },
  { "name": "Azamuki removes a ki counter: gain control of target creature until end of turn",
    "players": [ { "battlefield": [ { "name": "Azamuki, Treachery Incarnate", "counters": { "Ki": 1 }, "sick": false } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Azamuki, Treachery Incarnate", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Azamuki, Treachery Incarnate", "Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "no ki counter to remove: Azamuki cannot take control of a creature",
    "players": [ { "battlefield": ["Azamuki, Treachery Incarnate"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Azamuki, Treachery Incarnate", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
