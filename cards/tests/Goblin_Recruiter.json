[
  {
    "name": "finds two goblins, puts them on top in the chosen order (drawn next turn)",
    "players": [
      { "hand": ["Goblin Recruiter"], "battlefield": ["Mountain", "Mountain"], "library": ["Island", "Goblin Arsonist", "Island", "Goblin Artillery", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Goblin Recruiter" },
      { "resolve": true, "answers": [["Goblin Arsonist", "Goblin Artillery"], ["Goblin Artillery", "Goblin Arsonist"]] },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Goblin Recruiter"], "hand": ["Goblin Artillery"] },
        {}
      ]
    }
  },
  {
    "name": "chooses no goblins: none is moved to the top",
    "players": [
      { "hand": ["Goblin Recruiter"], "battlefield": ["Mountain", "Mountain"], "library": ["Island", "Goblin Arsonist"] },
      {}
    ],
    "steps": [
      { "cast": "Goblin Recruiter" },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Goblin Recruiter"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "no goblin in library: the trigger does nothing",
    "players": [
      { "hand": ["Goblin Recruiter"], "battlefield": ["Mountain", "Mountain"], "library": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Goblin Recruiter" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Goblin Recruiter"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: a kindred Goblin (Tarfire, not a creature) can be found and put on top",
    "players": [
      { "hand": ["Goblin Recruiter"], "battlefield": ["Mountain", "Mountain"], "library": ["Island", "Tarfire", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Goblin Recruiter" },
      { "resolve": true, "answers": [["Tarfire"]] },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Goblin Recruiter"], "hand": ["Tarfire"] },
        {}
      ]
    }
  }
]
