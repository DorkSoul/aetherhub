[
 {
  "name": "at your upkeep Halfdane's base power and toughness become those of the target creature",
  "players": [
   { "battlefield": ["Halfdane", "Craw Wurm"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" }
  ],
  "expect": { "pt": { "Halfdane": [6, 4] } }
 },
 {
  "name": "the change lasts through the opponent's turn",
  "players": [
   { "battlefield": ["Halfdane", "Craw Wurm"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" }
  ],
  "expect": { "pt": { "Halfdane": [6, 4] } }
 },
 {
  "name": "with no other creature Halfdane stays 3/3",
  "players": [
   { "battlefield": ["Halfdane"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" }
  ],
  "expect": { "pt": { "Halfdane": [3, 3] } }
 },
 {
  "name": "with no legal target at the next upkeep the old effect lingers through that upkeep",
  "players": [
   { "battlefield": ["Halfdane", "Craw Wurm"] },
   { "hand": ["Swords to Plowshares"], "battlefield": ["Plains"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "player": 1, "cast": "Swords to Plowshares", "targets": ["Craw Wurm"] },
   { "resolve": true },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "pt": { "Halfdane": [6, 4] } }
 },
 {
  "name": "and the effect ends at the end of that upkeep",
  "players": [
   { "battlefield": ["Halfdane", "Craw Wurm"] },
   { "hand": ["Swords to Plowshares"], "battlefield": ["Plains"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "player": 1, "cast": "Swords to Plowshares", "targets": ["Craw Wurm"] },
   { "resolve": true },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" }
  ],
  "expect": { "pt": { "Halfdane": [3, 3] } }
 },
 {
  "name": "ruling: trigger that fizzles in response to removal of its target leaves the old effect through that upkeep",
  "players": [
   { "hand": ["Swords to Plowshares"], "battlefield": ["Halfdane", "Craw Wurm", "Plains"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "advance_to": "Upkeep", "hold": true },
   { "cast": "Swords to Plowshares", "targets": ["Craw Wurm"] },
   { "pass": true },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": { "pt": { "Halfdane": [6, 4] } }
 }
]
