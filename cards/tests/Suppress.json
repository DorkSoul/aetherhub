[
  { "name": "opponent's hand returns at the end step of their next turn",
    "players": [ { "hand": ["Suppress"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Suppress", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard": ["Suppress"] }, { "hand_count": 3, "exile": [] } ] } },
  { "name": "not returned at the end of the casting turn",
    "players": [ { "hand": ["Suppress"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Suppress", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard": ["Suppress"] }, { "hand_count": 0, "exile": ["Grizzly Bears", "Hill Giant"] } ] } },
  { "name": "targeting yourself returns the cards at the end step of your NEXT turn",
    "players": [ { "hand": ["Suppress", "Grizzly Bears", "Hill Giant"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { } ],
    "steps": [ { "cast": "Suppress", "targets": ["p0"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand_count": 0, "exile": ["Grizzly Bears", "Hill Giant"] }, {} ] } },
  { "name": "targeting yourself: back after your next turn's end step",
    "players": [ { "hand": ["Suppress", "Grizzly Bears", "Hill Giant"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { } ],
    "steps": [ { "cast": "Suppress", "targets": ["p0"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand_count": 3, "exile": [] }, {} ] } }
]
