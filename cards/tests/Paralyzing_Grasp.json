[
  {
    "name": "enchanted creature stays tapped through its controller's untap step",
    "players": [
      { "hand": ["Paralyzing Grasp"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Paralyzing Grasp", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "attached": { "Paralyzing Grasp": "Grizzly Bears" },
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "an unenchanted tapped creature untaps in its controller's untap step",
    "players": [
      { "battlefield": ["Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "needs a creature to enchant",
    "players": [
      { "hand": ["Paralyzing Grasp"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Paralyzing Grasp", "illegal": true }
    ]
  },
  {
    "name": "ruling: may enchant an untapped creature; it has no effect until the creature becomes tapped",
    "players": [
      { "hand": ["Paralyzing Grasp"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Paralyzing Grasp", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "attached": { "Paralyzing Grasp": "Grizzly Bears" },
      "tapped": { "Grizzly Bears": false }
    }
  }
]
