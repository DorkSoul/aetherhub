[
  {
    "name": "gets -1/-1 for each basic land type among lands I control",
    "players": [
      { "hand": ["Exotic Curse"], "battlefield": ["Plains", "Island", "Swamp"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [ { "cast": "Exotic Curse", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": {
      "pt": { "Serra Angel": [1, 1] }
    }
  },
  {
    "name": "lands of one basic type give -1/-1 no matter how many lands there are",
    "players": [
      { "hand": ["Exotic Curse"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [ { "cast": "Exotic Curse", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": {
      "pt": { "Serra Angel": [3, 3] }
    }
  },
  {
    "name": "ruling: nonbasic land types such as Desert do not count toward domain",
    "players": [
      { "hand": ["Exotic Curse"], "battlefield": ["Swamp", "Desert", "Desert"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [ { "cast": "Exotic Curse", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": {
      "pt": { "Serra Angel": [3, 3] }
    }
  }
]
