    "steps": [ { "activate": "Teferi's Honor Guard", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Teferi's Honor Guard"] }, {} ] }
  },
  {
    "name": "phased out creature phases in at its controller's next untap step",
    "players": [ { "battlefield": ["Teferi's Honor Guard", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Teferi's Honor Guard", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
