[
  {
    "name": "UU: it phases out",
    "players": [ { "battlefield": ["Teferi's Honor Guard", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Teferi's Honor Guard", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Teferi's Honor Guard"] }, {} ] }
  },
  {
    "name": "needs both blue mana: one Island is not enough",
