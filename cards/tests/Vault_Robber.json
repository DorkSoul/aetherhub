[
  {
    "name": "exiles a creature card from your graveyard to create a Treasure",
    "players": [{ "battlefield": ["Vault Robber", "Mountain", "Swamp"], "graveyard": ["Grizzly Bears"] }, {}],
    "steps": [{ "activate": "Vault Robber", "ability": 0 }, { "resolve": true }],
    "expect": {
      "players": [
        { "battlefield_has": ["Vault Robber", "Treasure"], "exile": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "cannot activate without a creature card in your graveyard",
    "players": [{ "battlefield": ["Vault Robber", "Mountain", "Swamp"], "graveyard": ["Lightning Bolt"] }, {}],
    "steps": [{ "activate": "Vault Robber", "ability": 0, "illegal": true }],
    "expect": { "players": [{ "battlefield_lacks": ["Treasure"] }, {}] }
  },
  {
    "name": "ruling: the creature card is exiled as a cost on activation, before the ability resolves",
    "players": [{ "battlefield": ["Vault Robber", "Mountain", "Swamp"], "graveyard": ["Grizzly Bears"] }, {}],
    "steps": [{ "activate": "Vault Robber", "ability": 0 }],
    "expect": {
      "stack_empty": false,
      "players": [
        { "battlefield_lacks": ["Treasure"], "graveyard": [], "exile": ["Grizzly Bears"] },
        {}
      ]
    }
  }
]
