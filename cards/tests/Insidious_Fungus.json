[
  {
    "name": "sacrifice for {2}: destroy target artifact",
    "players": [
      { "battlefield": ["Insidious Fungus", "Forest", "Plains"] },
      { "battlefield": ["Mind Stone"] }
    ],
    "steps": [
      { "activate": "Insidious Fungus", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Insidious Fungus"], "battlefield_lacks": ["Insidious Fungus"] },
        { "graveyard": ["Mind Stone"] }
      ]
    }
  },
  {
    "name": "destroy artifact mode needs an artifact to target",
    "players": [
      { "battlefield": ["Insidious Fungus", "Forest", "Plains"] },
      { "battlefield": ["Burgeoning"] }
    ],
    "steps": [
      { "activate": "Insidious Fungus", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Insidious Fungus"] },
        { "battlefield_has": ["Burgeoning"] }
      ]
    }
  },
  {
    "name": "sacrifice for {2}: destroy target enchantment",
    "players": [
      { "battlefield": ["Insidious Fungus", "Forest", "Plains"] },
      { "battlefield": ["Burgeoning"] }
    ],
    "steps": [
      { "activate": "Insidious Fungus", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Insidious Fungus"] },
        { "graveyard": ["Burgeoning"] }
      ]
    }
  },
  {
    "name": "draw mode: draw a card then put a land from hand onto the battlefield",
    "players": [
      { "hand": ["Plains"], "library": ["Forest"], "battlefield": ["Insidious Fungus", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Insidious Fungus", "ability": 2 },
      { "resolve": true, "answers": ["Plains"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Insidious Fungus"], "battlefield_has": ["Plains"], "hand": ["Forest"] },
        {}
      ]
    }
  },
  {
    "name": "draw mode: putting a land onto the battlefield is optional",
    "players": [
      { "hand": ["Plains"], "library": ["Forest"], "battlefield": ["Insidious Fungus", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Insidious Fungus", "ability": 2 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Insidious Fungus"], "hand": ["Plains", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the land put onto the battlefield does not use the land drop (a land was already played)",
    "players": [
      { "hand": ["Mountain", "Forest"], "battlefield": ["Insidious Fungus", "Island", "Island"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "play_land": "Mountain" },
      { "activate": "Insidious Fungus", "ability": 2 },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mountain", "Forest"], "graveyard": ["Insidious Fungus"], "hand": ["Grizzly Bears"] },
        {}
      ],
      "tapped": { "Forest": true }
    }
  }
]
