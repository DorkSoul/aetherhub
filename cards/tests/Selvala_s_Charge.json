[
 { "name": "a nonland card from each library makes an Elephant per card, then each player draws",
   "players": [
     { "hand": ["Selvala's Charge"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears"] },
     { "library": ["Hill Giant"] }
   ],
   "steps": [ { "cast": "Selvala's Charge" }, { "resolve": true } ],
   "expect": { "players": [
     { "graveyard": ["Selvala's Charge"], "battlefield_has": ["Elephant 3-3", "Elephant 3-3"], "hand": ["Grizzly Bears"] },
     { "hand": ["Hill Giant"] }
   ] } },
 { "name": "only nonland cards make Elephants (land on your side, nonland on theirs)",
   "players": [
     { "hand": ["Selvala's Charge"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] },
     { "library": ["Grizzly Bears"] }
   ],
   "steps": [ { "cast": "Selvala's Charge" }, { "resolve": true } ],
   "expect": { "players": [
     { "battlefield_has": ["Elephant 3-3"], "hand": ["Forest"] },
     { "hand": ["Grizzly Bears"] }
   ] } },
 { "name": "two lands revealed: no Elephant, the revealed cards are still drawn",
   "players": [
     { "hand": ["Selvala's Charge"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] },
     { "library": ["Island"] }
   ],
   "steps": [ { "cast": "Selvala's Charge" }, { "resolve": true } ],
   "expect": { "players": [
     { "battlefield_lacks": ["Elephant 3-3"], "hand": ["Forest"] },
     { "hand": ["Island"] }
   ] } },
 { "name": "ruling: each player draws the card revealed from the top, even with more cards below it",
   "players": [
     { "hand": ["Selvala's Charge"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Hill Giant"] },
     { "library": ["Hill Giant", "Island"] }
   ],
   "steps": [ { "cast": "Selvala's Charge" }, { "resolve": true } ],
   "expect": { "players": [
     { "battlefield_has": ["Elephant 3-3"], "hand": ["Grizzly Bears"], "library_top": ["Hill Giant"] },
     { "hand": ["Hill Giant"], "library_top": ["Island"] }
   ] } }
]
