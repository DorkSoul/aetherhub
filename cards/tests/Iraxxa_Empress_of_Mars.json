 {
  "name": "ruling: a copy made by Twincast is not cast, so paradox does not count it",
  "players": [
   { "hand": ["Lightning Bolt", "Twincast"], "battlefield": ["Iraxxa, Empress of Mars", "Mountain", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "cast": "Twincast", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true, "auto": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Iraxxa, Empress of Mars"], "battlefield_lacks": ["Alien Warrior 2-2 Red"] },
    { "life": 14 }
   ]
  }
 },
 {
  "name": "ruling: a spell cast from exile (airbent) counts for paradox",
  "players": [
   { "hand": ["Appa, Loyal Sky Bison"], "battlefield": ["Iraxxa, Empress of Mars", "Grizzly Bears", "Plains", "Plains", "Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Appa, Loyal Sky Bison" },
   { "resolve": true, "answers": [[1], "Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Appa, Loyal Sky Bison", "Grizzly Bears", "Alien Warrior 2-2 Red"], "exile": [] },
    {}
   ]
  }
 }
]