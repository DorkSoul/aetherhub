 {
  "name": "an opponent casting a spell does not trigger it",
  "players": [
   {
    "battlefield": [
     "Iraxxa, Empress of Mars"
    ]
   },
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Mountain"
    ]
   }
  ],
  "steps": [
   {
    "pass": true
