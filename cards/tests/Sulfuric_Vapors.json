[
  {
    "name": "red spell deals one more damage to a player",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Sulfuric Vapors", "Mountain"] }, {}],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Lightning Bolt"] }, { "life": 16 }] }
  },
  {
    "name": "red spell's extra damage kills a creature that would survive",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Sulfuric Vapors", "Mountain"] }, { "battlefield": ["Serra Angel"] }],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["Serra Angel"] }, { "resolve": true }],
    "expect": { "players": [{}, { "graveyard": ["Serra Angel"] }] }
  },
  {
    "name": "ruling: the replacement applies to a red spell's damage when it is dealt (Bolt to a 4-toughness creature)",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Sulfuric Vapors", "Mountain"] }, { "battlefield": ["Serra Angel"] }],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["Serra Angel"] }, { "resolve": true }],
    "expect": { "players": [{}, { "graveyard": ["Serra Angel"] }] }
  },
  {
    "name": "ruling: one red spell damaging several targets adds 1 to each (Pyroclasm kills two 3/3s)",
    "players": [
      { "hand": ["Pyroclasm"], "battlefield": ["Sulfuric Vapors", "Mountain", "Mountain", "Hill Giant"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Pyroclasm" }, { "resolve": true }],
    "expect": { "players": [{ "graveyard_has": ["Hill Giant", "Pyroclasm"] }, { "graveyard_has": ["Hill Giant"] }] }
  }
]
