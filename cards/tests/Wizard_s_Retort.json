[
 {
  "name": "costs {1} less with a Wizard and counters a spell",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Mountain"] },
   { "hand": ["Wizard's Retort"], "battlefield": ["Island", "Island", "Apprentice Wizard"] }
  ],
  "steps": [
   { "cast": "Shock", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Wizard's Retort", "targets": [{ "stack": "Shock" }], "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Shock"], "life": 20 }, { "graveyard": ["Wizard's Retort"] } ]
  }
 },
 {
  "name": "without a Wizard it costs full price and cannot be cast with two lands",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Mountain"] },
   { "hand": ["Wizard's Retort"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Shock", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Wizard's Retort", "targets": [{ "stack": "Shock" }], "player": 1, "illegal": true }
  ],
  "expect": {
   "players": [ {}, { "hand": ["Wizard's Retort"] } ]
  }
 },
 {
  "name": "ruling: once Retort is cast with a Wizard, killing the Wizard in response does not stop it countering",
  "players": [
   { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] },
   { "hand": ["Wizard's Retort"], "battlefield": ["Island", "Island", "Apprentice Wizard"] }
  ],
  "steps": [
   { "cast": "Shock", "targets": ["Apprentice Wizard"] },
   { "pass": true },
   { "cast": "Wizard's Retort", "targets": [{ "stack": "Shock" }], "player": 1 },
   { "pass": true, "player": 1 },
   { "cast": "Shock", "targets": ["Apprentice Wizard"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Shock", "Shock"], "life": 20 }, { "graveyard": ["Wizard's Retort", "Apprentice Wizard"] } ]
  }
 }
]
