[
  {
    "name": "ETB: may search for a Forest and put it onto the battlefield",
    "players": [ { "hand": ["Silverglade Elemental"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] }, {} ],
    "steps": [
      { "cast": "Silverglade Elemental" },
      { "resolve": true, "answers": [true, "Forest"] }
    ],
    "expect": { "players": [{ "battlefield_has": ["Silverglade Elemental", "Forest"], "library_count": 0 }, {}] }
  },
  {
    "name": "may decline the search",
    "players": [ { "hand": ["Silverglade Elemental"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] }, {} ],
    "steps": [
      { "cast": "Silverglade Elemental" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [{ "battlefield_has": ["Silverglade Elemental"], "library_count": 1 }, {}] }
  },
  {
    "name": "ruling: the search may find nothing, so no Forest enters even though one is in the library",
    "players": [ { "hand": ["Silverglade Elemental"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] }, {} ],
    "steps": [
      { "cast": "Silverglade Elemental" },
      { "resolve": true, "answers": [true, []] }
    ],
    "expect": { "players": [{ "battlefield_has": ["Silverglade Elemental"], "library_count": 1 }, {}] }
  }
]
