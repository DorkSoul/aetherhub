[
  {
    "name": "1-toughness creatures on both sides are exiled instead of dying",
    "players": [
      { "hand": ["Underworld Fires"], "battlefield": ["Mountain", "Mountain", "Llanowar Elves"] },
      { "battlefield": ["Birds of Paradise"] }
    ],
    "steps": [{ "cast": "Underworld Fires" }, { "resolve": true }],
    "expect": {
      "players": [{ "exile": ["Llanowar Elves"], "graveyard": ["Underworld Fires"] }, { "exile": ["Birds of Paradise"] }]
    }
  },
  {
    "name": "a creature that survives the damage stays on the battlefield",
    "players": [
      { "hand": ["Underworld Fires"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [{ "cast": "Underworld Fires" }, { "resolve": true }],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "exile": ["Savannah Lions"] }]
    }
  },
  {
    "name": "ruling: a creature damaged by this spell and destroyed later that turn is exiled",
    "players": [
      { "hand": ["Underworld Fires", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Underworld Fires" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Underworld Fires", "Lightning Bolt"] }, {}]
    }
  }
]
