[
  {
    "name": "upkeep: untaps a tapped opposing creature and then itself",
    "players": [
      {
        "hand": [
          "Shipwreck Patrol"
        ],
        "battlefield": [
          "Soldevi Golem",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Shipwreck Patrol"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": false
      },
      "players": [
        {
          "battlefield_has": [
            "Soldevi Golem"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "no tapped opposing creature: nothing to untap",
    "players": [
      {
        "battlefield": [
          "Soldevi Golem"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": false
      },
      "players": [
        {
          "battlefield_has": [
            "Soldevi Golem"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "doesn't untap during your untap step: stays tapped with no tapped opposing creature",
    "players": [
      { "battlefield": [ { "name": "Soldevi Golem", "tapped": true } ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Soldevi Golem": true }
    }
  },
  {
    "name": "ruling: the untap ability works even though the Golem is already untapped",
    "players": [
      { "battlefield": ["Soldevi Golem"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false, "Soldevi Golem": false }
    }
  }
]
