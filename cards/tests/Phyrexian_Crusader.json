[
  {
    "name": "first strike with infect kills a 2/2 blocker before it deals damage",
    "players": [
      {
        "battlefield": [
          "Phyrexian Crusader"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Phyrexian Crusader",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Grizzly Bears",
            "attacker": "Phyrexian Crusader"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Phyrexian Crusader"
          ],
          "poison": 0
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "protection from red: a red creature cannot block it, so infect hits the player",
    "players": [
      {
        "battlefield": [
          "Phyrexian Crusader"
        ]
      },
      {
        "battlefield": [
          "Angrath's Marauders"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Phyrexian Crusader",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Phyrexian Crusader"
          ]
        },
        {
          "battlefield": [
            "Angrath's Marauders"
          ],
          "life": 20,
          "poison": 2
        }
      ]
    }
  },
  {
    "name": "protection from red: Angrath's Marauders cannot block Crusader, so its infect hits the player",
    "players": [
      { "battlefield": ["Phyrexian Crusader", "Hill Giant"] },
      { "battlefield": ["Angrath's Marauders", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Phyrexian Crusader", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Angrath's Marauders", "attacker": "Phyrexian Crusader" }, { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Phyrexian Crusader"], "graveyard": ["Hill Giant"] },
        { "life": 20, "poison": 2, "battlefield_has": ["Angrath's Marauders"], "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: infect damage to a blocker without first strike shrinks it before it deals damage",
    "players": [
      { "battlefield": ["Phyrexian Crusader"] },
      { "battlefield": ["Abomination of Gudul"] }
    ],
    "steps": [
      { "attack": [ { "card": "Phyrexian Crusader", "at": "p1" } ] },
      { "block": [ { "blocker": "Abomination of Gudul", "attacker": "Phyrexian Crusader" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Phyrexian Crusader"], "poison": 0 }, { "battlefield_has": ["Abomination of Gudul"] } ],
      "counters": { "Abomination of Gudul": { "-1/-1": 2 } },
      "pt": { "Abomination of Gudul": [1, 2], "Phyrexian Crusader": [2, 2] }
    }
  }
]
