[
  {
    "name": "unkicked: no life loss, P/T is 20 minus the highest life total (5/5)",
    "players": [
      { "hand": ["Scourge of the Skyclaves"], "battlefield": ["Swamp", "Forest"], "life": 15 },
      { "life": 6 }
    ],
    "steps": [
      { "cast": "Scourge of the Skyclaves" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Scourge of the Skyclaves"], "life": 15 }, { "life": 6 }],
      "pt": { "Scourge of the Skyclaves": [5, 5] }
    }
  },
  {
    "name": "kicked (7 mana): each player loses half their life rounded up, then P/T uses the new highest life (10/10)",
    "players": [
      { "hand": ["Scourge of the Skyclaves"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest"], "life": 20 },
      { "life": 15 }
    ],
    "steps": [
      { "cast": "Scourge of the Skyclaves", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Scourge of the Skyclaves"], "life": 10 }, { "life": 7 }],
      "pt": { "Scourge of the Skyclaves": [10, 10] }
    }
  },
  {
    "name": "ruling: the cast trigger resolves before the Scourge enters, so its toughness is 5 (not -10) when it arrives",
    "players": [
      { "hand": ["Scourge of the Skyclaves"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest"], "life": 30 },
      { "life": 6 }
    ],
    "steps": [
      { "cast": "Scourge of the Skyclaves", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Scourge of the Skyclaves"], "life": 15 }, { "life": 3 }],
      "pt": { "Scourge of the Skyclaves": [5, 5] }
    }
  },
  {
    "name": "ruling: with the highest life above 20 the P/T is negative (20 - 25 = -5), so the unkicked Scourge dies",
    "players": [
      { "hand": ["Scourge of the Skyclaves"], "battlefield": ["Swamp", "Forest"], "life": 25 },
      { "life": 10 }
    ],
    "steps": [
      { "cast": "Scourge of the Skyclaves" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Scourge of the Skyclaves"], "battlefield_lacks": ["Scourge of the Skyclaves"], "life": 25 }, { "life": 10 }]
    }
  },
  {
    "name": "ruling: kicker is paid once, so the halving happens once even with mana for a second kick (20 -> 10, not 5)",
    "players": [
      { "hand": ["Scourge of the Skyclaves"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "life": 20 },
      { "life": 20 }
    ],
    "steps": [
      { "cast": "Scourge of the Skyclaves", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Scourge of the Skyclaves"], "life": 10 }, { "life": 10 }],
      "pt": { "Scourge of the Skyclaves": [10, 10] }
    }
  }
]
