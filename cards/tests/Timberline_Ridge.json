[
  {"name": "tapping for mana puts a depletion counter on it",
   "players": [{"battlefield": ["Timberline Ridge"]}, {}],
   "steps": [{"tap_for_mana": "Timberline Ridge", "color": "R"}],
   "expect": {"counters": {"Timberline Ridge": {"depletion": 1}}, "players": [{"battlefield_has": ["Timberline Ridge"]}, {}]}},
  {"name": "does not untap while it has a depletion counter; upkeep removes it",
   "players": [{"battlefield": [{"name": "Timberline Ridge", "counters": {"depletion": 1}}, "Forest"]}, {}],
   "steps": [{"tap_for_mana": "Timberline Ridge", "color": "G"}, {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}],
   "expect": {"counters": {"Timberline Ridge": {}}}},
  {"name": "depletion counter: stays tapped through the untap step",
   "players": [{"battlefield": [{"name": "Timberline Ridge", "tapped": true, "counters": {"depletion": 1}}]}, {}],
   "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}],
   "expect": {"tapped": {"Timberline Ridge": true}, "counters": {"Timberline Ridge": {}}}},
  {"name": "no depletion counter: untaps in the untap step (control)",
   "players": [{"battlefield": [{"name": "Timberline Ridge", "tapped": true}]}, {}],
   "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}],
   "expect": {"tapped": {"Timberline Ridge": false}}}
]
