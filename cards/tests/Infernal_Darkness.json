[
  {
    "name": "lands tapped for mana produce B instead of their own colour",
    "players": [
      { "battlefield": ["Infernal Darkness", "Forest"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Forest" }
    ],
    "expect": {
      "players": [
        { "pool": { "B": 1 } },
        {}
      ]
    }
  },
  {
    "name": "paying the upkeep cost costs B and 1 life",
    "players": [
      { "battlefield": ["Infernal Darkness", "Swamp"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Infernal Darkness": { "age": 1 } },
      "players": [
        { "battlefield_has": ["Infernal Darkness"], "life": 19 },
        {}
      ]
    }
  },
  {
    "name": "an opponent's land also produces B",
    "players": [
      { "battlefield": ["Infernal Darkness"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "tap_for_mana": "Mountain", "player": 1 }
    ],
    "expect": {
      "players": [
        {},
        { "pool": { "B": 1 } }
      ]
    }
  },
  {
    "name": "non-land mana sources are unaffected",
    "players": [
      { "battlefield": ["Infernal Darkness", { "name": "Llanowar Elves", "sick": false }] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Llanowar Elves" }
    ],
    "expect": {
      "players": [
        { "pool": { "G": 1 } },
        {}
      ]
    }
  },
  {
    "name": "cannot pay the upkeep cost: sacrificed",
    "players": [
      { "battlefield": ["Infernal Darkness"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Infernal Darkness"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a land producing two mana still produces two, both B",
    "players": [
      { "battlefield": ["Infernal Darkness", "Ancient Tomb"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Ancient Tomb" }
    ],
    "expect": {
      "players": [
        { "pool": { "B": 2 } },
        {}
      ]
    }
  }
]
