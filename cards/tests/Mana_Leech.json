    "steps": [ { "activate": "Mana Leech", "ability": 0, "targets": ["Forest"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "tapped": { "Forest": true, "Mana Leech": true } } },
