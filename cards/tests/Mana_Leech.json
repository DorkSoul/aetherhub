    "steps": [ { "activate": "Mana Leech", "ability": 0, "targets": ["Forest"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "tapped": { "Forest": false, "Mana Leech": false } } },
  { "name": "choosing to keep Mana Leech tapped keeps the land tapped",
