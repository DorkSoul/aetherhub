   "steps": [ { "activate": "Skill Borrower", "ability": 32768, "targets": ["p1"] },
              { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 19 } ], "tapped": { "Skill Borrower": true } } },
 { "name": "a land on top lends nothing",
   "players": [ { "battlefield": [ { "name": "Skill Borrower", "sick": false } ], "library": ["Island", "Prodigal Sorcerer"] }, {} ],
   "steps": [ { "activate": "Skill Borrower", "ability": 32768, "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "an artifact on top lends its abilities too (Bonesplitter's equip)",
   "players": [ { "battlefield": [ { "name": "Skill Borrower", "sick": false }, "Plains" ], "library": ["Bonesplitter"] }, {} ],
   "steps": [ { "activate": "Skill Borrower", "ability": 32768 },
              { "resolve": true } ],
   "expect": { "pt": { "Skill Borrower": [1, 3] } } },
 { "name": "the abilities follow the top card: drawing reveals a new one",
   "players": [ { "hand": ["Divination"], "battlefield": [ { "name": "Skill Borrower", "sick": false }, "Island", "Island", "Island" ], "library": ["Grizzly Bears", "Island", "Prodigal Sorcerer"] }, {} ],
   "steps": [ { "activate": "Skill Borrower", "ability": 32768, "targets": ["p1"], "illegal": true },
              { "cast": "Divination" },
              { "resolve": true },
              { "activate": "Skill Borrower", "ability": 32768, "targets": ["p1"] },
              { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Grizzly Bears", "Island"] }, { "life": 19 } ] } },
 { "name": "summoning sick: the borrowed {T} ability can't be used",
   "players": [ { "hand": ["Skill Borrower"], "battlefield": ["Island", "Island", "Island"], "library": ["Prodigal Sorcerer"] }, {} ],
   "steps": [ { "cast": "Skill Borrower" },
              { "resolve": true },
              { "activate": "Skill Borrower", "ability": 32768, "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "ruling: the top card changes while the borrowed ability is on the stack; it still resolves",
   "players": [ { "hand": ["Opt"], "battlefield": [ { "name": "Skill Borrower", "sick": false }, "Island" ], "library": ["Prodigal Sorcerer", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Skill Borrower", "ability": 32768, "targets": ["p1"] },
              { "cast": "Opt" },
              { "pass": true },
              { "pass": true, "answers": [ [] ] },
              { "pass": true },
              { "pass": true, "player": 1 } ],
   "expect": { "players": [ { "hand": ["Prodigal Sorcerer"] }, { "life": 19 } ], "tapped": { "Skill Borrower": true } } }
