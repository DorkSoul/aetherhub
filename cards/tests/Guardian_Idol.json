[
 {
  "name": "enters tapped",
  "players": [
   {
    "hand": [
     "Guardian Idol"
    ],
    "battlefield": [
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Guardian Idol"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Guardian Idol": true
   }
  }
 },
 {
  "name": "{2} animates into a 2/2 Golem artifact creature",
  "players": [
   {
    "battlefield": [
     "Guardian Idol",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Guardian Idol"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Guardian Idol": [
     2,
     2
    ]
   }
  }
 },
 {
  "name": "animation ends at end of turn",
  "players": [
   {
    "battlefield": [
     "Guardian Idol",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Guardian Idol"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "pass": true
   },
   {
    "pass": true,
    "player": 1
   }
  ],
  "expect": {
   "turn": 2
  }
 },
 {
  "name": "ruling: a +1/+1 counter on Guardian Idol makes it a 3/3 while animated",
  "players": [{ "battlefield": [{ "name": "Guardian Idol", "counters": { "p1p1": 1 } }, "Mountain", "Mountain"] }, {}],
  "steps": [{ "activate": "Guardian Idol" }, { "resolve": true }],
  "expect": { "pt": { "Guardian Idol": [3, 3] } }
 },
 {
  "name": "ruling: the +1/+1 counter stays on Guardian Idol after the animation ends",
  "players": [{ "battlefield": [{ "name": "Guardian Idol", "counters": { "p1p1": 1 } }, "Mountain", "Mountain"] }, {}],
  "steps": [{ "activate": "Guardian Idol" }, { "resolve": true }, { "advance_to": "End" }, { "pass": true }, { "pass": true, "player": 1 }],
  "expect": { "turn": 2, "counters": { "Guardian Idol": { "p1p1": 1 } }, "not_subtypes": { "Guardian Idol": ["Golem"] } }
 }
]