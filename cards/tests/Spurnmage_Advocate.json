    ],
    "steps": [
      { "advance_to": "End", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "advance_to": "End", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "activate": "Spurnmage Advocate", "player": 1, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"] },
        {}
      ]
    }
