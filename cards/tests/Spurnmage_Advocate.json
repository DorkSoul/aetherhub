[
  {
    "name": "tap: return two opponent cards to hand and destroy an attacking creature",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ],
        "graveyard": [
          "Lightning Bolt",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Spurnmage Advocate",
            "sick": false
          }
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End",
        "auto": true
      },
      {
        "advance_to": "Main1",
        "auto": true
      },
      {
        "advance_to": "End",
        "auto": true
      },
      {
        "advance_to": "Main1",
        "auto": true
      },
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "pass": true
      },
      {
        "activate": "Spurnmage Advocate",
        "player": 1,
        "targets": [
          "Lightning Bolt",
          "Grizzly Bears",
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
