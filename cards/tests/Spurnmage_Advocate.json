  {
    "name": "ruling: two Advocates aimed at the same two cards: the second still destroys its attacker",
    "players": [
      {
        "battlefield": ["Hill Giant", "Serra Angel"],
        "graveyard": ["Lightning Bolt", "Grizzly Bears"]
      },
      {
        "battlefield": [
          { "name": "Spurnmage Advocate", "sick": false },
          { "name": "Spurnmage Advocate", "sick": false }
        ]
      }
    ],
    "steps": [
      { "advance_to": "End", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "advance_to": "End", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Serra Angel", "at": "p1" } ] },
      { "pass": true },
      { "activate": "Spurnmage Advocate", "player": 1, "targets": ["Hill Giant"] },
      { "activate": "Spurnmage Advocate", "player": 1, "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3, "graveyard": ["Hill Giant", "Serra Angel"], "battlefield_lacks": ["Hill Giant", "Serra Angel"] },
        { "battlefield_has": ["Spurnmage Advocate", "Spurnmage Advocate"] }
      ]
    }
  },
  {
    "name": "ruling: an opponent with only one card in graveyard cannot be targeted for the two-card cost",
    "players": [
      {
        "battlefield": ["Hill Giant"],
        "graveyard": ["Lightning Bolt"]
      },
      {
        "battlefield": [ { "name": "Spurnmage Advocate", "sick": false } ]
