            "Spurnmage Advocate"
          ]
        }
      ]
    }
  },
  {
    "name": "needs an attacking creature to target",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ],
        "graveyard": [
          "Lightning Bolt",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Spurnmage Advocate",
            "sick": false
          }
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "activate": "Spurnmage Advocate",
