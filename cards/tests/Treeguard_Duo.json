[
  { "name": "ETB gives a creature you control vigilance and +X/+X where X is your creature count",
    "players": [ { "hand": ["Treeguard Duo"], "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [ { "cast": "Treeguard Duo" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4], "Treeguard Duo": [3, 4] },
      "keywords": { "Grizzly Bears": ["Vigilance"] }
    } },
  { "name": "alone it can target itself with X = 1",
    "players": [ { "hand": ["Treeguard Duo"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Treeguard Duo" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Treeguard Duo": [4, 5] }, "keywords": { "Treeguard Duo": ["Vigilance"] } } },
  { "name": "ruling: X is fixed on resolution; a creature entering later does not raise the bonus",
    "players": [ { "hand": ["Treeguard Duo", "Llanowar Elves"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [ { "cast": "Treeguard Duo" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Llanowar Elves" }, { "resolve": true } ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4], "Llanowar Elves": [1, 1] },
      "keywords": { "Grizzly Bears": ["Vigilance"] }
    } }
]
