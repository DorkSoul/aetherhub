[
  { "name": "1UR: draw a card, then discard a card",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Nivix Guildmage", "Island", "Mountain", "Forest"], "library": ["Grizzly Bears"] }, { } ],
    "steps": [ { "activate": "Nivix Guildmage" }, { "resolve": true, "answers": ["Grizzly Bears"] } ],
    "expect": {
      "players": [ { "hand": ["Lightning Bolt"], "graveyard": ["Grizzly Bears"] }, { } ]
    }
  },
  { "name": "2UR: copies an instant you control, same target",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Nivix Guildmage", "Mountain", "Mountain", "Island", "Forest", "Forest"] }, { } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Nivix Guildmage", "ability": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 14 } ] }
  },
  { "name": "copy ability needs an instant or sorcery spell you control on the stack",
    "players": [ { "battlefield": ["Nivix Guildmage", "Mountain", "Mountain", "Island", "Forest", "Forest"] }, { } ],
    "steps": [ { "activate": "Nivix Guildmage", "ability": 1, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Nivix Guildmage"] }, { "life": 20 } ] }
  },
  { "name": "ruling: the copy ability can copy an instant or sorcery with no targets (Divination draws twice)",
    "players": [ { "hand": ["Divination"], "battlefield": ["Nivix Guildmage", "Island", "Island", "Mountain", "Mountain", "Forest", "Forest", "Forest"] }, { } ],
    "steps": [ { "cast": "Divination" }, { "activate": "Nivix Guildmage", "ability": 1, "targets": [ { "stack": "Divination" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 4, "graveyard": ["Divination"] }, { } ] } }
]
