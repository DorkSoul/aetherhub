[
  { "name": "this turn damage that would take you below 1 life reduces it to 1 instead",
    "players": [ { "hand": ["Angel of Grace"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island"], "life": 2 },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Angel of Grace" }, { "resolve": true }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 1, "battlefield_has": ["Angel of Grace"] }, {} ] } },
  { "name": "the replacement is only until end of turn: before Angel enters, damage takes life below 1",
    "players": [ { "hand": ["Angel of Grace"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island"], "life": 2 },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": -1 }, {} ] } },
  { "name": "graveyard: {4}{W}{W}, exile this card: your life total becomes 10 (gain 7 from 3)",
    "players": [ { "graveyard": ["Angel of Grace"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island", "Island"], "life": 3 }, {} ],
    "steps": [ { "activate": "Angel of Grace", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 10, "graveyard": [] }, {} ] } },
  { "name": "graveyard ability needs six mana: five lands is not enough",
    "players": [ { "graveyard": ["Angel of Grace"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island"], "life": 3 }, {} ],
    "steps": [ { "activate": "Angel of Grace", "ability": 0, "illegal": true } ] },
  { "name": "ruling: the graveyard ability can also make you lose life to reach 10 (20 -> 10)",
    "players": [ { "graveyard": ["Angel of Grace"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island", "Island"], "life": 20 }, {} ],
    "steps": [ { "activate": "Angel of Grace", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 10, "graveyard": [] }, {} ] } }
]
