[
  { "name": "searches two lands: exiled, and it becomes a base 2/2",
    "players": [ { "hand": ["Trench Gorger"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Trench Gorger" }, { "resolve": true, "answers": [["Forest", "Forest"]] } ],
    "expect": { "players": [ { "exile": ["Forest", "Forest"], "battlefield_has": ["Trench Gorger"] }, {} ], "pt": { "Trench Gorger": [2, 2] } } },
  { "name": "searching four lands gives base 4/4",
    "players": [ { "hand": ["Trench Gorger"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Forest", "Plains", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Trench Gorger" }, { "resolve": true, "answers": [["Forest", "Forest", "Plains", "Island"]] } ],
    "expect": { "players": [ { "exile": ["Forest", "Forest", "Plains", "Island"] }, {} ], "pt": { "Trench Gorger": [4, 4] } } },
  { "name": "choosing no lands leaves it a 6/6 and nothing is exiled",
    "players": [ { "hand": ["Trench Gorger"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Trench Gorger" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "exile": [], "battlefield_has": ["Trench Gorger"] }, {} ], "pt": { "Trench Gorger": [6, 6] } } },
  { "name": "ruling: while its ETB ability is on the stack, Trench Gorger is already a 6/6",
    "players": [ { "hand": ["Trench Gorger"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Trench Gorger" }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "stack_empty": false, "players": [ { "battlefield_has": ["Trench Gorger"], "exile": [] }, {} ], "pt": { "Trench Gorger": [6, 6] } } },
  { "name": "ruling: Trench Gorger killed in response to its ETB still lets you search and exile the lands",
    "players": [ { "hand": ["Trench Gorger"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Forest", "Grizzly Bears"] }, { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] } ],
    "steps": [ { "cast": "Trench Gorger" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Doom Blade", "player": 1, "targets": ["Trench Gorger"] }, { "resolve": true, "answers": [["Forest", "Forest"]] } ],
    "expect": { "players": [ { "exile": ["Forest", "Forest"], "graveyard": ["Trench Gorger"] }, { "graveyard": ["Doom Blade"] } ] } }
]
