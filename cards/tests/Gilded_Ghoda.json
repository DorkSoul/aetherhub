[
  { "name": "attacking while saddled creates a Treasure",
    "players": [ { "battlefield": ["Gilded Ghoda", "Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Gilded Ghoda", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Gilded Ghoda", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Treasure"] }, {} ] } },
  { "name": "attacking without being saddled creates no Treasure",
    "players": [ { "battlefield": ["Gilded Ghoda"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Gilded Ghoda", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Treasure"] }, {} ] } },
  { "name": "ruling: a saddled Mount can be saddled again (second saddle taps another creature), attacking still makes one Treasure",
    "players": [ { "battlefield": ["Gilded Ghoda", "Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [
      { "activate": "Gilded Ghoda", "ability": 0 },
      { "resolve": true },
      { "activate": "Gilded Ghoda", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Gilded Ghoda", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Treasure"] }, { "life": 18 } ], "tapped": { "Grizzly Bears": true, "Hill Giant": true } } },
  { "name": "ruling: a Mount that is not saddled can still attack and deals its damage",
    "players": [ { "battlefield": ["Gilded Ghoda"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Gilded Ghoda", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] } }
]
