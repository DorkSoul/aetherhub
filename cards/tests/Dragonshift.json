[
  {
    "name": "single target: a 4/4 blue and red Dragon with flying",
    "players": [
      { "hand": ["Dragonshift"], "battlefield": ["Island", "Mountain", "Forest", "Grizzly Bears"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Dragonshift", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "keywords": { "Grizzly Bears": ["Flying"] }
    }
  },
  {
    "name": "overload: every creature you control becomes a 4/4 Dragon with flying",
    "players": [
      { "hand": ["Dragonshift"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Forest", "Forest", "Forest", "Grizzly Bears", "Hill Giant"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Dragonshift", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [4, 4], "Serra Angel": [4, 4] },
      "keywords": { "Grizzly Bears": ["Flying"], "Hill Giant": ["Flying"] }
    }
  },
  {
    "name": "single target cannot be an opponent's creature",
    "players": [
      { "hand": ["Dragonshift"], "battlefield": ["Island", "Mountain", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dragonshift", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "ruling: overload only affects creatures you control on resolution (opponent's creature unchanged)",
    "players": [
      { "hand": ["Dragonshift"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Dragonshift", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [3, 3] },
      "keywords": { "Grizzly Bears": ["Flying"] }
    }
  },
  {
    "name": "ruling: overload paid has no target, so it can be cast with no creatures on the battlefield",
    "players": [
      { "hand": ["Dragonshift"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Dragonshift", "alt": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Dragonshift"] }, {} ] }
  }
]
