  {
    "name": "transformed back face: combat damage to a player draws a card",
    "players": [
      {
        "battlefield": [
          {
            "name": "Lambholt Elder",
            "sick": false
          }
        ],
        "library": [
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main1"
      },
      {
        "attack": [
          {
            "card": "Silverpelt Werewolf",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        },
        {
          "life": 16
        }
      ]
    }
  },
  {
    "name": "two spells last turn: Silverpelt Werewolf transforms back to Lambholt Elder at upkeep",
    "players": [ { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Silverpelt Werewolf", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Lambholt Elder": [1, 2] } }
  },
  {
    "name": "one spell last turn: Silverpelt Werewolf stays a 4/5",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Silverpelt Werewolf", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "pt": { "Silverpelt Werewolf": [4, 5] } }
  }
