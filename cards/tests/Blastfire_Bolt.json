[
  {
    "name": "deals 5 damage and destroys the Equipment attached to the target",
    "players": [
      { "hand": ["Blastfire Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Bonesplitter"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Blastfire Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Blastfire Bolt", "Bonesplitter", "Grizzly Bears"], "battlefield_lacks": ["Bonesplitter", "Grizzly Bears"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "Equipment on a different creature is not destroyed",
    "players": [
      { "hand": ["Blastfire Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Bonesplitter"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Blastfire Bolt", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Bonesplitter": "Grizzly Bears" },
      "players": [
        { "battlefield_has": ["Bonesplitter", "Grizzly Bears"] },
        { "graveyard": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling: damage is dealt to a creature with no Equipment attached",
    "players": [ { "hand": ["Blastfire Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Blastfire Bolt", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blastfire Bolt"] }, { "graveyard": ["Serra Angel"] } ] }
  },
  {
    "name": "ruling: target gone in response, no Equipment is destroyed",
    "players": [ { "hand": ["Blastfire Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Bonesplitter"] },
                 { "hand": ["Vapor Snag"], "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Blastfire Bolt", "targets": ["Grizzly Bears"] }, { "pass": true },
               { "cast": "Vapor Snag", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blastfire Bolt"], "battlefield_has": ["Bonesplitter"] }, { "graveyard": ["Vapor Snag"] } ] }
  }
]
