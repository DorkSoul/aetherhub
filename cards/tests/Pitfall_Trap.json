  {
    "name": "ruling: full cost may be paid even though the alt cost condition is met",
    "players": [
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] },
      { "hand": ["Pitfall Trap", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains"] }
