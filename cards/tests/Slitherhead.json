[
  { "name": "scavenge from the graveyard puts counters equal to its power",
    "players": [ { "graveyard": ["Slitherhead"], "battlefield": ["Grizzly Bears"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Slitherhead", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Slitherhead"] }, {} ], "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "cannot scavenge without a creature to target",
    "players": [ { "graveyard": ["Slitherhead"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Slitherhead", "illegal": true }
    ] },
  { "name": "ruling: exiling the card is part of the scavenge cost, so it is exiled once the ability is on the stack",
    "players": [ { "graveyard": ["Slitherhead"], "battlefield": ["Grizzly Bears"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Slitherhead", "targets": ["Grizzly Bears"] }
    ],
    "expect": { "players": [ { "exile": ["Slitherhead"], "graveyard": [] }, {} ], "pt": { "Grizzly Bears": [2, 2] } } }
]
