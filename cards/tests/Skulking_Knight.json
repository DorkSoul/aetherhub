[
  {
    "name": "sacrificed when targeted by a spell",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Skulking Knight"] }],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Skulking Knight"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Skulking Knight"] }] }
  },
  {
    "name": "targeting the player does not sacrifice it",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Skulking Knight"] }],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "life": 17, "battlefield_has": ["Skulking Knight"] }] }
  }
]
