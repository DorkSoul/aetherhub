[
  {
    "name": "exiles the target nonland permanent and opponents can't cast a spell with that name",
    "players": [
      { "hand": ["Exclusion Ritual"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Grizzly Bears"], "battlefield": ["Grizzly Bears", "Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Exclusion Ritual" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "advance_to": "Main1", "player": 1 },
      { "cast": "Grizzly Bears", "player": 1, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Exclusion Ritual"] },
        { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"], "hand": ["Forest", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "a spell with a different name can still be cast",
    "players": [
      { "hand": ["Exclusion Ritual"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Hill Giant"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Exclusion Ritual" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "advance_to": "Main1", "player": 1 },
      { "cast": "Hill Giant", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Exclusion Ritual"] },
        { "battlefield_has": ["Hill Giant"], "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "the controller can't cast a spell with the exiled card's name either",
    "players": [
      { "hand": ["Exclusion Ritual", "Grizzly Bears"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Exclusion Ritual" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Exclusion Ritual"], "hand": ["Grizzly Bears"] },
        { "battlefield": [], "exile": ["Grizzly Bears"] }
      ]
    }
  }
]
