[
  {
    "name": "no black permanent: 2 damage",
    "players": [{ "hand": ["Dark Temper"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Dark Temper", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "players": [{}, { "graveyard": ["Grizzly Bears"] }] }
  },
  {
    "name": "you control a black permanent: destroys the creature",
    "players": [
      { "hand": ["Dark Temper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Dark Revenant"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Dark Temper", "targets": ["Hill Giant"] }, { "resolve": true }],
    "expect": { "players": [{}, { "graveyard": ["Hill Giant"] }] }
  },
  {
    "name": "ruling: colour check is made as it resolves; a black permanent that leaves in response means 2 damage only",
    "players": [
      { "hand": ["Dark Temper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Dark Revenant"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Dark Temper", "targets": ["Hill Giant"] },
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Dark Revenant"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dark Temper"], "library_top": ["Dark Revenant"] },
        { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]
