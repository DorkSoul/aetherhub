[
  { "name": "enchants an opponent's creature, removes it from combat and draws a card per tapped creature it controls",
    "players": [ { "hand": ["Observed Stasis"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Island", "Island"] },
                 { "battlefield": ["Hill Giant", { "name": "Grizzly Bears", "tapped": true }, { "name": "Goblin Piker", "tapped": true }] } ],
    "steps": [ { "cast": "Observed Stasis", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ], "attached": { "Observed Stasis": "Hill Giant" }, "pt": { "Hill Giant": [3, 3] } } },
  { "name": "no tapped creatures: no cards drawn",
    "players": [ { "hand": ["Observed Stasis"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Island"] },
                 { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Observed Stasis", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "can't target a creature its controller controls",
    "players": [ { "hand": ["Observed Stasis"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Observed Stasis", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "enchanted creature loses its activated abilities (Prodigal Sorcerer cannot be activated by its controller)",
    "players": [ { "hand": ["Observed Stasis"], "battlefield": ["Island", "Island", "Island", "Island"] },
                 { "battlefield": [ { "name": "Prodigal Sorcerer", "sick": false } ] } ],
    "steps": [ { "cast": "Observed Stasis", "targets": ["Prodigal Sorcerer"] }, { "resolve": true }, { "advance_to": "Upkeep" },
               { "activate": "Prodigal Sorcerer", "ability": 0, "player": 1, "illegal": true } ],
    "expect": { "attached": { "Observed Stasis": "Prodigal Sorcerer" } } },
  { "name": "enchanted creature can't block: the Hill Giant's block is dropped and my Bears is unblocked",
    "players": [ { "hand": ["Observed Stasis"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears", "Goblin Piker"] },
                 { "battlefield": ["Hill Giant", "Llanowar Elves"] } ],
    "steps": [ { "cast": "Observed Stasis", "targets": ["Hill Giant"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Goblin Piker", "at": "p1" } ] },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" }, { "blocker": "Llanowar Elves", "attacker": "Goblin Piker" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "life": 18 } ] } },
  { "name": "ruling: removing the attacking creature from combat does not untap it (still tapped, no damage, one card drawn)",
    "players": [ { "hand": ["Observed Stasis"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Island"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "BeginCombat" },
               { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
               { "pass": true, "player": 1 },
               { "cast": "Observed Stasis", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "hand_count": 1 }, {} ], "tapped": { "Grizzly Bears": true }, "attached": { "Observed Stasis": "Grizzly Bears" } } }
]
