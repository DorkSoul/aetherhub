[
  {
    "name": "bigger creature you control kills the opposing creature",
    "players": [
      {
        "hand": [
          "Swift Kick"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Swift Kick",
        "targets": [
          "Hill Giant",
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Swift Kick"
          ],
          "battlefield_has": [
            "Hill Giant"
          ]
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ],
      "pt": {
        "Hill Giant": [
          4,
          3
        ]
      }
    }
  },
  {
    "name": "both creatures die when the +1/+0 is not enough",
    "players": [
      {
        "hand": [
          "Swift Kick"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Swift Kick",
        "targets": [
          "Grizzly Bears",
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        },
        {
          "graveyard": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: if only the opposing creature becomes illegal, the creature you control still gets +1/+0",
    "players": [
      { "hand": ["Swift Kick"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Hill Giant"] },
      { "hand": ["Shock"], "battlefield": ["Grizzly Bears", "Mountain"] }
    ],
    "steps": [
      { "cast": "Swift Kick", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Swift Kick"], "battlefield_has": ["Hill Giant"] },
        { "graveyard_has": ["Grizzly Bears", "Shock"] }
      ],
      "pt": { "Hill Giant": [4, 3] }
    }
  },
  {
    "name": "ruling: if the creature you control becomes illegal, the opposing creature is not fought",
    "players": [
      { "hand": ["Swift Kick"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Shock"], "battlefield": ["Hill Giant", "Mountain"] }
    ],
    "steps": [
      { "cast": "Swift Kick", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Swift Kick", "Grizzly Bears"] },
        { "graveyard_has": ["Shock"], "battlefield_has": ["Hill Giant"] }
      ],
      "pt": { "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "ruling: both targets are required, the same creature twice is rejected",
    "players": [
      { "hand": ["Swift Kick"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Swift Kick", "targets": ["Hill Giant", "Hill Giant"], "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Swift Kick"], "battlefield_has": ["Hill Giant"] }, {} ] }
  }
]
