[
  { "name": "no crime this turn: costs {2}{U}, so two lands are not enough",
    "players": [ { "hand": ["Seize the Secrets"], "battlefield": ["Island", "Island"], "library": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Seize the Secrets", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Seize the Secrets"], "hand_count": 1 }, {} ] } },
  { "name": "no crime this turn: three mana casts it and draws two",
    "players": [ { "hand": ["Seize the Secrets"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Seize the Secrets" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "library_count": 1, "graveyard": ["Seize the Secrets"] }, {} ] } },
  { "name": "targeting an opponent's creature is a crime: costs {1} less and draws two",
    "players": [ { "hand": ["Lightning Bolt", "Seize the Secrets"], "battlefield": ["Mountain", "Island", "Island"], "library": ["Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Seize the Secrets" }, { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 2, "library_count": 1 }, {} ] } },
  { "name": "targeting your own creature is not a crime: still costs three",
    "players": [ { "hand": ["Lightning Bolt", "Seize the Secrets"], "battlefield": ["Mountain", "Island", "Island", "Grizzly Bears"], "library": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Seize the Secrets", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Seize the Secrets"] }, {} ] } },
  { "name": "ruling: targeting an opponent (the player) with a spell is a crime: Seize the Secrets costs {1} less",
    "players": [ { "hand": ["Lightning Bolt", "Seize the Secrets"], "battlefield": ["Mountain", "Island", "Island"], "library": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Seize the Secrets" }, { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 2, "library_count": 1 }, { "life": 17 } ] } }
]
