[
  {
    "name": "discarding a card makes each opponent mill two",
    "players": [
      { "hand": ["Blasted Landscape"], "battlefield": ["Mystic Redaction", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Blasted Landscape", "ability": 0 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Blasted Landscape"] }, { "library_count": 18 } ]
    }
  },
  {
    "name": "upkeep scry 1: bottoming the top card draws the next one",
    "players": [
      { "battlefield": ["Mystic Redaction"], "library": ["Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[0]] },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "hand": ["Mountain"] }, {} ]
    }
  },
  {
    "name": "upkeep scry 1: keeping the top card draws it",
    "players": [
      { "battlefield": ["Mystic Redaction"], "library": ["Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[]] },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "hand": ["Island"] }, {} ]
    }
  },
  {
    "name": "ruling: a hand-size discard in cleanup still makes each opponent mill two",
    "players": [
      { "hand": ["Island", "Plains", "Forest", "Mountain", "Swamp", "Grizzly Bears", "Lightning Bolt", "Llanowar Elves"], "battlefield": ["Mystic Redaction"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true, "auto": true },
      { "pass": true, "player": 1, "auto": true },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "hand_count": 7 }, { "library_count": 18 } ],
      "turn": 1
    }
  }
]
