[
  {
    "name": "an enchant creature Aura can be cast at instant speed in the end step",
    "players": [
      { "hand": ["Dead Weight"], "battlefield": ["Swamp", "Rootwater Shaman"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Dead Weight", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dead Weight"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "without Rootwater Shaman an enchant creature Aura is still sorcery speed",
    "players": [
      { "hand": ["Dead Weight"], "battlefield": ["Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Dead Weight", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Dead Weight"] },
        { "battlefield_lacks": ["Dead Weight"] }
      ]
    }
  },
  {
    "name": "an Aura that enchants a player does not gain flash",
    "players": [
      { "hand": ["Curse of Bounty"], "battlefield": ["Forest", "Forest", "Rootwater Shaman"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Curse of Bounty", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Curse of Bounty"] },
        { "battlefield_lacks": ["Curse of Bounty"] }
      ]
    }
  }
]
