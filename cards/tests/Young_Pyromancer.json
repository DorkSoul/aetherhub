[
  {
    "name": "casting an instant creates a 1/1 red Elemental token",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Young Pyromancer", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Young Pyromancer", "Elemental"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "casting a creature spell creates no token",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Young Pyromancer", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Young Pyromancer", "Grizzly Bears"], "battlefield_lacks": ["Elemental"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the token trigger still resolves when the Bolt is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Young Pyromancer", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "stack_empty": true,
      "players": [
        { "battlefield_has": ["Young Pyromancer", "Elemental"], "graveyard_has": ["Lightning Bolt"] },
        { "life": 20, "graveyard_has": ["Counterspell"] }
      ]
    }
  }
]
