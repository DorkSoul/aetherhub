[
  {
    "name": "attacks while you control two artifacts: gets +2/+1",
    "players": [ { "battlefield": ["Mountain", "Brazen Blademaster", "Sol Ring", "Ornithopter"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Brazen Blademaster", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "boundary: with only one artifact it does not get the bonus",
    "players": [ { "battlefield": ["Mountain", "Brazen Blademaster", "Sol Ring"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Brazen Blademaster", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: artifacts drop below two after the attack trigger is on the stack, bonus still applies",
    "players": [ { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain", "Brazen Blademaster", "Sol Ring", "Ornithopter"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Brazen Blademaster", "at": "p1" } ] },
      { "cast": "Shatter", "targets": ["Sol Ring"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Sol Ring"] }, { "life": 16 } ]
    }
  }
]
