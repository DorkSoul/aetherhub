[
  {
    "name": "power and toughness count snow permanents, the owl included",
    "players": [
      {
        "battlefield": [
          "Rimefeather Owl",
          "Snow-Covered Island",
          "Snow-Covered Island"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Rimefeather Owl": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "ice counter on a non-snow permanent makes it snow and grows the owl",
    "players": [
      {
        "battlefield": [
          "Rimefeather Owl",
          "Snow-Covered Island",
          "Snow-Covered Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rimefeather Owl",
        "targets": [
          "Island"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Island": {
          "ice": 1
        }
      },
      "pt": {
        "Rimefeather Owl": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "a non-snow permanent without ice counters is not snow",
    "players": [
      {
        "battlefield": [
          "Rimefeather Owl",
          "Island"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Rimefeather Owl": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "the {S} cost needs snow mana",
    "players": [
      {
        "battlefield": [
          "Rimefeather Owl",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rimefeather Owl",
        "targets": [
          "Island"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "pt": {
        "Rimefeather Owl": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "ruling: an ice counter from another source still makes the permanent snow (owl grows, {S} payable)",
    "players": [
      {
        "battlefield": [
          "Rimefeather Owl",
          { "name": "Mountain", "counters": { "ice": 1 } },
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rimefeather Owl",
        "targets": [
          "Island"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Island": {
          "ice": 1
        }
      },
      "pt": {
        "Rimefeather Owl": [
          3,
          3
        ]
      }
    }
  }
]
