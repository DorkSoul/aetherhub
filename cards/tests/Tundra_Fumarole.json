[
 {
  "name": "snow mana spent adds colorless mana",
  "players": [
   {
    "hand": [
     "Tundra Fumarole"
    ],
    "battlefield": [
     "Snow-Covered Mountain",
     "Snow-Covered Mountain",
     "Mountain"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Tundra Fumarole",
    "targets": [
     "Hill Giant"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "pool": {
      "C": 2
     }
    },
    {
     "graveyard": [
      "Hill Giant"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: {S} can be paid by snow mana of any colour (snow Island pays the generic part)",
  "players": [
   { "hand": ["Tundra Fumarole"], "battlefield": ["Snow-Covered Mountain", "Snow-Covered Mountain", "Snow-Covered Island"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Tundra Fumarole", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "pool": { "C": 3 } }, { "graveyard": ["Hill Giant"] } ] }
 },
 {
  "name": "ruling: cast without snow mana still deals 4 damage but adds no mana",
  "players": [
   { "hand": ["Tundra Fumarole"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Tundra Fumarole", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "pool": { "C": 0 } }, { "graveyard": ["Hill Giant"] } ] }
 },
 {
  "name": "ruling: if the target is gone on resolution nothing happens and no mana is added",
  "players": [
   { "hand": ["Tundra Fumarole", "Lightning Bolt"], "battlefield": ["Snow-Covered Mountain", "Snow-Covered Mountain", "Snow-Covered Mountain", "Snow-Covered Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Tundra Fumarole", "targets": ["Hill Giant"] },
   { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Tundra Fumarole", "Lightning Bolt"], "pool": { "C": 0 } }, { "graveyard": ["Hill Giant"] } ] }
 }
]