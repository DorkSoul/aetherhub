[
  { "name": "normal cast for {U}{U} in main phase: no flash needed, no tapped creature to return",
    "players": [ { "hand": ["Harbinger of the Tides"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Harbinger of the Tides" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Harbinger of the Tides"] }, {} ] } },
  { "name": "without paying {2} more it does not have flash: illegal in the end step",
    "players": [ { "hand": ["Harbinger of the Tides"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "cast": "Harbinger of the Tides", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Harbinger of the Tides"], "battlefield_lacks": ["Harbinger of the Tides"] }, {} ] } },
  { "name": "paying {2} more ({2}{U}{U}) gives flash: castable in the end step",
    "players": [ { "hand": ["Harbinger of the Tides"], "battlefield": ["Island", "Island", "Plains", "Plains"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "cast": "Harbinger of the Tides", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Harbinger of the Tides"], "hand": [] }, {} ] } },
  { "name": "enters: may return a tapped creature an opponent controls to hand",
    "players": [ { "hand": ["Harbinger of the Tides"], "battlefield": ["Island", "Island"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Harbinger of the Tides" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Harbinger of the Tides"] }, { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "enters: an untapped creature an opponent controls cannot be returned",
    "players": [ { "hand": ["Harbinger of the Tides"], "battlefield": ["Island", "Island"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Harbinger of the Tides" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Harbinger of the Tides"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
