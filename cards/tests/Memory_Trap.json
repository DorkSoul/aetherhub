[
  {
    "name": "exiles an opponent's nonland permanent",
    "players": [
      { "hand": ["Memory Trap"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Memory Trap" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Memory Trap"] }, { "battlefield": [], "exile": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "only opponent's nonland permanents are chosen",
    "players": [
      { "hand": ["Memory Trap"], "battlefield": ["Plains", "Plains", "Plains", "Serra Angel"] },
      { "battlefield": ["Forest", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Memory Trap" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Serra Angel", "Memory Trap"] }, { "battlefield_has": ["Forest"], "exile": ["Hill Giant"] }]
    }
  }
]
