[
  {
    "name": "combat damage to a player returns a graveyard card with mana value 3 or less",
    "players": [{ "battlefield": ["Bilbo, Unexpected Adventurer"], "graveyard": ["Grizzly Bears"] }, {}],
    "steps": [
      { "attack": [{ "card": "Bilbo, Unexpected Adventurer", "at": "p1" }] },
      { "advance_to": "Main2", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "graveyard": [] }, { "life": 18 }]
    }
  },
  {
    "name": "mana value 4 card in graveyard is not a legal target",
    "players": [{ "battlefield": ["Bilbo, Unexpected Adventurer"], "graveyard": ["Bigfin Bouncer"] }, {}],
    "steps": [{ "attack": [{ "card": "Bilbo, Unexpected Adventurer", "at": "p1" }] }, { "advance_to": "Main2" }],
    "expect": {
      "players": [{ "graveyard": ["Bigfin Bouncer"], "battlefield_lacks": ["Bigfin Bouncer"] }, { "life": 18 }]
    }
  },
  {
    "name": "can't be blocked by power 3 or greater: Hill Giant's block is illegal, Bilbo connects",
    "players": [ { "battlefield": ["Bilbo, Unexpected Adventurer", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Llanowar Elves"] } ],
    "steps": [
      { "attack": [ { "card": "Bilbo, Unexpected Adventurer", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Bilbo, Unexpected Adventurer" }, { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bilbo, Unexpected Adventurer", "Grizzly Bears"] }, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: X counts as 0 for a graveyard card's mana value (Sphere of Annihilation has MV 1 and can be returned)",
    "players": [{ "battlefield": ["Bilbo, Unexpected Adventurer"], "graveyard": ["Sphere of Annihilation"] }, {}],
    "steps": [
      { "attack": [{ "card": "Bilbo, Unexpected Adventurer", "at": "p1" }] },
      { "advance_to": "Main2", "targets": ["Sphere of Annihilation"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Sphere of Annihilation"], "graveyard": [] }, { "life": 18 }]
    }
  }
]
