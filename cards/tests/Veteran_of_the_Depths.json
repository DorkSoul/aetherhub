[
  {
    "name": "becoming tapped (attacking) and accepting puts a +1/+1 counter",
    "players": [ { "battlefield": ["Veteran of the Depths"] }, {} ],
    "steps": [ { "attack": [ { "card": "Veteran of the Depths", "at": "p1" } ] }, { "resolve": true, "answers": [true] } ],
    "expect": { "counters": { "Veteran of the Depths": { "p1p1": 1 } }, "pt": { "Veteran of the Depths": [3, 3] } }
  },
  {
    "name": "declining the optional counter",
    "players": [ { "battlefield": ["Veteran of the Depths"] }, {} ],
    "steps": [ { "attack": [ { "card": "Veteran of the Depths", "at": "p1" } ] }, { "resolve": true, "answers": [false] } ],
    "expect": { "pt": { "Veteran of the Depths": [2, 2] } }
  },
  {
    "name": "ruling: an untapped creature tapped by a spell triggers (control)",
    "players": [ { "hand": ["Frost Breath"], "battlefield": ["Veteran of the Depths", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Frost Breath", "targets": ["Veteran of the Depths"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "counters": { "Veteran of the Depths": { "p1p1": 1 } }, "pt": { "Veteran of the Depths": [3, 3] } }
  },
  {
    "name": "ruling: a creature that is already tapped does not trigger again when an effect taps it",
    "players": [ { "hand": ["Frost Breath"], "battlefield": ["Veteran of the Depths", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Veteran of the Depths", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main2" },
      { "cast": "Frost Breath", "targets": ["Veteran of the Depths"] },
      { "resolve": true }
    ],
    "expect": { "counters": { "Veteran of the Depths": { "p1p1": 1 } }, "pt": { "Veteran of the Depths": [3, 3] } }
  }
]
