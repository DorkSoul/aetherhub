[
  {
    "name": "finds a Goblin permanent and puts it onto the battlefield",
    "players": [
      {
        "battlefield": [
          "Moggcatcher",
          "Mountain",
          "Mountain",
          "Mountain"
        ],
        "library": [
          "Goblin King"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Moggcatcher"
      },
      {
        "resolve": true,
        "answers": [
          "Goblin King"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Goblin King",
            "Moggcatcher"
          ]
        },
        {}
      ],
      "tapped": {
        "Moggcatcher": true
      }
    }
  },
  {
    "name": "ignores non-Goblin cards in the library",
    "players": [
      {
        "battlefield": [
          "Moggcatcher",
          "Mountain",
          "Mountain",
          "Mountain"
        ],
        "library": [
          "Grizzly Bears",
          "Goblin King"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Moggcatcher"
      },
      {
        "resolve": true,
        "answers": [
          "Goblin King"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Goblin King"
          ],
          "battlefield_lacks": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "no Goblin in library: nothing enters",
    "players": [
      {
        "battlefield": [
          "Moggcatcher",
          "Mountain",
          "Mountain",
          "Mountain"
        ],
        "library": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Moggcatcher"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: you may find nothing even when a Goblin is in the library",
    "players": [ { "battlefield": ["Moggcatcher", "Mountain", "Mountain", "Mountain"], "library": ["Goblin King"] }, {} ],
    "steps": [ { "activate": "Moggcatcher" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Goblin King"], "library_count": 21 }, {} ], "tapped": { "Moggcatcher": true } }
  }
]
