[
  {
    "name": "Equipment spells cost {1} less for each Ally you control",
    "players": [
      {
        "hand": [
          "Bonesplitter"
        ],
        "battlefield": [
          "Sokka, Swordmaster"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Bonesplitter"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Bonesplitter"
          ],
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "without Sokka the Equipment still costs {1}",
    "players": [
      {
        "hand": [
          "Bonesplitter"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Bonesplitter",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Bonesplitter"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "beginning of combat: attach up to one Equipment you control to Sokka",
    "players": [
      {
        "battlefield": [
          "Sokka, Swordmaster",
          "Accorder's Shield"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat",
        "targets": [
          "Accorder's Shield"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "attached": {
        "Accorder's Shield": "Sokka, Swordmaster"
      }
    }
  },
  {
    "name": "ruling: Thalia's {1} tax and Sokka's reduction both apply to the Equipment spell's total cost",
    "players": [
      { "hand": ["Bonesplitter"], "battlefield": ["Mountain", "Sokka, Swordmaster", "Thalia, Guardian of Thraben"] },
      {}
    ],
    "steps": [
      { "cast": "Bonesplitter" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bonesplitter"], "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "ruling: without Sokka, Thalia's tax alone makes the Equipment cost {2}",
    "players": [
      { "hand": ["Bonesplitter"], "battlefield": ["Mountain", "Thalia, Guardian of Thraben"] },
      {}
    ],
    "steps": [
      { "cast": "Bonesplitter", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Bonesplitter"] }, {} ]
    }
  }
]
