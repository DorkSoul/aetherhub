[
  { "name": "boast creates a Dwarf Berserker after the creature attacked",
    "players": [ { "battlefield": ["Fearless Liberator", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "attack": [ { "card": "Fearless Liberator", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "activate": "Fearless Liberator", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dwarf Berserker", "Fearless Liberator"] }, { "life": 18 } ] } },
  { "name": "boast can only be activated once each turn",
    "players": [ { "battlefield": ["Fearless Liberator", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "attack": [ { "card": "Fearless Liberator", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "activate": "Fearless Liberator", "ability": 0 }, { "resolve": true }, { "activate": "Fearless Liberator", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dwarf Berserker"] }, {} ] } },
  { "name": "boast is not available if the creature did not attack this turn",
    "players": [ { "battlefield": ["Fearless Liberator", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "activate": "Fearless Liberator", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Fearless Liberator"] }, {} ] } },
  { "name": "ruling: boast can still be activated in the end step after the creature attacked",
    "players": [ { "battlefield": ["Fearless Liberator", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "attack": [ { "card": "Fearless Liberator", "at": "p1" } ] }, { "block": [] }, { "advance_to": "End" }, { "activate": "Fearless Liberator", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dwarf Berserker", "Fearless Liberator"] }, { "life": 18 } ] } }
]
