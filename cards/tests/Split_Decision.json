[
  { "name": "denial gets more votes: the spell is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Split Decision"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Split Decision", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
               { "resolve": true, "answers": [0, 0] } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 20, "graveyard": ["Split Decision"] } ] } },
  { "name": "a tied vote copies the spell: the copy and the original both hit for 3",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Split Decision"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Split Decision", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
               { "resolve": true, "answers": [0, 1] },
               { "resolve": true },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 14, "graveyard": ["Split Decision"] } ] } },
  { "name": "ruling: a vote of one denial and one duplication is tied, so the spell is copied",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Split Decision"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Split Decision", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
               { "resolve": true, "answers": [0, 1] },
               { "resolve": true },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 14, "graveyard": ["Split Decision"] } ] } },
  { "name": "ruling: a copy of a modal spell has the same modes",
    "players": [ { "hand": ["Dromoka's Command"], "battlefield": ["Forest", "Plains", "Grizzly Bears"] },
                 { "hand": ["Split Decision"], "battlefield": ["Island", "Island", "Oath of Gideon"] } ],
    "steps": [ { "cast": "Dromoka's Command", "targets": ["p1", "Grizzly Bears"], "answers": [[1, 2]] },
               { "cast": "Split Decision", "player": 1, "targets": [ { "stack": "Dromoka's Command" } ] },
               { "resolve": true, "answers": [1, 1] },
               { "resolve": true },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Dromoka's Command"] }, { "graveyard_has": ["Oath of Gideon", "Split Decision"] } ], "pt": { "Grizzly Bears": [4, 4] } } }
]
