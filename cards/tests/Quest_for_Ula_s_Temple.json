[
  {
    "name": "ruling: a revealed creature stays on top of the library",
    "players": [ { "battlefield": ["Quest for Ula's Temple"], "library": ["Hill Giant", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "advance_to": "Main2", "player": 1 }, { "advance_to": "Upkeep", "answers": [true, true] } ],
    "expect": { "players": [ { "library_top": ["Hill Giant", "Forest", "Forest"] }, {} ], "counters": { "Quest for Ula's Temple": { "quest": 1 } } }
  },
  {
    "name": "ruling: the end-step ability also triggers on the opponent's end step",
    "players": [ { "hand": ["Kraken Hatchling"], "battlefield": [ { "name": "Quest for Ula's Temple", "counters": { "quest": 3 } } ] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1, "answers": [[]] }, { "advance_to": "Main2", "player": 1 }, { "advance_to": "End", "player": 1, "answers": [["Kraken Hatchling"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Kraken Hatchling", "Quest for Ula's Temple"] }, {} ] }
  },
  {
    "name": "upkeep: a creature on top, revealed, puts a quest counter",
    "players": [
      {
        "battlefield": [
          "Quest for Ula's Temple"
        ],
        "library": [
          "Hill Giant",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      },
      {
        "advance_to": "Main1",
        "player": 1
      },
      {
        "advance_to": "Main2",
        "player": 1
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true,
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Quest for Ula's Temple"
          ]
        },
        {}
      ],
      "counters": {
        "Quest for Ula's Temple": {
          "quest": 1
        }
      }
    }
  },
  {
    "name": "upkeep: a non-creature on top puts no quest counter",
    "players": [
      {
        "battlefield": [
          "Quest for Ula's Temple"
        ],
        "library": [
          "Forest",
          "Hill Giant",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      },
      {
        "advance_to": "Main1",
        "player": 1
      },
      {
        "advance_to": "Main2",
        "player": 1
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Quest for Ula's Temple"
          ]
        },
        {}
      ],
      "counters": {
        "Quest for Ula's Temple": {
          "quest": 0
        }
      }
    }
  },
  {
    "name": "upkeep: a creature on top that is not revealed puts no quest counter",
    "players": [
      {
        "battlefield": [
          "Quest for Ula's Temple"
        ],
        "library": [
          "Hill Giant",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      },
      {
        "advance_to": "Main1",
        "player": 1
      },
      {
        "advance_to": "Main2",
        "player": 1
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true,
          false
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Quest for Ula's Temple"
          ]
        },
        {}
      ],
      "counters": {
        "Quest for Ula's Temple": {
          "quest": 0
        }
      }
    }
  },
  {
    "name": "end step with three quest counters: may put a Kraken from hand onto the battlefield",
    "players": [
      {
        "hand": [
          "Kraken Hatchling"
        ],
        "battlefield": [
          {
            "name": "Quest for Ula's Temple",
            "counters": {
              "quest": 3
            }
          }
        ]
      },
      {}
