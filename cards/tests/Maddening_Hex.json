[
 { "name": "enchanted player casting a noncreature spell takes a d6",
   "players": [ { "hand": ["Maddening Hex"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Maddening Hex", "targets": ["p1"] }, { "resolve": true },
              { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 17, "battlefield_has": ["Maddening Hex"] }, { "life": 18 } ] } },
 { "name": "ruling: the die result is the damage (a 6 deals 6)",
   "rolls": [6],
   "players": [ { "hand": ["Maddening Hex"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Maddening Hex", "targets": ["p1"] }, { "resolve": true },
              { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 17 }, { "life": 14 } ] } },
 { "name": "ruling: with only one opponent the Aura stays on that player and keeps triggering",
   "rolls": [2, 4],
   "players": [ { "hand": ["Maddening Hex"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
   "steps": [ { "cast": "Maddening Hex", "targets": ["p1"] }, { "resolve": true },
              { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true },
              { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 14, "battlefield_has": ["Maddening Hex"] }, { "life": 14 } ] } }
]
