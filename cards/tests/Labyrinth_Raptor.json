[
  {
    "name": "blocked menace attacker makes the defending player sacrifice one blocker",
    "players": [
      { "battlefield": [
          { "name": "Grizzly Bears", "sick": false },
          { "name": "Balduvian Bears", "sick": false }
        ] },
      { "battlefield": [{ "name": "Labyrinth Raptor", "sick": false }] }
    ],
    "steps": [
      { "advance_to": "Main1", "auto": true },
      { "player": 1, "attack": [{ "card": "Labyrinth Raptor", "at": "p0" }] },
      { "player": 0, "block": [
          { "blocker": "Grizzly Bears", "attacker": "Labyrinth Raptor" },
          { "blocker": "Balduvian Bears", "attacker": "Labyrinth Raptor" }
        ] },
      { "advance_to": "Main2", "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "a non-menace attacker being blocked does not trigger",
    "players": [
      { "battlefield": [{ "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": [
          "Labyrinth Raptor",
          { "name": "Hill Giant", "sick": false }
        ] }
    ],
    "steps": [
      { "advance_to": "Main1", "auto": true },
      { "player": 1, "attack": [{ "card": "Hill Giant", "at": "p0" }] },
      { "player": 0, "block": [{ "blocker": "Grizzly Bears", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "BR pumps creatures you control with menace",
    "players": [
      { "battlefield": ["Labyrinth Raptor", "Swamp", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Labyrinth Raptor" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Labyrinth Raptor": [3, 2] }
    }
  },
  {
    "name": "ruling: the sacrificed blocker leaves; the remaining blocker still deals and takes combat damage",
    "players": [
      { "battlefield": [
          { "name": "Grizzly Bears", "sick": false },
          { "name": "Balduvian Bears", "sick": false }
        ] },
      { "battlefield": [{ "name": "Labyrinth Raptor", "sick": false }] }
    ],
    "steps": [
      { "advance_to": "Main1", "auto": true },
      { "player": 1, "attack": [{ "card": "Labyrinth Raptor", "at": "p0" }] },
      { "player": 0, "block": [
          { "blocker": "Grizzly Bears", "attacker": "Labyrinth Raptor" },
          { "blocker": "Balduvian Bears", "attacker": "Labyrinth Raptor" }
        ] },
      { "advance_to": "Main2", "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears", "Balduvian Bears"] },
        { "graveyard_has": ["Labyrinth Raptor"] }
      ]
    }
  }
]
