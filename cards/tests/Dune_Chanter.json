[
  { "name": "tap: mill two lands, gain 2 life",
    "players": [ { "battlefield": ["Dune Chanter"], "library": ["Forest", "Mountain", "Island"] }, {} ],
    "steps": [ { "activate": "Dune Chanter", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "graveyard": ["Forest", "Mountain"] }, {} ], "tapped": { "Dune Chanter": true } } },
  { "name": "tap: one land and one nonland milled, gain 1 life",
    "players": [ { "battlefield": ["Dune Chanter"], "library": ["Grizzly Bears", "Forest", "Island"] }, {} ],
    "steps": [ { "activate": "Dune Chanter", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Grizzly Bears", "Forest"] }, {} ] } },
  { "name": "tap: no lands milled, no life",
    "players": [ { "battlefield": ["Dune Chanter"], "library": ["Grizzly Bears", "Hill Giant", "Island"] }, {} ],
    "steps": [ { "activate": "Dune Chanter", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "lands you control tap for any colour (three Forests pay for a blue spell)",
    "players": [ { "hand": ["Divination"], "battlefield": ["Dune Chanter", "Forest", "Forest", "Forest"], "library": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard": ["Divination"] }, {} ] } },
  { "name": "lands you control are Deserts (Colossal Rattlewurm gets flash)",
    "start": "Upkeep",
    "players": [ { "hand": ["Colossal Rattlewurm"], "battlefield": ["Dune Chanter", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Colossal Rattlewurm" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Colossal Rattlewurm"] }, {} ] } },
  { "name": "without the Chanter a Forest is no Desert (no flash)",
    "start": "Upkeep",
    "players": [ { "hand": ["Colossal Rattlewurm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Colossal Rattlewurm", "illegal": true } ] },
  { "name": "your land cards in the library are Deserts (Rattlewurm fetches a Forest tapped)",
    "players": [ { "graveyard": ["Colossal Rattlewurm"], "battlefield": ["Dune Chanter", "Forest", "Forest"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "activate": "Colossal Rattlewurm", "ability": 0 }, { "resolve": true, "answers": ["Forest"] } ],
    "expect": { "tapped": { "Forest": true }, "players": [ { "exile": ["Colossal Rattlewurm"] }, {} ] } },
  { "name": "without the Chanter a Forest in the library is no Desert (nothing fetched)",
    "players": [ { "graveyard": ["Colossal Rattlewurm"], "battlefield": ["Forest", "Forest"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "activate": "Colossal Rattlewurm", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Colossal Rattlewurm"], "battlefield_has": ["Forest", "Forest"] }, {} ] } }
]
