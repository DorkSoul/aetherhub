[
  { "name": "destroys the creature and its controller gets the Inkling",
    "players": [ { "hand": ["Harsh Annotation"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Harsh Annotation", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Harsh Annotation"], "battlefield_lacks": ["Inkling 1-1 White Black Flying"] },
        { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Inkling 1-1 White Black Flying"] }
      ]
    }
  },
  { "name": "casting it on your own creature gives the Inkling to you",
    "players": [ { "hand": ["Harsh Annotation"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Harsh Annotation", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears", "Harsh Annotation"], "battlefield_has": ["Inkling 1-1 White Black Flying"] },
        { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Inkling 1-1 White Black Flying"] }
      ]
    }
  },
  { "name": "ruling: if the target becomes illegal (shroud in response) Harsh Annotation does nothing and no Inkling is created",
    "players": [ { "hand": ["Harsh Annotation"], "battlefield": ["Plains", "Plains"] }, { "hand": ["Mage's Guile"], "battlefield": ["Island", "Island", "Grizzly Bears"] } ],
    "steps": [
      { "cast": "Harsh Annotation", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Mage's Guile", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Harsh Annotation"] },
        { "graveyard": ["Mage's Guile"], "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Inkling 1-1 White Black Flying"] }
      ]
    }
  }
]
