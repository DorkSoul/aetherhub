[
  {
    "name": "chapter I creates a 1/1 white Human",
    "players": [
      { "hand": ["Welcome to Sweettooth"], "battlefield": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Welcome to Sweettooth" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Human 1-1 White", "Welcome to Sweettooth"] },
        {}
      ]
    }
  },
  {
    "name": "chapter II creates a Food",
    "players": [
      { "hand": ["Welcome to Sweettooth"], "battlefield": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Welcome to Sweettooth" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Food", "Human 1-1 White", "Welcome to Sweettooth"] },
        {}
      ]
    }
  },
  {
    "name": "chapter III: counters on target creature equal to one plus the Foods you control",
    "players": [
      { "hand": ["Welcome to Sweettooth"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Welcome to Sweettooth" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Food", "Grizzly Bears"], "battlefield_lacks": ["Welcome to Sweettooth"] },
        {}
      ],
      "pt": { "Grizzly Bears": [4, 4] },
      "counters": { "Grizzly Bears": { "p1p1": 2 } }
    }
  },
  {
    "name": "ruling: a non-token Food artifact (Tough Cookie) counts as a Food for chapter III",
    "players": [
      { "hand": ["Welcome to Sweettooth"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Tough Cookie"] },
      {}
    ],
    "steps": [
      { "cast": "Welcome to Sweettooth" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Food", "Grizzly Bears", "Tough Cookie"], "battlefield_lacks": ["Welcome to Sweettooth"] },
        {}
      ],
      "pt": { "Grizzly Bears": [5, 5] },
      "counters": { "Grizzly Bears": { "p1p1": 3 } }
    }
  }
]
