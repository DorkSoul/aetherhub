    "steps": [ { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Golden Egg"], "battlefield_has": ["Maraleaf Rider"] }, {} ] } },
  { "name": "a Food cannot pay two costs: after Golden Egg's life ability, Maraleaf Rider has no Food to sacrifice",
