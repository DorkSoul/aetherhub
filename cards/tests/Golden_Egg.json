    "players": [ { "hand": ["Tough Cookie"], "battlefield": ["Forest", "Forest", "Maraleaf Rider"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Tough Cookie" }, { "resolve": true }, { "resolve": true }, { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"], "answers": ["Food"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tough Cookie", "Maraleaf Rider"], "battlefield_lacks": ["Food"] }, {} ] } }
