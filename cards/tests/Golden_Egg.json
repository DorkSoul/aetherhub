    "steps": [ { "activate": "Golden Egg", "ability": 0 }, { "resolve": true }, { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "life": 23, "graveyard": ["Golden Egg"], "battlefield_has": ["Maraleaf Rider"] }, {} ] } },
