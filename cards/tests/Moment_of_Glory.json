[
 { "name": "from hand: only the targeted creature gets the counter",
   "players": [ { "hand": ["Moment of Glory"], "battlefield": ["Plains", "Grizzly Bears", "Prodigal Pyromancer"] }, {} ],
   "steps": [ { "cast": "Moment of Glory", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "pt": { "Grizzly Bears": [3, 3], "Prodigal Pyromancer": [1, 1] }, "players": [ { "graveyard": ["Moment of Glory"] } ] } },
 { "name": "flashback from graveyard: counter on each other creature too, then exiled",
   "players": [ { "graveyard": ["Moment of Glory"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears", "Prodigal Pyromancer"] }, {} ],
   "steps": [ { "cast": "Moment of Glory", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "pt": { "Grizzly Bears": [3, 3], "Prodigal Pyromancer": [2, 2] }, "players": [ { "exile": ["Moment of Glory"] } ] } },
 { "name": "flashback costs five mana",
   "players": [ { "graveyard": ["Moment of Glory"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Moment of Glory", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
 { "name": "ruling: flashback spell whose target becomes illegal is exiled, not put in the graveyard",
   "players": [ { "graveyard": ["Moment of Glory"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears", "Prodigal Pyromancer"] },
                { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Moment of Glory", "alt": 0, "targets": ["Grizzly Bears"] },
              { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] },
              { "pass": true, "player": 1 },
              { "pass": true },
              { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Moment of Glory"], "graveyard": ["Grizzly Bears"], "battlefield_has": ["Prodigal Pyromancer"] },
                            { "graveyard": ["Shock"] } ] } },
 { "name": "ruling: a card put into the graveyard this turn can be flashed back right away",
   "players": [ { "hand": ["Moment of Glory"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Moment of Glory", "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "cast": "Moment of Glory", "alt": 0, "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "pt": { "Grizzly Bears": [4, 4] }, "players": [ { "exile": ["Moment of Glory"] }, {} ] } },
 { "name": "ruling: flashback follows sorcery timing, so it is illegal during combat",
   "players": [ { "graveyard": ["Moment of Glory"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" },
              { "cast": "Moment of Glory", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Moment of Glory"] }, {} ], "pt": { "Grizzly Bears": [2, 2] } } }
]
