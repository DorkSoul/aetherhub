 {
  "name": "ruling: if its only blocker is removed before damage, it deals no combat damage and the player takes none",
  "players": [
   { "battlefield": [ { "name": "Butcher Orgg", "sick": false } ] },
   { "hand": ["Drag Down"], "battlefield": ["Swamp", "Swamp", "Forest", "Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [ { "card": "Butcher Orgg", "at": "p1" } ] },
   { "block": [ { "blocker": "Grizzly Bears", "attacker": "Butcher Orgg" } ] },
   { "pass": true },
   { "cast": "Drag Down", "player": 1, "targets": ["p1:Grizzly Bears"] },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "life": 20, "graveyard": ["Grizzly Bears", "Drag Down"] } ]
  }
 },
 {
