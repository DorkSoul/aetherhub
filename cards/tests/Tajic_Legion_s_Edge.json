[
  {
    "name": "noncombat damage to another creature you control is prevented: Grizzly Bears survives Shock",
    "players": [
      { "battlefield": ["Tajic, Legion's Edge", "Grizzly Bears", "Plains"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Tajic, Legion's Edge", "Grizzly Bears", "Plains"] },
        { "graveyard": ["Shock"] }
      ]
    }
  },
  {
    "name": "Tajic himself is not protected: Shock deals 2 and kills him (3/2)",
    "players": [
      { "battlefield": ["Tajic, Legion's Edge", "Grizzly Bears", "Plains"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Tajic, Legion's Edge"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Tajic, Legion's Edge"] },
        { "graveyard": ["Shock"] }
      ]
    }
  },
  {
    "name": "RW: Tajic gains first strike, so a blocking Grizzly Bears dies without dealing damage",
    "players": [
      { "battlefield": ["Mountain", "Plains", { "name": "Tajic, Legion's Edge", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Tajic, Legion's Edge", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Tajic, Legion's Edge", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Tajic, Legion's Edge" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Tajic, Legion's Edge"], "life": 20 }, { "graveyard": ["Grizzly Bears"] } ] }
  },
  {
    "name": "without the first strike activation Tajic and the blocking Grizzly Bears trade",
    "players": [
      { "battlefield": ["Mountain", "Plains", { "name": "Tajic, Legion's Edge", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Tajic, Legion's Edge", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Tajic, Legion's Edge" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Tajic, Legion's Edge"] }, { "graveyard": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: mentor uses the attacker's last power: Tajic dies with its trigger on the stack, the counter still lands on Grizzly Bears",
    "players": [
      { "battlefield": ["Tajic, Legion's Edge", "Grizzly Bears", "Plains", "Mountain"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "attack": [ { "card": "Tajic, Legion's Edge", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Tajic, Legion's Edge"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Tajic, Legion's Edge"], "battlefield_has": ["Grizzly Bears"] },
        { "graveyard": ["Shock"] }
      ],
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
