[
  {
    "name": "end step: deals damage to you equal to the pain counters on it",
    "players": [
      {
        "battlefield": [{ "name": "Torture Chamber", "counters": { "pain": 2 } }]
      },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "life": 18 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "upkeep: puts a pain counter on it",
    "players": [
      {
        "battlefield": ["Torture Chamber"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "counters": {
        "Torture Chamber": { "pain": 1 }
      }
    }
  },
  {
    "name": "{1},{T}, remove all pain counters: deals that much damage to target creature",
    "players": [
      {
        "battlefield": [{ "name": "Torture Chamber", "counters": { "pain": 3 } }, "Swamp"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "activate": "Torture Chamber", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": {
        "Torture Chamber": { "pain": 0 }
      },
      "players": [
        { "battlefield_has": ["Torture Chamber"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "{1},{T}, remove all pain counters: no counters means no damage",
    "players": [
      {
        "battlefield": ["Torture Chamber", "Swamp"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "activate": "Torture Chamber", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Torture Chamber"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
