   "steps": [{"cast": "Lightning Helix", "targets": ["p1"]}, {"resolve": true}, {"activate": "Lunar Convocation", "ability": 0}, {"resolve": true}, {"advance_to": "End"}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{"life": 21, "battlefield_has": ["Bat 1-1 Flying"]}, {"life": 16}]}},
