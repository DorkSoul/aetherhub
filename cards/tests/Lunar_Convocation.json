  {"name": "ruling: life gained and lost only during my end step does not create a Bat",
   "players": [{"hand": ["Healing Salve"], "battlefield": ["Lunar Convocation", "Plains", "Swamp", "Swamp"]}, {}],
   "steps": [{"advance_to": "End"}, {"cast": "Healing Salve", "targets": ["p0"], "answers": [0]}, {"resolve": true}, {"activate": "Lunar Convocation", "ability": 0}, {"resolve": true}],
   "expect": {"players": [{"life": 21, "battlefield_lacks": ["Bat 1-1 Flying"]}, {"life": 20}]}}
