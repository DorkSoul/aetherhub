[
  {
    "name": "chapter I creates a 1/1 Human Soldier",
    "players": [
      { "hand": ["The First Iroan Games"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "The First Iroan Games" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["The First Iroan Games", "Human Soldier"] },
        {}
      ],
      "counters": { "The First Iroan Games": { "lore": 1 } }
    }
  },
  {
    "name": "chapter II puts three +1/+1 counters on a creature you control",
    "players": [
      {
        "battlefield": [
          { "name": "The First Iroan Games", "counters": { "lore": 1 } },
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "counters": {
        "The First Iroan Games": { "lore": 2 },
        "Grizzly Bears": { "p1p1": 3 }
      },
      "pt": { "Grizzly Bears": [5, 5] }
    }
  },
  {
    "name": "chapter IV creates a Gold token",
    "players": [
      {
        "battlefield": [
          { "name": "The First Iroan Games", "counters": { "lore": 3 } }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Gold"] },
        {}
      ]
    }
  },
  {
    "name": "chapter III draws two cards if you control a creature with power 4 or greater",
    "players": [
      { "battlefield": [{ "name": "The First Iroan Games", "counters": { "lore": 2 } }, "Serra Angel"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 3 }, {}],
      "counters": { "The First Iroan Games": { "lore": 3 } }
    }
  },
  {
    "name": "chapter III draws nothing if your creatures all have power below 4",
    "players": [
      { "battlefield": [{ "name": "The First Iroan Games", "counters": { "lore": 2 } }, "Hill Giant"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, {}]
    }
  },
  {
    "name": "ruling: a third lore counter triggers III only; I and II do not trigger again",
    "players": [
      {
        "battlefield": [
          { "name": "The First Iroan Games", "counters": { "lore": 2 } },
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["The First Iroan Games"] },
        {}
      ],
      "counters": { "The First Iroan Games": { "lore": 3 } },
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: the Gold token is a colorless artifact",
    "players": [
      {
        "battlefield": [
          { "name": "The First Iroan Games", "counters": { "lore": 3 } }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Gold"] },
        {}
      ],
      "colors": { "Gold": [] }
    }
  },
  {
    "name": "ruling: the Saga is sacrificed once chapter IV has left the stack",
    "players": [
      {
        "battlefield": [
          { "name": "The First Iroan Games", "counters": { "lore": 3 } }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["The First Iroan Games"], "battlefield_has": ["Gold"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a chapter II ability on the stack still resolves after the Saga is destroyed",
    "players": [
      {
        "battlefield": [
          { "name": "The First Iroan Games", "counters": { "lore": 1 } },
          "Grizzly Bears"
        ]
      },
      {
        "hand": ["Disenchant"],
        "battlefield": ["Plains", "Plains"]
      }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["The First Iroan Games"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["The First Iroan Games"] },
        { "graveyard_has": ["Disenchant"] }
      ],
      "pt": { "Grizzly Bears": [5, 5] }
    }
  }
]
