[
 {
  "name": "each other creature (both sides) becomes a copy of the target creature",
  "players": [
   {
    "hand": [
     "Nanogene Conversion"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island",
     {
      "name": "Hill Giant",
      "sick": false
     },
     {
      "name": "Mulldrifter",
      "sick": false
     }
    ]
   },
   {
    "battlefield": [
     {
      "name": "Grizzly Bears",
      "sick": false
     }
    ]
   }
  ],
  "steps": [
   {
    "cast": "Nanogene Conversion",
    "targets": [
     "Hill Giant"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Hill Giant",
      "Hill Giant"
     ]
    },
    {
     "battlefield_has": [
      "Hill Giant"
     ]
    }
   ]
  }
 },
 {
  "name": "lands are not creatures and are not copied",
  "players": [
   {
    "hand": [
     "Nanogene Conversion"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island",
     {
      "name": "Hill Giant",
      "sick": false
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Nanogene Conversion",
    "targets": [
     "Hill Giant"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Hill Giant",
      "Island",
      "Island",
      "Island",
      "Island"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "the target creature stays what it was (its own copy is not affected)",
  "players": [
   {
    "hand": [
     "Nanogene Conversion"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island",
     {
      "name": "Hill Giant",
      "sick": false
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Nanogene Conversion",
    "targets": [
     "Hill Giant"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Hill Giant": [
     3,
     3
    ]
   },
   "players": [
    {
     "battlefield_has": [
      "Hill Giant"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: the copies revert at the end of the turn",
  "players": [
   {"hand": ["Nanogene Conversion"], "battlefield": ["Island", "Island", "Island", "Island", {"name": "Hill Giant", "sick": false}, {"name": "Mulldrifter", "sick": false}]},
   {"battlefield": [{"name": "Grizzly Bears", "sick": false}]}
  ],
  "steps": [
   {"cast": "Nanogene Conversion", "targets": ["Hill Giant"]},
   {"resolve": true},
   {"advance_to": "Main1"}
  ],
  "expect": {
   "players": [{"battlefield_has": ["Hill Giant", "Mulldrifter"]}, {"battlefield_has": ["Grizzly Bears"]}],
   "pt": {"Mulldrifter": [2, 2], "Hill Giant": [3, 3], "Grizzly Bears": [2, 2]}
  }
 },
 {
  "name": "ruling: a pump from earlier in the turn still applies to the copy",
  "players": [
   {"hand": ["Nanogene Conversion", "Giant Growth"], "battlefield": ["Island", "Island", "Island", "Island", "Forest", {"name": "Grizzly Bears", "sick": false}, {"name": "Hill Giant", "sick": false}]},
   {}
  ],
  "steps": [
   {"cast": "Giant Growth", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"cast": "Nanogene Conversion", "targets": ["Hill Giant"]},
   {"resolve": true}
  ],
  "expect": {
   "players": [{"battlefield_has": ["Hill Giant", "Hill Giant"]}, {}],
   "pt": {"Hill Giant": [6, 6]}
  }
 },
 {
  "name": "ruling: copies take only the printed values, not the target's counters",
  "players": [
   {"hand": ["Nanogene Conversion"], "battlefield": ["Island", "Island", "Island", "Island", {"name": "Grizzly Bears", "sick": false}, {"name": "Hill Giant", "sick": false, "counters": {"p1p1": 1}}]},
   {}
  ],
  "steps": [
   {"cast": "Nanogene Conversion", "targets": ["Hill Giant"]},
   {"resolve": true}
  ],
  "expect": {
   "pt": {"Hill Giant": [3, 3]}
  }
 }
]