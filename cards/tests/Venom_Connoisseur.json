[
  {
    "name": "gains deathtouch when another creature you control enters",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Venom Connoisseur", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Venom Connoisseur": ["Deathtouch"] }
    }
  },
  {
    "name": "second time it resolves this turn, all creatures you control gain deathtouch",
    "players": [
      { "hand": ["Grizzly Bears", "Grizzly Bears"], "battlefield": ["Venom Connoisseur", "Hill Giant", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Venom Connoisseur": ["Deathtouch"], "Hill Giant": ["Deathtouch"] }
    }
  },
  {
    "name": "the Glyph counter from an entering creature is still there during the turn",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Venom Connoisseur", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Venom Connoisseur": { "Glyph": 1 } } }
  },
  {
    "name": "the Glyph counter is removed at the beginning of the end step",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Venom Connoisseur", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Venom Connoisseur": { "Glyph": 0 } } }
  }
]
