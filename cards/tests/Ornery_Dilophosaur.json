[
  {
    "name": "attacks alongside a creature with power 4 or greater: +2/+2 until end of turn",
    "players": [ { "battlefield": ["Ornery Dilophosaur", "Serra Angel"] }, {} ],
    "steps": [ { "attack": [ { "card": "Ornery Dilophosaur", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "pt": { "Ornery Dilophosaur": [4, 4] } }
  },
  {
    "name": "no creature with power 4 or greater: no bonus",
    "players": [ { "battlefield": ["Ornery Dilophosaur", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Ornery Dilophosaur", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "pt": { "Ornery Dilophosaur": [2, 2] } }
  },
  {
    "name": "deathtouch: a 2/2 attacker kills the 3/3 blocker",
    "players": [ { "battlefield": ["Ornery Dilophosaur"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Ornery Dilophosaur", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Ornery Dilophosaur" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Ornery Dilophosaur"] }, { "graveyard_has": ["Hill Giant"] } ] }
  },
  {"name": "ruling: the bonus is +2/+2 however many creatures have power 4 or greater",
   "players": [ { "battlefield": ["Ornery Dilophosaur", "Serra Angel", "Serra Angel"] }, {} ],
   "steps": [ { "attack": [ { "card": "Ornery Dilophosaur", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "pt": { "Ornery Dilophosaur": [4, 4] } }
  },
  {"name": "ruling: power raised to 4 by anthems still triggers the attack bonus",
   "players": [ { "battlefield": ["Ornery Dilophosaur", "Glorious Anthem", "Glorious Anthem"] }, {} ],
   "steps": [ { "attack": [ { "card": "Ornery Dilophosaur", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "pt": { "Ornery Dilophosaur": [6, 6] } }
  }
]
