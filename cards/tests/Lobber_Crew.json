[
  {
    "name": "tap ability deals 1 damage to each opponent",
    "players": [
      {
        "battlefield": [
          "Lobber Crew"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lobber Crew",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 19
        }
      ],
      "tapped": {
        "Lobber Crew": true
      }
    }
  },
  {
    "name": "casting a multicolored spell untaps it",
    "players": [
      {
        "hand": [
          "Lightning Helix"
        ],
        "battlefield": [
          "Lobber Crew",
          "Mountain",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lobber Crew",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Helix",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 23
        },
        {
          "life": 16
        }
      ],
      "tapped": {
        "Lobber Crew": false
      }
    }
  },
  {
    "name": "casting a monocolored spell does not untap it",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Lobber Crew",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lobber Crew",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 16
        }
      ],
      "tapped": {
        "Lobber Crew": true
      }
    }
  },
  {
    "name": "ruling: the Crew untaps before the multicolored spell resolves, so it can tap again in response",
    "players": [
      { "hand": ["Lightning Helix"], "battlefield": [{ "name": "Lobber Crew", "tapped": true }, "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Helix", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "activate": "Lobber Crew", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 23 }, { "life": 16 } ],
      "tapped": { "Lobber Crew": true }
    }
  },
  {
    "name": "ruling: a hybrid spell is multicolored, so casting it in one colour still untaps the Crew",
    "players": [
      { "hand": ["Boros Recruit"], "battlefield": [{ "name": "Lobber Crew", "tapped": true }, "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Boros Recruit" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Boros Recruit"] }, {} ],
      "tapped": { "Lobber Crew": false }
    }
  }
]
