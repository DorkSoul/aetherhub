[
  { "name": "casting a noncreature spell puts an oil counter on it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Trawler Drake", "counters": { "oil": 1 } }] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "pt": { "Trawler Drake": [2, 2] }, "counters": { "Trawler Drake": { "oil": 2 } } } },
  { "name": "casting a creature spell does not add an oil counter",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", { "name": "Trawler Drake", "counters": { "oil": 1 } }] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "counters": { "Trawler Drake": { "oil": 1 } }, "pt": { "Trawler Drake": [1, 1] } } },
  { "name": "enters with an oil counter: a 1/1 on arrival, not a 0/0 that dies",
    "players": [ { "hand": ["Trawler Drake"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Trawler Drake" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Trawler Drake"] }, {} ], "pt": { "Trawler Drake": [1, 1] }, "counters": { "Trawler Drake": { "oil": 1 } } } }
]
