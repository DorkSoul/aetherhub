[
  {
    "name": "destroys target artifact or land",
    "players": [
      {
        "hand": [
          "Volcanic Submersion"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Volcanic Submersion",
        "targets": [
          "Island"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Volcanic Submersion"
          ]
        },
        {
          "graveyard": [
            "Island"
          ]
        }
      ]
    }
  },
  {
    "name": "cycling for 2 draws a card",
    "players": [
      {
        "hand": [
          "Volcanic Submersion"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Volcanic Submersion",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "graveyard": [
            "Volcanic Submersion"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Stifle can counter the cycling ability",
    "players": [
      { "hand": ["Volcanic Submersion"], "battlefield": ["Island", "Island"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Volcanic Submersion", "ability": 0 },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Volcanic Submersion" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Volcanic Submersion"] },
        { "graveyard": ["Stifle"] }
      ]
    }
  },
  {
    "name": "ruling: Counterspell cannot target cycling; the cycling still draws",
    "players": [
      { "hand": ["Volcanic Submersion"], "battlefield": ["Island", "Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "activate": "Volcanic Submersion", "ability": 0 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Volcanic Submersion"] },
        { "hand": ["Counterspell"] }
      ]
    }
  }
]
