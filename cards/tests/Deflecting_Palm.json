               { "pass": true, "player": 1 },
               { "cast": "Deflecting Palm" }, { "resolve": true, "answers": ["Grizzly Bears"] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 17 }, { "life": 18 } ] } },
