[
  { "name": "flashed in during combat, its ETB removes the attacking Bears from combat (no damage to you)",
    "players": [ { "hand": ["Hollowhenge Spirit"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "pass": true, "player": 1 },
      { "cast": "Hollowhenge Spirit" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Hollowhenge Spirit"] }, { "battlefield_has": ["Grizzly Bears"] } ], "keywords": { "Hollowhenge Spirit": ["Flying", "Flash"] } } },
  { "name": "cast in your own main phase with nothing attacking or blocking: the ETB has no target and does nothing",
    "players": [ { "hand": ["Hollowhenge Spirit"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Hollowhenge Spirit" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hollowhenge Spirit"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Hollowhenge Spirit": [2, 2] } } },
  { "name": "ruling: removing a blocker leaves the attacker blocked, so it deals no damage to me",
    "players": [ { "hand": ["Hollowhenge Spirit"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "cast": "Hollowhenge Spirit" },
      { "resolve": true, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Hollowhenge Spirit", "Grizzly Bears"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: removing an attacker from combat does not untap it",
    "players": [ { "hand": ["Hollowhenge Spirit"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
      { "pass": true, "player": 1 },
      { "cast": "Hollowhenge Spirit" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20 }, { "battlefield_has": ["Hill Giant"] } ], "tapped": { "Hill Giant": true } } }
]
