[
  {
    "name": "target sorcery gains flashback for its mana cost until end of turn; it is cast and then exiled",
    "players": [
      { "hand": ["Recoup"], "graveyard": ["Lava Spike"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Recoup", "targets": ["Lava Spike"] },
      { "resolve": true },
      { "cast": "Lava Spike", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Recoup"], "exile": ["Lava Spike"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "the flashback cost is the sorcery's own mana cost: two Mountains leave nothing for Lava Spike",
    "players": [
      { "hand": ["Recoup"], "graveyard": ["Lava Spike"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Recoup", "targets": ["Lava Spike"] },
      { "resolve": true },
      { "cast": "Lava Spike", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Recoup", "Lava Spike"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "without Recoup a sorcery in the graveyard has no flashback",
    "players": [
      { "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Lava Spike"] },
      {}
    ],
    "steps": [
      { "cast": "Lava Spike", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lava Spike"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "Recoup's own flashback {3}{R} casts it from the graveyard, and then it is exiled",
    "players": [
      { "graveyard": ["Recoup", "Lava Spike"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Recoup", "targets": ["Lava Spike"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Recoup"], "graveyard": ["Lava Spike"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "three Mountains cannot pay Recoup's flashback {3}{R}; Recoup stays in the graveyard",
    "players": [
      { "graveyard": ["Recoup", "Lava Spike"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Recoup", "targets": ["Lava Spike"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Recoup", "Lava Spike"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: a flashback sorcery follows sorcery timing, so Lava Spike cannot be cast in combat",
    "players": [ { "hand": ["Recoup"], "graveyard": ["Lava Spike"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Recoup", "targets": ["Lava Spike"] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "cast": "Lava Spike", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Recoup", "Lava Spike"] }, { "life": 20 } ] }
  }
]
