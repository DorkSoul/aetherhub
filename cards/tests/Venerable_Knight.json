[
  {
    "name": "dies: +1/+1 counter on another Knight you control",
    "players": [
      { "battlefield": ["Venerable Knight", "Benalish Knight"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Venerable Knight", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Venerable Knight" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Venerable Knight"] }, {} ],
      "pt": { "Benalish Knight": [3, 3] },
      "counters": { "Benalish Knight": { "p1p1": 1 } }
    }
  },
  {
    "name": "no other Knight: the trigger has no target and does nothing",
    "players": [
      { "battlefield": ["Venerable Knight"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Venerable Knight", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Venerable Knight" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ { "graveyard": ["Venerable Knight"] }, {} ]
    }
  },
  {
    "name": "ruling: a Knight dealt lethal damage simultaneously cannot receive the counter in time",
    "players": [
      { "battlefield": ["Venerable Knight", "Benalish Knight"] },
      { "battlefield": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Venerable Knight", "at": "p1" }, { "card": "Benalish Knight", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Venerable Knight" }, { "blocker": "Hill Giant", "attacker": "Benalish Knight" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ { "graveyard": ["Venerable Knight", "Benalish Knight"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ]
    }
  }
]
