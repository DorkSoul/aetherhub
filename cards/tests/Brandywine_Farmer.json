[
  {
    "name": "enters and creates a Food token",
    "players": [
      { "hand": ["Brandywine Farmer"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Brandywine Farmer" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Brandywine Farmer", "Food"] },
        {}
      ]
    }
  },
  {
    "name": "leaving the battlefield creates another Food token",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Brandywine Farmer"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Brandywine Farmer"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Brandywine Farmer"], "battlefield_has": ["Food"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Food cannot pay for its own life ability and Maraleaf Rider's sacrifice cost at the same time",
    "players": [
      { "hand": ["Brandywine Farmer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Maraleaf Rider"] },
      {}
    ],
    "steps": [
      { "cast": "Brandywine Farmer" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Food", "ability": 0 },
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Maraleaf Rider"], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "battlefield_has": ["Brandywine Farmer", "Maraleaf Rider"], "battlefield_lacks": ["Food"] },
        {}
      ]
    }
  }
]
