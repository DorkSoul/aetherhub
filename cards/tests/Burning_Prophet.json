[
 { "name": "noncreature spell: +1/+0 until end of turn (scry 1 on trigger)",
   "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Burning Prophet"] }, {} ],
   "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Shock"] }, { "life": 18 } ], "pt": { "Burning Prophet": [2, 3] } } },
 { "name": "creature spell does not trigger Burning Prophet",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Burning Prophet"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Burning Prophet"] }, {} ], "pt": { "Burning Prophet": [1, 3] } } },
 { "name": "ruling: the trigger resolves even if the noncreature spell is countered",
   "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Burning Prophet"] }, { "hand": ["Hydroblast"], "battlefield": ["Island"] } ],
   "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "cast": "Hydroblast", "player": 1, "answers": [0], "targets": [{ "stack": "Shock" }] }, { "resolve": true, "answers": [[]] } ],
   "expect": { "players": [ { "graveyard_has": ["Shock"] }, { "life": 20, "graveyard_has": ["Hydroblast"] } ], "pt": { "Burning Prophet": [2, 3] }, "stack_empty": true } }
]
