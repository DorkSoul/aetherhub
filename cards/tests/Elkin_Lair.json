 {
  "name": "a card exiled by Elkin Lair that is not played goes to the graveyard at the end step",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Elkin Lair"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Lightning Bolt"
     ]
    },
    {
     "life": 20
    }
   ]
  },
  "start": "Untap"
 },
 {
  "name": "a land exiled by Elkin Lair can be played this turn and is not sent to the graveyard afterwards",
  "players": [
   {
    "hand": [
     "Mountain"
    ],
    "battlefield": [
     "Elkin Lair"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Main1"
   },
   {
    "play_land": "Mountain"
   },
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Mountain"
     ]
    },
    {
     "life": 20
    }
   ]
  },
  "start": "Untap"
 },
 {
  "name": "ruling: the exiled card can still be cast later in the same turn (Main2), not only in the upkeep window",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Elkin Lair", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt"] },
    { "life": 17 }
   ]
  },
  "start": "Untap"
 },
 {
  "name": "ruling (world rule): a second world enchantment entering puts the first into its owner's graveyard",
  "players": [
   { "hand": ["Elkin Lair"], "battlefield": ["Elkin Lair", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Elkin Lair" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Elkin Lair"], "graveyard_has": ["Elkin Lair"] },
    {}
   ]
  }
 },
  {
  "name": "another spell resolving during the turn does not stop the unplayed card from going to the graveyard",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Elkin Lair"] },
   { "hand": ["Time and Tide"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "pass": true },
   { "cast": "Time and Tide", "player": 1 },
   { "resolve": true },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "exile": [] }, { "graveyard": ["Time and Tide"] } ] },
  "start": "Untap"
 }
]
