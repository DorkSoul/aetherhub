    ],
    "battlefield": [
     "Elkin Lair",
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Main1"
   },
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
