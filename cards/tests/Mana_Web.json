[
 {
  "name": "tapping a Forest taps the other lands that could produce green",
  "players": [
   {
    "battlefield": [
     "Mana Web"
    ]
   },
   {
    "battlefield": [
     "Forest",
     "Taiga",
     "Mountain",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "pass": true
   },
   {
    "tap_for_mana": "Forest",
    "player": 1
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Forest": true,
    "Taiga": true,
    "Mountain": false,
    "Island": false
   }
  }
 },
 {
  "name": "tapping a Taiga (red or green) taps every land that could produce red or green",
  "players": [
   {
    "battlefield": [
     "Mana Web"
    ]
   },
   {
    "battlefield": [
     "Forest",
     "Taiga",
     "Mountain",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "pass": true
   },
   {
    "tap_for_mana": "Taiga",
    "player": 1
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Forest": true,
    "Taiga": true,
    "Mountain": true,
    "Island": false
   }
  }
 },
 {
  "name": "tapping an Island taps only lands that could produce blue",
  "players": [
   {
    "battlefield": [
     "Mana Web"
    ]
   },
   {
    "battlefield": [
     "Forest",
     "Taiga",
     "Mountain",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "pass": true
   },
   {
    "tap_for_mana": "Island",
    "player": 1
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Forest": false,
    "Taiga": false,
    "Mountain": false,
    "Island": true
   }
  }
 },
 {
  "name": "lands you control are not affected",
  "players": [
   {
    "battlefield": [
     "Mana Web",
     "Swamp",
     "Plains"
    ]
   },
   {
    "battlefield": [
     "Forest",
     "Taiga",
     "Mountain",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "tap_for_mana": "Swamp"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Swamp": true,
    "Plains": false,
    "Forest": false
   }
  }
 },
 {
  "name": "ruling: lands tapped by Mana Web make no mana (the pool holds only the Forest's G)",
  "players": [
   { "battlefield": ["Mana Web"] },
   { "battlefield": ["Forest", "Taiga", "Mountain", "Island"] }
  ],
  "steps": [
   { "pass": true },
   { "tap_for_mana": "Forest", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Forest": true, "Taiga": true, "Mountain": false, "Island": false },
   "players": [
    {},
    { "pool": { "G": 1, "R": 0, "U": 0 } }
   ]
  }
 },
 {
  "name": "ruling: tapping a Taiga for red still taps the Forest, because the Taiga's green ability counts too",
  "players": [
   { "battlefield": ["Mana Web"] },
   { "battlefield": ["Forest", "Taiga", "Mountain", "Island"] }
  ],
  "steps": [
   { "pass": true },
   { "tap_for_mana": "Taiga", "color": "R", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Forest": true, "Taiga": true, "Mountain": true, "Island": false },
   "players": [
    {},
    { "pool": { "R": 1, "G": 0 } }
   ]
  }
 },
 {
  "name": "ruling: the opponent can tap another land for mana in response to the Mana Web trigger",
  "players": [
   { "battlefield": ["Mana Web"] },
   { "battlefield": ["Forest", "Taiga", "Mountain", "Island"] }
  ],
  "steps": [
   { "pass": true },
   { "tap_for_mana": "Forest", "player": 1 },
   { "tap_for_mana": "Island", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Forest": true, "Taiga": true, "Mountain": false, "Island": true }
  }
 }
]