[
  {
    "name": "pays cumulative upkeep with one age counter",
    "players": [
      {
        "battlefield": [
          "Soldevi Simulacrum",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "counters": {
        "Soldevi Simulacrum": {
          "age": 1
        }
      },
      "players": [
        {
          "battlefield_has": [
            "Soldevi Simulacrum"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "cannot pay: sacrificed",
    "players": [
      {
        "battlefield": [
          "Soldevi Simulacrum"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Soldevi Simulacrum"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "{1}: gets +1/+0",
    "players": [
      {
        "battlefield": [
          "Soldevi Simulacrum",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Soldevi Simulacrum",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Soldevi Simulacrum": [
          3,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: with three age counters the next upkeep adds a fourth and {4} is paid",
    "players": [ { "battlefield": [ { "name": "Soldevi Simulacrum", "counters": { "age": 3 } }, "Island", "Island", "Island", "Island" ] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Soldevi Simulacrum": { "age": 4 } },
      "players": [ { "battlefield_has": ["Soldevi Simulacrum"] }, {} ]
    }
  },
  {
    "name": "ruling: no partial payment: three Islands cannot pay {4}, so it is sacrificed",
    "players": [ { "battlefield": [ { "name": "Soldevi Simulacrum", "counters": { "age": 3 } }, "Island", "Island", "Island" ] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Soldevi Simulacrum"] }, {} ] }
  },
  {
    "name": "ruling: paying is optional: declining sacrifices it even with {4} available",
    "players": [ { "battlefield": [ { "name": "Soldevi Simulacrum", "counters": { "age": 3 } }, "Island", "Island", "Island", "Island" ] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": { "players": [ { "graveyard_has": ["Soldevi Simulacrum"] }, {} ] }
  }
]
