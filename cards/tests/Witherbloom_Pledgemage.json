[
  {
    "name": "casting an instant gains you 1 life",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Witherbloom Pledgemage", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 21 }, { "life": 17 }]
    }
  },
  {
    "name": "casting a creature spell does not trigger magecraft",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", { "name": "Witherbloom Pledgemage", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 20, "battlefield_has": ["Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "ruling: magecraft also fires for an Archmage Emeritus draw when an instant is cast",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Witherbloom Pledgemage", "sick": false }, { "name": "Archmage Emeritus", "sick": false }], "library": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 21, "hand_count": 1 }, { "life": 17 }]
    }
  }
]
