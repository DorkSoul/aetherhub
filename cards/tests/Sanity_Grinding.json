[
  {
    "name": "mills the opponent once per blue mana symbol among the top ten cards",
    "players": [
      {
        "hand": ["Sanity Grinding"],
        "battlefield": ["Island", "Island", "Island"],
        "library": ["Air Elemental", "Lightning Bolt", "Opt", "Grizzly Bears", "Hill Giant", "Llanowar Elves", "Serra Angel", "Mind Stone", "Mox Opal", "Shivan Dragon"]
      },
      {
        "library": ["Lightning Bolt", "Grizzly Bears", "Hill Giant", "Llanowar Elves"]
      }
    ],
    "steps": [
      { "cast": "Sanity Grinding" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 10 },
        { "graveyard": ["Lightning Bolt", "Grizzly Bears", "Hill Giant"], "library_count": 1 }
      ]
    }
  },
  {
    "name": "no blue symbols among the top ten: nothing is milled",
    "players": [
      {
        "hand": ["Sanity Grinding"],
        "battlefield": ["Island", "Island", "Island"],
        "library": ["Lightning Bolt", "Grizzly Bears", "Hill Giant", "Llanowar Elves", "Serra Angel", "Mind Stone", "Mox Opal", "Shivan Dragon"]
      },
      {
        "library": ["Lightning Bolt"]
      }
    ],
    "steps": [
      { "cast": "Sanity Grinding" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 8 },
        { "graveyard": [], "library_count": 1 }
      ]
    }
  },
  {
    "name": "ruling: with fewer than ten cards, all of them are revealed and the opponent mills once per blue symbol",
    "players": [
      {
        "hand": ["Sanity Grinding"],
        "battlefield": ["Island", "Island", "Island"],
        "library": ["Air Elemental", "Grizzly Bears", "Opt"]
      },
      {
        "library": ["Lightning Bolt", "Grizzly Bears", "Hill Giant", "Llanowar Elves"]
      }
    ],
    "steps": [
      { "cast": "Sanity Grinding" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 3 },
        { "graveyard": ["Lightning Bolt", "Grizzly Bears", "Hill Giant"], "library_count": 1 }
      ]
    }
  },
  {
    "name": "ruling: chroma counts only mana costs, so the blue symbol in an Island's text is not counted",
    "players": [
      {
        "hand": ["Sanity Grinding"],
        "battlefield": ["Island", "Island", "Island"],
        "library": ["Island", "Grizzly Bears", "Hill Giant"]
      },
      {
        "library": ["Lightning Bolt"]
      }
    ],
    "steps": [
      { "cast": "Sanity Grinding" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 3 },
        { "graveyard": [], "library_count": 1 }
      ]
    }
  }
]
