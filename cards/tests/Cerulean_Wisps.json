[
  {
    "name": "untaps the target creature and draws a card",
    "players": [
      { "hand": ["Cerulean Wisps"], "battlefield": ["Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Cerulean Wisps", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "needs a creature target",
    "players": [
      { "hand": ["Cerulean Wisps"], "battlefield": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Cerulean Wisps", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Cerulean Wisps"] }, {} ]
    }
  },
  {
    "name": "ruling: the target becomes only blue, losing its old black",
    "players": [
      { "hand": ["Cerulean Wisps"], "battlefield": ["Island"] },
      { "battlefield": ["Vampire Nighthawk"] }
    ],
    "steps": [
      { "cast": "Cerulean Wisps", "targets": ["p1:Vampire Nighthawk"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "battlefield_has": ["Vampire Nighthawk"] } ],
      "colors": { "Vampire Nighthawk": ["U"] }
    }
  },
  {
    "name": "ruling: a colorless creature becomes blue only (colorless is not a color)",
    "players": [
      { "hand": ["Cerulean Wisps"], "battlefield": ["Island"] },
      { "battlefield": ["Ornithopter"] }
    ],
    "steps": [
      { "cast": "Cerulean Wisps", "targets": ["p1:Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "battlefield_has": ["Ornithopter"] } ],
      "colors": { "Ornithopter": ["U"] }
    }
  }
]
