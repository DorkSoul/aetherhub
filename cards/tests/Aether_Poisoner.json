[
  {
    "name": "enters: two energy, deathtouch",
    "players": [ { "hand": ["Aether Poisoner"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Aether Poisoner" }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 2 }, {} ], "keywords": { "Aether Poisoner": ["Deathtouch"] } }
  },
  {
    "name": "attack: declining the payment makes no Servo",
    "players": [ { "hand": ["Aether Poisoner"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Aether Poisoner" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Aether Poisoner", "at": "p1" } ] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ { "energy": 2, "battlefield_lacks": ["Servo"] }, {} ] }
  },
  {
    "name": "ruling: paying EE on attack makes one Servo and spends exactly two energy",
    "players": [ { "energy": 4, "battlefield": ["Aether Poisoner"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Aether Poisoner", "at": "p1" } ] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ { "energy": 2, "battlefield_has": ["Servo"] }, {} ] }
  },
  {
    "name": "ruling: with only one energy the attack payment is not possible",
    "players": [ { "energy": 1, "battlefield": ["Aether Poisoner"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Aether Poisoner", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 1, "battlefield_lacks": ["Servo"] }, {} ] }
  },
  {
    "name": "ruling: energy counters stay with the player when the turn ends",
    "players": [ { "energy": 2, "battlefield": ["Aether Poisoner"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "energy": 2 }, {} ] }
  },
  {
    "name": "ruling: energy is not tied to the permanent; it stays when Aether Poisoner dies",
    "players": [ { "hand": ["Lightning Bolt"], "energy": 2, "battlefield": ["Mountain", "Aether Poisoner"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Aether Poisoner"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 2, "graveyard": ["Aether Poisoner", "Lightning Bolt"] }, {} ] }
  }
]
