[
  {
    "name": "returns two target creatures to their owners' hands",
    "players": [
      { "hand": ["Step Through"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Step Through", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Step Through"] }, { "hand": ["Grizzly Bears", "Hill Giant"] } ]
    }
  },
  {
    "name": "wizardcycling {2}: search for a Wizard card and put it into your hand",
