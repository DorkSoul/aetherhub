      {}
    ],
    "steps": [
      { "activate": "Step Through", "ability": 0 },
      { "resolve": true, "answers": ["Benthic Biomancer"] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Step Through"], "hand": ["Benthic Biomancer"] }, {} ]
    }
  },
  {
    "name": "ruling: typecycling searches but does not draw a card",
    "players": [
      { "hand": ["Step Through"], "battlefield": ["Island", "Island"], "library": ["Benthic Biomancer"] },
      {}
    ],
    "steps": [
      { "activate": "Step Through", "ability": 0 },
      { "resolve": true, "answers": ["Benthic Biomancer"] }
    ],
    "expect": {
      "players": [ { "hand": ["Benthic Biomancer"], "library_count": 20 }, {} ]
    }
  },
  {
    "name": "ruling: a trigger on cycling also triggers on typecycling",
    "players": [
      { "hand": ["Step Through"], "battlefield": ["Drannith Healer", "Island", "Island"], "library": ["Benthic Biomancer"] },
      {}
    ],
    "steps": [
      { "activate": "Step Through", "ability": 0 },
      { "resolve": true, "answers": ["Benthic Biomancer"] }
    ],
    "expect": {
