[
  { "name": "leaving the battlefield draws cards equal to the opponent's hand advantage",
    "players": [ { "battlefield": ["Slithermuse"] }, { "hand": ["Lightning Bolt", "Grizzly Bears", "Hill Giant"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Slithermuse"] },
      { "resolve": true, "auto": true }
    ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Slithermuse"] }, { "hand_count": 2 } ] } },
  { "name": "no draw when the opponent does not have more cards in hand",
    "players": [ { "hand": ["Grizzly Bears", "Hill Giant"], "battlefield": ["Slithermuse"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Slithermuse"] },
      { "resolve": true, "auto": true }
    ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] } },
  { "name": "evoke: sacrificed when it enters, so it leaves the battlefield",
    "players": [ { "hand": ["Slithermuse"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Slithermuse", "alt": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Slithermuse"], "battlefield_lacks": ["Slithermuse"] }, {} ] } },
  { "name": "hard cast (no evoke) stays on the battlefield",
    "players": [ { "hand": ["Slithermuse"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Slithermuse" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Slithermuse"] }, {} ] } },
  { "name": "ruling: the draw is worked out when the trigger resolves, so a spell the opponent casts in response lowers it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Slithermuse"] }, { "hand": ["Lightning Bolt", "Grizzly Bears", "Hill Giant"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Slithermuse"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Slithermuse"] }, { "hand_count": 2 } ] } }
]
