[
 {
  "name": "surveil: pay 1U to create a token copy",
  "players": [ { "hand": ["Consider"], "battlefield": ["Copy Catchers","Island","Island","Island"], "library": ["Mountain","Forest"] }, {} ],
  "steps": [
   { "cast": "Consider" },
   { "resolve": true, "answers": [[], true] }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Copy Catchers","Copy Catchers"], "hand": ["Mountain"] }, {} ]
  }
 },
 {
  "name": "surveil: declining to pay makes no copy",
  "players": [ { "hand": ["Consider"], "battlefield": ["Copy Catchers","Island","Island","Island"], "library": ["Mountain","Forest"] }, {} ],
  "steps": [
   { "cast": "Consider" },
   { "resolve": true, "answers": [[], false] }
  ],
  "expect": {
   "players": [ { "battlefield": ["Copy Catchers","Island","Island","Island"], "hand": ["Mountain"] }, {} ]
  }
 },
 {
  "name": "ruling: the token copy has the surveil trigger, so a later surveil can copy again",
  "players": [ { "hand": ["Consider","Consider"], "battlefield": ["Copy Catchers","Island","Island","Island","Island","Island","Island","Island","Island"], "library": ["Mountain","Forest"] }, {} ],
  "steps": [
   { "cast": "Consider" },
   { "resolve": true, "answers": [[], true] },
   { "cast": "Consider" },
   { "resolve": true, "answers": [[], true, true] }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Copy Catchers","Copy Catchers","Copy Catchers","Copy Catchers"], "hand": ["Forest","Mountain"], "graveyard": ["Consider","Consider"] }, {} ]
  }
 }
]
