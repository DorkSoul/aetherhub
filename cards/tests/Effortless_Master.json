[
  {
    "name": "second spell this turn: enters with two counters",
    "players": [ { "hand": ["Unsummon", "Effortless Master"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Unsummon", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Effortless Master" }, { "resolve": true } ],
    "expect": { "pt": { "Effortless Master": [6, 5] } }
  },
  {
    "name": "first spell this turn: no counters",
    "players": [ { "hand": ["Effortless Master"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Effortless Master" }, { "resolve": true } ],
    "expect": { "pt": { "Effortless Master": [4, 3] } }
  },
  {
    "name": "ruling: a countered spell still counts toward the two-spell condition",
    "players": [
      { "hand": ["Unsummon", "Effortless Master"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Unsummon", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Unsummon" }] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Effortless Master" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Effortless Master": [6, 5] } }
  }
]
