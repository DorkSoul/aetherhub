    "players": [
      { "battlefield": ["Vital Splicer", "Forest"] },
      {}
    ],
    "steps": [ { "activate": "Vital Splicer", "ability": 0, "targets": ["Vital Splicer"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vital Splicer"] }, {} ] } },
  { "name": "regenerate ability is activatable with a Golem you control",
    "players": [
      { "battlefield": ["Vital Splicer", "Lead Golem", "Forest"] },
      {}
    ],
    "steps": [ { "activate": "Vital Splicer", "ability": 0, "targets": ["Lead Golem"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Lead Golem", "Vital Splicer"] }, {} ] } }
