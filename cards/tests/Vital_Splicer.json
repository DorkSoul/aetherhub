      { "hand": ["Vital Splicer"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [ { "cast": "Vital Splicer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vital Splicer", "Phyrexian Golem 3-3"] }, {} ], "pt": { "Phyrexian Golem 3-3": [3, 3] } } },
