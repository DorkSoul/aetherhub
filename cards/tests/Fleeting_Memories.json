[
 {
  "name": "enters and investigates into a Clue",
  "players": [
   { "hand": ["Fleeting Memories"], "battlefield": ["Island", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Fleeting Memories" },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Fleeting Memories", "Clue"] },
    {}
   ]
  }
 },
 {
  "name": "sacrificing a Clue: the targeted opponent mills three cards",
  "players": [
   { "battlefield": ["Fleeting Memories", "Clue", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "activate": "Clue", "ability": 0, "targets": ["p1"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Fleeting Memories"] }, { "library_count": 17, "graveyard_has": [] } ] }
 },
 {
  "name": "sacrificing a Clue: the target player can be yourself (mills three from your own library)",
  "players": [
   { "battlefield": ["Fleeting Memories", "Clue", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "activate": "Clue", "ability": 0, "targets": ["p0"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 1, "library_count": 16 }, { "library_count": 20 } ] }
 },
 {
  "name": "ruling: the Clue's Fleeting Memories trigger resolves before the Clue's draw (self-mill first, then draw)",
  "players": [
   { "battlefield": ["Fleeting Memories", "Clue", "Island", "Island"], "library": ["Mountain", "Plains", "Swamp", "Island"] },
   {}
  ],
  "steps": [
   { "activate": "Clue", "ability": 0, "targets": ["p0"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Island"], "graveyard_has": ["Mountain", "Plains", "Swamp"] }, {} ] }
 },
 {
  "name": "ruling: any Clue artifact counts, so sacrificing a non-token Clue (Wrench) triggers the mill",
  "players": [
   { "battlefield": ["Fleeting Memories", "Wrench", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "activate": "Wrench", "ability": 0, "targets": ["p1"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Wrench"] }, { "library_count": 17, "graveyard_has": [] } ] }
 }
]
