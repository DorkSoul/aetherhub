[
  { "name": "the target artifact stays tapped through its controller's untap step while the Gremlins stay tapped",
    "players": [ { "battlefield": [{"name": "Phyrexian Gremlins", "sick": false}] }, { "battlefield": ["Dungeon Map"] } ],
    "steps": [ { "activate": "Phyrexian Gremlins", "ability": 0, "targets": ["Dungeon Map"] }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 2, "tapped": { "Dungeon Map": true, "Phyrexian Gremlins": true } } },
  { "name": "choosing to untap the Gremlins releases the artifact at its controller's next untap step",
    "players": [ { "battlefield": [{"name": "Phyrexian Gremlins", "sick": false}] }, { "battlefield": ["Dungeon Map"] } ],
    "steps": [ { "activate": "Phyrexian Gremlins", "ability": 0, "targets": ["Dungeon Map"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "tapped": { "Dungeon Map": false, "Phyrexian Gremlins": false } } },
  { "name": "choosing to keep the Gremlins tapped keeps the artifact tapped",
    "players": [ { "battlefield": [{"name": "Phyrexian Gremlins", "sick": false}] }, { "battlefield": ["Dungeon Map"] } ],
    "steps": [ { "activate": "Phyrexian Gremlins", "ability": 0, "targets": ["Dungeon Map"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "tapped": { "Dungeon Map": true, "Phyrexian Gremlins": true } } },
  { "name": "ruling: my own artifact stays tapped in my untap step while the Gremlins are still tapped, even if I untap the Gremlins",
    "players": [ { "battlefield": [{"name": "Phyrexian Gremlins", "sick": false}, "Dungeon Map"] }, {} ],
    "steps": [ { "activate": "Phyrexian Gremlins", "ability": 0, "targets": ["Dungeon Map"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
    "expect": { "turn": 3, "tapped": { "Dungeon Map": true, "Phyrexian Gremlins": false } } }
]
