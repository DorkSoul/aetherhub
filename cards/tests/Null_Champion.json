[
  {
    "name": "base 1/1 before any level",
    "players": [
      {
        "battlefield": [
          {
            "name": "Null Champion",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Null Champion": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "one level up makes it 4/2",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          {
            "name": "Null Champion",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Null Champion",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Null Champion": [
          4,
          2
        ]
      }
    }
  },
  {
    "name": "level 4: regenerate replaces destruction from a lethal Lightning Bolt",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Swamp", "Mountain", { "name": "Null Champion", "sick": false, "counters": { "Level": 4 } }] }, {} ],
    "steps": [ { "activate": "Null Champion", "ability": 1 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Null Champion"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Null Champion"] }, {} ], "pt": { "Null Champion": [7, 3] } }
  },
  {
    "name": "regenerate needs level 4: at level 3 it cannot be activated",
    "players": [ { "battlefield": ["Swamp", { "name": "Null Champion", "sick": false, "counters": { "Level": 3 } }] }, {} ],
    "steps": [ { "activate": "Null Champion", "ability": 1, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Null Champion"] }, {} ], "pt": { "Null Champion": [4, 2] } }
  },
  {
    "name": "ruling: the level comes from level counters: four level-ups make it 7/3",
    "players": [
      {
        "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", {"name": "Null Champion", "sick": false}]
      },
      {}
    ],
    "steps": [
      {"activate": "Null Champion", "ability": 0}, {"resolve": true},
      {"activate": "Null Champion", "ability": 0}, {"resolve": true},
      {"activate": "Null Champion", "ability": 0}, {"resolve": true},
      {"activate": "Null Champion", "ability": 0}, {"resolve": true}
    ],
    "expect": {"pt": {"Null Champion": [7, 3]}}
  },
  {
    "name": "ruling: a pump applied before the level-ups still applies at level 4",
    "players": [
      {
        "hand": ["Desperate Lunge"],
        "battlefield": ["Plains", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", {"name": "Null Champion", "sick": false}]
      },
      {}
    ],
    "steps": [
      {"cast": "Desperate Lunge", "targets": ["Null Champion"]}, {"resolve": true},
      {"activate": "Null Champion", "ability": 0}, {"resolve": true},
      {"activate": "Null Champion", "ability": 0}, {"resolve": true},
      {"activate": "Null Champion", "ability": 0}, {"resolve": true},
      {"activate": "Null Champion", "ability": 0}, {"resolve": true}
    ],
    "expect": {"pt": {"Null Champion": [9, 5]}}
  }
]
