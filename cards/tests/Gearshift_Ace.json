[
  {
    "name": "crewing a vehicle gives it first strike until end of turn",
    "players": [
      { "battlefield": ["Gearshift Ace", "Smuggler's Copter"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Smuggler's Copter" },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Smuggler's Copter": ["FirstStrike", "Flying"] }
    }
  },
  {
    "name": "the first strike goes to the vehicle the Ace crewed, not the other creature's crew",
    "players": [
      { "battlefield": ["Gearshift Ace", "Grizzly Bears", "Smuggler's Copter"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Smuggler's Copter" },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Smuggler's Copter": ["Flying"], "Gearshift Ace": ["FirstStrike"] }
    }
  },
  {
    "name": "ruling: the Ace is killed in response to its crew trigger and the Vehicle still gains first strike",
    "players": [
      { "battlefield": ["Gearshift Ace", "Smuggler's Copter"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Smuggler's Copter" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Gearshift Ace"], "player": 1 },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Smuggler's Copter": ["FirstStrike", "Flying"] },
      "players": [ { "graveyard": ["Gearshift Ace"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  }
]
