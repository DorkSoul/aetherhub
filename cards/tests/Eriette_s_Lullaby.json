[
  {
    "name": "destroys a tapped creature and gains 2 life",
    "players": [
      { "hand": ["Eriette's Lullaby"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Eriette's Lullaby", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "graveyard_has": ["Grizzly Bears"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "cannot target an untapped creature",
    "players": [
      { "hand": ["Eriette's Lullaby"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Eriette's Lullaby", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Eriette's Lullaby"], "life": 20 },
        {}
      ]
    }
  },
  {
    "name": "ruling: if the tapped target is gone on resolution, no life is gained",
    "players": [
      { "hand": ["Eriette's Lullaby"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Eriette's Lullaby", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Grizzly Bears", "Eriette's Lullaby"] },
        { "life": 18, "graveyard": ["Shock"] }
      ]
    }
  }
]
