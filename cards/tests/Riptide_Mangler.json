[
 {
  "name": "base power becomes the target creature's power",
  "players": [ { "battlefield": ["Riptide Mangler", "Hill Giant", "Island", "Island"] }, {} ],
  "steps": [ { "activate": "Riptide Mangler", "targets": ["Hill Giant"] }, { "resolve": true } ],
  "expect": { "pt": { "Riptide Mangler": [3, 3], "Hill Giant": [3, 3] } }
 },
 {
  "name": "toughness stays 3 when the target has a smaller power",
  "players": [ { "battlefield": ["Riptide Mangler", "Grizzly Bears", "Island", "Island"] }, {} ],
  "steps": [ { "activate": "Riptide Mangler", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "pt": { "Riptide Mangler": [2, 3] } }
 },
 {
  "name": "ruling: a pump before the activation still applies on top of the copied base power",
  "players": [ { "hand": ["Giant Growth"], "battlefield": ["Riptide Mangler", "Grizzly Bears", "Forest", "Island", "Island"] }, {} ],
  "steps": [ { "cast": "Giant Growth", "targets": ["Riptide Mangler"] }, { "resolve": true }, { "activate": "Riptide Mangler", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "pt": { "Riptide Mangler": [5, 6] } }
 },
 {
  "name": "ruling: a later activation overwrites the base power set by an earlier one",
  "players": [ { "battlefield": ["Riptide Mangler", "Hill Giant", "Grizzly Bears", "Island", "Island", "Forest", "Forest"] }, {} ],
  "steps": [ { "activate": "Riptide Mangler", "targets": ["Hill Giant"] }, { "resolve": true }, { "activate": "Riptide Mangler", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "pt": { "Riptide Mangler": [2, 3] } }
 }
]
