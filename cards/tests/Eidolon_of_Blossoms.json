  {
    "name": "ruling: two constellation triggers both resolve (two draws)",
    "players": [{"hand": ["Pacifism"], "battlefield": ["Eidolon of Blossoms", "Eidolon of Blossoms", "Plains", "Plains"]}, {"battlefield": ["Grizzly Bears"]}],
    "steps": [{"cast": "Pacifism", "targets": ["Grizzly Bears"]}, {"resolve": true}],
    "expect": {"players": [{"hand_count": 2}, {}]}
  },
  {
    "name": "ruling: Aura whose target is gone does not resolve, so no constellation draw",
    "players": [{"hand": ["Pacifism"], "battlefield": ["Eidolon of Blossoms", "Plains", "Plains"]}, {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"]}],
    "steps": [{"cast": "Pacifism", "targets": ["Grizzly Bears"]}, {"pass": true}, {"cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"]}, {"resolve": true}],
    "expect": {"players": [{"graveyard_has": ["Pacifism"], "hand_count": 0}, {"graveyard_has": ["Grizzly Bears", "Lightning Bolt"]}]}
  },
  {
    "name": "ruling: bestow Aura with illegal target becomes a creature, enters and triggers constellation",
    "players": [{"hand": ["Boon Satyr"], "battlefield": ["Eidolon of Blossoms", "Forest", "Forest", "Forest", "Forest", "Forest"]}, {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"]}],
    "steps": [{"cast": "Boon Satyr", "alt": 0, "targets": ["Grizzly Bears"]}, {"pass": true}, {"cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"]}, {"resolve": true}],
    "expect": {"players": [{"battlefield_has": ["Boon Satyr"], "hand_count": 1}, {"graveyard_has": ["Grizzly Bears", "Lightning Bolt"]}]}
  },
  {
