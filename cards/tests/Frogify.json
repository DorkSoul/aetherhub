[
  {"name": "enchanted creature becomes a 1/1 blue Frog with no abilities",
   "players": [{"hand": ["Frogify"], "battlefield": ["Island", "Island"]}, {"battlefield": ["Serra Angel"]}],
   "steps": [{"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}],
   "expect": {"pt": {"Serra Angel": [1, 1]}, "attached": {"Frogify": "Serra Angel"}, "keywords": {"Serra Angel": []}}},
  {"name": "can't enchant a player",
   "players": [{"hand": ["Frogify"], "battlefield": ["Island", "Island"]}, {}],
   "steps": [{"cast": "Frogify", "illegal": true}],
   "expect": {"players": [{"hand": ["Frogify"]}, {}]}},
  {"name": "enchanted creature is a blue Frog that is not an Angel",
   "players": [{"hand": ["Frogify"], "battlefield": ["Island", "Island"]}, {"battlefield": ["Serra Angel"]}],
   "steps": [{"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}],
   "expect": {"colors": {"Serra Angel": ["U"]}, "subtypes": {"Serra Angel": ["Frog"]}, "not_subtypes": {"Serra Angel": ["Angel"]}}},
  {"name": "enchanted creature loses flying: a ground Grizzly Bears can block it",
   "players": [{"hand": ["Frogify"], "battlefield": ["Island", "Island", "Serra Angel"]}, {"battlefield": ["Grizzly Bears"]}],
   "steps": [{"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}, {"attack": [{"card": "Serra Angel", "at": "p1"}]}, {"block": [{"blocker": "Grizzly Bears", "attacker": "Serra Angel"}], "player": 1}, {"advance_to": "Main2"}],
   "expect": {"players": [{"graveyard_has": ["Serra Angel"]}, {"life": 20, "battlefield_has": ["Grizzly Bears"]}]}},
  {"name": "ruling: a later base power/toughness effect overrides Frogify (Lignify makes it 0/4)",
   "players": [{"hand": ["Frogify", "Lignify"], "battlefield": ["Island", "Island", "Forest", "Forest"]}, {"battlefield": ["Serra Angel"]}],
   "steps": [{"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}, {"cast": "Lignify", "targets": ["Serra Angel"]}, {"resolve": true}],
   "expect": {"pt": {"Serra Angel": [0, 4]}}},
  {"name": "ruling: Frogify overwrites colors and creature types (legendary Marisi becomes a blue Frog, not a Cat Warrior)",
   "players": [{"hand": ["Frogify"], "battlefield": ["Island", "Island"]}, {"battlefield": ["Marisi, Breaker of the Coil"]}],
   "steps": [{"cast": "Frogify", "targets": ["Marisi, Breaker of the Coil"]}, {"resolve": true}],
   "expect": {"colors": {"Marisi, Breaker of the Coil": ["U"]}, "subtypes": {"Marisi, Breaker of the Coil": ["Frog"]}, "not_subtypes": {"Marisi, Breaker of the Coil": ["Cat", "Warrior"]}}},
  {"name": "ruling: a -2/-2 that started before Frogify still applies (Serra Angel dies as a 1/1 with -2/-2)",
   "players": [{"hand": ["Dead Weight", "Frogify"], "battlefield": ["Swamp", "Island", "Island"]}, {"battlefield": ["Serra Angel"]}],
   "steps": [{"cast": "Dead Weight", "targets": ["Serra Angel"]}, {"resolve": true}, {"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}],
   "expect": {"players": [{}, {"graveyard_has": ["Serra Angel"]}]}},
  {"name": "ruling: a -2/-2 that starts after Frogify also applies (Serra Angel dies)",
   "players": [{"hand": ["Dead Weight", "Frogify"], "battlefield": ["Swamp", "Island", "Island"]}, {"battlefield": ["Serra Angel"]}],
   "steps": [{"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}, {"cast": "Dead Weight", "targets": ["Serra Angel"]}, {"resolve": true}],
   "expect": {"players": [{}, {"graveyard_has": ["Serra Angel"]}]}},
  {"name": "ruling: damage already marked becomes lethal when Frogify makes the creature 1/1 (Shock then Frogify)",
   "players": [{"hand": ["Shock", "Frogify"], "battlefield": ["Mountain", "Island", "Island"]}, {"battlefield": ["Serra Angel"]}],
   "steps": [{"cast": "Shock", "targets": ["Serra Angel"]}, {"resolve": true}, {"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}],
   "expect": {"players": [{}, {"graveyard_has": ["Serra Angel"]}]}},
  {"name": "ruling: a keyword gained after Frogify is kept (Orcish Medicine grants indestructible)",
   "players": [{"hand": ["Frogify", "Orcish Medicine"], "battlefield": ["Island", "Island", "Swamp", "Swamp"]}, {"battlefield": ["Serra Angel"]}],
   "steps": [{"cast": "Frogify", "targets": ["Serra Angel"]}, {"resolve": true}, {"cast": "Orcish Medicine", "targets": ["Serra Angel"]}, {"resolve": true, "answers": [[1]]}],
   "expect": {"pt": {"Serra Angel": [1, 1]}, "keywords": {"Serra Angel": ["Indestructible"]}}}
]
