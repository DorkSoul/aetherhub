[
 { "name": "ruling: flashback follows sorcery timing, so it can't be cast on the opponent's turn",
   "players": [ { "graveyard": ["Duel Tactics"], "battlefield": ["Mountain", "Mountain"] }, { "battlefield": ["Llanowar Elves"] } ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Duel Tactics", "alt": 0, "targets": ["Llanowar Elves"], "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Duel Tactics"] }, { "battlefield_has": ["Llanowar Elves"] } ] } },
 { "name": "ruling: a flashback spell that fizzles is still exiled",
   "players": [ { "graveyard": ["Duel Tactics"], "battlefield": ["Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Llanowar Elves"] } ],
   "steps": [ { "cast": "Duel Tactics", "alt": 0, "targets": ["Llanowar Elves"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Llanowar Elves"] }, { "pass": true, "player": 1 }, { "pass": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": [], "exile": ["Duel Tactics"] }, { "graveyard_has": ["Llanowar Elves", "Lightning Bolt"] } ] } },
 { "name": "1 damage to a creature and it can't block this turn",
   "players": [ { "hand": ["Duel Tactics"], "battlefield": ["Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Duel Tactics", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Duel Tactics"] }, {} ], "keywords": { "Grizzly Bears": ["CantBlock"] } } },
 { "name": "1 damage kills a 1-toughness creature",
   "players": [ { "hand": ["Duel Tactics"], "battlefield": ["Mountain"] }, { "battlefield": ["Llanowar Elves"] } ],
   "steps": [ { "cast": "Duel Tactics", "targets": ["Llanowar Elves"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Llanowar Elves"] } ] } },
 { "name": "flashback from the graveyard for {1}{R}, then exiled",
   "players": [ { "graveyard": ["Duel Tactics"], "battlefield": ["Mountain", "Mountain"] }, { "battlefield": ["Llanowar Elves"] } ],
   "steps": [ { "cast": "Duel Tactics", "alt": 0, "targets": ["Llanowar Elves"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": [], "exile": ["Duel Tactics"] }, { "graveyard": ["Llanowar Elves"] } ] } }
]
