[
 { "name": "{U},{T} puts an eon counter on it",
   "players": [ { "battlefield": ["Magosi, the Waterveil", "Island"] }, {} ],
   "steps": [ { "activate": "Magosi, the Waterveil", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Magosi, the Waterveil"] }, {} ], "counters": { "Magosi, the Waterveil": { "eon": 1 } }, "tapped": { "Magosi, the Waterveil": true } } },
 { "name": "returning it to hand removes the counter and takes an extra turn",
   "players": [ { "battlefield": [{ "name": "Magosi, the Waterveil", "counters": { "eon": 1 } }] }, {} ],
   "steps": [ { "activate": "Magosi, the Waterveil", "ability": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Magosi, the Waterveil"] }, {} ] } },
 { "name": "the return ability needs an eon counter",
   "players": [ { "battlefield": ["Magosi, the Waterveil"] }, {} ],
   "steps": [ { "activate": "Magosi, the Waterveil", "ability": 1, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Magosi, the Waterveil"] }, {} ] } },
 { "name": "enters tapped when played",
   "players": [ { "hand": ["Magosi, the Waterveil"] }, {} ],
   "steps": [ { "play_land": "Magosi, the Waterveil" } ],
   "expect": { "players": [ { "battlefield_has": ["Magosi, the Waterveil"] }, {} ], "tapped": { "Magosi, the Waterveil": true } } },
 { "name": "ruling: with several eon counters the return still just puts Magosi in hand",
   "players": [ { "battlefield": [{ "name": "Magosi, the Waterveil", "counters": { "eon": 2 } }] }, {} ],
   "steps": [ { "activate": "Magosi, the Waterveil", "ability": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Magosi, the Waterveil"], "battlefield_lacks": ["Magosi, the Waterveil"] }, {} ] } },
 { "name": "ruling: the skipped turn still happens after Magosi left the battlefield in response",
   "players": [ { "hand": ["Boomerang"], "battlefield": ["Magosi, the Waterveil", "Island", "Island", "Island"] }, {} ],
   "steps": [
     { "activate": "Magosi, the Waterveil", "ability": 0 },
     { "cast": "Boomerang", "targets": ["Magosi, the Waterveil"] },
     { "pass": true },
     { "pass": true },
     { "resolve": true },
     { "advance_to": "Main1" },
     { "advance_to": "Main1" },
     { "advance_to": "Main1" }
   ],
   "expect": { "turn": 4, "players": [ { "hand_count": 2, "battlefield_lacks": ["Magosi, the Waterveil"], "graveyard_has": ["Boomerang"] }, {} ] } }
