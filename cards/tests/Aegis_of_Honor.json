[
 { "name": "activated Aegis redirects the next instant's damage to its caster",
   "players": [ { "battlefield": ["Aegis of Honor", "Plains"] },
                { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
   "steps": [ { "activate": "Aegis of Honor" },
              { "resolve": true },
              { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
 { "name": "only the next instant is redirected; a second Shock hits its target",
   "players": [ { "battlefield": ["Aegis of Honor", "Plains", "Plains"] },
                { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] } ],
   "steps": [ { "activate": "Aegis of Honor" },
              { "resolve": true },
              { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true },
              { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 18 }, { "life": 18 } ] } },
 { "name": "without activating Aegis, Shock damage hits its target",
   "players": [ { "battlefield": ["Aegis of Honor"] },
                { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 18 }, { "life": 20 } ] } }
]
