[
  {
    "name": "channel from hand destroys a creature with flying",
    "players": [
      { "hand": ["Bamboo Grove Archer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "activate": "Bamboo Grove Archer", "ability": 0, "targets": ["p1:Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Bamboo Grove Archer"] }, { "graveyard": ["Serra Angel"] } ]
    }
  },
  {
    "name": "no channel activation without a creature with flying to target",
    "players": [
      { "hand": ["Bamboo Grove Archer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Bamboo Grove Archer", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Bamboo Grove Archer"] }, {} ]
    }
  },
  {
    "name": "ruling: discarding the card is part of the channel cost, so it is in the graveyard while the ability is on the stack",
    "players": [
      { "hand": ["Bamboo Grove Archer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "activate": "Bamboo Grove Archer", "ability": 0, "targets": ["p1:Serra Angel"] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Bamboo Grove Archer"] }, { "battlefield_has": ["Serra Angel"] } ]
    }
  },
  {
    "name": "ruling: a channel ability needing a target cannot be activated just to discard the card when no legal target exists",
    "players": [
      { "hand": ["Bamboo Grove Archer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Bamboo Grove Archer", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Bamboo Grove Archer"] }, {} ]
    }
  }
]
