[
  { "name": "{2}{W}, {Q}: +0/+2 until end of turn and untaps itself",
    "players": [ { "battlefield": [{ "name": "Safehold Sentry", "tapped": true }, "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Safehold Sentry" }, { "resolve": true } ],
    "expect": { "pt": { "Safehold Sentry": [2, 4] }, "tapped": { "Safehold Sentry": false } } },
  { "name": "an untapped creature cannot pay {Q}",
    "players": [ { "battlefield": ["Safehold Sentry", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Safehold Sentry", "illegal": true } ],
    "expect": { "pt": { "Safehold Sentry": [2, 2] } } },
  { "name": "ruling: a summoning-sick creature cannot pay {Q} even when tapped",
    "players": [ { "battlefield": [{ "name": "Safehold Sentry", "tapped": true, "sick": true }, "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Safehold Sentry", "illegal": true } ],
    "expect": { "pt": { "Safehold Sentry": [2, 2] }, "tapped": { "Safehold Sentry": true } } },
  { "name": "ruling: the untap is a cost, so the Sentry is untapped while its ability is on the stack",
    "players": [ { "battlefield": [{ "name": "Safehold Sentry", "tapped": true }, "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Safehold Sentry" } ],
    "expect": { "stack_empty": false, "pt": { "Safehold Sentry": [2, 2] }, "tapped": { "Safehold Sentry": false } } }
]
