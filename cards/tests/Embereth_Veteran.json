[
  {
    "name": "pay 1 and sacrifice: Young Hero Role attaches to another creature",
    "players": [
      {
        "battlefield": [
          "Embereth Veteran",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Embereth Veteran"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears"
          ],
          "battlefield_lacks": [
            "Embereth Veteran"
          ],
          "graveyard": [
            "Embereth Veteran"
          ]
        },
        {}
      ],
      "attached": {
        "Young Hero Role": "Grizzly Bears"
      },
      "pt": {
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "no other creature to enchant: the ability is not legal",
    "players": [
      {
        "battlefield": [
          "Embereth Veteran",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Embereth Veteran",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Embereth Veteran"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: if the target is gone when the ability resolves, no Role token is created",
    "players": [
      { "battlefield": ["Embereth Veteran", "Mountain", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Embereth Veteran" },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Embereth Veteran", "Grizzly Bears"], "battlefield_lacks": ["Young Hero Role"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
