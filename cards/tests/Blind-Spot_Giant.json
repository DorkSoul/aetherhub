[
  {
    "name": "can attack when you control another Giant",
    "players": [
      {
        "battlefield": [
          {
            "name": "Blind-Spot Giant",
            "sick": false
          },
          {
            "name": "Hill Giant",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Blind-Spot Giant",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 16
        }
      ]
    }
  },
  {
    "name": "alone: Blind-Spot Giant's attack is dropped, the other attacker still hits",
    "players": [
      {
        "battlefield": [
          { "name": "Blind-Spot Giant", "sick": false },
          { "name": "Grizzly Bears", "sick": false }
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          { "card": "Blind-Spot Giant", "at": "p1" },
          { "card": "Grizzly Bears", "at": "p1" }
        ]
      },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "alone: Blind-Spot Giant can't block; the opponent's unblocked attacker hits",
    "players": [
      { "battlefield": ["Blind-Spot Giant", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant", "Savannah Lions"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      {
        "attack": [
          { "card": "Hill Giant", "at": "p0" },
          { "card": "Savannah Lions", "at": "p0" }
        ],
        "player": 1
      },
      {
        "block": [
          { "blocker": "Blind-Spot Giant", "attacker": "Hill Giant" },
          { "blocker": "Grizzly Bears", "attacker": "Savannah Lions" }
        ],
        "player": 0
      },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 17 }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: an attacking Giant keeps attacking after the other Giant leaves",
    "players": [
      { "battlefield": [ { "name": "Blind-Spot Giant", "sick": false }, { "name": "Hill Giant", "sick": false } ] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "attack": [ { "card": "Blind-Spot Giant", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"], "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Hill Giant"], "battlefield_has": ["Blind-Spot Giant"] }, { "life": 16, "graveyard": ["Lightning Bolt"] } ]
    }
  }
]
