[
  {
    "name": "cycling {2}: discard to draw a card",
    "players": [
      {
        "hand": [
          "Disciple of Grace"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Disciple of Grace"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "graveyard_has": [
            "Disciple of Grace"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "protection from black: black spell cannot target it",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Disciple of Grace"
        ]
      },
      {
        "hand": [
          "Terror"
        ],
        "battlefield": [
          "Swamp",
          "Swamp"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Terror",
        "player": 1,
        "targets": [
          "Disciple of Grace"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Disciple of Grace"
          ]
        },
        {
          "hand": [
            "Terror"
          ]
        }
      ]
    }
  },
  {
    "name": "cycling is an activated ability: Stifle counters it, so no card is drawn",
    "players": [
      {
        "hand": ["Disciple of Grace"],
        "battlefield": ["Plains", "Plains"]
      },
      {
        "hand": ["Stifle"],
        "battlefield": ["Island"]
      }
    ],
    "steps": [
      { "activate": "Disciple of Grace" },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Disciple of Grace" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Disciple of Grace"] },
        { "graveyard": ["Stifle"] }
      ]
    }
  },
  {
    "name": "ruling: cycling is an ability, not a spell, so Remove Soul cannot counter it and the card is still drawn",
    "players": [
      {
        "hand": ["Disciple of Grace"],
        "battlefield": ["Plains", "Plains"]
      },
      {
        "hand": ["Remove Soul"],
        "battlefield": ["Island", "Island"]
      }
    ],
    "steps": [
      { "activate": "Disciple of Grace" },
      { "pass": true },
      { "cast": "Remove Soul", "player": 1, "targets": [{ "stack": "Disciple of Grace" }], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard_has": ["Disciple of Grace"] },
        { "hand": ["Remove Soul"] }
      ]
    }
  }
]
