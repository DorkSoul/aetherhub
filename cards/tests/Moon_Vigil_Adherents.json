[
  { "name": "alone it is a 1/1",
    "players": [ { "hand": ["Moon-Vigil Adherents"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Moon-Vigil Adherents" }, { "resolve": true } ],
    "expect": { "pt": { "Moon-Vigil Adherents": [1, 1] } } },
  { "name": "counts creatures you control and creature cards in your graveyard",
    "players": [ { "hand": ["Moon-Vigil Adherents"], "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "sick": false }], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Moon-Vigil Adherents" }, { "resolve": true } ],
    "expect": { "pt": { "Moon-Vigil Adherents": [3, 3] } } },
  { "name": "ruling: marked damage becomes lethal when the creature count drops",
    "players": [ { "battlefield": ["Island", "Moon-Vigil Adherents", "Grizzly Bears"], "hand": ["Unsummon"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [
      { "attack": [ { "card": "Moon-Vigil Adherents", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Moon-Vigil Adherents" } ] },
      { "advance_to": "Main2" },
      { "cast": "Unsummon", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Moon-Vigil Adherents", "Unsummon"] }, {} ] } },
  { "name": "ruling: without the count dropping, the same marked damage is not lethal",
    "players": [ { "battlefield": ["Island", "Moon-Vigil Adherents", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [
      { "attack": [ { "card": "Moon-Vigil Adherents", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Moon-Vigil Adherents" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Moon-Vigil Adherents"] }, {} ], "pt": { "Moon-Vigil Adherents": [2, 2] } } }
]
