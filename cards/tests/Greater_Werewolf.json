    "players": [
      { "battlefield": ["Greater Werewolf"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Greater Werewolf", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
