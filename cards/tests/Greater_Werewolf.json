    ],
    "steps": [
      { "attack": [ { "card": "Greater Werewolf", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Greater Werewolf" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Greater Werewolf": [2, 4], "Savannah Lions": [2, 1] } } },
