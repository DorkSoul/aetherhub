[
  {
    "name": "destroys a basic land and stays tapped",
    "players": [
      { "battlefield": ["Helldozer", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "activate": "Helldozer", "targets": ["p1:Forest"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "graveyard_has": ["Forest"] } ], "tapped": { "Helldozer": true } }
  },
  {
    "name": "destroying a nonbasic land untaps it",
    "players": [
      { "battlefield": ["Helldozer", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Badlands"] }
    ],
    "steps": [
      { "activate": "Helldozer", "targets": ["p1:Badlands"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "graveyard_has": ["Badlands"] } ], "tapped": { "Helldozer": false } }
  }
]
