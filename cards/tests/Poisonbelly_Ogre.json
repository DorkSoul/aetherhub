[
  {
    "name": "controller loses 1 life when another creature enters",
    "players": [{ "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Poisonbelly Ogre"] }, {}],
    "steps": [{ "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true }],
    "expect": { "players": [{ "life": 19, "battlefield_has": ["Grizzly Bears"] }, {}] }
  },
  {
    "name": "the Ogre itself entering does not trigger it",
    "players": [{ "hand": ["Poisonbelly Ogre"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {}],
    "steps": [{ "cast": "Poisonbelly Ogre" }, { "resolve": true }],
    "expect": { "players": [{ "life": 20, "battlefield_has": ["Poisonbelly Ogre"] }, {}] }
  },
  {
    "name": "ruling: the opponent's creature entering makes its controller (the opponent) lose 1 life",
    "players": [{ "battlefield": ["Poisonbelly Ogre"] }, { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }],
    "steps": [{ "advance_to": "Main1" }, { "cast": "Grizzly Bears", "player": 1 }, { "resolve": true }, { "resolve": true }],
    "expect": { "players": [{ "life": 20 }, { "life": 19, "battlefield_has": ["Grizzly Bears"] }] }
  }
]
