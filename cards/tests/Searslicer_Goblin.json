  {
    "name": "ruling: raid checks the whole turn, so a Goblin cast after the attack still makes a token",
    "players": [
      { "hand": ["Searslicer Goblin"], "battlefield": ["Grizzly Bears", "Mountain", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" },
      { "cast": "Searslicer Goblin" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Searslicer Goblin", "Goblin", "Grizzly Bears"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: the attacker can die in combat and raid still makes a token",
    "players": [
      { "battlefield": ["Searslicer Goblin", "Grizzly Bears"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Serra Angel", "attacker": "Grizzly Bears" }], "player": 1 },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Searslicer Goblin", "Goblin"], "battlefield_lacks": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: attacking with several creatures still makes just one token",
    "players": [
      { "battlefield": ["Searslicer Goblin", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Searslicer Goblin", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [], "player": 1 },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Searslicer Goblin", "Grizzly Bears", "Goblin"] },
        { "life": 16 }
      ]
    }
  }
]