[
  {
    "name": "{U}: returns enchanted creature and the Aura to hand",
    "players": [ { "hand": ["Disappear"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Disappear", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Disappear" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Disappear"] }, { "hand": ["Grizzly Bears"] } ] }
  },
  {
    "name": "Aura on the battlefield stays attached until the ability is used",
    "players": [ { "hand": ["Disappear"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Disappear", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Disappear"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  }
]
