    "hand": ["Forest", "Forest", "Forest"],
    "battlefield": ["Song of Creation", "Song of Creation"]
   },
   {}
  ],
  "steps": [
   { "play_land": "Forest" },
   { "play_land": "Forest" },
   { "play_land": "Forest" }
  ],
  "expect": {
