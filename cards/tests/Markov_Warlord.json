      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Silver Knight" } ], "player": 1, "illegal": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Markov Warlord" } ], "player": 1, "illegal": true },
