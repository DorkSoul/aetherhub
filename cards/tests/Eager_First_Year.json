[
  { "name": "casting an instant gives +1/+0 until end of turn",
    "players": [ { "hand": ["Opt"], "battlefield": ["Island", "Island", "Eager First-Year"] }, {} ],
    "steps": [ { "cast": "Opt" }, { "resolve": true } ],
    "expect": { "pt": { "Eager First-Year": [3, 2] } } },
  { "name": "casting a creature spell does not trigger magecraft",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Eager First-Year"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Eager First-Year": [2, 2] } } },
  { "name": "opponent casting an instant does not trigger it",
    "players": [ { "battlefield": ["Eager First-Year"] }, { "hand": ["Opt"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "pass": true }, { "cast": "Opt", "player": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Eager First-Year": [2, 2] } } },
  { "name": "ruling: a copy of an instant triggers magecraft (cast, cast and copy give +3/+0)",
    "players": [ { "hand": ["Opt", "Twincast"], "battlefield": ["Island", "Island", "Island", "Eager First-Year"] }, {} ],
    "steps": [ { "cast": "Opt" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Twincast" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "pt": { "Eager First-Year": [5, 2] } } }
]
