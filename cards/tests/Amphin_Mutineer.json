[
  { "name": "exiles the target and its controller creates a 4/3 Salamander Warrior",
    "players": [ { "hand": ["Amphin Mutineer"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Amphin Mutineer" }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
    "expect": { "players": [
      { "battlefield_has": ["Amphin Mutineer"] },
      { "battlefield_has": ["Salamander Warrior 4-3"], "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"] }
    ] }
  },
  { "name": "a Salamander can't be the target of the enters trigger",
    "players": [ { "hand": ["Amphin Mutineer"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Pyric Salamander"] } ],
    "steps": [ { "cast": "Amphin Mutineer" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Amphin Mutineer"] }, { "battlefield": ["Pyric Salamander"] } ] }
  },
  { "name": "encore from the graveyard creates a hasty token copy that is sacrificed at end step",
    "players": [ { "graveyard": ["Amphin Mutineer"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Amphin Mutineer", "ability": 0 }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Amphin Mutineer"], "exile": ["Amphin Mutineer"] }, {} ] }
  },
  { "name": "ruling: the encore token copies only the printed card (the +1/+1 counter Amphin had is not copied)",
    "players": [
      { "battlefield": [ { "name": "Amphin Mutineer", "counters": { "p1p1": 1 } }, "Island", "Island", "Island", "Island", "Island", "Island" ] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"] }
    ],
    "steps": [ { "pass": true }, { "player": 1, "cast": "Murder", "targets": ["Amphin Mutineer"] }, { "resolve": true }, { "activate": "Amphin Mutineer", "ability": 0 }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
    "expect": { "players": [ { "battlefield_has": ["Amphin Mutineer"] }, { "battlefield_has": ["Salamander Warrior 4-3"], "battlefield_lacks": ["Grizzly Bears"] } ], "pt": { "Amphin Mutineer": [3, 3] } }
  }
]
