[
  {
    "name": "{2}{W}: puts target nontoken Mercenary on the bottom of its owner's library",
    "players": [{ "battlefield": ["Mercenary Informer", "Plains", "Plains", "Plains"] }, {}],
    "steps": [{ "activate": "Mercenary Informer", "ability": 0, "targets": ["Mercenary Informer"] }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_lacks": ["Mercenary Informer"], "library_count": 21 }, {}] }
  },
  {
    "name": "cannot activate with only two mana",
    "players": [{ "battlefield": ["Mercenary Informer", "Plains", "Plains"] }, {}],
    "steps": [{ "activate": "Mercenary Informer", "ability": 0, "targets": ["Mercenary Informer"], "illegal": true }],
    "expect": { "players": [{ "battlefield_has": ["Mercenary Informer"] }, {}] }
  },
  { "name": "black spell cannot target it (no other creature to target)",
    "players": [{ "battlefield": ["Mercenary Informer"] }, { "hand": ["Disfigure"], "battlefield": ["Swamp"] }],
    "steps": [{ "pass": true }, { "cast": "Disfigure", "player": 1, "targets": ["Mercenary Informer"], "illegal": true }],
    "expect": { "players": [{ "battlefield_has": ["Mercenary Informer"] }, {}] }
  },
  { "name": "red spell can still target it",
    "players": [{ "battlefield": ["Mercenary Informer"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }],
    "steps": [{ "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Mercenary Informer"] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard_has": ["Mercenary Informer"] }, {}] }
  }
]
