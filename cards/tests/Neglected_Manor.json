    "expect": { "players": [ { "pool": { "B": 1 } } ] }
  },
  {
    "name": "ruling: an opponent at 13 life lets the Manor enter untapped (life totals of all players are checked)",
    "players": [ { "hand": ["Neglected Manor"], "life": 20 }, { "life": 13 } ],
    "steps": [ { "play_land": "Neglected Manor" } ],
    "expect": { "tapped": { "Neglected Manor": false } }
  },
  {
    "name": "ruling: the Manor's controller at 13 life alone lets it enter untapped",
    "players": [ { "hand": ["Neglected Manor"], "life": 13 }, { "life": 20 } ],
    "steps": [ { "play_land": "Neglected Manor" } ],
    "expect": { "tapped": { "Neglected Manor": false } }
  }
