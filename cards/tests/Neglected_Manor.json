[
  {
    "name": "enters tapped while every player has 14 or more life",
    "players": [ { "hand": ["Neglected Manor"] }, {} ],
    "steps": [ { "play_land": "Neglected Manor" } ],
    "expect": { "tapped": { "Neglected Manor": true } }
  },
  {
    "name": "taps for white or black",
    "players": [ { "battlefield": ["Neglected Manor"] }, {} ],
