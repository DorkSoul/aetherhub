[
 {
  "name": "upkeep: returns itself when it is the only enchantment",
  "players": [ { "battlefield": ["Riptide Chimera"] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 1 }, {} ] }
 },
 {
  "name": "upkeep: returns the other enchantment you choose",
  "players": [ { "battlefield": ["Riptide Chimera", "Rhystic Study"] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": ["Rhystic Study"] }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Riptide Chimera"] }, {} ] }
 },
 {
  "name": "ruling: the only enchantment you control must be returned to hand",
  "players": [ { "battlefield": ["Riptide Chimera"] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
  "expect": { "players": [ { "hand": ["Riptide Chimera"], "battlefield_lacks": ["Riptide Chimera"] }, {} ] }
 }
]
