[
 {
  "name": "bolt on the mage is copied onto the other creature",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Beamsplitter Mage",
     "Grizzly Bears",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Beamsplitter Mage"
    ]
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Lightning Bolt",
      "Grizzly Bears",
      "Beamsplitter Mage"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: the Mage dies in response to its trigger, and the spell is still copied",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Beamsplitter Mage", "Grizzly Bears", "Mountain", "Mountain"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Beamsplitter Mage"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Beamsplitter Mage"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt", "Grizzly Bears", "Beamsplitter Mage"] },
    { "graveyard": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: an opponent's creature does not count as another creature, so nothing is copied",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Beamsplitter Mage", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Beamsplitter Mage"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt", "Beamsplitter Mage"] },
    { "battlefield_has": ["Hill Giant"] }
   ]
  }
 }
]