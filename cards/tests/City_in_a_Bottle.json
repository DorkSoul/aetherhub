[
 {
  "name": "players can't cast spells with an Arabian Nights name",
  "players": [
   {
    "hand": [
     "War Elephant"
    ],
    "battlefield": [
     "City in a Bottle",
     "Plains",
     "Plains",
     "Plains",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "War Elephant",
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "War Elephant"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "players can't play lands with an Arabian Nights name",
  "players": [
   {
    "hand": [
     "Oasis"
    ],
    "battlefield": [
     "City in a Bottle"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Oasis",
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Oasis"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "other lands and spells are unaffected",
  "players": [
   {
    "hand": [
     "Forest",
     "Grizzly Bears"
    ],
    "battlefield": [
     "City in a Bottle",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Forest"
   },
   {
    "cast": "Grizzly Bears"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Grizzly Bears",
      "City in a Bottle"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "entering: each other nontoken permanent with such a name is sacrificed by its controller",
  "players": [
   {
    "hand": [
     "City in a Bottle"
    ],
    "battlefield": [
     "Plains",
     "Plains",
     "War Elephant",
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "War Elephant"
    ]
   }
  ],
  "steps": [
   {
    "cast": "City in a Bottle"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "War Elephant"
     ],
     "battlefield_has": [
      "City in a Bottle",
      "Grizzly Bears"
     ]
    },
    {
     "graveyard": [
      "War Elephant"
     ]
    }
   ]
  }
 },
 {
  "name": "a basic Mountain is not an Arabian Nights name (first printed in Alpha)",
  "players": [
   {
    "hand": [
     "Mountain"
    ],
    "battlefield": [
     "City in a Bottle"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Mountain"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Mountain",
      "City in a Bottle"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: the check happens whenever a player gets priority, so an opposing War Elephant already in play is sacrificed",
  "players": [
   { "battlefield": ["City in a Bottle"] },
   { "battlefield": ["War Elephant"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["City in a Bottle"] },
    { "graveyard_has": ["War Elephant"] }
   ]
  }
 }
]
