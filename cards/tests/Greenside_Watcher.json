[
 {
  "name": "untaps target Gate",
  "players": [
   {
    "battlefield": [
     {
      "name": "Greenside Watcher",
      "sick": false
     },
     {
      "name": "Boros Guildgate",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Greenside Watcher",
    "ability": 0,
    "targets": [
     "Boros Guildgate"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Greenside Watcher": true,
    "Boros Guildgate": false
   }
  }
 },
 {
  "name": "target must be a Gate",
  "players": [
   {
    "battlefield": [
     "Greenside Watcher",
     {
      "name": "Forest",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Greenside Watcher",
    "ability": 0,
    "targets": [
     "Forest"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Forest": true
   }
  }
 },
 {
  "name": "ruling: the ability uses the stack and still resolves after the Watcher dies in response",
  "players": [
   { "battlefield": [ { "name": "Greenside Watcher", "sick": false }, { "name": "Boros Guildgate", "tapped": true } ] },
   { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "activate": "Greenside Watcher", "ability": 0, "targets": ["Boros Guildgate"] },
   { "pass": true },
   { "cast": "Terror", "player": 1, "targets": ["Greenside Watcher"] },
   { "resolve": true }
  ],
  "expect": { "tapped": { "Boros Guildgate": false }, "players": [ { "graveyard_has": ["Greenside Watcher"] }, { "graveyard_has": ["Terror"] } ] }
 }
]