[
  {
    "name": "casting an instant that targets a creature gives +1/+1",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Rehearsed Debater"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Rehearsed Debater"] },
        { "graveyard": ["Grizzly Bears"] }
      ],
      "pt": { "Rehearsed Debater": [4, 4] }
    }
  },
  {
    "name": "a spell that targets only a player does not trigger repartee",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Rehearsed Debater"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 17 }],
      "pt": { "Rehearsed Debater": [3, 3] }
    }
  },
  {
    "name": "ruling: repartee still resolves when the targeted spell fizzles after its target leaves (rulings 0 and 1)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Rehearsed Debater"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ],
      "pt": { "Rehearsed Debater": [4, 4] }
    }
  }
]
