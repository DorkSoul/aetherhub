 {
  "name": "ruling: Disallow can counter an activated (sacrifice) ability: the Witching Well draw never happens",
  "players": [
   { "battlefield": ["Witching Well", "Island", "Island", "Island", "Island"] },
   { "hand": ["Disallow"], "battlefield": ["Island", "Island", "Island"] }
  ],
  "steps": [
   { "activate": "Witching Well", "ability": 0 },
   { "pass": true },
   { "cast": "Disallow", "player": 1, "targets": [{ "stack": "Witching Well" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 0, "graveyard_has": ["Witching Well"] }, { "graveyard": ["Disallow"] } ]
  }
 },
 {
