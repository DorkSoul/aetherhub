    "players": [ { "battlefield": ["Giant's Skewer", "Grizzly Bears", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Giant's Skewer", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
