[
  {
    "name": "regenerates target artifact",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Metallurgeon",
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Metallurgeon",
        "ability": 0,
        "targets": [
          "Sol Ring"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Sol Ring",
            "Metallurgeon"
          ]
        },
        {}
      ],
      "tapped": {
        "Metallurgeon": true
      }
    }
  },
  {
    "name": "can target itself (it is an artifact)",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Metallurgeon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Metallurgeon",
        "ability": 0,
        "targets": [
          "Metallurgeon"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Metallurgeon": true
      },
      "players": [
        {
          "battlefield_has": [
            "Metallurgeon"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a colored artifact is still an artifact, so Shatter can destroy it",
    "players": [
      { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Metallurgeon"] }
    ],
    "steps": [
      { "cast": "Shatter", "targets": ["Metallurgeon"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Shatter"] },
        { "graveyard_has": ["Metallurgeon"] }
      ]
    }
  }
]
