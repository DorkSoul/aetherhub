[
  {"name": "creates an Eldrazi Scion at the beginning of your upkeep",
   "players": [{"battlefield": ["From Beyond", "Forest"]}, {}],
   "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}],
   "expect": {"players": [{"battlefield": ["Eldrazi Scion", "Forest", "From Beyond"]}, {}]}},
  {"name": "sacrifice ability is activated and the enchantment leaves",
   "players": [{"battlefield": ["From Beyond", "Forest", "Forest"]}, {}],
   "steps": [{"activate": "From Beyond"}, {"resolve": true}],
   "expect": {"players": [{"graveyard": ["From Beyond"]}, {}]}},
  {"name": "ruling: an Eldrazi Scion is a 1/1 (not 0/1)",
   "players": [{"battlefield": ["From Beyond", "Forest"]}, {}],
   "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}],
   "expect": {"players": [{}, {}], "pt": {"Eldrazi Scion": [1, 1]}}},
  {"name": "ruling: an Eldrazi card is one with the Eldrazi creature type (Eldrazi Skyspawner is found)",
   "players": [{"battlefield": ["From Beyond", "Forest", "Forest"], "library": ["Eldrazi Temple", "Eldrazi Skyspawner"]}, {}],
   "steps": [{"activate": "From Beyond"}, {"resolve": true, "answers": ["Eldrazi Skyspawner"]}],
   "expect": {"players": [{"hand": ["Eldrazi Skyspawner"]}, {}]}},
  {"name": "ruling: an instant that creates a Scion and targets fizzles when its only target is gone: no Scion",
   "players": [
     {"hand": ["Adverse Conditions"], "battlefield": ["Island", "Island", "Island", "Island"]},
     {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"]}
   ],
   "steps": [
     {"cast": "Adverse Conditions", "targets": ["Grizzly Bears"]},
     {"pass": true},
     {"cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"]},
     {"resolve": true},
     {"resolve": true}
   ],
   "expect": {"players": [{"battlefield_lacks": ["Eldrazi Scion"], "graveyard_has": ["Adverse Conditions"]}, {"graveyard_has": ["Lightning Bolt", "Grizzly Bears"]}]}}
]
