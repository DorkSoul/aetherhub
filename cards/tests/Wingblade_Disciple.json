[
  {
    "name": "second spell each turn creates a 1/1 white Bird with flying",
    "players": [
      { "hand": ["Divination", "Divination"], "battlefield": ["Wingblade Disciple", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bird 1-1 White Flying"] }, {} ]
    }
  },
  {
    "name": "the first spell of the turn creates nothing",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Wingblade Disciple", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Bird 1-1 White Flying"] }, {} ]
    }
  },
  {
    "name": "ruling: a spell cast before the Disciple counts: the Disciple as first spell makes the next spell the second",
    "players": [
      { "hand": ["Wingblade Disciple", "Divination"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Wingblade Disciple" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Wingblade Disciple", "Bird 1-1 White Flying"] }, {} ]
    }
  }
]
