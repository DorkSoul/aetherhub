[
  {
    "name": "dies: target player loses life equal to its power",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mortis Dogs"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Mortis Dogs"] }, { "resolve": true, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Mortis Dogs"] }, { "life": 18 } ] }
  },
  {
    "name": "attacking: gets +2/+0 until end of turn",
    "players": [ { "battlefield": ["Mortis Dogs"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Mortis Dogs", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "ruling: dies in combat, loses life equal to its power as it last existed (4 with the attack pump)",
    "players": [ { "battlefield": [ { "name": "Mortis Dogs", "sick": false } ] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Mortis Dogs", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Mortis Dogs" } ], "player": 1 },
      { "advance_to": "Main2", "targets": ["p1"] }
    ],
    "expect": { "players": [ { "graveyard_has": ["Mortis Dogs"] }, { "life": 16 } ] }
  }
]
