[
  {
    "name": "deals 1 damage to any target",
    "players": [
      { "hand": ["Death Spark"], "battlefield": ["Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Death Spark", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Death Spark"] }, { "life": 19 } ] }
  },
  {
    "name": "at your upkeep with a creature card directly above it, pay {1} to return it to your hand",
    "players": [
      { "battlefield": ["Mountain"], "graveyard": ["Death Spark", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": ["yes"] }
    ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "hand_count": 1 }, {} ] }
  },
  {
    "name": "the controller may decline to pay",
    "players": [
      { "battlefield": ["Mountain"], "graveyard": ["Death Spark", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": ["no"] }
    ],
    "expect": { "players": [ { "graveyard": ["Death Spark", "Grizzly Bears"] }, {} ] }
  },
  {
    "name": "a noncreature card directly above it blocks the return even with a creature further up",
    "players": [
      { "battlefield": ["Mountain"], "graveyard": ["Death Spark", "Lightning Bolt", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "graveyard": ["Death Spark", "Grizzly Bears", "Lightning Bolt"] }, {} ] }
  },
  {
    "name": "nothing above it: no return",
    "players": [
      { "battlefield": ["Mountain"], "graveyard": ["Grizzly Bears", "Death Spark"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "graveyard": ["Death Spark", "Grizzly Bears"] }, {} ] }
  },
  {
    "name": "ruling: a creature killed by Death Spark goes to the graveyard after it, so it is directly above and Spark returns",
    "players": [
      { "hand": ["Death Spark"], "battlefield": ["Mountain", "Mountain", "Savannah Lions"] },
      {}
    ],
    "steps": [
      { "cast": "Death Spark", "targets": ["Savannah Lions"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": ["yes"] }
    ],
    "expect": { "players": [ { "graveyard": ["Savannah Lions"], "hand_count": 1 }, {} ] }
  }
]
