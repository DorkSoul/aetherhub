[
 { "name": "ETB earthbend 1: target land becomes a 0/0 haste creature with one +1/+1 counter",
   "players": [ { "hand": ["Badgermole Cub"], "battlefield": ["Forest", "Forest", "Forest", "Plains"] }, {} ],
   "steps": [ { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Badgermole Cub", "Plains"] }, {} ], "pt": { "Plains": [1, 1] }, "keywords": { "Plains": ["Haste"] }, "counters": { "Plains": { "p1p1": 1 } } } },
 { "name": "tapping a creature for mana adds an additional G",
   "players": [ { "battlefield": ["Badgermole Cub", "Llanowar Elves"] }, {} ],
   "steps": [ { "tap_for_mana": "Llanowar Elves" } ],
   "expect": { "players": [ { "pool": { "G": 2 } }, {} ] } },
 { "name": "tapping a noncreature land adds only its own mana",
   "players": [ { "battlefield": ["Badgermole Cub", "Forest"] }, {} ],
   "steps": [ { "tap_for_mana": "Forest" } ],
   "expect": { "players": [ { "pool": { "G": 1 } }, {} ] } },
 { "name": "ruling: an earthbent Forest is still a Forest and taps for G (plus the extra G)",
   "players": [ { "hand": ["Badgermole Cub"], "battlefield": ["Llanowar Elves", "Forest", "Plains"] }, {} ],
   "steps": [ { "cast": "Badgermole Cub", "answers": ["tap:Llanowar Elves#0", "tap:Plains#0"] }, { "resolve": true, "targets": ["Forest"] }, { "resolve": true }, { "tap_for_mana": "Forest" } ],
   "expect": { "players": [ { "pool": { "G": 2 } }, {} ], "pt": { "Forest": [1, 1] } } },
 { "name": "ruling: the Cub's mana trigger resolves without using the stack",
   "players": [ { "battlefield": ["Badgermole Cub", "Llanowar Elves"] }, {} ],
   "steps": [ { "tap_for_mana": "Llanowar Elves" } ],
   "expect": { "players": [ { "pool": { "G": 2 } }, {} ], "stack_empty": true } },
 { "name": "ruling: earthbending a land that is already a creature adds counters and resets base P/T to 0/0",
   "players": [ { "hand": ["Badgermole Cub", "Badgermole Cub"], "battlefield": ["Forest", "Forest", "Forest", "Plains"] }, {} ],
   "steps": [ { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true },
     { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Badgermole Cub", "Plains"] }, {} ], "pt": { "Plains": [2, 2] }, "counters": { "Plains": { "p1p1": 2 } } } },
 { "name": "ruling: an earthbent land that dies returns to the battlefield tapped",
   "players": [ { "hand": ["Badgermole Cub", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Plains", "Mountain"] }, {} ],
   "steps": [ { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Plains"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Badgermole Cub", "Plains"], "graveyard": ["Lightning Bolt"] }, {} ], "tapped": { "Plains": true } } },
 { "name": "ruling: an earthbent land that is bounced to hand is not returned to the battlefield",
   "players": [ { "hand": ["Badgermole Cub", "Unsummon"], "battlefield": ["Forest", "Forest", "Plains", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true },
     { "cast": "Unsummon", "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Plains"], "hand": ["Plains"] }, {} ] } },
 { "name": "ruling: earthbend does not give the land a color",
   "players": [ { "hand": ["Badgermole Cub"], "battlefield": ["Forest", "Forest", "Plains"] }, {} ],
   "steps": [ { "cast": "Badgermole Cub" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Badgermole Cub", "Plains"] }, {} ], "colors": { "Plains": [] } } },
 { "name": "ruling: a creature tapped for another object's mana ability (no {T} in its cost) does not trigger the Cub",
   "players": [ { "battlefield": ["Badgermole Cub", "Springleaf Drum"] }, {} ],
   "steps": [ { "tap_for_mana": "Springleaf Drum", "color": "G" } ],
   "expect": { "players": [ { "pool": { "G": 1 } }, {} ], "tapped": { "Badgermole Cub": true } } }
]
