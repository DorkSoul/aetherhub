[
  { "name": "discover 4 casts the revealed nonland card for free",
    "players": [ { "battlefield": ["Hidden Cataract", "Island", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "activate": "Hidden Cataract", "ability": 0 }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Hidden Cataract"], "battlefield_has": ["Grizzly Bears"], "exile": [] }, {} ] } },
  { "name": "declining the cast puts the revealed card into hand",
    "players": [ { "battlefield": ["Hidden Cataract", "Island", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "activate": "Hidden Cataract", "ability": 0 }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Hidden Cataract"], "hand": ["Grizzly Bears"], "exile": [] }, {} ] } },
  { "name": "enters tapped",
    "players": [ { "hand": ["Hidden Cataract"] }, {} ],
    "steps": [ { "play_land": "Hidden Cataract" } ],
    "expect": { "players": [ { "battlefield_has": ["Hidden Cataract"] }, {} ], "tapped": { "Hidden Cataract": true } } },
  { "name": "ruling: discover exiles every nonland card above mana value 4 and reveals the first nonland card with mana value 4 or less",
    "players": [ { "battlefield": ["Hidden Cataract", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Baneslayer Angel", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Hidden Cataract", "ability": 0 }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Hidden Cataract"], "hand": ["Grizzly Bears"], "exile": [] }, {} ] } },
  { "name": "ruling: a discovered card that cannot be cast (no creature to target) goes to hand",
    "players": [ { "battlefield": ["Hidden Cataract", "Island", "Island", "Island", "Island", "Island"], "library": ["Giant Growth", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Hidden Cataract", "ability": 0 }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Hidden Cataract"], "hand": ["Giant Growth"], "exile": [] }, {} ] } },
  { "name": "ruling: a discovered {X} spell is cast with X = 0, so Fireball deals no damage",
    "players": [ { "battlefield": ["Hidden Cataract", "Island", "Island", "Island", "Island", "Island"], "library": ["Fireball", "Forest"] }, {} ],
    "steps": [ { "activate": "Hidden Cataract", "ability": 0 }, { "resolve": true, "answers": [true], "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Fireball"] }, { "life": 20 } ] } }
]
