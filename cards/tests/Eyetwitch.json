  },
  {
    "name": "ruling: learn is optional, declining both options does nothing",
    "players": [
      { "hand": ["Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Eyetwitch"], "library": ["Plains"], "sideboard": ["Airbending Lesson"] },
