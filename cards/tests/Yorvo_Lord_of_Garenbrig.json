    "players": [
      {
        "hand": ["Craw Wurm", "Lightning Bolt", "Lightning Bolt"],
        "battlefield": ["Yorvo, Lord of Garenbrig", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Mountain"]
