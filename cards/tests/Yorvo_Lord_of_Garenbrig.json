      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Craw Wurm"] },
      { "cast": "Lightning Bolt", "targets": ["Craw Wurm"] },
      { "resolve": true }
