[
  {
    "name": "blocked by a creature: gains control of it at end of combat",
    "players": [ { "battlefield": ["Tolarian Entrancer"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Tolarian Entrancer", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Tolarian Entrancer" } ] }, { "advance_to": "Main2" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "unblocked: no control change",
    "players": [ { "battlefield": ["Tolarian Entrancer"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Tolarian Entrancer", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"], "life": 19 } ]
    }
  },
  {
    "name": "ruling: control change is permanent even if Tolarian Entrancer has left the battlefield by end of combat",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Tolarian Entrancer", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Tolarian Entrancer", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Tolarian Entrancer" } ] }, { "cast": "Lightning Bolt", "targets": ["Tolarian Entrancer"] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Tolarian Entrancer"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] }
  }
]
