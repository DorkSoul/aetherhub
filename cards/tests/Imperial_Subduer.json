[
  {
    "name": "attacking alone taps target creature you don't control",
    "players": [
      { "battlefield": ["Imperial Subduer"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Imperial Subduer", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "attacking with another creature does not trigger it",
    "players": [
      { "battlefield": ["Imperial Subduer", "Savannah Lions"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Imperial Subduer", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  }
]
