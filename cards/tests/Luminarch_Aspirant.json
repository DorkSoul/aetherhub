[
  {
    "name": "puts a counter on itself at beginning of combat",
    "players": [
      {
        "battlefield": [
          "Luminarch Aspirant"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "pt": {
        "Luminarch Aspirant": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "can target another creature you control",
    "players": [
      {
        "battlefield": [
          "Luminarch Aspirant",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Luminarch Aspirant": [
          1,
          1
        ],
        "Grizzly Bears": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "does not trigger on the opponent's turn",
    "players": [
      {},
      {
        "battlefield": [
          "Luminarch Aspirant"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "pt": {
        "Luminarch Aspirant": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "ruling: can target itself when another creature is also available",
    "players": [
      {
        "battlefield": [
          "Luminarch Aspirant",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat",
        "targets": [
          "Luminarch Aspirant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Luminarch Aspirant": [
          2,
          2
        ],
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  }
]
