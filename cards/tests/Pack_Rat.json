[
 {
  "name": "power and toughness equal the number of Rats you control",
  "players": [
   {
    "battlefield": [
     "Pack Rat"
    ]
   },
   {}
  ],
  "steps": [],
  "expect": {
   "pt": {
    "Pack Rat": [
     1,
     1
    ]
   }
  }
 },
 {
  "name": "copy by discarding: two Rats are 2/2",
  "players": [
   {
    "hand": [
     "Plains"
    ],
    "battlefield": [
     "Pack Rat",
     "Swamp",
     "Swamp",
     "Swamp"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Pack Rat"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Pack Rat": [
     2,
     2
    ]
   },
   "players": [
    {
     "battlefield": [
      "Pack Rat",
      "Pack Rat",
      "Swamp",
      "Swamp",
      "Swamp"
     ],
     "graveyard": [
      "Plains"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "cannot activate with no card to discard",
  "players": [
   {
    "battlefield": [
     "Pack Rat",
     "Swamp",
     "Swamp",
     "Swamp"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Pack Rat",
    "illegal": true
   }
  ],
  "expect": {
   "pt": {
    "Pack Rat": [
     1,
     1
    ]
   }
  }
 },
 {
  "name": "ruling: token copies Pack Rat's last known values when the original leaves in response",
  "players": [ { "hand": ["Plains"], "battlefield": ["Pack Rat", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
  "steps": [ { "activate": "Pack Rat" }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Pack Rat"] }, { "resolve": true } ],
  "expect": { "pt": { "Pack Rat": [1, 1] }, "players": [ { "battlefield_has": ["Pack Rat"], "graveyard_has": ["Pack Rat", "Plains"] }, { "graveyard": ["Lightning Bolt"] } ] }
 },
 {
  "name": "ruling: the token does not copy the +1/+1 counter on Pack Rat",
  "players": [ { "hand": ["Plains"], "battlefield": [ { "name": "Pack Rat", "counters": { "+1/+1": 1 } }, "Swamp", "Swamp", "Swamp" ] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
  "steps": [ { "activate": "Pack Rat" }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Pack Rat"] }, { "resolve": true } ],
  "expect": { "pt": { "Pack Rat": [1, 1] }, "players": [ { "battlefield_has": ["Pack Rat"], "graveyard_has": ["Pack Rat", "Plains"] }, { "graveyard": ["Lightning Bolt"] } ] }
 },
 {
  "name": "ruling: token's power and toughness count the Rats you control at resolution",
  "players": [ { "hand": ["Plains", "Island"], "battlefield": ["Pack Rat", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
  "steps": [ { "activate": "Pack Rat", "answers": ["Plains"] }, { "resolve": true }, { "activate": "Pack Rat" }, { "resolve": true } ],
  "expect": { "pt": { "Pack Rat": [3, 3] }, "players": [ { "graveyard": ["Plains", "Island"] }, {} ] }
 },
 {
  "name": "ruling: Pack Rat counts Rats of other names you control",
  "players": [ { "battlefield": ["Pack Rat", "Burglar Rat"] }, {} ],
  "steps": [],
  "expect": { "pt": { "Pack Rat": [2, 2] } }
 }
]