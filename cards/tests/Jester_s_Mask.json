[
  {
    "name": "opponent's hand goes on top of their library, then they search for that many and shuffle",
    "players": [
      { "battlefield": ["Jester's Mask", "Plains"] },
      { "hand": ["Grizzly Bears", "Forest"], "library": ["Plains", "Island"] }
    ],
    "steps": [
      { "activate": "Jester's Mask", "targets": ["p1"] },
      { "resolve": true, "answers": [["Grizzly Bears", "Plains"]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Jester's Mask"], "hand_count": 0 },
        { "hand": ["Grizzly Bears", "Plains"] }
      ]
    }
  },
  {
    "name": "opponent with an empty hand searches for nothing",
    "players": [
      { "battlefield": ["Jester's Mask", "Plains"] },
      { "library": ["Plains", "Island"] }
    ],
    "steps": [
      { "activate": "Jester's Mask", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Jester's Mask"] },
        { "hand_count": 0 }
      ]
    }
  },
  {
    "name": "enters tapped",
    "players": [
      { "hand": ["Jester's Mask"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Jester's Mask" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Jester's Mask": true }
    }
  },
  {
    "name": "activation needs {1} and a tap: illegal with no untapped mana",
    "players": [
      { "battlefield": ["Jester's Mask"] },
      { "hand": ["Grizzly Bears"], "library": ["Plains"] }
    ],
    "steps": [
      { "activate": "Jester's Mask", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "hand": ["Grizzly Bears"] } ]
    }
  }
]
