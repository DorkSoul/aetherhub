[
  {
    "name": "sacrifice for a card, then draw from the graveyard trigger",
    "players": [
      { "battlefield": ["Island", "Implement of Examination"], "library": ["Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "activate": "Implement of Examination", "ability": 0 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Implement of Examination"], "hand_count": 2 },
        {}
      ]
    }
  },
  {
    "name": "needs U mana to activate",
    "players": [
      { "battlefield": ["Mountain", "Implement of Examination"] },
      {}
    ],
    "steps": [
      { "activate": "Implement of Examination", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Implement of Examination"] }, {} ]
    }
  },
  {
    "name": "ruling: destroyed by an opponent's spell still draws from the last ability",
    "players": [
      { "battlefield": ["Implement of Examination"], "library": ["Grizzly Bears", "Hill Giant"] },
      { "hand": ["Smash to Smithereens"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Smash to Smithereens", "targets": ["Implement of Examination"] },
      { "pass": true },
      { "player": 1, "pass": true },
      { "pass": true },
      { "player": 1, "pass": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Implement of Examination"], "hand_count": 1, "life": 17 },
        { "graveyard": ["Smash to Smithereens"] }
      ]
    }
  }
]
