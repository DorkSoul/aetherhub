[
 { "name": "attacking adds R that lasts until end of combat",
   "players": [ { "battlefield": ["Fire Sages"] }, {} ],
   "steps": [ { "attack": [ { "card": "Fire Sages", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, {} ] } },
 { "name": "not attacking: the firebending mana is lost when combat ends",
   "players": [ { "battlefield": ["Fire Sages"] }, {} ],
   "steps": [ { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": {} }, {} ] } },
 { "name": "{1}{R}{R}: puts a +1/+1 counter on it",
   "players": [ { "battlefield": ["Fire Sages", "Mountain", "Mountain", "Swamp"] }, {} ],
   "steps": [ { "activate": "Fire Sages", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Fire Sages": [3, 3] }, "players": [ {}, {} ] } },
 { "name": "{1}{R}{R} with only one red source is illegal",
   "players": [ { "battlefield": ["Fire Sages", "Mountain", "Swamp", "Swamp"] }, {} ],
   "steps": [ { "activate": "Fire Sages", "ability": 0, "illegal": true } ],
   "expect": { "pt": { "Fire Sages": [2, 2] }, "players": [ {}, {} ] } },
 { "name": "ruling: two Fire Sages attacking each add R (triggers separately)",
   "players": [ { "battlefield": ["Fire Sages", "Fire Sages"] }, {} ],
   "steps": [ { "attack": [ { "card": "Fire Sages", "at": "p1" }, { "card": "Fire Sages", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 2 } }, {} ] } },
 { "name": "ruling: ordinary floating mana empties when combat begins, firebending R stays",
   "players": [ { "battlefield": ["Fire Sages", "Mountain"] }, {} ],
   "steps": [ { "tap_for_mana": "Mountain" }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Fire Sages", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, {} ] } },
 { "name": "ruling: firebending trigger is on the stack, so it resolves after its source is Bolted",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fire Sages", "Mountain"] }, {} ],
   "steps": [ { "attack": [ { "card": "Fire Sages", "at": "p1" } ] }, { "cast": "Lightning Bolt", "targets": ["Fire Sages"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Fire Sages", "Lightning Bolt"], "pool": { "R": 1 } }, {} ] } },
 { "name": "ruling: firebending mana can pay for the pump after combat damage",
   "players": [ { "battlefield": ["Fire Sages", "Mountain", "Swamp"] }, {} ],
   "steps": [ { "attack": [ { "card": "Fire Sages", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "activate": "Fire Sages", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Fire Sages": [3, 3] }, "players": [ { "pool": {} }, {} ] } },
 { "name": "ruling: firebending mana is lost when leaving combat for the second main phase",
   "players": [ { "battlefield": ["Fire Sages"] }, {} ],
   "steps": [ { "attack": [ { "card": "Fire Sages", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": {} }, {} ] } }
]
