[
  {
    "name": "exiles only the top card of the graveyard as a cost",
    "players": [ { "graveyard": ["Grizzly Bears", "Lightning Bolt"], "battlefield": ["Alms", "Plains", "Hill Giant"] }, {} ],
    "steps": [ { "activate": "Alms", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "exile": ["Lightning Bolt"] }, {} ] }
  },
  {
    "name": "empty graveyard: can't activate",
    "players": [ { "battlefield": ["Alms", "Plains", "Hill Giant"] }, {} ],
    "steps": [ { "activate": "Alms", "targets": ["Hill Giant"], "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "ruling: the top card is the one put into the graveyard most recently (the Bolt, not the older Bears)",
    "players": [ { "hand": ["Lightning Bolt"], "graveyard": ["Grizzly Bears"], "battlefield": ["Alms", "Plains", "Mountain", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
               { "activate": "Alms", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "exile": ["Lightning Bolt"] }, { "life": 17 } ] }
  }
]
