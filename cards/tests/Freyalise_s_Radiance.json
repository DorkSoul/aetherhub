[
  {
    "name": "upkeep: pays {2} for one age counter",
    "players": [
      { "battlefield": ["Freyalise's Radiance", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Freyalise's Radiance": { "age": 1 } },
      "players": [ { "battlefield_has": ["Freyalise's Radiance"] }, {} ]
    }
  },
  {
    "name": "upkeep: cannot pay, sacrificed",
    "players": [
      { "battlefield": ["Freyalise's Radiance"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Freyalise's Radiance"] }, {} ]
    }
  },
  {
    "name": "untap step: a tapped snow land stays tapped while a tapped non-snow land untaps",
    "start": "End",
    "players": [ { "battlefield": ["Freyalise's Radiance", { "name": "Snow-Covered Forest", "tapped": true }, { "name": "Forest", "tapped": true }] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "tapped": { "Snow-Covered Forest": true, "Forest": false } }
  }
]
