[
  {
    "name": "enters with a +1/+1 counter: 1/2",
    "players": [{ "hand": ["Zack Fair"], "battlefield": ["Plains"] }, {}],
    "steps": [{ "cast": "Zack Fair" }, { "resolve": true }],
    "expect": { "counters": { "Zack Fair": { "p1p1": 1 } }, "pt": { "Zack Fair": [1, 2] } }
  },
  {
    "name": "sacrifice: target creature gains indestructible and Zack's counter",
    "players": [{ "battlefield": [{ "name": "Zack Fair", "counters": { "p1p1": 1 } }, "Grizzly Bears", "Plains"] }, {}],
    "steps": [{ "activate": "Zack Fair", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": {
      "players": [{ "graveyard": ["Zack Fair"] }, {}],
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3] },
      "keywords": { "Grizzly Bears": ["Indestructible"] }
    }
  },
  {
    "name": "an Equipment attached to Zack is attached to the target creature",
    "players": [{ "battlefield": [{ "name": "Zack Fair", "counters": { "p1p1": 1 } }, "Grizzly Bears", "Bonesplitter", "Plains", "Plains"] }, {}],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Zack Fair"] },
      { "resolve": true },
      { "activate": "Zack Fair", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Bonesplitter": "Grizzly Bears" },
      "pt": { "Grizzly Bears": [5, 3] },
      "players": [{ "graveyard": ["Zack Fair"] }, {}]
    }
  },
  {
    "name": "an Equipment attached to another creature stays there",
    "players": [{ "battlefield": [{ "name": "Zack Fair", "counters": { "p1p1": 1 } }, "Grizzly Bears", "Hill Giant", "Bonesplitter", "Plains", "Plains"] }, {}],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Zack Fair", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "attached": { "Bonesplitter": "Hill Giant" }, "pt": { "Grizzly Bears": [3, 3] } }
  },
  {
    "name": "ruling: the sacrifice puts the same number of each counter kind Zack had (not moved from Zack)",
    "players": [{ "battlefield": [{ "name": "Zack Fair", "counters": { "p1p1": 3 } }, "Grizzly Bears", "Plains"] }, {}],
    "steps": [{ "activate": "Zack Fair", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": {
      "players": [{ "graveyard": ["Zack Fair"] }, {}],
      "counters": { "Grizzly Bears": { "p1p1": 3 } },
      "pt": { "Grizzly Bears": [5, 5] }
    }
  },
  {
    "name": "ruling: the sacrifice puts all of Zack's counter kinds on the target, not just +1/+1",
    "players": [{ "battlefield": [{ "name": "Zack Fair", "counters": { "p1p1": 1, "charge": 2 } }, "Grizzly Bears", "Plains"] }, {}],
    "steps": [{ "activate": "Zack Fair", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": {
      "players": [{ "graveyard": ["Zack Fair"] }, {}],
      "counters": { "Grizzly Bears": { "p1p1": 1, "charge": 2 } }
    }
  },
  {
    "name": "ruling: with The Ozolith, the counters Zack had also go onto The Ozolith when it leaves",
    "players": [{ "battlefield": [{ "name": "Zack Fair", "counters": { "p1p1": 1 } }, "Grizzly Bears", "Plains", "The Ozolith"] }, {}],
    "steps": [{ "activate": "Zack Fair", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 1 }, "The Ozolith": { "p1p1": 1 } }
    }
  }
]
