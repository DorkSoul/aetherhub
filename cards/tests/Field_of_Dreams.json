[
  {
    "name": "world rule: a new world permanent puts the old world permanent into the graveyard",
    "players": [
      { "hand": ["Field of Dreams"], "battlefield": ["Island", "Chaosphere", "Mountain", "Plains"] },
      {}
    ],
    "steps": [ { "cast": "Field of Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Field of Dreams"], "graveyard": ["Chaosphere"] }, {} ] }
  },
  {
    "name": "a single world permanent stays on the battlefield",
    "players": [
      { "hand": ["Field of Dreams"], "battlefield": ["Island"] },
      {}
    ],
    "steps": [ { "cast": "Field of Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Field of Dreams"] }, {} ] }
  },
  {
    "name": "ruling: the old world permanent goes to its owner's graveyard, even when the opponent controls it",
    "players": [
      { "hand": ["Field of Dreams"], "battlefield": ["Island"] },
      { "battlefield": ["Chaosphere"] }
    ],
    "steps": [ { "cast": "Field of Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Field of Dreams"] }, { "graveyard": ["Chaosphere"] } ] }
  }
]
