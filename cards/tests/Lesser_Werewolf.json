[
 { "name": "attacker: puts a -0/-1 counter on its blocker and gets -1/-0",
   "players": [ { "battlefield": ["Lesser Werewolf", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Lesser Werewolf", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Lesser Werewolf" } ] },
              { "activate": "Lesser Werewolf", "ability": 0 },
              { "resolve": true } ],
   "expect": { "counters": { "Grizzly Bears": { "m0m1": 1 } }, "pt": { "Grizzly Bears": [2, 1], "Lesser Werewolf": [1, 4] } } },
 { "name": "blocker: targets the creature it blocks",
   "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Lesser Werewolf", "Swamp"] } ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "block": [ { "blocker": "Lesser Werewolf", "attacker": "Grizzly Bears" } ] },
              { "pass": true },
              { "activate": "Lesser Werewolf", "ability": 0, "player": 1 },
              { "resolve": true } ],
   "expect": { "counters": { "Grizzly Bears": { "m0m1": 1 } }, "pt": { "Grizzly Bears": [2, 1], "Lesser Werewolf": [1, 4] } } },
 { "name": "ruling: at power 0 the ability may be activated but does nothing",
   "players": [ { "battlefield": ["Lesser Werewolf", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Lesser Werewolf", "at": "p1" } ] },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Lesser Werewolf" } ] },
              { "activate": "Lesser Werewolf", "ability": 0 }, { "resolve": true },
              { "activate": "Lesser Werewolf", "ability": 0 }, { "resolve": true },
              { "activate": "Lesser Werewolf", "ability": 0 }, { "resolve": true } ],
   "expect": { "counters": { "Hill Giant": { "m0m1": 2 } }, "pt": { "Hill Giant": [3, 1], "Lesser Werewolf": [0, 4] } } },
 {
   "name": "cannot activate outside the declare blockers step",
   "players": [ { "battlefield": ["Lesser Werewolf", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Lesser Werewolf", "ability": 0, "illegal": true } ],
   "expect": { "counters": { "Grizzly Bears": { "m0m1": 0 } } } }
]
