[
 {
  "name": "creates a 3/3 Beast",
  "players": [
   { "battlefield": ["Soul of Zendikar", "Forest", "Forest", "Forest", "Forest", "Forest"] },
   { }
  ],
  "steps": [
   { "activate": "Soul of Zendikar" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Soul of Zendikar", "Beast"] }, { } ]
  }
 },
 {
  "name": "from the graveyard: exile itself to create a Beast",
  "players": [
   { "graveyard": ["Soul of Zendikar"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
   { }
  ],
  "steps": [
   { "activate": "Soul of Zendikar", "ability": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "exile": ["Soul of Zendikar"], "graveyard": [], "battlefield_has": ["Beast"] }, { } ]
  }
 },
 {
  "name": "the graveyard ability needs the card in the graveyard",
  "players": [
   { "battlefield": ["Soul of Zendikar", "Forest", "Forest", "Forest", "Forest", "Forest"] },
   { }
  ],
  "steps": [
   { "activate": "Soul of Zendikar", "ability": 1, "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Soul of Zendikar"], "battlefield_lacks": ["Beast"] }, { } ]
  }
 },
 {
  "name": "ruling: the exile is a cost, so the Soul is already exiled while the ability is on the stack",
  "players": [
   { "graveyard": ["Soul of Zendikar"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
   { }
  ],
  "steps": [
   { "activate": "Soul of Zendikar", "ability": 1 }
  ],
  "expect": {
   "players": [ { "exile": ["Soul of Zendikar"], "graveyard": [], "battlefield_lacks": ["Beast"] }, { } ]
  }
 },
 {
  "name": "ruling: the graveyard ability cannot be activated once the Soul is in exile",
  "players": [
   { "exile": ["Soul of Zendikar"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
   { }
  ],
  "steps": [
   { "activate": "Soul of Zendikar", "ability": 1, "illegal": true }
  ],
  "expect": {
   "players": [ { "exile": ["Soul of Zendikar"], "battlefield_lacks": ["Beast"] }, { } ]
  }
 }
]
