[
 { "name": "madness: discarded to Wild Guess, cast it for 2G and it resolves as a 4/4",
   "players": [ { "hand": ["Wild Guess", "Arrogant Wurm"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [ true ] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Arrogant Wurm"] }, {} ], "pt": { "Arrogant Wurm": [4, 4] } } },
 { "name": "madness: declining leaves it in the graveyard",
   "players": [ { "hand": ["Wild Guess", "Arrogant Wurm"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [ false ] } ],
   "expect": { "players": [ { "graveyard_has": ["Arrogant Wurm"], "battlefield_lacks": ["Arrogant Wurm"] }, {} ] } },
 { "name": "ruling: discarded to a spell's effect (Mind Rot) it can still be cast for madness",
   "players": [ { "hand": ["Mind Rot"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Arrogant Wurm", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest"] } ],
   "steps": [ { "cast": "Mind Rot", "targets": ["p1"] }, { "resolve": true, "answers": [ true ] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Arrogant Wurm"], "graveyard_has": ["Lightning Bolt"] } ], "pt": { "Arrogant Wurm": [4, 4] } } },
 { "name": "ruling: a card put into the graveyard by milling is not discarded, so no madness",
   "players": [ { "hand": ["Dream Twist"], "battlefield": ["Island"], "library": ["Arrogant Wurm"] }, {} ],
   "steps": [ { "cast": "Dream Twist", "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Arrogant Wurm"], "battlefield_lacks": ["Arrogant Wurm"] }, {} ] } },
 { "name": "ruling: a sorcery with madness discarded on the opponent's turn can be cast then (Biting Rain)",
   "players": [ { "hand": ["Biting Rain", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Mind Rot"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"] } ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Mind Rot", "player": 1, "targets": ["p0"] }, { "resolve": true, "answers": [ true ] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Biting Rain", "Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears", "Mind Rot"] } ] } },
 { "name": "ruling: a discarded card counts as discarded even when it is exiled for madness (Megrim triggers twice; p1 has no mana to cast it)",
   "players": [ { "hand": ["Mind Rot"], "battlefield": ["Megrim", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Arrogant Wurm", "Lightning Bolt"] } ],
   "steps": [ { "cast": "Mind Rot", "targets": ["p1"] }, { "resolve": true, "auto": true } ],
   "expect": { "players": [ {}, { "life": 16, "graveyard_has": ["Arrogant Wurm", "Lightning Bolt"] } ] } }
]
