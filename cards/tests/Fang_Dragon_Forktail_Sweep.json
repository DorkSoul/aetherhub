[
  { "name": "Forktail Sweep deals 1 damage to each creature you don't control, then the card is exiled",
    "players": [ { "hand": ["Fang Dragon // Forktail Sweep"], "battlefield": ["Mountain", "Mountain", "Hill Giant"] },
                 { "battlefield": ["Llanowar Elves", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Fang Dragon // Forktail Sweep", "face": true }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Fang Dragon // Forktail Sweep"], "battlefield_has": ["Hill Giant"] },
                             { "graveyard": ["Llanowar Elves"], "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "cast as the 6/3 flyer for its creature cost",
    "players": [ { "hand": ["Fang Dragon // Forktail Sweep"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Fang Dragon // Forktail Sweep" }, { "resolve": true } ],
    "expect": { "pt": { "Fang Dragon // Forktail Sweep": [6, 3] }, "keywords": { "Fang Dragon // Forktail Sweep": ["Flying"] } } },
  { "name": "ruling: a countered Adventure goes to the graveyard, not exile, so the creature is never castable",
    "players": [ { "hand": ["Fang Dragon // Forktail Sweep"], "battlefield": ["Mountain", "Mountain"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Fang Dragon // Forktail Sweep", "face": true }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Forktail Sweep" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Fang Dragon // Forktail Sweep"], "exile": [] }, { "graveyard_has": ["Counterspell"] } ] } },
  { "name": "ruling: a resolved Adventure is exiled and its creature can be cast from exile later",
    "players": [ { "hand": ["Fang Dragon // Forktail Sweep"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Fang Dragon // Forktail Sweep", "face": true }, { "resolve": true }, { "cast": "Fang Dragon // Forktail Sweep" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": [], "battlefield_has": ["Fang Dragon // Forktail Sweep"] }, {} ], "pt": { "Fang Dragon // Forktail Sweep": [6, 3] } } }
]
