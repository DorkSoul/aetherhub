   "steps": [ { "cast": "Vital Surge" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 23, "graveyard": ["Vital Surge"] }, {} ] } },
 { "name": "spliced onto Unchecked Growth: the splice effect also gains 3 life and the card stays in hand",
   "players": [ { "hand": ["Unchecked Growth", "Vital Surge"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Unchecked Growth", "targets": ["Grizzly Bears"], "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 23, "hand": ["Vital Surge"], "graveyard": ["Unchecked Growth"] }, {} ] } },
 { "name": "declining the splice: no life gained, Vital Surge stays in hand",
   "players": [ { "hand": ["Unchecked Growth", "Vital Surge"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Unchecked Growth", "targets": ["Grizzly Bears"], "answers": [false] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "hand": ["Vital Surge"], "graveyard": ["Unchecked Growth"] }, {} ] } },
 { "name": "ruling: if every target of the spell is gone, the spliced spell does not resolve and no splice effect happens",
   "players": [ { "hand": ["Unchecked Growth", "Vital Surge"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [
