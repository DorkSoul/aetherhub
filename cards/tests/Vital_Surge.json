     { "pass": true, "player": 1 },
     { "pass": true },
     { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "hand": ["Vital Surge"], "graveyard": ["Unchecked Growth", "Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ] } }
