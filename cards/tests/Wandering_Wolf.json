[
 {
  "name": "a blocker with equal power can block it and trades",
  "players": [ { "battlefield": [ { "name": "Wandering Wolf", "sick": false } ] }, { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] } ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "attack": [ { "card": "Wandering Wolf", "at": "p1" } ] },
   { "block": [ { "blocker": "Grizzly Bears", "attacker": "Wandering Wolf" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "graveyard_has": ["Wandering Wolf"] }, { "graveyard_has": ["Grizzly Bears"] } ] }
 },
 {
  "name": "a smaller creature cannot block it: unblocked for 2",
  "players": [ { "battlefield": [ { "name": "Wandering Wolf", "sick": false } ] }, { "battlefield": [ { "name": "Llanowar Elves", "sick": false } ] } ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "attack": [ { "card": "Wandering Wolf", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "life": 20 }, { "life": 18 } ] }
 },
 {
  "name": "a power-1 creature cannot block it: the Elves' block is dropped, Wolf deals 2",
  "players": [ { "battlefield": [ { "name": "Wandering Wolf", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }, { "battlefield": [ { "name": "Llanowar Elves", "sick": false }, { "name": "Hill Giant", "sick": false } ] } ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "attack": [ { "card": "Wandering Wolf", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Llanowar Elves", "attacker": "Wandering Wolf" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "battlefield_has": ["Wandering Wolf"] }, { "life": 18, "battlefield_has": ["Llanowar Elves"] } ] }
 },
 {
  "name": "ruling: a power-up on the Wolf after blocks does not undo the block (Bears still blocks)",
  "players": [ { "battlefield": [ { "name": "Wandering Wolf", "sick": false }, "Forest" ], "hand": ["Giant Growth"] }, { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] } ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "attack": [ { "card": "Wandering Wolf", "at": "p1" } ] },
   { "block": [ { "blocker": "Grizzly Bears", "attacker": "Wandering Wolf" } ] },
   { "cast": "Giant Growth", "targets": ["Wandering Wolf"] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "life": 20, "battlefield_has": ["Wandering Wolf"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] }
 }
]
