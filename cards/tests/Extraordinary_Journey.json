[
  {
    "name": "X=2 exiles two target creatures, each of which stays exiled",
    "players": [
      { "hand": ["Extraordinary Journey"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Extraordinary Journey", "answers": [2] },
      { "resolve": true, "targets": ["Grizzly Bears", "Hill Giant"] }
    ],
    "expect": {
      "players": [
        { "exile": ["Grizzly Bears"], "battlefield_has": ["Extraordinary Journey"] },
        { "exile": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "casting the exiled creature from exile draws a card",
    "players": [
      { "hand": ["Extraordinary Journey"], "library": ["Forest", "Forest"], "battlefield": ["Island", "Island", "Island", "Island", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Extraordinary Journey", "answers": [1] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Extraordinary Journey", "Grizzly Bears"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "a creature cast from hand does not draw",
    "players": [
      { "hand": ["Grizzly Bears"], "library": ["Forest"], "battlefield": ["Extraordinary Journey", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "draws only once each turn even if two exiled creatures are cast",
    "players": [
      { "hand": ["Extraordinary Journey"], "library": ["Forest", "Forest", "Forest"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Extraordinary Journey", "answers": [2] },
      { "resolve": true, "targets": ["Grizzly Bears", "Grizzly Bears"] },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "ruling: the owner of an exiled creature still follows timing: no casting it on the opponent's turn",
    "players": [
      { "hand": ["Extraordinary Journey"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Forest", "Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Extraordinary Journey", "answers": [1] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Grizzly Bears", "player": 1, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Extraordinary Journey"] },
        { "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the draw applies to any creature entering from exile, e.g. one returned by Banisher Priest",
    "players": [
      { "hand": ["Banisher Priest", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Mountain", "Extraordinary Journey"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Banisher Priest" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Banisher Priest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Banisher Priest", "Lightning Bolt"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
