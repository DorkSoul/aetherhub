[
  {
    "name": "tap to put a charge counter on it",
    "players": [ { "battlefield": ["Grindclock"] }, {} ],
    "steps": [
      { "activate": "Grindclock", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "counters": { "Grindclock": { "charge": 1 } },
      "tapped": { "Grindclock": true }
    }
  },
  {
    "name": "target player mills a card for each charge counter",
    "players": [ { "battlefield": [ { "name": "Grindclock", "counters": { "charge": 2 } } ] }, {} ],
    "steps": [
      { "activate": "Grindclock", "ability": 1, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "library_count": 18 } ]
    }
  },
  {
    "name": "no charge counters mills nothing",
    "players": [ { "battlefield": ["Grindclock"] }, {} ],
    "steps": [
      { "activate": "Grindclock", "ability": 1, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "library_count": 20 } ]
    }
  },
  {
    "name": "mill still uses the counters it had when it left the battlefield in response",
    "players": [
      { "battlefield": [ { "name": "Grindclock", "counters": { "charge": 2 } } ] },
      { "hand": ["Naturalize"], "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Grindclock", "ability": 1, "targets": ["p1"] },
      { "pass": true },
      { "cast": "Naturalize", "targets": ["Grindclock"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grindclock"], "battlefield_lacks": ["Grindclock"] }, { "library_count": 18 } ]
    }
  },
  {
    "name": "ruling: uses the charge counters it had when it left the battlefield",
    "players": [
      { "battlefield": [ { "name": "Grindclock", "counters": { "charge": 3 } } ] },
      { "hand": ["Naturalize"], "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Grindclock", "ability": 1, "targets": ["p1"] },
      { "pass": true },
      { "cast": "Naturalize", "targets": ["Grindclock"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grindclock"] }, { "library_count": 17 } ]
    }
  }
]
