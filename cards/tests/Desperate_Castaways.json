        "attack": [
          {
            "card": "Desperate Castaways",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "without an artifact it can't attack: the declared Castaways is dropped, the Grizzly Bears hits",
    "players": [
      {
        "battlefield": [
          { "name": "Desperate Castaways", "sick": false },
          { "name": "Grizzly Bears", "sick": false }
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          { "card": "Desperate Castaways", "at": "p1" },
          { "card": "Grizzly Bears", "at": "p1" }
        ]
      },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: once attacking it stays in combat after its artifact is destroyed",
    "players": [
      { "battlefield": [ { "name": "Desperate Castaways", "sick": false }, "Sol Ring" ] },
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "attack": [ { "card": "Desperate Castaways", "at": "p1" } ] },
      { "block": [] },
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Sol Ring"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Sol Ring"] }, { "life": 18, "graveyard_has": ["Disenchant"] } ]
    }
  }
