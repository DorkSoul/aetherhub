[
  {
    "name": "draws a card and gains 5 life when you control an Angel",
    "players": [ { "battlefield": ["Scroll of Avacyn", "Island", "Serra Angel"] }, {} ],
    "steps": [
      { "activate": "Scroll of Avacyn", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 25, "hand_count": 1, "battlefield_lacks": ["Scroll of Avacyn"], "graveyard_has": ["Scroll of Avacyn"] }, {} ] }
  },
  {
    "name": "draws a card but gains no life without an Angel",
    "players": [ { "battlefield": ["Scroll of Avacyn", "Island"] }, {} ],
    "steps": [
      { "activate": "Scroll of Avacyn", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "hand_count": 1, "battlefield_lacks": ["Scroll of Avacyn"] }, {} ] }
  },
  {
    "name": "ruling: Angel removed in response, so no life is gained (checked on resolution)",
    "players": [ { "battlefield": ["Scroll of Avacyn", "Island", "Serra Angel"] }, { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] } ],
    "steps": [
      { "activate": "Scroll of Avacyn", "ability": 0 },
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "hand_count": 1, "battlefield_lacks": ["Scroll of Avacyn"], "graveyard_has": ["Scroll of Avacyn", "Serra Angel"] }, { "graveyard_has": ["Terror"] } ] }
  }
]
