[
  {
    "name": "opponent pays X = Shock's mana value (1) and Shock resolves",
    "players": [
      { "hand": ["Rethink"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["p0"] },
      { "cast": "Rethink", "targets": [{ "stack": "Shock" }] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ { "graveyard_has": ["Rethink"], "life": 18 }, { "graveyard_has": ["Shock"] } ] }
  },
  {
    "name": "opponent declines to pay X = 1 and Shock is countered",
    "players": [
      { "hand": ["Rethink"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["p0"] },
      { "cast": "Rethink", "targets": [{ "stack": "Shock" }] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ { "graveyard_has": ["Rethink"], "life": 20 }, { "graveyard_has": ["Shock"] } ] }
  },
  {
    "name": "ruling: Rethink on Grizzly Bears (mana value 2): controller pays 2 on resolution and the spell resolves",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Rethink"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "cast": "Rethink", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ] },
      { "resolve": true, "auto": true, "answers": [true] }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Rethink"] } ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: Rethink on Grizzly Bears: controller declines to pay 2 and the spell is countered",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Rethink"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "cast": "Rethink", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ] },
      { "resolve": true, "auto": true, "answers": [false] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Rethink"] } ],
      "stack_empty": true
    }
  }
]
