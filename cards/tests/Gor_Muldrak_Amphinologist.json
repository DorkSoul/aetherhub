[
  {
    "name": "the player with fewer creatures (the opponent) alone makes a token at my end step",
    "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant", "Salamander Warrior 4-3"] }
    ] }
  },
  {
    "name": "I control the fewest creatures: only I make a token",
    "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist"] },
      { "battlefield": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist", "Salamander Warrior 4-3"] },
      { "battlefield": ["Hill Giant", "Grizzly Bears"] }
    ] }
  },
  {
    "name": "tied for the fewest: both players create a token",
    "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist", "Salamander Warrior 4-3"] },
      { "battlefield": ["Hill Giant", "Salamander Warrior 4-3"] }
    ] }
  },
  {
    "name": "my permanents have protection from Salamanders: an opponent's Amphin Mutineer cannot target my creature",
    "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist", "Grizzly Bears"] },
      { "hand": ["Amphin Mutineer"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [ { "advance_to": "End" }, { "resolve": true }, { "advance_to": "Main1" }, { "cast": "Amphin Mutineer", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist", "Grizzly Bears"] },
      { "battlefield_has": ["Amphin Mutineer", "Salamander Warrior 4-3"] }
    ] }
  },
  { "name": "my permanents have protection from Salamanders: a Salamander cannot block Gor, which hits for 3",
    "players": [ { "battlefield": ["Gor Muldrak, Amphinologist"] }, { "battlefield": [{ "name": "Salamander Warrior 4-3", "sick": false }, "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Gor Muldrak, Amphinologist", "at": "p1" } ] }, { "block": [ { "blocker": "Salamander Warrior 4-3", "attacker": "Gor Muldrak, Amphinologist" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Gor Muldrak, Amphinologist"] }, { "life": 17, "battlefield_has": ["Salamander Warrior 4-3"] } ] } },
  {
    "name": "ruling: Gor himself has protection from Salamanders, so an opponent's Amphin Mutineer cannot exile him",
    "players": [
      { "battlefield": ["Gor Muldrak, Amphinologist"] },
      { "hand": ["Amphin Mutineer"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [ { "advance_to": "End" }, { "resolve": true }, { "advance_to": "Main1" }, { "cast": "Amphin Mutineer", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [
      { "battlefield_has": ["Gor Muldrak, Amphinologist"] },
      { "battlefield_has": ["Amphin Mutineer"] }
    ] }
  }
]
