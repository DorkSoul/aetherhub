[
  { "name": "target creature becomes 0/1 until end of turn",
    "players": [ { "hand": ["Humble"], "battlefield": ["Plains", "Island"] },
                 { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Humble", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "pt": { "Serra Angel": [0, 1] }, "players": [ { "graveyard": ["Humble"] }, {} ] } },
  { "name": "loses its abilities: Dawn Elemental no longer prevents damage",
    "players": [ { "hand": ["Humble"], "battlefield": ["Plains", "Island", "Dawn Elemental"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Humble", "targets": ["Dawn Elemental"] }, { "resolve": true },
               { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["Dawn Elemental"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Humble", "Dawn Elemental"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "not a creature: can't be cast",
    "players": [ { "hand": ["Humble"], "battlefield": ["Plains", "Island"] },
                 { "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Humble", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Humble"] }, {} ] } },
  { "name": "ruling: Humble cast in response to an upkeep trigger does not stop the trigger",
    "players": [ { "hand": ["Consuming Fervor", "Humble"], "battlefield": ["Mountain", "Plains", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Consuming Fervor", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" },
               { "pass": true }, { "pass": true, "player": 1 },
               { "cast": "Humble", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "counters": { "Grizzly Bears": { "m1m1": 1 } }, "pt": { "Grizzly Bears": [2, 3] } } },
  { "name": "ruling: an ability granted after Humble resolves is kept",
    "players": [ { "hand": ["Humble", "Consuming Fervor"], "battlefield": ["Mountain", "Mountain", "Plains", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Humble", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Consuming Fervor", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "counters": { "Grizzly Bears": { "m1m1": 1 } }, "pt": { "Grizzly Bears": [4, 4] } } },
  { "name": "ruling: a pump effect that started before Humble still applies",
    "players": [ { "hand": ["Giant Growth", "Humble"], "battlefield": ["Forest", "Plains", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Humble", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 4] } } }
]
