      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Ravenous Slime", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Ravenous Slime" } ] },
      { "cast": "Tragic Slip", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Ravenous Slime"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ]
