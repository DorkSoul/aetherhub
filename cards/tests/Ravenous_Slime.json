  {
    "name": "ruling: an exiled creature counts the power it had when it died (pumped to 5)",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt", "Giant Growth"], "battlefield": ["Mountain", "Mountain", "Forest", "Ravenous Slime"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ravenous Slime": [6, 6] },
      "players": [ { "graveyard": ["Lightning Bolt", "Lightning Bolt", "Giant Growth"] }, { "exile": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: a dying token is exiled instead and still gives Slime counters",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Ravenous Slime"] },
      { "battlefield": ["Fish 1-1 Unblockable"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Fish 1-1 Unblockable"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ravenous Slime": [2, 2] },
      "players": [ { "graveyard": ["Lightning Bolt"] }, { "battlefield_lacks": ["Fish 1-1 Unblockable"] } ]
    }
  },
  {
    "name": "ruling: a blocked Slime stays blocked when the blocker's power drops below 3",
    "players": [
