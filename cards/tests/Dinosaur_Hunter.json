[
  {
    "name": "damage to a blocking Dinosaur destroys it",
    "players": [
      { "battlefield": ["Dinosaur Hunter"] },
      { "battlefield": ["Dinosaur 3-3"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dinosaur Hunter", "at": "p1" } ] },
      { "block": [ { "blocker": "Dinosaur 3-3", "attacker": "Dinosaur Hunter" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": [] },
        { "battlefield_lacks": ["Dinosaur 3-3"] }
      ]
    }
  },
  {
    "name": "damage to a blocking non-Dinosaur does not destroy it",
    "players": [
      { "battlefield": ["Dinosaur Hunter"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dinosaur Hunter", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Dinosaur Hunter" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dinosaur Hunter"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: on your turn the opponent's Dinosaur's enrage still resolves (2 damage to you)",
    "players": [
      { "battlefield": ["Dinosaur Hunter"] },
      { "battlefield": ["Frilled Deathspitter"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dinosaur Hunter", "at": "p1" } ] },
      { "block": [ { "blocker": "Frilled Deathspitter", "attacker": "Dinosaur Hunter" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 18, "graveyard": ["Dinosaur Hunter"] },
        { "graveyard": ["Frilled Deathspitter"] }
      ]
    }
  },
  {
    "name": "ruling: on the opponent's turn the Dinosaur is gone before its enrage resolves, which still deals 2 damage to you",
    "players": [
      { "battlefield": ["Dinosaur Hunter"] },
      { "battlefield": ["Frilled Deathspitter"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Frilled Deathspitter", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Dinosaur Hunter", "attacker": "Frilled Deathspitter" } ], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 18, "graveyard": ["Dinosaur Hunter"] },
        { "graveyard": ["Frilled Deathspitter"] }
      ]
    }
  }
]
