[
  { "name": "sacrificing a Thrull puts three time counters on the Aura",
    "players": [ { "hand": ["Tourach's Gate"], "battlefield": ["Swamp", "Swamp", "Swamp", "Thrull Wizard"] }, {} ],
    "steps": [
      { "cast": "Tourach's Gate", "targets": ["Swamp"] },
      { "resolve": true },
      { "activate": "Tourach's Gate" },
      { "resolve": true }
    ],
    "expect": { "counters": { "Tourach's Gate": { "time": 3 } }, "players": [ { "graveyard": ["Thrull Wizard"] }, {} ] } },
  { "name": "upkeep removes a time counter and the Aura stays while counters remain",
    "players": [ { "hand": ["Tourach's Gate"], "battlefield": ["Swamp", "Swamp", "Swamp", "Thrull Wizard"] }, {} ],
    "steps": [
      { "cast": "Tourach's Gate", "targets": ["Swamp"] },
      { "resolve": true },
      { "activate": "Tourach's Gate" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "counters": { "Tourach's Gate": { "time": 2 } }, "players": [ { "battlefield_has": ["Tourach's Gate"] }, {} ] } },
  { "name": "tapping the untapped enchanted land gives attacking creatures +2/-1",
    "players": [ { "hand": ["Tourach's Gate"], "battlefield": ["Swamp", "Swamp", "Swamp", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Tourach's Gate", "targets": ["Forest"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "activate": "Tourach's Gate", "ability": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ], "pt": { "Grizzly Bears": [4, 1] } } },
  { "name": "a tapped enchanted land cannot pay for the attack pump",
    "players": [ { "hand": ["Tourach's Gate"], "battlefield": ["Swamp", "Swamp", "Swamp", { "name": "Forest", "tapped": true }, "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Tourach's Gate", "targets": ["Forest"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "activate": "Tourach's Gate", "ability": 1, "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ], "pt": { "Grizzly Bears": [2, 2] } } }
]
