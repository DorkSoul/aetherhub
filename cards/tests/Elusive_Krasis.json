[
  {
    "name": "evolves when a creature with greater power enters",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Elusive Krasis"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Elusive Krasis", "Grizzly Bears"] }, {} ],
      "pt": { "Elusive Krasis": [1, 5] }
    }
  },
  {
    "name": "has unblockable and evolve",
    "players": [ { "battlefield": ["Elusive Krasis"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Elusive Krasis"] }, {} ],
      "keywords": { "Elusive Krasis": ["Unblockable", "Evolve"] },
      "pt": { "Elusive Krasis": [0, 4] }
    }
  },
  {
    "name": "ruling: toughness alone is enough to trigger evolve (0/8 Wall of Stone vs Krasis 0/4)",
    "players": [ { "hand": ["Wall of Stone"], "battlefield": ["Mountain", "Mountain", "Forest", "Elusive Krasis"] }, {} ],
    "steps": [ { "cast": "Wall of Stone" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Elusive Krasis", "Wall of Stone"] }, {} ], "pt": { "Elusive Krasis": [1, 5] } }
  },
  {
    "name": "ruling: a creature with neither power nor toughness greater does not trigger evolve (Steel Wall 0/4)",
    "players": [ { "hand": ["Steel Wall"], "battlefield": ["Forest", "Elusive Krasis"] }, {} ],
    "steps": [ { "cast": "Steel Wall" }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Elusive Krasis", "Steel Wall"] }, {} ], "pt": { "Elusive Krasis": [0, 4] } }
  },
  {
    "name": "ruling: evolve uses last known P/T if the entering creature dies in response (Bolt on Grizzly Bears)",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Elusive Krasis"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Elusive Krasis"], "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ], "pt": { "Elusive Krasis": [1, 5] } }
  }
]
