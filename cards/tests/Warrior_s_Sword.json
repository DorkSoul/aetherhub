[
  { "name": "job select: Hero token equipped, 4/3 and a Warrior",
    "players": [ { "hand": ["Warrior's Sword"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Warrior's Sword" }, { "resolve": true } ],
    "expect": { "attached": { "Warrior's Sword": "Hero" }, "pt": { "Hero": [4, 3] } } },
  { "name": "equip {5} moves it to another creature",
    "players": [ { "battlefield": ["Warrior's Sword", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Warrior's Sword", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "attached": { "Warrior's Sword": "Grizzly Bears" }, "pt": { "Grizzly Bears": [5, 4] } } },
  { "name": "job select Hero token is also a Warrior",
    "players": [ { "hand": ["Warrior's Sword"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Warrior's Sword" }, { "resolve": true } ],
    "expect": { "subtypes": { "Hero": ["Warrior"] } } },
  { "name": "the equipped creature is a Warrior",
    "players": [ { "battlefield": ["Warrior's Sword", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Warrior's Sword", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "subtypes": { "Grizzly Bears": ["Warrior"] } } },
  { "name": "ruling: destroying the Hero token leaves the Equipment on the battlefield",
    "players": [ { "hand": ["Warrior's Sword", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Warrior's Sword" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Hero"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Warrior's Sword"], "battlefield_lacks": ["Hero"] }, {} ] } },
  { "name": "ruling: equip moves the Equipment off the Hero token onto another creature (Hero stays as a 1/1)",
    "players": [ { "hand": ["Warrior's Sword"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Warrior's Sword" }, { "resolve": true }, { "activate": "Warrior's Sword", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "attached": { "Warrior's Sword": "Grizzly Bears" }, "pt": { "Grizzly Bears": [5, 4], "Hero": [1, 1] } } }
]
