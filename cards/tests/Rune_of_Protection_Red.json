   "steps": [ { "activate": "Rune of Protection: Red", "ability": 1, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Rune of Protection: Red"] }, {} ] } },
 { "name": "ruling: activated before any damage, it still prevents the next red damage this turn",
   "players": [ { "battlefield": ["Hill Giant"] },
                { "battlefield": ["Rune of Protection: Red", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "pass": true },
