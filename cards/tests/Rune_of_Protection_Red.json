   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "pass": true },
              { "activate": "Rune of Protection: Red", "player": 1 },
              { "resolve": true },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "cycling {2}: discard Rune, draw a card",
   "players": [ { "hand": ["Rune of Protection: Red"], "battlefield": ["Plains", "Plains"], "library": ["Island"] }, {} ],
   "steps": [ { "activate": "Rune of Protection: Red", "ability": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island"], "graveyard_has": ["Rune of Protection: Red"] }, {} ] } },
 { "name": "cycling needs {2}: one land is not enough",
