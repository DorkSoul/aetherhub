    "steps": [ { "attack": [ { "card": "Scion of Darkness", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Scion of Darkness" } ] }, { "advance_to": "End", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Scion of Darkness", "Grizzly Bears"] }, { "life": 16, "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "combat damage: put a creature card from that player's graveyard onto the battlefield under my control",
