    "steps": [ { "activate": "Scion of Darkness", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Scion of Darkness"] }, {} ] } },
  { "name": "cycling needs three mana: illegal with two lands",
