   "players": [ { "hand": [ "Lobelia, Defender of Bag End" ], "battlefield": [ "Swamp", "Swamp", "Swamp", "Sol Ring" ] }, { "library": [ "Forest" ] } ],
   "steps": [ { "cast": "Lobelia, Defender of Bag End" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" },
              { "advance_to": "End" }, { "advance_to": "Main1" }, { "advance_to": "End" },
              { "activate": "Lobelia, Defender of Bag End" }, { "resolve": true, "answers": [ [ 0 ] ] }, { "play_land": "Forest", "illegal": true } ],
   "expect": { "players": [ { "battlefield_lacks": [ "Forest" ] }, { "exile": [ "Forest" ] } ] } }
