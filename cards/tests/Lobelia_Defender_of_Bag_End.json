 { "name": "mode 1 permission ends with the turn: the exiled card can no longer be cast",
   "players": [ { "hand": [ "Lobelia, Defender of Bag End" ], "battlefield": [ "Swamp", "Swamp", "Swamp", "Sol Ring", "Forest" ] }, { "library": [ "Llanowar Elves" ] } ],
   "steps": [ { "cast": "Lobelia, Defender of Bag End" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" },
              { "advance_to": "End" }, { "advance_to": "Main1" },
              { "activate": "Lobelia, Defender of Bag End" }, { "resolve": true, "answers": [ [ 0 ] ] }, { "advance_to": "End" }, { "advance_to": "Main1" }, { "advance_to": "End" }, { "advance_to": "Main1" },
              { "cast": "Llanowar Elves", "illegal": true } ],
   "expect": { "players": [ { "battlefield_lacks": [ "Llanowar Elves" ] }, { "exile": [ "Llanowar Elves" ] } ] } },
 { "name": "mode 2: each opponent loses 2 life and you gain 2 life",
   "players": [ { "hand": [ "Lobelia, Defender of Bag End" ], "battlefield": [ "Swamp", "Swamp", "Swamp", "Sol Ring" ] }, { "library": [ "Llanowar Elves" ] } ],
   "steps": [ { "cast": "Lobelia, Defender of Bag End" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" },
              { "advance_to": "End" }, { "advance_to": "Main1" },
              { "activate": "Lobelia, Defender of Bag End" }, { "resolve": true, "answers": [ [ 1 ] ] } ],
   "expect": { "players": [ { "life": 22, "battlefield_has": [ "Lobelia, Defender of Bag End" ] }, { "life": 18, "exile": [ "Llanowar Elves" ] } ] } },
 { "name": "ruling: a card cast without paying its cost has X = 0 (Fireball deals no damage)",
   "players": [ { "hand": [ "Lobelia, Defender of Bag End" ], "battlefield": [ "Swamp", "Swamp", "Swamp", "Sol Ring" ] }, { "library": [ "Fireball" ] } ],
   "steps": [ { "cast": "Lobelia, Defender of Bag End" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" },
              { "advance_to": "End" }, { "advance_to": "Main1" },
              { "activate": "Lobelia, Defender of Bag End" }, { "resolve": true, "answers": [ [ 0 ] ] }, { "cast": "Fireball", "targets": [ "p1" ] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": [ "Sol Ring" ] }, { "life": 20, "graveyard": [ "Fireball" ] } ] } },
 { "name": "ruling: an exiled land can be played in a main phase with the stack empty",
   "players": [ { "hand": [ "Lobelia, Defender of Bag End" ], "battlefield": [ "Swamp", "Swamp", "Swamp", "Sol Ring" ] }, { "library": [ "Forest" ] } ],
   "steps": [ { "cast": "Lobelia, Defender of Bag End" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" },
              { "advance_to": "End" }, { "advance_to": "Main1" },
              { "activate": "Lobelia, Defender of Bag End" }, { "resolve": true, "answers": [ [ 0 ] ] }, { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": [ "Lobelia, Defender of Bag End", "Forest" ] }, {} ] } },
