   "steps": [ { "cast": "Lobelia, Defender of Bag End" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": [ "Lobelia, Defender of Bag End" ], "exile": [] }, { "exile": [ "Llanowar Elves" ] } ] } },
 { "name": "mode 1: sacrifice an artifact, then cast the exiled card for free this turn",
