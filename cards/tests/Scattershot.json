[
  {
    "name": "deals 1 damage to a creature",
    "players": [
      { "hand": ["Scattershot"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "cast": "Scattershot", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Scattershot"] }, { "graveyard": ["Savannah Lions"] } ]
    }
  },
  {
    "name": "a bigger creature survives 1 damage",
    "players": [
      { "hand": ["Scattershot"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Scattershot", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Scattershot"] }, { "battlefield": ["Grizzly Bears"] } ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "needs a creature target",
    "players": [
      { "hand": ["Scattershot"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Scattershot", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Scattershot"] }, {} ]
    }
  },
  {
    "name": "ruling: a countered spell still counts for storm (Bolt countered, then Scattershot gets 1 copy)",
    "players": [
      { "hand": ["Lightning Bolt", "Scattershot"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Scattershot", "targets": ["Grizzly Bears"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Scattershot"] },
        { "life": 20, "graveyard": ["Counterspell", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a storm copy may get new targets (Bears survives, Savannah Lions is hit by the copy)",
    "players": [
      { "hand": ["Lightning Bolt", "Scattershot"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Savannah Lions"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Scattershot", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": ["Savannah Lions"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Scattershot"] },
        { "life": 17, "graveyard": ["Savannah Lions"], "battlefield": ["Grizzly Bears"] }
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: Stifle on the storm trigger means no copies, so Grizzly Bears takes only 1",
    "players": [
      { "hand": ["Lightning Bolt", "Scattershot"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Stifle"], "battlefield": ["Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Scattershot", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Scattershot" }] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Scattershot"] },
        { "life": 17, "graveyard": ["Stifle"], "battlefield_has": ["Grizzly Bears"] }
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]
