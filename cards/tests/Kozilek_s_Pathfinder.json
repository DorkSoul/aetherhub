[
  {
    "name": "target creature can't block it this turn",
    "players": [
      { "battlefield": ["Kozilek's Pathfinder", "Wastes"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Kozilek's Pathfinder", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Kozilek's Pathfinder", "at": "p1" }] },
      { "block": [], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [{}, { "life": 15, "battlefield": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "other creatures can still block it",
    "players": [
      { "battlefield": ["Kozilek's Pathfinder", "Wastes"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Kozilek's Pathfinder", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Kozilek's Pathfinder", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Kozilek's Pathfinder" }], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Hill Giant"], "battlefield": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "needs colorless mana",
    "players": [
      { "battlefield": ["Kozilek's Pathfinder", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Kozilek's Pathfinder", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "battlefield": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: a blocker already declared keeps blocking after the can't-block ability resolves",
    "players": [
      { "battlefield": ["Kozilek's Pathfinder", "Wastes"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Kozilek's Pathfinder", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Kozilek's Pathfinder" }], "player": 1 },
      { "activate": "Kozilek's Pathfinder", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Kozilek's Pathfinder"] }, { "graveyard": ["Hill Giant"], "life": 20 }]
    }
  }
]
