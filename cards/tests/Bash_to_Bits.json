[
  { "name": "destroys target artifact",
    "players": [ { "hand": ["Bash to Bits"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Arc Reactor"] } ],
    "steps": [ { "cast": "Bash to Bits", "targets": ["Arc Reactor"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Bash to Bits"] }, { "graveyard": ["Arc Reactor"] } ] } },
  { "name": "flashback for {4}{R}{R} exiles it afterward",
    "players": [ { "graveyard": ["Bash to Bits"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Arc Reactor"] } ],
    "steps": [ { "cast": "Bash to Bits", "alt": 0, "targets": ["Arc Reactor"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Bash to Bits"], "graveyard": [] }, { "graveyard": ["Arc Reactor"] } ] } },
  { "name": "ruling: a flashback spell that is countered is still exiled",
    "players": [ { "graveyard": ["Bash to Bits"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Arc Reactor", "Island", "Island"] } ],
    "steps": [ { "cast": "Bash to Bits", "alt": 0, "targets": ["Arc Reactor"] }, { "pass": true }, { "cast": "Counterspell", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Bash to Bits"], "graveyard": [] }, { "graveyard_has": ["Counterspell"], "battlefield_has": ["Arc Reactor"] } ] } },
  { "name": "ruling: flashback follows the instant's timing and can be cast in the opponent's turn",
    "players": [ { "graveyard": ["Bash to Bits"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Arc Reactor"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Bash to Bits", "alt": 0, "targets": ["Arc Reactor"], "player": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Bash to Bits"], "graveyard": [] }, { "graveyard": ["Arc Reactor"] } ] } }
]
