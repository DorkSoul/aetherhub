  ],
  "expect": {
   "players": [
    {},
    { "life": 13 }
   ]
  }
 },
 {
  "name": "ruling: each other creature you control can also assign its damage as though unblocked",
  "players": [
   { "battlefield": [ { "name": "Siege Behemoth", "sick": false }, { "name": "Hill Giant", "sick": false } ] },
