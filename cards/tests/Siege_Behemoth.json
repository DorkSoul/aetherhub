  ],
  "steps": [
   { "attack": [ { "card": "Siege Behemoth", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
   { "block": [ { "blocker": "Grizzly Bears", "attacker": "Siege Behemoth" }, { "blocker": "Serra Angel", "attacker": "Hill Giant" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
