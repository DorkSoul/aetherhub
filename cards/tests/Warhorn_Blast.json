[
  { "name": "creatures you control get +2/+1 until end of turn; opposing creatures do not",
    "players": [ { "hand": ["Warhorn Blast"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Hill Giant"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Warhorn Blast" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Warhorn Blast"] }, {} ],
                "pt": { "Hill Giant": [5, 4], "Grizzly Bears": [2, 2] } } },
  { "name": "foretold for {2}, then cast from exile for {2}{W} on a later turn",
    "players": [ { "hand": ["Warhorn Blast"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Hill Giant"] }, {} ],
    "steps": [ { "activate": "Warhorn Blast", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Warhorn Blast", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Warhorn Blast"] }, {} ], "pt": { "Hill Giant": [5, 4] } } },
  { "name": "a foretold card cannot be cast on the turn it was foretold",
    "players": [ { "hand": ["Warhorn Blast"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Warhorn Blast", "ability": 0 }, { "resolve": true }, { "cast": "Warhorn Blast", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Warhorn Blast"] }, {} ] } },
  { "name": "ruling: a foretold instant can be cast on the opponent's turn",
    "players": [ { "hand": ["Warhorn Blast"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Hill Giant"] }, {} ],
    "steps": [ { "activate": "Warhorn Blast", "ability": 0 }, { "resolve": true }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Warhorn Blast", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Warhorn Blast"] }, {} ], "pt": { "Hill Giant": [5, 4] } } },
  { "name": "ruling: foretelling is a special action that can be taken in response to a spell",
    "players": [ { "hand": ["Lightning Bolt", "Warhorn Blast"], "battlefield": ["Mountain", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "activate": "Warhorn Blast", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Warhorn Blast"], "graveyard_has": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } }
]
