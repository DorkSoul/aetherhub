[
  {
    "name": "attacks after sacrificing a land",
    "players": [
      {
        "battlefield": [
          "Exalted Dragon",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Exalted Dragon",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Plains"
          ]
        },
        {
          "life": 15
        }
      ]
    }
  },
  {
    "name": "cannot attack without a land to sacrifice",
    "players": [
      {
        "battlefield": [
          "Exalted Dragon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Exalted Dragon",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 20
        }
      ],
      "tapped": {
        "Exalted Dragon": false
      }
    }
  },
  {
    "name": "other creatures attack without sacrificing a land",
    "players": [
      {
        "battlefield": [
          "Exalted Dragon",
          "Grizzly Bears",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Plains"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "ruling: the land sacrifice is additive with another attack cost: Ghostly Prison's {2} is also paid",
    "players": [ { "battlefield": ["Exalted Dragon", "Plains", "Plains", "Plains"] }, { "battlefield": ["Ghostly Prison"] } ],
    "steps": [
      { "attack": [ { "card": "Exalted Dragon", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 15 } ] }
  },
  {
    "name": "ruling: with only two lands the sacrifice leaves one, which cannot also pay Ghostly Prison's {2}, so no attack",
    "players": [ { "battlefield": ["Exalted Dragon", "Plains", "Plains"] }, { "battlefield": ["Ghostly Prison"] } ],
    "steps": [
      { "attack": [ { "card": "Exalted Dragon", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20 } ], "tapped": { "Exalted Dragon": false } }
  }
]
