      { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Swamp"], "graveyard": ["Bump in the Night"] },
      {}
    ],
    "steps": [
      { "cast": "Bump in the Night", "alt": 0, "illegal": true }
