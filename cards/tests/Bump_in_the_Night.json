    "expect": { "players": [ { "graveyard": ["Bump in the Night"] }, { "life": 20 } ] }
  },
  {
    "name": "ruling: flashback follows sorcery timing, so it can't be cast during combat",
    "players": [
      { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Swamp"], "graveyard": ["Bump in the Night"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Bump in the Night", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "graveyard": ["Bump in the Night"] }, { "life": 20 } ] }
