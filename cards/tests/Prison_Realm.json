[
  { "name": "exiles an opposing creature until it leaves; scry 1",
    "players": [ { "hand": ["Prison Realm"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Prison Realm" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Prison Realm"] }, { "exile": ["Hill Giant"], "battlefield": [] } ] } },
  { "name": "no opposing creature: nothing exiled, scry still happens",
    "players": [ { "hand": ["Prison Realm"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Forest"] }, { "battlefield": [] } ],
    "steps": [ { "cast": "Prison Realm" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Prison Realm"], "hand": [] }, {} ] } },
  { "name": "ruling: scry 1 still happens with no opposing creature to exile",
    "players": [ { "hand": ["Prison Realm"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Lightning Bolt", "Forest"] }, {} ],
    "steps": [ { "cast": "Prison Realm" }, { "resolve": true, "answers": [["Lightning Bolt"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Prison Realm"], "library_top": ["Forest"] }, {} ] } },
  { "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard",
    "players": [ { "hand": ["Stay Hidden, Stay Silent", "Prison Realm"], "battlefield": ["Island", "Island", "Plains", "Plains", "Plains"], "library": ["Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Stay Hidden, Stay Silent", "targets": ["Hill Giant"] }, { "resolve": true }, { "cast": "Prison Realm" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Stay Hidden, Stay Silent"], "battlefield_has": ["Prison Realm"] }, { "exile": ["Hill Giant"] } ] } }
]
