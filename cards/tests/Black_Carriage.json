[
 {
  "name": "does not untap in your untap step; sacrifice a creature in upkeep to untap it",
  "players": [
   {
    "battlefield": [
     {
      "name": "Black Carriage",
      "tapped": true
     },
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep"
   },
   {
    "activate": "Black Carriage",
    "answers": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Grizzly Bears"
     ],
     "battlefield_has": [
      "Black Carriage"
     ]
    },
    {}
   ],
   "tapped": {
    "Black Carriage": false
   }
  }
 },
 {
  "name": "cannot be untapped outside your upkeep",
  "players": [
   {
    "battlefield": [
     {
      "name": "Black Carriage",
      "tapped": true
     },
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Black Carriage",
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Black Carriage": true
   }
  }
 },
 {
  "name": "a tapped Carriage stays tapped through your untap step",
  "players": [{"battlefield": [{"name": "Black Carriage", "tapped": true}, "Grizzly Bears"]}, {}],
  "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}],
  "expect": {"tapped": {"Black Carriage": true}}
 },
 {
  "name": "ruling: the upkeep untap has no limit; a second untap in the same upkeep works too",
  "players": [ {"battlefield": [{"name": "Black Carriage", "tapped": true}, "Grizzly Bears", "Grizzly Bears"]}, {} ],
  "steps": [
   {"advance_to": "Upkeep"},
   {"advance_to": "Upkeep"},
   {"activate": "Black Carriage", "answers": ["Grizzly Bears"]},
   {"resolve": true},
   {"activate": "Black Carriage", "answers": ["Grizzly Bears"]},
   {"resolve": true}
  ],
  "expect": {
   "players": [ {"graveyard": ["Grizzly Bears", "Grizzly Bears"], "battlefield_has": ["Black Carriage"]}, {} ],
   "tapped": {"Black Carriage": false}
  }
 }
]
