[
  {
    "name": "returns to hand when the enchanted creature dies",
    "players": [
      { "hand": ["Unquenchable Fury", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Unquenchable Fury", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Unquenchable Fury"], "graveyard_has": ["Lightning Bolt"] }, {} ]
    }
  },
  {
    "name": "the aura is attached to the creature",
    "players": [
      { "hand": ["Unquenchable Fury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Unquenchable Fury", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Unquenchable Fury": "Grizzly Bears" }
    }
  },
  {
    "name": "enchanted attacker deals damage equal to the defending player's hand size on attack",
    "players": [
      { "hand": ["Unquenchable Fury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Unquenchable Fury", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 15 } ] }
  },
  {
    "name": "defending player with an empty hand: the attack trigger deals no damage",
    "players": [
      { "hand": ["Unquenchable Fury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Unquenchable Fury", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  }
]
