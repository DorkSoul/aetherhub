[
  { "name": "may play a land from the top of the library",
    "players": [ { "battlefield": ["Future Sight"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Future Sight"] }, {} ] } },
  { "name": "may cast a spell from the top of the library",
    "players": [ { "battlefield": ["Future Sight", "Forest", "Forest"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "without Future Sight the top card of the library cannot be played",
    "players": [ { "battlefield": ["Forest"], "library": ["Forest"] }, {} ],
    "steps": [ { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, {} ] } },
  { "name": "ruling: a sorcery-speed top card cannot be cast during combat",
    "players": [ { "battlefield": ["Future Sight", "Forest", "Forest"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "library_top": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a land on top: only one land a turn, so the next top land cannot be played",
    "players": [ { "battlefield": ["Future Sight"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "play_land": "Island", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Future Sight"], "library_top": ["Island"] }, {} ] } }
