[
 { "name": "prevents noncombat damage dealt to it",
   "players": [ { "battlefield": ["Cho-Manno, Revolutionary"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Cho-Manno, Revolutionary"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Cho-Manno, Revolutionary"] }, { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "prevents combat damage dealt to it",
   "players": [ { "battlefield": ["Hill Giant"] },
                { "battlefield": ["Cho-Manno, Revolutionary", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [ { "blocker": "Cho-Manno, Revolutionary", "attacker": "Hill Giant" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "battlefield_has": ["Cho-Manno, Revolutionary"] } ] } },
 { "name": "damage to the player is not prevented",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                { "battlefield": ["Cho-Manno, Revolutionary"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ] } }
]
