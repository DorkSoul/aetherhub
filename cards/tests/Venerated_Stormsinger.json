[
  {
    "name": "mobilize 1: a tapped attacking Warrior joins the attack",
    "players": [
      { "battlefield": ["Venerated Stormsinger"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Venerated Stormsinger", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Venerated Stormsinger", "Warrior 1-1 R"] }, { "life": 16 } ]
    }
  },
  {
    "name": "dies: each opponent loses 1 and you gain 1",
    "players": [
      { "battlefield": ["Venerated Stormsinger"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Venerated Stormsinger", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Venerated Stormsinger" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 21, "graveyard": ["Venerated Stormsinger"] }, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: a Warrior token entering attacking does not trigger 'whenever a creature attacks' abilities",
    "players": [ { "battlefield": ["Venerated Stormsinger", "Hellrider"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Venerated Stormsinger", "at": "p1" }, { "card": "Hellrider", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Venerated Stormsinger", "Hellrider", "Warrior 1-1 R"] }, { "life": 11 } ] }
  }
