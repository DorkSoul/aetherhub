[
  {
    "name": "casts a colorless artifact spell from the top of the library",
    "players": [
      { "battlefield": ["Mystic Forge", "Forest"], "library": ["Sol Ring", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Sol Ring", "Mystic Forge"] },
        {}
      ]
    }
  },
  {
    "name": "cannot cast a colored nonartifact spell from the top of the library",
    "players": [
      { "battlefield": ["Mystic Forge", "Forest", "Forest"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "library_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "cannot play a land from the top of the library",
    "players": [
      { "battlefield": ["Mystic Forge"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest", "illegal": true }
    ],
    "expect": {
      "players": [
        { "library_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "tap and pay 1 life to exile the top card of the library",
    "players": [
      { "battlefield": ["Mystic Forge"], "library": ["Grizzly Bears", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Mystic Forge" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Grizzly Bears"], "life": 19 },
        {}
      ]
    }
  },
  {
    "name": "casts a coloured artifact spell from the top of the library",
    "players": [
      { "battlefield": ["Mystic Forge", "Mountain"], "library": ["Boots of Speed", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Boots of Speed" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boots of Speed", "Mystic Forge"] },
        {}
      ]
    }
  },
  {
    "name": "casts a colorless creature spell from the top of the library",
    "players": [
      { "battlefield": ["Mystic Forge", "Wastes", "Wastes", "Wastes"], "library": ["Matter Reshaper", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Matter Reshaper" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Matter Reshaper", "Mystic Forge"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an artifact land on top cannot be played from the library (lands are not cast)",
    "players": [
      {"battlefield": ["Mystic Forge"], "library": ["Ancient Den"]},
      {}
    ],
    "steps": [
      {"play_land": "Ancient Den", "illegal": true}
    ],
    "expect": {"players": [{"library_count": 1}, {}]}
  },
  {
    "name": "ruling: a sorcery-speed artifact creature on top cannot be cast on the opponent's turn",
    "players": [
      {"battlefield": ["Mystic Forge"], "library": ["Ornithopter"]},
      {}
    ],
    "steps": [
      {"advance_to": "Main2"},
      {"advance_to": "Main1"},
      {"pass": true, "player": 1},
      {"cast": "Ornithopter", "illegal": true}
    ],
    "expect": {"players": [{"library_top": ["Ornithopter"]}, {}]}
  }
]
