[
  {
    "name": "instant and sorcery spells cost 1 less",
    "players": [
      {
        "hand": [
          "Divination"
        ],
        "battlefield": [
          "Jace's Sanctum",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Divination"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "without the enchantment the spell costs full price",
    "players": [
      {
        "hand": [
          "Divination"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Divination",
        "illegal": true
      }
    ]
  },
  {
    "name": "ruling: the reduction only pays generic mana, so a {U} sorcery with no generic part is not made free",
    "players": [
      {
        "hand": ["Ponder"],
        "battlefield": ["Jace's Sanctum"]
      },
      {}
    ],
    "steps": [
      { "cast": "Ponder", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Ponder"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the scry trigger resolves before the sorcery that caused it (bottom the Forest, then Divination draws the Island and Swamp)",
    "players": [
      {
        "hand": ["Divination"],
        "battlefield": ["Jace's Sanctum", "Island", "Island"],
        "library": ["Forest", "Island", "Swamp"]
      },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true, "answers": [[0]] }
    ],
    "expect": {
      "players": [
        { "hand": ["Island", "Swamp"], "library_top": ["Forest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the reduction applies to an overload cost: Vandalblast's overload {4}{R} costs {3}{R} with Jace's Sanctum",
    "players": [
      {
        "hand": ["Vandalblast"],
        "battlefield": ["Jace's Sanctum", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Sol Ring"]
      }
    ],
    "steps": [
      { "cast": "Vandalblast", "alt": 0 },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Vandalblast"] },
        { "graveyard": ["Sol Ring"] }
      ]
    }
  }
]
