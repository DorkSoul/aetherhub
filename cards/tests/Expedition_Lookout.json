[
  {"name": "attacks unblocked once an opponent has eight cards in graveyard",
   "players": [{"battlefield": ["Island", "Expedition Lookout"]}, {"battlefield": ["Grizzly Bears"], "graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}],
   "steps": [
     {"attack": [{"card": "Expedition Lookout", "at": "p1"}]},
     {"block": [{"blocker": "Grizzly Bears", "attacker": "Expedition Lookout"}], "illegal": true},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"battlefield_has": ["Expedition Lookout"]}, {"life": 18}]}
  },
  {"name": "cannot attack with seven cards in opponent graveyard",
   "players": [{"battlefield": ["Island", "Expedition Lookout"]}, {"graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}],
   "steps": [{"attack": [], "illegal": true}],
   "expect": {"players": [{"battlefield_has": ["Expedition Lookout"]}, {"life": 20}]}
  },
  {"name": "unblockable at eight cards in opponent graveyard: the declared block on it is dropped",
   "players": [{"battlefield": ["Expedition Lookout", "Hill Giant"]}, {"battlefield": ["Grizzly Bears", "Wall of Stone"], "graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}],
   "steps": [
     {"attack": [{"card": "Expedition Lookout", "at": "p1"}, {"card": "Hill Giant", "at": "p1"}]},
     {"block": [{"blocker": "Grizzly Bears", "attacker": "Expedition Lookout"}, {"blocker": "Wall of Stone", "attacker": "Hill Giant"}]},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"battlefield_has": ["Expedition Lookout"]}, {"life": 18}]}
  },
  {"name": "ruling: only an opponent's graveyard counts, not your own",
   "players": [{"battlefield": ["Island", "Expedition Lookout"], "graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}, {"graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}],
   "steps": [{"attack": [{"card": "Expedition Lookout", "at": "p1"}], "illegal": true}],
   "expect": {"players": [{"battlefield_has": ["Expedition Lookout"]}, {"life": 20}]}
  },
  {"name": "ruling: graveyard cards removed while attacking do not stop it; before blocks it can be blocked",
   "players": [{"battlefield": ["Tormod's Crypt", "Expedition Lookout"]}, {"battlefield": ["Grizzly Bears"], "graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}],
   "steps": [
     {"attack": [{"card": "Expedition Lookout", "at": "p1"}]},
     {"activate": "Tormod's Crypt", "targets": ["p1"]},
     {"resolve": true},
     {"block": [{"blocker": "Grizzly Bears", "attacker": "Expedition Lookout"}]},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"battlefield_has": ["Expedition Lookout"]}, {"life": 20, "graveyard_has": ["Grizzly Bears"]}]}
  }
]
