      {},
      {
        "battlefield": [
          "Teferi's Ageless Insight"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "turn": 2,
      "players": [
        {},
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "only its controller's draws are doubled",
    "players": [
      {
        "hand": [
          "Divination"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Teferi's Ageless Insight"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a land put into hand by Six is not a draw, so it is not doubled",
    "players": [
      {
        "battlefield": ["Teferi's Ageless Insight", "Six"]
      },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Six", "at": "p1" }] },
      { "advance_to": "CombatDamage", "answers": [["Forest"]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "hand_count": 1 },
        {}
      ]
    }
  }
