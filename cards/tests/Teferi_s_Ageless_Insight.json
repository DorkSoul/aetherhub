[
  {
    "name": "extra draws are doubled (Divination draws four)",
    "players": [
      {
        "hand": [
          "Divination"
        ],
        "battlefield": [
          "Teferi's Ageless Insight",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 4,
          "graveyard": [
            "Divination"
          ]
        }
      ]
