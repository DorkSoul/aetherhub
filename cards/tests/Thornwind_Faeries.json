[
  {
    "name": "taps to deal 1 damage to a 1/1",
    "players": [
      { "battlefield": ["Thornwind Faeries"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Thornwind Faeries", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Llanowar Elves"] }],
      "tapped": { "Thornwind Faeries": true }
    }
  },
  {
    "name": "1 damage does not kill a 2/2",
    "players": [
      { "battlefield": ["Thornwind Faeries"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Thornwind Faeries", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "cannot tap again while tapped",
    "players": [
      { "battlefield": [{ "name": "Thornwind Faeries", "tapped": true }] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Thornwind Faeries", "targets": ["Llanowar Elves"], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "battlefield": ["Llanowar Elves"] }]
    }
  }
]
