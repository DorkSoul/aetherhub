[
  {
    "name": "unique most life player gains control at upkeep",
    "players": [
      {
        "battlefield": ["Wild Dogs"],
        "life": 10
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Wild Dogs"] },
        { "battlefield_has": ["Wild Dogs"] }
      ]
    }
  },
  {
    "name": "tied for most life: control does not change",
    "players": [
      {
        "battlefield": ["Wild Dogs"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Wild Dogs"] },
        { "battlefield_lacks": ["Wild Dogs"] }
      ]
    }
  },
  {
    "name": "cycling {2}: discard to draw a card",
    "players": [
      {
        "hand": ["Wild Dogs"],
        "battlefield": ["Island", "Island"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Wild Dogs" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "graveyard": ["Wild Dogs"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: tie when the trigger resolves leaves control unchanged",
    "players": [
      { "battlefield": ["Wild Dogs"] },
      { "life": 25 }
    ],
    "steps": [
      { "advance_to": "Upkeep", "hold": true },
      { "set_life": 20, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Wild Dogs"] },
        { "battlefield_lacks": ["Wild Dogs"] }
      ]
    }
  }
]
