      },
      {}
    ],
    "steps": [
      { "cast": "Watcher of the Roost", "alt": 254 },
      { "resolve": true },
      { "activate": "Watcher of the Roost", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        {}
      ]
    }
  },
  {
    "name": "ruling: face-down spell costs generic {3} (no white needed) and enters as a 2/2",
    "players": [ { "hand": ["Watcher of the Roost"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Watcher of the Roost", "alt": 254 }, { "resolve": true } ],
    "expect": { "pt": { "Watcher of the Roost": [2, 2] } }
  },
  {
    "name": "ruling: face-down cast costs {3}, two lands are not enough",
    "players": [ { "hand": ["Watcher of the Roost"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Watcher of the Roost", "alt": 254, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Watcher of the Roost"] }, {} ] }
  },
  {
    "name": "ruling: a face-down spell on the stack cannot be turned face up",
    "players": [ { "hand": ["Watcher of the Roost", "Savannah Lions"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Watcher of the Roost", "alt": 254 }, { "activate": "Watcher of the Roost", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Savannah Lions"] }, {} ] }
