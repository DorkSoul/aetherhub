[
 {
  "name": "destroys an artifact, then populates a creature token",
  "players": [
   {
    "hand": [
     "Sundering Growth"
    ],
    "battlefield": [
     "Forest",
     "Plains",
     "Servo"
    ]
   },
   {
    "battlefield": [
     "Sol Ring"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Sundering Growth",
    "targets": [
     "Sol Ring"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Sundering Growth"
     ],
     "battlefield_has": [
      "Servo"
     ]
    },
    {
     "graveyard": [
      "Sol Ring"
     ]
    }
   ]
  }
 },
 {
  "name": "hybrid cost can be paid with any mix of green and white",
  "players": [
   {
    "hand": [
     "Sundering Growth"
    ],
    "battlefield": [
     "Forest",
     "Forest"
    ]
   },
   {
    "battlefield": [
     "Glorious Anthem"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Sundering Growth",
    "targets": [
     "Glorious Anthem"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Sundering Growth"
     ]
    },
    {
     "graveyard": [
      "Glorious Anthem"
     ]
    }
   ]
  }
 },
 {
  "name": "can't target a creature",
  "players": [
   {
    "hand": [
     "Sundering Growth"
    ],
    "battlefield": [
     "Forest",
     "Forest"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Sundering Growth",
    "targets": [
     "Grizzly Bears"
    ],
    "illegal": true
   }
  ],
  "expect": {}
 },
 {
  "name": "ruling: if the target is gone on resolution, nothing happens and nothing populates",
  "players": [
   { "hand": ["Sundering Growth"], "battlefield": ["Forest", "Plains", "Servo"] },
   { "hand": ["Disenchant"], "battlefield": ["Sol Ring", "Plains", "Plains"] }
  ],
  "steps": [
   { "cast": "Sundering Growth", "targets": ["Sol Ring"] },
   { "pass": true },
   { "cast": "Disenchant", "targets": ["Sol Ring"], "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Sundering Growth"], "battlefield": ["Forest", "Plains", "Servo"] },
    { "graveyard": ["Disenchant", "Sol Ring"] }
   ]
  }
 },
 {
  "name": "ruling: with no creature tokens, populate does nothing",
  "players": [
   { "hand": ["Sundering Growth"], "battlefield": ["Forest", "Plains"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "cast": "Sundering Growth", "targets": ["Sol Ring"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Sundering Growth"], "battlefield": ["Forest", "Plains"] },
    { "graveyard": ["Sol Ring"] }
   ]
  }
 },
 {
  "name": "ruling: populate copies the creature token you choose, not only the first",
  "players": [
   { "hand": ["Sundering Growth"], "battlefield": ["Forest", "Plains", "Servo", "Construct 6-12"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "cast": "Sundering Growth", "targets": ["Sol Ring"] },
   { "resolve": true, "answers": [1] }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Forest", "Plains", "Servo", "Construct 6-12", "Construct 6-12"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: the populated copy has the copied token's characteristics",
  "players": [
   { "hand": ["Sundering Growth"], "battlefield": ["Forest", "Plains", "Construct 6-12"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "cast": "Sundering Growth", "targets": ["Sol Ring"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Forest", "Plains", "Construct 6-12", "Construct 6-12"] },
    {}
   ],
   "pt": { "Construct 6-12": [6, 12] },
   "keywords": { "Construct 6-12": ["Trample"] }
  }
 }
]