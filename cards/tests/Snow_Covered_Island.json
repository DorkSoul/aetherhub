  {
    "name": "ruling: a snow-covered Island pays {S} for Icebind Pillar (one mana of any colour from a snow source)",
    "players": [
      { "battlefield": ["Icebind Pillar", "Snow-Covered Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Icebind Pillar", "targets": ["Grizzly Bears"] },
      { "resolve": true }
