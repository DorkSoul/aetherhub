  {
    "name": "ruling: snow is not a mana type; a non-snow Island cannot pay {S} for Icebind Pillar",
    "players": [
      { "battlefield": ["Icebind Pillar", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Icebind Pillar", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
