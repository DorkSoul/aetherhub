[
  {
    "name": "devotion to black reduces generic cost",
    "players": [
      { "hand": ["Marshmist Titan"], "battlefield": ["Vampire Nighthawk", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Marshmist Titan" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Marshmist Titan", "Vampire Nighthawk"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: numeric mana symbols do not count toward devotion: Hill Giant does not reduce Marshmist Titan",
    "players": [
      { "hand": ["Marshmist Titan"], "battlefield": ["Hill Giant", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [ { "cast": "Marshmist Titan", "illegal": true } ],
    "expect": { "players": [{ "hand": ["Marshmist Titan"] }, {}] }
  },
  {
    "name": "ruling: devotion above six: only the generic part is reduced, four Nighthawks pay with one Swamp",
    "players": [
      { "hand": ["Marshmist Titan"], "battlefield": ["Vampire Nighthawk", "Vampire Nighthawk", "Vampire Nighthawk", "Vampire Nighthawk", "Swamp"] },
      {}
    ],
    "steps": [ { "cast": "Marshmist Titan" }, { "resolve": true } ],
    "expect": { "players": [{ "battlefield_has": ["Marshmist Titan"], "hand_count": 0 }, {}] }
  },
  {
    "name": "ruling: the {B} part is never reduced: devotion 8 with only a Mountain cannot cast it",
    "players": [
      { "hand": ["Marshmist Titan"], "battlefield": ["Vampire Nighthawk", "Vampire Nighthawk", "Vampire Nighthawk", "Vampire Nighthawk", "Mountain"] },
      {}
    ],
    "steps": [ { "cast": "Marshmist Titan", "illegal": true } ],
    "expect": { "players": [{ "hand": ["Marshmist Titan"] }, {}] }
  },
  {
    "name": "four lands are not enough at devotion 2",
    "players": [
      { "hand": ["Marshmist Titan"], "battlefield": ["Vampire Nighthawk", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Marshmist Titan", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Marshmist Titan"] },
        {}
      ]
    }
  }
]
