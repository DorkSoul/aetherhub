[
  { "name": "exiles the target and every same-named card in graveyard, library and hand; draws one per card exiled from hand",
    "players": [ { "hand": ["The End"], "battlefield": ["Swamp", "Swamp", "Island", "Island"] },
                 { "battlefield": ["Grizzly Bears"], "graveyard": ["Grizzly Bears"], "hand": ["Grizzly Bears", "Forest"], "library": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "The End", "targets": ["p1:Grizzly Bears"] },
               { "resolve": true, "answers": [["Grizzly Bears"], ["Grizzly Bears"], ["Grizzly Bears"]] } ],
    "expect": { "players": [ { "graveyard_has": ["The End"] },
                             { "battlefield_lacks": ["Grizzly Bears"], "graveyard": [], "exile": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"], "hand_count": 2 } ] } },
  { "name": "no same-named card in hand: no draw",
    "players": [ { "hand": ["The End"], "battlefield": ["Swamp", "Swamp", "Island", "Island"] },
                 { "battlefield": ["Grizzly Bears"], "graveyard": ["Grizzly Bears"], "hand": ["Forest"] } ],
    "steps": [ { "cast": "The End", "targets": ["p1:Grizzly Bears"] },
               { "resolve": true, "answers": [["Grizzly Bears"]] } ],
    "expect": { "players": [ { "graveyard_has": ["The End"] },
                             { "battlefield_lacks": ["Grizzly Bears"], "hand": ["Forest"], "hand_count": 1 } ] } },
  { "name": "costs {2} less when your life total is 5 or less",
    "players": [ { "life": 5, "hand": ["The End"], "battlefield": ["Swamp", "Swamp"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "The End", "targets": ["p1:Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["The End"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "does not cost {2} less when your life total is 6 or more",
    "players": [ { "life": 6, "hand": ["The End"], "battlefield": ["Swamp", "Swamp"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "The End", "targets": ["p1:Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["The End"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: The End's mana value stays 4 with the reduced cost: Disrupting Shoal with X=4 counters it",
    "players": [ { "life": 5, "hand": ["The End"], "battlefield": ["Swamp", "Swamp"] },
                 { "battlefield": ["Grizzly Bears", "Island", "Island", "Island", "Island", "Island", "Island"], "hand": ["Disrupting Shoal"] } ],
    "steps": [ { "cast": "The End", "targets": ["p1:Grizzly Bears"] },
               { "pass": true },
               { "cast": "Disrupting Shoal", "player": 1, "answers": [4], "targets": [{ "stack": "The End" }] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["The End"] },
                             { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Disrupting Shoal"] } ] } },
  { "name": "ruling: The End's mana value is 4, not 2: Disrupting Shoal with X=2 does not counter it",
    "players": [ { "life": 5, "hand": ["The End"], "battlefield": ["Swamp", "Swamp"] },
                 { "battlefield": ["Grizzly Bears", "Island", "Island", "Island", "Island"], "hand": ["Disrupting Shoal"] } ],
    "steps": [ { "cast": "The End", "targets": ["p1:Grizzly Bears"] },
               { "pass": true },
               { "cast": "Disrupting Shoal", "player": 1, "answers": [2], "targets": [{ "stack": "The End" }] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["The End"] },
                             { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"], "graveyard": ["Disrupting Shoal"] } ] } },
  { "name": "ruling: a transformed DFC's back name (Insectile Aberration) finds no same-named cards; the front-named copy stays in library",
    "players": [ { "life": 5, "hand": ["The End"], "battlefield": ["Swamp", "Swamp", "Delver of Secrets // Insectile Aberration"],
                   "library": ["Lightning Bolt", "Delver of Secrets // Insectile Aberration"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" },
               { "advance_to": "Upkeep", "answers": [true] },
               { "resolve": true },
               { "cast": "The End", "targets": ["Insectile Aberration"] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["The End"], "exile": ["Delver of Secrets // Insectile Aberration"], "hand_count": 0 },
                             {} ] } }
]
