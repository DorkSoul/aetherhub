      { "battlefield": ["Mulldrifter"] }
    ],
    "steps": [
      { "cast": "Omni-Changeling" },
      { "resolve": true, "answers": ["Mulldrifter"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mulldrifter"], "hand_count": 2 },
        {}
      ]
