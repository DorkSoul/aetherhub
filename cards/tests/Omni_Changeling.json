      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Omni-Changeling", "answers": [["Grizzly Bears", "Llanowar Elves"]] },
      { "resolve": true, "answers": ["Hill Giant"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"] },
        {}
      ],
      "tapped": { "Grizzly Bears": true, "Llanowar Elves": true }
