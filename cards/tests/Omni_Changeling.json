  {
    "name": "ruling: summoning-sick creatures can be tapped to convoke Omni-Changeling",
    "players": [
      {
        "hand": ["Omni-Changeling"],
        "battlefield": ["Island", "Island", "Island", { "name": "Grizzly Bears", "sick": true }, { "name": "Llanowar Elves", "sick": true }]
