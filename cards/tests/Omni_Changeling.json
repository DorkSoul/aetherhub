    "name": "ruling: the copy's enters trigger (Mulldrifter draws two) fires when Omni-Changeling enters as the copy",
    "players": [
      {
        "hand": ["Omni-Changeling"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island"],
