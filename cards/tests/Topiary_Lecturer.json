[
  { "name": "casting a spell that spends more mana than its power puts a +1/+1 counter on it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Topiary Lecturer", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Topiary Lecturer": [2, 3] }, "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "spending no more mana than its power or toughness does not trigger increment",
    "players": [ { "hand": ["Ornithopter"], "battlefield": ["Topiary Lecturer"] }, {} ],
    "steps": [ { "cast": "Ornithopter" }, { "resolve": true } ],
    "expect": { "pt": { "Topiary Lecturer": [1, 2] }, "players": [ { "battlefield_has": ["Ornithopter"] }, {} ] } },
  { "name": "taps for green equal to its power",
    "players": [ { "battlefield": ["Topiary Lecturer"] }, {} ],
    "steps": [ { "tap_for_mana": "Topiary Lecturer", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ] } },
  { "name": "taps for two green when its power is two",
    "players": [ { "battlefield": [ { "name": "Topiary Lecturer", "counters": { "p1p1": 1 } } ] }, {} ],
    "steps": [ { "tap_for_mana": "Topiary Lecturer", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 2 } }, {} ] } },
  { "name": "ruling: spending exactly its power (1) does not trigger increment, even though toughness is 2",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Topiary Lecturer", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "pt": { "Topiary Lecturer": [1, 2] }, "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
  { "name": "ruling: increment resolves even when the spell that caused it is countered",
    "players": [ { "hand": ["Smuggler's Copter"], "battlefield": ["Topiary Lecturer", "Plains", "Plains"] }, { "hand": ["Consign to Memory"], "battlefield": ["Island"] } ],
    "steps": [ { "cast": "Smuggler's Copter" }, { "pass": true }, { "cast": "Consign to Memory", "player": 1, "answers": [1], "targets": [{ "stack": "Smuggler's Copter" }] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Topiary Lecturer": [2, 3] }, "players": [ { "graveyard": ["Smuggler's Copter"] }, { "graveyard": ["Consign to Memory"] } ] } }
]
