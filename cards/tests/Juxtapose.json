[
 {
  "name": "exchanges the greatest-MV creature each player controls",
  "players": [
   {
    "hand": ["Juxtapose"],
    "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears", "Shivan Dragon"]
   },
   {
    "battlefield": ["Birds of Paradise"]
   }
  ],
  "steps": [
   { "cast": "Juxtapose", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Birds of Paradise", "Grizzly Bears"], "battlefield_lacks": ["Shivan Dragon"] },
    { "battlefield_has": ["Shivan Dragon"], "battlefield_lacks": ["Birds of Paradise"] }
   ]
  }
 },
 {
  "name": "tie for greatest: I choose which of my creatures is exchanged",
  "players": [
   {
    "hand": ["Juxtapose"],
    "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears", "Grizzly Bears"]
   },
   {
    "battlefield": ["Birds of Paradise"]
   }
  ],
  "steps": [
   { "cast": "Juxtapose", "targets": ["p1"] },
   { "resolve": true, "answers": [["Grizzly Bears"]] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Birds of Paradise", "Grizzly Bears"] },
    { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Birds of Paradise"] }
   ]
  }
 },
 {
  "name": "then the greatest-MV artifacts are exchanged the same way",
  "players": [
   {
    "hand": ["Juxtapose"],
    "battlefield": ["Island", "Island", "Island", "Island", "Icy Manipulator"]
   },
   {
    "battlefield": ["Mox Jasper"]
   }
  ],
  "steps": [
   { "cast": "Juxtapose", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Mox Jasper"], "battlefield_lacks": ["Icy Manipulator"] },
    { "battlefield_has": ["Icy Manipulator"], "battlefield_lacks": ["Mox Jasper"] }
   ]
  }
 },
 {
  "name": "a player without creatures or artifacts exchanges nothing",
  "players": [
   {
    "hand": ["Juxtapose"],
    "battlefield": ["Island", "Island", "Island", "Island", "Shivan Dragon", "Icy Manipulator"]
   },
   {}
  ],
  "steps": [
   { "cast": "Juxtapose", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Shivan Dragon", "Icy Manipulator"] },
    { "battlefield_lacks": ["Shivan Dragon", "Icy Manipulator"] }
   ]
  }
 },
 {
  "name": "ruling: creatures are swapped before artifacts, so the swapped-in artifact creature is not swapped back",
  "players": [
   {
    "hand": ["Juxtapose"],
    "battlefield": ["Island", "Island", "Island", "Island", "Iron League Steed"]
   },
   {
    "battlefield": ["Birds of Paradise", "Mox Jasper"]
   }
  ],
  "steps": [
   { "cast": "Juxtapose", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Birds of Paradise"], "battlefield_lacks": ["Iron League Steed", "Mox Jasper"] },
    { "battlefield_has": ["Iron League Steed", "Mox Jasper"], "battlefield_lacks": ["Birds of Paradise"] }
   ]
  }
 }
]
