[
 { "name": "animates into a 2/1 for UR",
   "players": [ { "battlefield": ["Izzet Keyrune", "Island", "Mountain"] }, {} ],
   "steps": [ { "activate": "Izzet Keyrune", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Izzet Keyrune": [2, 1] } } },
 { "name": "taps for R",
   "players": [ { "battlefield": ["Izzet Keyrune"] }, {} ],
   "steps": [ { "tap_for_mana": "Izzet Keyrune", "color": "R" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, {} ] } },
 { "name": "combat damage to a player: may draw, then discard (the only card in hand is discarded)",
   "players": [ { "battlefield": ["Izzet Keyrune", "Island", "Mountain"], "library": ["Island", "Mountain"] }, {} ],
   "steps": [ { "activate": "Izzet Keyrune", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Izzet Keyrune", "at": "p1" } ] }, { "advance_to": "Main2", "answers": [true] } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard": ["Island"], "library_top": ["Mountain"] }, { "life": 18 } ] } },
 { "name": "combat damage to a player: declining the may draws nothing",
   "players": [ { "battlefield": ["Izzet Keyrune", "Island", "Mountain"], "library": ["Island", "Mountain"] }, {} ],
   "steps": [ { "activate": "Izzet Keyrune", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Izzet Keyrune", "at": "p1" } ] }, { "advance_to": "Main2", "answers": [false] } ],
   "expect": { "players": [ { "hand_count": 0, "library_top": ["Island", "Mountain"] }, { "life": 18 } ] } },
 { "name": "blocked: no combat damage to a player, so no draw trigger",
   "players": [ { "battlefield": ["Izzet Keyrune", "Island", "Mountain"], "library": ["Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Izzet Keyrune", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Izzet Keyrune", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Izzet Keyrune" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "hand_count": 0, "library_top": ["Island", "Mountain"] }, { "life": 20 } ] } },
 { "name": "ruling: re-animating while already a creature keeps Mark of the Vampire's +2/+2 (the P/T setting is overridden, modifiers still apply)",
   "players": [ { "hand": ["Mark of the Vampire"], "battlefield": ["Izzet Keyrune", "Island", "Mountain", "Island", "Mountain", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
   "steps": [ { "activate": "Izzet Keyrune", "ability": 0 }, { "resolve": true }, { "cast": "Mark of the Vampire", "targets": ["Izzet Keyrune"] }, { "resolve": true }, { "activate": "Izzet Keyrune", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Izzet Keyrune": [4, 3] }, "attached": { "Mark of the Vampire": "Izzet Keyrune" } } }
]
