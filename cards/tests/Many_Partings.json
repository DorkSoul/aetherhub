[
  {
    "name": "searches for a basic land to hand and creates a Food",
    "players": [
      { "hand": ["Many Partings"], "battlefield": ["Forest"], "library": ["Sol Ring", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Many Partings" },
      { "resolve": true, "answers": ["Island"] }
    ],
    "expect": {
      "players": [
        { "hand": ["Island"], "graveyard": ["Many Partings"], "battlefield_has": ["Food", "Forest"] }
      ]
    }
  },
  {
    "name": "a non-basic land in library cannot be found, Food is still created",
    "players": [
      { "hand": ["Many Partings"], "battlefield": ["Forest"], "library": ["Sol Ring", "Mana Vault"] },
      {}
    ],
    "steps": [
      { "cast": "Many Partings" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "battlefield_has": ["Food"], "library_count": 22 }
      ]
    }
  },
  {
    "name": "ruling: a Food sacrificed for Maraleaf Rider's cost cannot also be sacrificed for its own ability",
    "players": [
      { "hand": ["Many Partings"], "battlefield": ["Forest", "Island", "Island", "Maraleaf Rider"], "library": ["Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Many Partings" },
      { "resolve": true, "answers": ["Forest"] },
      { "activate": "Maraleaf Rider", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Food", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Maraleaf Rider"], "battlefield_lacks": ["Food"] }, {}]
    }
  }
]
