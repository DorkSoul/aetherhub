[
  {
    "name": "enters and makes an opponent with a card in hand discard it",
    "players": [
      {
        "hand": ["Refurbished Familiar"],
        "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]
      },
      {
        "hand": ["Grizzly Bears"]
      }
    ],
    "steps": [
      {"cast": "Refurbished Familiar"},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Refurbished Familiar"]
        },
        {
          "graveyard": ["Grizzly Bears"],
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "you draw a card for an opponent who has no cards in hand",
    "players": [
      {
        "hand": ["Refurbished Familiar"],
        "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      {"cast": "Refurbished Familiar"},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {
          "hand": ["Forest"]
        },
        {}
      ]
    }
  },
  {
    "name": "affinity for artifacts reduces the cost by one for each artifact",
    "players": [
      {
        "hand": ["Refurbished Familiar"],
        "battlefield": ["Ornithopter", "Swamp", "Swamp", "Swamp"]
      },
      {}
    ],
    "steps": [
      {"cast": "Refurbished Familiar"},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Refurbished Familiar"]
        },
        {}
      ]
    }
  },
  {
    "name": "without an artifact the full cost is still required",
    "players": [
      {
        "hand": ["Refurbished Familiar"],
        "battlefield": ["Swamp", "Swamp", "Swamp"]
      },
      {}
    ],
    "steps": [
      {"cast": "Refurbished Familiar", "illegal": true}
    ],
    "expect": {
      "players": [
        {
          "hand": ["Refurbished Familiar"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the opponent chooses which card to discard, the others stay in hand",
    "players": [
      { "hand": ["Refurbished Familiar"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "cast": "Refurbished Familiar" },
      { "resolve": true, "answers": [["Grizzly Bears"]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Refurbished Familiar"] },
        { "graveyard": ["Grizzly Bears"], "hand": ["Forest"] }
      ]
    }
  }
]
