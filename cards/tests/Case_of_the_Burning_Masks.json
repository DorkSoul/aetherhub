[
  {
    "name": "enters: 3 damage to an opposing creature",
    "players": [ { "hand": ["Case of the Burning Masks"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Case of the Burning Masks" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Case of the Burning Masks"] }, { "graveyard": ["Hill Giant"] } ] }
  },
  {
    "name": "three damage sources solve it at end step",
    "players": [ { "hand": ["Case of the Burning Masks"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "p0:Hill Giant", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Case of the Burning Masks" }, { "resolve": true }, { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "counters": { "Case of the Burning Masks": { "judgment": 1 } } }
  },
  {
    "name": "two sources are not enough",
    "players": [ { "hand": ["Case of the Burning Masks"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Case of the Burning Masks" }, { "resolve": true }, { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Case of the Burning Masks"] }, {} ] }
  },
  { "name": "sacrificed with a judgment counter: exile the top three and play the one you choose this turn",
    "players": [ { "battlefield": [ { "name": "Case of the Burning Masks", "counters": { "judgment": 1 } } ], "library": ["Grizzly Bears", "Forest", "Island"] }, {} ],
    "steps": [ { "activate": "Case of the Burning Masks", "ability": 0 }, { "resolve": true, "answers": ["Island"] }, { "play_land": "Island" } ],
    "expect": { "players": [ { "battlefield_has": ["Island"], "graveyard_has": ["Case of the Burning Masks"], "exile": ["Grizzly Bears", "Forest"] }, {} ] } },
  { "name": "cannot be sacrificed without a judgment counter",
    "players": [ { "battlefield": ["Case of the Burning Masks"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Case of the Burning Masks", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Case of the Burning Masks"] }, {} ] } },
  { "name": "ruling: a source that dealt damage and then died still counts toward solving",
    "players": [ { "hand": ["Case of the Burning Masks"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] }, { "battlefield": ["Hill Giant", "Elite Vanguard"] } ],
    "steps": [
      { "cast": "Case of the Burning Masks" }, { "resolve": true, "targets": ["p1:Hill Giant"] }, { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Elite Vanguard", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ], "counters": { "Case of the Burning Masks": { "judgment": 1 } } } },
  { "name": "ruling: a card exiled by the Case can be cast later in the main phase",
    "players": [ { "battlefield": [ { "name": "Case of the Burning Masks", "counters": { "judgment": 1 } }, "Forest", "Forest" ], "library": ["Grizzly Bears", "Forest", "Island"] }, {} ],
    "steps": [ { "activate": "Case of the Burning Masks", "ability": 0 }, { "resolve": true, "answers": ["Grizzly Bears"] }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": ["Forest", "Island"] }, {} ] } }
]
