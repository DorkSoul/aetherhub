[
  { "name": "blinks a non-Pirate creature without drawing",
    "players": [ { "hand": ["Siren's Ruse"], "battlefield": ["Island", "Island", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [ { "cast": "Siren's Ruse", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand_count": 0, "graveyard": ["Siren's Ruse"] }, {} ] } },
  { "name": "blinking a Pirate draws a card",
    "players": [ { "hand": ["Siren's Ruse"], "battlefield": ["Island", "Island", "Boarding Party"] }, {} ],
    "steps": [ { "cast": "Siren's Ruse", "targets": ["Boarding Party"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Boarding Party"], "hand_count": 1, "graveyard": ["Siren's Ruse"] }, {} ] } },
  { "name": "ruling: a spell that targeted the creature before it was blinked does not affect the returned creature (Impolite Entrance fizzles, no draw)",
    "players": [ { "hand": ["Impolite Entrance", "Siren's Ruse"], "battlefield": ["Mountain", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Impolite Entrance", "targets": ["Grizzly Bears"] }, { "cast": "Siren's Ruse", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand": [], "graveyard_has": ["Impolite Entrance", "Siren's Ruse"] }, {} ], "keywords": { "Grizzly Bears": [] } } },
  { "name": "ruling: counters on the blinked creature cease to exist (a 3/3 with a +1/+1 counter returns as a 2/2)",
    "players": [ { "hand": ["Siren's Ruse"], "battlefield": ["Island", "Island", { "name": "Grizzly Bears", "counters": { "plusoneplusone": 1 } }] }, {} ],
    "steps": [ { "cast": "Siren's Ruse", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ], "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: an Aura attached to the blinked creature is put into its owner's graveyard",
    "players": [ { "hand": ["Pacifism", "Siren's Ruse"], "battlefield": ["Plains", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Siren's Ruse", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Pacifism", "Siren's Ruse"] }, {} ] } }
]
