[
  {
    "name": "upkeep fuse counter when chosen",
    "players": [
      {
        "battlefield": [
          "Powder Keg"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true
        ]
      },
      {
        "pass": true
      }
    ],
    "expect": {
      "counters": {
        "Powder Keg": {
          "fuse": 1
        }
      },
      "players": [
        {
          "battlefield_has": [
            "Powder Keg"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "destroys artifacts and creatures with mana value equal to its fuse counters",
    "players": [
      {
        "battlefield": [
          {
            "name": "Powder Keg",
            "counters": {
              "fuse": 2
            }
          },
          "Forest",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Hill Giant",
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Powder Keg",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Powder Keg"
          ]
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Hill Giant",
            "Llanowar Elves"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: declining the upkeep counter leaves no fuse counter, so the sacrifice destroys only mana value 0",
    "players": [
      { "battlefield": ["Powder Keg", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "activate": "Powder Keg", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Powder Keg"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: with one fuse counter only mana value 1 dies; the mana value 2 and 4 creatures survive",
    "players": [
      { "battlefield": [ { "name": "Powder Keg", "counters": { "fuse": 1 } } ] },
      { "battlefield": ["Llanowar Elves", "Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Powder Keg", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Powder Keg"] },
        { "graveyard": ["Llanowar Elves"], "battlefield_has": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  }
]
