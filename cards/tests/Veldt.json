[
  { "name": "{T}: adds G and puts a depletion counter on it",
    "players": [ { "battlefield": ["Veldt"] }, {} ],
    "steps": [ { "tap_for_mana": "Veldt", "color": "G" } ],
    "expect": { "players": [ { "battlefield_has": ["Veldt"], "pool": { "G": 1 } }, {} ], "tapped": { "Veldt": true } } },
  { "name": "{T}: adds W (second ability)",
    "players": [ { "battlefield": ["Veldt"] }, {} ],
    "steps": [ { "tap_for_mana": "Veldt", "color": "W" } ],
    "expect": { "players": [ { "battlefield_has": ["Veldt"], "pool": { "W": 1 } }, {} ], "tapped": { "Veldt": true } } },
  { "name": "with a depletion counter it does not untap during your untap step",
    "players": [ { "battlefield": ["Veldt"] }, {} ],
    "steps": [ { "tap_for_mana": "Veldt", "color": "G" }, { "advance_to": "End" }, { "advance_to": "Draw" }, { "advance_to": "Draw" } ],
    "expect": { "players": [ { "battlefield_has": ["Veldt"] }, {} ], "tapped": { "Veldt": true } } },
  { "name": "tapped with no depletion counter: untaps during your untap step",
    "players": [ { "battlefield": [ { "name": "Veldt", "tapped": true } ] }, {} ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Draw" }, { "advance_to": "Draw" } ],
    "expect": { "players": [ { "battlefield_has": ["Veldt"] }, {} ], "tapped": { "Veldt": false } } }
]
