  {
    "name": "overload returns each nonland permanent you don't control, not lands or your own",
    "players": [
      {
        "hand": [
          "Cyclonic Rift"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Savannah Lions"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Hill Giant",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Cyclonic Rift",
        "alt": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Savannah Lions"
          ]
        },
        {
          "battlefield": [
            "Forest"
          ],
          "hand": [
            "Grizzly Bears",
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: overload does not target, so it bounces a hexproof creature",
    "players": [
      { "hand": ["Cyclonic Rift"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Slippery Bogle", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Cyclonic Rift", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": [], "hand": ["Grizzly Bears", "Slippery Bogle"] }
      ]
    }
  },
  {
    "name": "ruling: overloaded Rift with no nonland permanent to hit still casts and resolves",
    "players": [
      { "hand": ["Cyclonic Rift"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Cyclonic Rift", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Cyclonic Rift"] },
        { "battlefield": ["Forest"] }
      ]
    }
  },
  {
    "name": "ruling: without overload Rift needs a single nonland target",
    "players": [
      { "hand": ["Cyclonic Rift"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Cyclonic Rift", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Cyclonic Rift"] },
        { "battlefield": ["Forest"] }
      ]
    }
  }
