    "players": [
      {
        "hand": [
          "Cyclonic Rift"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Hill Giant"
        ]
      }
    ],
    "steps": [
