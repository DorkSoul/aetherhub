[
  {
    "name": "Reduce counters the spell when its controller cannot pay {3}",
    "players": [
      {"hand": ["Reduce"], "battlefield": ["Island", "Island", "Island"]},
      {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}
    ],
    "steps": [
      {"pass": true},
      {"cast": "Lightning Bolt", "player": 1, "targets": ["p0"]},
      {"cast": "Reduce", "targets": [{"stack": "Lightning Bolt"}]},
      {"resolve": true, "auto": true},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"life": 20}, {"graveyard_has": ["Lightning Bolt"]}]
    }
  },
  {
    "name": "Reduce does nothing when its controller pays {3}",
    "players": [
      {"hand": ["Reduce"], "battlefield": ["Island", "Island", "Island"]},
      {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]}
    ],
    "steps": [
      {"pass": true},
      {"cast": "Lightning Bolt", "player": 1, "targets": ["p0"]},
      {"cast": "Reduce", "targets": [{"stack": "Lightning Bolt"}]},
      {"resolve": true, "answers": [true]},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"life": 17}, {}]
    }
  },
  {
    "name": "Rubble (aftermath) is cast from the graveyard and exiled",
    "players": [
      {"graveyard": ["Reduce"], "battlefield": ["Mountain", "Mountain", "Mountain", "Island", "Island"]},
      {}
    ],
    "steps": [
      {"cast": "Reduce", "face": true, "targets": ["Island", "Mountain"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"exile": ["Reduce"]}, {}]
    }
  },
  {
    "name": "Rubble cannot be cast from hand (only from the graveyard); the card stays in hand",
    "players": [
      {"hand": ["Reduce"], "battlefield": ["Mountain", "Mountain", "Mountain", "Island", "Island"]},
      {}
    ],
    "steps": [
      {"cast": "Reduce", "face": true, "targets": ["Island", "Mountain"], "illegal": true}
    ],
    "expect": {
      "players": [{"hand": ["Reduce"]}, {}]
    }
  }
]
