 {
  "name": "ruling: a 3-power attacker's prevented damage adds one counter, not one per point",
  "players": [ { "battlefield": ["Hill Giant"] }, { "battlefield": ["Ironscale Hydra"] } ],
  "steps": [
   { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
   { "block": [ { "blocker": "Ironscale Hydra", "attacker": "Hill Giant" } ] },
   { "advance_to": "Main2" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Hill Giant"] }, { "battlefield": ["Ironscale Hydra"] } ],
   "pt": { "Ironscale Hydra": [6, 6] }
  }
 },
 {
  "name": "ruling: one counter for each creature whose combat damage is prevented (double-blocked Hydra)",
  "players": [ { "battlefield": ["Ironscale Hydra"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
  "steps": [
   { "attack": [ { "card": "Ironscale Hydra", "at": "p1" } ] },
   { "block": [ { "blocker": "Grizzly Bears", "attacker": "Ironscale Hydra" }, { "blocker": "Hill Giant", "attacker": "Ironscale Hydra" } ] },
   { "advance_to": "Main2" },
   { "resolve": true }
  ],
  "expect": { "pt": { "Ironscale Hydra": [7, 7] } }
 }
]
