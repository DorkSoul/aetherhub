 {
  "name": "ruling: Sunken Hollow has basic land types, so a basic-land-type search can find it",
  "players": [
   { "hand": ["Boseiju, Who Endures"], "battlefield": ["Forest", "Forest"] },
   { "battlefield": ["Glittering Massif"], "library": ["Sunken Hollow"] }
  ],
  "steps": [
   { "activate": "Boseiju, Who Endures", "ability": 0, "targets": ["Glittering Massif"] },
   { "resolve": true, "answers": ["Sunken Hollow"] }
  ],
  "expect": { "players": [ { "graveyard": ["Boseiju, Who Endures"] }, { "graveyard": ["Glittering Massif"], "battlefield_has": ["Sunken Hollow"] } ] }
 },
