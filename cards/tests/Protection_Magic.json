 {
  "name": "ruling: a shield counter still works after the creature loses all abilities (Deep Freeze)",
  "players": [ { "hand": ["Deep Freeze", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain", { "name": "Grizzly Bears", "counters": { "shield": 1 } }] }, {} ],
  "steps": [
    { "cast": "Deep Freeze", "targets": ["Grizzly Bears"] },
    { "resolve": true },
    { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
    { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Lightning Bolt"] }, {} ],
   "counters": { "Grizzly Bears": { "shield": 0 } }
  }
 },
 {
  "name": "ruling: shield counters do not prevent a sacrifice",
  "players": [ { "hand": ["Diabolic Edict"], "battlefield": ["Swamp", "Swamp"] }, { "battlefield": [ { "name": "Grizzly Bears", "counters": { "shield": 1 } } ] } ],
  "steps": [
    { "cast": "Diabolic Edict", "targets": ["p1"] },
    { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Diabolic Edict"] }, { "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: with two shield counters the damage is prevented and only one counter is removed",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": [ { "name": "Grizzly Bears", "counters": { "shield": 2 } } ] } ],
  "steps": [
    { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
    { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Lightning Bolt"] }, { "battlefield_has": ["Grizzly Bears"] } ],
   "counters": { "Grizzly Bears": { "shield": 1 } }
  }
 }
