[
  { "name": "casting an artifact spell mills the targeted opponent two",
    "players": [ { "hand": ["Sol Ring"], "battlefield": ["Island", "Island", "Diligent Excavator"] }, {} ],
    "steps": [
      { "cast": "Sol Ring", "answers": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "library_count": 18 } ] }
  },
  { "name": "casting a non-historic spell does not trigger",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Diligent Excavator"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "library_count": 20 } ] }
  },
  { "name": "ruling: playing a legendary land is not casting it, so no mill",
    "players": [ { "hand": ["Boseiju, Who Endures"], "battlefield": ["Diligent Excavator"] }, {} ],
    "steps": [ { "play_land": "Boseiju, Who Endures" } ],
    "expect": { "players": [ {}, { "library_count": 20 } ] }
  },
  { "name": "ruling: a legendary artifact is historic once: the trigger mills two, not four",
    "players": [ { "hand": ["Blackblade Reforged"], "battlefield": ["Island", "Island", "Diligent Excavator"] }, {} ],
    "steps": [
      { "cast": "Blackblade Reforged", "answers": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "library_count": 18 } ] }
  },
  { "name": "ruling: the historic trigger resolves even if the spell is countered",
    "players": [
      { "hand": ["Sol Ring"], "battlefield": ["Island", "Diligent Excavator"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Sol Ring", "answers": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Sol Ring" }] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Sol Ring"] }, { "graveyard_has": ["Counterspell"], "library_count": 18 } ] }
  },
  { "name": "ruling: a legendary creature put onto the battlefield by Reanimate was not cast, so no mill",
    "players": [ { "hand": ["Reanimate"], "battlefield": ["Swamp", "Diligent Excavator"], "graveyard": ["Isamaru, Hound of Konda"] }, {} ],
    "steps": [
      { "cast": "Reanimate", "targets": ["Isamaru, Hound of Konda"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Isamaru, Hound of Konda"] }, { "library_count": 20 } ] }
  }
]
