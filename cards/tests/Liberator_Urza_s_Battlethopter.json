[
  { "name": "an artifact spell can be cast at the end step (flash)",
    "players": [ { "hand": ["Bladed Pinions"], "battlefield": ["Liberator, Urza's Battlethopter", "Plains", "Plains"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "cast": "Bladed Pinions" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bladed Pinions"] }, {} ] } },
  { "name": "a colored sorcery cannot be cast at the end step (no flash for it)",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Liberator, Urza's Battlethopter", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "cast": "Harmonize", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Harmonize"] }, {} ] } },
  { "name": "mana spent greater than its power puts a +1/+1 counter on it",
    "players": [ { "hand": ["Bladed Pinions"], "battlefield": ["Liberator, Urza's Battlethopter", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Bladed Pinions" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bladed Pinions"] }, {} ],
      "counters": { "Liberator, Urza's Battlethopter": { "PlusOnePlusOne": 1 } },
      "pt": { "Liberator, Urza's Battlethopter": [2, 3] } } },
  { "name": "mana spent equal to its power puts no counter on it",
    "players": [ { "hand": ["Bladed Pinions"], "battlefield": [ { "name": "Liberator, Urza's Battlethopter", "counters": { "PlusOnePlusOne": 1 } }, "Plains", "Plains" ] }, {} ],
    "steps": [ { "cast": "Bladed Pinions" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bladed Pinions"] }, {} ],
      "counters": { "Liberator, Urza's Battlethopter": { "PlusOnePlusOne": 1 } },
      "pt": { "Liberator, Urza's Battlethopter": [2, 3] } } },
  { "name": "a four-mana spell gives a counter (mana spent 4 > power 1)",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Liberator, Urza's Battlethopter", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Liberator, Urza's Battlethopter"] }, {} ],
      "counters": { "Liberator, Urza's Battlethopter": { "PlusOnePlusOne": 1 } } } },
  { "name": "ruling: Liberator's flash does not let a sorcery-speed equip be activated at the end step",
    "players": [ { "battlefield": ["Liberator, Urza's Battlethopter", "Bonesplitter", "Grizzly Bears", "Plains"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bonesplitter"] }, {} ], "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: the same sorcery-speed equip is legal in the main phase",
    "players": [ { "battlefield": ["Liberator, Urza's Battlethopter", "Bonesplitter", "Grizzly Bears", "Plains"] }, {} ],
    "steps": [ { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 2] } } },
  { "name": "ruling: Phyrexian mana paid with life counts only mana actually spent (Dismember: 1 spent, cost 3)",
    "players": [ { "hand": ["Dismember"], "battlefield": ["Liberator, Urza's Battlethopter", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Dismember", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 16, "battlefield_has": ["Liberator, Urza's Battlethopter"] }, { "graveyard": ["Grizzly Bears"] } ],
      "pt": { "Liberator, Urza's Battlethopter": [1, 2] } } }
]
