[
  {
    "name": "paying {2}{W} when it attacks taps target creature",
    "players": [
      { "battlefield": [{ "name": "Thousand Moons Crackshot", "sick": false }, "Plains", "Plains", "Plains"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Thousand Moons Crackshot", "at": "p1" }] },
      { "resolve": true, "answers": [true, "Hill Giant"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Hill Giant": true },
      "players": [{}, { "life": 18 }]
    }
  },
  {
    "name": "declining to pay leaves the creature untapped",
    "players": [
      { "battlefield": [{ "name": "Thousand Moons Crackshot", "sick": false }, "Plains", "Plains", "Plains"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Thousand Moons Crackshot", "at": "p1" }] },
      { "resolve": true, "answers": [false] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Hill Giant": false },
      "players": [{}, { "life": 18 }]
    }
  },
 {
  "name": "ruling: the reflexive tap target is chosen when that trigger goes on the stack",
  "players": [
   { "battlefield": [{ "name": "Thousand Moons Crackshot", "sick": false }, "Plains", "Plains", "Plains"] },
   { "battlefield": ["Hill Giant", "Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [{ "card": "Thousand Moons Crackshot", "at": "p1" }] },
   { "resolve": true, "answers": [true, "Grizzly Bears"] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true, "Hill Giant": false },
   "players": [{}, { "life": 18 }]
  }
 }
]
