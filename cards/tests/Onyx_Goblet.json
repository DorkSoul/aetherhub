[
  { "name": "taps to make target player lose 1 life",
    "players": [ { "battlefield": ["Onyx Goblet"] }, {} ],
    "steps": [ { "activate": "Onyx Goblet", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 19 } ], "tapped": { "Onyx Goblet": true } } },
  { "name": "can target yourself",
    "players": [ { "battlefield": ["Onyx Goblet"] }, {} ],
    "steps": [ { "activate": "Onyx Goblet", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 19 }, { "life": 20 } ] } },
  { "name": "a tapped Goblet cannot be activated again",
    "players": [ { "battlefield": [ { "name": "Onyx Goblet", "tapped": true } ] }, {} ],
    "steps": [ { "activate": "Onyx Goblet", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "ruling: a colored artifact needs colored mana to cast (red mana is not enough)",
    "players": [ { "hand": ["Onyx Goblet"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Onyx Goblet", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Onyx Goblet"] }, {} ] } },
  { "name": "ruling: with black mana it is castable and has color B on the battlefield",
    "players": [ { "hand": ["Onyx Goblet"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Onyx Goblet" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Onyx Goblet"], "hand_count": 0 }, {} ], "colors": { "Onyx Goblet": ["B"] } } },
  { "name": "ruling: a colored artifact is destroyed by Shatter like any other artifact",
    "players": [ { "battlefield": ["Onyx Goblet"] }, { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Shatter", "player": 1, "targets": ["Onyx Goblet"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Onyx Goblet"] }, { "graveyard_has": ["Shatter"] } ] } }
]
