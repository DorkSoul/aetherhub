[
  {
    "name": "discarding one or more lands at once makes each opponent lose 2 life once",
    "players": [
      {
        "hand": ["Burning Inquiry", "Forest"],
        "battlefield": ["Doctor Doom, King of Latveria", "Mountain"],
        "library": ["Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Burning Inquiry" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "discarding only nonland cards does not trigger the life loss",
    "players": [
      {
        "hand": ["Burning Inquiry", "Grizzly Bears"],
        "battlefield": ["Doctor Doom, King of Latveria", "Mountain"],
        "library": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Burning Inquiry" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "connive draws and discards a nonland card, putting a +1/+1 counter on the target Villain",
    "players": [
      {
        "battlefield": ["Doctor Doom, King of Latveria"],
        "library": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Doctor Doom, King of Latveria"] },
        {}
      ],
      "counters": {
        "Doctor Doom, King of Latveria": { "PlusOnePlusOne": 1 }
      }
    }
  },
  {
    "name": "connive discarding a land puts no counter on the Villain",
    "players": [
      {
        "battlefield": ["Doctor Doom, King of Latveria"],
        "library": ["Island"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Island"], "battlefield_has": ["Doctor Doom, King of Latveria"] },
        {}
      ],
      "counters": {
        "Doctor Doom, King of Latveria": { "PlusOnePlusOne": 0 }
      }
    }
  }
