[
  {
    "name": "full cost {3}{R}{R} after attacking untaps the attacking creature",
    "players": [
      { "hand": ["Overpowering Attack"], "battlefield": ["King's Assassin", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "attack": [{ "card": "King's Assassin", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Overpowering Attack" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Overpowering Attack"], "battlefield_has": ["King's Assassin"] },
        {}
      ],
      "tapped": { "King's Assassin": false }
    }
  },
  {
    "name": "freerunning {2}{R} after an Assassin dealt combat damage to a player",
    "players": [
      { "hand": ["Overpowering Attack"], "battlefield": ["King's Assassin", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "attack": [{ "card": "King's Assassin", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Overpowering Attack", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Overpowering Attack"], "battlefield_has": ["King's Assassin"] },
        {}
      ],
      "tapped": { "King's Assassin": false }
    }
  },
  {
    "name": "freerunning is not available when no Assassin or commander dealt combat damage",
    "players": [
      { "hand": ["Overpowering Attack"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "cast": "Overpowering Attack", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": [] },
        {}
      ]
    }
  },
  {
    "name": "ruling: freerunning stays available after the Assassin that dealt combat damage dies later in the turn",
    "players": [
      { "hand": ["Lightning Bolt", "Overpowering Attack"], "battlefield": [{ "name": "Brotherhood Spy", "sick": false }, "Island", "Island", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Brotherhood Spy", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["Brotherhood Spy"] },
      { "resolve": true },
      { "cast": "Overpowering Attack", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Overpowering Attack", "Brotherhood Spy"] }, { "life": 19 }]
    }
  }
]
