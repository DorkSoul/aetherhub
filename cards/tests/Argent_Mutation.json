[
  { "name": "draws a card and the target becomes an artifact until end of turn",
    "players": [ { "hand": ["Argent Mutation"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Argent Mutation", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "graveyard_has": ["Argent Mutation"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "a land can be the target",
    "players": [ { "hand": ["Argent Mutation"], "battlefield": ["Island", "Island", "Island", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Argent Mutation", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Mountain"], "battlefield_has": ["Forest"] }, {} ] } },
  { "name": "ruling: an artifact can be the target; it resolves and draws a card",
    "players": [ { "hand": ["Argent Mutation"], "battlefield": ["Island", "Island", "Island", "Mind Stone"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Argent Mutation", "targets": ["Mind Stone"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "battlefield_has": ["Mind Stone"], "graveyard_has": ["Argent Mutation"] }, {} ] } },
  { "name": "ruling: target gone when it resolves: no effect and no card drawn",
    "players": [ { "hand": ["Argent Mutation"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"], "library": ["Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Argent Mutation", "targets": ["Grizzly Bears"] }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Argent Mutation", "Grizzly Bears"], "library_count": 1 }, { "graveyard": ["Lightning Bolt"] } ] } }
]
