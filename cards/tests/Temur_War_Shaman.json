[
  { "name": "ETB manifests the top card as a face-down 2/2",
    "players": [ { "hand": ["Temur War Shaman"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Island"] }, {} ],
    "steps": [ { "cast": "Temur War Shaman" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ { "battlefield_has": ["Temur War Shaman", "Grizzly Bears"], "library_count": 1 }, {} ] } },
  { "name": "boundary: without the Shaman entering there is no manifest",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"], "library": ["Grizzly Bears", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 2 }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "turning a creature face up: the Shaman's trigger lets it fight an opposing creature",
    "players": [ { "hand": ["Bloodstoke Howler"], "battlefield": ["Temur War Shaman", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Bloodstoke Howler", "alt": 254 }, { "resolve": true }, { "activate": "Bloodstoke Howler", "ability": 0, "auto": true }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Temur War Shaman", "Bloodstoke Howler"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a face-down manifested creature is colorless, has no creature types and is a 2/2",
    "players": [ { "battlefield": [ { "name": "Grizzly Bears", "face_down": true }, "Temur War Shaman" ] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] }, "colors": { "Grizzly Bears": [] }, "not_subtypes": { "Grizzly Bears": ["Bear"] }, "players": [ { "battlefield_has": ["Grizzly Bears", "Temur War Shaman"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: a face-down manifested instant cannot be turned face up, so the Shaman's fight trigger never happens",
    "players": [ { "battlefield": ["Temur War Shaman", { "name": "Shock", "face_down": true }, "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "Main2" }, { "activate": "Shock", "illegal": true } ],
    "expect": { "pt": { "Shock": [2, 2] }, "players": [ { "battlefield_has": ["Temur War Shaman", "Shock"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: turning a manifested creature face up is a special action; the Shaman's trigger then fights",
    "players": [ { "hand": ["Temur War Shaman"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Island"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Temur War Shaman" }, { "resolve": true }, { "resolve": true }, { "activate": "Grizzly Bears" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Temur War Shaman"], "graveyard": ["Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] } ] } }
]
