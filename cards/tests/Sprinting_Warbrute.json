[
  { "name": "dash: enters with haste and returns to hand at end step",
    "players": [ { "hand": ["Sprinting Warbrute"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Sprinting Warbrute", "alt": 0 }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Sprinting Warbrute"] }, {} ] } },
  { "name": "normal cast: stays on the battlefield",
    "players": [ { "hand": ["Sprinting Warbrute"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Sprinting Warbrute" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Sprinting Warbrute"] }, {} ] } },
  { "name": "attacks each combat if able: forced attack hits the unblocked player",
    "players": [ { "battlefield": ["Sprinting Warbrute"] }, {} ],
    "steps": [ { "attack": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "ruling: a dashed creature that dies in combat before the end step is not returned to hand",
    "players": [ { "hand": ["Sprinting Warbrute"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [
      { "cast": "Sprinting Warbrute", "alt": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Sprinting Warbrute", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Sprinting Warbrute" }, { "blocker": "Grizzly Bears", "attacker": "Sprinting Warbrute" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Sprinting Warbrute"] }, {} ] } }
]
