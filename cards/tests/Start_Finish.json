      {
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Grizzly Bears"
        ],
        "graveyard": [
          "Start"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
