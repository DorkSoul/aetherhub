  {
    "name": "Finish is not castable from hand (only from the graveyard)",
    "players": [
      { "hand": ["Start"], "battlefield": ["Swamp", "Swamp", "Swamp", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Serra Angel"] }
