[
  {
    "name": "mode 1: at the beginning of combat tap target creature",
    "players": [
      { "battlefield": ["Dreamshackle Geist"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat", "answers": [[0], "Grizzly Bears"] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Dreamshackle Geist": false }
    }
  },
  {
    "name": "mode 2: target creature doesn't untap during its controller's next untap step",
    "players": [
      { "battlefield": ["Dreamshackle Geist"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "advance_to": "BeginCombat", "answers": [[1], "Grizzly Bears"] },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "turn": 2,
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "choosing no mode does nothing",
    "players": [
      { "battlefield": ["Dreamshackle Geist"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat", "answers": [[]] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  }
]
