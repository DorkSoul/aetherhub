[
  {
    "name": "the targeted tapped creature does not untap during its controller's next untap step",
    "players": [
      { "battlefield": ["Barl's Cage", "Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "activate": "Barl's Cage" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "it untaps in the untap step after the skipped one",
    "players": [
      { "battlefield": ["Barl's Cage", "Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "activate": "Barl's Cage" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "the ability can target a creature that is still untapped; it has no effect beyond the next untap step",
    "players": [
      { "battlefield": ["Barl's Cage", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Barl's Cage" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: a creature already untapped when the skipped untap step begins is not affected later",
    "players": [
      { "battlefield": ["Barl's Cage", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Barl's Cage" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  }
]
