[
 {
  "name": "keep a 2-mana card on top: 2 damage kills Grizzly Bears, not Craw Wurm",
  "players": [
   { "hand": ["Riddle of Lightning"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain"], "library": ["Grizzly Bears","Forest","Swamp","Island"] },
   { "battlefield": ["Grizzly Bears", "Craw Wurm"] }
  ],
  "steps": [
   { "cast": "Riddle of Lightning", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [[]] }
  ],
  "expect": { "players": [ { "graveyard": ["Riddle of Lightning"] }, { "graveyard": ["Grizzly Bears"], "battlefield": ["Craw Wurm"] } ] }
 },
 {
  "name": "scry bottoms a land; the next card sets the damage to a player",
  "players": [
   { "hand": ["Riddle of Lightning"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain"], "library": ["Forest","Craw Wurm","Swamp","Island"] },
   {}
  ],
  "steps": [
   { "cast": "Riddle of Lightning", "targets": ["p1"] },
   { "resolve": true, "answers": [["Forest"]] }
  ],
  "expect": { "players": [ { "graveyard": ["Riddle of Lightning"] }, { "life": 14 } ] }
 },
 {
  "name": "a land on top deals no damage",
  "players": [
   { "hand": ["Riddle of Lightning"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain"], "library": ["Forest","Craw Wurm","Swamp"] },
   {}
  ],
  "steps": [
   { "cast": "Riddle of Lightning", "targets": ["p1"] },
   { "resolve": true, "answers": [[]] }
  ],
  "expect": { "players": [ { "graveyard": ["Riddle of Lightning"] }, { "life": 20 } ] }
 },
 {
  "name": "ruling: if the target is gone on resolution, no scry and no reveal",
  "players": [
   { "hand": ["Riddle of Lightning"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Swamp", "Island"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Riddle of Lightning", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Riddle of Lightning"], "library_top": ["Forest", "Swamp", "Island"] },
    { "graveyard": ["Lightning Bolt", "Grizzly Bears"] }
   ]
  }
 }
]
