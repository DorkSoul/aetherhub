[
  {
    "name": "sacrifice ability puts a creature card from the top five into hand",
    "players": [
      {
        "battlefield": ["Memorial to Unity", "Forest", "Plains", "Plains"],
        "library": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "Memorial to Unity" },
      { "resolve": true, "answers": [["Grizzly Bears"]] }
    ],
    "expect": {
      "players": [{ "hand": ["Grizzly Bears"], "graveyard": ["Memorial to Unity"] }, {}]
    }
  },
  {
    "name": "enters tapped",
    "players": [
      { "hand": ["Memorial to Unity"], "battlefield": ["Forest"] },
      {}
    ],
    "steps": [
      { "play_land": "Memorial to Unity" }
    ],
    "expect": {
      "tapped": { "Memorial to Unity": true },
      "players": [{ "battlefield_has": ["Memorial to Unity"] }, {}]
    }
  }
]
