[
  {
    "name": "embalm exiles the cat from the graveyard and creates a white Zombie Cat token copy",
    "players": [ { "battlefield": ["Plains", "Plains"], "graveyard": ["Sacred Cat"] }, {} ],
    "steps": [ { "activate": "Sacred Cat", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sacred Cat"], "graveyard": [] }, {} ], "pt": { "Sacred Cat": [1, 1] } }
  },
  {
    "name": "embalm needs its {W} cost: with no Plains it is illegal",
    "players": [ { "battlefield": ["Forest", "Forest"], "graveyard": ["Sacred Cat"] }, {} ],
    "steps": [ { "activate": "Sacred Cat", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Sacred Cat"] }, {} ] }
  },
  {
    "name": "ruling: the token copies only the printed card, not the +1/+1 counter it had on the battlefield",
    "players": [ { "hand": ["Doom Blade"], "battlefield": [ { "name": "Sacred Cat", "counters": { "+1/+1": 1 } }, "Swamp", "Plains", "Plains" ] }, {} ],
    "steps": [
      { "cast": "Doom Blade", "targets": ["Sacred Cat"] },
      { "resolve": true },
      { "activate": "Sacred Cat", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Sacred Cat"], "graveyard": ["Doom Blade"] }, {} ], "pt": { "Sacred Cat": [1, 1] } }
  },
  {
    "name": "ruling: the embalmed token is a Zombie in addition to its other types",
    "players": [ { "battlefield": ["Plains", "Plains"], "graveyard": ["Sacred Cat"] }, {} ],
    "steps": [ { "activate": "Sacred Cat", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sacred Cat"] }, {} ], "subtypes": { "Sacred Cat": ["Zombie"] } }
  },
  {
    "name": "ruling: embalm exiles the card as soon as the ability is activated",
    "players": [ { "battlefield": ["Plains", "Plains"], "graveyard": ["Sacred Cat"] }, {} ],
    "steps": [ { "activate": "Sacred Cat", "ability": 0 } ],
    "expect": { "players": [ { "graveyard": [], "exile": ["Sacred Cat"] }, {} ] }
  }
]
