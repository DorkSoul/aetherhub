[
 { "name": "cast normally it is a 3/3 Elk creature",
   "players": [ { "hand": ["Trickster's Elk"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Trickster's Elk" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"] }, {} ], "pt": { "Trickster's Elk": [3, 3] } } },
 { "name": "bestowed on Serra Angel: the Angel is a green 3/3 Elk with no abilities",
   "players": [ { "hand": ["Trickster's Elk"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Trickster's Elk", "alt": 0, "targets": ["Serra Angel"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"] }, { "battlefield_has": ["Serra Angel"] } ],
               "pt": { "Serra Angel": [3, 3] }, "keywords": { "Serra Angel": [] }, "attached": { "Trickster's Elk": "Serra Angel" } } },
 { "name": "when the enchanted creature dies the Elk is a creature again",
   "players": [ { "hand": ["Trickster's Elk", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Trickster's Elk", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ],
               "pt": { "Trickster's Elk": [3, 3] } } },
 { "name": "bestowed on Serra Angel: it loses flying, so a Grizzly Bears can block it (Angel's 3 damage kills the Bears)",
   "players": [ { "hand": ["Trickster's Elk"], "battlefield": ["Forest", "Forest", "Serra Angel"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Trickster's Elk", "alt": 0, "targets": ["Serra Angel"] }, { "resolve": true },
              { "attack": [ { "card": "Serra Angel", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Serra Angel" } ], "player": 1 },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Serra Angel"] }, { "graveyard_has": ["Grizzly Bears"], "life": 20 } ] } },
 { "name": "bestowed on Serra Angel: the Angel is a green Elk, no longer an Angel",
   "players": [ { "hand": ["Trickster's Elk"], "battlefield": ["Forest", "Forest", "Serra Angel"] }, {} ],
   "steps": [ { "cast": "Trickster's Elk", "alt": 0, "targets": ["Serra Angel"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Serra Angel"] }, {} ],
               "colors": { "Serra Angel": ["G"] }, "subtypes": { "Serra Angel": ["Elk"] }, "not_subtypes": { "Serra Angel": ["Angel"] } } },
 { "name": "ruling: a later P/T-setting effect (Turn to Frog) overwrites the Elk's 3/3: the creature is 1/1",
   "players": [ { "hand": ["Trickster's Elk", "Turn to Frog"], "battlefield": ["Forest", "Forest", "Island", "Island", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Trickster's Elk", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Turn to Frog", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"] }, {} ], "pt": { "Grizzly Bears": [1, 1] } } },
 { "name": "ruling: a P/T-setting effect applied before the bestow is overwritten by the Elk's 3/3",
   "players": [ { "hand": ["Trickster's Elk", "Turn to Frog"], "battlefield": ["Forest", "Forest", "Island", "Island", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Turn to Frog", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Trickster's Elk", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"] }, {} ], "pt": { "Grizzly Bears": [3, 3] } } },
 { "name": "ruling: the bestowed Aura does not become tapped when the enchanted creature attacks",
   "players": [ { "hand": ["Trickster's Elk"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Trickster's Elk", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "advance_to": "BeginCombat" },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "block": [], "player": 1 },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk", "Grizzly Bears"] }, { "life": 17 } ],
               "tapped": { "Grizzly Bears": true, "Trickster's Elk": false } } },
 { "name": "ruling: nonlethal damage stays marked, so the Elk's 3/3 kills a Serra Angel already damaged by 3",
   "players": [ { "hand": ["Trickster's Elk", "Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest"] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Serra Angel"] }, { "resolve": true },
              { "cast": "Trickster's Elk", "alt": 0, "targets": ["Serra Angel"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Serra Angel"] } ] } },
 { "name": "ruling: a bestow spell whose target is gone resolves as a creature instead of being countered",
   "players": [ { "hand": ["Trickster's Elk", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Trickster's Elk", "alt": 0, "targets": ["Grizzly Bears"] },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ],
               "pt": { "Trickster's Elk": [3, 3] } } },
 { "name": "ruling: a +3/+3 effect that applied before the bestow still applies once the Elk is attached",
   "players": [ { "hand": ["Trickster's Elk", "Giant Growth"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Trickster's Elk", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Trickster's Elk"] }, {} ], "pt": { "Grizzly Bears": [6, 6] } } }
]
