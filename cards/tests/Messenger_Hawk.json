[
  {
    "name": "creates a Clue when it enters",
    "players": [
      {
        "hand": [
          "Messenger Hawk"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Messenger Hawk"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Messenger Hawk",
            "Clue"
          ]
        },
        {}
      ],
      "pt": {
        "Messenger Hawk": [
          1,
          2
        ]
      }
    }
  },
  {
    "name": "gets +2/+0 once you have drawn two cards this turn",
    "players": [
      {
        "hand": [
          "Divination",
          "Messenger Hawk"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      },
      {
        "cast": "Messenger Hawk"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Messenger Hawk": [
          3,
          2
        ]
      }
    }
  },
  {
    "name": "ruling: the Clue is an artifact that draws a card for {2}",
    "players": [
      { "hand": ["Messenger Hawk"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Lightning Bolt", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Messenger Hawk" },
      { "resolve": true },
      { "activate": "Clue", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Lightning Bolt"], "battlefield_has": ["Messenger Hawk"] }, {} ],
      "pt": { "Messenger Hawk": [1, 2] }
    }
  },
  {
    "name": "ruling: cards put into hand by a non-draw effect do not count toward the Hawk's bonus",
    "players": [
      { "hand": ["Unsummon", "Messenger Hawk"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Unsummon", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Messenger Hawk" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Messenger Hawk"] }, {} ],
      "pt": { "Messenger Hawk": [1, 2] }
    }
  }
]
