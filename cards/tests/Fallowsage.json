[
  { "name": "draws when it becomes tapped by attacking and the controller accepts",
    "players": [ { "battlefield": ["Fallowsage"] }, {} ],
    "steps": [ { "attack": [ { "card": "Fallowsage", "at": "p1" } ] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "may decline the draw",
    "players": [ { "battlefield": ["Fallowsage"] }, {} ],
    "steps": [ { "attack": [ { "card": "Fallowsage", "at": "p1" } ] }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "ruling: the draw is a triggered ability, not an activated one (no tap ability to use)",
    "players": [ { "battlefield": ["Fallowsage"] }, {} ],
    "steps": [ { "activate": "Fallowsage", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Fallowsage"] }, {} ] } },
  { "name": "ruling: already tapped, another tap does not trigger the draw",
    "players": [ { "battlefield": [{ "name": "Fallowsage", "tapped": true }] }, { "hand": ["Frost Breath"], "battlefield": ["Island", "Island", "Island"] } ],
    "steps": [ { "pass": true }, { "cast": "Frost Breath", "targets": ["Fallowsage"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ], "tapped": { "Fallowsage": true } } }
]
