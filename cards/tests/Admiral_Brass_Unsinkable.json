[
  { "name": "at the beginning of combat returns a Pirate with a finality counter as a 4/4 with haste",
    "players": [ { "battlefield": ["Admiral Brass, Unsinkable"], "graveyard": ["Dockside Extortionist"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "answers": [true] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Dockside Extortionist"], "graveyard": [] }, {} ],
      "counters": { "Dockside Extortionist": { "finality": 1 } },
      "pt": { "Dockside Extortionist": [4, 4] },
      "keywords": { "Dockside Extortionist": ["Haste"] }
    }
  },
  { "name": "declining the optional return leaves the Pirate in the graveyard",
    "players": [ { "battlefield": ["Admiral Brass, Unsinkable"], "graveyard": ["Dockside Extortionist"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Dockside Extortionist"], "battlefield_lacks": ["Dockside Extortionist"] }, {} ] }
  },
  { "name": "a non-Pirate creature card in the graveyard is not a target",
    "players": [ { "battlefield": ["Admiral Brass, Unsinkable"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ] }
  },
  { "name": "entering the battlefield mills four cards",
    "players": [ { "hand": ["Admiral Brass, Unsinkable"], "battlefield": ["Island", "Swamp", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Admiral Brass, Unsinkable" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Admiral Brass, Unsinkable"], "library_count": 16 }, {} ] } }
  ,{ "name": "ruling: a Pirate returned with a finality counter is exiled instead of going to the graveyard",
    "players": [ { "hand": ["Blaze"], "battlefield": ["Admiral Brass, Unsinkable", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Dockside Extortionist"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "answers": [true] }, { "resolve": true }, { "advance_to": "Main2" }, { "cast": "Blaze", "targets": ["Dockside Extortionist"], "answers": [4] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Dockside Extortionist"], "graveyard": ["Blaze"] }, {} ] } }
]
