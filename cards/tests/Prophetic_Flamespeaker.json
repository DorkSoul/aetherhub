[
  { "name": "unblocked combat damage to a player exiles the top card twice (double strike)",
    "players": [ { "battlefield": ["Prophetic Flamespeaker"], "library": ["Forest", "Swamp"] }, {} ],
    "steps": [ { "attack": [ { "card": "Prophetic Flamespeaker", "at": "p1" } ] }, { "block": [] },
               { "advance_to": "Main2" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Forest", "Swamp"] }, { "life": 18 } ] } },
  { "name": "blocked: no combat damage to the player, nothing exiled",
    "players": [ { "battlefield": ["Prophetic Flamespeaker"], "library": ["Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Prophetic Flamespeaker", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Prophetic Flamespeaker" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "exile": [] }, { "life": 20 } ] } },
  { "name": "ruling: an exiled creature card can be cast in the second main phase this turn",
    "players": [ { "battlefield": ["Prophetic Flamespeaker", "Forest", "Forest"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Prophetic Flamespeaker", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: an exiled land can be played this turn when no land has been played yet",
    "players": [ { "battlefield": ["Prophetic Flamespeaker"], "library": ["Forest", "Swamp"] }, {} ],
    "steps": [ { "attack": [ { "card": "Prophetic Flamespeaker", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"], "exile": ["Swamp"] }, {} ] } },
  { "name": "ruling: after a land was played this turn, the exiled land cannot be played",
    "players": [ { "hand": ["Plains"], "battlefield": ["Prophetic Flamespeaker"], "library": ["Forest", "Swamp"] }, {} ],
    "steps": [ { "play_land": "Plains" }, { "attack": [ { "card": "Prophetic Flamespeaker", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Plains"], "exile": ["Forest", "Swamp"] }, {} ] } }
]
