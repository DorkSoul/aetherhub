[
  {
    "name": "combat damage to a player taps the creature that player controls",
    "players": [
      { "battlefield": ["Somnophore"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Somnophore", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "the tapped creature stays tapped through its controller's untap step",
    "players": [
      { "battlefield": ["Somnophore"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Somnophore", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "only creatures the damaged player controls are targeted",
    "players": [
      { "battlefield": ["Somnophore", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Somnophore", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Hill Giant": false }
    }
  },
  {
    "name": "ruling: two Somnophores can end up holding two different creatures tapped",
    "players": [
      { "battlefield": ["Somnophore", "Somnophore"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Somnophore", "at": "p1" }, { "card": "Somnophore", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2", "targets": ["Grizzly Bears", "Hill Giant"] }
    ],
    "expect": {
      "players": [ {}, {} ],
      "tapped": { "Grizzly Bears": true, "Hill Giant": true }
    }
  }
]
