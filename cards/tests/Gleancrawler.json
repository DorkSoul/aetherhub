[
  {
    "name": "end step: returns own creature that died this turn to hand",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Gleancrawler",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Gleancrawler"
          ],
          "hand": [
            "Grizzly Bears"
          ],
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "opponent creature put into their own graveyard is not returned",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Gleancrawler",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [],
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: creature put into graveyard before Gleancrawler entered is still returned at end step",
    "players": [
      { "hand": ["Lightning Bolt", "Gleancrawler"], "battlefield": ["Mountain", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Gleancrawler" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Gleancrawler"], "hand": ["Grizzly Bears"], "graveyard": ["Lightning Bolt"] },
        {}
      ]
    }
  }
]
