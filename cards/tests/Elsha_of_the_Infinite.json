[
 {
  "name": "casts a noncreature spell from the top of the library",
  "players": [
   { "battlefield": ["Elsha of the Infinite", "Island", "Island", "Island"], "library": ["Divination", "Island", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Divination" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Island", "Forest"], "graveyard": ["Divination"] },
    {}
   ]
  }
 },
 {
  "name": "a noncreature spell that is not on top of the library can't be cast from it",
  "players": [
   { "battlefield": ["Elsha of the Infinite", "Island", "Island", "Island"], "library": ["Island", "Divination"] },
   {}
  ],
  "steps": [
   { "cast": "Divination", "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard": [], "hand_count": 0 },
    {}
   ]
  }
 },
 {
  "name": "a creature card on top of the library can't be cast from the library",
  "players": [
   { "battlefield": ["Elsha of the Infinite", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears", "illegal": true }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Grizzly Bears"] },
    {}
   ]
  }
 },
 {
  "name": "a top-of-library noncreature spell can be cast at instant speed (as though it had flash)",
  "players": [
   { "battlefield": ["Elsha of the Infinite", "Island", "Island", "Island"], "library": ["Divination", "Island", "Forest"] },
   {}
  ],
  "steps": [
   { "advance_to": "End" },
   { "cast": "Divination" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Island", "Forest"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: the full mana cost must be paid to cast from the top of the library",
  "players": [
   { "battlefield": ["Elsha of the Infinite", "Island", "Island"], "library": ["Divination", "Island", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Divination", "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard": [], "hand_count": 0, "library_top": ["Divination"] },
    {}
   ]
  }
 }
