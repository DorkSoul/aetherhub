[
  {
    "name": "destroying a Nissa planeswalker draws a card",
    "players": [
      { "hand": ["Nissa's Defeat"], "battlefield": ["Forest", "Island", "Island"] },
      { "battlefield": ["Nissa Revane"] }
    ],
    "steps": [ { "cast": "Nissa's Defeat", "targets": ["Nissa Revane"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, { "graveyard_has": ["Nissa Revane"] } ] }
  },
  {
    "name": "destroying a Forest does not draw a card",
    "players": [
      { "hand": ["Nissa's Defeat"], "battlefield": ["Forest", "Island", "Island"] },
      {}
    ],
    "steps": [ { "cast": "Nissa's Defeat" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Forest"] }, {} ] }
  },
  { "name": "ruling: a nonbasic land that is not a Forest (Desert of the Indomitable) is not a legal target",
    "players": [ { "hand": ["Nissa's Defeat"], "battlefield": ["Forest", "Island", "Island"] },
                 { "battlefield": ["Desert of the Indomitable"] } ],
    "steps": [ { "cast": "Nissa's Defeat", "targets": ["Desert of the Indomitable"], "illegal": true } ],
    "expect": { "players": [ { "hand_count": 1 }, { "battlefield_has": ["Desert of the Indomitable"] } ] } }
]
