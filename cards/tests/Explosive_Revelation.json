[
  { "name": "damage equals the revealed nonland card's mana value",
    "players": [ { "hand": ["Explosive Revelation"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Explosive Revelation", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, { "life": 18 } ] } },
  { "name": "all lands: no damage",
    "players": [ { "hand": ["Explosive Revelation"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Explosive Revelation", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "ruling: if the target is gone on resolution the spell fizzles and no cards are revealed",
    "players": [ { "hand": ["Explosive Revelation"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Explosive Revelation", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Explosive Revelation"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } }
]
