[
  { "name": "controller who can't pay {2}: the spell is countered and you create no Lander",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Divert Disaster"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Divert Disaster", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Lightning Bolt"] },
                             { "graveyard": ["Divert Disaster"], "battlefield": ["Island", "Island"] } ],
                "stack_empty": true } },
  { "name": "controller pays {2}: the spell resolves and you create a Lander",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                 { "hand": ["Divert Disaster"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Divert Disaster", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] },
                             { "life": 17, "graveyard": ["Divert Disaster"], "battlefield": ["Island", "Island", "Lander"] } ],
                "stack_empty": true } }
]
