[
  {
    "name": "red spell goes to the top of its owner's library when they choose top",
    "players": [
      {
        "hand": ["Aether Gust"],
        "battlefield": ["Island", "Island"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      {
        "cast": "Aether Gust",
        "answers": [0],
        "targets": [{ "stack": "Lightning Bolt" }]
      },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Aether Gust"], "life": 20 },
        { "graveyard": [], "library_count": 21, "life": 20 }
      ]
    }
  },
  {
    "name": "red spell goes to the bottom of its owner's library when they choose bottom",
    "players": [
      {
        "hand": ["Aether Gust"],
        "battlefield": ["Island", "Island"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      {
        "cast": "Aether Gust",
        "answers": [0],
        "targets": [{ "stack": "Lightning Bolt" }]
      },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Aether Gust"] },
        { "graveyard": [], "library_count": 21 }
      ]
    }
  },
  {
    "name": "permanent mode puts a red or green creature into its owner's library",
    "players": [
      {
        "hand": ["Aether Gust"],
        "battlefield": ["Island", "Island"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      {
        "cast": "Aether Gust",
        "answers": [1],
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Aether Gust"] },
        { "battlefield_lacks": ["Grizzly Bears"], "graveyard": [], "library_count": 21 }
      ]
    }
  },
  {
    "name": "a white creature is not a legal target",
    "players": [
      {
        "hand": ["Aether Gust"],
        "battlefield": ["Island", "Island"]
      },
      {
        "battlefield": ["Serra Angel"]
      }
    ],
    "steps": [
      { "cast": "Aether Gust", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Aether Gust"] },
        { "battlefield": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling: a spell put into its owner's library does not resolve and is not put in the graveyard",
    "players": [
      { "hand": ["Aether Gust"], "battlefield": ["Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Aether Gust", "answers": [0], "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Aether Gust"], "life": 20 },
        { "graveyard": [], "library_top": ["Lightning Bolt"], "life": 20 }
      ]
    }
  }
]
