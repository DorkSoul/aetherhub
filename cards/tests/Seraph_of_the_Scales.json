[
  {
    "name": "afterlife 2: two Spirit tokens when it dies",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Seraph of the Scales",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Seraph of the Scales"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Seraph of the Scales",
            "Lightning Bolt"
          ],
          "battlefield": [
            "Spirit 1-1 White Black Flying",
            "Spirit 1-1 White Black Flying",
            "Mountain"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "{W} gives vigilance until end of turn; the Seraph is not a Spirit-maker when it survives",
    "players": [
      {
        "battlefield": [
          "Seraph of the Scales",
          "Plains",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Seraph of the Scales",
        "ability": 1,
        "targets": []
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Seraph of the Scales"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "{W} vigilance: attacking does not tap the Seraph",
    "players": [
      { "battlefield": ["Seraph of the Scales", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Seraph of the Scales", "ability": 0 },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Seraph of the Scales", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "keywords": { "Seraph of the Scales": ["Vigilance"] },
      "tapped": { "Seraph of the Scales": false },
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "without vigilance, attacking taps the Seraph",
    "players": [
      { "battlefield": ["Seraph of the Scales", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Seraph of the Scales", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Seraph of the Scales": true },
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "{W} vigilance needs white mana: no Plains means it cannot be activated",
    "players": [
      { "battlefield": ["Seraph of the Scales", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Seraph of the Scales", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Seraph of the Scales"] }, {} ]
    }
  },
  {
    "name": "ruling: gaining vigilance after attacks are declared does not untap the attacking Seraph",
    "players": [ { "battlefield": ["Seraph of the Scales", "Plains"] }, {} ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Seraph of the Scales", "at": "p1" } ] },
      { "activate": "Seraph of the Scales", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Seraph of the Scales": true },
      "players": [ {}, { "life": 16 } ]
    }
  }
]
