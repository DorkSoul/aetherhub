[
 {
  "name": "Marvin taps for a Prodigal Sorcerer's ping",
  "players": [
   { "battlefield": [{ "name": "Marvin, Murderous Mimic", "sick": false }, { "name": "Prodigal Sorcerer", "sick": false }] },
   { "battlefield": ["Llanowar Elves"] }
  ],
  "steps": [
   { "activate": "Marvin, Murderous Mimic", "ability": 32768, "targets": ["Llanowar Elves"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Marvin, Murderous Mimic", "Prodigal Sorcerer"] },
    { "graveyard": ["Llanowar Elves"] }
   ]
  }
 },
 {
  "name": "creatures the opponent controls do not give Marvin abilities",
  "players": [
   { "battlefield": [{ "name": "Marvin, Murderous Mimic", "sick": false }] },
   { "battlefield": ["Prodigal Sorcerer"] }
  ],
  "steps": [
   { "activate": "Marvin, Murderous Mimic", "ability": 32768, "targets": ["p1"], "illegal": true }
  ],
  "expect": { "players": [{}, {}] }
 },
 {
  "name": "without other creatures Marvin has no activated abilities",
  "players": [
   { "battlefield": [{ "name": "Marvin, Murderous Mimic", "sick": false }] },
   {}
  ],
  "steps": [
   { "activate": "Marvin, Murderous Mimic", "ability": 0, "illegal": true }
  ],
  "expect": { "players": [{}, {}] }
 },
 {
  "name": "ruling: Marvin's copy still resolves after the Sorcerer it copied has died",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Marvin, Murderous Mimic", "sick": false }, { "name": "Prodigal Sorcerer", "sick": false }, "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Marvin, Murderous Mimic", "ability": 32768, "targets": ["p1"] },
   { "cast": "Lightning Bolt", "targets": ["Prodigal Sorcerer"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Lightning Bolt", "Prodigal Sorcerer"], "battlefield_has": ["Marvin, Murderous Mimic"] },
    { "life": 19 }
   ]
  }
 },
 {
  "name": "ruling: Marvin's copy of Floodpits Drowner shuffles Marvin, not Floodpits",
  "players": [
   { "battlefield": [{ "name": "Marvin, Murderous Mimic", "sick": false }, { "name": "Floodpits Drowner", "sick": false }, "Island", "Island"] },
   { "battlefield": [{ "name": "Grizzly Bears", "counters": { "stun": 1 } }] }
  ],
  "steps": [
   { "activate": "Marvin, Murderous Mimic", "ability": 32768, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Floodpits Drowner"], "battlefield_lacks": ["Marvin, Murderous Mimic"] },
    { "battlefield_lacks": ["Grizzly Bears"] }
   ]
  }
 }
]
