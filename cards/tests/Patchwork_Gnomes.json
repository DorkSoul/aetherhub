[
  {
    "name": "discard a card to regenerate it from lethal damage",
    "players": [
      { "hand": ["Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Patchwork Gnomes"] },
      {}
    ],
    "steps": [
      { "activate": "Patchwork Gnomes", "answers": ["Forest"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Patchwork Gnomes"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "battlefield": ["Mountain", "Patchwork Gnomes"], "graveyard_has": ["Forest", "Lightning Bolt"] },
        { "life": 20 }
      ],
      "tapped": { "Patchwork Gnomes": true }
    }
  },
  {
    "name": "no card to discard means no regeneration ability",
    "players": [
      { "battlefield": ["Mountain", "Patchwork Gnomes"] },
      {}
    ],
    "steps": [
      { "activate": "Patchwork Gnomes", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Patchwork Gnomes"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: regeneration can be activated with no damage and no combat",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Mountain", "Patchwork Gnomes"] },
      {}
    ],
    "steps": [ { "activate": "Patchwork Gnomes" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "hand": [], "battlefield": ["Mountain", "Patchwork Gnomes"], "graveyard_has": ["Forest"] },
        { "life": 20 }
      ],
      "tapped": { "Patchwork Gnomes": false }
    }
  },
  {
    "name": "ruling: the shield also replaces destruction by a spell (Murder), not just lethal damage",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Mountain", "Patchwork Gnomes"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Patchwork Gnomes"] },
      { "pass": true, "player": 1 },
      { "activate": "Patchwork Gnomes" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "battlefield": ["Mountain", "Patchwork Gnomes"], "graveyard_has": ["Forest"] },
        { "graveyard_has": ["Murder"] }
      ],
      "tapped": { "Patchwork Gnomes": true }
    }
  }
]
