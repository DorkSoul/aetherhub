[
  {
    "name": "{1}{R}{R}: puts a +1/+1 counter on it",
    "players": [
      { "battlefield": ["Molten Hydra", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Molten Hydra" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Molten Hydra": { "PlusOnePlusOne": 1 } },
      "pt": { "Molten Hydra": [2, 2] }
    }
  },
  {
    "name": "taps and removes all +1/+1 counters to deal that much damage",
    "players": [
      { "battlefield": [{ "name": "Molten Hydra", "counters": { "p1p1": 3 } }] },
      {}
    ],
    "steps": [
      { "activate": "Molten Hydra", "ability": 1, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 17 }],
      "counters": { "Molten Hydra": { "PlusOnePlusOne": 0 } },
      "tapped": { "Molten Hydra": true }
    }
  },
  {
    "name": "with no counters it deals no damage",
    "players": [
      { "battlefield": ["Molten Hydra"] },
      {}
    ],
    "steps": [
      { "activate": "Molten Hydra", "ability": 1, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "tapped": { "Molten Hydra": true }
    }
  }
]
