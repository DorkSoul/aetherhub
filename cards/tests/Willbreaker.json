[
  {
    "name": "targeting an opponent's creature with your spell steals it",
    "players": [
      { "hand": ["Built to Last"], "battlefield": ["Plains", "Island", "Island", "Island", "Willbreaker"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Built to Last", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "opponent's spell targeting its own creature does not steal it",
    "players": [
      { "battlefield": ["Willbreaker"] },
      { "hand": ["Built to Last"], "battlefield": ["Plains", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Built to Last", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Willbreaker"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: Willbreaker leaving before its trigger resolves, so the opponent's creature is not gained",
    "players": [
      { "hand": ["Built to Last", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Island", "Island", "Mountain", "Willbreaker"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Built to Last", "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Willbreaker"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Willbreaker"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: when Willbreaker leaves the battlefield, its control-change effect ends and the stolen creature returns",
    "players": [
      { "hand": ["Built to Last", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Island", "Island", "Mountain", "Willbreaker"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Built to Last", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Willbreaker"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Willbreaker"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
