 {
  "name": "ruling: an opponent's first spell counts even when it is countered",
  "players": [
   { "hand": ["Counterspell"], "battlefield": ["Monologue Tax", "Island", "Island"] },
   { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Shock", "player": 1, "targets": ["p0"] },
   { "cast": "Counterspell", "targets": [ { "stack": "Shock" } ] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Shock", "player": 1, "targets": ["p0"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Monologue Tax", "Island", "Island", "Treasure"], "graveyard": ["Counterspell"], "life": 18 },
    { "graveyard": ["Shock", "Shock"] }
   ]
  }
 },
 {
  "name": "ruling: the third spell each turn gives no further Treasure",
  "players": [
