[
  {
    "name": "counters the first noncreature spell of the turn",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          {
            "name": "Nullstone Gargoyle",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "second noncreature spell is not countered",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          {
            "name": "Nullstone Gargoyle",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt",
            "Lightning Bolt"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "ruling: a spell cast in response to the first one is not countered",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", { "name": "Nullstone Gargoyle", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt", "Lightning Bolt"] }, { "life": 17 } ]
    }
  },
  {
    "name": "ruling: a noncreature spell cast before the Gargoyle entered does not count",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt", "Nullstone Gargoyle"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Nullstone Gargoyle" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt", "Lightning Bolt"], "battlefield_has": ["Nullstone Gargoyle"] }, { "life": 14 } ]
    }
  }
]
