[
  { "name": "opponent with two cards discards both and you draw nothing",
    "players": [ { "hand": ["Skull Raid"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
                 { "hand": ["Grizzly Bears", "Lightning Bolt"] } ],
    "steps": [ { "cast": "Skull Raid", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Skull Raid"] },
                             { "hand_count": 0, "graveyard": ["Grizzly Bears", "Lightning Bolt"] } ] } },
  { "name": "opponent with one card discards it and you draw one",
    "players": [ { "hand": ["Skull Raid"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
                 { "hand": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Skull Raid", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard": ["Skull Raid"] },
                             { "hand_count": 0, "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "opponent with an empty hand: you draw two",
    "players": [ { "hand": ["Skull Raid"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Skull Raid", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard": ["Skull Raid"] }, {} ] } },
  { "name": "foretell pays {2} and exiles the card face down",
    "players": [ { "hand": ["Skull Raid"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Skull Raid", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Skull Raid"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: a foretold card can't be cast on the turn it was foretold, but can be cast on a later turn for {1}{B}",
    "players": [ { "hand": ["Skull Raid"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Skull Raid", "ability": 0 },
               { "cast": "Skull Raid", "targets": ["p1"], "illegal": true },
               { "advance_to": "Main2" }, { "advance_to": "Main1" },
               { "advance_to": "Main2" }, { "advance_to": "Main1" },
               { "cast": "Skull Raid", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Skull Raid"] }, {} ] } },
  { "name": "ruling: foretelling is a special action in response to a spell on your turn; the card leaves the hand",
    "players": [ { "hand": ["Lightning Bolt", "Skull Raid"], "battlefield": ["Mountain", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Skull Raid", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Skull Raid"], "graveyard": ["Lightning Bolt"], "hand_count": 0 }, { "life": 17 } ] } }
]
