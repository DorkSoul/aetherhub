[
  {
    "name": "upkeep exiles one card from the opponent's library for one outlaw (itself)",
    "players": [
      { "battlefield": ["Laughing Jasper Flint"] },
      { "library": ["Forest", "Lightning Bolt", "Shock"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "exile": ["Lightning Bolt"], "library_top": ["Shock"] } ]
    }
  },
  {
    "name": "upkeep exiles two cards when two outlaws are controlled",
    "players": [
      { "battlefield": ["Laughing Jasper Flint", "Daring Thief"] },
      { "library": ["Forest", "Lightning Bolt", "Shock", "Island"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "exile": ["Lightning Bolt", "Shock"], "library_top": ["Island"] } ]
    }
  },
  {
    "name": "a creature we control but do not own is a Mercenary, so it counts as a second outlaw",
    "players": [
      { "hand": ["Control Magic"], "battlefield": ["Laughing Jasper Flint", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Forest", "Lightning Bolt", "Shock", "Island"] }
    ],
    "steps": [
      { "cast": "Control Magic", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "exile": ["Lightning Bolt", "Shock"], "library_top": ["Island"] } ]
    }
  },
  {
    "name": "ruling: a non-outlaw creature does not add to X, so one card is exiled",
    "players": [
      { "battlefield": ["Laughing Jasper Flint", "Grizzly Bears"] },
      { "library": ["Forest", "Lightning Bolt", "Shock"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "exile": ["Lightning Bolt"], "library_top": ["Shock"] } ]
    }
  },
  {
    "name": "ruling: a creature exiled by the upkeep ability is cast in the main phase, not in upkeep",
    "players": [
      { "battlefield": ["Laughing Jasper Flint", "Forest", "Forest"] },
      { "library": ["Island", "Grizzly Bears", "Shock"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true },
      { "advance_to": "Main1" },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "exile": [] } ]
    }
  }
]
