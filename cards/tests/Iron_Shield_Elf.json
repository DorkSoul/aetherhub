[
  {
    "name": "discard a card: gains indestructible and taps",
    "players": [ { "hand": ["Swamp"], "battlefield": ["Iron-Shield Elf"] }, {} ],
    "steps": [
      { "activate": "Iron-Shield Elf", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Swamp"], "battlefield_has": ["Iron-Shield Elf"] }, {} ],
      "keywords": { "Iron-Shield Elf": ["Indestructible"] }
    }
  },
  {
    "name": "indestructible survives lethal damage from Lightning Bolt",
    "players": [
      { "hand": ["Swamp"], "battlefield": ["Iron-Shield Elf"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Iron-Shield Elf", "ability": 0 },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Iron-Shield Elf"], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Iron-Shield Elf"] }, {} ] }
  },
  {
    "name": "without the ability, Lightning Bolt kills it",
    "players": [
      { "battlefield": ["Iron-Shield Elf"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Iron-Shield Elf"], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Iron-Shield Elf"] }, {} ] }
  },
  {
    "name": "ruling: the ability can be activated while the Elf is already tapped",
    "players": [ { "hand": ["Swamp", "Swamp"], "battlefield": [ { "name": "Iron-Shield Elf", "tapped": true } ] }, {} ],
    "steps": [
      { "activate": "Iron-Shield Elf", "ability": 0, "answers": ["Swamp"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Swamp"], "hand_count": 1, "battlefield_has": ["Iron-Shield Elf"] }, {} ],
      "keywords": { "Iron-Shield Elf": ["Indestructible"] },
      "tapped": { "Iron-Shield Elf": true }
    }
  }
]
