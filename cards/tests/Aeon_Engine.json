[
 {
  "name": "reversing the turn order makes the previous player take the next turn",
  "players": [
   {
    "battlefield": [
     {
      "name": "Aeon Engine",
      "sick": false
     }
    ]
   },
   {},
   {
    "hand": [
     "Mountain"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Aeon Engine"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "pass": true
   },
   {
    "advance_to": "Main1"
   },
   {
    "play_land": "Mountain",
    "player": 2
   }
  ],
  "expect": {
   "players": [
    {
     "exile": [
      "Aeon Engine"
     ]
    },
    {},
    {
     "battlefield_has": [
      "Mountain"
     ]
    }
   ]
  }
 },
 {
  "name": "without reversal the next player takes the turn",
  "players": [
   {
    "battlefield": [
     {
      "name": "Aeon Engine",
      "sick": false
     }
    ]
   },
   {
    "hand": [
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "pass": true
   },
   {
    "advance_to": "Main1"
   },
   {
    "play_land": "Mountain",
    "player": 1
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "battlefield_has": [
      "Mountain"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "enters tapped: a cast Aeon Engine comes in tapped",
  "players": [
   {
    "hand": ["Aeon Engine"],
    "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"]
   },
   {}
  ],
  "steps": [
   {"cast": "Aeon Engine"},
   {"resolve": true}
  ],
  "expect": {
   "players": [
    {"battlefield_has": ["Aeon Engine"]},
    {}
   ],
   "tapped": {"Aeon Engine": true}
  }
 },
 {
  "name": "ruling: reversing twice returns to the default order (the turn after p0 goes to p1)",
  "players": [
   {"battlefield": [{"name": "Aeon Engine", "sick": false}]},
   {"hand": ["Mountain"]},
   {"battlefield": [{"name": "Aeon Engine", "sick": false}]}
  ],
  "steps": [
   {"activate": "Aeon Engine"},
   {"activate": "Aeon Engine", "player": 2},
   {"resolve": true},
   {"resolve": true},
   {"advance_to": "End"},
   {"pass": true},
   {"advance_to": "Main1"},
   {"play_land": "Mountain", "player": 1}
  ],
  "expect": {
   "players": [
    {"exile": ["Aeon Engine"]},
    {"battlefield_has": ["Mountain"]},
    {"exile": ["Aeon Engine"]}
   ]
  }
 },
 {
  "name": "ruling: reversing during an extra turn, the next normal turn goes to the next player in the reversed order (p2)",
  "players": [
   {
    "hand": ["Alrund's Epiphany"],
    "battlefield": ["Aeon Engine", "Island", "Island", "Island", "Island", "Island", "Island", "Island"]
   },
   {},
   {"hand": ["Mountain"]}
  ],
  "steps": [
   {"cast": "Alrund's Epiphany"},
   {"resolve": true},
   {"advance_to": "End"},
   {"pass": true},
   {"advance_to": "Main1"},
   {"activate": "Aeon Engine"},
   {"resolve": true},
   {"advance_to": "End"},
   {"pass": true},
   {"advance_to": "Main1"},
   {"play_land": "Mountain", "player": 2}
  ],
  "expect": {
   "players": [
    {"exile": ["Aeon Engine", "Alrund's Epiphany"]},
    {},
    {"battlefield_has": ["Mountain"]}
   ]
  }
 }
]