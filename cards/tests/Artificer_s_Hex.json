[
 {
  "name": "upkeep: destroys the creature the enchanted Equipment is attached to",
  "players": [
   { "hand": ["Artificer's Hex"], "battlefield": ["Bonesplitter", "Grizzly Bears", "Swamp", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Bonesplitter", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Artificer's Hex", "targets": ["Bonesplitter"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Grizzly Bears"] }, {} ] }
 },
 {
  "name": "unattached Equipment: nothing is destroyed",
  "players": [
   { "hand": ["Artificer's Hex"], "battlefield": ["Bonesplitter", "Grizzly Bears", "Swamp"] },
   {}
  ],
  "steps": [
   { "cast": "Artificer's Hex", "targets": ["Bonesplitter"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "graveyard": [] }, {} ] }
 },
 {
  "name": "ruling: the trigger checks at the controller's own upkeep, not the opponent's",
  "players": [
   { "hand": ["Artificer's Hex"], "battlefield": ["Bonesplitter", "Grizzly Bears", "Swamp", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Bonesplitter", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Artificer's Hex", "targets": ["Bonesplitter"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Artificer's Hex"] }, {} ] }
 }
]
