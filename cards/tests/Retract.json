[
  {
    "name": "returns all artifacts you control to hand, not your opponent's",
    "players": [ { "hand": ["Retract"], "battlefield": ["Island", "Sol Ring", "Ornithopter"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [
      { "cast": "Retract" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "hand": ["Sol Ring", "Ornithopter"], "graveyard_has": ["Retract"], "battlefield_lacks": ["Sol Ring", "Ornithopter"] },
      { "battlefield_has": ["Sol Ring"] }
    ] }
  },
  {
    "name": "no artifacts of your own: nothing moves",
    "players": [ { "hand": ["Retract"], "battlefield": ["Island"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [
      { "cast": "Retract" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Retract"] }, { "battlefield_has": ["Sol Ring"] } ] }
  }
]
