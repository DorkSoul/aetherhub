[
  {
    "name": "instant or sorcery with less than five mana spent adds one counter",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Tackle Artist"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Tackle Artist"] }, {} ],
      "pt": { "Tackle Artist": [5, 4] }
    }
  },
  {
    "name": "five mana spent on an instant or sorcery adds two counters",
    "players": [
      { "hand": ["Sphinx's Revelation"], "battlefield": ["Plains", "Island", "Island", "Island", "Island", "Island", "Tackle Artist"] },
      {}
    ],
    "steps": [
      { "cast": "Sphinx's Revelation", "answers": [3] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 23, "hand_count": 3 }, {} ],
      "pt": { "Tackle Artist": [6, 5] }
    }
  },
  {
    "name": "a creature spell does not trigger opus",
    "players": [
      { "hand": ["Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Tackle Artist"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Tackle Artist", "Hill Giant"] }, {} ],
      "pt": { "Tackle Artist": [4, 3] }
    }
  },
  {
    "name": "ruling: opus resolves before the spell even when the instant is countered; counter still placed",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Tackle Artist"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Divination" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "player": 1, "cast": "Counterspell" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Divination"], "battlefield_has": ["Tackle Artist"] },
        { "graveyard": ["Counterspell"] }
      ],
      "pt": { "Tackle Artist": [5, 4] }
    }
  }
]
