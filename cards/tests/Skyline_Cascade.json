[
  {
    "name": "enters tapped",
    "players": [
      {
        "hand": [
          "Skyline Cascade"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Skyline Cascade"
      }
    ],
    "expect": {
      "tapped": {
        "Skyline Cascade": true
      }
    }
  },
  {
    "name": "ETB trigger does not tap the opposing creature it targets",
    "players": [
      {
        "hand": [
          "Skyline Cascade"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "play_land": "Skyline Cascade"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "ruling: a tapped creature can be targeted and stays tapped through its controller's next untap step",
    "players": [
      { "hand": ["Skyline Cascade"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "play_land": "Skyline Cascade" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": true }
    }
  }
]
