   "expect": { "players": [ { "graveyard": ["Rockalanche"] }, {} ], "pt": { "Plains": [3, 3] }, "keywords": { "Plains": ["Haste"] }, "counters": { "Plains": { "p1p1": 3 } } } },
 { "name": "with one Forest the earthbend is X = 1 (only Forests count, not other lands)",
   "players": [ { "hand": ["Rockalanche"], "battlefield": ["Forest", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Rockalanche", "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Rockalanche"] }, {} ], "pt": { "Plains": [1, 1] }, "counters": { "Plains": { "p1p1": 1 } } } },
