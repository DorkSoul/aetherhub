   "steps": [ { "cast": "Rockalanche", "alt": 0, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Rockalanche"] }, {} ], "pt": { "Plains": [2, 2] }, "counters": { "Plains": { "p1p1": 2 } } } },
