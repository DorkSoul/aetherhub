   "players": [ { "graveyard": ["Rockalanche"], "battlefield": ["Forest", "Plains", "Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Rockalanche", "alt": 0, "targets": ["Plains"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Rockalanche" }] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Rockalanche"] }, {} ] } },
 { "name": "ruling: a land that is earthbent is colorless",
   "players": [ { "hand": ["Rockalanche"], "battlefield": ["Forest", "Forest", "Plains"] }, {} ],
   "steps": [ { "cast": "Rockalanche", "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Rockalanche"] }, {} ], "colors": { "Plains": [] }, "pt": { "Plains": [2, 2] } } },
 { "name": "ruling: earthbending a land that is already a creature adds counters again",
   "players": [ { "hand": ["Rockalanche"], "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Rockalanche", "targets": ["Plains"] }, { "resolve": true }, { "cast": "Rockalanche", "alt": 0, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Rockalanche"] }, {} ], "pt": { "Plains": [4, 4] }, "counters": { "Plains": { "p1p1": 4 } } } },
 { "name": "ruling: an earthbent land that dies returns to the battlefield tapped",
   "players": [ { "hand": ["Rockalanche", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Plains", "Mountain"] }, {} ],
   "steps": [ { "cast": "Rockalanche", "targets": ["Plains"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Plains"], "graveyard": ["Rockalanche", "Lightning Bolt"] }, {} ], "tapped": { "Plains": true } } },
 { "name": "ruling: an earthbent land that is bounced is not returned to the battlefield",
   "players": [ { "hand": ["Rockalanche", "Unsummon"], "battlefield": ["Forest", "Forest", "Plains", "Island"] }, {} ],
   "steps": [ { "cast": "Rockalanche", "targets": ["Plains"] }, { "resolve": true }, { "cast": "Unsummon", "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Plains"], "battlefield_lacks": ["Plains"] }, {} ] } },
 { "name": "ruling: flashback follows sorcery timing, so it is illegal in combat",
   "players": [ { "graveyard": ["Rockalanche"], "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "advance_to": "BeginCombat" }, { "cast": "Rockalanche", "alt": 0, "illegal": true }, { "advance_to": "Main2" }, { "cast": "Rockalanche", "alt": 0, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Rockalanche"] }, {} ], "pt": { "Plains": [2, 2] } } },
