  {
    "name": "a spell that targets another creature does not trigger heroic",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Centaur Battlemaster"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Centaur Battlemaster": [
          3,
          3
        ]
      },
      "players": [
        {},
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: the heroic trigger resolves before the spell that caused it (3/3 survives Bolt)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Centaur Battlemaster"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Centaur Battlemaster"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Centaur Battlemaster"], "graveyard_has": ["Lightning Bolt"] },
        {}
      ],
      "counters": { "Centaur Battlemaster": { "p1p1": 3 } }
    }
  },
  {
    "name": "ruling: a copy does not trigger heroic, even when the copy's new target is the creature",
    "players": [
      { "hand": ["Lightning Bolt", "Twincast"], "battlefield": ["Mountain", "Island", "Island", "Island", "Centaur Battlemaster"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "cast": "Twincast", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": ["Centaur Battlemaster"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Centaur Battlemaster", "Twincast"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]