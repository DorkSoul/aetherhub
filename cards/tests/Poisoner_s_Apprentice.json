[
  {
    "name": "infusion: -4/-4 when you gained life this turn",
    "players": [{ "hand": ["Poisoner's Apprentice"], "battlefield": ["Swamp", "Swamp", "Swamp", "Aardvark Sloth"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [{ "card": "Aardvark Sloth", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Poisoner's Apprentice" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 23, "battlefield_has": ["Poisoner's Apprentice"] }, { "graveyard": ["Grizzly Bears"] }] }
  },
  {
    "name": "no life gained this turn: the target is unaffected",
    "players": [{ "hand": ["Poisoner's Apprentice"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "cast": "Poisoner's Apprentice" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Poisoner's Apprentice"] }, { "battlefield_has": ["Grizzly Bears"] }], "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "ruling: life gained after the infusion trigger is put on the stack still counts (checked on resolution)",
    "players": [{ "hand": ["Poisoner's Apprentice", "Healing Salve"], "battlefield": ["Swamp", "Swamp", "Swamp", "Plains"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "cast": "Poisoner's Apprentice" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Healing Salve", "targets": ["p0"], "answers": [0] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 23, "battlefield_has": ["Poisoner's Apprentice"] }, { "graveyard": ["Grizzly Bears"] }] }
  }
]
