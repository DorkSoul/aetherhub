[
  {
    "name": "enters with a shield counter",
    "players": [
      { "hand": ["Swooping Protector"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Swooping Protector" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swooping Protector"] },
        {}
      ],
      "counters": { "Swooping Protector": { "shield": 1 } },
      "keywords": { "Swooping Protector": ["Flash", "Flying"] }
    }
  },
  {
    "name": "the shield counter prevents the damage and is removed instead",
    "players": [
      { "hand": ["Swooping Protector"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Swooping Protector" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Swooping Protector"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swooping Protector"], "graveyard": [] },
        { "graveyard": ["Lightning Bolt"] }
      ],
      "counters": { "Swooping Protector": { "shield": 0 } }
    }
  },
  {
    "name": "ruling: with two shield counters, damage is prevented and only one shield counter is removed",
    "players": [
      { "battlefield": [{ "name": "Swooping Protector", "counters": { "shield": 2 } }, "Plains", "Plains", "Plains", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Swooping Protector"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swooping Protector"] },
        { "graveyard": ["Lightning Bolt"] }
      ],
      "counters": { "Swooping Protector": { "shield": 1 } }
    }
  }
]
