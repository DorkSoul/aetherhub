[
  { "name": "ruling: a flashback spell that is countered is exiled, not put in the graveyard",
    "players": [ { "graveyard": ["Solstice Revelations"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "library": ["Hill Giant"] }, { "battlefield": ["Island", "Island"], "hand": ["Negate"] } ],
    "steps": [ { "cast": "Solstice Revelations", "alt": 0 }, { "pass": true }, { "cast": "Negate", "player": 1, "targets": [{ "stack": "Solstice Revelations" }] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Solstice Revelations"], "library_top": ["Hill Giant"] }, { "graveyard_has": ["Negate"] } ] } },
  { "name": "exiled nonland card cheaper than the Mountains you control is cast free",
    "players": [ { "hand": ["Solstice Revelations"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Solstice Revelations" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand_count": 0 }, {} ] } },
  { "name": "exiled card too expensive is put into hand",
    "players": [ { "hand": ["Solstice Revelations"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Hill Giant"] }, {} ],
    "steps": [ { "cast": "Solstice Revelations" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Hill Giant"], "graveyard_has": ["Solstice Revelations"] }, {} ] } },
  { "name": "flashback {6}{R} then exiled; too expensive card goes to hand",
    "players": [ { "graveyard": ["Solstice Revelations"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "library": ["Hill Giant"] }, {} ],
    "steps": [ { "cast": "Solstice Revelations", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Hill Giant"], "exile": ["Solstice Revelations"] }, {} ] } }
]
