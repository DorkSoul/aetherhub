[
  {
    "name": "combat damage to a player returns a creature card with MV 4 or less from my graveyard with a finality counter",
    "players": [
      { "battlefield": [ { "name": "U.S.S. Reliant, From Hell's Heart", "counters": { "charge": 10 } } ], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "U.S.S. Reliant, From Hell's Heart", "at": "p1" } ] },
      { "advance_to": "Main2", "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["U.S.S. Reliant, From Hell's Heart", "Grizzly Bears"] }, { "life": 16 } ],
      "counters": { "Grizzly Bears": { "finality": 1 } }
    }
  },
  {
    "name": "combat damage with only a non-creature card in my graveyard: nothing returns",
    "players": [
      { "battlefield": [ { "name": "U.S.S. Reliant, From Hell's Heart", "counters": { "charge": 10 } } ], "graveyard": ["Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "U.S.S. Reliant, From Hell's Heart", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "battlefield_lacks": ["Grizzly Bears"] }, { "life": 16 } ] }
  }
]
