[
 { "name": "prevents a red spell on the stack",
   "players": [ { "battlefield": ["Burrenton Forge-Tender", "Grizzly Bears"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
              { "activate": "Burrenton Forge-Tender", "player": 0 },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield": ["Grizzly Bears"], "graveyard": ["Burrenton Forge-Tender"] },
                            { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "prevents all damage from a red attacker",
   "players": [ { "battlefield": ["Burrenton Forge-Tender", "Goblin Piker"] },
                { } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Goblin Piker", "at": "p1" } ] },
              { "activate": "Burrenton Forge-Tender" },
              { "resolve": true },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "a different red source still deals damage",
   "players": [ { "battlefield": ["Burrenton Forge-Tender", "Grizzly Bears"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Goblin Piker"] } ],
   "steps": [ { "activate": "Burrenton Forge-Tender" },
              { "resolve": true },
              { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Burrenton Forge-Tender", "Grizzly Bears"] },
                            { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "protection from red: a red attacker blocked by it deals no damage and dies to its 1 power",
   "players": [ { "battlefield": ["Burrenton Forge-Tender"] }, { "battlefield": ["Goblin Piker"] } ],
   "steps": [ { "advance_to": "End" }, { "advance_to": "Upkeep" },
              { "attack": [ { "card": "Goblin Piker", "at": "p0" } ], "player": 1 },
              { "block": [ { "blocker": "Burrenton Forge-Tender", "attacker": "Goblin Piker" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Burrenton Forge-Tender"] }, { "graveyard": ["Goblin Piker"] } ] } },
 { "name": "protection from red: a red creature cannot block it, so the 1/1 hits for 1",
   "players": [ { "battlefield": ["Burrenton Forge-Tender"] }, { "battlefield": ["Goblin Piker", "Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Burrenton Forge-Tender", "at": "p1" } ] },
              { "block": [ { "blocker": "Goblin Piker", "attacker": "Burrenton Forge-Tender" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 19, "battlefield_has": ["Goblin Piker", "Grizzly Bears"] } ] } },
 { "name": "ruling: can activate with no red source to choose; the Forge-Tender is still sacrificed",
   "players": [ { "battlefield": ["Burrenton Forge-Tender"] }, {} ],
   "steps": [ { "activate": "Burrenton Forge-Tender" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Burrenton Forge-Tender"] }, {} ] } }
]
