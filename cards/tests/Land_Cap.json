[
  {
    "name": "tapping for mana taps it (depletion counter asserted via the next two scenarios)",
    "players": [
      {
        "battlefield": [
          "Land Cap"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Land Cap"
      }
    ],
    "expect": {
      "tapped": {
        "Land Cap": true
      }
    }
  },
  {
    "name": "stays tapped through its controller's untap step while it has a depletion counter",
    "players": [
      {
        "battlefield": [
          "Land Cap"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Land Cap"
      },
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "tapped": {
        "Land Cap": true
      },
      "turn": 3
    }
  },
  {
    "name": "upkeep removes the counter, so it untaps in the following untap step",
    "players": [
      {
        "battlefield": [
          "Land Cap"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Land Cap"
      },
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "tapped": {
        "Land Cap": false
      },
      "turn": 5
    }
  }
]
