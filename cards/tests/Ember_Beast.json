[
  {
    "name": "can't attack alone",
    "players": [ { "battlefield": ["Ember Beast"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Ember Beast", "at": "p1" } ], "illegal": true }
    ],
    "expect": { "tapped": { "Ember Beast": false } }
  },
  {
    "name": "can attack together with another creature",
    "players": [ { "battlefield": ["Ember Beast", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Ember Beast", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Ember Beast": true, "Grizzly Bears": true } }
  },
  {
    "name": "can't block alone",
    "players": [ { "battlefield": ["Hill Giant"] }, { "battlefield": ["Ember Beast"] } ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "block": [ { "blocker": "Ember Beast", "attacker": "Hill Giant" } ], "illegal": true }
    ],
    "expect": { "players": [ {}, {} ] }
  },
  { "name": "attacking alone: the declared Ember Beast is dropped, so no damage and it stays untapped",
    "players": [ { "battlefield": ["Ember Beast", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Ember Beast", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20 } ], "tapped": { "Ember Beast": false } } },
  { "name": "blocking alone: the declared lone Ember Beast block is dropped, so Grizzly Bears connects for 2",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Ember Beast", "Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "pass": true },
      { "block": [ { "blocker": "Ember Beast", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "ruling: two Ember Beasts can attack together",
    "players": [ { "battlefield": ["Ember Beast", "Ember Beast"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Ember Beast", "at": "p1" }, { "card": "Ember Beast", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 14 } ] } },
  { "name": "ruling: once declared, Ember Beast still attacks even if its partner is blocked and dies",
    "players": [ { "battlefield": ["Ember Beast", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Ember Beast", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "pass": true },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"] }, { "life": 17 } ] } }
]
