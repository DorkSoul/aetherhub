[
  { "name": "pay WUBRG to cast a spell you could not otherwise pay for",
    "players": [ { "hand": ["Serra Angel"], "battlefield": ["Fist of Suns", "Plains", "Island", "Swamp", "Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Serra Angel", "alt": 100 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Serra Angel"] }, {} ] } },
  { "name": "boundary: four of the five colors are not enough for the alternative cost",
    "players": [ { "hand": ["Serra Angel"], "battlefield": ["Fist of Suns", "Plains", "Island", "Swamp", "Mountain"] }, {} ],
    "steps": [ { "cast": "Serra Angel", "alt": 100, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Serra Angel"], "battlefield_lacks": ["Serra Angel"] }, {} ] } },
  { "name": "without Fist of Suns the five-color alternative cost is not offered",
    "players": [ { "hand": ["Serra Angel"], "battlefield": ["Plains", "Island", "Swamp", "Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Serra Angel", "alt": 100, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Serra Angel"] }, {} ] } },
  { "name": "ruling: the alternative cost makes X 0 even with a spare Mountain (auto-chosen X)",
    "players": [ { "hand": ["Blaze"], "battlefield": ["Fist of Suns", "Plains", "Island", "Swamp", "Mountain", "Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Blaze", "alt": 100, "targets": ["p1"], "auto": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blaze"] }, { "life": 20 } ] } },
  { "name": "ruling: kicker is paid in addition to the alternative cost",
    "players": [ { "hand": ["Joraga Warcaller"], "battlefield": ["Fist of Suns", "Plains", "Island", "Swamp", "Mountain", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Joraga Warcaller", "alt": 100, "answers": [1] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Joraga Warcaller"] }, {} ], "pt": { "Joraga Warcaller": [2, 2] } } }
]
