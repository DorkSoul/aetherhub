[
 { "name": "a spell targeting it puts a +1/+1 counter on it (heroic)",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Sage of Hours"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Sage of Hours"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "counters": { "Sage of Hours": { "p1p1": 1 } }, "pt": { "Sage of Hours": [5, 5] } } },
 { "name": "a spell that targets another creature does not trigger heroic",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Sage of Hours", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "pt": { "Sage of Hours": [1, 1] } } },
 { "name": "removing five counters takes an extra turn",
   "players": [ { "battlefield": [{ "name": "Sage of Hours", "counters": { "p1p1": 5 } }] }, {} ],
   "start": "End",
   "steps": [ { "activate": "Sage of Hours" }, { "resolve": true }, { "advance_to": "Main1" } ],
   "expect": { "turn": 2, "players": [ { "hand_count": 1 }, { "hand_count": 0 } ] } },
 { "name": "removing four counters takes no extra turn",
   "players": [ { "battlefield": [{ "name": "Sage of Hours", "counters": { "p1p1": 4 } }] }, {} ],
   "start": "End",
   "steps": [ { "activate": "Sage of Hours" }, { "resolve": true }, { "advance_to": "Main1" } ],
   "expect": { "turn": 2, "players": [ { "hand_count": 0 }, { "hand_count": 1 } ] } },
 { "name": "ruling: all counters are removed even if not a multiple of five (three removed: no extra turn)",
   "players": [ { "battlefield": [{ "name": "Sage of Hours", "counters": { "p1p1": 3 } }] }, {} ],
   "start": "End",
   "steps": [ { "activate": "Sage of Hours" }, { "resolve": true }, { "advance_to": "Main1" } ],
   "expect": { "counters": { "Sage of Hours": { "p1p1": 0 } }, "turn": 2, "players": [ { "hand_count": 0 }, { "hand_count": 1 } ] } }
]
