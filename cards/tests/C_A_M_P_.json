[
  { "name": "fortify attaches C.A.M.P. to a target land you control for {3}",
    "players": [ { "battlefield": ["C.A.M.P.", "Forest", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "C.A.M.P.", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "attached": { "C.A.M.P.": "Forest" } } },
  { "name": "fortified Forest tapped for G: +1/+1 counter on a green creature and a Junk token",
    "players": [ { "battlefield": ["C.A.M.P.", "Forest", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "C.A.M.P.", "targets": ["Forest"] }, { "resolve": true }, { "tap_for_mana": "Forest" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] }, "players": [ { "battlefield_has": ["Junk"] }, {} ] } },
  { "name": "mana of a color the creature doesn't share: counter but no Junk token",
    "players": [ { "battlefield": ["C.A.M.P.", "Mountain", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "C.A.M.P.", "targets": ["Mountain"] }, { "resolve": true }, { "tap_for_mana": "Mountain" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] }, "players": [ { "battlefield": ["C.A.M.P.", "Mountain", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ] } },
  { "name": "tapping a land that isn't fortified does nothing",
    "players": [ { "battlefield": ["C.A.M.P.", "Forest", "Island", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "C.A.M.P.", "targets": ["Forest"] }, { "resolve": true }, { "tap_for_mana": "Island" } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: no Junk if the trigger's target creature is gone when it resolves (Bolt in response)",
    "players": [ { "battlefield": ["C.A.M.P.", "Forest", "Plains", "Plains", "Plains", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "activate": "C.A.M.P.", "targets": ["Forest"] }, { "resolve": true }, { "tap_for_mana": "Forest" }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Junk"] }, { "graveyard_has": ["Lightning Bolt"] } ] } }
]
