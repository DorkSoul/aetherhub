[
  {
    "name": "with no artifacts it costs six and bounces the artifact",
    "players": [
      { "hand": ["Into Thin Air"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Into Thin Air" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Into Thin Air"] }, { "hand": ["Sol Ring"] } ]
    }
  },
  {
    "name": "affinity: one artifact makes it cost five",
    "players": [
      { "hand": ["Into Thin Air"], "battlefield": ["Island", "Island", "Island", "Sol Ring"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Into Thin Air", "targets": ["p1:Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Into Thin Air"] }, { "hand": ["Sol Ring"] } ]
    }
  },
  {
    "name": "four Islands and no artifact cannot pay six",
    "players": [
      { "hand": ["Into Thin Air"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Into Thin Air", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Into Thin Air"] }, { "battlefield_has": ["Sol Ring"] } ]
    }
  }
