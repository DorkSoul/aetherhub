[
  {
    "name": "enters with six charge counters",
    "players": [ { "hand": ["Surge Node"], "battlefield": ["Plains"] }, {} ],
    "steps": [ { "cast": "Surge Node" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Surge Node"] }, {} ],
      "counters": { "Surge Node": { "charge": 6 } }
    }
  },
  {
    "name": "{1},{T}, remove a counter: put a charge counter on target artifact",
    "players": [ { "battlefield": [ { "name": "Surge Node", "counters": { "charge": 6 } }, "Mind Stone", "Plains" ] }, {} ],
    "steps": [ { "activate": "Surge Node", "ability": 0, "targets": ["Mind Stone"] }, { "resolve": true } ],
    "expect": {
      "players": [ {}, {} ],
      "counters": { "Surge Node": { "charge": 5 }, "Mind Stone": { "charge": 1 } },
      "tapped": { "Surge Node": true }
    }
  },
  {
    "name": "can target itself: the counter is removed and put back",
    "players": [ { "battlefield": [ { "name": "Surge Node", "counters": { "charge": 6 } }, "Plains" ] }, {} ],
    "steps": [ { "activate": "Surge Node", "ability": 0, "targets": ["Surge Node"] }, { "resolve": true } ],
    "expect": {
      "players": [ {}, {} ],
      "counters": { "Surge Node": { "charge": 6 } }
    }
  },
  {
    "name": "ruling: targeting itself with its last counter: the counter is removed and put back",
    "players": [ { "battlefield": [ { "name": "Surge Node", "counters": { "charge": 1 } }, "Plains" ] }, {} ],
    "steps": [ { "activate": "Surge Node", "ability": 0, "targets": ["Surge Node"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Surge Node"] }, {} ],
      "counters": { "Surge Node": { "charge": 1 } }
    }
  },
  {
    "name": "ruling: out of charge counters, the node remains on the battlefield",
    "players": [ { "battlefield": [ { "name": "Surge Node", "counters": { "charge": 1 } }, "Mind Stone", "Plains" ] }, {} ],
    "steps": [ { "activate": "Surge Node", "ability": 0, "targets": ["Mind Stone"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Surge Node"] }, {} ],
      "counters": { "Surge Node": { "charge": 0 }, "Mind Stone": { "charge": 1 } },
      "tapped": { "Surge Node": true }
    }
  }
]
