[
  {
    "name": "sacrifice for 2 life, then draw from the graveyard trigger",
    "players": [
      { "battlefield": ["Plains", "Implement of Improvement"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "activate": "Implement of Improvement", "ability": 0 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 22, "graveyard": ["Implement of Improvement"], "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "needs W mana to activate",
    "players": [
      { "battlefield": ["Mountain", "Implement of Improvement"] },
      {}
    ],
    "steps": [
      { "activate": "Implement of Improvement", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Implement of Improvement"], "life": 20 }, {} ]
    }
  },
  {
    "name": "ruling: put into the graveyard by Disenchant (not sacrificed) still draws a card",
    "players": [
      { "battlefield": ["Implement of Improvement"], "library": ["Island"] },
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Disenchant", "targets": ["Implement of Improvement"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20, "graveyard": ["Implement of Improvement"], "hand_count": 1 }, {} ]
    }
  }
]
