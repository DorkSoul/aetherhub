[
  {
    "name": "untaps another artifact",
    "players": [
      {
        "battlefield": [
          "Manifold Key",
          {
            "name": "Sol Ring",
            "tapped": true
          },
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Manifold Key",
        "ability": 0,
        "targets": [
          "Sol Ring"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Sol Ring": false,
        "Manifold Key": true
      }
    }
  },
  {
    "name": "can't target itself with the untap",
    "players": [
      {
        "battlefield": [
          "Manifold Key",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Manifold Key",
        "illegal": true
      }
    ]
  },
  {
    "name": "target creature can't be blocked",
    "players": [
      {
        "battlefield": [
          "Manifold Key",
          "Sol Ring",
          "Mountain",
          "Mountain",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Manifold Key",
        "ability": 1,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "keywords": {
        "Grizzly Bears": [
          "Unblockable"
        ]
      },
      "tapped": {
        "Manifold Key": true
      }
    }
  },
  {
    "name": "ruling: making a blocked creature unblockable after blocks does not unblock it",
    "players": [
      {
        "battlefield": [
          "Manifold Key",
          "Forest",
          "Forest",
          "Forest",
          { "name": "Grizzly Bears", "sick": false }
        ]
      },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "activate": "Manifold Key", "ability": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"] },
        { "life": 20 }
      ]
    }
  }
]
