[
  {
    "name": "commander spell cast from exile deals its mana value to target opponent",
    "players": [
      {
        "command": [ "Grizzly Bears" ],
        "hand": [ "Pacifism" ],
        "battlefield": [ "Passionate Archaeologist", "Armory Paladin", "Forest", "Forest", "Plains", "Mountain", "Mountain" ],
        "library": [ "Lightning Bolt", "Island" ]
      },
      {
        "battlefield": [ "Hill Giant" ]
      }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Pacifism", "targets": [ "Hill Giant" ] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "targets": [ "p1" ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    },
    "commander": true
  },
  {
    "name": "a spell cast from hand does not trigger the granted ability",
