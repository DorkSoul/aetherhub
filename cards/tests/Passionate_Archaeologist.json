      {
        "command": [ "Grizzly Bears" ],
        "hand": [ "Lightning Bolt" ],
        "battlefield": [ "Passionate Archaeologist", "Forest", "Forest", "Mountain" ]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": [ "p1" ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    },
    "commander": true
  },
  {
    "name": "ruling: commander tax is tracked separately (no extra {2} for the second commander)",
    "players": [
      {
        "command": [ "Grizzly Bears", "Hill Giant" ],
        "battlefield": [ "Passionate Archaeologist", "Forest", "Plains", "Mountain", "Mountain", "Mountain", "Mountain" ]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Hill Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": [ "Grizzly Bears", "Hill Giant" ] }, {} ]
    },
    "commander": true
  }
