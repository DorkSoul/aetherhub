[
  {
    "name": "ruling: a declined upkeep choice is not made up later: only the counter added on the next upkeep counts", "players": [ { "hand": ["Incendiary", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ], "steps": [ { "cast": "Incendiary", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "targets": ["p1"] }, { "resolve": true } ], "expect": { "players": [ {}, { "life": 19, "graveyard_has": ["Grizzly Bears"] } ] } },
  {
   "name": "dies with one fuse counter (put on in upkeep): deals 1 to any target",
    "players": [ { "hand": ["Incendiary", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Incendiary", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 19, "graveyard_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "no fuse counter (declined in upkeep): the death trigger deals no damage",
    "players": [ { "hand": ["Incendiary", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Incendiary", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] }
  }
]
