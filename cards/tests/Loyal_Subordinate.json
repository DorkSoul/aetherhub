[
  {
    "name": "beginning of combat with your commander: each opponent loses 3 life",
    "players": [
      {
        "command": ["Llanowar Elves"],
        "battlefield": ["Loyal Subordinate", "Swamp", "Swamp", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Llanowar Elves" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17 }
      ]
    },
    "commander": true
  },
  {
    "name": "no commander on the battlefield: opponent keeps their life",
    "players": [
      {
        "battlefield": ["Loyal Subordinate"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: two commanders still give one lieutenant trigger per combat",
    "players": [
      {
        "command": ["Llanowar Elves", "Grizzly Bears"],
        "battlefield": ["Loyal Subordinate", "Swamp", "Swamp", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Llanowar Elves" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17 }
      ]
    },
    "commander": true
  },
  {
    "name": "ruling: with two commanders, controlling only one is enough",
    "players": [
      {
        "command": ["Llanowar Elves", "Grizzly Bears"],
        "battlefield": ["Loyal Subordinate", "Swamp", "Swamp", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Llanowar Elves" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "command": ["Grizzly Bears"] },
        { "life": 17 }
      ]
    },
    "commander": true
  }
]
