[
 { "name": "enters and deals 5 damage to the chosen creature",
   "players": [ { "hand": ["Outpace Oblivion"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Outpace Oblivion" }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
   "expect": { "players": [ { "battlefield_has": ["Outpace Oblivion"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "sacrifice: 2 damage only to the player without max speed",
   "players": [ { "battlefield": ["Outpace Oblivion", "Mountain", "Mountain"], "life": 20 }, { "life": 20 } ],
   "steps": [ { "set_speed": 4, "player": 0 }, { "activate": "Outpace Oblivion", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
 { "name": "sacrifice: nobody takes damage when both players have max speed",
   "players": [ { "battlefield": ["Outpace Oblivion", "Mountain", "Mountain"], "life": 20 }, { "life": 20 } ],
   "steps": [ { "set_speed": 4, "player": 0 }, { "set_speed": 4, "player": 1 }, { "activate": "Outpace Oblivion", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
 { "name": "start your engines: enters at speed 1 (no speed before it)",
   "players": [ { "hand": ["Outpace Oblivion"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Outpace Oblivion" }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
   "expect": { "players": [ { "speed": 1, "battlefield_has": ["Outpace Oblivion"] }, {} ] } },
 { "name": "ruling: speed is tracked per player: my Outpace Oblivion does not change the opponent's speed",
   "players": [ { "battlefield": ["Outpace Oblivion"] }, {} ],
   "steps": [ { "set_speed": 2, "player": 1 } ],
   "expect": { "players": [ { "speed": 1 }, { "speed": 2 } ] } },
 { "name": "ruling: my speed rises when the opponent loses life on my turn (Lightning Bolt to the face)",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Outpace Oblivion", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 2 }, { "life": 17 } ] } },
 { "name": "ruling: speed 3 is not max speed, so the sacrifice still damages that player",
   "players": [ { "battlefield": ["Outpace Oblivion", "Mountain", "Mountain"], "life": 20 }, { "life": 20 } ],
   "steps": [ { "set_speed": 4, "player": 0 }, { "set_speed": 3, "player": 1 }, { "activate": "Outpace Oblivion", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } }
]
