[
  {
    "name": "tap adds a charge counter",
    "players": [
      {
        "battlefield": [
          "Lux Cannon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lux Cannon",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Lux Cannon": {
          "charge": 1
        }
      },
      "tapped": {
        "Lux Cannon": true
      }
    }
  },
  {
    "name": "with three counters destroys target permanent",
    "players": [
      {
        "battlefield": [
          {
            "name": "Lux Cannon",
            "counters": {
              "charge": 3
            }
          }
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Lux Cannon",
        "ability": 1,
        "targets": [
          "p1:Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard_has": [
            "Hill Giant"
          ]
        }
      ],
      "counters": {
        "Lux Cannon": {
          "charge": 0
        }
      }
    }
  },
  {
    "name": "a tapped Cannon can't use either ability",
    "players": [
      {
        "battlefield": [
          {
            "name": "Lux Cannon",
            "counters": {
              "charge": 3
            },
            "tapped": true
          }
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Lux Cannon",
        "illegal": true
      }
    ]
  },
  {
    "name": "with two counters only the charging ability is available (it goes to three, then tapped)",
    "players": [
      {
        "battlefield": [
          {
            "name": "Lux Cannon",
            "counters": {
              "charge": 2
            }
          }
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Lux Cannon",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Lux Cannon": {
          "charge": 3
        }
      },
      "players": [
        {},
        {
          "battlefield": [
            "Hill Giant"
          ]
        }
      ]
    }
  }
]
