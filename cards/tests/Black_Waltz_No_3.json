[
  { "name": "casting a noncreature spell deals 2 to each opponent",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Black Waltz No. 3", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "casting a creature spell does not trigger it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Black Waltz No. 3", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "ruling: the trigger still deals its damage when the noncreature spell is countered",
    "players": [ { "hand": ["Shock"], "battlefield": ["Black Waltz No. 3", "Mountain"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] },
               { "pass": true },
               { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Shock" }] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Shock"] }, { "life": 18, "graveyard": ["Counterspell"] } ] } }
]
