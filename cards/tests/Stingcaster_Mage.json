[
 {
  "name": "the targeted instant gains flashback until end of turn and is exiled when it resolves",
  "players": [
   { "hand": ["Stingcaster Mage"], "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Lightning Bolt"] },
   {}
  ],
  "steps": [
   { "cast": "Stingcaster Mage" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Stingcaster Mage"], "exile": ["Lightning Bolt"] },
    { "life": 17 }
   ]
  }
 },
 {
  "name": "flashback applies only to the targeted card, not another instant in the graveyard",
  "players": [
   { "hand": ["Stingcaster Mage"], "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Lightning Bolt", "Shock"] },
   {}
  ],
  "steps": [
   { "cast": "Stingcaster Mage" },
   { "resolve": true, "targets": ["Lightning Bolt"] },
   { "cast": "Shock", "targets": ["p1"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt", "Shock"] },
    { "life": 20 }
   ]
  }
 },
 {
  "name": "haste: Stingcaster Mage can attack the turn it enters",
  "players": [
   { "hand": ["Stingcaster Mage"], "battlefield": ["Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Stingcaster Mage" },
   { "resolve": true },
   { "attack": [ { "card": "Stingcaster Mage", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Stingcaster Mage"] }, { "life": 18 } ]
  }
 }
]
