[
 {
  "name": "ETB returns an artifact card from your graveyard",
  "players": [
   {
    "hand": [
     "Elder Owyn Lyons"
    ],
    "battlefield": [
     "Plains",
     "Island",
     "Plains",
     "Island"
    ],
    "graveyard": [
     "Adventuring Gear"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Elder Owyn Lyons"
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Adventuring Gear"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "artifacts you control have ward {1}",
  "players": [
   {
    "battlefield": [
     "Elder Owyn Lyons",
     "Arcanist's Owl"
    ]
   },
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Mountain"
    ]
   }
  ],
  "steps": [
   {
    "pass": true
   },
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Arcanist's Owl"
    ],
    "player": 1
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Arcanist's Owl"
     ]
    },
    {
     "graveyard_has": [
      "Lightning Bolt"
     ]
    }
   ]
  }
 },
  {
    "name": "dies: return target artifact card from your graveyard to your hand",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Elder Owyn Lyons", "Mountain"], "graveyard": ["Adventuring Gear"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Elder Owyn Lyons"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Adventuring Gear"], "graveyard_has": ["Lightning Bolt", "Elder Owyn Lyons"] }, {}]
    }
  },
  {
    "name": "dies with no artifact card in your graveyard: nothing returns",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Elder Owyn Lyons", "Mountain"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Elder Owyn Lyons"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 0, "graveyard_has": ["Grizzly Bears", "Elder Owyn Lyons"] }, {}]
    }
  }
]
