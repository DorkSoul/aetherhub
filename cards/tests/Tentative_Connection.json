    "players": [
      { "hand": ["Tentative Connection"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Tentative Connection", "targets": ["Grizzly Bears"] },
