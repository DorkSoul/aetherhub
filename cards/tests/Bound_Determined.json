    "steps": [ { "cast": "Bound" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Lightning Bolt", "Ornithopter"], "exile": ["Bound"] }, {} ] } },
  { "name": "Determined draws a card",
    "players": [ { "hand": ["Bound"], "battlefield": ["Forest", "Island"] }, {} ],
