[
  {
    "name": "sacrifice: deals damage equal to its power to a creature",
    "players": [
      {
        "battlefield": [
          "Heartfire Immolator",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Heartfire Immolator",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Heartfire Immolator"
          ]
        },
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: prowess pump raises the power used for the sacrifice damage (last known power)",
    "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Heartfire Immolator", "Mountain", "Mountain"]}, {"battlefield": ["Hill Giant"]}],
    "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"activate": "Heartfire Immolator", "targets": ["Hill Giant"]}, {"resolve": true}],
    "expect": {"players": [{"graveyard_has": ["Heartfire Immolator", "Lightning Bolt"]}, {"life": 17, "graveyard_has": ["Hill Giant"]}]}
  },
  {
    "name": "ruling: the sacrifice is paid as a cost before the ability resolves",
    "players": [{"battlefield": ["Heartfire Immolator", "Mountain"]}, {"battlefield": ["Hill Giant"]}],
    "steps": [{"activate": "Heartfire Immolator", "targets": ["Hill Giant"]}],
    "expect": {"players": [{"graveyard_has": ["Heartfire Immolator"]}, {"battlefield_has": ["Hill Giant"]}]}
  },
  {
    "name": "sacrifice cost needs {R}: no red source means it can't be activated",
    "players": [
      {
        "battlefield": [
          "Heartfire Immolator",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Heartfire Immolator",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Heartfire Immolator"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  }
]
