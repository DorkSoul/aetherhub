[
  {
    "name": "keeps flying and phasing keywords",
    "players": [ { "battlefield": ["Shimmering Efreet"] }, {} ],
    "steps": [],
    "expect": { "keywords": { "Shimmering Efreet": ["Flying", "Phasing"] } }
  },
  {
    "name": "phasing out does not trigger its phase-in ability",
    "players": [ { "battlefield": ["Shimmering Efreet"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Shimmering Efreet"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "when it phases in, target creature phases out",
    "players": [ { "battlefield": ["Shimmering Efreet"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Shimmering Efreet"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: alone, it phases itself back out when it phases in",
    "players": [ { "battlefield": ["Shimmering Efreet"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Shimmering Efreet"] }, {} ] }
  }
]
