[
  { "name": "puts all creatures on the bottom of their owners' libraries, lands stay",
    "players": [ { "hand": ["Terminus"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Llanowar Elves"] } ],
    "steps": [ { "cast": "Terminus" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Terminus"], "battlefield_lacks": ["Grizzly Bears"], "library_count": 21, "battlefield_has": ["Plains"] }, { "battlefield": [], "library_count": 22 } ] } },
  { "name": "lands stay on the battlefield and the caster's own creature goes to the library",
    "players": [ { "hand": ["Terminus"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Terminus" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Plains"], "battlefield_lacks": ["Grizzly Bears"], "hand_count": 0 }, { "life": 20 } ] } },
  { "name": "miracle: first card drawn this turn is cast for {W} and puts creatures on the bottom of libraries",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Plains"], "library": ["Terminus", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Terminus", "Tormenting Voice"], "hand": ["Forest"] }, { "battlefield_lacks": ["Hill Giant"], "library_count": 21 } ] } },
  { "name": "miracle is declined: Terminus stays in hand and the creature stays",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Plains"], "library": ["Terminus", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Terminus", "Forest"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: only the first card drawn this turn can use miracle; Terminus drawn second is just a card in hand",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Plains"], "library": ["Forest", "Terminus"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest", "Terminus"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: a declined miracle is gone: later in the turn Terminus cannot be cast for {W}",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Plains"], "library": ["Terminus", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true, "answers": [false] }, { "cast": "Terminus", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Terminus", "Forest"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: miracle works on any turn: the opponent's Think Twice draws Terminus first, so they can cast it for {W} on my turn",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "hand": ["Think Twice"], "battlefield": ["Island", "Island", "Island", "Plains", "Plains"], "library": ["Terminus"] } ],
    "steps": [ { "pass": true }, { "cast": "Think Twice", "player": 1 }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "library_count": 21 }, { "graveyard_has": ["Terminus", "Think Twice"], "hand_count": 0 } ] } }
]
