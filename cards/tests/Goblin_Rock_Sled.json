[
  { "name": "defender controls no Mountain: cannot attack (Bears can attack, not declared)",
    "players": [ { "battlefield": ["Goblin Rock Sled", "Grizzly Bears"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [ { "card": "Goblin Rock Sled", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "cannot attack unless the defending player controls a Mountain",
    "players": [ { "battlefield": ["Goblin Rock Sled"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [ { "card": "Goblin Rock Sled", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "attacks a player who controls a Mountain (trample damage)",
    "players": [ { "battlefield": ["Goblin Rock Sled"] }, { "battlefield": ["Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Goblin Rock Sled", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "does not untap in its controller's untap step after attacking last turn",
    "players": [ { "battlefield": ["Goblin Rock Sled"] }, { "battlefield": ["Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Goblin Rock Sled", "at": "p1" } ] }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "tapped": { "Goblin Rock Sled": true } } },
  { "name": "untaps normally when it did not attack last turn",
    "players": [ { "battlefield": [ { "name": "Goblin Rock Sled", "tapped": true } ] }, { "battlefield": ["Mountain"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "tapped": { "Goblin Rock Sled": false } } }
]
