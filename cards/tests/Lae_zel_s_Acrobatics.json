[
  {
    "name": "exiles your nontoken creatures and returns them at the next end step",
    "players": [
      {
        "hand": [
          "Lae'zel's Acrobatics"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lae'zel's Acrobatics"
      },
      {
        "resolve": true,
        "auto": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears"
          ],
          "exile": []
        },
        {}
      ]
    }
  },
  {
    "name": "tokens are not exiled",
    "players": [
      {
        "hand": [
          "Lae'zel's Acrobatics"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Faerie 1-1 Blue Flying"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lae'zel's Acrobatics"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Faerie 1-1 Blue Flying"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: an Aura on an exiled creature goes to the graveyard and the creature returns with no counters",
    "rolls": [5],
    "players": [
      { "hand": ["Pacifism", "Lae'zel's Acrobatics"], "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 1 } }, "Plains", "Plains", "Plains", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Pacifism", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lae'zel's Acrobatics" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 0 } },
      "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Pacifism"] }, {} ]
    }
  },
  {
    "name": "ruling: on a 10-20 roll the creatures re-enter during the spell, so Kavu's enters trigger fires before the end step",
    "rolls": [15],
    "players": [
      { "hand": ["Lae'zel's Acrobatics"], "battlefield": ["Flametongue Kavu", "Plains", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lae'zel's Acrobatics" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Flametongue Kavu"] }, { "graveyard": ["Grizzly Bears"] } ] }
  }
]