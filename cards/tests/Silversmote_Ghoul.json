    }
   ],
   "tapped": {
    "Silversmote Ghoul": true
   }
  }
 },
 {
  "name": "no return if less than 3 life was gained this turn",
  "players": [
   {
    "graveyard": [
     "Silversmote Ghoul"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Silversmote Ghoul"
     ],
     "battlefield_lacks": [
      "Silversmote Ghoul"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "sacrifice {1}{B}: draw a card",
  "players": [
   {
    "battlefield": [
     "Swamp",
     "Swamp",
     "Silversmote Ghoul"
    ],
    "library": [
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Silversmote Ghoul",
    "ability": 0
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 1,
     "graveyard": [
      "Silversmote Ghoul"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: life gained earlier this turn counts even if life was lost later (Helix on yourself, then Bolt on yourself)",
  "players": [
    { "hand": ["Lightning Helix", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Plains", "Swamp", "Swamp", "Silversmote Ghoul"], "library": ["Island"] },
    {}
  ],
  "steps": [
    { "cast": "Lightning Helix", "targets": ["p0"] },
    { "resolve": true },
    { "cast": "Lightning Bolt", "targets": ["p0"] },
    { "resolve": true },
    { "activate": "Silversmote Ghoul", "ability": 0 },
    { "resolve": true },
    { "advance_to": "End" },
    { "resolve": true }
  ],
  "expect": {
    "players": [ { "life": 17, "battlefield_has": ["Silversmote Ghoul"] }, {} ],
    "tapped": { "Silversmote Ghoul": true }
  }
 },
 {
  "name": "ruling: a Ghoul still in hand at the end step does not trigger; it stays in hand",
  "players": [
    { "hand": ["Lightning Helix", "Silversmote Ghoul"], "battlefield": ["Mountain", "Plains"] },
    {}
  ],
  "steps": [
    { "cast": "Lightning Helix", "targets": ["p1"] },
    { "resolve": true },
    { "advance_to": "End" },
    { "resolve": true }
  ],
  "expect": {
    "players": [
      { "life": 23, "hand": ["Silversmote Ghoul"], "battlefield_lacks": ["Silversmote Ghoul"] },
      { "life": 17 }
    ]
  }
 }
]
