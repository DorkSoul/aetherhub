[
 {
  "name": "returns from the graveyard at end step after gaining 3 life this turn",
  "players": [
   {
    "hand": [
     "Lightning Helix"
    ],
    "battlefield": [
     "Mountain",
     "Plains"
    ],
    "graveyard": [
     "Silversmote Ghoul"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Lightning Helix",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 23,
     "battlefield_has": [
      "Silversmote Ghoul"
     ]
    },
    {
