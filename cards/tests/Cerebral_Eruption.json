[
  { "name": "nonland revealed: damages the opponent and each of their creatures by its mana value, goes to graveyard",
    "players": [
      { "hand": ["Cerebral Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Grizzly Bears"], "battlefield": ["Giant Spider"] } ],
    "steps": [ { "cast": "Cerebral Eruption", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [
      { "graveyard": ["Cerebral Eruption"] },
      { "life": 18, "battlefield_has": ["Giant Spider"] } ] } },
  { "name": "land revealed: no damage and the spell returns to its owner's hand",
    "players": [
      { "hand": ["Cerebral Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Forest"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Cerebral Eruption", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [
      { "hand": ["Cerebral Eruption"], "graveyard": [] },
      { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "damage hits only creatures the targeted opponent controls",
    "players": [
      { "hand": ["Cerebral Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "library": ["Giant Spider"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Cerebral Eruption", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [
      { "life": 20, "battlefield_has": ["Grizzly Bears"] },
      { "life": 16, "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: the revealed card's mana value counts all of its mana symbols, not only coloured ones",
    "players": [
      { "hand": ["Cerebral Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Tezzeret's Touch"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Cerebral Eruption", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [
      { "graveyard": ["Cerebral Eruption"] },
      { "life": 17, "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an {X} in the revealed card's cost counts as 0 (Fireball reveals mana value 1)",
    "players": [
      { "hand": ["Cerebral Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Fireball"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Cerebral Eruption", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [
      { "graveyard": ["Cerebral Eruption"] },
      { "life": 19, "battlefield_has": ["Grizzly Bears"] } ] } }
]
