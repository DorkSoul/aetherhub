[
  {
    "name": "your 3-power creature deals 3 damage to the opponent's 2/2, which dies",
    "players": [
      { "hand": ["Tenderize"], "battlefield": ["Forest", "Forest", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Tenderize", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"], "graveyard": ["Tenderize"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "2-power creature deals only 2 damage: a 3/3 survives",
    "players": [
      { "hand": ["Tenderize"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Tenderize", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: if the creature I control is removed in response, Tenderize deals no damage (the 2/2 survives a 3-power source)",
    "players": [
      { "hand": ["Tenderize"], "battlefield": ["Forest", "Forest", "Hill Giant"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Tenderize", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Hill Giant", "Tenderize"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
