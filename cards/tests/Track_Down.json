[
  {
    "name": "draws the revealed top card when it is a land",
    "players": [
      { "hand": ["Track Down"], "battlefield": ["Forest", "Forest"], "library": ["Forest", "Shock", "Shock", "Shock"] }
    ],
    "steps": [
      { "cast": "Track Down" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Forest"] } ] }
  },
  {
    "name": "does not draw when the revealed top card is neither creature nor land",
    "players": [
      { "hand": ["Track Down"], "battlefield": ["Forest", "Forest"], "library": ["Shock", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Track Down" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": [] } ] }
  },
  {
    "name": "draws the revealed card when it is a creature",
    "players": [
      { "hand": ["Track Down"], "battlefield": ["Forest", "Forest"], "library": ["Grizzly Bears", "Shock", "Shock", "Shock"] }
    ],
    "steps": [
      { "cast": "Track Down" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: a revealed card that is not drawn stays on top of the library",
    "players": [
      { "hand": ["Track Down"], "battlefield": ["Forest", "Forest"], "library": ["Shock", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Track Down" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": [], "exile": [], "library_top": ["Shock"] } ] }
  }
]
