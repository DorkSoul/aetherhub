  {
    "name": "ruling: once cast, it counts itself as an artifact on the battlefield (power 2 with Sol Ring)",
    "players": [
      {
        "hand": ["Cephalopod Sentry"],
        "battlefield": ["Sol Ring", "Plains", "Island", "Plains", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Cephalopod Sentry" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Cephalopod Sentry"] },
        {}
      ],
      "pt": {
        "Cephalopod Sentry": [2, 5]
      }
    }
  },
  {
    "name": "power drops when an artifact leaves",
    "players": [
      {
        "battlefield": [
          "Cephalopod Sentry"
        ]
      },
      {}
    ],
    "steps": [
      {
        "pass": true
      }
    ],
    "expect": {
      "pt": {
        "Cephalopod Sentry": [
          1,
          5
        ]
      }
    }
  }
