[
  { "name": "{U}{U}: the enchanted creature phases out (and the Aura with it)",
    "players": [
      { "hand": ["Vanishing"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Vanishing", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Vanishing", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Vanishing"] }, { "battlefield_lacks": ["Hill Giant"] } ]
    } },
  { "name": "the creature phases back in at its controller's next untap step",
    "players": [
      { "hand": ["Vanishing"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Vanishing", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Vanishing", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vanishing"] }, { "battlefield_has": ["Hill Giant"] } ]
    } },
  { "name": "with only one Island left the phase-out cannot be activated",
    "players": [
      { "hand": ["Vanishing"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Vanishing", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Vanishing", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vanishing"] }, { "battlefield_has": ["Hill Giant"] } ]
    } }
]
