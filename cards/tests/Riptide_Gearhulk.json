[
  { "name": "ETB puts the opponent's nonland creature into its library (off the battlefield)",
    "players": [
      { "hand": ["Riptide Gearhulk"], "battlefield": ["Plains", "Plains", "Island", "Island", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Riptide Gearhulk" }, { "resolve": true, "answers": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Riptide Gearhulk"] },
        { "battlefield": [] }
      ]
    }
  },
  { "name": "a land the opponent controls is not a legal target and stays put",
    "players": [
      { "hand": ["Riptide Gearhulk"], "battlefield": ["Plains", "Plains", "Island", "Island", "Mountain"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [ { "cast": "Riptide Gearhulk" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Riptide Gearhulk"] },
        { "battlefield": ["Forest"] }
      ]
    }
  }
]
