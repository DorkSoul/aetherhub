[
  {
    "name": "Shock to you is prevented and adds an incarnation counter",
    "players": [
      { "battlefield": ["Nine Lives"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Nine Lives": { "incarnation": 1 } },
      "players": [ { "life": 20 }, {} ]
    }
  },
  {
    "name": "ninth counter exiles Nine Lives and its leave trigger makes you lose",
    "players": [
      { "battlefield": [ { "name": "Nine Lives", "counters": { "incarnation": 8 } } ] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "winner": 1 }
  },
  {
    "name": "ruling: two sources dealing combat damage at once each put an incarnation counter on Nine Lives",
    "players": [
      { "battlefield": ["Nine Lives"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Llanowar Elves", "at": "p0" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Nine Lives": { "incarnation": 2 } },
      "players": [ { "life": 20 }, {} ]
    }
  }
]
