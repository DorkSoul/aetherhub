  {
    "name": "cannot be cast without a snow land",
    "players": [
      { "hand": ["Blizzard"], "battlefield": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Blizzard", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Blizzard"] }, {} ]
    }
  },
  {
    "name": "castable with a snow land; upkeep pays {2} for one age counter",
    "players": [
      { "hand": ["Blizzard"], "battlefield": ["Snow-Covered Forest", "Snow-Covered Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Blizzard" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Blizzard": { "age": 1 } },
      "players": [ { "battlefield_has": ["Blizzard"] }, {} ]
    }
  },
  {
    "name": "flying creatures don't untap in their controller's untap step; other creatures do",
    "players": [
      {
        "battlefield": [
          "Blizzard",
          "Snow-Covered Forest",
          "Snow-Covered Forest",
          { "name": "Serra Angel", "tapped": true },
          { "name": "Grizzly Bears", "tapped": true }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "tapped": { "Serra Angel": true, "Grizzly Bears": false }
    }
  }
]
