[
  {
    "name": "destroys the land and deals 13 to the creature",
    "players": [
      { "hand": ["Into the Maw of Hell"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Into the Maw of Hell", "targets": ["Forest", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Into the Maw of Hell"] },
        { "graveyard_has": ["Forest", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "needs a creature as well as a land",
    "players": [
      { "hand": ["Into the Maw of Hell"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Into the Maw of Hell", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Into the Maw of Hell"] }, { "battlefield_has": ["Forest"] } ]
    }
  },
  {
    "name": "ruling: one target illegal on resolution, Into still destroys the remaining land",
    "players": [
      { "hand": ["Into the Maw of Hell", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Into the Maw of Hell", "targets": ["Forest", "Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["p1:Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Into the Maw of Hell", "Lightning Bolt"] },
        { "graveyard_has": ["Forest", "Grizzly Bears"] }
      ]
    }
  }
