[
  {
    "name": "X=3 kills a 3/3 creature and exiles it instead",
    "players": [
      { "hand": ["Disintegrate"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Disintegrate", "targets": ["Hill Giant"], "answers": [3] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Disintegrate"] }, { "exile": ["Hill Giant"] }]
    }
  },
  {
    "name": "X=2 does not kill a 3/3 creature",
    "players": [
      { "hand": ["Disintegrate"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Disintegrate", "targets": ["Hill Giant"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Disintegrate"] }, { "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "X=3 to a player: life loss, nothing exiled",
    "players": [
      { "hand": ["Disintegrate"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Disintegrate", "targets": ["p1"], "answers": [3] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Disintegrate"] }, { "life": 17 }]
    }
  },
  {
    "name": "ruling: an exiled creature never dies, so Reaper of the Wilds does not scry",
    "players": [
      { "hand": ["Disintegrate"], "battlefield": ["Reaper of the Wilds", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Disintegrate", "targets": ["Hill Giant"], "answers": [3] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "library_top": ["Island"] }, { "exile": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: can't be regenerated applies, so a regeneration shield does not save the creature",
    "players": [
      { "hand": ["Disintegrate"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Drudge Skeletons", "Swamp"] }
    ],
    "steps": [
      { "cast": "Disintegrate", "targets": ["Drudge Skeletons"], "answers": [1] },
      { "pass": true },
      { "activate": "Drudge Skeletons", "ability": 0, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Disintegrate"] }, { "exile": ["Drudge Skeletons"] }]
    }
  }
]
