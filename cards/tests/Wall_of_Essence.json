[
  {
    "name": "combat damage dealt to the wall: its controller gains that much life",
    "players": [
      { "battlefield": ["Grizzly Bears"], "life": 20 },
      { "battlefield": ["Wall of Essence"], "life": 20 }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Wall of Essence", "attacker": "Grizzly Bears" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 22, "battlefield_has": ["Wall of Essence"] } ] }
  },
  {
    "name": "noncombat damage to the wall does not gain life",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain"], "life": 20 },
      { "battlefield": ["Wall of Essence"], "life": 20 }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Wall of Essence"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 20, "battlefield_has": ["Wall of Essence"] } ] }
  },
  {
    "name": "ruling: lethal combat damage still triggers: 6 damage kills the wall and gains 6 life",
    "players": [
      { "battlefield": ["Craw Wurm"], "life": 20 },
      { "battlefield": ["Wall of Essence"], "life": 20 }
    ],
    "steps": [
      { "attack": [ { "card": "Craw Wurm", "at": "p1" } ] },
      { "block": [ { "blocker": "Wall of Essence", "attacker": "Craw Wurm" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 26, "graveyard": ["Wall of Essence"] } ] }
  }
]
