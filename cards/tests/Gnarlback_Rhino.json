[
  {
    "name": "a spell that targets it draws a card",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Gnarlback Rhino",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Giant Growth",
        "targets": [
          "Gnarlback Rhino"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        },
        {}
      ],
      "pt": {
        "Gnarlback Rhino": [
          7,
          7
        ]
      }
    }
  },
  {
    "name": "an opponent's spell that targets it draws nothing",
    "players": [
      {
        "battlefield": [
          "Gnarlback Rhino"
        ]
      },
      {
        "hand": [
          "Shock"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "pass": true
      },
      {
        "cast": "Shock",
        "targets": [
          "Gnarlback Rhino"
        ],
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the draw still happens when the spell that targeted the Rhino is countered",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Gnarlback Rhino", "Forest"] },
      { "hand": ["Miscalculation"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Gnarlback Rhino"] },
      { "pass": true },
      { "player": 1, "cast": "Miscalculation", "targets": [{ "stack": "Giant Growth" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard_has": ["Giant Growth"], "battlefield_has": ["Gnarlback Rhino"] },
        { "graveyard_has": ["Miscalculation"] }
      ]
    }
  }
]
