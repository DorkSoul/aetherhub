[
 {
  "name": "a nontoken creature you control dying makes Saprolings equal to its power",
  "players": [ { "hand": ["Infested Thrinax","Lightning Bolt"], "battlefield": ["Swamp","Forest","Mountain","Mountain","Mountain","Mountain","Grizzly Bears"] }, {} ],
  "steps": [
   { "cast": "Infested Thrinax" },
   { "resolve": true },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Lightning Bolt","Grizzly Bears"], "battlefield_has": ["Infested Thrinax","Saproling 1-1 G"] }, {} ]
  }
 },
 {
  "name": "an opponent's creature dying makes no Saprolings",
  "players": [ { "hand": ["Infested Thrinax","Lightning Bolt"], "battlefield": ["Swamp","Forest","Mountain","Mountain","Mountain","Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
   { "cast": "Infested Thrinax" },
   { "resolve": true },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Infested Thrinax"], "battlefield_lacks": ["Saproling 1-1 G"] }, { "graveyard": ["Grizzly Bears"] } ]
  }
 },
 { "name": "ruling: the Saproling count uses the dying creature's power as it last existed (counters included)",
   "players": [ { "hand": ["Infested Thrinax", "Lightning Bolt"], "battlefield": ["Swamp", "Forest", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, {} ],
   "steps": [ { "cast": "Infested Thrinax" }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"], "battlefield_has": ["Infested Thrinax", "Saproling 1-1 G", "Saproling 1-1 G", "Saproling 1-1 G"] }, {} ] } }
]
