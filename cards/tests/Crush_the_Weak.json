[
 { "name": "2 damage to each creature; creatures that would die are exiled",
   "players": [ { "hand": ["Crush the Weak"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Typhoid Rats"] } ],
   "steps": [ { "cast": "Crush the Weak" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Crush the Weak"], "exile": ["Grizzly Bears"] }, { "exile": ["Typhoid Rats"] } ] } },
 { "name": "a creature with 3 toughness survives and stays on the battlefield",
   "players": [ { "hand": ["Crush the Weak"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Crush the Weak" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Crush the Weak"] }, { "battlefield_has": ["Hill Giant"] } ] } },
 { "name": "foretell {2} then cast from exile for {R} on a later turn",
   "players": [ { "hand": ["Crush the Weak"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Typhoid Rats"] } ],
   "steps": [ { "activate": "Crush the Weak", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
              { "cast": "Crush the Weak", "alt": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Grizzly Bears"], "graveyard": ["Crush the Weak"] }, { "exile": ["Typhoid Rats"] } ] } },
 { "name": "ruling: foretell is a special action, so it can be taken while a spell is on the stack",
   "players": [ { "hand": ["Shock", "Crush the Weak"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "activate": "Crush the Weak", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Crush the Weak"], "graveyard": ["Shock"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "ruling: a creature damaged by Crush that dies later the same turn is exiled instead",
   "players": [ { "hand": ["Crush the Weak", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Crush the Weak" }, { "resolve": true }, { "cast": "Shock", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Crush the Weak", "Shock"] }, { "exile": ["Hill Giant"] } ] } },
 { "name": "ruling: a foretold sorcery cannot be cast on the opponent's turn",
   "players": [ { "hand": ["Crush the Weak"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Crush the Weak", "ability": 0 }, { "resolve": true }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Crush the Weak", "alt": 0, "illegal": true } ],
   "expect": { "players": [ { "exile": ["Crush the Weak"] }, {} ] } }
]
