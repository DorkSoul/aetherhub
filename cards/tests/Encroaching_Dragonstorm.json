[
  {
    "name": "enters: search for two basics onto the battlefield tapped",
    "players": [
      { "hand": ["Encroaching Dragonstorm"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Plains", "Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Encroaching Dragonstorm" },
      { "resolve": true, "answers": [["Plains", "Island"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Encroaching Dragonstorm", "Plains", "Island"], "library_count": 1 },
        {}
      ],
      "tapped": { "Plains": true, "Island": true }
    }
  },
  {
    "name": "a Dragon you control entering returns it to hand",
    "players": [
      { "hand": ["Furnace Whelp"], "battlefield": ["Encroaching Dragonstorm", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Furnace Whelp" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Furnace Whelp"], "battlefield_lacks": ["Encroaching Dragonstorm"], "hand": ["Encroaching Dragonstorm"] },
        {}
      ]
    }
  },
  {
    "name": "a non-Dragon entering does not return it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Encroaching Dragonstorm", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Encroaching Dragonstorm", "Grizzly Bears"] },
        {}
      ]
    }
  }
]
