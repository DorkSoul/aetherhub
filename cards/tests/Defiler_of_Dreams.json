[
  {
    "name": "paying 2 life makes a blue permanent spell cost {U} less, and it draws",
    "players": [
      { "hand": ["Merfolk of the Pearl Trident"], "battlefield": ["Defiler of Dreams"], "library": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Merfolk of the Pearl Trident", "answers": [true] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "battlefield_has": ["Merfolk of the Pearl Trident"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "declining the life payment costs full mana",
    "players": [
      { "hand": ["Merfolk of the Pearl Trident"], "battlefield": ["Defiler of Dreams", "Island"], "library": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Merfolk of the Pearl Trident", "answers": [false] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield_has": ["Merfolk of the Pearl Trident"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "a non-blue permanent spell is not offered the option and does not draw",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Defiler of Dreams", "Forest", "Mountain"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield_has": ["Grizzly Bears"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "a blue sorcery is not a permanent spell: no option and no extra draw",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Defiler of Dreams", "Island", "Mountain", "Swamp"], "library": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "hand_count": 2 },
        {}
      ]
    }
  },
  {
    "name": "only the blue mana is reduced: the generic part is still paid",
    "players": [
      { "hand": ["Cloudkin Seer"], "battlefield": ["Defiler of Dreams", "Mountain", "Swamp"], "library": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Cloudkin Seer", "answers": [true] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "battlefield_has": ["Cloudkin Seer"], "hand_count": 2 },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Defiler's additional cost can be paid only once per permanent spell",
    "players": [
      { "hand": ["Defiler of Dreams"], "battlefield": ["Defiler of Dreams", "Island", "Island", "Island", "Island"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Defiler of Dreams", "answers": [true] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "battlefield_has": ["Defiler of Dreams"], "hand_count": 1 },
        {}
      ]
    }
  }
]
