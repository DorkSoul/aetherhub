  {
    "name": "ruling: opponents are chosen as it resolves, and may differ for each effect",
    "players": [
      { "hand": ["Sylvan Offering"], "battlefield": ["Forest", "Island", "Island"] },
      {},
      {}
    ],
    "steps": [
