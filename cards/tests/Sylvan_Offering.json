      "pt": { "Treefolk 0-0 Green": [2, 2] }
    }
  },
  {
    "name": "ruling: the same opponent may be chosen for both effects",
    "players": [
      { "hand": ["Sylvan Offering"], "battlefield": ["Forest", "Island", "Island"] },
