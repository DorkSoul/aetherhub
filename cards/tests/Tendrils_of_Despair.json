[
  {
    "name": "sacrifice a creature: opponent discards two cards",
    "players": [
      { "hand": ["Tendrils of Despair"], "battlefield": ["Swamp", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt", "Shock"] }
    ],
    "steps": [
      { "cast": "Tendrils of Despair", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Grizzly Bears", "Tendrils of Despair"] },
        { "hand_count": 0, "graveyard": ["Lightning Bolt", "Shock"] }
      ]
    }
  },
  {
    "name": "opponent with one card discards just that card",
    "players": [
      { "hand": ["Tendrils of Despair"], "battlefield": ["Swamp", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "cast": "Tendrils of Despair", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"] },
        { "hand_count": 0, "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "needs a creature to sacrifice",
    "players": [
      { "hand": ["Tendrils of Despair"], "battlefield": ["Swamp"] },
      { "hand": ["Lightning Bolt", "Shock"] }
    ],
    "steps": [
      { "cast": "Tendrils of Despair", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Tendrils of Despair"] }, { "hand_count": 2 }]
    }
  },
  {
    "name": "ruling: opponent with no cards in hand: Tendrils resolves and discards nothing",
    "players": [
      { "hand": ["Tendrils of Despair"], "battlefield": ["Swamp", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Tendrils of Despair", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Grizzly Bears", "Tendrils of Despair"] },
        { "hand_count": 0 }
      ]
    }
  },
  {
    "name": "ruling: the sacrifice is paid on cast, before Tendrils is on the stack",
    "players": [
      { "hand": ["Tendrils of Despair"], "battlefield": ["Swamp", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt", "Shock"] }
    ],
    "steps": [
      { "cast": "Tendrils of Despair", "targets": ["p1"] }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Grizzly Bears"] },
        { "hand_count": 2, "graveyard": [] }
      ]
    }
  },
  {
    "name": "ruling: exactly one creature is sacrificed, the other stays",
    "players": [
      { "hand": ["Tendrils of Despair"], "battlefield": ["Swamp", "Grizzly Bears", "Hill Giant"] },
      { "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "cast": "Tendrils of Despair", "targets": ["p1"], "answers": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Grizzly Bears", "Tendrils of Despair"] },
        { "hand_count": 0, "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
