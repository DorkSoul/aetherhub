[
  {
    "name": "enters: taps the enchanted creature",
    "players": [
      { "hand": ["Tangle Kelp"], "battlefield": ["Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] }
    ],
    "steps": [
      { "cast": "Tangle Kelp", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "enchanted creature that did not attack last turn untaps normally",
    "players": [
      { "hand": ["Tangle Kelp"], "battlefield": ["Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] }
    ],
    "steps": [
      { "cast": "Tangle Kelp", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "enchanted creature that attacked during its controller's last turn stays tapped",
    "players": [
      { "hand": ["Tangle Kelp"], "battlefield": ["Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] }
    ],
    "steps": [
      { "cast": "Tangle Kelp", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Main1", "auto": true, "player": 1 },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [], "auto": true },
      { "advance_to": "Main2", "auto": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  }
]
