[
 { "name": "power equals the artifacts you control (itself)",
   "players": [ { "hand": ["Mendicant Core, Guidelight"], "battlefield": ["Plains", "Island"] }, {} ],
   "steps": [ { "cast": "Mendicant Core, Guidelight" }, { "resolve": true } ],
   "expect": { "pt": { "Mendicant Core, Guidelight": [1, 3] } } },
 { "name": "max speed: paying {1} copies your artifact spell",
   "players": [ { "hand": ["Mendicant Core, Guidelight", "Walking Sarcophagus"], "battlefield": ["Plains", "Island", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Mendicant Core, Guidelight" }, { "resolve": true },
              { "set_speed": 4 },
              { "cast": "Walking Sarcophagus" }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Walking Sarcophagus", "Walking Sarcophagus"] }, {} ] } },
 { "name": "not max speed: no copy is offered",
   "players": [ { "hand": ["Mendicant Core, Guidelight", "Walking Sarcophagus"], "battlefield": ["Plains", "Island", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Mendicant Core, Guidelight" }, { "resolve": true },
              { "cast": "Walking Sarcophagus" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Walking Sarcophagus"] }, {} ], "pt": { "Walking Sarcophagus": [2, 1] } } },
 { "name": "start your engines: speed starts at 1",
   "players": [ { "hand": ["Mendicant Core, Guidelight"], "battlefield": ["Plains", "Island"] }, {} ],
   "steps": [ { "cast": "Mendicant Core, Guidelight" }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1 }, {} ] } },
 { "name": "speed rises when an opponent loses life on your turn",
   "players": [ { "hand": ["Mendicant Core, Guidelight", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Mountain"] }, {} ],
   "steps": [ { "cast": "Mendicant Core, Guidelight" }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 2 }, { "life": 17 } ] } },
 { "name": "ruling: speed changes only when a spell or ability says so, and each player tracks their own",
   "players": [ { "hand": ["Mendicant Core, Guidelight"], "battlefield": ["Plains", "Island"] }, {} ],
   "steps": [ { "cast": "Mendicant Core, Guidelight" }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "End" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "speed": 1 }, { "speed": 0 } ] } }
]
