 {
  "name": "a power 2 creature cannot block it: the Grizzly Bears block is dropped and 3 damage gets through",
  "players": [ { "battlefield": ["Arlinn's Wolf", "Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
  "steps": [
   { "attack": [ { "card": "Arlinn's Wolf", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
   { "block": [ { "blocker": "Grizzly Bears", "attacker": "Arlinn's Wolf" }, { "blocker": "Llanowar Elves", "attacker": "Hill Giant" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Arlinn's Wolf", "Hill Giant"] },
    { "life": 17, "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: shrinking the blocker's power after blocks does not make the Wolf unblocked",
  "players": [
   { "battlefield": ["Arlinn's Wolf"] },
   { "hand": ["Shrink"], "battlefield": ["Hill Giant", "Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Arlinn's Wolf", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Arlinn's Wolf" } ] },
   { "pass": true },
   { "cast": "Shrink", "player": 1, "targets": ["Hill Giant"] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Arlinn's Wolf"] }, { "life": 20, "graveyard_has": ["Hill Giant"] } ]
  }
 }
