[
 {
  "name": "ETB: the targeted opponent creature can't attack, another one can",
  "players": [
   { "hand": ["Spara's Adjudicators"], "battlefield": ["Forest", "Plains", "Island", "Swamp", "Mountain"] },
   { "battlefield": [{ "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false }] }
  ],
  "steps": [
   { "cast": "Spara's Adjudicators" },
   { "resolve": true, "targets": ["Grizzly Bears"] },
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "player": 1, "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Hill Giant", "at": "p0" } ] },
   { "player": 0, "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "life": 17 }, {} ] }
 },
 {
  "name": "exiling it from hand gives a land '{T}: Add {G}, {W}, or {U}'",
  "players": [
   { "hand": ["Spara's Adjudicators"], "battlefield": [{ "name": "Mountain", "tapped": false }, "Snow-Covered Mountain", "Swamp"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Mountain" },
   { "tap_for_mana": "Snow-Covered Mountain" },
   { "activate": "Spara's Adjudicators", "targets": ["Swamp"] },
   { "resolve": true },
   { "tap_for_mana": "Swamp", "color": "W" }
  ],
  "expect": { "players": [ { "exile": ["Spara's Adjudicators"], "pool": { "W": 1 } }, {} ] }
 },
 {
  "name": "it can be cast from exile later and then enters",
  "players": [
   { "hand": ["Spara's Adjudicators"], "battlefield": ["Mountain", "Snow-Covered Mountain", "Swamp", "Forest", "Plains", "Island", "Snow-Covered Swamp", "Snow-Covered Forest", "Snow-Covered Plains", "Snow-Covered Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "tap_for_mana": "Mountain" },
   { "tap_for_mana": "Snow-Covered Mountain" },
   { "activate": "Spara's Adjudicators", "targets": ["Swamp"] },
   { "resolve": true },
   { "cast": "Spara's Adjudicators" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Spara's Adjudicators"], "exile": [] }, {} ] }
 },
 {
  "name": "ruling: the granted land ability pays part of the cost when casting Spara's Adjudicators from exile",
  "players": [
   { "hand": ["Spara's Adjudicators"], "battlefield": ["Mountain", "Snow-Covered Mountain", "Swamp", "Forest", "Plains", "Island", "Forest"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Mountain" },
   { "tap_for_mana": "Snow-Covered Mountain" },
   { "activate": "Spara's Adjudicators", "targets": ["Swamp"] },
   { "resolve": true },
   { "cast": "Spara's Adjudicators" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Spara's Adjudicators"], "exile": [] }, {} ] }
 }
]
