[
  {
    "name": "RG: becomes a 3/2 trample Beast until end of turn",
    "players": [
      {
        "battlefield": [
          "Gruul Keyrune",
          "Mountain",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Gruul Keyrune",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Gruul Keyrune": [
          3,
          2
        ]
      },
      "keywords": {
        "Gruul Keyrune": [
          "Trample"
        ]
      }
    }
  },
  {
    "name": "taps for red or green",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Gruul Keyrune",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "animating needs both R and G",
    "players": [
      {
        "battlefield": [
          "Gruul Keyrune"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Gruul Keyrune",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: colorless while the animation ability is on the stack",
    "players": [ { "battlefield": ["Gruul Keyrune", "Mountain", "Forest"] }, {} ],
    "steps": [ { "activate": "Gruul Keyrune", "ability": 0 } ],
    "expect": { "colors": { "Gruul Keyrune": [] } }
  },
  {
    "name": "ruling: red and green once the animation resolves",
    "players": [ { "battlefield": ["Gruul Keyrune", "Mountain", "Forest"] }, {} ],
    "steps": [ { "activate": "Gruul Keyrune", "ability": 0 }, { "resolve": true } ],
    "expect": { "colors": { "Gruul Keyrune": ["R", "G"] } }
  }
]
