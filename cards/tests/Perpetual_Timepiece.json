[
  {
    "name": "tap to mill two cards",
    "players": [
      { "battlefield": ["Perpetual Timepiece"] },
      {}
    ],
    "steps": [
      { "activate": "Perpetual Timepiece", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 18, "battlefield": ["Perpetual Timepiece"] },
        {}
      ],
      "tapped": { "Perpetual Timepiece": true }
    }
  },
  {
    "name": "exile to shuffle chosen graveyard cards into library; opponent's cards untouched",
    "players": [
      { "battlefield": ["Mountain", "Mountain", "Perpetual Timepiece"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] },
      { "graveyard": ["Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Perpetual Timepiece", "ability": 1, "targets": ["Lightning Bolt", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 22, "battlefield": ["Mountain", "Mountain"], "graveyard": [], "exile": ["Perpetual Timepiece"] },
        { "graveyard": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: activating with no targets just shuffles the library",
    "players": [ { "battlefield": ["Perpetual Timepiece", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Perpetual Timepiece", "ability": 1, "targets": [] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Perpetual Timepiece"], "graveyard": ["Grizzly Bears"], "library_count": 20 }, {} ] }
  }
]
