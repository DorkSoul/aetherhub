[
  { "name": "can attack after an artifact entered under your control this turn",
    "players": [ { "hand": ["Amaranthine Wall"], "battlefield": ["Shipwreck Sentry", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Amaranthine Wall" }, { "resolve": true },
      { "attack": [ { "card": "Shipwreck Sentry", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Shipwreck Sentry": true }, "players": [ {}, { "life": 17 } ] } },
  { "name": "a non-artifact creature entering does not allow the attack",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Shipwreck Sentry", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Grizzly Bears" }, { "resolve": true },
      { "attack": [ { "card": "Shipwreck Sentry", "at": "p1" } ], "illegal": true }
    ],
    "expect": { "tapped": { "Shipwreck Sentry": false } } },
  { "name": "without any artifact entering it cannot attack",
    "players": [ { "battlefield": ["Shipwreck Sentry"] }, {} ],
    "steps": [ { "attack": [ { "card": "Shipwreck Sentry", "at": "p1" } ], "illegal": true } ],
    "expect": { "tapped": { "Shipwreck Sentry": false } } },
  { "name": "ruling: the artifact may be destroyed afterwards and the attack is still allowed",
    "players": [ { "hand": ["Amaranthine Wall"], "battlefield": ["Shipwreck Sentry", "Island", "Island", "Island", "Island"] },
                 { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [
      { "cast": "Amaranthine Wall" }, { "resolve": true },
      { "pass": true },
      { "cast": "Shatter", "player": 1, "targets": ["Amaranthine Wall"] }, { "resolve": true },
      { "attack": [ { "card": "Shipwreck Sentry", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Shipwreck Sentry": true }, "players": [ { "graveyard": ["Amaranthine Wall"] }, { "graveyard": ["Shatter"], "life": 17 } ] } }
]
