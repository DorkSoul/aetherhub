[
  { "name": "casting an instant puts a page counter on the Diary",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Diary of Dreams", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "counters": { "Diary of Dreams": { "page": 1 } } } },
  { "name": "with no page counters the draw ability costs {5} and {T}",
    "players": [ { "battlefield": ["Diary of Dreams", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Diary of Dreams", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ], "tapped": { "Diary of Dreams": true } } },
  { "name": "with no page counters four mana is not enough",
    "players": [ { "battlefield": ["Diary of Dreams", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Diary of Dreams", "ability": 0, "illegal": true } ] },
    { "name": "two page counters reduce the draw ability to {3}",
    "players": [ { "battlefield": [{ "name": "Diary of Dreams", "counters": { "page": 2 } }, "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Diary of Dreams", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "two page counters: two mana is not enough",
    "players": [ { "battlefield": [{ "name": "Diary of Dreams", "counters": { "page": 2 } }, "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Diary of Dreams", "ability": 0, "illegal": true } ] }
]
