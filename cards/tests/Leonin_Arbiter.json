[
  { "name": "Leonin Arbiter stops a search",
    "players": [ { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Forest", "Leonin Arbiter"], "library": ["Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Rampant Growth" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Mountain"] }, {} ] } },
  { "name": "its controller pays {2} and then can search",
    "players": [ { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Swamp", "Mountain", "Plains", "Island", "Leonin Arbiter"], "library": ["Snow-Covered Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Leonin Arbiter" }, { "resolve": true }, { "cast": "Rampant Growth" }, { "resolve": true, "answers": ["Snow-Covered Forest"] } ],
    "expect": { "players": [ { "battlefield_has": ["Snow-Covered Forest"] }, {} ] } },
  { "name": "an opponent may pay {2} too",
    "players": [ { "battlefield": ["Leonin Arbiter"] }, { "battlefield": ["Plains", "Island"] } ],
    "steps": [ { "pass": true }, { "activate": "Leonin Arbiter", "player": 1 }, { "resolve": true } ],
    "expect": { "tapped": { "Plains": true, "Island": true } } },
  { "name": "ruling: an opponent's payment frees only the payer, so the active player still cannot search",
    "players": [ { "battlefield": ["Plains", "Plains", "Leonin Arbiter"] }, { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Forest"], "library": ["Mountain"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "pass": true, "player": 1 }, { "activate": "Leonin Arbiter" }, { "resolve": true }, { "cast": "Rampant Growth", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_lacks": ["Mountain"] } ] } },
  { "name": "ruling: after paying {2} the player may search as many times as the spells instruct",
    "players": [ { "hand": ["Rampant Growth", "Rampant Growth"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Forest", "Forest", "Leonin Arbiter"], "library": ["Mountain", "Island"] }, {} ],
    "steps": [ { "activate": "Leonin Arbiter" }, { "resolve": true }, { "cast": "Rampant Growth" }, { "resolve": true, "answers": ["Mountain"] }, { "cast": "Rampant Growth" }, { "resolve": true, "answers": ["Island"] } ],
    "expect": { "players": [ { "battlefield_has": ["Mountain", "Island"] }, {} ] } },
  { "name": "ruling: with two Leonin Arbiters, paying {2} once is not enough to search",
    "players": [ { "hand": ["Rampant Growth"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Leonin Arbiter", "Leonin Arbiter"], "library": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Leonin Arbiter" }, { "resolve": true }, { "cast": "Rampant Growth" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Mountain"] }, {} ] } }
]
