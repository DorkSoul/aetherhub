    "players": [ { "hand": ["Zero, Incorporeal Sensate"], "battlefield": ["Plains", "Swamp", "Swamp"] },
                 { "hand": ["Lightning Bolt", "Grizzly Bears", "Island"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "cast": "Zero, Incorporeal Sensate" }, { "resolve": true, "answers": ["Lightning Bolt"] },
               { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Zero, Incorporeal Sensate"], "player": 1, "illegal": true } ],
