[
  { "name": "gets a counter for each creature that died this turn",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Khabál Ghoul", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "pt": { "Khabál Ghoul": [2, 2] } } },
  { "name": "no creature died: no counter",
    "players": [ { "battlefield": ["Khabál Ghoul"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "pt": { "Khabál Ghoul": [1, 1] } } },
  { "name": "ruling: a creature that died before Khabál Ghoul entered this turn still counts",
    "players": [ { "hand": ["Lightning Bolt", "Khabál Ghoul"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Khabál Ghoul" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ], "pt": { "Khabál Ghoul": [2, 2] } } },
  { "name": "creatures that died on an earlier turn do not count",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Khabál Ghoul", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "pt": { "Khabál Ghoul": [2, 2] } } }
]
