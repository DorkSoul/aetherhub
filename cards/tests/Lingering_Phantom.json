[
  {
    "name": "casting a historic spell and paying B returns it from the graveyard to hand",
    "players": [
      {
        "hand": [
          "Ornithopter"
        ],
        "battlefield": [
          "Swamp"
        ],
        "graveyard": [
          "Lingering Phantom"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Ornithopter"
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Lingering Phantom"
          ],
          "graveyard": [],
          "battlefield_has": [
            "Ornithopter"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "declining to pay leaves it in the graveyard",
    "players": [
      {
        "hand": [
          "Ornithopter"
        ],
        "battlefield": [
          "Swamp"
        ],
        "graveyard": [
          "Lingering Phantom"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Ornithopter"
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lingering Phantom"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "a non-historic spell does not trigger it",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ],
        "graveyard": [
          "Lingering Phantom"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lingering Phantom"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the trigger resolves even if the historic spell is countered",
    "players": [
      { "hand": ["Ornithopter"], "battlefield": ["Swamp"], "graveyard": ["Lingering Phantom"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Ornithopter" },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Ornithopter" }] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "hand": ["Lingering Phantom"], "graveyard": ["Ornithopter"] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  }
]
