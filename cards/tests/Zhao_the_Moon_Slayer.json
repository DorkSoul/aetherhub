    "steps": [ { "play_land": "Abandoned Air Temple" } ],
    "expect": { "tapped": { "Abandoned Air Temple": true } } },
  { "name": "ruling: with the conqueror counter a nonbasic land loses its enters trigger (Bloodfell Caves gains no life)",
    "players": [ { "hand": ["Bloodfell Caves"], "battlefield": ["Zhao, the Moon Slayer", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Zhao, the Moon Slayer" }, { "resolve": true }, { "play_land": "Bloodfell Caves" } ],
