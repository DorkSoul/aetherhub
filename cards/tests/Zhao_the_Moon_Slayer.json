  { "name": "conqueror counter: Mutavault (a nonbasic land) loses its animate ability",
    "players": [ { "battlefield": ["Zhao, the Moon Slayer", "Mutavault", "Mountain", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Zhao, the Moon Slayer" }, { "resolve": true }, { "activate": "Mutavault", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Zhao, the Moon Slayer", "Mutavault"] }, {} ] } },
