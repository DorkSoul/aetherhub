[
  {
    "name": "creating a token makes each opponent lose 1 life",
    "players": [{ "hand": ["Michelangelo, Weirdness to 11"], "battlefield": ["Mirkwood Bats", "Forest", "Forest"] }, {}],
    "steps": [
      { "cast": "Michelangelo, Weirdness to 11" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Mutagen", "Michelangelo, Weirdness to 11"] }, { "life": 19 }] }
  },
  {
    "name": "a non-token creature entering does not trigger it",
    "players": [{ "hand": ["Mesa Falcon"], "battlefield": ["Mirkwood Bats", "Plains", "Plains"] }, {}],
    "steps": [{ "cast": "Mesa Falcon" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Mesa Falcon"] }, { "life": 20 }] }
  },
  {
    "name": "sacrificing a token makes each opponent lose 1 life",
    "players": [{ "battlefield": ["Mirkwood Bats", "Ashnod's Altar", "Spirit 1-1 Colorless"] }, {}],
    "steps": [
      { "tap_for_mana": "Ashnod's Altar", "answers": ["Spirit 1-1 Colorless"] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Mirkwood Bats", "Ashnod's Altar"], "battlefield_lacks": ["Spirit 1-1 Colorless"] }, { "life": 19 }] }
  },
  {
    "name": "sacrificing a nontoken creature does not make opponents lose life",
    "players": [{ "battlefield": ["Mirkwood Bats", "Ashnod's Altar", "Grizzly Bears"] }, {}],
    "steps": [
      { "tap_for_mana": "Ashnod's Altar", "answers": ["Grizzly Bears"] }
    ],
    "expect": { "players": [{ "graveyard": ["Grizzly Bears"] }, { "life": 20 }] }
  }
]
