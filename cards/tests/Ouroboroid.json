[
  {
    "name": "at the beginning of your combat, each of your creatures gets counters equal to Ouroboroid's power",
    "players": [
      { "battlefield": ["Ouroboroid", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ouroboroid": [2, 4], "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "does not put counters on the opponent's creatures",
    "players": [
      { "battlefield": ["Ouroboroid"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ouroboroid": [2, 4], "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: X is calculated once as the ability resolves, so every creature gets 1 counter from a 1-power Ouroboroid",
    "players": [
      { "battlefield": ["Ouroboroid", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ouroboroid": [2, 4], "Grizzly Bears": [3, 3] },
      "counters": { "Grizzly Bears": { "p1p1": 1 }, "Ouroboroid": { "p1p1": 1 } }
    }
  }
]
