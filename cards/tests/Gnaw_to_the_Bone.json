[
  {
    "name": "gains 2 life per creature card in graveyard",
    "players": [{ "hand": ["Gnaw to the Bone"], "graveyard": ["Grizzly Bears", "Savannah Lions", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest"] }, {}],
    "steps": [{ "cast": "Gnaw to the Bone" }, { "resolve": true }],
    "expect": { "players": [{ "life": 24, "graveyard": ["Grizzly Bears", "Savannah Lions", "Lightning Bolt", "Gnaw to the Bone"] }, {}] }
  },
  {
    "name": "flashback from graveyard is exiled afterwards",
    "players": [{ "graveyard": ["Gnaw to the Bone"], "battlefield": ["Forest", "Forest", "Forest"] }, {}],
    "steps": [{ "cast": "Gnaw to the Bone", "alt": 0 }, { "resolve": true }],
    "expect": { "players": [{ "life": 20, "exile": ["Gnaw to the Bone"] }, {}] }
  },
  { "name": "ruling: an instant's flashback can be cast on the opponent's turn",
    "players": [ { "graveyard": ["Gnaw to the Bone", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Gnaw to the Bone", "alt": 0, "player": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "exile": ["Gnaw to the Bone"], "graveyard": ["Grizzly Bears"] }, {} ] } }
]
