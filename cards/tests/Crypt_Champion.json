[
  { "name": "R spent: each player returns a creature card with MV 3 or less from their own graveyard; Champion stays",
    "players": [
      { "hand": ["Crypt Champion"], "battlefield": ["Swamp", "Mountain", "Plains", "Plains"], "graveyard": ["Grizzly Bears", "Hill Giant"] },
      { "graveyard": ["Hill Giant", "Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Crypt Champion" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Crypt Champion", "Grizzly Bears"], "graveyard_has": ["Hill Giant"] },
        { "battlefield_has": ["Llanowar Elves"], "graveyard_has": ["Hill Giant"] }
      ]
    } },
  { "name": "no R spent: Champion is sacrificed, but each player still returns a creature card",
    "players": [
      { "hand": ["Crypt Champion"], "battlefield": ["Swamp", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] },
      { "graveyard": ["Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Crypt Champion" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Crypt Champion"] },
        { "battlefield_has": ["Llanowar Elves"] }
      ]
    } },
  { "name": "no creature card with MV 3 or less in graveyard: nothing returns",
    "players": [
      { "hand": ["Crypt Champion"], "battlefield": ["Swamp", "Mountain", "Plains", "Plains"], "graveyard": ["Hill Giant"] },
      {}
    ],
    "steps": [ { "cast": "Crypt Champion" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Crypt Champion"], "graveyard_has": ["Hill Giant"] },
        {}
      ]
    } },
  { "name": "ruling: a player with no creature card of MV 3 or less does nothing, while the other player still returns one",
    "players": [
      { "hand": ["Crypt Champion"], "battlefield": ["Swamp", "Mountain", "Plains", "Plains"], "graveyard": ["Hill Giant"] },
      { "graveyard": ["Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Crypt Champion" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Crypt Champion"], "graveyard_has": ["Hill Giant"] },
        { "battlefield_has": ["Llanowar Elves"] }
      ]
    } }
]
