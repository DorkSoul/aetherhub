[
  { "name": "imprint with X=3 exiles an instant with mana value 3 from hand",
    "players": [ { "hand": ["Divination", "Divination"], "battlefield": ["Panoptic Mirror", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Panoptic Mirror", "ability": 0, "answers": [3] },
      { "resolve": true, "answers": [["Divination"]] }
    ],
    "expect": { "players": [ { "hand": ["Divination"], "exile": ["Divination"] }, {} ] } },
  { "name": "upkeep: copy the imprinted card and cast it free",
    "players": [ { "hand": ["Divination"], "battlefield": ["Panoptic Mirror", "Island", "Island", "Island"], "library": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Panoptic Mirror", "ability": 0, "answers": [3] },
      { "resolve": true, "answers": [["Divination"]] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": { "players": [ { "exile": ["Divination"], "hand_count": 2 }, {} ] } },
  { "name": "a card whose mana value differs from X cannot be exiled",
    "players": [ { "hand": ["Divination"], "battlefield": ["Panoptic Mirror", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Panoptic Mirror", "ability": 0, "answers": [2] }
    ],
    "expect": { "players": [ { "hand": ["Divination"], "exile": [] }, {} ] } },
  { "name": "ruling: exiling the imprinted card is optional (declining leaves it in hand)",
    "players": [ { "hand": ["Divination"], "battlefield": ["Panoptic Mirror", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Panoptic Mirror", "ability": 0, "answers": [3] },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": { "players": [ { "hand": ["Divination"], "exile": [] }, {} ] } },
  { "name": "ruling: upkeep trigger with nothing imprinted does nothing",
    "players": [ { "hand": ["Divination"], "battlefield": ["Panoptic Mirror"], "library": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "hand": ["Divination"], "exile": [] }, {} ] } },
  { "name": "ruling: declining the upkeep copy leaves the card exiled and uncast",
    "players": [ { "hand": ["Divination"], "battlefield": ["Panoptic Mirror", "Island", "Island", "Island"], "library": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Panoptic Mirror", "ability": 0, "answers": [3] },
      { "resolve": true, "answers": [["Divination"]] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": { "players": [ { "exile": ["Divination"], "graveyard": [], "hand_count": 0 }, {} ] } }
]
