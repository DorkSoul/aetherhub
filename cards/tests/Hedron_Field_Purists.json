[
  { "name": "level up {2}{W} puts a level counter on it",
    "players": [ { "battlefield": ["Hedron-Field Purists", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Hedron-Field Purists", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Hedron-Field Purists": [1, 4] } } },
  { "name": "level 1 is a 1/4 that prevents 1 damage to you",
    "players": [ { "battlefield": [ { "name": "Hedron-Field Purists", "counters": { "Level": 1 } } ] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["p0"] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Hedron-Field Purists": [1, 4] }, "players": [ { "life": 19 }, {} ] } },
  { "name": "level 1 prevents 1 damage to a creature you control",
    "players": [ { "battlefield": [ { "name": "Hedron-Field Purists", "counters": { "Level": 1 } }, "Grizzly Bears" ] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Hedron-Field Purists", "Grizzly Bears"] }, { "graveyard": ["Shock"] } ] } },
  { "name": "level 5 is a 2/5 that prevents 2 damage",
    "players": [ { "battlefield": [ { "name": "Hedron-Field Purists", "counters": { "Level": 5 } }, "Grizzly Bears" ] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Hedron-Field Purists": [2, 5] }, "players": [ { "battlefield": ["Hedron-Field Purists", "Grizzly Bears"] }, { "graveyard": ["Shock"] } ] } },
  { "name": "level 5 Shock to you loses only 0 life",
    "players": [ { "battlefield": [ { "name": "Hedron-Field Purists", "counters": { "Level": 5 } } ] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["p0"] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "no level counters: no prevention, Shock kills a 2/2 creature you control",
    "players": [ { "battlefield": ["Hedron-Field Purists", "Grizzly Bears"] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Hedron-Field Purists"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Shock"] } ] } },
  { "name": "ruling: a pump applied before level up still applies (Giant Growth then level up gives 4/7)",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Hedron-Field Purists", "Forest", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Hedron-Field Purists"] }, { "resolve": true }, { "activate": "Hedron-Field Purists", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Hedron-Field Purists": [4, 7] } } },
  { "name": "ruling: two level 1 Purists are cumulative (Shock to you is fully prevented)",
    "players": [ { "battlefield": [ { "name": "Hedron-Field Purists", "counters": { "Level": 1 } }, { "name": "Hedron-Field Purists", "counters": { "Level": 1 } } ] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["p0"] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "ruling: prevention applies to the controller's own damage too (Shock at self loses 1 at level 1)",
    "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", { "name": "Hedron-Field Purists", "counters": { "Level": 1 } }] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 19 }, {} ] } },
  { "name": "ruling: the level up ability is still usable at level 5 and adds a level counter",
    "players": [ { "battlefield": [ { "name": "Hedron-Field Purists", "counters": { "Level": 5 } }, "Plains", "Plains", "Plains" ] }, {} ],
    "steps": [ { "activate": "Hedron-Field Purists", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Hedron-Field Purists": [2, 5] }, "counters": { "Hedron-Field Purists": { "Level": 6 } } } }
]
