[
  {
    "name": "gets +0/+2 when it attacks and unblocked deals 1",
    "players": [
      { "battlefield": ["Joven's Ferrets"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Joven's Ferrets", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { }, { "life": 19 } ],
      "pt": { "Joven's Ferrets": [1, 3] }
    }
  },
  {
    "name": "blocker is tapped at end of combat and does not untap in its controller's next untap step",
    "players": [
      { "battlefield": ["Joven's Ferrets"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Joven's Ferrets", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Joven's Ferrets" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Joven's Ferrets"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "creature that blocked a Ferrets which died in combat is not tapped",
    "players": [
      { "battlefield": ["Joven's Ferrets"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Joven's Ferrets", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Joven's Ferrets" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Joven's Ferrets"] }, { "battlefield_has": ["Hill Giant"] } ],
      "tapped": { "Hill Giant": false }
    }
  },
  {
    "name": "ruling: a Ferrets that dies to a double block does not tap either blocker",
    "players": [
      { "battlefield": ["Joven's Ferrets"] },
      { "battlefield": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Joven's Ferrets", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Joven's Ferrets" }, { "blocker": "Grizzly Bears", "attacker": "Joven's Ferrets" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Joven's Ferrets"] }, { "battlefield_has": ["Hill Giant", "Grizzly Bears"] } ],
      "tapped": { "Hill Giant": false, "Grizzly Bears": false }
    }
  }
]
