[
  {
    "name": "counters an opponent's spell with mana value 4 or less",
    "players": [
      { "hand": ["Thoughtbind"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Thoughtbind", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Thoughtbind"] }, { "graveyard_has": ["Lightning Bolt"] }]
    }
  },
  {
    "name": "cannot target a spell with mana value 5",
    "players": [
      { "hand": ["Thoughtbind"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Thoughtflare"], "battlefield": ["Island", "Mountain", "Mountain", "Mountain", "Island"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Thoughtflare", "player": 1 },
      { "cast": "Thoughtbind", "targets": [{ "stack": "Thoughtflare" }], "illegal": true }
    ],
    "expect": {
      "stack_empty": false,
      "players": [{ "hand": ["Thoughtbind"] }, {}]
    }
  }
]
