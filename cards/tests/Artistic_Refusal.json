[
  { "name": "counter mode: counters the target spell",
    "players": [ { "hand": ["Artistic Refusal"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "cast": "Artistic Refusal", "answers": [[0]], "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Artistic Refusal"] }, { "graveyard_has": ["Lightning Bolt"] } ] } },
  { "name": "draw mode: draw two, then discard one",
    "players": [ { "hand": ["Artistic Refusal"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Artistic Refusal", "answers": [[1]], "auto": true }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Artistic Refusal"] }, {} ] } },
  { "name": "ruling: both modes, counter target gone: Refusal does nothing, no draw or discard",
    "players": [ { "hand": ["Artistic Refusal", "Counterspell"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "cast": "Artistic Refusal", "answers": [[0, 1]], "targets": [{ "stack": "Lightning Bolt" }] }, { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "library_count": 20, "graveyard_has": ["Artistic Refusal", "Counterspell"] }, { "life": 20, "graveyard_has": ["Lightning Bolt"] } ] } },
  { "name": "ruling: a tapped creature cannot be tapped for convoke, so the spell is unaffordable",
    "players": [ { "hand": ["Artistic Refusal"], "battlefield": ["Island", "Island", "Island", "Island", "Island", { "name": "Savannah Lions", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Artistic Refusal", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Artistic Refusal"] }, {} ] } },
  { "name": "ruling: a summoning-sick creature can be tapped to convoke",
    "players": [ { "hand": ["Artistic Refusal"], "battlefield": ["Island", "Island", "Island", "Island", "Island", { "name": "Savannah Lions", "sick": true }] }, {} ],
    "steps": [ { "cast": "Artistic Refusal", "answers": [[1], ["Savannah Lions"]], "auto": true }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Artistic Refusal"] }, {} ], "tapped": { "Savannah Lions": true } } },
  { "name": "ruling: a blocker tapped for convoke still blocks",
    "players": [ { "hand": ["Artistic Refusal"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Savannah Lions"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ], "player": 0 }, { "pass": true, "player": 1 }, { "cast": "Artistic Refusal", "answers": [[1], ["Savannah Lions"]], "auto": true }, { "resolve": true, "auto": true }, { "pass": true, "player": 1 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Savannah Lions"] }, { "graveyard_has": ["Grizzly Bears"] } ] } }
]
