[
 {
  "name": "combat damage: returns creature card put into your graveyard from the battlefield this turn",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Moira, Urborg Haunt", "Mountain", "Grizzly Bears"] },
   { "life": 20 }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "attack": [{ "card": "Moira, Urborg Haunt", "at": "p1" }] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears", "Moira, Urborg Haunt"], "graveyard": ["Lightning Bolt"] },
    { "life": 17 }
   ]
  }
 },
 {
  "name": "creature card that was already in your graveyard (not put there this turn) is not returned",
  "players": [
   { "battlefield": ["Moira, Urborg Haunt"], "graveyard": ["Grizzly Bears"] },
   { "life": 20 }
  ],
  "steps": [
   { "attack": [{ "card": "Moira, Urborg Haunt", "at": "p1" }] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Moira, Urborg Haunt"], "graveyard": ["Grizzly Bears"] },
    { "life": 17 }
   ]
  }
 },
 {
  "name": "ruling: a creature that dies in the same combat damage step as Moira's damage can be returned",
  "players": [
   { "battlefield": ["Moira, Urborg Haunt", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"], "life": 20 }
  ],
  "steps": [
   { "attack": [{ "card": "Moira, Urborg Haunt", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
   { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }], "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears", "Moira, Urborg Haunt"] },
    { "life": 17 }
   ]
  }
 }
