   "steps": [ { "cast": "Ponyback Brigade" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ponyback Brigade", "Goblin 1-1"] }, {} ] } },
 { "name": "cast face down for 3: a 2/2 with no abilities makes no Goblins",
   "players": [ { "hand": ["Ponyback Brigade"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Ponyback Brigade", "alt": 254 }, { "resolve": true } ],
   "expect": { "pt": { "Ponyback Brigade": [2, 2] }, "players": [ { "battlefield_lacks": ["Goblin 1-1"] }, {} ] } },
 { "name": "turned face up for its morph cost: creates three Goblins",
   "players": [ { "battlefield": [ { "name": "Ponyback Brigade", "face_down": true }, "Mountain", "Plains", "Swamp", "Island", "Island" ] }, {} ],
   "steps": [ { "activate": "Ponyback Brigade" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ponyback Brigade", "Goblin 1-1", "Goblin 1-1", "Goblin 1-1"] }, {} ], "pt": { "Ponyback Brigade": [2, 2] } } },
 { "name": "morph cost with only four lands is illegal",
   "players": [ { "battlefield": [ { "name": "Ponyback Brigade", "face_down": true }, "Mountain", "Plains", "Swamp", "Island" ] }, {} ],
   "steps": [ { "activate": "Ponyback Brigade", "illegal": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Goblin 1-1"] }, {} ] } },
 { "name": "ruling: a face-down spell costs {3}, two lands are not enough",
   "players": [ { "hand": ["Ponyback Brigade"], "battlefield": ["Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Ponyback Brigade", "alt": 254, "illegal": true } ],
