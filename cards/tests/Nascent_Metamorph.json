[
 { "name": "attacking: becomes a copy of the first creature revealed from the opponent's library",
   "players": [ { "battlefield": [ { "name": "Nascent Metamorph", "sick": false } ] }, { "library": ["Forest", "Serra Angel", "Island"] } ],
   "steps": [ { "attack": [ { "card": "Nascent Metamorph", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Serra Angel": [4, 4] }, "keywords": { "Serra Angel": ["Flying"] } } },
 { "name": "the copy wears off at end of turn",
   "players": [ { "battlefield": [ { "name": "Nascent Metamorph", "sick": false } ] }, { "library": ["Forest", "Serra Angel", "Island"] } ],
   "steps": [ { "attack": [ { "card": "Nascent Metamorph", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "battlefield_has": ["Nascent Metamorph"] }, {} ], "pt": { "Nascent Metamorph": [1, 1] } } },
 { "name": "blocking: copies a revealed creature too",
   "players": [ { "battlefield": ["Nascent Metamorph"] }, { "battlefield": ["Hill Giant"], "library": ["Forest", "Grizzly Bears", "Island"] } ],
   "steps": [ { "advance_to": "End" }, { "pass": true }, { "advance_to": "Main1" }, { "player": 1, "attack": [ { "card": "Hill Giant", "at": "p0" } ] }, { "player": 0, "block": [ { "blocker": "Nascent Metamorph", "attacker": "Hill Giant" } ] }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [2, 2] } } },
 { "name": "ruling: no creature card in the target's library: the Metamorph is not copied and stays 1/1",
   "players": [ { "battlefield": [ { "name": "Nascent Metamorph", "sick": false } ] }, { "library": ["Forest", "Island"] } ],
   "steps": [ { "attack": [ { "card": "Nascent Metamorph", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Nascent Metamorph": [1, 1] } } }
]
