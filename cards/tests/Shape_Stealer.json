[
  {
    "name": "becomes blocked by a 2/2: base P/T become 2/2 until end of turn",
    "players": [
      { "battlefield": ["Shape Stealer"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Shape Stealer", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Shape Stealer" }] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Shape Stealer": [2, 2] }
    }
  },
  {
    "name": "becomes blocked by a 3/3: base P/T become 3/3",
    "players": [
      { "battlefield": ["Shape Stealer"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Shape Stealer", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Shape Stealer" }] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Shape Stealer": [3, 3] }
    }
  },
  {
    "name": "blocking a 2/2 sets its base P/T to 2/2 until end of turn",
    "players": [
      { "battlefield": ["Shape Stealer"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p0" }], "player": 1 },
      { "block": [{ "blocker": "Shape Stealer", "attacker": "Grizzly Bears" }], "player": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Shape Stealer": [2, 2] }
    }
  },
  {
    "name": "not blocking leaves Shape Stealer at 1/1 and it takes the unblocked damage",
    "players": [
      { "battlefield": ["Shape Stealer"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p0" }], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 18 }, {} ],
      "pt": { "Shape Stealer": [1, 1] }
    }
  },
  {
    "name": "ruling: a pump on the blocker after the trigger resolved does not change Shape Stealer",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Shape Stealer", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Shape Stealer", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Shape Stealer" }] },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Shape Stealer": [2, 2], "Grizzly Bears": [5, 5] }
    }
  },
  {
    "name": "ruling: a pump on the blocker in response to the trigger is seen when the trigger resolves",
    "players": [
      { "battlefield": ["Shape Stealer", "Forest"] },
      { "hand": ["Giant Growth"], "battlefield": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "attack": [{ "card": "Shape Stealer", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Shape Stealer" }] },
      { "pass": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Shape Stealer": [5, 5] }
    }
  }
]
