[
 { "name": "3/1 without a Domri planeswalker",
   "players": [ { "hand": ["Charging War Boar"], "battlefield": ["Mountain", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Charging War Boar" }, { "resolve": true } ],
   "expect": { "pt": { "Charging War Boar": [3, 1] } } },
 { "name": "4/2 trample while you control a Domri planeswalker",
   "players": [ { "battlefield": ["Domri Rade", "Charging War Boar"] }, {} ],
   "steps": [ { "advance_to": "Main2" } ],
   "expect": { "pt": { "Charging War Boar": [4, 2] }, "keywords": { "Charging War Boar": ["Trample"] } } },
 { "name": "opponent's Domri does not count",
   "players": [ { "battlefield": ["Charging War Boar"] }, { "battlefield": ["Domri Rade"] } ],
   "steps": [ { "advance_to": "Main2" } ],
   "expect": { "pt": { "Charging War Boar": [3, 1] } } },
 { "name": "ruling: nonlethal damage stays marked; with Domri still in play 1 damage does not kill the 4/2",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Domri Rade", "Charging War Boar", "Prodigal Pyromancer"] }, {} ],
   "steps": [ { "activate": "Prodigal Pyromancer", "ability": 0, "targets": ["Charging War Boar"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Charging War Boar", "Domri Rade"] }, {} ], "pt": { "Charging War Boar": [4, 2] } } },
 { "name": "ruling: damage marked on the Boar becomes lethal when Domri leaves the battlefield the same turn",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Domri Rade", "Charging War Boar", "Prodigal Pyromancer"] }, {} ],
   "steps": [
     { "activate": "Prodigal Pyromancer", "ability": 0, "targets": ["Charging War Boar"] },
     { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Domri Rade"] },
     { "resolve": true }
   ],
   "expect": { "players": [ { "graveyard_has": ["Charging War Boar", "Domri Rade"] }, {} ] } }
]
