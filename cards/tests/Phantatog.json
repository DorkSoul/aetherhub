[
  {
    "name": "discard a card: +1/+1 until end of turn",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Phantatog"] }, {} ],
    "steps": [
      { "activate": "Phantatog", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Phantatog": [2, 3] },
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "sacrifice an enchantment needs an enchantment you control",
    "players": [ { "battlefield": ["Phantatog"] }, {} ],
    "steps": [ { "activate": "Phantatog", "ability": 0, "illegal": true } ],
    "expect": { "pt": { "Phantatog": [1, 2] } }
  },
  {
    "name": "sacrifice an enchantment: +1/+1 until end of turn",
    "players": [ { "battlefield": ["Phantatog", "Bearscape"] }, {} ],
    "steps": [ { "activate": "Phantatog", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Phantatog": [2, 3] }, "players": [ { "graveyard_has": ["Bearscape"] }, {} ] }
  },
  {
    "name": "an artifact is not an enchantment: it cannot be sacrificed for the pump",
    "players": [ { "battlefield": ["Phantatog", "Witching Well"] }, {} ],
    "steps": [ { "activate": "Phantatog", "ability": 0, "illegal": true } ],
    "expect": { "pt": { "Phantatog": [1, 2] } }
  }
]
