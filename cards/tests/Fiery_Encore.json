[
  {
    "name": "discarding a nonland card deals damage equal to its mana value",
    "players": [
      {
        "hand": [
          "Fiery Encore",
          "Hill Giant"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Fiery Encore"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Fiery Encore",
            "Hill Giant"
          ],
          "hand_count": 1
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "discarding a land deals no damage",
    "players": [
      {
        "hand": [
          "Fiery Encore",
          "Mountain"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Fiery Encore"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Mountain"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: no card to discard means no discard, still draw, no damage",
    "players": [
      { "hand": ["Fiery Encore"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Fiery Encore" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Fiery Encore"], "hand_count": 1 },
        { "battlefield_has": ["Grizzly Bears"], "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: storm copy resolves on its own, discarding and dealing damage again",
    "players": [
      {
        "hand": ["Lightning Bolt", "Fiery Encore", "Serra Angel"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Hill Giant"]
      },
      { "battlefield": ["Grizzly Bears", "Savannah Lions", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Fiery Encore" },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Fiery Encore", "Serra Angel", "Hill Giant"], "hand_count": 1 },
        { "graveyard_has": ["Hill Giant", "Grizzly Bears", "Savannah Lions"], "battlefield_lacks": ["Grizzly Bears", "Savannah Lions"] }
      ]
    }
  }
]
