[
  {
    "name": "exiles a nonland permanent and its controller gets an Incubator with X counters, X its mana value",
    "players": [
      { "hand": ["Excise the Imperfect"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Excise the Imperfect", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard_has": ["Excise the Imperfect"] }, { "battlefield_lacks": ["Grizzly Bears"], "battlefield_has": ["Incubator"] } ],
      "counters": { "Incubator": { "p1p1": 2 } }
    }
  },
  {
    "name": "a land is not a legal target",
    "players": [
      { "hand": ["Excise the Imperfect"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [ { "cast": "Excise the Imperfect", "illegal": true } ],
    "expect": {
      "players": [ { "hand": ["Excise the Imperfect"] }, { "battlefield_has": ["Forest"] } ]
    }
  },
  {
    "name": "ruling: target gone in response: Excise does not resolve, so no Incubator",
    "players": [
      { "hand": ["Excise the Imperfect"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] }
    ],
    "steps": [
      { "cast": "Excise the Imperfect", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Excise the Imperfect"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"], "battlefield_lacks": ["Incubator"] } ]
    }
  }
]
