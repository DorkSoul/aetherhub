[
  {
    "name": "taps the red or green creature and it stays tapped",
    "players": [
      {
        "hand": [
          "Encase in Ice"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Encase in Ice",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "can't enchant a colorless creature",
    "players": [
      {
        "hand": [
          "Encase in Ice"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Ornithopter"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Encase in Ice",
        "targets": [
          "Ornithopter"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the enchanted creature dies, so Encase in Ice goes to its owner's graveyard",
    "players": [
      { "hand": ["Encase in Ice", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Encase in Ice", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Encase in Ice", "Lightning Bolt"], "battlefield_lacks": ["Encase in Ice"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: another spell can still untap the enchanted creature",
    "players": [
      { "hand": ["Encase in Ice", "Ornamental Courage"], "battlefield": ["Island", "Island", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Encase in Ice", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Ornamental Courage", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Encase in Ice"] },
        {}
      ],
      "tapped": { "Grizzly Bears": false }
    }
  }
]

