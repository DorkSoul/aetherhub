[
  { "name": "not kicked: controller who can't pay {2} has the spell countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Dispelling Exhale"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Dispelling Exhale", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Lightning Bolt"] }, { "life": 20, "graveyard": ["Dispelling Exhale"] } ], "stack_empty": true } },
  { "name": "not kicked: controller pays {2}: the spell resolves",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                 { "hand": ["Dispelling Exhale"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Dispelling Exhale", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "graveyard": ["Dispelling Exhale"] } ], "stack_empty": true } },
  { "name": "behold a Dragon: controller with only {2} spare cannot pay {4}, so the spell is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                 { "hand": ["Dispelling Exhale", "Shivan Dragon"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Dispelling Exhale", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [true] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Dispelling Exhale"], "hand": ["Shivan Dragon"] } ], "stack_empty": true } },
  { "name": "behold a Dragon: controller pays {4}: the spell resolves",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "hand": ["Dispelling Exhale", "Shivan Dragon"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Dispelling Exhale", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [true] },
               { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "graveyard": ["Dispelling Exhale"] } ], "stack_empty": true } },
  { "name": "ruling: a Dragon card revealed for one spell's behold cost can be revealed again for a second spell",
    "players": [ { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Mountain", "Mountain"] },
                 { "hand": ["Dispelling Exhale", "Dispelling Exhale", "Shivan Dragon"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Dispelling Exhale", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [true] },
               { "cast": "Shock", "targets": ["p1"] },
               { "cast": "Dispelling Exhale", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [true] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Lightning Bolt", "Shock"] }, { "life": 18, "graveyard_has": ["Dispelling Exhale"], "hand": ["Shivan Dragon"] } ], "stack_empty": true } },
  { "name": "ruling: a beheld Dragon that leaves the battlefield still counts as beheld: the {4} payment is what was made",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Strike"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "hand": ["Dispelling Exhale"], "battlefield": ["Island", "Island", "Acid-Spewer Dragon"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Dispelling Exhale", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "answers": [true] },
               { "cast": "Lightning Bolt", "targets": ["Acid-Spewer Dragon"] },
               { "resolve": true, "answers": [true] },
               { "cast": "Lightning Strike", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"], "hand": ["Lightning Strike"] }, { "life": 17, "graveyard_has": ["Dispelling Exhale", "Acid-Spewer Dragon"] } ], "stack_empty": true } }
]
