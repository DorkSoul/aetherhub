[
 {
  "name": "target player mills two",
  "players": [
   {
    "battlefield": [
     "Millstone",
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Millstone",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "library_count": 18
    }
   ]
  }
 },
 {
  "name": "can target yourself",
  "players": [
   {
    "battlefield": [
     "Millstone",
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Millstone",
    "targets": [
     "p0"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "library_count": 18
    },
    {
     "library_count": 20
    }
   ]
  }
 },
 {
  "name": "ruling: milling a player with one card in library mills that card (fewer than two is fine)",
  "players": [
   { "battlefield": ["Millstone", "Island", "Island"] },
   { "exact_library": true, "library": ["Forest"] }
  ],
  "steps": [
   { "activate": "Millstone", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "library_count": 0, "graveyard": ["Forest"] }
   ]
  }
 },
 {
  "name": "ruling: milling a player with an empty library mills nothing and does not fail",
  "players": [
   { "battlefield": ["Millstone", "Island", "Island"] },
   { "exact_library": true }
  ],
  "steps": [
   { "activate": "Millstone", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "library_count": 0, "graveyard": [] }
   ]
  }
 },
 {
  "name": "ruling: milling a player who has fewer than two cards does not make them lose",
  "players": [
   { "battlefield": ["Millstone", "Island", "Island"] },
   { "exact_library": true, "library": ["Forest"] }
  ],
  "steps": [
   { "activate": "Millstone", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "winner": -1,
   "players": [
    {},
    { "library_count": 0 }
   ]
  }
 }
]