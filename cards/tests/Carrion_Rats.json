[
 {
  "name": "nobody has a graveyard card: attacking Rats deal their damage",
  "players": [
   { "battlefield": ["Carrion Rats"] },
   { "battlefield": ["Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Carrion Rats", "at": "p1" } ] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "life": 18 }
   ]
  }
 },
 {
  "name": "opponent exiles a card from graveyard: attacking Rats assign no combat damage",
  "players": [
   { "battlefield": ["Carrion Rats"] },
   { "battlefield": ["Forest"], "graveyard": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [ { "card": "Carrion Rats", "at": "p1" } ] },
   { "resolve": true, "answers": [true] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "life": 20, "exile": ["Grizzly Bears"], "graveyard": [] }
   ]
  }
 },
 {
  "name": "opponent declines to exile: attacking Rats deal damage normally",
  "players": [
   { "battlefield": ["Carrion Rats"] },
   { "battlefield": ["Forest"], "graveyard": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [ { "card": "Carrion Rats", "at": "p1" } ] },
   { "resolve": true, "answers": [false] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "life": 18, "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "blocking Rats: attacker's controller exiles a card, so the Bears survive",
  "players": [
   { "battlefield": ["Grizzly Bears"], "graveyard": ["Llanowar Elves"] },
   { "battlefield": ["Carrion Rats"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Carrion Rats", "attacker": "Grizzly Bears" } ] },
   { "resolve": true, "answers": [true] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears"], "exile": ["Llanowar Elves"], "life": 20 },
    { "graveyard_has": ["Carrion Rats"], "life": 20 }
   ]
  }
 }
]
