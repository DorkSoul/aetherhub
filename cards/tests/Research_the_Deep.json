[
  { "name": "win the clash: draw a card and return to hand",
    "players": [ { "hand": ["Research the Deep"], "battlefield": ["Island", "Island"], "library": ["Hill Giant", "Hill Giant"] }, { "library": ["Mountain"] } ],
    "steps": [ { "cast": "Research the Deep" }, { "resolve": true, "answers": [false, false] } ],
    "expect": { "players": [ { "hand": ["Hill Giant", "Research the Deep"] }, {} ] } },
  { "name": "tie does not win: goes to the graveyard",
    "players": [ { "hand": ["Research the Deep"], "battlefield": ["Island", "Island"], "library": ["Mountain", "Mountain"] }, { "library": ["Mountain"] } ],
    "steps": [ { "cast": "Research the Deep" }, { "resolve": true, "answers": [false, false] } ],
    "expect": { "players": [ { "hand": ["Mountain"], "graveyard": ["Research the Deep"] }, {} ] } },
  { "name": "ruling: a won clash returns the spell to hand straight from the stack, never through the graveyard",
    "players": [ { "hand": ["Research the Deep"], "battlefield": ["Island", "Island"], "library": ["Hill Giant", "Hill Giant"] }, { "library": ["Mountain"] } ],
    "steps": [ { "cast": "Research the Deep" }, { "resolve": true, "answers": [false, false] } ],
    "expect": { "players": [ { "hand": ["Hill Giant", "Research the Deep"], "graveyard": [] }, {} ] } },
  { "name": "ruling: countered, Research the Deep has no effects: no draw and no clash",
    "players": [ { "hand": ["Research the Deep"], "battlefield": ["Island", "Island"], "library": ["Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Research the Deep" }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Research the Deep" }] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "library_top": ["Mountain"], "graveyard": ["Research the Deep"] }, { "graveyard": ["Counterspell"] } ], "stack_empty": true } }
]
