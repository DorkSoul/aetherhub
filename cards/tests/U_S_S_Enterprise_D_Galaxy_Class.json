[
  {
    "name": "first station of the turn exiles the top card, playable this turn",
    "players": [
      { "battlefield": ["U.S.S. Enterprise-D, Galaxy-Class", "Grizzly Bears", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "activate": "U.S.S. Enterprise-D, Galaxy-Class" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "U.S.S. Enterprise-D, Galaxy-Class": { "charge": 2 } },
      "players": [{ "exile": ["Island"] }, {}]
    }
  },
  {
    "name": "later stations the same turn do not exile again",
    "players": [
      { "battlefield": ["U.S.S. Enterprise-D, Galaxy-Class", "Grizzly Bears", "Hill Giant"], "library": ["Island", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "U.S.S. Enterprise-D, Galaxy-Class" },
      { "resolve": true, "answers": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "U.S.S. Enterprise-D, Galaxy-Class" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "U.S.S. Enterprise-D, Galaxy-Class": { "charge": 5 } },
      "players": [{ "exile": ["Island"] }, {}]
    }
  },
  {
    "name": "seven or more charge counters make it a 4/5 flying vigilance creature",
    "players": [
      { "battlefield": ["U.S.S. Enterprise-D, Galaxy-Class", "Grizzly Bears", "Hill Giant", "Serra Angel"] },
      {}
    ],
    "steps": [
      { "activate": "U.S.S. Enterprise-D, Galaxy-Class" },
      { "resolve": true, "answers": ["Grizzly Bears"] },
      { "activate": "U.S.S. Enterprise-D, Galaxy-Class" },
      { "resolve": true, "answers": ["Hill Giant"] },
      { "activate": "U.S.S. Enterprise-D, Galaxy-Class" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "U.S.S. Enterprise-D, Galaxy-Class": { "charge": 9 } },
      "pt": { "U.S.S. Enterprise-D, Galaxy-Class": [4, 5] },
      "keywords": { "U.S.S. Enterprise-D, Galaxy-Class": ["Flying", "Vigilance"] }
    }
  }
]
