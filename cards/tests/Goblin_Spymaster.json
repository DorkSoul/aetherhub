[
  {
    "name": "at the opponent's end step, that opponent creates a Goblin that must attack",
    "players": [
      {
        "battlefield": [
          "Goblin Spymaster"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Goblin Spymaster"
          ]
        },
        {
          "battlefield_has": [
            "Goblin 1-1 Must Attack"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a must-attack Goblin does not attack when its controller cannot pay the attack tax",
    "players": [ { "battlefield": ["Goblin Spymaster", "Propaganda"] }, { "battlefield": ["Goblin 1-1 Must Attack"] } ],
    "steps": [ { "advance_to": "Main1" }, { "player": 1, "attack": [] } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20, "battlefield_has": ["Goblin 1-1 Must Attack"] } ] }
  },
  {
    "name": "ruling: a must-attack Goblin isn't forced to attack even when its controller could pay the attack tax",
    "players": [ { "battlefield": ["Goblin Spymaster", "Propaganda"] }, { "battlefield": ["Goblin 1-1 Must Attack", "Forest", "Forest"] } ],
    "steps": [ { "advance_to": "Main1" }, { "player": 1, "attack": [] } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] }
  }
]
