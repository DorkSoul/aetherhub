          "graveyard_has": ["Hill Giant"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Wolves use the sacrificed creature's toughness as it last existed (with a counter)",
    "players": [
      {
        "battlefield": ["Feed the Pack", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }]
      },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [true] },
      { "resolve": true }
