  {
    "name": "ruling: you choose which nontoken creature to sacrifice; the chosen toughness sets the Wolves",
    "players": [
      {
        "battlefield": ["Feed the Pack", "Grizzly Bears", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [true, "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Wolf 2-2", "Wolf 2-2", "Wolf 2-2", "Feed the Pack", "Grizzly Bears"],
