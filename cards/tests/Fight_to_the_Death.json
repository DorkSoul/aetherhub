[
  {
    "name": "destroys the blocked attacker and its blocker, not the unblocked attacker",
    "players": [
      {
        "hand": [
          "Fight to the Death"
        ],
        "battlefield": [
          "Mountain",
          "Plains",
          {
            "name": "Grizzly Bears",
            "sick": false
          },
          {
            "name": "Hill Giant",
            "sick": false
          }
        ]
      },
      {
        "battlefield": [
          "Wall of Ice"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          },
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Wall of Ice",
            "attacker": "Grizzly Bears"
          }
        ]
      },
      {
        "cast": "Fight to the Death"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Fight to the Death",
            "Grizzly Bears"
          ]
        },
        {
          "graveyard": [
            "Wall of Ice"
          ]
        }
      ]
    }
  },
  {
    "name": "cast before blockers are declared does nothing",
    "players": [
      {
        "hand": [
          "Fight to the Death"
        ],
        "battlefield": [
          "Mountain",
          "Plains",
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      },
      {
        "battlefield": [
          "Wall of Ice"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "cast": "Fight to the Death"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Fight to the Death"
          ]
        },
        {
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "ruling: a blocker removed before Fight: the blocked attacker is still a blocked creature and is destroyed",
    "players": [
      {
        "hand": ["Fight to the Death", "Doom Blade"],
        "battlefield": ["Swamp", "Forest", "Mountain", "Plains", { "name": "Grizzly Bears", "sick": false }]
      },
      { "battlefield": ["Wall of Ice"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Ice", "attacker": "Grizzly Bears" }] },
      { "cast": "Doom Blade", "targets": ["Wall of Ice"] },
      { "resolve": true },
      { "cast": "Fight to the Death" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Fight to the Death", "Doom Blade", "Grizzly Bears"] },
        { "graveyard": ["Wall of Ice"] }
      ]
    }
  },
  {
    "name": "ruling: a blocking creature keeps blocking after the creature it blocks died: Fight still destroys it",
    "players": [
      {
        "hand": ["Fight to the Death", "Doom Blade"],
        "battlefield": ["Swamp", "Forest", "Mountain", "Plains", { "name": "Grizzly Bears", "sick": false }]
      },
      { "battlefield": ["Wall of Ice"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Ice", "attacker": "Grizzly Bears" }] },
      { "cast": "Doom Blade", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Fight to the Death" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Fight to the Death", "Doom Blade", "Grizzly Bears"] },
        { "graveyard": ["Wall of Ice"] }
      ]
    }
  },
  {
    "name": "ruling: cast after combat (second main phase) does nothing",
    "players": [
      {
        "hand": ["Fight to the Death"],
        "battlefield": ["Mountain", "Plains", { "name": "Grizzly Bears", "sick": false }]
      },
      { "battlefield": ["Wall of Ice"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Ice", "attacker": "Grizzly Bears" }] },
      { "advance_to": "Main2" },
      { "cast": "Fight to the Death" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fight to the Death"], "battlefield_has": ["Grizzly Bears"] },
        { "battlefield_has": ["Wall of Ice"] }
      ]
    }
  }
]
