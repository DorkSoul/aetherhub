[
  {
    "name": "{1},{T}: taps target non-Human creature",
    "players": [
      {
        "battlefield": [
          "Sigardian Priest",
          "Plains",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sigardian Priest",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true,
        "Sigardian Priest": true
      }
    }
  },
  {
    "name": "no legal target (only Human creatures) so it cannot be activated",
    "players": [
      {
        "battlefield": [
          "Sigardian Priest",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sigardian Priest",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "tapped": {
        "Sigardian Priest": false
      }
    }
  },
  {
    "name": "ruling: a Human creature with other types is not a non-Human creature and cannot be targeted",
    "players": [
      { "battlefield": ["Sigardian Priest", "Plains", "Plains"] },
      { "battlefield": ["Akoum Flameseeker", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Sigardian Priest", "ability": 0, "targets": ["Akoum Flameseeker"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Akoum Flameseeker": false, "Sigardian Priest": false }
    }
  },
  {
    "name": "ruling: a non-Human creature beside a Human one can still be targeted",
    "players": [
      { "battlefield": ["Sigardian Priest", "Plains", "Plains"] },
      { "battlefield": ["Akoum Flameseeker", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Sigardian Priest", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Akoum Flameseeker": false }
    }
  }
]
