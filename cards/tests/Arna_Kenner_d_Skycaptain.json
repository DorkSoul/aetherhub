[
 {
  "name": "attacking modified creature doubles its counters",
  "players": [
   {
    "battlefield": [
     "Arna Kennerüd, Skycaptain",
     {
      "name": "Grizzly Bears",
      "counters": {
       "p1p1": 1
      }
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Grizzly Bears": {
     "p1p1": 2
    }
   },
   "pt": {
    "Grizzly Bears": [
     4,
     4
    ]
   }
  }
 },
 {
  "name": "a creature that is not attacking does not trigger the doubling",
