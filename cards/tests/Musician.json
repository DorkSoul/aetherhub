  ],
  "steps": [
   { "activate": "Musician", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "activate": "Musician", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "advance_to": "Upkeep", "answers": [true] }
  ],
  "expect": {
   "counters": { "Hill Giant": { "Music": 2 } },
   "players": [
    { "battlefield_has": ["Musician"] },
    { "battlefield_has": ["Hill Giant"] }
   ]
  }
 },
 {
