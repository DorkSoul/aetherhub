[
  { "name": "cast normally it is a 1/1 creature",
    "players": [ { "hand": ["Noble Quarry"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Noble Quarry" }, { "resolve": true } ],
    "expect": { "pt": { "Noble Quarry": [1, 1] } } },
  { "name": "bestowed on Grizzly Bears: the Bears get +1/+1",
    "players": [ { "hand": ["Noble Quarry"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Noble Quarry", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "when the host dies the Quarry is a creature again (1/1)",
    "players": [ { "hand": ["Noble Quarry", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Noble Quarry", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Noble Quarry"], "graveyard_has": ["Grizzly Bears"] }, {} ], "pt": { "Noble Quarry": [1, 1] } } },
  { "name": "a creature Quarry attacking: the opposing creature must block it",
    "players": [ { "battlefield": ["Noble Quarry"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Noble Quarry", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Noble Quarry" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Noble Quarry"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "creatures are not forced to block an attacker that is not the Quarry or its host",
    "players": [ { "battlefield": ["Noble Quarry", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Noble Quarry", "Grizzly Bears"] }, { "life": 18 } ] } },
  { "name": "must be blocked: an empty block declaration still has Hill Giant block the attacking Quarry",
    "players": [ { "battlefield": ["Noble Quarry"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Noble Quarry", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Noble Quarry"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "bestowed on an attacking Grizzly Bears: Hill Giant must block the enchanted creature",
    "players": [ { "hand": ["Noble Quarry"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Noble Quarry", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Grizzly Bears"] }, { "life": 20, "graveyard_has": ["Hill Giant"] } ] } },
  { "name": "ruling: Quarry unattached on my turn can attack, since I controlled it since that turn began",
    "players": [ { "hand": ["Noble Quarry", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Noble Quarry", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Noble Quarry", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "pt": { "Noble Quarry": [1, 1] }, "players": [ { "battlefield_has": ["Noble Quarry"] }, { "life": 19 } ] } },
  { "name": "ruling: host killed in response to the bestow cast, the Quarry resolves as a creature",
    "players": [ { "hand": ["Noble Quarry"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Noble Quarry", "alt": 0, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Noble Quarry": [1, 1] }, "players": [ { "battlefield_has": ["Noble Quarry"], "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ] } },
  { "name": "ruling: the bestowed Quarry stays untapped when the enchanted Bears attack",
    "players": [ { "hand": ["Noble Quarry"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Noble Quarry", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "tapped": { "Grizzly Bears": true, "Noble Quarry": false }, "players": [ {}, { "life": 17 } ] } }
