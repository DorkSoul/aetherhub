[
  {
    "name": "sacrifice to ping a player",
    "players": [
      {
        "battlefield": [
          "Mogg Fanatic"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Mogg Fanatic",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [],
          "graveyard": [
            "Mogg Fanatic"
          ]
        },
        {
          "life": 19
        }
      ]
    }
  },
  {
    "name": "1 damage does not kill a 2/2",
    "players": [
      {
        "battlefield": [
          "Mogg Fanatic"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Mogg Fanatic",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Mogg Fanatic"
          ]
        },
        {
          "battlefield": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "1 damage does not kill a 2/3 but fanatic is gone",
    "players": [
      {
        "battlefield": [
          "Mogg Fanatic"
        ]
      },
      {
        "battlefield": [
          "Hurloon Minotaur"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Mogg Fanatic",
        "targets": [
          "Hurloon Minotaur"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Mogg Fanatic"
          ]
        },
        {
          "battlefield": [
            "Hurloon Minotaur"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: once combat damage is dealt the blocked Fanatic is dead and cannot be sacrificed",
    "players": [ { "battlefield": ["Mogg Fanatic"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Mogg Fanatic", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Mogg Fanatic" } ] },
      { "advance_to": "Main2" },
      { "activate": "Mogg Fanatic", "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [ { "graveyard": ["Mogg Fanatic"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: a blocked Fanatic can still be sacrificed before combat damage",
    "players": [ { "battlefield": ["Mogg Fanatic"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Mogg Fanatic", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Mogg Fanatic" } ] },
      { "activate": "Mogg Fanatic", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Mogg Fanatic"] }, { "life": 19, "battlefield_has": ["Grizzly Bears"] } ] }
  }
]