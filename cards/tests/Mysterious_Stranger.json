[
  { "name": "exiles one card from each graveyard, then casts a free copy of one of them",
    "players": [ { "hand": ["Mysterious Stranger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Divination"], "library": ["Island", "Island", "Island", "Island"] }, { "graveyard": ["Divination"] } ],
    "steps": [
      { "cast": "Mysterious Stranger" },
      { "resolve": true, "answers": ["Divination", "Divination", true] }
    ],
    "expect": { "players": [ { "hand_count": 2, "exile": ["Divination"], "battlefield_has": ["Mysterious Stranger"] }, { "exile": ["Divination"], "graveyard": [] } ] } },
  { "name": "only one exiled card: nothing is copied",
    "players": [ { "hand": ["Mysterious Stranger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Island", "Island", "Island"] }, { "graveyard": ["Divination"] } ],
    "steps": [
      { "cast": "Mysterious Stranger" },
      { "resolve": true, "answers": ["Divination"] }
    ],
    "expect": { "players": [ { "hand_count": 0 }, { "exile": ["Divination"], "graveyard": [] } ] } },
  { "name": "ruling: the copy is cast during the resolution; a free Lightning Bolt copy kills Grizzly Bears",
    "players": [ { "hand": ["Mysterious Stranger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Lightning Bolt"], "library": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"], "graveyard": ["Lightning Bolt"] } ],
    "steps": [
      { "cast": "Mysterious Stranger" },
      { "resolve": true, "answers": ["Lightning Bolt", "Lightning Bolt", true, "Grizzly Bears"] }
    ],
    "expect": { "players": [ { "exile": ["Lightning Bolt"], "battlefield_has": ["Mysterious Stranger"] }, { "exile": ["Lightning Bolt"], "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "ruling: declining the copy leaves no copy behind (it ceases to exist)",
    "players": [ { "hand": ["Mysterious Stranger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Divination"], "library": ["Island", "Island", "Island", "Island"] }, { "graveyard": ["Divination"] } ],
    "steps": [
      { "cast": "Mysterious Stranger" },
      { "resolve": true, "answers": ["Divination", "Divination", false] }
    ],
    "expect": { "players": [ { "hand_count": 0, "exile": ["Divination"], "graveyard": [] }, { "exile": ["Divination"], "graveyard": [] } ] } },
  { "name": "ruling: a copied Fireball with {X} is cast with X = 0 and deals no damage",
    "players": [ { "hand": ["Mysterious Stranger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Fireball"], "library": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"], "graveyard": ["Fireball"] } ],
    "steps": [
      { "cast": "Mysterious Stranger" },
      { "resolve": true, "answers": ["Fireball", "Fireball", true, 0] }
    ],
    "expect": { "players": [ { "exile": ["Fireball"], "life": 20 }, { "exile": ["Fireball"], "battlefield_has": ["Grizzly Bears"], "life": 20 } ], "pt": { "Grizzly Bears": [2, 2] } } }
]
