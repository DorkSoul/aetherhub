[
 {
  "name": "enters tapped when played",
  "players": [
   {
    "hand": [
     "Icatian Store"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Icatian Store"
   }
  ],
  "expect": {
   "tapped": {
    "Icatian Store": true
   }
  }
 },
 {
  "name": "tapped at upkeep when kept tapped during untap step: gets a storage counter",
  "players": [
   {
    "battlefield": [
     {
      "name": "Icatian Store",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep",
    "answers": [
     true
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "turn": 3,
   "counters": {
    "Icatian Store": {
     "storage": 1
    }
   },
   "tapped": {
    "Icatian Store": true
   }
  }
 },
 {
  "name": "untapped at upkeep gets no storage counter",
  "players": [
   {
    "battlefield": [
     "Icatian Store"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "turn": 3,
   "counters": {
    "Icatian Store": {
     "storage": 0
    }
   },
   "tapped": {
    "Icatian Store": false
   }
  }
 },
 {
  "name": "tap and remove three storage counters: adds W for each counter removed",
  "players": [
   {
    "battlefield": [
     {
      "name": "Icatian Store",
      "counters": {
       "storage": 3
      }
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Icatian Store"
   }
  ],
  "expect": {
   "players": [
    {
     "pool": {
      "W": 3
     }
    },
    {}
   ],
   "counters": {
    "Icatian Store": {
     "storage": 0
    }
   }
  }
 },
 {
  "name": "ruling: Blood Moon changes the land type but the storage counters stay on it",
  "players": [
   {
    "battlefield": [
     {
      "name": "Icatian Store",
      "counters": {
       "storage": 2
      }
     },
     "Blood Moon"
    ]
   },
   {}
  ],
  "steps": [],
  "expect": {
   "counters": {
    "Icatian Store": {
     "storage": 2
    }
   }
  }
 },
 {
  "name": "ruling: an external tap (Icy Manipulator) does not remove storage counters",
  "players": [
   {
    "battlefield": [
     "Icy Manipulator",
     "Island",
     {
      "name": "Icatian Store",
      "counters": {
       "storage": 3
      }
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Icy Manipulator",
    "targets": ["Icatian Store"]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Icatian Store": true
   },
   "counters": {
    "Icatian Store": {
     "storage": 3
    }
   }
  }
 }
]
