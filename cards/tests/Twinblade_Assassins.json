[
  {
    "name": "end step: draws a card if a creature died this turn",
    "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Twinblade Assassins"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "end step: no draw if no creature died this turn",
    "players": [ { "battlefield": ["Twinblade Assassins"] }, {} ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "ruling: a creature that died before Assassins entered still counts for the end step draw",
    "players": [
      { "hand": ["Shock", "Twinblade Assassins"], "battlefield": ["Mountain", "Mountain", "Mountain", "Swamp", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Twinblade Assassins" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "ruling: two creatures dying this turn still draw only one card at end step",
    "players": [
      { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain", "Twinblade Assassins"] },
      { "battlefield": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, {} ]
    }
  }
]
