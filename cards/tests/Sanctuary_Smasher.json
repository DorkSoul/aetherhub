[
  {
    "name": "cycling puts a first strike counter on the target creature you control",
    "players": [
      { "hand": ["Sanctuary Smasher"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Sanctuary Smasher", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Sanctuary Smasher"], "hand_count": 1 }, {} ],
      "keywords": { "Grizzly Bears": ["FirstStrike"] }
    }
  },
  {
    "name": "the creature without the counter does not gain first strike",
    "players": [
      { "hand": ["Sanctuary Smasher"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears", "Savannah Lions"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Sanctuary Smasher", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Savannah Lions": [] }
    }
  },
  {
    "name": "a creature with the first strike counter kills the 2/1 blocker first and survives",
    "players": [
      { "hand": ["Sanctuary Smasher"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Forest"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "activate": "Sanctuary Smasher", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Savannah Lions"] } ]
    }
  },
 { "name": "ruling: cycling still draws when the cycle trigger has no legal target (no creature you control)",
   "players": [ { "hand": ["Sanctuary Smasher"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Sanctuary Smasher", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Sanctuary Smasher"], "hand_count": 1 }, {} ] } }
]
