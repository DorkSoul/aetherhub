   { "resolve": true, "answers": [false] }
  ],
  "expect": {
   "players": [
    { "library_top": ["Mountain"], "library_count": 2, "graveyard": [] },
    { "life": 20, "graveyard": ["Endless Detour"] }
   ]
  }
 },
 {
  "name": "ruling: a token put into the library ceases to exist (the library gains no card)",
  "players": [
   { "hand": ["Raise the Alarm", "Endless Detour"], "battlefield": ["Plains", "Plains", "Island", "Island", "Forest", "Swamp"], "library": ["Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Raise the Alarm" },
   { "resolve": true },
   { "cast": "Endless Detour", "answers": [[1]], "targets": ["Soldier"] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Soldier"], "library_count": 1, "graveyard": ["Endless Detour", "Raise the Alarm"] },
