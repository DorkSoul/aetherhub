  "expect": {
   "players": [
    {},
    { "library_count": 2, "graveyard": [] }
   ]
  }
 },
 {
  "name": "ruling: the owner (p0) of the Bolt chooses top, so Lightning Bolt goes on top of its library and does not resolve",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"], "library": ["Mountain"] },
   { "hand": ["Endless Detour"], "battlefield": ["Forest", "Plains", "Island"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "cast": "Endless Detour", "player": 1, "answers": [[0]], "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": {
   "players": [
    { "library_top": ["Lightning Bolt"], "library_count": 2, "graveyard": [] },
    { "life": 20, "graveyard": ["Endless Detour"] }
   ]
  }
 },
 {
  "name": "ruling: the owner (p0) of the Bolt chooses bottom, so the Bolt goes under the Mountain",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"], "library": ["Mountain"] },
   { "hand": ["Endless Detour"], "battlefield": ["Forest", "Plains", "Island"] }
  ],
  "steps": [
