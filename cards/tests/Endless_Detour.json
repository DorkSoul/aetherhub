  "players": [
   {
    "hand": ["Endless Detour"],
    "battlefield": ["Forest", "Plains", "Island"]
   },
   {
    "battlefield": ["Grizzly Bears"],
    "library": ["Mountain"]
   }
  ],
  "steps": [
