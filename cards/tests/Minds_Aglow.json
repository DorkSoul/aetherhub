[
 {
  "name": "both players pay: each draws the total",
  "players": [
   { "hand": ["Minds Aglow"], "battlefield": ["Island", "Island", "Island", "Island"] },
   { "battlefield": ["Forest", "Mountain"] }
  ],
  "steps": [
   { "cast": "Minds Aglow" },
   { "resolve": true, "answers": [2, 1] }
  ],
  "expect": {
   "players": [ { "hand_count": 3, "battlefield": ["Island", "Island", "Island", "Island"] }, { "hand_count": 3 } ]
  }
 },
 {
  "name": "nobody pays: nobody draws",
  "players": [
   { "hand": ["Minds Aglow"], "battlefield": ["Island", "Island"] },
   { "battlefield": ["Forest"] }
  ],
  "steps": [
   { "cast": "Minds Aglow" },
   { "resolve": true, "answers": [0, 0] }
  ],
  "expect": { "players": [ { "hand_count": 0 }, { "hand_count": 0 } ] }
 },
 {
  "name": "a player with no mana to pay isn't asked; the opponent still draws",
  "players": [
   { "hand": ["Minds Aglow"], "battlefield": ["Island", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Minds Aglow" },
   { "resolve": true, "answers": [2] }
  ],
  "expect": { "players": [ { "hand_count": 2 }, { "hand_count": 2 } ] }
 },
 {
  "name": "only the opponent pays",
  "players": [
   { "hand": ["Minds Aglow"], "battlefield": ["Island"] },
   { "battlefield": ["Forest", "Forest", "Forest"] }
  ],
  "steps": [
   { "cast": "Minds Aglow" },
   { "resolve": true, "answers": [3] }
  ],
  "expect": { "players": [ { "hand_count": 3 }, { "hand_count": 3 } ] }
 },
 {
  "name": "ruling: a player who pays nothing (despite having mana) still draws X",
  "players": [
   { "hand": ["Minds Aglow"], "battlefield": ["Island", "Island", "Island"] },
   { "battlefield": ["Forest", "Forest"] }
  ],
  "steps": [
   { "cast": "Minds Aglow" },
   { "resolve": true, "answers": [0, 2] }
  ],
  "expect": { "players": [ { "hand_count": 2 }, { "hand_count": 2 } ] }
 }
]
