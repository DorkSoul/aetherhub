  {
    "name": "ruling: declining the bounce leaves the tapped creature on the battlefield",
    "players": [
      { "hand": ["Selkie Hedge-Mage"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
