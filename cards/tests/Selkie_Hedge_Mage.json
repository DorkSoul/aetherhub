  {
    "name": "ruling: one Island is not enough for the bounce trigger (intervening if)",
    "players": [
      { "hand": ["Selkie Hedge-Mage"], "battlefield": ["Forest", "Forest", "Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [ { "cast": "Selkie Hedge-Mage" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Selkie Hedge-Mage"], "life": 23 }, { "battlefield_has": ["Grizzly Bears"] } ] }
  }
