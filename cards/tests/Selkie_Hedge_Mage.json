    "steps": [ { "cast": "Selkie Hedge-Mage" }, { "resolve": true, "answers": [true, true] } ],
    "expect": { "players": [ { "battlefield_has": ["Selkie Hedge-Mage"], "life": 23 }, { "hand": ["Grizzly Bears"] } ] }
