  {
    "name": "ruling: a dual land counts for both the Forest and the Island trigger",
    "players": [
      { "hand": ["Selkie Hedge-Mage"], "battlefield": ["Breeding Pool", "Breeding Pool", "Plains"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
