[
  {
    "name": "when it dies, destroy target land",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Polluted Dead"] }, { "battlefield": ["Island"] }],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["Polluted Dead"] }, { "resolve": true, "targets": ["Island"] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Lightning Bolt", "Polluted Dead"] }, { "graveyard": ["Island"] }] }
  },
  {
    "name": "the trigger destroys only the chosen land",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Polluted Dead"] }, { "battlefield": ["Island", "Forest"] }],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["Polluted Dead"] }, { "resolve": true, "targets": ["Forest"] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Lightning Bolt", "Polluted Dead"] }, { "battlefield_has": ["Island"], "graveyard": ["Forest"] }] }
  }
]
