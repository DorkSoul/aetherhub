[
  { "name": "{2}: becomes a 2/1 flyer until end of turn",
    "players": [ { "battlefield": ["Chimeric Sphere", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Chimeric Sphere", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Chimeric Sphere": [2, 1] }, "keywords": { "Chimeric Sphere": ["Flying"] } } },
  { "name": "{2}: becomes a 3/2 with no flying after the flying ability resolved",
    "players": [ { "battlefield": ["Chimeric Sphere", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Chimeric Sphere", "ability": 0 },
      { "resolve": true },
      { "activate": "Chimeric Sphere", "ability": 1 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Chimeric Sphere": [3, 2] } } },
  { "name": "ruling: after the 3/2 activation (no flying) a ground creature can block it",
    "players": [ { "battlefield": ["Chimeric Sphere", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Chimeric Sphere", "ability": 0 },
      { "resolve": true },
      { "activate": "Chimeric Sphere", "ability": 1 },
      { "resolve": true },
      { "attack": [ { "card": "Chimeric Sphere", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Chimeric Sphere" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Chimeric Sphere"] }, { "graveyard": ["Grizzly Bears"] } ] } }
]
