[
  {
    "name": "toughness 2 target: +4/-1 (toughness drops to 1)",
    "players": [
      { "hand": ["Blood Lust"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Blood Lust", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [6, 1] }, "players": [ { "graveyard": ["Blood Lust"] }, {} ] }
  },
  {
    "name": "toughness 5 or greater: +4/-4",
    "players": [
      { "hand": ["Blood Lust"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Baneslayer Angel"] }
    ],
    "steps": [
      { "cast": "Blood Lust", "targets": ["Baneslayer Angel"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Baneslayer Angel": [9, 1] } }
  },
  {
    "name": "toughness 1 target: +4/-0 (stays alive)",
    "players": [
      { "hand": ["Blood Lust"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "cast": "Blood Lust", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Savannah Lions": [6, 1] } }
  },
  {
    "name": "ruling: toughness change is fixed on resolution: Nightmare with three Swamps becomes 7/1",
    "players": [
      { "hand": ["Blood Lust"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp", "Swamp", "Nightmare"] },
      {}
    ],
    "steps": [
      { "cast": "Blood Lust", "targets": ["Nightmare"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Nightmare": [7, 1] } }
  },
  {
    "name": "ruling: losing a Swamp afterwards does not reapply the change: Nightmare becomes 6/0 and dies",
    "players": [
      { "hand": ["Blood Lust", "Stone Rain"], "battlefield": ["Mountain", "Mountain", "Mountain", "Swamp", "Swamp", "Swamp", "Nightmare"] },
      {}
    ],
    "steps": [
      { "cast": "Blood Lust", "targets": ["Nightmare"] },
      { "resolve": true },
      { "cast": "Stone Rain", "targets": ["Swamp"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Nightmare"], "battlefield_lacks": ["Nightmare"] }, {} ] }
  }
]
