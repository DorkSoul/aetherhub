[
  {
    "name": "end step drains 3 when a permanent you controlled left the battlefield this turn",
    "players": [
      { "battlefield": ["Vrock", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Vrock"] }, { "life": 17 }]
    }
  },
  {
    "name": "does nothing when only an opponent's permanent left the battlefield",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Vrock", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "does nothing when no permanent you controlled left the battlefield",
    "players": [
      { "battlefield": ["Vrock", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "does nothing for a permanent that left during the opponent's turn",
    "players": [
      { "battlefield": ["Vrock", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  }
]
