[
  {
    "name": "discard X then return one graveyard card per discarded card, then exile Recall",
    "players": [
      {
        "hand": ["Recall", "Forest", "Mountain"],
        "battlefield": ["Island", "Island", "Island"],
        "graveyard": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Recall", "answers": [1] },
      { "resolve": true, "answers": [["Forest"], "Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "hand": ["Mountain", "Grizzly Bears"], "graveyard": ["Forest"], "exile": ["Recall"] },
        {}
      ]
    }
  },
  {
    "name": "X of zero discards nothing and still exiles Recall",
    "players": [
      { "hand": ["Recall", "Forest"], "battlefield": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Recall", "answers": [0] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "exile": ["Recall"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: returned cards are chosen after discarding, so a just-discarded card can come back",
    "players": [ { "hand": ["Recall", "Forest", "Mountain"], "battlefield": ["Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Recall", "answers": [1] }, { "resolve": true, "answers": [["Forest"], "Forest"] } ],
    "expect": { "players": [ { "hand": ["Mountain", "Forest"], "graveyard": ["Grizzly Bears"], "exile": ["Recall"] }, {} ] }
  },
  {
    "name": "ruling: discarding happens on resolution; with fewer cards than X all are discarded and one card returns per discard",
    "players": [ { "hand": ["Recall", "Forest"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Recall", "answers": [2] }, { "resolve": true, "answers": ["Grizzly Bears"] } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Forest"], "exile": ["Recall"] }, {} ] }
  }
]
