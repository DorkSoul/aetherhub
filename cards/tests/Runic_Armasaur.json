[
 {
  "name": "opponent activating a land ability lets me draw",
  "players": [
   { "battlefield": ["Runic Armasaur"], "library": ["Forest", "Forest"] },
   { "battlefield": ["Mutavault", "Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "activate": "Mutavault", "player": 1, "ability": 0 },
   { "resolve": true, "answers": [true] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 1 }, {} ] }
 },
 {
  "name": "declining the optional draw leaves my hand empty",
  "players": [
   { "battlefield": ["Runic Armasaur"], "library": ["Forest", "Forest"] },
   { "battlefield": ["Mutavault", "Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "activate": "Mutavault", "player": 1, "ability": 0 },
   { "resolve": true, "answers": [false] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 0 }, {} ] }
 },
 {
  "name": "my own activated land ability does not trigger it",
  "players": [
   { "battlefield": ["Runic Armasaur", "Mutavault", "Mountain"], "library": ["Forest"] },
   {}
  ],
  "steps": [
   { "activate": "Mutavault", "ability": 0 },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 0 }, {} ] }
 },
 {
  "name": "ruling: an opponent's creature mana ability does not trigger it",
  "players": [
   { "battlefield": ["Runic Armasaur"], "library": ["Forest"] },
   { "battlefield": [ { "name": "Llanowar Elves", "sick": false } ] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "tap_for_mana": "Llanowar Elves", "color": "G", "player": 1 }
  ],
  "expect": { "stack_empty": true, "players": [ { "hand_count": 0 }, {} ] }
 },
 {
  "name": "ruling: an opponent cycling a card from hand does not trigger it",
  "players": [
   { "battlefield": ["Runic Armasaur"], "library": ["Forest", "Forest"] },
   { "hand": ["Barren Moor"], "battlefield": ["Swamp"] }
  ],
  "steps": [
   { "pass": true },
   { "activate": "Barren Moor", "player": 1, "ability": 0 },
   { "resolve": true, "auto": true }
  ],
  "expect": { "players": [ { "hand_count": 0 }, {} ] }
 }
]
