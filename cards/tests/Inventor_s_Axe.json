[
  {
    "name": "enters: two energy and attaches to a creature you control",
    "players": [ { "hand": ["Inventor's Axe"], "battlefield": ["Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Inventor's Axe" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 2, "battlefield_has": ["Inventor's Axe"] }, {} ], "pt": { "Grizzly Bears": [4, 2] } }
  },
  {
    "name": "equip: pay EE to move it to another creature",
    "players": [ { "hand": ["Inventor's Axe"], "battlefield": ["Mountain", "Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [
      { "cast": "Inventor's Axe" },
      { "resolve": true, "answers": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Inventor's Axe", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 0 }, {} ], "pt": { "Hill Giant": [5, 3], "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "ruling: cast with no creature you control: the Axe enters unattached and gets its energy",
    "players": [ { "hand": ["Inventor's Axe"], "battlefield": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Inventor's Axe" }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 2, "battlefield_has": ["Inventor's Axe"] }, {} ] }
  },
  {
    "name": "ruling: attach target removed in response: the Axe stays on the battlefield unattached",
    "players": [ { "hand": ["Inventor's Axe", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Inventor's Axe" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 2, "battlefield_has": ["Inventor's Axe"], "graveyard": ["Grizzly Bears", "Lightning Bolt"] }, {} ] }
  }
]
