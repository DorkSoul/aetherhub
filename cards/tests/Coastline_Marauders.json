[
 { "name": "attacking gets +1/+0 for each land the defending player controls",
   "players": [ { "battlefield": ["Coastline Marauders"] },
                { "life": 20, "battlefield": ["Plains", "Plains", "Island", "Island", "Forest"] } ],
   "steps": [ { "attack": [ { "card": "Coastline Marauders", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "pt": { "Coastline Marauders": [5, 3] }, "players": [ {}, { "life": 15 } ] } },
 { "name": "only lands the defending player controls count, not the attacker's own lands",
   "players": [ { "battlefield": ["Coastline Marauders", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Plains"] } ],
   "steps": [ { "attack": [ { "card": "Coastline Marauders", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "pt": { "Coastline Marauders": [1, 3] } } },
 { "name": "encore from the graveyard creates a token copy for the opponent and exiles the card",
   "players": [ { "graveyard": ["Coastline Marauders"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Plains", "Plains"] },
                { "battlefield": ["Plains"] } ],
   "steps": [ { "activate": "Coastline Marauders", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Coastline Marauders"], "graveyard": [] }, {} ] } },
 { "name": "encore needs {4}{R}{R}: five lands is not enough",
   "players": [ { "graveyard": ["Coastline Marauders"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Plains"] },
                { "battlefield": ["Plains"] } ],
   "steps": [ { "activate": "Coastline Marauders", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Coastline Marauders"] }, {} ] } },
 { "name": "ruling: encore's exile is a cost, so the card is already exiled while the token ability is on the stack",
   "players": [ { "graveyard": ["Coastline Marauders"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Plains", "Plains"] },
                { "battlefield": ["Plains"] } ],
   "steps": [ { "activate": "Coastline Marauders", "ability": 0 } ],
   "expect": { "players": [ { "exile": ["Coastline Marauders"], "graveyard": [] }, {} ] } },
 { "name": "ruling: attacking a planeswalker, the bonus counts the lands of the planeswalker's controller only",
   "players": [ { "battlefield": ["Coastline Marauders", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Jace Beleren", "Plains", "Plains", "Island"] } ],
   "steps": [ { "attack": [ { "card": "Coastline Marauders", "at": "Jace Beleren" } ] }, { "resolve": true }, { "block": [] } ],
   "expect": { "pt": { "Coastline Marauders": [3, 3] } } }
]
