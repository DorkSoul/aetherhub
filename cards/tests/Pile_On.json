[
 { "name": "destroys a creature, then surveil 2 (one to graveyard, one stays)",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp","Swamp","Swamp","Swamp"], "library": ["Forest","Mountain","Island"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Pile On", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [["Forest"]] } ],
   "expect": { "players": [ { "graveyard": ["Pile On", "Forest"], "library_count": 2 }, { "graveyard": ["Hill Giant"] } ] } },
 { "name": "convoke: tap two creatures plus two Swamps",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp","Swamp","Grizzly Bears","Hill Giant"] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Pile On", "targets": ["Serra Angel"], "answers": [["Grizzly Bears", "Hill Giant"]] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Pile On"], "battlefield_has": ["Grizzly Bears", "Hill Giant"] }, { "graveyard": ["Serra Angel"] } ], "tapped": { "Grizzly Bears": true, "Hill Giant": true } } },
 { "name": "destroys a planeswalker",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp","Swamp","Swamp","Swamp"] }, { "battlefield": ["Arlinn Kord // Arlinn, Embraced by the Moon"] } ],
   "steps": [ { "cast": "Pile On", "targets": ["Arlinn Kord // Arlinn, Embraced by the Moon"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Pile On"] }, { "battlefield": [] } ] } },
 { "name": "can't target a land or artifact",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp","Swamp","Swamp","Swamp"] }, { "battlefield": ["Sol Ring"] } ],
   "steps": [ { "cast": "Pile On", "targets": ["Sol Ring"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Pile On"] }, { "battlefield": ["Sol Ring"] } ] } },
 { "name": "ruling: a creature tapped for mana cannot also be tapped for convoke",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp", "Swamp", "Llanowar Elves"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "tap_for_mana": "Llanowar Elves" }, { "cast": "Pile On", "targets": ["Hill Giant"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Pile On"], "battlefield_has": ["Llanowar Elves"] }, { "battlefield_has": ["Hill Giant"] } ], "tapped": { "Llanowar Elves": true } } },
 { "name": "ruling: a summoning-sick creature can be tapped to convoke",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp", "Swamp", "Swamp", { "name": "Grizzly Bears", "sick": true }], "library": ["Forest"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Pile On", "targets": ["Hill Giant"], "answers": [["Grizzly Bears"]] }, { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "graveyard_has": ["Pile On"], "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ], "tapped": { "Grizzly Bears": true } } },
 { "name": "ruling: surveil 2 may leave both cards on top (nothing to the graveyard)",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "library": ["Forest", "Mountain", "Island"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Pile On", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [[]] } ],
   "expect": { "players": [ { "graveyard": ["Pile On"], "library_top": ["Forest", "Mountain"], "library_count": 3 }, { "graveyard": ["Hill Giant"] } ] } },
 { "name": "ruling: surveil 2 may put both cards into the graveyard",
   "players": [ { "hand": ["Pile On"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "library": ["Forest", "Mountain", "Island"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Pile On", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [["Forest", "Mountain"]] } ],
   "expect": { "players": [ { "graveyard": ["Pile On", "Forest", "Mountain"], "library_count": 1 }, { "graveyard": ["Hill Giant"] } ] } }
]
