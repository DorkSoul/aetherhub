[
  {
    "name": "a spell targeting an opponent grows Danitha",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Danitha, Spear of Agony", "Mountain"] },
      {}
    ],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true }],
    "expect": { "pt": { "Danitha, Spear of Agony": [3, 3] } }
  },
  {
    "name": "a spell targeting an opponent's creature grows Danitha",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Danitha, Spear of Agony", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true }],
    "expect": { "pt": { "Danitha, Spear of Agony": [3, 3] } }
  },
  {
    "name": "a spell targeting my own creature does not",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Danitha, Spear of Agony", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "pt": { "Danitha, Spear of Agony": [2, 2] } }
  }
]
