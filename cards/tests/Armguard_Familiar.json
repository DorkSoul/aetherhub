   {}
  ],
  "steps": [
   { "activate": "Armguard Familiar", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "attack": [ { "card": "Armguard Familiar", "at": "p1" } ], "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Armguard Familiar"] }, {} ],
   "attached": { "Armguard Familiar": "Grizzly Bears" },
   "pt": { "Grizzly Bears": [4, 3] }
  }
 },
 {
  "name": "reconfigure needs {4}: three Islands cannot attach it",
  "players": [
   { "battlefield": ["Island", "Island", "Island", "Armguard Familiar", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Armguard Familiar", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Armguard Familiar"] }, {} ],
   "pt": { "Grizzly Bears": [2, 2] }
  }
 },
 {
  "name": "unattach with reconfigure makes the Familiar a 2/1 creature again",
  "players": [
   { "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Armguard Familiar", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Armguard Familiar", "ability": 0, "targets": ["Grizzly Bears"] },
