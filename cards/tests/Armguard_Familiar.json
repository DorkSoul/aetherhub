  "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Armguard Familiar"] }, { "resolve": true, "auto": true } ],
  "expect": { "players": [ { "battlefield_has": ["Armguard Familiar"] }, { "graveyard_has": ["Lightning Bolt"], "life": 20 } ] }
 },
 {
  "name": "ward {2}: the opponent pays 2 with spare mana, Bolt resolves and kills the Familiar",
  "players": [ { "battlefield": ["Armguard Familiar"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
  "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Armguard Familiar"] }, { "resolve": true, "auto": true } ],
  "expect": { "players": [ { "graveyard_has": ["Armguard Familiar"] }, { "graveyard_has": ["Lightning Bolt"], "life": 20 } ] }
 },
 {
  "name": "equipped creature has ward {2}: Bolt on the 4/3 Grizzly Bears is countered when the opponent cannot pay",
  "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Armguard Familiar", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
  "steps": [
   { "activate": "Armguard Familiar", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true, "auto": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Armguard Familiar", "Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"], "life": 20 } ],
   "attached": { "Armguard Familiar": "Grizzly Bears" },
   "pt": { "Grizzly Bears": [4, 3] }
  }
 },
 {
