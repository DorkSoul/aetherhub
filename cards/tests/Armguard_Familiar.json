  "expect": {
   "players": [ { "battlefield_has": ["Armguard Familiar"] }, {} ],
   "pt": { "Armguard Familiar": [2, 1] }
  }
 },
 {
  "name": "ruling: an attached Equipment does not become tapped when the creature it is attached to attacks",
  "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Armguard Familiar", "Grizzly Bears"] }, {} ],
  "steps": [
   { "activate": "Armguard Familiar", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }
