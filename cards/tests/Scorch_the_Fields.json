   { "hand": ["Scorch the Fields"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Forest", "Thalia, Guardian of Thraben", "Strip Mine"] }
