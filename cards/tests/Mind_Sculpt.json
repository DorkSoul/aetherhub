[
  {
    "name": "mills seven from the target opponent",
    "players": [
      {
        "hand": [
          "Mind Sculpt"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "library": [
          "Mountain",
          "Island",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Mind Sculpt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Mind Sculpt"
          ],
          "library_count": 20
        },
        {
          "graveyard_has": [
            "Mountain",
            "Island",
            "Forest"
          ],
          "library_count": 16
        }
      ]
    }
  },
  {
    "name": "ruling: a short library is still milled; the opponent just has nothing left",
    "players": [
      {
        "hand": ["Mind Sculpt"],
        "battlefield": ["Island", "Island"]
      },
      {
        "library": ["Mountain", "Island", "Forest"],
        "exact_library": true
      }
    ],
    "steps": [
      { "cast": "Mind Sculpt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Mind Sculpt"] },
        { "library_count": 0, "graveyard_has": ["Mountain", "Island", "Forest"] }
      ]
    }
  }
]