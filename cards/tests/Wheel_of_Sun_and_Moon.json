[
 {
  "name": "cards going to the enchanted player's graveyard go to the bottom of their library",
  "players": [
   { "hand": ["Wheel of Sun and Moon"], "battlefield": ["Plains", "Plains", "Millstone", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Wheel of Sun and Moon", "targets": ["p1"] },
   { "resolve": true },
   { "activate": "Millstone", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ {}, { "library_count": 20, "graveyard": [] } ]
  }
 },
 {
  "name": "cards going to the controller's own graveyard are not affected",
  "players": [
   { "hand": ["Wheel of Sun and Moon"], "battlefield": ["Plains", "Plains", "Millstone", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Wheel of Sun and Moon", "targets": ["p1"] },
   { "resolve": true },
   { "activate": "Millstone", "targets": ["p0"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "library_count": 18 }, { "library_count": 20 } ]
  }
 },
 {
  "name": "ruling: an instant that resolves goes to the bottom of the enchanted player's library, not their graveyard",
  "players": [
   { "hand": ["Wheel of Sun and Moon"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "cast": "Wheel of Sun and Moon", "targets": ["p1"] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Grizzly Bears"] }, { "library_count": 21, "graveyard": [] } ]
  }
 }
]
