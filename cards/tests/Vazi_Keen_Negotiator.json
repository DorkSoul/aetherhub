[
  {
    "name": "the target opponent creates as many Treasures as you created this turn",
    "players": [
      { "hand": ["Big Score", "Forest"], "battlefield": [{ "name": "Vazi, Keen Negotiator", "sick": false }, "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Big Score" },
      { "resolve": true },
      { "activate": "Vazi, Keen Negotiator", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Treasure", "Treasure"] }, { "battlefield": ["Treasure", "Treasure"] } ] }
  },
  {
    "name": "no Treasures created this turn: the opponent gets none",
    "players": [
      { "battlefield": [{ "name": "Vazi, Keen Negotiator", "sick": false }] },
      {}
    ],
    "steps": [
      { "activate": "Vazi, Keen Negotiator", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "battlefield": [] } ] }
  },
  {
    "name": "an opponent casts a spell with Treasure mana: +1/+1 counter and you draw",
    "players": [
      { "battlefield": ["Vazi, Keen Negotiator"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Treasure"] }
    ],
    "steps": [
      { "pass": true },
      { "tap_for_mana": "Treasure", "player": 1, "color": "R" },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 1, "life": 17 }, {} ], "pt": { "Vazi, Keen Negotiator": [4, 4] } }
  },
  {
    "name": "casting with ordinary mana does nothing",
    "players": [
      { "battlefield": ["Vazi, Keen Negotiator"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0, "life": 17 }, {} ], "pt": { "Vazi, Keen Negotiator": [3, 3] } }
  },
  {
    "name": "an opponent activates an ability with Treasure mana: counter and draw",
    "players": [
      { "battlefield": ["Vazi, Keen Negotiator"] },
      { "battlefield": [{ "name": "Shivan Dragon", "sick": false }, "Treasure"] }
    ],
    "steps": [
      { "pass": true },
      { "tap_for_mana": "Treasure", "player": 1, "color": "R" },
      { "activate": "Shivan Dragon", "player": 1, "ability": 0, "targets": ["Vazi, Keen Negotiator"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 1 }, {} ], "pt": { "Vazi, Keen Negotiator": [4, 4] } }
  }
]
