[
  { "name": "you shuffle up to four cards from your graveyard into your library",
    "players": [ { "hand": ["Dwell on the Past"], "battlefield": ["Forest"], "graveyard": ["Grizzly Bears", "Hill Giant", "Giant Growth"], "library": ["Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Dwell on the Past", "targets": ["p0", "Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 4, "graveyard_has": ["Giant Growth"] }, {} ] } },
  { "name": "the opponent's cards go to the opponent's library",
    "players": [ { "hand": ["Dwell on the Past"], "battlefield": ["Forest"], "library": ["Plains"] }, { "graveyard": ["Grizzly Bears", "Hill Giant"], "library": ["Plains"] } ],
    "steps": [ { "cast": "Dwell on the Past", "targets": ["p1", "Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 1 }, { "library_count": 3 } ] } },
  { "name": "up to four: zero cards is fine",
    "players": [ { "hand": ["Dwell on the Past"], "battlefield": ["Forest"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Dwell on the Past", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ] } }
]
