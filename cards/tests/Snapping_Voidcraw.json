[
  {
    "name": "tap for two colorless mana",
    "players": [
      { "battlefield": ["Snapping Voidcraw"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Snapping Voidcraw" }
    ],
    "expect": {
      "players": [
        { "pool": { "C": 2 } },
        {}
      ]
    }
  },
  {
    "name": "draw ability needs colorless mana: red mana cannot pay {C}",
    "players": [
      { "battlefield": ["Snapping Voidcraw", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Snapping Voidcraw", "ability": 0, "illegal": true }
    ]
  },
  {
    "name": "{3}{C}, {T}: draw a card, paying with colorless mana",
    "players": [
      { "library": ["Lightning Bolt"], "battlefield": ["Snapping Voidcraw", "Wastes", "Wastes", "Wastes", "Wastes"] },
      {}
    ],
    "steps": [{ "activate": "Snapping Voidcraw", "ability": 0 }, { "resolve": true }],
    "expect": { "players": [{ "hand": ["Lightning Bolt"] }, {}], "tapped": { "Snapping Voidcraw": true } }
  },
  {
    "name": "three colorless lands are not enough for {3}{C}",
    "players": [{ "battlefield": ["Snapping Voidcraw", "Wastes", "Wastes", "Wastes"] }, {}],
    "steps": [{ "activate": "Snapping Voidcraw", "ability": 0, "illegal": true }],
    "expect": { "players": [{ "battlefield_has": ["Snapping Voidcraw"] }, {}] }
  },
  {
    "name": "ruling: devoid makes the card colorless, not the colors in its mana cost",
    "players": [ { "battlefield": ["Snapping Voidcraw"] }, {} ],
    "steps": [ { "pass": true } ],
    "expect": { "colors": { "Snapping Voidcraw": [] } }
  },
  {
    "name": "ruling: a color given by another effect is just that color (Painter's Servant makes the devoid card red)",
    "players": [ { "hand": ["Painter's Servant"], "battlefield": ["Forest", "Forest", "Snapping Voidcraw"] }, {} ],
    "steps": [ { "cast": "Painter's Servant" }, { "resolve": true, "answers": ["R"] } ],
    "expect": { "colors": { "Snapping Voidcraw": ["R"] } }
  }
]
