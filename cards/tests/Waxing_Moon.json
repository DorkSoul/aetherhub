    "steps": [
      { "cast": "Waxing Moon", "targets": ["Ulvenwald Captive"] },
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Ulvenwald Captive"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
