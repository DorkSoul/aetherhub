  {
    "name": "ruling: target illegal on resolution, so no creatures gain trample",
    "players": [
      { "hand": ["Waxing Moon"], "battlefield": ["Forest", "Forest", "Ulvenwald Captive", { "name": "Grizzly Bears", "sick": false }] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp", "Llanowar Elves"] }
