[
  {
    "name": "destroys a nonland permanent when another with the same name is on the battlefield, and draws",
    "players": [
      { "hand": ["Winnow"], "battlefield": ["Plains", "Island", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Winnow", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "without another permanent of the same name nothing is destroyed but it still draws",
    "players": [
      { "hand": ["Winnow"], "battlefield": ["Plains", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Winnow", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
