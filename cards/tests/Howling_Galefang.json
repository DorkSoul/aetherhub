[
  {
    "name": "you own an Adventure card in exile: it has haste and can attack the turn it is cast",
    "players": [
      { "hand": ["Howling Galefang"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "exile": ["Bonecrusher Giant // Stomp"] },
      {}
    ],
    "steps": [
      { "cast": "Howling Galefang" },
      { "resolve": true },
      { "attack": [ { "card": "Howling Galefang", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "no Adventure card in exile: no haste, cannot attack the turn it is cast",
    "players": [
      { "hand": ["Howling Galefang"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Howling Galefang" },
      { "resolve": true },
      { "attack": [ { "card": "Howling Galefang", "at": "p1" } ], "illegal": true }
    ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "an opponent's Adventure card in exile does not count",
    "players": [
      { "hand": ["Howling Galefang"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "exile": ["Bonecrusher Giant // Stomp"] }
    ],
    "steps": [
      { "cast": "Howling Galefang" },
      { "resolve": true },
      { "attack": [ { "card": "Howling Galefang", "at": "p1" } ], "illegal": true }
    ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "an Adventure card in exile gives Howling Galefang the Haste keyword on entering",
    "players": [
      { "hand": ["Howling Galefang"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "exile": ["Bonecrusher Giant // Stomp"] },
      {}
    ],
    "steps": [
      { "cast": "Howling Galefang" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Howling Galefang"] }, {} ],
      "keywords": { "Howling Galefang": ["Haste"] }
    }
  },
  {
    "name": "ruling: an Adventure card cast as its Adventure and then exiled also gives haste",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp", "Howling Galefang"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Howling Galefang" },
      { "resolve": true },
      { "attack": [ { "card": "Howling Galefang", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "exile": ["Bonecrusher Giant // Stomp"] }, { "life": 14 } ]
    }
  }
]
