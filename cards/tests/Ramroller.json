[
  {
    "name": "attacks each combat if able",
    "players": [
      {
        "battlefield": [
          {
            "name": "Ramroller",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "DeclareAttackers"
      }
    ],
    "expect": {
      "tapped": {
        "Ramroller": true
      }
    }
  },
  {
    "name": "2/3 without another artifact",
    "players": [
      {
        "battlefield": [
          "Ramroller"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Ramroller": [
          2,
          3
        ]
      }
    }
  },
  {
    "name": "4/3 while you control another artifact",
    "players": [
      {
        "battlefield": [
          "Ramroller",
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Ramroller": [
          4,
          3
        ]
      }
    }
  },
  {
    "name": "ruling: a tapped Ramroller does not attack",
    "players": [
      { "battlefield": [ { "name": "Ramroller", "sick": false, "tapped": true } ] },
      {}
    ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "tapped": { "Ramroller": true }, "players": [ {}, { "life": 20 } ] }
  }
]