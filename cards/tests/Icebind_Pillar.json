[
  {
    "name": "snow mana taps a creature",
    "players": [
      { "battlefield": ["Icebind Pillar", "Snow-Covered Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Icebind Pillar", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Icebind Pillar": true }
    }
  },
  {
    "name": "taps an artifact too",
    "players": [
      { "battlefield": ["Icebind Pillar", "Snow-Covered Island"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "activate": "Icebind Pillar", "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Sol Ring": true }
    }
  },
  {
    "name": "a non-snow land cannot pay the S",
    "players": [
      { "battlefield": ["Icebind Pillar", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Icebind Pillar", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: {S} is one mana of any colour from a snow source (green snow Forest pays)",
    "players": [
      { "battlefield": ["Icebind Pillar", "Snow-Covered Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Icebind Pillar", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  }
]
