[
 {
  "name": "return two permanent cards to hand, the target player shuffles two cards from their graveyard into their library, the Rite is exiled",
  "players": [
   { "hand": ["Rite of Renewal"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears", "Llanowar Elves", "Lightning Bolt"] },
   { "graveyard": ["Island", "Swamp"] }
  ],
  "steps": [
   { "cast": "Rite of Renewal", "targets": ["Grizzly Bears", "Llanowar Elves", "p1", "Island", "Swamp"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Grizzly Bears", "Llanowar Elves"], "graveyard": ["Lightning Bolt"], "exile": ["Rite of Renewal"] }, { "graveyard": [], "library_count": 2 } ] }
 },
 {
  "name": "a nonpermanent card in my graveyard can't be returned; I shuffle up to four cards of my own graveyard",
  "players": [
   { "hand": ["Rite of Renewal"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Shock", "Giant Growth", "Counterspell"] },
   {}
  ],
  "steps": [
   { "cast": "Rite of Renewal", "targets": ["Grizzly Bears", "p0", "Lightning Bolt", "Shock", "Giant Growth", "Counterspell"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": [], "library_count": 4, "exile": ["Rite of Renewal"] }, {} ] }
 },
 {
  "name": "at most four cards are shuffled in; the rest stay in the graveyard",
  "players": [
   { "hand": ["Rite of Renewal"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
   { "graveyard": ["Island", "Swamp", "Mountain", "Plains", "Wastes"] }
  ],
  "steps": [
   { "cast": "Rite of Renewal", "targets": ["p1", "Island", "Swamp", "Mountain", "Plains"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 0, "exile": ["Rite of Renewal"] }, { "graveyard": ["Wastes"], "library_count": 4 } ] }
 },
 {
  "name": "the cards in the other graveyard can only be those of the targeted player",
  "players": [
   { "hand": ["Rite of Renewal"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "graveyard": ["Shock"] },
   { "graveyard": ["Island"] }
  ],
  "steps": [
   { "cast": "Rite of Renewal", "targets": ["p1", "Island"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Shock"] }, { "graveyard": [], "library_count": 1 } ] }
 }
]
