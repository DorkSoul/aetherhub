[
  { "name": "casting an instant that targets a creature puts a +1/+1 counter on it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lecturing Scornmage", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Lecturing Scornmage"] }, { "graveyard_has": ["Grizzly Bears"] } ],
                "pt": { "Lecturing Scornmage": [2, 2] } } },
  { "name": "an instant that targets a player does not trigger repartee",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lecturing Scornmage", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Lecturing Scornmage": [1, 1] } } },
  { "name": "ruling: repartee resolves before the targeting spell, so the counter is in place while the spell is still on the stack",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lecturing Scornmage", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "players": [ { "battlefield_has": ["Lecturing Scornmage"] }, { "battlefield_has": ["Grizzly Bears"] } ],
                "pt": { "Lecturing Scornmage": [2, 2] } } }
]
