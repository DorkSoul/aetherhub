[
  {
    "name": "draws a card when it enters",
    "players": [ { "hand": ["Didact Echo"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Island"] }, {} ],
    "steps": [
      { "cast": "Didact Echo" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Island"], "battlefield_has": ["Didact Echo"] }, {} ] }
  },
  {
    "name": "has flying with four permanent cards in your graveyard",
    "players": [ { "battlefield": [ { "name": "Didact Echo", "sick": false } ], "graveyard": ["Grizzly Bears", "Plains", "Island", "Swamp"] }, {} ],
    "steps": [ { "pass": true } ],
    "expect": { "keywords": { "Didact Echo": ["Flying"] } }
  },
  {
    "name": "ruling: an instant in the graveyard does not count toward descend, so no flying and Grizzly Bears can block",
    "players": [ { "battlefield": [ { "name": "Didact Echo", "sick": false } ], "graveyard": ["Grizzly Bears", "Plains", "Island", "Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Didact Echo", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Didact Echo" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Didact Echo", "Lightning Bolt"] },
        { "graveyard_has": ["Grizzly Bears"], "life": 20 }
      ]
    }
  }
]
