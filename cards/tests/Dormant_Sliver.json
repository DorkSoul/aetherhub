[
  {
    "name": "all Slivers have defender",
    "players": [
      {
        "battlefield": [
          "Dormant Sliver",
          "Brood Sliver"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "keywords": {
        "Brood Sliver": [
          "Defender"
        ],
        "Dormant Sliver": [
          "Defender"
        ]
      }
    }
  },
  {
    "name": "a Sliver entering draws a card for its controller",
    "players": [
      {
        "hand": [
          "Brood Sliver"
        ],
        "battlefield": [
          "Dormant Sliver",
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Brood Sliver"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "Dormant Sliver's own granted ability draws when it enters",
    "players": [
      {
        "hand": [
          "Dormant Sliver"
        ],
        "battlefield": [
          "Forest",
          "Island",
          "Forest",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Dormant Sliver"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: two Dormant Slivers give two cumulative draw triggers to an entering Sliver",
    "players": [
      {
        "hand": ["Brood Sliver"],
        "battlefield": ["Dormant Sliver", "Dormant Sliver", "Forest", "Forest", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Brood Sliver" },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 2 }, {} ]
    }
  },
  {
    "name": "ruling: the controller of the entering Sliver draws, not the Dormant Sliver's controller",
    "players": [
      { "battlefield": ["Dormant Sliver"] },
      { "hand": ["Brood Sliver"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "cast": "Brood Sliver", "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "battlefield_has": ["Dormant Sliver"] }, { "battlefield_has": ["Brood Sliver"] } ]
    }
  }
]
