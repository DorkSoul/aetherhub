[
  {
    "name": "attacking gains 1 life per creature you control with power 4 or greater",
    "players": [
      { "battlefield": ["Atlas, Sizable Stooge", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Atlas, Sizable Stooge", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 15 } ]
    }
  },
  {
    "name": "a power 3 creature does not count",
    "players": [
      { "battlefield": ["Atlas, Sizable Stooge", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Atlas, Sizable Stooge", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 15 } ]
    }
  },
  {
    "name": "blocking gains 1 life per creature you control with power 4 or greater",
    "players": [ { "battlefield": ["Atlas, Sizable Stooge", "Serra Angel", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Atlas, Sizable Stooge", "attacker": "Hill Giant" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 22 }, { "life": 20 } ] }
  },
  {
    "name": "not blocking with Atlas gains no life",
    "players": [ { "battlefield": ["Atlas, Sizable Stooge"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 17 }, { "life": 20 } ] }
  }
]
