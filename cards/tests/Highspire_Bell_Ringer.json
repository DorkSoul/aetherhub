[
  {
    "name": "second spell costs one less",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Hill Giant"
        ],
        "battlefield": [
          "Highspire Bell-Ringer",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Hill Giant"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Hill Giant"
          ]
        },
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "first spell is not reduced",
    "players": [
      {
        "hand": [
          "Hill Giant"
        ],
        "battlefield": [
          "Highspire Bell-Ringer",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Hill Giant",
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: Bell-Ringer cast as the first spell makes the next spell the second, so it is reduced",
    "players": [
      { "hand": ["Highspire Bell-Ringer", "Hill Giant"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Highspire Bell-Ringer" },
      { "resolve": true },
      { "cast": "Hill Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Highspire Bell-Ringer", "Hill Giant"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: spells cast before Bell-Ringer entered still count, so the third spell is not reduced",
    "players": [
      { "hand": ["Lightning Bolt", "Highspire Bell-Ringer", "Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Highspire Bell-Ringer" },
      { "resolve": true },
      { "cast": "Hill Giant", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Highspire Bell-Ringer"], "hand": ["Hill Giant"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: Bell-Ringer does not reduce its own cost when it is the second spell",
    "players": [
      { "hand": ["Lightning Bolt", "Highspire Bell-Ringer"], "battlefield": ["Mountain", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Highspire Bell-Ringer", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Highspire Bell-Ringer"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]
