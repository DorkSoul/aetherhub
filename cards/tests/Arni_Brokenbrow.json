[
  {
    "name": "boast: base power becomes 1 + the greatest power among other creatures",
    "players": [ { "battlefield": [ "Arni Brokenbrow", "Hill Giant", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Arni Brokenbrow", "at": "p1" } ] },
      { "activate": "Arni Brokenbrow" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "pt": { "Arni Brokenbrow": [4, 3] } }
  },
  {
    "name": "can't boast before attacking",
    "players": [ { "battlefield": [ "Arni Brokenbrow", "Hill Giant", "Mountain" ] }, {} ],
    "steps": [ { "activate": "Arni Brokenbrow", "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "ruling: boast can be activated only once per turn, even with spare mana",
    "players": [ { "battlefield": [ "Arni Brokenbrow", "Hill Giant", "Mountain", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Arni Brokenbrow", "at": "p1" } ] },
      { "activate": "Arni Brokenbrow" },
      { "resolve": true, "answers": [true] },
      { "activate": "Arni Brokenbrow", "illegal": true }
    ],
    "expect": { "pt": { "Arni Brokenbrow": [4, 3] } }
  },
  {
    "name": "ruling: a +1/+0 effect created after boast still applies on top of the base power",
    "players": [ { "hand": ["Moment of Valor"], "battlefield": ["Arni Brokenbrow", "Hill Giant", "Mountain", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Arni Brokenbrow", "at": "p1" } ] },
      { "activate": "Arni Brokenbrow" },
      { "resolve": true, "answers": [true] },
      { "cast": "Moment of Valor", "targets": ["Arni Brokenbrow"], "answers": [0] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Arni Brokenbrow": [5, 3] } }
  },
  {
    "name": "ruling: boast can be activated in the postcombat main phase, after damage",
    "players": [ { "battlefield": [ "Arni Brokenbrow", "Hill Giant", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Arni Brokenbrow", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "activate": "Arni Brokenbrow" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "pt": { "Arni Brokenbrow": [4, 3] }, "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "ruling: with no other creature, boast sets Arni's base power to 1",
    "players": [ { "battlefield": [ "Arni Brokenbrow", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Arni Brokenbrow", "at": "p1" } ] },
      { "activate": "Arni Brokenbrow" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "pt": { "Arni Brokenbrow": [1, 3] } }
  },
  {
    "name": "ruling: the greatest power used is the other creature's current power, including pumps",
    "players": [ { "hand": ["Moment of Valor"], "battlefield": ["Arni Brokenbrow", "Hill Giant", "Mountain", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Moment of Valor", "targets": ["Hill Giant"], "answers": [0] },
      { "resolve": true },
      { "attack": [ { "card": "Arni Brokenbrow", "at": "p1" } ] },
      { "activate": "Arni Brokenbrow" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "pt": { "Arni Brokenbrow": [5, 3], "Hill Giant": [4, 3] } }
  }
]
