[
  {
    "name": "destroys a white creature",
    "players": [
      { "hand": ["Soul Rend"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Elite Vanguard"] }
    ],
    "steps": [
      { "cast": "Soul Rend", "targets": ["Elite Vanguard"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Soul Rend"] },
        { "graveyard": ["Elite Vanguard"] }
      ]
    }
  },
  {
    "name": "does not destroy a nonwhite creature, but still draws at the next upkeep",
    "players": [
      { "hand": ["Soul Rend"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Soul Rend", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Soul Rend"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a creature that stops being white in response is not destroyed",
    "players": [
      { "hand": ["Soul Rend"], "battlefield": ["Swamp", "Swamp"] },
      { "hand": ["Moonlace"], "battlefield": ["Island", "Elite Vanguard"] }
    ],
    "steps": [
      { "cast": "Soul Rend", "targets": ["Elite Vanguard"] },
      { "cast": "Moonlace", "player": 1, "targets": ["Elite Vanguard"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Soul Rend"] },
        { "graveyard": ["Moonlace"], "battlefield_has": ["Elite Vanguard"] }
      ],
      "colors": { "Elite Vanguard": [] }
    }
  }
]
