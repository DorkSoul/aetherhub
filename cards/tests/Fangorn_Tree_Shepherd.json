[
 {
  "name": "Treefolk have vigilance; G persists",
  "players": [
   {
    "battlefield": [
     "Fangorn, Tree Shepherd",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Forest"
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "keywords": {
    "Fangorn, Tree Shepherd": [
     "Vigilance"
    ]
   }
  }
 },
 {
  "name": "attacking Treefolk: add twice that much green mana",
  "players": [ { "battlefield": [ { "name": "Fangorn, Tree Shepherd", "sick": false } ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Fangorn, Tree Shepherd", "at": "p1" } ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "pool": { "G": 2 } }, {} ] }
 },
 {
  "name": "two attacking Treefolk: one trigger adds four green mana",
  "players": [ { "battlefield": [ { "name": "Fangorn, Tree Shepherd", "sick": false }, { "name": "Argothian Treefolk", "sick": false } ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Fangorn, Tree Shepherd", "at": "p1" }, { "card": "Argothian Treefolk", "at": "p1" } ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "pool": { "G": 4 } }, {} ] }
 },
 {
  "name": "a non-Treefolk attacker does not trigger it",
  "players": [ { "battlefield": [ { "name": "Fangorn, Tree Shepherd", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }
  ],
  "expect": { "players": [ { "pool": {} }, {} ] }
 },
 { "name": "unspent green from the attack trigger persists into the second main phase",
  "players": [ { "battlefield": [ { "name": "Fangorn, Tree Shepherd", "sick": false } ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Fangorn, Tree Shepherd", "at": "p1" } ] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "pool": { "G": 2 } }, {} ] }
 },
 {
  "name": "ruling: unspent green stays in the pool across steps and into the opponent's next turn",
  "players": [ { "battlefield": [ { "name": "Fangorn, Tree Shepherd", "sick": false } ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Fangorn, Tree Shepherd", "at": "p1" } ] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" }
  ],
  "expect": { "players": [ { "pool": { "G": 2 } }, {} ] }
 },
 {
  "name": "ruling: unspent red is lost at end of combat while Fangorn's green stays",
  "players": [ { "battlefield": [ { "name": "Fangorn, Tree Shepherd", "sick": false }, "Mountain" ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Fangorn, Tree Shepherd", "at": "p1" } ] },
   { "resolve": true },
   { "tap_for_mana": "Mountain" },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "pool": { "G": 2 } }, {} ] }
 }
]
