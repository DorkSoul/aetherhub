[
  {
    "name": "activation puts a blaze counter on target land",
    "players": [
      {
        "battlefield": [
          "Obsidian Fireheart",
          "Mountain",
          "Mountain",
          "Mountain",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Obsidian Fireheart",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Forest": {
          "blaze": 1
        }
      }
    }
  },
  {
    "name": "blazing land deals 1 damage to its controller at their upkeep",
    "players": [
      {
        "battlefield": [
          "Obsidian Fireheart",
          "Mountain",
          "Mountain",
          "Mountain",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Obsidian Fireheart",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 19
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "land with a blaze counter does not burn on the opponent's upkeep",
    "players": [
      {
        "battlefield": [
          "Obsidian Fireheart",
          "Mountain",
          "Mountain",
          "Mountain",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Obsidian Fireheart",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: a burning land hurts its controller at their upkeep, not the Fireheart's controller",
    "players": [
      { "battlefield": ["Obsidian Fireheart", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "activate": "Obsidian Fireheart", "targets": ["Forest"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 20 }, { "life": 19 }]
    }
  },
  {
    "name": "ruling: a blazing land keeps burning after Obsidian Fireheart leaves",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Obsidian Fireheart", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Obsidian Fireheart", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Obsidian Fireheart"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Obsidian Fireheart"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 19, "graveyard_has": ["Obsidian Fireheart"] }, { "life": 20 }]
    }
  },
  {
    "name": "ruling: a land that already has a blaze counter is an illegal target; a response fizzles",
    "players": [
      { "battlefield": ["Obsidian Fireheart", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Obsidian Fireheart", "targets": ["Forest"] },
      { "activate": "Obsidian Fireheart", "targets": ["Forest"] },
      { "resolve": true },
      { "resolve": true },
      { "illegal": true, "activate": "Obsidian Fireheart", "targets": ["Forest"] }
    ],
    "expect": {
      "counters": { "Forest": { "blaze": 1 } }
    }
  }
]
