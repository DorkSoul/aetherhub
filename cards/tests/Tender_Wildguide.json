[
 { "name": "tap: put a +1/+1 counter on this creature",
   "players": [ { "battlefield": ["Tender Wildguide"] }, {} ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "activate": "Tender Wildguide", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Tender Wildguide": [3, 3] } } },
 { "name": "a tapped creature cannot use the counter ability again this turn",
   "players": [ { "battlefield": ["Tender Wildguide"] }, {} ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "activate": "Tender Wildguide", "ability": 0 }, { "resolve": true },
              { "activate": "Tender Wildguide", "ability": 0, "illegal": true } ],
   "expect": { "pt": { "Tender Wildguide": [3, 3] } } },
 { "name": "unkicked: no offspring token, enters as a 2/2",
   "players": [ { "hand": ["Tender Wildguide"], "battlefield": ["Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Tender Wildguide" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Tender Wildguide"] }, {} ], "pt": { "Tender Wildguide": [2, 2] } } },
 { "name": "offspring {2} paid: creates a 1/1 token copy",
   "players": [ { "hand": ["Tender Wildguide"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Tender Wildguide", "answers": [true] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Tender Wildguide"] }, {} ] } },
 { "name": "ruling: the offspring token is not cast, so Beast Whisperer draws only for the creature spell",
   "players": [ { "hand": ["Tender Wildguide"], "battlefield": ["Beast Whisperer", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Tender Wildguide", "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Beast Whisperer", "Tender Wildguide", "Tender Wildguide"] }, {} ] } },
 { "name": "ruling: the offspring token is still made if the creature is killed in response to its trigger (token is 1/1)",
   "players": [ { "hand": ["Tender Wildguide", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain"] }, {} ],
   "steps": [ { "cast": "Tender Wildguide", "answers": [true] }, { "pass": true }, { "pass": true, "player": 1 },
              { "cast": "Lightning Bolt", "targets": ["Tender Wildguide"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Tender Wildguide"], "battlefield_has": ["Tender Wildguide"] }, {} ], "pt": { "Tender Wildguide": [1, 1] } } },
 { "name": "ruling: a countered offspring spell makes no token",
   "players": [ { "hand": ["Tender Wildguide"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Tender Wildguide", "answers": [true] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Tender Wildguide" } ] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Tender Wildguide"], "battlefield_lacks": ["Tender Wildguide"] }, { "graveyard": ["Counterspell"] } ] } }
]
