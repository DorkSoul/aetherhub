[
  {
    "name": "entering makes it day without a counter",
    "players": [
      { "hand": ["Vadrik, Astral Archmage"], "battlefield": ["Island", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Vadrik, Astral Archmage" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vadrik, Astral Archmage"] }, {} ],
      "counters": { "Vadrik, Astral Archmage": { "p1p1": 0 } }
    }
  },
  {
    "name": "day becoming night puts a +1/+1 counter on Vadrik",
    "players": [
      { "hand": ["Vadrik, Astral Archmage"], "battlefield": ["Island", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Vadrik, Astral Archmage" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vadrik, Astral Archmage"] }, {} ],
      "counters": { "Vadrik, Astral Archmage": { "p1p1": 1 } }
    }
  },
  {
    "name": "instant or sorcery costs {1} less with Vadrik's power of 1",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Vadrik, Astral Archmage", "Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Divination"] }, {} ]
    }
  },
  {
    "name": "without Vadrik the sorcery costs full price",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Divination", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Divination"] }, {} ]
    }
  },
  {
    "name": "ruling: night becomes day when the previous turn's active player cast two or more spells",
    "players": [
      { "hand": ["Vadrik, Astral Archmage", "Divination", "Divination"], "battlefield": ["Island", "Island", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Vadrik, Astral Archmage" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vadrik, Astral Archmage"], "graveyard": ["Divination", "Divination"] }, {} ],
      "counters": { "Vadrik, Astral Archmage": { "p1p1": 2 } }
    }
  },
  {
    "name": "ruling: day stays day when the previous turn's active player cast a spell",
    "players": [
      { "hand": ["Vadrik, Astral Archmage"], "battlefield": ["Island", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Vadrik, Astral Archmage" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vadrik, Astral Archmage"] }, {} ],
      "counters": { "Vadrik, Astral Archmage": { "p1p1": 0 } }
    }
  },
  {
    "name": "ruling: night stays night when the previous turn's active player cast only one spell",
    "players": [
      { "hand": ["Vadrik, Astral Archmage", "Divination"], "battlefield": ["Island", "Island", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Vadrik, Astral Archmage" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Divination" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vadrik, Astral Archmage"], "graveyard": ["Divination"] }, {} ],
      "counters": { "Vadrik, Astral Archmage": { "p1p1": 1 } }
    }
  }
]
