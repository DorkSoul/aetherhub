[
  {
    "name": "gift promised: opponent draws first, then two artifacts are destroyed",
    "players": [
      { "hand": ["Wear Down"], "battlefield": ["Forest", "Forest"] },
      { "battlefield": ["Treasure", "Treasure"] }
    ],
    "steps": [
      { "cast": "Wear Down", "answers": [true], "targets": ["Treasure", "Treasure"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Wear Down"] },
        { "hand_count": 1, "battlefield_lacks": ["Treasure"] }
      ]
    }
  },
  {
    "name": "no gift: one target only, the opponent does not draw",
    "players": [
      { "hand": ["Wear Down"], "battlefield": ["Forest", "Forest"] },
      { "battlefield": ["Treasure", "Treasure"] }
    ],
    "steps": [
      { "cast": "Wear Down", "answers": [false], "targets": ["Treasure"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Wear Down"] },
        { "hand_count": 0, "battlefield_has": ["Treasure"] }
      ]
    }
  },
  {
    "name": "ruling: a countered gift spell gives no gift: the opponent draws nothing",
    "players": [
      { "hand": ["Wear Down"], "battlefield": ["Forest", "Forest"] },
      { "hand": ["Counterspell"], "battlefield": ["Treasure", "Treasure", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Wear Down", "answers": [true], "targets": ["Treasure", "Treasure"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Wear Down" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Wear Down"] },
        { "hand_count": 0, "battlefield_has": ["Treasure", "Treasure"], "graveyard_has": ["Counterspell"] }
      ]
    }
  }
]
