    ],
    "expect": {
      "players": [
        {
          "hand": ["Trial of Zeal"],
          "battlefield_has": ["Cartouche of Zeal"],
          "battlefield_lacks": ["Trial of Zeal"]
        },
        {}
      ]
    }
  },
  {
    "name": "a non-Cartouche enchantment entering leaves this enchantment on the battlefield",
    "players": [
      {
