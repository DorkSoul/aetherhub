[
  {
    "name": "ETB creates a 0/1 Wizard token",
    "players": [
      { "hand": ["Mysidian Elder"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Mysidian Elder" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mysidian Elder", "Wizard 0-1"] }, {} ],
      "pt": { "Wizard 0-1": [0, 1] }
    }
  },
  {
    "name": "the token pings each opponent when you cast a noncreature spell",
    "players": [
      { "hand": ["Mysidian Elder", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Mysidian Elder" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: the Wizard token's ping resolves first, even when the Bolt is countered",
    "players": [
      { "hand": ["Mysidian Elder", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Mysidian Elder" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 19, "graveyard": ["Counterspell"] }
      ]
    }
  }
]
