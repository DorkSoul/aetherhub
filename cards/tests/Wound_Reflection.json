[
  {"name": "each opponent loses life equal to the life it lost this turn at each end step",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Wound Reflection", "Mountain"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"advance_to": "End"}, {"resolve": true}],
   "expect": {"players": [{"life": 20}, {"life": 14}]}},
  {"name": "does nothing when no opponent lost life this turn",
   "players": [{"battlefield": ["Wound Reflection"]}, {}],
   "steps": [{"advance_to": "End"}, {"resolve": true}],
   "expect": {"players": [{"life": 20}, {"life": 20}]}},
  {"name": "ruling: life lost after the end step trigger resolved is not counted by it",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Wound Reflection", "Mountain"]}, {}],
   "steps": [{"advance_to": "End"}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"life": 20}, {"life": 17}]}},
  {"name": "ruling: life lost earlier in the turn, before Wound Reflection entered, still counts",
   "players": [{"hand": ["Lightning Bolt", "Wound Reflection"], "battlefield": ["Mountain", "Swamp", "Island", "Island", "Island", "Island", "Island"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Wound Reflection"}, {"resolve": true}, {"advance_to": "End"}, {"resolve": true}],
   "expect": {"players": [{}, {"life": 14}]}},
  {"name": "ruling: two Wound Reflections each trigger separately (3, then 6 more)",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Wound Reflection", "Wound Reflection", "Mountain"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"advance_to": "End"}, {"resolve": true}],
   "expect": {"players": [{}, {"life": 8}]}},
  {"name": "ruling: life gained does not change what is counted (lost 6, gained 3: opponent loses 6)",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Wound Reflection", "Mountain"]}, {"hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"]}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"pass": true}, {"cast": "Lightning Helix", "player": 1, "targets": ["p1"]}, {"resolve": true}, {"advance_to": "End"}, {"resolve": true}],
   "expect": {"players": [{}, {"life": 11}]}}
]
