[
  { "name": "Goblin Piker 2/1 switches to 1/2 and you draw a card",
    "players": [ { "hand": ["Inside Out"], "battlefield": ["Island", "Island", "Goblin Piker"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Inside Out", "targets": ["Goblin Piker"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ], "pt": { "Goblin Piker": [1, 2] } } },
  { "name": "the switch lasts only until end of turn",
    "players": [ { "hand": ["Inside Out"], "battlefield": ["Island", "Island", "Goblin Piker"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Inside Out", "targets": ["Goblin Piker"] }, { "resolve": true }, { "advance_to": "Cleanup", "auto": true } ],
    "expect": { "pt": { "Goblin Piker": [2, 1] } } },
  { "name": "with no creature on the battlefield it cannot be cast",
    "players": [ { "hand": ["Inside Out"], "battlefield": ["Island", "Island", "Plains"] }, {} ],
    "steps": [ { "cast": "Inside Out", "illegal": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "ruling: switching twice returns the creature to its original power and toughness",
    "players": [ { "hand": ["Inside Out", "Inside Out"], "battlefield": ["Island", "Island", "Island", "Island", "Goblin Piker"], "library": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Inside Out", "targets": ["Goblin Piker"] }, { "resolve": true }, { "cast": "Inside Out", "targets": ["Goblin Piker"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ], "pt": { "Goblin Piker": [2, 1] } } },
  { "name": "ruling: damage already marked on a creature becomes lethal when its toughness drops",
    "players": [ { "hand": ["Inside Out"], "battlefield": [ { "name": "Herald of Anafenza", "sick": false }, "Island", "Island" ], "library": ["Island"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
               { "attack": [ { "card": "Herald of Anafenza", "at": "p1" } ] },
               { "block": [ { "blocker": "Llanowar Elves", "attacker": "Herald of Anafenza" } ], "player": 1 },
               { "advance_to": "Main2" },
               { "cast": "Inside Out", "targets": ["Herald of Anafenza"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Herald of Anafenza"], "battlefield_lacks": ["Herald of Anafenza"] }, {} ] } }
]
