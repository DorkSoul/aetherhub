[
 { "name": "sacrifice a creature: destroy a nonblack creature, its controller loses 2 life",
   "players": [ { "hand": ["Death Bomb"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
                { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Death Bomb", "targets": ["p1:Serra Angel"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard_has": ["Death Bomb", "Grizzly Bears"] }, { "life": 18, "graveyard_has": ["Serra Angel"] } ] } },
 { "name": "cannot cast without a creature to sacrifice",
   "players": [ { "hand": ["Death Bomb"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
                { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Death Bomb", "targets": ["p1:Serra Angel"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Death Bomb"] }, { "battlefield_has": ["Serra Angel"] } ] } },
 { "name": "ruling: exactly one creature is sacrificed as the additional cost",
   "players": [ { "hand": ["Death Bomb"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears", "Llanowar Elves"] },
                { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Death Bomb", "targets": ["p1:Serra Angel"], "answers": ["Llanowar Elves"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Death Bomb", "Llanowar Elves"], "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Serra Angel"] } ] } },
 { "name": "ruling: the sacrifice is paid on casting, before the spell can be responded to",
   "players": [ { "hand": ["Death Bomb"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
                { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Death Bomb", "targets": ["p1:Serra Angel"] } ],
   "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "battlefield_has": ["Serra Angel"] } ] } }
]
