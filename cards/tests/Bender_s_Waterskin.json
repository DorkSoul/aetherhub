[
 {
  "name": "untaps during an opponent's untap step",
  "players": [
   { "battlefield": [ { "name": "Bender's Waterskin", "tapped": true } ] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "pass": true, "player": 1 },
   { "tap_for_mana": "Bender's Waterskin", "color": "G" }
  ],
  "expect": { "players": [ { "pool": {"G": 1} }, {} ] }
 },
 {
  "name": "taps for one mana of any color",
  "players": [
   { "battlefield": ["Bender's Waterskin"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Bender's Waterskin", "color": "R" }
  ],
  "expect": {
   "players": [
    { "pool": { "R": 1 } },
    {}
   ]
  }
 },
 {
  "name": "ruling: a 'doesn't untap' aura does not stop its untap in an opponent's untap step",
  "players": [ { "hand": ["Malfunction"], "battlefield": ["Bender's Waterskin", "Island", "Island", "Island", "Island"] }, {} ],
  "steps": [
    { "cast": "Malfunction", "targets": ["Bender's Waterskin"] },
    { "resolve": true },
    { "advance_to": "Main2" },
    { "advance_to": "Main1" }
  ],
  "expect": { "tapped": { "Bender's Waterskin": false }, "turn": 2 }
 }
]
