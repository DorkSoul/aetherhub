[
  {
    "name": "counters a spell",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Voidslime"
        ],
        "battlefield": [
          "Forest",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "cast": "Voidslime",
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 20,
          "graveyard": [
            "Voidslime"
          ]
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "counters an activated ability",
    "players": [
      {
        "hand": [
          "Voidslime"
        ],
        "battlefield": [
          "Forest",
          "Island",
          "Island",
          "Steel Overseer"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Steel Overseer"
      },
      {
        "cast": "Voidslime",
        "targets": [
          {
            "stack": "Steel Overseer"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Voidslime"
          ]
        },
        {}
      ],
      "stack_empty": true
    }
  },
  {
    "name": "counters a triggered ability",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Voidslime"
        ],
        "battlefield": [
          "Mountain",
          "Forest",
          "Island",
          "Island",
          "Undead Augur"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Undead Augur"
        ]
      },
      {
        "pass": true
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "cast": "Voidslime",
        "targets": [
          {
            "stack": "Undead Augur"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20,
          "hand_count": 0,
          "graveyard": [
            "Lightning Bolt",
            "Voidslime",
            "Undead Augur"
          ]
        },
        {}
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: countering an equip activation leaves the equipment unattached",
    "players": [
      {
        "battlefield": ["Bonesplitter", "Grizzly Bears", "Plains"]
      },
      {
        "hand": ["Voidslime"],
        "battlefield": ["Forest", "Island", "Island"]
      }
    ],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
      { "cast": "Voidslime", "player": 1, "targets": [{ "stack": "Bonesplitter" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bonesplitter", "Grizzly Bears"] },
        { "graveyard": ["Voidslime"] }
      ],
      "pt": { "Grizzly Bears": [2, 2] },
      "stack_empty": true
    }
  }
]