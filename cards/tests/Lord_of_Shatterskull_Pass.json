[
  {
    "name": "level up once: level 1 is 6/6",
    "players": [
      {
        "battlefield": [
          "Lord of Shatterskull Pass",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lord of Shatterskull Pass"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Lord of Shatterskull Pass": {
          "level": 1
        }
      },
      "pt": {
        "Lord of Shatterskull Pass": [
          6,
          6
        ]
      }
    }
  },
  {
    "name": "no level counters: 3/3",
    "players": [
      {
        "battlefield": [
          "Lord of Shatterskull Pass"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Lord of Shatterskull Pass": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "at level 6 it deals 6 to each creature the defending player controls when it attacks",
    "players": [
      {
        "battlefield": [
          {
            "name": "Lord of Shatterskull Pass",
            "counters": {
              "level": 6
            }
          }
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Typhoid Rats"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Lord of Shatterskull Pass",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 14,
          "graveyard_has": [
            "Grizzly Bears",
            "Typhoid Rats"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: at level 5 the leveler is 6/6 but its attack trigger does nothing",
    "players": [ { "battlefield": [ { "name": "Lord of Shatterskull Pass", "counters": { "level": 5 } } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Lord of Shatterskull Pass", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 14, "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Lord of Shatterskull Pass": [6, 6] } }
  },
  {
    "name": "ruling: the level 6 attack trigger resolves before blockers, so Grizzly Bears is already dead",
    "players": [ { "battlefield": [ { "name": "Lord of Shatterskull Pass", "counters": { "level": 6 } } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Lord of Shatterskull Pass", "at": "p1" } ] }, { "resolve": true }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Lord of Shatterskull Pass" } ], "illegal": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 14, "graveyard_has": ["Grizzly Bears"] } ] }
  }
]
