[
  {
    "name": "heroic: a spell that targets it taps an opposing creature",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Wavecrash Triton",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Wavecrash Triton"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Wavecrash Triton"
          ]
        },
        {}
      ],
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "the tapped creature stays tapped through its controller's next untap step",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Wavecrash Triton",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Wavecrash Triton"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      }
    ],
    "expect": {
      "turn": 2,
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "a spell that does not target it does not trigger",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Forest",
          "Wavecrash Triton",
          "Serra Angel"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "ruling: a tapped creature can be targeted and still does not untap",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Wavecrash Triton",
          "Forest"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Grizzly Bears",
            "tapped": true
          }
        ]
      }
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Wavecrash Triton"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      }
    ],
    "expect": {
