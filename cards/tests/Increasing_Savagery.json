[
  {
    "name": "ruling: a card in the graveyard without being cast can still be cast with flashback",
    "players": [
      { "graveyard": ["Increasing Savagery"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Increasing Savagery", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Increasing Savagery"], "graveyard": [] },
        {}
      ],
      "pt": { "Grizzly Bears": [12, 12] }
    }
  },
  {
    "name": "ruling: cast from hand (no flashback) puts five counters and the card goes to the graveyard",
    "players": [
      { "hand": ["Increasing Savagery"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Increasing Savagery", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Increasing Savagery"], "exile": [] },
        {}
      ],
      "pt": { "Grizzly Bears": [7, 7] }
    }
  },
  {
    "name": "ruling: a flashback spell that is countered is exiled instead of going to the graveyard",
    "players": [
      { "graveyard": ["Increasing Savagery"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Increasing Savagery", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Increasing Savagery" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Increasing Savagery"], "graveyard": [] },
        { "graveyard": ["Counterspell"] }
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: flashback is a sorcery, so it cannot be cast on the opponent's turn",
    "players": [
      { "graveyard": ["Increasing Savagery"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Increasing Savagery", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Increasing Savagery"] },
        {}
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]
