[
  {
    "name": "pays W/P with white mana to transform at sorcery speed",
    "players": [
      { "battlefield": ["Order of the Mirror", "Plains", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Order of the Mirror" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Order of the Alabaster Host": [3, 3] },
      "players": [{ "battlefield_has": ["Order of the Alabaster Host"] }, {}]
    }
  },
  {
    "name": "pays 2 life for the phyrexian part when no white mana is available",
    "players": [
      { "battlefield": ["Order of the Mirror", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Order of the Mirror" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Order of the Alabaster Host": [3, 3] },
      "players": [{ "life": 18, "battlefield_has": ["Order of the Alabaster Host"] }, {}]
    }
  },
  {
    "name": "cannot transform with only two lands (the generic {3} is not payable)",
    "players": [
      { "battlefield": ["Order of the Mirror", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Order of the Mirror", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Order of the Mirror"] }, {}]
    }
  },
  {
    "name": "blocking creature gets -1/-1 when it blocks the transformed creature",
    "players": [
      { "battlefield": ["Order of the Mirror", "Plains", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Order of the Mirror" },
      { "resolve": true },
      { "attack": [{ "card": "Order of the Alabaster Host", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Order of the Alabaster Host" }] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [1, 1], "Order of the Alabaster Host": [3, 3] },
      "players": [{ "battlefield_has": ["Order of the Alabaster Host"] }, { "battlefield_has": ["Grizzly Bears"] }]
    }
  }
]
