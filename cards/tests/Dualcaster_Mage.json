[
  {
    "name": "copy Lightning Bolt (your own) at the opponent",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Dualcaster Mage"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "cast": "Dualcaster Mage"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Dualcaster Mage"
          ],
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 14
        }
      ]
    }
  },
  {
