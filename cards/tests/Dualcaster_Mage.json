          "Grizzly Bears"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "cast": "Dualcaster Mage"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears",
            "Dualcaster Mage"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a spell with no targets can be copied (Divination is copied and both draw two)",
    "players": [
      {
        "hand": ["Divination", "Dualcaster Mage"],
        "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "cast": "Dualcaster Mage" },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 4,
          "battlefield_has": ["Dualcaster Mage"],
          "graveyard": ["Divination"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a copy of an opponent's spell affects its controller, not the original's (Opt copy scry and draw for you)",
    "players": [
      {
        "hand": ["Dualcaster Mage"],
        "battlefield": ["Mountain", "Mountain", "Mountain"],
        "library": ["Mountain", "Forest"]
      },
      {
        "hand": ["Opt"],
        "battlefield": ["Island"],
        "library": ["Island", "Swamp"]
      }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Opt", "player": 1 },
      { "cast": "Dualcaster Mage" },
      { "resolve": true, "auto": true, "answers": [[], []] }
    ],
    "expect": {
      "players": [
        { "hand": ["Mountain"], "battlefield_has": ["Dualcaster Mage"] },
        { "hand": ["Island"], "graveyard": ["Opt"] }
      ]
    }
  },
  {
    "name": "ruling: a copy of an X spell has the same X (Fireball X=2 copied deals 2 more)",
    "players": [
      {
        "hand": ["Fireball", "Dualcaster Mage"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Fireball", "targets": ["p1"], "answers": [2] },
      { "cast": "Dualcaster Mage" },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dualcaster Mage"] },
        { "life": 16 }
      ]
    }
  }
]
