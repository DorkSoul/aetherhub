[
  {
    "name": "deals 3 damage to a creature and you gain 3 life",
    "players": [
      { "hand": ["Smiting Helix"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Smiting Helix", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "graveyard": ["Smiting Helix"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "flashback from the graveyard is exiled afterwards",
    "players": [
      { "graveyard": ["Smiting Helix"], "battlefield": ["Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Smiting Helix", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "exile": ["Smiting Helix"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: fizzles with no lifegain when its target is gone on resolution",
    "players": [
      { "hand": ["Smiting Helix", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Smiting Helix", "targets": ["p1:Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Smiting Helix", "Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: flashback Helix is black, so it can target a protection-from-red creature",
    "players": [
      { "graveyard": ["Smiting Helix"], "battlefield": ["Mountain", "Plains"] },
      { "battlefield": ["Silver Knight"] }
    ],
    "steps": [
      { "cast": "Smiting Helix", "alt": 0, "targets": ["p1:Silver Knight"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 23, "exile": ["Smiting Helix"] }, { "graveyard_has": ["Silver Knight"] } ] }
  },
  {
    "name": "ruling: flashback of a sorcery is not allowed on the opponent's turn",
    "players": [
      { "graveyard": ["Smiting Helix"], "battlefield": ["Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Smiting Helix", "alt": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Smiting Helix"] }, { "life": 20 } ] }
  },
  {
    "name": "ruling: a countered flashback spell is still exiled",
    "players": [
      { "graveyard": ["Smiting Helix"], "battlefield": ["Mountain", "Plains"] },
      { "battlefield": ["Island", "Island"], "hand": ["Counterspell"] }
    ],
    "steps": [
      { "cast": "Smiting Helix", "alt": 0, "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true }
    ],
    "expect": { "players": [ { "life": 20, "exile": ["Smiting Helix"] }, { "life": 20 } ] }
  }
]
