[
  {
    "name": "can block a creature with flying",
    "players": [
      { "battlefield": ["Vaporkin"] },
      { "battlefield": ["Belbe's Percher"] }
    ],
    "steps": [
      { "attack": [{ "card": "Vaporkin", "at": "p1" }] },
      { "block": [{ "blocker": "Belbe's Percher", "attacker": "Vaporkin" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Vaporkin"] },
        { "graveyard_has": ["Belbe's Percher"] }
      ]
    }
  },
  {
    "name": "has flying",
    "players": [
      { "battlefield": [] },
      { "battlefield": ["Belbe's Percher"] }
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Belbe's Percher"] }],
      "keywords": { "Belbe's Percher": ["Flying"] }
    }
  },
  {
    "name": "cannot block a non-flyer: the non-flyer's damage goes through",
    "players": [
      { "battlefield": [ {"name": "Grizzly Bears", "sick": false}, {"name": "Hill Giant", "sick": false} ] },
      { "battlefield": [ "Belbe's Percher", "Craw Wurm" ] }
    ],
    "steps": [
      { "attack": [ {"card": "Grizzly Bears", "at": "p1"}, {"card": "Hill Giant", "at": "p1"} ] },
      { "block": [ {"blocker": "Belbe's Percher", "attacker": "Grizzly Bears"}, {"blocker": "Craw Wurm", "attacker": "Hill Giant"} ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, {"life": 18} ] }
  }
]
