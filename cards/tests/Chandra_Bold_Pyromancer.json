[
  {
    "name": "+1 adds RR and deals 2 damage to target player",
    "players": [
      { "battlefield": ["Chandra, Bold Pyromancer"] },
      {}
    ],
    "steps": [
      { "activate": "Chandra, Bold Pyromancer", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "pool": { "R": 2 } }, { "life": 18 }],
      "counters": { "Chandra, Bold Pyromancer": { "loyalty": 6 } }
    }
  },
  {
    "name": "-3 deals 3 damage to a creature",
    "players": [
      { "battlefield": ["Chandra, Bold Pyromancer"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Chandra, Bold Pyromancer", "ability": 1, "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Hill Giant"] }],
      "counters": { "Chandra, Bold Pyromancer": { "loyalty": 2 } }
    }
  },
  {
    "name": "-7 deals 10 to target player and each creature and planeswalker they control",
    "players": [ { "battlefield": [ { "name": "Chandra, Bold Pyromancer", "counters": { "loyalty": 7 } }, "Grizzly Bears" ] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Chandra, Bold Pyromancer", "ability": 2, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Chandra, Bold Pyromancer"] }, { "life": 10, "battlefield_lacks": ["Hill Giant", "Grizzly Bears"] } ] }
  },
  {
    "name": "-7 is illegal at six loyalty",
    "players": [ { "battlefield": [ { "name": "Chandra, Bold Pyromancer", "counters": { "loyalty": 6 } } ] }, {} ],
    "steps": [ { "activate": "Chandra, Bold Pyromancer", "ability": 2, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ], "counters": { "Chandra, Bold Pyromancer": { "loyalty": 6 } } }
  },
  {
    "name": "ruling: -7 targets only the player, so a hexproof creature they control is still dealt 10",
    "players": [ { "battlefield": [ { "name": "Chandra, Bold Pyromancer", "counters": { "loyalty": 7 } } ] }, { "battlefield": ["Slippery Bogle"] } ],
    "steps": [ { "activate": "Chandra, Bold Pyromancer", "ability": 2, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 10, "battlefield_lacks": ["Slippery Bogle"], "graveyard_has": ["Slippery Bogle"] } ] }
  }
]
