[
  {
    "name": "player with six or more lands sacrifices down to five; player with four or fewer searches for up to five minus lands",
    "players": [
      { "hand": ["Natural Balance"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Forest", "Forest"], "library": ["Island", "Mountain", "Plains", "Swamp", "Forest"] }
    ],
    "steps": [
      { "cast": "Natural Balance" },
      { "resolve": true, "answers": [[0, 1], [24, 23, 22]] }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard_has": ["Forest"] },
        { "battlefield": ["Forest", "Forest", "Island", "Mountain", "Plains"] }
      ]
    }
  },
  {
    "name": "exactly five lands: nobody sacrifices or searches",
    "players": [
      { "hand": ["Natural Balance"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Island", "Mountain"] }
    ],
    "steps": [
      { "cast": "Natural Balance" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "hand_count": 0 },
        { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library_count": 2 }
      ]
    }
  },
  {
    "name": "ruling: a player may find fewer basic lands than allowed (2 lands, up to 3 found, finds 2)",
    "players": [
      { "hand": ["Natural Balance"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Forest", "Forest"], "library": ["Island", "Mountain", "Plains", "Swamp", "Forest"] }
    ],
    "steps": [
      { "cast": "Natural Balance" },
      { "resolve": true, "answers": [[0, 1], ["Island", "Mountain"]] }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
        { "battlefield": ["Forest", "Forest", "Island", "Mountain"] }
      ]
    }
  },
  {
    "name": "ruling: a player may choose to find no basic lands at all",
    "players": [
      { "hand": ["Natural Balance"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Forest", "Forest"], "library": ["Island", "Mountain", "Plains", "Swamp", "Forest"] }
    ],
    "steps": [
      { "cast": "Natural Balance" },
      { "resolve": true, "answers": [[0, 1], []] }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
        { "battlefield": ["Forest", "Forest"] }
      ]
    }
  }
]
