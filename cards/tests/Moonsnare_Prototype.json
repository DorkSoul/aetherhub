[
  {
    "name": "channel from hand: the owner of the Bears puts them on top of their library",
    "players": [
      { "hand": ["Moonsnare Prototype"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Moonsnare Prototype", "ability": 0 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Moonsnare Prototype"] },
        { "library_count": 2, "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "channel: owner chooses bottom and the Bears leave the battlefield",
    "players": [
      { "hand": ["Moonsnare Prototype"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Moonsnare Prototype", "ability": 0 },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Moonsnare Prototype"] },
        { "library_count": 2, "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "channel is not an ability on the battlefield: nothing happens",
    "players": [
      { "battlefield": ["Moonsnare Prototype", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Moonsnare Prototype", "ability": 0, "targets": ["Hill Giant"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Moonsnare Prototype", "Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: the owner who puts the Bears on top leaves them as the top card",
    "players": [
      { "hand": ["Moonsnare Prototype"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Moonsnare Prototype", "ability": 0 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Moonsnare Prototype"] },
        { "battlefield_lacks": ["Grizzly Bears"], "library_top": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the owner who puts the Bears on the bottom leaves the Mountain on top",
    "players": [
      { "hand": ["Moonsnare Prototype"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Moonsnare Prototype", "ability": 0 },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Moonsnare Prototype"] },
        { "battlefield_lacks": ["Grizzly Bears"], "library_top": ["Mountain"] }
      ]
    }
  },
  {
    "name": "ruling: channel needs a target, so with no nonland permanent it cannot be activated",
    "players": [
      { "hand": ["Moonsnare Prototype"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Moonsnare Prototype", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Moonsnare Prototype"] },
        {}
      ]
    }
  }
]
