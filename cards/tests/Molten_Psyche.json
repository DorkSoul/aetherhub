[
 {
  "name": "each player shuffles hand into library and draws that many; no metalcraft means no damage",
  "players": [
   { "hand": ["Molten Psyche", "Grizzly Bears", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "hand": ["Forest", "Island"] }
  ],
  "steps": [ { "cast": "Molten Psyche" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 2, "life": 20 }, { "hand_count": 2, "life": 20 } ] }
 },
 {
  "name": "metalcraft: damage to each opponent equals the cards that opponent drew this turn",
  "players": [
   { "hand": ["Molten Psyche", "Grizzly Bears", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Bonesplitter", "Bonesplitter", "Bonesplitter"] },
   { "hand": ["Forest", "Island"] }
  ],
  "steps": [ { "cast": "Molten Psyche" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 2, "life": 20 }, { "hand_count": 2, "life": 18 } ] }
 },
 {
  "name": "metalcraft boundary: two artifacts is not enough, no damage",
  "players": [
   { "hand": ["Molten Psyche", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Bonesplitter", "Bonesplitter"] },
   { "hand": ["Forest", "Island", "Plains"] }
  ],
  "steps": [ { "cast": "Molten Psyche" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 1, "life": 20 }, { "hand_count": 3, "life": 20 } ] }
 },
 {
  "name": "ruling: metalcraft counts every card the opponent drew this turn, not only Psyche's draws",
  "players": [
   { "hand": ["Molten Psyche", "Sign in Blood"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp", "Sol Ring", "Bonesplitter", "Spear of Heliod"] },
   {}
  ],
  "steps": [ { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true }, { "cast": "Molten Psyche" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 0, "life": 20 }, { "hand_count": 2, "life": 14 } ] }
 }
]
