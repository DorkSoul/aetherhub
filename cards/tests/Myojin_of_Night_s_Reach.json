[
  {
    "name": "enters with a divinity counter when cast from hand",
    "players": [
      { "hand": ["Myojin of Night's Reach"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Night's Reach" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Night's Reach"] }, {} ],
      "counters": { "Myojin of Night's Reach": { "divinity": 1 } }
    }
  },
  {
    "name": "removing the counter makes each opponent discard their hand",
    "players": [
      { "battlefield": [ { "name": "Myojin of Night's Reach", "counters": { "divinity": 1 } } ] },
      { "hand": ["Lightning Bolt", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Myojin of Night's Reach", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "hand_count": 0, "graveyard_has": ["Lightning Bolt", "Grizzly Bears"] } ],
      "counters": { "Myojin of Night's Reach": { "divinity": 0 } }
    }
  },
  {
    "name": "indestructible while it has a counter: Murder does not destroy it",
    "players": [
      { "battlefield": [ { "name": "Myojin of Night's Reach", "counters": { "divinity": 1 } } ] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Night's Reach"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Night's Reach"] }, {} ],
      "counters": { "Myojin of Night's Reach": { "divinity": 1 } }
    }
  },
  {
    "name": "without a counter Murder destroys it",
    "players": [
      { "battlefield": ["Myojin of Night's Reach"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Night's Reach"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Myojin of Night's Reach"] }, {} ] }
  },
  {
    "name": "ruling: cast from the command zone does not count as cast from hand, so no divinity counter",
    "commander": true,
    "players": [
      { "command": ["Myojin of Night's Reach"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Night's Reach" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Night's Reach"] }, {} ],
      "counters": { "Myojin of Night's Reach": { "divinity": 0 } }
    }
  }
]
