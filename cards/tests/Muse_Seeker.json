[
  { "name": "casting a cheap instant draws a card then discards a card",
    "players": [ { "hand": ["Lightning Bolt", "Island"], "battlefield": ["Mountain", "Muse Seeker"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [["Forest"]] } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Lightning Bolt", "Forest"] }, {} ] } },
  { "name": "four mana spent on a sorcery: draw and discard (boundary below five)",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Muse Seeker"], "library": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Island", "Island", "Island"], "graveyard": ["Harmonize", "Island"] }, {} ] } },
  { "name": "five mana spent on a sorcery: draw only, no discard",
    "players": [ { "hand": ["Sunfall"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Muse Seeker"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Sunfall" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Sunfall"] }, {} ] } },
  { "name": "a creature spell does not trigger it",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Muse Seeker"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Hill Giant" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "battlefield_has": ["Hill Giant", "Muse Seeker"] }, {} ] } },
  { "name": "ruling: opus still resolves when the spell is countered (draw and discard happen)",
    "players": [ { "hand": ["Lightning Bolt", "Plains"], "battlefield": ["Mountain", "Muse Seeker"], "library": ["Island"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] }, { "resolve": true, "answers": [["Island"]] } ],
    "expect": { "players": [ { "hand": ["Plains"], "graveyard": ["Lightning Bolt", "Island"] }, { "graveyard": ["Counterspell"], "life": 20 } ], "stack_empty": true } }
]
