[
  {
    "name": "casting an instant or sorcery makes a Fractal with counters equal to its mana value",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Deekah, Fractal Theorist", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Fractal 0-0 Green Blue": [3, 3] } }
  },
  {
    "name": "a one-mana instant makes a 1/1 Fractal",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Deekah, Fractal Theorist", "Mountain"] },
      { }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Fractal 0-0 Green Blue": [1, 1] } }
  },
  {
    "name": "{3}{U}: target creature token can't be blocked this turn",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Deekah, Fractal Theorist", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Deekah, Fractal Theorist", "ability": 0, "targets": ["Fractal 0-0 Green Blue"] },
      { "resolve": true }
    ],
    "expect": { "keywords": { "Fractal 0-0 Green Blue": ["Unblockable"] } }
  },
  {
    "name": "ruling: a copy triggers magecraft too (Divination copied by Swarm Intelligence makes a second 3/3 Fractal)",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Deekah, Fractal Theorist", "Swarm Intelligence", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 4, "battlefield_has": ["Fractal 0-0 Green Blue", "Fractal 0-0 Green Blue"] }, {} ], "pt": { "Fractal 0-0 Green Blue": [3, 3] } }
  }
]
