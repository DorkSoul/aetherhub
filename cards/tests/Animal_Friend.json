[
  {
    "name": "attacking creates a 1/1 Squirrel; Animal Friend itself adds no counter",
    "players": [
      { "hand": ["Animal Friend"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Animal Friend", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Animal Friend", "Grizzly Bears", "Squirrel 1-1 Green"] },
        {}
      ],
      "pt": {
        "Squirrel 1-1 Green": [1, 1]
      }
    }
  },
  {
    "name": "one counter on the Squirrel for each other Aura attached to the creature",
    "players": [
      { "hand": ["Bear Umbra", "Animal Friend"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
