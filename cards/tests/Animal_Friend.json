    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Animal Friend", "Bear Umbra", "Squirrel 1-1 Green"] },
        {}
      ],
      "pt": {
        "Squirrel 1-1 Green": [2, 2]
      }
    }
  },
