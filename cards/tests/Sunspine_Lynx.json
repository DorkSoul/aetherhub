[
 {
  "name": "ETB: each player is dealt damage equal to the nonbasic lands they control",
  "players": [
   { "hand": ["Sunspine Lynx"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mutavault"] },
   { "battlefield": ["Mutavault", "Mutavault"] }
  ],
  "steps": [
   { "cast": "Sunspine Lynx" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "life": 19 }, { "life": 18 }]
  }
 },
 {
  "name": "no nonbasic lands: no damage",
  "players": [
   { "hand": ["Sunspine Lynx"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest"] },
   { "battlefield": ["Plains"] }
  ],
  "steps": [
   { "cast": "Sunspine Lynx" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "life": 20 }, { "life": 20 }]
  }
 },
 {
  "name": "players can't gain life",
  "players": [
   { "hand": ["Healing Salve"], "battlefield": ["Plains", "Sunspine Lynx"] },
   {}
  ],
  "steps": [
   { "cast": "Healing Salve", "targets": ["p0"], "answers": [0] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "life": 20 }, {}]
  }
 },
 {
  "name": "damage can't be prevented: Healing Salve prevention does nothing",
  "players": [
   { "hand": ["Healing Salve", "Lightning Bolt"], "battlefield": ["Plains", "Mountain", "Sunspine Lynx"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Healing Salve", "targets": ["Grizzly Bears"], "answers": [1] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, { "graveyard": ["Grizzly Bears"] }]
  }
 },
 {
  "name": "ruling: protection from red does not prevent damage while Sunspine Lynx is out (Silver Knight dies blocking it)",
  "players": [
   { "battlefield": [ { "name": "Sunspine Lynx", "sick": false } ] },
   { "battlefield": ["Silver Knight"] }
  ],
  "steps": [
   { "attack": [ { "card": "Sunspine Lynx", "at": "p1" } ] },
   { "block": [ { "blocker": "Silver Knight", "attacker": "Sunspine Lynx" } ], "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "battlefield_has": ["Sunspine Lynx"] }, { "graveyard": ["Silver Knight"] } ] }
 },
 {
  "name": "ruling: a life-gain spell still deals its damage, but no player gains life",
  "players": [
   { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"] },
   { "battlefield": ["Sunspine Lynx"] }
  ],
  "steps": [
   { "cast": "Lightning Helix", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "life": 20 }, { "life": 17 } ] }
 },
 {
  "name": "ruling: a life total set higher than the current one does not change it (Biorhythm: 3 creatures, life stays 1)",
  "players": [
   { "hand": ["Biorhythm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", { "name": "Sunspine Lynx", "sick": false }, "Grizzly Bears"] },
   { "life": 1, "battlefield": ["Grizzly Bears", "Hill Giant", "Serra Angel"] }
  ],
  "steps": [
   { "cast": "Biorhythm" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "life": 2 }, { "life": 1 } ] }
 }
]
