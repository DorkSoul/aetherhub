[
  {
    "name": "creates a token per nontoken Villain, itself included",
    "players": [ { "hand": ["Mysterio, Master of Illusion"], "battlefield": ["Island", "Island", "Island", "Island", "A.I.M. Bot"] }, {} ],
    "steps": [ { "cast": "Mysterio, Master of Illusion" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mysterio, Master of Illusion", "A.I.M. Bot", "Illusion Villain", "Illusion Villain"] }, {} ] }
  },
  {
    "name": "tokens do not count and an opponent's Villains do not count",
    "players": [ { "hand": ["Mysterio, Master of Illusion"], "battlefield": ["Island", "Island", "Island", "Island", "Illusion Villain"] }, { "battlefield": ["A.I.M. Bot"] } ],
    "steps": [ { "cast": "Mysterio, Master of Illusion" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mysterio, Master of Illusion", "Illusion Villain", "Illusion Villain"] }, {} ] }
  },
  {
    "name": "tokens are exiled when Mysterio leaves the battlefield",
    "players": [ { "hand": ["Mysterio, Master of Illusion", "Unsummon"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "A.I.M. Bot"] }, {} ],
    "steps": [
      { "cast": "Mysterio, Master of Illusion" }, { "resolve": true },
      { "cast": "Unsummon", "targets": ["Mysterio, Master of Illusion"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["A.I.M. Bot"], "battlefield_lacks": ["Illusion Villain", "Mysterio, Master of Illusion"] }, {} ] }
  },
  {
    "name": "ruling: Mysterio bounced before its ETB resolves: the tokens are still made (for the other Villains) and are never exiled",
    "players": [ { "hand": ["Mysterio, Master of Illusion", "Unsummon"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "A.I.M. Bot"] }, {} ],
    "steps": [
      { "cast": "Mysterio, Master of Illusion" }, { "pass": true }, { "pass": true, "player": 1 },
      { "cast": "Unsummon", "targets": ["Mysterio, Master of Illusion"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Mysterio, Master of Illusion"], "battlefield_has": ["A.I.M. Bot", "Illusion Villain"], "battlefield_lacks": ["Mysterio, Master of Illusion"] }, {} ] }
  }
]
