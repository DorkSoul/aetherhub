[
  { "name": "all creatures get +2/+2 while Thran Weaponry stays tapped",
    "players": [ { "battlefield": ["Thran Weaponry", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "activate": "Thran Weaponry" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4], "Llanowar Elves": [3, 3] }, "tapped": { "Thran Weaponry": true } } },
  { "name": "the bonus ends when Thran Weaponry untaps in its controller's untap step",
    "players": [ { "battlefield": ["Thran Weaponry", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "activate": "Thran Weaponry" }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "pt": { "Grizzly Bears": [2, 2], "Llanowar Elves": [1, 1] }, "tapped": { "Thran Weaponry": false } } },
  { "name": "choosing not to untap Thran Weaponry keeps the bonus",
    "players": [ { "battlefield": ["Thran Weaponry", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "activate": "Thran Weaponry" }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "pt": { "Grizzly Bears": [4, 4], "Llanowar Elves": [3, 3] }, "tapped": { "Thran Weaponry": true } } },
  { "name": "echo: paying {4} keeps Thran Weaponry",
    "players": [ { "hand": ["Thran Weaponry"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Thran Weaponry" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Thran Weaponry"] }, {} ] } },
  { "name": "echo: not paying sacrifices Thran Weaponry",
    "players": [ { "hand": ["Thran Weaponry"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Thran Weaponry" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Thran Weaponry"], "battlefield_lacks": ["Thran Weaponry"] }, {} ] } }
]
