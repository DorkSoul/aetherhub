[
  {
    "name": "enchanted Mountain becomes a 7/7 red Giant creature with haste",
    "players": [
      {
        "hand": [
          "Awaken the Ancient"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Awaken the Ancient",
        "targets": [
          "Mountain"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Awaken the Ancient"
          ]
        },
        {}
      ],
      "pt": {
        "Mountain": [
          7,
          7
        ]
      },
      "keywords": {
        "Mountain": [
          "Haste"
        ]
      }
    }
  },
  {
    "name": "cannot be cast without red mana",
    "players": [
      {
        "hand": [
          "Awaken the Ancient"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Awaken the Ancient",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Awaken the Ancient"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "enchanted Mountain is red",
    "players": [ { "hand": ["Awaken the Ancient"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Awaken the Ancient", "targets": ["Mountain"] }, { "resolve": true } ],
    "expect": { "colors": { "Mountain": ["R"] } }
  },
  {
    "name": "enchanted Mountain is a creature: Unsummon can bounce it (Aura falls off)",
    "players": [ { "hand": ["Awaken the Ancient", "Unsummon"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Island"] }, {} ],
    "steps": [ { "cast": "Awaken the Ancient", "targets": ["Mountain"] }, { "resolve": true }, { "cast": "Unsummon", "targets": ["Mountain"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Mountain"], "graveyard_has": ["Awaken the Ancient", "Unsummon"] }, {} ] }
  },
  {
    "name": "ruling: the enchanted Mountain is a creature when Glistening Deluge resolves: gets -1/-1 only",
    "players": [
      { "hand": ["Awaken the Ancient", "Glistening Deluge"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Awaken the Ancient", "targets": ["Mountain"] },
      { "resolve": true },
      { "cast": "Glistening Deluge" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Mountain": [6, 6] }
    }
  },
  {
    "name": "ruling: any land with the Mountain subtype can be enchanted (Snow-Covered Mountain)",
    "players": [
      { "hand": ["Awaken the Ancient"], "battlefield": ["Snow-Covered Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Awaken the Ancient", "targets": ["Snow-Covered Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Awaken the Ancient"] }, {} ],
      "pt": { "Snow-Covered Mountain": [7, 7] }
    }
  }
]
