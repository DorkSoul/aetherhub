[
  { "name": "attacking with a 4-power creature around puts a counter on each creature you control",
    "players": [ { "battlefield": [ { "name": "Wilderland Scrounger", "sick": false }, { "name": "Wild Leotau", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Wilderland Scrounger", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "pt": { "Wilderland Scrounger": [4, 7], "Wild Leotau": [6, 5], "Grizzly Bears": [3, 3] } } },
  { "name": "without a creature of power 4 or greater the trigger does not happen",
    "players": [ { "battlefield": [ { "name": "Wilderland Scrounger", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Wilderland Scrounger", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "pt": { "Wilderland Scrounger": [3, 6], "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: the trigger checks only on attack; the power-4 creature dying in response does not stop it",
    "players": [ { "battlefield": [ { "name": "Wilderland Scrounger", "sick": false }, { "name": "Wild Leotau", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }, { "battlefield": ["Swamp", "Swamp"], "hand": ["Go for the Throat"] } ],
    "steps": [ { "attack": [ { "card": "Wilderland Scrounger", "at": "p1" } ] }, { "pass": true }, { "cast": "Go for the Throat", "player": 1, "targets": ["Wild Leotau"] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Wild Leotau"] }, { "graveyard_has": ["Go for the Throat"] } ], "pt": { "Wilderland Scrounger": [4, 7], "Grizzly Bears": [3, 3] } } }
]
