        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Intrepid Paleontologist",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "cast": "Drowsing Tyrannodon"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
