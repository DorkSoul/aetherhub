        "battlefield": [
          "Intrepid Paleontologist"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Intrepid Paleontologist",
        "color": "U"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "U": 1
          }
        },
        {}
      ]
    }
  },
  {
    "name": "cannot cast a non-Dinosaur card exiled with it",
    "players": [
      {
        "battlefield": [
          "Intrepid Paleontologist",
          "Forest",
          "Forest",
          "Plains",
          "Plains"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Intrepid Paleontologist",
        "ability": 0
      },
