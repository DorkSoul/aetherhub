[
  {
    "name": "two blockers give -1/-1 (one beyond the first)",
    "players": [
      { "battlefield": ["Jungle Wurm"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Jungle Wurm", "at": "p1" } ] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Jungle Wurm" },
          { "blocker": "Hill Giant", "attacker": "Jungle Wurm" }
        ]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Jungle Wurm": [4, 4] }
    }
  },
  {
    "name": "three blockers give -2/-2",
    "players": [
      { "battlefield": ["Jungle Wurm"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant", "Hill Giant Herdgorger"] }
    ],
    "steps": [
      { "attack": [ { "card": "Jungle Wurm", "at": "p1" } ] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Jungle Wurm" },
          { "blocker": "Hill Giant", "attacker": "Jungle Wurm" },
          { "blocker": "Hill Giant Herdgorger", "attacker": "Jungle Wurm" }
        ]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Jungle Wurm": [3, 3] }
    }
  },
  {
    "name": "a single blocker gives no penalty",
    "players": [
      { "battlefield": ["Jungle Wurm"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Jungle Wurm", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Jungle Wurm" } ] },
      { "resolve": true }
