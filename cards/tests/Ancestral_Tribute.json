[
  {
    "name": "gain 2 life for each card in your graveyard",
    "players": [ { "hand": ["Ancestral Tribute"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Forest"] }, {} ],
    "steps": [ { "cast": "Ancestral Tribute" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 26, "graveyard_has": ["Ancestral Tribute"] }, {} ] }
  },
  {
    "name": "flashback for its flashback cost, then it is exiled",
    "players": [ { "graveyard": ["Ancestral Tribute", "Grizzly Bears"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Ancestral Tribute", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "exile": ["Ancestral Tribute"] }, {} ] }
  },
  {
    "name": "flashback needs twelve mana",
    "players": [ { "graveyard": ["Ancestral Tribute"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Ancestral Tribute", "alt": 0, "illegal": true } ],
    "expect": {}
  },
  {
    "name": "ruling: a flashback spell that is countered is still exiled",
    "players": [
      { "graveyard": ["Ancestral Tribute", "Grizzly Bears"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Ancestral Tribute", "alt": 0 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "exile": ["Ancestral Tribute"] }, { "graveyard_has": ["Counterspell"] } ] }
  },
  {
    "name": "ruling: a sorcery's flashback can't be cast during the opponent's turn",
    "players": [
      { "graveyard": ["Ancestral Tribute"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Ancestral Tribute", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Ancestral Tribute"], "life": 20 }, {} ] }
  }
]
