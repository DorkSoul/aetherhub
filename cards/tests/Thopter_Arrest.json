[
 { "name": "exiles target creature an opponent controls until it leaves",
   "players": [ { "hand": ["Thopter Arrest"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Thopter Arrest" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Thopter Arrest"] }, { "battlefield": [], "exile": ["Grizzly Bears"] } ] } },
 { "name": "creature returns when Thopter Arrest leaves",
   "players": [ { "hand": ["Thopter Arrest", "Disenchant"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Thopter Arrest" }, { "resolve": true }, { "resolve": true }, { "cast": "Disenchant", "targets": ["Thopter Arrest"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Thopter Arrest", "Disenchant"] }, { "battlefield_has": ["Grizzly Bears"], "exile": [] } ] } },
 { "name": "cannot target my own creature",
   "players": [ { "hand": ["Thopter Arrest"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Thopter Arrest" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Thopter Arrest"] }, { "battlefield": [], "exile": ["Hill Giant"] } ] } },
 { "name": "ruling: if Thopter Arrest leaves before its trigger resolves, the target is not exiled",
   "players": [ { "hand": ["Thopter Arrest", "Disenchant"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Thopter Arrest" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Disenchant", "targets": ["Thopter Arrest"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Thopter Arrest", "Disenchant"] }, { "battlefield_has": ["Grizzly Bears"], "exile": [] } ] } }
]
