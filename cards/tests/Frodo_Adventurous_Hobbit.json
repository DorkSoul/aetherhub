  {
    "name": "ETB: target player (yourself) searches for Sam and puts it into hand",
    "players": [ {"hand": ["Frodo, Adventurous Hobbit"], "battlefield": ["Plains", "Swamp"], "library": ["Sam, Loyal Attendant"]}, {} ],
    "steps": [ {"cast": "Frodo, Adventurous Hobbit"}, {"resolve": true, "targets": ["p0"], "answers": ["Sam, Loyal Attendant"]} ],
    "expect": {"players": [{"hand": ["Sam, Loyal Attendant"], "battlefield_has": ["Frodo, Adventurous Hobbit"]}, {}]}
  },
  {
    "name": "ETB: targeting the opponent searches their library for Sam",
    "players": [ {"hand": ["Frodo, Adventurous Hobbit"], "battlefield": ["Plains", "Swamp"]}, {"library": ["Sam, Loyal Attendant"]} ],
    "steps": [ {"cast": "Frodo, Adventurous Hobbit"}, {"resolve": true, "targets": ["p1"], "answers": ["Sam, Loyal Attendant"]} ],
    "expect": {"players": [{"hand": []}, {"hand": ["Sam, Loyal Attendant"]}]}
  },
  {
    "name": "ETB: nothing happens when Sam is not in the searched library",
    "players": [ {"hand": ["Frodo, Adventurous Hobbit"], "battlefield": ["Plains", "Swamp"]}, {} ],
    "steps": [ {"cast": "Frodo, Adventurous Hobbit"}, {"resolve": true, "targets": ["p0"]} ],
    "expect": {"players": [{"hand": [], "battlefield_has": ["Frodo, Adventurous Hobbit"]}, {}]}
  },
  {
    "name": "ruling: gaining 6 life still tempts the Ring only once",
    "players": [ { "hand": ["Lightning Helix", "Lightning Helix"], "battlefield": ["Frodo, Adventurous Hobbit", "Mountain", "Mountain", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true }, { "attack": [ { "card": "Frodo, Adventurous Hobbit", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "command": ["The Ring 1"], "life": 26 }, { "life": 13 } ] }
  },
  {
    "name": "ruling: a second tempt with Frodo as Ring-bearer draws a card",
    "players": [ { "hand": ["Lightning Helix", "Lightning Helix"], "battlefield": ["Frodo, Adventurous Hobbit", "Mountain", "Mountain", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true }, { "attack": [ { "card": "Frodo, Adventurous Hobbit", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true }, { "attack": [ { "card": "Frodo, Adventurous Hobbit", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] }
  },
  {
    "name": "ruling: losing more life than gained does not stop the tempt",
    "players": [ { "hand": ["Lightning Helix", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Frodo, Adventurous Hobbit", "Mountain", "Mountain", "Mountain", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Helix", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true }, { "attack": [ { "card": "Frodo, Adventurous Hobbit", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "command": ["The Ring 1"], "life": 17 }, { "life": 16 } ] }
  }
