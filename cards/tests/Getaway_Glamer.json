   "steps": [ { "cast": "Getaway Glamer", "answers": [[0]], "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "destroy mode: destroys the creature when no other creature has greater power",
   "players": [ { "hand": ["Getaway Glamer"], "battlefield": ["Plains", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Getaway Glamer", "answers": [[1]], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "destroy mode does nothing when another creature has greater power",
   "players": [ { "hand": ["Getaway Glamer"], "battlefield": ["Plains", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
   "steps": [ { "cast": "Getaway Glamer", "answers": [[1]], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ] } },
 { "name": "ruling: with no creature on any battlefield no mode has a legal target, so the spell cannot be cast",
   "players": [ { "hand": ["Getaway Glamer"], "battlefield": ["Plains", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Getaway Glamer", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Getaway Glamer"] }, {} ] } },
 { "name": "ruling: modes resolve in printed order, so the exile mode removes the bigger creature before the destroy mode checks power",
   "players": [ { "hand": ["Getaway Glamer"], "battlefield": ["Plains", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
   "steps": [ { "cast": "Getaway Glamer", "answers": [[0, 1]], "targets": ["Hill Giant", "Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Getaway Glamer"] }, { "graveyard": ["Grizzly Bears"], "exile": ["Hill Giant"] } ] } },
 { "name": "ruling: the destroy target bounced in response; the exile mode still happens",
   "players": [ { "hand": ["Getaway Glamer"], "battlefield": ["Plains", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Unsummon"], "battlefield": ["Island", "Grizzly Bears", "Hill Giant"] } ],
   "steps": [ { "cast": "Getaway Glamer", "answers": [[0, 1]], "targets": ["Hill Giant", "Grizzly Bears"] }, { "pass": true }, { "cast": "Unsummon", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Getaway Glamer"] }, { "hand": ["Grizzly Bears"], "graveyard": ["Unsummon"], "exile": ["Hill Giant"] } ] } }
