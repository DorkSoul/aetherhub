[
  {
    "name": "landfall: draws three cards if a land entered this turn",
    "players": [
      {
        "hand": [
          "Mysteries of the Deep",
          "Island"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Island"
      },
      {
        "cast": "Mysteries of the Deep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3,
          "graveyard_has": [
            "Mysteries of the Deep"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: with no land entering this turn, the normal two cards are drawn",
    "players": [
      { "hand": ["Mysteries of the Deep"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [ { "cast": "Mysteries of the Deep" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Mysteries of the Deep"] }, {} ] }
  }
]
