[
  {
    "name": "draws at end step after a second nonland permanent entered this turn",
    "players": [
      {
        "hand": [
          "Grizzly Bears",
          "Grizzly Bears"
        ],
        "battlefield": [
          "Lady of Laughter",
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      },
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "no draw when only Lady itself entered this turn",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Lady of Laughter",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "lands do not count toward celebration",
    "players": [
      {
        "hand": [
          "Forest"
        ],
        "battlefield": [
          "Lady of Laughter"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Forest"
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "ruling: a permanent that entered and then left still counts toward celebration",
    "players": [
      {
        "hand": ["Grizzly Bears", "Grizzly Bears", "Lightning Bolt"],
        "battlefield": ["Lady of Laughter", "Forest", "Forest", "Forest", "Forest", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard_has": ["Lightning Bolt", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: three nonland permanents entering still draw only one card",
    "players": [
      {
        "hand": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears"],
        "battlefield": ["Lady of Laughter", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 }
      ]
    }
  }
]