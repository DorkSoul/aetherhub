[
  { "name": "attacking while saddled exiles the top card of the library",
    "players": [ { "battlefield": ["Gila Courser", "Grizzly Bears"], "library": ["Plains", "Island"] }, {} ],
    "steps": [
      { "activate": "Gila Courser", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Gila Courser", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "exile": ["Plains"] }, {} ], "tapped": { "Grizzly Bears": true } } },
  { "name": "the exiled card can be played this turn",
    "players": [ { "battlefield": ["Gila Courser", "Grizzly Bears"], "library": ["Plains", "Island"] }, {} ],
    "steps": [
      { "activate": "Gila Courser", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Gila Courser", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "play_land": "Plains" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Plains"], "exile": [] }, {} ] } },
  { "name": "saddle needs other creatures with total power 1: alone it cannot be activated",
    "players": [ { "battlefield": ["Gila Courser"], "library": ["Plains"] }, {} ],
    "steps": [ { "activate": "Gila Courser", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": [] }, {} ] } },
  { "name": "attacking without being saddled exiles nothing",
    "players": [ { "battlefield": ["Gila Courser"], "library": ["Plains"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Gila Courser", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "exile": [], "library_count": 1 }, {} ] } },
{ "name": "ruling: a Mount can be saddled again while already saddled",
  "players": [ { "battlefield": ["Gila Courser", "Grizzly Bears", "Grizzly Bears"], "library": ["Plains", "Island"] }, {} ],
  "steps": [ { "activate": "Gila Courser", "ability": 0 }, { "resolve": true }, { "activate": "Gila Courser", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Gila Courser", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
  "expect": { "players": [ { "exile": ["Plains"] }, {} ] } },
{ "name": "ruling: the exiled land cannot be played during combat, only in a main phase",
  "players": [ { "battlefield": ["Gila Courser", "Grizzly Bears"], "library": ["Plains", "Island"] }, {} ],
  "steps": [ { "activate": "Gila Courser", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Gila Courser", "at": "p1" } ] }, { "resolve": true }, { "play_land": "Plains", "illegal": true }, { "advance_to": "Main2" }, { "play_land": "Plains" } ],
  "expect": { "players": [ { "battlefield_has": ["Plains"], "exile": [] }, {} ] } },
{ "name": "ruling: an unsaddled Mount can still attack and deal combat damage",
  "players": [ { "battlefield": ["Gila Courser"] }, {} ],
  "steps": [ { "attack": [ { "card": "Gila Courser", "at": "p1" } ] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 16 } ] } }
]
