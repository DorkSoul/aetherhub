[
 {
  "name": "mana value 3 or less: returns tapped under your control",
  "players": [ { "hand": ["Vindictive Triumph"], "battlefield": ["Plains", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Vindictive Triumph", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "exile": [] } ] }
 },
 {
  "name": "returned creature is exiled again at the beginning of the next end step",
  "players": [ { "hand": ["Vindictive Triumph"], "battlefield": ["Plains", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Vindictive Triumph", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Plains"] }, { "exile": ["Grizzly Bears"] } ] }
 },
 {
  "name": "mana value 4 stays exiled",
  "players": [ { "hand": ["Vindictive Triumph"], "battlefield": ["Plains", "Swamp", "Swamp"] }, { "battlefield": ["Hill Giant"] } ],
  "steps": [ { "cast": "Vindictive Triumph", "targets": ["Hill Giant"] }, { "resolve": true } ],
  "expect": { "players": [ {}, { "exile": ["Hill Giant"] } ] }
 }
]
