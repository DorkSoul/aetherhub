[
 {
  "name": "enters with four oil counters",
  "players": [
   {
    "hand": [
     "Archfiend of the Dross"
    ],
    "battlefield": [
     "Swamp",
     "Swamp",
     "Swamp",
     "Swamp"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Archfiend of the Dross"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Archfiend of the Dross": {
     "oil": 4
    }
   },
   "pt": {
    "Archfiend of the Dross": [
