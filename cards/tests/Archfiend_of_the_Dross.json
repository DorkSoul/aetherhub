    ]
   }
  }
 },
 {
  "name": "upkeep removes a counter",
  "players": [
   {
    "battlefield": [
     {
      "name": "Archfiend of the Dross",
      "counters": {
       "oil": 3
      }
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Archfiend of the Dross": {
     "oil": 2
    }
   },
   "winner": -1
  }
 },
 {
  "name": "losing the last oil counter loses the game",
  "players": [
   {
    "battlefield": [
     {
      "name": "Archfiend of the Dross",
      "counters": {
       "oil": 1
      }
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "winner": 1
  }
 },
 {
  "name": "opponent creature dying costs its controller 2 life",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Archfiend of the Dross",
     "Mountain"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 20
    },
    {
     "life": 18,
     "graveyard": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "own creature dying does not trigger",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Archfiend of the Dross",
     "Mountain",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 20
    },
    {
     "life": 20
    }
   ]
  }
 },
 {
  "name": "ruling: counters removed by another effect do not lose the game straight away",
  "players": [
   {
    "battlefield": ["Vampire Hexmage", { "name": "Archfiend of the Dross", "counters": { "oil": 1 } }]
   },
   {}
  ],
  "steps": [
   { "activate": "Vampire Hexmage", "ability": 0, "targets": ["Archfiend of the Dross"] },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Archfiend of the Dross": { "oil": 0 } },
   "winner": -1
  }
 },
 {
  "name": "ruling: the next upkeep after counters were removed by another effect loses the game",
  "players": [
   {
    "battlefield": ["Vampire Hexmage", { "name": "Archfiend of the Dross", "counters": { "oil": 1 } }]
   },
   {}
  ],
  "steps": [
   { "activate": "Vampire Hexmage", "ability": 0, "targets": ["Archfiend of the Dross"] },
   { "resolve": true },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "resolve": true }
  ],
  "expect": {
   "winner": 1
  }
 }
]