[
 { "name": "puts target enchantment on top of its owner's library",
   "players": [ { "hand": ["Aura Extraction"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Blight Mound"] } ],
   "steps": [ { "cast": "Aura Extraction", "targets": ["Blight Mound"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Aura Extraction"] }, { "library_count": 21, "battlefield_lacks": ["Blight Mound"] } ] } },
 { "name": "cycling {2}: discard to draw a card",
   "players": [ { "hand": ["Aura Extraction"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "activate": "Aura Extraction" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Aura Extraction"] }, {} ] } },
 { "name": "ruling: Stifle can counter the cycling ability, so no card is drawn",
   "players": [ { "hand": ["Aura Extraction"], "battlefield": ["Island", "Island"] }, { "hand": ["Stifle"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "activate": "Aura Extraction" }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Aura Extraction" }] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Aura Extraction"] }, { "graveyard_has": ["Stifle"] } ] } },
 { "name": "ruling: Counterspell cannot counter the cycling ability (cycling is not a spell)",
   "players": [ { "hand": ["Aura Extraction"], "battlefield": ["Island", "Island"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "activate": "Aura Extraction" }, { "pass": true }, { "cast": "Counterspell", "player": 1, "illegal": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Aura Extraction"] }, { "hand": ["Counterspell"] } ] } }
]
