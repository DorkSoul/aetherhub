[
  {
    "name": "Opt scries 2 with Kenessos: both top cards can go to the bottom",
    "players": [
      { "hand": ["Opt"], "battlefield": ["Island", "Kenessos, Priest of Thassa"], "library": ["Mountain", "Forest", "Swamp", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Opt" },
      { "resolve": true, "answers": [["Mountain", "Forest"]] }
    ],
    "expect": { "players": [ { "hand": ["Swamp"], "graveyard": ["Opt"], "library_count": 3 }, {} ] }
  },
  {
    "name": "without Kenessos Opt scries only 1",
    "players": [
      { "hand": ["Opt"], "battlefield": ["Island"], "library": ["Mountain", "Forest", "Swamp", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Opt" },
      { "resolve": true, "answers": [["Mountain"]] }
    ],
    "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Opt"] }, {} ] }
  },
  {
    "name": "Kenessos does not change an opponent's scry",
    "players": [
      { "battlefield": ["Kenessos, Priest of Thassa"], "library": ["Mountain"] },
      { "hand": ["Opt"], "battlefield": ["Island"], "library": ["Mountain", "Forest", "Swamp", "Plains"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "cast": "Opt", "player": 1 },
      { "resolve": true, "answers": [["Forest"]] }
    ],
    "expect": { "players": [ {}, { "hand": ["Mountain", "Swamp"], "graveyard": ["Opt"] } ] }
  },
  {
    "name": "activate: a Serpent on top may be put onto the battlefield",
    "players": [
      { "battlefield": ["Kenessos, Priest of Thassa", "Island", "Island", "Island", "Island"], "library": ["Sea Serpent", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Kenessos, Priest of Thassa", "ability": 0 },
      { "resolve": true, "answers": [["Sea Serpent"]] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Sea Serpent"], "library_count": 1 }, {} ] }
  },
  {
    "name": "activate: a Kraken is declined and may go to the bottom",
    "players": [
      { "battlefield": ["Kenessos, Priest of Thassa", "Island", "Island", "Island", "Island"], "library": ["Kraken Hatchling", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Kenessos, Priest of Thassa", "ability": 0 },
      { "resolve": true, "answers": [[], true] },
      { "advance_to": "Draw" },
      { "advance_to": "Draw" }
    ],
    "expect": { "players": [ { "hand": ["Forest"] }, {} ] }
  },
  {
    "name": "activate: a non-matching card may stay on top",
    "players": [
      { "battlefield": ["Kenessos, Priest of Thassa", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Kenessos, Priest of Thassa", "ability": 0 },
      { "resolve": true, "answers": [false] },
      { "advance_to": "Draw" },
      { "advance_to": "Draw" }
    ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "activate: a non-matching card put on the bottom",
    "players": [
      { "battlefield": ["Kenessos, Priest of Thassa", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Kenessos, Priest of Thassa", "ability": 0 },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Draw" },
      { "advance_to": "Draw" }
    ],
    "expect": { "players": [ { "hand": ["Forest"] }, {} ] }
  },
  {
    "name": "ruling: while resolving, a Kraken on top may be left on top instead of going to the bottom",
    "players": [
      { "battlefield": ["Kenessos, Priest of Thassa", "Island", "Island", "Island", "Island"], "library": ["Kraken Hatchling", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Kenessos, Priest of Thassa", "ability": 0 },
      { "resolve": true, "answers": [[], false] }
    ],
    "expect": { "players": [ { "library_top": ["Kraken Hatchling", "Forest"] }, {} ] }
  }
]
