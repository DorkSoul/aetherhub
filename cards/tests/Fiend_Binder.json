[
  {
    "name": "attack trigger taps the creature defending player controls",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Fiend Binder"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Fiend Binder", "at": "p1" }] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "no creature to tap: attack still deals damage",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Fiend Binder"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Fiend Binder", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "ruling: the trigger never taps a creature its controller controls",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Fiend Binder", "Grizzly Bears"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "attack": [{ "card": "Fiend Binder", "at": "p1" }] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Savannah Lions": true, "Grizzly Bears": false },
      "players": [{}, { "life": 17 }]
    }
  }
]
