[
  { "name": "granted miracle {2}: first instant drawn can be cast for {2}",
    "players": [ { "hand": ["Divination"], "battlefield": ["Lorehold, the Historian", "Island", "Island", "Island", "Island", "Island"], "library": ["Opt", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Divination", "Opt"] }, {} ] } },
  { "name": "granted miracle: declining leaves the instant in hand",
    "players": [ { "hand": ["Divination"], "battlefield": ["Lorehold, the Historian", "Island", "Island", "Island", "Island", "Island"], "library": ["Opt", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Opt", "Forest"] }, {} ] } },
  { "name": "opponent's upkeep: may discard a card to draw a card",
    "players": [ { "hand": ["Forest"], "battlefield": ["Lorehold, the Historian", "Island"], "library": ["Grizzly Bears", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Upkeep", "answers": [true, ["Forest"]] } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Forest"] }, {} ] } },
  { "name": "opponent's upkeep: declining keeps the hand",
    "players": [ { "hand": ["Forest"], "battlefield": ["Lorehold, the Historian", "Island"], "library": ["Grizzly Bears", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Upkeep", "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Forest"] }, {} ] } },
  { "name": "a creature drawn first does not get miracle",
    "players": [ { "hand": ["Divination"], "battlefield": ["Lorehold, the Historian", "Island", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Opt", "Forest"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears", "Opt"], "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: only the first card drawn this turn can be revealed for miracle (the second drawn instant stays in hand)",
    "players": [ { "hand": ["Divination"], "battlefield": ["Lorehold, the Historian", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Opt", "Forest"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest", "Opt"] }, {} ] } }
]
