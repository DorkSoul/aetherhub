[
  {
    "name": "destroys one nonland permanent of each chosen opponent",
    "players": [
      {
        "hand": ["Windgrace's Judgment"],
        "battlefield": ["Swamp", "Forest", "Island", "Mountain", "Plains"]
      },
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Hill Giant", "Forest"] }
    ],
    "steps": [
      { "cast": "Windgrace's Judgment", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Windgrace's Judgment"] },
        { "graveyard": ["Grizzly Bears"] },
        { "graveyard": ["Hill Giant"], "battlefield": ["Forest"] }
      ]
    }
  },
  {
    "name": "an opponent who is not chosen keeps its permanent",
    "players": [
      {
        "hand": ["Windgrace's Judgment"],
        "battlefield": ["Swamp", "Forest", "Island", "Mountain", "Plains"]
      },
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Windgrace's Judgment", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Windgrace's Judgment"] },
        { "graveyard": ["Grizzly Bears"] },
        { "battlefield": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "choosing no opponents destroys nothing",
    "players": [
      {
        "hand": ["Windgrace's Judgment"],
        "battlefield": ["Swamp", "Forest", "Island", "Mountain", "Plains"]
      },
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Windgrace's Judgment", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Windgrace's Judgment"] },
        { "battlefield": ["Grizzly Bears"] },
        { "battlefield": ["Hill Giant"] }
      ]
    }
  }
]
