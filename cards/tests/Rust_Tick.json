[
  {
    "name": "tapping an artifact: it stays tapped through its controller's untap step while Rust Tick stays tapped",
    "players": [
      { "battlefield": [{ "name": "Rust Tick", "sick": false }, "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "activate": "Rust Tick", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "turn": 2, "tapped": { "Sol Ring": true, "Rust Tick": true } }
  },
  {
    "name": "choosing to untap Rust Tick releases the artifact at the next opponent untap step",
    "players": [
      { "battlefield": [{ "name": "Rust Tick", "sick": false }, "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "activate": "Rust Tick", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "turn": 4, "tapped": { "Sol Ring": false, "Rust Tick": false } }
  },
  {
    "name": "choosing to keep Rust Tick tapped keeps the artifact tapped",
    "players": [
      { "battlefield": [{ "name": "Rust Tick", "sick": false }, "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "activate": "Rust Tick", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "turn": 4, "tapped": { "Sol Ring": true, "Rust Tick": true } }
  },
  {
    "name": "ruling: Rust Tick may target an artifact that is already tapped",
    "players": [
      { "battlefield": [{ "name": "Rust Tick", "sick": false }, "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "activate": "Rust Tick", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "activate": "Rust Tick", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Sol Ring": true, "Rust Tick": true } }
  },
  {
    "name": "ruling: untapping Rust Tick while controlling the artifact keeps that artifact tapped through this untap step",
    "players": [
      { "battlefield": [{ "name": "Rust Tick", "sick": false }, "Mountain", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "activate": "Rust Tick", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": { "tapped": { "Sol Ring": true, "Rust Tick": false } }
  },
  {
    "name": "ruling: the artifact untaps in its controller's next untap step after Rust Tick was untapped",
    "players": [
      { "battlefield": [{ "name": "Rust Tick", "sick": false }, "Mountain", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "activate": "Rust Tick", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "tapped": { "Sol Ring": false } }
  }
]
