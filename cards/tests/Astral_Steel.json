[
  {
    "name": "target creature gets +1/+2 until end of turn",
    "players": [{ "hand": ["Astral Steel"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] }, {}],
    "steps": [
      { "cast": "Astral Steel", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Astral Steel"] }, {}],
      "pt": { "Grizzly Bears": [3, 4] }
    }
  },
  {
    "name": "storm copies the spell for each spell cast before it this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Astral Steel"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Astral Steel", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Astral Steel", "Lightning Bolt"] }, { "graveyard": ["Hill Giant"] }],
      "pt": { "Grizzly Bears": [4, 6] }
    }
  },
  {
    "name": "ruling: a copy's new target can be chosen (the copy pumps the other creature)",
    "players": [
      { "hand": ["Lightning Bolt", "Astral Steel"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "cast": "Astral Steel", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": ["Serra Angel"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Astral Steel", "Lightning Bolt"] }, {}],
      "pt": { "Grizzly Bears": [3, 4], "Serra Angel": [5, 6] }
    }
  },
  {
    "name": "ruling: copies made by one storm spell are not counted by a later storm spell",
    "players": [
      { "hand": ["Lightning Bolt", "Astral Steel", "Astral Steel"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Astral Steel", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Astral Steel", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Astral Steel", "Lightning Bolt"] }, { "graveyard": ["Hill Giant"] }],
      "pt": { "Grizzly Bears": [7, 12] }
    }
  }
]
