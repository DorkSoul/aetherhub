  {
    "name": "saddle 4 needs total power 4 from other creatures",
    "players": [
      {
        "battlefield": [
          "Guardian Sunmare",
          "Grizzly Bears"
        ],
        "library": [
          "Elvish Mystic"
        ]
      },
      {}
    ],
