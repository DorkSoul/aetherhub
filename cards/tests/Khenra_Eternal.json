    "steps": [ { "attack": [ { "card": "Khenra Eternal", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Khenra Eternal" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 0 } ] } },
