  {
    "name": "ruling: an illegal target does not stop the other modes (opponent Bolts their own Bears in response; Llanowar Elves still returns)",
    "players": [
      { "hand": ["Inscription of Ruin"], "battlefield": ["Swamp", "Swamp", "Swamp", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Llanowar Elves"] },
