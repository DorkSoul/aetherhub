    "expect": {
      "players": [
        { "battlefield_has": ["Llanowar Elves"], "graveyard": ["Inscription of Ruin"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: kicked with all three modes performs them in order (discard two, return Llanowar Elves, destroy Grizzly Bears)",
    "players": [
      { "hand": ["Inscription of Ruin"], "battlefield": ["Swamp", "Swamp", "Swamp", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Llanowar Elves"] },
