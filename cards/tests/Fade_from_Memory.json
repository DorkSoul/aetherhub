[
  { "name": "exiles target card from a graveyard",
    "players": [ { "hand": ["Fade from Memory"], "battlefield": ["Swamp"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [
      {"cast": "Fade from Memory", "targets": ["Grizzly Bears"]},
      {"resolve": true}
    ],
    "expect": { "players": [ {"graveyard": ["Fade from Memory"]}, {"exile": ["Grizzly Bears"]} ] } },
  { "name": "cycling {B}: discard it to draw a card",
    "players": [ { "hand": ["Fade from Memory"], "battlefield": ["Swamp"] }, {} ],
    "steps": [
      {"activate": "Fade from Memory", "ability": 0},
      {"resolve": true}
    ],
    "expect": { "players": [ {"hand_count": 1, "graveyard": ["Fade from Memory"]}, {} ] } },
  { "name": "ruling: cycling is an activated ability, so Stifle can counter it and no card is drawn",
    "players": [ { "hand": ["Fade from Memory"], "battlefield": ["Swamp"] }, { "hand": ["Stifle"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      {"activate": "Fade from Memory", "ability": 0},
      {"pass": true},
      {"cast": "Stifle", "player": 1, "targets": [{"stack": "Fade from Memory"}]},
      {"resolve": true}
    ],
    "expect": { "players": [ {"hand_count": 0, "graveyard": ["Fade from Memory"]}, {"graveyard": ["Stifle"]} ] } }
]
