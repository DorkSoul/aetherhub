[
 { "name": "casts a creature card from the graveyard by paying its cost",
   "players": [ { "battlefield": ["Conduit of Worlds", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Conduit of Worlds", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": [] }, {} ], "tapped": { "Conduit of Worlds": true } } },
 { "name": "after casting it no further spells can be cast this turn",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Conduit of Worlds", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Conduit of Worlds", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] }, { "cast": "Giant Growth", "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Giant Growth"] }, {} ] } },
 { "name": "does nothing once a spell has been cast this turn",
   "players": [ { "hand": ["Shock"], "battlefield": ["Conduit of Worlds", "Mountain", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true }, { "activate": "Conduit of Worlds", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "life": 18 } ] } },
 { "name": "plays a land from the graveyard",
   "players": [ { "battlefield": ["Conduit of Worlds"], "graveyard": ["Forest"] }, {} ],
   "steps": [ { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": ["Forest"], "graveyard": [] }, {} ] } },
 { "name": "ruling: the Conduit itself counts as a spell cast this turn, so its ability does nothing",
   "players": [ { "hand": ["Conduit of Worlds"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Conduit of Worlds" }, { "resolve": true }, { "activate": "Conduit of Worlds", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Conduit of Worlds"] }, {} ], "tapped": { "Conduit of Worlds": true } } },
 { "name": "ruling: only one land per turn, so a second land from the graveyard is refused",
   "players": [ { "battlefield": ["Conduit of Worlds"], "graveyard": ["Forest", "Forest"] }, {} ],
   "steps": [ { "play_land": "Forest" }, { "play_land": "Forest", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Forest"], "graveyard": ["Forest"] }, {} ] } },
 { "name": "ruling: playing a land from the graveyard is only allowed in a main phase (not in combat)",
   "players": [ { "battlefield": ["Conduit of Worlds"], "graveyard": ["Forest"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "play_land": "Forest", "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Forest"], "battlefield_lacks": ["Forest"] }, {} ] } }
]
