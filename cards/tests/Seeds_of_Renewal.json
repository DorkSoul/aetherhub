[
  { "name": "returns two target cards from graveyard to hand and exiles itself",
    "players": [
      { "hand": ["Seeds of Renewal"], "graveyard": ["Grizzly Bears", "Hill Giant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Seeds of Renewal", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Grizzly Bears", "Hill Giant"], "exile": ["Seeds of Renewal"], "graveyard": [] }, {} ] } },
  { "name": "undaunted: one opponent makes it cost one less, so five lands are not enough",
    "players": [
      { "hand": ["Seeds of Renewal"], "graveyard": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [ { "cast": "Seeds of Renewal", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Seeds of Renewal"], "graveyard": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: all targets illegal on resolution: Seeds goes to the graveyard, not exile",
    "players": [
      { "hand": ["Seeds of Renewal"], "graveyard": ["Grizzly Bears", "Hill Giant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Tormod's Crypt"] }
    ],
    "steps": [
      { "cast": "Seeds of Renewal", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "pass": true },
      { "activate": "Tormod's Crypt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": [], "graveyard": ["Seeds of Renewal"], "exile": ["Grizzly Bears", "Hill Giant"] }, {} ] } },
  { "name": "ruling: one target illegal on resolution: the legal target still returns to hand",
    "players": [
      { "hand": ["Seeds of Renewal"], "graveyard": ["Grizzly Bears", "Hill Giant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Cling to Dust"], "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "cast": "Seeds of Renewal", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "pass": true },
      { "cast": "Cling to Dust", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Hill Giant"], "graveyard": [], "exile": ["Grizzly Bears", "Seeds of Renewal"] }, {} ] } }
