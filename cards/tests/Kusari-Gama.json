[
  {
    "name": "damage dealt to a blocker is dealt again to each other defending creature",
    "players": [
      { "battlefield": ["Kusari-Gama", "Hill Giant", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Kusari-Gama", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Kusari-Gama", "Hill Giant", "Mountain", "Mountain", "Mountain"] },
        { "graveyard": ["Grizzly Bears", "Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "combat damage to a player does not trigger the equipment",
    "players": [
      { "battlefield": ["Kusari-Gama", "Hill Giant", "Mountain", "Mountain", "Mountain"], "life": 20 },
      { "battlefield": ["Llanowar Elves"], "life": 20 }
    ],
    "steps": [
      { "activate": "Kusari-Gama", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 17, "battlefield": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "equipped creature gains the granted {2}: +1/+0 ability",
    "players": [
      { "battlefield": ["Kusari-Gama", "Hill Giant", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Kusari-Gama", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Hill Giant", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Hill Giant": [4, 3] }
    }
  }
]
