[
  {
    "name": "enters: investigate once (a Clue token)",
    "players": [ { "hand": ["Novice Inspector"], "battlefield": ["Plains"] }, {} ],
    "steps": [ { "cast": "Novice Inspector" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Novice Inspector", "Clue"] }, {} ] }
  },
  {
    "name": "needs W: no mana for the cast",
    "players": [ { "hand": ["Novice Inspector"], "battlefield": ["Forest"] }, {} ],
    "steps": [ { "cast": "Novice Inspector", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Novice Inspector"] }, {} ] }
  },
  {
    "name": "ruling: sacrificing a Clue token for its own ability is a sacrifice of a Clue (Tireless Tracker gets a counter)",
    "players": [
      { "hand": ["Novice Inspector"], "battlefield": [{ "name": "Tireless Tracker", "sick": false }, "Plains", "Plains", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Novice Inspector" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Clue", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Novice Inspector", "Tireless Tracker"] }, {} ],
      "counters": { "Tireless Tracker": { "p1p1": 1 } }
    }
  },
  {
    "name": "ruling: Wrench is a Clue artifact, not only a token: sacrificing it for its own ability counts as sacrificing a Clue",
    "players": [
      { "battlefield": [{ "name": "Tireless Tracker", "sick": false }, "Wrench", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Wrench", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Tireless Tracker"], "graveyard_has": ["Wrench"] }, {} ],
      "counters": { "Tireless Tracker": { "p1p1": 1 } }
    }
  }
]
