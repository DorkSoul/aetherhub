  {
    "name": "ward {2}: an opposing spell is countered unless its controller pays",
    "players": [
      {
        "battlefield": [
          "Colossal Skyturtle",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "Colossal Skyturtle"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Colossal Skyturtle"
          ]
        },
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        }
      ]
    }
  },
  {
    "name": "ward {2}: the opponent has only 1 spare mana, cannot pay, Doom Blade is countered",
    "players": [ { "battlefield": ["Colossal Skyturtle"] }, { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", "Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Doom Blade", "player": 1, "targets": ["Colossal Skyturtle"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Colossal Skyturtle"] }, { "graveyard_has": ["Doom Blade"], "life": 20 } ] }
  },
  {
    "name": "ward {2}: the opponent pays 2 with spare Swamps, Doom Blade destroys it",
    "players": [ { "battlefield": ["Colossal Skyturtle"] }, { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Doom Blade", "player": 1, "targets": ["Colossal Skyturtle"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "graveyard": ["Colossal Skyturtle"] }, { "life": 20 } ] }
  },
  {
    "name": "ruling: a channel ability with a target can't be activated without one, just to discard the card",
    "players": [
      { "hand": ["Colossal Skyturtle"], "battlefield": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Colossal Skyturtle", "ability": 1, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Colossal Skyturtle"], "graveyard": [] }, {} ]
    }
  },
  {
    "name": "ruling: discarding is part of the channel cost, so the card is in the graveyard before the ability resolves",
    "players": [
      { "hand": ["Colossal Skyturtle"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Colossal Skyturtle", "ability": 1, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "hand": [], "graveyard": ["Colossal Skyturtle"] }, { "battlefield": ["Grizzly Bears"] } ]
    }
  }
]