   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "attack": [ { "card": "Firebending Student", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "pt": { "Firebending Student": [2, 3] }, "players": [ { "pool": { "R": 2 } }, { "life": 15 } ] } },
 { "name": "not attacking: no mana is added",
   "players": [ { "battlefield": ["Firebending Student"] }, {} ],
   "steps": [ { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": {} }, {} ] } },
 { "name": "ruling: two firebending triggers each add R equal to power (two R)",
   "players": [ { "battlefield": ["Firebending Student", "Firebending Student"] }, {} ],
   "steps": [ { "attack": [ { "card": "Firebending Student", "at": "p1" }, { "card": "Firebending Student", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 2 } }, { "life": 18 } ] } },
 { "name": "ruling: mana tapped in the beginning of combat is lost, firebending mana lasts to end of combat",
   "players": [ { "battlefield": ["Firebending Student", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "tap_for_mana": "Mountain" }, { "attack": [ { "card": "Firebending Student", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, { "life": 19 } ] } },
 { "name": "ruling: a firebending trigger still adds mana (using last known power) when the creature is killed in response",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Firebending Student", "Mountain"] }, {} ],
   "steps": [ { "attack": [ { "card": "Firebending Student", "at": "p1" } ] }, { "cast": "Lightning Bolt", "targets": ["Firebending Student"] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 2 }, "graveyard_has": ["Firebending Student"] }, {} ] } },
 { "name": "ruling: firebending mana can still be spent after combat damage (in the end of combat step)",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Firebending Student"] }, {} ],
   "steps": [ { "attack": [ { "card": "Firebending Student", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "pool": {} }, { "life": 16 } ] } }
