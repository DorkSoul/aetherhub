[
  {
    "name": "opponent's Mind Rot discards cards this turn: they return to hand",
    "players": [
      { "hand": ["Pure Intentions", "Island", "Forest"], "battlefield": ["Plains"] },
      { "hand": ["Mind Rot"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "cast": "Pure Intentions" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Island", "Forest"], "graveyard": ["Pure Intentions"] }, {} ]
    }
  },
  {
    "name": "opponent's Mind Rot discards Pure Intentions itself: returns at the next end step",
    "players": [
      { "hand": ["Pure Intentions"], "battlefield": ["Plains"] },
      { "hand": ["Mind Rot"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "advance_to": "End", "player": 1 }
    ],
    "expect": {
      "players": [ { "hand": ["Pure Intentions"], "graveyard": [] }, {} ]
    }
  },
  {
    "name": "cards discarded by its controller's own spell stay in the graveyard",
    "players": [
      { "hand": ["Pure Intentions", "Faithless Looting", "Island"], "battlefield": ["Plains", "Mountain"], "library": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Pure Intentions" },
      { "resolve": true },
      { "cast": "Faithless Looting" },
      { "resolve": true, "answers": [["Forest", "Forest"]] }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "graveyard_has": ["Forest"] }, {} ]
    }
  },
  {
    "name": "ruling: an opponent's spell that lets the opponent choose the discard still returns the card",
    "players": [
      { "hand": ["Pure Intentions", "Lightning Bolt"], "battlefield": ["Plains"] },
      { "hand": ["Duress"], "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Pure Intentions" },
      { "resolve": true },
      { "cast": "Duress", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Lightning Bolt"], "graveyard_has": ["Pure Intentions"] }, {} ]
    }
  }
]
