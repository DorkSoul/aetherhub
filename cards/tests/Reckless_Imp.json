[
  { "name": "dash: haste, attacks, then returns to hand at the end step",
    "players": [ { "hand": ["Reckless Imp"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Reckless Imp", "alt": 0 }, { "resolve": true }, { "attack": [ { "card": "Reckless Imp", "at": "p1" } ] }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Reckless Imp"], "battlefield_lacks": ["Reckless Imp"] }, { "life": 18 } ] } },
  { "name": "hard cast stays on the battlefield and has no haste",
    "players": [ { "hand": ["Reckless Imp"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Reckless Imp" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Reckless Imp"] }, {} ] } },
  { "name": "dash can't be paid with one mana",
    "players": [ { "hand": ["Reckless Imp"], "battlefield": ["Swamp"] }, {} ],
    "steps": [ { "cast": "Reckless Imp", "alt": 0, "illegal": true } ],
    "expect": {} },
  { "name": "ruling: dash creature need not attack; it still returns to hand at the end step",
    "players": [ { "hand": ["Reckless Imp"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Reckless Imp", "alt": 0 }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Reckless Imp"], "battlefield_lacks": ["Reckless Imp"] }, { "life": 20 } ] } },
  { "name": "ruling: dash creature killed before its return trigger resolves stays in the graveyard",
    "players": [ { "hand": ["Reckless Imp"], "battlefield": ["Swamp", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Reckless Imp", "alt": 0 }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Reckless Imp"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard_has": ["Reckless Imp"], "hand_count": 0 }, { "graveyard_has": ["Lightning Bolt"] } ] } }
]
