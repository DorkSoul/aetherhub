[
 {
  "name": "opponent's tapped creatures stay tapped through their next untap step",
  "players": [
   {
    "hand": [
     "Misstep"
    ],
    "battlefield": [
     "Island",
     "Island"
    ]
   },
   {
    "battlefield": [
     {
      "name": "Grizzly Bears",
      "tapped": true
     },
     {
      "name": "Hill Giant",
      "tapped": true
     }
    ]
   }
  ],
  "steps": [
   {
    "cast": "Misstep",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main1"
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true,
    "Hill Giant": true
   }
  }
 },
 {
  "name": "creatures untap normally on the following untap step",
  "players": [
   {
    "hand": [
     "Misstep"
    ],
    "battlefield": [
     "Island",
     "Island"
    ]
   },
   {
    "battlefield": [
     {
      "name": "Grizzly Bears",
      "tapped": true
     }
    ]
   }
  ],
  "steps": [
   {
    "cast": "Misstep",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main1"
   },
   {
    "advance_to": "Main1"
   },
   {
    "advance_to": "Main1"
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": false
   }
  }
 },
 {
  "name": "only the targeted player's creatures are affected",
  "players": [
   {
    "hand": [
     "Misstep"
    ],
    "battlefield": [
     "Island",
     "Island",
     {
      "name": "Hill Giant",
      "tapped": true
     }
    ]
   },
   {
    "battlefield": [
     {
      "name": "Grizzly Bears",
      "tapped": true
     }
    ]
   }
  ],
  "steps": [
   {
    "cast": "Misstep",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main1"
   },
   {
    "advance_to": "Main1"
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true,
    "Hill Giant": false
   }
  }
 },
 {
  "name": "ruling: the targeted player's creature stays tapped through that player's next untap step",
  "players": [
   { "hand": ["Misstep"], "battlefield": ["Island", "Island"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Misstep", "targets": ["p1"] },
   { "resolve": true },
   { "advance_to": "Main1" }
  ],
  "expect": { "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "ruling: the restriction covers only the next untap step; the creature untaps in the untap step after it",
  "players": [
   { "hand": ["Misstep"], "battlefield": ["Island", "Island"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Misstep", "targets": ["p1"] },
   { "resolve": true },
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "advance_to": "Main1" }
  ],
  "expect": { "tapped": { "Grizzly Bears": false } }
 }
]