[
  { "name": "exiles the target and every same-named creature its controller controls; that player gets a Clue per nontoken one",
    "players": [ { "hand": ["Declaration in Stone"], "battlefield": ["Plains", "Plains"] },
                 { "battlefield": ["Grizzly Bears", "Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Declaration in Stone", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Declaration in Stone"] },
                             { "exile": ["Grizzly Bears", "Grizzly Bears"], "battlefield_has": ["Hill Giant", "Clue", "Clue"] } ] } },
  { "name": "a single creature: exactly one Clue, and the caster's same-named creatures are untouched",
    "players": [ { "hand": ["Declaration in Stone"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Declaration in Stone", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] },
                             { "exile": ["Hill Giant"], "battlefield_has": ["Clue"] } ] } },
  { "name": "ruling: target gone in response, nothing is exiled and the same-named creature survives",
    "players": [ { "hand": ["Declaration in Stone", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Mountain"] },
                 { "battlefield": ["Grizzly Bears", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Declaration in Stone", "targets": ["Grizzly Bears"] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Declaration in Stone", "Lightning Bolt"] },
                             { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Grizzly Bears"], "exile": [] } ] } }
]
