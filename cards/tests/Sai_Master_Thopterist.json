[
 {
  "name": "casting an artifact makes a Thopter",
  "players": [
   {
    "hand": [
     "Mind Stone"
    ],
    "battlefield": [
     "Sai, Master Thopterist",
     "Plains",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Mind Stone"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Sai, Master Thopterist",
      "Mind Stone",
      "Thopter"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "a non-artifact spell makes no Thopter",
  "players": [
   {
    "hand": [
     "Giant Growth"
    ],
    "battlefield": [
     "Sai, Master Thopterist",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Giant Growth",
    "targets": [
     "Sai, Master Thopterist"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Sai, Master Thopterist",
      "Forest"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "sacrifice two artifacts to draw",
  "players": [
   {
    "battlefield": [
     "Sai, Master Thopterist",
     "Island",
     "Island",
     "Sol Ring",
     "Mind Stone"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Sai, Master Thopterist"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 1,
     "graveyard_has": [
      "Sol Ring",
      "Mind Stone"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "one artifact is not enough",
  "players": [
   {
    "battlefield": [
     "Sai, Master Thopterist",
     "Island",
     "Island",
     "Sol Ring"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Sai, Master Thopterist",
    "illegal": true
   }
  ]
 },
 {
  "name": "ruling: the Thopter trigger resolves before the artifact spell (Mind Stone still on the stack)",
  "players": [
   {"hand": ["Mind Stone"], "battlefield": ["Sai, Master Thopterist", "Plains", "Plains"]},
   {}
  ],
  "steps": [
   {"cast": "Mind Stone"},
   {"pass": true},
   {"pass": true, "player": 1}
  ],
  "expect": {"stack_empty": false, "players": [{"battlefield_has": ["Thopter"], "battlefield_lacks": ["Mind Stone"]}, {}]}
 },
 {
  "name": "ruling: the Thopter trigger still resolves when the artifact spell is countered",
  "players": [
   {"hand": ["Mind Stone"], "battlefield": ["Sai, Master Thopterist", "Plains", "Plains"]},
   {"hand": ["Counterspell"], "battlefield": ["Island", "Island"]}
  ],
  "steps": [
   {"cast": "Mind Stone"},
   {"pass": true},
   {"cast": "Counterspell", "player": 1, "targets": [{"stack": "Mind Stone"}]},
   {"resolve": true}
  ],
  "expect": {"stack_empty": true, "players": [{"battlefield_has": ["Sai, Master Thopterist", "Thopter"], "graveyard_has": ["Mind Stone"]}, {"graveyard_has": ["Counterspell"]}]}
 }
]
