[
 { "name": "attacking adds RRR that lasts until end of combat",
   "players": [ { "battlefield": [ { "name": "Mai and Zuko", "sick": false } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Mai and Zuko", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 3 } }, {} ] } },
 { "name": "the firebending mana is lost when the combat ends and the steps move on",
   "players": [ { "battlefield": [ { "name": "Mai and Zuko", "sick": false } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Mai and Zuko", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": { "R": 0 } }, {} ] } },
 { "name": "an Ally creature spell can be cast at instant speed (flash)",
   "players": [ { "hand": ["Sokka, Swordmaster"], "battlefield": ["Plains", "Plains", "Plains", "Island", "Swamp", "Mountain", { "name": "Mai and Zuko", "sick": false }] }, {} ],
   "steps": [ { "advance_to": "End" }, { "cast": "Sokka, Swordmaster" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Sokka, Swordmaster"] }, {} ] } },
 { "name": "without Mai and Zuko an Ally creature spell can not be cast at the end step",
   "players": [ { "hand": ["Sokka, Swordmaster"], "battlefield": ["Plains", "Plains", "Plains", "Island", "Swamp", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "End" }, { "cast": "Sokka, Swordmaster", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Sokka, Swordmaster"] }, {} ] } },
 { "name": "an artifact spell can be cast at instant speed",
   "players": [ { "hand": ["Sol Ring"], "battlefield": ["Plains", "Plains", "Mountain", { "name": "Mai and Zuko", "sick": false }] }, {} ],
   "steps": [ { "advance_to": "End" }, { "cast": "Sol Ring" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Sol Ring"] }, {} ] } },
 { "name": "ruling: firebending mana can still pay for a spell after combat damage, until the end of combat",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Mai and Zuko", "sick": false } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Mai and Zuko", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": [], "graveyard": ["Lightning Bolt"] }, { "life": 14 } ] } },
 { "name": "ruling: firebending is a triggered ability, so its mana is only added when the trigger resolves",
   "players": [ { "battlefield": [ { "name": "Mai and Zuko", "sick": false } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Mai and Zuko", "at": "p1" } ] } ],
   "expect": { "stack_empty": false, "players": [ { "pool": { "R": 0 } }, {} ] } },
 { "name": "ruling: mana from other sources added in combat is lost when the combat steps change",
   "players": [ { "battlefield": [ { "name": "Mai and Zuko", "sick": false }, "Plains" ] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "tap_for_mana": "Plains" }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "W": 0 } }, {} ], "tapped": { "Plains": true } } }
]
