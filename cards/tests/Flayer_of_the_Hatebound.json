    }
  },
  {
    "name": "ruling: a creature cast from the graveyard (Lurrus) does not trigger it",
    "players": [
      { "battlefield": ["Lurrus of the Dream-Den", "Forest", "Flayer of the Hatebound"], "graveyard": ["Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "cast": "Llanowar Elves" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Llanowar Elves"] }, { "life": 20 }]
    }
