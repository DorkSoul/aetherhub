      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Flayer of the Hatebound"] }, { "life": 15 }],
      "pt": { "Flayer of the Hatebound": [5, 3] }
    }
  },
  {
