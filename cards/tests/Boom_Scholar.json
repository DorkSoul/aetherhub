[
 { "name": "exhaust: trample for creatures and Vehicles, two counters, once only",
   "players": [ { "battlefield": ["Boom Scholar", "Boommobile", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Forest"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "activate": "Boom Scholar", "ability": 0 }, { "resolve": true },
              { "activate": "Boom Scholar", "ability": 0, "illegal": true } ],
   "expect": { "counters": { "Boom Scholar": { "p1p1": 2 } }, "pt": { "Boom Scholar": [5, 5] },
               "keywords": { "Boom Scholar": ["Trample"], "Grizzly Bears": ["Trample"], "Boommobile": ["Trample"] } } },
 { "name": "another permanent's exhaust ability costs {2} less (X=2 for three mana)",
   "players": [ { "battlefield": ["Boom Scholar", "Boommobile", "Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Boommobile", "ability": 0, "targets": ["Grizzly Bears"], "answers": [2] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ], "counters": { "Boommobile": { "p1p1": 1 } } } },
 { "name": "with Boom Scholar the exhaust ability {X}{2}{R} is payable with just {R}",
   "players": [ { "battlefield": ["Boom Scholar", "Boommobile", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Boommobile", "ability": 0, "targets": ["Grizzly Bears"], "answers": [0] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Grizzly Bears"] } ], "counters": { "Boommobile": { "p1p1": 1 } } } },
 { "name": "without Boom Scholar the same exhaust ability needs {2}{R}",
   "players": [ { "battlefield": ["Boommobile", "Mountain", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Boommobile", "ability": 0, "targets": ["Grizzly Bears"], "answers": [0], "illegal": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "non-exhaust abilities of other permanents are not reduced",
   "players": [ { "battlefield": ["Boom Scholar", "Mind Stone"] }, {} ],
   "steps": [ { "activate": "Mind Stone", "ability": 1, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Mind Stone"] }, {} ] } },
 { "name": "ruling: an ability triggered by activating an exhaust ability resolves before the exhaust ability",
   "players": [ { "battlefield": ["Boom Scholar", "Adrenaline Jockey", "Mountain", "Forest", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
   "steps": [ { "activate": "Boom Scholar", "ability": 0 }, { "pass": true }, { "pass": true } ],
   "expect": { "pt": { "Boom Scholar": [3, 3], "Adrenaline Jockey": [4, 4] }, "counters": { "Adrenaline Jockey": { "p1p1": 1 } } } },
 { "name": "ruling: after Boom Scholar leaves and returns, its exhaust ability can be activated again",
   "players": [ { "hand": ["Boomerang"], "battlefield": ["Boom Scholar", "Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Forest", "Forest", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
   "steps": [ { "activate": "Boom Scholar", "ability": 0 }, { "resolve": true },
              { "cast": "Boomerang", "targets": ["Boom Scholar"] }, { "resolve": true },
              { "cast": "Boom Scholar" }, { "resolve": true },
              { "activate": "Boom Scholar", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Boom Scholar"] }, {} ], "counters": { "Boom Scholar": { "p1p1": 2 } } } },
 { "name": "ruling: exhaust can be activated at instant speed, during the opponent's turn",
   "players": [ { "battlefield": ["Boom Scholar", "Mountain", "Forest", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 },
              { "activate": "Boom Scholar", "ability": 0 }, { "resolve": true } ],
   "expect": { "counters": { "Boom Scholar": { "p1p1": 2 } } } }
]
