[
  { "name": "for an Equipment you control, may attach it to a creature you control (split second instant)",
    "players": [ { "hand": ["Inventory Management"], "battlefield": ["Mountain", "Plains", "Bonesplitter", "Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Inventory Management" }, { "resolve": true, "answers": [["Grizzly Bears"]] } ],
    "expect": { "pt": { "Grizzly Bears": [4, 2], "Hill Giant": [3, 3] } } },
  { "name": "may decline: the Equipment stays where it is",
    "players": [ { "hand": ["Inventory Management"], "battlefield": ["Mountain", "Plains", "Bonesplitter", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Inventory Management" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "an Aura you control is moved from one creature you control to another",
    "players": [ { "hand": ["Inventory Management", "Dead Weight"], "battlefield": ["Swamp", "Mountain", "Plains", "Craw Wurm", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Dead Weight", "targets": ["Craw Wurm"] }, { "resolve": true },
               { "cast": "Inventory Management" }, { "resolve": true, "answers": [["Hill Giant"]] } ],
    "expect": { "pt": { "Craw Wurm": [6, 4], "Hill Giant": [1, 1] } } },
  { "name": "an Equipment controlled by an opponent is not affected",
    "players": [ { "hand": ["Inventory Management"], "battlefield": ["Mountain", "Plains", "Grizzly Bears"] }, { "battlefield": ["Bonesplitter"] } ],
    "steps": [ { "cast": "Inventory Management" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "with no creature to attach to, nothing is asked",
    "players": [ { "hand": ["Inventory Management"], "battlefield": ["Mountain", "Plains", "Bonesplitter"] }, {} ],
    "steps": [ { "cast": "Inventory Management" }, { "resolve": true } ],
    "expect": {} },
  { "name": "ruling: a split second spell cast in response does not affect the spell already on the stack (Shock still resolves)",
    "players": [ { "hand": ["Shock", "Inventory Management"], "battlefield": ["Mountain", "Mountain", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "cast": "Inventory Management" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Shock", "Inventory Management"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: once split second leaves the stack, spells can be cast again before the next object resolves",
    "players": [ { "hand": ["Shock", "Shock", "Inventory Management"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "cast": "Inventory Management" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Shock", "Inventory Management"] }, { "life": 18, "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: while split second is on the stack an opponent can only use mana abilities (their Lightning Bolt is illegal until it resolves)",
    "players": [ { "hand": ["Inventory Management"], "battlefield": ["Mountain", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Inventory Management" },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"], "illegal": true },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true } ],
    "expect": { "players": [ { "life": 17, "graveyard_has": ["Inventory Management"] }, { "graveyard_has": ["Lightning Bolt"] } ] } }
]
