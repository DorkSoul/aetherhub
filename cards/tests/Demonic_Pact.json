[
  {
    "name": "damage mode",
    "players": [{ "battlefield": ["Demonic Pact"] }, {}],
    "steps": [{ "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [[0], ["p1"]] }, { "resolve": true }],
    "expect": { "players": [{ "life": 24 }, { "life": 16 }] }
  },
  {
    "name": "draw two mode",
    "players": [{ "battlefield": ["Demonic Pact"] }, {}],
    "steps": [{ "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [[2]] }],
    "expect": { "players": [{ "hand_count": 2 }, {}] }
  },
  {
    "name": "last mode loses the game",
    "players": [{ "battlefield": ["Demonic Pact"] }, {}],
    "steps": [{ "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [[3]] }],
    "expect": { "winner": 1 }
  },
  {
    "name": "ruling: once only 'lose the game' is left, the fourth upkeep must choose it",
    "players": [{ "battlefield": ["Demonic Pact"] }, {}],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[0], ["p1"]] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[2]] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[1]] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "winner": 1 }
  }
]
