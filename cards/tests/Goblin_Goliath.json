[
  {
    "name": "enters with one Goblin token per opponent (three players)",
    "players": [
      { "hand": ["Goblin Goliath"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {},
      {}
    ],
    "steps": [
      { "cast": "Goblin Goliath" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Goblin Goliath", "Goblin", "Goblin"] }
      ],
      "pt": { "Goblin": [1, 1] }
    }
  },
  {
    "name": "enters with a single Goblin token in a two-player game",
    "players": [
      { "hand": ["Goblin Goliath"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Goblin Goliath" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Goblin Goliath", "Goblin"] }
      ]
    }
  },
  {
    "name": "activated ability doubles a source's damage to an opponent this turn",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Goblin Goliath", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Goblin Goliath" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 14 }
      ],
      "tapped": { "Goblin Goliath": true }
    }
  },
  {
    "name": "without the activation, damage to an opponent is not doubled",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Goblin Goliath", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17 }
      ]
    }
  }
]
