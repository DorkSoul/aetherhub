[
  {
    "name": "ETB taps an opponent's nonland permanent, puts stun counters on it and gains life per nonbasic land",
    "players": [
      { "hand": ["Omega, Heartless Evolution"], "battlefield": ["Sulfurous Springs", "Command Tower", "Forest", "Forest", "Forest", "Forest", "Forest", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Omega, Heartless Evolution" },
      { "resolve": true, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "life": 22, "battlefield_has": ["Omega, Heartless Evolution"] }, { "battlefield_has": ["Grizzly Bears"], "life": 20 } ],
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 2 } }
    }
  },
  {
    "name": "basic lands do not count: no life and no stun counters when only basics are controlled",
    "players": [
      { "hand": ["Omega, Heartless Evolution"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Omega, Heartless Evolution" },
      { "resolve": true, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "life": 20, "battlefield_has": ["Omega, Heartless Evolution"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 0 } }
    }
  },
  {
    "name": "up to one: declining the target still gains life but taps nothing",
    "players": [
      { "hand": ["Omega, Heartless Evolution"], "battlefield": ["Sulfurous Springs", "Command Tower", "Forest", "Forest", "Forest", "Forest", "Forest", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Omega, Heartless Evolution" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 22 }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: X is counted once, as the ability resolves (a nonbasic land destroyed in response lowers it)",
    "players": [
      { "hand": ["Omega, Heartless Evolution"], "battlefield": ["Sulfurous Springs", "Command Tower", "Forest", "Forest", "Forest", "Forest", "Forest", "Island"] },
      { "battlefield": ["Grizzly Bears", "Wasteland"] }
    ],
    "steps": [
      { "cast": "Omega, Heartless Evolution" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true, "targets": ["Grizzly Bears"] },
      { "activate": "Wasteland", "player": 1, "ability": 0, "targets": ["Sulfurous Springs"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 21, "battlefield_has": ["Omega, Heartless Evolution", "Command Tower"], "graveyard_has": ["Sulfurous Springs"] }, { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Wasteland"] } ],
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 1 } }
    }
  }
]
