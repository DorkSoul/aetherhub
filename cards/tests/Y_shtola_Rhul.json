[
 {
  "name": "the end step blink happens twice: an additional end step follows the first",
  "players": [
   {
    "battlefield": [
     "Y'shtola Rhul",
     "Mulldrifter"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End",
    "targets": [
     "Mulldrifter"
    ]
   },
   {
    "pass": true
   },
   {
    "pass": true,
    "player": 1
   },
   {
    "resolve": true,
    "targets": [
     "Mulldrifter"
    ]
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 4,
     "battlefield_has": [
      "Y'shtola Rhul",
      "Mulldrifter"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "blinking the Rhul itself still adds the extra end step (its trigger fires again)",
  "players": [
   {
    "battlefield": [
     "Y'shtola Rhul"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Y'shtola Rhul"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "it does not trigger at an opponent's end step",
  "players": [
   {
    "battlefield": [
     "Mulldrifter"
    ]
   },
   {
    "battlefield": [
     "Y'shtola Rhul"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 0
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: an until-end-of-turn pump lasts through the additional end step",
  "players": [
   { "hand": ["Giant Growth"], "battlefield": ["Y'shtola Rhul", "Mulldrifter", "Grizzly Bears", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End", "targets": ["Mulldrifter"] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true, "targets": ["Mulldrifter"] }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [5, 5] }
  }
 }
]