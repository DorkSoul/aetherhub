  "steps": [{"activate": "The Animus", "targets": ["Barktooth Warbeard", "Yargle, Goliath of Otaria"]}, {"resolve": true}, {"advance_to": "Main1"}, {"advance_to": "Main1"}],
  "expect": {"players": [{}, {}], "pt": {"Barktooth Warbeard": [6, 5]}}},
 {"name": "an exiled creature card without a memory counter is not a legal copy target",
