  "steps": [{"activate": "The Animus", "targets": ["Barktooth Warbeard", "Yargle, Goliath of Otaria"]}, {"resolve": true}],
  "expect": {"players": [{}, {}], "pt": {"Yargle, Goliath of Otaria": [3, 9]}}},
 {"name": "the copy ends when your next turn begins",
