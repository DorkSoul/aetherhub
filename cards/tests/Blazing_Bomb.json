[
  { "name": "four mana spent on a noncreature spell adds a +1/+1 counter",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Blazing Bomb"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Blazing Bomb"] }, {} ], "counters": { "Blazing Bomb": { "PlusOnePlusOne": 1 } } } },
  { "name": "only three mana spent on a noncreature spell: no counter",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Blazing Bomb"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Blazing Bomb"] }, {} ], "counters": { "Blazing Bomb": { "PlusOnePlusOne": 0 } } } },
  { "name": "a creature spell does not trigger it",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Blazing Bomb"] }, {} ],
    "steps": [ { "cast": "Hill Giant" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Blazing Bomb", "Hill Giant"] }, {} ], "counters": { "Blazing Bomb": { "PlusOnePlusOne": 0 } } } },
  { "name": "Blow Up: sacrifices itself and deals damage equal to its power",
    "players": [ { "battlefield": ["Mountain", { "name": "Blazing Bomb", "counters": { "PlusOnePlusOne": 2 } }] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Blazing Bomb", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blazing Bomb"], "battlefield": ["Mountain"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "Blow Up is sorcery speed: not while a spell is on the stack",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Blazing Bomb"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Harmonize" }, { "activate": "Blazing Bomb", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Blazing Bomb"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: Blow Up uses the Bomb's power as it last existed (3 power kills a 3/3)",
    "players": [ { "battlefield": ["Mountain", { "name": "Blazing Bomb", "counters": { "PlusOnePlusOne": 2 } }] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Blazing Bomb", "ability": 0, "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blazing Bomb"] }, { "graveyard": ["Hill Giant"] } ] } },
  { "name": "ruling: the Bomb's counter trigger resolves before the spell and still counts if that spell is countered",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Blazing Bomb"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Harmonize" }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Harmonize" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Harmonize"], "battlefield_has": ["Blazing Bomb"] }, { "graveyard": ["Counterspell"] } ], "counters": { "Blazing Bomb": { "PlusOnePlusOne": 1 } } } }
]
