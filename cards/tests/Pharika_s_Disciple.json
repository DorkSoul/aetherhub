  {
    "name": "ruling: combat damage to a creature (blocked) does not trigger renown",
    "players": [ { "battlefield": ["Pharika's Disciple"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Pharika's Disciple", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Pharika's Disciple" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Pharika's Disciple": [2, 3] },
      "players": [ { "battlefield_has": ["Pharika's Disciple"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: noncombat damage to a player does not trigger renown",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pharika's Disciple"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Pharika's Disciple": [2, 3] },
      "players": [ {}, { "life": 17 } ]
    }
