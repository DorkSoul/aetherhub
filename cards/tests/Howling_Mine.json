[
  {
    "name": "each player draws an extra card in their draw step (no draw step on the first turn)",
    "players": [
      {
        "battlefield": [
          "Howling Mine"
        ]
      },
      {}
    ],
    "start": "Upkeep",
    "steps": [
      {
        "advance_to": "Draw"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Draw"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        },
        {
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "tapped Howling Mine gives no extra card",
    "players": [
      {
        "battlefield": [
          {
            "name": "Howling Mine",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "start": "Upkeep",
    "steps": [
      {
        "advance_to": "Draw"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "ruling: the extra draw happens after the normal draw (one card in hand while the trigger is on the stack)",
    "players": [
      {
        "battlefield": [
          "Howling Mine"
        ]
      },
      {}
    ],
    "start": "Upkeep",
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "pass": true,
        "player": 0
      },
      {
        "pass": true,
        "player": 1
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "ruling: tapped in response to its trigger, it does not draw when the trigger resolves",
    "players": [
      {
        "battlefield": [
          "Howling Mine",
          "Icy Manipulator",
          "Island"
        ]
      },
      {}
    ],
    "start": "Upkeep",
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "pass": true,
        "player": 0
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "activate": "Icy Manipulator",
        "targets": [
          "Howling Mine"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 1
        }
      ],
      "tapped": {
        "Howling Mine": true
      }
    }
  },
  {
    "name": "ruling: destroyed in response to its trigger, the trigger still draws (last known untapped state)",
    "players": [
      {
        "hand": [
          "Shatter"
        ],
        "battlefield": [
          "Howling Mine",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "start": "Upkeep",
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "pass": true,
        "player": 0
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "cast": "Shatter",
        "targets": [
          "Howling Mine"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Shatter",
            "Howling Mine"
          ]
        },
        {
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "ruling: tapped in response to its trigger, it does not draw when the trigger resolves",
    "players": [
      {
        "battlefield": [
          "Howling Mine",
          "Icy Manipulator",
          "Island"
        ]
      },
      {}
    ],
    "start": "Upkeep",
    "steps": [
      {
        "advance_to": "Draw",
        "hold": true
      },
      {
        "activate": "Icy Manipulator",
        "targets": [
          "Howling Mine"
        ]
      },
      {
        "pass": true
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 1
        }
      ],
      "tapped": {
        "Howling Mine": true
      }
    }
  }
]
