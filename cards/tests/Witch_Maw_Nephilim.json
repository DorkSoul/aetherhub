[
  {
    "name": "casting a spell lets you put two +1/+1 counters on it",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Witch-Maw Nephilim"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Witch-Maw Nephilim"] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Witch-Maw Nephilim": { "p1p1": 2 } },
      "pt": { "Witch-Maw Nephilim": [6, 6] }
    }
  },
  {
    "name": "declining the optional trigger puts no counters",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Witch-Maw Nephilim"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Witch-Maw Nephilim"] },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Witch-Maw Nephilim": [4, 4] }
    }
  },
  {
    "name": "attacking with power 10 or more: gains trample, so 8 damage goes through a 2/2 blocker",
    "players": [ { "battlefield": [ { "name": "Witch-Maw Nephilim", "sick": false, "counters": { "p1p1": 9 } } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [{ "card": "Witch-Maw Nephilim", "at": "p1" }] },
      { "resolve": true },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Witch-Maw Nephilim" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 12, "graveyard": ["Grizzly Bears"] } ] }
  },
  {
    "name": "attacking with power 9: no trample, the blocker absorbs all the damage",
    "players": [ { "battlefield": [ { "name": "Witch-Maw Nephilim", "sick": false, "counters": { "p1p1": 8 } } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [{ "card": "Witch-Maw Nephilim", "at": "p1" }] },
      { "resolve": true },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Witch-Maw Nephilim" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20, "graveyard": ["Grizzly Bears"] } ] }
  }
]
