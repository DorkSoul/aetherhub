[
  { "name": "expend 4 adds a stash counter",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Hoarder's Overflow"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 8 } ], "counters": { "Hoarder's Overflow": { "stash": 1 } } } },
  { "name": "only three mana spent: no stash counter",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Hoarder's Overflow"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 11 } ], "counters": { "Hoarder's Overflow": { "stash": 0 } } } },
  { "name": "sacrifice: discards the hand and draws one card per stash counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", { "name": "Hoarder's Overflow", "counters": { "stash": 2 } }] }, {} ],
    "steps": [ { "activate": "Hoarder's Overflow", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Lightning Bolt", "Hoarder's Overflow"], "battlefield_lacks": ["Hoarder's Overflow"] }, {} ] } },
  { "name": "sacrifice with no stash counters: discards the hand and draws nothing",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Hoarder's Overflow"] }, {} ],
    "steps": [ { "activate": "Hoarder's Overflow", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Lightning Bolt", "Hoarder's Overflow"] }, {} ] } },
 { "name": "entering the battlefield puts a stash counter on it",
   "players": [ { "hand": ["Hoarder's Overflow"], "battlefield": ["Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Hoarder's Overflow" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hoarder's Overflow"] }, {} ], "counters": { "Hoarder's Overflow": { "stash": 1 } } } },
 { "name": "needs {1}{R} to cast: one Mountain is illegal",
   "players": [ { "hand": ["Hoarder's Overflow"], "battlefield": ["Mountain"] }, {} ],
   "steps": [ { "cast": "Hoarder's Overflow", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Hoarder's Overflow"], "battlefield_lacks": ["Hoarder's Overflow"] }, {} ] } },
 { "name": "ruling: expend 4 triggers once per turn; spending more mana later does not trigger again",
   "players": [ { "hand": ["Twin Bolt", "Twin Bolt", "Twin Bolt", "Twin Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Hoarder's Overflow"] }, {} ],
   "steps": [ { "cast": "Twin Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Twin Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Twin Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Twin Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 12 } ], "counters": { "Hoarder's Overflow": { "stash": 1 } } } },
 { "name": "ruling: a permanent entering after 4 mana was already spent does not trigger expend 4",
   "players": [ { "hand": ["Twin Bolt", "Hoarder's Overflow"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Twin Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Hoarder's Overflow" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hoarder's Overflow"] }, { "life": 18 } ], "counters": { "Hoarder's Overflow": { "stash": 1 } } } },
 { "name": "ruling: Snuff Out paid with life counts no mana toward expend 4",
   "players": [ { "hand": ["Snuff Out", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Swamp", "Mountain", "Mountain", "Mountain", "Hoarder's Overflow"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Snuff Out", "targets": ["Grizzly Bears"], "alt": 0 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 16 }, { "life": 11, "graveyard": ["Grizzly Bears"] } ], "counters": { "Hoarder's Overflow": { "stash": 0 } } } }
]
