[
 { "name": "deals 3 damage to target creature, no extra damage without a modified creature",
   "players": [ { "hand": ["Kami's Flare"], "battlefield": ["Mountain", "Island"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Kami's Flare", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0 }, { "life": 20, "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "also deals 2 damage to its controller if you control a modified creature",
   "players": [ { "hand": ["Kami's Flare"], "battlefield": ["Mountain", "Island", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Kami's Flare", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 18, "graveyard": ["Hill Giant"] } ] } },
 { "name": "an equipped creature counts as modified",
   "players": [ { "hand": ["Kami's Flare"], "battlefield": ["Mountain", "Island", "Plains", "Grizzly Bears", "Bonesplitter"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "activate": "Bonesplitter", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Kami's Flare", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "cannot target a land",
   "players": [ { "hand": ["Kami's Flare"], "battlefield": ["Mountain", "Island"] },
                { "battlefield": ["Forest"] } ],
   "steps": [ { "cast": "Kami's Flare", "targets": ["Forest"], "illegal": true } ],
   "expect": { "players": [ { "hand_count": 1 }, { "life": 20 } ] } },
 { "name": "ruling: an Aura controlled by an opponent does not make my creature modified",
   "players": [ { "hand": ["Kami's Flare"], "battlefield": ["Mountain", "Island", "Grizzly Bears"] },
                { "hand": ["Ward of Lights"], "battlefield": ["Plains", "Plains", "Hill Giant"] } ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "cast": "Ward of Lights", "player": 1, "targets": ["Grizzly Bears"] },
              { "resolve": true, "answers": ["U"] },
              { "pass": true, "player": 1 },
              { "cast": "Kami's Flare", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 20, "graveyard": ["Hill Giant"] } ] } },
 { "name": "ruling: a creature with a counter of any kind is modified",
   "players": [ { "hand": ["Kami's Flare"], "battlefield": ["Mountain", "Island", { "name": "Grizzly Bears", "counters": { "charge": 1 } }] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Kami's Flare", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 18, "graveyard": ["Hill Giant"] } ] } }
]
