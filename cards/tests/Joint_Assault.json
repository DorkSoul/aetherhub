[
  {
    "name": "an unpaired target gets +2/+2",
    "players": [ { "hand": ["Joint Assault"], "battlefield": ["Forest", "Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Joint Assault", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [3, 3] } }
  },
  {
    "name": "a paired target and its partner both get +2/+2",
    "players": [ { "hand": ["Nearheath Pilgrim", "Joint Assault"], "battlefield": ["Plains", "Plains", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Nearheath Pilgrim" },
      { "resolve": true, "answers": [true, "Grizzly Bears"] },
      { "cast": "Joint Assault", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [4, 4], "Nearheath Pilgrim": [4, 3] } }
  },
  {
    "name": "targeting the soulbond creature pumps its partner too",
    "players": [ { "hand": ["Nearheath Pilgrim", "Joint Assault"], "battlefield": ["Plains", "Plains", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Nearheath Pilgrim" },
      { "resolve": true, "answers": [true, "Grizzly Bears"] },
      { "cast": "Joint Assault", "targets": ["Nearheath Pilgrim"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [4, 4], "Nearheath Pilgrim": [4, 3] } }
  },
  {
    "name": "ruling: target illegal on resolution - Joint Assault does nothing",
    "players": [ { "hand": ["Joint Assault"], "battlefield": ["Forest", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Joint Assault", "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Joint Assault", "Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "ruling: unpaired later - the +2/+2 stays on the target",
    "players": [ { "hand": ["Nearheath Pilgrim", "Joint Assault", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Nearheath Pilgrim" },
      { "resolve": true, "answers": [true, "Grizzly Bears"] },
      { "cast": "Joint Assault", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Nearheath Pilgrim"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Nearheath Pilgrim"] }, {} ], "pt": { "Grizzly Bears": [4, 4] } }
  }
]
