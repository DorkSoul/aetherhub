[
  {
    "name": "B: regenerates so Shock does not destroy it",
    "players": [ { "hand": ["Shock"], "battlefield": ["Dutiful Thrull", "Swamp", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Dutiful Thrull" },
      { "resolve": true },
      { "cast": "Shock", "targets": ["Dutiful Thrull"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Dutiful Thrull"] }, {} ], "tapped": { "Dutiful Thrull": true } }
  },
  {
    "name": "regeneration needs {B}: no Swamp means no activation",
    "players": [ { "battlefield": ["Dutiful Thrull", "Mountain", "Plains"] }, {} ],
    "steps": [ { "activate": "Dutiful Thrull", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dutiful Thrull"] }, {} ] }
  }
]
