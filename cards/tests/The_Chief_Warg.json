    "players": [
      { "battlefield": ["The Chief Warg", "Serra Angel"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "The Chief Warg", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "life": 19 }, {} ]
    }
  },
  {
    "name": "no trigger without a creature of power 4 or greater",
    "players": [
      { "battlefield": ["The Chief Warg", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "The Chief Warg", "at": "p1" } ] }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "life": 20 }, {} ]
    }
  },
  {
    "name": "menace: a single blocker is illegal",
    "players": [
      { "battlefield": ["The Chief Warg"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "The Chief Warg", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "The Chief Warg" } ], "illegal": true }
    ],
    "expect": {
      "players": [ {}, {} ]
    }
  },
  {
    "name": "ruling: the trigger checks on attack; it still resolves after the 4-power creature dies in response",
    "players": [
      { "battlefield": ["The Chief Warg", "Grizzly Bears", "Bonesplitter", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "The Chief Warg", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "life": 19, "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  },
  {
    "name": "ruling: a power boost after attackers are declared does not start the attack trigger",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["The Chief Warg", "Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "The Chief Warg", "at": "p1" } ] },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "life": 20, "graveyard": ["Giant Growth"] }, {} ]
    }
  }
