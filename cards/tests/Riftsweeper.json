[
  {
    "name": "enters: the face-up exiled card is shuffled into its owner's library",
    "players": [ { "hand": ["Riftsweeper"], "battlefield": ["Forest", "Forest"], "exile": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Riftsweeper" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Riftsweeper"], "exile": [], "library_count": 1 }, {} ] }
  },
  {
    "name": "the card returns to its owner's library, not the controller's",
    "players": [ { "hand": ["Riftsweeper"], "battlefield": ["Forest", "Forest"] }, { "exile": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Riftsweeper" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 0 }, { "exile": [], "library_count": 1 } ] }
  },
  {
    "name": "ruling: a card haunting a creature is removed from exile, and the haunt effect ends",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt", "Riftsweeper"], "battlefield": ["Absolver Thrull", "Mountain", "Mountain", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears", "Glorious Anthem"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Absolver Thrull"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Riftsweeper" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": [], "library_count": 1, "battlefield_has": ["Riftsweeper"] },
        { "battlefield_has": ["Glorious Anthem"], "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]
