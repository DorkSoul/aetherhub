[
  { "name": "upkeep: attach a Curse attached to you to an opponent and draw two cards",
    "players": [ { "hand": ["Curse of Opulence"], "battlefield": ["Lynde, Cheerful Tormentor", "Mountain"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Curse of Opulence", "targets": ["p0"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "battlefield_has": ["Curse of Opulence"] }, {} ] } },
  { "name": "upkeep: declining does nothing",
    "players": [ { "hand": ["Curse of Opulence"], "battlefield": ["Lynde, Cheerful Tormentor", "Mountain"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Curse of Opulence", "targets": ["p0"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "a Curse put into your graveyard returns attached to you at the next end step",
    "players": [ { "hand": ["Curse of Opulence", "Disenchant"], "battlefield": ["Lynde, Cheerful Tormentor", "Mountain", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Curse of Opulence", "targets": ["p1"] }, { "resolve": true }, { "cast": "Disenchant", "targets": ["Curse of Opulence"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Curse of Opulence"] }, {} ] } },
  { "name": "ruling: the upkeep attach is not targeted, so it works on an opponent with hexproof (Leyline of Sanctity)",
    "players": [ { "hand": ["Curse of Opulence"], "battlefield": ["Lynde, Cheerful Tormentor", "Mountain"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Leyline of Sanctity"] } ],
    "steps": [ { "cast": "Curse of Opulence", "targets": ["p0"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "battlefield_has": ["Curse of Opulence"] }, { "battlefield_has": ["Leyline of Sanctity"] } ] } }
]
