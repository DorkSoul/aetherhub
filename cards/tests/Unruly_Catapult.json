[
  { "name": "tap: deals 1 damage to each opponent",
    "players": [ { "battlefield": ["Unruly Catapult"] }, {} ],
    "steps": [ { "activate": "Unruly Catapult", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19 } ] } },
  { "name": "casting an instant untaps it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Unruly Catapult", "Mountain"] }, {} ],
    "steps": [ { "activate": "Unruly Catapult", "ability": 0 }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 16 } ], "tapped": { "Unruly Catapult": false } } },
  { "name": "ruling: the untap trigger resolves before the instant, so the Catapult can ping again before the instant resolves",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Unruly Catapult", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Unruly Catapult", "ability": 0 }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 },
      { "activate": "Unruly Catapult", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 18, "graveyard": ["Grizzly Bears"] } ], "tapped": { "Unruly Catapult": true } } },
  { "name": "ruling: the untap trigger still resolves when the instant is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Unruly Catapult", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Unruly Catapult", "ability": 0 }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 19, "graveyard": ["Counterspell"] } ], "tapped": { "Unruly Catapult": false } } }
]
