[
  { "name": "earthbend 4: target land you control becomes a 4/4 haste creature",
    "players": [ { "hand": ["Earthbending Lesson"], "battlefield": ["Forest", "Forest", "Forest", "Plains"] }, {} ],
    "steps": [
      { "cast": "Earthbending Lesson", "targets": ["Plains"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Plains"], "graveyard": ["Earthbending Lesson"] }, {} ],
      "pt": { "Plains": [4, 4] },
      "keywords": { "Plains": ["Haste"] },
      "counters": { "Plains": { "p1p1": 4 } }
    }
  },
  { "name": "the earthbent land returns tapped when it is exiled",
    "players": [ { "hand": ["Earthbending Lesson", "Swords to Plowshares"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Earthbending Lesson", "targets": ["Plains"] },
      { "resolve": true },
      { "cast": "Swords to Plowshares", "targets": ["Plains"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Plains"] }, {} ],
      "tapped": { "Plains": true }
    }
  },
  { "name": "ruling: an earthbent Forest keeps its mana ability and is colorless",
    "players": [ { "hand": ["Earthbending Lesson"], "battlefield": ["Llanowar Elves", "Forest", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "tap_for_mana": "Llanowar Elves", "color": "G" },
      { "cast": "Earthbending Lesson", "targets": ["Forest"] },
      { "resolve": true },
      { "tap_for_mana": "Forest", "color": "G" }
    ],
    "expect": {
      "players": [ { "pool": { "G": 1 } }, {} ],
      "colors": { "Forest": [] },
      "pt": { "Forest": [4, 4] }
    }
  },
  { "name": "ruling: a land that is already a creature can be earthbent again: counters add up and base P/T stays 0/0",
    "players": [ { "hand": ["Earthbending Lesson", "Earthbending Lesson"], "battlefield": ["Llanowar Elves", "Forest", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "tap_for_mana": "Llanowar Elves", "color": "G" },
      { "cast": "Earthbending Lesson", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Earthbending Lesson", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Forest"], "graveyard_has": ["Earthbending Lesson"] }, {} ],
      "counters": { "Forest": { "p1p1": 8 } },
      "pt": { "Forest": [8, 8] }
    }
  },
  { "name": "ruling: an earthbent land bounced to hand does not return to the battlefield",
    "players": [ { "hand": ["Earthbending Lesson", "Unsummon"], "battlefield": ["Llanowar Elves", "Forest", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "tap_for_mana": "Llanowar Elves", "color": "G" },
      { "cast": "Earthbending Lesson", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Unsummon", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "battlefield_has": ["Llanowar Elves"], "battlefield_lacks": ["Forest"], "graveyard_has": ["Unsummon"] }, {} ]
    }
  }
]
