[
  {
    "name": "counters a spell: it goes to the graveyard and its controller takes no damage",
    "players": [
      { "hand": ["Reject Imperfection"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Reject Imperfection", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 20, "graveyard": ["Reject Imperfection"] }, { "graveyard": ["Lightning Bolt"] }]
    }
  },
  {
    "name": "ruling: proliferate may choose only some of the permanents with counters (Grizzly Bears, not Hill Giant)",
    "players": [
      { "hand": ["Reject Imperfection"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }, { "name": "Hill Giant", "counters": { "p1p1": 1 } }] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Reject Imperfection", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [["Grizzly Bears"]] }
    ],
    "expect": {
      "players": [{ "life": 20 }, {}],
      "counters": { "Grizzly Bears": { "p1p1": 2 }, "Hill Giant": { "p1p1": 1 } }
    }
  },
  {
    "name": "ruling: proliferating a player gives it one of each counter kind it already has (poison and energy)",
    "players": [
      { "hand": ["Reject Imperfection"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"], "poison": 1, "energy": 1 }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Reject Imperfection", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [["p1"]] }
    ],
    "expect": {
      "players": [{ "life": 20 }, { "poison": 2, "energy": 2 }]
    }
  }
]
