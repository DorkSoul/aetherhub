 { "name": "ruling: the Operative cast as my second spell does not trigger from its own cast",
   "players": [ { "hand": ["Lightning Bolt", "Illvoi Operative"], "battlefield": ["Mountain", "Mountain", "Island"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Illvoi Operative" }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Illvoi Operative": [2, 1] } } },
 { "name": "ruling: a countered first spell still counts, so the second spell puts a counter",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Illvoi Operative"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17, "graveyard": ["Counterspell"] } ], "pt": { "Illvoi Operative": [3, 2] }, "counters": { "Illvoi Operative": { "p1p1": 1 } } } },
 { "name": "ruling: the trigger resolves even when the second spell is countered",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Illvoi Operative"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17, "graveyard": ["Counterspell"] } ], "pt": { "Illvoi Operative": [3, 2] } } }
