[
  { "name": "hard cast: enters and gains 2 life",
    "players": [ { "hand": ["Germinating Wurm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Germinating Wurm" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "battlefield_has": ["Germinating Wurm"] }, {} ] } },
  { "name": "warp: cast for {1}{G}, gains 2 life, exiled at the next end step",
    "players": [ { "hand": ["Germinating Wurm"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Germinating Wurm", "alt": 0 }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "exile": ["Germinating Wurm"], "battlefield_lacks": ["Germinating Wurm"] }, {} ] } },
  { "name": "warped card cast later from exile gains 2 life again",
    "players": [ { "hand": ["Germinating Wurm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Germinating Wurm", "alt": 0 }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" }, { "cast": "Germinating Wurm" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 24, "battlefield_has": ["Germinating Wurm"] }, {} ] } }
]
