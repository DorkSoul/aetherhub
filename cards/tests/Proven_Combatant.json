[
  {
    "name": "eternalize exiles the combatant from the graveyard and creates a 4/4 black Zombie Human Warrior token copy",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Proven Combatant"] }, {} ],
    "steps": [ { "activate": "Proven Combatant", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Proven Combatant"], "graveyard": [] }, {} ], "pt": { "Proven Combatant": [4, 4] } }
  },
  {
    "name": "eternalize cannot be activated with only five lands",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Proven Combatant"] }, {} ],
    "steps": [ { "activate": "Proven Combatant", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Proven Combatant"] }, {} ] }
  },
  {
    "name": "ruling: eternalize exiles the card as a cost, before the ability resolves",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Proven Combatant"] }, {} ],
    "steps": [ { "activate": "Proven Combatant", "ability": 0 } ],
    "expect": { "players": [ { "graveyard": [], "exile": ["Proven Combatant"], "battlefield_lacks": ["Proven Combatant"] }, {} ] }
  },
  {
    "name": "ruling: right after the combatant dies in your main phase you can activate eternalize",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Proven Combatant", "Mountain", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Proven Combatant"] },
      { "resolve": true },
      { "activate": "Proven Combatant", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Proven Combatant"], "battlefield_has": ["Proven Combatant"] }, {} ], "pt": { "Proven Combatant": [4, 4] } }
  },
  {
    "name": "ruling: the token copies the printed card, not the pumped combatant it was before dying",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Proven Combatant", "counters": { "p1p1": 2 } }, "Mountain", "Island", "Island", "Island", "Island", "Island", "Island" ] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Proven Combatant"] },
      { "resolve": true },
      { "activate": "Proven Combatant", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Proven Combatant"], "battlefield_has": ["Proven Combatant"] }, {} ], "pt": { "Proven Combatant": [4, 4] } }
  },
  {
    "name": "ruling: the token is a black Zombie in addition to its other types",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Proven Combatant"] }, {} ],
    "steps": [ { "activate": "Proven Combatant", "ability": 0 }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Proven Combatant"] }, {} ],
      "pt": { "Proven Combatant": [4, 4] },
      "colors": { "Proven Combatant": ["B"] },
      "subtypes": { "Proven Combatant": ["Zombie", "Human", "Warrior"] }
    }
  }
]
