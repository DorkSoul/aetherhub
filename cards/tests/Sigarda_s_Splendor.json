[
 {
  "name": "life total unchanged: draw a card at your next upkeep",
  "players": [
   { "hand": ["Sigarda's Splendor"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Sigarda's Splendor" },
   { "resolve": true },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Sigarda's Splendor"] }, {} ] }
 },
 {
  "name": "life total lower than the noted one: no card at upkeep",
  "players": [
   { "hand": ["Sigarda's Splendor"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Sigarda's Splendor" },
   { "resolve": true },
   { "set_life": 15 },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "hand_count": 0, "life": 15 }, {} ] }
 },
 {
  "name": "the life total is noted again after each upkeep: a drop then no drop draws at the following upkeep (plus the turn-3 draw step)",
  "players": [
   { "hand": ["Sigarda's Splendor"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Sigarda's Splendor" },
   { "resolve": true },
   { "set_life": 15 },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "hand_count": 2, "life": 15 }, {} ] }
 },
 {
  "name": "gaining life keeps it at or above the noted total: draw at upkeep",
  "players": [
   { "hand": ["Sigarda's Splendor", "Savannah Lions"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Sigarda's Splendor" },
   { "resolve": true },
   { "cast": "Savannah Lions" },
   { "resolve": true },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "hand_count": 1, "life": 21 }, {} ] }
 },
 {
  "name": "whenever you cast a white spell you gain 1 life; a nonwhite spell does not",
  "players": [
   { "hand": ["Sigarda's Splendor", "Savannah Lions", "Llanowar Elves"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Sigarda's Splendor" },
   { "resolve": true },
   { "cast": "Savannah Lions" },
   { "resolve": true },
   { "cast": "Llanowar Elves" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "life": 21, "battlefield_has": ["Savannah Lions", "Llanowar Elves"] }, {} ] }
 },
 {
  "name": "ruling: the total is noted at the upkeep even when no card is drawn (drop to 15 with no draw, then 16 draws because 16 >= 15)",
  "players": [
   { "hand": ["Sigarda's Splendor"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Sigarda's Splendor" },
   { "resolve": true },
   { "set_life": 15 },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "set_life": 16 },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": { "players": [ { "hand_count": 2, "life": 16 }, {} ] }
 }
]
