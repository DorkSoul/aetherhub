[
  {
    "name": "next upkeep: 1 damage to each opponent it has dealt damage to",
    "players": [ { "battlefield": ["The Fallen"] }, {} ],
    "steps": [
      { "attack": [ { "card": "The Fallen", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "never dealt damage: nobody is hit",
    "players": [ { "battlefield": ["The Fallen"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "ruling: after it leaves the battlefield it no longer damages the player at upkeep",
    "players": [ { "battlefield": ["The Fallen"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "attack": [ { "card": "The Fallen", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["The Fallen"] },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "graveyard_has": ["The Fallen"] }, { "life": 18, "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "ruling: the upkeep damage is one per opponent however many times it dealt damage",
    "players": [ { "battlefield": ["The Fallen"] }, {} ],
    "steps": [
      { "attack": [ { "card": "The Fallen", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "The Fallen", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 14 } ] }
  }
]
