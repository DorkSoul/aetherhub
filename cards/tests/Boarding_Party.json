[
  {
    "name": "cascade into a cheaper spell and cast it free",
    "players": [
      {
        "hand": ["Boarding Party"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Forest", "Hill Giant", "Savannah Lions"]
      },
      {}
    ],
    "steps": [
      { "cast": "Boarding Party" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boarding Party", "Hill Giant"] },
        {}
      ]
    }
  },
  {
    "name": "cascade may be declined",
    "players": [
      {
        "hand": ["Boarding Party"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Forest", "Hill Giant", "Savannah Lions"]
      },
      {}
    ],
    "steps": [
      { "cast": "Boarding Party" },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boarding Party"], "battlefield_lacks": ["Hill Giant"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a card with the same mana value (6) is not a valid cascade hit; cascade continues to Hill Giant",
    "players": [
      {
        "hand": ["Boarding Party"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Craw Wurm", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      { "cast": "Boarding Party" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boarding Party", "Hill Giant"], "battlefield_lacks": ["Craw Wurm"], "hand": [] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a countered Boarding Party still lets its cascade resolve",
    "players": [
      {
        "hand": ["Boarding Party"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Forest", "Hill Giant"]
      },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Boarding Party" },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Boarding Party"], "battlefield_has": ["Hill Giant"] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  }
]
