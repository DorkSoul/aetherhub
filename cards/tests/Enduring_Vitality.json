[
  {
    "name": "dies as a creature and returns as a non-creature enchantment",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Enduring Vitality"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Enduring Vitality"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "battlefield": [
            "Enduring Vitality"
          ],
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "exiled Enduring Vitality does not return",
