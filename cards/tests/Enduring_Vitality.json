      {
        "hand": [
          "Path to Exile"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Enduring Vitality"
        ],
        "library": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Path to Exile",
        "targets": [
          "Enduring Vitality"
        ]
      },
      {
        "resolve": true,
        "answers": [
          "Forest"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Path to Exile"
          ]
        },
        {
          "battlefield": [
            "Forest"
          ],
          "exile": [
            "Enduring Vitality"
          ]
        }
      ]
    }
  },
  {
    "name": "returned Enduring Vitality is not a creature (Murder has no legal target)",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Murder"
        ],
        "battlefield": [
          "Mountain",
          "Swamp",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Enduring Vitality"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Enduring Vitality"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Murder",
        "illegal": true
      }
