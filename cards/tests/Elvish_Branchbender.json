[
  {
    "name": "a Forest becomes an X/X Treefolk where X is the number of Elves you control",
    "players": [ { "battlefield": ["Elvish Branchbender", "Llanowar Elves", "Forest"] }, {} ],
    "steps": [
      { "activate": "Elvish Branchbender", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Forest", "Elvish Branchbender"] }, {} ],
      "pt": { "Forest": [2, 2] },
      "tapped": { "Elvish Branchbender": true }
    }
  },
  {
    "name": "the Forest is only a creature until end of turn",
    "players": [ { "battlefield": ["Elvish Branchbender", "Forest"] }, {} ],
    "steps": [
      { "activate": "Elvish Branchbender", "targets": ["Forest"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Forest", "Elvish Branchbender"] }, {} ],
      "pt": { "Forest": [1, 1] }
    }
  },
  {
    "name": "ruling: X is fixed on resolution, so Elves dying later do not shrink the Forest",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Elvish Branchbender", "Llanowar Elves", "Forest", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Elvish Branchbender", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Llanowar Elves"], "battlefield_has": ["Forest", "Elvish Branchbender"] }, {} ],
      "pt": { "Forest": [2, 2] }
    }
  },
  {
    "name": "ruling: with no Elves left when it resolves the Forest is a 0/0 and dies",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Elvish Branchbender", "Forest", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Elvish Branchbender", "targets": ["Forest"] },
      { "cast": "Lightning Bolt", "targets": ["Elvish Branchbender"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Elvish Branchbender", "Forest"] }, {} ]
    }
  }
]
