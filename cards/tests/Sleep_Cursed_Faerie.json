[
  {
    "name": "enters tapped with stun counters",
    "players": [
      {
        "hand": [
          "Sleep-Cursed Faerie"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sleep-Cursed Faerie"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Sleep-Cursed Faerie"
          ]
        },
        {}
      ],
      "pt": {
        "Sleep-Cursed Faerie": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "untap costs 1U",
    "players": [
      {
        "battlefield": [
          "Sleep-Cursed Faerie",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sleep-Cursed Faerie",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Sleep-Cursed Faerie",
            "Island"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "untap ability untaps the faerie when it has no stun counters",
    "players": [
      { "battlefield": ["Island", "Island", { "name": "Sleep-Cursed Faerie", "tapped": true, "counters": { "Stun": 0 } }] },
      {}
    ],
    "steps": [
      { "activate": "Sleep-Cursed Faerie", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Sleep-Cursed Faerie"] }, {}],
      "tapped": { "Sleep-Cursed Faerie": false }
    }
  },
  {
    "name": "untap ability with stun counters only removes one stun counter",
    "players": [
      { "battlefield": ["Island", "Island", { "name": "Sleep-Cursed Faerie", "tapped": true, "counters": { "Stun": 2 } }] },
      {}
    ],
    "steps": [
      { "activate": "Sleep-Cursed Faerie", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Sleep-Cursed Faerie"] }, {}],
      "tapped": { "Sleep-Cursed Faerie": true },
      "counters": { "Sleep-Cursed Faerie": { "Stun": 1 } }
    }
  },
  {
    "name": "ward {2}: opponent with one Mountain cannot pay, Bolt is countered, Faerie survives",
    "players": [ { "battlefield": ["Sleep-Cursed Faerie"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Sleep-Cursed Faerie"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sleep-Cursed Faerie"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "ward {2}: opponent pays 2 with spare mana, Bolt resolves and kills the Faerie",
    "players": [ { "battlefield": ["Sleep-Cursed Faerie"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Sleep-Cursed Faerie"] }, { "resolve": true, "auto": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Sleep-Cursed Faerie"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "enters tapped with three stun counters",
    "players": [ { "hand": ["Sleep-Cursed Faerie"], "battlefield": ["Island"] }, {} ],
    "steps": [ { "cast": "Sleep-Cursed Faerie" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sleep-Cursed Faerie"] }, {} ], "tapped": { "Sleep-Cursed Faerie": true }, "counters": { "Sleep-Cursed Faerie": { "Stun": 3 } } }
  }
]
