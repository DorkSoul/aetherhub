[
 { "name": "{1}: puts up to two land cards from hand onto the battlefield tapped",
   "players": [ { "hand": ["Plains", "Plains", "Forest"], "battlefield": ["Patron of the Moon", "Island"] }, {} ],
   "steps": [ { "activate": "Patron of the Moon" }, { "resolve": true, "answers": [["Plains", "Plains"]] } ],
   "expect": { "players": [ { "battlefield_has": ["Plains", "Plains"], "hand": ["Forest"] }, {} ], "tapped": { "Plains": true } } },
 { "name": "choosing zero lands does nothing to the hand",
   "players": [ { "hand": ["Plains"], "battlefield": ["Patron of the Moon", "Island"] }, {} ],
   "steps": [ { "activate": "Patron of the Moon" }, { "resolve": true, "answers": [[]] } ],
   "expect": { "players": [ { "hand": ["Plains"] }, {} ] } },
 { "name": "only land cards can be put onto the battlefield",
   "players": [ { "hand": ["Grizzly Bears", "Plains", "Plains"], "battlefield": ["Patron of the Moon", "Island"] }, {} ],
   "steps": [ { "activate": "Patron of the Moon" }, { "resolve": true, "answers": [["Plains"]] } ],
   "expect": { "players": [ { "hand": ["Grizzly Bears", "Plains"], "battlefield_has": ["Plains"] }, {} ] } },
 { "name": "offering: sacrifice a Moonfolk and pay {3}{U} (7 minus the Illusionist's {2}{U})",
   "players": [ { "hand": ["Patron of the Moon"], "battlefield": ["Moonbow Illusionist", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Patron of the Moon", "alt": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Patron of the Moon"], "graveyard": ["Moonbow Illusionist"] }, {} ] } },
 { "name": "offering needs a Moonfolk to sacrifice",
   "players": [ { "hand": ["Patron of the Moon"], "battlefield": ["Grizzly Bears", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Patron of the Moon", "alt": 0, "illegal": true } ] },
 { "name": "offering with too little mana left is illegal",
   "players": [ { "hand": ["Patron of the Moon"], "battlefield": ["Moonbow Illusionist", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Patron of the Moon", "alt": 0, "illegal": true } ] },
 { "name": "ruling: the ability is activatable with no land in hand (zero lands chosen)",
   "players": [ { "hand": [], "battlefield": ["Patron of the Moon", "Island"] }, {} ],
   "steps": [ { "activate": "Patron of the Moon" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Patron of the Moon"], "hand_count": 0 }, {} ] } }
