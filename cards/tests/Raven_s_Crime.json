[
  {
    "name": "target player discards a card",
    "players": [
      {
        "hand": [
          "Raven's Crime"
        ],
        "battlefield": [
          "Swamp"
        ]
      },
      {
        "hand": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Raven's Crime",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Raven's Crime"
          ]
        },
        {
          "hand_count": 0,
          "graveyard": [
            "Forest"
          ]
        }
      ]
    }
  },
  {
    "name": "retrace: cast from the graveyard by discarding a land, then it returns to the graveyard",
    "players": [
      {
        "graveyard": [
          "Raven's Crime"
        ],
        "hand": [
          "Forest"
        ],
        "battlefield": [
          "Swamp"
        ]
      },
      {
        "hand": [
          "Shock"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Raven's Crime",
        "alt": 0,
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Raven's Crime",
            "Forest"
          ],
          "hand_count": 0
        },
        {
          "graveyard": [
            "Shock"
          ]
        }
      ]
    }
  },
  {
    "name": "retrace needs a land to discard",
    "players": [
      {
        "graveyard": [
          "Raven's Crime"
        ],
        "hand": [
          "Shock"
        ],
        "battlefield": [
          "Swamp"
        ]
      },
      {
        "hand": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Raven's Crime",
        "alt": 0,
        "targets": [
          "p1"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Raven's Crime"
          ]
        },
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "ruling: retrace returns the card to the graveyard, so it can be cast again right away",
    "players": [
      { "graveyard": ["Raven's Crime"], "hand": ["Forest", "Forest"], "battlefield": ["Swamp", "Swamp"] },
      { "hand": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Raven's Crime", "alt": 0, "targets": ["p1"], "answers": ["Forest"] },
      { "resolve": true, "answers": ["Forest"] },
      { "cast": "Raven's Crime", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Raven's Crime"], "hand_count": 0 },
        { "hand_count": 0 }
      ]
    }
  }
]
