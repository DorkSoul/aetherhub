[
 { "name": "cast from hand: surveil 2 and gain 2 life; the card goes to the graveyard, not the battlefield",
   "players": [ { "hand": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Esper Origins // Summon: Esper Maduin" }, { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "life": 22, "graveyard_has": ["Esper Origins // Summon: Esper Maduin"], "battlefield_lacks": ["Summon: Esper Maduin"] }, {} ] } },
 { "name": "flashback from the graveyard: exiled, then it returns transformed as the 4/4 Saga with a finality counter",
   "players": [ { "graveyard": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Esper Origins // Summon: Esper Maduin", "alt": 0 }, { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "life": 22, "battlefield_has": ["Summon: Esper Maduin"], "graveyard": [] }, {} ],
               "pt": { "Summon: Esper Maduin": [4, 4] }, "counters": { "Summon: Esper Maduin": { "Finality": 1 } } } },
 { "name": "flashback needs {3}{G}: three lands are not enough",
   "players": [ { "graveyard": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Esper Origins // Summon: Esper Maduin", "alt": 0, "illegal": true } ],
   "expect": { "players": [ { "graveyard_has": ["Esper Origins // Summon: Esper Maduin"] }, {} ] } },
 { "name": "finality: when it would die it is exiled instead of going to the graveyard",
   "players": [ { "graveyard": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt"] }, {} ],
   "steps": [ { "cast": "Esper Origins // Summon: Esper Maduin", "alt": 0 }, { "resolve": true, "auto": true },
              { "cast": "Lightning Bolt", "targets": ["Summon: Esper Maduin"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Summon: Esper Maduin"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Summon: Esper Maduin"], "graveyard": ["Lightning Bolt", "Lightning Bolt"], "exile": ["Esper Origins // Summon: Esper Maduin"] }, {} ] } },
 { "name": "Saga chapter I on entering: the top card is a permanent, so it goes to hand",
   "players": [ { "graveyard": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Esper Origins // Summon: Esper Maduin", "alt": 0 }, { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Summon: Esper Maduin"] }, {} ] } },
 { "name": "ruling: flashback follows sorcery timing, so it is illegal during combat",
   "players": [ { "graveyard": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Esper Origins // Summon: Esper Maduin", "alt": 0, "illegal": true } ],
   "expect": { "players": [ { "graveyard_has": ["Esper Origins // Summon: Esper Maduin"] }, {} ] } },
 { "name": "ruling: a flashback spell that is countered is still exiled",
   "players": [ { "graveyard": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
                { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Esper Origins // Summon: Esper Maduin", "alt": 0 },
              { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Esper Origins // Summon: Esper Maduin" } ] },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard": [], "exile": ["Esper Origins // Summon: Esper Maduin"] }, { "graveyard": ["Counterspell"] } ] } },
 { "name": "ruling: a finality counter on a Saga: after chapter III it is sacrificed and exiled instead of going to the graveyard",
   "players": [ { "graveyard": ["Esper Origins // Summon: Esper Maduin"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Esper Origins // Summon: Esper Maduin", "alt": 0 }, { "resolve": true, "auto": true },
              { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "battlefield_lacks": ["Summon: Esper Maduin"], "exile": ["Esper Origins // Summon: Esper Maduin"] }, {} ] } }
]
