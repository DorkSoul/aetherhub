    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "cast": "Avoid Fate", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
