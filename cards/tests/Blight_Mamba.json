     {"battlefield": ["Hill Giant"]},
     {"battlefield": ["Blight Mamba", "Forest", "Forest"]}
   ],
   "steps": [
     {"attack": [{"card": "Hill Giant", "at": "p1"}]},
     {"block": [{"blocker": "Blight Mamba", "attacker": "Hill Giant"}]},
     {"pass": true},
     {"activate": "Blight Mamba", "ability": 0, "player": 1},
     {"resolve": true},
     {"advance_to": "Main2"},
     {"advance_to": "End"}
