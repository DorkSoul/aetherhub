[
  { "name": "one-mana noncreature spell: creates a Hero token and draws nothing",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Tellah, Great Sage"], "library": ["Grizzly Bears", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tellah, Great Sage", "Hero"], "hand_count": 0, "library_count": 2 }, { "life": 17 } ] } },
  { "name": "five mana spent on a noncreature spell: draws two cards",
    "players": [ { "hand": ["Bury in Books"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Tellah, Great Sage"], "library": ["Grizzly Bears", "Grizzly Bears"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Bury in Books", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hero"], "hand_count": 2, "library_count": 0 }, {} ] } },
  { "name": "eight mana spent: Tellah is sacrificed and deals 8 damage to each opponent",
    "players": [ { "hand": ["Molten Note"], "battlefield": ["Plains", "Mountain", "Swamp", "Forest", "Island", "Island", "Island", "Island", "Tellah, Great Sage"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Molten Note", "targets": ["p1:Hill Giant"], "answers": [6] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Molten Note", "Tellah, Great Sage"] }, { "life": 12, "graveyard": ["Hill Giant"] } ] } },
  { "name": "ruling: Tellah exiled before its trigger resolves still deals the damage (eight mana spent)",
    "players": [ { "hand": ["Molten Note"], "battlefield": ["Plains", "Mountain", "Swamp", "Forest", "Island", "Island", "Island", "Island", "Tellah, Great Sage"] },
                 { "hand": ["Swords to Plowshares"], "battlefield": ["Hill Giant", "Plains"] } ],
    "steps": [ { "cast": "Molten Note", "targets": ["p1:Hill Giant"], "answers": [6] }, { "pass": true }, { "cast": "Swords to Plowshares", "player": 1, "targets": ["Tellah, Great Sage"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 23, "exile": ["Tellah, Great Sage"], "graveyard": ["Molten Note"] }, { "life": 12, "graveyard": ["Hill Giant", "Swords to Plowshares"] } ] } },
  { "name": "ruling: Tellah's trigger still deals the damage when the spell fizzles (its target is exiled in response)",
    "players": [ { "hand": ["Molten Note"], "battlefield": ["Plains", "Mountain", "Swamp", "Forest", "Island", "Island", "Island", "Island", "Tellah, Great Sage"] },
                 { "hand": ["Swords to Plowshares"], "battlefield": ["Hill Giant", "Plains"] } ],
    "steps": [ { "cast": "Molten Note", "targets": ["p1:Hill Giant"], "answers": [6] }, { "pass": true }, { "cast": "Swords to Plowshares", "player": 1, "targets": ["p1:Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Molten Note", "Tellah, Great Sage"] }, { "life": 15, "exile": ["Hill Giant"] } ] } }
]
