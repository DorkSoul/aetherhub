[
 {
  "name": "returns to hand at end of combat after blocking",
  "players": [
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Wall of Junk"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "block": [
     {
      "blocker": "Wall of Junk",
      "attacker": "Grizzly Bears"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main2"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "hand": [
      "Wall of Junk"
     ],
     "battlefield_lacks": [
      "Wall of Junk"
     ]
    }
   ]
  }
 },
 {
  "name": "a wall that did not block stays on the battlefield",
  "players": [
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Wall of Junk"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "battlefield_has": [
      "Wall of Junk"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: a Wall of Junk removed before end of combat is not returned to hand",
  "players": [
   { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Wall of Junk"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Wall of Junk", "attacker": "Grizzly Bears" } ] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Wall of Junk"] }, { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Wall of Junk"] }, { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Wall of Junk"] }, { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    {},
    { "graveyard_has": ["Wall of Junk"], "hand_count": 0, "battlefield_lacks": ["Wall of Junk"] }
   ]
  }
 }
]
