[
  {
    "name": "power-up destroys an artifact and puts a +1/+1 counter on her",
    "players": [
      {
        "battlefield": ["She-Hulk, Jade Defender", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]
      },
      {
        "battlefield": ["+2 Mace"]
      }
    ],
    "steps": [
      { "activate": "She-Hulk, Jade Defender", "ability": 0, "targets": ["+2 Mace"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["She-Hulk, Jade Defender"] },
        { "graveyard": ["+2 Mace"] }
