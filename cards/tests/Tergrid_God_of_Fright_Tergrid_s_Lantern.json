      { "resolve": true },
      { "activate": "Tergrid's Lantern", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "Lantern {3}{B}: untap it",
