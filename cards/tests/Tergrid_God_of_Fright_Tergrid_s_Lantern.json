        { "battlefield_lacks": ["Lightning Bolt"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "opponent sacrifices a nontoken creature: you may put it onto the battlefield",
    "players": [
      { "hand": ["Diabolic Edict"], "battlefield": ["Tergrid, God of Fright", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
