[
  {
    "name": "ruling: a second amass adds counters to the existing Army instead of creating a new token",
    "players": [ { "hand": ["Toll of the Invasion", "Toll of the Invasion"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Forest"] } ],
    "steps": [ { "cast": "Toll of the Invasion", "targets": ["p1"] }, { "resolve": true }, { "cast": "Toll of the Invasion", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Army"] }, { "hand": ["Forest"] } ],
      "pt": { "Army": [2, 2] }
    }
  },
  {
    "name": "opponent discards the nonland card you choose, and you amass Zombies 1",
    "players": [ { "hand": ["Toll of the Invasion"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt", "Forest"] } ],
    "steps": [ { "cast": "Toll of the Invasion", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Army"] }, { "hand": ["Forest"], "graveyard": ["Lightning Bolt"] } ],
      "pt": { "Army": [1, 1] }
    }
  },
  {
    "name": "opponent with only lands: nothing discarded, amass still happens",
    "players": [ { "hand": ["Toll of the Invasion"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Forest"] } ],
    "steps": [ { "cast": "Toll of the Invasion", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Army"] }, { "hand": ["Forest"] } ]
    }
  }
