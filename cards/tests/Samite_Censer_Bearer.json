[
  {
    "name": "{W}, sacrifice: prevent the next 1 damage to each creature you control",
    "players": [
      {
        "battlefield": [
          "Samite Censer-Bearer",
          "Grizzly Bears",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Samite Censer-Bearer"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears"
          ],
          "battlefield_lacks": [
            "Samite Censer-Bearer"
          ],
          "graveyard": [
            "Samite Censer-Bearer"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "needs {W} to activate",
    "players": [
      {
        "battlefield": [
          "Samite Censer-Bearer",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Samite Censer-Bearer",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Samite Censer-Bearer"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "prevents 1 damage to each creature you control: Hill Giant survives a 3-damage Lightning Bolt",
    "players": [
      {
        "battlefield": [
          "Samite Censer-Bearer",
          "Hill Giant",
          "Plains"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Samite Censer-Bearer"
      },
      {
        "resolve": true
      },
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Hill Giant"
        ],
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Hill Giant"
          ]
        },
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        }
      ]
    }
  },
  {
    "name": "shields are set up only on creatures present on resolution: a creature cast afterwards is not protected",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Samite Censer-Bearer", "Hill Giant", "Plains", "Forest", "Forest"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "activate": "Samite Censer-Bearer" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: each creature gets its own 1-point shield: Pyroclasm (2 to each creature) deals 1 to each survivor",
    "players": [
      { "hand": ["Pyroclasm"], "battlefield": ["Samite Censer-Bearer", "Grizzly Bears", "Hill Giant", "Plains", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Samite Censer-Bearer" },
      { "resolve": true },
      { "cast": "Pyroclasm" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears", "Hill Giant"], "battlefield_lacks": ["Samite Censer-Bearer"] }, {} ]
    }
  }
]
