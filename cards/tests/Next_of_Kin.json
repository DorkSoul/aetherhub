[
  {
    "name": "enchanted creature dies: put a lesser creature from hand, Next of Kin returns attached at end step",
    "players": [
      {
        "hand": ["Next of Kin", "Llanowar Elves"],
        "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"]
      },
      {
        "hand": ["Shock"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Next of Kin", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": ["Llanowar Elves"] },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Llanowar Elves", "Next of Kin"], "graveyard": ["Grizzly Bears"] },
        { "graveyard": ["Shock"] }
      ],
      "attached": { "Next of Kin": "Llanowar Elves" }
    }
  },
  {
    "name": "no creature in hand with lesser mana value: nothing enters",
    "players": [
      {
        "hand": ["Next of Kin", "Serra Angel"],
