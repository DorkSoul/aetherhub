      },
      {
        "hand": ["Shock"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Next of Kin", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Serra Angel"], "graveyard": ["Next of Kin", "Grizzly Bears"] },
        { "graveyard": ["Shock"] }
      ]
    }
  },
  {
    "name": "declining to put a creature leaves the hand alone and Next of Kin stays in the graveyard",
    "players": [
      {
        "hand": ["Next of Kin", "Llanowar Elves"],
        "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"]
      },
      {
        "hand": ["Shock"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Next of Kin", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [] },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Llanowar Elves"], "graveyard": ["Next of Kin", "Grizzly Bears"] },
        { "graveyard": ["Shock"] }
      ]
