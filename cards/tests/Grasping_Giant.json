[
  { "name": "blocking creature is exiled until the Giant leaves the battlefield",
    "players": [ { "battlefield": ["Grasping Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Grasping Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grasping Giant" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grasping Giant"] }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "no block, no trigger",
    "players": [ { "battlefield": ["Grasping Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Grasping Giant", "at": "p1" } ] }, { "block": [] } ],
    "expect": { "players": [ {}, { "battlefield": ["Grizzly Bears"], "exile": [] } ] } },
  { "name": "ruling: each blocker triggers the ability and is exiled",
    "players": [ { "battlefield": ["Grasping Giant"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Grasping Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grasping Giant" }, { "blocker": "Llanowar Elves", "attacker": "Grasping Giant" } ] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grasping Giant"] }, { "exile": ["Grizzly Bears", "Llanowar Elves"] } ] } },
  { "name": "ruling: the exiled blocker does not make the Giant unblocked (no damage without trample)",
    "players": [ { "battlefield": ["Grasping Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Grasping Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grasping Giant" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grasping Giant"] }, { "life": 20, "exile": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard",
    "players": [ { "hand": ["Holy Strength"], "battlefield": ["Grasping Giant", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Holy Strength", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grasping Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grasping Giant" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grasping Giant"], "graveyard": ["Holy Strength"] }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "ruling: if the Giant leaves before its trigger resolves, the blocker is not exiled",
    "players": [ { "battlefield": ["Grasping Giant"] }, { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Grasping Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grasping Giant" } ] }, { "pass": true }, { "cast": "Swords to Plowshares", "player": 1, "targets": ["Grasping Giant"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grasping Giant"] }, { "battlefield_has": ["Grizzly Bears"], "exile": [] } ] } }
]
