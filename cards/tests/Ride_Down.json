[
  {
    "name": "destroys the blocker and the creature it blocked gains trample",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain", "Plains"], "hand": ["Ride Down"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }] },
      { "cast": "Ride Down", "player": 0, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "graveyard": ["Ride Down"] }, { "life": 18, "graveyard": ["Hill Giant"] }]
    }
  },
  {
    "name": "only the creatures blocked by the destroyed blocker gain trample",
    "players": [
      { "battlefield": ["Grizzly Bears", "Llanowar Elves", "Mountain", "Plains"], "hand": ["Ride Down"] },
      { "battlefield": ["Hill Giant", "Wall of Wood"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" }] },
      {
        "block": [
          { "blocker": "Hill Giant", "attacker": "Grizzly Bears" },
          { "blocker": "Wall of Wood", "attacker": "Llanowar Elves" }
        ]
      },
      { "cast": "Ride Down", "player": 0, "targets": ["Wall of Wood"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Llanowar Elves"], "graveyard": ["Grizzly Bears", "Ride Down"] }, { "life": 19, "battlefield_has": ["Hill Giant"], "graveyard": ["Wall of Wood"] }]
    }
  },
  {
    "name": "ruling: a creature blocked by two stays blocked when one blocker is destroyed (no damage to the player)",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain", "Plains"], "hand": ["Ride Down"] },
      { "battlefield": ["Hill Giant", "Wall of Wood"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      {
        "block": [
          { "blocker": "Hill Giant", "attacker": "Grizzly Bears" },
          { "blocker": "Wall of Wood", "attacker": "Grizzly Bears" }
        ]
      },
      { "cast": "Ride Down", "player": 0, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "graveyard": ["Ride Down"] }, { "life": 20, "battlefield_has": ["Wall of Wood"], "graveyard": ["Hill Giant"] }]
