    "hand": ["Lightning Bolt"],
    "battlefield": ["Mountain", "Celestial Gatekeeper"],
    "graveyard": ["Celestial Messenger"]
   },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Celestial Gatekeeper"] },
