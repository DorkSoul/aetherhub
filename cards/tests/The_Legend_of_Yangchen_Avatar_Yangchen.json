[
  {
    "name": "chapter I: each player chooses a permanent with mana value 3+ an opponent controls; those are exiled",
    "players": [
      { "hand": ["The Legend of Yangchen // Avatar Yangchen"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Serra Angel", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "The Legend of Yangchen // Avatar Yangchen" },
      { "resolve": true, "answers": [["Serra Angel"], []] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["The Legend of Yangchen // Avatar Yangchen"] },
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "chapter I: opponent's only permanent has mana value below 3, so nothing is exiled",
    "players": [
      { "hand": ["The Legend of Yangchen // Avatar Yangchen"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "The Legend of Yangchen // Avatar Yangchen" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["The Legend of Yangchen // Avatar Yangchen"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "chapter II: target opponent draws three and you draw three when you accept",
    "players": [
      { "battlefield": [{ "name": "The Legend of Yangchen // Avatar Yangchen", "counters": { "lore": 1 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 4 },
        { "hand_count": 4 }
      ]
    }
  },
  {
    "name": "chapter II: declining the optional draw leaves only the turn draw",
    "players": [
      { "battlefield": [{ "name": "The Legend of Yangchen // Avatar Yangchen", "counters": { "lore": 1 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        { "hand_count": 1 }
      ]
    }
  },
  {
    "name": "chapter III exiles the Saga and returns it transformed as Avatar Yangchen",
    "players": [
      { "battlefield": [{ "name": "The Legend of Yangchen // Avatar Yangchen", "counters": { "lore": 2 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Avatar Yangchen"], "battlefield_lacks": ["The Legend of Yangchen // Avatar Yangchen"] },
        {}
      ],
      "pt": { "Avatar Yangchen": [4, 5] }
    }
  },
  {
    "name": "second spell each turn airbends the chosen nonland permanent; the first spell does not",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Avatar Yangchen", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "exile": ["Grizzly Bears"], "life": 14 }
      ]
    }
  },
  {
    "name": "second spell with no chosen target (up to one) airbends nothing",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Avatar Yangchen", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield_has": ["Grizzly Bears"], "life": 14 }
      ]
    }
  },
  {
    "name": "ruling: both players' chosen permanents are exiled together",
    "players": [{ "hand": ["The Legend of Yangchen // Avatar Yangchen"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Hill Giant"] }, { "battlefield": ["Serra Angel"] }],
    "steps": [{ "cast": "The Legend of Yangchen // Avatar Yangchen" }, { "resolve": true, "answers": [["Serra Angel"], ["Hill Giant"]] }],
    "expect": { "players": [{ "battlefield_lacks": ["Hill Giant"], "exile": ["Hill Giant"] }, { "battlefield_lacks": ["Serra Angel"], "exile": ["Serra Angel"] }] }
  }
]
