[
  {
    "name": "when it dies, return another artifact card from your graveyard to hand",
    "players": [
      { "battlefield": ["Workshop Assistant"], "graveyard": ["Workhorse"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Workshop Assistant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Workhorse"], "graveyard_has": ["Workshop Assistant"] },
        { "graveyard": ["Shock"] }
      ]
    }
  },
  {
    "name": "does not return itself when it is the only artifact in the graveyard",
    "players": [
      { "battlefield": ["Workshop Assistant"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Workshop Assistant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Workshop Assistant"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an artifact dying at the same time can be the target of its dies trigger",
    "players": [
      { "hand": ["Wrath of God"], "battlefield": ["Workshop Assistant", "Ornithopter", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Wrath of God" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Ornithopter"], "graveyard_has": ["Workshop Assistant"] },
        {}
      ]
    }
  }
]
