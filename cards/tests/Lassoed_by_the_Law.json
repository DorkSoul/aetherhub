[
  { "name": "exiles an opposing creature and makes a Mercenary",
    "players": [ { "hand": ["Lassoed by the Law"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lassoed by the Law" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Lassoed by the Law", "Mercenary 1-1"] }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "only nonland permanents can be exiled",
    "players": [ { "hand": ["Lassoed by the Law"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Forest", "Serra Angel"] } ],
    "steps": [ { "cast": "Lassoed by the Law" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Lassoed by the Law"] }, { "exile": ["Serra Angel"], "battlefield_has": ["Forest"] } ] } },
  { "name": "ruling: leaving before the exile trigger resolves means nothing is exiled",
    "players": [ { "hand": ["Lassoed by the Law"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Disenchant"], "battlefield": ["Grizzly Bears", "Plains", "Plains"] } ],
    "steps": [ { "cast": "Lassoed by the Law" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Disenchant", "player": 1, "targets": ["Lassoed by the Law"] }, { "pass": true, "player": 1 }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lassoed by the Law"], "battlefield_has": ["Mercenary 1-1"] }, { "graveyard_has": ["Disenchant"], "battlefield_has": ["Grizzly Bears"] } ] } }
]
