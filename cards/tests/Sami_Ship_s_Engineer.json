  {
    "name": "one tapped creature is not enough",
    "players": [{ "battlefield": ["Sami, Ship's Engineer", "Grizzly Bears", "Hill Giant"] }, {}],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
