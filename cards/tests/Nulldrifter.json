  "name": "ruling: annihilator resolves in declare attackers, so a sacrificed Storm Crow cannot block",
  "players": [ { "battlefield": ["Nulldrifter"] }, { "battlefield": ["Storm Crow"] } ],
  "steps": [ { "attack": [ { "card": "Nulldrifter", "at": "p1" } ] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 16, "battlefield_lacks": ["Storm Crow"] } ] }
 },
 {
  "name": "ruling: an evoked Nulldrifter has mana value 7 (its mana cost), so the revealed copy can be cast free",
  "players": [ { "battlefield": ["Powerbalance"], "library": ["Nulldrifter"] }, { "hand": ["Nulldrifter"], "battlefield": ["Island", "Forest", "Forest"] } ],
  "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Nulldrifter", "player": 1, "alt": 0 }, { "resolve": true, "answers": [true, true] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Powerbalance", "Nulldrifter"] }, { "graveyard": ["Nulldrifter"] } ] }
