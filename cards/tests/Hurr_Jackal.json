[
  {
    "name": "tap: target creature can't be regenerated this turn, so Murder destroys it",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", { "name": "Hurr Jackal", "sick": false }] },
      { "battlefield": ["Swamp", "Drudge Skeletons"] }
    ],
    "steps": [
      { "activate": "Hurr Jackal", "ability": 0, "targets": ["Drudge Skeletons"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Drudge Skeletons", "player": 1, "ability": 0 },
      { "resolve": true },
      { "cast": "Murder", "targets": ["Drudge Skeletons"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Murder"] },
        { "graveyard": ["Drudge Skeletons"] }
      ]
    }
  },
  {
    "name": "a tapped Hurr Jackal cannot activate again",
    "players": [
      { "battlefield": ["Swamp", { "name": "Hurr Jackal", "sick": false }] },
      { "battlefield": ["Swamp", "Drudge Skeletons"] }
    ],
    "steps": [
      { "activate": "Hurr Jackal", "ability": 0, "targets": ["Drudge Skeletons"] },
      { "resolve": true },
      { "activate": "Hurr Jackal", "ability": 0, "targets": ["Drudge Skeletons"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Drudge Skeletons"] } ]
    }
  }
]
