[
  { "name": "target player shuffles their graveyard into their library, then you draw",
    "players": [ { "hand": ["Learn from the Past"], "battlefield": ["Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Learn from the Past", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Learn from the Past"], "library_count": 21 }, {} ] } },
  { "name": "opponent's graveyard shuffles into their library; you still draw",
    "players": [ { "hand": ["Learn from the Past"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "graveyard": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Learn from the Past", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, { "graveyard": [], "library_count": 21 } ] } },
  { "name": "ruling: empty target graveyard: the library is still shuffled and you still draw",
    "players": [ { "hand": ["Learn from the Past"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Learn from the Past", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Learn from the Past"] }, { "library_count": 20 } ] } }
