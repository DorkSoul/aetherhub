[
  {
    "name": "pumps your creature, then it deals damage equal to its new power",
    "players": [
      { "hand": ["Ambuscade"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Ambuscade", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Hill Giant"] } ],
      "pt": { "Grizzly Bears": [3, 2] }
    }
  },
  {
    "name": "damage is 2 when the creature is not pumped above its power",
    "players": [
      { "hand": ["Ambuscade"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Alpine Watchdog"] }
    ],
    "steps": [
      { "cast": "Ambuscade", "targets": ["Grizzly Bears", "Alpine Watchdog"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard_has": ["Alpine Watchdog"] } ]
    }
  },
  {
    "name": "ruling: if your creature leaves in response, Ambuscade deals no damage",
    "players": [
      { "hand": ["Ambuscade"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Alpine Watchdog"] }
    ],
    "steps": [
      { "cast": "Ambuscade", "targets": ["Grizzly Bears", "Alpine Watchdog"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "battlefield_has": ["Alpine Watchdog"] } ]
    }
  },
  {
    "name": "ruling: if the opponent's creature leaves in response, your creature still gets +1/+0",
    "players": [
      { "hand": ["Ambuscade"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Alpine Watchdog"] }
    ],
    "steps": [
      { "cast": "Ambuscade", "targets": ["Grizzly Bears", "Alpine Watchdog"] },
      { "cast": "Lightning Bolt", "targets": ["Alpine Watchdog"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Alpine Watchdog"] } ],
      "pt": { "Grizzly Bears": [3, 2] }
    }
  }
]
