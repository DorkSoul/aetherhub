[
  {
    "name": "sacrificing a mana value 1 artifact exiles the top 2 cards",
    "players": [
      {
        "battlefield": ["Memorial Vault", "Sol Ring"],
        "library": ["Serra Angel", "Grizzly Bears", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      { "activate": "Memorial Vault", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Memorial Vault"],
          "graveyard": ["Sol Ring"],
          "exile": ["Serra Angel", "Grizzly Bears"],
          "library_count": 21
        },
        {}
      ]
    }
  },
  {
    "name": "the exiled cards can be played this turn",
    "players": [
      {
        "battlefield": ["Memorial Vault", "Sol Ring", "Plains", "Plains", "Plains", "Plains", "Plains"],
        "library": ["Serra Angel", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "Memorial Vault", "ability": 0 },
      { "resolve": true },
      { "cast": "Serra Angel" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Memorial Vault", "Serra Angel"], "exile": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "with no other artifact to sacrifice the ability can't be activated",
    "players": [
      {
        "battlefield": ["Memorial Vault"]
      },
      {}
    ],
    "steps": [
      { "activate": "Memorial Vault", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Memorial Vault"] }, {}]
    }
  },
  {
    "name": "ruling: a sacrificed artifact with {X} in its cost has mana value 0, so only the top card is exiled",
    "players": [
      {
        "battlefield": ["Memorial Vault", "Chalice of the Void"],
        "library": ["Grizzly Bears", "Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Memorial Vault", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Memorial Vault"], "graveyard": ["Chalice of the Void"], "exile": ["Grizzly Bears"], "library_top": ["Island"] },
        {}
      ]
    }
  }
]
