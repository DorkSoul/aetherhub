[
  { "name": "when it dies, create a 1/1 Phyrexian Mite with toxic 1 that can't block",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Stinging Hivemaster"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Stinging Hivemaster"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Stinging Hivemaster"], "battlefield_has": ["Phyrexian Mite 1-1 Toxic"] }, {} ] } },
  { "name": "toxic 1: combat damage to a player gives a poison counter",
    "players": [ { "battlefield": ["Stinging Hivemaster"] }, {} ],
    "steps": [ { "attack": [{ "card": "Stinging Hivemaster", "at": "p1" }] }, { "advance_to": "End" } ],
    "expect": { "players": [ {}, { "life": 17, "poison": 1 } ] } },
  { "name": "ruling: a player with ten poison counters loses the game (state-based action)",
    "players": [ { "battlefield": ["Stinging Hivemaster"] }, { "poison": 9 } ],
    "steps": [ { "attack": [{ "card": "Stinging Hivemaster", "at": "p1" }] }, { "advance_to": "End" } ],
    "expect": { "winner": 0 } },
  { "name": "ruling: combat damage dealt to a creature gives no poison counters",
    "players": [ { "battlefield": ["Stinging Hivemaster"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [{ "card": "Stinging Hivemaster", "at": "p1" }] },
              { "block": [{ "blocker": "Grizzly Bears", "attacker": "Stinging Hivemaster" }], "player": 1 },
              { "advance_to": "End" } ],
    "expect": { "players": [ {}, { "life": 20, "poison": 0 } ] } },
  { "name": "ruling: Vorinclex doubles the poison counters toxic gives (I put them)",
    "players": [ { "battlefield": ["Vorinclex, Monstrous Raider", "Stinging Hivemaster"] }, {} ],
    "steps": [ { "attack": [{ "card": "Stinging Hivemaster", "at": "p1" }] }, { "advance_to": "End" } ],
    "expect": { "players": [ {}, { "life": 17, "poison": 2 } ] } },
  { "name": "ruling: Vorinclex halves an opponent's toxic poison counters, rounded down (1 becomes 0)",
    "players": [ { "battlefield": ["Vorinclex, Monstrous Raider"] }, { "battlefield": ["Stinging Hivemaster"] } ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Main1" },
              { "attack": [{ "card": "Stinging Hivemaster", "at": "p0" }], "player": 1 },
              { "block": [], "player": 0 },
              { "advance_to": "End" } ],
    "expect": { "players": [ { "life": 17, "poison": 0 }, {} ] } }
]
