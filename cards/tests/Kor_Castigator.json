   "steps": [ { "cast": "Kor Castigator" }, { "resolve": true } ],
   "expect": { "pt": { "Kor Castigator": [3, 1] }, "players": [ { "battlefield_has": ["Kor Castigator"] }, { "battlefield_has": ["Eldrazi Scion"] } ] } },
