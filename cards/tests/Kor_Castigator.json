   "players": [ { "battlefield": ["Kor Castigator"] }, { "battlefield": ["Eldrazi Scion"] } ],
   "steps": [ { "attack": [ { "card": "Kor Castigator", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Kor Castigator"] }, { "life": 17, "battlefield_has": ["Eldrazi Scion"] } ] } },
 { "name": "a Scion that blocks it is dropped: the 3/1 is unblocked, the Bears are blocked by the Giant",
   "players": [ { "battlefield": ["Kor Castigator", "Grizzly Bears"] }, { "battlefield": ["Eldrazi Scion", "Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Kor Castigator", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Eldrazi Scion", "attacker": "Kor Castigator" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Kor Castigator"] }, { "life": 17, "battlefield_has": ["Eldrazi Scion", "Hill Giant"] } ] } },
 { "name": "ruling: an Eldrazi that is not a Scion can block it; the Spawn blocks and no damage gets through",
   "players": [ { "battlefield": ["Kor Castigator"] }, { "battlefield": ["Eldrazi Spawn"] } ],
   "steps": [ { "attack": [ { "card": "Kor Castigator", "at": "p1" } ] }, { "block": [ { "blocker": "Eldrazi Spawn", "attacker": "Kor Castigator" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Kor Castigator"] }, { "life": 20 } ] } }
