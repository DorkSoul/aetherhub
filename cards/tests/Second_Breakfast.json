  {
    "name": "up to two: zero targets still creates a Food",
    "players": [ { "hand": ["Second Breakfast"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Second Breakfast", "targets": [] },
      { "resolve": true }
