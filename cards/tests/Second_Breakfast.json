  {
    "name": "ruling: if every target is illegal on resolution, no Food is created",
    "players": [ { "hand": ["Second Breakfast"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
