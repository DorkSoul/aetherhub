      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Food", "Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ] }
  }
