[
  {
    "name": "X=2 deals 4 damage to each of two targets",
    "players": [
      { "hand": ["Meteor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Meteor Blast", "targets": ["p1", "Grizzly Bears"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Meteor Blast"] },
        { "life": 16, "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "X=1 hits exactly one target for 4",
    "players": [
      { "hand": ["Meteor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Meteor Blast", "targets": ["p1"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 16 }
      ]
    }
  },
  {
    "name": "ruling: cannot target the same permanent more than once",
    "players": [
      { "hand": ["Meteor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Meteor Blast", "targets": ["Grizzly Bears", "Grizzly Bears"], "answers": [2], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Meteor Blast"] },
        { "life": 20, "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: if one target became illegal, the remaining targets are still dealt damage",
    "players": [
      { "hand": ["Meteor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Meteor Blast", "targets": ["p1", "Grizzly Bears"], "answers": [2] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Meteor Blast"] },
        { "life": 16, "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]
