[
 {
  "name": "dash: haste, then returned to hand at the next end step",
  "players": [
   {
    "hand": [
     "Zurgo Bellstriker"
    ],
    "battlefield": [
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Zurgo Bellstriker",
    "alt": 0
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Zurgo Bellstriker"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "normal cast stays on the battlefield",
  "players": [
   {
    "hand": [
     "Zurgo Bellstriker"
    ],
    "battlefield": [
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Zurgo Bellstriker"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Zurgo Bellstriker"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "Zurgo can't block a power 2 attacker: the Bears connect for 2",
  "players": [ { "battlefield": ["Zurgo Bellstriker", "Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
  "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Llanowar Elves", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Zurgo Bellstriker", "attacker": "Grizzly Bears" }, { "blocker": "Hill Giant", "attacker": "Llanowar Elves" } ], "player": 0 }, { "advance_to": "Main2", "player": 1 } ],
  "expect": { "players": [ { "life": 18 }, {} ] }
 },
 {
  "name": "Zurgo can still block a power 1 attacker",
  "players": [ { "battlefield": ["Zurgo Bellstriker"] }, { "battlefield": ["Llanowar Elves"] } ],
  "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "attack": [ { "card": "Llanowar Elves", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Zurgo Bellstriker", "attacker": "Llanowar Elves" } ], "player": 0 }, { "advance_to": "Main2", "player": 1 } ],
  "expect": { "players": [ { "life": 20 }, {} ] }
 },
 {
  "name": "ruling: dash creature that dies before the end step stays in the graveyard",
  "players": [ { "hand": ["Zurgo Bellstriker", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
  "steps": [ { "cast": "Zurgo Bellstriker", "alt": 0 }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Zurgo Bellstriker"] }, { "resolve": true }, { "advance_to": "End" } ],
  "expect": { "players": [ { "graveyard_has": ["Zurgo Bellstriker", "Lightning Bolt"], "battlefield_lacks": ["Zurgo Bellstriker"], "hand_count": 0 }, {} ] }
 },
 {
  "name": "ruling: dash cast can be responded to and countered",
  "players": [ { "hand": ["Zurgo Bellstriker"], "battlefield": ["Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
  "steps": [ { "cast": "Zurgo Bellstriker", "alt": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Zurgo Bellstriker" }] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard_has": ["Zurgo Bellstriker"], "battlefield_lacks": ["Zurgo Bellstriker"] }, { "graveyard_has": ["Counterspell"] } ] }
 },
 {
  "name": "ruling: two differently named Zurgos do not trigger the legend rule",
  "players": [ { "battlefield": ["Zurgo Bellstriker", "Zurgo Helmsmasher"] }, {} ],
  "steps": [ { "advance_to": "Main1" } ],
  "expect": { "players": [ { "battlefield_has": ["Zurgo Bellstriker", "Zurgo Helmsmasher"] }, {} ] }
 }
]