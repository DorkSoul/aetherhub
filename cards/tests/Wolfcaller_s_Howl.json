[
  {
    "name": "opponent with four cards at your upkeep (3 in hand + turn draw): one Wolf",
    "players": [
      { "battlefield": ["Wolfcaller's Howl", "Forest"] },
      { "hand": ["Forest", "Forest", "Forest"] }
    ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield": ["Wolfcaller's Howl", "Forest", "Wolf 2-2"] }, { "hand_count": 4 } ]
    }
  },
  {
    "name": "opponent with three cards at your upkeep: no Wolf",
    "players": [
      { "battlefield": ["Wolfcaller's Howl", "Forest"] },
      { "hand": ["Forest", "Forest"] }
    ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield": ["Wolfcaller's Howl", "Forest"] }, { "hand_count": 3 } ]
    }
  },
  {
    "name": "opponent with six cards at your upkeep: still exactly one Wolf",
    "players": [
      { "battlefield": ["Wolfcaller's Howl", "Forest"] },
      { "hand": ["Forest", "Forest", "Forest", "Forest", "Forest"] }
    ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield": ["Wolfcaller's Howl", "Forest", "Wolf 2-2"] }, { "hand_count": 6 } ]
    }
  },
  {
    "name": "ruling: X is counted as the ability resolves (opponent drops to three cards in response, no Wolf)",
    "players": [
      { "battlefield": ["Wolfcaller's Howl", "Forest"] },
      { "battlefield": ["Mountain"], "hand": ["Lightning Bolt", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "advance_to": "Upkeep", "hold": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Wolf 2-2"], "life": 17 },
        { "hand_count": 3 }
      ]
    }
  }
]
