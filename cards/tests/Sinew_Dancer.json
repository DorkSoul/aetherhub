    "steps": [
      { "activate": "Sinew Dancer", "ability": 1, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "players": [{}, { "battlefield_has": ["Grizzly Bears"] }] }
  },
  {
    "name": "corrupted: with three poison counters on an opponent, {W},{T} taps target creature",
    "players": [ { "battlefield": ["Sinew Dancer", "Plains"] }, { "poison": 3, "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Sinew Dancer", "ability": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true }, "players": [{}, { "poison": 3 }] }
  },
  {
    "name": "corrupted: two poison counters is not enough",
    "players": [ { "battlefield": ["Sinew Dancer", "Plains"] }, { "poison": 2, "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Sinew Dancer", "ability": 1, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "players": [{}, { "poison": 2, "battlefield_has": ["Grizzly Bears"] }] }
  }
