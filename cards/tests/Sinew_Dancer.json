[
  {
    "name": "{3}{W}, {T}: taps target creature",
    "players": [ { "battlefield": ["Sinew Dancer", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Sinew Dancer", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true }, "players": [{}, {}] }
  },
  {
    "name": "corrupted ability is not available without three poison counters",
