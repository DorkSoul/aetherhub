[
  {
    "name": "opponent's creature is exiled and copied for me",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"], "hand": ["Fractured Identity"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Fractured Identity", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Hill Giant"] }, { "battlefield_lacks": ["Hill Giant"], "exile": ["Hill Giant"] }]
    }
  },
  {
    "name": "my permanent is exiled and the opponent gets the copy",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Island", "Island", "Hill Giant"], "hand": ["Fractured Identity"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Fractured Identity", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Hill Giant"] }, { "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: the token copy's enters-the-battlefield ability triggers (Mulldrifter draws two for me)",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"], "hand": ["Fractured Identity"] },
      { "battlefield": ["Mulldrifter"] }
    ],
    "steps": [
      { "cast": "Fractured Identity", "targets": ["Mulldrifter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Mulldrifter"], "hand_count": 2 }, { "battlefield_lacks": ["Mulldrifter"] }]
    }
  },
  {
    "name": "ruling: the token copy has the printed characteristics only (not tapped status or counters)",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"], "hand": ["Fractured Identity"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true, "counters": { "p1p1": 1 } }] }
    ],
    "steps": [
      { "cast": "Fractured Identity", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "tapped": { "Grizzly Bears": false },
      "counters": { "Grizzly Bears": { "p1p1": 0 } },
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: a copied token with {X} in its cost enters with X = 0 and dies (Walking Ballista)",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"], "hand": ["Fractured Identity"] },
      { "battlefield": [{ "name": "Walking Ballista", "counters": { "p1p1": 4 } }] }
    ],
    "steps": [
      { "cast": "Fractured Identity", "targets": ["Walking Ballista"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Walking Ballista"] }, { "battlefield_lacks": ["Walking Ballista"] }]
    }
  },
  {
    "name": "ruling: a copied token copies the original characteristics of the token (1/1 Soldier)",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"], "hand": ["Fractured Identity"] },
      { "battlefield": ["Soldier"] }
    ],
    "steps": [
      { "cast": "Fractured Identity", "targets": ["Soldier"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Soldier": [1, 1] },
      "players": [{ "battlefield_has": ["Soldier"] }, { "battlefield_lacks": ["Soldier"] }]
    }
  }
]
