[
  {
    "name": "X=2 redirects 2 of a Lightning Bolt's 3 damage to the other target",
    "players": [ { "hand": ["Captain's Maneuver", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Captain's Maneuver", "targets": ["Grizzly Bears", "p1"], "answers": [2] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "life": 18 } ] }
  },
  {
    "name": "X=0 redirects nothing",
    "players": [ { "hand": ["Captain's Maneuver", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Plains", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Captain's Maneuver", "targets": ["Grizzly Bears", "p1"], "answers": [0] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "life": 20 } ] }
  },
  {
    "name": "X=3 redirects all of the Bolt's damage onto the opposing creature",
    "players": [ { "hand": ["Captain's Maneuver", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Captain's Maneuver", "targets": ["Grizzly Bears", "Hill Giant"], "answers": [3] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Hill Giant"] } ] }
  },
  {
    "name": "ruling: if the second target is gone, the redirected damage is dealt to the first target as if not redirected",
    "players": [ { "hand": ["Captain's Maneuver", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Captain's Maneuver", "targets": ["Grizzly Bears", "Hill Giant"], "answers": [2] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "life": 20 } ] }
  }
]
