[
  { "name": "extort: paying {W/B} drains one life from each opponent",
    "players": [ { "hand": ["Shock"], "battlefield": ["Basilica Guards", "Mountain", "Plains"] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true, "answers": [true], "auto": true } ],
    "expect": { "players": [ { "life": 21 }, { "life": 17 } ] } },
  { "name": "extort: declining to pay leaves life totals alone apart from Shock",
    "players": [ { "hand": ["Shock"], "battlefield": ["Basilica Guards", "Mountain", "Plains"] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true, "answers": [false], "auto": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
  { "name": "ruling: extort resolves before a countered spell and still drains",
    "players": [ { "hand": ["Shock"], "battlefield": ["Basilica Guards", "Mountain", "Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Shock" }] }, { "resolve": true, "answers": [true], "auto": true } ],
    "expect": { "players": [ { "life": 21, "graveyard_has": ["Shock"] }, { "life": 19, "graveyard_has": ["Counterspell"] } ] } },
  { "name": "ruling: extort gains nothing when the opponent's life total cannot change",
    "players": [ { "hand": ["Shock"], "battlefield": ["Basilica Guards", "Mountain", "Plains"] }, { "battlefield": ["Platinum Emperion"] } ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true, "answers": [true], "auto": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "ruling: each extort trigger is paid separately (one paid, one declined)",
    "players": [ { "hand": ["Shock"], "battlefield": ["Basilica Guards", "Basilica Guards", "Mountain", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true, "answers": [true, false], "auto": true } ],
    "expect": { "players": [ { "life": 21 }, { "life": 17 } ] } }
]
