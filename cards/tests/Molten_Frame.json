[
  {
    "name": "destroys target artifact creature",
    "players": [
      { "hand": ["Molten Frame"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Ornithopter"] }
    ],
    "steps": [
      { "cast": "Molten Frame" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Molten Frame"] }, { "graveyard_has": ["Ornithopter"] } ]
    }
  },
  {
    "name": "cycling {2}: discard it and draw a card",
    "players": [
      { "hand": ["Molten Frame"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Molten Frame", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Molten Frame"], "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "ruling: a creature that is not an artifact is not a legal target",
    "players": [
      { "hand": ["Molten Frame"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Molten Frame", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Molten Frame"] }, {} ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]
