[
  {
    "name": "enchanted land becomes an Island",
    "players": [
      {
        "hand": [
          "Lingering Mirage"
        ],
        "battlefield": [
          "Island",
          "Swamp",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lingering Mirage",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      },
      {
        "tap_for_mana": "Forest",
        "color": "U"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "cycling for {2} draws a card",
    "players": [
      {
        "hand": [
          "Lingering Mirage"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lingering Mirage"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lingering Mirage"
          ],
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "enchanted Forest is an Island; an unenchanted Swamp is not",
    "players": [
      { "hand": ["Lingering Mirage"], "battlefield": ["Island", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Lingering Mirage", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Forest"] }, {} ],
      "subtypes": { "Forest": ["Island"] },
      "not_subtypes": { "Swamp": ["Island"] }
    }
  },
  {
    "name": "ruling: Stifle can counter the cycling ability; no card is drawn",
    "players": [
      { "hand": ["Lingering Mirage"], "battlefield": ["Island", "Island"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Lingering Mirage" },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Lingering Mirage" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lingering Mirage"], "hand_count": 0, "library_count": 20 },
        { "graveyard": ["Stifle"] }
      ]
    }
  }
]
