[
  {
    "name": "an activated ability costs {2} more: can't pay with only one mana",
    "players": [
      { "battlefield": ["Suppression Field", "Prodigal Sorcerer", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Prodigal Sorcerer", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [{}, { "life": 20 }], "tapped": { "Prodigal Sorcerer": false } }
  },
  {
    "name": "an activated ability costs {2} more: paid with two extra mana",
    "players": [
      { "battlefield": ["Suppression Field", "Prodigal Sorcerer", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Prodigal Sorcerer", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "life": 19 }], "tapped": { "Prodigal Sorcerer": true } }
  },
  {
    "name": "mana abilities are not affected",
    "players": [
      { "hand": ["Prodigal Sorcerer"], "battlefield": ["Suppression Field", "Sol Ring", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Prodigal Sorcerer" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Prodigal Sorcerer", "Sol Ring"] }, {}] }
  },
  {
    "name": "ruling: cycling (an activated ability with a colon in its reminder text) costs {2} more",
    "players": [
      { "hand": ["Brand"], "battlefield": ["Suppression Field", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Brand", "ability": 0, "illegal": true }
    ],
    "expect": { "players": [{ "hand": ["Brand"], "battlefield_has": ["Suppression Field"] }, {}] }
  },
  {
    "name": "ruling: cycling with four mana (two base plus two from Suppression Field) draws a card",
    "players": [
      { "hand": ["Brand"], "battlefield": ["Suppression Field", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Brand", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "graveyard": ["Brand"], "hand_count": 1 }, {}] }
  }
]
