[
  { "name": "improvise: an artifact pays for one generic mana",
    "players": [ { "hand": ["Enraged Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Bonesplitter"] }, {} ],
    "steps": [ { "cast": "Enraged Giant", "answers": [["Bonesplitter"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Enraged Giant", "Bonesplitter"] }, {} ] } },
  { "name": "haste: can attack the turn it enters",
    "players": [ { "hand": ["Enraged Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Bonesplitter"] }, {} ],
    "steps": [ { "cast": "Enraged Giant", "answers": [["Bonesplitter"]] }, { "resolve": true }, { "attack": [ { "card": "Enraged Giant", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Enraged Giant"] }, { "life": 16 } ] } },
  { "name": "without an artifact to improvise it cannot be cast",
    "players": [ { "hand": ["Enraged Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Enraged Giant", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Enraged Giant"] }, {} ] } },
  { "name": "ruling: a tapped Bonesplitter (used for improvise) still gives the equipped creature +2/+0",
    "players": [ { "hand": ["Enraged Giant"], "battlefield": ["Grizzly Bears", "Bonesplitter", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Bonesplitter", "ability": 0 }, { "resolve": true }, { "cast": "Enraged Giant", "answers": [["Bonesplitter"]] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Enraged Giant", "Bonesplitter"] }, { "life": 16 } ], "pt": { "Grizzly Bears": [4, 2] } } },
  { "name": "ruling: an attacking creature does not tap its equipment, which can then pay for improvise",
    "players": [ { "hand": ["Enraged Giant"], "battlefield": ["Grizzly Bears", "Bonesplitter", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Bonesplitter", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" }, { "cast": "Enraged Giant", "answers": [["Bonesplitter"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Enraged Giant", "Bonesplitter"] }, { "life": 16 } ] } },
  { "name": "ruling: improvise cannot pay the {R} symbol (artifacts only reduce generic)",
    "players": [ { "hand": ["Enraged Giant"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Bonesplitter", "Greataxe"] }, {} ],
    "steps": [ { "cast": "Enraged Giant", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Enraged Giant"] }, {} ] } },
  { "name": "ruling: the same artifacts pay the generic part when a Mountain supplies {R}",
    "players": [ { "hand": ["Enraged Giant"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Mountain", "Bonesplitter", "Greataxe"] }, {} ],
    "steps": [ { "cast": "Enraged Giant", "answers": [["Bonesplitter", "Greataxe"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Enraged Giant"] }, {} ] } },
  { "name": "ruling: an improvise artifact is not a source for a counter-style unless payment",
    "players": [ { "hand": ["Wild Might"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Bonesplitter"] } ],
    "steps": [ { "cast": "Wild Might" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [7, 7] } } }
]
