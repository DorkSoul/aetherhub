[
  {
    "name": "target Zombie gets +2/+2 and fear while the Courier stays tapped",
    "players": [
      { "battlefield": ["Frightshroud Courier", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Diregraf Ghoul"] }
    ],
    "steps": [
      { "activate": "Frightshroud Courier", "ability": 0, "targets": ["Diregraf Ghoul"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Diregraf Ghoul": [4, 4] },
      "tapped": { "Frightshroud Courier": true }
    }
  },
  {
    "name": "keeping the Courier tapped keeps the bonus",
    "players": [
      { "battlefield": ["Frightshroud Courier", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Diregraf Ghoul"] }
    ],
    "steps": [
      { "activate": "Frightshroud Courier", "ability": 0, "targets": ["Diregraf Ghoul"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "turn": 4,
      "pt": { "Diregraf Ghoul": [4, 4] },
      "tapped": { "Frightshroud Courier": true }
    }
  },
  {
    "name": "untapping the Courier ends the bonus",
    "players": [
      { "battlefield": ["Frightshroud Courier", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Diregraf Ghoul"] }
    ],
    "steps": [
      { "activate": "Frightshroud Courier", "ability": 0, "targets": ["Diregraf Ghoul"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "turn": 4,
      "pt": { "Diregraf Ghoul": [2, 2] },
      "tapped": { "Frightshroud Courier": false }
    }
  },
  {
    "name": "ruling: the target must be a Zombie when the ability is announced",
    "players": [
      { "battlefield": ["Frightshroud Courier", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Diregraf Ghoul"] }
    ],
    "steps": [
      { "activate": "Frightshroud Courier", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true },
      { "activate": "Frightshroud Courier", "ability": 0, "targets": ["Diregraf Ghoul"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [2, 2], "Diregraf Ghoul": [4, 4] } }
  }
]
