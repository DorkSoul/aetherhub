[
  {
    "name": "destroys all creatures and makes an X/X Horror where X is the number destroyed",
    "players": [
      {
        "hand": ["Phyrexian Rebirth"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"]
      },
      { "battlefield": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Phyrexian Rebirth" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Phyrexian Horror 0-0 Colorless Artifact"], "battlefield_lacks": ["Grizzly Bears"] },
        { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }
      ],
      "pt": { "Phyrexian Horror 0-0 Colorless Artifact": [3, 3] }
    }
  },
  {
    "name": "no creatures destroyed: the 0/0 token dies immediately",
    "players": [
      { "hand": ["Phyrexian Rebirth"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Phyrexian Rebirth" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Phyrexian Horror 0-0 Colorless Artifact"] },
        {}
      ]
    }
  },
  {
    "name": "indestructible creatures are not destroyed and not counted",
    "players": [
      { "hand": ["Phyrexian Rebirth"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Darksteel Angel", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Phyrexian Rebirth" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Phyrexian Horror 0-0 Colorless Artifact"] },
        { "battlefield_has": ["Darksteel Angel"], "battlefield_lacks": ["Grizzly Bears"] }
      ],
      "pt": { "Phyrexian Horror 0-0 Colorless Artifact": [1, 1] }
    }
  },
  {
    "name": "ruling: a creature regenerated in response is not destroyed and not counted",
    "players": [
      { "hand": ["Phyrexian Rebirth"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Drudge Skeletons", "Swamp"] }
    ],
    "steps": [
      { "cast": "Phyrexian Rebirth" },
      { "pass": true },
      { "activate": "Drudge Skeletons", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Phyrexian Horror 0-0 Colorless Artifact"] },
        { "battlefield_has": ["Drudge Skeletons"] }
