[
  {
    "name": "draws a card at the end step when a player lost 4 or more life this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Y'shtola, Night's Blessed"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "life": 20 },
        { "life": 14 }
      ]
    }
  },
  {
    "name": "no draw when every player lost less than 4 life this turn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Y'shtola, Night's Blessed"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "life": 20 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "noncreature spell with mana value 3 or more drains 2 and gains 2",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Y'shtola, Night's Blessed"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22 },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: life lost after the end step began does not draw a card",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Y'shtola, Night's Blessed"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "life": 20 },
        { "life": 14 }
      ]
    }
  },
  {
    "name": "ruling: Y'shtola's drain still resolves when the triggering spell is countered",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Y'shtola, Night's Blessed"] },
      { "hand": ["Cancel"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Divination" },
      { "cast": "Cancel", "player": 1, "targets": [{ "stack": "Divination" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "graveyard": ["Divination"], "hand_count": 0 },
        { "life": 18, "graveyard": ["Cancel"] }
      ]
    }
  },
  {
    "name": "ruling: an X spell's mana value uses X (Fireball X=2 has mana value 3 and triggers)",
    "players": [
      { "hand": ["Fireball"], "battlefield": ["Mountain", "Mountain", "Mountain", "Y'shtola, Night's Blessed"] },
      {}
    ],
    "steps": [
      { "cast": "Fireball", "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22 },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "ruling: an X spell with X=1 has mana value 2 and does not trigger Y'shtola",
    "players": [
      { "hand": ["Fireball"], "battlefield": ["Mountain", "Mountain", "Y'shtola, Night's Blessed"] },
      {}
    ],
    "steps": [
      { "cast": "Fireball", "targets": ["p1"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 19 }
      ]
    }
  }
]
