[
  {
    "name": "sacrifice to destroy target Plains",
    "players": [
      { "battlefield": ["Boggart Arsonists", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Plains"] }
    ],
    "steps": [
      { "activate": "Boggart Arsonists", "ability": 0, "targets": ["Plains"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Boggart Arsonists"] },
        { "graveyard": ["Plains"] }
      ]
    }
  },
  {
    "name": "no Scarecrow or Plains to target: ability can't be activated",
    "players": [
      { "battlefield": ["Boggart Arsonists", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Boggart Arsonists", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Boggart Arsonists"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
