    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Arcades, the Strategist", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"], "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "defender creature attacks and assigns damage equal to its toughness",
    "players": [ { "battlefield": ["Arcades, the Strategist", "Angelic Wall"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Angelic Wall", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: Rabid Bite uses the defender's power (0), not its toughness",
    "players": [
      { "hand": ["Rabid Bite"], "battlefield": ["Arcades, the Strategist", "Angelic Wall", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Rabid Bite", "targets": ["Angelic Wall", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
