      "pt": { "Angelic Wall": [0, 4] }
    }
  },
  {
    "name": "ruling: Arcades leaves after the defender attacked, so it assigns damage by its power (0)",
    "players": [ { "hand": ["Doom Blade"], "battlefield": ["Arcades, the Strategist", "Angelic Wall", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Angelic Wall", "at": "p1" } ] },
      { "cast": "Doom Blade", "targets": ["Arcades, the Strategist"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Arcades, the Strategist"] }, { "life": 20 } ] }
