[
  {
    "name": "sacrifice itself to exile one of the top two cards of the opponent's library",
    "players": [
      { "battlefield": ["Thoughtpicker Witch", "Swamp"] },
      { "library": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Thoughtpicker Witch", "ability": 0, "targets": ["p1"] },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Thoughtpicker Witch"] }, { "exile": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "the controller chooses which of the two cards is exiled",
    "players": [
      { "battlefield": ["Thoughtpicker Witch", "Swamp"] },
      { "library": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Thoughtpicker Witch", "ability": 0, "targets": ["p1"] },
      { "resolve": true, "answers": ["Hill Giant"] }
    ],
    "expect": {
      "players": [{}, { "exile": ["Hill Giant"] }]
    }
  },
  {
    "name": "needs {1} to activate",
    "players": [
      { "battlefield": ["Thoughtpicker Witch"] },
      {}
    ],
    "steps": [
      { "activate": "Thoughtpicker Witch", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Thoughtpicker Witch"] }, {}]
    }
  }
]
