[
  {
    "name": "unblocked attacker's combat damage goes to the Bodyguards",
    "players": [ { "battlefield": ["Weathered Bodyguards"] }, { "battlefield": [{ "name": "Hill Giant", "sick": false }] } ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Hill Giant", "at": "p0" } ], "player": 1 }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, {} ] }
  },
  { "name": "can be cast face down as a 2/2 for {3}",
    "players": [ { "hand": ["Weathered Bodyguards"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Weathered Bodyguards", "alt": 254 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ], "pt": { "Weathered Bodyguards": [2, 2] } } },
  { "name": "turned face up for {3}{W} it is the 2/5 Bodyguards",
    "players": [ { "battlefield": ["Plains", "Plains", "Plains", "Plains", { "name": "Weathered Bodyguards", "face_down": true }] }, {} ],
    "steps": [ { "activate": "Weathered Bodyguards" }, { "resolve": true } ],
    "expect": { "pt": { "Weathered Bodyguards": [2, 5] } } },
  { "name": "ruling: noncombat damage (Lightning Bolt to you) is not redirected to the Bodyguards",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Weathered Bodyguards", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17, "battlefield_has": ["Weathered Bodyguards"] }, {} ] } },
  { "name": "ruling: trample excess from a blocked creature still hits you, not the Bodyguards",
    "players": [ { "battlefield": ["Weathered Bodyguards", "Grizzly Bears"] }, { "battlefield": [{ "name": "Bannerhide Krushok", "sick": false }] } ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Bannerhide Krushok", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Bannerhide Krushok" } ], "player": 0 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 18 }, {} ] } }
]
