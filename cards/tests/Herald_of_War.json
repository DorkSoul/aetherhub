[
  { "name": "attacking puts a +1/+1 counter on it",
    "players": [ { "battlefield": ["Herald of War"] }, {} ],
    "steps": [ { "attack": [ { "card": "Herald of War", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "counters": { "Herald of War": { "PlusOnePlusOne": 1 } }, "pt": { "Herald of War": [4, 4] } } },
  { "name": "Human spell costs {1} less per +1/+1 counter on Herald of War",
    "players": [ { "hand": ["Hero of Precinct One"], "battlefield": [ { "name": "Herald of War", "counters": { "PlusOnePlusOne": 2 } }, "Plains" ] }, {} ],
    "steps": [ { "cast": "Hero of Precinct One" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hero of Precinct One", "Herald of War"] }, {} ] } },
  { "name": "no counters means no reduction",
    "players": [ { "hand": ["Hero of Precinct One"], "battlefield": [ "Herald of War", "Plains" ] }, {} ],
    "steps": [ { "cast": "Hero of Precinct One", "illegal": true } ] },
  { "name": "non-Angel non-Human spells are not reduced",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "Herald of War", "counters": { "PlusOnePlusOne": 2 } }, "Forest" ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ] },
  { "name": "ruling: the cost reduction uses the total +1/+1 counters (one already there + one from attacking = 2): Serra Angel costs {1}{W}{W}",
    "players": [ { "hand": ["Serra Angel"], "battlefield": [ { "name": "Herald of War", "counters": { "PlusOnePlusOne": 1 } }, "Plains", "Plains", "Plains" ] }, {} ],
    "steps": [ { "attack": [ { "card": "Herald of War", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "cast": "Serra Angel" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Serra Angel", "Herald of War"] }, {} ] } },
  { "name": "ruling: with only the single counter from its attack, Serra Angel still costs {2}{W}{W} (illegal with three Plains)",
    "players": [ { "hand": ["Serra Angel"], "battlefield": ["Herald of War", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "attack": [ { "card": "Herald of War", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "cast": "Serra Angel", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Serra Angel"] }, {} ] } },
  { "name": "ruling: the attack counter is on Herald before combat damage (blocked by Serra Angel: Herald is 4/4 and kills Serra)",
    "players": [ { "battlefield": ["Herald of War"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "attack": [ { "card": "Herald of War", "at": "p1" } ] }, { "block": [ { "blocker": "Serra Angel", "attacker": "Herald of War" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Herald of War"] }, { "graveyard": ["Serra Angel"] } ] } }
]
