[
 {
  "name": "the upkeep untaps a tapped land you control",
  "players": [
   {
    "battlefield": [
     "Rising Waters",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Forest" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, {}],
   "tapped": { "Forest": false }
  }
 },
 {
  "name": "with no lands the upkeep trigger does nothing",
  "players": [
   {
    "battlefield": ["Rising Waters"]
   },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": {
   "players": [{}, {}]
  }
 },
 {
  "name": "lands don't untap in the untap step: a tapped Forest is still tapped at your upkeep, before the trigger resolves",
  "players": [
   { "battlefield": ["Rising Waters", "Forest", "Mountain"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Forest" },
   { "tap_for_mana": "Mountain" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep", "answers": [0] }
  ],
  "expect": {
   "players": [{}, {}],
   "tapped": { "Mountain": true }
  }
 }
]
