[
  {
    "name": "cycling {2}: discard Rune, draw a card",
    "players": [
      {
        "hand": [
          "Rune of Protection: Lands"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ],
        "library": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rune of Protection: Lands",
        "ability": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Island"
          ],
          "graveyard_has": [
            "Rune of Protection: Lands"
          ]
        },
        {}
      ]
    }
  },
  { "name": "prevents the next damage from a land source of your choice",
    "players": [ { "battlefield": ["Dryad Arbor"] },
                 { "battlefield": ["Rune of Protection: Lands", "Plains"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
               { "attack": [ { "card": "Dryad Arbor", "at": "p1" } ] },
               { "pass": true },
               { "activate": "Rune of Protection: Lands", "player": 1 },
               { "resolve": true, "answers": ["Dryad Arbor"] },
               { "block": [] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "a non-land attacker is not prevented",
    "players": [ { "battlefield": ["Grizzly Bears"] },
                 { "battlefield": ["Rune of Protection: Lands", "Plains"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "pass": true },
               { "activate": "Rune of Protection: Lands", "player": 1 },
               { "resolve": true },
               { "block": [] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "ruling: activated before any damage, it still prevents the next damage from that land",
    "players": [ { "battlefield": ["Dryad Arbor"] },
                 { "battlefield": ["Rune of Protection: Lands", "Plains"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
               { "pass": true },
               { "activate": "Rune of Protection: Lands", "player": 1 },
               { "resolve": true, "answers": ["Dryad Arbor"] },
               { "attack": [ { "card": "Dryad Arbor", "at": "p1" } ] },
               { "block": [] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] } }
]