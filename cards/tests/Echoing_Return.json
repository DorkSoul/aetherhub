[
  {
    "name": "returns the target and all same-named cards",
    "players": [
      {
        "hand": ["Echoing Return"],
        "battlefield": ["Swamp"],
        "graveyard": ["Grizzly Bears", "Grizzly Bears", "Lightning Bolt", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Echoing Return",
        "targets": ["Grizzly Bears"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Grizzly Bears", "Grizzly Bears"],
          "graveyard": ["Lightning Bolt", "Hill Giant", "Echoing Return"]
        },
        {}
      ]
    }
  },
  {
    "name": "does not return other names",
    "players": [
      {
        "hand": ["Echoing Return"],
        "battlefield": ["Swamp"],
        "graveyard": ["Grizzly Bears", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Echoing Return",
        "targets": ["Hill Giant"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Hill Giant"],
          "graveyard": ["Grizzly Bears", "Echoing Return"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: if the target leaves the graveyard in response, Echoing Return does nothing even though a same-named card remains",
    "players": [
      {
        "hand": ["Echoing Return"],
        "battlefield": ["Swamp"],
        "graveyard": ["Hill Giant", "Hill Giant"]
      },
      {
        "hand": ["Purify the Grave"],
        "battlefield": ["Plains"]
      }
    ],
    "steps": [
      { "cast": "Echoing Return", "targets": ["Hill Giant"] },
      { "pass": true },
      { "cast": "Purify the Grave", "player": 1, "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Hill Giant", "Echoing Return"], "exile": ["Hill Giant"] },
        { "graveyard": ["Purify the Grave"] }
      ]
    }
  }
]
