[
  {
    "name": "returns to its owner's hand at end of combat after attacking",
    "players": [ { "battlefield": ["Phantom Whelp"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Phantom Whelp", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand": ["Phantom Whelp"] }, {} ] }
  },
  {
    "name": "stays on the battlefield during combat",
    "players": [ { "battlefield": ["Phantom Whelp"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Phantom Whelp", "at": "p1" } ] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Phantom Whelp"] }, {} ] }
  },
  {
    "name": "blocking: returns to its owner's hand at end of combat",
    "players": [ { "battlefield": ["Phantom Whelp"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Llanowar Elves", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Phantom Whelp", "attacker": "Llanowar Elves" } ], "player": 0 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Phantom Whelp"] }, { "graveyard_has": ["Llanowar Elves"] } ] }
  },
  {
    "name": "not blocking: the Whelp stays on the battlefield",
    "players": [ { "battlefield": ["Phantom Whelp"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Llanowar Elves", "at": "p0" } ], "player": 1 }, { "block": [], "player": 0 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Phantom Whelp"] }, { "battlefield_has": ["Llanowar Elves"] } ] }
  }
]
