[
  { "name": "ETB: sacrifice a creature, target player draws two and loses 2 life",
    "players": [ { "hand": ["Unscrupulous Contractor"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Unscrupulous Contractor" }, { "resolve": true, "answers": [true, "Grizzly Bears", "p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Unscrupulous Contractor"], "battlefield_lacks": ["Grizzly Bears"] }, { "life": 18, "hand_count": 2 } ] } },
  { "name": "declining the sacrifice: no draw and no life loss",
    "players": [ { "hand": ["Unscrupulous Contractor"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Unscrupulous Contractor" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Unscrupulous Contractor", "Grizzly Bears"] }, { "life": 20 } ] } },
  { "name": "plotted for {2}{B}, then cast for free on a later turn",
    "players": [ { "hand": ["Unscrupulous Contractor"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Unscrupulous Contractor", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Unscrupulous Contractor", "alt": 0 }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Unscrupulous Contractor"] }, {} ] } },
  { "name": "a plotted card cannot be cast from exile on the turn it was plotted",
    "players": [ { "hand": ["Unscrupulous Contractor"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Unscrupulous Contractor", "ability": 0 }, { "resolve": true }, { "cast": "Unscrupulous Contractor", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Unscrupulous Contractor"], "hand_count": 0 }, {} ] } },
  { "name": "reflexive target chosen on resolution can be yourself: you draw two and lose 2 life",
    "players": [ { "hand": ["Unscrupulous Contractor"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Unscrupulous Contractor" }, { "resolve": true, "answers": [true, "Grizzly Bears", "p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Unscrupulous Contractor"], "battlefield_lacks": ["Grizzly Bears"], "life": 18, "hand_count": 2 }, { "life": 20 } ] } }
  ,{ "name": "ruling: plotting is only possible in your own main phase: on the opponent's turn the plot is not legal",
    "players": [ { "hand": ["Unscrupulous Contractor"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "activate": "Unscrupulous Contractor", "ability": 0, "player": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Unscrupulous Contractor"], "exile": [] }, {} ] } },
  { "name": "ruling: plotting is a special action: no stack object is created and the card is exiled at once",
    "players": [ { "hand": ["Unscrupulous Contractor"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Unscrupulous Contractor", "ability": 0 } ],
    "expect": { "stack_empty": true, "players": [ { "exile": ["Unscrupulous Contractor"], "hand_count": 0 }, {} ] } }
]
