[
  {
    "name": "opponent's spell targeting Syr Elenora is castable with three lands and resolves",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Syr Elenora, the Discerning"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Syr Elenora, the Discerning"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "battlefield_has": [
            "Syr Elenora, the Discerning"
          ]
        }
      ]
    }
  },
  {
    "name": "opponent's spell targeting another creature costs no extra",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Syr Elenora, the Discerning",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "battlefield_has": [
            "Syr Elenora, the Discerning"
          ],
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "entering the battlefield draws a card",
    "players": [
      { "hand": ["Syr Elenora, the Discerning"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Lightning Bolt"] },
      {}
    ],
    "steps": [ { "cast": "Syr Elenora, the Discerning" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"], "battlefield_has": ["Syr Elenora, the Discerning"] }, {} ] }
  },
  {
    "name": "power equals the number of cards in hand",
    "players": [ { "hand": ["Island", "Island", "Island"], "battlefield": ["Syr Elenora, the Discerning"] }, {} ],
    "steps": [],
    "expect": { "pt": { "Syr Elenora, the Discerning": [3, 4] } }
  },
  {
    "name": "empty hand makes power zero",
    "players": [ { "battlefield": ["Syr Elenora, the Discerning"] }, {} ],
    "steps": [],
    "expect": { "pt": { "Syr Elenora, the Discerning": [0, 4] } }
  },
  {
    "name": "opponent's Swords to Plowshares targeting Syr Elenora costs two more: illegal with two lands",
    "players": [ { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Syr Elenora, the Discerning"] } ],
    "steps": [ { "cast": "Swords to Plowshares", "targets": ["Syr Elenora, the Discerning"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Swords to Plowshares"] }, { "battlefield_has": ["Syr Elenora, the Discerning"] } ] }
  },
  {
    "name": "ruling: the tax does not change mana value, so Change the Equation mode 1 counters Swords (MV 1) that cost 3",
    "players": [
      { "hand": ["Change the Equation"], "battlefield": ["Island", "Island", "Syr Elenora, the Discerning"] },
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Swords to Plowshares", "player": 1, "targets": ["Syr Elenora, the Discerning"] },
      { "pass": true, "player": 1 },
      { "cast": "Change the Equation", "answers": [0], "targets": [{ "stack": "Swords to Plowshares" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Change the Equation"], "battlefield_has": ["Syr Elenora, the Discerning"] },
        { "graveyard": ["Swords to Plowshares"] }
      ]
    }
  }
]