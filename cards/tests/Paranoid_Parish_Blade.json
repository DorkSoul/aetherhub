[
  {
    "name": "delirium (four card types in graveyard): +1/+0 and first strike",
    "players": [
      { "battlefield": ["Paranoid Parish-Blade"], "graveyard": ["Lightning Bolt", "Grizzly Bears", "Forest", "Duress"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Paranoid Parish-Blade": [4, 2] },
      "keywords": { "Paranoid Parish-Blade": ["FirstStrike"] }
    }
  },
  {
    "name": "three card types is not delirium: plain 3/2",
    "players": [
      { "battlefield": ["Paranoid Parish-Blade"], "graveyard": ["Lightning Bolt", "Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Paranoid Parish-Blade": [3, 2] }
    }
  },
  {
    "name": "ruling: card types count, not cards (artifact creature counts twice): delirium with three cards",
    "players": [ { "battlefield": ["Paranoid Parish-Blade"], "graveyard": ["Cogwork Tracker", "Lightning Bolt", "Duress"] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "players": [{}, {}], "pt": { "Paranoid Parish-Blade": [4, 2] }, "keywords": { "Paranoid Parish-Blade": ["FirstStrike"] } }
  },
  {
    "name": "ruling: four cards of only three types is not delirium",
    "players": [ { "battlefield": ["Paranoid Parish-Blade"], "graveyard": ["Grizzly Bears", "Grizzly Bears", "Lightning Bolt", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "players": [{}, {}], "pt": { "Paranoid Parish-Blade": [3, 2] } }
  },
  {
    "name": "ruling: supertypes and subtypes are not counted (Forest and Mountain are one type)",
    "players": [ { "battlefield": ["Paranoid Parish-Blade"], "graveyard": ["Forest", "Mountain", "Grizzly Bears", "Lightning Bolt"] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "players": [{}, {}], "pt": { "Paranoid Parish-Blade": [3, 2] } }
  }
]
