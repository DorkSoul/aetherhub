[
  {
    "name": "equipped creature pumps when it attacks by the number of attackers",
    "players": [
      {
        "battlefield": [
          "Veteran's Armaments",
          "Grizzly Bears",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Veteran's Armaments",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          3,
          3
        ]
      },
      "attached": {
        "Veteran's Armaments": "Grizzly Bears"
      }
    }
  },
  {
    "name": "a Soldier entering may be attached to",
    "players": [
      {
        "hand": [
          "Brokers Veteran"
        ],
        "battlefield": [
          "Veteran's Armaments",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Brokers Veteran"
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "attached": {
        "Veteran's Armaments": "Brokers Veteran"
      }
    }
  },
  {
    "name": "blocking equipped creature gets +1/+1 per attacking creature",
    "players": [
      {
        "battlefield": [
          "Veteran's Armaments",
          "Grizzly Bears",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": ["Saproling"]
      }
    ],
    "steps": [
      {
        "activate": "Veteran's Armaments",
        "targets": ["Grizzly Bears"]
      },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Saproling", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Saproling" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [3, 3]
      },
      "attached": {
        "Veteran's Armaments": "Grizzly Bears"
      }
    }
  },
  {
    "name": "ruling: an opponent's Soldier entering can be given this Equipment by its controller",
    "players": [
      { "battlefield": ["Veteran's Armaments", "Plains"] },
      { "hand": ["Brokers Veteran"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "advance_to": "Main1", "auto": true },
      { "cast": "Brokers Veteran", "player": 1 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Brokers Veteran"] } ],
      "attached": { "Veteran's Armaments": "Brokers Veteran" }
    }
  }
]
