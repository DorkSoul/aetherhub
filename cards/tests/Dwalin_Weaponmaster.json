[
  {
    "name": "ruling: hone counter on an Equipment gives +1/+0 to the creature it equips, without the Equipment referencing hone counters",
    "players": [
      { "hand": ["Dwalin, Weaponmaster"], "battlefield": ["+2 Mace", "Grizzly Bears", "Mountain", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Dwalin, Weaponmaster" },
      { "resolve": true },
      { "activate": "+2 Mace", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dwalin, Weaponmaster", "+2 Mace"] },
        {}
      ],
      "counters": { "+2 Mace": { "Hone": 1 } },
      "pt": { "Grizzly Bears": [5, 4] },
      "attached": { "+2 Mace": "Grizzly Bears" }
    }
  },
  {
    "name": "ruling: hone counters stay on the Equipment and the bonus moves with it when it is re-attached",
    "players": [
      { "battlefield": [{ "name": "+2 Mace", "counters": { "Hone": 1 } }, "Grizzly Bears", "Hill Giant", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "+2 Mace", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "+2 Mace", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "counters": { "+2 Mace": { "Hone": 1 } },
      "pt": { "Grizzly Bears": [2, 2], "Hill Giant": [6, 5] },
      "attached": { "+2 Mace": "Hill Giant" }
    }
  },
  {
    "name": "ruling: Dwalin's attack trigger puts a hone counter on each Equipment you control",
    "players": [
      { "battlefield": ["Dwalin, Weaponmaster", "+2 Mace", "Plains"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Dwalin, Weaponmaster", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dwalin, Weaponmaster", "+2 Mace"] },
        { "life": 18 }
      ],
      "counters": { "+2 Mace": { "Hone": 1 } }
    }
  },
  {
    "name": "boundary: a second attack on a later turn adds another hone counter",
    "players": [
      { "battlefield": ["Dwalin, Weaponmaster", "+2 Mace", "Plains"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Dwalin, Weaponmaster", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Dwalin, Weaponmaster", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dwalin, Weaponmaster", "+2 Mace"] },
        { "life": 16 }
      ],
      "counters": { "+2 Mace": { "Hone": 2 } }
    }
  }
]
