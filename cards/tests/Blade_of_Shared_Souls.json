[
  { "name": "equipped creature becomes a copy of another creature while attached",
    "players": [ { "battlefield": ["Blade of Shared Souls", "Grizzly Bears", "Serra Angel", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Blade of Shared Souls", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": ["Serra Angel", true] } ],
    "expect": { "players": [ { "battlefield": ["Blade of Shared Souls", "Serra Angel", "Serra Angel", "Island", "Island"] }, {} ] } },
  { "name": "moving the equipment ends the copy",
    "players": [ { "battlefield": ["Blade of Shared Souls", "Grizzly Bears", "Hill Giant", "Serra Angel", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Blade of Shared Souls", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": ["Serra Angel", true] }, { "activate": "Blade of Shared Souls", "ability": 0, "targets": ["Hill Giant"] }, { "resolve": true, "answers": ["Serra Angel", false] } ],
    "expect": { "players": [ { "battlefield": ["Blade of Shared Souls", "Grizzly Bears", "Hill Giant", "Serra Angel", "Island", "Island", "Island", "Island"] }, {} ] } },
  { "name": "entering creates a 2/2 Rebel and attaches the Blade to it (For Mirrodin!)",
    "players": [ { "hand": ["Blade of Shared Souls"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Blade of Shared Souls" }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Blade of Shared Souls", "Rebel 2-2"] }, {} ],
                "attached": { "Blade of Shared Souls": "Rebel 2-2" },
                "pt": { "Rebel 2-2": [2, 2] } } },
  { "name": "ruling: destroying the equipped Rebel leaves the Equipment on the battlefield",
    "players": [ { "hand": ["Blade of Shared Souls", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Mountain"] }, {} ],
    "steps": [ { "cast": "Blade of Shared Souls" }, { "resolve": true, "answers": [false] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Rebel 2-2"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Blade of Shared Souls"], "battlefield_lacks": ["Rebel 2-2"], "graveyard": ["Lightning Bolt"] }, {} ] } },
  { "name": "ruling: the copy takes printed values only (not counters or tapped status); the creature's own counters still apply",
    "players": [ { "battlefield": ["Blade of Shared Souls", "Island", "Island", { "name": "Grizzly Bears", "tapped": true, "counters": { "p1p1": 1 } }, { "name": "Serra Angel", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "activate": "Blade of Shared Souls", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": ["Serra Angel", true] } ],
    "expect": { "players": [ { "battlefield_has": ["Blade of Shared Souls", "Serra Angel"] }, {} ], "pt": { "Serra Angel": [5, 5] }, "tapped": { "Serra Angel": true }, "attached": { "Blade of Shared Souls": "Serra Angel" } } }
]
