[
  {
    "name": "destroys a land that could produce colorless",
    "players": [
      { "hand": ["Break the Ice"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Wastes", "Forest"] }
    ],
    "steps": [
      { "cast": "Break the Ice", "targets": ["Wastes"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Break the Ice"] }, { "graveyard": ["Wastes"], "battlefield_has": ["Forest"] } ] }
  },
  {
    "name": "destroys a snow land",
    "players": [
      { "hand": ["Break the Ice"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Snow-Covered Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Break the Ice", "targets": ["Snow-Covered Forest"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Snow-Covered Forest"], "battlefield_has": ["Forest"] } ] }
  },
  {
    "name": "cannot target a nonsnow land without a colorless ability",
    "players": [
      { "hand": ["Break the Ice"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Break the Ice", "illegal": true }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Forest"] } ] }
  },
  {
    "name": "overload destroys every snow or colorless land",
    "players": [
      { "hand": ["Break the Ice"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Wastes"] },
      { "battlefield": ["Wastes", "Snow-Covered Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Break the Ice", "alt": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Wastes"] }, { "graveyard_has": ["Wastes", "Snow-Covered Forest"], "battlefield": ["Forest"] } ] }
  },
  {
    "name": "ruling: a tapped Wastes is still a legal target (it could produce {C})",
    "players": [
      { "hand": ["Break the Ice"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": [ { "name": "Wastes", "tapped": true }, "Forest" ] }
    ],
    "steps": [
      { "cast": "Break the Ice", "targets": ["Wastes"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Wastes"], "battlefield_has": ["Forest"] } ] }
  }
]
