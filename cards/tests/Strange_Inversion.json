[
  {
    "name": "switches the target creature's power and toughness",
    "players": [
      { "hand": ["Strange Inversion"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Giant Spider"] }
    ],
    "steps": [
      { "cast": "Strange Inversion", "targets": ["Giant Spider"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [] },
        { "battlefield_has": ["Giant Spider"] }
      ],
      "pt": { "Giant Spider": [4, 2] }
    }
  },
  {
    "name": "splice onto Blind with Anger: the switch also happens (Blind with Anger's spell resolves too)",
    "players": [
      { "hand": ["Blind with Anger", "Strange Inversion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Giant Spider"] }
    ],
    "steps": [
      { "cast": "Blind with Anger", "targets": ["Grizzly Bears", "Giant Spider"], "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "hand": ["Strange Inversion"] },
        { "battlefield_has": ["Giant Spider"] }
      ],
      "pt": { "Giant Spider": [4, 2] }
    }
  },
  {
    "name": "declining the splice leaves Strange Inversion in hand",
    "players": [
      { "hand": ["Blind with Anger", "Strange Inversion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Giant Spider"] }
    ],
    "steps": [
      { "cast": "Blind with Anger", "targets": ["Grizzly Bears"], "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "hand": ["Strange Inversion"] },
        { "battlefield_has": ["Giant Spider"] }
      ],
      "pt": { "Giant Spider": [2, 4] }
    }
  },
  {
    "name": "ruling: switching twice returns the creature to its original power and toughness",
    "players": [
      { "hand": ["Strange Inversion", "Strange Inversion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Giant Spider"] }
    ],
    "steps": [
      { "cast": "Strange Inversion", "targets": ["Giant Spider"], "answers": [false] },
      { "resolve": true },
      { "cast": "Strange Inversion", "targets": ["Giant Spider"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [] },
        { "battlefield_has": ["Giant Spider"] }
      ],
      "pt": { "Giant Spider": [2, 4] }
    }
  },
  {
    "name": "ruling: damage stays marked, so switching toughness to 2 makes the damaged Giant Spider die",
    "players": [
      { "hand": ["Lightning Bolt", "Strange Inversion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Giant Spider"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Giant Spider"] },
      { "resolve": true },
      { "cast": "Strange Inversion", "targets": ["Giant Spider"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [] },
        { "graveyard_has": ["Giant Spider"] }
      ]
    }
  }
]
