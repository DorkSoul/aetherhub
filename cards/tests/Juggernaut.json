        "advance_to": "DeclareAttackers"
      },
      {
        "block": [
          {
            "blocker": "Grizzly Bears",
            "attacker": "Juggernaut"
          }
        ],
        "player": 1
      },
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
