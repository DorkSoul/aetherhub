  {
    "name": "a non-Wall can block it and dies",
    "players": [
      {
        "battlefield": [
          {
            "name": "Juggernaut",
            "sick": false
          }
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
