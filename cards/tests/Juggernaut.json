  {
    "name": "a Wall cannot block it: its block is dropped and Juggernaut connects",
    "players": [
      { "battlefield": [ { "name": "Juggernaut", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      { "battlefield": ["Wall of Stone", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Juggernaut", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Wall of Stone", "attacker": "Juggernaut" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Juggernaut"] },
        { "battlefield_has": ["Wall of Stone"], "life": 15 }
      ]
    }
