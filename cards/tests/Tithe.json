[
  { "name": "opponent with more lands lets you search for a second Plains",
    "players": [ { "hand": ["Tithe"], "battlefield": ["Plains"], "library": ["Plains", "Plains"] }, { "battlefield": ["Plains", "Plains", "Forest"] } ],
    "steps": [ { "cast": "Tithe", "targets": ["p1"] }, { "resolve": true, "answers": ["Plains", true, "Plains"] } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Tithe"] }, {} ] } },
  { "name": "opponent without more lands gives only one Plains",
    "players": [ { "hand": ["Tithe"], "battlefield": ["Plains", "Plains"], "library": ["Plains", "Plains"] }, { "battlefield": ["Plains"] } ],
    "steps": [ { "cast": "Tithe", "targets": ["p1"] }, { "resolve": true, "answers": ["Plains"] } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Tithe"] }, {} ] } },
  { "name": "ruling: you may decline to find the Plains in the search",
    "players": [ { "hand": ["Tithe"], "battlefield": ["Plains"], "library": ["Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Tithe", "targets": ["p1"] }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Tithe"] }, {} ] } },
  { "name": "ruling: declining the optional second Plains search gives only the first",
    "players": [ { "hand": ["Tithe"], "battlefield": ["Plains"], "library": ["Plains", "Plains"] }, { "battlefield": ["Plains", "Plains", "Forest"] } ],
    "steps": [ { "cast": "Tithe", "targets": ["p1"] }, { "resolve": true, "answers": ["Plains", false] } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Tithe"] }, {} ] } }
]
