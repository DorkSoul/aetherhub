[
 {
  "name": "ETB puts a +1/+1 counter on the chosen creature",
  "players": [
   {
    "hand": [
     "Obsessive Skinner"
    ],
    "battlefield": [
     "Forest",
     "Forest"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Obsessive Skinner"
   },
   {
    "resolve": true,
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Grizzly Bears": {
     "p1p1": 1
    }
   },
   "pt": {
    "Grizzly Bears": [
     3,
     3
    ]
   }
  }
 },
 {
  "name": "delirium: at each opponent's upkeep it adds a counter",
  "players": [
   {
    "battlefield": [
     "Obsessive Skinner"
    ],
    "graveyard": [
     "Grizzly Bears",
     "Lightning Bolt",
     "Divination",
     "Sol Ring"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Upkeep",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "advance_to": "Upkeep"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Grizzly Bears": {
     "p1p1": 1
    }
   }
  }
 },
 {
  "name": "no delirium with three card types: no counter",
  "players": [
   {
    "battlefield": [
     "Obsessive Skinner"
    ],
    "graveyard": [
     "Grizzly Bears",
     "Lightning Bolt",
     "Divination"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "counters": {
    "Grizzly Bears": {
     "p1p1": 0
    }
   }
  }
 },
 {
  "name": "ruling: delirium counts card types, not cards (four cards of three types do not enable it)",
  "players": [ { "battlefield": ["Obsessive Skinner"], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Divination", "Sol Ring"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
  "expect": { "counters": { "Grizzly Bears": { "p1p1": 0 } } }
 },
 {
  "name": "ruling: supertypes and subtypes are not card types (Forest, Forest, Bolt, Divination is three types)",
  "players": [ { "battlefield": ["Obsessive Skinner"], "graveyard": ["Forest", "Forest", "Lightning Bolt", "Divination"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
  "expect": { "counters": { "Grizzly Bears": { "p1p1": 0 } } }
 },
 {
  "name": "ruling: the delirium upkeep trigger can target Obsessive Skinner itself",
  "players": [ { "battlefield": ["Obsessive Skinner"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Divination", "Sol Ring"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "advance_to": "Upkeep", "targets": ["Obsessive Skinner"] }, { "advance_to": "Upkeep" }, { "resolve": true } ],
  "expect": { "counters": { "Obsessive Skinner": { "p1p1": 1 } } }
 },
 {
  "name": "ruling: the ETB counter can target Obsessive Skinner itself",
  "players": [ { "hand": ["Obsessive Skinner"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Obsessive Skinner" }, { "resolve": true, "targets": ["Obsessive Skinner"] }, { "resolve": true } ],
  "expect": { "counters": { "Obsessive Skinner": { "p1p1": 1 } }, "pt": { "Obsessive Skinner": [2, 2] } }
 }
]
