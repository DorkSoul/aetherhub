[
  {
    "name": "from the graveyard: discard two, return tapped",
    "players": [
      {
        "hand": [
          "Grizzly Bears",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ],
        "graveyard": [
          "Advanced Stitchwing"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Advanced Stitchwing"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Advanced Stitchwing": true
      },
      "players": [
        {
          "battlefield_has": [
            "Advanced Stitchwing"
          ],
          "hand_count": 0,
          "graveyard_has": [
            "Grizzly Bears",
            "Lightning Bolt"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "needs two cards in hand to discard",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ],
        "graveyard": [
          "Advanced Stitchwing"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Advanced Stitchwing",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Advanced Stitchwing"
          ],
          "hand": [
            "Lightning Bolt"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: on the battlefield it has no graveyard ability to activate",
    "players": [
      { "hand": ["Grizzly Bears", "Lightning Bolt"], "battlefield": ["Advanced Stitchwing", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [ { "activate": "Advanced Stitchwing", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Advanced Stitchwing"], "hand_count": 2 }, {} ] }
  },
  {
    "name": "ruling: a Stitchwing in the opponent's graveyard cannot use its ability",
    "players": [
      { "hand": ["Grizzly Bears", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island"] },
      { "graveyard": ["Advanced Stitchwing"] }
    ],
    "steps": [ { "activate": "Advanced Stitchwing", "player": 0, "illegal": true } ],
    "expect": { "players": [ { "hand_count": 2 }, { "graveyard_has": ["Advanced Stitchwing"] } ] }
  }
]