[
  {
    "name": "draws a card when it enters",
    "players": [
      {
        "hand": [
          "Blur of Heroism"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Blur of Heroism"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "library_count": 19
        },
        {}
      ]
    }
  },
  {
    "name": "Hero creature spell can be cast at instant speed",
    "players": [
      {
        "hand": [
          "Agent Venom"
        ],
        "battlefield": [
          "Blur of Heroism",
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "cast": "Agent Venom"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Agent Venom"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "non-Hero creature spell still needs sorcery timing",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Blur of Heroism",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "cast": "Grizzly Bears",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ]
    }
  },
  {
    "name": "Hero creature spell can be cast in an opponent's main phase",
    "players": [
      { "hand": ["Agent Maria Hill"], "battlefield": ["Blur of Heroism", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "End" }, { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Agent Maria Hill", "player": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Agent Maria Hill"] }, {} ] }
  },
  {
    "name": "non-Hero creature spell cannot be cast in an opponent's main phase",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Blur of Heroism", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "End" }, { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Grizzly Bears", "player": 0, "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] }
  }
]
