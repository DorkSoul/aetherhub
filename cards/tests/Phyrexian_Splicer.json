[
  {
    "name": "flying ability moves flying from a flier to another creature",
    "players": [
      { "battlefield": ["Phyrexian Splicer", "Forest", "Forest"] },
      { "battlefield": ["Serra Angel", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Phyrexian Splicer", "ability": 0, "targets": ["Serra Angel", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Flying"] },
      "tapped": { "Phyrexian Splicer": true }
    }
  },
  {
    "name": "first strike choice grants first strike",
    "players": [
      { "battlefield": ["Phyrexian Splicer", "Forest", "Forest"] },
      { "battlefield": ["White Knight", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Phyrexian Splicer", "ability": 1, "targets": ["White Knight", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["FirstStrike"] }
    }
  },
  {
    "name": "no creature with flying means no flying ability",
    "players": [
      { "battlefield": ["Phyrexian Splicer", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Phyrexian Splicer", "ability": 0, "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "{2}, {T}, choose trample: another creature gains trample from a trampler",
    "players": [ { "battlefield": ["Phyrexian Splicer", "Forest", "Forest"] }, { "battlefield": ["Charging Monstrosaur", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Phyrexian Splicer", "ability": 2, "targets": ["Charging Monstrosaur", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "keywords": { "Grizzly Bears": ["Trample"] }, "tapped": { "Phyrexian Splicer": true } }
  },
  {
    "name": "no creature with trample: the trample ability is illegal",
    "players": [ { "battlefield": ["Phyrexian Splicer", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Phyrexian Splicer", "ability": 2, "illegal": true } ],
    "expect": {}
  },
  {
    "name": "{2}, {T}, choose shadow: another creature gains shadow from a shadow creature",
    "players": [ { "battlefield": ["Phyrexian Splicer", "Forest", "Forest"] }, { "battlefield": ["Dauthi Slayer", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Phyrexian Splicer", "ability": 3, "targets": ["Dauthi Slayer", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "keywords": { "Grizzly Bears": ["Shadow"] } }
  },
  {
    "name": "ruling: the flying target dies in response; the other target still gains first strike",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Phyrexian Splicer", "Forest", "Forest", "Mountain"] },
      { "battlefield": ["White Knight", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Phyrexian Splicer", "ability": 1, "targets": ["White Knight", "Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["White Knight"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["White Knight"] }
      ],
      "keywords": { "Grizzly Bears": ["FirstStrike"] },
      "tapped": { "Phyrexian Splicer": true }
    }
  }
]
