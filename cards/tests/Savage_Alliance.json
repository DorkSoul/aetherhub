  "expect": { "players": [ { "graveyard": ["Savage Alliance"] }, { "graveyard": ["Llanowar Elves"], "battlefield_has": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: trample damage assignment counts the 1 damage already on the blocker (1 tramples over)",
  "players": [ { "hand": ["Savage Alliance"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Hill Giant"] }, { "battlefield": ["Centaur Courser"] } ],
  "steps": [ { "cast": "Savage Alliance", "alt": 3, "targets": ["p0", "p1"] }, { "resolve": true }, { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Centaur Courser", "attacker": "Hill Giant" } ] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 19, "graveyard": ["Centaur Courser"] } ] }
 },
 {
