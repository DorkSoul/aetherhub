[
  { "name": "normal cast X=2 deals 2 to each of two targets",
    "players": [ { "hand": ["Fall of the Titans"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Fall of the Titans", "answers": [2], "targets": ["Grizzly Bears", "p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Fall of the Titans"] }, { "graveyard": ["Grizzly Bears"], "life": 18 } ] } },
  { "name": "up to two: a single target works too (X=1 for {1}{1}{R})",
    "players": [ { "hand": ["Fall of the Titans"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Fall of the Titans", "answers": [1], "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Fall of the Titans"] }, { "battlefield_has": ["Grizzly Bears"], "life": 19 } ] } },
  { "name": "surge X=2 after another spell deals 2 to each of two targets",
    "players": [ { "hand": ["Fall of the Titans", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Fall of the Titans", "alt": 0, "answers": [2], "targets": ["Grizzly Bears", "p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Fall of the Titans", "Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"], "life": 15 } ] } },
  { "name": "ruling: surge counts a spell that already resolved (Lightning Bolt resolved before Fall of the Titans)",
    "players": [ { "hand": ["Fall of the Titans", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Fall of the Titans", "alt": 0, "answers": [2], "targets": ["Grizzly Bears", "p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Fall of the Titans", "Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"], "life": 15 } ] } }
]
