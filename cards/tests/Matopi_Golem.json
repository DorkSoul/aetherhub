[
  {
    "name": "the -1/-1 counter arrives only when the regeneration shield is used",
    "players": [
      { "battlefield": ["Plains", "Island", "Matopi Golem"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Mountain"] }
    ],
    "steps": [
      { "tap_for_mana": "Plains", "color": "W" },
      { "activate": "Matopi Golem", "ability": 0 },
      { "resolve": true },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Matopi Golem"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Matopi Golem"] }, { "graveyard": ["Doom Blade"] } ],
      "pt": { "Matopi Golem": [2, 2] }
    }
  },
  {
    "name": "activating without the shield being used adds no counter",
    "players": [
      { "battlefield": ["Plains", "Island", "Matopi Golem"] },
      { "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "tap_for_mana": "Plains", "color": "W" },
      { "activate": "Matopi Golem", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Matopi Golem"] }, {} ],
      "pt": { "Matopi Golem": [3, 3] }
    }
  }
]
