[
  {
    "name": "upkeep: transform into Unholy Fiend",
    "players": [
      {
        "battlefield": [
          "Cloistered Youth"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Unholy Fiend": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "upkeep: declining keeps the front face",
    "players": [
      {
        "battlefield": [
          "Cloistered Youth"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          false
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Cloistered Youth": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "end step: the transformed Unholy Fiend makes you lose 1 life",
    "players": [ { "battlefield": [ "Cloistered Youth" ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 19 }, {} ] }
  },
  {
    "name": "declining the transform: the front face does not lose life at end step",
    "players": [ { "battlefield": [ "Cloistered Youth" ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "life": 20 }, {} ] }
  }
]
