[
  { "name": "opponent's flying creatures get -1/-0",
    "players": [ { "battlefield": ["One-Eyed Scarecrow"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "pt": { "Serra Angel": [3, 4] } } },
  { "name": "your own flying creatures are not affected",
    "players": [ { "battlefield": ["One-Eyed Scarecrow", "Serra Angel"] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "pt": { "Serra Angel": [4, 4] } } },
  { "name": "opponent's non-flying creatures are not affected",
    "players": [ { "battlefield": ["One-Eyed Scarecrow"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } }
]
