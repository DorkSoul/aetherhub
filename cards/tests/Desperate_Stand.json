    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2], "Hill Giant": [5, 3], "Air Elemental": [6, 4] }
    }
  },
  {
    "name": "ruling: cast with no targets is legal and does nothing",
    "players": [
      { "hand": ["Desperate Stand"], "battlefield": ["Mountain", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Desperate Stand" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2], "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "ruling: an illegal target is skipped, the legal target still gets the effect",
    "players": [
      { "hand": ["Desperate Stand"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Grizzly Bears", "Hill Giant"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
