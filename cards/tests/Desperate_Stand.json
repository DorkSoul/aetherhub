      "pt": { "Hill Giant": [5, 3] },
      "keywords": { "Hill Giant": ["FirstStrike", "Vigilance"] }
    }
  },
  {
    "name": "ruling: if all targets are illegal the spell does not resolve",
    "players": [
      { "hand": ["Desperate Stand"], "battlefield": ["Mountain", "Plains", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Desperate Stand", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Desperate Stand", "Grizzly Bears"] },
