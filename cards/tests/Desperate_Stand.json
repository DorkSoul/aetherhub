  {
    "name": "three targets cost RW three times: all six lands are spent, so a Lightning Bolt in hand can't be cast",
    "players": [
      { "hand": ["Desperate Stand", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains", "Plains", "Grizzly Bears", "Hill Giant", "Air Elemental"] },
      {}
    ],
    "steps": [
      { "cast": "Desperate Stand", "targets": ["Grizzly Bears", "Hill Giant", "Air Elemental"] },
