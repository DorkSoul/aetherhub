      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Desperate Stand", "Grizzly Bears"] },
        { "graveyard": ["Lightning Bolt"] }
