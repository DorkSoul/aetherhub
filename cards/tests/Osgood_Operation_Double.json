      {}
    ],
    "steps": [
      { "cast": "Osgood, Operation Double" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Osgood, Operation Double", "Osgood, Operation Double"], "battlefield_lacks": ["Clue"] },
        {}
      ]
    }
  },
  {
    "name": "the {C} from Osgood pays for an artifact spell",
    "players": [
      { "hand": ["Sol Ring"], "battlefield": ["Osgood, Operation Double"] },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Osgood, Operation Double", "Sol Ring"] },
        {}
      ]
    }
  },
  {
    "name": "the {C} from Osgood cannot pay for a creature spell",
    "players": [
      { "hand": ["Hill Giant"], "battlefield": ["Osgood, Operation Double", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Hill Giant"] },
        {}
      ]
    }
  },
  {
    "name": "casting a spell from the graveyard investigates",
    "players": [
      {
        "battlefield": ["Osgood, Operation Double", "Island", "Island"],
        "graveyard": ["Deep Analysis"]
      },
      {}
    ],
    "steps": [
      { "cast": "Deep Analysis", "alt": 0, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Osgood, Operation Double", "Clue"], "exile": ["Deep Analysis"] },
        {}
      ]
    }
  },
  {
    "name": "casting a spell from hand does not investigate",
    "players": [
      {
        "hand": ["Deep Analysis"],
        "battlefield": ["Osgood, Operation Double", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Deep Analysis", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Osgood, Operation Double"], "battlefield_lacks": ["Clue"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a creature cast from exile (adventure) counts for paradox",
    "players": [
      {
        "hand": ["Animating Faerie // Bring to Life"],
        "battlefield": ["Osgood, Operation Double", "Arcane Signet", "Island", "Island", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Animating Faerie // Bring to Life", "face": true, "targets": ["Arcane Signet"] },
      { "resolve": true },
      { "cast": "Animating Faerie // Bring to Life" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Osgood, Operation Double", "Clue", "Animating Faerie // Bring to Life"] },
        {}
      ]
    }
  }
