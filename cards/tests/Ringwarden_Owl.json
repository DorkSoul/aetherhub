[
 {
  "name": "has flying and prowess",
  "players": [
   {
    "battlefield": ["Ringwarden Owl"]
   },
   {}
  ],
  "steps": [
   { "advance_to": "Main1" }
  ],
  "expect": {
   "players": [{}, {}],
   "keywords": { "Ringwarden Owl": ["Flying", "Prowess"] },
   "pt": { "Ringwarden Owl": [3, 3] }
  }
 },
 {
  "name": "prowess triggers for a noncreature spell",
  "players": [
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Ringwarden Owl", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, { "life": 17 }],
   "pt": { "Ringwarden Owl": [4, 4] }
  }
 },
 {
  "name": "a creature spell does not trigger prowess",
  "players": [
   {
    "hand": ["Grizzly Bears"],
    "battlefield": ["Ringwarden Owl", "Forest", "Forest"]
   },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, {}],
   "pt": { "Ringwarden Owl": [3, 3] }
  }
 },
 {
  "name": "ruling: playing a land does not trigger prowess",
  "players": [
   {
    "hand": ["Forest"],
    "battlefield": ["Ringwarden Owl"]
   },
   {}
  ],
  "steps": [
   { "play_land": "Forest" }
  ],
  "expect": {
   "players": [{}, {}],
   "pt": { "Ringwarden Owl": [3, 3] }
  }
 },
 {
  "name": "ruling: casting an artifact creature does not trigger prowess",
  "players": [
   {
    "hand": ["Ersatz Gnomes"],
    "battlefield": ["Ringwarden Owl", "Forest", "Forest", "Forest"]
   },
   {}
  ],
  "steps": [
   { "cast": "Ersatz Gnomes" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, {}],
   "pt": { "Ringwarden Owl": [3, 3] }
  }
 },
 {
  "name": "ruling: prowess still resolves when the triggering spell is countered",
  "players": [
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Ringwarden Owl", "Mountain"]
   },
   {
    "hand": ["Counterspell"],
    "battlefield": ["Island", "Island"]
   }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "pass": true },
   { "pass": true, "player": 1 }
  ],
  "expect": {
   "players": [{}, { "life": 20 }],
   "pt": { "Ringwarden Owl": [4, 4] }
  }
 }
]
