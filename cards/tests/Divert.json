[
  {
    "name": "opponent cannot pay {2}, so the Bolt's target is changed to its controller",
    "players": [
      { "hand": ["Divert"], "battlefield": ["Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Divert", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [[0]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 20 }, { "life": 17 }]
    }
  },
  {
    "name": "opponent pays {2}, so the target is not changed",
    "players": [
      { "hand": ["Divert"], "battlefield": ["Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Divert", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 17 }, { "life": 20 }]
    }
  }
]
