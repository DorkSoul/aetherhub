[
 { "name": "tapping enchanted land mills its controller three cards",
   "players": [ { "hand": ["Chronic Flooding"], "battlefield": ["Plains","Island","Mountain"] }, {} ],
   "steps": [ { "cast": "Chronic Flooding", "targets": ["Mountain"] }, { "resolve": true }, { "tap_for_mana": "Mountain" }, { "resolve": true } ],
   "expect": { "players": [ { "library_count": 17 }, {} ] } },
 { "name": "ruling: attaching to an already tapped land does not mill (the land must go untapped to tapped)",
   "players": [ { "hand": ["Chronic Flooding"], "battlefield": ["Plains", "Island", { "name": "Mountain", "tapped": true }] }, {} ],
   "steps": [ { "cast": "Chronic Flooding", "targets": ["Mountain"] }, { "resolve": true } ],
   "expect": { "players": [ { "library_count": 20, "battlefield_has": ["Chronic Flooding"] }, {} ] } },
 { "name": "ruling: tapped by another effect (Icy Manipulator, not mana) still mills three cards",
   "players": [ { "hand": ["Chronic Flooding"], "battlefield": ["Island", "Plains", "Plains", "Plains", "Mountain", "Icy Manipulator"] }, {} ],
   "steps": [ { "cast": "Chronic Flooding", "targets": ["Mountain"] }, { "resolve": true }, { "activate": "Icy Manipulator", "ability": 0, "targets": ["Mountain"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "library_count": 17, "battlefield_has": ["Icy Manipulator"] }, {} ] } }
]
