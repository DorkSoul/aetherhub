[
  {
    "name": "ETB exiles two target lands",
    "players": [
      {
        "hand": [
          "Petradon"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Island",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Petradon"
      },
      {
        "resolve": true,
        "targets": [
          "Island",
          "Forest"
        ]
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "exile": [
            "Island",
            "Forest"
          ]
        }
      ]
    }
  },
  {
    "name": "lands return when Petradon leaves",
    "players": [
      {
        "hand": [
          "Petradon",
          "Terror"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Swamp",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Island",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Petradon"
      },
      {
        "resolve": true,
        "targets": [
          "Island",
          "Forest"
        ]
      },
      {
        "cast": "Terror",
        "targets": [
          "Petradon"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Petradon"
          ]
        },
        {
          "battlefield_has": [
            "Island",
            "Forest"
          ]
        }
      ]
    }
  },
  {
    "name": "{R}: +1/+0 for each activation",
    "players": [ { "battlefield": ["Petradon", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Petradon", "ability": 0 }, { "resolve": true }, { "activate": "Petradon", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Petradon": [7, 6] } }
  },
  {
    "name": "no red mana: the pump cannot be activated",
    "players": [ { "battlefield": ["Petradon", "Forest"] }, {} ],
    "steps": [ { "activate": "Petradon", "ability": 0, "illegal": true } ],
    "expect": { "pt": { "Petradon": [5, 6] } }
  }
]
