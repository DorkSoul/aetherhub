  "expect": { "players": [ { "graveyard": ["Riveteers Charm"] }, { "battlefield": ["Grizzly Bears"], "graveyard": ["Elvish Visionary"] } ] }
 },
 {
  "name": "ruling: a land exiled by the charm can be played as the land drop in the main phase",
  "players": [
