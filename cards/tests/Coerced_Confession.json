  },
  {
    "name": "draws nothing when no creature card is milled",
    "players": [
      { "hand": ["Coerced Confession"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "library": ["Lightning Bolt", "Island", "Lightning Bolt", "Island"] }
    ],
    "steps": [
      { "cast": "Coerced Confession", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
