[
  {
    "name": "cannot attack without having cast a noncreature spell this turn",
    "players": [
      { "battlefield": ["Silburlind Snapper"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Silburlind Snapper", "at": "p1" } ], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "can attack after casting a noncreature spell this turn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Silburlind Snapper", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "attack": [ { "card": "Silburlind Snapper", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 11 } ]
    }
  },
  {
    "name": "one attacker is illegal, the other still attacks: 2 damage",
    "players": [
      { "battlefield": ["Silburlind Snapper", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Silburlind Snapper", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: a noncreature spell that fizzles (its target died in response) still counts as cast, so Snapper can attack",
    "players": [
      { "hand": ["Flesh Allergy"], "battlefield": ["Silburlind Snapper", "Knight of Meadowgrain", "Swamp", "Swamp", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] }
    ],
    "steps": [
      { "cast": "Flesh Allergy", "targets": ["Grizzly Bears"], "answers": ["Knight of Meadowgrain"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Silburlind Snapper", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 14 } ]
    }
  }
]
