[
 {
  "name": "return three lands: returns itself to hand",
  "players": [
   {
    "battlefield": [
     "Pearl Lake Ancient",
     "Island",
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Pearl Lake Ancient",
    "ability": 0
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": [
      "Pearl Lake Ancient"
     ],
     "hand_count": 4
    },
    {}
   ]
  }
 },
 {
  "name": "only two lands: can't return it",
  "players": [
   {
    "battlefield": [
     "Pearl Lake Ancient",
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Pearl Lake Ancient",
    "ability": 0,
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Pearl Lake Ancient"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "opponent's Counterspell cannot counter it",
  "players": [
   { "hand": ["Pearl Lake Ancient"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Pearl Lake Ancient" },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Pearl Lake Ancient" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Pearl Lake Ancient"] }, { "graveyard": ["Counterspell"] }]
  }
 },
 {
  "name": "ruling: prowess triggers on casting a noncreature spell: the Ancient is 7/8 after it resolves",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Pearl Lake Ancient", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Lightning Bolt"], "battlefield_has": ["Pearl Lake Ancient"] }, { "graveyard": ["Grizzly Bears"] } ],
   "pt": { "Pearl Lake Ancient": [7, 8] }
  }
 },
 {
  "name": "ruling: if the spell that triggered prowess is countered, prowess still resolves",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Pearl Lake Ancient", "Mountain"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Lightning Bolt"], "battlefield_has": ["Pearl Lake Ancient"] }, { "graveyard": ["Counterspell"], "battlefield_has": ["Grizzly Bears"] } ],
   "pt": { "Pearl Lake Ancient": [7, 8] }
  }
 },
 {
  "name": "ruling: casting a creature spell does not trigger prowess",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Pearl Lake Ancient", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears", "Pearl Lake Ancient"] }, {} ],
   "pt": { "Pearl Lake Ancient": [6, 7] }
  }
 },
 {
  "name": "ruling: playing a land does not trigger prowess",
  "players": [
   { "hand": ["Island"], "battlefield": ["Pearl Lake Ancient"] },
   {}
  ],
  "steps": [
   { "play_land": "Island" }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Island", "Pearl Lake Ancient"] }, {} ],
   "pt": { "Pearl Lake Ancient": [6, 7] }
  }
 }
]
