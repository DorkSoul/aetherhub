[
  { "name": "upkeep puts a time counter on it",
    "players": [ { "battlefield": ["As Foretold"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "counters": { "As Foretold": { "time": 1 } } } },
  { "name": "casts a spell with mana value <= time counters for {0}",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 2 } } ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "alt": 100 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "spell with mana value above the time counters can't use the {0} cost",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 1 } } ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "alt": 100, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] } },
  { "name": "only once each turn",
    "players": [ { "hand": ["Grizzly Bears", "Savannah Lions"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 2 } } ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "alt": 100 }, { "resolve": true }, { "cast": "Savannah Lions", "alt": 100, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand": ["Savannah Lions"] }, {} ] } },
  { "name": "casts a spell from your library for {0} when its mana value is within the time counters",
    "players": [ { "library": ["Grizzly Bears"], "battlefield": [ "Future Sight", { "name": "As Foretold", "counters": { "time": 2 } } ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "alt": 101 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "casts a spell from your graveyard for {0} when its mana value is within the time counters",
    "players": [ { "graveyard": ["Grizzly Bears"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 2 } } ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "alt": 102 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "casts a spell from exile for {0} when its mana value is within the time counters",
    "players": [ { "exile": ["Grizzly Bears"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 2 } } ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "alt": 103 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "casts a spell from the command zone for {0} when its mana value is within the time counters",
    "players": [ { "command": ["Grizzly Bears"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 2 } } ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "alt": 104 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: each As Foretold allows one spell for {0} in the same turn",
    "players": [ { "hand": ["Lightning Bolt", "Savannah Lions"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 1 } }, { "name": "As Foretold", "counters": { "time": 1 } } ] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "alt": 100, "targets": ["p1"] }, { "resolve": true }, { "cast": "Savannah Lions", "alt": 105 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Savannah Lions"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
  { "name": "ruling: a mandatory additional discard is still paid when casting for {0}",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 2 } } ] }, {} ],
    "steps": [ { "cast": "Tormenting Voice", "alt": 100 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard": ["Grizzly Bears", "Tormenting Voice"] }, {} ] } },
  { "name": "ruling: cast for {0} means X is 0, so Pull from Tomorrow draws nothing",
    "players": [ { "hand": ["Pull from Tomorrow", "Forest"], "battlefield": [ { "name": "As Foretold", "counters": { "time": 5 } } ] }, {} ],
    "steps": [ { "cast": "Pull from Tomorrow", "alt": 100 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "graveyard": ["Pull from Tomorrow", "Forest"], "library_count": 20 }, {} ] } }
