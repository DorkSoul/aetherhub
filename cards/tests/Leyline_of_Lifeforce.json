[
  {
    "name": "creature spells can't be countered",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Leyline of Lifeforce", "Forest", "Forest"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Grizzly Bears" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Leyline of Lifeforce", "Grizzly Bears"] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "without the leyline a creature spell can be countered",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Grizzly Bears" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "in the opening hand it begins the game on the battlefield",
    "players": [ { "hand": ["Leyline of Lifeforce"] }, {} ],
    "steps": [],
    "expect": { "players": [ { "battlefield_has": ["Leyline of Lifeforce"], "hand_count": 0 }, {} ] }
  }
]
