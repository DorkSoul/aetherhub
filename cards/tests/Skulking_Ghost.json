  {
    "name": "ruling: countered Lightning Bolt still gets the Ghost sacrificed by its trigger",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      },
      {
        "hand": ["Counterspell"],
        "battlefield": ["Skulking Ghost", "Island", "Island"]
