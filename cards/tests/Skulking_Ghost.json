    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": ["Skulking Ghost"]
      },
      {
        "cast": "Counterspell",
        "player": 1,
        "targets": [{ "stack": "Lightning Bolt" }]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
