[
  { "name": "fortify attaches the Garrison to a target land you control for {3}",
    "players": [ { "hand": [], "battlefield": ["Darksteel Garrison", "Forest", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Darksteel Garrison", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "attached": { "Darksteel Garrison": "Forest" } } },
  { "name": "fortified land has indestructible: Stone Rain cannot destroy it",
    "players": [ { "hand": ["Stone Rain"], "battlefield": ["Darksteel Garrison", "Forest", "Plains", "Plains", "Plains", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Darksteel Garrison", "targets": ["Forest"] }, { "resolve": true },
               { "cast": "Stone Rain", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "attached": { "Darksteel Garrison": "Forest" }, "players": [ { "graveyard": ["Stone Rain"] } ] } },
  { "name": "tapping the fortified land triggers: target creature gets +1/+1 until end of turn",
    "players": [ { "hand": [], "battlefield": ["Darksteel Garrison", "Forest", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Darksteel Garrison", "targets": ["Forest"] }, { "resolve": true },
               { "tap_for_mana": "Forest" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "tapping a land that is not fortified does not trigger",
    "players": [ { "hand": [], "battlefield": ["Darksteel Garrison", "Forest", "Plains", "Plains", "Plains", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Darksteel Garrison", "targets": ["Forest"] }, { "resolve": true },
               { "tap_for_mana": "Island" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: with no creature of your own, the mandatory trigger must target the opponent's creature",
    "players": [ { "hand": [], "battlefield": ["Darksteel Garrison", "Forest", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Darksteel Garrison", "targets": ["Forest"] }, { "resolve": true },
               { "tap_for_mana": "Forest" }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } }
]
