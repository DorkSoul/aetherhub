[
  {
    "name": "tapped land is untapped",
    "players": [
      {
        "hand": [
          "Azorius Guildgate"
        ],
        "battlefield": [
          "Amulet of Vigor"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Azorius Guildgate"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Azorius Guildgate": false
      }
    }
  },
  {
    "name": "without Amulet it stays tapped",
    "players": [
      {
        "hand": [
          "Azorius Guildgate"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Azorius Guildgate"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Azorius Guildgate": true
      }
    }
  },
  {
    "name": "opponent's permanents are not untapped",
    "players": [
      {
        "battlefield": [
          "Amulet of Vigor"
        ]
      },
      {
        "hand": [
          "Azorius Guildgate"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "play_land": "Azorius Guildgate",
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Azorius Guildgate": true
      }
    }
  },
  {
    "name": "ruling: a land that entered untapped and was tapped for mana later is not untapped",
    "players": [
      {
        "hand": ["Forest"],
        "battlefield": ["Amulet of Vigor"]
      },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "tap_for_mana": "Forest" }
    ],
    "expect": {
      "stack_empty": true,
      "tapped": {
        "Forest": true
      }
    }
  },
  {
    "name": "ruling: with two Amulets, a permanent entering tapped is untapped (both triggers resolve)",
    "players": [
      {
        "hand": ["Azorius Guildgate"],
        "battlefield": ["Amulet of Vigor", "Amulet of Vigor"]
      },
      {}
    ],
    "steps": [
      { "play_land": "Azorius Guildgate" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": {
        "Azorius Guildgate": false
      }
    }
  }
]