[
  {
    "name": "instants and sorceries in your graveyard gain flashback for their mana costs; they are exiled after casting",
    "players": [
      { "hand": ["Past in Flames"], "graveyard": ["Lightning Bolt", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Past in Flames" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Past in Flames"], "exile": ["Lightning Bolt", "Shock"] },
        { "life": 15 }
      ]
    }
  },
  {
    "name": "a creature card in your graveyard does not gain flashback",
    "players": [
      { "hand": ["Past in Flames"], "graveyard": ["Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Past in Flames" },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Past in Flames", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "its own flashback {4}{R} exiles it, and the granted flashback of Lightning Bolt is available too",
    "players": [
      { "graveyard": ["Past in Flames", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Past in Flames", "alt": 0 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Past in Flames", "Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: an instant put into the graveyard after Past in Flames resolved gains no flashback",
    "players": [
      { "hand": ["Past in Flames", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Past in Flames" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Past in Flames", "Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: a sorcery cast with flashback still needs sorcery timing (not while Shock is on the stack)",
    "players": [
      { "hand": ["Shock"], "graveyard": ["Past in Flames"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "cast": "Past in Flames", "alt": 0, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Past in Flames", "Shock"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: flashback of an X spell still lets you choose X and pay for it",
    "players": [
      { "hand": ["Past in Flames"], "graveyard": ["Fireball"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Past in Flames" },
      { "resolve": true },
      { "cast": "Fireball", "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Fireball"] },
        { "life": 18 }
      ]
    }
  }
]
