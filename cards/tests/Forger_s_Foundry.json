[
  {
    "name": "mana spent on a small sorcery: accept and the spell is exiled instead of going to the graveyard",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Forger's Foundry", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ { "exile": ["Divination"], "graveyard": [], "hand_count": 2 }, {} ] }
  },
  {
    "name": "declining the exile leaves the spell in the graveyard",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Forger's Foundry", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ { "exile": [], "graveyard": ["Divination"], "hand_count": 2 }, {} ] }
  },
  {
    "name": "mana value 4 spells don't qualify",
    "players": [
      { "hand": ["Wrath of God"], "battlefield": ["Forger's Foundry", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Wrath of God" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": [], "graveyard": ["Wrath of God"] }, {} ] }
  },
  {
    "name": "creature spells don't qualify",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forger's Foundry", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": [] }, {} ] }
  },
  {
    "name": "later: {3}{U}{U}, {T}: cast the exiled spell for free",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Forger's Foundry", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true, "answers": [true] },
      { "advance_to": "End" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "activate": "Forger's Foundry" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ { "exile": [], "graveyard": ["Divination"] }, {} ] }
  },
  {
    "name": "ruling: mana from Forger's Foundry can be spent on a creature spell (no exile)",
    "players": [
      { "hand": ["Spectral Sailor"], "battlefield": ["Forger's Foundry"] },
      {}
    ],
    "steps": [
      { "cast": "Spectral Sailor" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Sailor"], "exile": [], "graveyard": [] }, {} ], "tapped": { "Forger's Foundry": true } }
  },
  {
    "name": "ruling: choosing not to cast the exiled spell as the last ability resolves leaves it exiled",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Forger's Foundry", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true, "answers": [true] },
      { "advance_to": "End" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "activate": "Forger's Foundry" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ { "exile": ["Divination"], "graveyard": [] }, {} ] }
  }
]
