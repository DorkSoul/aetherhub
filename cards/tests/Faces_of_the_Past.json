[
  {
    "name": "tap mode taps untapped creatures sharing a creature type with the dead creature",
    "players": [
      {
        "hand": ["Faces of the Past", "Lightning Bolt"],
        "battlefield": ["Island", "Island", "Island", "Mountain"],
        "library": ["Forest"]
      },
      {
        "battlefield": ["Llanowar Elves", "Elvish Mystic", "Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Faces of the Past" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
      { "resolve": true, "answers": [[0]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Llanowar Elves"], "battlefield": ["Elvish Mystic", "Grizzly Bears"] }
      ],
      "tapped": { "Elvish Mystic": true, "Grizzly Bears": false }
    }
  },
  {
    "name": "untap mode untaps tapped creatures sharing a creature type with the dead creature",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Faces of the Past", "Mountain"]
      },
      {
        "battlefield": ["Llanowar Elves", { "name": "Elvish Mystic", "tapped": true }, { "name": "Grizzly Bears", "tapped": true }]
      }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
      { "resolve": true, "answers": [[1]] }
    ],
    "expect": {
      "tapped": { "Elvish Mystic": false, "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: tap mode never untaps an already tapped creature sharing the type",
    "players": [
      {
        "hand": ["Faces of the Past", "Lightning Bolt"],
        "battlefield": ["Island", "Island", "Island", "Mountain"],
        "library": ["Forest"]
      },
      {
        "battlefield": ["Llanowar Elves", { "name": "Elvish Mystic", "tapped": true }]
      }
    ],
    "steps": [
      { "cast": "Faces of the Past" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
      { "resolve": true, "answers": [[0]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Llanowar Elves"] }
      ],
      "tapped": { "Elvish Mystic": true }
    }
  }
]
