    "steps": [
      { "attack": [ { "card": "Phalanx Vanguard", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Phalanx Vanguard": false } }
  },
  {
    "name": "gets +1/+0 when an artifact you control enters",
