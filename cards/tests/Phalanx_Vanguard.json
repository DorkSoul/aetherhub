    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Phalanx Vanguard": [3, 2] } }
  },
  {
    "name": "a non-artifact creature entering does not pump it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Phalanx Vanguard", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Phalanx Vanguard": [2, 2] } }
  }
