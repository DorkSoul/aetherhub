      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
