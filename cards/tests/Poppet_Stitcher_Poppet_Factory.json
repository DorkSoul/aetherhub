[
  {
    "name": "Factory upkeep: you may transform it back into the creature",
    "players": [
      { "hand": ["Shock", "Shock", "Shock"], "battlefield": ["Poppet Stitcher", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Poppet Stitcher"], "battlefield_lacks": ["Poppet Factory"] },
        { "life": 14 }
      ]
    }
  },
  {
    "name": "face-up Factory: creature tokens you control have base power and toughness 3/3",
    "players": [
      { "hand": ["Shock", "Shock", "Shock"], "battlefield": ["Poppet Stitcher", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Poppet Factory"], "battlefield_lacks": ["Poppet Stitcher"] },
        { "life": 14 }
      ],
      "pt": { "Zombie 2-2 Decayed": [3, 3] }
    }
  },
  {
    "name": "face-up Factory: tokens lose decayed, so they can still block",
    "players": [
      { "hand": ["Shock", "Shock", "Shock"], "battlefield": ["Poppet Stitcher", "Mountain", "Mountain", "Mountain", "Serra Angel"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true },
      { "advance_to": "Main2" }, { "advance_to": "End" }, { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Zombie 2-2 Decayed", "attacker": "Grizzly Bears" }, { "blocker": "Serra Angel", "attacker": "Hill Giant" } ], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 20, "battlefield_has": ["Poppet Factory"] }, { "life": 14 } ]
    }
  },
  {
    "name": "Factory upkeep: declining leaves the artifact face up",
    "players": [
      { "hand": ["Shock", "Shock", "Shock"], "battlefield": ["Poppet Stitcher", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
