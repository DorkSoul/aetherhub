    ]
   }
  ],
  "steps": [
   {
    "activate": "Frostwalk Bastion",
    "ability": 0
   },
   {
    "resolve": true
   },
   {
    "attack": [
     {
      "card": "Frostwalk Bastion",
      "at": "p1"
     }
    ]
   },
   {
    "block": [
     {
      "blocker": "Wall of Stone",
      "attacker": "Frostwalk Bastion"
     }
    ]
   },
   {
    "advance_to": "Main2"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Wall of Stone": true
   }
  }
 },
 {
  "name": "ruling: the creature it damaged stays tapped through its controller's next untap step",
  "players": [
   {"battlefield": ["Frostwalk Bastion", "Snow-Covered Island", "Snow-Covered Island"]},
   {"battlefield": ["Wall of Stone"]}
  ],
  "steps": [
   {"activate": "Frostwalk Bastion", "ability": 0},
   {"resolve": true},
   {"attack": [{"card": "Frostwalk Bastion", "at": "p1"}]},
   {"block": [{"blocker": "Wall of Stone", "attacker": "Frostwalk Bastion"}]},
   {"advance_to": "Main2"},
   {"resolve": true},
   {"advance_to": "Upkeep"}
  ],
  "expect": {
   "tapped": {"Wall of Stone": true}
  }
 },
 {
  "name": "ruling: the skipped untap is only the next one; the creature untaps in its controller's following untap step",
  "players": [
   {"battlefield": ["Frostwalk Bastion", "Snow-Covered Island", "Snow-Covered Island"]},
   {"battlefield": ["Wall of Stone"]}
  ],
  "steps": [
   {"activate": "Frostwalk Bastion", "ability": 0},
   {"resolve": true},
   {"attack": [{"card": "Frostwalk Bastion", "at": "p1"}]},
   {"block": [{"blocker": "Wall of Stone", "attacker": "Frostwalk Bastion"}]},
   {"advance_to": "Main2"},
   {"resolve": true},
   {"advance_to": "Upkeep"},
   {"advance_to": "Upkeep"},
   {"advance_to": "Upkeep"}
  ],
  "expect": {
   "tapped": {"Wall of Stone": false}
  }
 }
