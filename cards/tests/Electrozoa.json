[
 {
  "name": "enters with two energy",
  "players": [
   {
    "hand": [
     "Electrozoa"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Electrozoa"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 2,
     "battlefield_has": [
      "Electrozoa"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "with no energy it is tapped in your first main phase",
  "players": [
   {
    "battlefield": [
     "Electrozoa"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "advance_to": "Main1"
   },
   {
    "advance_to": "Main1"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {}
   ],
   "tapped": {
    "Electrozoa": true
   }
  }
 },
 {
  "name": "ruling: paying one energy at your first main phase keeps it untapped and leaves one energy",
  "players": [
   { "hand": ["Electrozoa"], "battlefield": ["Island", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Electrozoa" },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "advance_to": "Main1", "answers": [true] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "energy": 1, "battlefield_has": ["Electrozoa"] }, {} ],
   "tapped": { "Electrozoa": false }
  }
 },
 {
  "name": "ruling: energy belongs to the player and stays after Electrozoa leaves",
  "players": [
   { "hand": ["Electrozoa", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Electrozoa" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Electrozoa"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "energy": 2, "graveyard_has": ["Electrozoa", "Lightning Bolt"] }, {} ]
  }
 }
]
