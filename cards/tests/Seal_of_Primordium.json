[
 {
  "name": "sacrifices itself to destroy an enchantment",
  "players": [
   {
    "battlefield": [
     "Seal of Primordium",
     "Seal of Strength"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Seal of Primordium",
    "targets": [
     "Seal of Strength"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard_has": [
      "Seal of Primordium",
      "Seal of Strength"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "can destroy an artifact",
  "players": [
   {
    "battlefield": [
     "Seal of Primordium",
     "Sol Ring"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Seal of Primordium",
    "targets": [
     "Sol Ring"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard_has": [
      "Seal of Primordium"
     ],
     "battlefield_lacks": [
      "Sol Ring"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: the ability may target its own source; the sacrifice happens and nothing else is destroyed",
  "players": [ { "battlefield": ["Seal of Primordium", "Sol Ring"] }, {} ],
  "steps": [ { "activate": "Seal of Primordium", "targets": ["Seal of Primordium"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Seal of Primordium"], "battlefield_has": ["Sol Ring"] }, {} ] }
 },
 {
  "name": "ruling: a creature made an artifact by Liquimetal Coating can be destroyed (not modal)",
  "players": [ { "battlefield": ["Seal of Primordium", "Liquimetal Coating"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "activate": "Liquimetal Coating", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Seal of Primordium", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Seal of Primordium"] }, { "graveyard": ["Grizzly Bears"] } ] }
 }
]