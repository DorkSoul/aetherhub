[
  {
    "name": "draw two, discard one, create a tapped Powerstone",
    "players": [
      { "hand": ["Stern Lesson"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Stern Lesson" },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [{ "hand_count": 1, "graveyard_has": ["Forest", "Stern Lesson"], "battlefield_has": ["Powerstone"] }, {}],
      "tapped": { "Powerstone": true }
    }
  },
  {
    "name": "the discarded card is the one you choose",
    "players": [
      { "hand": ["Stern Lesson"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Stern Lesson" },
      { "resolve": true, "answers": ["Mountain"] }
    ],
    "expect": {
      "players": [{ "hand_count": 1, "graveyard_has": ["Mountain"] }, {}]
    }
  },
  {
    "name": "ruling: Powerstone mana can pay an ability's cost (Icy Manipulator's {1})",
    "players": [
      { "battlefield": ["Icy Manipulator", "Powerstone"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Icy Manipulator", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Powerstone": true, "Icy Manipulator": true }
    }
  },
  {
    "name": "ruling: Powerstone mana can't be spent to cast a nonartifact spell (3 mana with it, only 2 without)",
    "players": [
      { "hand": ["Stern Lesson"], "battlefield": ["Island", "Island", "Powerstone"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Stern Lesson", "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Stern Lesson"] }, {}]
    }
  }
]
