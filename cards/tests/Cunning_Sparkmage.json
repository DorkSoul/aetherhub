[
  {
    "name": "haste: pings the opponent right away",
    "players": [
      { "hand": ["Cunning Sparkmage"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Cunning Sparkmage" },
      { "resolve": true },
      { "activate": "Cunning Sparkmage", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ],
      "tapped": { "Cunning Sparkmage": true }
    }
  },
  {
    "name": "kills an X/1 creature",
    "players": [
      { "battlefield": ["Cunning Sparkmage"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "activate": "Cunning Sparkmage", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Savannah Lions"] } ]
    }
  },
  {
    "name": "tapped: can't ping again",
    "players": [
      { "battlefield": [ { "name": "Cunning Sparkmage", "tapped": true } ] },
      {}
    ],
    "steps": [
      { "activate": "Cunning Sparkmage", "targets": ["p1"], "illegal": true }
    ],
    "expect": {}
  }
]
