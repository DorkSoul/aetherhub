[
  {
    "name": "enters: returns an Aura from your graveyard to hand",
    "players": [
      { "hand": ["Super Mutant Scavenger"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Pacifism"] },
      {}
    ],
    "steps": [
      { "cast": "Super Mutant Scavenger" },
      { "resolve": true, "targets": ["Pacifism"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Pacifism"], "hand_count": 1, "battlefield_has": ["Super Mutant Scavenger"] }, {} ]
    }
  },
  {
    "name": "enters with no Aura or Equipment in graveyard: nothing returns",
    "players": [
      { "hand": ["Super Mutant Scavenger"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Super Mutant Scavenger" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard": ["Grizzly Bears"], "battlefield_has": ["Super Mutant Scavenger"] }, {} ]
    }
  },
  {
    "name": "dies: returns an Aura from your graveyard to hand",
    "players": [
      { "battlefield": [ { "name": "Super Mutant Scavenger", "sick": false } ], "graveyard": ["Pacifism"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Super Mutant Scavenger"] },
      { "resolve": true, "targets": ["Pacifism"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Pacifism"], "graveyard_has": ["Super Mutant Scavenger"] }, { "graveyard_has": ["Doom Blade"] } ]
    }
  },
  {
    "name": "dies with no Aura or Equipment in your graveyard: nothing returns",
    "players": [
      { "battlefield": [ { "name": "Super Mutant Scavenger", "sick": false } ], "graveyard": ["Grizzly Bears"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Super Mutant Scavenger"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard_has": ["Super Mutant Scavenger", "Grizzly Bears"] }, {} ]
    }
  }
]
