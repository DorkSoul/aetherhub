[
 { "name": "destroys the target and every land with the same name",
   "players": [ { "hand": ["Wake of Destruction"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest", "Forest", "Island"] } ],
   "steps": [ { "cast": "Wake of Destruction", "targets": ["Forest"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Island"], "graveyard": ["Forest", "Forest"] } ] } },
 { "name": "lands with other names survive, own same-named lands die too",
   "players": [ { "hand": ["Wake of Destruction"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Island"] }, { "battlefield": ["Mountain", "Forest"] } ],
   "steps": [ { "cast": "Wake of Destruction", "targets": ["Island"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Mountain"] }, { "battlefield": ["Mountain", "Forest"] } ] } },
 { "name": "ruling: Wake of Destruction matches names, not types: a Forest Island (Breeding Pool) survives when a Forest is targeted",
   "players": [ { "hand": ["Wake of Destruction"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest", "Forest", "Breeding Pool"] } ],
   "steps": [ { "cast": "Wake of Destruction", "targets": ["Forest"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Breeding Pool"], "graveyard": ["Forest", "Forest"] } ] } },
 { "name": "ruling: targeting Breeding Pool destroys only lands named Breeding Pool, so the Forests survive",
   "players": [ { "hand": ["Wake of Destruction"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest", "Forest", "Breeding Pool"] } ],
   "steps": [ { "cast": "Wake of Destruction", "targets": ["Breeding Pool"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Forest", "Forest"], "graveyard": ["Breeding Pool"] } ] } }
