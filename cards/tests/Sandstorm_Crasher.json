[
  {
    "name": "exert: a tapped, attacking copy of a chosen creature you control deals damage",
    "players": [
      { "battlefield": ["Sandstorm Crasher", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Sandstorm Crasher", "at": "p1" } ] },
      { "resolve": true, "answers": [true, "Grizzly Bears"] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ {}, { "life": 15 } ],
      "tapped": { "Sandstorm Crasher": true }
    }
  },
  {
    "name": "the attacking token copy is sacrificed at the beginning of the next end step",
    "players": [
      { "battlefield": ["Sandstorm Crasher", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Sandstorm Crasher", "at": "p1" } ] },
      { "resolve": true, "answers": [true, "Grizzly Bears"] },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield": ["Sandstorm Crasher", "Grizzly Bears"] }, { "life": 15 } ]
    }
  },
  {
    "name": "declining the exert makes no copy and deals only the Crasher's damage",
    "players": [
      { "battlefield": ["Sandstorm Crasher", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Sandstorm Crasher", "at": "p1" } ] },
      { "resolve": true, "answers": [false] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield": ["Sandstorm Crasher", "Grizzly Bears"] }, { "life": 17 } ]
    }
  },
  {
    "name": "an exerted Crasher does not untap during your next untap step",
    "players": [
      { "battlefield": ["Sandstorm Crasher"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Sandstorm Crasher", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Sandstorm Crasher": true }
    }
  },
  {
    "name": "ruling: an enters ability of the copied creature triggers for the token copy",
    "players": [
      { "battlefield": ["Sandstorm Crasher", "Harmonious Archon"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Sandstorm Crasher", "at": "p1" } ] },
      { "resolve": true, "answers": [true, "Harmonious Archon"] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Harmonious Archon", "Human", "Human"] }, { "life": 13 } ]
    }
  }
]
