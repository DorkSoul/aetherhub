[
 {
  "name": "prowess: noncreature spell gives +1/+1 until end of turn",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Wing Commando"] }, {} ],
  "steps": [
    { "cast": "Lightning Bolt", "targets": ["p1"] },
    { "resolve": true },
    { "resolve": true }
  ],
  "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Wing Commando": [3, 3] } }
 },
 {
  "name": "flying: a non-flying creature cannot block it",
  "players": [ { "battlefield": ["Wing Commando"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "attack": [{ "card": "Wing Commando", "at": "p1" }] },
    { "block": [{ "blocker": "Grizzly Bears", "attacker": "Wing Commando" }], "illegal": true }
  ],
  "expect": { "pt": { "Wing Commando": [2, 2] } }
 },
 {
  "name": "ruling: casting a creature spell does not trigger prowess (Wing Commando stays 2/2)",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Wing Commando"] }, {} ],
  "steps": [
    { "cast": "Grizzly Bears" },
    { "resolve": true }
  ],
  "expect": { "pt": { "Wing Commando": [2, 2] } }
 },
 {
  "name": "ruling: playing a land does not trigger prowess (Wing Commando stays 2/2)",
  "players": [ { "hand": ["Forest"], "battlefield": ["Wing Commando"] }, {} ],
  "steps": [
    { "play_land": "Forest" }
  ],
  "expect": { "pt": { "Wing Commando": [2, 2] } }
 },
 {
  "name": "ruling: prowess trigger is not connected to its spell: countering Lightning Bolt still leaves Wing Commando at 3/3",
  "players": [
    { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Wing Commando"] },
    { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
    { "cast": "Lightning Bolt", "targets": ["p1"] },
    { "pass": true },
    { "cast": "Counterspell", "player": 1 },
    { "resolve": true }
  ],
  "expect": {
    "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Counterspell"], "life": 20 } ],
    "pt": { "Wing Commando": [3, 3] }
  }
 }
]
