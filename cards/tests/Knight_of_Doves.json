[
  { "name": "our enchantment put into graveyard from battlefield makes a Bird",
    "players": [ { "hand": ["Beastmaster's Magemark", "Disenchant"], "battlefield": ["Knight of Doves", "Grizzly Bears", "Forest", "Forest", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Beastmaster's Magemark", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Disenchant", "targets": ["Beastmaster's Magemark"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bird 1-1 White Flying"], "graveyard_has": ["Beastmaster's Magemark"] }, {} ] } },
  { "name": "creatures dying do not make Birds",
    "players": [ { "battlefield": ["Knight of Doves", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Bird 1-1 White Flying"] }, {} ] } },
  { "name": "ruling: Knight of Doves destroyed together with an Aura it enchants (not destroyed by the same effect) makes no Bird",
    "players": [ { "hand": ["Beastmaster's Magemark", "Wrath of God"], "battlefield": ["Knight of Doves", "Forest", "Forest", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Beastmaster's Magemark", "targets": ["Knight of Doves"] }, { "resolve": true }, { "cast": "Wrath of God" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Knight of Doves", "Beastmaster's Magemark"], "battlefield_lacks": ["Bird 1-1 White Flying"] }, {} ], "stack_empty": true } }
]
