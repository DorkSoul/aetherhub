[
  {
    "name": "enters with three +1/+1 counters",
    "players": [
      { "hand": ["Gargantos, the Endbringer"], "battlefield": ["Swamp", "Forest", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Gargantos, the Endbringer" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Gargantos, the Endbringer": [3, 3] },
      "counters": { "Gargantos, the Endbringer": { "p1p1": 3 } }
    }
  },
  {
    "name": "your upkeep doubles its +1/+1 counters",
    "players": [
      { "hand": ["Gargantos, the Endbringer"], "battlefield": ["Swamp", "Forest", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Gargantos, the Endbringer" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Gargantos, the Endbringer": [6, 6] },
      "counters": { "Gargantos, the Endbringer": { "p1p1": 6 } }
    }
  },
  {
    "name": "combat damage to an opponent also hits each other opponent for that amount",
    "players": [ { "battlefield": [ { "name": "Gargantos, the Endbringer", "counters": { "p1p1": 3 } } ] }, {}, {} ],
    "steps": [ { "attack": [ { "card": "Gargantos, the Endbringer", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 17 }, { "life": 17 } ] }
  },
  {
    "name": "blocked: no combat damage to a player, so no damage to the other opponent",
    "players": [ { "battlefield": [ { "name": "Gargantos, the Endbringer", "counters": { "p1p1": 3 } } ] }, { "battlefield": ["Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Gargantos, the Endbringer", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Gargantos, the Endbringer" } ], "player": 1 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 }, { "life": 20 } ] }
  }
]
