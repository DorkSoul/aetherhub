[
 {
  "name": "with the city's blessing it goes to the library bottom and takes an extra turn",
  "players": [
   {
    "battlefield": [
     "Timestream Navigator",
     "Island",
     "Island",
     "Island",
     "Island",
     "Island",
     "Island",
     "Island",
     "Island",
     "Island"
    ],
    "hand": [
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Forest"
   },
   {
    "activate": "Timestream Navigator"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main1",
    "auto": true
   },
   {
    "play_land": "Forest"
   }
  ],
  "expect": {
   "turn": 2,
   "players": [
    {
     "library_count": 0,
     "battlefield_lacks": [
      "Timestream Navigator"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "without the city's blessing it cannot be activated",
  "players": [
   {
    "battlefield": [
     "Timestream Navigator",
     "Island",
     "Island",
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Timestream Navigator",
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Timestream Navigator"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: a spell is not a permanent and does not count toward the blessing",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Timestream Navigator", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "activate": "Timestream Navigator", "illegal": true },
   { "resolve": true },
   { "activate": "Timestream Navigator", "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Timestream Navigator"], "hand_count": 0 }, { "graveyard": ["Grizzly Bears"] } ]
  }
 },
 {
  "name": "ruling: the blessing is kept after dropping below ten permanents",
  "players": [
   { "hand": ["Unsummon"], "battlefield": ["Timestream Navigator", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Unsummon", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "activate": "Timestream Navigator" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_lacks": ["Timestream Navigator"], "hand": ["Grizzly Bears"] }, {} ]
  }
 },
 {
  "name": "ruling: a land played as the tenth permanent gives the blessing",
  "players": [
   { "hand": ["Forest"], "battlefield": ["Timestream Navigator", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "play_land": "Forest" },
   { "activate": "Timestream Navigator" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_lacks": ["Timestream Navigator"] }, {} ]
  }
 }
]