[
  {
    "name": "ETB: may search for a creature with embalm and put it into the graveyard",
    "players": [
      {
        "hand": ["Vizier of the Anointed"],
        "battlefield": ["Island", "Island", "Island", "Island"],
        "library": ["Anointer Priest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Vizier of the Anointed" },
      { "resolve": true, "answers": [true, ["Anointer Priest"]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Anointer Priest"], "battlefield_has": ["Vizier of the Anointed"] },
        {}
      ]
    }
  },
  {
    "name": "ETB: declining the search leaves the library alone",
    "players": [
      {
        "hand": ["Vizier of the Anointed"],
        "battlefield": ["Island", "Island", "Island", "Island"],
        "library": ["Anointer Priest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Vizier of the Anointed" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard": [], "battlefield_has": ["Vizier of the Anointed"] },
        {}
      ]
    }
  },
  {
    "name": "ETB: a creature without embalm or eternalize cannot be found",
    "players": [
      {
        "hand": ["Vizier of the Anointed"],
        "battlefield": ["Island", "Island", "Island", "Island"],
        "library": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Vizier of the Anointed" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": [], "battlefield_has": ["Vizier of the Anointed"] },
        {}
      ]
    }
  },
  {
    "name": "activating an embalm ability draws a card",
    "players": [
      {
        "battlefield": ["Vizier of the Anointed", "Plains", "Plains", "Plains", "Plains"],
        "graveyard": ["Anointer Priest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Anointer Priest", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": [], "battlefield_has": ["Vizier of the Anointed", "Anointer Priest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the embalm draw happens before the ability resolves, after its cost is paid",
    "players": [
      {
        "battlefield": ["Vizier of the Anointed", "Plains", "Plains", "Plains", "Plains"],
        "graveyard": ["Anointer Priest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Anointer Priest", "ability": 0 },
      { "pass": true },
      { "pass": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": [], "battlefield_lacks": ["Anointer Priest"] },
        {}
      ]
    }
  }
]
