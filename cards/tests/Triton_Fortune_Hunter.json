[
  {
    "name": "heroic: a spell targeting it draws a card",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Forest",
          "Triton Fortune Hunter"
        ],
        "library": [
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Triton Fortune Hunter"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Forest"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "a spell targeting another creature draws nothing",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Forest",
          "Triton Fortune Hunter",
          "Grizzly Bears"
        ],
        "library": [
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": []
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the heroic trigger resolves before the spell that caused it",
    "players": [
      {
        "hand": ["Giant Growth"],
        "battlefield": ["Forest", "Triton Fortune Hunter"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Triton Fortune Hunter"] },
      { "pass": true },
      { "pass": true }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ { "hand": ["Forest"] }, {} ]
    }
  },
  {
    "name": "ruling: copying a spell that targets it does not trigger heroic",
    "players": [
      {
        "hand": ["Giant Growth", "Twincast"],
        "battlefield": ["Forest", "Island", "Island", "Triton Fortune Hunter"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Triton Fortune Hunter"] },
      { "cast": "Twincast", "targets": [{ "stack": "Giant Growth" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"] }, {} ]
    }
  }
]
