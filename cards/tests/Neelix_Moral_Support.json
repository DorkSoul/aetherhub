[
  {
    "name": "enters and creates a Food token",
    "players": [{ "hand": ["Neelix, Moral Support"], "battlefield": ["Forest", "Forest"] }, {}],
    "steps": [
      { "cast": "Neelix, Moral Support" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Neelix, Moral Support", "Food"] }, {}] }
  },
  {
    "name": "gaining life puts a +1/+1 counter on Neelix",
    "players": [
      { "battlefield": ["Neelix, Moral Support", "Food", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Food", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 23 }, {}], "pt": { "Neelix, Moral Support": [2, 2] } }
  },
  {
    "name": "an opponent gaining life does not put a counter on Neelix",
    "players": [
      { "battlefield": ["Neelix, Moral Support"] },
      { "battlefield": ["Food", "Forest", "Forest"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Food", "ability": 0, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "life": 23 }], "pt": { "Neelix, Moral Support": [1, 1] } }
  }
]
