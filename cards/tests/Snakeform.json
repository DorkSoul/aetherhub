[
  {
    "name": "ruling: an activated ability already on the stack still resolves after Snakeform resolves",
    "players": [
      { "battlefield": ["Ith, High Arcanist"] },
      { "hand": ["Snakeform"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Island"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "pass": true, "player": 1 },
      { "activate": "Ith, High Arcanist", "ability": 0, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 0 },
      { "cast": "Snakeform", "player": 1, "targets": ["Ith, High Arcanist"] },
      { "pass": true, "player": 1 },
      { "pass": true, "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Ith, High Arcanist"] }, { "graveyard": ["Snakeform"], "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Ith, High Arcanist": [1, 1] } }
  },
  {
    "name": "target creature becomes a green 1/1 Snake and you draw a card",
    "players": [
      {
        "hand": [
          "Snakeform"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Snakeform",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Snakeform"
          ],
          "hand_count": 1
        },
        {}
      ],
      "pt": {
        "Serra Angel": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "loses flying: a Grizzly Bears can block it after Snakeform",
    "players": [
      {
        "hand": [
          "Snakeform"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Island",
          "Serra Angel"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Snakeform",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Serra Angel",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Grizzly Bears",
            "attacker": "Serra Angel"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Snakeform",
            "Serra Angel"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  }
]
