      {
        "hand": [
          "Repair and Recharge"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {
        "graveyard": [
          "Worn Powerstone"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Repair and Recharge",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Repair and Recharge"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Powerstone token has the Powerstone artifact subtype",
    "players": [
      {
        "hand": ["Repair and Recharge"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"],
        "graveyard": ["Worn Powerstone"]
      },
      {}
    ],
    "steps": [
      { "cast": "Repair and Recharge", "targets": ["Worn Powerstone"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Powerstone"] },
        {}
      ],
      "subtypes": { "Powerstone": ["Powerstone"] }
    }
  },
  {
    "name": "ruling: a Powerstone's mana cannot be spent to cast a nonartifact spell",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Powerstone"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Lightning Bolt"], "battlefield_has": ["Powerstone"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a Powerstone's mana pays for an activated ability of a nonartifact permanent",
    "players": [
      { "battlefield": ["Witching Well", "Powerstone", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Witching Well", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Witching Well"], "hand_count": 2 },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Powerstone's mana pays for an artifact spell",
    "players": [
      { "hand": ["Worn Powerstone"], "battlefield": ["Powerstone", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Worn Powerstone" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "battlefield_has": ["Worn Powerstone"] },
        {}
      ]
    }
