[
  {
    "name": "unblocked attack: sacrifice it to steal a creature",
    "players": [
      { "battlefield": ["Thalakos Deceiver"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Thalakos Deceiver", "at": "p1" } ] },
      { "block": [], "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Thalakos Deceiver"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "unblocked attack: declining keeps the creature and the target",
    "players": [
      { "battlefield": ["Thalakos Deceiver"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Thalakos Deceiver", "at": "p1" } ] },
      { "block": [], "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [false] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": [] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "blocked by a shadow creature: no trigger",
    "players": [
      { "battlefield": ["Thalakos Deceiver"] },
      { "battlefield": ["Thalakos Seer"] }
    ],
    "steps": [
      { "attack": [ { "card": "Thalakos Deceiver", "at": "p1" } ] },
      { "block": [ { "blocker": "Thalakos Seer", "attacker": "Thalakos Deceiver" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Thalakos Deceiver"] },
        { "graveyard": ["Thalakos Seer"] }
      ]
    }
  },
  {
    "name": "ruling: a blocked creature stays blocked after its blocker loses shadow",
    "players": [
      { "battlefield": ["Thalakos Deceiver"] },
      { "hand": ["Reality Anchor"], "battlefield": ["Thalakos Seer", "Forest", "Forest"] }
    ],
    "steps": [
      { "attack": [ { "card": "Thalakos Deceiver", "at": "p1" } ] },
      { "block": [ { "blocker": "Thalakos Seer", "attacker": "Thalakos Deceiver" } ] },
      { "pass": true },
      { "cast": "Reality Anchor", "player": 1, "targets": ["Thalakos Seer"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Thalakos Deceiver"], "life": 20 },
        { "life": 20, "graveyard_has": ["Thalakos Seer", "Reality Anchor"] }
      ]
    }
  }
]
