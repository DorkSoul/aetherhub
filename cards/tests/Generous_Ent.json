 {
  "name": "forestcycling {1} discards it and fetches a Forest",
  "players": [
   {
    "hand": [
     "Generous Ent"
    ],
    "battlefield": [
     "Mountain"
    ],
    "library": [
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Generous Ent"
   },
   {
    "resolve": true,
    "answers": [
     "Forest"
    ]
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Forest"
     ],
     "graveyard": [
      "Generous Ent"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: typecycling is not a draw; the hand holds only the fetched Forest",
  "players": [
   {
    "hand": ["Generous Ent"],
    "battlefield": ["Mountain"],
    "library": ["Forest", "Grizzly Bears"]
   },
   {}
  ],
  "steps": [
   { "activate": "Generous Ent" },
   { "resolve": true, "answers": ["Forest"] }
  ],
  "expect": {
   "players": [
    { "hand": ["Forest"], "hand_count": 1, "graveyard": ["Generous Ent"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: a 'when you cycle' ability also triggers on forestcycling",
  "players": [
   {
    "hand": ["Generous Ent"],
    "battlefield": ["Astral Drift", "Mountain"],
    "library": ["Forest"]
   },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "activate": "Generous Ent", "targets": ["p1:Grizzly Bears"] },
   { "resolve": true, "answers": [true, "Forest"] }
  ],
  "expect": {
   "players": [
    { "hand": ["Forest"], "graveyard": ["Generous Ent"] },
    { "exile": ["Grizzly Bears"] }
   ]
  }
 }
]
