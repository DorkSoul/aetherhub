  {
    "name": "with 49 life at your upkeep you do not win",
    "players": [
      {
        "life": 49,
        "battlefield": [
          "Test of Endurance"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "winner": -1
    }
  },
  {
    "name": "it only checks at your own upkeep",
    "players": [
      {
        "life": 50,
        "battlefield": [
          "Test of Endurance"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "winner": -1
    }
  },
  {
    "name": "ruling: life lost in response to the upkeep trigger stops the win on resolution",
    "players": [
      {
        "life": 50,
        "hand": ["Lightning Bolt"],
        "battlefield": ["Test of Endurance", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "hold": true },
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 47, "graveyard": ["Lightning Bolt"] },
        {}
      ],
      "winner": -1
    }
  }
]