[
  {
    "name": "legendary creature gets a counter, then fights",
    "players": [
      {
        "hand": [
          "Ancient Animus"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Mirri, Cat Warrior"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Ancient Animus",
        "targets": [
          "Mirri, Cat Warrior",
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Mirri, Cat Warrior": [
          3,
          4
        ]
      },
      "counters": {
        "Mirri, Cat Warrior": {
          "p1p1": 1
        }
      },
      "players": [
        {},
        {
          "graveyard": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "non-legendary creature gets no counter and fights",
    "players": [
      {
        "hand": [
          "Ancient Animus"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Ancient Animus",
        "targets": [
          "Grizzly Bears",
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield_has": [
            "Hill Giant"
          ]
        }
      ],
      "pt": {
        "Hill Giant": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "ruling: legendary creature still gets the counter when the opposing target became illegal",
    "players": [
      { "hand": ["Ancient Animus", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Mountain", "Mirri, Cat Warrior"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Ancient Animus", "targets": ["Mirri, Cat Warrior", "Hill Giant"] },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Mirri, Cat Warrior": [3, 4] },
      "counters": { "Mirri, Cat Warrior": { "p1p1": 1 } },
      "players": [ { "battlefield_has": ["Mirri, Cat Warrior"] }, { "graveyard": ["Hill Giant"] } ]
    }
  },
  {
    "name": "ruling: if your creature is illegal, neither creature deals or is dealt damage",
    "players": [
      { "hand": ["Ancient Animus", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Mountain", "Mirri, Cat Warrior"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ancient Animus", "targets": ["Mirri, Cat Warrior", "Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Mirri, Cat Warrior"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Mirri, Cat Warrior"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: cannot cast without a creature you control and a creature an opponent controls",
    "players": [
      { "hand": ["Ancient Animus"], "battlefield": ["Forest", "Forest", "Mirri, Cat Warrior"] },
      {}
    ],
    "steps": [
      { "cast": "Ancient Animus", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Ancient Animus"] }, {} ] }
  }
]
