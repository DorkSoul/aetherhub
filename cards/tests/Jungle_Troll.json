[
 {
  "name": "{R} regenerates the Troll when it would die in combat",
  "players": [
   {
    "battlefield": [
     "Jungle Troll",
     "Mountain"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Main1",
    "player": 1
   },
   {
    "attack": [
     {
      "card": "Hill Giant",
      "at": "p0"
     }
    ]
   },
   {
    "block": [
     {
      "blocker": "Jungle Troll",
      "attacker": "Hill Giant"
     }
    ]
   },
   {
    "pass": true,
    "player": 1
   },
   {
    "activate": "Jungle Troll",
    "ability": 0,
    "player": 0
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {
