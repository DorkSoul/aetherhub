      "Jungle Troll"
     ]
    },
    {
     "battlefield_has": [
      "Hill Giant"
     ]
    }
   ]
  }
 },
 {
  "name": "cannot regenerate with {R} when only Forest is available",
  "players": [
   {
    "battlefield": [
     "Jungle Troll",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Jungle Troll",
    "ability": 0,
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Jungle Troll"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "{G} regenerates the Troll, so Doom Blade's destruction is replaced",
  "players": [{ "hand": ["Doom Blade"], "battlefield": ["Jungle Troll", "Forest", "Swamp", "Swamp"] }, {}],
  "steps": [{ "activate": "Jungle Troll", "ability": 1 }, { "resolve": true }, { "cast": "Doom Blade", "targets": ["Jungle Troll"] }, { "resolve": true }],
  "expect": { "players": [{ "battlefield_has": ["Jungle Troll"], "graveyard_has": ["Doom Blade"] }, {}] }
 },
 {
  "name": "{G} regeneration needs a green source",
  "players": [{ "battlefield": ["Jungle Troll", "Swamp"] }, {}],
  "steps": [{ "activate": "Jungle Troll", "ability": 1, "illegal": true }],
  "expect": { "players": [{ "battlefield_has": ["Jungle Troll"] }, {}] }
 }
]