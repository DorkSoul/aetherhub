[
 { "name": "damage can't be prevented this turn: a prevention shield does nothing",
   "players": [ { "hand": ["Flaring Pain", "Healing Salve", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Flaring Pain" }, { "resolve": true },
              { "cast": "Healing Salve", "answers": [1], "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] } ] } },
 { "name": "without Flaring Pain the same prevention shield works",
   "players": [ { "hand": ["Healing Salve", "Lightning Bolt"], "battlefield": ["Mountain", "Plains", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Healing Salve", "answers": [1], "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "flashback for {R} from the graveyard, then exiled",
   "players": [ { "graveyard": ["Flaring Pain"], "battlefield": ["Mountain"] }, {} ],
   "steps": [ { "cast": "Flaring Pain", "alt": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Flaring Pain"] }, {} ] } },
 { "name": "ruling: a flashback spell that is countered is still exiled",
   "players": [ { "graveyard": ["Flaring Pain"], "battlefield": ["Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Flaring Pain", "alt": 0 }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Flaring Pain" }] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Flaring Pain"] }, { "graveyard": ["Counterspell"] } ] } }
]
