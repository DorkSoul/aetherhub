[
  {
    "name": "Aura spells can't target it",
    "players": [
      {
        "hand": ["Dead Weight"],
        "battlefield": ["Swamp"]
      },
      {
        "battlefield": ["Tetsuo Umezawa"]
      }
    ],
    "steps": [
      {
        "cast": "Dead Weight",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Dead Weight"]
        },
        {
          "battlefield": ["Tetsuo Umezawa"]
        }
      ]
    }
  },
  {
    "name": "a non-Aura targeted spell can still target it",
    "players": [
      {
        "hand": ["Murder"],
        "battlefield": ["Swamp", "Swamp", "Swamp"]
      },
      {
        "battlefield": ["Tetsuo Umezawa"]
      }
    ],
    "steps": [
      {
        "cast": "Murder",
        "targets": ["Tetsuo Umezawa"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard": ["Tetsuo Umezawa"]
        }
      ]
    }
  },
  {
    "name": "its own destroy ability still targets a tapped creature",
    "players": [
      {
        "battlefield": ["Island", "Swamp", "Swamp", "Mountain", {"name": "Tetsuo Umezawa", "sick": false}]
      },
      {
        "battlefield": [{"name": "Grizzly Bears", "tapped": true}]
      }
    ],
    "steps": [
      {
        "activate": "Tetsuo Umezawa",
        "ability": 0,
        "targets": ["Grizzly Bears"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard": ["Grizzly Bears"]
        }
      ]
    }
  },
  {
    "name": "ruling: an Aura can be moved onto it (only casting an Aura spell is blocked)",
    "players": [
      {
        "hand": ["Frogify", "Aura Graft"],
        "battlefield": ["Island", "Island", "Plains", "Plains", {"name": "Tetsuo Umezawa", "sick": false}, {"name": "Grizzly Bears", "sick": false}]
      },
      {}
    ],
    "steps": [
      { "cast": "Frogify", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Aura Graft", "targets": ["Frogify"] },
      { "resolve": true, "answers": ["Tetsuo Umezawa"] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Frogify", "Tetsuo Umezawa"] }, {}],
      "attached": { "Frogify": "Tetsuo Umezawa" }
    }
  },
  {
    "name": "ruling: an Aura's triggered ability can target it",
    "players": [
      {
        "hand": ["Ancestral Vengeance"],
        "battlefield": ["Swamp", "Swamp", {"name": "Tetsuo Umezawa", "sick": false}]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ancestral Vengeance", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Ancestral Vengeance", "Tetsuo Umezawa"] }, {}],
      "pt": { "Tetsuo Umezawa": [4, 4] }
    }
  }
]
