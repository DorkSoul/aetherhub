[
  {
    "name": "dash: haste, attacks for 5, returns to hand at end step",
    "players": [
      { "hand": ["Pitiless Horde"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Pitiless Horde", "alt": 0 },
      { "resolve": true },
      { "resolve": true },
      { "attack": [ { "card": "Pitiless Horde", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Pitiless Horde"], "battlefield_has": [] },
        { "life": 15 }
      ]
    }
  },
  {
    "name": "normal cast for {2}{B}: no haste, stays on battlefield at end step",
    "players": [
      { "hand": ["Pitiless Horde"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Pitiless Horde" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Pitiless Horde"], "hand": [] },
        {}
      ]
    }
  },
  {
    "name": "dash illegal with only two mana",
    "players": [
      { "hand": ["Pitiless Horde"], "battlefield": ["Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Pitiless Horde", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Pitiless Horde"] }, {} ]
    }
  },
  {
    "name": "upkeep: you lose 2 life",
    "players": [
      { "battlefield": ["Pitiless Horde"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 18 }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: the dashed creature need not attack, and still returns to hand at the end step",
    "players": [
      { "hand": ["Pitiless Horde"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Pitiless Horde", "alt": 0 },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Pitiless Horde"], "battlefield_has": [] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: dashed creature removed before its return trigger resolves stays where it is",
    "players": [
      { "hand": ["Pitiless Horde"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Pitiless Horde", "alt": 0 },
      { "resolve": true },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Pitiless Horde"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Pitiless Horde"] },
        { "life": 20, "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: a Clone copying the dashed creature does not return to hand at the end step",
    "players": [
      { "hand": ["Pitiless Horde", "Clone"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Pitiless Horde", "alt": 0 },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Clone" },
      { "resolve": true, "answers": ["Pitiless Horde"] },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Pitiless Horde"], "battlefield_has": ["Pitiless Horde"] },
        {}
      ]
    }
  }
]
