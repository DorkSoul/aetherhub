[
  {
    "name": "draws one card with no copies in graveyard",
    "players": [
      {
        "hand": [
          "Frantic Inventory"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Frantic Inventory"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "graveyard": [
            "Frantic Inventory"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "draws one more per copy in graveyard",
    "players": [
      {
        "hand": [
          "Frantic Inventory"
        ],
        "battlefield": [
          "Island",
          "Island"
        ],
        "graveyard": [
          "Frantic Inventory"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Frantic Inventory"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the spell on the stack does not count itself when drawing",
    "players": [
      { "hand": ["Frantic Inventory"], "battlefield": ["Island", "Island"], "library": ["Lightning Bolt", "Shock"] },
      {}
    ],
    "steps": [ { "cast": "Frantic Inventory" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"], "library_top": ["Shock"] }, {} ] }
  }
]