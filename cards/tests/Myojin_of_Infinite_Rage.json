[
  {
    "name": "enters with a divinity counter when cast from hand",
    "players": [
      { "hand": ["Myojin of Infinite Rage"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Infinite Rage" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Infinite Rage"] }, {} ],
      "counters": { "Myojin of Infinite Rage": { "divinity": 1 } }
    }
  },
  {
    "name": "removing the counter destroys all lands (both players)",
    "players": [
      { "battlefield": [ { "name": "Myojin of Infinite Rage", "counters": { "divinity": 1 } }, "Mountain", "Mountain" ] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "activate": "Myojin of Infinite Rage", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Myojin of Infinite Rage"], "graveyard_has": ["Mountain", "Mountain"] },
        { "graveyard_has": ["Forest"] }
      ]
    }
  },
  {
    "name": "indestructible while it has a counter: Murder does not destroy it",
    "players": [
      { "battlefield": [ { "name": "Myojin of Infinite Rage", "counters": { "divinity": 1 } } ] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Infinite Rage"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Infinite Rage"] }, {} ],
      "counters": { "Myojin of Infinite Rage": { "divinity": 1 } }
    }
  },
  {
    "name": "without a counter Murder destroys it",
    "players": [
      { "battlefield": ["Myojin of Infinite Rage"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Infinite Rage"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Myojin of Infinite Rage"] }, {} ] }
  },
  {
    "name": "ruling: cast from the command zone is not cast from hand, so no divinity counter and no lands destroyed",
    "commander": true,
    "players": [
      { "command": ["Myojin of Infinite Rage"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Infinite Rage" },
      { "resolve": true },
      { "activate": "Myojin of Infinite Rage", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Infinite Rage"] }, {} ]
    }
  }
]
