[
  { "name": "attack trigger taps a creature of the defending player",
    "players": [
      { "battlefield": ["Plains", "Plains", { "name": "Master of Diversion", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Master of Diversion", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } } },
  { "name": "only the defending player's creatures are targeted in multiplayer",
    "players": [
      { "battlefield": [{ "name": "Master of Diversion", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Master of Diversion", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true, "Hill Giant": false } } },
  { "name": "ruling: the creature tapped by the attack trigger cannot block",
    "players": [ { "battlefield": [{ "name": "Master of Diversion", "sick": false }] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Master of Diversion", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Master of Diversion" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ], "tapped": { "Grizzly Bears": true } } }
]
