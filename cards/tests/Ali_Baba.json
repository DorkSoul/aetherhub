 {"name": "taps target Wall",
  "players": [{"battlefield": ["Ali Baba", "Mountain"]}, {"battlefield": ["Wall of Frost"]}],
  "steps": [{"activate": "Ali Baba", "targets": ["Wall of Frost"]}, {"resolve": true}],
  "expect": {"tapped": {"Wall of Frost": true}}},
 {"name": "cannot target a non-Wall",
  "players": [{"battlefield": ["Ali Baba", "Mountain"]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"activate": "Ali Baba", "illegal": true}],
  "expect": {"tapped": {"Grizzly Bears": false}}},
 {"name": "ruling: can tap more than one Wall in a turn (no {T} in the cost)",
  "players": [{"battlefield": ["Ali Baba", "Mountain", "Mountain"]}, {"battlefield": ["Wall of Frost", "Wall of Ice"]}],
  "steps": [{"activate": "Ali Baba", "targets": ["Wall of Frost"]}, {"resolve": true}, {"activate": "Ali Baba", "targets": ["Wall of Ice"]}, {"resolve": true}],
  "expect": {"tapped": {"Wall of Frost": true, "Wall of Ice": true}}},
 {"name": "ruling: works while Ali Baba itself is tapped",
  "players": [{"battlefield": [{"name": "Ali Baba", "tapped": true}, "Mountain"]}, {"battlefield": ["Wall of Frost"]}],
  "steps": [{"activate": "Ali Baba", "targets": ["Wall of Frost"]}, {"resolve": true}],
  "expect": {"tapped": {"Wall of Frost": true}}},
 {"name": "ruling: works the turn Ali Baba entered (summoning sick)",
  "players": [{"battlefield": [{"name": "Ali Baba", "sick": true}, "Mountain"]}, {"battlefield": ["Wall of Frost"]}],
  "steps": [{"activate": "Ali Baba", "targets": ["Wall of Frost"]}, {"resolve": true}],
  "expect": {"tapped": {"Wall of Frost": true}}}
