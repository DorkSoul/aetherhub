  },
  {
    "name": "may draw: declining draws nothing",
    "players": [
      { "battlefield": ["Vedalken Heretic"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Vedalken Heretic", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, { "life": 19 } ]
