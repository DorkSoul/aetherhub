[
  {
    "name": "combat damage to the opponent: may draw a card",
    "players": [
      { "battlefield": ["Vedalken Heretic"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Vedalken Heretic", "at": "p1" } ] },
      { "block": [] },
