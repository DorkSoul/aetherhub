  },
  {
    "name": "damage to a creature does not trigger",
    "players": [
      { "battlefield": ["Vedalken Heretic"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Vedalken Heretic", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Vedalken Heretic" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ { "hand_count": 0 }, {} ]
    }
  }
