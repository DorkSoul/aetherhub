[
  {
    "name": "enters: exile an instant with mana value 3 from your graveyard, 2 counters (half rounded up)",
    "players": [
      { "hand": ["Torrent Sculptor"], "battlefield": ["Island", "Island", "Island", "Island"], "graveyard": ["Cancel"] },
      {}
    ],
    "steps": [
      { "cast": "Torrent Sculptor" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Cancel"], "battlefield_has": ["Torrent Sculptor"], "graveyard": [] },
        {}
      ],
      "pt": { "Torrent Sculptor": [4, 4] }
    }
  },
  {
    "name": "enters: a mana value 1 instant gives 1 counter",
    "players": [
      { "hand": ["Torrent Sculptor"], "battlefield": ["Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "cast": "Torrent Sculptor" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Lightning Bolt"] },
        {}
      ],
      "pt": { "Torrent Sculptor": [3, 3] }
    }
  },
  {
    "name": "enters with no instant or sorcery in the graveyard: no counters",
    "players": [
      { "hand": ["Torrent Sculptor"], "battlefield": ["Island", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Torrent Sculptor" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        {}
      ],
      "pt": { "Torrent Sculptor": [2, 2] }
    }
  },
  {
    "name": "Flamethrower Sonata: discarding an instant deals its mana value to a creature you do not control",
    "players": [
      { "hand": ["Torrent Sculptor", "Cancel"], "battlefield": ["Mountain", "Mountain"], "library": ["Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Torrent Sculptor", "face": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Island"], "graveyard": ["Cancel", "Torrent Sculptor"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "Flamethrower Sonata: discarding a creature card deals no damage",
    "players": [
      { "hand": ["Torrent Sculptor", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain"], "library": ["Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Torrent Sculptor", "face": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Island"], "graveyard": ["Grizzly Bears", "Torrent Sculptor"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ward {2}: opponent has only 1 spare mana, cannot pay, Shock is countered",
    "players": [
      { "battlefield": ["Torrent Sculptor"] },
      { "hand": ["Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Torrent Sculptor"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Torrent Sculptor"] }, { "graveyard": ["Shock"] } ]
    }
  },
  {
    "name": "ward {2}: opponent pays 2 with a third Mountain, Shock resolves and kills the 2/2",
    "players": [
      { "battlefield": ["Torrent Sculptor"] },
      { "hand": ["Shock"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Torrent Sculptor"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Torrent Sculptor"] }, { "graveyard": ["Shock"] } ]
    }
