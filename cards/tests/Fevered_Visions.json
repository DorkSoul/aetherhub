[
  {
    "name": "your own end step: you draw, and you take no damage even with 4+ cards in hand",
    "players": [
      { "hand": ["Grizzly Bears", "Hill Giant", "Shock", "Forest"], "battlefield": ["Fevered Visions"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 5 }, { "life": 20 } ]
    }
  },
  {
    "name": "opponent's end step: opponent draws to 4 cards and takes 2 damage",
    "players": [
      { "battlefield": ["Fevered Visions"] },
      { "hand": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand_count": 4, "life": 18 } ]
    }
  },
  {
    "name": "opponent's end step: opponent drawing to 3 cards does not damage them",
    "players": [
      { "battlefield": ["Fevered Visions"] },
      { "hand": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand_count": 3, "life": 20 } ]
    }
  },
  {
    "name": "ruling: the hand size is checked after the draw, so the opponent takes 2 damage once their draw brings them to 4",
    "players": [
      { "battlefield": ["Fevered Visions"] },
      { "hand": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand_count": 4, "life": 18 } ]
    }
  }
