 {
  "name": "ruling: an adventure whose target is gone on resolution goes to the graveyard, not exile",
  "players": [
   { "hand": ["Minecart Daredevil // Ride the Rails"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "cast": "Minecart Daredevil // Ride the Rails", "face": true, "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Minecart Daredevil // Ride the Rails"], "exile": [] },
    { "graveyard_has": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: the creature can't be cast from exile outside a main phase",
  "players": [
