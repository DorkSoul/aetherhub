[
  {
    "name": "creates a Fractal with X counters where X is the number of lands you control",
    "players": [
      { "hand": ["Leyline Invocation"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Leyline Invocation" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Fractal 0-0 Green Blue", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
        {}
      ],
      "counters": { "Fractal 0-0 Green Blue": { "p1p1": 6 } },
      "pt": { "Fractal 0-0 Green Blue": [6, 6] }
    }
  },
  {
    "name": "cannot be cast with five lands and a creature (only lands count toward X and pay the cost)",
    "players": [
      { "hand": ["Leyline Invocation"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Serra Angel"] },
      {}
    ],
    "steps": [
      { "cast": "Leyline Invocation", "illegal": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "hand": ["Leyline Invocation"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: lands are counted as Leyline Invocation resolves (a land destroyed in response lowers X)",
    "players": [
      { "hand": ["Leyline Invocation"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Strip Mine"] }
    ],
    "steps": [
      { "cast": "Leyline Invocation" },
      { "pass": true },
      { "activate": "Strip Mine", "player": 1, "ability": 0, "targets": ["Forest"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Fractal 0-0 Green Blue", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard_has": ["Forest"] },
        { "graveyard_has": ["Strip Mine"] }
      ],
      "counters": { "Fractal 0-0 Green Blue": { "p1p1": 5 } },
      "pt": { "Fractal 0-0 Green Blue": [5, 5] }
    }
  }
]
