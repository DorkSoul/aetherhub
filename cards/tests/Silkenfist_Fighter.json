[
  {
    "name": "becoming blocked untaps it",
    "players": [
      { "battlefield": ["Silkenfist Fighter"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Silkenfist Fighter", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Silkenfist Fighter" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Silkenfist Fighter": false }
    }
  },
  {
    "name": "an unblocked attacker stays tapped",
    "players": [
      { "battlefield": ["Silkenfist Fighter"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Silkenfist Fighter", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Silkenfist Fighter": true }
    }
  }
]
