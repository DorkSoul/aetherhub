[
  {
    "name": "not bargained: 3 damage to a blocking creature (it survives a 4/4)",
    "players": [
      { "hand": ["Kellan's Lightblades"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Serra Angel", "attacker": "Grizzly Bears" }] },
      { "cast": "Kellan's Lightblades", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Kellan's Lightblades"] }, { "battlefield_has": ["Serra Angel"] } ]
    }
  },
  {
    "name": "bargained (sacrificed an artifact): destroy the blocking creature instead",
    "players": [
      { "hand": ["Kellan's Lightblades"], "battlefield": ["Plains", "Plains", "Adventuring Gear", "Grizzly Bears"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Serra Angel", "attacker": "Grizzly Bears" }] },
      { "cast": "Kellan's Lightblades", "targets": ["Serra Angel"], "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Kellan's Lightblades", "Adventuring Gear"] }, { "graveyard_has": ["Serra Angel"] } ]
    }
  },
  {
    "name": "cannot target a creature that is neither attacking nor blocking",
    "players": [
      { "hand": ["Kellan's Lightblades"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Kellan's Lightblades", "targets": ["Serra Angel"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Kellan's Lightblades"] }, { "battlefield_has": ["Serra Angel"] } ]
    }
  },
  {
    "name": "ruling: bargain sacrifices only one artifact even with two available",
    "players": [ { "hand": ["Kellan's Lightblades"], "battlefield": ["Plains", "Plains", "Ornithopter", "Adventuring Gear", "Grizzly Bears"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Serra Angel", "attacker": "Grizzly Bears" }] },
      { "cast": "Kellan's Lightblades", "targets": ["Serra Angel"], "answers": [true, [1]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Kellan's Lightblades", "Adventuring Gear"], "battlefield_has": ["Ornithopter"] }, { "graveyard_has": ["Serra Angel"] } ]
    }
  },
  {
    "name": "ruling: declining the optional bargain keeps the artifact and deals 3 damage",
    "players": [ { "hand": ["Kellan's Lightblades"], "battlefield": ["Plains", "Plains", "Adventuring Gear", "Grizzly Bears"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Serra Angel", "attacker": "Grizzly Bears" }] },
      { "cast": "Kellan's Lightblades", "targets": ["Serra Angel"], "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Kellan's Lightblades"], "battlefield_has": ["Adventuring Gear"] }, { "battlefield_has": ["Serra Angel"] } ]
    }
  }
]
