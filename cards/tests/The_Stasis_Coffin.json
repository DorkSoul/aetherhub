[
  {
    "name": "pay 2, tap and exile itself for protection from everything",
    "players": [
      { "battlefield": ["The Stasis Coffin", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "The Stasis Coffin" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "exile": ["The Stasis Coffin"] }, { "battlefield": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "needs {2} to activate",
    "players": [
      { "battlefield": ["The Stasis Coffin", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "The Stasis Coffin", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["The Stasis Coffin"] }, {}]
    }
  },
  {
    "name": "ruling: a spell targeting you fizzles when protection from everything resolves first",
    "players": [
      { "battlefield": ["The Stasis Coffin", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "pass": true, "player": 1 },
      { "activate": "The Stasis Coffin" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "exile": ["The Stasis Coffin"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "ruling: protection from everything lets creatures attack you but prevents their combat damage",
    "players": [
      { "battlefield": ["The Stasis Coffin", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "The Stasis Coffin" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20, "exile": ["The Stasis Coffin"] }, {} ] }
  }
]
