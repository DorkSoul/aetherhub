[
  {
    "name": "upkeep: a land on top goes onto the battlefield",
    "players": [
      { "battlefield": ["Into the Wilds"], "library": ["Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Into the Wilds", "Forest"] }, {} ]
    }
  },
  {
    "name": "upkeep: a nonland card stays on top and is drawn",
    "players": [
      { "battlefield": ["Into the Wilds"], "library": ["Lightning Bolt", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Draw" },
      { "advance_to": "Draw" }
    ],
    "expect": {
      "players": [ { "hand": ["Lightning Bolt"], "battlefield_lacks": ["Lightning Bolt"] }, {} ]
    }
  },
  {
    "name": "ruling: a land put onto the battlefield by Into the Wilds does not use the land drop",
    "players": [
      { "hand": ["Plains"], "battlefield": ["Into the Wilds"], "library": ["Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": ["Forest"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "play_land": "Plains" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Into the Wilds", "Forest", "Plains"] }, {} ]
    }
  },
  {
    "name": "ruling: declining to put the land onto the battlefield leaves it on top to be drawn",
    "players": [
      { "battlefield": ["Into the Wilds"], "library": ["Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[]] },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "battlefield_lacks": ["Forest"] }, {} ]
    }
  }
]
