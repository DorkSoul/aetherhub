      { "battlefield": ["Furnace Brood", "Mountain", "Swamp", "Sedge Troll"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Furnace Brood", "ability": 0, "targets": ["Sedge Troll"] },
      { "resolve": true },
      { "activate": "Sedge Troll" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Sedge Troll"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Sedge Troll"] }, {}]
    }
  },
  {
    "name": "untargeted creature still regenerates",
    "players": [
      { "battlefield": ["Furnace Brood", "Mountain", "Swamp", "Sedge Troll"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Sedge Troll" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Sedge Troll"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Sedge Troll", "Furnace Brood"] }, {}]
    }
  }
]
