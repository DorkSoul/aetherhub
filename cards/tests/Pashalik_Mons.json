[
  {
    "name": "sacrificing itself makes two Goblins and pings any target when it dies",
    "players": [
      { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Pashalik Mons"] },
      {}
    ],
    "steps": [
      { "activate": "Pashalik Mons", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Goblin", "Goblin"], "battlefield_lacks": ["Pashalik Mons"] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "another Goblin dying triggers Mons once",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pashalik Mons", "Raging Goblin"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Raging Goblin"] },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Raging Goblin"], "battlefield": ["Mountain", "Pashalik Mons"] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "a non-Goblin dying does not trigger Mons",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pashalik Mons"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"], "battlefield": ["Mountain", "Pashalik Mons"] },
        { "graveyard": ["Grizzly Bears"], "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: Mons and another Goblin dying at the same time trigger Mons once for each (two pings)",
    "players": [
      { "hand": ["Pyroclasm"], "battlefield": ["Mountain", "Mountain", "Pashalik Mons", "Raging Goblin"] },
      {}
    ],
    "steps": [
      { "cast": "Pyroclasm" },
      { "resolve": true, "targets": ["p1", "p1"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Pyroclasm", "Pashalik Mons", "Raging Goblin"] },
        { "life": 18 }
      ]
    }
  }
]
