[
 { "name": "enters prepared; Seething Song is cast from exile once and unprepares it",
   "players": [ { "hand": ["Blazing Firesinger // Seething Song"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Blazing Firesinger // Seething Song" }, { "resolve": true },
              { "cast": "Seething Song" }, { "resolve": true },
              { "cast": "Seething Song", "illegal": true } ],
   "expect": { "players": [ { "life": 20, "hand": [] }, {} ] } },
 { "name": "the spell cannot be cast from hand",
   "players": [ { "hand": ["Blazing Firesinger // Seething Song"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Seething Song", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Blazing Firesinger // Seething Song"] }, {} ] } },
 { "name": "ruling: the prepared copy in exile ceases when the prepared creature dies",
   "players": [ { "hand": ["Blazing Firesinger // Seething Song"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Blazing Firesinger // Seething Song" }, { "resolve": true },
              { "pass": true },
              { "cast": "Lightning Bolt", "targets": ["Blazing Firesinger // Seething Song"], "player": 1 }, { "resolve": true },
              { "cast": "Seething Song", "illegal": true } ],
   "expect": { "players": [ { "exile": [], "graveyard_has": ["Blazing Firesinger // Seething Song"] }, { "graveyard_has": ["Lightning Bolt"] } ] } }
]
