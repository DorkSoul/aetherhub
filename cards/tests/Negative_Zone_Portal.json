[
  {
    "name": "exile a creature card from opponent's graveyard and draw a card",
    "players": [
      { "battlefield": ["Negative Zone Portal", "Plains", "Plains"] },
      { "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Negative Zone Portal", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "battlefield_has": ["Negative Zone Portal"] },
        { "graveyard": [], "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "exile a noncreature card from opponent's graveyard: no draw",
    "players": [
      { "battlefield": ["Negative Zone Portal", "Plains", "Plains"] },
      { "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Negative Zone Portal", "targets": ["Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        { "graveyard": [], "exile": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "cannot activate a second time while tapped",
    "players": [
      { "battlefield": ["Negative Zone Portal", "Plains", "Plains", "Plains", "Plains"] },
      { "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Negative Zone Portal", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Negative Zone Portal", "targets": ["Lightning Bolt"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        { "graveyard": ["Lightning Bolt"], "exile": ["Grizzly Bears"] }
      ]
    }
  }
]
