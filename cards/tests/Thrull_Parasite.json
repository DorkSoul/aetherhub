[
  {
    "name": "tap and pay 2 life to remove a counter from a creature",
    "players": [
      { "battlefield": ["Thrull Parasite"] },
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] }
    ],
    "steps": [
      { "activate": "Thrull Parasite", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 18 }, {} ],
      "tapped": { "Thrull Parasite": true },
      "counters": { "Grizzly Bears": { "p1p1": 1 } }
    }
  },
  {
    "name": "a nonland permanent with no counters: the cost is still paid, nothing is removed",
    "players": [
      { "battlefield": ["Thrull Parasite"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Thrull Parasite", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 18 }, {} ],
      "tapped": { "Thrull Parasite": true },
      "counters": { "Grizzly Bears": { "p1p1": 0 } }
    }
  },
  {
    "name": "ruling: a planeswalker is a legal target; one loyalty counter is removed",
    "players": [
      { "battlefield": ["Thrull Parasite"] },
      { "battlefield": ["Jace, the Mind Sculptor"] }
    ],
    "steps": [
      { "activate": "Thrull Parasite", "targets": ["Jace, the Mind Sculptor"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 18 }, {} ],
      "tapped": { "Thrull Parasite": true },
      "counters": { "Jace, the Mind Sculptor": { "loyalty": 2 } }
    }
  },
  {
    "name": "ruling: extort pays one drain when {W/B} is paid, the spell still resolves",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Thrull Parasite", "Mountain", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: each extort trigger is paid separately (one paid, one declined)",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Thrull Parasite", "Mountain", "Mountain", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": [true] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 13 } ]
    }
  }
]
