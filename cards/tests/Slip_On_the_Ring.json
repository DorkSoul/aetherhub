[
  { "name": "exiles your creature and returns it under your control, then the Ring tempts you",
    "players": [ { "hand": ["Slip On the Ring"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Slip On the Ring", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Slip On the Ring"], "command": ["The Ring 1"] }, {} ] } },
  { "name": "you cannot target a creature you do not own",
    "players": [ { "hand": ["Slip On the Ring"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Slip On the Ring", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Slip On the Ring"] }, {} ] } },
  { "name": "ruling: if the only target is illegal on resolution (Bolt kills it in response), the Ring does not tempt you",
    "players": [ { "hand": ["Slip On the Ring"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Slip On the Ring", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Slip On the Ring", "Grizzly Bears"], "command": [] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: the returned creature is a new object: its Aura goes to the graveyard and its counters are gone",
    "players": [ { "hand": ["Pacifism", "Slip On the Ring"], "battlefield": ["Plains", "Plains", "Forest", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] }, {} ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Slip On the Ring", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Pacifism", "Slip On the Ring"] }, {} ] } },
  { "name": "ruling: you can target a creature you own but do not control (opponent stole it with Control Magic on their turn)",
    "players": [ { "hand": ["Slip On the Ring"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }, { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "pass": true, "player": 1 },
      { "cast": "Slip On the Ring", "targets": ["Grizzly Bears"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Control Magic"] } ] } },
  { "name": "ruling: an exiled token ceases to exist and does not return",
    "players": [ { "hand": ["Slip On the Ring"], "battlefield": ["Plains", "Plains", "Soldier"] }, {} ],
    "steps": [ { "cast": "Slip On the Ring", "targets": ["Soldier"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Soldier"], "command": ["The Ring 1"] }, {} ] } },
  { "name": "ruling: a player has one The Ring emblem; the second tempt upgrades it (The Ring 2)",
    "players": [ { "hand": ["Slip On the Ring", "Slip On the Ring"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Slip On the Ring", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Slip On the Ring", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 2"], "battlefield_has": ["Grizzly Bears"] }, {} ] } }
]
