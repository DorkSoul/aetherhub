[
  {
    "name": "discard the hand then draw a card for each card discarded this turn",
    "players": [
      {
        "hand": ["Change of Fortune", "Island", "Island"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Forest", "Swamp", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Change of Fortune" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 2, "graveyard": ["Change of Fortune", "Island", "Island"] },
        {}
      ]
    }
  },
  {
    "name": "empty hand after casting discards nothing and draws nothing",
    "players": [
      {
        "hand": ["Change of Fortune"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Forest", "Swamp", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Change of Fortune" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Change of Fortune"] },
        {}
      ]
    }
  },
  {
    "name": "one card in hand is discarded and replaced by one draw",
    "players": [
      {
        "hand": ["Change of Fortune", "Island"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Forest", "Swamp"]
      },
      {}
    ],
    "steps": [
      { "cast": "Change of Fortune" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Change of Fortune", "Island"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: cards discarded earlier this turn by any means count toward the draw",
    "players": [
      {
        "hand": ["Faithless Looting", "Change of Fortune", "Grizzly Bears", "Hill Giant"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Island", "Swamp", "Forest", "Plains", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Faithless Looting" },
      { "resolve": true, "answers": [["Grizzly Bears", "Hill Giant"]] },
      { "cast": "Change of Fortune" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 4, "graveyard": ["Faithless Looting", "Grizzly Bears", "Hill Giant", "Change of Fortune", "Island", "Swamp"] },
        {}
      ]
    }
  }
]
