[
 {
  "name": "with shroud the only legal Sign in Blood target is the opponent",
  "players": [
   {
    "hand": [
     "Gilded Light",
     "Sign in Blood"
    ],
    "battlefield": [
     "Plains",
     "Plains",
     "Swamp",
     "Swamp"
    ],
    "library": [
     "Island",
     "Island",
     "Island"
    ]
   },
   {
    "library": [
     "Island",
     "Island",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Gilded Light"
   },
   {
    "resolve": true
   },
   {
    "cast": "Sign in Blood"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 20,
     "hand_count": 0
    },
    {
     "hand_count": 2
    }
   ]
  }
 },
 {
  "name": "cycling {2}: discard it to draw a card",
  "players": [
   { "hand": ["Gilded Light"], "battlefield": ["Island", "Island"], "library": ["Forest", "Swamp"] },
   {}
  ],
  "steps": [
   { "activate": "Gilded Light", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 1, "graveyard": ["Gilded Light"], "library_top": ["Swamp"] },
    {}
   ]
  }
 },
 {
  "name": "cycling needs {2}",
  "players": [
   { "hand": ["Gilded Light"], "battlefield": ["Island"], "library": ["Forest"] },
   {}
  ],
  "steps": [
   { "activate": "Gilded Light", "ability": 0, "illegal": true }
  ],
  "expect": {
   "players": [ { "hand_count": 1, "library_top": ["Forest"] }, {} ]
  }
 },
 {
  "name": "ruling: Stifle can counter the cycling ability (cycling is an activated ability)",
  "players": [
   { "hand": ["Gilded Light"], "battlefield": ["Island", "Island"], "library": ["Forest", "Swamp"] },
   { "hand": ["Stifle"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "activate": "Gilded Light", "ability": 0 },
   { "pass": true },
   { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Gilded Light" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 0, "graveyard": ["Gilded Light"], "library_top": ["Forest"] },
    { "graveyard": ["Stifle"] }
   ]
  }
 },
 {
  "name": "ruling: Counterspell cannot counter cycling (it is not a spell), so the card is still drawn",
  "players": [
   { "hand": ["Gilded Light"], "battlefield": ["Island", "Island"], "library": ["Forest", "Swamp"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "activate": "Gilded Light", "ability": 0 },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 1, "graveyard": ["Gilded Light"], "library_top": ["Swamp"] },
    { "hand": ["Counterspell"] }
   ]
  }
 }
]