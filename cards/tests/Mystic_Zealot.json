[
  {
    "name": "threshold gives +1/+1 and flying",
    "players": [
      { "battlefield": ["Mystic Zealot"], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      {}
    ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": {
      "pt": { "Mystic Zealot": [3, 5] },
      "keywords": { "Mystic Zealot": ["Flying"] }
    }
  },
  {
    "name": "below threshold it is a plain 2/4 without flying",
    "players": [
      { "battlefield": ["Mystic Zealot"], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      {}
    ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": {
      "pt": { "Mystic Zealot": [2, 4] }
    }
  },
  {
    "name": "ruling: nonlethal damage becomes lethal when threshold is lost (4 damage, 3/5 until the Crypt exiles the graveyard)",
    "players": [
      { "battlefield": ["Mystic Zealot", "Tormod's Crypt"], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [ { "card": "Mystic Zealot", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Mystic Zealot" } ] },
      { "advance_to": "Main2" },
      { "activate": "Tormod's Crypt", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Mystic Zealot"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling control: the same 4 damage does not kill it while threshold holds (3/5)",
    "players": [
      { "battlefield": ["Mystic Zealot"], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [ { "card": "Mystic Zealot", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Mystic Zealot" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Mystic Zealot": [3, 5] },
      "players": [
        { "battlefield_has": ["Mystic Zealot"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  }
]
