[
  {
    "name": "tap: 2 damage to any target (player) and it stays tapped",
    "players": [
      {
        "battlefield": [
          "Reveka, Wizard Savant"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Reveka, Wizard Savant",
        "ability": 0,
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 18
        }
      ],
      "tapped": {
        "Reveka, Wizard Savant": true
      }
    }
  },
  {
    "name": "tap: 2 damage kills a creature",
    "players": [
      {
        "battlefield": [
          "Reveka, Wizard Savant"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Reveka, Wizard Savant",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: Reveka stays tapped through your next untap step",
    "players": [
      { "battlefield": ["Reveka, Wizard Savant"] },
      {}
    ],
    "steps": [
      { "activate": "Reveka, Wizard Savant", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 18 }
      ],
      "tapped": { "Reveka, Wizard Savant": true }
    }
  },
  {
    "name": "ruling: Reveka untaps in the untap step after the skipped one",
    "players": [
      { "battlefield": ["Reveka, Wizard Savant"] },
      {}
    ],
    "steps": [
      { "activate": "Reveka, Wizard Savant", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 18 }
      ],
      "tapped": { "Reveka, Wizard Savant": false }
    }
  },
  {
    "name": "ruling: if another player gains control, Reveka stays tapped through my untap step (it is the new controller's untap that counts)",
    "players": [
      { "battlefield": ["Reveka, Wizard Savant"] },
      { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "activate": "Reveka, Wizard Savant", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Reveka, Wizard Savant"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Reveka, Wizard Savant"] },
        { "battlefield_has": ["Reveka, Wizard Savant"], "life": 18 }
      ],
      "tapped": { "Reveka, Wizard Savant": true }
    }
  },
  {
    "name": "ruling: a Reveka taken by another player untaps during that player's next untap step",
    "players": [
      { "battlefield": ["Reveka, Wizard Savant"] },
      { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "activate": "Reveka, Wizard Savant", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Reveka, Wizard Savant"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Reveka, Wizard Savant"] },
        { "battlefield_has": ["Reveka, Wizard Savant"], "life": 18 }
      ],
      "tapped": { "Reveka, Wizard Savant": false }
    }
  }
]
