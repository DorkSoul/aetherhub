[
  {
    "name": "power and toughness equal the number of Swamps you control",
    "players": [
      { "battlefield": ["Korlash, Heir to Blackblade", "Swamp", "Swamp", "Island"] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": { "Korlash, Heir to Blackblade": [2, 2] }
    }
  },
  {
    "name": "grandeur discards another Korlash and fetches two tapped Swamps",
    "players": [
      {
        "hand": ["Korlash, Heir to Blackblade", "Korlash, Heir to Blackblade"],
        "library": ["Swamp", "Swamp", "Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Korlash, Heir to Blackblade", "ability": 1 },
      { "resolve": true, "answers": [["Swamp", "Swamp"]] }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Korlash, Heir to Blackblade"],
          "graveyard": ["Korlash, Heir to Blackblade"],
          "battlefield": ["Swamp", "Swamp"]
        },
        {}
      ],
      "tapped": { "Swamp": true }
    }
  },
  {
    "name": "grandeur needs another Korlash in hand",
    "players": [
      { "hand": ["Korlash, Heir to Blackblade"], "library": ["Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Korlash, Heir to Blackblade", "ability": 1, "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Korlash, Heir to Blackblade"], "battlefield": [] }, {}]
    }
  },
  {
    "name": "regeneration shield: lethal Bolt damage is replaced and Korlash is tapped",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Korlash, Heir to Blackblade", "Swamp", "Swamp", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Korlash, Heir to Blackblade", "ability": 0 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Korlash, Heir to Blackblade"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Korlash, Heir to Blackblade"], "graveyard": ["Lightning Bolt"] }, {} ],
      "tapped": { "Korlash, Heir to Blackblade": true }
    }
  },
  {
    "name": "without the regeneration shield the Bolt destroys Korlash",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Korlash, Heir to Blackblade", "Swamp", "Swamp", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Korlash, Heir to Blackblade"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Korlash, Heir to Blackblade"], "graveyard_has": ["Korlash, Heir to Blackblade"] }, {} ]
    }
  }
]
