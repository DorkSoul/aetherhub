    "steps": [ { "pass": true }, { "cast": "Ambush Viper", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Zombie Warrior 4-4 Black Vigilance"] }, {} ] } },
  { "name": "dies: may put it third from the top of its owner's library",
