    "steps": [ { "pass": true }, { "cast": "Murder", "player": 1, "targets": ["God-Eternal Oketra"] }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard_has": ["God-Eternal Oketra"], "library_count": 20 }, {} ] } },
