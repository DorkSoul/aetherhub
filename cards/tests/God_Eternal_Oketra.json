    "expect": { "players": [ { "exile": ["God-Eternal Oketra"], "library_count": 20 }, {} ] } },
  { "name": "ruling: a countered creature spell still gets the Zombie token (the trigger resolves first)",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["God-Eternal Oketra", "Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Grizzly Bears" }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Grizzly Bears" }] }, { "resolve": true } ],
