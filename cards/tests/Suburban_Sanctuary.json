[
  {
    "name": "taps for green",
    "players": [{ "battlefield": ["Suburban Sanctuary"] }, {}],
    "steps": [{ "tap_for_mana": "Suburban Sanctuary", "color": "G" }],
    "expect": { "players": [{ "pool": { "G": 1 } }, {}] }
  },
  {
    "name": "taps for white",
    "players": [{ "battlefield": ["Suburban Sanctuary"] }, {}],
    "steps": [{ "tap_for_mana": "Suburban Sanctuary", "color": "W" }],
    "expect": { "players": [{ "pool": { "W": 1 } }, {}] }
  },
  {
    "name": "{4},{T}: surveil 1 puts the top card in the graveyard",
    "players": [ { "battlefield": ["Suburban Sanctuary", "Plains", "Plains", "Plains", "Plains"], "library": ["Grizzly Bears", "Island"] }, {} ],
    "steps": [ { "activate": "Suburban Sanctuary", "ability": 0 }, { "resolve": true, "answers": [["Grizzly Bears"]] } ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears"], "library_top": ["Island"], "battlefield_has": ["Suburban Sanctuary"] }, {} ],
      "tapped": { "Suburban Sanctuary": true }
    }
  },
  {
    "name": "surveil 1 keeping the top card on top of the library",
    "players": [ { "battlefield": ["Suburban Sanctuary", "Plains", "Plains", "Plains", "Plains"], "library": ["Grizzly Bears", "Island"] }, {} ],
    "steps": [ { "activate": "Suburban Sanctuary", "ability": 0 }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "graveyard": [], "library_top": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "surveil needs four other mana: three Plains is not enough",
    "players": [ { "battlefield": ["Suburban Sanctuary", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Suburban Sanctuary", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Suburban Sanctuary"] }, {} ] }
  },
  {
    "name": "enters tapped when played",
    "players": [ { "hand": ["Suburban Sanctuary"] }, {} ],
    "steps": [ { "play_land": "Suburban Sanctuary" } ],
    "expect": { "players": [ { "battlefield_has": ["Suburban Sanctuary"] }, {} ], "tapped": { "Suburban Sanctuary": true } }
  },
  {
    "name": "a basic land played the same way enters untapped",
    "players": [ { "hand": ["Plains"] }, {} ],
    "steps": [ { "play_land": "Plains" } ],
    "expect": { "players": [ { "battlefield_has": ["Plains"] }, {} ], "tapped": { "Plains": false } }
  }
]
