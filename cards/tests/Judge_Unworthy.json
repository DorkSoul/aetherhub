  {
    "name": "top card with mana value 0 deals no damage to the attacker",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ]
      },
      {
        "hand": [
          "Judge Unworthy"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ],
        "library": [
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Judge Unworthy",
        "player": 1,
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true,
