  {
    "name": "ruling: if the target is gone on resolution the spell fizzles: no scry and no reveal",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"] },
      { "hand": ["Judge Unworthy"], "battlefield": ["Plains", "Plains"], "library": ["Lightning Bolt", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "pass": true },
      { "cast": "Judge Unworthy", "player": 1, "targets": ["Hill Giant"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Hill Giant", "Lightning Bolt"] },
        { "library_top": ["Lightning Bolt", "Grizzly Bears"], "graveyard_has": ["Judge Unworthy"] }
      ]
    }
  },
  {
    "name": "ruling: destroying the blocker does not unblock the attacker, which deals no damage to the player",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "hand": ["Judge Unworthy"], "battlefield": ["Hill Giant", "Plains", "Plains"], "library": ["Hill Giant", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }], "player": 1 },
      { "pass": true },
      { "cast": "Judge Unworthy", "player": 1, "targets": ["Hill Giant"] },
      { "resolve": true, "auto": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "life": 20, "graveyard_has": ["Hill Giant"] }
      ]
    }
  }
