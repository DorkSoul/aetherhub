[
  {
    "name": "damage equal to the revealed top card's mana value kills the attacker",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ]
      },
      {
        "hand": [
          "Judge Unworthy"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ],
        "library": [
          "Hill Giant",
          "Island",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Judge Unworthy",
        "player": 1,
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
