[
  {
    "name": "spell targeting a creature adds a +1/+1 counter and scries",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hawkeye, Bowslinger"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "pt": { "Hawkeye, Bowslinger": [4, 4] },
      "counters": { "Hawkeye, Bowslinger": { "p1p1": 1 } },
      "players": [ { "graveyard": ["Lightning Bolt"] }, { "battlefield_lacks": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "spell targeting only a player does not trigger",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hawkeye, Bowslinger"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "pt": { "Hawkeye, Bowslinger": [3, 3] },
      "players": [ {}, { "life": 17 } ]
    }
  }
]
