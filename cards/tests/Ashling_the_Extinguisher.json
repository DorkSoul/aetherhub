[
 {
  "name": "combat damage to a player makes that player sacrifice the chosen creature",
  "players": [
   { "battlefield": ["Ashling, the Extinguisher"] },
   { "battlefield": ["Grizzly Bears", "Hill Giant"] }
  ],
  "steps": [
   { "attack": [{ "card": "Ashling, the Extinguisher", "at": "p1" }] },
   { "block": [] },
   { "advance_to": "End", "answers": ["Grizzly Bears"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Ashling, the Extinguisher"] },
    { "battlefield_has": ["Hill Giant"], "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "only creatures the damaged player controls can be chosen",
  "players": [
   { "battlefield": ["Ashling, the Extinguisher", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "attack": [{ "card": "Ashling, the Extinguisher", "at": "p1" }] },
   { "block": [] },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Ashling, the Extinguisher", "Grizzly Bears"] },
    { "graveyard": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "no trigger when the attacker is blocked",
  "players": [
   { "battlefield": ["Ashling, the Extinguisher"] },
   { "battlefield": ["Grizzly Bears", "Hill Giant"] }
  ],
  "steps": [
   { "attack": [{ "card": "Ashling, the Extinguisher", "at": "p1" }] },
   { "block": [{ "blocker": "Grizzly Bears", "attacker": "Ashling, the Extinguisher" }] },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Ashling, the Extinguisher"] },
    { "battlefield_has": ["Hill Giant"], "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: an indestructible creature can still be sacrificed",
  "players": [
   { "battlefield": ["Ashling, the Extinguisher"] },
   { "battlefield": ["Darksteel Myr", "Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [{ "card": "Ashling, the Extinguisher", "at": "p1" }] },
   { "block": [] },
   { "advance_to": "End", "answers": ["Darksteel Myr"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Ashling, the Extinguisher"] },
    { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Darksteel Myr"] }
   ]
  }
 }
]
