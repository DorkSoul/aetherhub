[
  {
    "name": "Chilling Screech counters a spell with mana value 2 and shuffles itself into my library",
    "players": [
      { "hand": ["Runescale Stormbrood"], "battlefield": ["Island", "Island"], "library": ["Forest", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "cast": "Runescale Stormbrood", "face": true, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 3, "graveyard": [] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "Chilling Screech cannot target a spell with mana value 3 or more",
    "players": [
      { "hand": ["Runescale Stormbrood", "Hill Giant"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "cast": "Runescale Stormbrood", "face": true, "targets": [{ "stack": "Hill Giant" }], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Runescale Stormbrood"] }, {} ]
    }
  },
  {
    "name": "casting a noncreature spell gives Runescale Stormbrood +2/+0 until end of turn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Runescale Stormbrood"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Runescale Stormbrood": [4, 4] },
      "players": [ {}, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "casting a Dragon spell also gives +2/+0",
    "players": [
      { "hand": ["Shivan Dragon"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Runescale Stormbrood"] },
      {}
    ],
    "steps": [
      { "cast": "Shivan Dragon" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Runescale Stormbrood": [4, 4] }
    }
  },
  {
    "name": "casting a creature spell that is not a Dragon does not pump it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Runescale Stormbrood"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Runescale Stormbrood": [2, 4] }
    }
  }
]
