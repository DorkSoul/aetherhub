   "expect": { "players": [ { "exile": ["Agate-Blade Assassin"], "life": 20 }, { "life": 16 } ] } },
 { "name": "ruling: the token copy's enters ability triggers (Serpent Assassin destroys the opponent's creature)",
   "players": [ { "battlefield": [ { "name": "Altaïr Ibn-La'Ahad", "sick": false } ], "graveyard": ["Serpent Assassin"] }, { "battlefield": ["Grizzly Bears"] } ],
