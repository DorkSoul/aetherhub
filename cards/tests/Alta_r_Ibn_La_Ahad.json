[
 { "name": "attack: exile the Assassin from the graveyard with a memory counter and get an attacking token copy",
   "players": [ { "battlefield": [ { "name": "Altaïr Ibn-La'Ahad", "sick": false } ], "graveyard": ["Hired Poisoner"] }, {} ],
   "steps": [ { "attack": [ { "card": "Altaïr Ibn-La'Ahad", "at": "p1" } ] },
              { "resolve": true, "targets": ["Hired Poisoner"] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "exile": ["Hired Poisoner"], "battlefield_has": ["Altaïr Ibn-La'Ahad"] }, { "life": 16 } ] } },
 { "name": "the token is exiled at end of combat; a second attack copies every memory-counter creature again",
   "players": [ { "battlefield": [ { "name": "Altaïr Ibn-La'Ahad", "sick": false } ], "graveyard": ["Hired Poisoner"] }, {} ],
   "steps": [ { "attack": [ { "card": "Altaïr Ibn-La'Ahad", "at": "p1" } ] },
              { "resolve": true, "targets": ["Hired Poisoner"] },
              { "advance_to": "End" } ],
   "expect": { "players": [ { "exile": ["Hired Poisoner"] }, {} ] } },
 { "name": "no Assassin in the graveyard: no token",
