[
  {
    "name": "enters with three time counters and stays while they remain",
    "players": [
      { "hand": ["Reality Acid"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Reality Acid", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Reality Acid"] }, { "battlefield_has": ["Grizzly Bears"] }],
      "counters": { "Reality Acid": { "time": 2 } }
    }
  },
  {
    "name": "last time counter removed: Aura is sacrificed and the enchanted creature's controller sacrifices the creature",
    "players": [
      { "hand": ["Reality Acid"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Reality Acid", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Reality Acid"] },
        { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "enchanted creature dies first: Aura goes to graveyard and no other creature is sacrificed",
    "players": [
      { "hand": ["Reality Acid", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Reality Acid", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Reality Acid", "Lightning Bolt"] },
        { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]
