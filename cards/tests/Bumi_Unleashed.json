[
  { "name": "ETB earthbend 4: target land becomes a 4/4 land creature",
    "players": [ { "hand": ["Bumi, Unleashed"], "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Bumi, Unleashed" }, { "resolve": true, "targets": ["Mountain"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bumi, Unleashed", "Mountain"] }, {} ], "pt": { "Mountain": [4, 4] }, "counters": { "Mountain": { "p1p1": 4 } } } },
  { "name": "combat damage to a player untaps all lands you control",
    "players": [ { "hand": ["Bumi, Unleashed"], "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Bumi, Unleashed" }, { "resolve": true, "targets": ["Mountain"] }, { "resolve": true },
      { "advance_to": "Main1", "player": 1 },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Bumi, Unleashed", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 15 } ], "tapped": { "Mountain": false, "Forest": false } } },
  { "name": "extra combat after combat damage: only land creatures can attack in it",
    "players": [ { "hand": ["Bumi, Unleashed"], "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Bumi, Unleashed" }, { "resolve": true, "targets": ["Mountain"] }, { "resolve": true },
      { "advance_to": "Main1", "player": 1 },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Bumi, Unleashed", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ], "illegal": true }
    ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "extra combat: the earthbent land creature may attack in it (after Bumi's combat damage)",
    "players": [ { "hand": ["Bumi, Unleashed"], "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Bumi, Unleashed" }, { "resolve": true, "targets": ["Mountain"] }, { "resolve": true },
      { "advance_to": "Main1", "player": 1 },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Bumi, Unleashed", "at": "p1" } ] },
      { "block": [] },
      { "attack": [ { "card": "Mountain", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 11 } ] } },
  { "name": "ruling: an earthbent land that dies returns to the battlefield tapped",
    "players": [ { "hand": ["Bumi, Unleashed", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Bumi, Unleashed" }, { "resolve": true, "targets": ["Mountain"] }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["Mountain"] }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["Mountain"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bumi, Unleashed", "Mountain"], "graveyard_has": ["Lightning Bolt"] }, {} ], "tapped": { "Mountain": true } } },
  { "name": "extra combat: a non-land creature can't attack in it, the land creature can",
    "players": [ { "hand": ["Bumi, Unleashed"], "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Bumi, Unleashed" }, { "resolve": true, "targets": ["Mountain"] }, { "resolve": true },
      { "advance_to": "Main1", "player": 1 },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Bumi, Unleashed", "at": "p1" } ] },
      { "block": [] },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ], "illegal": true },
      { "attack": [ { "card": "Mountain", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 11 } ], "turn": 3 } }
]
