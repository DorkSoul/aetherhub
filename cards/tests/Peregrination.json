[
  {
    "name": "one basic onto the battlefield tapped, one into hand",
    "players": [
      {
        "hand": ["Peregrination"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest"],
        "library": ["Mountain", "Island", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Peregrination" },
      { "resolve": true, "answers": ["Mountain", "Island"] }
    ],
    "expect": {
      "tapped": { "Mountain": true },
      "players": [
        { "battlefield_has": ["Mountain"], "hand": ["Island"], "graveyard": ["Peregrination"] },
        {}
      ]
    }
  },
  {
    "name": "no basic land in library: nothing found",
    "players": [
      {
        "hand": ["Peregrination"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest"],
        "library": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Peregrination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard": ["Peregrination"] }, {} ]
    }
  },
  {
    "name": "ruling: searching for only one basic puts just that card onto the battlefield tapped",
    "players": [
      { "hand": ["Peregrination"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Mountain", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [ { "cast": "Peregrination" }, { "resolve": true, "answers": ["Mountain"] } ],
    "expect": { "tapped": { "Mountain": true }, "players": [ { "battlefield_has": ["Mountain"], "hand_count": 0, "graveyard": ["Peregrination"] }, {} ] }
  }
]
