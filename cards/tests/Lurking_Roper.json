    "expect": {
      "turn": 3,
      "tapped": { "Lurking Roper": true, "Grizzly Bears": false }
    }
  },
  {
    "name": "gaining life untaps it",
    "players": [
      { "hand": ["Swords to Plowshares"], "battlefield": [{ "name": "Lurking Roper", "tapped": true }, "Grizzly Bears", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Swords to Plowshares", "targets": ["Grizzly Bears"] },
      { "resolve": true },
