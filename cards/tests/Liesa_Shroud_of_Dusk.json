[
  { "name": "whenever a player casts a spell, they lose 2 life",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Liesa, Shroud of Dusk", "Mountain"] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true }, { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["p0"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 16 }, { "life": 15 } ] } },
  { "name": "a spell cast by an opponent makes that opponent lose life, not you",
    "players": [ { "battlefield": ["Liesa, Shroud of Dusk"] }, { "hand": ["Moment of Silence"], "battlefield": ["Plains"] } ],
    "steps": [ { "pass": true }, { "cast": "Moment of Silence", "player": 1, "targets": ["p0"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
  { "name": "recast from the command zone: pay 2 life instead of {2}",
    "commander": true,
    "players": [ { "command": ["Liesa, Shroud of Dusk"], "battlefield": ["Plains", "Plains", "Plains", "Swamp", "Swamp"] }, { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] } ],
    "steps": [ { "cast": "Liesa, Shroud of Dusk" }, { "resolve": true }, { "pass": true }, { "cast": "Murder", "player": 1, "targets": ["Liesa, Shroud of Dusk"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Liesa, Shroud of Dusk" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 18, "battlefield_has": ["Liesa, Shroud of Dusk"] }, { "life": 18 } ] } },
  { "name": "the first cast from the command zone costs no life",
    "commander": true,
    "players": [ { "command": ["Liesa, Shroud of Dusk"], "battlefield": ["Plains", "Plains", "Plains", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Liesa, Shroud of Dusk" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Liesa, Shroud of Dusk"] }, {} ] } },
  { "name": "ruling: the commander tax is paid in life even when there is mana to pay {2} per previous cast",
    "commander": true,
    "players": [ { "command": ["Liesa, Shroud of Dusk"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] } ],
    "steps": [ { "cast": "Liesa, Shroud of Dusk" }, { "resolve": true }, { "pass": true }, { "cast": "Murder", "player": 1, "targets": ["Liesa, Shroud of Dusk"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Liesa, Shroud of Dusk" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 18, "battlefield_has": ["Liesa, Shroud of Dusk"] }, { "life": 18 } ] } },
  { "name": "ruling: Liesa's life loss resolves before the spell that caused it (the 2-life caster dies before Lightning Bolt resolves)",
    "players": [ { "life": 2, "hand": ["Lightning Bolt"], "battlefield": ["Liesa, Shroud of Dusk", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 0 }, { "life": 20 } ], "winner": 1 } }
]
