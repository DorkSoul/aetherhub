[
  {
    "name": "attacks when the defending player controls an Island",
    "players": [
      { "battlefield": ["Island", "Dandân"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Dandân", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield": ["Island", "Dandân"] }, { "life": 16, "battlefield": ["Island"] } ]
    }
  },
  {
    "name": "sacrificed when its controller controls no Islands",
    "players": [
      { "battlefield": ["Swamp", "Dandân"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield": ["Swamp"], "graveyard": ["Dandân"] }, {} ]
    }
  },
  {
    "name": "stays while its controller controls an Island",
    "players": [
      { "battlefield": ["Island", "Dandân"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "battlefield": ["Island", "Dandân"] }, {} ]
    }
  },
  {
    "name": "can't attack when the defending player controls no Island (only Grizzly Bears gets through)",
    "players": [
      { "battlefield": ["Island", "Dandân", "Grizzly Bears"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Dandân", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield": ["Island", "Dandân", "Grizzly Bears"] }, { "life": 18, "battlefield": ["Forest"] } ]
    }
  }
]
