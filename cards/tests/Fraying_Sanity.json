[
  { "name": "enchanted player mills one card for the one card put into their graveyard this turn",
    "players": [ { "hand": ["Fraying Sanity", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Fraying Sanity", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"], "library_count": 19 } ] } },
  { "name": "no cards put into the enchanted player's graveyard this turn: mills nothing",
    "players": [ { "hand": ["Fraying Sanity"], "battlefield": ["Island", "Island", "Island"] }, { "graveyard": ["Shock"] } ],
    "steps": [
      { "cast": "Fraying Sanity", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ {}, { "graveyard_has": ["Shock"], "library_count": 20 } ] } },
  { "name": "cards put into the caster's own graveyard do not count",
    "players": [ { "hand": ["Fraying Sanity", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [
      { "cast": "Fraying Sanity", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "library_count": 20 } ] } },
  { "name": "ruling: a card put into the enchanted player's graveyard before the Sanity arrived still counts",
    "players": [ { "hand": ["Fraying Sanity", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Fraying Sanity", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"], "library_count": 19 } ] } },
  { "name": "ruling: two Fraying Sanity auras: X is counted at resolution, so the second mills twice (1 then 2)",
    "players": [ { "hand": ["Fraying Sanity", "Fraying Sanity", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Fraying Sanity", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Fraying Sanity", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ {}, { "library_count": 17 } ] } }
]
