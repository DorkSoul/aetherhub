[
  {
    "name": "upkeep: pays {1} for one age counter",
    "players": [
      { "battlefield": ["Kjeldoran Javelineer", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Kjeldoran Javelineer": { "age": 1 } },
      "players": [ { "battlefield_has": ["Kjeldoran Javelineer"] }, {} ]
    }
  },
  {
    "name": "tap: deals damage equal to age counters to an attacking creature",
    "players": [
      { "battlefield": [ { "name": "Kjeldoran Javelineer", "counters": { "age": 2 } }, "Grizzly Bears" ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "activate": "Kjeldoran Javelineer", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: declining the cumulative upkeep payment sacrifices it",
    "players": [ { "battlefield": [ { "name": "Kjeldoran Javelineer", "counters": { "age": 2 } }, "Plains" ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
    "expect": { "players": [ { "graveyard_has": ["Kjeldoran Javelineer"] }, {} ] }
  }
]
