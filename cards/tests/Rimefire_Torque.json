[
  { "name": "tap and remove 3 charge counters: next instant you cast is copied (copy may get new target)",
    "players": [ { "hand": ["Shock"], "battlefield": [{ "name": "Rimefire Torque", "counters": { "Charge": 3 } }, "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "activate": "Rimefire Torque", "answers": ["Bear"] }, { "resolve": true }, { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "pass": true }, { "resolve": true, "answers": [["Hill Giant"]] } ],
    "expect": { "players": [ { "graveyard": ["Shock"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ], "tapped": { "Rimefire Torque": true } } },
  { "name": "only two charge counters: the ability can't be activated",
    "players": [ { "hand": ["Shock"], "battlefield": [{ "name": "Rimefire Torque", "counters": { "Charge": 2 } }, "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Rimefire Torque", "illegal": true, "answers": ["Bear"] } ],
    "expect": { "players": [ { "hand": ["Shock"] }, {} ], "counters": { "Rimefire Torque": { "Charge": 2 } } } },
  { "name": "a permanent of the chosen type entering puts a charge counter on it",
    "players": [ { "hand": ["Rimefire Torque", "Grizzly Bears"], "battlefield": ["Island", "Island", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Rimefire Torque" }, { "resolve": true, "answers": ["Bear"] }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Rimefire Torque", "Grizzly Bears"] }, {} ], "counters": { "Rimefire Torque": { "Charge": 1 } } } },
  { "name": "a permanent that is not of the chosen type entering puts no counter",
    "players": [ { "hand": ["Rimefire Torque", "Hill Giant"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Rimefire Torque" }, { "resolve": true, "answers": ["Bear"] }, { "cast": "Hill Giant" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Rimefire Torque", "Hill Giant"] }, {} ], "counters": { "Rimefire Torque": { "Charge": 0 } } } },
  { "name": "copy applies only to the next instant or sorcery: a second Shock is not copied",
    "players": [ { "hand": ["Shock", "Shock"], "battlefield": [{ "name": "Rimefire Torque", "counters": { "Charge": 3 } }, "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "activate": "Rimefire Torque", "answers": ["Bear"] }, { "resolve": true }, { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "pass": true }, { "resolve": true, "answers": [["Hill Giant"]] }, { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Shock", "Shock"] }, { "life": 18, "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: the copy keeps the original target when no new target is chosen",
    "players": [ { "hand": ["Shock"], "battlefield": [{ "name": "Rimefire Torque", "counters": { "Charge": 3 } }, "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Rimefire Torque", "answers": ["Bear"] }, { "resolve": true }, { "cast": "Shock", "targets": ["Hill Giant"] }, { "pass": true }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "graveyard": ["Shock"] }, { "graveyard": ["Hill Giant"] } ] } },
  { "name": "ruling: a copy of an X spell has the same X (X=2 copied: 4 damage kills the 3/3)",
    "players": [ { "hand": ["Blaze"], "battlefield": [{ "name": "Rimefire Torque", "counters": { "Charge": 3 } }, "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Rimefire Torque", "answers": ["Bear"] }, { "resolve": true }, { "cast": "Blaze", "targets": ["Hill Giant"], "answers": [2] }, { "pass": true }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "graveyard": ["Blaze"] }, { "graveyard": ["Hill Giant"] } ] } }
]
