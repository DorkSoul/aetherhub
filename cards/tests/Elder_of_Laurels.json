[
  {
    "name": "+X/+X where X is creatures you control",
    "players": [ { "battlefield": ["Elder of Laurels", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Elder of Laurels", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4] } }
  },
  {
    "name": "ruling: X is counted as the ability resolves; a creature entering later does not change the bonus",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Elder of Laurels", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Elder of Laurels", "ability": 0 }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Elder of Laurels": [3, 4] } }
  },
  {
    "name": "ruling: X is counted as the ability resolves, so a creature entering in response is counted",
    "players": [ { "hand": ["Cloudthresher"], "battlefield": ["Elder of Laurels", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Elder of Laurels", "ability": 0 }, { "cast": "Cloudthresher" }, { "resolve": true } ],
    "expect": { "pt": { "Elder of Laurels": [4, 5] } }
  }
]
