   "players": [ { "hand": ["Giant Growth", "Island"], "battlefield": ["Naktamun Lorespinner // Wheel of Fortune", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Shock", "Grizzly Bears"] } ],
