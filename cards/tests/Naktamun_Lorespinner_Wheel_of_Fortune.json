   "expect": { "players": [ {}, {} ] } },
 { "name": "ruling: the prepared copy of the spell waits in exile while the creature stays prepared and is not removed by state-based actions",
   "players": [ { "hand": [], "battlefield": ["Naktamun Lorespinner // Wheel of Fortune", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Giant Growth", "Island"] } ],
