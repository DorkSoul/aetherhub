   "players": [ { "hand": ["Giant Growth", "Island"], "battlefield": ["Naktamun Lorespinner // Wheel of Fortune", "Mountain", "Mountain", "Mountain"] }, { "hand": [] } ],
   "steps": [ { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
              { "cast": "Wheel of Fortune" }, { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "hand_count": 7 }, { "hand_count": 7 } ] } },
