[
 {
  "name": "gets +X/+X where X is your devotion to green",
  "players": [
   { "hand": ["Aspect of Hydra"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Llanowar Elves"] },
   {}
  ],
  "steps": [
   { "cast": "Aspect of Hydra", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ], "pt": { "Grizzly Bears": [4, 4] } }
 },
 {
  "name": "devotion counts only green mana symbols of your permanents",
  "players": [
   { "hand": ["Aspect of Hydra"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Vampire Nighthawk"] },
   {}
  ],
  "steps": [
   { "cast": "Aspect of Hydra", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [3, 3] } }
 },
 {
  "name": "ruling: devotion is counted as the ability resolves; a green permanent removed in response no longer counts",
  "players": [
   { "hand": ["Aspect of Hydra"], "battlefield": ["Forest", "Forest", "Grizzly Bears", { "name": "Llanowar Elves", "sick": true }] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "cast": "Aspect of Hydra", "targets": ["Grizzly Bears"] },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Llanowar Elves"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Aspect of Hydra", "Llanowar Elves"] },
    { "graveyard_has": ["Lightning Bolt"] }
   ],
   "pt": { "Grizzly Bears": [3, 3] }
  }
 },
 {
  "name": "ruling: generic mana symbols of permanents (Sol Ring) do not count toward devotion",
  "players": [
   { "hand": ["Aspect of Hydra"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Sol Ring"] },
   {}
  ],
  "steps": [
   { "cast": "Aspect of Hydra", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [3, 3] } }
 },
 {
  "name": "ruling: hybrid mana symbols count toward devotion to their colour (Selesnya Guildmage {G/W}{G/W} counts 2 green)",
  "players": [
   { "hand": ["Aspect of Hydra"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Selesnya Guildmage"] },
   {}
  ],
  "steps": [
   { "cast": "Aspect of Hydra", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [5, 5] } }
 }
]
