[
  {
    "name": "shuffles two chosen creature cards from your graveyard into your library",
    "players": [
      { "hand": ["Renewing Touch"], "battlefield": ["Forest"], "graveyard": ["Grizzly Bears", "Hill Giant", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "cast": "Renewing Touch", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Renewing Touch", "Sol Ring"], "library_count": 22 }, {} ]
    }
  },
  {
    "name": "choosing no targets does nothing",
    "players": [
      { "hand": ["Renewing Touch"], "battlefield": ["Forest"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Renewing Touch", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Renewing Touch", "Grizzly Bears"], "library_count": 20 }, {} ]
    }
  }
]
