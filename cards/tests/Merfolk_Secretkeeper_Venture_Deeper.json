[
  {
    "name": "Venture Deeper mills four and the Adventure is exiled",
    "players": [
      {
        "hand": [
          "Merfolk Secretkeeper // Venture Deeper"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Merfolk Secretkeeper // Venture Deeper",
        "face": true,
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Merfolk Secretkeeper // Venture Deeper"
          ]
        },
        {
          "library_count": 16
        }
      ]
    }
  },
  {
    "name": "the creature half is a 0/4 for U",
    "players": [
      {
        "hand": [
          "Merfolk Secretkeeper // Venture Deeper"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Merfolk Secretkeeper // Venture Deeper"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Merfolk Secretkeeper // Venture Deeper"
          ]
        },
        {}
      ],
      "pt": {
        "Merfolk Secretkeeper // Venture Deeper": [
          0,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: a countered Adventure is not exiled and cannot be cast later",
    "players": [
      { "hand": ["Merfolk Secretkeeper // Venture Deeper"], "battlefield": ["Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Merfolk Secretkeeper // Venture Deeper", "face": true, "targets": ["p1"] },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Venture Deeper" } ] },
      { "resolve": true },
      { "cast": "Merfolk Secretkeeper // Venture Deeper", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Merfolk Secretkeeper // Venture Deeper"], "exile": [] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "ruling: an Adventure exiled on resolution can be cast as the creature later",
    "players": [
      { "hand": ["Merfolk Secretkeeper // Venture Deeper"], "battlefield": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Merfolk Secretkeeper // Venture Deeper", "face": true, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Merfolk Secretkeeper // Venture Deeper" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Merfolk Secretkeeper // Venture Deeper"], "exile": [] },
        { "library_count": 16 }
      ],
      "pt": { "Merfolk Secretkeeper // Venture Deeper": [0, 4] }
    }
  },
  {
    "name": "ruling: the exiled creature needs an empty stack; once the stack clears it can be cast",
    "players": [
      { "hand": ["Merfolk Secretkeeper // Venture Deeper", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Merfolk Secretkeeper // Venture Deeper", "face": true, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Merfolk Secretkeeper // Venture Deeper", "illegal": true },
      { "resolve": true },
      { "cast": "Merfolk Secretkeeper // Venture Deeper" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Merfolk Secretkeeper // Venture Deeper"], "exile": [] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: an Adventure card exiled by another effect cannot be cast as the creature",
    "players": [
      { "battlefield": ["Island", "Island"], "exile": ["Merfolk Secretkeeper // Venture Deeper"] },
      {}
    ],
    "steps": [
      { "cast": "Merfolk Secretkeeper // Venture Deeper", "illegal": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Merfolk Secretkeeper // Venture Deeper"] },
        {}
      ]
    }
  }
]
