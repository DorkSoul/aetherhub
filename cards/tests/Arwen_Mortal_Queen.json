[
 {
  "name": "enters with an indestructible counter",
  "players": [
   {
    "hand": [
     "Arwen, Mortal Queen"
    ],
    "battlefield": [
     "Forest",
     "Plains",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Arwen, Mortal Queen"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Arwen, Mortal Queen": {
     "indestructible": 1
    }
   }
  }
 },
 {
  "name": "removing the counter gives another creature indestructible and counters to it and Arwen",
  "players": [
   {
    "battlefield": [
     {
      "name": "Arwen, Mortal Queen",
      "counters": {
       "indestructible": 1
      }
     },
     "Plains",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Arwen, Mortal Queen"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Arwen, Mortal Queen": {
     "plusoneplusone": 1,
     "lifelink": 1
    },
    "Grizzly Bears": {
     "plusoneplusone": 1,
     "lifelink": 1
    }
   },
   "pt": {
    "Arwen, Mortal Queen": [
     3,
     3
    ],
    "Grizzly Bears": [
     3,
     3
    ]
   },
   "keywords": {
    "Grizzly Bears": [
     "Indestructible",
     "Lifelink"
    ]
   }
  }
 },
 {
  "name": "a second activation is illegal once the indestructible counter is gone",
  "players": [
   {
    "battlefield": [
     {
      "name": "Arwen, Mortal Queen",
      "counters": {
       "indestructible": 1
      }
     },
     "Plains",
     "Plains",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Arwen, Mortal Queen"
   },
   {
    "resolve": true
   },
   {
    "activate": "Arwen, Mortal Queen",
    "illegal": true
   }
  ],
  "expect": {
   "counters": {
    "Arwen, Mortal Queen": {
     "plusoneplusone": 1,
     "lifelink": 1
    }
   },
   "pt": {
    "Arwen, Mortal Queen": [
     3,
     3
    ]
   }
  }
 },
 {
  "name": "ruling: target dies in response, so Arwen's ability does nothing and she gets no counters",
  "players": [
   { "battlefield": [ { "name": "Arwen, Mortal Queen", "counters": { "indestructible": 1 } }, "Plains", "Grizzly Bears" ] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "activate": "Arwen, Mortal Queen", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ], "pt": { "Arwen, Mortal Queen": [2, 2] } }
 },
 {
  "name": "ruling: Arwen with 2 damage is destroyed when the indestructible counter is removed as a cost",
  "players": [
   { "battlefield": [ { "name": "Arwen, Mortal Queen", "counters": { "indestructible": 1 } }, "Plains", "Grizzly Bears" ] },
   { "hand": ["Shock"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Shock", "player": 1, "targets": ["Arwen, Mortal Queen"] },
   { "resolve": true },
   { "activate": "Arwen, Mortal Queen", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Arwen, Mortal Queen"] }, { "graveyard_has": ["Shock"] } ] }
 }
]