    "steps": [ { "activate": "Draconian Cylix", "ability": 0 } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Forest"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Draconian Cylix": true } } }
