[
 {
  "name": "copy ability: next instant with MV <= power is copied",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Loki Laufeyson", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Loki Laufeyson", "ability": 0 },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 0 }, { "life": 14 } ]
  }
 },
 {
  "name": "spell with mana value above Loki's power is not copied",
  "players": [
   { "hand": ["Divination"], "battlefield": ["Loki Laufeyson", "Island", "Island", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "activate": "Loki Laufeyson", "ability": 0 },
   { "resolve": true },
   { "cast": "Divination" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 2 }, {} ]
  }
 },
 {
  "name": "power-up for {3} the turn it enters, then the full cost is illegal",
  "players": [
   { "hand": ["Loki Laufeyson"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Loki Laufeyson" },
   { "resolve": true },
   { "activate": "Loki Laufeyson", "ability": 2 },
   { "resolve": true },
   { "activate": "Loki Laufeyson", "ability": 1, "illegal": true }
  ],
  "expect": {
   "pt": { "Loki Laufeyson": [4, 3] }
  }
 },
 {
  "name": "not entered this turn: power-up costs {4}{R}",
  "players": [
   { "battlefield": ["Loki Laufeyson", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Loki Laufeyson", "ability": 1 },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Loki Laufeyson": [4, 3] }
  }
 }
]
