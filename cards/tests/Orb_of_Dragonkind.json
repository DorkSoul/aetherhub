[
  {
    "name": "restricted mana from Orb pays for a Dragon spell",
    "players": [
      { "hand": ["Shivan Dragon"], "battlefield": ["Orb of Dragonkind", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Shivan Dragon" },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Shivan Dragon"] }, {} ]
    }
  },
  {
    "name": "Orb's two mana cannot pay for a non-Dragon spell",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Orb of Dragonkind", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "sacrifice ability takes a Dragon from the top seven into hand",
    "players": [
      {
        "battlefield": ["Orb of Dragonkind", "Mountain"],
        "library": ["Forest", "Shivan Dragon", "Plains", "Island", "Swamp", "Forest", "Mountain", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "Orb of Dragonkind" },
      { "resolve": true, "answers": [["Shivan Dragon"]] }
    ],
    "expect": {
      "players": [ { "hand": ["Shivan Dragon"], "graveyard": ["Orb of Dragonkind"] }, {} ]
    }
  },
  {
    "name": "sacrifice ability: declining to reveal leaves the hand empty",
    "players": [
      {
        "battlefield": ["Orb of Dragonkind", "Mountain"],
        "library": ["Forest", "Shivan Dragon", "Plains", "Island", "Swamp", "Forest", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Orb of Dragonkind" },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard": ["Orb of Dragonkind"] }, {} ]
    }
  },
  {
    "name": "sacrifice ability cannot take a Dragon from below the top seven",
    "players": [
      {
        "battlefield": ["Orb of Dragonkind", "Mountain"],
        "library": ["Forest", "Forest", "Plains", "Island", "Swamp", "Forest", "Mountain", "Shivan Dragon"]
      },
      {}
    ],
    "steps": [
      { "activate": "Orb of Dragonkind" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard": ["Orb of Dragonkind"] }, {} ]
    }
  },
  {
    "name": "ruling: a card with Dragon in its name but no Dragon type gets no Orb mana",
    "players": [
      { "hand": ["Dragon Fodder"], "battlefield": ["Orb of Dragonkind", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Dragon Fodder", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Dragon Fodder"] }, {} ]
    }
  },
  {
    "name": "ruling: the sacrifice ability does not take a card with Dragon in its name",
    "players": [
      {
        "battlefield": ["Orb of Dragonkind", "Mountain"],
        "library": ["Dragon Fodder", "Forest", "Plains", "Island", "Swamp", "Forest", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Orb of Dragonkind" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard": ["Orb of Dragonkind"] }, {} ]
    }
  }
]
