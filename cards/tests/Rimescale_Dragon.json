 { "name": "a creature with an ice counter does not untap during its controller's untap step",
   "players": [ { "battlefield": [{"name": "Rimescale Dragon", "sick": false}, "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Rimescale Dragon", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Upkeep" } ],
   "expect": { "turn": 2, "tapped": { "Grizzly Bears": true } } },
 { "name": "a tapped creature without an ice counter untaps normally in its controller's untap step",
   "players": [ { "battlefield": [{"name": "Rimescale Dragon", "sick": false}] }, { "battlefield": [{"name": "Grizzly Bears", "tapped": true}] } ],
   "steps": [ { "advance_to": "Upkeep" } ],
   "expect": { "turn": 2, "tapped": { "Grizzly Bears": false } } },
 { "name": "the ability needs a snow mana source for its {S}: plain lands are not enough",
   "players": [ { "battlefield": [{"name": "Rimescale Dragon", "sick": false}, "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Rimescale Dragon", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "tapped": { "Grizzly Bears": false } } },
 { "name": "ruling: a creature with an ice counter put there by another source still does not untap (the static covers all permanents with ice counters)",
