[
  {
    "name": "the upkeep player chooses which of their creatures is destroyed",
    "players": [
      { "battlefield": ["Magus of the Abyss"] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Upkeep", "answers": [1] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Abyss"] },
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "each player's upkeep destroys one of that player's own creatures",
    "players": [
      { "battlefield": ["Magus of the Abyss", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": [ { "name": "Hill Giant", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [1] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Abyss"], "graveyard": ["Grizzly Bears"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "an artifact creature cannot be targeted, so nothing is destroyed",
    "players": [
      { "battlefield": ["Magus of the Abyss"] },
      { "battlefield": [ { "name": "Juggernaut", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Abyss"] },
        { "battlefield_has": ["Juggernaut"] }
      ]
    }
  },
  {
    "name": "ruling: an indestructible creature can be targeted by the trigger but is not destroyed",
    "players": [
      { "battlefield": ["Magus of the Abyss"] },
      { "battlefield": [ { "name": "Brash Taunter", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Abyss"] },
        { "battlefield_has": ["Brash Taunter"] }
      ]
    }
  },
  {
    "name": "ruling: the controller cannot target a creature with hexproof that the upkeep player controls, so nothing is destroyed",
    "players": [
      { "battlefield": ["Magus of the Abyss"] },
      { "battlefield": [ { "name": "Bassara Tower Archer", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Abyss"] },
        { "battlefield_has": ["Bassara Tower Archer"] }
      ]
    }
  },
  {
    "name": "ruling: with a non-hexproof creature alongside, only that creature can be destroyed",
    "players": [
      { "battlefield": ["Magus of the Abyss"] },
      { "battlefield": [ { "name": "Bassara Tower Archer", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Abyss"] },
        { "battlefield_has": ["Bassara Tower Archer"], "graveyard": ["Grizzly Bears"] }
      ]
    }
  }
]
