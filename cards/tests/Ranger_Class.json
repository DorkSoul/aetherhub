[
  { "name": "enters: creates a 2/2 green Wolf token",
    "players": [ { "hand": ["Ranger Class"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Ranger Class" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ranger Class", "Wolf"] }, {} ], "pt": { "Wolf": [2, 2] } } },
  { "name": "level 2 ability: {1}{G} as a sorcery-speed activation raises the level to 2",
    "players": [ { "battlefield": ["Forest", "Forest", { "name": "Ranger Class", "counters": { "level": 1 } }] }, {} ],
    "steps": [ { "activate": "Ranger Class", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ranger Class"] }, {} ], "counters": { "Ranger Class": { "level": 2 } } } },
  { "name": "level 2: whenever you attack, a target attacking creature gets a +1/+1 counter",
    "players": [ { "battlefield": ["Forest", { "name": "Ranger Class", "counters": { "level": 2 } }, "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "level 1: no attack trigger, the attacker is unchanged",
    "players": [ { "battlefield": ["Forest", { "name": "Ranger Class", "counters": { "level": 1 } }, "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "level 3: may cast a creature spell from the top of the library",
    "players": [ { "battlefield": ["Forest", "Forest", { "name": "Ranger Class", "counters": { "level": 3 } }], "library": ["Grizzly Bears", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "level 2: a creature on top of the library cannot be cast from there",
    "players": [ { "battlefield": ["Forest", "Forest", { "name": "Ranger Class", "counters": { "level": 2 } }], "library": ["Grizzly Bears", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
 {"name": "level 3 costs {3}{G} and is only available from level 2",
  "players": [ { "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Ranger Class", "counters": { "level": 2 } }] }, {} ],
  "steps": [ { "activate": "Ranger Class", "ability": 1 }, { "resolve": true } ],
  "expect": { "counters": { "Ranger Class": { "level": 3 } }, "players": [ {}, {} ] } },
 {"name": "level 3 needs four mana: three Forests is illegal",
  "players": [ { "battlefield": ["Forest", "Forest", "Forest", { "name": "Ranger Class", "counters": { "level": 2 } }] }, {} ],
  "steps": [ { "activate": "Ranger Class", "ability": 1, "illegal": true } ],
  "expect": { "counters": { "Ranger Class": { "level": 2 } }, "players": [ {}, {} ] } },
  { "name": "enters with one level counter: a level 2 activation right after casting is legal",
    "players": [ { "hand": ["Ranger Class"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Ranger Class" }, { "resolve": true }, { "resolve": true }, { "activate": "Ranger Class", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ranger Class", "Wolf"] }, {} ], "counters": { "Ranger Class": { "level": 2 } } } },
  { "name": "ruling: a level 2 ability cannot be activated again once the Class is level 2",
    "players": [ { "battlefield": ["Forest", "Forest", { "name": "Ranger Class", "counters": { "level": 2 } }] }, {} ],
    "steps": [ { "activate": "Ranger Class", "ability": 0, "illegal": true } ],
    "expect": { "counters": { "Ranger Class": { "level": 2 } }, "players": [ {}, {} ] } },
  { "name": "ruling: a level 3 Class keeps the level 2 attack trigger",
    "players": [ { "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Ranger Class", "counters": { "level": 3 } }, "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "ruling: several attackers still give only one +1/+1 counter (once per combat)",
    "players": [ { "battlefield": ["Forest", { "name": "Ranger Class", "counters": { "level": 2 } }, "Grizzly Bears", "Goblin Piker"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Goblin Piker", "at": "p1" } ] }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3], "Goblin Piker": [2, 1] } } }
]
