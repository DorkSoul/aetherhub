  ],
  "steps": [
   { "attack": [ { "card": "Mesa Pegasus", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 }, { "card": "Hill Giant", "at": "p1", "band": 1 } ], "illegal": true },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 20 } ] }
 },
 {
  "name": "ruling: a band with one nonbanding creature (Hill Giant) is legal and all three deal damage",
  "players": [
   { "battlefield": [ { "name": "Mesa Pegasus", "sick": false }, { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false } ] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Mesa Pegasus", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 }, { "card": "Hill Giant", "at": "p1", "band": 1 } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 14 } ] }
 },
 {
  "name": "ruling: the attacking player divides a blocker's damage among the banded creatures (all 3 to Grizzly Bears)",
  "players": [
   { "battlefield": [ { "name": "Mesa Pegasus", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
   { "battlefield": [ "Hill Giant" ] }
  ],
  "steps": [
   { "attack": [ { "card": "Mesa Pegasus", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2", "answers": [ "Grizzly Bears=3" ] }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Mesa Pegasus"] },
    { "graveyard_has": ["Hill Giant"] }
   ]
