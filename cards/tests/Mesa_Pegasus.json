[
 {
  "name": "flying: a creature without flying or reach can't block it",
  "players": [
   { "battlefield": [ { "name": "Mesa Pegasus", "sick": false } ] },
   { "battlefield": [ "Hill Giant" ] }
  ],
  "steps": [
   { "attack": [ { "card": "Mesa Pegasus", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Mesa Pegasus" } ], "illegal": true },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 19 } ] }
 },
 {
  "name": "banding: a band with Grizzly Bears is blocked as a group when one member is blocked",
  "players": [
   { "battlefield": [ { "name": "Mesa Pegasus", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
   { "battlefield": [ "Hill Giant" ] }
  ],
  "steps": [
   { "attack": [ { "card": "Mesa Pegasus", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 20 } ] }
 },
 {
  "name": "boundary: without a band the Pegasus connects when only the Bears are blocked",
  "players": [
   { "battlefield": [ { "name": "Mesa Pegasus", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
   { "battlefield": [ "Hill Giant" ] }
  ],
  "steps": [
   { "attack": [ { "card": "Mesa Pegasus", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 19 } ] }
 },
 {
  "name": "ruling: a band takes at most one nonbanding creature, so Bears plus Hill Giant with the Pegasus is an illegal attack",
  "players": [
   { "battlefield": [ { "name": "Mesa Pegasus", "sick": false }, { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false } ] },
