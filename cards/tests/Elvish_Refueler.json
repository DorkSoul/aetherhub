[
  {
    "name": "exhaust adds a counter",
    "players": [ { "battlefield": ["Elvish Refueler", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Elvish Refueler" }, { "resolve": true } ],
    "expect": { "counters": { "Elvish Refueler": { "p1p1": 1 } }, "pt": { "Elvish Refueler": [3, 4] } }
  },
  {
    "name": "same turn: the first exhaust activation uses up the permission, so no second activation",
    "players": [ { "battlefield": ["Elvish Refueler", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Elvish Refueler" }, { "resolve": true },
      { "activate": "Elvish Refueler", "illegal": true }
    ],
    "expect": { "counters": { "Elvish Refueler": { "p1p1": 1 } } }
  },
  {
    "name": "on the opponent's turn the exhausted ability stays used",
    "players": [ { "battlefield": ["Elvish Refueler", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Elvish Refueler" }, { "resolve": true },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "activate": "Elvish Refueler", "illegal": true }
    ],
    "expect": { "turn": 2, "counters": { "Elvish Refueler": { "p1p1": 1 } } }
  },
  {
    "name": "on your next turn, before any other exhaust activation, it may be activated again",
    "players": [ { "battlefield": ["Elvish Refueler", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Elvish Refueler" }, { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Elvish Refueler" }, { "resolve": true },
      { "activate": "Elvish Refueler", "illegal": true }
    ],
    "expect": { "turn": 3, "counters": { "Elvish Refueler": { "p1p1": 2 } }, "pt": { "Elvish Refueler": [4, 5] } }
  },
  {
    "name": "ruling: exhaust can be activated at any time the player could activate an ability, here on the opponent's turn",
    "players": [ { "battlefield": ["Elvish Refueler", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "activate": "Elvish Refueler" }, { "resolve": true }
    ],
    "expect": { "turn": 2, "counters": { "Elvish Refueler": { "p1p1": 1 } }, "pt": { "Elvish Refueler": [3, 4] } }
  }
]
