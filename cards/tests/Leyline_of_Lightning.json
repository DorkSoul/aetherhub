[
  {
    "name": "paying 1 deals 1 damage to target player when a spell is cast",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Leyline of Lightning",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1",
          "p1"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 16
        }
      ]
    }
  },
  {
    "name": "declining to pay deals no damage",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Leyline of Lightning",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1",
          "p1"
        ]
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "in the opening hand it begins the game on the battlefield",
    "players": [ { "hand": ["Leyline of Lightning"] }, {} ],
    "steps": [],
    "expect": { "players": [ { "battlefield_has": ["Leyline of Lightning"], "hand_count": 0 }, {} ] }
  },
  {
    "name": "ruling: the Leyline payment is made before the creature resolves, so bloodthirst sees the damage",
    "players": [ { "hand": ["Stormblood Berserker"], "battlefield": ["Leyline of Lightning", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Stormblood Berserker", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "pt": { "Stormblood Berserker": [3, 3] }, "players": [ { "battlefield_has": ["Stormblood Berserker"] }, { "life": 19 } ] }
  },
  {
    "name": "ruling: declining the Leyline payment leaves bloodthirst unsatisfied, so the creature enters as a 1/1",
    "players": [ { "hand": ["Stormblood Berserker"], "battlefield": ["Leyline of Lightning", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Stormblood Berserker", "targets": ["p1"] }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "pt": { "Stormblood Berserker": [1, 1] }, "players": [ {}, { "life": 20 } ] }
  }
]
