[
  {
    "name": "gives trample to Sliver creatures you control",
    "players": [
      { "battlefield": ["Groundshaker Sliver", "Battle Sliver"] },
      {}
    ],
    "steps": [ { "pass": true } ],
    "expect": {
      "keywords": { "Battle Sliver": ["Trample"], "Groundshaker Sliver": ["Trample"] }
    }
  },
  {
    "name": "does not give trample to non-Sliver creatures",
    "players": [
      { "battlefield": ["Groundshaker Sliver", "Grizzly Bears"] },
      {}
    ],
    "steps": [ { "pass": true } ],
    "expect": {
      "keywords": { "Groundshaker Sliver": ["Trample"] },
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: if a Sliver stops being a Sliver, its own ability no longer affects it, but still affects other Slivers",
    "players": [
      { "hand": ["De-evolve"], "battlefield": ["Swamp", "Island", "Groundshaker Sliver", "Battle Sliver"] },
      {}
    ],
    "steps": [
      { "cast": "De-evolve", "targets": ["Groundshaker Sliver"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Groundshaker Sliver", "Battle Sliver"] }, {}],
      "subtypes": { "Groundshaker Sliver": ["Salamander"] },
      "not_subtypes": { "Groundshaker Sliver": ["Sliver"] },
      "keywords": { "Battle Sliver": ["Trample"] }
    }
  },
  {
    "name": "ruling: Sliver abilities and power/toughness boosts from several sources are cumulative",
    "players": [
      { "battlefield": ["Battle Sliver", "Groundshaker Sliver", "Sliver Legion"] },
      {}
    ],
    "steps": [ { "pass": true } ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Groundshaker Sliver": [9, 7], "Battle Sliver": [7, 5], "Sliver Legion": [11, 9] },
      "keywords": { "Battle Sliver": ["Trample"], "Groundshaker Sliver": ["Trample"] }
    }
  }
]
