   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Blaze", "targets": ["p1"], "answers": [2] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Blaze"], "hand_count": 0 }, { "life": 13 } ] } },
