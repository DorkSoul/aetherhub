   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Divination" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 3 }, { "life": 17 } ] } },
 { "name": "the first spell each turn does nothing",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Shiko and Narset, Unified", "Mountain"] }, { } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0 }, { "life": 17 } ] } },
 { "name": "the third spell does nothing",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Divination"], "battlefield": ["Shiko and Narset, Unified", "Mountain", "Mountain", "Island", "Island", "Island"] }, { } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Divination" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2 }, { "life": 11 } ] } },
 { "name": "ruling: the copy keeps the original X (Blaze X=2 is copied for 2)",
