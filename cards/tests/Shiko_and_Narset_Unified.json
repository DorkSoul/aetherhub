   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Lightning Bolt"], "hand_count": 0 }, { "life": 11 } ] } },
 { "name": "second spell that targets nothing is not copied: draw a card instead",
