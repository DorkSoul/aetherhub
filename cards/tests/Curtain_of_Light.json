      { "block": [] },
      { "pass": true },
      { "cast": "Curtain of Light", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "turn": 1,
      "players": [{}, { "life": 18, "graveyard": ["Curtain of Light"] }]
