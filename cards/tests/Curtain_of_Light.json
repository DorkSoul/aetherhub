      { "block": [] },
      { "pass": true },
      { "cast": "Curtain of Light", "player": 1, "targets": ["Rampaging Baloths"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 14, "hand_count": 1, "graveyard": ["Curtain of Light"] }]
    }
  },
  {
    "name": "ruling: Curtain of Light can be cast in an additional combat phase after its declare blockers step",
    "players": [
      { "battlefield": ["Aggravated Assault", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Plains", "Island"], "hand": ["Curtain of Light"] }
