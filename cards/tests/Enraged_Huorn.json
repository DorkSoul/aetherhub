[
 { "name": "the Huorn becomes the Ring-bearer and can't be blocked by a greater-power creature",
   "players": [ { "hand": ["Enraged Huorn"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Enraged Huorn" }, { "resolve": true },
              { "advance_to": "Main1" } ],
   "expect": { "players": [ { "battlefield_has": ["Enraged Huorn"] }, {} ] } },
 { "name": "ruling: the first tempt gives you The Ring 1 emblem",
   "players": [ { "hand": ["Enraged Huorn"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Enraged Huorn" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Enraged Huorn"], "command": ["The Ring 1"] }, {} ] } },
 { "name": "ruling: the Ring tempts you even with no creature; The Ring Goes South still gives the emblem",
   "players": [ { "hand": ["The Ring Goes South"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "The Ring Goes South" }, { "resolve": true } ],
   "expect": { "players": [ { "command": ["The Ring 1"] }, {} ] } },
 { "name": "ruling: a second tempt replaces The Ring 1 with The Ring 2, leaving one emblem",
   "players": [ { "hand": ["Enraged Huorn", "The Ring Goes South"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Enraged Huorn" }, { "resolve": true }, { "cast": "The Ring Goes South" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Enraged Huorn"], "command": ["The Ring 2"] }, {} ] } },
 { "name": "ruling: you must choose a creature when you control one; the chosen Grizzly Bears is the Ring-bearer and cannot be blocked by greater power",
   "players": [ { "hand": ["Enraged Huorn"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Enraged Huorn" }, { "resolve": true, "answers": ["Grizzly Bears"] },
              { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
              { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }], "illegal": true },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Enraged Huorn", "Grizzly Bears"] }, { "life": 18 } ] } },
 { "name": "ruling: if every target of the tempting spell is gone on resolution, the Ring does not tempt you",
   "players": [ { "hand": ["Slip On the Ring"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Slip On the Ring", "targets": ["Grizzly Bears"] },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "command": [], "graveyard": ["Grizzly Bears", "Slip On the Ring"] }, { "life": 20, "graveyard": ["Lightning Bolt"] } ], "stack_empty": true } }
]
