[
  {
    "name": "combat damage to a player investigates that many times",
    "players": [
      {
        "battlefield": [
          "Piper Wright, Publick Reporter"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Piper Wright, Publick Reporter",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Piper Wright, Publick Reporter",
            "Clue"
          ]
        },
        {
          "life": 19
        }
      ]
    }
  },
  {
    "name": "blocked: no combat damage to the player, no Clue",
    "players": [
      {
        "battlefield": [
          "Piper Wright, Publick Reporter"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Piper Wright, Publick Reporter",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Grizzly Bears",
            "attacker": "Piper Wright, Publick Reporter"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Clue"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "sacrificing your Clue puts a +1/+1 counter on a creature you control",
    "players": [
      { "battlefield": ["Piper Wright, Publick Reporter", "Grizzly Bears", "Clue", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Clue", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Grizzly Bears": [3, 3] },
      "counters": { "Grizzly Bears": { "p1p1": 1 } }
    }
  },
  {
    "name": "the opponent sacrificing their Clue does not trigger Piper",
    "players": [
      { "battlefield": ["Piper Wright, Publick Reporter", "Grizzly Bears"] },
      { "battlefield": ["Clue", "Island", "Island"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Clue", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: a Clue sacrificed as part of another spell's effect still triggers Piper",
    "players": [
      { "hand": ["Pitiless Carnage"], "battlefield": ["Piper Wright, Publick Reporter", "Grizzly Bears", "Clue", "Swamp", "Forest", "Forest", "Forest", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Pitiless Carnage" },
      { "resolve": true, "answers": [[2]], "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "battlefield_lacks": ["Clue"] }, {} ],
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
