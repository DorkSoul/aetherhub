[
 {
  "name": "two devotion to white makes two Soldiers",
  "players": [
   {
    "hand": [
     "Evangel of Heliod"
    ],
    "battlefield": [
     "Plains",
     "Plains",
     "Plains",
     "Plains",
     "Plains",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Evangel of Heliod"
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [],
     "battlefield_has": [
      "Soldier",
      "Soldier"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "devotion counts other white permanents, not green ones",
  "players": [
   {
    "hand": [
     "Evangel of Heliod"
    ],
    "battlefield": [
     "Plains",
     "Plains",
     "Plains",
     "Plains",
     "Plains",
     "Plains",
     "Serra Angel",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Evangel of Heliod"
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Soldier",
      "Soldier",
      "Soldier",
      "Soldier"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: Phyrexian white mana counts toward devotion",
  "players": [ { "hand": ["Evangel of Heliod"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Porcelain Legionnaire"] }, {} ],
  "steps": [ { "cast": "Evangel of Heliod" }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Soldier", "Soldier", "Soldier"] }, {} ] }
 },
 {
  "name": "ruling: generic mana symbols do not count toward devotion",
  "players": [ { "hand": ["Evangel of Heliod"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Benalish Knight"] }, {} ],
  "steps": [ { "cast": "Evangel of Heliod" }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Soldier", "Soldier", "Soldier"] }, {} ] }
 },
 {
  "name": "ruling: devotion is counted as the trigger resolves, so removing a white permanent shrinks the tokens",
  "players": [ { "hand": ["Evangel of Heliod", "Shock"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Mountain", "Benalish Knight"] }, {} ],
  "steps": [
   { "cast": "Evangel of Heliod" }, { "resolve": true },
   { "cast": "Shock", "targets": ["Benalish Knight"] }, { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Soldier", "Soldier"], "battlefield_lacks": ["Benalish Knight"] }, {} ] }
 }
]