[
 {
  "name": "returns target creature to its owner's hand",
  "players": [
   { "hand": ["Consuming Vortex"], "battlefield": ["Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [ { "cast": "Consuming Vortex", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "hand": [] , "graveyard": ["Consuming Vortex"] }, { "battlefield_lacks": ["Grizzly Bears"], "hand": ["Grizzly Bears"] } ] }
 },
 {
  "name": "spliced onto Glacial Ray: both spells' targets are chosen and both effects happen",
  "players": [
   { "hand": ["Glacial Ray", "Consuming Vortex"], "battlefield": ["Mountain", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [ { "cast": "Glacial Ray", "targets": ["p1", "Grizzly Bears"], "answers": [true] }, { "resolve": true } ],
  "expect": { "players": [ { "hand": ["Consuming Vortex"] }, { "life": 18, "battlefield_lacks": ["Grizzly Bears"], "hand": ["Grizzly Bears"] } ] }
 },
 {
  "name": "declining the splice: only Glacial Ray resolves",
  "players": [
   { "hand": ["Glacial Ray", "Consuming Vortex"], "battlefield": ["Mountain", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [ { "cast": "Glacial Ray", "targets": ["p1"], "answers": [false] }, { "resolve": true } ],
  "expect": { "players": [ { "hand": ["Consuming Vortex"] }, { "life": 18, "battlefield_has": [] } ] }
 },
 {
  "name": "ruling: if the only target is illegal on resolution, the spell does nothing (no bounce)",
  "players": [
   { "hand": ["Consuming Vortex"], "battlefield": ["Island", "Island"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Consuming Vortex", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Consuming Vortex"] },
    { "graveyard": ["Grizzly Bears", "Lightning Bolt"], "battlefield_lacks": ["Grizzly Bears"] }
   ]
  }
 }
]
