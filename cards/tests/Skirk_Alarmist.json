[
  { "name": "turns a face-down creature face up and sacrifices it at the next end step",
    "players": [ { "battlefield": [ { "name": "Skirk Alarmist", "sick": false }, { "name": "Grizzly Bears", "face_down": true } ] }, {} ],
    "steps": [ { "activate": "Skirk Alarmist", "ability": 0 }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Skirk Alarmist"], "graveyard": ["Grizzly Bears"] }, {} ] } },
  { "name": "the turned-up creature stays on the battlefield until the end step",
    "players": [ { "battlefield": [ { "name": "Skirk Alarmist", "sick": false }, { "name": "Grizzly Bears", "face_down": true } ] }, {} ],
    "steps": [ { "activate": "Skirk Alarmist", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield": ["Skirk Alarmist", "Grizzly Bears"] }, {} ] } },
  { "name": "needs a face-down creature you control to activate",
    "players": [ { "battlefield": [ { "name": "Skirk Alarmist", "sick": false }, "Grizzly Bears" ] }, {} ],
    "steps": [ { "activate": "Skirk Alarmist", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield": ["Skirk Alarmist", "Grizzly Bears"] }, {} ] } },
  { "name": "ruling: activated in the end step, the creature is not sacrificed in that step (still there in the opponent's main phase)",
    "players": [ { "battlefield": [ { "name": "Skirk Alarmist", "sick": false }, { "name": "Grizzly Bears", "face_down": true } ] }, {} ],
    "steps": [ { "advance_to": "End" }, { "activate": "Skirk Alarmist", "ability": 0 }, { "resolve": true }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield": ["Skirk Alarmist", "Grizzly Bears"], "graveyard": [] }, {} ] } },
  { "name": "ruling: activated in the end step, the creature is sacrificed at the next turn's end step",
    "players": [ { "battlefield": [ { "name": "Skirk Alarmist", "sick": false }, { "name": "Grizzly Bears", "face_down": true } ] }, {} ],
    "steps": [ { "advance_to": "End" }, { "activate": "Skirk Alarmist", "ability": 0 }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Skirk Alarmist"], "graveyard": ["Grizzly Bears"] }, {} ] } }
]
