[
 { "name": "mountainwalk: can't be blocked when defending player controls a Mountain",
   "players": [ { "battlefield": ["Vug Lizard"] }, { "battlefield": ["Mountain", "Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Vug Lizard", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Vug Lizard" } ], "illegal": true },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 20 }, { "life": 17 } ] } },
 { "name": "mountainwalk: without a Mountain the defender can block it",
   "players": [ { "battlefield": ["Vug Lizard"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Vug Lizard", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Vug Lizard" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
 { "name": "echo: paying the echo cost keeps it",
   "players": [
    { "hand": ["Vug Lizard"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
    {}
   ],
   "steps": [
    { "cast": "Vug Lizard" },
    { "resolve": true },
    { "advance_to": "End" },
    { "advance_to": "Upkeep" },
    { "advance_to": "Upkeep", "answers": [true] }
   ],
   "expect": { "players": [ { "battlefield_has": ["Vug Lizard"] }, {} ] } },
 { "name": "echo: not paying sacrifices it",
   "players": [
    { "hand": ["Vug Lizard"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
    {}
   ],
   "steps": [
    { "cast": "Vug Lizard" },
    { "resolve": true },
    { "advance_to": "End" },
    { "advance_to": "Upkeep" },
    { "advance_to": "Upkeep", "answers": [false] }
   ],
   "expect": { "players": [ { "graveyard": ["Vug Lizard"] }, {} ] } }
]
