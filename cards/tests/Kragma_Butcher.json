[
  {
    "name": "untapped by its own untap step: gets +2/+0 (inspired)",
    "players": [ { "battlefield": [ { "name": "Kragma Butcher", "tapped": true } ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "pt": { "Kragma Butcher": [4, 3] } }
  },
  {
    "name": "without becoming untapped it stays 2/3",
    "players": [ { "battlefield": ["Kragma Butcher"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "pt": { "Kragma Butcher": [2, 3] } }
  },
  {
    "name": "ruling: entering the battlefield does not trigger inspired",
    "players": [ { "hand": ["Kragma Butcher"], "battlefield": ["Mountain", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Kragma Butcher" }, { "resolve": true } ],
    "expect": { "pt": { "Kragma Butcher": [2, 3] } }
  }
]
