[
  {
    "name": "when it becomes tapped, you may discard a card to draw a card",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Volatile Wanderglyph"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Volatile Wanderglyph", "at": "p1" }] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "hand_count": 1, "graveyard": ["Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "declining the discard keeps the hand",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Volatile Wanderglyph"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Volatile Wanderglyph", "at": "p1" }] },
      { "resolve": true, "answers": [false] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "hand": ["Grizzly Bears"], "graveyard": [] }, {}]
    }
  },
  {
    "name": "with an empty hand there is nothing to discard and no draw",
    "players": [
      { "battlefield": ["Volatile Wanderglyph"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Volatile Wanderglyph", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "hand_count": 0 }, {}]
    }
  }
]
