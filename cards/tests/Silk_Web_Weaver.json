[
  { "name": "hard cast for 2GW makes no token",
    "players": [ { "hand": ["Silk, Web Weaver"], "battlefield": ["Forest", "Plains", "Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Silk, Web Weaver" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Silk, Web Weaver"], "hand": [] }, {} ] } },
  { "name": "web-slinging: return a tapped creature to hand instead of paying 2GW",
    "players": [ { "hand": ["Silk, Web Weaver"], "battlefield": ["Forest", "Plains", "Swamp", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Silk, Web Weaver", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Silk, Web Weaver"], "hand": ["Grizzly Bears"] }, {} ] } },
  { "name": "web-slinging illegal without a tapped creature to return",
    "players": [ { "hand": ["Silk, Web Weaver"], "battlefield": ["Forest", "Plains", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Silk, Web Weaver", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Silk, Web Weaver"] }, {} ] } },
  { "name": "casting a creature spell creates a Human Citizen token",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Silk, Web Weaver", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Human Citizen 1-1 GW"], "hand": [] }, {} ] } },
  { "name": "casting a noncreature spell creates no token",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Silk, Web Weaver", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "3GW: creatures you control get +2/+2",
    "players": [ { "battlefield": ["Silk, Web Weaver", "Grizzly Bears", "Forest", "Plains", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Silk, Web Weaver", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Silk, Web Weaver": [5, 7], "Grizzly Bears": [4, 4] } } },
  { "name": "ruling: a creature tapped for mana earlier can be returned to pay web-slinging",
    "players": [ { "hand": ["Silk, Web Weaver"], "battlefield": ["Llanowar Elves", "Forest", "Plains"] }, {} ],
    "steps": [ { "tap_for_mana": "Llanowar Elves" }, { "cast": "Silk, Web Weaver", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Silk, Web Weaver"], "hand": ["Llanowar Elves"] }, {} ] } },
  { "name": "ruling: web-slinging follows creature timing, so it is illegal in combat",
    "players": [ { "hand": ["Silk, Web Weaver"], "battlefield": ["Forest", "Plains", "Swamp", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Silk, Web Weaver", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Silk, Web Weaver"], "battlefield_has": ["Grizzly Bears"] }, {} ] } }
]
