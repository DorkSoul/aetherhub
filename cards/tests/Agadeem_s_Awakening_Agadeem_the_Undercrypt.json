[
  {
    "name": "returns creatures with different mana values, dropping a duplicate",
    "players": [
      { "hand": ["Agadeem's Awakening // Agadeem, the Undercrypt"], "graveyard": ["Grizzly Bears", "Balduvian Bears", "Llanowar Elves", "Hill Giant"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Agadeem's Awakening // Agadeem, the Undercrypt", "targets": ["Grizzly Bears", "Balduvian Bears", "Llanowar Elves"], "answers": [3] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Grizzly Bears", "Llanowar Elves"], "graveyard": ["Agadeem's Awakening // Agadeem, the Undercrypt", "Balduvian Bears", "Hill Giant"] }, {}] }
  },
  {
    "name": "back face: paying 3 life makes the land enter untapped",
    "players": [
      { "hand": ["Agadeem's Awakening // Agadeem, the Undercrypt"] },
      {}
    ],
    "steps": [
      { "play_land": "Agadeem's Awakening // Agadeem, the Undercrypt", "face": true },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [ { "life": 17, "battlefield_has": ["Agadeem, the Undercrypt"] }, {} ],
      "tapped": { "Agadeem, the Undercrypt": false }
    }
  },
  {
    "name": "back face: not paying 3 life makes the land enter tapped",
    "players": [
      { "hand": ["Agadeem's Awakening // Agadeem, the Undercrypt"] },
      {}
    ],
    "steps": [
      { "play_land": "Agadeem's Awakening // Agadeem, the Undercrypt", "face": true },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [ { "life": 20, "battlefield_has": ["Agadeem, the Undercrypt"] }, {} ],
      "tapped": { "Agadeem, the Undercrypt": true }
    }
  },
  {
    "name": "ruling: X counts as 0 for a graveyard card with {X} in its cost, so the MV 0 creature is a legal target at X=0",
    "players": [ { "hand": ["Agadeem's Awakening // Agadeem, the Undercrypt"], "graveyard": ["Endless One"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Agadeem's Awakening // Agadeem, the Undercrypt", "targets": ["Endless One"], "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Agadeem's Awakening // Agadeem, the Undercrypt", "Endless One"] }, {} ] }
  },
  {
    "name": "ruling: with X=3, one creature of each mana value 2, 1 and 0 can all be targeted",
    "players": [ { "hand": ["Agadeem's Awakening // Agadeem, the Undercrypt"], "graveyard": ["Grizzly Bears", "Llanowar Elves", "Endless One"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Agadeem's Awakening // Agadeem, the Undercrypt", "targets": ["Grizzly Bears", "Llanowar Elves", "Endless One"], "answers": [3] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Llanowar Elves"], "graveyard": ["Agadeem's Awakening // Agadeem, the Undercrypt", "Endless One"] }, {} ] }
  }
]
