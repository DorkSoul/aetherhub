[
  { "name": "first spell on your own turn: no damage",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mischievous Chimera", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "first spell on an opponent's turn: 1 damage to each opponent",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mischievous Chimera", "Mountain"] }, {} ],
    "steps": [
      { "advance_to": "End" }, { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "player": 0, "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }, { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] } },
  { "name": "ruling: the cast trigger still resolves when the spell is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mischievous Chimera", "Mountain"] }, { "hand": ["Psychic Rebuttal"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 },
               { "player": 0, "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true },
               { "cast": "Psychic Rebuttal", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19 } ] } }
]
