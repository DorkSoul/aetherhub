[
  {
    "name": "casting a Spirit: opponent exiles a card of their choice from hand",
    "players": [
      {"hand": ["Wind Spirit"], "battlefield": ["Kyoki, Sanity's Eclipse", "Island", "Island", "Island", "Island", "Island"]},
      {"hand": ["Lightning Bolt", "Grizzly Bears"]}
    ],
    "steps": [
      {"cast": "Wind Spirit"},
      {"resolve": true, "answers": ["Grizzly Bears"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"battlefield_has": ["Wind Spirit"]},
        {"hand": ["Lightning Bolt"], "exile": ["Grizzly Bears"]}
      ]
    }
  },
  {
    "name": "casting a non-Spirit spell does not trigger",
    "players": [
      {"hand": ["Grizzly Bears"], "battlefield": ["Kyoki, Sanity's Eclipse", "Forest", "Forest"]},
      {"hand": ["Lightning Bolt"]}
    ],
    "steps": [
      {"cast": "Grizzly Bears"},
      {"resolve": true}
    ],
    "expect": {"players": [{}, {"hand": ["Lightning Bolt"]}]}
  },
  {
    "name": "ruling: a card exiled by Kyoki stays exiled after Kyoki leaves the battlefield",
    "players": [
      {"hand": ["Wind Spirit", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Kyoki, Sanity's Eclipse", "Island", "Island", "Island", "Island", "Island", "Mountain", "Mountain"]},
      {"hand": ["Grizzly Bears"]}
    ],
    "steps": [
      {"cast": "Wind Spirit"},
      {"resolve": true},
      {"resolve": true},
      {"cast": "Lightning Bolt", "targets": ["Kyoki, Sanity's Eclipse"]},
      {"resolve": true},
      {"cast": "Lightning Bolt", "targets": ["Kyoki, Sanity's Eclipse"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"battlefield_lacks": ["Kyoki, Sanity's Eclipse"], "graveyard": ["Kyoki, Sanity's Eclipse", "Lightning Bolt", "Lightning Bolt"]},
        {"hand": [], "exile": ["Grizzly Bears"]}
      ]
    }
  }
]
