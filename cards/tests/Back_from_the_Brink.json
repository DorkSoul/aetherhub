[
  { "name": "exile a creature card and pay its mana cost to make a token copy",
    "players": [
      { "graveyard": ["Grizzly Bears"], "battlefield": ["Back from the Brink", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Back from the Brink" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "battlefield_has": ["Grizzly Bears", "Back from the Brink"], "graveyard": [], "exile": ["Grizzly Bears"] },
      {}
    ], "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "a coloured mana cost must be paid in full",
    "players": [
      { "graveyard": ["Serra Angel"], "battlefield": ["Back from the Brink", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Back from the Brink" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "battlefield_has": ["Serra Angel"], "exile": ["Serra Angel"] },
      {}
    ], "keywords": { "Serra Angel": ["Flying", "Vigilance"] } } },
  { "name": "cannot activate when the card's mana cost cannot be paid",
    "players": [
      { "graveyard": ["Serra Angel"], "battlefield": ["Back from the Brink", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Back from the Brink", "ability": 0, "illegal": true }
    ] },
  { "name": "the chosen creature card is the one exiled and copied; non-creature cards are not eligible",
    "players": [
      { "graveyard": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"], "battlefield": ["Back from the Brink", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Back from the Brink", "answers": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"], "exile": ["Hill Giant"], "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] },
      {}
    ] } },
  { "name": "sorcery speed only",
    "players": [
      { "graveyard": ["Grizzly Bears"], "battlefield": ["Back from the Brink", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "activate": "Back from the Brink", "ability": 0, "illegal": true }
    ] },
  { "name": "ruling: the token copy's enters ability triggers (Mulldrifter draws two)",
    "players": [ { "graveyard": ["Mulldrifter"], "battlefield": ["Back from the Brink", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Back from the Brink" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mulldrifter", "Back from the Brink"], "exile": ["Mulldrifter"], "hand_count": 2 }, {} ] } },
  { "name": "ruling: X in the mana cost is zero, so the Walking Ballista token enters with no counters and dies",
    "players": [ { "graveyard": ["Walking Ballista"], "battlefield": ["Back from the Brink"] }, {} ],
    "steps": [ { "activate": "Back from the Brink" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Walking Ballista"], "exile": ["Walking Ballista"] }, {} ] } }
]
