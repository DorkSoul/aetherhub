    "expect": { "players": [ { "battlefield_has": ["Kukemssa Pirates", "Sol Ring"] }, { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Sol Ring"], "life": 20 } ] } },
  { "name": "unblocked: declining the artifact keeps combat damage",
    "players": [ { "battlefield": [ { "name": "Kukemssa Pirates", "sick": false } ] }, { "battlefield": [ "Grizzly Bears", "Sol Ring" ] } ],
    "steps": [ { "attack": [ { "card": "Kukemssa Pirates", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2", "answers": [false], "targets": ["Sol Ring"] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Sol Ring"] }, { "battlefield_has": ["Sol Ring"], "life": 18 } ] } },
