    "steps": [ { "attack": [ { "card": "Kukemssa Pirates", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Kukemssa Pirates" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Kukemssa Pirates"] }, { "battlefield_has": ["Sol Ring"] } ] } },
