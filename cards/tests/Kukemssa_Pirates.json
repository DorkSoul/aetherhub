    "players": [ { "battlefield": [ { "name": "Kukemssa Pirates", "sick": false } ] }, { "battlefield": [ "Sol Ring" ] } ],
    "steps": [ { "attack": [ { "card": "Kukemssa Pirates", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2", "answers": [true], "targets": ["Sol Ring"] } ],
    "expect": { "players": [ { "battlefield_has": ["Kukemssa Pirates", "Sol Ring"] }, { "battlefield_lacks": ["Sol Ring"], "life": 20 } ] } }
