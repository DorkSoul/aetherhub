[
  {
    "name": "combat damage to a player copies an artifact that player controls",
    "players": [
      { "battlefield": ["Schema Thief", "Plains", "Plains", "Plains", "Island"] },
      { "battlefield": ["Bloodforged Battle-Axe"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Schema Thief", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Bloodforged Battle-Axe", "Island", "Plains", "Plains", "Plains", "Schema Thief"] },
        { "life": 17, "battlefield": ["Bloodforged Battle-Axe"] }
      ]
    }
  },
  {
    "name": "no copy of an artifact the damaged player does not control",
    "players": [
      { "battlefield": ["Schema Thief", "Bloodforged Battle-Axe", "Plains", "Plains", "Plains", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Schema Thief", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Bloodforged Battle-Axe", "Island", "Plains", "Plains", "Plains", "Schema Thief"] },
        { "life": 17, "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a token copy of Solemn Simulacrum makes its own enters-the-battlefield search",
    "players": [
      { "battlefield": ["Schema Thief"], "library": ["Forest"] },
      { "battlefield": ["Solemn Simulacrum"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Schema Thief", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2", "answers": [true, "Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Solemn Simulacrum", "Forest"] },
        { "life": 17, "battlefield_has": ["Solemn Simulacrum"] }
      ]
    }
  },
  {
    "name": "ruling: a copy of Hangarback Walker has X=0 and dies as a 0/0",
    "players": [
      { "battlefield": ["Schema Thief"] },
      { "battlefield": [{ "name": "Hangarback Walker", "counters": { "p1p1": 2 } }] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Schema Thief", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Hangarback Walker"] },
        { "life": 17, "battlefield_has": ["Hangarback Walker"] }
      ]
    }
  }
]
