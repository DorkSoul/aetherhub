  { "name": "ruling: no creature to sacrifice means Ogre Marauder can't be blocked",
    "players": [ { "battlefield": ["Ogre Marauder"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Ogre Marauder", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "keywords": { "Ogre Marauder": ["Unblockable"] }, "players": [ {}, { "life": 17 } ] }
