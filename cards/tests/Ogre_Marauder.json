    "steps": [
      { "attack": [ { "card": "Ogre Marauder", "at": "p1" } ] },
      { "resolve": true, "player": 1, "answers": [false] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Waves of Aggression" },
      { "resolve": true },
      { "attack": [ { "card": "Ogre Marauder", "at": "p1" } ] },
      { "resolve": true, "player": 1, "answers": [true] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "keywords": { "Ogre Marauder": ["Unblockable"] }, "players": [ {}, { "life": 14, "graveyard": ["Grizzly Bears"] } ] }
