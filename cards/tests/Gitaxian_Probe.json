[
  {
    "name": "pay U: look at the hand and draw a card",
    "players": [
      {
        "hand": [
          "Gitaxian Probe"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {
        "hand": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Gitaxian Probe",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20,
          "graveyard": [
            "Gitaxian Probe"
          ],
          "hand_count": 1
        },
        {
          "hand": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "pay 2 life with no blue mana",
    "players": [
      {
        "hand": [
          "Gitaxian Probe"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Gitaxian Probe",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18,
          "graveyard": [
            "Gitaxian Probe"
          ],
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the targeted player may have no cards in hand; you still draw",
    "players": [{ "hand": ["Gitaxian Probe"], "battlefield": ["Island"] }, {}],
    "steps": [{ "cast": "Gitaxian Probe", "targets": ["p1"] }, { "resolve": true }],
    "expect": { "players": [{ "life": 20, "graveyard": ["Gitaxian Probe"], "hand_count": 1 }, {}] }
  },
  {
    "name": "ruling: at 1 life you can't pay the 2 life for the Phyrexian blue symbol",
    "players": [{ "hand": ["Gitaxian Probe"] }, {}],
    "steps": [{ "set_life": 1 }, { "cast": "Gitaxian Probe", "targets": ["p1"], "illegal": true }],
    "expect": { "players": [{ "life": 1, "hand": ["Gitaxian Probe"] }, {}] }
  },
  {
    "name": "ruling: a Phyrexian blue spell paid with life is still blue (Veil of Summer draws)",
    "players": [
      { "hand": ["Veil of Summer"], "library": ["Forest"], "battlefield": ["Forest"] },
      { "hand": ["Gitaxian Probe"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Gitaxian Probe", "targets": ["p0"], "player": 1 },
      { "cast": "Veil of Summer" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Veil of Summer"], "hand": ["Forest"] }, { "life": 18, "graveyard": ["Gitaxian Probe"] }]
    }
  }
]
