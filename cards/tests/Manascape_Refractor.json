[
  {
    "name": "enters tapped and taps for any basic land's mana, spent as any colour",
    "players": [
      { "hand": ["Manascape Refractor"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [ { "cast": "Manascape Refractor" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Forest", "Forest", "Forest", "Manascape Refractor"] }, {} ], "tapped": { "Manascape Refractor": true } }
  },
  {
    "name": "an untapped Refractor taps for mana of each land type on the battlefield",
    "players": [
      { "battlefield": [{ "name": "Manascape Refractor", "sick": false }, "Forest"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [ { "tap_for_mana": "Manascape Refractor", "color": "U" } ],
    "expect": { "players": [ { "pool": { "U": 1 } }, {} ] }
  },
  {
    "name": "with only a Forest it can make only green",
    "players": [
      { "battlefield": [{ "name": "Manascape Refractor", "sick": false }, "Forest"] },
      {}
    ],
    "steps": [ { "tap_for_mana": "Manascape Refractor" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ] }
  },
  {
    "name": "granted {U}{B} activation is paid with two Forests (mana spent as any colour)",
    "players": [
      { "battlefield": [{ "name": "Manascape Refractor", "sick": false }, "Duskmantle, House of Shadow", "Forest", "Forest"] },
      {}
    ],
    "steps": [ { "activate": "Manascape Refractor", "ability": 32769, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "library_count": 19 } ], "tapped": { "Manascape Refractor": true } }
  },
  {
    "name": "ruling: with a Mountain on the battlefield the Refractor taps for red",
    "players": [
      { "battlefield": [{ "name": "Manascape Refractor", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [ { "tap_for_mana": "Manascape Refractor", "color": "R" } ],
    "expect": { "players": [ { "pool": { "R": 1 } }, {} ] }
  }
]
