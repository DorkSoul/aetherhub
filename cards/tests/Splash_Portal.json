[
  { "name": "blinks a Bird and its controller draws a card",
    "players": [ { "hand": ["Splash Portal"], "battlefield": ["Island", "Bay Falcon"] }, {} ],
    "steps": [ { "cast": "Splash Portal" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Bay Falcon"] }, {} ] } },
  { "name": "a creature that is not a Bird, Frog, Otter or Rat is blinked without a draw",
    "players": [ { "hand": ["Splash Portal"], "battlefield": ["Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Splash Portal" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a blinked creature is a new object, so its aura goes to the graveyard and its counters are gone",
    "players": [ { "hand": ["Pacifism", "Splash Portal"], "battlefield": ["Plains", "Island", "Island", { "name": "Storm Crow", "counters": { "+1/+1": 1 } }] }, {} ],
    "steps": [ { "cast": "Pacifism", "targets": ["Storm Crow"] }, { "resolve": true }, { "cast": "Splash Portal", "targets": ["Storm Crow"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Pacifism"], "battlefield_has": ["Storm Crow"], "hand_count": 1 }, {} ], "counters": { "Storm Crow": { "PlusOnePlusOne": 0 } } } },
  { "name": "ruling: an exiled token ceases to exist and does not return to the battlefield",
    "players": [ { "hand": ["Elvish Promenade", "Splash Portal"], "battlefield": ["Elvish Piper", "Forest", "Forest", "Forest", "Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Elvish Promenade" }, { "resolve": true }, { "cast": "Splash Portal", "targets": ["Elf Warrior"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Elf Warrior"], "graveyard_has": ["Splash Portal"], "hand_count": 0 }, {} ] } }
]
