    "steps": [ { "advance_to": "End", "answers": ["Carpet of Flowers"] } ],
    "expect": { "counters": { "Case of the Shifting Visage": { "judgment": 1 } }, "players": [ { "hand": ["Carpet of Flowers"] }, {} ] } },
  { "name": "a Case that is not solved does not trigger it",
