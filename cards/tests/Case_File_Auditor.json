[
  {
    "name": "Case spells can be cast with any colour of mana",
    "players": [ { "hand": ["Case of the Ransacked Lab"], "battlefield": ["Case File Auditor", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Case of the Ransacked Lab" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Case of the Ransacked Lab"] }, {} ] }
  },
  {
    "name": "non-Case spells still need their colours",
