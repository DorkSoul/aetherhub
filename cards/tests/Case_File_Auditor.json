    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "ruling: a Case solved by an opponent does not trigger this",
    "players": [ { "battlefield": ["Case File Auditor"], "library": ["Carpet of Flowers"] }, { "battlefield": ["Case of the Shifting Visage"], "graveyard": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "End" } ],
