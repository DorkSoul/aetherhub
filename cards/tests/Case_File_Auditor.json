    "steps": [ { "cast": "Case File Auditor" }, { "resolve": true, "answers": ["Carpet of Flowers"] } ],
    "expect": { "players": [ { "hand": ["Carpet of Flowers"], "battlefield_has": ["Case File Auditor"] }, {} ] } },
  { "name": "an enchantment seventh from the top is not seen",
    "players": [ { "hand": ["Case File Auditor"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Carpet of Flowers"] }, {} ],
    "steps": [ { "cast": "Case File Auditor" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Case File Auditor"] }, {} ] } },
