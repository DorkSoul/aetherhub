[
  { "name": "beginning of combat: up to one card from a graveyard is exiled, adapt puts a creature back with haste and finality",
    "players": [ { "hand": ["Emperor of Bones"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Emperor of Bones" }, { "resolve": true },
               { "advance_to": "BeginCombat", "answers": [0] }, { "resolve": true },
               { "activate": "Emperor of Bones" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Emperor of Bones", "Grizzly Bears"], "exile": [], "graveyard": [] }, {} ] } },
  { "name": "a non-creature exiled with it is not put onto the battlefield by adapt",
    "players": [ { "hand": ["Emperor of Bones"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Emperor of Bones" }, { "resolve": true },
               { "advance_to": "BeginCombat", "answers": [0] }, { "resolve": true },
               { "activate": "Emperor of Bones" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Lightning Bolt"], "exile": ["Lightning Bolt"] }, {} ] } },
  { "name": "the returned creature is sacrificed at the next end step and, with its finality counter, is exiled",
    "players": [ { "hand": ["Emperor of Bones"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Emperor of Bones" }, { "resolve": true },
               { "advance_to": "BeginCombat", "answers": [0] }, { "resolve": true },
               { "activate": "Emperor of Bones" }, { "resolve": true }, { "resolve": true },
               { "advance_to": "End", "auto": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a returned creature that dies while it has a finality counter is exiled instead of going to the graveyard",
    "players": [ { "hand": ["Emperor of Bones", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Mountain"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Emperor of Bones" }, { "resolve": true },
               { "advance_to": "BeginCombat", "answers": [0] }, { "resolve": true },
               { "activate": "Emperor of Bones" }, { "resolve": true }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"], "graveyard": ["Lightning Bolt"] }, {} ] } },
  { "name": "ruling: adapt does nothing if the creature already has a +1/+1 counter",
    "players": [ { "battlefield": ["Swamp", "Swamp", { "name": "Emperor of Bones", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "activate": "Emperor of Bones" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Emperor of Bones"] }, {} ], "pt": { "Emperor of Bones": [3, 3] }, "counters": { "Emperor of Bones": { "p1p1": 1 } } } }
