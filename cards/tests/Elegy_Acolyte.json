[
  {
    "name": "combat damage to a player: lifelink, draw a card and lose 1 life",
    "players": [
      { "library": ["Forest", "Island"], "battlefield": [{ "name": "Elegy Acolyte", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Elegy Acolyte", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "life": 23 },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "end step: no void, no Robot",
    "players": [
      { "battlefield": ["Elegy Acolyte"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Elegy Acolyte"] },
        {}
      ]
    }
  },
  {
    "name": "end step: a nonland permanent left the battlefield this turn, so a Robot is created",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Elegy Acolyte"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Robot 2-2", "Elegy Acolyte"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  }
]
