[
  {
    "name": "on opponent's turn, tapping forces the target creature to attack you",
    "players": [
      {
        "battlefield": [
          {
            "name": "Alluring Siren",
            "sick": false
          }
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "activate": "Alluring Siren",
        "player": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p0"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18
        },
        {
          "battlefield": [
            "Grizzly Bears"
          ]
        }
      ],
      "tapped": {
        "Alluring Siren": true
      }
    }
  },
  {
    "name": "activated on your own turn: no forced attack on the next turn",
    "players": [
      {
        "battlefield": [
          {
            "name": "Alluring Siren",
            "sick": false
          }
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Alluring Siren",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main1"
      },
      {
        "attack": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a creature tapped after the effect resolves can't be forced to attack",
    "players": [
      { "battlefield": [ { "name": "Alluring Siren", "sick": false } ] },
      { "battlefield": [ "Llanowar Elves" ] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "activate": "Alluring Siren", "player": 0, "targets": [ "Llanowar Elves" ] },
      { "resolve": true },
      { "tap_for_mana": "Llanowar Elves", "player": 1 },
      { "attack": [ { "card": "Llanowar Elves", "at": "p0" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "battlefield_has": [ "Llanowar Elves" ] }
      ]
    }
  },
  {
    "name": "ruling: the forced attack goes to you, not to your planeswalker",
    "players": [
      { "battlefield": [ { "name": "Alluring Siren", "sick": false }, "Ajani Resolute" ] },
      { "battlefield": [ "Grizzly Bears" ] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "activate": "Alluring Siren", "player": 0, "targets": [ "Grizzly Bears" ] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "Ajani Resolute" } ], "illegal": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 18, "battlefield_has": [ "Ajani Resolute" ] },
        { "battlefield": [ "Grizzly Bears" ] }
      ]
    }
  }
]
