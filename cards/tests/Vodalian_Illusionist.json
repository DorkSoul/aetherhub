[
  { "name": "{U}{U}, {T}: target creature phases out",
    "players": [
      { "battlefield": ["Vodalian Illusionist", "Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Vodalian Illusionist", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vodalian Illusionist"] }, { "battlefield_lacks": ["Hill Giant"] } ],
      "tapped": { "Vodalian Illusionist": true }
    } },
  { "name": "a tapped Illusionist cannot activate",
    "players": [
      { "battlefield": [{ "name": "Vodalian Illusionist", "tapped": true }, "Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Vodalian Illusionist", "ability": 0, "targets": ["Hill Giant"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Hill Giant"] } ]
    } },
  { "name": "the phased-out creature phases back in at its controller's untap step",
    "players": [
      { "battlefield": ["Vodalian Illusionist", "Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Vodalian Illusionist", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Hill Giant"] } ]
    } }
]
