[
  {
    "name": "hard cast: investigates twice and stays",
    "players": [
      { "hand": ["Wavesifter"], "battlefield": ["Forest", "Island", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Wavesifter" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Wavesifter", "Clue", "Clue"] }, {} ]
    }
  },
  {
    "name": "evoked: sacrificed on entering but still investigates twice",
    "players": [
      { "hand": ["Wavesifter"], "battlefield": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Wavesifter", "alt": 0 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Wavesifter"], "battlefield_has": ["Clue", "Clue"], "battlefield_lacks": ["Wavesifter"] }, {} ]
    }
  },
  {
    "name": "evoke needs both G and U",
    "players": [
      { "hand": ["Wavesifter"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Wavesifter", "alt": 0, "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "ruling: Clue tokens are artifacts, so Krang's affinity and power count them",
    "players": [
      { "hand": ["Wavesifter", "Krang, Master Mind"], "battlefield": ["Forest", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Wavesifter", "alt": 0 },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Krang, Master Mind" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Krang, Master Mind", "Clue", "Clue"], "battlefield_lacks": ["Wavesifter"] }, {} ],
      "pt": { "Krang, Master Mind": [3, 4] }
    }
  },
  {
    "name": "ruling: a Clue sacrificed for its own ability cannot also pay for Lonis",
    "players": [
      { "battlefield": ["Lonis, Cryptozoologist", "Clue", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Clue", "ability": 0 },
      { "resolve": true },
      { "activate": "Lonis, Cryptozoologist", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Lonis, Cryptozoologist"], "battlefield_lacks": ["Clue"] }, {} ]
    }
  }
]
