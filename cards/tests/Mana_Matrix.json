   { "battlefield": ["Mana Matrix", "Grizzly Bears"] },
   { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Murder", "player": 1, "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "hand": ["Murder"] } ]
  }
 }
