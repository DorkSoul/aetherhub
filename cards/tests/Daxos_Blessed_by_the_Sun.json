[
 {
  "name": "toughness equals devotion to white",
  "players": [ { "battlefield": ["Daxos, Blessed by the Sun","Serra Angel"] }, {} ],
  "steps": [ { "pass": true } ],
  "expect": {
   "pt": { "Daxos, Blessed by the Sun": [2,4] }
  }
 },
 {
  "name": "another creature entering gains 1 life",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Daxos, Blessed by the Sun","Forest","Plains"] }, {} ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 21, "battlefield_has": ["Grizzly Bears"] }, {} ]
  }
 },
 {
  "name": "another creature dying gains 1 life",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Daxos, Blessed by the Sun","Grizzly Bears","Mountain"] }, {} ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 21, "graveyard": ["Lightning Bolt","Grizzly Bears"] }, {} ]
  }
 },
 {
  "name": "ruling: hybrid mana symbols count toward devotion to their colour",
  "players": [ { "battlefield": ["Daxos, Blessed by the Sun", "Boros Guildmage"] }, {} ],
  "steps": [ { "pass": true } ],
  "expect": { "pt": { "Daxos, Blessed by the Sun": [2,4] } }
 },
 {
  "name": "ruling: creatures dying together with Daxos gain life for each other creature, not for Daxos itself",
  "players": [ { "hand": ["Pyroclasm"], "battlefield": ["Mountain","Mountain","Daxos, Blessed by the Sun","Grizzly Bears"] }, {} ],
  "steps": [ { "cast": "Pyroclasm" }, { "resolve": true }, { "resolve": true } ],
  "expect": {
   "players": [ { "life": 21, "graveyard_has": ["Daxos, Blessed by the Sun","Grizzly Bears"] }, {} ]
  }
 },
 {
  "name": "ruling: an Aura I control on an opponent's creature counts toward my devotion",
  "players": [ { "hand": ["Pacifism"], "battlefield": ["Daxos, Blessed by the Sun","Plains","Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": {
   "pt": { "Daxos, Blessed by the Sun": [2,3] },
   "attached": { "Pacifism": "Grizzly Bears" }
  }
 },
 {
  "name": "ruling: nonlethal damage stays marked while devotion keeps Daxos alive",
  "players": [ { "hand": ["Pacifism","Shock"], "battlefield": ["Daxos, Blessed by the Sun","Plains","Plains","Mountain","Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
   { "cast": "Pacifism", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Shock", "targets": ["Daxos, Blessed by the Sun"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Daxos, Blessed by the Sun"] }, {} ],
   "pt": { "Daxos, Blessed by the Sun": [2,3] }
  }
 },
 {
  "name": "ruling: when the Aura leaves, Daxos's lower toughness lets the marked damage kill it",
  "players": [ { "hand": ["Pacifism","Shock"], "battlefield": ["Daxos, Blessed by the Sun","Plains","Plains","Mountain","Mountain"] }, { "hand": ["Disenchant"], "battlefield": ["Grizzly Bears","Plains","Plains"] } ],
  "steps": [
   { "cast": "Pacifism", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Shock", "targets": ["Daxos, Blessed by the Sun"] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Disenchant", "player": 1, "targets": ["Pacifism"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard_has": ["Daxos, Blessed by the Sun","Pacifism"] }, { "battlefield_has": ["Grizzly Bears"] } ]
  }
 },
 {
  "name": "ruling: mana symbols in a text box do not count toward devotion",
  "players": [ { "battlefield": ["Daxos, Blessed by the Sun","Bastion Mastodon"] }, {} ],
  "steps": [ { "pass": true } ],
  "expect": { "pt": { "Daxos, Blessed by the Sun": [2,2] } }
 },
 {
  "name": "ruling: generic mana symbols on other permanents do not count toward devotion",
  "players": [ { "battlefield": ["Daxos, Blessed by the Sun","Sol Ring"] }, {} ],
  "steps": [ { "pass": true } ],
  "expect": { "pt": { "Daxos, Blessed by the Sun": [2,2] } }
 }
]
