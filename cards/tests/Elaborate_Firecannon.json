    "expect": {}
  },
  {
    "name": "upkeep: discarding a card untaps the cannon, which does not untap in your untap step",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Elaborate Firecannon", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Elaborate Firecannon", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Grizzly Bears"], "battlefield_has": ["Elaborate Firecannon"] }, { "life": 18 }],
      "tapped": { "Elaborate Firecannon": false }
    }
  },
  {
    "name": "upkeep: declining to discard leaves the cannon tapped",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Elaborate Firecannon", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Elaborate Firecannon", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": [], "hand_count": 1 }, { "life": 18 }],
      "tapped": { "Elaborate Firecannon": true }
    }
  }
