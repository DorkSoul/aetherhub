    "steps": [ { "cast": "Grave Birthing", "targets": ["p1"] }, { "resolve": true, "answers": ["Llanowar Elves"] } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Grave Birthing"], "battlefield_has": ["Eldrazi Scion"] }, { "graveyard": ["Grizzly Bears"], "exile": ["Llanowar Elves"] } ] } },
  { "name": "ruling: the Eldrazi Scion token is 1/1, not 0/1",
    "players": [ { "hand": ["Grave Birthing"], "battlefield": ["Swamp", "Swamp", "Swamp"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Grave Birthing", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Eldrazi Scion"] }, {} ], "pt": { "Eldrazi Scion": [1, 1] } } }
