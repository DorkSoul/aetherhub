    "players": [ { "battlefield": ["Bounty Hunter"] }, { "battlefield": ["Black Knight"] } ],
    "steps": [ { "activate": "Bounty Hunter", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bounty Hunter"] }, { "battlefield_has": ["Black Knight"] } ] } },
  { "name": "tap: destroy target creature with a bounty counter on it",
    "players": [ { "battlefield": ["Bounty Hunter", "Bounty Hunter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Bounty Hunter", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Bounty Hunter", "ability": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bounty Hunter"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "cannot destroy a creature without a bounty counter",
    "players": [ { "battlefield": ["Bounty Hunter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Bounty Hunter", "ability": 1, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bounty Hunter"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
