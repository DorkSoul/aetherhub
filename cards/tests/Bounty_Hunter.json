  { "name": "tap: put a bounty counter on target nonblack creature (then it is tapped)",
    "players": [ { "battlefield": ["Bounty Hunter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Bounty Hunter", "ability": 0 }, { "resolve": true }, { "activate": "Bounty Hunter", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bounty Hunter"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Bounty Hunter": true } } },
