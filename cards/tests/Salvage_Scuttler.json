[
  {
    "name": "attacking returns an artifact you control to hand",
    "players": [{ "battlefield": ["Salvage Scuttler", "Ornithopter"] }, {}],
    "steps": [
      { "attack": [{ "card": "Salvage Scuttler", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Salvage Scuttler"], "battlefield_lacks": ["Ornithopter"], "hand": ["Ornithopter"] }, {}] }
  },
  {
    "name": "with no artifact you control, nothing is returned",
    "players": [{ "battlefield": ["Salvage Scuttler", "Grizzly Bears"] }, {}],
    "steps": [
      { "attack": [{ "card": "Salvage Scuttler", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Salvage Scuttler", "Grizzly Bears"], "hand_count": 0 }, {}] }
  },
  {
    "name": "ruling: with no artifact to return there is no penalty; the attack still deals its damage",
    "players": [{ "battlefield": ["Salvage Scuttler"] }, {}],
    "steps": [
      { "attack": [{ "card": "Salvage Scuttler", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Salvage Scuttler"] }, { "life": 16 }] }
  }
]
