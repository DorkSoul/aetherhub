    "players": [ { "battlefield": ["Dire Mimic", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Dire Mimic" },
      { "resolve": true },
      { "tap_for_mana": "Dire Mimic", "color": "G" }
    ],
    "expect": { "players": [ { "graveyard": ["Dire Mimic"] }, {} ] }
