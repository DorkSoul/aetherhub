[
  { "name": "{1}{S}: +1/+0 and menace, paid with snow mana",
    "players": [ { "battlefield": ["Grim Draugr", "Snow-Covered Swamp", "Snow-Covered Swamp"] }, {} ],
    "steps": [ { "activate": "Grim Draugr", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Grim Draugr": [4, 2] }, "keywords": { "Grim Draugr": ["Menace"] } } },
  { "name": "{1}{S} can't be paid with non-snow lands",
    "players": [ { "battlefield": ["Grim Draugr", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Grim Draugr", "ability": 0, "illegal": true } ],
    "expect": { "pt": { "Grim Draugr": [3, 2] } } },
  { "name": "activating twice stacks the +1/+0 bonus",
    "players": [ { "battlefield": ["Grim Draugr", "Snow-Covered Swamp", "Snow-Covered Swamp", "Snow-Covered Swamp", "Snow-Covered Swamp"] }, {} ],
    "steps": [ { "activate": "Grim Draugr", "ability": 0 }, { "resolve": true }, { "activate": "Grim Draugr", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Grim Draugr": [5, 2] } } },
  { "name": "{S} is generic: snow mana of another colour (Snow-Covered Island) pays it",
    "players": [ { "battlefield": ["Grim Draugr", "Snow-Covered Island", "Snow-Covered Island"] }, {} ],
    "steps": [ { "activate": "Grim Draugr", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Grim Draugr": [4, 2] }, "keywords": { "Grim Draugr": ["Menace"] } } },
  { "name": "blocked by a single creature, then pumped with menace: stays blocked",
    "players": [ { "battlefield": ["Grim Draugr", "Snow-Covered Swamp", "Snow-Covered Swamp"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
               { "attack": [ { "card": "Grim Draugr", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grim Draugr" } ], "player": 1 },
               { "activate": "Grim Draugr", "ability": 0 },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Grim Draugr"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: {S} is one snow mana of any colour; the {1} part can be paid by a non-snow land",
    "players": [ { "battlefield": ["Grim Draugr", "Snow-Covered Island", "Swamp"] }, {} ],
    "steps": [ { "activate": "Grim Draugr", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Grim Draugr": [4, 2] }, "keywords": { "Grim Draugr": ["Menace"] } } },
  { "name": "ruling: pumping after a single blocker does not make Grim Draugr unblocked",
    "players": [ { "battlefield": ["Grim Draugr", "Snow-Covered Swamp", "Snow-Covered Swamp"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
               { "attack": [ { "card": "Grim Draugr", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grim Draugr" } ], "player": 1 },
               { "activate": "Grim Draugr", "ability": 0 },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Grim Draugr"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: Heartstone reduces only the generic {1}; one snow land still pays the {S}",
    "players": [ { "battlefield": ["Heartstone", "Grim Draugr", "Snow-Covered Swamp"] }, {} ],
    "steps": [ { "activate": "Grim Draugr", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Grim Draugr": [4, 2] } } },
  { "name": "ruling: Heartstone cannot make the {S} payable by a non-snow land",
    "players": [ { "battlefield": ["Heartstone", "Grim Draugr", "Swamp"] }, {} ],
    "steps": [ { "activate": "Grim Draugr", "ability": 0, "illegal": true } ],
    "expect": { "pt": { "Grim Draugr": [3, 2] } } }
]
