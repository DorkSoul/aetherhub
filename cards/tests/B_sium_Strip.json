[
 {
  "name": "casts the top instant from the graveyard; it is exiled afterwards",
  "players": [
   { "graveyard": ["Lightning Bolt"], "battlefield": ["Bösium Strip", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Bösium Strip" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "exile": ["Lightning Bolt"], "graveyard": [] }, { "life": 17 } ] }
 },
 {
  "name": "a creature card on top blocks the instant beneath it",
  "players": [
   { "graveyard": ["Lightning Bolt", "Grizzly Bears"], "battlefield": ["Bösium Strip", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Bösium Strip" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, { "life": 20 } ] }
 },
 {
  "name": "after the top spell is cast the next instant is on top and can be cast too; both are exiled",
  "players": [
   { "graveyard": ["Shock", "Lightning Bolt"], "battlefield": ["Bösium Strip", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Bösium Strip" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "cast": "Shock", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "exile": ["Lightning Bolt", "Shock"], "graveyard": [] }, { "life": 15 } ] }
 },
 {
  "name": "without activating the Strip nothing can be cast from the graveyard",
  "players": [
   { "graveyard": ["Lightning Bolt"], "battlefield": ["Bösium Strip", "Mountain"] },
   {}
  ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 20 } ] }
 }
]
