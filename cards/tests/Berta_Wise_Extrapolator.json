[
  { "name": "increment: spending more mana than its toughness-or-power adds a counter",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Berta, Wise Extrapolator", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true, "answers": [3] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Berta, Wise Extrapolator", "Grizzly Bears"] }, {} ],
                "counters": { "Berta, Wise Extrapolator": { "p1p1": 1 } }, "pt": { "Berta, Wise Extrapolator": [2, 5] } } },
  { "name": "increment: a spell that spends no more mana than its power or toughness does not trigger",
    "players": [ { "hand": ["Llanowar Elves"], "battlefield": ["Berta, Wise Extrapolator", "Forest"] }, {} ],
    "steps": [ { "cast": "Llanowar Elves" }, { "resolve": true } ],
    "expect": { "counters": { "Berta, Wise Extrapolator": { "p1p1": 0 } }, "pt": { "Berta, Wise Extrapolator": [1, 4] } } },
  { "name": "a counter put on Berta adds one mana of any colour",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Berta, Wise Extrapolator", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true, "answers": [3] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ], "counters": { "Berta, Wise Extrapolator": { "p1p1": 1 } } } },
  { "name": "{X},{T}: a 0/0 Fractal with X +1/+1 counters",
    "players": [ { "battlefield": ["Berta, Wise Extrapolator", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Berta, Wise Extrapolator", "answers": [2] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Berta, Wise Extrapolator", "Fractal 0-0 Green Blue"] }, {} ],
                "counters": { "Fractal 0-0 Green Blue": { "p1p1": 2 } }, "pt": { "Fractal 0-0 Green Blue": [2, 2] }, "tapped": { "Berta, Wise Extrapolator": true } } },
  { "name": "ruling: the X ability uses the stack (it is not a mana ability): no Fractal until it resolves",
    "players": [ { "battlefield": ["Berta, Wise Extrapolator", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Berta, Wise Extrapolator", "answers": [2] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Fractal 0-0 Green Blue"] }, {} ], "stack_empty": false, "tapped": { "Berta, Wise Extrapolator": true } } },
  { "name": "ruling: increment still resolves and adds its counter when the spell it triggered on fizzles",
    "players": [ { "hand": ["Fireball"], "battlefield": ["Berta, Wise Extrapolator", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Fireball", "targets": ["Grizzly Bears"], "answers": [1] }, { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [3] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Fireball"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ], "counters": { "Berta, Wise Extrapolator": { "p1p1": 1 } } } }
]
