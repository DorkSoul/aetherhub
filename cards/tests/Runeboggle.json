[
  {
    "name": "counters an unpaid spell and draws a card even so",
    "players": [
      { "hand": ["Runeboggle"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Runeboggle" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Runeboggle"], "hand_count": 1 },
        { "graveyard": ["Lightning Bolt"], "life": 20 }
      ]
    }
  },
  {
    "name": "controller pays {1} and the spell resolves; Runeboggle still draws",
    "players": [
      { "hand": ["Runeboggle"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Runeboggle" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Runeboggle"], "hand_count": 1, "life": 17 },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: Runeboggle draws a card even when the opponent pays {1}",
    "players": [
      { "hand": ["Runeboggle"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Runeboggle" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Runeboggle"], "hand": ["Grizzly Bears"], "life": 17 },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
