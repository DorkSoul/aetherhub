[
  {
    "name": "ruling: the cost reduction only removes generic mana, so Divination's {U} still needs a blue source",
    "players": [
      { "battlefield": ["Bilbo, Thief in the Night", "Forest", "Forest"], "graveyard": ["Divination"], "library": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Bilbo, Thief in the Night", "at": "p1" } ] },
      { "resolve": true, "answers": ["Divination", true] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [
      { "graveyard": ["Divination"], "hand_count": 0 },
      { "life": 18 }
    ] }
  },
  {
    "name": "attacking: cast Divination from the graveyard for {1}{U} (one less), then it is exiled",
    "players": [
      { "battlefield": ["Bilbo, Thief in the Night", "Island", "Island"], "graveyard": ["Divination"], "library": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Bilbo, Thief in the Night", "at": "p1" } ] },
      { "resolve": true, "answers": ["Divination", true] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [
      { "exile": ["Divination"], "hand_count": 2, "graveyard": [] },
      { "life": 18 }
    ] }
  },
  {
    "name": "an artifact card in the graveyard is cast and stays on the battlefield (not exiled)",
    "players": [
      { "battlefield": ["Bilbo, Thief in the Night", "Island"], "graveyard": ["Mind Stone"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Bilbo, Thief in the Night", "at": "p1" } ] },
      { "resolve": true, "answers": ["Mind Stone", true] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [
      { "battlefield_has": ["Mind Stone"], "graveyard": [] },
      { "life": 18 }
    ] }
  },
  {
    "name": "declining the cast leaves the card in the graveyard",
    "players": [
      { "battlefield": ["Bilbo, Thief in the Night", "Island", "Island"], "graveyard": ["Divination"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Bilbo, Thief in the Night", "at": "p1" } ] },
      { "resolve": true, "answers": ["Divination", false] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [
      { "graveyard": ["Divination"], "hand_count": 0 },
      { "life": 18 }
    ] }
  },
  {
    "name": "an instant cast from the graveyard through the attack is exiled; a creature card is not offered",
    "players": [
      { "battlefield": ["Bilbo, Thief in the Night", "Mountain"], "graveyard": ["Shock", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Bilbo, Thief in the Night", "at": "p1" } ] },
      { "resolve": true, "answers": ["Shock", true, "p1"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [
      { "exile": ["Shock"], "graveyard": ["Grizzly Bears"] },
      { "life": 16 }
    ] }
  }
]
