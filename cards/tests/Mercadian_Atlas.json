[
  {
    "name": "no land played this turn: may draw a card at the end step",
    "players": [
      { "battlefield": ["Mercadian Atlas"] },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "declining the optional draw leaves the hand alone",
    "players": [
      { "battlefield": ["Mercadian Atlas"] },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "a land was played this turn: no trigger at the end step",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Mercadian Atlas"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "battlefield_has": ["Forest"] }, {} ]
    }
  },
  {
    "name": "ruling: a land put onto the battlefield by Rampant Growth is not a land played: the Atlas still draws",
    "players": [
      { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Forest", "Mercadian Atlas"], "library": ["Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Rampant Growth" },
      { "resolve": true, "answers": ["Mountain"] },
      { "advance_to": "End", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Mountain"] }, {} ]
    }
  }
