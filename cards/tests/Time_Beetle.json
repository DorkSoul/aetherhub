[
  {
    "name": "combat damage to a player lets its controller time travel",
    "players": [
      { "battlefield": [{ "name": "Time Beetle", "sick": false }, { "name": "Rotating Fireplace", "counters": { "Time": 1 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Time Beetle", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2", "answers": [0] }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19 }
      ],
      "counters": { "Rotating Fireplace": { "Time": 2 } }
    }
  },
  {
    "name": "skulk: a creature with greater power can't block it",
    "players": [
      { "battlefield": [{ "name": "Time Beetle", "sick": false }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Time Beetle", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Time Beetle" } ], "illegal": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19 }
      ]
    }
  },
  {
    "name": "ruling: time travel can remove a time counter from a permanent that has one",
    "players": [
      { "battlefield": [{ "name": "Time Beetle", "sick": false }, { "name": "Rotating Fireplace", "counters": { "Time": 1 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Time Beetle", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2", "answers": [1] }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19 }
      ],
      "counters": { "Rotating Fireplace": { "Time": 0 } }
    }
  }
]
