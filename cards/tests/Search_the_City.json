[
  {
    "name": "enters: exile the top five cards of your library",
    "players": [
      { "hand": ["Search the City"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Lightning Bolt", "Forest", "Grizzly Bears", "Swamp", "Plains", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Search the City" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Lightning Bolt", "Forest", "Grizzly Bears", "Swamp", "Plains"], "battlefield_has": ["Search the City"] },
        {}
      ]
    }
  },
  {
    "name": "casting a spell with the name of an exiled card lets you put that card into your hand",
    "players": [
      { "hand": ["Search the City", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Mountain"], "library": ["Lightning Bolt", "Forest", "Grizzly Bears", "Swamp", "Plains", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Search the City" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Lightning Bolt"], "graveyard": ["Lightning Bolt"], "exile": ["Forest", "Grizzly Bears", "Swamp", "Plains"], "battlefield_has": ["Search the City"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "casting a spell whose name is not among the exiled cards moves nothing",
    "players": [
      { "hand": ["Search the City", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Mountain"], "library": ["Forest", "Grizzly Bears", "Swamp", "Plains", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Search the City" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Forest", "Grizzly Bears", "Swamp", "Plains", "Mountain"], "battlefield_has": ["Search the City"], "graveyard": ["Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "playing a land with the name of an exiled card puts that card into your hand",
    "players": [
      { "hand": ["Search the City", "Forest"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Mountain", "Swamp", "Plains", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Search the City" },
      { "resolve": true },
      { "play_land": "Forest" },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "exile": ["Island", "Mountain", "Plains", "Swamp"], "battlefield_has": ["Search the City"] }, {} ]
    }
  },
  {
    "name": "playing a land whose name is not exiled moves nothing",
    "players": [
      { "hand": ["Search the City", "Forest"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Search the City" },
      { "resolve": true },
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": [], "exile": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "battlefield_has": ["Search the City"] }, {} ]
    }
  },
  {
    "name": "ruling: only one card is put into hand per card played, even when several exiled cards share its name",
    "players": [
      { "hand": ["Search the City", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Mountain"], "library": ["Lightning Bolt", "Forest", "Lightning Bolt", "Swamp", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Search the City" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Lightning Bolt", "Lightning Bolt"], "graveyard": ["Lightning Bolt"], "exile": ["Lightning Bolt", "Forest", "Swamp", "Plains"], "battlefield_has": ["Search the City"] },
        { "life": 17 }
      ]
    }
  }
]
