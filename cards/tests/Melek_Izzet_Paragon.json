 {
  "name": "ruling: a sorcery cast from the top of the library is still sorcery-speed (illegal in combat, legal in main phase 2)",
  "players": [
   { "battlefield": ["Melek, Izzet Paragon", "Island", "Island", "Island"], "library": ["Divination", "Island"] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "cast": "Divination", "illegal": true },
   { "advance_to": "Main2" },
   { "cast": "Divination" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Divination"], "hand_count": 4 }, {} ] }
 },
 {
  "name": "ruling: a spell with no targets cast from the library is still copied (two Divinations draw four)",
  "players": [
   { "battlefield": ["Melek, Izzet Paragon", "Island", "Island", "Island"], "library": ["Divination", "Island"] },
   {}
  ],
  "steps": [ { "cast": "Divination" }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard_has": ["Divination"], "hand_count": 4 }, {} ] }
 },
 {
  "name": "ruling: the copy of an X spell from the library has the same X (Fireball X=2 deals 2 twice)",
  "players": [
   { "battlefield": ["Melek, Izzet Paragon", "Mountain", "Mountain", "Mountain"], "library": ["Fireball", "Island"] },
   {}
  ],
  "steps": [ { "cast": "Fireball", "targets": ["p1"], "answers": [2] }, { "resolve": true, "auto": true } ],
  "expect": { "players": [ {}, { "life": 16 } ] }
 }
]