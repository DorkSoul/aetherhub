   {
    "battlefield": [
     "Melek, Izzet Paragon",
     "Mountain"
    ],
    "library": [
     "Lightning Bolt",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true,
    "answers": [
     "Hill Giant"
    ]
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 17,
     "graveyard_has": [
      "Hill Giant"
     ]
    }
   ]
  }
 },
 {
