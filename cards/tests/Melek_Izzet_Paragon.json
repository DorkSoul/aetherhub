[
 {
  "name": "cast an instant from the top of the library: it is copied",
  "players": [
   {
    "battlefield": [
     "Melek, Izzet Paragon",
     "Mountain"
    ],
    "library": [
     "Lightning Bolt",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true,
    "auto": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard_has": [
      "Lightning Bolt"
     ]
    },
    {
     "life": 14
    }
