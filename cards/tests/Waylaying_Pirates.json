[
  {
    "name": "ETB with an artifact on board taps and stuns an opposing creature",
    "players": [
      { "hand": ["Waylaying Pirates"], "battlefield": ["Island", "Island", "Island", "Island", "Sol Ring"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Waylaying Pirates" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 1 } }
    }
  },
  {
    "name": "without an artifact the ETB does nothing",
    "players": [
      { "hand": ["Waylaying Pirates"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Waylaying Pirates" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false },
      "counters": { "Grizzly Bears": { "stun": 0 } }
    }
  },
  {
    "name": "ruling: an already tapped creature can be targeted and still gets the stun counter",
    "players": [
      { "hand": ["Waylaying Pirates"], "battlefield": ["Island", "Island", "Island", "Island", "Sol Ring"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Waylaying Pirates" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 1 } }
    }
  }
]
