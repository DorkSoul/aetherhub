[
  {
    "name": "ETB: -1/-1 counter on target creature you control",
    "players": [
      { "hand": ["Ornery Kudu"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Ornery Kudu" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [1, 1], "Ornery Kudu": [3, 4] } }
  },
  {
    "name": "ETB: may target itself",
    "players": [
      { "hand": ["Ornery Kudu"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Ornery Kudu" },
      { "resolve": true, "targets": ["Ornery Kudu"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Ornery Kudu": [2, 3], "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "ETB: an opponent's creature is not a legal target",
    "players": [
      { "hand": ["Ornery Kudu"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ornery Kudu" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Ornery Kudu": [2, 3], "Grizzly Bears": [2, 2] } }
  }
]
