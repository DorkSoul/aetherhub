      { "advance_to": "Main1" },
      { "attack": [ { "card": "Alley Strangler", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Latchkey Faerie", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Latchkey Faerie", "Alley Strangler"], "hand_count": 2 },
        { "life": 18 }
      ]
    }
