[
  {
    "name": "prowl cost after a Rogue dealt combat damage to a player: the ETB draws a card",
    "players": [
      {
        "hand": ["Latchkey Faerie"],
        "battlefield": ["Island", "Island", "Island", "Alley Strangler"]
      },
      {}
    ],
