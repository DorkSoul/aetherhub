        { "battlefield_has": ["Latchkey Faerie"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "prowl is illegal when only a non-Faerie non-Rogue dealt combat damage",
    "players": [
      {
        "hand": ["Latchkey Faerie"],
        "battlefield": ["Island", "Island", "Island", "Brotherhood Ambushers"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Brotherhood Ambushers", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Latchkey Faerie", "alt": 0, "illegal": true }
    ],
    "expect": {
