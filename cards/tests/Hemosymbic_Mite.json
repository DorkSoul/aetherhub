    "steps": [ { "attack": [ { "card": "Hemosymbic Mite", "at": "p1" } ] } ],
    "expect": { "pt": { "Hemosymbic Mite": [1, 1] } } },
  { "name": "ruling: X is fixed as the trigger resolves; a later pump of the Mite does not change the Bears' bonus",
