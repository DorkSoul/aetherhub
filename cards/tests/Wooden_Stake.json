[
  {
    "name": "equipped creature blocked by a Vampire: the Vampire is destroyed (can't be regenerated)",
    "players": [
      {
        "battlefield": [
          "Wooden Stake",
          { "name": "Grizzly Bears", "sick": false },
          "Plains"
        ]
      },
      {
        "battlefield": [
          { "name": "Arrogant Vampire", "sick": false }
        ]
      }
    ],
    "steps": [
