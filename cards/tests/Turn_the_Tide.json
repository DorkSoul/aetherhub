[
  {
    "name": "opponent creatures get -2/-0 until end of turn; my creatures unaffected",
    "players": [
      { "hand": ["Turn the Tide"], "battlefield": ["Island", "Island", "Savannah Lions"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Turn the Tide" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [0, 2], "Savannah Lions": [2, 1] },
      "players": [ { "graveyard": ["Turn the Tide"] }, {} ]
    }
  },
  {
    "name": "needs {1}{U}",
    "players": [
      { "hand": ["Turn the Tide"], "battlefield": ["Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Turn the Tide", "illegal": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: a creature that enters later in the turn is not affected",
    "players": [
      { "hand": ["Turn the Tide"], "battlefield": ["Island", "Island"] },
      { "hand": ["Spectral Sailor"], "battlefield": ["Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Turn the Tide" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Spectral Sailor", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [0, 2], "Spectral Sailor": [1, 1] }
    }
  }
]
