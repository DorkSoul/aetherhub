[
  {
    "name": "ruling: the controller may put a land onto the battlefield on the opponent's turn, outside a land drop",
    "players": [
      { "hand": ["Pendant of Prosperity", "Forest"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Plains", "Island"], "library": ["Island", "Island"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [ { "cast": "Pendant of Prosperity" }, { "resolve": true }, { "pass": true }, { "activate": "Pendant of Prosperity", "player": 1 }, { "resolve": true, "answers": [[0], [0]] } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, { "battlefield_has": ["Plains", "Pendant of Prosperity"] } ] }
  },
  {
    "name": "enters under the opponent's control",
    "players": [ { "hand": ["Pendant of Prosperity"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Pendant of Prosperity" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Pendant of Prosperity"] } ] }
  },
  {
    "name": "controller and owner each draw and may put a land onto the battlefield",
    "players": [
      { "hand": ["Pendant of Prosperity", "Forest"], "library": ["Swamp", "Swamp"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "library": ["Island", "Island"], "hand": ["Plains"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Pendant of Prosperity" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "activate": "Pendant of Prosperity", "player": 1 },
      { "resolve": true, "answers": [[0], [0]] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, { "battlefield_has": ["Plains", "Pendant of Prosperity"] } ] }
  }
]
