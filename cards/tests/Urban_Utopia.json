[
  {
    "name": "enters attached to a land and draws a card",
    "players": [
      { "hand": ["Urban Utopia"], "battlefield": ["Forest", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Urban Utopia", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Island"] }, {}],
      "attached": { "Urban Utopia": "Forest" }
    }
  },
  {
    "name": "enchanted land taps for any color",
    "players": [
      { "hand": ["Urban Utopia", "Pacifism"], "battlefield": ["Plains", "Forest", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Urban Utopia", "targets": ["Plains"] },
      { "resolve": true },
      { "tap_for_mana": "Plains", "color": "U" }
    ],
    "expect": {
      "tapped": { "Plains": true }
    }
  },
  {
    "name": "enchanted Forest taps for U: pays for a blue spell",
    "players": [
      { "hand": ["Urban Utopia", "Opt"], "battlefield": ["Forest", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Urban Utopia", "targets": ["Plains"] },
      { "resolve": true },
      { "cast": "Opt" },
      { "resolve": true, "auto": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Opt"] }, {} ] }
  },
  {
    "name": "ruling: the enchanted land keeps its Forest land type",
    "players": [
      { "hand": ["Urban Utopia"], "battlefield": ["Forest", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Urban Utopia", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Island"] }, {}],
      "attached": { "Urban Utopia": "Forest" },
      "subtypes": { "Forest": ["Forest"] }
    }
  }
]
