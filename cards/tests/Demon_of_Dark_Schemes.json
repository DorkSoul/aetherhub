[
  { "name": "ETB: all other creatures get -2/-2 until end of turn",
    "players": [
      { "hand": ["Demon of Dark Schemes"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [ { "cast": "Demon of Dark Schemes" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Demon of Dark Schemes"] }, { "battlefield_lacks": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ], "pt": { "Hill Giant": [1, 1] } } },
  { "name": "each other creature death gives energy; paying EEEE returns a creature card",
    "players": [
      { "battlefield": ["Demon of Dark Schemes", "Swamp", "Swamp", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      { "battlefield": ["Grizzly Bears", "Typhoid Rats", "Llanowar Elves", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Typhoid Rats"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true },
      { "activate": "Demon of Dark Schemes", "targets": ["Grizzly Bears"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Demon of Dark Schemes", "Grizzly Bears"], "energy": 0 }, {} ] } },
  { "name": "with only three energy the ability cannot be activated",
    "players": [
      { "battlefield": ["Demon of Dark Schemes", "Swamp", "Swamp", "Swamp", "Mountain", "Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      { "battlefield": ["Grizzly Bears", "Typhoid Rats", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Typhoid Rats"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] }, { "resolve": true },
      { "activate": "Demon of Dark Schemes", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "players": [ { "energy": 3, "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a creature entering after the -2/-2 resolves does not get it",
    "players": [
      { "hand": ["Demon of Dark Schemes", "Grizzly Bears"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "cast": "Demon of Dark Schemes" }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Demon of Dark Schemes", "Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] } ], "pt": { "Hill Giant": [1, 1], "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: creatures killed by the -2/-2 trigger each give energy",
    "players": [
      { "hand": ["Demon of Dark Schemes"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Llanowar Elves", "Typhoid Rats", "Hill Giant"] }
    ],
    "steps": [ { "cast": "Demon of Dark Schemes" }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 2, "battlefield_has": ["Demon of Dark Schemes"] }, { "battlefield_lacks": ["Llanowar Elves", "Typhoid Rats"], "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: energy stays with the player through steps and turns",
    "players": [
      { "battlefield": ["Demon of Dark Schemes", "Mountain", "Mountain", "Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      { "battlefield": ["Grizzly Bears", "Typhoid Rats", "Llanowar Elves", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Typhoid Rats"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": { "players": [ { "energy": 4, "battlefield_has": ["Demon of Dark Schemes"] }, {} ] } },
  { "name": "ruling: energy is a player's counter, not tied to the Demon, so it stays when the Demon leaves",
    "players": [
      { "battlefield": ["Demon of Dark Schemes", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      { "battlefield": ["Grizzly Bears", "Typhoid Rats", "Llanowar Elves", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Typhoid Rats"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Demon of Dark Schemes"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Demon of Dark Schemes"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 4, "battlefield_lacks": ["Demon of Dark Schemes"] }, {} ] } }
]
