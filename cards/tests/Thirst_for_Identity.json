[
  { "name": "draw three, then discard two when no creature card is discarded",
    "players": [ { "hand": ["Thirst for Identity"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Thirst for Identity" }, { "resolve": true, "answers": [["Forest", "Forest"]] } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard": ["Thirst for Identity", "Forest", "Forest"] }, {} ] } },
  { "name": "discarding a creature card instead avoids the second discard",
    "players": [ { "hand": ["Thirst for Identity"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Thirst for Identity" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard": ["Thirst for Identity", "Grizzly Bears"] }, {} ] } }
]
