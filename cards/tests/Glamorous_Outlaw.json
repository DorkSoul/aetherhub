[
 {
  "name": "hard-cast: 2 damage to each opponent and scry 2",
  "players": [
   { "hand": ["Glamorous Outlaw"], "battlefield": ["Island", "Swamp", "Mountain", "Forest", "Plains", "Snow-Covered Island"] },
   {}
  ],
  "steps": [ { "cast": "Glamorous Outlaw" }, { "resolve": true, "auto": true } ],
  "expect": { "players": [ { "battlefield_has": ["Glamorous Outlaw"] }, { "life": 18 } ] }
 },
 {
  "name": "exile it from hand: the target land taps for U, B or R",
  "players": [
   { "hand": ["Glamorous Outlaw"], "battlefield": [ { "name": "Plains", "tapped": false }, "Snow-Covered Plains", "Forest"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Plains" },
   { "tap_for_mana": "Snow-Covered Plains" },
   { "activate": "Glamorous Outlaw", "targets": ["Forest"] },
   { "resolve": true },
   { "tap_for_mana": "Forest", "color": "R" }
  ],
  "expect": { "players": [ { "exile": ["Glamorous Outlaw"], "hand_count": 0, "pool": { "R": 1 } }, {} ] }
 },
 {
  "name": "cast from exile later: it enters, the opponent takes 2 and the land loses the ability",
  "players": [
   { "hand": ["Glamorous Outlaw"], "battlefield": ["Plains", "Snow-Covered Plains", "Mountain", "Snow-Covered Mountain", "Forest", "Island", "Swamp", "Snow-Covered Forest", "Snow-Covered Swamp", "Snow-Covered Island"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Plains" },
   { "tap_for_mana": "Snow-Covered Plains" },
   { "activate": "Glamorous Outlaw", "targets": ["Forest"] },
   { "resolve": true },
   { "cast": "Glamorous Outlaw" },
   { "resolve": true, "auto": true },
   { "tap_for_mana": "Forest" }
  ],
  "expect": { "players": [ { "battlefield_has": ["Glamorous Outlaw"], "pool": { "G": 1 } }, { "life": 18 } ] }
 },
 {
  "name": "the activation only works from your hand",
  "players": [ { "battlefield": ["Glamorous Outlaw", "Mountain", "Snow-Covered Mountain", "Forest"] }, {} ],
  "steps": [ { "activate": "Glamorous Outlaw", "targets": ["Forest"], "illegal": true } ]
 },
 {
  "name": "ruling: the granted mana ability of the land can pay for casting Outlaw from exile",
  "players": [
   { "hand": ["Glamorous Outlaw"], "battlefield": ["Plains", "Snow-Covered Plains", "Forest", "Mountain", "Island", "Swamp", "Snow-Covered Mountain", "Snow-Covered Island"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Plains" },
