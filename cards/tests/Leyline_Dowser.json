[
  {
    "name": "mills an instant and puts it into hand",
    "players": [
      { "battlefield": ["Leyline Dowser", "Swamp"], "library": ["Lightning Bolt", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Leyline Dowser", "ability": 0 },
      { "resolve": true, "answers": [[0]] }
    ],
    "expect": {
      "players": [
        { "hand": ["Lightning Bolt"], "graveyard": [], "library_count": 1 },
        {}
      ],
      "tapped": { "Leyline Dowser": true }
    }
  },
  {
    "name": "milled creature card cannot be put into hand",
    "players": [
      { "battlefield": ["Leyline Dowser", "Swamp"], "library": ["Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Leyline Dowser", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Grizzly Bears"], "library_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "tapping an untapped legendary creature untaps it",
    "players": [
      { "battlefield": ["Leyline Dowser", "Swamp", "Isamaru, Hound of Konda"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Leyline Dowser", "ability": 0 },
      { "resolve": true },
      { "activate": "Leyline Dowser", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Leyline Dowser": false, "Isamaru, Hound of Konda": true }
    }
  },
  {
    "name": "ruling: a summoning-sick legendary creature can be tapped to pay the untap cost",
    "players": [
      { "battlefield": ["Leyline Dowser", "Island", "Island", { "name": "Goddric, Cloaked Reveler", "sick": true }], "library": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Leyline Dowser", "ability": 0 },
      { "resolve": true },
      { "activate": "Leyline Dowser", "ability": 1 },
      { "resolve": true },
      { "activate": "Leyline Dowser", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Leyline Dowser": true, "Goddric, Cloaked Reveler": true }
    }
  }
]
