    "steps": [
      { "activate": "Simian Sling", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, {} ], "attached": { "Simian Sling": "Grizzly Bears" }, "tapped": { "Simian Sling": true }, "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "ruling: an attached Sling is no longer a creature and loses its Monkey subtype",
    "players": [ { "battlefield": ["Mountain", "Mountain", "Simian Sling", "Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Simian Sling", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, {} ], "attached": { "Simian Sling": "Grizzly Bears" }, "subtypes": { "Simian Sling": ["Equipment"] }, "not_subtypes": { "Simian Sling": ["Monkey"] } } },
  { "name": "ruling: an Equipment creature cannot attach to itself, so the reconfigure does nothing",
    "players": [ { "battlefield": ["Mountain", "Mountain", "Simian Sling", "Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Simian Sling", "ability": 0, "targets": ["Simian Sling"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Simian Sling": [1, 1], "Grizzly Bears": [2, 2] }, "subtypes": { "Simian Sling": ["Monkey"] } } }
