[
  {
    "name": "each player draws two then discards one at random",
    "players": [
      { "hand": ["Noggle Ransacker"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "library": ["Mountain", "Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Noggle Ransacker" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Noggle Ransacker"], "library_count": 3 }, { "hand_count": 1, "library_count": 2 } ]
    }
  },
  {
    "name": "each player with an empty hand still draws and discards",
    "players": [
      { "hand": ["Noggle Ransacker"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Noggle Ransacker" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand_count": 1 } ]
    }
  }
]
