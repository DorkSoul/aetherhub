[
  {
    "name": "attacks after tapping another untapped creature",
    "players": [
      { "battlefield": ["Hollow Warrior", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Hollow Warrior", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }],
      "tapped": { "Grizzly Bears": true, "Hollow Warrior": true }
    }
  },
  {
    "name": "cannot attack when it is the only creature (cannot tap itself)",
    "players": [
      { "battlefield": ["Hollow Warrior"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Hollow Warrior", "at": "p1" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "tapped": { "Hollow Warrior": false }
    }
  },
  {
    "name": "blocks after tapping another untapped creature",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Hollow Warrior", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "resolve": true },
      { "block": [{ "blocker": "Hollow Warrior", "attacker": "Grizzly Bears" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "tapped": { "Hill Giant": true }
    }
  },
  {
    "name": "cannot block when it is the only creature",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Hollow Warrior"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "tapped": { "Hollow Warrior": false }
    }
  },
  {
    "name": "ruling: cannot block by tapping itself when it is the only creature",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Hollow Warrior"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "resolve": true },
      { "block": [{ "blocker": "Hollow Warrior", "attacker": "Grizzly Bears" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "tapped": { "Hollow Warrior": false }
    }
  }
]
