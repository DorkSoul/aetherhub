[
  {
    "name": "-3/-0 and amass Orcs 1 creates an Orc Army",
    "players": [
      {
        "hand": [
          "Deceive the Messenger"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Deceive the Messenger",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Hill Giant": [
          0,
          3
        ]
      },
      "players": [
        {
          "battlefield_has": [
            "Army"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "no creature to target",
    "players": [
      {
        "hand": [
          "Deceive the Messenger"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Deceive the Messenger",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Deceive the Messenger"
          ]
        },
        {}
      ]
    }
  },
 {
  "name": "ruling: if the target is gone on resolution, nothing is amassed",
  "players": [
   { "hand": ["Deceive the Messenger"], "battlefield": ["Island"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"] }
  ],
  "steps": [
   { "cast": "Deceive the Messenger", "targets": ["Hill Giant"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Army"], "graveyard_has": ["Deceive the Messenger"] },
    { "battlefield_lacks": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "ruling: amass with an Army already present adds counters to it, no new token",
  "players": [
   { "hand": ["Deceive the Messenger", "Deceive the Messenger"], "battlefield": ["Island", "Island"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Deceive the Messenger", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "cast": "Deceive the Messenger", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Army": [2, 2] },
   "counters": { "Army": { "p1p1": 2 } },
   "players": [ { "battlefield_has": ["Army"] }, {} ]
  }
 },
 {
  "name": "ruling: amass 1 on a new 0/0 Army makes it a 1/1 Orc Army with one counter",
  "players": [
   { "hand": ["Deceive the Messenger"], "battlefield": ["Island"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Deceive the Messenger", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Army": [1, 1] },
   "counters": { "Army": { "p1p1": 1 } },
   "subtypes": { "Army": ["Orc"] },
   "players": [ { "battlefield_has": ["Army"] }, {} ]
  }
 }
]
