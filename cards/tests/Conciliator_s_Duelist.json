  {
    "name": "repartee exiles the targeted creature until the next end step, then it returns",
    "players": [
      {
        "hand": [
          "Shock"
        ],
        "battlefield": [
          "Conciliator's Duelist",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Shock",
        "targets": [
          "Grizzly Bears",
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Conciliator's Duelist"
          ],
          "graveyard": [
            "Shock"
          ]
