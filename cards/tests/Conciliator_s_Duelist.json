        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: repartee still exiles the creature when the targeting spell is countered",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Conciliator's Duelist", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Grizzly Bears", "Island", "Island"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Shock", "targets": ["Grizzly Bears", "Grizzly Bears"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Shock" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Shock"] },
        { "exile": ["Grizzly Bears"], "graveyard_has": ["Counterspell"] }
      ]
    }
  }
