[
 { "name": "gain control of all the opponent's creatures, untapped, with haste",
   "players": [ { "hand": ["Call for Aid"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                { "battlefield": [{"name":"Hill Giant","tapped":true}, "Serra Angel", "Forest"] } ],
   "steps": [ {"cast": "Call for Aid", "targets": ["p1"]}, {"resolve": true} ],
   "expect": { "players": [ {"battlefield_has": ["Hill Giant", "Serra Angel", "Grizzly Bears"], "graveyard": ["Call for Aid"]}, {"battlefield": ["Forest"]} ],
              "tapped": {"Hill Giant": false},
              "keywords": {"Hill Giant": ["Haste"], "Serra Angel": ["Haste"]} } },
 { "name": "I can't attack that player this turn, with the stolen creatures or my own",
   "players": [ { "hand": ["Call for Aid"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", {"name":"Grizzly Bears","sick":false}] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ {"cast": "Call for Aid", "targets": ["p1"]}, {"resolve": true},
     {"attack": [ {"card":"Hill Giant","at":"p1"} ], "illegal": true},
     {"attack": [ {"card":"Grizzly Bears","at":"p1"} ], "illegal": true} ],
   "expect": { "players": [ {}, {"life": 20} ] } },
 { "name": "control returns at end of turn",
   "players": [ { "hand": ["Call for Aid"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ {"cast": "Call for Aid", "targets": ["p1"]}, {"resolve": true}, {"advance_to": "Upkeep"} ],
   "expect": { "players": [ {"battlefield_lacks": ["Hill Giant"]}, {"battlefield_has": ["Hill Giant"]} ] } },
 { "name": "I can't sacrifice the stolen creatures",
   "players": [ { "hand": ["Call for Aid"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Ashnod's Altar"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ {"cast": "Call for Aid", "targets": ["p1"]}, {"resolve": true},
     {"activate": "Ashnod's Altar", "illegal": true} ],
   "expect": { "players": [ {"battlefield_has": ["Hill Giant", "Ashnod's Altar"]}, {} ] } },
 { "name": "ruling: a sacrifice cost takes one of my other creatures, not the stolen ones",
   "players": [ { "hand": ["Call for Aid"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Dark-Dweller Oracle", "Grizzly Bears"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ {"cast": "Call for Aid", "targets": ["p1"]}, {"resolve": true},
     {"activate": "Dark-Dweller Oracle", "ability": 0, "answers": ["Grizzly Bears"]}, {"resolve": true} ],
   "expect": { "players": [ {"battlefield_has": ["Hill Giant", "Dark-Dweller Oracle"], "graveyard": ["Call for Aid", "Grizzly Bears"]}, {"battlefield_lacks": ["Hill Giant"]} ] } }
]
