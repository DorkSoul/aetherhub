   "steps": [ { "attack": [ { "card": "Liege of the Axe", "at": "p1" } ] }, { "activate": "Liege of the Axe", "ability": 0 }, { "resolve": true }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
   "expect": { "pt": { "Liege of the Axe": [2, 3] }, "tapped": { "Liege of the Axe": false } } },
 { "name": "ruling: a face-down Liege that is never turned face up stays tapped after attacking",
   "players": [ { "battlefield": [ { "name": "Liege of the Axe", "face_down": true }, "Plains", "Plains" ] }, {} ],
   "steps": [ { "attack": [ { "card": "Liege of the Axe", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
