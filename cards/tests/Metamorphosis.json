[
 {
  "name": "sacrificing Hill Giant (mana value 4) makes five mana for a creature spell",
  "players": [
   { "hand": ["Metamorphosis", "Serra Angel"], "battlefield": ["Forest", "Hill Giant"] },
   {}
  ],
  "steps": [
   { "cast": "Metamorphosis" },
   { "resolve": true, "answers": [[0]] },
   { "cast": "Serra Angel" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Serra Angel"], "graveyard": ["Hill Giant", "Metamorphosis"] }, {} ] }
 },
 {
  "name": "the mana can't be spent on a noncreature spell",
  "players": [
   { "hand": ["Metamorphosis", "Lightning Bolt"], "battlefield": ["Forest", "Hill Giant"] },
   {}
  ],
  "steps": [
   { "cast": "Metamorphosis" },
   { "resolve": true, "answers": [[3]] },
   { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true }
  ],
  "expect": { "players": [ { "hand_count": 1 }, { "life": 20 } ] }
 },
 {
  "name": "ruling: exactly one creature is sacrificed, so the other creature stays",
  "players": [
   { "hand": ["Metamorphosis", "Serra Angel"], "battlefield": ["Forest", "Hill Giant", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Metamorphosis", "answers": ["Hill Giant"] },
   { "resolve": true, "answers": [[0]] },
   { "cast": "Serra Angel" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Serra Angel", "Grizzly Bears"], "graveyard_has": ["Hill Giant", "Metamorphosis"] }, {} ] }
 },
 {
  "name": "ruling: with no creature to sacrifice it cannot be cast",
  "players": [ { "hand": ["Metamorphosis"], "battlefield": ["Forest"] }, {} ],
  "steps": [ { "cast": "Metamorphosis", "illegal": true } ],
  "expect": { "players": [ { "hand_count": 1 }, {} ] }
 }
]
