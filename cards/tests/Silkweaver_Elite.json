[
 {
  "name": "revolt: draws when a permanent left the battlefield this turn",
  "players": [
   {
    "hand": [
     "Silkweaver Elite"
    ],
    "battlefield": [
     "Silent Clearing",
     "Plains",
     "Forest",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Silent Clearing",
    "ability": 0
   },
   {
    "resolve": true
   },
   {
    "cast": "Silkweaver Elite"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 2,
     "graveyard": [
      "Silent Clearing"
     ],
     "battlefield_has": [
      "Silkweaver Elite"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "no revolt: no draw",
  "players": [
   {
    "hand": [
     "Silkweaver Elite"
    ],
    "battlefield": [
     "Forest",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Silkweaver Elite"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 0,
     "battlefield_has": [
      "Silkweaver Elite"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: a creature you controlled destroyed by your own Murder satisfies revolt",
  "players": [ { "hand": ["Murder", "Silkweaver Elite"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
  "steps": [ { "cast": "Murder", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Silkweaver Elite" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Murder", "Grizzly Bears"], "battlefield_has": ["Silkweaver Elite"] }, {} ] }
 },
 {
  "name": "ruling: a token that leaves the battlefield satisfies revolt",
  "players": [ { "hand": ["Raise the Alarm", "Lightning Bolt", "Silkweaver Elite"], "battlefield": ["Plains", "Forest", "Forest", "Forest", "Mountain", "Mountain"] }, {} ],
  "steps": [ { "cast": "Raise the Alarm" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Soldier"] }, { "resolve": true }, { "cast": "Silkweaver Elite" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Lightning Bolt"], "battlefield_has": ["Silkweaver Elite"] }, {} ] }
 },
 {
  "name": "ruling: paying energy does not satisfy revolt",
  "players": [ { "hand": ["Silkweaver Elite"], "energy": 2, "battlefield": ["Aether Swooper", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "advance_to": "BeginCombat" }, { "attack": [{ "card": "Aether Swooper", "at": "p1" }] }, { "resolve": true, "answers": [true] }, { "advance_to": "Main2" }, { "cast": "Silkweaver Elite" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 0, "energy": 0, "battlefield_has": ["Silkweaver Elite", "Aether Swooper"] }, {} ] }
 },
 {
  "name": "ruling: revolt is only checked as it enters, so a sacrifice afterwards does not draw",
  "players": [ { "hand": ["Silkweaver Elite"], "battlefield": ["Silent Clearing", "Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Silkweaver Elite" }, { "resolve": true }, { "activate": "Silent Clearing", "ability": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 1, "graveyard": ["Silent Clearing"], "battlefield_has": ["Silkweaver Elite"] }, {} ] }
 },
 {
  "name": "ruling: several permanents leaving still give only one revolt draw",
  "players": [ { "hand": ["Silkweaver Elite", "Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest", "Forest", "Forest", "Silent Clearing", "Grizzly Bears"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Silent Clearing", "ability": 0 }, { "resolve": true }, { "cast": "Silkweaver Elite" }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Lightning Bolt", "Grizzly Bears", "Silent Clearing"], "battlefield_has": ["Silkweaver Elite"] }, {} ] }
 }
]
