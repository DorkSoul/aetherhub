[
  {
    "name": "enters and fights an opposing creature, which dies",
    "players": [
      { "hand": ["Pheres-Band Brawler"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Pheres-Band Brawler" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Pheres-Band Brawler": [4, 4] },
      "players": [ {}, { "graveyard_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "with no opposing creature the up-to-one target is not required",
    "players": [
      { "hand": ["Pheres-Band Brawler"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Pheres-Band Brawler" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Pheres-Band Brawler"] }, {} ] }
  },
  {
    "name": "ruling: target gone when the trigger resolves, so Brawler takes no damage",
    "players": [
      { "hand": ["Pheres-Band Brawler", "Shock", "Shock"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Pheres-Band Brawler" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Shock", "targets": ["Grizzly Bears", "Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "cast": "Shock", "targets": ["Pheres-Band Brawler"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Pheres-Band Brawler"], "graveyard_has": ["Shock"] }, { "graveyard_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: Brawler leaves before its trigger resolves, so the target is neither dealt nor deals damage",
    "players": [
      { "hand": ["Pheres-Band Brawler"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Doom Blade"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Pheres-Band Brawler" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true, "targets": ["Grizzly Bears"] },
      { "cast": "Doom Blade", "player": 1, "targets": ["Pheres-Band Brawler"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Pheres-Band Brawler"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  }
]
