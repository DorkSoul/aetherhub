[
  { "name": "destroys a tapped creature and gains 3 life",
    "players": [ { "hand": ["Radiant Strike"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] } ],
    "steps": [ { "cast": "Radiant Strike", "targets": ["p1:Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 23 }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "an untapped creature is not a legal target",
    "players": [ { "hand": ["Radiant Strike"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Radiant Strike", "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "battlefield": ["Grizzly Bears"] } ] } },
  { "name": "ruling: if the target becomes illegal in response, Radiant Strike does nothing and gains no life",
    "players": [ { "hand": ["Radiant Strike"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Grizzly Bears", "tapped": true }] } ],
    "steps": [
      { "cast": "Radiant Strike", "targets": ["p1:Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p1:Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Radiant Strike"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] } }
]
