[
  {
    "name": "target player mills three",
    "players": [
      { "hand": ["Dream Twist"], "battlefield": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Dream Twist", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dream Twist"] },
        { "library_count": 17 }
      ]
    }
  },
  {
    "name": "flashback mills three from the graveyard and exiles the card",
    "players": [
      { "graveyard": ["Dream Twist"], "battlefield": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Dream Twist", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Dream Twist"] },
        { "library_count": 17 }
      ]
    }
  },
  {
    "name": "flashback needs two mana",
    "players": [
      { "graveyard": ["Dream Twist"], "battlefield": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Dream Twist", "alt": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dream Twist"] },
        { "library_count": 20 }
      ]
    }
  },
  {
    "name": "ruling: a flashback card put into the graveyard this turn can be flashed back right away",
    "players": [ { "hand": ["Dream Twist"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Dream Twist", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Dream Twist", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Dream Twist"], "graveyard": [] }, { "library_count": 14 } ] }
  },
  {
    "name": "ruling: a countered flashback spell is still exiled, not put into the graveyard",
    "players": [ { "graveyard": ["Dream Twist"], "battlefield": ["Island", "Island"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Dream Twist", "alt": 0, "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Dream Twist"], "graveyard": [] }, { "library_count": 20, "graveyard": ["Counterspell"] } ] }
  }
]
