[
 { "name": "+1 exiles the top card face down and makes a 2/2 colorless Spirit",
   "players": [ { "battlefield": ["Ugin, the Ineffable"], "library": ["Island", "Forest"] }, {} ],
   "steps": [
     { "activate": "Ugin, the Ineffable", "ability": 0 },
     { "resolve": true }
   ],
   "expect": {
     "players": [ { "exile": ["Island"], "hand": [], "library_count": 1, "battlefield_has": ["Spirit 2-2 Colorless"] }, {} ],
     "counters": { "Ugin, the Ineffable": { "Loyalty": 5 } }
   } },
 { "name": "when the Spirit leaves the battlefield the exiled card goes to hand",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Ugin, the Ineffable", "Mountain"], "library": ["Island", "Forest"] },
                {} ],
   "steps": [
     { "activate": "Ugin, the Ineffable", "ability": 0 },
     { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Spirit 2-2 Colorless"] },
     { "resolve": true },
     { "resolve": true }
   ],
   "expect": { "players": [ { "exile": [], "hand": ["Island"], "battlefield_lacks": ["Spirit 2-2 Colorless"] }, {} ] } },
 { "name": "the card stays exiled while the Spirit is alive",
   "players": [ { "battlefield": ["Ugin, the Ineffable"], "library": ["Island", "Forest"] }, {} ],
   "steps": [
     { "activate": "Ugin, the Ineffable", "ability": 0 },
     { "resolve": true }
   ],
   "expect": { "players": [ { "hand": [], "exile": ["Island"] }, {} ] } },
 { "name": "-3 destroys a colored permanent",
   "players": [ { "battlefield": ["Ugin, the Ineffable"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [
     { "activate": "Ugin, the Ineffable", "ability": 1, "targets": ["Grizzly Bears"] },
     { "resolve": true }
   ],
   "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "-3 cannot target a colorless permanent",
   "players": [ { "battlefield": ["Ugin, the Ineffable"] }, { "battlefield": ["Sol Ring"] } ],
   "steps": [
     { "activate": "Ugin, the Ineffable", "ability": 1, "targets": ["Sol Ring"], "illegal": true }
   ],
   "expect": { "players": [ {}, { "battlefield_has": ["Sol Ring"] } ] } },
 { "name": "colorless spells cost {2} less",
   "players": [ { "hand": ["Wurmcoil Engine"], "battlefield": ["Ugin, the Ineffable", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [
     { "cast": "Wurmcoil Engine" },
     { "resolve": true }
   ],
   "expect": { "players": [ { "battlefield_has": ["Wurmcoil Engine"] }, {} ] } },
 { "name": "colored spells are not reduced",
   "players": [ { "hand": ["Serra Angel"], "battlefield": ["Ugin, the Ineffable", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [
     { "cast": "Serra Angel", "illegal": true }
   ],
   "expect": { "players": [ { "hand": ["Serra Angel"] }, {} ] } },
 { "name": "ruling: a land is colorless, so -3 cannot destroy it",
   "players": [ { "battlefield": ["Ugin, the Ineffable"] }, { "battlefield": ["Forest"] } ],
   "steps": [ { "activate": "Ugin, the Ineffable", "ability": 1, "illegal": true } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Forest"] } ] } },
 { "name": "ruling: a colorless spell with mana cost {1} costs nothing",
   "players": [ { "hand": ["Sol Ring"], "battlefield": ["Ugin, the Ineffable"] }, {} ],
   "steps": [ { "cast": "Sol Ring" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Sol Ring"], "hand": [] }, {} ] } },
 { "name": "ruling: the exiled card still goes to hand after Ugin has left the battlefield",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Ugin, the Ineffable", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Forest"] }, {} ],
   "steps": [
     { "activate": "Ugin, the Ineffable", "ability": 0 },
     { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Ugin, the Ineffable"] },
     { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Ugin, the Ineffable"] },
     { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Spirit 2-2 Colorless"] },
     { "resolve": true },
     { "resolve": true }
   ],
   "expect": { "players": [ { "hand": ["Island"], "exile": [], "graveyard_has": ["Ugin, the Ineffable"], "battlefield_lacks": ["Spirit 2-2 Colorless"] }, {} ] } },
 { "name": "ruling: with Doubling Season two Spirits exile only one card, returned when the first leaves",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Ugin, the Ineffable", "Doubling Season", "Mountain"], "library": ["Island", "Forest"] }, {} ],
   "steps": [
     { "activate": "Ugin, the Ineffable", "ability": 0 },
     { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Spirit 2-2 Colorless"] },
     { "resolve": true },
     { "resolve": true }
   ],
   "expect": { "players": [ { "hand": ["Island"], "exile": [], "battlefield": ["Ugin, the Ineffable", "Doubling Season", "Mountain", "Spirit 2-2 Colorless"] }, {} ] } }
