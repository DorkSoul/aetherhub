[
  { "name": "draw and lose life equal to creature cards in target opponent's graveyard",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Corpse Augur", "Mountain"], "graveyard": ["Grizzly Bears"] },
      { "graveyard": ["Grizzly Bears", "Llanowar Elves", "Lightning Bolt"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Corpse Augur"] },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": { "players": [ { "hand_count": 2, "life": 18, "graveyard_has": ["Corpse Augur"] }, {} ] } },
  { "name": "targeting yourself counts the Augur itself in your graveyard",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Corpse Augur", "Mountain"], "graveyard": ["Grizzly Bears"] },
      { "graveyard": ["Grizzly Bears", "Llanowar Elves", "Lightning Bolt"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Corpse Augur"] },
      { "resolve": true, "targets": ["p0"] }
    ],
    "expect": { "players": [ { "hand_count": 2, "life": 18 }, {} ] } },
  { "name": "empty graveyard: nothing drawn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Corpse Augur", "Mountain"] },
      { "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Corpse Augur"] },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": { "players": [ { "hand_count": 0, "life": 20 }, {} ] } },
  { "name": "ruling: X is counted on resolution (a creature dying in response to the trigger is counted)",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Corpse Augur", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"], "graveyard": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Corpse Augur"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["p1", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 2, "life": 18 }, { "graveyard_has": ["Grizzly Bears", "Llanowar Elves"] } ] } }
]
