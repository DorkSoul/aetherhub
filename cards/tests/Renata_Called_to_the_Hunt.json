[
  {
    "name": "power is devotion to green (own GG counts)",
    "players": [
      { "hand": ["Renata, Called to the Hunt"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Renata, Called to the Hunt" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Renata, Called to the Hunt": [2, 3] }
    }
  },
  {
    "name": "other creature you control enters with a +1/+1 counter; devotion grows with its G",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Renata, Called to the Hunt", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3], "Renata, Called to the Hunt": [3, 3] }
    }
  },
  {
    "name": "opponent's creature gets no counter and does not add to your devotion",
    "players": [
      { "battlefield": ["Renata, Called to the Hunt", "Forest"] },
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "player": 1, "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2], "Renata, Called to the Hunt": [2, 3] }
    }
  },
  {
    "name": "ruling: a {G} symbol in an artifact's text box does not count toward devotion",
    "players": [ { "battlefield": ["Renata, Called to the Hunt", "Moss Diamond"] }, {} ],
    "steps": [],
    "expect": { "pt": { "Renata, Called to the Hunt": [2, 3] } }
  },
  {
    "name": "ruling: devotion-based mana ability counts its own {G} and Renata's GG at resolution",
    "players": [ { "battlefield": ["Renata, Called to the Hunt", "Karametra's Acolyte"] }, {} ],
    "steps": [ { "tap_for_mana": "Karametra's Acolyte" } ],
    "expect": { "players": [ { "pool": { "G": 3 } }, {} ] }
  },
  {
    "name": "ruling: an Aura you control on an opponent's creature counts toward your devotion",
    "players": [ { "hand": ["Rancor"], "battlefield": ["Renata, Called to the Hunt", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Rancor", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Renata, Called to the Hunt": [3, 3] }, "attached": { "Rancor": "Grizzly Bears" } }
  },
  {
    "name": "ruling: monocolored hybrid {G/W} counts toward devotion to green",
    "players": [ { "hand": ["Dryad Militant"], "battlefield": ["Renata, Called to the Hunt", "Forest"] }, {} ],
    "steps": [ { "cast": "Dryad Militant" }, { "resolve": true } ],
    "expect": { "pt": { "Renata, Called to the Hunt": [3, 3] } }
  },
  {
    "name": "ruling: Phyrexian {G/P} counts toward devotion to green",
    "players": [ { "battlefield": ["Renata, Called to the Hunt", "Birthing Pod"] }, {} ],
    "steps": [],
    "expect": { "pt": { "Renata, Called to the Hunt": [3, 3] } }
  },
  {
    "name": "ruling: colorless and generic symbols do not count toward devotion",
    "players": [ { "battlefield": ["Renata, Called to the Hunt", "Chief of the Foundry", "Sol Ring"] }, {} ],
    "steps": [],
    "expect": { "pt": { "Renata, Called to the Hunt": [2, 3] } }
  }
]
