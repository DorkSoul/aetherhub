[
  {
    "name": "opponent sacrifices their flying creature",
    "players": [
      { "hand": ["Clip Wings"], "battlefield": ["Forest", "Forest"] },
      { "battlefield": ["Serra Angel", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Clip Wings" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Clip Wings"] },
        { "graveyard": ["Serra Angel"], "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "no opposing flyer: spell resolves and nothing is sacrificed",
    "players": [
      { "hand": ["Clip Wings"], "battlefield": ["Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Clip Wings" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Clip Wings"] },
        { "battlefield_has": ["Grizzly Bears"], "graveyard": [] }
      ]
    }
  },
  {
    "name": "ruling: the caster's own flyers are not sacrificed",
    "players": [
      { "hand": ["Clip Wings"], "battlefield": ["Forest", "Forest", "Serra Angel"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Clip Wings" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Serra Angel"], "graveyard": ["Clip Wings"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
