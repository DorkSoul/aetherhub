[
  {
    "name": "sacrifices itself and another green creature to tutor a green creature",
    "players": [
      {
        "battlefield": [
          "Magus of the Order",
          "Grizzly Bears",
          "Forest"
        ],
        "library": [
          "Llanowar Elves"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Magus of the Order"
      },
      {
        "resolve": true,
        "answers": [
          "Llanowar Elves"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Magus of the Order",
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Llanowar Elves"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "needs another green creature to sacrifice",
    "players": [
      {
        "battlefield": [
          "Magus of the Order",
          "Forest",
          "Forest"
        ],
        "library": [
          "Llanowar Elves"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Magus of the Order",
        "illegal": true
      }
    ]
  },
  {
    "name": "ruling: the sacrifices are paid on activation, before the ability resolves (the Magus and the Bears are already in the graveyard with the search still on the stack)",
    "players": [
      { "battlefield": ["Magus of the Order", "Grizzly Bears", "Forest"], "library": ["Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "activate": "Magus of the Order" }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ { "graveyard": ["Magus of the Order", "Grizzly Bears"], "battlefield_lacks": ["Magus of the Order", "Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: only one other green creature is sacrificed, even with two available",
    "players": [
      { "battlefield": ["Magus of the Order", "Grizzly Bears", "Llanowar Elves", "Forest"], "library": ["Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "activate": "Magus of the Order", "answers": [[0]] },
      { "resolve": true, "answers": ["Llanowar Elves"] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Magus of the Order", "Grizzly Bears"], "battlefield_has": ["Llanowar Elves"] }, {} ]
    }
  },
  {
    "name": "ruling: a Magus that has become nongreen (Deathlace) can still be activated by sacrificing it and a green creature",
    "players": [
      { "battlefield": ["Magus of the Order", "Grizzly Bears", "Forest"], "library": ["Llanowar Elves"] },
      { "hand": ["Deathlace"], "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Deathlace", "player": 1, "targets": ["Magus of the Order"] },
      { "resolve": true },
      { "activate": "Magus of the Order" },
      { "resolve": true, "answers": ["Llanowar Elves"] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Magus of the Order", "Grizzly Bears"], "battlefield_has": ["Llanowar Elves"] }, { "graveyard": ["Deathlace"] } ]
    }
  }
]
