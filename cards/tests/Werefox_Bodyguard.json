[
  {
    "name": "exiles up to one target non-Fox creature until it leaves",
    "players": [
      { "hand": ["Werefox Bodyguard"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Werefox Bodyguard" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Werefox Bodyguard"] },
        { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "sacrificing it returns the exiled creature and gains 2 life",
    "players": [
      { "hand": ["Werefox Bodyguard"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Werefox Bodyguard" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Werefox Bodyguard" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "graveyard_has": ["Werefox Bodyguard"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "with no target chosen nothing is exiled",
    "players": [
      { "hand": ["Werefox Bodyguard"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Werefox Bodyguard" },
      { "resolve": true, "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Werefox Bodyguard"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: if Werefox leaves before its trigger resolves, the creature is not exiled",
    "players": [
      { "hand": ["Werefox Bodyguard"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Werefox Bodyguard" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "activate": "Werefox Bodyguard" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "graveyard_has": ["Werefox Bodyguard"] },
        { "battlefield_has": ["Grizzly Bears"], "exile": [] }
      ]
    }
  },
  {
    "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard",
    "players": [
      { "hand": ["Pacifism", "Werefox Bodyguard"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Pacifism", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Werefox Bodyguard" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Pacifism"], "battlefield_has": ["Werefox Bodyguard"] },
        { "exile": ["Grizzly Bears"] }
      ]
    }
  }
]
