[
 {
  "name": "upkeep: unpaid, it's sacrificed",
  "players": [
   { "battlefield": ["Peacekeeper"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep", "answers": [false] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "graveyard_has": ["Peacekeeper"] }, {}]
  }
 },
 {
  "name": "upkeep: pay {1}{W} to keep it",
  "players": [
   { "battlefield": ["Peacekeeper", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep", "answers": [true] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Peacekeeper"] }, {}]
  }
 },
 {
  "name": "creatures can't attack",
  "players": [
   { "battlefield": ["Grizzly Bears", "Peacekeeper"] },
   {}
  ],
  "steps": [
   { "attack": [{ "card": "Grizzly Bears", "at": "p1" }], "illegal": true }
  ],
  "expect": {
   "players": [{}, { "life": 20 }]
  }
 },
 {
  "name": "ruling: unable to pay means it must be sacrificed",
  "players": [
   { "battlefield": ["Peacekeeper", "Plains"] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "graveyard_has": ["Peacekeeper"] }, {}]
  }
 },
 {
  "name": "ruling: if Peacekeeper left before the trigger resolved, the payment can still be made",
  "players": [
   { "battlefield": ["Peacekeeper", "Plains", "Mountain"] },
   { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep", "answers": [true] },
   { "pass": true },
   { "cast": "Doom Blade", "player": 1, "targets": ["Peacekeeper"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "graveyard_has": ["Peacekeeper"] }, { "graveyard_has": ["Doom Blade"] }],
   "tapped": { "Plains": true, "Mountain": true }
  }
 }
]
