[
  {
    "name": "keeps flying and phasing keywords",
    "players": [ { "battlefield": ["Teferi's Imp"] }, {} ],
    "steps": [],
    "expect": { "keywords": { "Teferi's Imp": ["Flying", "Phasing"] } }
  },
  {
    "name": "phasing out makes its controller discard a card",
    "players": [ { "battlefield": ["Teferi's Imp"], "hand": ["Island"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Teferi's Imp"], "graveyard": ["Island"] }, {} ] }
  },
  {
    "name": "phasing in draws a card",
    "players": [ { "battlefield": ["Teferi's Imp"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Teferi's Imp"], "hand_count": 2 }, {} ] }
  },
  {
    "name": "ruling: with no card in hand the phase-out discard does nothing, and phasing in still draws",
    "players": [ { "battlefield": ["Teferi's Imp"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Teferi's Imp"], "graveyard": [], "hand_count": 2 }, {} ] }
  }
]
