[
  { "name": "taps target creature and deals 2 damage to its controller",
    "players": [ { "hand": ["Sonic Assault"], "battlefield": ["Island", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sonic Assault", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Sonic Assault"] }, { "life": 18 } ], "tapped": { "Grizzly Bears": true } } },
  { "name": "jump-start from the graveyard by discarding a card, then exiled",
    "players": [ { "hand": ["Forest"], "graveyard": ["Sonic Assault"], "battlefield": ["Island", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sonic Assault", "player": 0, "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "exile": ["Sonic Assault"] }, { "life": 18 } ] } },
  { "name": "jump-start needs a card to discard",
    "players": [ { "graveyard": ["Sonic Assault"], "battlefield": ["Island", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sonic Assault", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Sonic Assault"] }, { "life": 20 } ] } },
  { "name": "ruling: target dies in response, so Sonic Assault does not resolve and deals no damage",
    "players": [ { "hand": ["Sonic Assault"], "battlefield": ["Island", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] } ],
    "steps": [ { "cast": "Sonic Assault", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Sonic Assault"] }, { "life": 20, "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] } },
  { "name": "ruling: a tapped creature can be targeted; it stays tapped and its controller still takes 2",
    "players": [ { "hand": ["Sonic Assault"], "battlefield": ["Island", "Mountain", "Mountain"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Sonic Assault", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Sonic Assault"] }, { "life": 18 } ], "tapped": { "Grizzly Bears": true } } },
  { "name": "ruling: a jump-start Sonic Assault whose target is gone is still exiled",
    "players": [ { "hand": ["Forest"], "graveyard": ["Sonic Assault"], "battlefield": ["Island", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] } ],
    "steps": [ { "cast": "Sonic Assault", "player": 0, "alt": 0, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "exile": ["Sonic Assault"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] } }
]
