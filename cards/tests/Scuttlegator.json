    "steps": [ { "activate": "Scuttlegator", "ability": 0 }, { "resolve": true } ],
    "expect": { "counters": { "Scuttlegator": { "p1p1": 1 } }, "pt": { "Scuttlegator": [7, 7] } } },
  { "name": "adapt does nothing when it already has a +1/+1 counter",
    "players": [ { "battlefield": ["Scuttlegator", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Scuttlegator", "ability": 0 }, { "resolve": true },
      { "activate": "Scuttlegator", "ability": 0 }, { "resolve": true }
