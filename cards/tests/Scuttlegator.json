      { "advance_to": "Main2" }
    ],
    "expect": { "counters": { "Scuttlegator": { "p1p1": 3 } }, "pt": { "Scuttlegator": [9, 9] }, "tapped": { "Scuttlegator": true }, "players": [ { "life": 20 }, { "life": 11 } ] } },
