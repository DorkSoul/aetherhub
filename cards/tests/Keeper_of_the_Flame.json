[
  { "name": "opponent with more life takes 2 damage",
    "players": [ { "life": 14, "battlefield": ["Keeper of the Flame", "Mountain"] }, { "life": 20 } ],
    "steps": [ { "activate": "Keeper of the Flame", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 18 } ], "tapped": { "Keeper of the Flame": true } }
  },
  { "name": "opponent with less life is not a legal target",
    "players": [ { "life": 20, "battlefield": ["Keeper of the Flame", "Mountain"] }, { "life": 14 } ],
    "steps": [ { "activate": "Keeper of the Flame", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 14 } ] }
  },
  { "name": "ruling: the condition is checked only on activation; the damage still happens after the life totals equalise",
    "players": [ { "life": 14, "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Keeper of the Flame", "Mountain", "Mountain", "Mountain"] }, { "life": 20 } ],
    "steps": [
      { "activate": "Keeper of the Flame", "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 14 }, { "life": 12 } ], "tapped": { "Keeper of the Flame": true } } }
]
