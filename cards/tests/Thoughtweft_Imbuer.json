[
  {
    "name": "attacking alone gets +X/+X for each Kithkin you control",
    "players": [
      { "battlefield": [{ "name": "Thoughtweft Imbuer", "sick": false }, "Thoughtweft Trio"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Thoughtweft Imbuer", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  },
  {
    "name": "attacking with two creatures does not trigger it",
    "players": [
      { "battlefield": [{ "name": "Thoughtweft Imbuer", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Thoughtweft Imbuer", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Thoughtweft Imbuer": [0, 5] },
      "players": [{}, { "life": 18 }]
    }
  },
  {
    "name": "ruling: X is locked in on resolution, a later loss of Kithkin does not shrink the bonus",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Thoughtweft Imbuer", "sick": false }, "Thoughtweft Trio", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Thoughtweft Imbuer", "at": "p1" }] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Thoughtweft Trio"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Thoughtweft Imbuer": [2, 7] },
      "players": [{}, { "life": 18 }]
    }
  }
]
