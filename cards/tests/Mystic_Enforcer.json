  {
    "name": "protection from black: a black creature cannot block it, a green one can",
    "players": [
      { "battlefield": [ { "name": "Mystic Enforcer", "sick": false } ] },
      { "battlefield": ["Bog Wraith", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Mystic Enforcer", "at": "p1" } ] },
      { "block": [ { "blocker": "Bog Wraith", "attacker": "Mystic Enforcer" }, { "blocker": "Grizzly Bears", "attacker": "Mystic Enforcer" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mystic Enforcer"] }, { "battlefield_has": ["Bog Wraith"], "graveyard_has": ["Grizzly Bears"], "life": 20 } ]
