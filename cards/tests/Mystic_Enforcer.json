  },
  {
    "name": "ruling: nonlethal damage becomes lethal when the graveyard drops below seven",
    "players": [
      { "battlefield": [ { "name": "Mystic Enforcer", "sick": false }, "Battlefield Scrounger" ], "graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] },
      { "battlefield": ["Air Elemental"] }
    ],
    "steps": [
      { "attack": [ { "card": "Mystic Enforcer", "at": "p1" } ] },
      { "block": [ { "blocker": "Air Elemental", "attacker": "Mystic Enforcer" } ] },
      { "advance_to": "Main2" },
      { "activate": "Battlefield Scrounger", "answers": [[0, 1, 2]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Mystic Enforcer"] }, { "graveyard_has": ["Air Elemental"] } ]
