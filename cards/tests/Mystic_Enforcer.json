      "pt": { "Mystic Enforcer": [6, 6] },
      "keywords": { "Mystic Enforcer": ["Flying"] }
    }
  },
  {
    "name": "six cards in graveyard: still 3/3 without flying",
    "players": [
      { "battlefield": ["Mystic Enforcer"], "graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [ { "pass": true } ],
    "expect": {
