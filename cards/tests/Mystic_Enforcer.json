  {
    "name": "protection from black: a black spell cannot target it",
    "players": [
      { "battlefield": ["Mystic Enforcer"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Mystic Enforcer"], "illegal": true }
