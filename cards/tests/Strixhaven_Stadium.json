[
 {
  "name": "tapping for mana adds a point counter",
  "players": [
   {
    "battlefield": [
     "Strixhaven Stadium"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Strixhaven Stadium"
   }
  ],
  "expect": {
   "counters": {
    "Strixhaven Stadium": {
     "point": 1
    }
   },
   "players": [
    {
     "pool": {
      "C": 1
     }
    },
    {}
   ]
  }
 },
 {
  "name": "your creature hitting an opponent adds a counter",
  "players": [
   {
    "battlefield": [
     "Strixhaven Stadium",
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Hill Giant",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "block": []
   },
   {
    "advance_to": "Main2"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Strixhaven Stadium": {
     "point": 1
    }
   },
   "winner": -1,
   "players": [
    {},
    {
     "life": 17
    }
   ]
  }
 },
 {
  "name": "tenth counter makes the player lose",
  "players": [
   {
    "battlefield": [
     {
      "name": "Strixhaven Stadium",
      "counters": {
       "point": 9
      }
     },
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Hill Giant",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "block": []
   },
   {
    "advance_to": "Main2"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "winner": 0
  }
 },
 {
  "name": "ninth counter does not win",
  "players": [
   {
    "battlefield": [
     {
      "name": "Strixhaven Stadium",
      "counters": {
       "point": 8
      }
     },
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Hill Giant",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "block": []
   },
   {
    "advance_to": "Main2"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "winner": -1,
   "counters": {
    "Strixhaven Stadium": {
     "point": 9
    }
   }
  }
 },
 {
  "name": "a creature dealing combat damage to you removes a counter",
  "players": [
   {
    "battlefield": [
     {
      "name": "Strixhaven Stadium",
      "counters": {
       "point": 3
      }
     }
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "start": "Main1",
  "steps": [
   {
    "advance_to": "Main1",
    "auto": true
   },
   {
    "attack": [
     {
      "card": "Hill Giant",
      "at": "p0"
     }
    ],
    "player": 1
   },
   {
    "resolve": true
   },
   {
    "block": []
   },
   {
    "advance_to": "Main2"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Strixhaven Stadium": {
     "point": 2
    }
   },
   "players": [
    {
     "life": 17
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: two creatures dealing combat damage at once each put a counter",
  "players": [ { "battlefield": ["Strixhaven Stadium", "Hill Giant", "Grizzly Bears"] }, {} ],
  "steps": [
   { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "resolve": true },
   { "block": [] },
   { "advance_to": "Main2" },
   { "resolve": true }
  ],
  "expect": { "counters": { "Strixhaven Stadium": { "point": 2 } }, "winner": -1, "players": [ {}, { "life": 15 } ] }
 },
 {
  "name": "ruling: a tenth counter added by another means does not make the opponent lose yet",
  "players": [ { "battlefield": [ { "name": "Strixhaven Stadium", "counters": { "point": 9 } } ] }, {} ],
  "steps": [ { "tap_for_mana": "Strixhaven Stadium" } ],
  "expect": { "winner": -1, "counters": { "Strixhaven Stadium": { "point": 10 } }, "players": [ { "pool": { "C": 1 } }, { "life": 20 } ] }
 }
]