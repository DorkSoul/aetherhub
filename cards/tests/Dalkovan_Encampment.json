[
 {
  "name": "enters tapped without a Swamp or Mountain",
  "players": [
   {
    "hand": [
     "Dalkovan Encampment"
    ],
    "battlefield": [
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Dalkovan Encampment"
   }
  ],
  "expect": {
   "tapped": {
    "Dalkovan Encampment": true
   }
  }
 },
 {
  "name": "enters untapped when you control a Mountain",
  "players": [
   {
    "hand": [
     "Dalkovan Encampment"
    ],
    "battlefield": [
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Dalkovan Encampment"
   }
  ],
  "expect": {
   "tapped": {
    "Dalkovan Encampment": false
   }
  }
 },
 {
  "name": "attack trigger makes two tapped and attacking Warriors, sacrificed at end step",
  "players": [
   {
    "battlefield": [
     "Dalkovan Encampment",
     "Plains",
     "Mountain",
     "Mountain",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Dalkovan Encampment",
    "ability": 0
   },
   {
    "resolve": true
   },
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Dalkovan Encampment",
      "Plains",
      "Mountain",
      "Mountain",
      "Grizzly Bears"
     ]
    },
    {
     "life": 16
    }
   ]
  }
 },
 {
  "name": "ruling: if no creature is declared as an attacker, the delayed trigger creates no Warriors",
  "players": [
   { "battlefield": ["Dalkovan Encampment", "Plains", "Mountain", "Mountain", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Dalkovan Encampment", "ability": 0 },
   { "resolve": true },
   { "advance_to": "BeginCombat" },
   { "attack": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Warrior 1-1 R"] },
    { "life": 20 }
   ]
  }
 },
 {
  "name": "ruling: the attack trigger still works after Dalkovan Encampment has been destroyed",
  "players": [
   { "hand": ["Stone Rain"], "battlefield": ["Dalkovan Encampment", "Plains", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Dalkovan Encampment", "ability": 0 },
   { "resolve": true },
   { "cast": "Stone Rain", "targets": ["Dalkovan Encampment"] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "resolve": true },
   { "block": [], "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Dalkovan Encampment"] },
    { "life": 16 }
   ]
  }
 }
]
