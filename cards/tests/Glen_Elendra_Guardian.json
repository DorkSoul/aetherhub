[
  {
    "name": "enters as a 2/3 with a -1/-1 counter",
    "players": [
      {
        "hand": [
          "Glen Elendra Guardian"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Glen Elendra Guardian"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Glen Elendra Guardian": [
          2,
          3
        ]
      },
      "counters": {
        "Glen Elendra Guardian": {
          "MinusOneMinusOne": 1
        }
      }
    }
  },
  {
    "name": "counters a noncreature spell, its controller draws",
    "players": [
      {
        "battlefield": [
          "Glen Elendra Guardian",
          "Island",
          "Island"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Lightning Bolt",
        "targets": [
          "p0"
        ]
      },
      {
        "activate": "Glen Elendra Guardian",
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20,
          "battlefield_has": [
            "Glen Elendra Guardian"
          ]
        },
        {
          "graveyard": [
            "Lightning Bolt"
          ],
          "hand_count": 1
        }
      ],
      "pt": {
        "Glen Elendra Guardian": [
          3,
          4
        ]
      }
    }
  },
  {
    "name": "can't counter a creature spell",
    "players": [
      {
        "battlefield": [
          "Glen Elendra Guardian",
          "Island",
          "Island"
        ]
      },
      {
        "hand": [
          "Glen Elendra Guardian"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Glen Elendra Guardian"
      },
      {
        "activate": "Glen Elendra Guardian",
        "illegal": true
      }
    ],
    "expect": {
      "counters": {
        "Glen Elendra Guardian": {
          "MinusOneMinusOne": 1
        }
      }
    }
  },
  {
    "name": "ruling: the countered spell already left the stack, so the ability does nothing and nobody draws",
    "players": [
      { "hand": ["Counterspell"], "battlefield": ["Glen Elendra Guardian", "Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] },
      { "activate": "Glen Elendra Guardian", "targets": [{ "stack": "Lightning Bolt" }] },
      { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "hand_count": 0, "graveyard_has": ["Counterspell"], "battlefield_has": ["Glen Elendra Guardian"] },
        { "graveyard": ["Lightning Bolt"], "hand_count": 0 }
      ],
      "pt": { "Glen Elendra Guardian": [3, 4] }
    }
  }
]
