[
  {
    "name": "exiles an opposing creature of mana value 3 or less until Annex Sentry leaves",
    "players": [
      {
        "hand": [
          "Annex Sentry"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Annex Sentry"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Annex Sentry"
          ]
        },
        {
          "exile": [
            "Grizzly Bears"
          ],
          "battlefield_lacks": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "returns the exiled creature when Annex Sentry leaves the battlefield",
    "players": [
      {
        "hand": [
          "Annex Sentry"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {
        "hand": [
          "Shatter"
        ],
        "battlefield": [
          "Mountain",
          "Swamp",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Annex Sentry"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "pass": true
      },
      {
        "cast": "Shatter",
        "targets": [
          "Annex Sentry"
        ],
        "player": 1
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Annex Sentry"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: toxic does nothing when its creature deals combat damage to a creature",
    "players": [ { "battlefield": ["Annex Sentry"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Annex Sentry", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Annex Sentry" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "poison": 0, "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: unblocked toxic 1 gives one poison counter and the damage is unchanged",
    "players": [ { "battlefield": ["Annex Sentry"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Annex Sentry", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 19, "poison": 1 } ] }
  },
  {
    "name": "ruling: doubled damage from Gratuitous Violence still gives only one poison counter",
    "players": [ { "battlefield": ["Annex Sentry", "Gratuitous Violence"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Annex Sentry", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18, "poison": 1 } ] }
  },
  {
    "name": "ruling: ten poison counters lose the game",
    "players": [ { "battlefield": ["Annex Sentry"] }, { "poison": 9 } ],
    "steps": [
      { "attack": [ { "card": "Annex Sentry", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "winner": 0 }
  }
]
