    "name": "ruling: the cast trigger still resolves when the spell is countered",
    "players": [
      { "hand": ["Snuff Out"], "battlefield": ["Roiling Vortex", "Swamp"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
