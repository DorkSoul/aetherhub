[
  {
    "name": "taps to deal 1 to a Spirit and exile it if it would die",
    "players": [ { "battlefield": ["Nine-Ringed Bo"] }, { "battlefield": ["Bloodghast"] } ],
    "steps": [ { "activate": "Nine-Ringed Bo", "ability": 0, "targets": ["Bloodghast"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "exile": ["Bloodghast"], "battlefield_lacks": ["Bloodghast"] } ], "tapped": { "Nine-Ringed Bo": true } }
  },
  {
    "name": "only Spirit creatures can be targeted",
    "players": [ { "battlefield": ["Nine-Ringed Bo"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Nine-Ringed Bo", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: the exile still applies if Nine-Ringed Bo has left the battlefield",
    "players": [ { "battlefield": ["Nine-Ringed Bo"] }, { "hand": ["Shatter"], "battlefield": ["Bloodghast", "Mountain", "Mountain"] } ],
    "steps": [
      { "activate": "Nine-Ringed Bo", "ability": 0, "targets": ["Bloodghast"] },
      { "pass": true },
      { "cast": "Shatter", "player": 1, "targets": ["Nine-Ringed Bo"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Nine-Ringed Bo"] }, { "exile": ["Bloodghast"], "battlefield_lacks": ["Bloodghast"] } ]
    }
  }
]
