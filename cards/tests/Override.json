[
  {
    "name": "controller pays {1} per artifact you control and the spell resolves",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Override"], "battlefield": ["Island", "Island", "Island", "Sol Talisman", "Mind Stone"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Override", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 17, "graveyard": ["Override"] }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "controller declines to pay and the spell is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Override"], "battlefield": ["Island", "Island", "Island", "Sol Talisman", "Mind Stone"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Override", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 20 }
      ],
      "stack_empty": true
    }
  }
]
