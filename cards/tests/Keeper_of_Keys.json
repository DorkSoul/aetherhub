[
  { "name": "enters and becomes the monarch",
    "players": [ { "hand": ["Keeper of Keys"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Keeper of Keys" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Keeper of Keys"] }, {} ] } },
  { "name": "monarch's upkeep: creatures you control can't be blocked this turn",
    "players": [ { "hand": ["Keeper of Keys"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Keeper of Keys" }, { "resolve": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "resolve": true, "auto": true },
               { "advance_to": "BeginCombat", "auto": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Keeper of Keys", "at": "p1" } ] }, { "block": [] }, { "advance_to": "End", "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Keeper of Keys", "Grizzly Bears"] }, { "life": 14 } ] } },
  { "name": "without the monarch trigger, the blocker stops the attack",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "life": 20 } ] } },
  { "name": "ruling: the monarch draws a card at the beginning of their end step",
    "players": [ { "hand": ["Keeper of Keys"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Keeper of Keys" }, { "resolve": true }, { "advance_to": "End", "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Keeper of Keys"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: without being the monarch, the upkeep trigger does nothing (attacker stays blockable)",
    "players": [ { "battlefield": ["Keeper of Keys", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] } ],
    "expect": { "players": [ { "battlefield_has": ["Keeper of Keys"] }, { "life": 20 } ] } }
]
