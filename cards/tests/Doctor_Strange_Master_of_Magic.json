[
  { "name": "taps to draw after you cast a noncreature spell this turn",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Doctor Strange, Master of Magic", "sick": false }, "Mountain" ] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "activate": "Doctor Strange, Master of Magic", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"] } ],
                "tapped": { "Doctor Strange, Master of Magic": true } } },
  { "name": "cannot tap to draw without casting a noncreature spell this turn",
    "players": [ { "battlefield": [ { "name": "Doctor Strange, Master of Magic", "sick": false } ] }, {} ],
    "steps": [ { "activate": "Doctor Strange, Master of Magic", "ability": 0, "illegal": true } ],
    "expect": { "players": [ {}, {} ] } },
  { "name": "casting a creature spell does not enable the draw",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "Doctor Strange, Master of Magic", "sick": false }, "Forest", "Forest" ] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true },
               { "activate": "Doctor Strange, Master of Magic", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } }
]
