[
  {
    "name": "X=1: exiles target creature you control until the next end step",
    "players": [
      { "hand": ["Waterbender's Restoration"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Waterbender's Restoration", "targets": ["Grizzly Bears"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "the exiled creature returns at the beginning of the next end step",
    "players": [
      { "hand": ["Waterbender's Restoration"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Waterbender's Restoration", "targets": ["Grizzly Bears"], "answers": [1] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "exile": [] },
        {}
      ]
    }
  },
  {
    "name": "X=2: exiles two target creatures you control",
    "players": [
      { "hand": ["Waterbender's Restoration"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Waterbender's Restoration", "targets": ["Grizzly Bears", "Hill Giant"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Grizzly Bears", "Hill Giant"] },
        {}
      ]
    }
  },
  {
    "name": "needs {U}{U} to cast",
    "players": [
      { "hand": ["Waterbender's Restoration"], "battlefield": ["Island", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Waterbender's Restoration", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Waterbender's Restoration"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: waterbend {1}: an untapped creature may be tapped instead of paying the generic mana",
    "players": [
      { "hand": ["Waterbender's Restoration"], "battlefield": ["Island", "Island", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Waterbender's Restoration", "targets": ["Hill Giant"], "answers": [1, [0]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Hill Giant"] },
        {}
      ],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: a summoning-sick creature may be tapped to pay waterbend",
    "players": [
      { "hand": ["Waterbender's Restoration"], "battlefield": ["Island", "Island", { "name": "Grizzly Bears", "sick": true }, "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Waterbender's Restoration", "targets": ["Hill Giant"], "answers": [1, [0]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Hill Giant"] },
        {}
      ],
      "tapped": { "Grizzly Bears": true }
    }
  }
