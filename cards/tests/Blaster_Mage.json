[
  {
    "name": "discard a card and tap to destroy target Wall",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Blaster Mage", "Mountain"] },
      { "battlefield": ["Wall of Frost"] }
    ],
    "steps": [
      { "activate": "Blaster Mage", "ability": 0, "targets": ["Wall of Frost"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Blaster Mage": true },
      "players": [ { "graveyard": ["Grizzly Bears"], "hand": [] }, { "graveyard": ["Wall of Frost"] } ]
    }
  },
  {
    "name": "target must be a Wall",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Blaster Mage", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Blaster Mage", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
