        "battlefield": [
          "Boompile",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Boompile",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "activate": "Boompile",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "a tapped Boompile cannot activate",
    "players": [
      {
        "battlefield": [
          {
            "name": "Boompile",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Boompile",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Boompile"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a winning flip destroys every nonland permanent, Boompile included (the Forest survives)",
    "seed": 3,
    "players": [
      { "battlefield": ["Boompile", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Boompile", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Forest"], "battlefield_lacks": ["Boompile", "Grizzly Bears"], "graveyard_has": ["Boompile", "Grizzly Bears"] },
        { "battlefield_lacks": ["Llanowar Elves"], "graveyard_has": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: a losing flip destroys nothing",
    "seed": 1,
    "players": [
      { "battlefield": ["Boompile", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Boompile", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Boompile", "Forest", "Grizzly Bears"] },
        { "battlefield_has": ["Llanowar Elves"] }
      ]
    }
  }
]
