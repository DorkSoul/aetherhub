[
  {
    "name": "casting a blue spell makes target player mill two",
    "players": [
      {
        "hand": [
          "Divination"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Drowned Secrets"
        ]
      },
      {
        "library": [
          "Island",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Divination",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard": [
            "Island",
            "Forest"
          ]
        }
      ]
    }
  },
  {
    "name": "casting a red spell does not trigger it",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Drowned Secrets"
        ]
      },
      {
        "library": [
          "Island",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17,
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "ruling: casting it does not trigger its own ability",
    "players": [
      { "hand": ["Drowned Secrets"], "battlefield": ["Island", "Island"] },
      { "library": ["Island", "Forest"] }
    ],
    "steps": [
      { "cast": "Drowned Secrets" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Drowned Secrets"] },
        { "graveyard": [], "library_top": ["Island", "Forest"] }
      ]
    }
  },
  {
    "name": "ruling: the trigger still mills when the blue spell is countered",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Drowned Secrets"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"], "library": ["Island", "Forest"] }
    ],
    "steps": [
      { "cast": "Divination", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Divination" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Divination"] },
        { "graveyard_has": ["Island", "Forest", "Counterspell"] }
      ]
    }
  }
]
