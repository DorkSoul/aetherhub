[
  { "name": "with an artifact you control, bounces a creature an opponent controls",
    "players": [ { "hand": ["Moonlit Scavengers"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Manalith"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Moonlit Scavengers" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Moonlit Scavengers"] }, { "hand": ["Grizzly Bears"], "battlefield": [] } ] } },
  { "name": "without an artifact or enchantment the trigger does nothing",
    "players": [ { "hand": ["Moonlit Scavengers"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Moonlit Scavengers" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Moonlit Scavengers"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an aura you control on an opponent's creature still counts as an enchantment you control",
    "players": [ { "hand": ["Pacifism", "Moonlit Scavengers"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Moonlit Scavengers" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Moonlit Scavengers"] }, { "hand": ["Grizzly Bears"], "battlefield": [] } ] } },
  { "name": "ruling: several artifacts still return only one creature",
    "players": [ { "hand": ["Moonlit Scavengers"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Manalith", "Manalith"] }, { "battlefield": ["Grizzly Bears", "Assembly-Worker"] } ],
    "steps": [ { "cast": "Moonlit Scavengers" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Moonlit Scavengers"] }, { "hand": ["Grizzly Bears"], "battlefield_has": ["Assembly-Worker"] } ] } }
]
