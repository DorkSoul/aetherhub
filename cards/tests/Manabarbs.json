  {
    "name": "ruling: the Manabarbs trigger goes on the stack under the spell, so the trigger resolves first (player at 1 life dies before the Bolt)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Manabarbs", "Mountain"], "life": 1 },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "winner": 1,
      "players": [
        {},
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: the trigger is on the stack when a spell is cast with the tapped mana, so the spell resolves first",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Manabarbs", "Mountain"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Mountain" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 19 },
        { "life": 17 }
      ]
    }
  }
