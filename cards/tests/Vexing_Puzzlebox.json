[
  {
    "name": "tapping for mana rolls a d20 and the roll puts that many charge counters on it",
    "rolls": [
      15
    ],
    "players": [
      {
        "battlefield": [
          "Vexing Puzzlebox"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Vexing Puzzlebox"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Vexing Puzzlebox"
          ]
        },
        {}
      ],
      "counters": {
        "Vexing Puzzlebox": {
          "charge": 15
        }
      }
    }
  },
  {
    "name": "a roll of 1 puts exactly one charge counter on it",
    "rolls": [
      1
    ],
    "players": [
      {
        "battlefield": [
          "Vexing Puzzlebox"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Vexing Puzzlebox"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "counters": {
        "Vexing Puzzlebox": {
          "charge": 1
        }
      }
    }
  },
  {
    "name": "removing 100 charge counters searches for an artifact onto the battlefield",
    "players": [
      {
        "battlefield": [
          {
            "name": "Vexing Puzzlebox",
            "counters": {
              "charge": 100
            }
          }
        ],
        "library": [
          "Treasure Chest",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Vexing Puzzlebox",
        "ability": 0
      },
      {
        "resolve": true,
        "answers": [
          0
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Treasure Chest"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "with only 99 charge counters the search ability is illegal",
    "players": [
      {
        "battlefield": [
          {
            "name": "Vexing Puzzlebox",
            "counters": {
              "charge": 99
            }
          }
        ],
        "library": [
          "Treasure Chest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Vexing Puzzlebox",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: the roll on tap is a mana ability: the mana is in the pool at once, only the roll trigger uses the stack",
    "rolls": [15],
    "players": [ { "battlefield": ["Vexing Puzzlebox"] }, {} ],
    "steps": [ { "tap_for_mana": "Vexing Puzzlebox", "color": "U" } ],
    "expect": {
      "stack_empty": false,
      "players": [ { "pool": { "U": 1 } }, {} ]
    }
  }
]