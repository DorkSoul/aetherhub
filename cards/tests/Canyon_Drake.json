[
  {
    "name": "{1} and a random discard: +2/+0 until end of turn",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Canyon Drake", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Canyon Drake" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Canyon Drake": [3, 2] },
      "players": [ { "hand_count": 0, "graveyard": ["Forest"] }, {} ]
    }
  },
  {
    "name": "the pump wears off at end of turn",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Canyon Drake", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Canyon Drake" },
      { "resolve": true },
      { "advance_to": "Main1", "player": 1 }
    ],
    "expect": {
      "pt": { "Canyon Drake": [1, 2] }
    }
  },
  {
    "name": "needs {1} to activate",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Canyon Drake"] },
      {}
    ],
    "steps": [
      { "activate": "Canyon Drake", "illegal": true }
    ],
    "expect": {
      "pt": { "Canyon Drake": [1, 2] },
      "players": [ { "hand": ["Forest"] }, {} ]
    }
  },
  {
    "name": "needs a card in hand to discard",
    "players": [
      { "battlefield": ["Canyon Drake", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Canyon Drake", "illegal": true }
    ],
    "expect": {
      "pt": { "Canyon Drake": [1, 2] }
    }
  }
