[
  {
    "name": "a tapped Plains produces one mana of the chosen color",
    "players": [
      { "hand": ["Island"], "battlefield": ["Harvest Mage", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Harvest Mage" },
      { "resolve": true },
      { "tap_for_mana": "Plains", "color": "R" }
    ],
    "expect": {
      "players": [{ "graveyard": ["Island"], "pool": { "R": 1 } }, {}],
      "tapped": { "Harvest Mage": true, "Plains": true }
    }
  },
  {
    "name": "a land that makes two mana produces only one",
    "players": [
      { "hand": ["Island"], "battlefield": ["Harvest Mage", "Forest", "Ancient Tomb"] },
      {}
    ],
    "steps": [
      { "activate": "Harvest Mage" },
      { "resolve": true },
      { "tap_for_mana": "Ancient Tomb", "color": "U" }
    ],
    "expect": {
      "players": [{ "pool": { "U": 1 }, "life": 18 }, {}]
    }
  },
  {
    "name": "the chosen color can pay for a spell the land could not normally help with",
    "players": [
      { "hand": ["Island", "Lightning Bolt"], "battlefield": ["Harvest Mage", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Harvest Mage", "answers": ["Island"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Island", "Lightning Bolt"] }, { "life": 17 }]
    }
  },
  {
    "name": "without the activation the land produces its normal mana",
    "players": [
      { "hand": ["Island"], "battlefield": ["Harvest Mage", "Plains"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Plains" }
    ],
    "expect": {
      "players": [{ "pool": { "W": 1 } }, {}]
    }
  },
  {
    "name": "the ability needs a card to discard",
    "players": [
      { "battlefield": ["Harvest Mage", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Harvest Mage", "illegal": true }
    ],
    "expect": {
      "tapped": { "Harvest Mage": false }
    }
  }
]
