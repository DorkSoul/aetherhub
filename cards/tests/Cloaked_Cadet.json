[
 {
  "name": "training counter draws a card (once per turn)",
  "players": [
   {
    "battlefield": [
     "Cloaked Cadet",
     "Serra Angel"
    ],
    "library": [
     "Forest",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Cloaked Cadet",
      "at": "p1"
     },
     {
      "card": "Serra Angel",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 1,
     "library_count": 2
    },
    {}
   ],
   "counters": {
    "Cloaked Cadet": {
     "p1p1": 1
    }
   },
   "pt": {
    "Cloaked Cadet": [
     3,
     5
    ]
   }
  }
 },
 {
  "name": "no training without a greater-power attacker: no counter, no draw",
  "players": [
   {
    "battlefield": [
     "Cloaked Cadet",
     "Grizzly Bears"
    ],
    "library": [
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Cloaked Cadet",
      "at": "p1"
     },
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 0
    },
    {}
   ],
   "counters": {},
   "pt": {
    "Cloaked Cadet": [
     2,
     4
    ]
   }
  }
 },
 {
  "name": "ruling: power raised after attackers are declared does not cause training",
  "players": [
   { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Cloaked Cadet", "Elusive Spellfist"], "library": ["Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Cloaked Cadet", "at": "p1" }, { "card": "Elusive Spellfist", "at": "p1" } ] },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "resolve": true },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "hand_count": 0 }, { "life": 9 } ],
   "counters": {},
   "pt": { "Cloaked Cadet": [2, 4] }
  }
 },
 {
  "name": "ruling: training still puts the counter on Cadet after the greater-power attacker is destroyed in response",
  "players": [
   { "battlefield": ["Cloaked Cadet", "Hill Giant"], "library": ["Forest", "Forest"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "attack": [ { "card": "Cloaked Cadet", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["Hill Giant"], "player": 1 },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 1, "graveyard": ["Hill Giant"] }, {} ],
   "counters": { "Cloaked Cadet": { "p1p1": 1 } }
  }
 }
]
