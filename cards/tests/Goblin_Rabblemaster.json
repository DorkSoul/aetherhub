 {
  "name": "ruling: a Goblin that has not been under your control since the turn began is not forced to attack",
  "players": [
   { "battlefield": ["Goblin Rabblemaster", { "name": "Goblin Piker", "sick": true }] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "resolve": true },
   { "attack": [ { "card": "Goblin Rabblemaster", "at": "p1" }, { "card": "Goblin 1-1 Haste", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [{}, { "life": 16 }]
  }
 },
 {
  "name": "ruling: the bonus is counted when the trigger resolves (a Goblin killed in response is not counted)",
  "players": [
   { "battlefield": ["Goblin Rabblemaster"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "resolve": true },
   { "attack": [ { "card": "Goblin Rabblemaster", "at": "p1" }, { "card": "Goblin 1-1 Haste", "at": "p1" } ] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Goblin 1-1 Haste"] },
   { "resolve": true },
   { "resolve": true },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [{}, { "life": 18 }]
  }
 },
 {
  "name": "ruling: two Goblin Rabblemasters force each other to attack, so the tokens alone may not attack",
  "players": [
   { "battlefield": ["Goblin Rabblemaster", "Goblin Rabblemaster"] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "resolve": true },
   { "resolve": true },
   { "attack": [ { "card": "Goblin 1-1 Haste", "at": "p1" } ], "illegal": true }
  ],
  "expect": {
   "players": [{}, { "life": 20 }]
  }
 }
]