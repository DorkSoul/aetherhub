[
  { "name": "ETB exiles a non-Assassin creature until the Stalker leaves",
    "players": [ { "hand": ["All-Fates Stalker"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "All-Fates Stalker" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["All-Fates Stalker"] }, { "battlefield": [], "exile": ["Grizzly Bears"] } ] } },
  { "name": "up to one: with no opposing creature the Stalker just enters",
    "players": [ { "hand": ["All-Fates Stalker"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "All-Fates Stalker" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["All-Fates Stalker"] }, {} ] } },
  { "name": "warp: cast for {1}{W}, exiled at the next end step",
    "players": [ { "hand": ["All-Fates Stalker"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "All-Fates Stalker", "alt": 0 }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["All-Fates Stalker"], "battlefield_lacks": ["All-Fates Stalker"] }, {} ] } },
  { "name": "ruling: Stalker killed in response to its ETB trigger, so nothing is exiled",
    "players": [ { "hand": ["All-Fates Stalker"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "All-Fates Stalker" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["All-Fates Stalker"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["All-Fates Stalker"] }, { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Lightning Bolt"] } ] } },
  { "name": "ruling: warped Stalker is exiled at the end step, so the creature it exiled returns",
    "players": [ { "hand": ["All-Fates Stalker"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "All-Fates Stalker", "alt": 0 }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["All-Fates Stalker"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: warp is cast only when the Stalker could be cast (not with a spell on the stack)",
    "players": [ { "hand": ["Lightning Bolt", "All-Fates Stalker"], "battlefield": ["Mountain", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "All-Fates Stalker", "alt": 0, "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Plains"] }, { "life": 17 } ] } }
]
