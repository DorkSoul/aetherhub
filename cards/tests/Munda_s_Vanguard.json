[
  {
    "name": "taps itself and an untapped Ally to put a counter on each creature you control",
    "players": [ { "battlefield": ["Munda's Vanguard", "Aang, Air Nomad", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Munda's Vanguard" }, { "resolve": true } ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 }, "Aang, Air Nomad": { "p1p1": 1 }, "Munda's Vanguard": { "p1p1": 1 } } }
  },
  {
    "name": "needs another Ally to pay the cost",
    "players": [ { "battlefield": ["Munda's Vanguard", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Munda's Vanguard", "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "ruling: the tapped second Ally may have just come under your control (summoning sick)",
    "players": [ { "battlefield": ["Munda's Vanguard", { "name": "Aang, Air Nomad", "sick": true }, "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Munda's Vanguard" }, { "resolve": true } ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 }, "Aang, Air Nomad": { "p1p1": 1 }, "Munda's Vanguard": { "p1p1": 1 } } }
  },
  {
    "name": "ruling: a summoning-sick Vanguard cannot activate cohort even with an untapped Ally",
    "players": [ { "battlefield": [{ "name": "Munda's Vanguard", "sick": true }, "Aang, Air Nomad"] }, {} ],
    "steps": [ { "activate": "Munda's Vanguard", "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  }
]
