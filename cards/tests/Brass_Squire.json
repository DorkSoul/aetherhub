[
  {
    "name": "taps to attach an Equipment you control to a creature you control",
    "players": [
      {
        "battlefield": [
          {
            "name": "Brass Squire",
            "sick": false
          },
          "Brawler's Plate",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Brass Squire",
        "ability": 0,
        "targets": [
          "Grizzly Bears",
          "Brawler's Plate"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          4,
          4
        ]
      },
      "attached": {
        "Brawler's Plate": "Grizzly Bears"
      }
    }
  },
  {
    "name": "cannot activate while tapped",
    "players": [
      {
        "battlefield": [
          {
            "name": "Brass Squire",
            "sick": false,
            "tapped": true
          },
          "Brawler's Plate",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Brass Squire",
        "ability": 0,
        "targets": [
          "Brawler's Plate",
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Brass Squire",
            "Brawler's Plate",
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: activated at instant speed in response to a spell",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": [
          { "name": "Brass Squire", "sick": false },
          "Brawler's Plate",
          "Grizzly Bears",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      {
        "activate": "Brass Squire",
        "ability": 0,
        "targets": ["Grizzly Bears", "Brawler's Plate"]
      },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "attached": { "Brawler's Plate": "Grizzly Bears" },
      "players": [
        { "life": 20 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: if the Equipment is gone on resolution, nothing moves",
    "players": [
      {
        "battlefield": [
          { "name": "Brass Squire", "sick": false },
          "Brawler's Plate",
          "Grizzly Bears"
        ]
      },
      {
        "hand": ["Disenchant"],
        "battlefield": ["Plains", "Plains"]
      }
    ],
    "steps": [
      {
        "activate": "Brass Squire",
        "ability": 0,
        "targets": ["Grizzly Bears", "Brawler's Plate"]
      },
      { "cast": "Disenchant", "player": 1, "targets": ["p0:Brawler's Plate"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "players": [
        { "graveyard": ["Brawler's Plate"] },
        { "graveyard": ["Disenchant"] }
      ]
    }
  }
