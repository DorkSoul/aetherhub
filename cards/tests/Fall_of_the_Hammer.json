[
 {
  "name": "first creature deals damage equal to its power to the second",
  "players": [
   {
    "hand": [
     "Fall of the Hammer"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Hill Giant"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears",
     "Wall of Stone"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Fall of the Hammer",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Hill Giant"
     ],
     "graveyard": [
      "Fall of the Hammer"
     ]
    },
    {
     "graveyard": [
      "Grizzly Bears"
     ],
     "battlefield": [
      "Wall of Stone"
     ]
    }
   ]
  }
 },
 {
  "name": "damage is only dealt, source takes none and a bigger blocker survives",
  "players": [
   {
    "hand": [
     "Fall of the Hammer"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Fall of the Hammer"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Mountain",
      "Mountain",
      "Grizzly Bears"
     ]
    },
    {
     "battlefield": [
      "Hill Giant"
     ]
    }
   ]
  }
 },
 {
  "name": "cannot target the same creature twice",
  "players": [
   {
    "hand": [
     "Fall of the Hammer"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Fall of the Hammer",
    "illegal": true
   }
  ]
 },
 {
  "name": "ruling: damage uses the first creature's power as Fall of the Hammer resolves, after a pump",
  "players": [
   { "hand": ["Fall of the Hammer", "Giant Growth"], "battlefield": ["Mountain", "Forest", "Forest", "Hill Giant"] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "cast": "Fall of the Hammer", "targets": ["Hill Giant", "Serra Angel"] },
   { "cast": "Giant Growth", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "graveyard": ["Serra Angel"] } ] }
 },
 {
  "name": "ruling: if the first target is gone, Fall of the Hammer deals no damage to the second",
  "players": [
   { "hand": ["Fall of the Hammer", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Hill Giant"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Fall of the Hammer", "targets": ["Hill Giant", "Grizzly Bears"] },
   { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Fall of the Hammer", "Lightning Bolt", "Hill Giant"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
 }
]
