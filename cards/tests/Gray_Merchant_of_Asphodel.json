[
  {
    "name": "enters: each opponent loses devotion to black (itself: 2), you gain that much",
    "players": [
      { "hand": ["Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22 }, { "life": 18 } ] }
  },
  {
    "name": "devotion counts the black symbols of the other permanents you control (Vampire Nighthawk: 2 + itself 2 = 4)",
    "players": [
      { "hand": ["Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Vampire Nighthawk"] },
      {}
    ],
    "steps": [
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 24 }, { "life": 16 } ] }
  },
  {
    "name": "green mana symbols do not count toward devotion to black",
    "players": [
      { "hand": ["Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22 }, { "life": 18 } ] }
  },
  {
    "name": "each opponent in a three-player game loses X and you gain X for each",
    "players": [
      { "hand": ["Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {},
      {}
    ],
    "steps": [
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 24 }, { "life": 18 }, { "life": 18 } ] }
  },
  {
    "name": "needs five mana",
    "players": [
      { "hand": ["Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [ { "cast": "Gray Merchant of Asphodel", "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] }
  },
  {
    "name": "ruling: an Aura you control on an opponent's creature still counts toward your devotion (Dead Weight 1 + Merchant 2)",
    "players": [
      { "hand": ["Dead Weight", "Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Dead Weight", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 23 }, { "life": 17 } ] }
  },
  {
    "name": "ruling: colorless mana symbols do not count toward devotion (Sol Ring adds nothing; Merchant alone = 2)",
    "players": [
      { "hand": ["Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22 }, { "life": 18 } ] }
  },
  {
    "name": "ruling: Phyrexian mana symbols count toward devotion (Phyrexian Rager 1 + Merchant 2 = 3)",
    "players": [
      { "hand": ["Phyrexian Rager", "Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Phyrexian Rager" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "ruling: you gain the total life lost even when the opponent's life goes below 0 (lose 2 from 1 life, gain 2)",
    "players": [
      { "hand": ["Gray Merchant of Asphodel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "set_life": 1, "player": 1 },
      { "cast": "Gray Merchant of Asphodel" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22 }, { "life": -1 } ] }
  }
]
