[
  {
    "name": "-2/-2 to all creatures; creatures that would die are exiled instead",
    "players": [
      { "hand": ["Cry of the Carnarium"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears", "Serra Angel"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [{ "cast": "Cry of the Carnarium" }, { "resolve": true }],
    "expect": {
      "players": [
        { "battlefield_has": ["Serra Angel"], "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Cry of the Carnarium"], "exile": ["Grizzly Bears"] },
        { "battlefield_lacks": ["Savannah Lions"], "exile": ["Savannah Lions"] }
      ],
      "pt": { "Serra Angel": [2, 2] }
    }
  },
  {
    "name": "creature cards put into a graveyard from the battlefield this turn are exiled from all graveyards",
    "players": [
      { "hand": ["Lightning Bolt", "Cry of the Carnarium"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Cry of the Carnarium" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt", "Cry of the Carnarium"], "exile": ["Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "a creature that went to the graveyard on an earlier turn is not exiled",
    "players": [{ "hand": ["Cry of the Carnarium"], "battlefield": ["Swamp", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] }, {}],
    "steps": [{ "cast": "Cry of the Carnarium" }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Cry of the Carnarium", "Grizzly Bears"] }, {}] }
  },
  {
    "name": "an opponent's creature put into their graveyard this turn is exiled too",
    "players": [
      { "hand": ["Lightning Bolt", "Cry of the Carnarium"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Cry of the Carnarium" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt", "Cry of the Carnarium"] }, { "exile": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: a creature that enters after Cry resolves does not get -2/-2",
    "players": [
      { "hand": ["Cry of the Carnarium", "Grizzly Bears"], "battlefield": ["Swamp", "Swamp", "Swamp", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Cry of the Carnarium" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "graveyard": ["Cry of the Carnarium"] }, {}],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: a creature entering after Cry that dies this turn is exiled instead",
    "players": [
      { "hand": ["Cry of the Carnarium", "Grizzly Bears", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Forest", "Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Cry of the Carnarium" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"], "graveyard": ["Cry of the Carnarium", "Lightning Bolt"] }, {}]
    }
  }
]
