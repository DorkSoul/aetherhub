   { "hand": ["Golden Bear"], "battlefield": ["Goblinslide", "Forest", "Forest", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Golden Bear" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Goblinslide", "Forest", "Forest", "Forest", "Forest", "Golden Bear"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: declining to pay {1} makes no Goblin",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Goblinslide", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [false] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Goblinslide", "Mountain", "Mountain"] },
    { "graveyard": ["Grizzly Bears"] }
   ]
  }
 }
