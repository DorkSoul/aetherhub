[
 {
  "name": "paying 1 for a noncreature spell makes a hasty Goblin",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Goblinslide", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Goblinslide", "Mountain", "Mountain", "Goblin 1-1 Haste"] },
    { "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "creature spells do not trigger it",
