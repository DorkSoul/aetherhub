[
  {
    "name": "creature without flying can still block creatures you control",
    "players": [
      {
        "battlefield": [
          "Bower Passage",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Hill Giant",
            "attacker": "Grizzly Bears"
          }
        ]
      },
      {
        "pass": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield_has": [
            "Hill Giant"
          ],
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "unblocked attacker deals damage with flyer on the other side",
    "players": [
      {
        "battlefield": [
          "Bower Passage",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Air Elemental"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "a flying creature can't block creatures you control, even with another blocker available",
    "players": [{"battlefield": ["Bower Passage", "Grizzly Bears"]}, {"battlefield": ["Air Elemental", "Hill Giant"]}],
    "steps": [{"attack": [{"card": "Grizzly Bears", "at": "p1"}]}, {"block": [{"blocker": "Air Elemental", "attacker": "Grizzly Bears"}]}, {"advance_to": "Main2"}],
    "expect": {"players": [{}, {"life": 18}]}
  },
  {
    "name": "ruling: a creature with reach can still block creatures you control",
    "players": [
      { "battlefield": ["Bower Passage", "Grizzly Bears"] },
      { "battlefield": ["Giant Spider"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Giant Spider", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        { "life": 20, "battlefield_has": ["Giant Spider"] }
      ]
    }
  }
]
