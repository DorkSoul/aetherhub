[
  {
    "name": "taps the target creature",
    "players": [
      {
        "hand": ["Take into Custody"],
        "battlefield": ["Island"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Take into Custody", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Grizzly Bears"] }],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "can target an already tapped creature",
    "players": [
      {
        "hand": ["Take into Custody"],
        "battlefield": ["Island", { "name": "Grizzly Bears", "tapped": true }]
      },
      {}
    ],
    "steps": [
      { "cast": "Take into Custody", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Take into Custody"] }, {}],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: the creature untaps in the untap step after the skipped one",
    "players": [
      { "hand": ["Take into Custody"], "battlefield": ["Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Take into Custody", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Untap", "auto": true },
      { "advance_to": "Untap", "auto": true },
      { "advance_to": "Untap", "auto": true },
      { "advance_to": "Untap", "auto": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, {}],
      "tapped": { "Grizzly Bears": false }
    }
  }
]
