   "steps": [ { "cast": "Ettercap // Web Shot", "face": true, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Ettercap // Web Shot"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
