   "players": [ { "hand": ["Ettercap // Web Shot"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Storm Crow"] } ],
   "steps": [ { "cast": "Ettercap // Web Shot", "face": true, "targets": ["Storm Crow"] }, { "resolve": true }, { "cast": "Ettercap // Web Shot" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ettercap // Web Shot"] }, { "graveyard": ["Storm Crow"] } ] } },
 { "name": "ruling: the exiled Adventure creature is cast for its own cost ({4}{G}), so 4 spare mana is not enough",
   "players": [ { "hand": ["Ettercap // Web Shot"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Storm Crow"] } ],
   "steps": [ { "cast": "Ettercap // Web Shot", "face": true, "targets": ["Storm Crow"] }, { "resolve": true }, { "cast": "Ettercap // Web Shot", "illegal": true } ],
