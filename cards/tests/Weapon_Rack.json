[
  {
    "name": "enters with three +1/+1 counters",
    "players": [
      {
        "hand": [
          "Weapon Rack"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Weapon Rack"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Weapon Rack": {
          "p1p1": 3
        }
      }
    }
  },
  {
    "name": "moves a counter onto target creature",
    "players": [
      {
        "battlefield": [
          {
            "name": "Weapon Rack",
            "counters": {
              "p1p1": 3
            }
          }
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Weapon Rack",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Weapon Rack": {
          "p1p1": 2
        },
        "Grizzly Bears": {
          "p1p1": 1
        }
      },
      "pt": {
        "Grizzly Bears": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "no counters left: does nothing",
    "players": [
      {
        "battlefield": [
          {
            "name": "Weapon Rack",
            "counters": {
              "p1p1": 0
            }
          }
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Weapon Rack",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "ruling: with no counters left the Rack stays on the battlefield and its ability does nothing",
    "players": [
      { "battlefield": [ { "name": "Weapon Rack", "counters": { "p1p1": 0 } } ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Weapon Rack", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Weapon Rack"] }, {} ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: if the target becomes illegal in response the Rack keeps its counters",
    "players": [
      { "battlefield": [ { "name": "Weapon Rack", "counters": { "p1p1": 3 } }, "Grizzly Bears" ] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Weapon Rack", "ability": 0, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Weapon Rack"] }, { "graveyard": ["Lightning Bolt"] } ],
      "counters": { "Weapon Rack": { "p1p1": 3 } }
    }
  }
]
