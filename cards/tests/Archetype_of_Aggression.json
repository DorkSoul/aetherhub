    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "keywords": { "Aberrant Manawurm": [] } } },
  { "name": "opponent's Aetherstream Leopard loses trample: no excess damage over a 1/1 blocker",
    "players": [ { "battlefield": ["Archetype of Aggression", { "name": "Llanowar Elves", "sick": false }] }, { "battlefield": [{ "name": "Aetherstream Leopard", "sick": false }] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "attack": [{ "card": "Aetherstream Leopard", "at": "p0" }], "player": 1 }, { "block": [{ "blocker": "Llanowar Elves", "attacker": "Aetherstream Leopard" }], "player": 0 }, { "advance_to": "Main2", "player": 1 } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "ruling: a creature an opponent casts after Archetype is on the battlefield loses its trample",
    "players": [ { "battlefield": ["Archetype of Aggression"] }, { "hand": ["Aetherstream Leopard"], "battlefield": ["Forest", "Forest", "Forest"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "cast": "Aetherstream Leopard", "player": 1 }, { "resolve": true } ],
    "expect": { "keywords": { "Aetherstream Leopard": [] } } },
  { "name": "ruling: when Archetype leaves, trample granted by an aura comes back",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Archetype of Aggression"] }, { "hand": ["Rancor"], "battlefield": ["Forest", { "name": "Grizzly Bears", "sick": false }] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "cast": "Rancor", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Archetype of Aggression"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Archetype of Aggression", "Lightning Bolt"] }, { "battlefield_has": ["Rancor", "Grizzly Bears"] } ], "keywords": { "Grizzly Bears": ["Trample"] }, "pt": { "Grizzly Bears": [4, 2] } } },
  { "name": "ruling: Overrun's trample is not created while Archetype is out, even after Archetype leaves",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Archetype of Aggression"] }, { "hand": ["Overrun"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains", { "name": "Grizzly Bears", "sick": false }] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "cast": "Overrun", "player": 1 }, { "resolve": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Archetype of Aggression"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Archetype of Aggression", "Lightning Bolt"] }, { "battlefield_has": ["Grizzly Bears"] } ], "keywords": { "Grizzly Bears": [] }, "pt": { "Grizzly Bears": [5, 5] } } },
  { "name": "ruling: if both players control an Archetype, no creature has trample",
    "players": [ { "battlefield": ["Archetype of Aggression", "Grizzly Bears"] }, { "battlefield": ["Archetype of Aggression", "Llanowar Elves"] } ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "keywords": { "Grizzly Bears": [], "Llanowar Elves": [] } } }
]
