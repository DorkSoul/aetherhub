[
  {
    "name": "equipped creature can be blocked by a Wall",
    "players": [{ "battlefield": ["Prowler's Helm", "Grizzly Bears", "Island", "Island"] }, { "battlefield": ["Wall of Stone"] }],
    "steps": [
      { "activate": "Prowler's Helm", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Stone", "attacker": "Grizzly Bears" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 20 }], "attached": { "Prowler's Helm": "Grizzly Bears" } }
  },
  {
    "name": "equipped creature unblocked when no Wall is on the other side",
    "players": [{ "battlefield": ["Prowler's Helm", "Grizzly Bears", "Island", "Island"] }, { "battlefield": ["Llanowar Elves"] }],
    "steps": [
      { "activate": "Prowler's Helm", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 18 }] }
  },
  {
    "name": "equipped creature cannot be blocked by a non-Wall: Elves' block is rejected while Wall blocks the other attacker",
    "players": [{ "battlefield": ["Prowler's Helm", "Grizzly Bears", "Hill Giant", "Island", "Island"] }, { "battlefield": ["Llanowar Elves", "Wall of Stone"] }],
    "steps": [
      { "activate": "Prowler's Helm", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" }, { "blocker": "Wall of Stone", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 18 }] }
  }
]
