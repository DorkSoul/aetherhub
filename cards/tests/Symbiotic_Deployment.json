[
  { "name": "{1} and tapping two creatures you control draws a card",
    "players": [
      { "battlefield": ["Symbiotic Deployment", "Forest", "Grizzly Bears", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Symbiotic Deployment" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Symbiotic Deployment", "Grizzly Bears"] }, {} ] }
  },
  { "name": "the draw ability needs two untapped creatures to tap",
    "players": [
      { "battlefield": ["Symbiotic Deployment", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Symbiotic Deployment", "illegal": true }
    ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] }
  },
  { "name": "the draw ability needs {1}",
    "players": [
      { "battlefield": ["Symbiotic Deployment", "Grizzly Bears", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Symbiotic Deployment", "illegal": true }
    ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] }
  },
  { "name": "skips the draw step while it is on the battlefield",
    "players": [
      { "battlefield": ["Symbiotic Deployment"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "advance_to": "End", "auto": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Main1", "auto": true }
    ],
    "expect": { "turn": 3, "players": [ { "hand_count": 0 }, {} ] }
  },
  { "name": "without Symbiotic Deployment the controller draws in the draw step",
    "players": [
      { "battlefield": ["Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "advance_to": "End", "auto": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Main1", "auto": true }
    ],
    "expect": { "turn": 3, "players": [ { "hand_count": 1 }, {} ] }
  }
]
