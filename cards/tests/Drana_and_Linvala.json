  {
    "name": "ruling: 'this creature' in the granted ability means Drana (Temur Sabertooth gives Drana indestructible)",
    "players": [
      { "hand": [], "battlefield": ["Drana and Linvala", "Grizzly Bears", "Mountain", "Mountain"] },
      { "battlefield": ["Temur Sabertooth"] }
