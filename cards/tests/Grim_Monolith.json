    "players": [ { "battlefield": [ { "name": "Grim Monolith", "tapped": true }, "Plains", "Plains", "Plains" ] }, {} ],
    "steps": [ { "activate": "Grim Monolith", "ability": 0, "illegal": true } ],
    "expect": { "tapped": { "Grim Monolith": true } } }
