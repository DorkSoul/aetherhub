[
 { "name": "enters prepared; Enroot is cast from exile and puts a land card into the graveyard",
   "players": [ { "hand": ["Carnivorous Cultivator // Enroot"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Carnivorous Cultivator // Enroot" }, { "resolve": true },
              { "cast": "Enroot" }, { "resolve": true, "answers": ["Forest"] } ],
   "expect": { "players": [ { "graveyard": ["Forest"], "library_count": 20 }, {} ] } },
 { "name": "Enroot cannot be cast from hand",
   "players": [ { "hand": ["Carnivorous Cultivator // Enroot"], "battlefield": ["Forest"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Enroot", "illegal": true } ],
   "expect": { "players": [ { "graveyard": [] }, {} ] } },
 { "name": "combat damage to a player returns a land card from your graveyard to hand",
   "players": [ { "battlefield": [ { "name": "Carnivorous Cultivator // Enroot", "sick": false } ], "graveyard": ["Forest"] }, {} ],
   "steps": [ { "attack": [ { "card": "Carnivorous Cultivator // Enroot", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Forest"], "graveyard": [] }, { "life": 18 } ] } },
 { "name": "blocked: no combat damage to a player, so nothing returns",
   "players": [ { "battlefield": [ { "name": "Carnivorous Cultivator // Enroot", "sick": false } ], "graveyard": ["Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Carnivorous Cultivator // Enroot", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Carnivorous Cultivator // Enroot" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard": ["Forest"], "hand_count": 0 }, { "graveyard": ["Grizzly Bears"] } ] } }
]
