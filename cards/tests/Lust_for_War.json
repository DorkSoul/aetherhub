[
  {
    "name": "enchanted creature tapping to attack deals 3 to its controller",
    "players": [
      {
        "hand": [
          "Lust for War"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lust for War",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "attached": {
        "Lust for War": "Grizzly Bears"
      },
      "players": [
        {
          "life": 17,
          "battlefield_has": [
            "Grizzly Bears",
            "Lust for War"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "enchanted creature must attack: declaring only Savannah Lions still makes the Bears attack (Lust trigger hits its controller)",
    "players": [
      { "hand": ["Lust for War"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears", "Savannah Lions"] },
      {}
    ],
    "steps": [
      { "cast": "Lust for War", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Savannah Lions", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "attached": { "Lust for War": "Grizzly Bears" },
      "tapped": { "Grizzly Bears": true },
      "players": [
        { "life": 17, "battlefield_has": ["Grizzly Bears", "Lust for War"] },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "ruling: a summoning-sick enchanted creature does not have to attack",
    "players": [
      { "hand": ["Lust for War"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": true }] },
      {}
    ],
    "steps": [
      { "cast": "Lust for War", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "attached": { "Lust for War": "Grizzly Bears" },
      "tapped": { "Grizzly Bears": false },
      "players": [ { "life": 20 }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: the Lust trigger fires when the creature is tapped for mana, not only when it attacks",
    "players": [
      { "hand": ["Lust for War"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Llanowar Elves", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Lust for War", "targets": ["Llanowar Elves"] },
      { "resolve": true },
      { "tap_for_mana": "Llanowar Elves" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 17 }, { "life": 20 } ] }
  }
]
