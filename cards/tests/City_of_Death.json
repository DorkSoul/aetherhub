[
  {
    "name": "chapter I creates a Treasure",
    "players": [
      { "hand": ["City of Death"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "City of Death" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Treasure", "City of Death"] }, {} ]
    }
  },
  {
    "name": "chapter II copies a target non-Saga token you control",
    "players": [
      { "battlefield": [{ "name": "City of Death", "counters": { "lore": 1 } }, "Treasure"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Treasure", "Treasure"] }, {} ]
    }
  },
  {
    "name": "chapter III copies a target non-Saga token you control",
    "players": [ { "battlefield": [{ "name": "City of Death", "counters": { "lore": 2 } }, "Treasure"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure", "Treasure", "City of Death"] }, {} ] }
  },
  {
    "name": "chapter IV copies a target non-Saga token you control",
    "players": [ { "battlefield": [{ "name": "City of Death", "counters": { "lore": 3 } }, "Treasure"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure", "Treasure", "City of Death"] }, {} ] }
  },
  {
    "name": "chapter V copies a target non-Saga token you control",
    "players": [ { "battlefield": [{ "name": "City of Death", "counters": { "lore": 4 } }, "Treasure"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure", "Treasure", "City of Death"] }, {} ] }
  },
  {
    "name": "chapter VI copies a target non-Saga token, then the Saga is sacrificed",
    "players": [ { "battlefield": [{ "name": "City of Death", "counters": { "lore": 5 } }, "Treasure"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure", "Treasure"], "battlefield_lacks": ["City of Death"], "graveyard_has": ["City of Death"] }, {} ] }
  },
  {
    "name": "chapter III with no non-Saga token to copy: the chapter does nothing",
    "players": [ { "battlefield": [{ "name": "City of Death", "counters": { "lore": 2 } }] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["City of Death"], "battlefield_lacks": ["Treasure"] }, {} ] }
  },
  {
    "name": "ruling: a copy of a token that copied Shaman enters as Shaman (copy of a copy)",
    "players": [
      { "battlefield": [{ "name": "City of Death", "counters": { "lore": 1 } }, "Kiki-Jiki, Mirror Breaker", "Shaman of the Pack"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "activate": "Kiki-Jiki, Mirror Breaker", "ability": 0 },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Shaman of the Pack", "Shaman of the Pack", "Shaman of the Pack", "City of Death"] }, {} ],
      "pt": { "Shaman of the Pack": [3, 2] }
    }
  },
  {
    "name": "ruling: the copy's enters-the-battlefield trigger fires and counts Elves as it resolves",
    "players": [
      { "battlefield": [{ "name": "City of Death", "counters": { "lore": 1 } }, "Kiki-Jiki, Mirror Breaker", "Shaman of the Pack"] },
      {}
    ],
    "steps": [
