[
 {
  "name": "after {G} naming the opponent, their Doom Blade kills it",
  "players": [
   { "battlefield": ["Autumn Willow", "Forest"] },
   { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Island"] }
  ],
  "steps": [
   { "activate": "Autumn Willow", "targets": ["p1"] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Doom Blade", "player": 1, "targets": ["Autumn Willow"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Autumn Willow"] }, { "graveyard": ["Doom Blade"] } ] }
 },
 {
  "name": "shroud stops the opponent's Doom Blade",
  "players": [
   { "battlefield": ["Autumn Willow", "Forest"] },
   { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Island"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Doom Blade", "player": 1, "targets": ["Autumn Willow"], "illegal": true }
  ],
  "expect": { "players": [ { "battlefield": ["Autumn Willow", "Forest"] }, { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Island"] } ] }
 },
 {
  "name": "naming the opponent does not let me target my own Willow",
  "players": [
   { "hand": ["Doom Blade"], "battlefield": ["Autumn Willow", "Forest", "Swamp", "Island"] },
   {}
  ],
  "steps": [
   { "activate": "Autumn Willow", "targets": ["p1"] },
   { "resolve": true },
   { "cast": "Doom Blade", "illegal": true }
  ],
  "expect": { "players": [ { "hand": ["Doom Blade"], "battlefield": ["Autumn Willow", "Forest", "Swamp", "Island"] }, {} ] }
 },
 {
  "name": "ruling: a spell with shroud's source can still be countered on the stack",
  "players": [
   { "hand": ["Autumn Willow"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Autumn Willow" },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Autumn Willow" }] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Autumn Willow"] }, { "graveyard": ["Counterspell"] } ] }
 }
]
