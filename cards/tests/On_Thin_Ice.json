    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "On Thin Ice", "answers": [0] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Pacifism"], "battlefield_has": ["On Thin Ice"] }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "ruling: counters on the exiled creature cease to exist, so it returns as a 2/2",
    "players": [ { "hand": ["On Thin Ice", "Naturalize"], "battlefield": ["Snow-Covered Plains", "Plains", "Forest"] }, { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } } ] } ],
    "steps": [ { "cast": "On Thin Ice" }, { "resolve": true }, { "resolve": true }, { "cast": "Naturalize", "targets": ["On Thin Ice"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["On Thin Ice"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [2, 2] } } }
