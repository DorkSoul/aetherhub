[
 { "name": "exchanges two creatures",
   "players": [ { "battlefield": ["Gauntlets of Chaos", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "activate": "Gauntlets of Chaos", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "graveyard": ["Gauntlets of Chaos"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "exchanges two lands",
   "players": [ { "battlefield": ["Gauntlets of Chaos", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Mountain"] } ],
   "steps": [ { "activate": "Gauntlets of Chaos", "targets": ["Swamp", "Mountain"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Mountain"] }, { "battlefield_has": ["Swamp"] } ] } },
 { "name": "destroys Auras attached to the exchanged permanents",
   "players": [ { "hand": ["Pacifism"], "battlefield": ["Gauntlets of Chaos", "Grizzly Bears", "Plains", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Pacifism", "targets": ["Hill Giant"] }, { "resolve": true },
              { "activate": "Gauntlets of Chaos", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Pacifism"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: if one target is gone on resolution nothing is exchanged and the other stays under its controller",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Gauntlets of Chaos", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "activate": "Gauntlets of Chaos", "targets": ["Grizzly Bears", "Hill Giant"] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Gauntlets of Chaos", "Grizzly Bears", "Lightning Bolt"] }, { "battlefield_has": ["Hill Giant"] } ] } }
]
