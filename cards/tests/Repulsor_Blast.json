[
 { "name": "without teamwork: 5 damage to the creature and no damage to its controller",
   "players": [
     { "hand": ["Repulsor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
     { "battlefield": [{ "name": "Hill Giant", "sick": false }] }
   ],
   "steps": [ { "cast": "Repulsor Blast", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20, "graveyard_has": ["Hill Giant"] } ] } },
 { "name": "teamwork with one creature of power 2: 2 damage to the controller",
   "players": [
     { "hand": ["Repulsor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
     { "battlefield": [{ "name": "Hill Giant", "sick": false }] }
   ],
   "steps": [ { "cast": "Repulsor Blast", "targets": ["Hill Giant"], "answers": [true, 0] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 18, "graveyard_has": ["Hill Giant"] } ], "tapped": { "Grizzly Bears": true } } },
 { "name": "teamwork with two creatures of power 1: 2 damage to the controller",
   "players": [
     { "hand": ["Repulsor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Llanowar Elves", "sick": false }, { "name": "Llanowar Elves", "sick": false }] },
     { "battlefield": [{ "name": "Hill Giant", "sick": false }] }
   ],
   "steps": [ { "cast": "Repulsor Blast", "targets": ["Hill Giant"], "answers": [true, 1] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 18, "graveyard_has": ["Hill Giant"] } ] } },
 { "name": "a single creature of power 1 cannot pay teamwork 2",
   "players": [
     { "hand": ["Repulsor Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Llanowar Elves", "sick": false }] },
     { "battlefield": [{ "name": "Hill Giant", "sick": false }] }
   ],
   "steps": [ { "cast": "Repulsor Blast", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20, "graveyard_has": ["Hill Giant"] } ], "tapped": { "Llanowar Elves": false } } }
]
