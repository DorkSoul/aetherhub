      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "battlefield_has": ["Ori, Plate Stacker"] },
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Sol Ring", "Ghostly Prison"] }
      ]
    }
  },
  {
    "name": "own artifacts and enchantments survive and no life without opposing targets",
    "players": [
      { "hand": ["Ori, Plate Stacker"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island", "Island", "Island", "Sol Ring"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ori, Plate Stacker" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield_has": ["Ori, Plate Stacker", "Sol Ring"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: an indestructible artifact is not destroyed, so no life is gained for it",
    "players": [
      { "hand": ["Ori, Plate Stacker"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Darksteel Myr", "Sol Ring"] }
    ],
    "steps": [
      { "cast": "Ori, Plate Stacker" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "battlefield_has": ["Ori, Plate Stacker"] },
        { "battlefield_has": ["Darksteel Myr"], "graveyard": ["Sol Ring"] }
      ]
    }
  }
