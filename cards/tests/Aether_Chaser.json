  ],
  "expect": { "players": [ { "energy": 2 }, {} ] }
 },
 {
  "name": "ruling: energy stays with the player after the creature leaves",
  "players": [
   { "hand": ["Aether Chaser", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Aether Chaser" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Aether Chaser"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "energy": 2, "graveyard_has": ["Aether Chaser"] }, {} ] }
 },
 {
  "name": "ruling: with no energy the attack trigger creates no Servo",
