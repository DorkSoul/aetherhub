  "name": "ruling: energy persists across steps and turns",
  "players": [
   { "hand": ["Aether Chaser"], "battlefield": ["Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Aether Chaser" },
   { "resolve": true },
