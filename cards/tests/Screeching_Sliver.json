[
  {
    "name": "granted tap ability: target opponent mills a card",
    "players": [ { "battlefield": ["Screeching Sliver"] }, {} ],
    "steps": [
      { "activate": "Screeching Sliver", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "library_count": 19 } ], "tapped": { "Screeching Sliver": true } }
  },
  {
    "name": "granted tap ability can't be used while tapped",
    "players": [ { "battlefield": ["Screeching Sliver"] }, {} ],
    "steps": [
      { "activate": "Screeching Sliver", "ability": 32768, "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Screeching Sliver", "ability": 32768, "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [ {}, { "library_count": 19 } ] }
  },
  {
    "name": "ruling: two Screeching Slivers each grant the mill ability, so each can mill once",
    "players": [ { "battlefield": ["Screeching Sliver", "Screeching Sliver"] }, { "library": ["Grizzly Bears", "Forest"] } ],
    "steps": [
      { "activate": "Screeching Sliver", "ability": 32768, "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Screeching Sliver", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "graveyard_has": ["Grizzly Bears", "Forest"] } ] }
  }
]
