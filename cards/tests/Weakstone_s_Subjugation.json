[
  {
    "name": "enchants a creature when it enters",
    "players": [
      {
        "hand": [
          "Weakstone's Subjugation"
        ],
        "battlefield": [
          "Island",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Weakstone's Subjugation",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "attached": {
        "Weakstone's Subjugation": "Grizzly Bears"
      },
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "paying {3} taps the enchanted creature, and it doesn't untap",
    "players": [
      {
        "hand": [
          "Weakstone's Subjugation"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Weakstone's Subjugation",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "attached": {
        "Weakstone's Subjugation": "Grizzly Bears"
      },
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "the enchanted tapped creature does not untap in its controller's untap step",
    "players": [ { "hand": ["Weakstone's Subjugation"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Weakstone's Subjugation", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "ruling: an unpaid Aura still stops the already tapped enchanted creature from untapping",
    "players": [ { "hand": ["Weakstone's Subjugation"], "battlefield": ["Island", "Island", "Island", "Island", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [
      { "cast": "Weakstone's Subjugation", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [false] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  }
]
