[
  {
    "name": "takes a creature card from the target opponent's graveyard under its controller's control",
    "players": [
      { "battlefield": ["Tariel, Reckoner of Souls"] },
      { "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Tariel, Reckoner of Souls", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Tariel, Reckoner of Souls", "Grizzly Bears"] },
        { "graveyard_has": ["Lightning Bolt"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "no creature card in the opponent's graveyard: nothing happens",
    "players": [
      { "battlefield": ["Tariel, Reckoner of Souls"] },
      { "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Tariel, Reckoner of Souls", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Tariel, Reckoner of Souls"], "battlefield_lacks": ["Lightning Bolt"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "target must be an opponent: targeting yourself is illegal",
    "players": [
      { "battlefield": ["Tariel, Reckoner of Souls"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Tariel, Reckoner of Souls", "targets": ["p0"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] },
        {}
      ]
    }
  }
]
