[
 {
  "name": "bounce opponent's creature, its controller draws",
  "players": [
   {
    "hand": [
     "Call to Heel"
    ],
    "battlefield": [
     "Island",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Call to Heel",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 0,
     "graveyard": [
      "Call to Heel"
     ]
    },
    {
     "hand_count": 2,
     "battlefield": []
    }
   ]
  }
 },
 {
  "name": "bounce own creature, I draw",
  "players": [
   {
    "hand": [
     "Call to Heel"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Call to Heel",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 2,
     "battlefield": [
      "Island",
      "Island"
     ]
    },
    {
     "hand_count": 0
    }
   ]
  }
 },
 {
  "name": "ruling: the controller at resolution draws, not the owner (I bounce a creature I stole)",
  "players": [
   { "hand": ["Ritual of the Machine", "Call to Heel"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Island", "Island", "Island", "Llanowar Elves"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Ritual of the Machine", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Call to Heel", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 1, "graveyard_has": ["Call to Heel", "Ritual of the Machine", "Llanowar Elves"] },
    { "hand_count": 1, "battlefield_lacks": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: if the target is gone before Call to Heel resolves, it does nothing and no one draws",
  "players": [
   { "hand": ["Call to Heel"], "battlefield": ["Island", "Island"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Call to Heel", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 0, "graveyard_has": ["Call to Heel"] },
    { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
   ]
  }
 }
]