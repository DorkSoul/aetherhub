[
  {
    "name": "beginning of combat: copies a noncreature artifact as a 4/4 Mishra's Warform",
    "players": [
      { "battlefield": ["Mishra, Eminent One", "Abzan Banner"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mishra, Eminent One", "Abzan Banner", "Mishra's Warform"] },
        {}
      ],
      "pt": { "Mishra's Warform": [4, 4] }
    }
  },
  {
    "name": "the token is sacrificed at the beginning of the next end step",
    "players": [
      { "battlefield": ["Mishra, Eminent One", "Abzan Banner"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mishra, Eminent One", "Abzan Banner"], "battlefield_lacks": ["Mishra's Warform"] },
        {}
      ]
    }
  },
  {
    "name": "only noncreature artifacts can be copied: an artifact creature alone gives no token",
    "players": [
      { "battlefield": ["Mishra, Eminent One", "Ornithopter"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mishra, Eminent One", "Ornithopter"], "battlefield_lacks": ["Mishra's Warform"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Warform copy does not copy the original's tapped status (it enters untapped)",
    "players": [ { "battlefield": ["Mishra, Eminent One", { "name": "Abzan Banner", "tapped": true }] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Mishra, Eminent One", "Abzan Banner", "Mishra's Warform"] }, {} ],
      "tapped": { "Mishra's Warform": false, "Abzan Banner": true }
    }
  }
]
