[
  {
    "name": "tapping your Mountain adds an extra R",
    "players": [
      {
        "battlefield": [
          "Gauntlet of Might",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Mountain"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "R": 2
          }
        },
        {}
      ]
    }
  },
  {
    "name": "an opponent's Mountain gives its controller the extra R",
    "players": [
      {
        "battlefield": [
          "Gauntlet of Might"
        ]
      },
      {
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "tap_for_mana": "Mountain",
        "player": 1
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {}
        },
        {
          "pool": {
            "R": 2
          }
        }
      ]
    }
  },
  {
    "name": "red creatures get +1/+1",
    "players": [
      {
        "battlefield": [
          "Gauntlet of Might",
          "Goblin Soothsayer"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Goblin Soothsayer": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "tapping a Forest adds no extra mana",
    "players": [
      {
        "battlefield": [
          "Gauntlet of Might",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Forest"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "G": 1
          }
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a dual Mountain tapped for blue still adds an extra R",
    "players": [ { "battlefield": ["Gauntlet of Might", "Volcanic Island"] }, {} ],
    "steps": [ { "tap_for_mana": "Volcanic Island", "color": "U" } ],
    "expect": { "players": [ { "pool": { "U": 1, "R": 1 } }, {} ] }
  },
  {
    "name": "ruling: a dual Mountain tapped for red adds an extra R",
    "players": [ { "battlefield": ["Gauntlet of Might", "Volcanic Island"] }, {} ],
    "steps": [ { "tap_for_mana": "Volcanic Island", "color": "R" } ],
    "expect": { "players": [ { "pool": { "R": 2 } }, {} ] }
  }
