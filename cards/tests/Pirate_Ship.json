[
  {
    "name": "attacks when the defending player controls an Island",
    "players": [
      { "battlefield": ["Pirate Ship", "Island"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "attack": [ { "card": "Pirate Ship", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "cannot attack when the defending player controls no Island",
    "players": [
      { "battlefield": ["Pirate Ship", "Island"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "attack": [ { "card": "Pirate Ship", "at": "p1" } ], "illegal": true }
    ]
  },
  {
    "name": "pings any target by tapping",
    "players": [
      { "battlefield": ["Pirate Ship", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Pirate Ship", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 19 } ], "tapped": { "Pirate Ship": true } }
  },
  {
    "name": "sacrificed when its controller controls no Islands",
    "players": [
      { "battlefield": ["Pirate Ship"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }
    ],
    "expect": { "players": [ { "battlefield": [], "graveyard": ["Pirate Ship"] }, {} ] }
  },
  {
    "name": "cannot attack into a Forest-only defender: the Ship is dropped and the second attacker deals 2",
    "players": [
      { "battlefield": ["Pirate Ship", "Island", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "attack": [ { "card": "Pirate Ship", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  }
]
