[
  {
    "name": "exiles target creature and its controller gets a blue Bird",
    "players": [
      {
        "hand": [
          "Ravenform"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Ravenform",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "exile": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Bird 1-1 Blue Flying"
          ]
        }
      ]
    }
  },
  {
    "name": "targeting your own creature gives the Bird to you",
    "players": [
      {
        "hand": [
          "Ravenform"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Ravenform",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Bird 1-1 Blue Flying"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "foretold for U and cast on a later turn",
    "players": [
      {
        "hand": [
          "Ravenform"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Ravenform",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Ravenform",
        "alt": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "exile": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Bird 1-1 Blue Flying"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a foretold non-instant can't be cast on the turn it was foretold",
    "players": [
      { "hand": ["Ravenform"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Ravenform", "ability": 0 },
      { "resolve": true },
      { "cast": "Ravenform", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "players": [ { "exile": ["Ravenform"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: Ravenform does nothing if its target is gone when it resolves",
    "players": [
      { "hand": ["Ravenform"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ravenform", "targets": ["Grizzly Bears"] },
      { "cast": "Doom Blade", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "battlefield_lacks": ["Bird 1-1 Blue Flying"], "graveyard": ["Ravenform"] },
      { "battlefield_lacks": ["Bird 1-1 Blue Flying"], "graveyard": ["Doom Blade", "Grizzly Bears"] }
    ] }
  },
  {
    "name": "ruling: foretelling is a special action you can take in response to a spell on your turn",
    "players": [
      { "hand": ["Ravenform", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Ravenform", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Ravenform"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] }
  }
]
