[
  {
    "name": "one enchantment (itself): each attacker costs {1}",
    "players": [
      { "battlefield": ["Grizzly Bears", "Plains"] },
      { "battlefield": ["Sphere of Safety"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ],
      "tapped": { "Plains": true }
    }
  },
  {
    "name": "cannot attack without paying the tax",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Sphere of Safety"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "X counts every enchantment you control (two enchantments = {2} per attacker)",
    "players": [
      { "battlefield": ["Grizzly Bears", "Plains"] },
      { "battlefield": ["Sphere of Safety", "Kismet"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "two enchantments: two mana pays for one attacker",
    "players": [
      { "battlefield": ["Grizzly Bears", "Plains", "Plains"] },
      { "battlefield": ["Sphere of Safety", "Kismet"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ],
      "tapped": { "Plains": true }
    }
  },
  {
    "name": "protects planeswalkers you control: attacking them without paying does nothing",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Sphere of Safety", "Test Walker"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "Test Walker" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ],
      "counters": { "Test Walker": { "Loyalty": 4 } },
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: an attacks-if-able creature may simply not attack when the tax is not paid",
    "players": [
      { "battlefield": [ { "name": "Juggernaut", "sick": false } ] },
      { "battlefield": ["Sphere of Safety"] }
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ],
      "tapped": { "Juggernaut": false }
    }
  }
]
