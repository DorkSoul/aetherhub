[
 {
  "name": "sacrificed when its controller casts a spell",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Illusory Demon"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard_has": ["Illusory Demon", "Lightning Bolt"] }, { "life": 17 } ] }
 },
 {
  "name": "an opponent casting a spell does not sacrifice it",
  "players": [ { "battlefield": ["Illusory Demon"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
  "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Illusory Demon"], "life": 17 }, {} ] }
 },
 {
  "name": "ruling: the sacrifice trigger resolves before the spell, which still resolves",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Illusory Demon"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "pass": true }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Illusory Demon", "Lightning Bolt"] }, { "life": 17 } ] }
 }
]
