 {
  "name": "ruling: the cast trigger resolves before the targeting spell, even when that spell is countered",
  "players": [
   { "hand": ["Giant Growth"], "battlefield": ["Forest", "Hero of the Nyxborn", "Grizzly Bears"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": ["Hero of the Nyxborn"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [{"stack": "Giant Growth"}] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Giant Growth"], "battlefield_has": ["Hero of the Nyxborn"] }, { "graveyard": ["Counterspell"] } ],
   "pt": { "Grizzly Bears": [3, 2] }
  }
 },
 {
  "name": "ruling: a creature that enters after the trigger resolved does not get +1/+0",
  "players": [
