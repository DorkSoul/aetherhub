[
  { "name": "search mode puts a basic land into hand",
    "players": [ { "hand": ["Thirsting Roots"], "battlefield": ["Forest"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Thirsting Roots", "answers": [0] }, { "resolve": true, "answers": ["Forest"] } ],
    "expect": { "players": [ { "hand": ["Forest"] }, {} ] } },
  { "name": "proliferate mode adds a counter to the chosen permanent",
    "players": [ { "hand": ["Thirsting Roots"], "battlefield": ["Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "cast": "Thirsting Roots", "answers": [1] }, { "resolve": true } ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 2 } } } },
  { "name": "ruling: proliferate adds one of each kind a player already has (poison and energy)",
    "players": [ { "hand": ["Thirsting Roots"], "battlefield": ["Forest"] }, { "poison": 1, "energy": 2 } ],
    "steps": [ { "cast": "Thirsting Roots", "answers": [1] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "poison": 2, "energy": 3 } ] } },
  { "name": "ruling: proliferate may choose no permanents or players at all",
    "players": [ { "hand": ["Thirsting Roots"], "battlefield": ["Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "cast": "Thirsting Roots", "answers": [1] }, { "resolve": true, "answers": [[]] } ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 } } } },
  { "name": "ruling: a whenever-you-proliferate trigger still triggers when nothing is chosen",
    "players": [ { "hand": ["Thirsting Roots"], "battlefield": ["Forest", "Scheming Aspirant", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "cast": "Thirsting Roots", "answers": [1] }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "life": 22 }, { "life": 18 } ] } },
  { "name": "ruling: proliferate can choose an opponent's permanent with a counter",
    "players": [ { "hand": ["Thirsting Roots"], "battlefield": ["Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, { "battlefield": [ { "name": "Hill Giant", "counters": { "p1p1": 1 } } ] } ],
    "steps": [ { "cast": "Thirsting Roots", "answers": [1] }, { "resolve": true } ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 2 }, "Hill Giant": { "p1p1": 2 } } } }
]
