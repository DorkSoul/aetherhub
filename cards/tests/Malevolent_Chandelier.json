[
 {
  "name": "puts a graveyard card on the bottom of its owner's library",
  "players": [
   { "battlefield": ["Malevolent Chandelier", "Forest", "Forest"] },
   { "graveyard": ["Hill Giant"] }
  ],
  "steps": [
   { "activate": "Malevolent Chandelier", "ability": 0, "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Malevolent Chandelier"] }, { "graveyard": [], "library_count": 21 } ]
  }
 },
 {
  "name": "can target your own graveyard card",
  "players": [
   { "battlefield": ["Malevolent Chandelier", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Malevolent Chandelier", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": [], "library_count": 21 }, {} ]
  }
 }
]
