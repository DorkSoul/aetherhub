[
 { "name": "enters with a counter per card in hand, then discards the hand",
   "players": [ { "hand": ["Thought Gorger", "Shock", "Plains"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Thought Gorger" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard": ["Shock", "Plains"] }, {} ], "counters": { "Thought Gorger": { "p1p1": 2 } }, "pt": { "Thought Gorger": [4, 4] } } },
 { "name": "empty hand: enters as a 2/2 with no counters",
   "players": [ { "hand": ["Thought Gorger"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Thought Gorger" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "pt": { "Thought Gorger": [2, 2] } } },
 { "name": "leaves the battlefield: draw a card for each +1/+1 counter",
   "players": [ { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", { "name": "Thought Gorger", "counters": { "p1p1": 2 } }] }, {} ],
   "steps": [ { "cast": "Murder", "targets": ["Thought Gorger"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2, "graveyard": ["Murder", "Thought Gorger"] }, {} ] } },
 { "name": "ruling: Shock in response to the enters trigger leaves no counters and no discard",
   "players": [ { "hand": ["Thought Gorger", "Shock", "Plains"], "battlefield": ["Swamp", "Swamp", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Thought Gorger" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Shock", "targets": ["Thought Gorger"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard": ["Shock", "Thought Gorger"] }, {} ] } },
 { "name": "ruling: counters put on by the enters trigger are counted when it leaves",
   "players": [ { "hand": ["Thought Gorger", "Shock", "Plains"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains"] }, { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] } ],
   "steps": [ { "cast": "Thought Gorger" }, { "resolve": true }, { "resolve": true }, { "pass": true }, { "cast": "Murder", "targets": ["Thought Gorger"], "player": 1 }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2, "graveyard": ["Shock", "Plains", "Thought Gorger"] }, { "graveyard": ["Murder"] } ] } }
]
