    "expect": {
      "players": [{}, { "life": 18 }],
      "stack_empty": true
    }
  },
  {
    "name": "replicate paid twice copies it twice: three damage total",
    "players": [
      { "hand": ["Pyromatics"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Pyromatics", "targets": ["p1"], "answers": [2] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 17 }],
      "stack_empty": true
    }
  }
