[
  {
    "name": "without replicate deals 1 damage to the target player",
    "players": [
      { "hand": ["Pyromatics"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Pyromatics", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 19 }],
