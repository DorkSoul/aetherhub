[
  { "name": "cycling for 2 draws a card",
    "players": [ { "hand": ["Shimmering Barrier"], "battlefield": ["Plains", "Plains"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Shimmering Barrier", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Shimmering Barrier"] }, {} ] }
  },
  { "name": "cast as a 1/3 defender with first strike",
    "players": [ { "hand": ["Shimmering Barrier"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Shimmering Barrier" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Shimmering Barrier"] }, {} ], "pt": { "Shimmering Barrier": [1, 3] }, "keywords": { "Shimmering Barrier": ["Defender", "FirstStrike"] } }
  },
  { "name": "ruling: cycling is an ability, so a spell counter (Counterspell) has no target",
    "players": [ { "hand": ["Shimmering Barrier"], "battlefield": ["Plains", "Plains"], "library": ["Grizzly Bears"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Shimmering Barrier", "ability": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1, "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Shimmering Barrier"] }, { "hand": ["Counterspell"] } ] }
  },
  { "name": "ruling: Stifle counters the cycling ability; the card is still discarded and no card is drawn",
    "players": [ { "hand": ["Shimmering Barrier"], "battlefield": ["Plains", "Plains"], "library": ["Grizzly Bears"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Shimmering Barrier", "ability": 0 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Shimmering Barrier" }] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Shimmering Barrier"] }, { "graveyard": ["Stifle"] } ] }
  }
]
