[
  { "name": "gains 2 life when it attacks and isn't blocked",
    "players": [ { "battlefield": ["Merchant Ship", "Island"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [ { "card": "Merchant Ship", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 22 }, { "life": 20 } ] } },
  { "name": "can't attack when the defending player controls no Island",
    "players": [ { "battlefield": ["Merchant Ship", "Island"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "attack": [ { "card": "Merchant Ship", "at": "p1" } ], "illegal": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "sacrificed when you control no Islands",
    "players": [ { "battlefield": ["Merchant Ship"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Merchant Ship"] }, {} ] } },
  { "name": "stays while you control an Island",
    "players": [ { "battlefield": ["Island", "Merchant Ship"] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Merchant Ship"] }, {} ] } },
  { "name": "with an Island of its own, it still can't attack a player with no Island (other attacker connects)",
    "players": [ { "battlefield": ["Merchant Ship", "Grizzly Bears", "Island"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "attack": [ { "card": "Merchant Ship", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
  { "name": "ruling: when the attacker is blocked, the 'attacks and isn't blocked' trigger does not happen",
    "players": [ { "battlefield": ["Merchant Ship", "Island"] }, { "battlefield": ["Island", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Merchant Ship", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Merchant Ship" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Merchant Ship"] }, {} ] } }
]
