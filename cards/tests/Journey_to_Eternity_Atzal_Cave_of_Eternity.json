[
  {
    "name": "when the enchanted creature dies it returns under your control and the Aura returns transformed as Atzal",
    "players": [
      { "hand": ["Journey to Eternity // Atzal, Cave of Eternity"], "battlefield": ["Swamp", "Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Journey to Eternity // Atzal, Cave of Eternity", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Atzal, Cave of Eternity"], "battlefield_lacks": ["Journey to Eternity // Atzal, Cave of Eternity"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "a creature the Aura does not enchant dying leaves the Aura where it is",
    "players": [
      { "hand": ["Journey to Eternity // Atzal, Cave of Eternity"], "battlefield": ["Swamp", "Forest", "Forest", "Grizzly Bears", "Hill Giant"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Journey to Eternity // Atzal, Cave of Eternity", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"], "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Journey to Eternity // Atzal, Cave of Eternity"], "graveyard_has": ["Hill Giant"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "{3}{B}{G}, {T}: return a creature card from my graveyard to the battlefield",
    "players": [
      { "battlefield": ["Atzal, Cave of Eternity", "Swamp", "Forest", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Atzal, Cave of Eternity", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "four mana sources are not enough for the Atzal ability",
    "players": [
      { "battlefield": ["Atzal, Cave of Eternity", "Swamp", "Forest", "Island"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [ { "activate": "Atzal, Cave of Eternity", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "ruling: a creature you control but do not own returns under your control when it dies",
    "players": [
      { "hand": ["Control Magic", "Journey to Eternity // Atzal, Cave of Eternity", "Dead Weight"], "battlefield": ["Island", "Island", "Island", "Island", "Swamp", "Swamp", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Control Magic", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Journey to Eternity // Atzal, Cave of Eternity", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Dead Weight", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Atzal, Cave of Eternity"] },
        { "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: another player gaining control of the enchanted creature puts the Aura into its owner's graveyard",
    "players": [
      { "hand": ["Journey to Eternity // Atzal, Cave of Eternity"], "battlefield": ["Swamp", "Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Journey to Eternity // Atzal, Cave of Eternity", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Journey to Eternity // Atzal, Cave of Eternity"] },
        { "battlefield_has": ["Grizzly Bears", "Control Magic"] }
      ]
    }
  }
]
