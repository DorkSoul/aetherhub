[
 { "name": "redirects the next damage from the chosen source to you",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jade Monolith", "Mountain", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Jade Monolith", "targets": ["Grizzly Bears"] },
              { "resolve": true, "answers": ["Lightning Bolt"] },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 17, "graveyard": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "damage to a creature that was not targeted is not redirected",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jade Monolith", "Mountain", "Mountain"] },
                { "battlefield": ["Grizzly Bears", "Black Knight"] } ],
   "steps": [ { "activate": "Jade Monolith", "targets": ["Black Knight"] },
              { "resolve": true, "answers": ["Lightning Bolt"] },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"], "battlefield": ["Black Knight"] } ] } },
 { "name": "a source that was not chosen is not redirected",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jade Monolith", "Mountain", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Jade Monolith", "targets": ["Grizzly Bears"] },
              { "resolve": true, "answers": ["Mountain"] },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } }
]
