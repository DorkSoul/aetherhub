[
  { "name": "affinity: two snow lands make it cost two less",
    "players": [ { "hand": ["Icebreaker Kraken"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Snow-Covered Island", "Snow-Covered Island"] }, {} ],
    "steps": [ { "cast": "Icebreaker Kraken" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Icebreaker Kraken"], "hand_count": 0 }, {} ] } },
  { "name": "affinity boundary: one snow land is not enough with nine lands",
    "players": [ { "hand": ["Icebreaker Kraken"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Snow-Covered Island"] }, {} ],
    "steps": [ { "cast": "Icebreaker Kraken", "illegal": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_lacks": ["Icebreaker Kraken"] }, {} ] } },
  { "name": "return three snow lands to hand: returns the Kraken to hand",
    "players": [ { "battlefield": ["Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", { "name": "Icebreaker Kraken" }] }, {} ],
    "steps": [ { "activate": "Icebreaker Kraken", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 4, "battlefield_lacks": ["Icebreaker Kraken", "Snow-Covered Island"] }, {} ] } },
  { "name": "ruling: the opponent's tapped creatures do not untap during their next untap step",
    "players": [ { "hand": ["Icebreaker Kraken"], "battlefield": ["Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, { "name": "Hill Giant", "tapped": true } ] } ],
    "steps": [ { "cast": "Icebreaker Kraken" }, { "resolve": true }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Icebreaker Kraken"] }, { "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ], "tapped": { "Grizzly Bears": true, "Hill Giant": true } } },
  { "name": "ruling: the enters trigger does not tap an untapped creature",
    "players": [ { "hand": ["Icebreaker Kraken"], "battlefield": ["Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Icebreaker Kraken" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Hill Giant"] } ], "tapped": { "Hill Giant": false } } }
]
