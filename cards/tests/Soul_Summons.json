   "players": [ { "hand": ["Soul Summons"], "battlefield": ["Plains", "Plains"], "library": ["Island", "Forest"] }, {} ],
   "steps": [ { "cast": "Soul Summons" }, { "resolve": true } ],
   "expect": { "players": [ { "library_count": 1, "graveyard": ["Soul Summons"] }, {} ] } },
 { "name": "ruling: the face-down manifest is a colorless 2/2 (no printed characteristics)",
   "players": [ { "hand": ["Soul Summons"], "battlefield": ["Plains", "Plains"], "library": ["Savannah Lions", "Forest"] }, {} ],
   "steps": [ { "cast": "Soul Summons" }, { "resolve": true } ],
   "expect": { "pt": { "Savannah Lions": [2, 2] }, "colors": { "Savannah Lions": [] }, "players": [ { "library_count": 1 }, {} ] } },
 { "name": "ruling: a manifested creature card is turned face up for its mana cost (special action, no stack)",
   "players": [ { "hand": ["Soul Summons"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Savannah Lions", "Forest"] }, {} ],
   "steps": [ { "cast": "Soul Summons" }, { "resolve": true }, { "activate": "Savannah Lions" } ],
   "expect": { "pt": { "Savannah Lions": [2, 1] }, "stack_empty": true, "players": [ { "battlefield_has": ["Savannah Lions"], "library_count": 1 }, {} ] } },
 { "name": "ruling: a manifested non-creature card cannot be turned face up",
   "players": [ { "hand": ["Soul Summons"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island", "Forest"] }, {} ],
   "steps": [ { "cast": "Soul Summons" }, { "resolve": true }, { "activate": "Island", "illegal": true } ],
   "expect": { "pt": { "Island": [2, 2] }, "players": [ { "library_count": 1 }, {} ] } }
