      { "hand": ["Arcane Signet"], "battlefield": ["Iron Man, Master of Machines", "Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Arcane Signet" },
      { "resolve": true },
      { "attack": [ { "card": "Iron Man, Master of Machines", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "life": 18 } ]
    }
  },
  {
    "name": "no draw when no artifact entered this turn",
    "players": [
      { "battlefield": ["Iron Man, Master of Machines", "Arcane Signet"] },
