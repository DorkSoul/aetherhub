[
  { "name": "at your end step an opponent gains a creature you control with two counters, tapped",
    "players": [ { "battlefield": ["Jon Irenicus, Shattered One", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "End", "targets": ["Grizzly Bears"] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] } ],
                "pt": { "Grizzly Bears": [4, 4] }, "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "p1p1": 2 } } } },
  { "name": "with no creature of yours to give, nothing changes hands",
    "players": [ { "battlefield": ["Jon Irenicus, Shattered One"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Jon Irenicus, Shattered One"] }, { "battlefield": [] } ] } },
  { "name": "a creature you own but an opponent controls attacks: you draw a card",
    "players": [ { "battlefield": ["Jon Irenicus, Shattered One", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "End", "targets": ["Grizzly Bears"] }, { "advance_to": "Main1", "player": 1 }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "an opponent's own creature attacking does not draw",
    "players": [ { "battlefield": ["Jon Irenicus, Shattered One"] }, { "battlefield": [ { "name": "Hill Giant", "sick": false } ] } ],
    "steps": [ { "advance_to": "Main1", "player": 1 }, { "attack": [ { "card": "Hill Giant", "at": "p0" } ] }, { "block": [], "player": 0 } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "ruling: a token you own, given to the opponent, draws you a card when it attacks",
    "players": [ { "hand": ["Dragon Fodder"], "battlefield": ["Jon Irenicus, Shattered One", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Dragon Fodder" }, { "resolve": true }, { "advance_to": "End", "targets": ["Goblin"] }, { "advance_to": "Main1", "player": 1 }, { "attack": [ { "card": "Goblin", "at": "p0" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } }
]
