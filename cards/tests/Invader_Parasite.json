[
 {
  "name": "imprint: ETB exiles target land",
  "players": [
   { "hand": ["Invader Parasite"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Island"] }
  ],
  "steps": [
   { "cast": "Invader Parasite" },
   { "resolve": true, "targets": ["Island"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Invader Parasite"] },
    { "exile": ["Island"], "battlefield": [] }
   ]
  }
 },
 {
  "name": "an opponent's land with the exiled card's name entering deals 2 damage to that player",
  "players": [
   { "hand": ["Invader Parasite"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "hand": ["Island"], "battlefield": ["Island"] }
  ],
  "steps": [
   { "cast": "Invader Parasite" },
   { "resolve": true, "targets": ["Island"] },
   { "resolve": true },
   { "advance_to": "Main1" },
   { "play_land": "Island", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "life": 18, "battlefield_has": ["Island"] }
   ]
  }
 },
 {
  "name": "an opponent's land with a different name entering does not trigger",
  "players": [
   { "hand": ["Invader Parasite"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "hand": ["Forest"], "battlefield": ["Island"] }
  ],
  "steps": [
   { "cast": "Invader Parasite" },
   { "resolve": true, "targets": ["Island"] },
   { "resolve": true },
   { "advance_to": "Main1" },
   { "play_land": "Forest", "player": 1 }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "life": 20, "battlefield_has": ["Forest"] }
   ]
  }
 }
]
