[
 { "name": "ETB creates a colorless Soldier artifact token",
   "players": [ { "hand": ["Scrapwork Cohort"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Scrapwork Cohort" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Scrapwork Cohort", "Soldier 1-1 Colorless Artifact"] }, {} ] } },
 { "name": "unearth returns it with haste and it is exiled at end step",
   "players": [ { "graveyard": ["Scrapwork Cohort"], "battlefield": ["Plains", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Scrapwork Cohort" }, { "resolve": true },
              { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Scrapwork Cohort"], "battlefield_has": [] }, {} ] } },
 { "name": "ruling: unearth grants haste, so the returned creature can attack this turn",
   "players": [ { "graveyard": ["Scrapwork Cohort"], "battlefield": ["Plains", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Scrapwork Cohort" }, { "resolve": true },
              { "advance_to": "BeginCombat" },
              { "attack": [{ "card": "Scrapwork Cohort", "at": "p1" }] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Scrapwork Cohort"] }, { "life": 17 } ] } },
 { "name": "ruling: an unearthed creature that would die in combat is exiled instead",
   "players": [ { "graveyard": ["Scrapwork Cohort"], "battlefield": ["Plains", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "activate": "Scrapwork Cohort" }, { "resolve": true },
              { "advance_to": "BeginCombat" },
              { "attack": [{ "card": "Scrapwork Cohort", "at": "p1" }] },
              { "block": [{ "blocker": "Hill Giant", "attacker": "Scrapwork Cohort" }], "player": 1 },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "exile": ["Scrapwork Cohort"], "graveyard": [] }, {} ] } }
]
