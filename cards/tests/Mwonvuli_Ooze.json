 {
  "name": "ruling: P/T changes when the cumulative upkeep resolves, not when it triggers",
  "players": [
   { "battlefield": [ { "name": "Mwonvuli Ooze", "counters": { "age": 1 } }, "Forest", "Forest", "Forest", "Forest" ] },
   {}
  ],
  "steps": [ { "advance_to": "Upkeep", "hold": true } ],
  "expect": {
   "counters": { "Mwonvuli Ooze": { "age": 1 } },
   "pt": { "Mwonvuli Ooze": [3, 3] }
  }
 },
 {
  "name": "ruling: after the cumulative upkeep resolves (paid) the counter is added and P/T is 5/5",
  "players": [
   { "battlefield": [ { "name": "Mwonvuli Ooze", "counters": { "age": 1 } }, "Forest", "Forest", "Forest", "Forest" ] },
   {}
  ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
  "expect": {
   "counters": { "Mwonvuli Ooze": { "age": 2 } },
   "pt": { "Mwonvuli Ooze": [5, 5] },
   "players": [ { "battlefield_has": ["Mwonvuli Ooze"] }, {} ]
  }
 }
