[
  { "name": "one card goes to hand, one is exiled, the last goes to the bottom",
    "players": [ { "hand": ["Expressive Iteration"], "battlefield": ["Island", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Expressive Iteration" }, { "resolve": true, "answers": [0, 0] } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "exile": ["Island"], "library_count": 1 }, {} ] } },
  { "name": "the exiled card can be played this turn",
    "players": [ { "hand": ["Expressive Iteration"], "battlefield": ["Island", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Expressive Iteration" }, { "resolve": true, "answers": [0, 0] }, { "play_land": "Island" } ],
    "expect": { "players": [ { "exile": [], "battlefield_has": ["Island"] }, {} ] } },
  { "name": "with fewer than three cards, the exile choice is still made from what is there",
    "players": [ { "hand": ["Expressive Iteration"], "battlefield": ["Island", "Mountain"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "cast": "Expressive Iteration" }, { "resolve": true, "answers": [0, 0] } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "exile": ["Forest"], "library_count": 0 }, {} ] } },
  { "name": "ruling: an exiled land can't be played when the land drop was already used",
    "players": [ { "hand": ["Expressive Iteration", "Forest"], "battlefield": ["Island", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "cast": "Expressive Iteration" }, { "resolve": true, "answers": [0, 0] }, { "play_land": "Island", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Island"] }, {} ] } },
  { "name": "ruling: an exiled creature must still be paid for (one Forest is not enough for Grizzly Bears)",
    "players": [ { "hand": ["Expressive Iteration"], "battlefield": ["Island", "Mountain", "Forest"], "library": ["Grizzly Bears", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Expressive Iteration" }, { "resolve": true, "answers": [2, 0] }, { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: with enough mana the exiled creature can be cast this turn",
    "players": [ { "hand": ["Expressive Iteration"], "battlefield": ["Island", "Mountain", "Forest", "Forest"], "library": ["Grizzly Bears", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Expressive Iteration" }, { "resolve": true, "answers": [2, 0] }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": [] }, {} ] } },
  { "name": "ruling: a card that is exiled and not played stays exiled on later turns",
    "players": [ { "hand": ["Expressive Iteration"], "battlefield": ["Island", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Expressive Iteration" }, { "resolve": true, "answers": [0, 0] }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "exile": ["Island"] }, {} ] } }
]
