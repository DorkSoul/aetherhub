[
 { "name": "imprint: each player exiles the top three cards of their library",
   "players": [ { "hand": ["Knowledge Pool"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Forest", "Grizzly Bears", "Swamp"] },
                 { "library": ["Plains", "Plains", "Plains", "Plains"] } ],
   "steps": [ { "cast": "Knowledge Pool" }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Island", "Forest", "Grizzly Bears"], "library_count": 1, "battlefield_has": ["Knowledge Pool"] },
                            { "exile": ["Plains", "Plains", "Plains"], "library_count": 1 } ] } },
 { "name": "a spell cast from hand is exiled and its caster may cast a nonland card exiled with the Pool for free",
   "players": [ { "hand": ["Knowledge Pool", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] },
                 {} ],
   "steps": [ { "cast": "Knowledge Pool" }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "resolve": true, "answers": ["Grizzly Bears"] } ],
   "expect": { "players": [ { "battlefield_has": ["Knowledge Pool", "Grizzly Bears"], "battlefield_lacks": ["Lightning Bolt"], "exile": ["Island", "Forest", "Lightning Bolt"] },
                            { "life": 20 } ] } },
 { "name": "the caster may decline to cast a card exiled with the Pool (the card stays exiled)",
   "players": [ { "hand": ["Knowledge Pool", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] },
                 {} ],
   "steps": [ { "cast": "Knowledge Pool" }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears", "Island", "Forest", "Lightning Bolt"] },
                            { "life": 20 } ] } },
 { "name": "ruling: a card cast for free from exile may be a creature cast on the opponent's turn (timing is ignored)",
   "players": [ { "hand": ["Knowledge Pool", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] },
                 {} ],
   "steps": [ { "cast": "Knowledge Pool" }, { "resolve": true },
              { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "pass": true, "player": 1 },
              { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "resolve": true, "answers": ["Grizzly Bears"] } ],
   "expect": { "players": [ { "battlefield_has": ["Knowledge Pool", "Grizzly Bears"], "exile": ["Island", "Forest", "Lightning Bolt"] },
                            { "life": 20 } ] } },
 { "name": "ruling: with no nonland card exiled by the Pool, the original spell is still exiled and does not resolve",
   "players": [ { "hand": ["Knowledge Pool", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Forest", "Swamp"] },
                 {} ],
   "steps": [ { "cast": "Knowledge Pool" }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Island", "Forest", "Swamp", "Lightning Bolt"], "battlefield_has": ["Knowledge Pool"] },
                            { "life": 20 } ] } }
]
