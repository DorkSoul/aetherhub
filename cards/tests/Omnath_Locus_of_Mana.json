[
 {
  "name": "unspent G persists and pumps Omnath",
  "players": [
   {
    "battlefield": [
     "Omnath, Locus of Mana",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Forest"
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "pt": {
    "Omnath, Locus of Mana": [
     2,
     2
    ]
   }
  }
 },
 {
  "name": "ruling: unspent green mana kept into Main2 pays for Llanowar Elves",
  "players": [
   { "battlefield": ["Omnath, Locus of Mana", "Forest"], "hand": ["Llanowar Elves"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Forest" },
   { "advance_to": "Main2" },
   { "cast": "Llanowar Elves" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Llanowar Elves"] }, {} ]
  }
 },
 {
  "name": "ruling: unspent white is lost at the end of the phase while unspent green is kept",
  "players": [
   { "battlefield": ["Omnath, Locus of Mana", "Forest", "Plains"], "hand": ["Savannah Lions"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Forest" },
   { "tap_for_mana": "Plains" },
   { "advance_to": "Main2" },
   { "cast": "Savannah Lions", "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Omnath, Locus of Mana"] }, {} ],
   "pt": { "Omnath, Locus of Mana": [2, 2] }
  }
 },
 {
  "name": "ruling: green mana stays unspent after Omnath leaves the battlefield until the end of the step",
  "players": [
   { "battlefield": ["Omnath, Locus of Mana", "Forest"], "hand": ["Llanowar Elves"] },
   { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "tap_for_mana": "Forest" },
   { "pass": true },
   { "cast": "Doom Blade", "player": 1, "targets": ["Omnath, Locus of Mana"] },
   { "resolve": true, "auto": true },
   { "cast": "Llanowar Elves" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Llanowar Elves"], "graveyard_has": ["Omnath, Locus of Mana"] }, { "graveyard_has": ["Doom Blade"] } ]
  }
 }
]
