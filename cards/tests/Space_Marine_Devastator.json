[
  {
    "name": "a 3/3 token",
    "players": [
      {
        "battlefield": [
          "Space Marine Devastator"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Space Marine Devastator": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "cast without squad destroys the targeted artifact",
    "players": [
      { "hand": ["Space Marine Devastator"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [ { "cast": "Space Marine Devastator" }, { "resolve": true, "targets": ["Sol Ring"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Space Marine Devastator"] }, { "graveyard": ["Sol Ring"] } ], "pt": { "Space Marine Devastator": [3, 3] } }
  },
  {
    "name": "squad paid once: two Devastators enter, the copy also has its ETB",
    "players": [
      { "hand": ["Space Marine Devastator"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [ { "cast": "Space Marine Devastator", "answers": [1] }, { "resolve": true, "targets": ["Sol Ring"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Space Marine Devastator", "Space Marine Devastator"] }, { "graveyard": ["Sol Ring"] } ] }
  },
 {
  "name": "ruling: squad paid twice makes two copies, three Devastators in total",
  "players": [
    { "hand": ["Space Marine Devastator"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
    { "battlefield": ["Sol Ring"] }
  ],
  "steps": [ { "cast": "Space Marine Devastator", "answers": [2] }, { "resolve": true, "targets": ["Sol Ring"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Space Marine Devastator", "Space Marine Devastator", "Space Marine Devastator"] }, { "graveyard": ["Sol Ring"] } ] }
 },
 {
  "name": "ruling: a countered squad spell creates no tokens",
  "players": [
    { "hand": ["Space Marine Devastator"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
    { "hand": ["Essence Scatter"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [ { "cast": "Space Marine Devastator", "answers": [2] }, { "pass": true }, { "player": 1, "cast": "Essence Scatter", "targets": [{ "stack": "Space Marine Devastator" }] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_lacks": ["Space Marine Devastator"], "graveyard_has": ["Space Marine Devastator"] }, { "graveyard_has": ["Essence Scatter"] } ] }
 }
