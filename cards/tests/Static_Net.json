[
  { "name": "exiles the opponent's nonland permanent, gains 2 life and makes a tapped Powerstone",
    "players": [ { "hand": ["Static Net"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Static Net" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "battlefield_has": ["Static Net", "Powerstone"] }, { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"] } ] } },
  { "name": "no legal target (only opponent land): still gains 2 life and makes the Powerstone",
    "players": [ { "hand": ["Static Net"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "cast": "Static Net" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "battlefield_has": ["Powerstone"] }, { "battlefield_has": ["Forest"] } ] } },
  { "name": "ruling: an Aura attached to the exiled creature goes to its owner's graveyard",
    "players": [ { "hand": ["Pacifism", "Static Net"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Static Net" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Pacifism"], "life": 22 }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "ruling: when Static Net leaves the battlefield the exiled creature returns immediately",
    "players": [ { "hand": ["Static Net"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Disenchant"], "battlefield": ["Grizzly Bears", "Plains", "Plains"] } ],
    "steps": [
      { "cast": "Static Net" }, { "resolve": true }, { "resolve": true },
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Static Net"] },
      { "pass": true, "player": 1 },
      { "pass": true }
    ],
    "expect": { "players": [ { "graveyard": ["Static Net"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: Static Net leaving before its exile trigger resolves means nothing is exiled",
    "players": [ { "hand": ["Static Net"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Disenchant"], "battlefield": ["Grizzly Bears", "Plains", "Plains"] } ],
    "steps": [
      { "cast": "Static Net" }, { "resolve": true },
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Static Net"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Static Net"], "life": 22 }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an exiled token ceases to exist and does not return when Static Net leaves",
    "players": [ { "hand": ["Static Net"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Disenchant"], "battlefield": ["Powerstone", "Plains", "Plains"] } ],
    "steps": [
      { "cast": "Static Net" }, { "resolve": true }, { "resolve": true },
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Static Net"] },
      { "pass": true, "player": 1 },
      { "pass": true }
    ],
    "expect": { "players": [ { "graveyard": ["Static Net"] }, { "battlefield_lacks": ["Powerstone"] } ] } },
  { "name": "ruling: Powerstone mana pays for an artifact's activated ability (equip)",
    "players": [ { "battlefield": ["Powerstone", "Bonesplitter", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Bonesplitter", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 2] } } },
  { "name": "ruling: Powerstone mana cannot pay for a nonartifact spell",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Powerstone"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "life": 20 } ] } }
]
