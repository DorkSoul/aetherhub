[
  {
    "name": "destroys target enchantment",
    "players": [
      { "hand": ["Break Asunder"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Briar Patch"] }
    ],
    "steps": [
      { "cast": "Break Asunder", "targets": ["Briar Patch"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Break Asunder"] },
        { "graveyard": ["Briar Patch"] }
      ]
    }
  },
  {
    "name": "destroys target artifact",
    "players": [
      { "hand": ["Break Asunder"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Adventuring Gear", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Break Asunder", "targets": ["Adventuring Gear"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Break Asunder"] },
        { "graveyard": ["Adventuring Gear"], "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "cycling {2} discards it to draw a card",
    "players": [
      { "hand": ["Break Asunder"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Briar Patch"] }
    ],
    "steps": [
      { "activate": "Break Asunder", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Break Asunder"], "hand_count": 1 },
        { "battlefield": ["Briar Patch"] }
      ]
    }
  }
]
