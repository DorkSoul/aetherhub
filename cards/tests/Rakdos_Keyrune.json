[
  {
    "name": "{B}{R}: becomes a 3/1 first-strike Devil until end of turn",
    "players": [
      {
        "battlefield": [
          "Rakdos Keyrune",
          "Swamp",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rakdos Keyrune",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Rakdos Keyrune": [
          3,
          1
        ]
      },
      "keywords": {
        "Rakdos Keyrune": [
          "FirstStrike"
        ]
      }
    }
  },
  {
    "name": "taps for black or red mana to pay for a spell",
    "players": [
      {
        "hand": [
          "Mind Rot"
        ],
        "battlefield": [
          "Rakdos Keyrune",
          "Swamp",
          "Swamp"
        ]
      },
      {
        "hand": [
          "Island",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Mind Rot",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Mind Rot"
          ]
        },
        {
          "graveyard": [
            "Island",
            "Forest"
          ]
        }
      ],
      "tapped": {
        "Rakdos Keyrune": true
      }
    }
  },
  {
    "name": "ruling: animating again does not stack; it is still 3/1",
    "players": [ { "battlefield": ["Rakdos Keyrune", "Swamp", "Mountain", "Swamp", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Rakdos Keyrune", "ability": 0 },
      { "resolve": true },
      { "activate": "Rakdos Keyrune", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Rakdos Keyrune": [3, 1] } }
  },
  {
    "name": "ruling: a pump still applies after the Keyrune is animated",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Rakdos Keyrune", "Swamp", "Mountain", "Forest"] }, {} ],
    "steps": [
      { "activate": "Rakdos Keyrune", "ability": 0 },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Rakdos Keyrune"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Rakdos Keyrune": [6, 4] } }
  },
  {
    "name": "ruling: the Keyrune is colorless while the animation ability is on the stack",
    "players": [ { "battlefield": ["Rakdos Keyrune", "Swamp", "Mountain"] }, {} ],
    "steps": [ { "activate": "Rakdos Keyrune", "ability": 0 } ],
    "expect": { "colors": { "Rakdos Keyrune": [] } }
  },
  {
    "name": "ruling: once the animation resolves the Keyrune is black and red",
    "players": [ { "battlefield": ["Rakdos Keyrune", "Swamp", "Mountain"] }, {} ],
    "steps": [ { "activate": "Rakdos Keyrune", "ability": 0 }, { "resolve": true } ],
    "expect": { "colors": { "Rakdos Keyrune": ["B", "R"] } }
  }
]
