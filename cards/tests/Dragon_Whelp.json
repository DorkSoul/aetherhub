[
  {
    "name": "three {R} activations give +3/+0 and no sacrifice",
    "players": [
      { "battlefield": ["Dragon Whelp", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true }
    ],
    "expect": {
      "pt": { "Dragon Whelp": [5, 3] },
      "players": [ { "battlefield_has": ["Dragon Whelp"] }, {} ]
    }
  },
  {
    "name": "fourth activation in a turn: sacrificed at the beginning of the next end step",
    "players": [
      { "battlefield": ["Dragon Whelp", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Dragon Whelp"] }, {} ]
    }
  },
  { "name": "ruling: a fifth activation keeps adding +1/+0 (no limit on activations)",
    "players": [ { "battlefield": ["Dragon Whelp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true }
    ],
    "expect": {
      "pt": { "Dragon Whelp": [7, 3] },
      "players": [ { "battlefield_has": ["Dragon Whelp"] }, {} ]
    }
  },
  { "name": "ruling: a fourth activation in the end step is sacrificed at the next turn's end step, so it survives this end step",
    "players": [ { "battlefield": ["Dragon Whelp", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "advance_to": "End" },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Dragon Whelp"] }, {} ]
    }
  },
  { "name": "ruling: the end-step activation's sacrifice happens at the beginning of the next turn's end step",
    "players": [ { "battlefield": ["Dragon Whelp", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "advance_to": "End" },
      { "activate": "Dragon Whelp", "ability": 0 }, { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Dragon Whelp"] }, {} ]
    }
  }
]
