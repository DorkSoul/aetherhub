[
  {
    "name": "destroys target creature; its controller gets a 3/3 Ape",
    "players": [
      {
        "hand": [
          "Pongify"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Pongify",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Pongify"
          ],
          "battlefield": [
            "Island"
          ]
        },
        {
          "graveyard": [
            "Serra Angel"
          ],
          "battlefield": [
            "Ape"
          ]
        }
      ],
      "pt": {
        "Ape": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "targeting your own creature gives you the Ape",
    "players": [
      {
        "hand": [
          "Pongify"
        ],
        "battlefield": [
          "Island",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Pongify",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Pongify",
            "Grizzly Bears"
          ],
          "battlefield": [
            "Island",
            "Ape"
          ]
        },
        {
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "ruling: fizzles if its target is gone; the fizzled spell creates no Ape",
    "players": [
      { "hand": ["Pongify"], "battlefield": ["Island"] },
      { "hand": ["Pongify"], "battlefield": ["Island", "Serra Angel"] }
    ],
    "steps": [
      { "cast": "Pongify", "targets": ["Serra Angel"] },
      { "pass": true },
      { "cast": "Pongify", "player": 1, "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Pongify"], "battlefield": ["Island"] },
        { "graveyard": ["Pongify", "Serra Angel"], "battlefield": ["Island", "Ape"] }
      ],
      "pt": { "Ape": [3, 3] }
    }
  },
  {
    "name": "ruling: indestructible target survives, but its controller still gets the Ape",
    "players": [
      { "hand": ["Pongify"], "battlefield": ["Island"] },
      { "battlefield": ["Darksteel Myr"] }
    ],
    "steps": [
      { "cast": "Pongify", "targets": ["Darksteel Myr"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Pongify"] },
        { "battlefield_has": ["Darksteel Myr", "Ape"] }
      ]
    }
  }
]