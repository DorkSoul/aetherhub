      "players": [ {}, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "boundary: with no +1/+1 counters the target is not changed",
    "players": [
      { "battlefield": ["Vish Kal, Blood Arbiter"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Vish Kal, Blood Arbiter", "ability": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
