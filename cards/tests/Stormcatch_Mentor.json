[
  {
    "name": "instants you cast cost {1} less",
    "players": [
      { "hand": ["Stoke the Flames"], "battlefield": ["Stormcatch Mentor", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Stoke the Flames", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Stoke the Flames"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "creature spells are not discounted",
    "players": [
      { "hand": ["Hill Giant"], "battlefield": ["Stormcatch Mentor", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Hill Giant"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: only the generic part is reduced, so the Island pays it and two Mountains pay RR",
    "players": [
      { "hand": ["Stoke the Flames"], "battlefield": ["Stormcatch Mentor", "Mountain", "Mountain", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Stoke the Flames", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Stoke the Flames"] }, { "graveyard": ["Hill Giant"] } ] }
  },
  {
    "name": "ruling: colored mana is not reduced, so Think Twice still needs a blue source",
    "players": [
      { "hand": ["Think Twice"], "battlefield": ["Stormcatch Mentor", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Think Twice", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Think Twice"] }, {} ] }
  },
  {
    "name": "ruling: the flashback total cost is reduced by one",
    "players": [
      { "graveyard": ["Think Twice"], "battlefield": ["Stormcatch Mentor", "Island", "Island"], "library": ["Forest", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Think Twice", "alt": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Forest"], "exile": ["Think Twice"], "graveyard": [] }, {} ] }
  },
  {
    "name": "ruling: flashback with the discount still needs two mana",
    "players": [
      { "graveyard": ["Think Twice"], "battlefield": ["Stormcatch Mentor", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Think Twice", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "graveyard": ["Think Twice"] }, {} ] }
  }
]
