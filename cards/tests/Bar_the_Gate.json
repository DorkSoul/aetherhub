[
  { "name": "counters target creature spell, then venture into the Tomb of Annihilation (each player loses 1 life)",
    "players": [ { "hand": ["Bar the Gate", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" },
               { "cast": "Bar the Gate", "targets": [{ "stack": "Grizzly Bears" }] },
               { "resolve": true, "answers": [1] } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"], "life": 19 }, { "life": 19 } ] } },
  { "name": "cannot target a noncreature, nonplaneswalker spell",
    "players": [ { "hand": ["Bar the Gate", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
               { "cast": "Bar the Gate", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true },
               { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Bar the Gate"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a venture with no dungeon puts Tomb of Annihilation in the command zone",
    "players": [ { "hand": ["Bar the Gate", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" },
               { "cast": "Bar the Gate", "targets": [{ "stack": "Grizzly Bears" }] },
               { "resolve": true, "answers": [1] } ],
    "expect": { "players": [ { "command": ["Tomb of Annihilation"] }, {} ] } },
  { "name": "ruling: a second venture continues in the same dungeon, so only one dungeon is in the command zone",
    "players": [ { "hand": ["Bar the Gate", "Grizzly Bears", "Bar the Gate", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" },
               { "cast": "Bar the Gate", "targets": [{ "stack": "Grizzly Bears" }] },
               { "resolve": true, "answers": [1] },
               { "cast": "Grizzly Bears" },
               { "cast": "Bar the Gate", "targets": [{ "stack": "Grizzly Bears" }] },
               { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "command": ["Tomb of Annihilation"], "graveyard_has": ["Grizzly Bears"] }, {} ] } }
]
