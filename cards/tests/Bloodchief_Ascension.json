[
  { "name": "an opponent lost 2 or more life this turn: quest counter at the end step",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Bloodchief Ascension", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "End", "answers": [true] } ],
    "expect": { "counters": { "Bloodchief Ascension": { "quest": 1 } } } },
  { "name": "no opponent lost life: no quest counter",
    "players": [ { "battlefield": ["Bloodchief Ascension"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "counters": { "Bloodchief Ascension": { "quest": 0 } } } },
  { "name": "with three quest counters an opponent's card going to the graveyard drains 2",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Bloodchief Ascension", "counters": { "quest": 3 } }, "Mountain" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "life": 22 }, { "life": 18, "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "your own card going to the graveyard does not drain",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Bloodchief Ascension", "counters": { "quest": 3 } }, "Mountain", "Grizzly Bears" ] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "ruling: an opponent who lost 3 and gained 3 back still lost life this turn (quest counter)",
    "players": [ { "battlefield": ["Bloodchief Ascension"] }, { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Helix", "player": 1, "targets": ["p1"] }, { "resolve": true }, { "advance_to": "End", "answers": [true] } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ], "counters": { "Bloodchief Ascension": { "quest": 1 } } } },
  { "name": "ruling: life lost earlier in the turn counts even if Bloodchief Ascension entered afterwards",
    "players": [ { "hand": ["Lightning Bolt", "Bloodchief Ascension"], "battlefield": ["Mountain", "Swamp"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Bloodchief Ascension" }, { "resolve": true }, { "advance_to": "End", "answers": [true] } ],
    "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Bloodchief Ascension": { "quest": 1 } } } }
]
