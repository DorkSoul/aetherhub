[
  {
    "name": "planeswalker spells can be cast with any colour of mana",
    "players": [ { "hand": ["Jace Beleren"], "battlefield": ["Oath of Nissa", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Jace Beleren" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Jace Beleren"] }, {} ] }
  },
  {
    "name": "without Oath the Forests can't cast it",
    "players": [ { "hand": ["Jace Beleren"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Jace Beleren", "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "enters: take a creature, land or planeswalker from the top three",
    "players": [ { "hand": ["Oath of Nissa"], "library": ["Island", "Grizzly Bears", "Island", "Island"], "battlefield": ["Forest"] }, {} ],
    "steps": [ { "cast": "Oath of Nissa" }, { "resolve": true, "answers": [["Grizzly Bears"], [[0, 1]]] } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] }
  },
  {
    "name": "ruling: a second Oath still gets its enters ability; the legend rule keeps one",
    "players": [ { "hand": ["Oath of Nissa"], "library": ["Grizzly Bears", "Island", "Island"], "battlefield": ["Oath of Nissa", "Forest"] }, {} ],
    "steps": [ { "cast": "Oath of Nissa" }, { "resolve": true, "answers": [0, ["Grizzly Bears"], [[0, 1]]] } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Oath of Nissa"], "battlefield_has": ["Oath of Nissa"] }, {} ] }
  }
]
