[
  {
    "name": "destroys target enchantment",
    "players": [
      {"hand": ["Frantic Purification"], "battlefield": ["Plains", "Plains", "Plains"]},
      {"battlefield": ["Glorious Anthem"]}
    ],
    "steps": [
      {"cast": "Frantic Purification", "targets": ["Glorious Anthem"]},
      {"resolve": true}
    ],
    "expect": {"players": [{"graveyard": ["Frantic Purification"]}, {"graveyard": ["Glorious Anthem"]}]}
  },
  {
    "name": "cannot target a creature",
    "players": [
      {"hand": ["Frantic Purification"], "battlefield": ["Plains", "Plains", "Plains"]},
      {"battlefield": ["Grizzly Bears"]}
    ],
    "steps": [
      {"cast": "Frantic Purification", "targets": ["Grizzly Bears"], "illegal": true}
    ],
    "expect": {"players": [{"hand_count": 1}, {"battlefield_has": ["Grizzly Bears"]}]}
  },
  {
    "name": "madness: discarded to Wild Guess, pay W, cast it free to destroy the enchantment",
    "players": [ { "hand": ["Wild Guess", "Frantic Purification"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains"] }, { "battlefield": ["Glorious Anthem"] } ],
    "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Frantic Purification"] }, { "graveyard_has": ["Glorious Anthem"] } ] }
  },
  {
    "name": "madness: declining leaves Frantic Purification in the graveyard and the enchantment in play",
    "players": [ { "hand": ["Wild Guess", "Frantic Purification"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains"] }, { "battlefield": ["Glorious Anthem"] } ],
    "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard_has": ["Frantic Purification"] }, { "battlefield_has": ["Glorious Anthem"] } ] }
  },
  {
    "name": "ruling: discarding a madness card still triggers 'whenever you discard' abilities",
    "players": [ { "hand": ["Wild Guess", "Frantic Purification"], "battlefield": ["Archfiend of Ifnir", "Mountain", "Mountain", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard_has": ["Frantic Purification"] }, {} ], "pt": { "Grizzly Bears": [1, 1] } }
  }
]
