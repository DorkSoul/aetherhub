[
  {
    "name": "seven counters on a noncreature land: it becomes a 7/7 Fungus with haste, still a land",
    "players": [
      { "battlefield": ["Tendril of the Mycotyrant", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Tendril of the Mycotyrant", "ability": 0, "targets": ["Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Mountain"] }, {}],
      "pt": { "Mountain": [7, 7] },
      "counters": { "Mountain": { "p1p1": 7 } },
      "keywords": { "Mountain": ["Haste"] }
    }
  },
  {
    "name": "six lands cannot pay the seven-mana cost",
    "players": [
      { "battlefield": ["Tendril of the Mycotyrant", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Tendril of the Mycotyrant", "ability": 0, "targets": ["Mountain"], "illegal": true }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Tendril of the Mycotyrant": [2, 2] }
    }
  },
  {
    "name": "ruling: the land stays a 7/7 creature with no duration, still so after the turn ends",
    "players": [
      { "battlefield": ["Tendril of the Mycotyrant", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Tendril of the Mycotyrant", "ability": 0, "targets": ["Mountain"] },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Mountain"] }, {}],
      "pt": { "Mountain": [7, 7] },
      "counters": { "Mountain": { "p1p1": 7 } }
    }
  }
]
