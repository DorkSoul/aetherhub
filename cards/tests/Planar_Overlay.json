    { "hand": ["Forest", "Plains", "Island"], "battlefield_has": ["Island", "Plains"], "battlefield_lacks": ["Forest"], "graveyard": ["Planar Overlay"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: a dual land (Tundra) can be chosen as both of its basic land types",
  "players": [
