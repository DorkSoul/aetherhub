[
  { "name": "enters tapped",
    "players": [ { "hand": ["Gas Guzzler"], "battlefield": ["Swamp"] }, {} ],
    "steps": [ { "cast": "Gas Guzzler" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Gas Guzzler"] }, {} ], "tapped": { "Gas Guzzler": true } } },
  { "name": "max speed: sacrifice another creature to draw a card",
    "players": [ { "battlefield": ["Gas Guzzler", "Grizzly Bears", "Swamp"] }, {} ],
    "steps": [ { "set_speed": 4 }, { "activate": "Gas Guzzler", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "hand_count": 1, "battlefield_has": ["Gas Guzzler"] }, {} ] } },
  { "name": "max speed: sacrifice a Vehicle to draw a card",
    "players": [ { "battlefield": ["Gas Guzzler", "Adventurer's Airship", "Swamp"] }, {} ],
    "steps": [ { "set_speed": 4 }, { "activate": "Gas Guzzler", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Adventurer's Airship"], "hand_count": 1, "battlefield_has": ["Gas Guzzler"] }, {} ] } },
  { "name": "speed 3 is not max speed: ability can't be activated",
    "players": [ { "battlefield": ["Gas Guzzler", "Grizzly Bears", "Swamp"] }, {} ],
    "steps": [ { "set_speed": 3 }, { "activate": "Gas Guzzler", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Gas Guzzler", "Grizzly Bears"], "hand_count": 0 }, {} ] } },
  { "name": "can't sacrifice itself as the cost",
    "players": [ { "battlefield": ["Gas Guzzler", "Swamp"] }, {} ],
    "steps": [ { "set_speed": 4 }, { "activate": "Gas Guzzler", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Gas Guzzler"] }, {} ] } },
  { "name": "start your engines: speed starts at 1 when it enters",
    "players": [ { "hand": ["Gas Guzzler"], "battlefield": ["Swamp"] }, {} ],
    "steps": [ { "cast": "Gas Guzzler" }, { "resolve": true } ],
    "expect": { "players": [ { "speed": 1 }, {} ] } },
  { "name": "ruling: speed is tracked per player (raising my speed to max leaves the opponent's speed alone)",
    "players": [ {}, { "battlefield": ["Gas Guzzler", "Swamp"] } ],
    "steps": [ { "set_speed": 4 } ],
    "expect": { "players": [ { "speed": 4 }, { "speed": 1 } ] } },
  { "name": "ruling: gaining control of a Start your engines! permanent gives its new controller speed 1",
    "players": [ { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Gas Guzzler", "Swamp"] } ],
    "steps": [ { "cast": "Control Magic", "targets": ["Gas Guzzler"] }, { "resolve": true } ],
    "expect": { "players": [ { "speed": 1, "battlefield_has": ["Gas Guzzler"] }, {} ] } },
  { "name": "ruling: losing control of a Start your engines! permanent does not change the old controller's speed",
    "players": [ { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Gas Guzzler", "Swamp"] } ],
    "steps": [ { "set_speed": 4, "player": 1 }, { "cast": "Control Magic", "targets": ["Gas Guzzler"] }, { "resolve": true } ],
    "expect": { "players": [ { "speed": 1 }, { "speed": 4 } ] } }
]
