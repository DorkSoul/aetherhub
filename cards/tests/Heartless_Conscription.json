[
  {
    "name": "exiles every creature; the controller may cast them with any mana",
    "players": [
      { "hand": ["Heartless Conscription"], "battlefield": ["Swamp", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Merfolk Looter"] }
    ],
    "steps": [
      { "cast": "Heartless Conscription" },
      { "resolve": true },
      { "cast": "Merfolk Looter" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Merfolk Looter"], "graveyard": [], "exile": ["Heartless Conscription", "Grizzly Bears"] },
        { "battlefield_has": [], "exile": [] }
      ]
    }
  },
  {
    "name": "no mana left after the spell: the exiled creature cannot be cast",
    "players": [
      { "hand": ["Heartless Conscription"], "battlefield": ["Swamp", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Merfolk Looter"] }
    ],
    "steps": [
      { "cast": "Heartless Conscription" },
      { "resolve": true },
      { "cast": "Merfolk Looter", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": [], "exile": ["Heartless Conscription"] },
        { "battlefield_has": [], "exile": ["Merfolk Looter"] }
      ]
    }
  },
  {
    "name": "ruling: an exiled creature without flash can't be cast during combat",
    "players": [
      { "hand": ["Heartless Conscription"], "battlefield": ["Swamp", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Merfolk Looter"] }
    ],
    "steps": [
      { "cast": "Heartless Conscription" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "cast": "Merfolk Looter", "illegal": true }
    ],
    "expect": { "players": [ { "exile": ["Heartless Conscription"] }, { "exile": ["Merfolk Looter"] } ] }
  },
  {
    "name": "ruling: an animated land exiled by Heartless Conscription can be played from exile as a land",
    "players": [
      { "hand": ["Heartless Conscription"], "battlefield": ["Mutavault", "Swamp", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Mutavault" },
      { "resolve": true },
      { "cast": "Heartless Conscription" },
      { "resolve": true },
      { "play_land": "Mutavault" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Mutavault"], "exile": ["Heartless Conscription"] }, {} ] }
  }
]
