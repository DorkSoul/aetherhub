  {
    "name": "ruling: the loyalty ability may target any opponent permanent, even one that cannot be dealt damage",
    "players": [
      { "battlefield": ["Dovin, Hand of Control", "Mountain"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Dovin, Hand of Control", "ability": 0, "targets": ["Island"] },
      { "resolve": true }
