          ]
        }
      ]
    }
  },
  {
    "name": "minus one: other opponent permanents still take damage",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Dovin, Hand of Control",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
