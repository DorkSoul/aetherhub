  {
    "name": "minus one: damage to the targeted opponent permanent is prevented",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Dovin, Hand of Control",
          "Mountain"
        ]
      },
      {
        "battlefield": [
