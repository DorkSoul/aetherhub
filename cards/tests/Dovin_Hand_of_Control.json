  {
    "name": "ruling: the damage prevention keeps applying after Dovin leaves the battlefield",
    "players": [
      {
        "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"],
        "battlefield": ["Dovin, Hand of Control", "Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "activate": "Dovin, Hand of Control", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Dovin, Hand of Control"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Dovin, Hand of Control"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dovin, Hand of Control", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
