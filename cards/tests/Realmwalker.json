[
  {
    "name": "cast an Elf from the top of the library after choosing Elf",
    "players": [
      {
        "hand": ["Realmwalker"],
        "battlefield": ["Forest", "Forest", "Island", "Island", "Island", "Island"],
        "library": ["Llanowar Elves"]
      },
      {}
    ],
    "steps": [
      { "cast": "Realmwalker" },
      { "resolve": true, "answers": ["Elf"] },
      { "cast": "Llanowar Elves" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Island", "Island", "Island", "Island", "Realmwalker", "Llanowar Elves"] },
        {}
      ]
    }
  },
  {
    "name": "creature of another type cannot be cast from the top of the library",
    "players": [
      {
        "hand": ["Realmwalker"],
        "battlefield": ["Forest", "Forest", "Island", "Island", "Island", "Island"],
        "library": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Realmwalker" },
      { "resolve": true, "answers": ["Elf"] },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Island", "Island", "Island", "Island", "Realmwalker"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: cannot cast a creature from the top while another spell is on the stack",
    "players": [
      { "hand": ["Realmwalker", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Island", "Island", "Mountain"], "library": ["Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "cast": "Realmwalker" },
      { "resolve": true, "answers": ["Elf"] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Llanowar Elves", "illegal": true }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ { "hand": [], "battlefield_has": ["Realmwalker"] }, { "life": 20 } ]
    }
  }
]
