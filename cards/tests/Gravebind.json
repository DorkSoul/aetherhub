[
  {
    "name": "creature can't be regenerated: Murder destroys it through its regeneration shield",
    "players": [
      { "hand": ["Gravebind", "Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Swamp", "Drudge Skeletons"] }
    ],
    "steps": [
      { "cast": "Gravebind", "targets": ["Drudge Skeletons"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Drudge Skeletons", "player": 1, "ability": 0 },
      { "resolve": true },
      { "cast": "Murder", "targets": ["Drudge Skeletons"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Gravebind", "Murder"] },
        { "graveyard": ["Drudge Skeletons"] }
      ]
    }
  },
  {
    "name": "without Gravebind the regeneration shield saves the creature",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Swamp", "Drudge Skeletons"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Drudge Skeletons", "player": 1, "ability": 0 },
      { "resolve": true },
      { "cast": "Murder", "targets": ["Drudge Skeletons"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Murder"] },
        { "battlefield_has": ["Drudge Skeletons"] }
      ],
      "tapped": { "Drudge Skeletons": true }
    }
  }
]
