[
 { "name": "untap an opponent's tapped Mountain: add R",
   "players": [ { "battlefield": [ { "name": "Benthic Explorers", "sick": false } ] }, { "battlefield": [ { "name": "Mountain", "tapped": true } ] } ],
   "steps": [ { "tap_for_mana": "Benthic Explorers" } ],
   "expect": { "tapped": { "Mountain": false, "Benthic Explorers": true }, "players": [ { "pool": { "R": 1 } }, {} ] } },
 { "name": "colorless land gives colorless",
   "players": [ { "battlefield": [ { "name": "Benthic Explorers", "sick": false } ] }, { "battlefield": [ { "name": "Wastes", "tapped": true } ] } ],
   "steps": [ { "tap_for_mana": "Benthic Explorers" } ],
   "expect": { "tapped": { "Wastes": false }, "players": [ { "pool": { "C": 1 } }, {} ] } },
 { "name": "an any-color land lets any color be chosen",
   "players": [ { "battlefield": [ { "name": "Benthic Explorers", "sick": false } ] }, { "battlefield": [ { "name": "City of Brass", "tapped": true } ] } ],
   "steps": [ { "tap_for_mana": "Benthic Explorers", "color": "G" } ],
   "expect": { "tapped": { "City of Brass": false }, "players": [ { "pool": { "G": 1 } }, {} ] } },
 { "name": "a painland can give a color it makes",
   "players": [ { "battlefield": [ { "name": "Benthic Explorers", "sick": false } ] }, { "battlefield": [ { "name": "Adarkar Wastes", "tapped": true } ] } ],
   "steps": [ { "tap_for_mana": "Benthic Explorers", "color": "W" } ],
   "expect": { "tapped": { "Adarkar Wastes": false }, "players": [ { "pool": { "W": 1 } }, {} ] } },
 { "name": "an untapped opponent land is not enough",
   "players": [ { "battlefield": [ { "name": "Benthic Explorers", "sick": false } ] }, { "battlefield": [ "Mountain" ] } ],
   "steps": [ { "tap_for_mana": "Benthic Explorers", "illegal": true } ],
   "expect": { "tapped": { "Benthic Explorers": false }, "players": [ { "pool": {} }, {} ] } },
 { "name": "your own tapped land does not count",
   "players": [ { "battlefield": [ { "name": "Benthic Explorers", "sick": false }, { "name": "Forest", "tapped": true } ] }, {} ],
   "steps": [ { "tap_for_mana": "Benthic Explorers", "illegal": true } ],
   "expect": { "tapped": { "Forest": true }, "players": [ { "pool": {} }, {} ] } }
,
 { "name": "ruling: a tapped opponent Vivid Crag without counters still gives any color", "players": [ { "battlefield": [ { "name": "Benthic Explorers", "sick": false } ] }, { "battlefield": [ { "name": "Vivid Crag", "tapped": true } ] } ], "steps": [ { "tap_for_mana": "Benthic Explorers", "color": "R" } ], "expect": { "tapped": { "Vivid Crag": false, "Benthic Explorers": true }, "players": [ { "pool": { "R": 1 } }, {} ] } }
]
