[
  {
    "name": "4 damage kills the opposing creature and a Young Hero Role goes on your creature",
    "players": [
      { "hand": ["Cut In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Savannah Lions"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cut In", "targets": ["Hill Giant", "Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Cut In"], "battlefield_has": ["Savannah Lions", "Young Hero Role"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "up to one: with no creature of yours chosen, the opposing creature still takes 4 and no Role is created",
    "players": [
      { "hand": ["Cut In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Cut In", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Cut In"], "battlefield_lacks": ["Young Hero Role"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: no Role when the creature it would attach to is gone by resolution",
    "players": [
      { "hand": ["Cut In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Savannah Lions"] },
      { "hand": ["Unsummon"], "battlefield": ["Island", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cut In", "targets": ["Hill Giant", "Savannah Lions"] },
      { "pass": true },
      { "cast": "Unsummon", "targets": ["Savannah Lions"], "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Savannah Lions"], "battlefield_lacks": ["Young Hero Role", "Savannah Lions"] },
        { "graveyard": ["Hill Giant", "Unsummon"] }
      ]
    }
  },
  {
    "name": "ruling: a second Young Hero Role on the same creature replaces the first",
    "players": [
      { "hand": ["Cut In", "Cut In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Savannah Lions"] },
      { "battlefield": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Cut In", "targets": ["Hill Giant", "Savannah Lions"] },
      { "resolve": true },
      { "cast": "Cut In", "targets": ["Grizzly Bears", "Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Cut In", "Cut In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Savannah Lions", "Young Hero Role"] },
        { "graveyard": ["Hill Giant", "Grizzly Bears"] }
      ]
    }
  }
]
