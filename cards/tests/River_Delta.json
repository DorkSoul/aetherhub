[
 {
  "name": "tapping for U taps it and adds U",
  "players": [ { "battlefield": ["River Delta"] }, {} ],
  "steps": [ { "tap_for_mana": "River Delta" } ],
  "expect": {
   "players": [ { "pool": { "U": 1 } } ],
   "tapped": { "River Delta": true }
  }
 },
 {
  "name": "with a depletion counter it does not untap in the untap step, and the upkeep trigger removes the counter",
  "players": [ { "battlefield": ["River Delta"] }, {} ],
  "steps": [
   { "tap_for_mana": "River Delta" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": {
   "tapped": { "River Delta": true }
  }
 },
 {
  "name": "after the upkeep trigger removed its counter it untaps in a later untap step",
  "players": [ { "battlefield": ["River Delta"] }, {} ],
  "steps": [
   { "tap_for_mana": "River Delta" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" }
  ],
  "expect": {
   "tapped": { "River Delta": false }
  }
 },
 {
  "name": "without a depletion counter it untaps normally",
  "players": [ { "battlefield": [ { "name": "River Delta", "tapped": true } ] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
  "expect": {
   "tapped": { "River Delta": false }
  }
 }
]
