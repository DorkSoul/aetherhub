[
  {
    "name": "foretell for 2 then cast from exile for R on a later turn",
    "players": [
      { "hand": ["Demon Bolt"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "cast": "Demon Bolt", "alt": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Demon Bolt"], "battlefield": ["Mountain", "Mountain"] },
        { "graveyard": ["Grizzly Bears"] }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "cannot foretell with only one untapped land",
    "players": [
      { "hand": ["Demon Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Demon Bolt", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Demon Bolt"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "foretold card cannot be cast from exile on the same turn",
    "players": [
      { "hand": ["Demon Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true },
      { "cast": "Demon Bolt", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Demon Bolt"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "hard cast for 2R deals 4 to a creature",
    "players": [
      { "hand": ["Demon Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Demon Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Demon Bolt"] },
        { "graveyard": ["Grizzly Bears"] }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: a foretold instant can be cast on the opponent's turn",
    "players": [
      { "hand": ["Demon Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Demon Bolt", "alt": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Demon Bolt"] }, { "graveyard": ["Grizzly Bears"] } ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: foretelling is a special action on your turn, so it can be done in response to a spell",
    "players": [
      { "hand": ["Demon Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Demon Bolt"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ],
      "stack_empty": true
    }
  }
]
