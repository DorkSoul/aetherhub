          -1,
          2
        ],
        "Savannah Lions": [
          0,
          1
        ],
        "Hill Giant": [
          2,
          3
        ]
      }
    }
  },
  {
    "name": "only one target chosen: the other two are optional",
    "players": [
      {
        "hand": [
          "Blue Dragon"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Forest",
          "Forest",
          "Forest",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Blue Dragon"
      },
      {
        "resolve": true
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Blue Dragon"
          ]
