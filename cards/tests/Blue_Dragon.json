  {
    "name": "ruling: the optional -1/-0 target can be one of your own creatures",
    "players": [
      {
        "hand": ["Blue Dragon"],
        "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Mountain", "Mountain", "Savannah Lions"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Blue Dragon" },
      { "resolve": true, "targets": ["Savannah Lions"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
