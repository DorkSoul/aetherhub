[
  {
    "name": "ETB gives -3/-0, -2/-0 and -1/-0 until your next turn",
    "players": [
      {
        "hand": [
          "Blue Dragon"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Forest",
          "Forest",
          "Forest",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Savannah Lions",
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Blue Dragon"
      },
      {
        "resolve": true,
        "targets": [
          "Grizzly Bears",
          "Savannah Lions",
          "Hill Giant"
        ]
      },
      {
        "resolve": true,
        "auto": true
      }
