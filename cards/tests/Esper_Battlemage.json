    "steps": [ { "cast": "Esper Battlemage" }, { "resolve": true } ],
    "expect": { "colors": { "Esper Battlemage": ["U"] }, "players": [ { "battlefield_has": ["Esper Battlemage"] }, {} ] } },
  { "name": "ruling: colored artifact is destroyed by Shatter like any other artifact",
