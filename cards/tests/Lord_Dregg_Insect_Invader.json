      {}
    ],
    "steps": [
      { "activate": "Lord Dregg, Insect Invader" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lord Dregg, Insect Invader"], "battlefield_lacks": ["Insect Warrior 1-1 Black Flying"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "{3}{G}, sacrifice a token: no token to sacrifice means the ability cannot be activated",
    "players": [
      { "battlefield": ["Lord Dregg, Insect Invader", "Forest", "Swamp", "Swamp", "Swamp"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Lord Dregg, Insect Invader", "illegal": true }
