    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lord Dregg, Insect Invader", "Grizzly Bears"], "battlefield_lacks": ["Insect Warrior 1-1 Black Flying"] },
        {}
      ]
    }
  },
  {
    "name": "{3}{G}, sacrifice a token: draw a card",
    "players": [
