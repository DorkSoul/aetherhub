    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "attack": [
          {
            "card": "Akroan Sergeant",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
