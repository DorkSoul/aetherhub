  {
    "name": "ruling: a renown trigger does nothing if the Sergeant has left the battlefield before it resolves",
    "players": [
      { "battlefield": ["Akroan Sergeant"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Akroan Sergeant", "at": "p1" } ] },
      { "block": [] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "player": 1, "cast": "Doom Blade", "targets": ["Akroan Sergeant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Akroan Sergeant"] },
        { "life": 18, "graveyard": ["Doom Blade"] }
