[
  { "name": "ruling: heroic trigger resolves before the spell that caused it",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Satyr Hoplite", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Giant Growth", "targets": ["Satyr Hoplite"] }, { "pass": true }, { "pass": true } ],
    "expect": { "stack_empty": false, "pt": { "Satyr Hoplite": [2, 2] }, "counters": { "Satyr Hoplite": { "p1p1": 1 } } } },
  { "name": "ruling: heroic triggers once per spell even when the spell targets it twice",
    "players": [ { "hand": ["Blind with Anger", "Glacial Ray"], "battlefield": ["Satyr Hoplite", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Blind with Anger", "targets": ["Satyr Hoplite"], "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Satyr Hoplite"] }, {} ] } },
  { "name": "heroic: a spell targeting it adds a +1/+1 counter",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Satyr Hoplite", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Giant Growth", "targets": ["Satyr Hoplite"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Satyr Hoplite": [5, 5] }, "counters": { "Satyr Hoplite": { "p1p1": 1 } } } },
  { "name": "a spell targeting another creature does not trigger heroic",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Satyr Hoplite", "Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Satyr Hoplite": [1, 1] } } }
]
