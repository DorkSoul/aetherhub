[
 {"name": "enchanted land taps for an extra mana of the chosen colour",
  "players": [{"hand": ["Shimmerwilds Growth"], "battlefield": ["Forest", "Forest", "Island"]}, {}],
  "steps": [
    {"cast": "Shimmerwilds Growth", "targets": ["Island"]},
    {"resolve": true, "answers": ["R"]},
    {"tap_for_mana": "Island"}
  ],
  "expect": {"players": [{"pool": {"U": 1, "R": 1}}, {}]}},
 {"name": "only the enchanted land gets the extra mana",
  "players": [{"hand": ["Shimmerwilds Growth"], "battlefield": ["Forest", "Forest", "Island", "Mountain"]}, {}],
  "steps": [
    {"cast": "Shimmerwilds Growth", "targets": ["Island"]},
    {"resolve": true, "answers": ["G"]},
    {"tap_for_mana": "Mountain"}
  ],
  "expect": {"players": [{"pool": {"R": 1}}, {}]}},
 {"name": "the chosen colour is what the extra mana is, not blue",
  "players": [{"hand": ["Shimmerwilds Growth"], "battlefield": ["Forest", "Forest", "Island"]}, {}],
  "steps": [
    {"cast": "Shimmerwilds Growth", "targets": ["Island"]},
    {"resolve": true, "answers": ["G"]},
    {"tap_for_mana": "Island"}
  ],
  "expect": {"players": [{"pool": {"U": 1, "G": 1}}, {}]}},
 {"name": "the extra mana from the enchanted land's tap trigger is added once the trigger resolves",
  "players": [{"hand": ["Shimmerwilds Growth"], "battlefield": ["Forest", "Forest", "Island"]}, {}],
  "steps": [
    {"cast": "Shimmerwilds Growth", "targets": ["Island"]},
    {"resolve": true, "answers": ["R"]},
    {"tap_for_mana": "Island"},
    {"resolve": true}
  ],
  "expect": {"players": [{"pool": {"U": 1, "R": 1}}, {}]}},
 {"name": "ruling: the extra mana from the enchanted land is a mana ability that does not use the stack",
  "players": [{"hand": ["Shimmerwilds Growth"], "battlefield": ["Forest", "Forest", "Island"]}, {}],
  "steps": [
    {"cast": "Shimmerwilds Growth", "targets": ["Island"]},
    {"resolve": true, "answers": ["R"]},
    {"tap_for_mana": "Island"}
  ],
  "expect": {"stack_empty": true, "players": [{"pool": {"U": 1, "R": 1}}, {}]}}
]
