[
  { "name": "the opponent sacrifices their artifact and you get a Treasure",
    "players": [ { "hand": ["Visions of Ruin"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Ornithopter"] } ],
    "steps": [ { "cast": "Visions of Ruin" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure"], "graveyard": ["Visions of Ruin"] }, { "graveyard": ["Ornithopter"] } ] } },
  { "name": "no artifact means no Treasure",
    "players": [ { "hand": ["Visions of Ruin"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Visions of Ruin" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Treasure"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "flashback costs X less, X the greatest mana value of your commander in the command zone",
    "players": [ { "command": ["Hill Giant"], "graveyard": ["Visions of Ruin"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain"] }, { "battlefield": ["Ornithopter"] } ],
    "steps": [ { "cast": "Visions of Ruin", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Visions of Ruin"], "battlefield_has": ["Treasure"] }, { "graveyard": ["Ornithopter"] } ] } },
  { "name": "flashback without a commander costs the full {8}{R}{R}",
    "players": [ { "graveyard": ["Visions of Ruin"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain"] }, {} ],
    "steps": [ { "cast": "Visions of Ruin", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Visions of Ruin"] }, {} ] } },
  { "name": "ruling: flashback follows sorcery timing, so it is illegal on the opponent's turn",
    "players": [ { "graveyard": ["Visions of Ruin"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain"] }, { "battlefield": ["Ornithopter"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Visions of Ruin", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Visions of Ruin"] }, { "battlefield_has": ["Ornithopter"] } ] } },
  { "name": "ruling: a flashback spell that is countered is still exiled",
    "players": [ { "graveyard": ["Visions of Ruin"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain","Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island","Island"] } ],
    "steps": [ { "cast": "Visions of Ruin", "alt": 0 }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Visions of Ruin" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Visions of Ruin"] }, { "graveyard": ["Counterspell"] } ] } },
  { "name": "ruling: the flashback reduction applies to the total cost (six Mountains pay {4}{R}{R} with a mana value 4 commander)",
    "players": [ { "command": ["Hill Giant"], "graveyard": ["Visions of Ruin"], "battlefield": ["Mountain","Mountain","Mountain","Mountain","Mountain","Mountain"] }, { "battlefield": ["Ornithopter"] } ],
    "steps": [ { "cast": "Visions of Ruin", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Visions of Ruin"], "battlefield_has": ["Treasure"] }, { "graveyard": ["Ornithopter"] } ] } }
]
