[
  {
    "name": "Overture mills half of the target opponent's library rounded down (20 cards -> 10)",
    "players": [
      { "hand": ["Jidoor, Aristocratic Capital // Overture"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Jidoor, Aristocratic Capital // Overture", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Jidoor, Aristocratic Capital // Overture"] },
        { "library_count": 10, "graveyard_has": ["Forest"] }
      ]
    }
  },
  {
    "name": "Overture only mills the target opponent (caster library untouched)",
    "players": [
      { "hand": ["Jidoor, Aristocratic Capital // Overture"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Jidoor, Aristocratic Capital // Overture", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 20 },
        { "library_count": 10 }
      ]
    }
  },
  {
    "name": "front face: enters tapped and taps for U",
    "players": [
      { "hand": ["Jidoor, Aristocratic Capital // Overture"] },
      {}
    ],
    "steps": [
      { "play_land": "Jidoor, Aristocratic Capital // Overture" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Jidoor, Aristocratic Capital // Overture"] }
      ]
    }
  },
  {
    "name": "front face played enters tapped (tapped on the battlefield)",
    "players": [
      { "hand": ["Jidoor, Aristocratic Capital // Overture"] },
      {}
    ],
    "steps": [
      { "play_land": "Jidoor, Aristocratic Capital // Overture" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "tapped": { "Jidoor, Aristocratic Capital // Overture": true }
    }
  },
  {
    "name": "ruling: after Overture resolves the card is exiled and its land side can be played from exile",
    "players": [
      { "hand": ["Jidoor, Aristocratic Capital // Overture"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Jidoor, Aristocratic Capital // Overture", "face": true, "targets": ["p1"] },
      { "resolve": true },
      { "play_land": "Jidoor, Aristocratic Capital // Overture" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Jidoor, Aristocratic Capital // Overture"], "exile": [] },
        { "library_count": 10 }
      ]
    }
  },
  {
    "name": "ruling: with the land drop already used, the exiled land can't be played",
    "players": [
      { "hand": ["Jidoor, Aristocratic Capital // Overture", "Forest"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Jidoor, Aristocratic Capital // Overture", "face": true, "targets": ["p1"] },
      { "resolve": true },
      { "play_land": "Forest" },
      { "play_land": "Jidoor, Aristocratic Capital // Overture", "illegal": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Jidoor, Aristocratic Capital // Overture"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Traveling Chocobo lets the land side be played from the top, but not the Adventure",
    "players": [
      { "battlefield": ["Traveling Chocobo", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Jidoor, Aristocratic Capital // Overture"] },
      {}
    ],
    "steps": [
      { "cast": "Jidoor, Aristocratic Capital // Overture", "face": true, "targets": ["p1"], "illegal": true },
      { "play_land": "Jidoor, Aristocratic Capital // Overture" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Jidoor, Aristocratic Capital // Overture"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: Sorceress's Schemes can't target an Adventure card in the graveyard (it is a land there)",
    "players": [
      { "hand": ["Sorceress's Schemes"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Jidoor, Aristocratic Capital // Overture"] },
      {}
    ],
    "steps": [
      { "cast": "Sorceress's Schemes", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Sorceress's Schemes"], "graveyard": ["Jidoor, Aristocratic Capital // Overture"] },
        {}
      ]
    }
  }
