[
  { "name": "creatures can't block it, so its attack is unblocked",
    "players": [ { "battlefield": ["Beloved Chaplain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Beloved Chaplain", "at": "p1" } ] },
               { "block": [] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 19 } ] } },
  { "name": "as a blocker, damage from a creature is prevented",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Beloved Chaplain"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Beloved Chaplain", "attacker": "Grizzly Bears" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Beloved Chaplain"] } ] } },
  { "name": "noncreature damage still kills it",
    "players": [ { "battlefield": ["Beloved Chaplain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["Beloved Chaplain"] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Beloved Chaplain"] }, {} ] } }
]
