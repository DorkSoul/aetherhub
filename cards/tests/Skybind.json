 {"name": "ruling: each constellation ability triggers when an enchantment enters (Skybind and Eidolon of Blossoms both trigger)",
  "players": [{"hand": ["Intangible Virtue"], "battlefield": ["Skybind", "Eidolon of Blossoms", "Plains", "Plains"]}, {"battlefield": ["Hill Giant"]}],
  "steps": [{"cast": "Intangible Virtue"}, {"resolve": true, "targets": ["Hill Giant"]}],
  "expect": {"players": [{"battlefield_has": ["Skybind", "Eidolon of Blossoms", "Intangible Virtue"], "hand_count": 1, "library_count": 19}, {"exile": ["Hill Giant"]}]}},
 {"name": "ruling: an Aura whose target is gone fizzles to the graveyard and never enters, so constellation does not trigger",
  "players": [{"hand": ["Pacifism", "Lightning Bolt"], "battlefield": ["Skybind", "Plains", "Plains", "Mountain"]}, {"battlefield": ["Grizzly Bears", "Hill Giant"]}],
