  "expect": {"players": [{"battlefield_has": ["Skybind"], "graveyard_has": ["Pacifism", "Lightning Bolt"]}, {"graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"]}]}},
