[
  { "name": "attacking a player with itself (a Halfling) creates a Food token",
    "players": [ { "battlefield": [ "Forest", { "name": "Meriadoc Brandybuck", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Meriadoc Brandybuck", "at": "p1" } ] }, { "block": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Food"] }, {} ] } },
  { "name": "a non-Halfling attacker creates no Food",
    "players": [ { "battlefield": [ "Forest", { "name": "Grizzly Bears", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Food"] }, {} ] } },
  { "name": "ruling: two Halflings attacking the same player create only one Food",
    "players": [ { "battlefield": [ "Forest", { "name": "Meriadoc Brandybuck", "sick": false }, { "name": "Samwise Gamgee", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Meriadoc Brandybuck", "at": "p1" }, { "card": "Samwise Gamgee", "at": "p1" } ] }, { "block": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": [ "Forest", "Meriadoc Brandybuck", "Samwise Gamgee", "Food" ] }, {} ] } },
  { "name": "ruling: Halflings attacking a planeswalker create no Food",
    "players": [ { "battlefield": [ "Forest", { "name": "Meriadoc Brandybuck", "sick": false } ] }, { "battlefield": [ { "name": "Chandra, Torch of Defiance", "counters": { "loyalty": 10 } } ] } ],
    "steps": [ { "attack": [ { "card": "Meriadoc Brandybuck", "at": "Chandra, Torch of Defiance" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield": [ "Forest", "Meriadoc Brandybuck" ] }, { "battlefield_has": [ "Chandra, Torch of Defiance" ] } ] } },
  { "name": "ruling: a Food sacrificed for its own ability can't also pay Maraleaf Rider's cost",
    "players": [ { "battlefield": [ "Forest", "Forest", "Maraleaf Rider", "Food" ] }, { "battlefield": [ "Grizzly Bears" ] } ],
    "steps": [ { "activate": "Food", "ability": 0 }, { "resolve": true }, { "activate": "Maraleaf Rider", "ability": 0, "targets": [ "Grizzly Bears" ], "illegal": true } ],
    "expect": { "players": [ { "life": 23, "battlefield": [ "Forest", "Forest", "Maraleaf Rider" ] }, { "battlefield": [ "Grizzly Bears" ] } ] } }
]
