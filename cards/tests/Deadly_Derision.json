[
  {
    "name": "destroys a creature and creates a Treasure",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Swamp"
        ],
        "hand": [
          "Deadly Derision"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Deadly Derision",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Treasure"
          ]
        },
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "can destroy a planeswalker",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Swamp"
        ],
        "hand": [
          "Deadly Derision"
        ]
      },
      {
        "battlefield": [
          "Ral Zarek"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Deadly Derision",
        "targets": [
          "Ral Zarek"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard_has": [
            "Ral Zarek"
          ]
        }
      ]
    }
  },
  {
    "name": "cannot target a land",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Swamp"
        ],
        "hand": [
          "Deadly Derision"
        ]
      },
      {
        "battlefield": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Deadly Derision",
        "targets": [
          "Forest"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Deadly Derision"
          ]
        },
        {
          "battlefield_has": [
            "Forest"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: if the target is gone when Deadly Derision resolves, no Treasure is created",
    "players": [
      { "hand": ["Deadly Derision"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Deadly Derision", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "player": 1, "cast": "Doom Blade", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Deadly Derision"], "battlefield_lacks": ["Treasure"] },
        { "graveyard_has": ["Grizzly Bears", "Doom Blade"] }
      ]
    }
  }
]
