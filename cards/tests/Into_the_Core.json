[
  {
    "name": "exiles two target artifacts",
    "players": [
      { "hand": ["Into the Core"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sol Ring", "Ornithopter"] }
    ],
    "steps": [
      { "cast": "Into the Core", "targets": ["Sol Ring", "Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Into the Core"] }, { "exile": ["Sol Ring", "Ornithopter"] } ]
    }
  },
  {
    "name": "needs two different artifacts",
    "players": [
      { "hand": ["Into the Core"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Into the Core", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Into the Core"] }, { "battlefield_has": ["Sol Ring"] } ]
    }
  },
  {
    "name": "ruling: a single artifact cannot satisfy both targets",
    "players": [
      { "hand": ["Into the Core"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Mind Stone"] }
    ],
    "steps": [
      { "cast": "Into the Core", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Into the Core"] }, { "battlefield_has": ["Mind Stone"] } ]
    }
  }
]
