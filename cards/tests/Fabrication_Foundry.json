[
  { "name": "exile an artifact with mana value 1: X=1 returns an artifact card with mana value 1 or less",
    "players": [ { "battlefield": ["Fabrication Foundry", "Plains", "Island", "Swamp", "Pyrite Spellbomb"], "graveyard": ["Ornithopter"] }, {} ],
    "steps": [ { "activate": "Fabrication Foundry", "ability": 0, "answers": [1] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ornithopter"], "exile": ["Pyrite Spellbomb"] }, {} ] } },
  { "name": "the returned card's mana value can't exceed X",
    "players": [ { "battlefield": ["Fabrication Foundry", "Plains", "Island", "Swamp", "Pyrite Spellbomb"], "graveyard": ["Mind Stone"] }, {} ],
    "steps": [ { "activate": "Fabrication Foundry", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Mind Stone"] }, {} ] } },
  { "name": "two artifacts with total mana value 2 return a mana value 2 artifact",
    "players": [ { "battlefield": ["Fabrication Foundry", "Plains", "Island", "Swamp", "Pyrite Spellbomb", "Pyrite Spellbomb"], "graveyard": ["Mind Stone"] }, {} ],
    "steps": [ { "activate": "Fabrication Foundry", "ability": 0, "answers": [2, [0, 1]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mind Stone"], "exile": ["Pyrite Spellbomb", "Pyrite Spellbomb"] }, {} ] } },
  { "name": "its white mana pays for an artifact spell",
    "players": [ { "hand": ["Mind Stone"], "battlefield": ["Fabrication Foundry", "Plains"] }, {} ],
    "steps": [ { "cast": "Mind Stone" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mind Stone"] }, {} ] } }
]
