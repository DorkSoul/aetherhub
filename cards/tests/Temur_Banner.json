[
  {
    "name": "sacrifice ability: pay G U R and tap, then draw a card",
    "players": [
      { "hand": [], "battlefield": ["Forest", "Island", "Mountain", "Temur Banner"] },
      {}
    ],
    "steps": [
      { "activate": "Temur Banner", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Temur Banner"] },
        {}
      ]
    }
  },
  {
    "name": "tapping for mana makes the chosen colour",
    "players": [
      { "battlefield": ["Temur Banner"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Temur Banner", "color": "R" }
    ],
    "expect": {
      "players": [{ "pool": { "R": 1 } }, {}],
      "tapped": { "Temur Banner": true }
    }
  },
  {
    "name": "without a blue source the draw ability cannot be activated",
    "players": [
      { "battlefield": ["Forest", "Mountain", "Temur Banner"] },
      {}
    ],
    "steps": [
      { "activate": "Temur Banner", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Temur Banner"] }, {}]
    }
  }
]
