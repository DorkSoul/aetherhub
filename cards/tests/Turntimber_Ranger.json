[
  {"name": "ETB: may create a 2/2 Wolf; if you do, a +1/+1 counter on it",
   "players": [ { "hand": ["Turntimber Ranger"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [
     {"cast": "Turntimber Ranger"},
     {"resolve": true, "answers": [true]}
   ],
   "expect": {"players": [ {"battlefield_has": ["Turntimber Ranger", "Wolf"]}, {} ],
              "counters": {"Turntimber Ranger": {"p1p1": 1}}, "pt": {"Turntimber Ranger": [3, 3]}}},
  {"name": "declining the 'may' creates nothing and adds no counter",
   "players": [ { "hand": ["Turntimber Ranger"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [
     {"cast": "Turntimber Ranger"},
     {"resolve": true, "answers": [false]}
   ],
   "expect": {"players": [ {"battlefield_lacks": ["Wolf"]}, {} ], "counters": {"Turntimber Ranger": {"p1p1": 0}}, "pt": {"Turntimber Ranger": [2, 2]}}},
  {"name": "another Ally you control entering also triggers it",
   "players": [ { "hand": ["Beastcaller Savant"], "battlefield": [{"name": "Turntimber Ranger", "sick": false}, "Forest", "Forest"] }, {} ],
   "steps": [
     {"cast": "Beastcaller Savant"},
     {"resolve": true, "answers": [true]}
   ],
   "expect": {"players": [ {"battlefield_has": ["Beastcaller Savant", "Wolf"]}, {} ], "counters": {"Turntimber Ranger": {"p1p1": 1}}}},
  {"name": "ruling: the ETB trigger puts the counter on after the Ranger enters, so a 2-damage response kills it before the counter",
   "players": [ { "hand": ["Turntimber Ranger"], "battlefield": ["Forest", "Forest", "Mountain", "Mountain", "Mountain"] },
                { "hand": ["Shivan Fire"], "battlefield": ["Mountain"] } ],
   "steps": [
     {"cast": "Turntimber Ranger"},
     {"pass": true},
     {"pass": true, "player": 1},
     {"pass": true},
     {"cast": "Shivan Fire", "targets": ["Turntimber Ranger"], "player": 1},
     {"pass": true, "player": 1},
     {"pass": true},
     {"resolve": true, "answers": [true]}
   ],
   "expect": {"players": [ {"graveyard_has": ["Turntimber Ranger"], "battlefield_has": ["Wolf"]}, {"graveyard_has": ["Shivan Fire"]} ]}}
]
