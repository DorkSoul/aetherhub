[
  {
    "name": "has banding while its controller controls a Plains",
    "players": [
      { "battlefield": [ "Dire Wolves", "Plains" ] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": { "keywords": { "Dire Wolves": ["Banding"] } }
  },
  {
    "name": "no banding without a Plains",
    "players": [
      { "battlefield": [ "Dire Wolves", "Forest" ] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": { "keywords": { "Dire Wolves": [] } }
  },
  {
    "name": "with a Plains, Dire Wolves and Grizzly Bears attack in a band; blocking the Bears blocks the band",
    "players": [
      { "battlefield": [ { "name": "Dire Wolves", "sick": false }, { "name": "Grizzly Bears", "sick": false }, "Plains" ] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dire Wolves", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "without a Plains there is no band: Dire Wolves connects",
    "players": [
      { "battlefield": [ { "name": "Dire Wolves", "sick": false }, { "name": "Grizzly Bears", "sick": false }, "Forest" ] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dire Wolves", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "ruling: a blocked band member's blocker damage is divided by the attacker (all to Dire Wolves)",
    "players": [
      { "battlefield": [ { "name": "Dire Wolves", "sick": false }, { "name": "Grizzly Bears", "sick": false }, "Plains" ] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dire Wolves", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2", "answers": ["Dire Wolves=3"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Dire Wolves"], "battlefield_has": ["Grizzly Bears"] },
        { "graveyard_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: the same block, with the attacker dividing the damage to Grizzly Bears instead",
    "players": [
      { "battlefield": [ { "name": "Dire Wolves", "sick": false }, { "name": "Grizzly Bears", "sick": false }, "Plains" ] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dire Wolves", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2", "answers": ["Grizzly Bears=3"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Dire Wolves"] },
        { "graveyard_has": ["Hill Giant"] }
      ]
    }
  }
]
