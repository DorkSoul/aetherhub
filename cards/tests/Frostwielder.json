  "steps": [
   { "activate": "Frostwielder", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Frostwielder"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ {}, { "graveyard": ["Hill Giant"] } ]
  }
 }
