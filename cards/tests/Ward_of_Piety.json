 {
  "name": "ruling: redirected combat damage is still combat damage (Slith Firewalker grows)",
  "players": [
   { "hand": ["Ward of Piety"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Wall of Omens"] },
   { "battlefield": ["Slith Firewalker"] }
  ],
  "steps": [
   { "cast": "Ward of Piety", "targets": ["Wall of Omens"] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "pass": true, "player": 1 },
   { "advance_to": "BeginCombat" },
   { "attack": [{ "card": "Slith Firewalker", "at": "p0" }], "player": 1 },
   { "block": [{ "blocker": "Wall of Omens", "attacker": "Slith Firewalker" }], "player": 0 },
   { "pass": true, "player": 1 },
   { "activate": "Ward of Piety", "targets": ["p1"] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Wall of Omens", "Ward of Piety"] },
    { "life": 19, "battlefield_has": ["Slith Firewalker"] }
   ],
   "counters": { "Slith Firewalker": { "p1p1": 1 } },
   "pt": { "Slith Firewalker": [2, 2], "Wall of Omens": [0, 4] }
  }
 }
