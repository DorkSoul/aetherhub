[
  { "name": "swampwalk creature can be blocked by a normal creature while the defending player controls a Swamp",
    "players": [ { "battlefield": ["Quagmire", "Bog Wraith"] }, { "battlefield": ["Swamp", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Bog Wraith", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Bog Wraith" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Bog Wraith"] }, { "graveyard": ["Grizzly Bears"], "life": 20 } ] } },
  { "name": "without Quagmire the swampwalk creature cannot be blocked by a non-Swamp-walker (block is illegal)",
    "players": [ { "battlefield": ["Bog Wraith"] }, { "battlefield": ["Swamp", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Bog Wraith", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Bog Wraith" } ], "illegal": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Bog Wraith"] }, { "battlefield_has": ["Grizzly Bears"], "life": 17 } ] } },
  { "name": "Quagmire does not change blocking of creatures without swampwalk",
    "players": [ { "battlefield": ["Quagmire", "Hill Giant"] }, { "battlefield": ["Swamp", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "life": 20 }, { "graveyard": ["Grizzly Bears"], "life": 20 } ] } }
