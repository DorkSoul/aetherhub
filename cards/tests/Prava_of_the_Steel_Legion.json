[
  {
    "name": "creature tokens get +1/+4 during your turn",
    "players": [
      { "battlefield": ["Prava of the Steel Legion", "Soldier"] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": { "Soldier": [2, 5], "Prava of the Steel Legion": [1, 4] }
    }
  },
  {
    "name": "activated ability creates a 1/1 Soldier that gets the bonus on your turn",
    "players": [
      { "battlefield": ["Prava of the Steel Legion", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Prava of the Steel Legion", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Soldier"] }, {}],
      "pt": { "Soldier": [2, 5] }
    }
  },
  {
    "name": "ruling: when Prava leaves, its bonus stops at once and the damaged token dies",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Prava of the Steel Legion", "Soldier", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Soldier"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Prava of the Steel Legion"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Prava of the Steel Legion"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Soldier", "Prava of the Steel Legion"] }, {}]
    }
  },
  {
    "name": "while Prava is on the battlefield the token survives 3 damage (2/5 with 3 damage)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Prava of the Steel Legion", "Soldier", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Soldier"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Prava of the Steel Legion", "Soldier"] }, {}],
      "pt": { "Soldier": [2, 5] }
    }
  },
  {
    "name": "ruling: the bonus still applies when damage is removed in cleanup, so the token survives",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Prava of the Steel Legion", "Soldier", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Soldier"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Soldier"] }, {}],
      "pt": { "Soldier": [1, 1] }
    }
  }
]
