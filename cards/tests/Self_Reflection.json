[
  { "name": "creates a token copy of a creature you control",
    "players": [
      { "hand": ["Self-Reflection"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Self-Reflection", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Self-Reflection"], "battlefield_has": ["Grizzly Bears", "Grizzly Bears"] }, {} ] } },
  { "name": "flashback for {3}{U} exiles it after it resolves",
    "players": [
      { "graveyard": ["Self-Reflection"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Self-Reflection", "alt": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Self-Reflection"], "graveyard": [], "battlefield_has": ["Grizzly Bears", "Grizzly Bears"] }, {} ] } },
  { "name": "ruling: sorcery-speed flashback is illegal during combat",
    "players": [ { "graveyard": ["Self-Reflection"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Self-Reflection", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Self-Reflection"], "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: flashback that fizzles (target killed in response) is still exiled",
    "players": [ { "graveyard": ["Self-Reflection"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Self-Reflection", "alt": 0, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Self-Reflection"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ] } }
]
