    "steps": [ { "cast": "Shock", "targets": ["Easterling Vanguard"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Easterling Vanguard", "Shock"], "battlefield_has": ["Army"] }, {} ],
