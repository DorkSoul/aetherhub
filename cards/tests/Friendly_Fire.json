[
  { "name": "the only card in the controller's hand is revealed: damage equal to its mana value to the creature and its controller",
    "players": [ { "hand": ["Friendly Fire"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Hill Giant"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Friendly Fire" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Friendly Fire"] }, { "life": 16, "hand": ["Hill Giant"], "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "empty hand of the creature's controller: no damage",
    "players": [ { "hand": ["Friendly Fire"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Friendly Fire" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Friendly Fire"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "a revealed land (mana value 0) deals no damage",
    "players": [ { "hand": ["Friendly Fire"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Forest"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Friendly Fire" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Friendly Fire"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"], "hand": ["Forest"] } ] } },
  { "name": "creature controlled by the caster: the caster takes the damage too",
    "players": [ { "hand": ["Friendly Fire", "Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Friendly Fire" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 16, "hand": ["Hill Giant"], "graveyard": ["Friendly Fire", "Grizzly Bears"] }, { "life": 20 } ] } },
  { "name": "ruling: a revealed card with {X} in its cost has mana value 1 (X counts as 0)",
    "players": [ { "hand": ["Friendly Fire"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Fireball"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Friendly Fire" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Friendly Fire"] }, { "life": 19, "hand": ["Fireball"], "battlefield_has": ["Grizzly Bears"] } ] } }
]
