[
  {
    "name": "creatures are exiled then return at the end step; opponent's creature stays",
    "players": [
      {
        "hand": [
          "Ghostway"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Grizzly Bears",
          "Elite Vanguard"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Ghostway"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Grizzly Bears",
            "Elite Vanguard"
