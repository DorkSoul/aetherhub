[
  { "name": "a creature able to block must block even when the declaration is empty",
    "players": [ { "battlefield": ["Invasion Plans", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "graveyard": ["Grizzly Bears"], "life": 20 } ] } },
  { "name": "the attacker's declaration decides which attacker the forced blocker blocks",
    "players": [ { "battlefield": ["Invasion Plans", "Hill Giant", "Grizzly Bears"] }, { "battlefield": ["Savannah Lions"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] }, { "graveyard": ["Savannah Lions"], "life": 17 } ] } },
  { "name": "with no creature to block the attacker is unblocked",
    "players": [ { "battlefield": ["Invasion Plans", "Hill Giant"] }, {} ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] } }
]
