[
  { "name": "ruling: fabricate's counters are added on resolution, so the creature is a 2/1 while the ability waits",
    "players": [ { "hand": ["Propeller Pioneer"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Propeller Pioneer" }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "players": [ { "battlefield_has": ["Propeller Pioneer"] }, {} ], "pt": { "Propeller Pioneer": [2, 1] } } },
  { "name": "ruling: if the creature has left the battlefield, fabricate creates a Servo",
    "players": [ { "hand": ["Propeller Pioneer", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Mountain"] }, {} ],
    "steps": [ { "cast": "Propeller Pioneer" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Propeller Pioneer"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Servo"], "battlefield_lacks": ["Propeller Pioneer"], "graveyard": ["Propeller Pioneer", "Lightning Bolt"] }, { "life": 20 } ] } },
  { "name": "fabricate: put a +1/+1 counter on it",
    "players": [ { "hand": ["Propeller Pioneer"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Propeller Pioneer" }, { "resolve": true, "answers": [true] } ],
    "expect": { "counters": { "Propeller Pioneer": { "p1p1": 1 } }, "pt": { "Propeller Pioneer": [3, 2] } } },
  { "name": "fabricate: create a Servo instead",
    "players": [ { "hand": ["Propeller Pioneer"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Propeller Pioneer" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Propeller Pioneer", "Servo"] }, {} ], "pt": { "Propeller Pioneer": [2, 1] } } }
]
