 { "name": "ruling: two Lunar Forces are both sacrificed even though the spell is already countered",
   "players": [ { "battlefield": ["Lunar Force", "Lunar Force", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lunar Force", "Lunar Force"], "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "ruling: Lunar Force still counters the spell when it left the battlefield in response",
   "players": [ { "hand": ["Clear"], "battlefield": ["Plains", "Plains", "Lunar Force", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "cast": "Clear", "targets": ["Lunar Force"] }, { "resolve": true } ],
