    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Blaster Hulk", "at": "p1" } ] }, { "resolve": true, "answers": [true, [1, 2], 4] } ],
    "expect": { "players": [ { "energy": 10 }, { "graveyard": ["Grizzly Bears", "Hill Giant"] } ] } },
