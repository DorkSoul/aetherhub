[
  { "name": "pings a player for 1 damage, which is poison not life loss",
    "players": [ { "battlefield": ["Fallen Ferromancer", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Fallen Ferromancer", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "poison": 1, "life": 20 } ] } },
  { "name": "tapping for the ability means it cannot be activated again this turn",
    "players": [ { "battlefield": ["Fallen Ferromancer", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Fallen Ferromancer", "ability": 0, "targets": ["p1"] }, { "resolve": true },
               { "activate": "Fallen Ferromancer", "ability": 0, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ {}, { "poison": 1 } ] } },
  { "name": "damage to a creature is dealt as a -1/-1 counter",
    "players": [ { "battlefield": ["Fallen Ferromancer", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Fallen Ferromancer", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "counters": { "Grizzly Bears": { "m1m1": 1 } }, "pt": { "Grizzly Bears": [1, 1] } } },
  { "name": "ruling: infect damage to a creature is a -1/-1 counter (a 2/2 becomes a 1/1 with the counter)",
    "players": [ { "battlefield": ["Fallen Ferromancer", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Fallen Ferromancer", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20, "poison": 0 } ], "counters": { "Grizzly Bears": { "m1m1": 1 } }, "pt": { "Grizzly Bears": [1, 1] } } }
]
