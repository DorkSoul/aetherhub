[
 {
  "name": "casting a creature spell that has an Adventure draws a card",
  "players": [
   { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Mountain", "Mountain", "Mountain", "Edgewall Innkeeper"], "library": ["Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Bonecrusher Giant // Stomp" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Mountain"], "battlefield_has": ["Bonecrusher Giant // Stomp", "Edgewall Innkeeper"] },
    {}
   ]
  }
 },
 {
  "name": "casting a creature spell without an Adventure does not draw",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Edgewall Innkeeper"], "library": ["Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": [], "battlefield_has": ["Grizzly Bears"] },
    {}
   ]
  }
 },
 {
  "name": "casting the Adventure half (an instant) does not draw",
  "players": [
   { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Mountain", "Mountain", "Edgewall Innkeeper"], "library": ["Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": [], "exile": ["Bonecrusher Giant // Stomp"] },
    { "life": 18 }
   ]
  }
 },
 {
  "name": "ruling: an Adventure spell cast as its Adventure does not trigger the Innkeeper",
  "players": [
   { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Mountain", "Mountain", "Edgewall Innkeeper"], "library": ["Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 0, "library_count": 1 },
    { "life": 18 }
   ]
  }
 },
 {
  "name": "ruling: the Innkeeper's draw resolves before a countered Adventure creature spell and still happens",
  "players": [
   { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Mountain", "Mountain", "Mountain", "Edgewall Innkeeper"], "library": ["Mountain"] },
   { "hand": ["Essence Scatter"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Bonecrusher Giant // Stomp" },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "cast": "Essence Scatter", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Mountain"], "graveyard": ["Bonecrusher Giant // Stomp"] },
    { "graveyard": ["Essence Scatter"] }
   ]
  }
 }
]
