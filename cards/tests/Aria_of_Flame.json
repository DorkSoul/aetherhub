 {
   "name": "ruling: the last ability still resolves when the spell that caused it is countered",
   "players": [
    { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Aria of Flame"] },
    { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
   ],
