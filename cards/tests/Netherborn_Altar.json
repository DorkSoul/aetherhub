[
 {
  "name": "with no commander in the command zone it only makes you lose life",
  "commander": true,
  "players": [
   {
    "battlefield": [
     "Netherborn Altar"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Netherborn Altar",
    "ability": 0
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 17,
     "hand_count": 0
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: the soul counter placed as a cost counts on resolution (one already there: lose 6)",
  "commander": true,
  "players": [ { "battlefield": [ { "name": "Netherborn Altar", "counters": { "Soul": 1 } } ] }, {} ],
  "steps": [ { "activate": "Netherborn Altar", "ability": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "life": 14 }, {} ], "counters": { "Netherborn Altar": { "Soul": 2 } } }
 },
 {
  "name": "ruling: with two commanders in the command zone only the chosen one goes to hand",
  "commander": true,
  "players": [ { "battlefield": ["Netherborn Altar"], "command": ["Krenko, Mob Boss", "Tymna the Weaver"] }, {} ],
  "steps": [ { "activate": "Netherborn Altar", "ability": 0 }, { "resolve": true, "answers": ["Krenko, Mob Boss"] } ],
  "expect": { "players": [ { "life": 17, "hand": ["Krenko, Mob Boss"], "command": ["Tymna the Weaver"] }, {} ] }
 },
 {
  "name": "ruling: sacrificed in response, the life loss uses the counters it had (3 life)",
  "commander": true,
  "players": [ { "battlefield": ["Netherborn Altar", "Scrap Welder"], "graveyard": ["Sol Ring"] }, {} ],
  "steps": [
   { "activate": "Netherborn Altar", "ability": 0 },
   { "activate": "Scrap Welder", "targets": ["Sol Ring"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "life": 17, "battlefield_has": ["Scrap Welder", "Sol Ring"], "battlefield_lacks": ["Netherborn Altar"], "graveyard_has": ["Netherborn Altar"] }, {} ] }
 }
]