[
  {
    "name": "one Bobblehead: up to 1 creature gains haste until end of turn",
    "players": [
      {
        "battlefield": ["Agility Bobblehead", "Mountain", "Mountain", "Mountain", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "Agility Bobblehead", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Haste"] },
      "players": [{ "battlefield_has": ["Agility Bobblehead", "Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "two Bobbleheads: up to 2 creatures gain haste",
    "players": [
      {
        "battlefield": ["Agility Bobblehead", "Agility Bobblehead", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant", "Savannah Lions"]
      },
      {}
    ],
    "steps": [
      { "activate": "Agility Bobblehead", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Haste"], "Hill Giant": ["Haste"] }
    }
  },
  {
    "name": "ruling: giving 'can't be blocked except by haste' does not unblock an already-blocked creature",
    "players": [
      { "battlefield": ["Agility Bobblehead", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "pass": true },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "activate": "Agility Bobblehead", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Agility Bobblehead"] }, { "life": 20 } ] }
  },
  {
    "name": "ruling: the targets are fixed on activation; a Bobblehead destroyed in response does not change them",
    "players": [
      { "battlefield": ["Agility Bobblehead", "Agility Bobblehead", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] },
      { "hand": ["Bant Charm"], "battlefield": ["Forest", "Plains", "Island"] }
    ],
    "steps": [
      { "activate": "Agility Bobblehead", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "cast": "Bant Charm", "player": 1, "answers": [0], "targets": ["Agility Bobblehead"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Haste"], "Hill Giant": ["Haste"] },
      "players": [ { "graveyard": ["Agility Bobblehead"], "battlefield_has": ["Grizzly Bears", "Hill Giant"] }, { "graveyard": ["Bant Charm"] } ]
    }
  }
]
