[
  {
    "name": "enters: create two Food tokens",
    "players": [
      { "hand": ["Orchard Strider"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Orchard Strider" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Orchard Strider", "Food", "Food"] },
        {}
      ]
    }
  },
  {
    "name": "basic landcycling: search for a basic land",
    "players": [
      { "hand": ["Orchard Strider"], "battlefield": ["Forest", "Forest"], "library": ["Sol Ring", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Orchard Strider" },
      { "resolve": true, "answers": ["Plains"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Orchard Strider"], "hand": ["Plains"] },
        {}
      ]
    }
  },
  {
    "name": "basic landcycling can't fetch a nonbasic land or a nonland card",
    "players": [
      { "hand": ["Orchard Strider"], "battlefield": ["Forest", "Forest"], "library": ["Sol Ring"] },
      {}
    ],
    "steps": [
      { "activate": "Orchard Strider" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Orchard Strider"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: typecycling is a discard, so a discard trigger (Archfiend of Ifnir) fires",
    "players": [
      { "hand": ["Orchard Strider"], "battlefield": ["Forest", "Forest", "Archfiend of Ifnir"], "library": ["Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Orchard Strider" },
      { "resolve": true, "answers": ["Plains"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Orchard Strider"], "hand": ["Plains"] },
        {}
      ],
      "pt": { "Grizzly Bears": [1, 1] }
    }
  },
  {
    "name": "ruling: typecycling fetches a basic land without drawing a card",
    "players": [
      { "hand": ["Orchard Strider"], "battlefield": ["Forest", "Forest"], "library": ["Sol Ring", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Orchard Strider" },
      { "resolve": true, "answers": ["Plains"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Orchard Strider"], "hand": ["Plains"], "hand_count": 1 },
        {}
      ]
    }
  }
]
