  {
    "name": "ruling: Vivi's counter and damage resolve before the spell that caused them",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Vivi Ornitier", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "stack_empty": false,
      "pt": { "Vivi Ornitier": [1, 4] },
      "players": [ {}, { "life": 19 } ]
    }
  },
  {
    "name": "ruling: Vivi's trigger still resolves when the noncreature spell is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Vivi Ornitier", "sick": false }, "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Vivi Ornitier": [1, 4] },
      "players": [
        { "graveyard_has": ["Lightning Bolt"] },
        { "life": 19, "graveyard_has": ["Counterspell"] }
      ]
    }
  }
