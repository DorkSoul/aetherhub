[
  {
    "name": "excess damage over a 2/2 creates a Lander",
    "players": [
      { "hand": ["Orbital Plunge"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Orbital Plunge", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lander"] },
        { "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "exactly lethal damage (6 vs toughness 6): no excess, no Lander",
    "players": [
      { "hand": ["Orbital Plunge"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Aethersquall Ancient"] }
    ],
    "steps": [
      { "cast": "Orbital Plunge", "targets": ["Aethersquall Ancient"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Lander"] },
        { "battlefield_lacks": ["Aethersquall Ancient"] }
      ]
    }
  },
  { "name": "ruling: damage already marked on the creature counts toward lethal, so excess is measured against the remaining toughness",
    "players": [ { "hand": ["Lightning Bolt", "Orbital Plunge"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Aethersquall Ancient"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Aethersquall Ancient"] }, { "resolve": true }, { "cast": "Orbital Plunge", "targets": ["Aethersquall Ancient"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Lander"] }, { "battlefield_lacks": ["Aethersquall Ancient"] } ] } }
]
