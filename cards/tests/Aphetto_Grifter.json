[
 {
  "name": "tap two Wizards: tap target permanent",
  "players": [ { "battlefield": ["Aphetto Grifter", "Aphetto Runecaster"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "activate": "Aphetto Grifter", "ability": 0, "targets": ["Grizzly Bears"] },
    { "resolve": true }
  ],
  "expect": { "tapped": { "Grizzly Bears": true, "Aphetto Grifter": true, "Aphetto Runecaster": true } }
 },
 {
  "name": "needs two untapped Wizards to pay",
  "players": [ { "battlefield": ["Aphetto Grifter", "Grizzly Bears"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "activate": "Aphetto Grifter", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": { "tapped": { "Aphetto Grifter": false } }
 },
 {
  "name": "ruling: summoning-sick Wizards can be tapped to pay the cost",
  "players": [ { "battlefield": [ {"name": "Aphetto Grifter", "sick": true}, {"name": "Aphetto Runecaster", "sick": true} ] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "activate": "Aphetto Grifter", "ability": 0, "targets": ["Grizzly Bears"] },
    { "resolve": true }
  ],
  "expect": { "tapped": { "Grizzly Bears": true, "Aphetto Grifter": true, "Aphetto Runecaster": true } }
 }
]
