[
  {
    "name": "equip {4}; equipped creature has double strike",
    "players": [ { "battlefield": ["Grappling Hook", "Grizzly Bears", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "activate": "Grappling Hook", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "attached": { "Grappling Hook": "Grizzly Bears" }, "keywords": { "Grizzly Bears": ["DoubleStrike"] } }
  },
  {
    "name": "when the equipped creature attacks, the chosen creature must block it",
    "players": [ { "battlefield": ["Grappling Hook", "Grizzly Bears", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Grappling Hook", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "targets": ["Hill Giant"], "answers": [true] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Hill Giant"], "life": 20 } ] }
  },
  {
    "name": "the attack trigger is optional: declining leaves the attack unblocked",
    "players": [ { "battlefield": ["Grappling Hook", "Grizzly Bears", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Grappling Hook", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "targets": ["Hill Giant"], "answers": [false] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "ruling: a creature that can't block the attacker (flying) makes the requirement do nothing",
    "players": [ { "battlefield": ["Grappling Hook", "Serra Angel", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Grappling Hook", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "attack": [ { "card": "Serra Angel", "at": "p1" } ] },
      { "resolve": true, "targets": ["Hill Giant"], "answers": [true] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Hill Giant"], "life": 12 } ] }
  },
  {
    "name": "ruling: a tapped creature is exempt from the forced block",
    "players": [ { "battlefield": ["Grappling Hook", "Grizzly Bears", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": [ { "name": "Hill Giant", "tapped": true } ] } ],
    "steps": [
      { "activate": "Grappling Hook", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "targets": ["Hill Giant"], "answers": [true] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Hill Giant"], "life": 16 } ] }
  }
]
