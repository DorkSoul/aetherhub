    "players": [ { "hand": ["Daniels, Temporal Agent"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Daniels, Temporal Agent" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "graveyard": ["Lightning Bolt"] }, {} ] } },
  { "name": "from the graveyard: pay 2 and put it on the bottom of the library to gain 2 life",
    "players": [ { "battlefield": ["Forest", "Forest"], "graveyard": ["Daniels, Temporal Agent"] }, {} ],
    "steps": [ { "activate": "Daniels, Temporal Agent", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "graveyard": [] }, {} ] } }
