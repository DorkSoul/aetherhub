    "steps": [ { "cast": "Daniels, Temporal Agent" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Daniels, Temporal Agent"], "graveyard": [] }, {} ] } },
