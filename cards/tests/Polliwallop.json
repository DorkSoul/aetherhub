[
  {
    "name": "Frog reduces the cost; the creature you control deals twice its power",
    "players": [{ "hand": ["Polliwallop"], "battlefield": ["Forest", "Forest", "Forest", "Pond Prophet", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] }],
    "steps": [{ "cast": "Polliwallop", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Polliwallop"] }, { "graveyard": ["Hill Giant"] }] }
  },
  {
    "name": "without a Frog it costs 4 and three lands are not enough",
    "players": [{ "hand": ["Polliwallop"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] }],
    "steps": [{ "cast": "Polliwallop", "illegal": true }],
    "expect": { "players": [{ "hand": ["Polliwallop"] }, { "battlefield_has": ["Hill Giant"] }] }
  },
  {
    "name": "ruling: if the creature you control is illegal on resolution, it deals no damage",
    "players": [
      { "hand": ["Polliwallop"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Polliwallop", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Polliwallop", "Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]
