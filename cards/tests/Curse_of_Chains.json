[
  {
    "name": "taps the enchanted creature at the next upkeep, even an opponent's",
    "players": [ { "hand": ["Curse of Chains"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Curse of Chains", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "attached": { "Curse of Chains": "Grizzly Bears" }
    }
  },
  {
    "name": "does not tap the creature before any upkeep",
    "players": [ { "hand": ["Curse of Chains"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Curse of Chains", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  }
]
