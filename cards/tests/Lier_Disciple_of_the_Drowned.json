[
 {
  "name": "an instant in your graveyard can be cast with flashback for its mana cost and is then exiled",
  "players": [
   { "battlefield": ["Lier, Disciple of the Drowned", "Mountain"], "graveyard": ["Lightning Bolt"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Lier, Disciple of the Drowned"], "exile": ["Lightning Bolt"] },
    { "life": 17 }
   ]
  }
 },
 {
  "name": "a creature card in your graveyard does not gain flashback",
  "players": [
   { "battlefield": ["Lier, Disciple of the Drowned", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears", "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Grizzly Bears"] },
    {}
   ]
  }
 },
 {
  "name": "spells can't be countered: opponent's Counterspell on my Lightning Bolt fails",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Lier, Disciple of the Drowned", "Mountain"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt"], "battlefield_has": ["Lier, Disciple of the Drowned"] },
    { "life": 17, "graveyard": ["Counterspell"] }
   ],
   "stack_empty": true
  }
 },
 {
  "name": "ruling: a flashback spell that fizzles is still exiled afterward",
  "players": [
   { "battlefield": ["Lier, Disciple of the Drowned", "Mountain"], "graveyard": ["Lightning Bolt"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Lightning Bolt"] },
    { "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
