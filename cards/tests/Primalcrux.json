    "players": [
      {
        "hand": [
          "Primalcrux"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
