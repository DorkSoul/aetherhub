          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "pass": true
      }
    ],
    "expect": {
      "pt": {
        "Primalcrux": [
          7,
          7
        ]
      }
    }
  },
  {
    "name": "permanents an opponent controls do not count",
    "players": [
      {
        "battlefield": [
          "Primalcrux"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      }
    ],
    "expect": {
      "pt": {
        "Primalcrux": [
          6,
          6
        ]
      }
    }
  },
  {
    "name": "ruling: a Primalcrux in the graveyard does not count itself",
    "players": [
      { "battlefield": ["Primalcrux"], "graveyard": ["Primalcrux"] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Primalcrux": [6, 6]
      }
    }
  },
  {
    "name": "ruling: chroma counts mana costs only, not green symbols in rules text (Abzan Banner)",
    "players": [
      { "battlefield": ["Primalcrux", "Abzan Banner"] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Primalcrux": [6, 6]
      }
    }
  },
  {
    "name": "ruling: hybrid {G/W} symbols on another permanent count as green (Sumala Rumblers adds 2)",
    "players": [
      { "battlefield": ["Primalcrux", "Sumala Rumblers"] },
      {}
    ],
    "steps": [],
