[
  {
    "name": "sacrifice and tap: destroys target artifact",
    "players": [
      { "battlefield": ["Elvish Scrapper", "Forest"] },
      { "battlefield": ["Burnished Hart"] }
    ],
    "steps": [
      { "activate": "Elvish Scrapper", "targets": ["Burnished Hart"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Elvish Scrapper"] },
        { "graveyard": ["Burnished Hart"] }
      ]
    }
  },
  {
    "name": "target must be an artifact",
    "players": [
      { "battlefield": ["Elvish Scrapper", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Elvish Scrapper", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Elvish Scrapper", "Forest"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "summoning sick creature cannot use the tap cost",
    "players": [
      { "battlefield": [{ "name": "Elvish Scrapper", "sick": true }, "Forest"] },
      { "battlefield": ["Burnished Hart"] }
    ],
    "steps": [
      { "activate": "Elvish Scrapper", "targets": ["Burnished Hart"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Elvish Scrapper", "Forest"] },
        { "battlefield": ["Burnished Hart"] }
      ]
    }
  }
]
