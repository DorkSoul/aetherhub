[
  { "name": "gift promised: opponent gets a Food and the creature is destroyed; no life loss",
    "players": [ { "hand": ["Nocturnal Hunger"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Nocturnal Hunger", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Nocturnal Hunger"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Food"] } ] } },
  { "name": "gift not promised: destroy the creature and lose 2 life",
    "players": [ { "hand": ["Nocturnal Hunger"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Nocturnal Hunger", "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 18, "graveyard": ["Nocturnal Hunger"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "no creature to target: cannot cast",
    "players": [ { "hand": ["Nocturnal Hunger"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Nocturnal Hunger", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Nocturnal Hunger"], "life": 20 }, {} ] } },
  { "name": "ruling: gift is given as the spell resolves, before its destroy: the opponent gets the Food",
    "players": [ { "hand": ["Nocturnal Hunger"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Nocturnal Hunger", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Nocturnal Hunger"] }, { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Food"] } ] } },
  { "name": "ruling: gift promised, then the spell does not resolve (its target is gone): no Food for the opponent",
    "players": [ { "hand": ["Nocturnal Hunger", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Nocturnal Hunger", "answers": [true], "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Nocturnal Hunger", "Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Food"] } ] } }
]
