              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "graveyard": ["Savannah Lions", "Carom"], "hand_count": 1 },
                            { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "does not redirect damage aimed at a creature other than the first target",
   "players": [ { "hand": ["Carom"], "battlefield": ["Plains", "Plains", "Hill Giant", "Savannah Lions"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
              { "cast": "Carom", "targets": ["Savannah Lions", "Hill Giant"] },
              { "resolve": true },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Savannah Lions"], "graveyard": ["Carom", "Hill Giant"] },
                            { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "ruling: Carom's controller draws when Carom resolves, before the redirected damage",
   "players": [ { "hand": ["Carom"], "battlefield": ["Plains", "Plains", "Hill Giant", "Savannah Lions"], "library": ["Forest"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
