[
 {
  "name": "choose red: the Servant and every permanent gain red in addition to their colors",
  "players": [
   { "hand": [ "Painter's Servant" ], "battlefield": [ "Forest", "Forest", "Grizzly Bears" ] },
   { "battlefield": [ "Serra Angel" ] }
  ],
  "steps": [
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "R" ] }
  ],
  "expect": { "colors": { "Painter's Servant": [ "R" ], "Grizzly Bears": [ "G", "R" ], "Serra Angel": [ "W", "R" ] } }
 },
 {
  "name": "the chosen color is the one picked (blue)",
  "players": [
   { "hand": [ "Painter's Servant" ], "battlefield": [ "Forest", "Forest", "Hill Giant" ] },
   {}
  ],
  "steps": [
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "U" ] }
  ],
  "expect": { "colors": { "Painter's Servant": [ "U" ], "Hill Giant": [ "R", "U" ] } }
 },
 {
  "name": "the colors revert when the Servant leaves the battlefield",
  "players": [
   { "hand": [ "Painter's Servant", "Lightning Bolt" ], "battlefield": [ "Forest", "Forest", "Mountain", "Grizzly Bears" ] },
   {}
  ],
  "steps": [
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "W" ] },
   { "cast": "Lightning Bolt", "targets": [ "Painter's Servant" ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": [ "Lightning Bolt", "Painter's Servant" ] }, {} ], "colors": { "Grizzly Bears": [ "G" ] } }
 },
 {
  "name": "spells are painted too: with red chosen a green creature spell is red and Hydroblast counters it",
  "players": [
   { "hand": [ "Painter's Servant", "Grizzly Bears" ], "battlefield": [ "Forest", "Forest", "Forest", "Forest" ] },
   { "hand": [ "Hydroblast" ], "battlefield": [ "Island" ] }
  ],
  "steps": [
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "R" ] },
   { "cast": "Grizzly Bears" },
   { "pass": true },
   { "player": 1, "cast": "Hydroblast", "targets": [ { "stack": "Grizzly Bears" } ], "answers": [ 0 ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": [ "Grizzly Bears" ], "battlefield_lacks": [ "Grizzly Bears" ] }, {} ] }
 },
 {
  "name": "without the Servant the same green spell is not red and Hydroblast does nothing",
  "players": [
   { "hand": [ "Grizzly Bears" ], "battlefield": [ "Forest", "Forest" ] },
   { "hand": [ "Hydroblast" ], "battlefield": [ "Island" ] }
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "pass": true },
   { "player": 1, "cast": "Hydroblast", "targets": [ { "stack": "Grizzly Bears" } ], "answers": [ 0 ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": [ "Grizzly Bears" ] }, {} ] }
 },
 {
  "name": "ruling: Cerulean Wisps makes the creature blue only, overriding the chosen colour",
  "players": [
   { "hand": [ "Painter's Servant", "Cerulean Wisps" ], "battlefield": [ "Island", "Forest", "Forest", "Grizzly Bears" ] },
   {}
  ],
  "steps": [
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "R" ] },
   { "cast": "Cerulean Wisps", "targets": [ "Grizzly Bears" ] },
   { "resolve": true }
  ],
  "expect": { "colors": { "Painter's Servant": [ "R" ], "Grizzly Bears": [ "U" ] } }
 },
 {
  "name": "ruling: a colourless permanent simply becomes the chosen colour (Sol Ring is red only)",
  "players": [
   { "hand": [ "Painter's Servant" ], "battlefield": [ "Forest", "Forest", "Sol Ring" ] },
   {}
  ],
  "steps": [
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "R" ] }
  ],
  "expect": { "colors": { "Sol Ring": [ "R" ] } }
 },
 {
  "name": "ruling: two Servants are cumulative (red and blue both added to the Bears)",
  "players": [
   { "hand": [ "Painter's Servant", "Painter's Servant" ], "battlefield": [ "Forest", "Forest", "Forest", "Forest", "Grizzly Bears" ] },
   {}
  ],
  "steps": [
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "R" ] },
   { "cast": "Painter's Servant" },
   { "resolve": true, "answers": [ "U" ] }
  ],
  "expect": { "colors": { "Grizzly Bears": [ "G", "R", "U" ] } }
 }
]
