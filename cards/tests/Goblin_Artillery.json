[
  {
    "name": "2 damage to a creature and 3 to its controller",
    "players": [{ "battlefield": ["Goblin Artillery"] }, { "battlefield": ["Savannah Lions"] }],
    "steps": [{ "activate": "Goblin Artillery", "targets": ["Savannah Lions"] }, { "resolve": true }],
    "expect": { "players": [{ "life": 17 }, { "graveyard": ["Savannah Lions"] }], "tapped": { "Goblin Artillery": true } }
  },
  {
    "name": "can target a player",
    "players": [{ "battlefield": ["Goblin Artillery"] }, {}],
    "steps": [{ "activate": "Goblin Artillery", "targets": ["p1"] }, { "resolve": true }],
    "expect": { "players": [{ "life": 17 }, { "life": 18 }] }
  },
  {
    "name": "tapped artillery cannot activate again",
    "players": [{ "battlefield": [{ "name": "Goblin Artillery", "tapped": true }] }, {}],
    "steps": [{ "activate": "Goblin Artillery", "targets": ["p1"], "illegal": true }],
    "expect": {}
  },
  {
    "name": "ruling: if the target is gone when the ability resolves, it does nothing and I take no damage",
    "players": [{ "hand": ["Unsummon"], "battlefield": ["Goblin Artillery", "Island"] }, { "battlefield": ["Savannah Lions"] }],
    "steps": [
      { "activate": "Goblin Artillery", "targets": ["Savannah Lions"] },
      { "cast": "Unsummon", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 20 }, { "life": 20, "hand": ["Savannah Lions"] }], "tapped": { "Goblin Artillery": true } }
  }
]
