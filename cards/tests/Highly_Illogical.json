  { "name": "unkicked: cannot target a spell with mana value 3",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island"] }, { "hand": ["Highly Illogical"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Divination" }, { "cast": "Highly Illogical", "player": 1, "targets": [{ "stack": "Divination" }], "illegal": true } ],
    "expect": { "stack_empty": false, "players": [ { "hand_count": 0 }, { "hand_count": 1 } ] } },
