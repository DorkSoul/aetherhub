    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island"] }, { "hand": ["Highly Illogical"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
    "steps": [ { "cast": "Divination" }, { "cast": "Highly Illogical", "player": 1, "answers": [true], "targets": [{ "stack": "Divination" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Divination"] }, { "graveyard": ["Highly Illogical"] } ], "stack_empty": true } }
