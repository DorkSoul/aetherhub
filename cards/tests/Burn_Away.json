[
  { "name": "6 damage kills the creature and exiles its controller's graveyard",
    "players": [ { "hand": ["Burn Away"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"], "graveyard": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Burn Away", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": [], "exile": ["Lightning Bolt", "Grizzly Bears"] } ] } },
  { "name": "the graveyard is not exiled when the creature survives",
    "players": [ { "hand": ["Burn Away"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Bosh, Iron Golem"], "graveyard": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Burn Away", "targets": ["Bosh, Iron Golem"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: a creature that survives this turn leaves no delayed trigger for a later turn",
    "players": [ { "hand": ["Burn Away", "Stonefury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Bosh, Iron Golem"], "graveyard": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Burn Away", "targets": ["Bosh, Iron Golem"] },
               { "resolve": true },
               { "advance_to": "Main2" },
               { "advance_to": "Main1" },
               { "advance_to": "Main2" },
               { "advance_to": "Main1" },
               { "cast": "Stonefury", "targets": ["Bosh, Iron Golem"] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Burn Away", "Stonefury"] }, { "graveyard": ["Lightning Bolt", "Bosh, Iron Golem"], "exile": [] } ] } }
]
