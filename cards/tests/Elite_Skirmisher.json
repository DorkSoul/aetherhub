[
  {
    "name": "a spell targeting it lets you tap target creature",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Forest",
          "Elite Skirmisher"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Elite Skirmisher",
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Elite Skirmisher"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ],
      "tapped": {
        "Grizzly Bears": true,
        "Elite Skirmisher": false
      }
    }
  },
  {
    "name": "a spell that does not target it does not trigger",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Forest",
          "Elite Skirmisher",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Elite Skirmisher",
            "Grizzly Bears"
          ]
        },
        {}
      ],
      "tapped": {
        "Elite Skirmisher": false,
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "ruling: the heroic trigger resolves before the spell that caused it",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Elite Skirmisher"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Elite Skirmisher", "Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "answers": [true] }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Elite Skirmisher": [3, 1] },
      "tapped": { "Grizzly Bears": true },
      "stack_empty": false
    }
  },
  {
    "name": "ruling: a copy of the targeting spell does not trigger heroic again",
    "players": [
      { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Forest", "Island", "Island", "Elite Skirmisher"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Elite Skirmisher", "Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Twincast", "targets": [{ "stack": "Giant Growth" }], "answers": [true] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "tapped": { "Grizzly Bears": true },
      "stack_empty": true
    }
  }
]