[
  { "name": "bounces opposing creatures with toughness X or less, X = Islands you control",
    "players": [ { "hand": ["Spectral Deluge"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Llanowar Elves"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Spectral Deluge" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Llanowar Elves"], "graveyard": ["Spectral Deluge"] },
                             { "hand": ["Grizzly Bears"], "battlefield": [] } ] } },
  { "name": "creature with toughness above the Island count stays",
    "players": [ { "hand": ["Spectral Deluge"], "battlefield": ["Island", "Island", "Swamp", "Swamp", "Swamp", "Swamp"] },
                 { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Spectral Deluge" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Spectral Deluge"] },
                             { "hand": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "foretell pays {2} and exiles the card face down",
    "players": [ { "hand": ["Spectral Deluge"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Spectral Deluge", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Spectral Deluge"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: foretelling is a special action, allowed in response to your own spell",
    "players": [ { "hand": ["Lightning Bolt", "Spectral Deluge"], "battlefield": ["Mountain", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "activate": "Spectral Deluge", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Spectral Deluge"], "graveyard": ["Lightning Bolt"], "hand_count": 0 }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a foretold sorcery cannot be cast on the opponent's turn",
    "players": [ { "hand": ["Spectral Deluge"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Spectral Deluge", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "pass": true, "player": 1 }, { "cast": "Spectral Deluge", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Spectral Deluge"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a foretold sorcery is cast for {1}{U}{U} on your next turn; X counts the Islands on resolution",
    "players": [ { "hand": ["Spectral Deluge"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Spectral Deluge", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Spectral Deluge", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Spectral Deluge"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } }
]
