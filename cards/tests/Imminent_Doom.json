[
 { "name": "ruling: X counts toward mana value (Blaze X=2 is MV 3 and triggers three doom counters)",
   "players": [ { "hand": ["Blaze"], "battlefield": ["Mountain", "Mountain", "Mountain", {"name": "Imminent Doom", "counters": {"doom": 3}}] }, {} ],
   "steps": [ { "cast": "Blaze", "targets": ["p1", "p1"], "answers": [2] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 15 } ], "counters": { "Imminent Doom": { "doom": 4 } } } },
 { "name": "ruling: a second spell cast in response to the trigger also triggers; both triggers deal 1 (counters at trigger time)",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", {"name": "Imminent Doom", "counters": {"doom": 1}}] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1", "p1"] }, { "cast": "Lightning Bolt", "targets": ["p1", "p1"] }, { "resolve": true }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 12 } ], "counters": { "Imminent Doom": { "doom": 3 } } } },
 { "name": "ruling: the trigger still resolves when the spell that caused it is countered",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", {"name": "Imminent Doom", "counters": {"doom": 1}}] }, { "battlefield": ["Island", "Island"], "hand": ["Counterspell"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1", "p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{"stack": "Lightning Bolt"}] }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 19, "graveyard": ["Counterspell"] } ], "counters": { "Imminent Doom": { "doom": 2 } } } },
 { "name": "casting a spell whose mana value equals the doom counters deals that much damage and adds a counter",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", {"name": "Imminent Doom", "counters": {"doom": 1}}] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1", "p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 16 } ] } },
 { "name": "a spell with a different mana value does not trigger",
   "players": [ { "hand": ["Lightning Strike"], "battlefield": ["Mountain", "Mountain", {"name": "Imminent Doom", "counters": {"doom": 1}}] }, {} ],
   "steps": [ { "cast": "Lightning Strike", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 17 } ] } },
 { "name": "damage equals the mana value (= counters when triggered), not the counters after resolution",
   "players": [ { "hand": ["Lightning Strike"], "battlefield": ["Mountain", "Mountain", {"name": "Imminent Doom", "counters": {"doom": 2}}] }, {} ],
   "steps": [ { "cast": "Lightning Strike", "targets": ["p1", "p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 15 } ] } },
 { "name": "enters with one doom counter",
   "players": [ { "hand": ["Imminent Doom"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Imminent Doom" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Imminent Doom"] }, {} ], "counters": { "Imminent Doom": { "doom": 1 } } } }
]
