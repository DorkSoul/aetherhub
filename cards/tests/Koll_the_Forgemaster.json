[
  { "name": "creature tokens that are equipped get +1/+1",
    "players": [ { "battlefield": ["Koll, the Forgemaster", "Soldier", "Bonesplitter", "Plains"] }, {} ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Soldier"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Soldier": [4, 2] } } },
  { "name": "an equipped creature that dies returns to its owner's hand",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Koll, the Forgemaster", "Grizzly Bears", "Bonesplitter", "Mountain", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Koll, the Forgemaster"] }, {} ] } },
  { "name": "ruling: a token with two attachments still gets only +1/+1 from Koll",
    "players": [ { "hand": ["Unflinching Courage"], "battlefield": ["Koll, the Forgemaster", "Soldier", "Bonesplitter", "Plains", "Forest", "Plains", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Soldier"] },
      { "resolve": true },
      { "cast": "Unflinching Courage", "targets": ["Soldier"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Soldier": [6, 4] } } },
  { "name": "ruling: an Aura controlled by the opponent still makes the token enchanted for Koll",
    "players": [ { "battlefield": ["Koll, the Forgemaster", "Soldier"] }, { "hand": ["Unflinching Courage"], "battlefield": ["Forest", "Plains", "Mountain"] } ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Unflinching Courage", "player": 1, "targets": ["Soldier"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Soldier": [4, 4] }, "attached": { "Unflinching Courage": "Soldier" } } }
]
