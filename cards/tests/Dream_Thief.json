[
  { "name": "draws when another blue spell was cast this turn",
    "players": [ { "hand": ["Air Elemental", "Dream Thief"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Air Elemental" }, { "resolve": true },
      { "cast": "Dream Thief" }, { "resolve": true }, { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Dream Thief", "Air Elemental"], "hand_count": 1 }, {} ] } },
  { "name": "no draw when no other blue spell was cast this turn",
    "players": [ { "hand": ["Dream Thief"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Dream Thief" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dream Thief"], "hand_count": 0 }, {} ] } },
  { "name": "a non-blue spell does not count",
    "players": [ { "hand": ["Grizzly Bears", "Dream Thief"], "battlefield": ["Forest", "Forest", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "cast": "Dream Thief" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dream Thief", "Grizzly Bears"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: Zombify puts it onto the battlefield and the check still looks at blue spells cast this turn",
    "players": [ { "hand": ["Air Elemental", "Zombify"], "graveyard": ["Dream Thief"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Air Elemental" }, { "resolve": true }, { "cast": "Zombify" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dream Thief", "Air Elemental"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: a blue instant cast in response to the enters trigger still gives the draw",
    "players": [ { "hand": ["Dream Thief", "Unsummon"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Dream Thief" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Unsummon", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dream Thief"], "hand_count": 1 }, { "battlefield_lacks": ["Grizzly Bears"], "hand_count": 1 } ] } }
]
