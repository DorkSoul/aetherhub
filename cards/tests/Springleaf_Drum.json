[
 {
  "name": "taps Drum and a creature for one mana of any colour",
  "players": [
   {
    "battlefield": [
     "Springleaf Drum",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Springleaf Drum",
    "color": "U"
   }
  ],
  "expect": {
   "tapped": {
    "Springleaf Drum": true,
    "Grizzly Bears": true
   },
   "players": [
    {
     "pool": {
      "U": 1
     }
    },
    {}
   ]
  }
 },
 {
  "name": "a tapped creature can't pay",
  "players": [
   {
    "battlefield": [
     "Springleaf Drum",
     {
      "name": "Grizzly Bears",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Springleaf Drum",
    "color": "U",
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Springleaf Drum": false
   }
  }
 },
 {
  "name": "no creature, no mana",
  "players": [
   {
    "battlefield": [
     "Springleaf Drum"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Springleaf Drum",
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Springleaf Drum": false
   }
  }
 },
 {
  "name": "ruling: a summoning-sick creature can be tapped to pay for the Drum",
  "players": [ { "battlefield": ["Springleaf Drum", { "name": "Grizzly Bears", "sick": true }] }, {} ],
  "steps": [ { "tap_for_mana": "Springleaf Drum", "color": "R" } ],
  "expect": { "tapped": { "Springleaf Drum": true, "Grizzly Bears": true }, "players": [ { "pool": { "R": 1 } }, {} ] }
 },
 {
  "name": "ruling: a creature cast this turn can be tapped to pay for the Drum",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Springleaf Drum", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "tap_for_mana": "Springleaf Drum", "color": "R" } ],
  "expect": { "tapped": { "Springleaf Drum": true, "Grizzly Bears": true }, "players": [ { "pool": { "R": 1 } }, {} ] }
 }
]