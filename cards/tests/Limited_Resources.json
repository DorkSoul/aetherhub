[
  {
    "name": "each player keeps five lands and sacrifices the rest",
    "players": [
      { "hand": ["Limited Resources"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Limited Resources" },
      { "resolve": true, "answers": [["Plains", "Plains", "Plains", "Plains", "Plains"]] }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Plains"] },
        { "battlefield_has": ["Island", "Island", "Island"] }
      ]
    }
  },
  {
    "name": "players can't play lands while ten or more lands are on the battlefield",
    "players": [
      { "hand": ["Mountain"], "battlefield": ["Limited Resources", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "play_land": "Mountain", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Mountain"] }, {} ] }
  },
  {
    "name": "with nine lands on the battlefield a land can be played",
    "players": [
      { "hand": ["Mountain"], "battlefield": ["Limited Resources", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "play_land": "Mountain" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Mountain"] }, {} ] }
  },
  {
    "name": "ruling: lands can still enter the battlefield from effects while playing lands is blocked",
    "players": [
      { "hand": ["Golos, Tireless Pilgrim", "Mountain"], "battlefield": ["Limited Resources", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "play_land": "Mountain", "illegal": true },
      { "cast": "Golos, Tireless Pilgrim" },
      { "resolve": true, "answers": [true, "Island"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Golos, Tireless Pilgrim", "Island"], "hand": ["Mountain"] },
        {}
      ]
    }
  }
]
