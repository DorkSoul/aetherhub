[
  {
    "name": "two tokens entering at once put two +1/+1 counters on it",
    "players": [
      {
        "hand": ["Elemental Masterpiece"],
        "battlefield": ["Woodland Champion", "Island", "Island", "Island", "Mountain", "Mountain", "Plains", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Elemental Masterpiece" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Elemental 4-4 UR", "Elemental 4-4 UR"] },
        {}
      ],
      "counters": { "Woodland Champion": { "p1p1": 2 } },
      "pt": { "Woodland Champion": [4, 4] }
    }
  },
  {
    "name": "a non-token creature entering puts no counters on it",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Woodland Champion", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        {}
      ],
      "pt": { "Woodland Champion": [2, 2] }
    }
  },
  {
    "name": "ruling: counters match the tokens that entered even if one leaves before the trigger resolves",
    "players": [
      {
        "hand": ["Elemental Masterpiece"],
        "battlefield": ["Woodland Champion", "Island", "Island", "Island", "Mountain", "Mountain", "Plains", "Plains"]
      },
      { "hand": ["Unsummon"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "cast": "Elemental Masterpiece" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Unsummon", "targets": ["Elemental 4-4 UR"], "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Elemental 4-4 UR"] }, {} ],
      "counters": { "Woodland Champion": { "p1p1": 2 } },
      "pt": { "Woodland Champion": [4, 4] }
    }
  }
]
