[
  {
    "name": "can't attack while defending player controls an untapped land",
    "players": [
      {
        "battlefield": [
          "Veteran Brawlers"
        ]
      },
      {
        "battlefield": [
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Veteran Brawlers",
            "at": "p1"
          }
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "can attack once the defending player's land is tapped",
    "players": [
      {
        "battlefield": [
          "Veteran Brawlers"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Plains",
            "tapped": true
          }
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Veteran Brawlers",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 16
        }
      ]
    }
  },
  {
    "name": "can't block while you control an untapped land (second blocker present): unblocked damage",
    "players": [
      { "battlefield": ["Veteran Brawlers", "Hill Giant", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Veteran Brawlers", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 18 }, {} ] }
  },
  {
    "name": "can block when your only land is tapped: Bears blocked, no damage",
    "players": [
      { "battlefield": ["Veteran Brawlers", { "name": "Plains", "tapped": true }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Veteran Brawlers", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20 }, {} ] }
  },
  {
    "name": "can't attack an untapped-land defender: Brawlers is dropped, the other attacker deals 2",
    "players": [
      { "battlefield": ["Veteran Brawlers", "Grizzly Bears"] },
      { "battlefield": ["Plains"] }
    ],
    "steps": [
      { "attack": [ { "card": "Veteran Brawlers", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  }
]
