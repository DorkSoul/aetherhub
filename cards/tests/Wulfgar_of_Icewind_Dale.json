      { "battlefield": [ { "name": "Wulfgar of Icewind Dale", "sick": false }, { "name": "Deputized Protester", "sick": false } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Deputized Protester": [2, 1], "Wulfgar of Icewind Dale": [4, 4] }
    }
  },
  {
