[
  {
    "name": "ETB exiles up to two target cards from a single graveyard",
    "players": [
      { "hand": [ "Gravegouger" ], "battlefield": [ "Swamp", "Swamp", "Swamp" ] },
      { "graveyard": [ "Grizzly Bears", "Hill Giant" ] }
    ],
    "steps": [
      { "cast": "Gravegouger" },
      { "resolve": true, "targets": [ "Grizzly Bears", "Hill Giant" ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": [ "Gravegouger" ] },
        { "exile": [ "Grizzly Bears", "Hill Giant" ], "graveyard": [] }
      ]
    }
  },
  {
    "name": "ETB with a single graveyard card exiles only that card",
    "players": [
      { "hand": [ "Gravegouger" ], "battlefield": [ "Swamp", "Swamp", "Swamp" ] },
      { "graveyard": [ "Grizzly Bears" ] }
    ],
    "steps": [
      { "cast": "Gravegouger" },
      { "resolve": true, "targets": [ "Grizzly Bears" ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": [ "Gravegouger" ] },
        { "exile": [ "Grizzly Bears" ], "graveyard": [] }
      ]
    }
  },
  { "name": "leaves the battlefield: the exiled cards return to their owner's graveyard, not the battlefield",
    "players": [
      { "hand": [ "Gravegouger", "Lightning Bolt" ], "battlefield": [ "Swamp", "Swamp", "Swamp", "Mountain" ] },
      { "graveyard": [ "Grizzly Bears", "Hill Giant" ] }
    ],
    "steps": [
      { "cast": "Gravegouger" },
      { "resolve": true, "targets": [ "Grizzly Bears", "Hill Giant" ] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": [ "Gravegouger" ] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": [ "Gravegouger", "Lightning Bolt" ], "battlefield_lacks": [ "Gravegouger" ] },
        { "graveyard_has": [ "Grizzly Bears", "Hill Giant" ], "exile": [], "battlefield_lacks": [ "Grizzly Bears", "Hill Giant" ] }
      ]
    }
  },
  { "name": "leaves the battlefield: only the cards it exiled come back; an untargeted card stays in exile-free graveyard",
    "players": [
      { "hand": [ "Gravegouger", "Lightning Bolt" ], "battlefield": [ "Swamp", "Swamp", "Swamp", "Mountain" ] },
      { "graveyard": [ "Grizzly Bears", "Hill Giant", "Llanowar Elves" ] }
    ],
    "steps": [
      { "cast": "Gravegouger" },
      { "resolve": true, "targets": [ "Grizzly Bears" ] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": [ "Gravegouger" ] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": [ "Gravegouger" ] },
        { "graveyard_has": [ "Grizzly Bears", "Hill Giant", "Llanowar Elves" ], "exile": [] }
      ]
    }
  }
]
