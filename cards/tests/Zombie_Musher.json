[
  {
    "name": "snow landwalk: can't be blocked while defending player controls a snow land",
    "players": [
      { "battlefield": ["Zombie Musher"] },
      { "battlefield": ["Snow-Covered Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Zombie Musher", "at": "p1" } ] },
      { "block": [ { "blocker": "p1:Grizzly Bears", "attacker": "Zombie Musher" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18, "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "no snow land: Grizzly Bears can block it",
    "players": [
      { "battlefield": ["Zombie Musher"] },
      { "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Zombie Musher", "at": "p1" } ] },
      { "block": [ { "blocker": "p1:Grizzly Bears", "attacker": "Zombie Musher" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Zombie Musher"] }, { "life": 20, "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "{S}: regenerate, paid with a snow source, saves it from Murder",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Zombie Musher", "Snow-Covered Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Zombie Musher", "ability": 0 },
      { "resolve": true },
      { "cast": "Murder", "targets": ["Zombie Musher"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Zombie Musher"], "graveyard": ["Murder"] }, {} ]
    }
  },
  {
    "name": "regenerate needs {S}: a non-snow land can't pay it",
    "players": [
      { "battlefield": ["Zombie Musher", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Zombie Musher", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Zombie Musher"] }, {} ]
    }
  },
  { "name": "snow landwalk: Hill Giant's block on Musher is dropped, Musher connects for 2 while Elves chump Bears",
    "players": [ { "battlefield": ["Zombie Musher", "Grizzly Bears"] }, { "battlefield": ["Snow-Covered Island", "Hill Giant", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Zombie Musher", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Zombie Musher" }, { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18, "battlefield_has": ["Hill Giant"], "graveyard": ["Llanowar Elves"] } ] } },
  { "name": "ruling: landwalk checks the defending player's snow lands, not the attacker's",
    "players": [ { "battlefield": ["Zombie Musher", "Snow-Covered Island"] }, { "battlefield": ["Forest", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Zombie Musher", "at": "p1" } ] }, { "block": [ { "blocker": "p1:Grizzly Bears", "attacker": "Zombie Musher" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Zombie Musher"] }, { "life": 20, "graveyard": ["Grizzly Bears"] } ] } }
]
