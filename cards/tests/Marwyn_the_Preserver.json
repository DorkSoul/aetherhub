[
  {
    "name": "lands you control have hexproof",
    "players": [
      {
        "battlefield": [
          "Marwyn, the Preserver",
          "Forest"
        ]
      },
      {
        "hand": [
          "Stone Rain"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Stone Rain",
        "player": 1,
        "targets": [
          "Forest"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "returns a land card from your graveyard to hand for 2",
    "players": [
      {
        "battlefield": [
          "Marwyn, the Preserver",
          "Forest",
          "Forest"
        ],
        "graveyard": [
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Marwyn, the Preserver",
        "targets": [
          "Mountain"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "battlefield_has": [
            "Marwyn, the Preserver"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "only land cards can be returned",
    "players": [
      {
        "battlefield": [
          "Marwyn, the Preserver",
          "Forest",
          "Forest"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Marwyn, the Preserver",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {}
      ]
    }
  },
 {
  "name": "lands you control have hexproof: an opponent's land-destroying spell has no legal target",
  "players": [
   { "battlefield": ["Marwyn, the Preserver", "Plains"] },
   { "hand": ["Sinkhole"], "battlefield": ["Black Lotus"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "cast": "Sinkhole", "player": 1, "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Plains", "Marwyn, the Preserver"] }, { "hand_count": 2 } ]
  }
 },
 {
  "name": "without Marwyn the opponent's Sinkhole destroys your Plains",
  "players": [
   { "battlefield": ["Plains"] },
   { "hand": ["Sinkhole"], "battlefield": ["Black Lotus"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Main1" },
   { "cast": "Sinkhole", "player": 1, "targets": ["Plains"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Plains"] }, {} ]
  }
 }
]
