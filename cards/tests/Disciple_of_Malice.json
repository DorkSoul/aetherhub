[
  {
    "name": "cycling {2}: discard to draw a card",
    "players": [ { "hand": ["Disciple of Malice"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [
      { "activate": "Disciple of Malice" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Disciple of Malice"], "hand_count": 1 }, {} ] }
  },
  {
    "name": "cycling needs two mana",
    "players": [ { "hand": ["Disciple of Malice"], "battlefield": ["Swamp"] }, {} ],
    "steps": [ { "activate": "Disciple of Malice", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Disciple of Malice"] }, {} ] }
  },
  {
    "name": "a white creature cannot block it (protection from white): unblocked damage",
    "players": [
      { "battlefield": ["Savannah Lions", "Grizzly Bears"] },
      { "battlefield": [{ "name": "Disciple of Malice", "sick": false }] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "attack": [ { "card": "Disciple of Malice", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Savannah Lions", "attacker": "Disciple of Malice" } ], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 19 }, {} ] }
  },
  {
    "name": "ruling: Stifle can counter cycling (cycling is an activated ability): no draw",
    "players": [
      { "hand": ["Disciple of Malice"], "battlefield": ["Swamp", "Swamp"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Disciple of Malice" },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Disciple of Malice" } ] },
      { "pass": true },
      { "pass": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Disciple of Malice"], "hand_count": 0 }, { "graveyard_has": ["Stifle"] } ] }
  }
]
