[
 {
  "name": "ETB gains 3 life and draws a card",
  "players": [
   { "hand": ["Bookwurm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Bookwurm" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 23, "battlefield_has": ["Bookwurm"], "hand_count": 1 }, {} ]
  }
 },
 {
  "name": "from the graveyard for {2}{G}: put third from the top of the library",
  "players": [
   { "graveyard": ["Bookwurm"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island", "Island"] },
   {}
  ],
  "steps": [
   { "activate": "Bookwurm", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "library_count": 23, "graveyard": [] }, {} ]
  }
 },
 {
  "name": "the ability works only from the graveyard",
  "players": [
   { "battlefield": ["Bookwurm", "Forest", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "activate": "Bookwurm", "ability": 0, "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Bookwurm"] }, {} ]
  }
 },
 {
  "name": "ruling: removed from the graveyard in response, it is not put into the library",
  "players": [
   { "graveyard": ["Bookwurm"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island", "Island"] },
   { "battlefield": ["Tormod's Crypt"] }
  ],
  "steps": [
   { "activate": "Bookwurm", "ability": 0 },
   { "pass": true },
   { "activate": "Tormod's Crypt", "player": 1, "targets": ["p0"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "library_count": 22, "graveyard": [], "exile": ["Bookwurm"] }, { "graveyard": ["Tormod's Crypt"] } ]
  }
 }
]
