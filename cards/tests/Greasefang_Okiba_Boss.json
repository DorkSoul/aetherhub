[
  {
    "name": "returns a Vehicle at combat, bounces it at end step",
    "players": [
      {
        "battlefield": [
          "Greasefang, Okiba Boss"
        ],
        "graveyard": [
          "Cultivator's Caravan"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Greasefang, Okiba Boss",
            "Cultivator's Caravan"
          ],
          "graveyard": []
        },
        {}
      ],
      "keywords": {
        "Cultivator's Caravan": [
          "Haste"
        ]
      }
    }
  },
  {
    "name": "vehicle returns to hand at the beginning of the end step",
    "players": [
      {
        "battlefield": [
          "Greasefang, Okiba Boss"
        ],
        "graveyard": [
          "Cultivator's Caravan"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Greasefang, Okiba Boss"
          ],
          "hand": [
            "Cultivator's Caravan"
          ],
          "graveyard": []
        },
        {}
      ]
    }
  },
  {
    "name": "nonvehicle cards in the graveyard are ignored",
    "players": [
      {
        "battlefield": [
          "Greasefang, Okiba Boss"
        ],
        "graveyard": [
          "Sol Ring",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Greasefang, Okiba Boss"
          ],
          "graveyard": [
            "Sol Ring",
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: an uncrewed Vehicle returned with haste still cannot attack",
    "players": [
      { "battlefield": ["Greasefang, Okiba Boss"], "graveyard": ["Smuggler's Copter"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true },
      { "attack": [ { "card": "Smuggler's Copter", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Smuggler's Copter"] }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: once crewed, the Vehicle returned with haste attacks the turn it returns",
    "players": [
      { "battlefield": ["Greasefang, Okiba Boss"], "graveyard": ["Smuggler's Copter"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true },
      { "activate": "Smuggler's Copter" },
      { "resolve": true },
      { "attack": [ { "card": "Smuggler's Copter", "at": "p1" } ] },
      { "resolve": true, "answers": [false] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Smuggler's Copter"] }, { "life": 17 } ]
    }
  }
]