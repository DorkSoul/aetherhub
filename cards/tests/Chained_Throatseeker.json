[
  {
    "name": "can't attack an unpoisoned player",
    "players": [ { "battlefield": ["Chained Throatseeker"] }, {} ],
    "steps": [ { "attack": [ { "card": "Chained Throatseeker", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "can attack a poisoned player",
    "players": [ { "battlefield": ["Chained Throatseeker"] }, { "poison": 1 } ],
    "steps": [ { "attack": [ { "card": "Chained Throatseeker", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "poison": 6 } ] }
  },
  {
    "name": "unpoisoned defender: the Throatseeker's attack is dropped (no infect), the Giant still hits",
    "players": [ { "battlefield": ["Chained Throatseeker", "Hill Giant"] }, {} ],
    "steps": [ { "attack": [ { "card": "Chained Throatseeker", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17, "poison": 0 } ] }
  },
  {
    "name": "ruling: a single poison counter makes the player poisoned, so the attack is legal",
    "players": [ { "battlefield": ["Chained Throatseeker"] }, { "poison": 1 } ],
    "steps": [ { "attack": [ { "card": "Chained Throatseeker", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "poison": 6 } ] }
  }
]
