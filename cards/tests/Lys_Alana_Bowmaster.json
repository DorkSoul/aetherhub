[
  {
    "name": "casting an Elf may deal 2 damage to a creature with flying",
    "players": [
      { "hand": ["Llanowar Elves"], "battlefield": ["Lys Alana Bowmaster", "Forest"] },
      { "battlefield": ["Wind Drake"] }
    ],
    "steps": [
      { "cast": "Llanowar Elves", "targets": ["p1:Wind Drake"] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Wind Drake"] }
      ]
    }
  },
  {
    "name": "declining the optional damage leaves the flyer alive",
    "players": [
      { "hand": ["Llanowar Elves"], "battlefield": ["Lys Alana Bowmaster", "Forest"] },
      { "battlefield": ["Wind Drake"] }
    ],
    "steps": [
      { "cast": "Llanowar Elves", "targets": ["p1:Wind Drake"] },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": ["Wind Drake"] }
      ]
    }
  },
  {
    "name": "a non-Elf spell does not trigger it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Lys Alana Bowmaster", "Forest", "Forest"] },
      { "battlefield": ["Wind Drake"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": ["Wind Drake"] }
      ]
    }
  },
  {
    "name": "ruling: the Elf trigger still resolves when the Elf spell is countered",
    "players": [
      { "hand": ["Llanowar Elves"], "battlefield": ["Lys Alana Bowmaster", "Forest"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Wind Drake"] }
    ],
    "steps": [
      { "cast": "Llanowar Elves", "targets": ["p1:Wind Drake"] },
      { "pass": true },
      { "player": 1, "cast": "Counterspell" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Llanowar Elves"] },
        { "graveyard_has": ["Wind Drake"] }
      ]
    }
  }
]
