[
  {
    "name": "blocking a creature: 1 damage to the attacker first, so a 1-toughness attacker dies",
    "players": [
      { "battlefield": ["Llanowar Elves"] },
      { "battlefield": ["Ornery Goblin"] }
    ],
    "steps": [
      { "attack": [{ "card": "Llanowar Elves", "at": "p1" }] },
      { "block": [{ "blocker": "Ornery Goblin", "attacker": "Llanowar Elves" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Llanowar Elves"] },
        { "battlefield_has": ["Ornery Goblin"] }
      ]
    }
  },
  {
    "name": "becoming blocked: 1 damage to the blocker",
    "players": [
      { "battlefield": ["Ornery Goblin"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [{ "card": "Ornery Goblin", "at": "p1" }] },
      { "block": [{ "blocker": "Llanowar Elves", "attacker": "Ornery Goblin" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Ornery Goblin"] },
        { "graveyard_has": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: blocker killed by the trigger before damage: Goblin stays blocked, no damage to the player",
    "players": [
      { "battlefield": ["Ornery Goblin"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [{ "card": "Ornery Goblin", "at": "p1" }] },
      { "block": [{ "blocker": "Llanowar Elves", "attacker": "Ornery Goblin" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Ornery Goblin"] },
        { "graveyard_has": ["Llanowar Elves"], "life": 20 }
      ]
    }
  }
]
