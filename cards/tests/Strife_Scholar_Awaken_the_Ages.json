[
  { "name": "enters prepared; the spell copy is cast from exile and makes two 2/2 Spirits",
    "players": [ { "hand": ["Strife Scholar // Awaken the Ages"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Strife Scholar // Awaken the Ages" }, { "resolve": true },
               { "cast": "Awaken the Ages" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": [], "battlefield_has": ["Spirit 2-2 Red White"] }, {} ],
                "pt": { "Spirit 2-2 Red White": [2, 2] } } },
  { "name": "the back face cannot be cast from hand",
    "players": [ { "hand": ["Strife Scholar // Awaken the Ages"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Awaken the Ages", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": [] }, {} ] } },
  { "name": "an unprepared creature gives no copy of the spell",
    "players": [ { "battlefield": ["Strife Scholar // Awaken the Ages", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Awaken the Ages", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Strife Scholar // Awaken the Ages"] }, {} ] } },
  { "name": "ward (pay 2 life): the opponent pays 2 life and the Bolt resolves",
    "players": [ { "battlefield": ["Strife Scholar // Awaken the Ages"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Strife Scholar // Awaken the Ages"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "graveyard": ["Strife Scholar // Awaken the Ages"] }, { "life": 18, "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ward (pay 2 life): an opponent at 1 life cannot pay, so the Bolt is countered",
    "players": [ { "battlefield": ["Strife Scholar // Awaken the Ages"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "set_life": 1, "player": 1 }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Strife Scholar // Awaken the Ages"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Strife Scholar // Awaken the Ages"] }, { "life": 1, "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: the copy of the prepare spell is in exile while the creature is prepared",
    "players": [ { "hand": ["Strife Scholar // Awaken the Ages"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Strife Scholar // Awaken the Ages" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Strife Scholar // Awaken the Ages"], "exile": ["Awaken the Ages"] }, {} ] } },
  { "name": "ruling: the exiled copy ceases to exist when the prepared creature leaves the battlefield",
    "players": [ { "hand": ["Strife Scholar // Awaken the Ages", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Strife Scholar // Awaken the Ages" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Strife Scholar // Awaken the Ages"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Strife Scholar // Awaken the Ages", "Lightning Bolt"], "exile": [] }, {} ] } }
]
