[
  {
    "name": "target creature gains trample and you draw a card",
    "players": [
      { "hand": ["Charge Through"], "battlefield": ["Forest", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Charge Through", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1, "battlefield_has": ["Grizzly Bears"] }, {}],
      "keywords": { "Grizzly Bears": ["Trample"] }
    }
  },
  {
    "name": "no creature to target: the spell cannot be cast",
    "players": [
      { "hand": ["Charge Through"], "battlefield": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Charge Through", "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Charge Through"] }, {}]
    }
  },
  {
    "name": "ruling: if the target becomes illegal before it resolves, no card is drawn",
    "players": [
      { "hand": ["Charge Through"], "battlefield": ["Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Charge Through", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Charge Through", "Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  }
]
