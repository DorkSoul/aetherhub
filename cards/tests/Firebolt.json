[
 {
  "name": "2 damage to a creature",
  "players": [
   {
    "hand": [
     "Firebolt"
    ],
    "battlefield": [
     "Mountain"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Firebolt",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Firebolt"
     ]
    },
    {
     "graveyard": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "flashback from the graveyard exiles it",
  "players": [
   {
    "graveyard": [
     "Firebolt"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Firebolt",
    "alt": 0,
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [],
     "exile": [
      "Firebolt"
     ]
    },
    {
     "life": 18
    }
   ]
  }
 },
 {
  "name": "cannot be flashed back without {4}{R}",
  "players": [
   {
    "graveyard": [
     "Firebolt"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Firebolt",
    "alt": 0,
    "targets": [
     "p1"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Firebolt"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: flashback is sorcery speed, so it cannot be cast while the opponent's instant is on the stack",
  "players": [ { "graveyard": ["Firebolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
  "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "cast": "Shock", "player": 1, "targets": ["p0"] }, { "pass": true, "player": 1 }, { "cast": "Firebolt", "alt": 0, "targets": ["p1"], "illegal": true }, { "resolve": true } ],
  "expect": { "players": [ { "life": 18, "graveyard_has": ["Firebolt"] }, { "graveyard_has": ["Shock"] } ] }
 },
 {
  "name": "ruling: a flashback card put into the graveyard this turn can be flashed back right away",
  "players": [ { "hand": ["Firebolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
  "steps": [ { "cast": "Firebolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Firebolt", "alt": 0, "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": [], "exile": ["Firebolt"] }, { "life": 16 } ] }
 },
 {
  "name": "ruling: a flashback spell that is countered is still exiled",
  "players": [ { "graveyard": ["Firebolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
  "steps": [ { "cast": "Firebolt", "alt": 0, "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Firebolt" }] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": [], "exile": ["Firebolt"] }, { "life": 20, "graveyard_has": ["Counterspell"] } ] }
 }
]
