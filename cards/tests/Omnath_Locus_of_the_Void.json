[
  { "name": "landfall adds {C}{C} and Omnath grows by the unspent mana",
    "players": [ { "hand": ["Forest"], "battlefield": ["Omnath, Locus of the Void"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "resolve": true } ],
    "expect": { "pt": { "Omnath, Locus of the Void": [8, 8] }, "players": [ { "pool": { "C": 2 } }, {} ] } },
  { "name": "unspent colored mana becomes colorless instead of being lost when the step ends",
    "players": [ { "battlefield": ["Omnath, Locus of the Void", "Forest"] }, {} ],
    "steps": [ { "tap_for_mana": "Forest" }, { "advance_to": "Main2" } ],
    "expect": { "pt": { "Omnath, Locus of the Void": [7, 7] }, "players": [ { "pool": { "C": 1 } }, {} ] } },
  { "name": "the mana stays through the turn change and still counts",
    "players": [ { "battlefield": ["Omnath, Locus of the Void", "Forest", "Island"] }, {} ],
    "steps": [ { "tap_for_mana": "Forest" }, { "tap_for_mana": "Island" }, { "advance_to": "Upkeep" } ],
    "expect": { "pt": { "Omnath, Locus of the Void": [8, 8] }, "players": [ { "pool": { "C": 2 } }, {} ] } },
  { "name": "colorless pool mana can pay for a spell",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Omnath, Locus of the Void", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "tap_for_mana": "Mountain" }, { "advance_to": "Main2" }, { "cast": "Hill Giant" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, {} ] } }
]
