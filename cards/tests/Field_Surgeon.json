[
  {
    "name": "taps itself to prevent 1 damage to a creature",
    "players": [
      { "battlefield": [{ "name": "Field Surgeon", "sick": false }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Field Surgeon", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Field Surgeon": true }
    }
  },
  {
    "name": "no untapped creature to tap: cannot activate",
    "players": [
      { "battlefield": [{ "name": "Field Surgeon", "sick": false, "tapped": true }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Field Surgeon", "targets": ["Hill Giant"], "illegal": true }
    ],
    "expect": {}
  }
]
