[
  {
    "name": "sacrifice: deals damage equal to its power (3) to a 3/3, which dies",
    "players": [
      { "battlefield": ["Mountain", "Flame Elemental"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Flame Elemental", "targets": ["p1:Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Flame Elemental"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "damage 3 does not kill a 4/4",
    "players": [
      { "battlefield": ["Mountain", "Flame Elemental"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "activate": "Flame Elemental", "targets": ["p1:Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Flame Elemental"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "needs R to activate",
    "players": [
      { "battlefield": ["Plains", "Flame Elemental"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Flame Elemental", "targets": ["p1:Hill Giant"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Flame Elemental"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
