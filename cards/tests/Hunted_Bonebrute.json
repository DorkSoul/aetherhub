[
  {
    "name": "hard-cast: opponent creates two Dogs",
    "players": [
      { "hand": ["Hunted Bonebrute"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Hunted Bonebrute" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hunted Bonebrute"] },
        { "battlefield_has": ["Dog", "Dog"] }
      ],
      "pt": { "Hunted Bonebrute": [6, 2] }
    }
  },
  {
    "name": "dies: each opponent loses 3 life",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hunted Bonebrute"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hunted Bonebrute"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Hunted Bonebrute"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "face-down disguise 2/2 dying does not drain (no abilities face down)",
    "players": [
      { "hand": ["Hunted Bonebrute", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Hunted Bonebrute", "alt": 254 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hunted Bonebrute"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Hunted Bonebrute"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "turn face up for disguise cost {1}{B}: 6/2, no enters trigger, no Dogs",
    "players": [
      { "hand": ["Hunted Bonebrute"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Hunted Bonebrute", "alt": 254 },
      { "resolve": true },
      { "activate": "Hunted Bonebrute", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hunted Bonebrute"] },
        { "battlefield_has": [] }
      ],
      "pt": { "Hunted Bonebrute": [6, 2] }
    }
  },
  {
    "name": "ruling: face-down disguise creature has ward {2}; opponent's Bolt is countered when it cannot be paid",
    "players": [
      { "hand": ["Hunted Bonebrute"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Hunted Bonebrute", "alt": 254 },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Hunted Bonebrute"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hunted Bonebrute"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: turning a tapped face-down permanent face up does not change whether it is tapped",
    "players": [
      { "battlefield": [{ "name": "Hunted Bonebrute", "face_down": true, "tapped": true }, "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Hunted Bonebrute", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hunted Bonebrute"] },
        {}
      ],
      "pt": { "Hunted Bonebrute": [6, 2] },
      "tapped": { "Hunted Bonebrute": true }
    }
  }
]
