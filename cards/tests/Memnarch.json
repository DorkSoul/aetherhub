[
 {"name": "ability 1 makes a nonartifact permanent an artifact, so ability 2 can take it",
  "players": [{"battlefield": ["Memnarch", "Island", "Island", "Island", "Island", "Island", "Island", "Island"]}, {"battlefield": ["Hill Giant"]}],
  "steps": [
    {"activate": "Memnarch", "ability": 0, "targets": ["Hill Giant"]},
    {"resolve": true},
    {"activate": "Memnarch", "ability": 1, "targets": ["Hill Giant"]},
    {"resolve": true}
  ],
  "expect": {"players": [{"battlefield_has": ["Hill Giant"]}, {"battlefield_lacks": ["Hill Giant"]}]}},
 {"name": "the steal ability costs four mana: three Islands are not enough",
  "players": [{"battlefield": ["Memnarch", "Island", "Island", "Island"]}, {"battlefield": ["Hill Giant"]}],
  "steps": [
    {"activate": "Memnarch", "ability": 1, "targets": ["Hill Giant"], "illegal": true}
  ],
  "expect": {"players": [{}, {"battlefield_has": ["Hill Giant"]}]}},
 {"name": "ruling: the stolen permanent stays under your control past end of turn (the effects do not end at cleanup)",
  "players": [{"battlefield": ["Memnarch", "Island", "Island", "Island", "Island", "Island", "Island", "Island"]}, {"battlefield": ["Hill Giant"]}],
  "steps": [
    {"activate": "Memnarch", "ability": 0, "targets": ["Hill Giant"]},
    {"resolve": true},
    {"activate": "Memnarch", "ability": 1, "targets": ["Hill Giant"]},
    {"resolve": true},
    {"advance_to": "Main2"},
    {"advance_to": "Main1"}
  ],
  "expect": {"players": [{"battlefield_has": ["Hill Giant"]}, {"battlefield_lacks": ["Hill Giant"]}]}}
]
