[
 { "name": "sacrifice prevents the next damage from the chosen source to enchanted creature",
   "players": [ { "hand": ["Kithkin Armor", "Lightning Bolt"], "battlefield": ["Plains", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Kithkin Armor", "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "activate": "Kithkin Armor" },
              { "resolve": true, "answers": ["Lightning Bolt"] },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Kithkin Armor", "Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "without the sacrifice the damage kills the enchanted creature",
   "players": [ { "hand": ["Kithkin Armor", "Lightning Bolt"], "battlefield": ["Plains", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Kithkin Armor", "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Kithkin Armor", "Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "damage from a source that was not chosen is not prevented",
   "players": [ { "hand": ["Kithkin Armor", "Lightning Bolt"], "battlefield": ["Plains", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Kithkin Armor", "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "activate": "Kithkin Armor" },
              { "resolve": true, "answers": ["Plains"] },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Kithkin Armor", "Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "enchanted creature can't be blocked by power 3 or greater: Hill Giant cannot block, Bears deal 2",
   "players": [ { "hand": ["Kithkin Armor"], "battlefield": ["Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Llanowar Elves"] } ],
   "steps": [ { "cast": "Kithkin Armor", "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" }, { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"], "graveyard": ["Llanowar Elves"] } ] } },
 { "name": "a power 1 creature can still block the enchanted creature",
   "players": [ { "hand": ["Kithkin Armor"], "battlefield": ["Plains", "Grizzly Bears"] }, { "battlefield": ["Kill-Suit Cultist"] } ],
   "steps": [ { "cast": "Kithkin Armor", "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "block": [ { "blocker": "Kill-Suit Cultist", "attacker": "Grizzly Bears" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 20, "graveyard": ["Kill-Suit Cultist"] } ] } }
]
