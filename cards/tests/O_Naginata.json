[
  {
    "name": "equip to a creature with power 3 or greater gives +3/+0 and trample",
    "players": [
      { "battlefield": ["O-Naginata", "Hill Giant", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "O-Naginata", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Hill Giant": [6, 3] },
      "attached": { "O-Naginata": "Hill Giant" },
      "keywords": { "Hill Giant": ["Trample"] }
    }
  },
  {
    "name": "equip cannot attach to a creature with power below 3",
    "players": [
      { "battlefield": ["O-Naginata", "Grizzly Bears", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "O-Naginata", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "attached": {}
    }
  },
  {
    "name": "equipped creature whose power drops below 3 loses the Naginata (Hill Giant with two Weaknesses)",
    "players": [
      {
        "hand": ["Weakness", "Weakness"],
        "battlefield": ["O-Naginata", "Hill Giant", "Mountain", "Mountain", "Swamp", "Swamp"]
      },
