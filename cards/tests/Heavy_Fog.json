  },
  { "name": "ruling: Heavy Fog prevents only damage to you; the blocker takes damage from the attacker normally",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "hand": ["Heavy Fog"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Heavy Fog", "player": 1 },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"] },
        { "life": 20, "graveyard_has": ["Heavy Fog", "Grizzly Bears"] }
