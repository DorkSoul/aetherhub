      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  },
  { "name": "cannot be cast outside the declare attackers step",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "hand": ["Heavy Fog"], "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "cast": "Heavy Fog", "player": 1, "illegal": true }
