[
  { "name": "backup on another creature: counter, and its dies ability until end of turn moves counters when it dies",
    "players": [ { "hand": ["Enduring Bondwarden", "Lightning Bolt"], "battlefield": ["Plains", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Enduring Bondwarden" }, { "resolve": true, "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Enduring Bondwarden"] }, {} ],
      "counters": { "Enduring Bondwarden": { "p1p1": 1 } },
      "pt": { "Enduring Bondwarden": [1, 2] } } },
  { "name": "backup on itself: just a counter and no granted dies ability",
    "players": [ { "hand": ["Enduring Bondwarden", "Lightning Bolt"], "battlefield": ["Plains", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Enduring Bondwarden" }, { "resolve": true, "targets": ["Enduring Bondwarden"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Enduring Bondwarden"] }, {} ],
      "counters": { "Enduring Bondwarden": { "p1p1": 1 } },
      "pt": { "Enduring Bondwarden": [1, 2] } } },
  { "name": "own dies trigger moves its counters to a creature you control",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Enduring Bondwarden", "counters": { "p1p1": 1 } }, "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Enduring Bondwarden"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard_has": ["Enduring Bondwarden"] }, {} ],
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "ruling: its dies ability moves all of its +1/+1 counters, not just one",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Enduring Bondwarden", "counters": { "p1p1": 2 } }, "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Enduring Bondwarden"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Enduring Bondwarden"] }, {} ],
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "pt": { "Grizzly Bears": [4, 4] } } },
  { "name": "ruling: counters are put onto the target, which keeps the counters it already had",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Enduring Bondwarden", "counters": { "p1p1": 1 } }, { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Enduring Bondwarden"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Enduring Bondwarden"] }, {} ],
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "pt": { "Grizzly Bears": [4, 4] } } },
  { "name": "ruling: a dying creature's -1/-1 counters (what remains after annihilation) are put onto the target",
    "players": [ { "hand": ["Puncture Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Enduring Bondwarden", "counters": { "p1p1": 2 } }, "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Puncture Blast", "targets": ["Enduring Bondwarden"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Enduring Bondwarden"] }, {} ],
      "counters": { "Grizzly Bears": { "m1m1": 1 } },
      "pt": { "Grizzly Bears": [1, 1] } } }
]
