[
  {
    "name": "each player's upkeep: that player sacrifices a non-Elf creature of their choice",
    "players": [
      { "battlefield": ["Ruthless Winnower", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Ruthless Winnower"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "an Elf is never the sacrificed creature",
    "players": [
      { "battlefield": ["Ruthless Winnower"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Ruthless Winnower"] },
        {}
      ]
    }
  }
]
