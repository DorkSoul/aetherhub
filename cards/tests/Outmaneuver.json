[
  {
    "name": "X=1 makes the blocked attacker assign its damage to the player",
    "players": [
      { "hand": ["Outmaneuver"], "battlefield": ["Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Grizzly Bears" } ] },
      { "cast": "Outmaneuver", "answers": [1] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears", "Outmaneuver"] },
        { "life": 18, "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "X=0 targets nothing: an unblocked attacker just hits the player as normal",
    "players": [
      { "hand": ["Outmaneuver"], "battlefield": ["Mountain", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "cast": "Outmaneuver", "answers": [0] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Outmaneuver"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: a blocked attacker still deals its damage to the player after its blocker is removed",
    "players": [
      { "hand": ["Outmaneuver", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Outmaneuver", "answers": [1] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Outmaneuver"], "battlefield_has": ["Hill Giant"] },
        { "life": 17, "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a blocked attacker assigns its damage to the planeswalker it attacked",
    "players": [
      { "hand": ["Outmaneuver"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Serra Angel", "Nahiri, the Unforgiving"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "Nahiri, the Unforgiving" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Grizzly Bears" } ] },
      { "cast": "Outmaneuver", "answers": [1] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears", "Outmaneuver"] },
        { "life": 20, "battlefield_has": ["Serra Angel", "Nahiri, the Unforgiving"] }
      ],
      "counters": { "Nahiri, the Unforgiving": { "loyalty": 3 } }
    }
  }
]
