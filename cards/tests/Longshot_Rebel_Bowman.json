[
  {
    "name": "casting a noncreature spell deals 2 to each opponent",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Longshot, Rebel Bowman"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 18, "battlefield_lacks": ["Grizzly Bears"] } ] }
  },
  {
    "name": "casting a creature spell does not trigger it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "a noncreature spell costs {1} less: Divination (3 mana) is castable with two Islands and Longshot",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Longshot, Rebel Bowman"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Divination"] }, { "life": 18 } ] }
  },
  {
    "name": "ruling: Sphere of Resistance's {1} is added and Longshot's {1} subtracted: Divination costs 3, so two Islands are not enough",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Longshot, Rebel Bowman"] }, { "battlefield": ["Sphere of Resistance"] } ],
    "steps": [ { "cast": "Divination", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Divination"] }, {} ] }
  }
]
