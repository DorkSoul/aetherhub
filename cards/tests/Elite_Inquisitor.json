      "pt": { "Elite Inquisitor": [2, 2] }
    }
  },
  {
    "name": "first strike kills a blocking 2/2 before it deals damage",
    "players": [ { "battlefield": ["Elite Inquisitor"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Elite Inquisitor", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Elite Inquisitor" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Elite Inquisitor"], "life": 20 }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "protection from Vampires: a Vampire attacker's 4 damage to the blocking Inquisitor is prevented (Inquisitor survives)",
    "players": [ { "battlefield": ["Elite Inquisitor"] }, { "battlefield": [ {"name": "Elenda, Saint of Dusk", "sick": false} ] } ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "attack": [ { "card": "Elenda, Saint of Dusk", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Elite Inquisitor", "attacker": "Elenda, Saint of Dusk" } ], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Elite Inquisitor"], "life": 20 }, { "battlefield_has": ["Elenda, Saint of Dusk"], "life": 20 } ]
    }
  },
  {
    "name": "a Zombie cannot block it: the illegal blocker is dropped and the Inquisitor's 2 damage gets through",
    "players": [ { "battlefield": ["Elite Inquisitor"] }, { "battlefield": [ {"name": "Gravebane Zombie", "sick": false}, "Grizzly Bears" ] } ],
    "steps": [
      { "attack": [ { "card": "Elite Inquisitor", "at": "p1" } ] },
      { "block": [ { "blocker": "Gravebane Zombie", "attacker": "Elite Inquisitor" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Elite Inquisitor"], "life": 20 }, { "battlefield_has": ["Gravebane Zombie", "Grizzly Bears"], "life": 18 } ]
