  {
    "name": "upkeep: exile the top two cards, playable this turn",
    "players": [
      {
        "battlefield": [
          "Wild Wasteland",
          "Island"
        ],
        "library": [
          "Wind Dancer",
          "Forest",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main1"
      },
      {
        "play_land": "Forest"
      },
      {
        "cast": "Wind Dancer"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Wild Wasteland",
            "Forest",
            "Wind Dancer"
          ],
          "exile": []
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: an exiled land can be played only in the main phase, not in upkeep",
    "players": [
      {
        "battlefield": ["Wild Wasteland", "Island"],
        "library": ["Forest", "Wind Dancer", "Plains"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "play_land": "Forest", "illegal": true },
      { "advance_to": "Main1" },
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Wild Wasteland", "Forest"] }, {} ]
    }
  }
