[
 { "name": "destroys a targeted artifact and draws",
   "players": [ { "hand": ["Topple the Statue"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island"] }, { "battlefield": ["Sol Ring"] } ],
   "steps": [ { "cast": "Topple the Statue", "targets": ["Sol Ring"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Topple the Statue"] }, { "graveyard": ["Sol Ring"] } ] } },
 { "name": "taps a non-artifact without destroying it, and draws",
   "players": [ { "hand": ["Topple the Statue"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Topple the Statue", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } } },
 { "name": "illegal target: nothing happens, no draw",
   "players": [ { "hand": ["Topple the Statue"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Topple the Statue", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island"] }, {} ] } },
 { "name": "ruling: target removed in response, Topple does not resolve and nothing is drawn",
   "players": [ { "hand": ["Topple the Statue"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Topple the Statue", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Topple the Statue"], "hand_count": 0, "library_top": ["Island"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] } },
 { "name": "ruling: a tapped creature can still be targeted, and Topple still draws",
   "players": [ { "hand": ["Topple the Statue"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "cast": "Topple the Statue", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } } }
]
