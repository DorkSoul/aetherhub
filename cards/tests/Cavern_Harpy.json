  {
    "name": "ruling: the returned creature is chosen on resolution, not targeted (a shroud creature can be returned)",
    "players": [
      { "hand": ["Cavern Harpy"], "battlefield": ["Island", "Swamp", "Neurok Commando"] },
      {}
    ],
    "steps": [
      { "cast": "Cavern Harpy" },
