[
  {
    "name": "lone devotion gives itself +1/+0",
    "players": [
      {
        "hand": [
          "Nylea's Huntmaster"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Nylea's Huntmaster"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Nylea's Huntmaster": [
          5,
          3
        ]
      }
    }
  },
  {
    "name": "ruling: X is fixed on resolution; a later green permanent does not change the pump (stays 5/3)",
    "players": [
      { "hand": ["Nylea's Huntmaster", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Nylea's Huntmaster" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Nylea's Huntmaster": [5, 3] },
      "players": [ { "battlefield_has": ["Nylea's Huntmaster", "Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: an Aura I control on an opponent's creature counts its green symbol toward my devotion (Rancor + Huntmaster = +2)",
    "players": [
      { "hand": ["Rancor", "Nylea's Huntmaster"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Rancor", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Nylea's Huntmaster" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Nylea's Huntmaster": [6, 3] }
    }
  },
  {
    "name": "ruling: generic-only mana costs add no devotion: Dagger of the Worthy ({2}) on the battlefield, Huntmaster pumps only +1",
    "players": [
      { "hand": ["Nylea's Huntmaster"], "battlefield": ["Dagger of the Worthy", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Nylea's Huntmaster" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Nylea's Huntmaster": [5, 3] }
    }
  }
]
