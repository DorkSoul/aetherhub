[
  { "name": "unconspired: destroys target artifact, no copy",
    "players": [ { "hand": ["Gleeful Sabotage"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Sol Ring", "Ornithopter"] } ],
    "steps": [ { "cast": "Gleeful Sabotage", "targets": ["Sol Ring"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Gleeful Sabotage"] }, { "graveyard": ["Sol Ring"], "battlefield_has": ["Ornithopter"] } ] } },
  { "name": "conspired: copy destroys a new target artifact chosen by the copy",
    "players": [ { "hand": ["Gleeful Sabotage"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Llanowar Elves"] }, { "battlefield": ["Sol Ring", "Ornithopter"] } ],
    "steps": [ { "cast": "Gleeful Sabotage", "targets": ["Sol Ring"], "answers": [true] }, { "pass": true }, { "resolve": true, "answers": [["Ornithopter"]] } ],
    "expect": { "players": [ { "graveyard": ["Gleeful Sabotage"] }, { "graveyard": ["Sol Ring", "Ornithopter"] } ] } },
  { "name": "conspire declined: a single copy is not made",
    "players": [ { "hand": ["Gleeful Sabotage"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Llanowar Elves"] }, { "battlefield": ["Sol Ring", "Ornithopter"] } ],
    "steps": [ { "cast": "Gleeful Sabotage", "targets": ["Sol Ring"], "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Gleeful Sabotage"] }, { "graveyard": ["Sol Ring"], "battlefield_has": ["Ornithopter"] } ] } }
]
