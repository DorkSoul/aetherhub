  "steps": [ { "cast": "Viridian Corrupter" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Viridian Corrupter"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
 },
 {
