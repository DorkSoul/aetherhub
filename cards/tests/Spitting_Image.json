  {
    "name": "ruling: a retrace card countered on the stack goes back to the graveyard",
    "players": [
      {
        "hand": ["Mountain"],
        "graveyard": ["Spitting Image"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]
      },
      {
        "hand": ["Counterspell"],
        "battlefield": ["Island", "Island", "Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Spitting Image", "alt": 0, "targets": ["p1:Hill Giant"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Spitting Image" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "graveyard_has": ["Spitting Image", "Mountain"]
        },
        {
          "battlefield_has": ["Hill Giant"],
          "graveyard_has": ["Counterspell"]
        }
      ]
    }
  },
  {
    "name": "ruling: after a retrace card resolves, its controller can cast it again straight away from the graveyard",
    "players": [
      {
        "hand": ["Mountain", "Mountain"],
        "graveyard": ["Spitting Image"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Spitting Image", "alt": 0, "targets": ["p1:Hill Giant"], "answers": ["Mountain"] },
      { "resolve": true },
      { "cast": "Spitting Image", "alt": 0, "targets": ["p1:Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "graveyard_has": ["Spitting Image", "Mountain", "Mountain"]
        },
        {
          "battlefield_has": ["Hill Giant"]
        }
      ]
    }
  }
]
