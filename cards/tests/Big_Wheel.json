[
  {
    "name": "ETB: discard a card to draw a card",
    "players": [{ "hand": ["Big Wheel", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {}],
    "steps": [{ "cast": "Big Wheel" }, { "resolve": true, "answers": [true] }, { "resolve": true }],
    "expect": {
      "players": [{ "graveyard": ["Grizzly Bears"], "hand_count": 1, "library_count": 19 }, {}]
    }
  },
  {
    "name": "declining the discard draws nothing",
    "players": [{ "hand": ["Big Wheel", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {}],
    "steps": [{ "cast": "Big Wheel" }, { "resolve": true, "answers": [false] }, { "resolve": true }],
    "expect": {
      "players": [{ "hand": ["Grizzly Bears"], "library_count": 20 }, {}]
    }
  },
  {
    "name": "crew 2 with a 2-power creature makes it a creature",
    "players": [{ "battlefield": ["Big Wheel", "Grizzly Bears"] }, {}],
    "steps": [
      { "activate": "Big Wheel", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "pt": { "Big Wheel": [4, 4] }
    }
  },
  {
    "name": "crew 2 needs total power 2",
    "players": [{ "battlefield": ["Big Wheel", "Elvish Mystic"] }, {}],
    "steps": [
      { "activate": "Big Wheel", "ability": 0, "illegal": true }
    ],
    "expect": {
      "tapped": { "Elvish Mystic": false }
    }
  }
]
