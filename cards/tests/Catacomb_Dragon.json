[
  { "name": "a blocking nonartifact non-Dragon creature gets -X/-0 where X is half its power rounded down",
    "players": [ { "battlefield": ["Catacomb Dragon"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "attack": [ { "card": "Catacomb Dragon", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Catacomb Dragon" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Serra Angel": [2, 4], "Catacomb Dragon": [4, 4] } } },
  { "name": "a Dragon blocking it is not affected",
    "players": [ { "battlefield": ["Catacomb Dragon"] }, { "battlefield": ["Shivan Dragon"] } ],
    "steps": [
      { "attack": [ { "card": "Catacomb Dragon", "at": "p1" } ] },
      { "block": [ { "blocker": "Shivan Dragon", "attacker": "Catacomb Dragon" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Shivan Dragon": [5, 5] } } },
  { "name": "the reduced power is what deals combat damage: the blocker dies to the Dragon but deals only 2",
    "players": [ { "battlefield": ["Catacomb Dragon"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "attack": [ { "card": "Catacomb Dragon", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Catacomb Dragon" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Catacomb Dragon"] }, { "graveyard_has": ["Serra Angel"] } ] } }
]
