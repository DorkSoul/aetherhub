               {"hand": ["Rancor"], "battlefield": ["Forest"]}],
   "steps": [{"advance_to": "Main1"}, {"cast": "Rancor", "player": 1, "targets": ["Grizzly Bears"]}, {"resolve": true},
             {"advance_to": "Main1"},
             {"attack": [{"card": "Grizzly Bears", "at": "p1"}, {"card": "Savannah Lions", "at": "p1"}]},
             {"resolve": true, "targets": ["Savannah Lions"]},
             {"block": []}, {"advance_to": "Main2"}],
   "expect": {"players": [{"exile": ["Forest"]}, {"life": 13}]}},
  {"name": "ruling: a creature with a counter of any kind is modified",
