             {"resolve": true, "targets": ["Savannah Lions"]},
             {"block": []}, {"advance_to": "Main2"}],
   "expect": {"players": [{"exile": ["Forest", "Lightning Bolt"]}, {"life": 13}]}},
  {"name": "ruling: an Aura controlled by the opponent does not make the creature modified",
