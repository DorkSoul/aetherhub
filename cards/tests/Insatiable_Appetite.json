[
  {
    "name": "sacrificing a Food gives +5/+5",
    "players": [
      { "hand": ["Insatiable Appetite"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Food"] },
      {}
    ],
    "steps": [
      { "cast": "Insatiable Appetite", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Food"] }, {}],
      "pt": { "Grizzly Bears": [7, 7] }
    }
  },
  {
    "name": "declining the sacrifice gives +3/+3 and keeps the Food",
    "players": [
      { "hand": ["Insatiable Appetite"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Food"] },
      {}
    ],
    "steps": [
      { "cast": "Insatiable Appetite", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears", "Food"] }, {}],
      "pt": { "Grizzly Bears": [5, 5] }
    }
  },
  {
    "name": "without a Food it gives +3/+3",
    "players": [
      { "hand": ["Insatiable Appetite"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Insatiable Appetite", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [5, 5] }
    }
  },
  {
    "name": "ruling: if the target is gone on resolution the spell does not resolve and no Food is sacrificed",
    "players": [
      { "hand": ["Insatiable Appetite"], "battlefield": ["Forest", "Forest", "Grizzly Bears", "Food"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Insatiable Appetite", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Shock", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Insatiable Appetite", "Grizzly Bears"], "battlefield_has": ["Food"] },
        { "graveyard": ["Shock"] }
      ]
    }
  }
]
