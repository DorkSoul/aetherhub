[
 { "name": "a single-target spell with only one legal target keeps it",
   "players": [ { "hand": ["Terror"], "battlefield": ["Grip of Chaos", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Terror", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Terror"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "a spell with two targets is not reselected",
   "players": [ { "hand": ["Arc Trail"], "battlefield": ["Grip of Chaos", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
   "steps": [ { "cast": "Arc Trail", "targets": ["Grizzly Bears", "p1"] }, { "resolve": true } ],
   "expect": { "players": [ { }, { "life": 19, "graveyard": ["Grizzly Bears"], "battlefield": ["Hill Giant"] } ] } },
 { "name": "a spell without targets is not affected",
   "players": [ { "hand": ["Divination"], "battlefield": ["Grip of Chaos", "Island", "Island", "Island"], "library": ["Forest", "Swamp"] }, { } ],
   "steps": [ { "cast": "Divination" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Forest", "Swamp"] } ] } },
 { "name": "the target of a Lightning Bolt is reselected at random among all legal targets",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Grip of Chaos", "Mountain"] }, { } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 17 }, { "life": 20 } ] } },
 { "name": "an activated ability with a single target is reselected too",
   "players": [ { "battlefield": ["Grip of Chaos", { "name": "Prodigal Sorcerer", "sick": false }] }, { } ],
   "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard": ["Prodigal Sorcerer"] }, { "life": 20 } ] } },
 { "name": "after another spell was cast the same Lightning Bolt is reselected to the other player",
   "players": [ { "hand": ["Divination", "Grizzly Bears", "Lightning Bolt"], "battlefield": ["Grip of Chaos", "Mountain", "Island", "Island", "Island"], "library": ["Forest", "Swamp"] }, { } ],
   "steps": [ { "cast": "Divination" }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 17 } ] } },
 { "name": "ruling: with no other legal target, a single-target spell keeps its target (Terror on Grizzly Bears)",
   "players": [ { "hand": ["Terror"], "battlefield": ["Grip of Chaos", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Terror", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Terror"] }, { "graveyard": ["Grizzly Bears"] } ] } }
]
