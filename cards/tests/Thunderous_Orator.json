[
  {
    "name": "gains flying when you control a creature with flying",
    "players": [
      {
        "battlefield": [
          "Thunderous Orator",
          "Serra Angel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Thunderous Orator",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "keywords": {
        "Thunderous Orator": [
          "Flying"
        ]
      }
    }
  },
  {
    "name": "gains lifelink from a creature you control with lifelink",
    "players": [
      {
        "battlefield": [
          "Thunderous Orator",
          "Aardvark Sloth"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Thunderous Orator",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "keywords": {
        "Thunderous Orator": [
          "Lifelink"
        ]
      }
    }
  },
  {
    "name": "ruling: with only a lifelink creature to copy, the Orator gains lifelink and not flying (Grizzly Bears can block it)",
    "players": [
      { "battlefield": ["Thunderous Orator", "Aardvark Sloth"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Thunderous Orator", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Thunderous Orator" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 22, "graveyard": ["Thunderous Orator"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: flying granted when the trigger resolves stays after the flyer dies later",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Thunderous Orator", "Pegasus Courser", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Thunderous Orator", "at": "p1" } ] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Pegasus Courser"] },
      { "pass": true },
      { "pass": true }
    ],
    "expect": {
      "keywords": { "Thunderous Orator": ["Flying"] },
      "players": [ { "graveyard": ["Lightning Bolt", "Pegasus Courser"] }, {} ]
    }
  },
  {
    "name": "ruling: the flyer is checked as the trigger resolves; killed in response, the Orator gains no flying",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Thunderous Orator", "Pegasus Courser", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Thunderous Orator", "at": "p1" } ] },
      { "cast": "Lightning Bolt", "targets": ["Pegasus Courser"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Thunderous Orator" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt", "Pegasus Courser", "Thunderous Orator"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
