[
  {
    "name": "end step: no spell cast from hand, so draw then discard",
    "players": [
      { "hand": [], "battlefield": ["Island", "Island", "Canyon Crab"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "end step: a spell cast from hand this turn, so no loot",
    "players": [
      { "hand": ["Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Canyon Crab"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "graveyard_has": ["Lightning Bolt"] }, {} ]
    }
  },
  {
    "name": "{1}{U}: gets +2/-2 until end of turn",
    "players": [
      { "hand": [], "battlefield": ["Island", "Island", "Canyon Crab"] },
      {}
    ],
    "steps": [
      { "activate": "Canyon Crab", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Canyon Crab": [2, 3] }
    }
  },
  {
    "name": "ruling: a spell cast from hand in response to the end step trigger makes it do nothing on resolution",
    "players": [
      { "hand": ["Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Canyon Crab"] },
      {}
    ],
    "steps": [
      { "advance_to": "End", "hold": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "library_count": 20, "graveyard_has": ["Lightning Bolt"] }, {} ]
    }
  }
]
