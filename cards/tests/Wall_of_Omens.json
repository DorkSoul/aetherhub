[
  {
    "name": "ETB: draw a card when it enters",
    "players": [
      { "hand": ["Wall of Omens"], "battlefield": ["Plains", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Wall of Omens" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "library_count": 19, "battlefield_has": ["Wall of Omens"] },
        {}
      ]
    }
  },
  {
    "name": "not entering the battlefield (already in play) does not draw",
    "players": [
      { "battlefield": ["Wall of Omens", "Plains", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 20, "battlefield_has": ["Wall of Omens"] },
        {}
      ]
    }
  }
]
