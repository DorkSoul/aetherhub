[
  { "name": "combat damage to the player makes them sacrifice a creature",
    "players": [ { "battlefield": [{ "name": "Demon of Loathing", "sick": false }] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Demon of Loathing", "at": "p1" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 13, "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "no creature to sacrifice: damage still dealt, nothing happens",
    "players": [ { "battlefield": [{ "name": "Demon of Loathing", "sick": false }] }, {} ],
    "steps": [ { "attack": [ { "card": "Demon of Loathing", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 13 } ] } },
  { "name": "ruling: a creature dealt lethal damage in the same combat damage step can't be sacrificed (Giant Spider blocks, the other creature is sacrificed)",
    "players": [ { "battlefield": [{ "name": "Demon of Loathing", "sick": false }] }, { "battlefield": ["Giant Spider", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Demon of Loathing", "at": "p1" } ] }, { "block": [ { "blocker": "Giant Spider", "attacker": "Demon of Loathing" } ], "player": 1 }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17, "battlefield_lacks": ["Giant Spider", "Llanowar Elves"], "graveyard_has": ["Giant Spider", "Llanowar Elves"] } ] } }
]
