[
  { "name": "attack taps the defending creature and adds counters for the power difference",
    "players": [
      { "battlefield": ["Conformer Shuriken", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Conformer Shuriken", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Hill Giant": true }, "counters": { "Grizzly Bears": { "p1p1": 1 } } } },
  { "name": "no counters when the defending creature does not have greater power",
    "players": [
      { "battlefield": ["Conformer Shuriken", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": [{ "name": "Llanowar Elves" }] }
    ],
    "steps": [
      { "activate": "Conformer Shuriken", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Llanowar Elves": true }, "counters": { "Grizzly Bears": {} } } }
]
