[
  {
    "name": "each land taps for black mana as well as its own",
    "players": [
      { "battlefield": ["Blanket of Night", "Island"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Island", "color": "B" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Blanket of Night", "Island"] }, {} ]
    }
  },
  {
    "name": "costs 1BB to cast",
    "players": [
      { "hand": ["Blanket of Night"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Blanket of Night", "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "every land is a Swamp, including the opponent's",
    "players": [
      { "battlefield": ["Blanket of Night", "Island"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": {
      "subtypes": { "Island": ["Swamp"], "Forest": ["Swamp"] }
    }
  },
  {
    "name": "ruling: an Island taps for black via Blanket of Night to pay for 1UB",
    "players": [
      { "hand": ["Phenomenon Investigators"], "battlefield": ["Blanket of Night", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Phenomenon Investigators" },
      { "resolve": true, "answers": [1] }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Phenomenon Investigators"] }, {} ]
    }
  },
  {
    "name": "ruling: without Blanket of Night the Islands make no black mana for 1UB",
    "players": [
      { "hand": ["Phenomenon Investigators"], "battlefield": ["Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Phenomenon Investigators", "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "ruling: the land keeps its name Island and is not renamed Swamp",
    "players": [
      { "battlefield": ["Blanket of Night", "Island"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Island"] }, { "battlefield_has": ["Forest"] } ]
    }
  }
]
