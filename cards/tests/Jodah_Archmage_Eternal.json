   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jodah, Archmage Eternal"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ] },
 { "name": "ruling: the alternative cost sets X to 0, so Fireball deals no damage",
   "players": [ { "hand": ["Fireball"], "battlefield": ["Jodah, Archmage Eternal", "Plains", "Island", "Swamp", "Mountain", "Forest"] }, {} ],
   "steps": [ { "cast": "Fireball", "alt": 100, "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Fireball"] }, { "life": 20 } ] } },
 { "name": "ruling: the Jodah cost can be combined with kicker (additional cost)",
   "players": [ { "hand": ["Agonizing Demise"], "battlefield": ["Jodah, Archmage Eternal", "Plains", "Island", "Swamp", "Mountain", "Forest", "Mountain", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Agonizing Demise", "alt": 100, "targets": ["Hill Giant"], "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Agonizing Demise"] }, { "life": 17, "graveyard_has": ["Hill Giant"] } ] } }
