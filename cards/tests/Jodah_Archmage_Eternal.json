[
 { "name": "pay {W}{U}{B}{R}{G} rather than the mana cost",
   "players": [ { "hand": ["Hill Giant"], "battlefield": ["Jodah, Archmage Eternal", "Plains", "Island", "Swamp", "Mountain", "Forest"] }, {} ],
   "steps": [ { "cast": "Hill Giant", "alt": 100 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, {} ] } },
