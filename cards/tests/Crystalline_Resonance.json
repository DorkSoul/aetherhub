[
  {
    "name": "cycling a card: it becomes a copy of the target permanent",
    "players": [
      {
        "hand": ["Forgotten Cave"],
        "battlefield": ["Crystalline Resonance", "Mountain", "Llanowar Elves"]
      },
      {}
    ],
    "steps": [
      { "activate": "Forgotten Cave", "targets": ["Llanowar Elves"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Forgotten Cave"], "battlefield_has": ["Llanowar Elves"], "battlefield_lacks": ["Crystalline Resonance"] },
        {}
      ],
      "pt": { "Llanowar Elves": [1, 1] }
    }
  },
  {
    "name": "cycling a card: declining the may leaves it an enchantment",
    "players": [
      {
        "hand": ["Forgotten Cave"],
        "battlefield": ["Crystalline Resonance", "Mountain", "Llanowar Elves"]
      },
      {}
    ],
    "steps": [
      { "activate": "Forgotten Cave", "targets": ["Llanowar Elves"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Forgotten Cave"], "battlefield_has": ["Crystalline Resonance", "Llanowar Elves"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: copying an Aura that is not attached puts Crystalline Resonance into the graveyard",
    "players": [
      { "hand": ["Forgotten Cave", "Ordeal of Thassa"], "battlefield": ["Crystalline Resonance", "Island", "Island", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Ordeal of Thassa", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Forgotten Cave", "targets": ["Ordeal of Thassa"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Forgotten Cave", "Crystalline Resonance"], "battlefield_has": ["Ordeal of Thassa"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: with two cycling triggers, the one that resolves last decides what Resonance copies",
    "players": [
      { "hand": ["Forgotten Cave", "Forgotten Cave"], "battlefield": ["Crystalline Resonance", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Forgotten Cave", "targets": ["Hill Giant"] },
      { "activate": "Forgotten Cave", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true, true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the copy wears off before your next turn, so Resonance is an enchantment again",
    "players": [
      { "hand": ["Forgotten Cave"], "battlefield": ["Crystalline Resonance", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Forgotten Cave", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Crystalline Resonance"], "battlefield_lacks": ["Hill Giant"] },
        {}
      ]
    }
  }
]
