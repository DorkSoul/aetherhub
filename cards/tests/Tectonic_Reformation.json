[
 {
  "name": "a land card in hand can be cycled for {R}",
  "players": [ { "hand": ["Forest"], "battlefield": ["Tectonic Reformation", "Mountain"], "library": ["Plains"] }, {} ],
  "steps": [ { "activate": "Forest", "ability": 32768 }, { "resolve": true } ],
  "expect": { "players": [ { "hand": ["Plains"], "graveyard": ["Forest"] }, {} ] }
 },
 {
  "name": "without the enchantment a land cannot be cycled",
  "players": [ { "hand": ["Forest"], "battlefield": ["Mountain"] }, {} ],
  "steps": [ { "activate": "Forest", "ability": 32768, "illegal": true } ],
  "expect": { "players": [ { "hand": ["Forest"] }, {} ] }
 },
 {
  "name": "a nonland card cannot be cycled for {R}",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Tectonic Reformation", "Mountain"] }, {} ],
  "steps": [ { "activate": "Grizzly Bears", "ability": 32768, "illegal": true } ],
  "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] }
 },
 {
  "name": "the enchantment itself cycles for {2}",
  "players": [ { "hand": ["Tectonic Reformation"], "battlefield": ["Mountain", "Mountain"], "library": ["Plains"] }, {} ],
  "steps": [ { "activate": "Tectonic Reformation", "ability": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "hand": ["Plains"], "graveyard": ["Tectonic Reformation"] }, {} ] }
 }
]
