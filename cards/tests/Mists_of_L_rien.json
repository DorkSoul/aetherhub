[
  { "name": "bounces the target and each other nonland permanent with the same mana value",
    "players": [
      { "hand": ["Mists of Lórien"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Mind Stone", "Llanowar Elves", "Sol Ring"] }
    ],
    "steps": [
      { "cast": "Mists of Lórien", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "graveyard": ["Mists of Lórien"] },
      { "battlefield_has": ["Llanowar Elves", "Sol Ring"], "battlefield_lacks": ["Grizzly Bears", "Mind Stone"], "hand_count": 2 }
    ] } },
  { "name": "replicate paid once: the copy bounces its new target and the MV-1 permanents with it",
    "players": [
      { "hand": ["Mists of Lórien"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Mind Stone", "Llanowar Elves", "Sol Ring"] }
    ],
    "steps": [
      { "cast": "Mists of Lórien", "targets": ["Grizzly Bears"], "answers": [1] },
      { "pass": true, "player": 1 },
      { "resolve": true, "answers": [["Llanowar Elves"]] }
    ],
    "expect": { "players": [
      { "graveyard": ["Mists of Lórien"] },
      { "battlefield_lacks": ["Grizzly Bears", "Mind Stone", "Llanowar Elves", "Sol Ring"] }
    ] } },
  { "name": "no replicate: the target is bounced, Llanowar Elves (other MV) stays",
    "players": [
      { "hand": ["Mists of Lórien"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Mind Stone", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Mists of Lórien", "targets": ["Mind Stone"], "answers": [0] },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "graveyard": ["Mists of Lórien"] },
      { "battlefield_has": ["Llanowar Elves"], "battlefield_lacks": ["Mind Stone"] }
    ] } },
  { "name": "ruling: X counts as 0 in mana value, so Walking Ballista matches Memnite and is bounced with it",
    "players": [
      { "hand": ["Mists of Lórien"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [{"name": "Walking Ballista", "counters": {"+1/+1": 2}}, "Memnite", "Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Mists of Lórien", "targets": ["Memnite"] }, { "resolve": true } ],
    "expect": { "players": [
      { "graveyard": ["Mists of Lórien"] },
      { "battlefield_has": ["Llanowar Elves"], "battlefield_lacks": ["Walking Ballista", "Memnite"] }
    ] } },
  { "name": "ruling: the target is gone when Mists resolves, so nothing is returned (Mind Stone with the same MV stays)",
    "players": [
      { "hand": ["Mists of Lórien"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Shock"], "battlefield": ["Mountain", "Grizzly Bears", "Mind Stone"] }
    ],
    "steps": [ { "cast": "Mists of Lórien", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [
      { "graveyard": ["Mists of Lórien"] },
      { "battlefield_has": ["Mind Stone"], "battlefield_lacks": ["Grizzly Bears"], "hand_count": 0 }
    ] } }
]
