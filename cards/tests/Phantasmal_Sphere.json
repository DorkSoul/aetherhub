[
  {
    "name": "upkeep: paying {1} for the one counter keeps it",
    "players": [ { "battlefield": ["Phantasmal Sphere", "Island"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Phantasmal Sphere"] }, {} ] }
  },
  {
    "name": "upkeep: unpaid, it is sacrificed and the opponent gets a 1/1 Orb",
    "players": [ { "battlefield": ["Phantasmal Sphere"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Phantasmal Sphere"] }, { "battlefield_has": ["Orb 0-0 Blue Flying"] } ] }
  }
]
