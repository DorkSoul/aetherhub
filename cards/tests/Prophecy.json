[
 { "name": "revealed land: gain 1 life, then the opponent shuffles; draw at the next upkeep",
   "players": [ { "hand": ["Prophecy"], "battlefield": ["Plains"] }, { "library": ["Forest", "Grizzly Bears"] } ],
   "steps": [
     { "cast": "Prophecy", "targets": ["p1"] },
     { "resolve": true },
     { "advance_to": "Upkeep" },
     { "resolve": true }
   ],
   "expect": { "players": [ { "life": 21, "hand_count": 1, "graveyard": ["Prophecy"] }, {} ] } },
 { "name": "revealed nonland: no life gained, the card goes back into the library",
   "players": [ { "hand": ["Prophecy"], "battlefield": ["Plains"] }, { "library": ["Grizzly Bears", "Forest"] } ],
   "steps": [
     { "cast": "Prophecy", "targets": ["p1"] },
     { "resolve": true }
   ],
   "expect": { "players": [ { "life": 20, "graveyard": ["Prophecy"] }, { "life": 20, "exile": [] } ] } },
 { "name": "ruling: a nonland revealed card is still shuffled away and the draw still happens at the next upkeep",
   "players": [ { "hand": ["Prophecy"], "battlefield": ["Plains"] }, { "library": ["Grizzly Bears", "Forest"] } ],
   "steps": [ { "cast": "Prophecy", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "hand_count": 1, "graveyard": ["Prophecy"] }, {} ] } }
]
