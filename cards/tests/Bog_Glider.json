[
  {
    "name": "sacrifice a land: search for a Mercenary with mana value 2 or less onto the battlefield",
    "players": [
      { "battlefield": ["Bog Glider", "Forest"], "library": ["Agent of Shauku"] },
      {}
    ],
    "steps": [
      { "activate": "Bog Glider", "ability": 0 },
      { "resolve": true, "answers": ["Agent of Shauku"] }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Agent of Shauku"], "graveyard_has": ["Forest"] }, {} ],
      "tapped": { "Bog Glider": true }
    }
  },
  {
    "name": "the search may find nothing (no Mercenary in the library)",
    "players": [
      { "battlefield": ["Bog Glider", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Bog Glider", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Forest"] }, {} ] }
  },
  {
    "name": "ruling: the search may be declined even when a Mercenary is in the library",
    "players": [
      { "battlefield": ["Bog Glider", "Forest"], "library": ["Agent of Shauku"] },
      {}
    ],
    "steps": [
      { "activate": "Bog Glider", "ability": 0 },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Forest"], "battlefield_lacks": ["Agent of Shauku"] }, {} ],
      "tapped": { "Bog Glider": true }
    }
  }
]
