        ],
        "battlefield": [
          "Forest",
          "Crocanura"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Llanowar Elves"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Crocanura": [
          1,
          3
        ]
      }
    }
  },
  {
    "name": "ruling: evolve compares power alone: a 3/2 entering creature evolves a 1/3",
    "players": [
      { "hand": ["Goblin Heelcutter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Crocanura"] },
      {}
    ],
    "steps": [
      { "cast": "Goblin Heelcutter" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Crocanura": [2, 4] } }
  },
  {
    "name": "ruling: evolve compares toughness alone: a 0/4 entering creature evolves a 1/3",
    "players": [
      { "hand": ["Alabaster Wall"], "battlefield": ["Plains", "Plains", "Plains", "Crocanura"] },
      {}
    ],
    "steps": [
      { "cast": "Alabaster Wall" },
      { "resolve": true },
      { "resolve": true }
