[
 { "name": "sacrifices itself to destroy the blocking creature",
   "players": [ { "battlefield": [ { "name": "Dauthi Jackal", "sick": false }, "Swamp", "Swamp" ] },
                { "battlefield": ["Dauthi Marauder"] } ],
   "steps": [ { "attack": [ { "card": "Dauthi Jackal", "at": "p1" } ] },
              { "block": [ { "blocker": "Dauthi Marauder", "attacker": "Dauthi Jackal" } ] },
              { "activate": "Dauthi Jackal", "targets": ["Dauthi Marauder"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Dauthi Jackal"] }, { "graveyard": ["Dauthi Marauder"] } ] } },
 { "name": "no blocking creature means no legal target",
   "players": [ { "battlefield": [ { "name": "Dauthi Jackal", "sick": false }, "Swamp", "Swamp" ] },
                { "battlefield": ["Dauthi Marauder"] } ],
   "steps": [ { "attack": [ { "card": "Dauthi Jackal", "at": "p1" } ] }, { "block": [] },
              { "activate": "Dauthi Jackal", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Dauthi Jackal"] }, {} ] } },
 { "name": "ruling: Dauthi Jackal need not be attacking or blocking to use its ability",
   "players": [ { "battlefield": [ { "name": "Dauthi Jackal", "sick": false }, { "name": "Dauthi Slayer", "sick": false }, "Swamp", "Swamp" ] },
                { "battlefield": ["Dauthi Marauder"] } ],
   "steps": [ { "attack": [ { "card": "Dauthi Slayer", "at": "p1" } ] },
              { "block": [ { "blocker": "Dauthi Marauder", "attacker": "Dauthi Slayer" } ] },
              { "activate": "Dauthi Jackal", "targets": ["Dauthi Marauder"] },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Dauthi Jackal"], "battlefield_has": ["Dauthi Slayer"] }, { "graveyard": ["Dauthi Marauder"], "life": 20 } ] } },
 { "name": "ruling: a shadow-only creature cannot block a creature with shadow and flying",
   "players": [ { "battlefield": ["Stronghold Overseer"] },
                { "battlefield": ["Dauthi Marauder"] } ],
   "steps": [ { "attack": [ { "card": "Stronghold Overseer", "at": "p1" } ] },
              { "block": [ { "blocker": "Dauthi Marauder", "attacker": "Stronghold Overseer" } ], "illegal": true },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Stronghold Overseer"] }, { "life": 15, "battlefield_has": ["Dauthi Marauder"] } ] } },
 { "name": "ruling: a flying-only creature cannot block a creature with shadow and flying",
   "players": [ { "battlefield": ["Stronghold Overseer"] },
                { "battlefield": ["Ornithopter"] } ],
   "steps": [ { "attack": [ { "card": "Stronghold Overseer", "at": "p1" } ] },
              { "block": [ { "blocker": "Ornithopter", "attacker": "Stronghold Overseer" } ], "illegal": true },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Stronghold Overseer"] }, { "life": 15, "battlefield_has": ["Ornithopter"] } ] } },
 { "name": "ruling: a creature with both shadow and flying can be blocked by a creature with both",
   "players": [ { "battlefield": ["Stronghold Overseer"] },
                { "battlefield": ["Stronghold Overseer"] } ],
   "steps": [ { "attack": [ { "card": "p0:Stronghold Overseer", "at": "p1" } ] },
              { "block": [ { "blocker": "p1:Stronghold Overseer", "attacker": "p0:Stronghold Overseer" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard": ["Stronghold Overseer"] }, { "life": 20, "graveyard": ["Stronghold Overseer"] } ] } }
]
