[
  {"name": "damage to a creature: its controller exiles that many cards from the top of their library",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Expedited Inheritance"]},
               {"battlefield": ["Serra Angel"], "library": ["Forest", "Island", "Plains", "Swamp"]}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["Serra Angel"]}, {"resolve": true, "answers": [true]}],
   "expect": {"players": [{"graveyard": ["Lightning Bolt"], "exile": []}, {"exile": ["Forest", "Island", "Plains"]}]}},
  {"name": "declining the exile exiles nothing",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Expedited Inheritance"]},
               {"battlefield": ["Serra Angel"], "library": ["Forest", "Island", "Plains", "Swamp"]}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["Serra Angel"]}, {"resolve": true, "answers": [false]}],
   "expect": {"players": [{}, {"exile": []}]}},
  {"name": "own creature: you exile from your own library",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Expedited Inheritance", "Serra Angel"], "library": ["Forest", "Island", "Plains"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["Serra Angel"]}, {"resolve": true, "answers": [true]}],
   "expect": {"players": [{"exile": ["Forest", "Island", "Plains"]}, {}]}},
  {"name": "damage to a player does not trigger it",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Expedited Inheritance"]},
               {"library": ["Forest", "Island", "Plains"]}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{}, {"life": 17, "exile": []}]}},
  {"name": "ruling: an exiled land can be played in your main phase once the stack is empty",
   "players": [{"battlefield": ["Expedited Inheritance", "Grizzly Bears"], "library": ["Forest", "Island", "Forest"]},
               {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}],
   "steps": [{"pass": true}, {"cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"]}, {"resolve": true, "answers": [true]}, {"play_land": "Forest"}],
   "expect": {"players": [{"battlefield_has": ["Forest"], "exile": ["Island", "Forest"]}, {}]}},
  {"name": "ruling: an exiled land cannot be played in the end step",
   "players": [{"battlefield": ["Expedited Inheritance", "Grizzly Bears"], "library": ["Forest", "Island", "Forest"]},
               {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}],
   "steps": [{"pass": true}, {"cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"]}, {"resolve": true, "answers": [true]}, {"advance_to": "End"}, {"play_land": "Forest", "illegal": true}],
   "expect": {"players": [{"battlefield_lacks": ["Forest"], "exile": ["Forest", "Island", "Forest"]}, {}]}}
]
