[
  {
    "name": "enters: destroys your own enchantment and the opponent's artifact, gets a +1/+1 counter for each",
    "players": [
      {
        "hand": ["Bane of Progress"],
        "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains", "Propaganda"]
      },
      {
        "battlefield": ["Sol Ring"]
      }
    ],
    "steps": [
      { "cast": "Bane of Progress" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bane of Progress"], "battlefield_lacks": ["Propaganda"], "graveyard": ["Propaganda"] },
        { "battlefield_lacks": ["Sol Ring"], "graveyard": ["Sol Ring"] }
      ],
      "pt": { "Bane of Progress": [4, 4] }
    }
  },
  {
    "name": "enters with no artifacts or enchantments to destroy: stays a 2/2",
    "players": [
      {
        "hand": ["Bane of Progress"],
        "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Bane of Progress" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bane of Progress"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "pt": { "Bane of Progress": [2, 2] }
    }
  },
  {
    "name": "an indestructible artifact is not destroyed and does not add a counter",
    "players": [
      {
        "hand": ["Bane of Progress"],
        "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains"]
      },
      {
        "battlefield": ["Darksteel Plate", "Sol Ring"]
      }
    ],
    "steps": [
      { "cast": "Bane of Progress" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bane of Progress"] },
        { "battlefield_has": ["Darksteel Plate"], "battlefield_lacks": ["Sol Ring"] }
      ],
      "pt": { "Bane of Progress": [3, 3] }
    }
  },
  {
    "name": "ruling: destroys your own artifact too, and counts it",
    "players": [
      { "hand": ["Bane of Progress"], "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "cast": "Bane of Progress" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bane of Progress"], "battlefield_lacks": ["Sol Ring"], "graveyard": ["Sol Ring"] },
        {}
      ],
      "pt": { "Bane of Progress": [3, 3] }
    }
  },
  {
    "name": "ruling: a destroyed permanent that is exiled instead of going to the graveyard still counts",
    "players": [
      { "hand": ["Bane of Progress"], "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Sol Ring", "Rest in Peace"] }
    ],
    "steps": [
      { "cast": "Bane of Progress" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bane of Progress"] },
        { "battlefield_lacks": ["Sol Ring", "Rest in Peace"] }
      ],
      "pt": { "Bane of Progress": [4, 4] }
    }
  }
]
