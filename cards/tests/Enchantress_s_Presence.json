[
  {
    "name": "casting an enchantment draws a card",
    "players": [
      {
        "hand": [
          "Pacifism"
        ],
        "battlefield": [
          "Enchantress's Presence",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Pacifism"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "a creature spell does not draw",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Enchantress's Presence",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "an opponent's enchantment does not draw",
    "players": [
      {
        "battlefield": [
          "Enchantress's Presence"
        ]
      },
      {
        "hand": [
          "Pacifism"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "advance_to": "Main1",
        "player": 1
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the draw happens even if the enchantment spell is countered",
    "players": [
      {
        "hand": ["Pacifism"],
        "battlefield": ["Enchantress's Presence", "Plains", "Plains"]
      },
      {
        "hand": ["Counterspell"],
        "battlefield": ["Grizzly Bears", "Island", "Island"]
      }
    ],
    "steps": [
      { "cast": "Pacifism" },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Pacifism" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard_has": ["Pacifism"] },
        { "graveyard_has": ["Counterspell"] }
      ]
    }
  }
]