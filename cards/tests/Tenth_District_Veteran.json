[
  {
    "name": "attacking untaps another tapped creature you control",
    "players": [
      { "battlefield": ["Tenth District Veteran", { "name": "Grizzly Bears", "tapped": true }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Tenth District Veteran", "at": "p1" }] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false, "Tenth District Veteran": false }
    }
  },
  {
    "name": "vigilance: the attacking Veteran stays untapped and deals damage",
    "players": [
      { "battlefield": ["Tenth District Veteran"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Tenth District Veteran", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "tapped": { "Tenth District Veteran": false }
    }
  },
  {
    "name": "ruling: untapping an attacking creature does not remove it from combat",
    "players": [ { "battlefield": ["Tenth District Veteran", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Tenth District Veteran", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ], "tapped": { "Grizzly Bears": false } }
  }
]
