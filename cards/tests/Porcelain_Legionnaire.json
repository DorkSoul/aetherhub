[
 { "name": "paying the white symbol with a Plains makes a 3/1 first striker",
   "players": [ { "hand": ["Porcelain Legionnaire"], "battlefield": ["Plains", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Porcelain Legionnaire" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Porcelain Legionnaire"], "life": 20 }, {} ],
               "pt": { "Porcelain Legionnaire": [3, 1] },
               "keywords": { "Porcelain Legionnaire": ["FirstStrike"] } } },
 { "name": "the white symbol can be paid with 2 life",
   "players": [ { "hand": ["Porcelain Legionnaire"], "battlefield": ["Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Porcelain Legionnaire" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Porcelain Legionnaire"], "life": 18 }, {} ] } },
 { "name": "cannot be cast with a single land",
   "players": [ { "hand": ["Porcelain Legionnaire"], "battlefield": ["Plains"] }, {} ],
   "steps": [ { "cast": "Porcelain Legionnaire", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Porcelain Legionnaire"], "life": 20 }, {} ] } },
 { "name": "ruling: at 1 life you can't pay 2 life for the white symbol",
   "players": [ { "hand": ["Porcelain Legionnaire"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "set_life": 1 }, { "cast": "Porcelain Legionnaire", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Porcelain Legionnaire"], "life": 1 }, {} ] } },
 { "name": "ruling: at 3 life, paying 2 life for the white symbol is allowed",
   "players": [ { "hand": ["Porcelain Legionnaire"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "set_life": 3 }, { "cast": "Porcelain Legionnaire" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Porcelain Legionnaire"], "life": 1 }, {} ] } },
 { "name": "ruling: Phyrexian symbols count 1 each for mana value (Legionnaire is 3, so the MV 2 Runeclaw Bear enters instead)",
   "players": [ { "hand": ["Stronghold Gambit", "Porcelain Legionnaire"], "battlefield": ["Mountain", "Mountain"] }, { "hand": ["Runeclaw Bear"] } ],
   "steps": [ { "cast": "Stronghold Gambit" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Porcelain Legionnaire"] }, { "battlefield_has": ["Runeclaw Bear"] } ] } }
]
