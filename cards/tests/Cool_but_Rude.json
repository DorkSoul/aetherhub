[
  {
    "name": "level 1: attacking and discarding a card (you may) draws a card",
    "players": [
      { "hand": ["Forest"], "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 1 } }, { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "block": [] },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard": ["Forest"], "hand_count": 1 }, { "life": 18 } ] }
  },
  {
    "name": "level 1: declining the discard keeps the card in hand and deals no damage",
    "players": [
      { "hand": ["Forest"], "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 1 } }, { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "answers": [false] },
      { "block": [] },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "hand": ["Forest"] }, { "life": 18 } ] }
  },
  {
    "name": "level 2: discarding a card deals 2 damage to each opponent",
    "players": [
      { "hand": ["Forest"], "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 2 } }, { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard": ["Forest"] }, { "life": 16 } ] }
  },
  {
    "name": "level 1 class: discarding a card deals no damage",
    "players": [
      { "hand": ["Forest"], "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 1 } }, { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "block": [] },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard": ["Forest"] }, { "life": 18 } ] }
  },
  {
    "name": "activating level 2 ability raises the level to 2",
    "players": [
      { "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 1 } }, "Mountain", "Mountain" ] },
      {}
    ],
    "steps": [
      { "activate": "Cool but Rude", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "counters": { "Cool but Rude": { "level": 2 } } }
  },
  {
    "name": "level 3: becoming level 3 searches the library then discards a card at random",
    "players": [
      { "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 2 } }, "Mountain", "Mountain", "Mountain" ], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Cool but Rude", "ability": 1 },
      { "resolve": true, "answers": [["Forest"]] },
      { "resolve": true }
    ],
    "expect": { "counters": { "Cool but Rude": { "level": 3 } }, "players": [ { "graveyard": ["Forest"] } ] }
  },
  {
    "name": "cast for {1}{R}: the Class enters at level 1",
    "players": [
      { "hand": ["Cool but Rude"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Cool but Rude" },
      { "resolve": true }
    ],
    "expect": { "counters": { "Cool but Rude": { "level": 1 } } }
  },
  {
    "name": "ruling: a level-up ability uses the stack and can be responded to",
    "players": [ { "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 1 } }, "Mountain", "Mountain" ] }, {} ],
    "steps": [ { "activate": "Cool but Rude", "ability": 0 } ],
    "expect": { "stack_empty": false, "counters": { "Cool but Rude": { "level": 1 } } }
  },
  {
    "name": "ruling: a class already at level 3 cannot activate either level-up ability",
    "players": [ { "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 3 } }, "Mountain", "Mountain", "Mountain", "Mountain" ] }, {} ],
    "steps": [
      { "activate": "Cool but Rude", "ability": 0, "illegal": true },
      { "activate": "Cool but Rude", "ability": 1, "illegal": true }
    ],
    "expect": { "counters": { "Cool but Rude": { "level": 3 } } }
  },
  {
    "name": "ruling: gaining level 3 keeps the level 2 discard damage",
    "players": [
      { "hand": ["Forest"], "battlefield": [ { "name": "Cool but Rude", "counters": { "level": 3 } }, { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard": ["Forest"] }, { "life": 16 } ] }
  }
]
