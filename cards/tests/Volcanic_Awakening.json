[
  {
    "name": "destroys target land",
    "players": [
      { "hand": ["Volcanic Awakening"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "cast": "Volcanic Awakening", "targets": ["Island"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Island"], "battlefield": [] }]
    }
  },
  {
    "name": "illegal to cast without enough mana",
    "players": [
      { "hand": ["Volcanic Awakening"], "battlefield": ["Mountain", "Forest"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "cast": "Volcanic Awakening", "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Volcanic Awakening"] }, {}]
    }
  },
  {
    "name": "ruling: storm copy may choose a new target, so both lands are destroyed",
    "players": [
      { "hand": ["Lightning Bolt", "Volcanic Awakening"], "battlefield": ["Mountain", "Mountain", "Mountain", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Island", "Plains", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Volcanic Awakening", "targets": ["Island"] },
      { "resolve": true, "answers": ["Plains"] }
    ],
    "expect": {
      "players": [{}, { "battlefield_lacks": ["Island", "Plains", "Grizzly Bears"] }]
    }
  }
]
