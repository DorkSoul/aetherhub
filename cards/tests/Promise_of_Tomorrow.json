[
 {
  "name": "creature dies, is exiled, and returns at the end step when you control no creatures",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Promise of Tomorrow", "Grizzly Bears", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Promise of Tomorrow"], "exile": [] },
    {}
   ]
  }
 },
 {
  "name": "still controlling a creature at the end step: exiled cards stay exiled",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Promise of Tomorrow", "Grizzly Bears", "Savannah Lions", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Promise of Tomorrow", "Grizzly Bears"], "battlefield_lacks": ["Savannah Lions"], "exile": ["Savannah Lions"] },
    {}
   ]
  }
 },
 {
  "name": "an opponent's creature dying is not exiled by Promise of Tomorrow",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Promise of Tomorrow", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": [] },
    { "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: two Promise of Tomorrow both trigger on death, but only the first one exiles the card",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Promise of Tomorrow", "Promise of Tomorrow", "Grizzly Bears", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Grizzly Bears"], "battlefield_has": ["Promise of Tomorrow"], "graveyard": ["Lightning Bolt"] },
    {}
   ]
  }
 }
]
