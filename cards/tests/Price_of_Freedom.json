[
 {
  "name": "destroys an opponent's artifact; its controller may search for a basic land",
  "players": [
   { "hand": ["Price of Freedom"], "battlefield": ["Mountain", "Mountain"] },
   { "battlefield": ["Mind Stone"], "library": ["Forest"] }
  ],
  "steps": [
   { "cast": "Price of Freedom", "targets": ["Mind Stone"] },
   { "resolve": true, "answers": [true, "Forest"] }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Price of Freedom"], "hand_count": 1 },
    { "graveyard_has": ["Mind Stone"], "battlefield_has": ["Forest"] }
   ]
  }
 },
 {
  "name": "controller may decline the search",
  "players": [
   { "hand": ["Price of Freedom"], "battlefield": ["Mountain", "Mountain"] },
   { "battlefield": ["Mind Stone"], "library": ["Forest"] }
  ],
  "steps": [
   { "cast": "Price of Freedom", "targets": ["Mind Stone"] },
   { "resolve": true, "answers": [false] }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Price of Freedom"], "hand_count": 1 },
    { "graveyard_has": ["Mind Stone"], "battlefield_lacks": ["Forest"] }
   ]
  }
 },
 {
  "name": "ruling: if the controller doesn't search, they don't shuffle (the library is left in order)",
  "players": [
   { "hand": ["Price of Freedom"], "battlefield": ["Mountain", "Mountain"] },
   { "battlefield": ["Mind Stone"], "library": ["Forest"] }
  ],
  "steps": [
   { "cast": "Price of Freedom", "targets": ["Mind Stone"] },
   { "resolve": true, "answers": [false] }
  ],
  "expect": {
   "players": [
    { "hand_count": 1 },
    { "library_top": ["Forest"], "library_count": 21 }
   ]
  }
 }
]
