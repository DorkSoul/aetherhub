[
  { "name": "equipped creature becomes blocked: 2 damage to each blocker",
    "players": [ { "battlefield": ["Forest", "Trailblazer's Torch", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Trailblazer's Torch", "ability": 0, "targets": ["Hill Giant"] }, { "resolve": true },
               { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant", "Trailblazer's Torch"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "entering takes the initiative: The Initiative and the Undercity dungeon go to the command zone",
    "players": [ { "hand": ["Trailblazer's Torch"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Trailblazer's Torch" }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Initiative", "Undercity"] }, {} ] } },
  { "name": "three mana is not enough to cast the Torch",
    "players": [ { "hand": ["Trailblazer's Torch"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Trailblazer's Torch", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Trailblazer's Torch"] }, {} ] } },
  { "name": "ruling: only one player has the initiative; taking it moves it and the old holder loses it",
    "players": [ { "hand": ["Trailblazer's Torch"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Trailblazer's Torch"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] } ],
    "steps": [ { "cast": "Trailblazer's Torch" }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" },
               { "player": 1, "cast": "Trailblazer's Torch" }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["Undercity"] }, { "command": ["The Initiative", "Undercity"] } ] } },
  { "name": "ruling: retaking the initiative keeps a single initiative designation",
    "players": [ { "hand": ["Trailblazer's Torch", "Trailblazer's Torch"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Trailblazer's Torch" }, { "resolve": true }, { "cast": "Trailblazer's Torch" }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "command": ["The Initiative", "Undercity"] }, {} ] } },
  { "name": "ruling: a venture outside a dungeon starts Undercity at Secret Entrance (basic land search)",
    "players": [ { "hand": ["Trailblazer's Torch"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Trailblazer's Torch" }, { "resolve": true, "answers": ["Mountain"] } ],
    "expect": { "players": [ { "hand": ["Mountain"], "command": ["The Initiative", "Undercity"] }, {} ] } },
  { "name": "ruling: combat damage to the player with the initiative gives the initiative to the attacker's controller",
    "players": [ { "hand": ["Trailblazer's Torch"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Trailblazer's Torch" }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" },
               { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ] },
               { "block": [], "player": 0 },
               { "advance_to": "Main2", "auto": true } ],
    "expect": { "players": [ { "command": ["Undercity"], "life": 18 }, { "command": ["The Initiative", "Undercity"] } ] } }
]
