[
  {
    "name": "taps two creatures and puts two stun counters on each",
    "players": [
      { "hand": ["Involuntary Cooldown"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Involuntary Cooldown", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Involuntary Cooldown"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
      "counters": { "Grizzly Bears": { "stun": 2 }, "Hill Giant": { "stun": 2 } },
      "tapped": { "Grizzly Bears": true, "Hill Giant": true }
    }
  },
  {
    "name": "works on an artifact too",
    "players": [
      { "hand": ["Involuntary Cooldown"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Involuntary Cooldown", "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Sol Ring": { "stun": 2 } },
      "tapped": { "Sol Ring": true }
    }
  },
  {
    "name": "up to two: zero targets is legal and does nothing",
    "players": [
      { "hand": ["Involuntary Cooldown"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Involuntary Cooldown", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Involuntary Cooldown"] }, { "battlefield": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": false }
    }
  },
  { "name": "ruling: stun counter replaces untap; one counter removed per untap step, creature stays tapped",
    "players": [ { "hand": ["Involuntary Cooldown"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Involuntary Cooldown", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ], "counters": { "Grizzly Bears": { "stun": 1 } }, "tapped": { "Grizzly Bears": true } } }
]
