[
 {
  "name": "plain cast adds RRR",
  "players": [ { "hand": ["Desperate Ritual"], "battlefield": ["Mountain", "Mountain"] }, {} ],
  "steps": [ { "cast": "Desperate Ritual" }, { "resolve": true } ],
  "expect": { "players": [ { "pool": { "R": 3 } }, {} ] }
 },
 {
  "name": "spliced onto an Arcane spell its mana is added too",
  "players": [ { "hand": ["Blind with Anger", "Desperate Ritual"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Blind with Anger", "targets": ["Grizzly Bears"], "answers": [true] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand": ["Desperate Ritual"], "pool": { "R": 3 } }, { "battlefield_lacks": ["Grizzly Bears"] } ] }
 },
 {
  "name": "declining the splice leaves the spell alone",
  "players": [ { "hand": ["Blind with Anger", "Desperate Ritual"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Blind with Anger", "targets": ["Grizzly Bears"], "answers": [false] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand": ["Desperate Ritual"] }, {} ] }
 },
 {
  "name": "ruling: if the only target is gone the whole spell fizzles, so the spliced Ritual adds no mana",
  "players": [ { "hand": ["Blind with Anger", "Desperate Ritual"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Shock"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
  "steps": [ { "cast": "Blind with Anger", "targets": ["Grizzly Bears"], "answers": [true] }, { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "hand": ["Desperate Ritual"], "graveyard": ["Blind with Anger"], "pool": { "R": 0 } }, { "graveyard": ["Shock", "Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: a lone Desperate Ritual cannot splice onto itself",
  "players": [ { "hand": ["Desperate Ritual"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
  "steps": [ { "cast": "Desperate Ritual" }, { "resolve": true } ],
  "expect": { "players": [ { "hand": [], "graveyard": ["Desperate Ritual"], "pool": { "R": 3 } }, {} ] }
 },
 {
  "name": "ruling: two Rituals spliced onto one spell each add their mana once",
  "players": [ { "hand": ["Blind with Anger", "Desperate Ritual", "Desperate Ritual"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Blind with Anger", "targets": ["Grizzly Bears"], "answers": [true, true] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand": ["Desperate Ritual", "Desperate Ritual"], "pool": { "R": 6 } }, { "battlefield_lacks": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: Desperate Ritual is a spell, not a mana ability, so it can be countered",
  "players": [ { "hand": ["Desperate Ritual"], "battlefield": ["Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
  "steps": [ { "cast": "Desperate Ritual" }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Desperate Ritual" }] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Desperate Ritual"], "pool": { "R": 0 } }, { "graveyard": ["Counterspell"] } ], "stack_empty": true }
 }
]
