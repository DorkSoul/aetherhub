[
  {
    "name": "target player discards three cards",
    "players": [
      { "hand": ["Mindstab"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Forest", "Mountain", "Island", "Plains"] }
    ],
    "steps": [
      { "cast": "Mindstab", "targets": ["p1"] },
      { "resolve": true, "answers": [["Forest", "Mountain", "Island"]] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Mindstab"] },
        { "hand": ["Plains"], "graveyard_has": ["Forest", "Mountain", "Island"] }
      ]
    }
  },
  {
    "name": "suspend 4 for B exiles it with four time counters",
    "players": [
      { "hand": ["Mindstab"], "battlefield": ["Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Mindstab" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Mindstab"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: after the last counter is removed the card may be cast without paying its mana cost",
    "players": [
      { "hand": ["Mindstab"], "battlefield": ["Swamp"] },
      { "hand": ["Forest", "Mountain", "Island", "Plains"] }
    ],
    "steps": [
      { "activate": "Mindstab" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": ["Forest", true, ["Forest", "Mountain", "Island"]], "targets": ["p1"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Mindstab"] },
        { "graveyard_has": ["Forest", "Mountain", "Island"] }
      ]
    }
  },
  {
    "name": "ruling: declining the free cast leaves the card exiled with no time counters",
    "players": [
      { "hand": ["Mindstab"], "battlefield": ["Swamp"] },
      { "hand": ["Forest", "Mountain", "Island", "Plains"] }
    ],
    "steps": [
      { "activate": "Mindstab" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": {
      "players": [
        { "exile": ["Mindstab"] },
        {}
      ]
    }
  }
]
