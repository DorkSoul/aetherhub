[
  { "name": "prevents combat damage from a creature",
    "players": [ { "battlefield": ["Hill Giant"] }, { "battlefield": ["Uncle Istvan"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Uncle Istvan", "attacker": "Hill Giant" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "battlefield_has": ["Uncle Istvan"] } ] } },
  { "name": "noncreature damage is not prevented",
    "players": [ { "battlefield": ["Uncle Istvan"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Uncle Istvan"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Uncle Istvan"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: damage from a creature's activated ability is prevented (ping plus Shock would be lethal)",
    "players": [ { "hand": ["Shock"], "battlefield": ["Prodigal Sorcerer", "Mountain"] }, { "battlefield": ["Uncle Istvan"] } ],
    "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["Uncle Istvan"] }, { "resolve": true },
               { "cast": "Shock", "targets": ["Uncle Istvan"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Shock"] }, { "battlefield_has": ["Uncle Istvan"] } ] } }
]
