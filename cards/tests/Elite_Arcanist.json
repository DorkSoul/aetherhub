[
  {
    "name": "exile Lightning Bolt; {1},{T} copy it for free",
    "players": [ { "hand": ["Elite Arcanist", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Elite Arcanist" },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "activate": "Elite Arcanist" },
      { "resolve": true, "answers": [true, "p1"] }
    ],
    "expect": { "players": [ { "exile": ["Lightning Bolt"] }, { "life": 17 } ] }
  },
  {
    "name": "ruling: copy of a card with {X} in its cost is cast with X=0 (Death Wind copy gives -0/-0)",
    "players": [
      { "hand": ["Elite Arcanist", "Death Wind"], "battlefield": ["Island", "Island", "Island", "Island", "Swamp"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "cast": "Elite Arcanist" },
      { "resolve": true, "answers": ["Death Wind"] },
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "activate": "Elite Arcanist" },
      { "resolve": true, "answers": [true, 0] }
    ],
    "expect": { "players": [ { "exile": ["Death Wind"], "battlefield_has": ["Elite Arcanist"] }, { "battlefield_has": ["Savannah Lions"] } ], "pt": { "Savannah Lions": [2, 1], "Elite Arcanist": [1, 1] } }
  },
  {
    "name": "ruling: once Elite Arcanist leaves the battlefield the exiled card can no longer be copied",
    "players": [
      { "hand": ["Elite Arcanist", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Elite Arcanist" },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Elite Arcanist"] },
      { "resolve": true },
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "activate": "Elite Arcanist", "illegal": true }
    ],
    "expect": { "players": [ { "exile": ["Lightning Bolt"], "graveyard": ["Elite Arcanist"] }, { "graveyard": ["Shock"] } ] }
  }
]
