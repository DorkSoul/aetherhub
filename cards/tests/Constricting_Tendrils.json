[
  { "name": "target creature gets -3/-0 until end of turn",
    "players": [ { "hand": ["Constricting Tendrils"], "battlefield": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Constricting Tendrils", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [-1, 2] } } },
  { "name": "cycling for {2} draws a card",
    "players": [ { "hand": ["Constricting Tendrils"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Constricting Tendrils", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Constricting Tendrils"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: Stifle counters the cycling ability; the discarded card stays in the graveyard and nothing is drawn",
    "players": [ { "hand": ["Constricting Tendrils"], "battlefield": ["Forest", "Forest"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Constricting Tendrils", "ability": 0 }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Constricting Tendrils" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Constricting Tendrils"], "hand_count": 0 }, { "graveyard_has": ["Stifle"] } ] } },
  { "name": "ruling: a spell counter (Counterspell) cannot target the cycling ability, so the draw still happens",
    "players": [ { "hand": ["Constricting Tendrils"], "battlefield": ["Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Constricting Tendrils", "ability": 0 }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Constricting Tendrils" }], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Constricting Tendrils"], "hand_count": 1 }, { "hand": ["Counterspell"] } ] } }
]
