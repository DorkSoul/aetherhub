[
  {
    "name": "3 damage to a creature kills it",
    "players": [
      { "hand": ["Fateful End"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Fateful End", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fateful End"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "3 damage to a player",
    "players": [
      { "hand": ["Fateful End"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Fateful End", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fateful End"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: the target is gone when Fateful End resolves, so it does nothing (no damage, no scry)",
    "players": [
      { "hand": ["Fateful End", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Fateful End", "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fateful End", "Lightning Bolt"], "life": 20 },
        { "graveyard": ["Grizzly Bears"], "life": 20 }
      ]
    }
  }
]
