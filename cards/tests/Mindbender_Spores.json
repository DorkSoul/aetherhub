[
  {
    "name": "blocked creature gets four fungus counters",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Mindbender Spores"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Mindbender Spores", "attacker": "Grizzly Bears" } ] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "fungus": 4 } }
    }
  },
  {
    "name": "blocked creature with fungus counters does not untap; counter removed at upkeep",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Mindbender Spores"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Mindbender Spores", "attacker": "Grizzly Bears" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "fungus": 3 } }
    }
  },
  {
    "name": "unblocked attacker untaps normally in its controller's untap step",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Mindbender Spores"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false },
      "counters": { "Grizzly Bears": { "fungus": 0 } }
    }
  }
]
