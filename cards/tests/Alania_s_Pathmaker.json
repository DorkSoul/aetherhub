[
  { "name": "ETB exiles the top card of your library",
    "players": [ { "hand": ["Alania's Pathmaker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Alania's Pathmaker" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Alania's Pathmaker"], "exile": ["Forest"] }, {} ] } },
  { "name": "the exiled card can be played this turn",
    "players": [ { "hand": ["Alania's Pathmaker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Alania's Pathmaker" }, { "resolve": true }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"], "exile": [] }, {} ] } },
  { "name": "ruling: an exiled land can't be played during the opponent's turn",
    "players": [ { "hand": ["Alania's Pathmaker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Alania's Pathmaker" }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Forest"] }, {} ] } },
  { "name": "ruling: the exiled land can't be played while a spell is on the stack",
    "players": [ { "hand": ["Alania's Pathmaker", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Alania's Pathmaker" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Forest"] }, {} ] } }
]
