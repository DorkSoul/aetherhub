    "steps": [
      { "cast": "Banisher Priest" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": [ "Banisher Priest" ] },
      { "resolve": true }
