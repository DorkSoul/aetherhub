[
  {
    "name": "you choose a card and the opponent shuffles it into their library",
    "players": [
      { "hand": ["Perish the Thought"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears", "Lightning Bolt"], "library": ["Forest"] }
    ],
    "steps": [
      { "cast": "Perish the Thought", "targets": ["p1"] },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Perish the Thought"] },
        { "hand": ["Lightning Bolt"], "library_count": 22 }
      ]
    }
  },
  {
    "name": "empty opponent hand: nothing happens",
    "players": [
      { "hand": ["Perish the Thought"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Perish the Thought", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Perish the Thought"] },
        { "hand_count": 0 }
      ]
    }
  },
  {
    "name": "ruling: empty opponent hand: no shuffle occurs",
    "players": [
      { "hand": ["Perish the Thought"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "library": ["Forest"] }
    ],
    "steps": [
      { "cast": "Perish the Thought", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Perish the Thought"] },
        { "hand_count": 0, "library_top": ["Forest"] }
      ]
    }
  }
]
