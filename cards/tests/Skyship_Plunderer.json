[
 {
  "name": "combat damage doubles up one counter kind on the target",
  "players": [
   {
    "battlefield": [
     "Skyship Plunderer",
     {
      "name": "Grizzly Bears",
      "counters": {
       "p1p1": 2
      }
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "BeginCombat"
   },
   {
    "attack": [
     {
      "card": "Skyship Plunderer",
      "at": "p1"
     }
    ]
   },
   {
    "advance_to": "Main2",
    "targets": [
     "Grizzly Bears"
    ]
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 18
    }
   ],
   "counters": {
    "Grizzly Bears": {
     "p1p1": 3
    }
   }
  }
 },
 {
  "name": "ruling: each kind of counter gets exactly one more counter, not a doubling",
  "players": [
   {
    "battlefield": [
     "Skyship Plunderer",
     {
      "name": "Grizzly Bears",
      "counters": {
       "p1p1": 2,
       "charge": 1
      }
     }
    ]
   },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Skyship Plunderer", "at": "p1" } ] },
   { "advance_to": "Main2", "targets": ["Grizzly Bears"] }
  ],
  "expect": {
   "players": [ {}, { "life": 18 } ],
   "counters": { "Grizzly Bears": { "p1p1": 3, "charge": 2 } }
  }
 },
 {
  "name": "ruling: the trigger can target a permanent that was not dealt damage (own creature)",
  "players": [
   { "battlefield": ["Skyship Plunderer", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Skyship Plunderer", "at": "p1" } ] },
   { "advance_to": "Main2", "targets": ["Grizzly Bears"] }
  ],
  "expect": {
   "players": [ {}, { "life": 18 } ],
   "counters": { "Grizzly Bears": { "p1p1": 2 } }
  }
 }
]