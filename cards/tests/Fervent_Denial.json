[
  {
    "name": "counters a spell",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Fervent Denial"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "cast": "Fervent Denial",
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "graveyard": [
            "Fervent Denial"
          ]
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "flashback for {5}{U}{U} exiles it after it resolves",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ],
        "graveyard": [
          "Fervent Denial"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "cast": "Fervent Denial",
        "alt": 0,
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "exile": [
            "Fervent Denial"
          ],
          "graveyard": []
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: a flashback cast that is countered is still exiled",
    "players": [
      {
        "hand": ["Lightning Bolt", "Fervent Denial"],
        "battlefield": ["Mountain", "Island", "Island", "Island", "Island", "Island"]
      },
      {
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"],
        "graveyard": ["Fervent Denial"]
      }
    ],
    "steps": [
      {"cast": "Lightning Bolt", "targets": ["p1"]},
      {"cast": "Fervent Denial", "alt": 0, "player": 1, "targets": [{"stack": "Lightning Bolt"}]},
      {"pass": true, "player": 1},
      {"cast": "Fervent Denial", "targets": [{"stack": "Fervent Denial"}]},
      {"pass": true},
      {"pass": true, "player": 1}
    ],
    "expect": {
      "players": [
        {"graveyard": ["Fervent Denial"]},
        {"exile": ["Fervent Denial"], "graveyard": []}
      ]
    }
  }
]