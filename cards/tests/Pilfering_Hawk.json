[
 { "name": "snow mana from a snow land: draw a card, then discard a card",
   "players": [ { "battlefield": ["Pilfering Hawk", "Snow-Covered Island"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Pilfering Hawk", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "hand": [], "graveyard": ["Forest"], "library_count": 20 } ], "tapped": { "Pilfering Hawk": true, "Snow-Covered Island": true } } },
 { "name": "{S} cannot be paid with mana from non-snow lands",
   "players": [ { "battlefield": ["Pilfering Hawk", "Island", "Island"] }, {} ],
   "steps": [ { "activate": "Pilfering Hawk", "ability": 0, "illegal": true } ],
   "expect": { "tapped": { "Pilfering Hawk": false } } },
 { "name": "the discard is the player's choice after the draw",
   "players": [ { "hand": ["Island"], "battlefield": ["Pilfering Hawk", "Snow-Covered Forest"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Pilfering Hawk", "ability": 0 }, { "resolve": true, "answers": ["Island"] } ],
   "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Island"] } ] } },
 { "name": "ruling: a cost reduction does not reduce {S}; non-snow Islands still cannot pay it",
   "players": [ { "battlefield": ["Pilfering Hawk", "Training Grounds", "Island", "Island"] }, {} ],
   "steps": [ { "activate": "Pilfering Hawk", "ability": 0, "illegal": true } ],
   "expect": { "tapped": { "Pilfering Hawk": false } } },
 { "name": "ruling: with a cost reduction in play, a snow land still pays {S}",
   "players": [ { "battlefield": ["Pilfering Hawk", "Training Grounds", "Snow-Covered Island"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Pilfering Hawk", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Forest"] } ], "tapped": { "Pilfering Hawk": true } } }
]
