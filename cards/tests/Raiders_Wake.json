[
  {
    "name": "an opponent who discards loses 2 life",
    "players": [
      {
        "hand": [
          "Rakdos's Return"
        ],
        "battlefield": [
          "Raiders' Wake",
          "Swamp",
          "Mountain",
          "Plains"
        ]
      },
      {
        "hand": [
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Rakdos's Return",
        "targets": [
          "p1"
        ],
        "answers": [
          1
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17,
          "graveyard": [
            "Island"
          ]
        }
      ]
    }
  },
  {
    "name": "raid: at your end step, target opponent discards a card",
    "players": [
      {
        "battlefield": [
          "Raiders' Wake",
          "Grizzly Bears"
        ]
      },
      {
        "hand": [
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 16,
          "graveyard": [
            "Island"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: raid counts any attack, here one at a planeswalker rather than the player",
    "players": [
      { "battlefield": ["Raiders' Wake", "Grizzly Bears"] },
      { "battlefield": ["Ajani Vengeant"], "hand": ["Island"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "Ajani Vengeant" }] },
      { "block": [] },
      { "advance_to": "End" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 18, "graveyard": ["Island"] }]
    }
  },
  {
    "name": "ruling: raid still counts when the attacker died in combat before your end step",
    "players": [
      { "battlefield": ["Raiders' Wake", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"], "hand": ["Island"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }] },
      { "advance_to": "End" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Grizzly Bears"] }, { "life": 18, "graveyard": ["Island"] }]
    }
  },
  {
    "name": "ruling: Raiders' Wake cast after combat still gets the end step raid trigger",
    "players": [
      { "hand": ["Raiders' Wake"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Island"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Raiders' Wake" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 16, "graveyard": ["Island"] }]
    }
  }
]
