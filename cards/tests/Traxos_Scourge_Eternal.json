[
  {
    "name": "does not untap during your untap step while other creatures do",
    "players": [
      {
        "battlefield": [
          {
            "name": "Traxos, Scourge Eternal",
            "tapped": true
          },
          {
            "name": "Grizzly Bears",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
