        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Traxos, Scourge Eternal": false
      }
    }
  },
  {
    "name": "casting a noncreature spell does not untap it",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          {
            "name": "Traxos, Scourge Eternal",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
