[
  {
    "name": "Croaking Curse taps the target and attaches a Cursed Role (enchanted creature is 1/1)",
    "players": [
      {
        "hand": [
          "Vantress Transmuter // Croaking Curse"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Vantress Transmuter // Croaking Curse",
        "face": true,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Vantress Transmuter // Croaking Curse"
          ],
          "battlefield_has": [
            "Cursed Role"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ],
      "attached": {
        "Cursed Role": "Grizzly Bears"
      },
      "pt": {
        "Grizzly Bears": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "the creature half is a plain 3/4 with no Role",
    "players": [
      {
        "hand": [
          "Vantress Transmuter // Croaking Curse"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Vantress Transmuter // Croaking Curse",
        "face": false
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Vantress Transmuter // Croaking Curse"
          ],
          "battlefield_lacks": [
            "Cursed Role"
          ]
        },
        {}
      ],
      "pt": {
        "Vantress Transmuter // Croaking Curse": [
          3,
          4
        ]
      }
    }
  },
 {
  "name": "ruling: an Adventure countered on the stack is not exiled, so the creature cannot be cast later",
  "players": [
   { "hand": ["Vantress Transmuter // Croaking Curse"], "battlefield": ["Island", "Island"] },
   { "battlefield": ["Grizzly Bears", "Island", "Island"], "hand": ["Counterspell"] }
  ],
  "steps": [
   { "cast": "Vantress Transmuter // Croaking Curse", "face": true, "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Croaking Curse" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Vantress Transmuter // Croaking Curse"], "exile": [] },
    { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Counterspell"] }
   ]
  }
 },
 {
  "name": "ruling: Croaking Curse on an already tapped creature still attaches a Cursed Role",
  "players": [
   { "hand": ["Vantress Transmuter // Croaking Curse"], "battlefield": ["Island", "Island"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Vantress Transmuter // Croaking Curse", "face": true, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Cursed Role"] }, { "battlefield_has": ["Grizzly Bears"] } ],
   "attached": { "Cursed Role": "Grizzly Bears" },
   "pt": { "Grizzly Bears": [1, 1] }
  }
 },
 {
  "name": "ruling: after the Adventure resolves, the creature can be cast from exile on your own main phase",
  "players": [
   { "hand": ["Vantress Transmuter // Croaking Curse"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Vantress Transmuter // Croaking Curse", "face": true, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Vantress Transmuter // Croaking Curse", "face": false },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Vantress Transmuter // Croaking Curse"], "exile": [] }, { "battlefield_has": ["Grizzly Bears"] } ],
   "pt": { "Vantress Transmuter // Croaking Curse": [3, 4] }
  }
 },
 {
  "name": "ruling: the creature cast from exile follows creature timing, so not on the opponent's turn",
  "players": [
   { "hand": ["Vantress Transmuter // Croaking Curse"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Vantress Transmuter // Croaking Curse", "face": true, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "pass": true, "player": 1 },
   { "cast": "Vantress Transmuter // Croaking Curse", "face": false, "illegal": true }
  ],
  "expect": { "players": [ { "exile": ["Vantress Transmuter // Croaking Curse"] }, {} ] }
 }
]
