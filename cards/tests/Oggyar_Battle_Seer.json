[
  { "name": "tap to scry 1 taps the creature",
    "players": [ { "battlefield": ["Oggyar Battle-Seer"] }, {} ],
    "steps": [ { "activate": "Oggyar Battle-Seer", "ability": 0 }, { "resolve": true } ],
    "expect": { "tapped": { "Oggyar Battle-Seer": true } } },
  { "name": "cannot activate again while tapped",
    "players": [ { "battlefield": ["Oggyar Battle-Seer"] }, {} ],
    "steps": [ { "activate": "Oggyar Battle-Seer", "ability": 0 }, { "resolve": true },
               { "activate": "Oggyar Battle-Seer", "ability": 0, "illegal": true } ],
    "expect": { "tapped": { "Oggyar Battle-Seer": true } } },
  { "name": "has haste",
    "players": [ { "hand": ["Oggyar Battle-Seer"], "battlefield": ["Island","Mountain","Island","Mountain","Island"] }, {} ],
    "steps": [ { "cast": "Oggyar Battle-Seer" }, { "resolve": true }, { "activate": "Oggyar Battle-Seer", "ability": 0 }, { "resolve": true } ],
    "expect": { "tapped": { "Oggyar Battle-Seer": true } } }
]
