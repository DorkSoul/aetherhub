[
  {
    "name": "destroys artifacts and enchantments; each permanent's controller gets a Centaur",
    "players": [
      { "hand": ["Rampage of the Clans"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Sol Ring"] },
      { "battlefield": ["Pestilence", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Rampage of the Clans" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Sol Ring", "Rampage of the Clans"], "battlefield_has": ["Centaur 3-3"], "battlefield_lacks": ["Sol Ring"] },
        { "graveyard_has": ["Pestilence"], "battlefield_has": ["Centaur 3-3", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "indestructible artifact is kept and gets no Centaur",
    "players": [
      { "hand": ["Rampage of the Clans"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Darksteel Myr"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Rampage of the Clans" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Darksteel Myr"], "battlefield_lacks": ["Centaur 3-3"] },
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Centaur 3-3"] }
      ]
    }
  },
  {
    "name": "creatures and lands are not destroyed and make no Centaurs",
    "players": [
      { "hand": ["Rampage of the Clans"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Rampage of the Clans" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Forest"], "battlefield_lacks": ["Centaur 3-3"] },
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Centaur 3-3"] }
      ]
    }
  },
  {
    "name": "ruling: a permanent destroyed but put into exile instead of the graveyard still gives its controller a Centaur",
    "players": [
      { "hand": ["Rampage of the Clans"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Rest in Peace"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Rampage of the Clans" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Centaur 3-3"], "battlefield_lacks": ["Rest in Peace"] },
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Centaur 3-3"] }
      ]
    }
  },
  {
    "name": "ruling: Centaurs enter after the artifacts/enchantments have left, so Impact Tremors does not trigger on them",
    "players": [
      { "hand": ["Rampage of the Clans"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Impact Tremors"] },
      {}
    ],
    "steps": [
      { "cast": "Rampage of the Clans" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Centaur 3-3"], "battlefield_lacks": ["Impact Tremors"], "life": 20 },
        { "life": 20 }
      ]
    }
  }
]
