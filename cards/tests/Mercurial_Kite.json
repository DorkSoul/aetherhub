[
  {
    "name": "combat damage to a blocking creature taps it and it skips its next untap step",
    "players": [{ "battlefield": ["Mercurial Kite"] }, { "battlefield": ["Merfolk Falconer"] }],
    "steps": [
      { "attack": [{ "card": "Mercurial Kite", "at": "p1" }] },
      { "block": [{ "blocker": "Merfolk Falconer", "attacker": "Mercurial Kite" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, {}], "tapped": { "Merfolk Falconer": true } }
  },
  {
    "name": "unblocked combat damage to a player does not tap anything",
    "players": [{ "battlefield": ["Mercurial Kite"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [{ "card": "Mercurial Kite", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 18 }], "tapped": { "Grizzly Bears": false } }
  }
]
