[
  {
    "name": "exiles only land cards from the targeted player's graveyard",
    "players": [ { "hand": ["Mudhole"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "graveyard": ["Forest", "Lightning Bolt", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Mudhole", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Mudhole"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"], "exile": ["Forest"] } ] }
  },
  {
    "name": "can target yourself to exile your own lands",
    "players": [ { "hand": ["Mudhole"], "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Forest"] }, {} ],
    "steps": [ { "cast": "Mudhole", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Mudhole"], "exile": ["Forest"] }, {} ] }
  }
]
