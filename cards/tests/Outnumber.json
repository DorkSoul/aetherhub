[
  {
    "name": "deals damage equal to creatures you control, killing the target",
    "players": [
      { "hand": ["Outnumber"], "battlefield": ["Mountain", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Outnumber", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Hill Giant"] } ]
    }
  },
  {
    "name": "opponent's creatures are not counted",
    "players": [
      { "hand": ["Outnumber"], "battlefield": ["Mountain", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Outnumber", "targets": ["p1:Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Hill Giant"] } ],
      "pt": { "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "ruling: creatures are counted as it resolves (one killed in response is not counted)",
    "players": [
      { "hand": ["Outnumber", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Outnumber", "targets": ["Hill Giant"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears", "Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] } ],
      "pt": { "Hill Giant": [3, 3] }
    }
  }
]
