[
  {
    "name": "destroys the untapped non-attacking non-Wall creatures of the attacking player",
    "players": [
      { "battlefield": ["Total War", "Grizzly Bears", "Hill Giant", "Wall of Blossoms", { "name": "Serra Angel", "tapped": true }] },
      { "battlefield": ["Serra Angel", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Total War", "Grizzly Bears", "Wall of Blossoms", "Serra Angel"], "graveyard": ["Hill Giant"] },
        { "battlefield_has": ["Serra Angel", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "a tapped creature of the attacking player survives",
    "players": [
      { "battlefield": ["Total War", "Grizzly Bears", { "name": "Hill Giant", "tapped": true }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Total War", "Grizzly Bears", "Hill Giant"] }, {} ]
    }
  },
  {
    "name": "a creature that came under control this turn survives",
    "players": [
      { "hand": ["Hill Giant"], "battlefield": ["Total War", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Total War", "Grizzly Bears", "Hill Giant"] }, {} ]
    }
  },
  {
    "name": "ruling: the destruction happens on the attack declaration trigger, before blocks and damage",
    "players": [
      { "battlefield": ["Total War", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Total War", "Grizzly Bears"], "graveyard": ["Hill Giant"] }, {} ]
    }
  }
]
