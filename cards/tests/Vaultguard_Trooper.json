[
  {
    "name": "two tapped creatures at your end step: may discard your hand and draw two",
    "players": [
      { "hand": ["Island"], "battlefield": ["Vaultguard Trooper", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "End", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Island"], "hand_count": 2 }, {} ]
    }
  },
  {
    "name": "only one tapped creature: the trigger does not happen, hand unchanged",
    "players": [
      { "hand": ["Island"], "battlefield": ["Vaultguard Trooper", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "hand": ["Island"] }, {} ]
    }
  },
  {
    "name": "ruling: a creature tapped earlier in the turn still counts at the end step",
    "players": [
      { "hand": ["Island"], "battlefield": ["Vaultguard Trooper", "Apprentice Sorcerer", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Apprentice Sorcerer", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "End", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Island"], "hand_count": 2 }, {} ]
    }
  }
]
