[
  {
    "name": "creates X Saprolings where X is the greatest power among your creatures",
    "players": [
      { "hand": ["Fungal Sprouting"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Fungal Sprouting" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fungal Sprouting"], "battlefield_has": ["Hill Giant", "Saproling", "Saproling", "Saproling"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "with no creatures of yours it creates nothing",
    "players": [
      { "hand": ["Fungal Sprouting"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Fungal Sprouting" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Saproling"], "graveyard": ["Fungal Sprouting"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: greatest power is checked on resolution (a pump in response adds Saprolings)",
    "players": [
      { "hand": ["Fungal Sprouting", "Giant Growth"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Fungal Sprouting" },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Fungal Sprouting", "Giant Growth"], "battlefield_has": ["Grizzly Bears", "Saproling", "Saproling", "Saproling", "Saproling", "Saproling"] },
        {}
      ],
      "pt": { "Grizzly Bears": [5, 5] }
    }
  }
]
