[
  {
    "name": "taps up to two target creatures and investigates",
    "players": [
      { "hand": ["Expose Evil"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Expose Evil", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Expose Evil"], "battlefield_has": ["Clue"] }, {}],
      "tapped": { "Grizzly Bears": true, "Hill Giant": true }
    }
  },
  {
    "name": "no targets: just investigate",
    "players": [
      { "hand": ["Expose Evil"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Expose Evil", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Expose Evil"], "battlefield_has": ["Clue"] }, {}],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: if all targets become illegal, Expose Evil does not resolve and no Clue is made",
    "players": [
      { "hand": ["Expose Evil"], "battlefield": ["Plains", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] }
    ],
    "steps": [
      { "cast": "Expose Evil", "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Expose Evil"], "battlefield_lacks": ["Clue"] },
        { "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  }
]
