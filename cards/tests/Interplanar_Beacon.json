[
 {
  "name": "gains 1 life when you cast a planeswalker spell",
  "players": [
   { "hand": ["Ajani Goldmane"], "battlefield": ["Interplanar Beacon", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Ajani Goldmane" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 21, "battlefield_has": ["Ajani Goldmane"] }, {} ]
  }
 },
 {
  "name": "does not gain life for a non-planeswalker spell",
  "players": [
   { "hand": ["Swords to Plowshares"], "battlefield": ["Interplanar Beacon", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Swords to Plowshares", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20 }, { "exile": ["Grizzly Bears"] } ]
  }
 },
 {
  "name": "ruling: both mana from the two-colour ability can be spent on one planeswalker spell",
  "players": [
   { "hand": ["Ajani Resolute"], "battlefield": ["Interplanar Beacon", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Ajani Resolute" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 21, "battlefield_has": ["Ajani Resolute"] }, {} ],
   "tapped": { "Interplanar Beacon": true, "Island": true }
  }
 },
 {
  "name": "ruling: the gain-life trigger resolves even if the planeswalker spell is countered",
  "players": [
   { "hand": ["Ajani Goldmane"], "battlefield": ["Interplanar Beacon", "Plains", "Plains", "Plains"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Ajani Goldmane" },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Ajani Goldmane" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 21, "graveyard": ["Ajani Goldmane"] }, { "graveyard": ["Counterspell"] } ]
  }
 }
]
