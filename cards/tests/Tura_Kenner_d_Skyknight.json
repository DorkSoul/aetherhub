[
 {
  "name": "casting an instant creates a 1/1 Soldier",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Tura Kennerüd, Skyknight",
     "Mountain"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Soldier",
      "Tura Kennerüd, Skyknight"
     ]
    },
    {
     "graveyard": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "casting a creature spell does not create a Soldier",
  "players": [
   {
    "hand": [
     "Grizzly Bears"
    ],
    "battlefield": [
     "Tura Kennerüd, Skyknight",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Grizzly Bears"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": [
      "Soldier"
     ],
     "battlefield_has": [
      "Grizzly Bears"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: the Soldier is still created when the instant is countered",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Tura Kennerüd, Skyknight", "Mountain"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Soldier", "Tura Kennerüd, Skyknight"], "graveyard": ["Lightning Bolt"] },
    { "graveyard": ["Counterspell"] }
   ]
  }
 }
]
