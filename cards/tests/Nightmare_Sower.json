[
  {
    "name": "casting a spell on an opponent's turn puts a -1/-1 counter on up to one target creature",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Nightmare Sower", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["p1", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "m1m1": 1 } },
      "pt": { "Grizzly Bears": [1, 1] },
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "casting on your own turn does not trigger it",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Nightmare Sower", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "players": [{}, { "life": 17 }]
    }
  }
]
