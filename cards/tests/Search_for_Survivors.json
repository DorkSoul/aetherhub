[
  {
    "name": "a random card from your graveyard is a creature: it goes onto the battlefield",
    "players": [
      { "hand": ["Search for Survivors"], "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Search for Survivors" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": [] }, {} ]
    }
  },
  {
    "name": "a random card from your graveyard that is not a creature is exiled",
    "players": [
      { "hand": ["Search for Survivors"], "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Search for Survivors" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Island"], "battlefield_lacks": ["Island"] }, {} ]
    }
  },
  {
    "name": "an empty graveyard (apart from the spell) gives no card",
    "players": [
      { "hand": ["Search for Survivors"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Search for Survivors" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": [], "graveyard": ["Search for Survivors"] }, {} ]
    }
  }
]
