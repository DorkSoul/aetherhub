 {
  "name": "ruling: survival still searches if the creature left the battlefield while tapped",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Cynical Loner", "tapped": true }, "Mountain"], "library": ["Grizzly Bears"] },
   {}
