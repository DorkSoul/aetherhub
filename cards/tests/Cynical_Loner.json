 {
  "name": "ruling: survival does nothing if the creature untapped before the ability resolves",
  "players": [
   { "hand": ["Benefactor's Draught"], "battlefield": [{ "name": "Cynical Loner", "tapped": true }, "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "advance_to": "Main2", "hold": true },
   { "cast": "Benefactor's Draught" },
   { "pass": true },
   { "pass": true },
   { "resolve": true }
