[
  {
    "name": "enchanted creature gets +2/+2 and is goaded",
    "players": [
      {
        "hand": ["Shiny Impetus"],
        "battlefield": ["Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Shiny Impetus", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] }
    }
  },
  {
    "name": "whenever enchanted creature attacks, you create a Treasure",
    "players": [
      {
        "hand": ["Shiny Impetus"],
        "battlefield": ["Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": [{ "name": "Grizzly Bears", "sick": false }]
      }
    ],
    "steps": [
      { "cast": "Shiny Impetus", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "resolve": true },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Treasure"] }, {} ]
    }
  },
  {
    "name": "goaded: Bears must attack even though only Hill Giant is declared, so it makes a Treasure and 4 damage goes through",
    "players": [
      { "hand": ["Shiny Impetus"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Shiny Impetus", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Treasure"] }, { "life": 13 } ]
    }
  },
  {
    "name": "ruling: the Treasure goes to the Impetus's controller when the opponent's enchanted creature attacks",
    "players": [
      { "hand": ["Shiny Impetus"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": [{ "name": "Grizzly Bears", "sick": false }] }
    ],
    "steps": [
      { "cast": "Shiny Impetus", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "resolve": true },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Treasure"], "life": 16 }, { "battlefield_lacks": ["Treasure"], "life": 20 } ]
    }
  }
]
