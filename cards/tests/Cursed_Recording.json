   { "hand": ["Grizzly Bears"], "battlefield": ["Cursed Recording", "Forest", "Forest"] },
   { }
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Cursed Recording": {} }
  }
 },
 {
  "name": "seventh time counter removes them and deals 20 damage to you",
  "players": [
   { "life": 25, "hand": ["Shock"], "battlefield": [{ "name": "Cursed Recording", "counters": { "time": 6 } }, "Mountain"] },
   { }
  ],
  "steps": [
   { "cast": "Shock", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 5 }, { "life": 18 } ],
   "counters": { "Cursed Recording": {} }
  }
 },
 {
  "name": "tap to copy the next instant or sorcery cast this turn",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Cursed Recording", "Mountain"] },
   { }
  ],
  "steps": [
   { "activate": "Cursed Recording" },
   { "resolve": true },
   { "cast": "Shock", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20 }, { "life": 16 } ],
   "counters": { "Cursed Recording": { "time": 1 } }
  }
 },
 {
  "name": "ruling: the copy of an X spell has the same X",
  "players": [
   { "hand": ["Blaze"], "battlefield": ["Cursed Recording", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { }
  ],
  "steps": [
   { "activate": "Cursed Recording" },
   { "resolve": true },
   { "cast": "Blaze", "targets": ["p1"], "answers": [3] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20 }, { "life": 14 } ]
  }
 },
 {
  "name": "ruling: the copy of a spell copies the additional cost's effect (Fling deals the sacrificed power again)",
  "players": [
   { "hand": ["Fling"], "battlefield": ["Cursed Recording", "Mountain", "Mountain", "Grizzly Bears"] },
   { }
  ],
  "steps": [
   { "activate": "Cursed Recording" },
   { "resolve": true },
   { "cast": "Fling", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20, "graveyard": ["Fling", "Grizzly Bears"] }, { "life": 16 } ]
  }
 }
]
