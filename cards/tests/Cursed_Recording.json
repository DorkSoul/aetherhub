[
 {
  "name": "casting an instant puts a time counter on it",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Cursed Recording", "Mountain"] },
   { }
  ],
  "steps": [
   { "cast": "Shock", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20 }, { "life": 18 } ],
   "counters": { "Cursed Recording": { "time": 1 } }
  }
 },
 {
  "name": "a creature spell does not put a time counter on it",
