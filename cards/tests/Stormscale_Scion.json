        { "life": 17, "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "ruling: countering the storm trigger means no copies are put onto the stack",
    "players": [
      { "hand": ["Lightning Bolt", "Stormscale Scion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island"] },
      { "hand": ["Tale's End"], "battlefield": ["Island", "Island"] }
