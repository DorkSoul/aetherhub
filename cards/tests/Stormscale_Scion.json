      { "resolve": true },
      { "cast": "Stormscale Scion" },
      { "pass": true },
      { "cast": "Tale's End", "player": 1, "answers": [[0]], "targets": [{ "stack": "Stormscale Scion" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island", "Stormscale Scion"] },
