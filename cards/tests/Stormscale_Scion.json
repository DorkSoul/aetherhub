      { "cast": "Stormscale Scion" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island", "Stormscale Scion", "Stormscale Scion", "Stormscale Scion"] },
