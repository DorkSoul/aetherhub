        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: countering one storm copy leaves the original spell to resolve",
    "players": [
      { "hand": ["Lightning Bolt", "Stormscale Scion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island"] },
