      ]
    }
  },
  {
    "name": "ruling: storm copies are not cast and are not counted by a later storm spell",
    "players": [
      { "hand": ["Lightning Bolt", "Stormscale Scion", "Stormscale Scion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
