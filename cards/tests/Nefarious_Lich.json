[
 {
  "name": "damage to you exiles that many cards from your graveyard instead",
  "players": [
   { "battlefield": ["Nefarious Lich"], "graveyard": ["Island", "Swamp"] },
   { "hand": ["Shock"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Shock", "player": 1, "targets": ["p0"] },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20, "graveyard": [], "exile": ["Island", "Swamp"] },
    { "graveyard": ["Shock"] }
   ],
   "winner": -1
  }
 },
 {
  "name": "can't exile enough cards: you lose the game",
  "players": [
   { "battlefield": ["Nefarious Lich"], "graveyard": ["Island"] },
   { "hand": ["Shock"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Shock", "player": 1, "targets": ["p0"] },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": { "winner": 1 }
 },
 {
  "name": "gaining life draws that many cards instead",
  "players": [
   { "hand": ["Revitalize"], "battlefield": ["Nefarious Lich", "Plains", "Island"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
   { }
  ],
  "steps": [
   { "cast": "Revitalize" },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20, "hand_count": 4, "library_count": 2, "graveyard": ["Revitalize"] }
   ]
  }
 },
 {
  "name": "the opponent's life gain is unaffected",
  "players": [
   { "battlefield": ["Nefarious Lich"] },
   { "hand": ["Revitalize"], "battlefield": ["Plains", "Island"], "library": ["Forest", "Forest"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Revitalize", "player": 1 },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "life": 23, "hand_count": 1 }
   ]
  }
 },
 {
  "name": "when it leaves the battlefield you lose the game",
  "players": [
   { "battlefield": ["Nefarious Lich"] },
   { "hand": ["Disenchant"], "battlefield": ["Plains", "Island"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Disenchant", "player": 1, "targets": ["Nefarious Lich"] },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": { "winner": 1 }
 },
 {
  "name": "ruling: at zero life the Lich does not prevent losing the game",
  "players": [
   { "life": 0, "battlefield": ["Nefarious Lich"] },
   {}
  ],
  "steps": [],
  "expect": { "winner": 1 }
 }
]
