[
  { "name": "sacrifice two Forests, fetch two lands tapped",
    "players": [ { "hand": ["Scapeshift"], "battlefield": ["Forest", "Forest", "Forest", "Mountain"], "library": ["Island", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Scapeshift" }, { "resolve": true, "answers": [[0, 1], ["Island", "Plains"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Island", "Plains"], "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Scapeshift", "Forest"] }, {} ], "tapped": { "Island": true, "Plains": true } } },
  { "name": "sacrifice nothing: fetch nothing",
    "players": [ { "hand": ["Scapeshift"], "battlefield": ["Forest", "Forest", "Forest", "Mountain"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Scapeshift" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Island"], "library_count": 1 }, {} ] } },
  { "name": "ruling: if Scapeshift is countered, no lands are sacrificed (the sacrifice happens on resolution)",
    "players": [ { "hand": ["Scapeshift"], "battlefield": ["Forest", "Forest", "Forest", "Mountain"], "library": ["Island", "Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Scapeshift" }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Scapeshift" }] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Forest", "Forest", "Mountain"], "battlefield_lacks": ["Island", "Plains"], "graveyard_has": ["Scapeshift"], "library_count": 2 }, { "graveyard_has": ["Counterspell"] } ] } }
]
