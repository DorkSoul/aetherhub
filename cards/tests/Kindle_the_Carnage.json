[
  { "name": "discard one card, damage equal to its mana value to each creature, don't repeat",
    "players": [ { "hand": ["Kindle the Carnage", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "cast": "Kindle the Carnage" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Kindle the Carnage", "Lightning Bolt"], "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Llanowar Elves"] } ] } },
  { "name": "repeating the process: two discards of mana value 1 kill a 2/2",
    "players": [ { "hand": ["Kindle the Carnage", "Lightning Bolt", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Kindle the Carnage" }, { "resolve": true, "answers": [true, false] } ],
    "expect": { "players": [ { "graveyard": ["Kindle the Carnage", "Lightning Bolt", "Shock", "Grizzly Bears"], "hand_count": 0 }, { "battlefield": ["Hill Giant"] } ] } },
  { "name": "the damage is equal to the discarded card's mana value",
    "players": [ { "hand": ["Kindle the Carnage", "Serra Angel"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Craw Wurm"] } ],
    "steps": [ { "cast": "Kindle the Carnage" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Kindle the Carnage", "Serra Angel", "Grizzly Bears"] }, { "graveyard": ["Hill Giant", "Craw Wurm"] } ] } },
  { "name": "with no card to discard nothing is dealt damage",
    "players": [ { "hand": ["Kindle the Carnage"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "cast": "Kindle the Carnage" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Kindle the Carnage"], "battlefield_has": ["Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ] } },
  { "name": "ruling: one regeneration shield saves the creature from the damage of every iteration",
    "players": [ { "hand": ["Kindle the Carnage", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Swamp", "Drudge Skeletons"] } ],
    "steps": [ { "cast": "Kindle the Carnage" }, { "pass": true }, { "activate": "Drudge Skeletons", "player": 1 }, { "resolve": true, "answers": [true, false] } ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "battlefield_has": ["Drudge Skeletons"] } ] } }
]
