[
  {
    "name": "mode 1 counters a spell with mana value 1",
    "players": [
      { "hand": ["Change the Equation", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "cast": "Change the Equation", "answers": [0], "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt", "Change the Equation"] }, { "battlefield_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "mode 2 counters a green spell with mana value 6 or less",
    "players": [
      { "hand": ["Change the Equation", "Grizzly Bears"], "battlefield": ["Island", "Island", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "cast": "Change the Equation", "answers": [1], "targets": [{ "stack": "Grizzly Bears" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Grizzly Bears", "Change the Equation"] }, {}]
    }
  },
  {
    "name": "ruling: X counts toward mana value (Fireball with X=6 has mana value 7, so neither mode can counter it)",
    "players": [
      { "hand": ["Fireball"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Change the Equation"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Fireball", "targets": ["p1"], "answers": [6] },
      { "pass": true },
      { "cast": "Change the Equation", "player": 1, "targets": [{ "stack": "Fireball" }], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Fireball"] }, { "life": 14, "hand": ["Change the Equation"] }]
    }
  }
]
