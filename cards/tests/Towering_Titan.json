[
  { "name": "enters with counters equal to total toughness of other creatures I control",
    "players": [ { "hand": ["Towering Titan"], "battlefield": ["Hill Giant", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Towering Titan" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Towering Titan"] }, {} ], "pt": { "Towering Titan": [5, 5] } } },
  { "name": "sacrificing a defender gives all creatures trample",
    "players": [ { "battlefield": [ { "name": "Towering Titan", "counters": { "p1p1": 3 } }, "Wall of Air", "Grizzly Bears" ] }, {} ],
    "steps": [ { "activate": "Towering Titan" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Towering Titan", "Grizzly Bears"], "graveyard": ["Wall of Air"] }, {} ], "keywords": { "Grizzly Bears": ["Trample"] } } },
  { "name": "ruling: counters are set on entry and do not change when another creature leaves",
    "players": [ { "hand": ["Towering Titan", "Lightning Bolt"], "battlefield": ["Hill Giant", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Towering Titan" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Towering Titan", "Hill Giant"], "battlefield_lacks": ["Grizzly Bears"] }, {} ], "pt": { "Towering Titan": [5, 5] } } }
]
