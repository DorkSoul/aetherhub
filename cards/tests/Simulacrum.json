[
  {
    "name": "gains life and deals the damage taken this turn to a creature you control",
    "players": [
      { "hand": ["Simulacrum"], "battlefield": ["Swamp", "Island", "Hill Giant"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Simulacrum", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard": ["Simulacrum", "Hill Giant"] },
        { "life": 20, "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "no damage taken this turn means no life and no damage",
    "players": [
      { "hand": ["Simulacrum"], "battlefield": ["Swamp", "Island", "Serra Angel"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Simulacrum", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield": ["Swamp", "Island", "Serra Angel"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "damage dealt to a creature is not damage dealt to you",
    "players": [
      { "hand": ["Simulacrum"], "battlefield": ["Swamp", "Island", "Serra Angel"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Serra Angel"] },
      { "resolve": true },
      { "cast": "Simulacrum", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield": ["Swamp", "Island", "Serra Angel"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: losing life (Blood Tithe) is not damage, so Simulacrum gains and deals nothing",
    "players": [
      { "hand": ["Blood Tithe"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Simulacrum"], "battlefield": ["Swamp", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Blood Tithe" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Simulacrum", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "battlefield_has": ["Grizzly Bears"], "graveyard": ["Simulacrum"] }
      ]
    }
