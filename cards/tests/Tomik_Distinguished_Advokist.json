[
 {"name":"opponent's ability can't target a land on the battlefield",
  "players":[{"battlefield":["Strip Mine"]},{"battlefield":["Tomik, Distinguished Advokist","Forest"]}],
  "steps":[{"activate":"Strip Mine","targets":["Forest"],"illegal":true}],
  "expect":{"players":[{"battlefield":["Strip Mine"]},{"battlefield":["Tomik, Distinguished Advokist","Forest"]}]}},
 {"name":"opponent's spell can't target a land",
  "players":[{"hand":["Stone Rain"],"battlefield":["Mountain","Island","Swamp"]},{"battlefield":["Tomik, Distinguished Advokist","Forest"]}],
  "steps":[{"cast":"Stone Rain","targets":["Forest"],"illegal":true}],
  "expect":{"players":[{"hand":["Stone Rain"]},{"battlefield":["Tomik, Distinguished Advokist","Forest"]}]}},
 {"name":"its controller can still target their own land",
  "players":[{"battlefield":["Strip Mine","Tomik, Distinguished Advokist","Forest"]},{}],
  "steps":[{"activate":"Strip Mine","targets":["Forest"]},{"resolve":true}],
  "expect":{"players":[{"graveyard":["Strip Mine","Forest"]},{}]}},
 {"name":"without Tomik the land can be targeted",
  "players":[{"battlefield":["Strip Mine"]},{"battlefield":["Forest"]}],
  "steps":[{"activate":"Strip Mine","targets":["Forest"]},{"resolve":true}],
  "expect":{"players":[{"graveyard":["Strip Mine"]},{"graveyard":["Forest"]}]}},
 {"name":"opponents can't play lands from graveyards",
  "players":[{"battlefield":["Crucible of Worlds"],"graveyard":["Forest"]},{"battlefield":["Tomik, Distinguished Advokist"]}],
  "steps":[{"play_land":"Forest","illegal":true}],
  "expect":{"players":[{"graveyard":["Forest"]},{}]}},
 {"name":"its controller can play lands from the graveyard",
  "players":[{"battlefield":["Crucible of Worlds","Tomik, Distinguished Advokist"],"graveyard":["Forest"]},{}],
  "steps":[{"play_land":"Forest"}],
  "expect":{"players":[{"battlefield_has":["Forest"]},{}]}},
 {"name":"ruling: a non-targeting effect (Armageddon) still destroys the Forest Tomik protects from targeting",
  "players":[{"hand":["Armageddon"],"battlefield":["Plains","Plains","Plains","Plains"]},{"battlefield":["Tomik, Distinguished Advokist","Forest"]}],
  "steps":[{"cast":"Armageddon"},{"resolve":true}],
  "expect":{"players":[{"battlefield_lacks":["Plains"]},{"graveyard_has":["Forest"],"battlefield_lacks":["Forest"]}]}},
 {"name":"ruling: Tomik's restriction overrides Crucible of Worlds' permission for the opponent to play lands from graveyards",
  "players":[{"battlefield":["Crucible of Worlds"],"graveyard":["Forest"]},{"battlefield":["Tomik, Distinguished Advokist"]}],
  "steps":[{"play_land":"Forest","illegal":true}],
  "expect":{"players":[{"graveyard":["Forest"]},{}]}}
]
