[
 {
  "name": "opponent tapping an artifact for mana lets you gain control of it",
  "players": [
   {
    "battlefield": [
     "Treasure Nabber"
    ]
   },
   {
    "battlefield": [
     "Mind Stone"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Main2"
   },
   {
    "advance_to": "Upkeep",
    "auto": true
   },
   {
    "tap_for_mana": "Mind Stone",
    "player": 1
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "turn": 2,
   "players": [
    {
     "battlefield_has": [
      "Mind Stone"
     ]
    },
    {
     "battlefield_lacks": [
      "Mind Stone"
     ]
    }
   ]
  }
 },
 {
  "name": "you tapping your own artifact or a non-artifact gives nothing",
  "players": [
   {
    "battlefield": [
     "Treasure Nabber"
    ]
   },
   {
    "battlefield": [
     "Mind Stone",
     "Forest"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Main2"
   },
   {
    "advance_to": "Upkeep",
    "auto": true
   },
   {
    "tap_for_mana": "Forest",
    "player": 1
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "turn": 2,
   "players": [
    {
     "battlefield_lacks": [
      "Mind Stone"
     ]
    },
    {
     "battlefield_has": [
      "Mind Stone"
     ]
    }
   ]
  }
 },
 {
  "name": "control reverts at the end step of your next turn, not before",
  "players": [
   {
    "battlefield": [
     "Treasure Nabber"
    ]
   },
   {
    "battlefield": [
     "Mind Stone"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Main2"
   },
   {
    "advance_to": "Upkeep",
    "auto": true
   },
   {
    "tap_for_mana": "Mind Stone",
    "player": 1
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "advance_to": "Upkeep",
    "auto": true
   }
  ],
  "expect": {
   "turn": 3,
   "players": [
    {
     "battlefield_has": [
      "Mind Stone"
     ]
    },
    {
     "battlefield_lacks": [
      "Mind Stone"
     ]
    }
   ]
  }
 },
 {
  "name": "control reverts when your next turn ends",
  "players": [
   {
    "battlefield": [
     "Treasure Nabber"
    ]
   },
   {
    "battlefield": [
     "Mind Stone"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Main2"
   },
   {
    "advance_to": "Upkeep",
    "auto": true
   },
   {
    "tap_for_mana": "Mind Stone",
    "player": 1
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "turn": 3,
   "players": [
    {
     "battlefield_lacks": [
      "Mind Stone"
     ]
    },
    {
     "battlefield_has": [
      "Mind Stone"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: a nabbed artifact stays tapped",
  "players": [
   { "battlefield": ["Treasure Nabber"] },
   { "battlefield": ["Mind Stone"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Upkeep", "auto": true },
   { "tap_for_mana": "Mind Stone", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Mind Stone"] }, { "battlefield_lacks": ["Mind Stone"] } ],
   "tapped": { "Mind Stone": true }
  }
 },
 {
  "name": "ruling: an opponent tapping during your turn gives you the artifact",
  "players": [
   { "battlefield": ["Treasure Nabber"] },
   { "battlefield": ["Mind Stone"] }
  ],
  "steps": [
   { "pass": true },
   { "tap_for_mana": "Mind Stone", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Mind Stone"] }, { "battlefield_lacks": ["Mind Stone"] } ]
  }
 },
 {
  "name": "ruling: the artifact you gained is kept through the opponent's turn and your next turn",
  "players": [
   { "battlefield": ["Treasure Nabber"] },
   { "battlefield": ["Mind Stone"] }
  ],
  "steps": [
   { "pass": true },
   { "tap_for_mana": "Mind Stone", "player": 1 },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Upkeep", "auto": true },
   { "advance_to": "End" },
   { "advance_to": "Upkeep", "auto": true }
  ],
  "expect": {
   "turn": 3,
   "players": [ { "battlefield_has": ["Mind Stone"] }, { "battlefield_lacks": ["Mind Stone"] } ]
  }
 },
 {
  "name": "ruling: the gained artifact returns when your next turn ends",
  "players": [
   { "battlefield": ["Treasure Nabber"] },
   { "battlefield": ["Mind Stone"] }
  ],
  "steps": [
   { "pass": true },
   { "tap_for_mana": "Mind Stone", "player": 1 },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Upkeep", "auto": true },
   { "advance_to": "End" },
   { "advance_to": "End" }
  ],
  "expect": {
   "turn": 3,
   "players": [ { "battlefield_lacks": ["Mind Stone"] }, { "battlefield_has": ["Mind Stone"] } ]
  }
 },
 {
  "name": "ruling: with two Treasure Nabbers the artifact is gained once and returns at the same time",
  "players": [
   { "battlefield": ["Treasure Nabber", "Treasure Nabber"] },
   { "battlefield": ["Mind Stone"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Upkeep", "auto": true },
   { "tap_for_mana": "Mind Stone", "player": 1 },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "End" }
  ],
  "expect": {
   "turn": 3,
   "players": [ { "battlefield_lacks": ["Mind Stone"] }, { "battlefield_has": ["Mind Stone"] } ]
  }
 }
]