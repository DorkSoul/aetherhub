[
  {
    "name": "an opponent casting an artifact spell turns it into a 5/3 trample Soldier",
    "players": [
      {
        "battlefield": [
          "Hidden Guerrillas"
        ]
      },
      {
        "hand": [
          "Sol Ring"
        ],
        "battlefield": [
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Main1"
      },
      {
        "player": 1,
        "cast": "Sol Ring"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "pt": {
        "Hidden Guerrillas": [
          5,
          3
        ]
      },
      "keywords": {
        "Hidden Guerrillas": [
          "Trample"
        ]
      }
    }
  },
  {
    "name": "your own artifact spell does not trigger it",
    "players": [
      {
        "hand": [
          "Sol Ring"
        ],
        "battlefield": [
          "Plains",
          "Hidden Guerrillas"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sol Ring"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Hidden Guerrillas",
            "Sol Ring"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a countered artifact spell still turns the enchantment into a 5/3 creature",
    "players": [
      { "hand": ["Counterspell"], "battlefield": ["Hidden Guerrillas", "Island", "Island"] },
      { "hand": ["Sol Ring"], "battlefield": ["Plains"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "player": 1, "cast": "Sol Ring" },
      { "pass": true, "player": 1 },
      { "player": 0, "cast": "Counterspell", "targets": [ { "stack": "Sol Ring" } ] },
      { "pass": true, "player": 0 },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Counterspell"] }, { "graveyard": ["Sol Ring"] } ],
      "pt": { "Hidden Guerrillas": [5, 3] },
      "keywords": { "Hidden Guerrillas": ["Trample"] }
    }
  },
  {
    "name": "ruling: a permanent that became a creature can attack once its controller has controlled it since the turn began",
    "players": [ { "battlefield": ["Hidden Guerrillas"] }, { "hand": ["Sol Ring"], "battlefield": ["Plains"] } ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "player": 1, "cast": "Sol Ring" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hidden Guerrillas", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 15 } ] }
  }
]