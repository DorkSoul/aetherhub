[
  { "name": "revealing a top card with three colored symbols adds three mana of its colors and puts it into hand",
    "players": [ { "battlefield": ["Omnath, Locus of All"], "library": ["Cruel Ultimatum"] }, {} ],
    "start": "Upkeep",
    "steps": [ { "advance_to": "Main1", "answers": [true, 0, 1, 2] } ],
    "expect": { "players": [ { "hand": ["Cruel Ultimatum"], "pool": { "U": 1, "B": 1, "R": 1 } }, {} ] } },
  { "name": "declining to reveal still puts the top card into hand with no mana",
    "players": [ { "battlefield": ["Omnath, Locus of All"], "library": ["Cruel Ultimatum"] }, {} ],
    "start": "Upkeep",
    "steps": [ { "advance_to": "Main1", "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Cruel Ultimatum"], "pool": {} }, {} ] } },
  { "name": "a top card with fewer than three colored symbols just goes to hand without a question",
    "players": [ { "battlefield": ["Omnath, Locus of All"], "library": ["Lightning Bolt"] }, {} ],
    "start": "Upkeep",
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"], "pool": {} }, {} ] } },
  { "name": "unspent mana becomes black instead of being lost",
    "players": [ { "battlefield": ["Omnath, Locus of All", "Forest"] }, {} ],
    "steps": [ { "tap_for_mana": "Forest" }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "pool": { "B": 1 } }, {} ] } },
  { "name": "ruling: black mana kept from an earlier step pays for a spell in a later step",
    "players": [ { "hand": ["Disfigure"], "battlefield": ["Omnath, Locus of All", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "tap_for_mana": "Forest" }, { "advance_to": "Main2" }, { "cast": "Disfigure", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Disfigure"], "pool": {} }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a card with generic cost and three red symbols ({2}{R}{R}{R}) gives three red mana when revealed",
    "players": [ { "battlefield": ["Omnath, Locus of All"], "library": ["Aerathi Berserker"] }, {} ],
    "start": "Upkeep",
    "steps": [ { "advance_to": "Main1", "answers": [true, 0, 0, 0] } ],
    "expect": { "players": [ { "hand": ["Aerathi Berserker"], "pool": { "R": 3 } }, {} ] } }
]
