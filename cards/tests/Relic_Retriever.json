        "battlefield": ["Relic Retriever", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"],
        "graveyard": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Ghouls' Night Out" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Relic Retriever", "Grizzly Bears", "Treasure"],
          "graveyard": ["Ghouls' Night Out"]
