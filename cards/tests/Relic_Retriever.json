          "battlefield_has": ["Relic Retriever"],
          "graveyard": ["Grizzly Bears"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a card leaving the graveyard during the end step is too late for the Treasure",
    "players": [
      {
        "hand": ["Beckon Apparition"],
        "battlefield": ["Relic Retriever", "Swamp"],
        "graveyard": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "End", "hold": true },
      { "cast": "Beckon Apparition" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Relic Retriever"],
          "battlefield_lacks": ["Treasure"],
