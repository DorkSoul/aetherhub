[
  {
    "name": "casting a Spirit spell: may gain life equal to its mana value",
    "players": [ { "hand": ["Spectral Sailor"], "battlefield": ["Island", "Bounteous Kirin"] }, {} ],
    "steps": [ { "cast": "Spectral Sailor" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "battlefield_has": ["Spectral Sailor", "Bounteous Kirin"] }, {} ] }
  },
  {
    "name": "declining the trigger gains no life",
    "players": [ { "hand": ["Spectral Sailor"], "battlefield": ["Island", "Bounteous Kirin"] }, {} ],
    "steps": [ { "cast": "Spectral Sailor" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "life": 20 }, {} ] }
  },
  {
    "name": "a non-Spirit spell does not trigger it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Island", "Bounteous Kirin"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "ruling: an X spell's mana value uses X on the stack (Shining Shoal with X=2 is worth 4 life)",
    "players": [ { "hand": ["Shining Shoal"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Bounteous Kirin"] }, {} ],
    "steps": [ { "cast": "Shining Shoal", "targets": ["p1"], "answers": [2] }, { "resolve": true, "answers": [true, "Bounteous Kirin"] } ],
    "expect": { "players": [ { "life": 24, "battlefield_has": ["Bounteous Kirin"] }, { "life": 20 } ] }
  }
]
