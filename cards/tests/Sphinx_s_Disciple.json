[
  {
    "name": "untapping in your untap step draws a card",
    "players": [
      { "battlefield": [ { "name": "Sphinx's Disciple", "tapped": true, "sick": false } ], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Sphinx's Disciple"] }, {} ]
    }
  },
  {
    "name": "entering the battlefield does not trigger it",
    "players": [
      { "hand": ["Sphinx's Disciple"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Sphinx's Disciple" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "battlefield_has": ["Sphinx's Disciple"] }, {} ]
    }
  },
  {
    "name": "ruling: becoming untapped by a spell (Dramatic Reversal) also triggers inspired",
    "players": [
      { "hand": ["Dramatic Reversal"], "battlefield": [ { "name": "Sphinx's Disciple", "tapped": true, "sick": false }, "Island", "Island" ], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Dramatic Reversal" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Sphinx's Disciple"], "graveyard_has": ["Dramatic Reversal"] }, {} ],
      "tapped": { "Sphinx's Disciple": false }
    }
  }
]
