[
  {
    "name": "exiles two cards from one graveyard; P/T equals cards exiled with it",
    "players": [
      { "battlefield": ["Unlicensed Hearse"] },
      { "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Unlicensed Hearse", "ability": 0, "targets": ["Grizzly Bears", "Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": [], "exile": ["Grizzly Bears", "Lightning Bolt"] } ],
      "pt": { "Unlicensed Hearse": [2, 2] }
    }
  },
  {
    "name": "exiling one card makes it 1/1",
    "players": [
      { "battlefield": ["Unlicensed Hearse"] },
      { "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Unlicensed Hearse", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Lightning Bolt"], "exile": ["Grizzly Bears"] } ],
      "pt": { "Unlicensed Hearse": [1, 1] }
    }
  },
  {
    "name": "Crew 2: tapping a 2-power creature makes the exiled-2 Hearse a 2/2 artifact creature",
    "players": [
      { "battlefield": ["Unlicensed Hearse", "Grizzly Bears"] },
      { "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Unlicensed Hearse", "ability": 0, "targets": ["p1:Grizzly Bears", "p1:Lightning Bolt"] },
      { "resolve": true },
      { "activate": "Unlicensed Hearse", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Unlicensed Hearse", "Grizzly Bears"] }, {} ],
      "tapped": { "Grizzly Bears": true },
      "pt": { "Unlicensed Hearse": [2, 2] }
    }
  },
  {
    "name": "Crew 2 needs total power 2: a 1-power creature cannot crew it",
    "players": [
      { "battlefield": ["Unlicensed Hearse", "Elvish Mystic"] },
      { "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Unlicensed Hearse", "ability": 0, "targets": ["p1:Grizzly Bears", "p1:Lightning Bolt"] },
      { "resolve": true },
      { "activate": "Unlicensed Hearse", "ability": 1, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Unlicensed Hearse", "Elvish Mystic"] }, {} ],
      "tapped": { "Elvish Mystic": false },
      "pt": { "Unlicensed Hearse": [2, 2] }
    }
  },
  {
    "name": "ruling: crewing before exiling any card makes it a 0/0 that dies as a state-based action",
    "players": [
      { "battlefield": ["Unlicensed Hearse", { "name": "Grizzly Bears", "sick": false }] },
      { "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Unlicensed Hearse", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Unlicensed Hearse"], "battlefield_lacks": ["Unlicensed Hearse"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
