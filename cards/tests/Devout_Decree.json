[
 {
  "name": "exiles target black or red creature and scries 1",
  "players": [
   { "hand": ["Devout Decree"], "battlefield": ["Plains", "Plains"] },
   { "battlefield": ["Shivan Dragon"] }
  ],
  "steps": [
   { "cast": "Devout Decree", "targets": ["Shivan Dragon"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Devout Decree"] },
    { "exile": ["Shivan Dragon"], "battlefield_lacks": ["Shivan Dragon"] }
   ]
  }
 },
 {
  "name": "cannot target a green creature",
  "players": [
   { "hand": ["Devout Decree"], "battlefield": ["Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Devout Decree", "illegal": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Devout Decree"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: if the target becomes illegal in response, Devout Decree does not resolve (no exile, no scry)",
  "players": [
   { "hand": ["Devout Decree"], "battlefield": ["Plains", "Plains"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] }
  ],
  "steps": [
   { "cast": "Devout Decree", "targets": ["Hill Giant"] },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Devout Decree"], "exile": [] },
    { "graveyard_has": ["Hill Giant", "Lightning Bolt"] }
   ]
  }
 }
]
