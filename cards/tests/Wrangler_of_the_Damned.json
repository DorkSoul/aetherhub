[
 {
  "name": "creates a 2/2 flying Spirit at your end step when no spell was cast from hand",
  "players": [
   { "battlefield": ["Wrangler of the Damned"] },
   {}
  ],
  "steps": [
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Spirit 2-2 Flying"] },
    {}
   ],
   "pt": { "Spirit 2-2 Flying": [2, 2] }
  }
 },
 {
  "name": "no token after casting a spell from hand this turn",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Wrangler of the Damned", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Spirit 2-2 Flying"] },
    {}
   ]
  }
 },
 {
  "name": "casting from graveyard (flashback) does not stop the token",
  "players": [
   { "graveyard": ["Think Twice"], "battlefield": ["Wrangler of the Damned", "Island", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Think Twice", "alt": 0 },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Spirit 2-2 Flying"] },
    {}
   ]
  }
 },
 {
  "name": "does not trigger on the opponent's end step",
  "players": [
   {},
   { "battlefield": ["Wrangler of the Damned"] }
  ],
  "steps": [
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "battlefield_lacks": ["Spirit 2-2 Flying"] }
   ]
  }
 },
 {
  "name": "ruling: a spell cast from hand in response to the end-step trigger: the trigger does nothing as it resolves",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Wrangler of the Damned", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "End", "hold": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Spirit 2-2 Flying"], "graveyard": ["Lightning Bolt"] },
    { "graveyard": ["Grizzly Bears"] }
   ]
  }
 }]
