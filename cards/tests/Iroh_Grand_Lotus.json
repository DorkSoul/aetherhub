[
 {
  "name": "on your turn a non-Lesson sorcery in your graveyard can be cast for its mana cost",
  "players": [
   {
    "battlefield": ["Iroh, Grand Lotus", "Island", "Island", "Plains"],
    "graveyard": ["Divination"],
    "library": ["Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "cast": "Divination", "alt": 100 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Iroh, Grand Lotus"], "exile": ["Divination"], "graveyard": [], "hand_count": 2 },
    {}
   ]
  }
 },
 {
  "name": "on an opponent's turn the flashback grant does not apply",
  "players": [
   {
    "battlefield": ["Iroh, Grand Lotus", "Island", "Island", "Plains"],
    "graveyard": ["Divination"]
   },
   {}
  ],
  "steps": [
