                   "library": ["Lightning Bolt", "Mountain", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Tracker's Instincts" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Tracker's Instincts", "Lightning Bolt", "Mountain", "Plains", "Island"] }, {} ] } },
  { "name": "flashback for 2U from the graveyard, then exiled",
