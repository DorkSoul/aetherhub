    "players": [ { "graveyard": ["Tracker's Instincts"], "battlefield": ["Island", "Forest", "Forest"],
                   "library": ["Grizzly Bears", "Lightning Bolt", "Mountain", "Plains"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 },
