   { "hand": ["Kenrith's Transformation"], "battlefield": ["Forest", "Forest"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Kenrith's Transformation", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 0, "graveyard_has": ["Kenrith's Transformation"] },
    { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: a later base power/toughness effect (Lignify) overwrites Kenrith's Transformation",
