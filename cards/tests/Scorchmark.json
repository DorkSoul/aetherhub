[
  { "name": "damaged creature that would die is exiled instead",
    "players": [ { "hand": ["Scorchmark"], "battlefield": ["Mountain", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Scorchmark", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scorchmark"] }, { "exile": ["Grizzly Bears"], "graveyard": [] } ] } },
  { "name": "creature that survives the damage is not exiled",
    "players": [ { "hand": ["Scorchmark"], "battlefield": ["Mountain", "Swamp"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Scorchmark", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scorchmark"] }, { "exile": [], "graveyard": [] } ] } },
  { "name": "ruling: a creature that dies later this turn for another reason is exiled too",
    "players": [ { "hand": ["Scorchmark", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Swamp"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Scorchmark", "targets": ["Hill Giant"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scorchmark", "Lightning Bolt"] }, { "exile": ["Hill Giant"], "graveyard": [] } ] } }
]
