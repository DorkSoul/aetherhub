[
  { "name": "ruling: the normal cost can be paid even when the alternative cost condition is met",
    "players": [ { "hand": ["Runeflare Trap", "Sign in Blood", "Sign in Blood"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Runeflare Trap", "targets": ["p1"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Runeflare Trap", "Sign in Blood", "Sign in Blood"] }, { "life": 10 } ] } },
  { "name": "ruling: the damaged player may be the caster, not the opponent who drew",
    "players": [ { "hand": ["Runeflare Trap", "Sign in Blood", "Sign in Blood", "Island", "Island"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Island"] } ],
    "steps": [
      { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Runeflare Trap", "alt": 0, "targets": ["p0"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "life": 18 }, { "life": 16 } ] } },
  { "name": "alt cost {R} once an opponent drew three or more this turn; damage = that player's hand (2 starting + 4 drawn)",
    "players": [ { "hand": ["Runeflare Trap", "Sign in Blood", "Sign in Blood"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Runeflare Trap", "alt": 0, "targets": ["p1"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Runeflare Trap", "Sign in Blood", "Sign in Blood"] }, { "life": 10 } ] } },
  { "name": "alt cost is not available when an opponent drew only two this turn",
    "players": [ { "hand": ["Runeflare Trap", "Sign in Blood"], "battlefield": ["Mountain", "Swamp", "Swamp"] }, { "hand": ["Island"] } ],
    "steps": [
      { "cast": "Sign in Blood", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Runeflare Trap", "alt": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Runeflare Trap"] }, { "life": 18 } ] } },
  { "name": "normal {4}{R}{R} cost always works; damage equals hand size",
    "players": [ { "hand": ["Runeflare Trap"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Island", "Island"] } ],
    "steps": [ { "cast": "Runeflare Trap", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Runeflare Trap"] }, { "life": 18 } ] } }
]
