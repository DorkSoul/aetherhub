[
 {"name": "upkeep: one Cat for each Equipment attached to it",
  "players": [{"battlefield": ["Kemba, Kha Regent", "+2 Mace", "Plains", "Plains", "Plains"]}, {}],
  "steps": [
    {"activate": "+2 Mace", "targets": ["Kemba, Kha Regent"]}, {"resolve": true},
    {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}
  ],
  "expect": {"players": [{"battlefield_has": ["Kemba, Kha Regent", "+2 Mace", "Cat 2-2 White"]}, {}]}},
 {"name": "two Equipment make two Cats",
  "players": [{"battlefield": ["Kemba, Kha Regent", "+2 Mace", "Accorder's Shield", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"]}, {}],
  "steps": [
    {"activate": "+2 Mace", "targets": ["Kemba, Kha Regent"]}, {"resolve": true},
    {"activate": "Accorder's Shield", "targets": ["Kemba, Kha Regent"]}, {"resolve": true},
    {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}
  ],
  "expect": {"players": [{"battlefield_has": ["Cat 2-2 White", "Cat 2-2 White"]}, {}]}},
 {"name": "unattached Equipment does not count",
  "players": [{"battlefield": ["Kemba, Kha Regent", "+2 Mace"]}, {}],
  "steps": [
    {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}
  ],
  "expect": {"players": [{"battlefield_lacks": ["Cat 2-2 White"]}, {}]}},
 {"name": "ruling: Kemba leaves before its upkeep trigger resolves; Equipment counts as it was at its last existence",
  "players": [{"hand": ["Unsummon"], "battlefield": ["Kemba, Kha Regent", "+2 Mace", "Plains", "Plains", "Island"]}, {}],
  "steps": [
    {"activate": "+2 Mace", "targets": ["Kemba, Kha Regent"]}, {"resolve": true},
    {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"},
    {"cast": "Unsummon", "targets": ["Kemba, Kha Regent"]}, {"resolve": true}
  ],
  "expect": {"players": [{"hand": ["Kemba, Kha Regent"], "battlefield_has": ["Cat 2-2 White"]}, {}]}}
]
