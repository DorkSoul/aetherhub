[
  {
    "name": "plus two forces the opponent's creatures to attack Gideon",
    "players": [
      { "battlefield": ["Gideon Jura"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Gideon Jura", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "DeclareAttackers", "player": 1 },
      { "attack": [], "player": 1, "illegal": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Hill Giant", "at": "p0" } ], "player": 1 }
    ],
    "expect": {
      "players": [{ "life": 20 }, {}],
      "counters": { "Gideon Jura": { "loyalty": 3 } }
    }
  },
  {
    "name": "the forced attack goes to Gideon, who takes the damage",
    "players": [
      { "battlefield": ["Gideon Jura"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Gideon Jura", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "DeclareAttackers", "player": 1 },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 }
    ],
    "expect": {
      "players": [{ "life": 20 }, {}],
      "counters": { "Gideon Jura": { "loyalty": 6 } }
    }
  },
  {
    "name": "minus two destroys a tapped creature",
    "players": [
      { "battlefield": ["Gideon Jura"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "activate": "Gideon Jura", "ability": 1, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Grizzly Bears"] }],
      "counters": { "Gideon Jura": { "loyalty": 4 } }
    }
  },
  {
    "name": "minus two cannot target an untapped creature",
    "players": [
      { "battlefield": ["Gideon Jura"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Gideon Jura", "ability": 1, "targets": ["p1:Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Grizzly Bears"] }],
      "counters": { "Gideon Jura": { "loyalty": 6 } }
    }
  },
  {
    "name": "zero makes Gideon a 6/6 creature",
    "players": [
      { "battlefield": ["Gideon Jura"] },
      {}
    ],
    "steps": [
      { "activate": "Gideon Jura", "ability": 2 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "counters": { "Gideon Jura": { "loyalty": 6 } },
      "pt": { "Gideon Jura": [6, 6] }
    }
  },
  {
    "name": "ruling: zero keeps Gideon's own subtype and adds Human Soldier",
    "players": [
      { "battlefield": ["Gideon Jura"] },
      {}
    ],
    "steps": [
      { "activate": "Gideon Jura", "ability": 2 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "subtypes": { "Gideon Jura": ["Gideon", "Human", "Soldier"] },
      "pt": { "Gideon Jura": [6, 6] }
    }
  }
]
