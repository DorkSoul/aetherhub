[
  {
    "name": "your upkeep exiles the top card of your library and you may play it this turn",
    "players": [
      {
        "battlefield": [
          "Urabrask, Heretic Praetor"
        ],
        "library": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Main1"
      },
      {
        "play_land": "Island"
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [],
          "battlefield_has": [
            "Urabrask, Heretic Praetor",
            "Island"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "the upkeep exile is not a draw: the card goes to exile, not to hand",
    "players": [
      {
        "battlefield": [
          "Urabrask, Heretic Praetor"
        ],
        "library": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "exile": [
            "Island"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "opponent's upkeep: their next draw this turn exiles the top card instead, and they may play it",
    "players": [
      {
        "battlefield": [
          "Urabrask, Heretic Praetor"
        ]
      },
      {
        "library": [
          "Island",
          "Swamp"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Draw"
      },
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 0,
          "exile": [
            "Island"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: an upkeep-exiled land cannot be played in the upkeep",
    "players": [
      {
        "battlefield": ["Urabrask, Heretic Praetor"],
        "library": ["Island"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "play_land": "Island", "illegal": true },
      { "advance_to": "Main1" },
      { "play_land": "Island" }
    ],
    "expect": {
      "players": [
        { "exile": [], "battlefield_has": ["Urabrask, Heretic Praetor", "Island"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an exiled land cannot be played if a land was already played this turn",
    "players": [
      {
        "hand": ["Mountain"],
        "battlefield": ["Urabrask, Heretic Praetor"],
        "library": ["Island"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "play_land": "Mountain" },
      { "play_land": "Island", "illegal": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Island"], "battlefield_has": ["Urabrask, Heretic Praetor", "Mountain"] },
        {}
      ]
    }
  }
]