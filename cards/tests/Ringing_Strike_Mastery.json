[
 {
  "name": "enters tapping the enchanted creature, which then does not untap",
  "players": [ { "hand": ["Ringing Strike Mastery"], "battlefield": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
   { "cast": "Ringing Strike Mastery", "targets": ["Grizzly Bears"] }, { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "tapped": { "Grizzly Bears": true }, "attached": { "Ringing Strike Mastery": "Grizzly Bears" } }
 },
 {
  "name": "enchanted creature stays tapped through your untap step",
  "players": [ { "hand": ["Ringing Strike Mastery"], "battlefield": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
   { "cast": "Ringing Strike Mastery", "targets": ["Grizzly Bears"] }, { "resolve": true },
   { "resolve": true },
   { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }
  ],
  "expect": { "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "granted {5}: untap ability lets the enchanted creature's controller untap it",
  "players": [ { "hand": ["Ringing Strike Mastery"], "battlefield": ["Island"] }, { "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest"] } ],
  "steps": [
   { "cast": "Ringing Strike Mastery", "targets": ["Grizzly Bears"] }, { "resolve": true },
   { "resolve": true },
   { "pass": true },
   { "activate": "Grizzly Bears", "ability": 32768, "player": 1 }, { "resolve": true }
  ],
  "expect": { "tapped": { "Grizzly Bears": false } }
 }
]
