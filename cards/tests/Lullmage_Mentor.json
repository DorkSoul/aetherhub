[
  {
    "name": "countering a spell with a spell you control makes a Merfolk",
    "players": [ { "hand": ["Cancel"], "battlefield": ["Lullmage Mentor", "Island", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Cancel", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Merfolk 1-1"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "seven Merfolk are needed to counter a spell",
    "players": [ { "battlefield": ["Lullmage Mentor"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "activate": "Lullmage Mentor", "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "tapping seven Merfolk counters a spell and the Mentor makes a Merfolk for the trigger",
    "players": [ { "battlefield": ["Lullmage Mentor", "Merfolk 1-1", "Merfolk 1-1", "Merfolk 1-1", "Merfolk 1-1", "Merfolk 1-1", "Merfolk 1-1"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "activate": "Lullmage Mentor", "ability": 0 }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Merfolk 1-1"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "a tapped Merfolk cannot be used: six untapped Merfolk is not enough",
    "players": [ { "battlefield": ["Lullmage Mentor", { "name": "Merfolk 1-1", "tapped": true }, "Merfolk 1-1", "Merfolk 1-1", "Merfolk 1-1", "Merfolk 1-1", "Merfolk 1-1"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "activate": "Lullmage Mentor", "ability": 0, "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "ruling: a bounced target makes the Bolt fizzle, which is not a counter, so no Merfolk",
    "players": [ { "hand": ["Unsummon"], "battlefield": ["Lullmage Mentor", "Island", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "cast": "Unsummon", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Merfolk 1-1"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  },
  {
    "name": "ruling: summoning-sick Merfolk, including the Mentor itself, can be tapped to pay the cost",
    "players": [ { "battlefield": [ { "name": "Lullmage Mentor", "sick": true }, { "name": "Merfolk 1-1", "sick": true }, { "name": "Merfolk 1-1", "sick": true }, { "name": "Merfolk 1-1", "sick": true }, { "name": "Merfolk 1-1", "sick": true }, { "name": "Merfolk 1-1", "sick": true }, { "name": "Merfolk 1-1", "sick": true } ] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "activate": "Lullmage Mentor", "ability": 0 }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Merfolk 1-1"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  }
]
