   "steps": [{"tap_for_mana": "Ether", "color": "U"}, {"cast": "Divination"}, {"resolve": true}],
   "expect": {"players": [{"exile": ["Ether"], "graveyard": ["Divination"], "hand_count": 4}, {}], "stack_empty": true}},
  {"name": "ruling: the copy may get new targets; the original keeps its target",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Ether", "Mountain"]}, {"battlefield": ["Grizzly Bears"]}],
   "steps": [{"tap_for_mana": "Ether", "color": "U"}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true, "answers": ["Grizzly Bears"]}],
   "expect": {"players": [{"exile": ["Ether"], "graveyard": ["Lightning Bolt"]}, {"life": 17, "graveyard": ["Grizzly Bears"]}], "stack_empty": true}}
