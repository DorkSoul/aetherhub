   "steps": [{"tap_for_mana": "Ether", "color": "U"}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{"exile": ["Ether"]}, {"life": 14}]}},
  {"name": "ruling: the copy has the same X as the original spell",
   "players": [{"hand": ["Blaze"], "battlefield": ["Ether", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"tap_for_mana": "Ether", "color": "U"}, {"cast": "Blaze", "targets": ["p1"], "answers": [3]}, {"resolve": true, "auto": true}],
   "expect": {"players": [{"exile": ["Ether"], "graveyard": ["Blaze"]}, {"life": 14}], "stack_empty": true}},
  {"name": "ruling: the copy is made even when the spell has no targets",
