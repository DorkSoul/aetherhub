[
  {
    "name": "ETB draw is doubled by the replacement when hand has one or fewer cards",
    "players": [
      { "hand": ["Quantum Riddler"], "battlefield": ["Island", "Island", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Quantum Riddler" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 2, "battlefield_has": ["Quantum Riddler"] },
        {}
      ]
    }
  },
  {
    "name": "replacement does not apply when hand has two or more cards",
    "players": [
      { "hand": ["Quantum Riddler", "Lightning Bolt", "Mountain"], "battlefield": ["Island", "Island", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Quantum Riddler" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3, "battlefield_has": ["Quantum Riddler"] },
        {}
      ]
    }
  },
  {
    "name": "warp from hand is exiled at the end step",
    "players": [
      { "hand": ["Quantum Riddler"], "battlefield": ["Island", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Quantum Riddler", "alt": 0 },
      { "resolve": true },
      { "advance_to": "End" },
      { "pass": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Quantum Riddler"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Divination draws three with one or fewer cards in hand (the instruction is replaced as a whole)",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Quantum Riddler", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3, "battlefield_has": ["Quantum Riddler"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Riddler applies to the whole draw first, then Thought Reflection doubles each card (six cards)",
    "players": [
      { "hand": ["Divination"], "battlefield": ["Quantum Riddler", "Thought Reflection", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 6, "battlefield_has": ["Quantum Riddler", "Thought Reflection"] },
        {}
      ]
    }
  }
]
