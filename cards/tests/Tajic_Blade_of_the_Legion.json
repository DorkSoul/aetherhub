[
  { "name": "battalion: gets +5/+5 when attacking with two others",
    "players": [ { "battlefield": ["Tajic, Blade of the Legion", "Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Tajic, Blade of the Legion", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Tajic, Blade of the Legion": [7, 7] }, "players": [ {}, { "life": 8 } ] } },
  { "name": "attacking with only one other: stays 2/2",
    "players": [ { "battlefield": ["Tajic, Blade of the Legion", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Tajic, Blade of the Legion", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Tajic, Blade of the Legion": [2, 2] }, "players": [ {}, { "life": 16 } ] } },
  { "name": "ruling: the battalion pump still happens when a third attacker is removed in response",
    "players": [ { "battlefield": ["Tajic, Blade of the Legion", "Grizzly Bears", "Hill Giant"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "attack": [ { "card": "Tajic, Blade of the Legion", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Tajic, Blade of the Legion": [7, 7] }, "players": [ { "battlefield_lacks": ["Hill Giant"] }, { "life": 11 } ] } }
]
