[
 {"name": "upkeep exiles one card per other nonland card type; the exiled spell can be cast this turn",
  "players": [{"battlefield": ["Loot, the Key to Everything", "Grizzly Bears", "Ornithopter", "Mountain"], "library": ["Lightning Bolt", "Island", "Forest"]}, {}],
  "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}, {"advance_to": "Main1"}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{"graveyard": ["Lightning Bolt"], "exile": ["Island"]}, {"life": 17}]}},
 {"name": "an exiled land can be played this turn",
  "players": [{"battlefield": ["Loot, the Key to Everything", "Grizzly Bears", "Ornithopter"], "library": ["Lightning Bolt", "Island", "Forest"]}, {}],
  "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}, {"advance_to": "Main1"}, {"play_land": "Island"}],
  "expect": {"players": [{"battlefield_has": ["Island"], "exile": ["Lightning Bolt"]}, {}]}},
 {"name": "the exiled cards can no longer be cast on a later turn",
  "players": [{"battlefield": ["Loot, the Key to Everything", "Grizzly Bears", "Ornithopter", "Mountain"], "library": ["Lightning Bolt", "Island", "Forest"]}, {}],
  "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}, {"advance_to": "End"}, {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}, {"advance_to": "Main1"}, {"cast": "Lightning Bolt", "targets": ["p1"], "illegal": true}],
  "expect": {}},
 {"name": "lands and Loot itself do not count, so nothing is exiled",
  "players": [{"battlefield": ["Loot, the Key to Everything", "Forest"], "library": ["Lightning Bolt", "Island"]}, {}],
  "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}, {"advance_to": "Main1"}],
  "expect": {"players": [{"exile": [], "hand": ["Lightning Bolt"]}, {}]}},
 {"name": "ward {1}: an opponent who cannot pay has the Bolt countered and Loot survives",
  "players": [{"battlefield": ["Loot, the Key to Everything"]}, {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}],
  "steps": [{"pass": true}, {"cast": "Lightning Bolt", "player": 1, "targets": ["Loot, the Key to Everything"]}, {"resolve": true}],
  "expect": {"players": [{"battlefield_has": ["Loot, the Key to Everything"]}, {"graveyard_has": ["Lightning Bolt"]}]}},
 {"name": "ward {1}: an opponent who pays the {1} lets the Bolt kill Loot",
  "players": [{"battlefield": ["Loot, the Key to Everything"]}, {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"]}],
  "steps": [{"pass": true}, {"cast": "Lightning Bolt", "player": 1, "targets": ["Loot, the Key to Everything"]}, {"resolve": true}],
  "expect": {"players": [{"graveyard_has": ["Loot, the Key to Everything"]}, {"graveyard_has": ["Lightning Bolt"]}]}},
 {"name": "ruling: an exiled land cannot be played during the upkeep",
  "players": [{"battlefield": ["Loot, the Key to Everything", "Grizzly Bears", "Ornithopter"], "library": ["Lightning Bolt", "Island", "Forest"]}, {}],
  "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}, {"play_land": "Island", "illegal": true}],
  "expect": {"players": [{"exile": ["Lightning Bolt", "Island"]}, {}]}},
 {"name": "ruling: artifact, creature and enchantment are three types, so three cards are exiled",
  "players": [{"battlefield": ["Loot, the Key to Everything", "Wingrattle Scarecrow", "Master's Guidance"], "library": ["Lightning Bolt", "Island", "Forest", "Mountain"]}, {}],
  "steps": [{"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true}],
  "expect": {"players": [{"exile": ["Lightning Bolt", "Island", "Forest"], "library_top": ["Mountain"]}, {}]}}
