[
  {
    "name": "sacrificing a land with fewer than seven lands in graveyard makes a tapped 1/1 Insect",
    "players": [
      { "hand": ["Crop Rotation"], "battlefield": ["Scouring Swarm", "Forest", "Mountain"], "library": ["Island", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Crop Rotation", "answers": [["Mountain"]] },
      { "resolve": true, "answers": [["Swamp"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scouring Swarm", "Insect 1-1 Black Flying"], "graveyard": ["Crop Rotation", "Mountain"] },
        {}
      ],
      "tapped": { "Insect 1-1 Black Flying": true }
    }
  },
  {
    "name": "seven land cards in graveyard: the token is a copy of Scouring Swarm and no Insect is made",
    "players": [
      { "hand": ["Crop Rotation"], "battlefield": ["Scouring Swarm", "Forest", "Mountain"], "library": ["Island", "Swamp"], "graveyard": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Crop Rotation", "answers": [["Mountain"]] },
      { "resolve": true, "answers": [["Swamp"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scouring Swarm", "Scouring Swarm"], "battlefield_lacks": ["Insect 1-1 Black Flying"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: if Scouring Swarm leaves before the trigger resolves, the token still copies it (last known copiable values)",
    "players": [
      { "hand": ["Crop Rotation"], "battlefield": ["Scouring Swarm", "Forest", "Mountain"], "library": ["Island", "Swamp"], "graveyard": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Crop Rotation", "answers": [["Mountain"]] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Scouring Swarm"] },
      { "resolve": true, "answers": [["Swamp"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scouring Swarm"], "battlefield_lacks": ["Insect 1-1 Black Flying"], "graveyard": ["Crop Rotation", "Island", "Island", "Island", "Island", "Island", "Island", "Mountain", "Scouring Swarm"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: the token copy has the trigger too, so sacrificing a land again makes more copies",
    "players": [
      { "hand": ["Crop Rotation", "Crop Rotation"], "battlefield": ["Scouring Swarm", "Forest", "Forest", "Mountain", "Island"], "library": ["Swamp", "Swamp"], "graveyard": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Crop Rotation", "answers": [["Mountain"]] },
      { "resolve": true, "answers": [["Swamp"]] },
      { "cast": "Crop Rotation", "answers": [["Island"]] },
      { "resolve": true, "answers": [["Swamp"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scouring Swarm", "Scouring Swarm", "Scouring Swarm", "Scouring Swarm"], "battlefield_lacks": ["Insect 1-1 Black Flying"] },
        {}
      ]
    }
  }
]
