[
 { "name": "max speed: sacrifice to copy your spell; the copy and the original both deal 3",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Island", "Mountain", "Slick Imitator"] }, {} ],
   "steps": [ { "set_speed": 4 }, { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "activate": "Slick Imitator", "ability": 32768, "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Slick Imitator", "Lightning Bolt"], "battlefield_lacks": ["Slick Imitator"] }, { "life": 14 } ] } },
 { "name": "speed below max: the ability is not available",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Island", "Mountain", "Slick Imitator"] }, {} ],
   "steps": [ { "set_speed": 3 }, { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "activate": "Slick Imitator", "ability": 32768, "targets": [{ "stack": "Lightning Bolt" }], "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Slick Imitator"] }, { "life": 20 } ] } },
 { "name": "start your engines: speed is 1 as soon as it enters",
   "players": [ { "hand": ["Slick Imitator"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "cast": "Slick Imitator" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Slick Imitator"], "speed": 1 }, {} ] } },
 { "name": "each player tracks speed: my speed does not give the opponent speed",
   "players": [ { "hand": ["Slick Imitator"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "cast": "Slick Imitator" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Slick Imitator"], "speed": 1 }, { "speed": 0 } ] } },
 { "name": "ruling: speed rises only through the inherent trigger, so a second opponent life loss on my turn does not raise it again",
   "players": [ { "hand": ["Slick Imitator", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Island", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Slick Imitator" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Slick Imitator"], "speed": 2 }, { "life": 14 } ] } },
 { "name": "ruling: losing control of a start your engines permanent does not change its old controller's speed",
   "players": [ { "battlefield": ["Slick Imitator"] }, { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
   "steps": [ { "set_speed": 4 }, { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "cast": "Control Magic", "player": 1, "targets": ["Slick Imitator"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 4, "battlefield_lacks": ["Slick Imitator"] }, { "battlefield_has": ["Slick Imitator"] } ] } },
 { "name": "ruling: gaining control of a start your engines permanent gives its new controller speed 1",
   "players": [ { "battlefield": ["Slick Imitator"] }, { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
   "steps": [ { "set_speed": 4 }, { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "cast": "Control Magic", "player": 1, "targets": ["Slick Imitator"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Slick Imitator"] }, { "battlefield_has": ["Slick Imitator"], "speed": 1 } ] } }
]
