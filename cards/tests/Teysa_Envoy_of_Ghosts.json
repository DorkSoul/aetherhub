[
  {
    "name": "a creature dealing combat damage to you is destroyed and you get a W/B Spirit",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Teysa, Envoy of Ghosts"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"] },
        { "battlefield_has": ["Teysa, Envoy of Ghosts", "Spirit 1-1 White Black Flying"], "life": 18 }
      ]
    }
  },
  {
    "name": "noncreature damage to you does not trigger Teysa",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Teysa, Envoy of Ghosts"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield_lacks": ["Spirit 1-1 White Black Flying"], "life": 17 }
      ]
    }
  },
  {
    "name": "protection from creatures: an opponent's creature cannot block Teysa",
    "players": [
      { "battlefield": ["Teysa, Envoy of Ghosts", "Raging Goblin"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Teysa, Envoy of Ghosts", "at": "p1" }, { "card": "Raging Goblin", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Teysa, Envoy of Ghosts" }, { "blocker": "Hill Giant", "attacker": "Raging Goblin" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 16 }
      ]
    }
  },
  {
    "name": "ruling: Teysa's destroy does not target, so a protection-from-white creature is still destroyed",
    "players": [
      { "battlefield": ["Black Knight"] },
      { "battlefield": ["Teysa, Envoy of Ghosts"] }
    ],
    "steps": [
      { "attack": [ { "card": "Black Knight", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Black Knight"] },
        { "battlefield_has": ["Teysa, Envoy of Ghosts", "Spirit 1-1 White Black Flying"], "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: the Spirit goes to Teysa's controller when the opponent's creature deals damage to that player",
    "players": [
      { "battlefield": ["Teysa, Envoy of Ghosts"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Teysa, Envoy of Ghosts", "Spirit 1-1 White Black Flying"], "life": 18 },
        { "battlefield_lacks": ["Grizzly Bears", "Spirit 1-1 White Black Flying"] }
      ]
    }
  },
  {
    "name": "ruling: the Spirit is still created when the destroy fails (attacking Bears is indestructible via Watershaper)",
    "players": [
      { "battlefield": ["Adept Watershaper", "Grizzly Bears"] },
      { "battlefield": ["Teysa, Envoy of Ghosts"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Adept Watershaper", "Grizzly Bears"] },
        { "battlefield_has": ["Teysa, Envoy of Ghosts", "Spirit 1-1 White Black Flying"], "life": 18 }
      ]
    }
  }
]
