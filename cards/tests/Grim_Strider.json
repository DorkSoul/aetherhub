    "name": "ruling: draw then discard, toughness dips to 0 mid-resolution but the creature survives",
    "players": [
      { "hand": ["Faithless Looting", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Grim Strider", "Mountain"] },
