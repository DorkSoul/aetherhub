  {
    "name": "ruling: combat damage stays marked, so a later draw makes it lethal",
    "players": [
      { "hand": ["Harmonize", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Grim Strider", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grim Strider", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Grim Strider" }] },
      { "advance_to": "Main2" },
      { "cast": "Harmonize" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grim Strider", "Harmonize"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: without a later draw the combat damage does not kill it",
    "players": [
      { "hand": ["Harmonize", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Grim Strider", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grim Strider", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Grim Strider" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "hand_count": 3, "battlefield_has": ["Grim Strider"] },
        { "graveyard": ["Grizzly Bears"] }
      ],
