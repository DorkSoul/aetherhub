[
  {
    "name": "next noncreature spell costs {1} less per artifact (castable with one Island)",
    "players": [
      { "hand": ["Divination"],
        "battlefield": ["Don & Raph, Hard Science", "Blood Clock", "Blood Clock", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Don & Raph, Hard Science", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Divination"] }, {} ] }
  },
  {
    "name": "only the first noncreature spell is reduced (the second would need {2}{U} but only two lands are left)",
    "players": [
      { "hand": ["Divination", "Divination"],
        "battlefield": ["Don & Raph, Hard Science", "Blood Clock", "Blood Clock", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Don & Raph, Hard Science", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Divination", "illegal": true }
    ],
    "expect": { "players": [ { "graveyard": ["Divination"] }, {} ] }
  },
  {
    "name": "a creature spell is not the next noncreature spell and does not use it up",
    "players": [
      { "hand": ["Grizzly Bears", "Divination"],
        "battlefield": ["Don & Raph, Hard Science", "Blood Clock", "Blood Clock", "Forest", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Don & Raph, Hard Science", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Divination"], "battlefield_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "ruling: cost increases apply before the affinity reduction (Sphere of Resistance: 3 artifacts, one Island suffices)",
    "players": [
      { "hand": ["Divination"],
        "battlefield": ["Don & Raph, Hard Science", "Sphere of Resistance", "Blood Clock", "Blood Clock", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Don & Raph, Hard Science", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Divination"] }, {} ] }
  },
  {
    "name": "no artifacts, no reduction: Divination is not castable with one Island",
    "players": [
      { "hand": ["Divination"],
        "battlefield": ["Don & Raph, Hard Science", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Don & Raph, Hard Science", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand": ["Divination"] }, {} ] }
  }
]
