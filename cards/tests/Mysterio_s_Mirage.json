[
  {
    "name": "if you discarded a card this turn, create a 3/3 Illusion Villain at your end step",
    "players": [
      { "hand": ["Wild Guess", "Grizzly Bears"], "battlefield": ["Mysterio's Mirage", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Wild Guess" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mysterio's Mirage", "Illusion Villain"] }, {} ],
      "pt": { "Illusion Villain": [3, 3] }
    }
  },
  {
    "name": "no discard this turn: no token at the end step",
    "players": [
      { "battlefield": ["Mysterio's Mirage", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mysterio's Mirage"], "battlefield_lacks": ["Illusion Villain"] }, {} ]
    }
  },
  {
    "name": "opponent's end step clears a discard counter from their turn: no token at my end step",
    "players": [
      { "hand": ["Grizzly Bears", "Savannah Lions"], "battlefield": ["Mysterio's Mirage"] },
      { "hand": ["Mind Rot"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "pass": true },
      { "resolve": true, "player": 1 },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears", "Savannah Lions"], "battlefield_lacks": ["Illusion Villain"] }, {} ]
    }
  }
]
