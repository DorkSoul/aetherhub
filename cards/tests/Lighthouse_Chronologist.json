    "steps": [
      { "advance_to": "End" }, { "advance_to": "Main1" }, { "advance_to": "End" }, { "resolve": true },
      { "advance_to": "Main1" }, { "advance_to": "End" }, { "advance_to": "Main1" }, { "advance_to": "End" },
