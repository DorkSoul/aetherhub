[
  { "name": "level 3 is still 1/3",
    "players": [ { "battlefield": ["Island", "Island", "Island", { "name": "Lighthouse Chronologist", "sick": false }] }, {} ],
    "steps": [
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true },
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true },
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true }
    ],
    "expect": { "pt": { "Lighthouse Chronologist": [1, 3] }, "counters": { "Lighthouse Chronologist": { "level": 3 } } } },
  { "name": "level 4 becomes 2/4",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", { "name": "Lighthouse Chronologist", "sick": false }] }, {} ],
    "steps": [
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true },
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true },
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true },
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true }
    ],
    "expect": { "pt": { "Lighthouse Chronologist": [2, 4] }, "counters": { "Lighthouse Chronologist": { "level": 4 } } } },
  { "name": "level up is sorcery speed only",
    "players": [ { "battlefield": ["Island", { "name": "Lighthouse Chronologist", "sick": false }] }, {} ],
    "steps": [ { "advance_to": "End" }, { "activate": "Lighthouse Chronologist", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Lighthouse Chronologist"] }, {} ] } },
  { "name": "level 7 at the opponent's end step: you take an extra turn",
    "players": [ { "battlefield": [ { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 7 } } ] }, {} ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "End" }, { "resolve": true },
      { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" }
    ],
    "expect": { "turn": 4, "players": [ { "library_count": 18 }, {} ] } },
  { "name": "level 6 at the opponent's end step: no extra turn",
    "players": [ { "battlefield": [ { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 6 } } ] }, {} ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "End" },
      { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" }
    ],
    "expect": { "turn": 4, "players": [ { "library_count": 19 }, {} ] } },
  { "name": "level 7 is a 3/5",
    "players": [ { "battlefield": [ { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 7 } } ] }, {} ],
    "steps": [],
    "expect": { "pt": { "Lighthouse Chronologist": [3, 5] } } },
  { "name": "ruling: level counters placed without any level up activation still give level 4 (2/4)",
    "players": [ { "battlefield": [ { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 4 } } ] }, {} ],
    "steps": [],
    "expect": { "pt": { "Lighthouse Chronologist": [2, 4] }, "counters": { "Lighthouse Chronologist": { "level": 4 } } } },
  { "name": "ruling: two level 7 Chronologists (one each side) cancel out: the turns alternate",
    "players": [ { "battlefield": [ { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 7 } } ] },
                 { "battlefield": [ { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 7 } } ] } ],
    "steps": [
      { "advance_to": "End" }, { "resolve": true }, { "advance_to": "Main1" },
      { "advance_to": "End" }, { "resolve": true }, { "advance_to": "Main1" },
      { "advance_to": "End" }, { "resolve": true }, { "advance_to": "Main1" }
    ],
    "expect": { "turn": 4, "players": [ { "library_count": 19 }, { "library_count": 18 } ] } },
  { "name": "ruling: two level 7 Chronologists on your side give three of your turns after one opponent turn",
    "players": [ { "battlefield": [ { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 7 } },
                                    { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 7 } } ] }, {} ],
    "steps": [
      { "advance_to": "End" }, { "advance_to": "Main1" }, { "advance_to": "End" }, { "resolve": true },
      { "advance_to": "Main1" }, { "advance_to": "End" }, { "advance_to": "Main1" }, { "advance_to": "End" },
