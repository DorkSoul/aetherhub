    ],
    "expect": { "turn": 6, "players": [ { "library_count": 17 }, { "library_count": 18 } ] } },
  { "name": "ruling: a pump applied before the level up still applies after it (Giant Growth then level 4: 2/4 +3/+3 = 5/7)",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Island", "Forest", { "name": "Lighthouse Chronologist", "sick": false, "counters": { "level": 3 } }] }, {} ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Lighthouse Chronologist"] }, { "resolve": true },
      { "activate": "Lighthouse Chronologist", "ability": 0 }, { "resolve": true }
    ],
    "expect": { "pt": { "Lighthouse Chronologist": [5, 7] } } }
]
