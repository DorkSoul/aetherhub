[
  { "name": "casting an artifact (historic) deals 3 damage to any target",
    "players": [ { "hand": ["Sol Ring"], "battlefield": ["Mountain", { "name": "Surtr, Fiery Jötun", "sick": false }] }, {} ],
    "steps": [ { "cast": "Sol Ring", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "casting a non-historic spell does not trigger",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Surtr, Fiery Jötun"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "life": 20 } ] } },
  { "name": "ruling: a historic card put onto the battlefield without being cast does not trigger",
    "players": [ { "hand": ["Ghostly Flicker"], "battlefield": ["Island", "Island", "Island", "Sol Ring", "Surtr, Fiery Jötun"] }, {} ],
    "steps": [ { "cast": "Ghostly Flicker", "targets": ["Sol Ring", "Island"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sol Ring", "Surtr, Fiery Jötun"] }, { "life": 20 } ] } },
  { "name": "ruling: the historic trigger resolves before its spell, and even if that spell is countered",
    "players": [ { "hand": ["Sol Ring"], "battlefield": ["Mountain", "Surtr, Fiery Jötun"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Sol Ring", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Sol Ring" }] }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Sol Ring"] }, { "life": 17, "graveyard": ["Counterspell"] } ] } }
]
