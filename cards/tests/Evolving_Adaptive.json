[
  {
    "name": "enters with an oil counter and is 1/1",
    "players": [
      { "hand": ["Evolving Adaptive"], "battlefield": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Evolving Adaptive" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Evolving Adaptive"] }, {} ],
      "pt": { "Evolving Adaptive": [1, 1] }
    }
  },
  {
    "name": "another creature with greater power enters: puts an oil counter on it",
    "players": [
      { "hand": ["Evolving Adaptive", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Evolving Adaptive" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Evolving Adaptive", "Grizzly Bears"] }, {} ],
      "pt": { "Evolving Adaptive": [2, 2] }
    }
  },
  {
    "name": "another creature with equal power and toughness entering does not trigger it",
    "players": [
      { "hand": ["Evolving Adaptive", "Llanowar Elves"], "battlefield": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Evolving Adaptive" },
      { "resolve": true },
      { "cast": "Llanowar Elves" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Evolving Adaptive", "Llanowar Elves"] }, {} ],
      "pt": { "Evolving Adaptive": [1, 1] }
    }
  },
  {
    "name": "ruling: a creature with greater toughness but equal power still puts an oil counter on Evolving Adaptive",
    "players": [
      { "hand": ["Evolving Adaptive", "Tower Worker"], "battlefield": ["Forest", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Evolving Adaptive" },
      { "resolve": true },
      { "cast": "Tower Worker" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Evolving Adaptive", "Tower Worker"] }, {} ],
      "pt": { "Evolving Adaptive": [2, 2] }
    }
  },
  {
    "name": "ruling: a creature with lower power and toughness than Evolving Adaptive does not trigger it",
    "players": [
      { "hand": ["Evolving Adaptive", "Grizzly Bears", "Llanowar Elves"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Evolving Adaptive" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
