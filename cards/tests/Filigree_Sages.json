[
  {
    "name": "untaps a tapped artifact",
    "players": [
      {
        "battlefield": [
          "Filigree Sages",
          {
            "name": "Sol Ring",
            "tapped": true
          },
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Filigree Sages",
        "targets": [
          "Sol Ring"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Sol Ring": false
      }
    }
  },
  {
    "name": "needs {2}{U}",
    "players": [
      {
        "battlefield": [
          "Filigree Sages",
          {
            "name": "Sol Ring",
            "tapped": true
          },
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Filigree Sages",
        "targets": [
          "Sol Ring"
        ],
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: a colored artifact is blue (it has a color on the battlefield)",
    "players": [
      { "hand": ["Filigree Sages"], "battlefield": ["Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Filigree Sages" },
      { "resolve": true }
    ],
    "expect": { "colors": { "Filigree Sages": ["U"] } }
  },
  {
    "name": "ruling: a colored artifact needs colored mana; colorless Sol Ring plus Mountains cannot cast it",
    "players": [
      { "hand": ["Filigree Sages"], "battlefield": ["Sol Ring", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Filigree Sages", "illegal": true }
    ],
    "expect": { "players": [{ "hand": ["Filigree Sages"] }, {}] }
  },
  {
    "name": "ruling: a colored artifact interacts normally with artifact removal (Containment Breach destroys it, no Pest at MV 4)",
    "players": [
      { "hand": ["Containment Breach"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Filigree Sages"] }
    ],
    "steps": [
      { "cast": "Containment Breach", "targets": ["Filigree Sages"] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_lacks": ["Pest 1-1"] }, { "graveyard_has": ["Filigree Sages"] }] }
  }
]