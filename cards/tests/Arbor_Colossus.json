[
 { "name": "monstrosity 3 puts three +1/+1 counters on it",
   "players": [ { "battlefield": ["Arbor Colossus", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "activate": "Arbor Colossus" }, { "resolve": true } ],
   "expect": { "counters": { "Arbor Colossus": { "p1p1": 3 } }, "pt": { "Arbor Colossus": [9, 9] } } },
 { "name": "becoming monstrous destroys a flyer an opponent controls",
   "players": [ { "battlefield": ["Arbor Colossus", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
                { "battlefield": ["Wind Drake", "Grizzly Bears"] } ],
   "steps": [ { "activate": "Arbor Colossus" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { }, { "graveyard": ["Wind Drake"], "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "monstrosity is once only: second activation does nothing",
   "players": [ { "battlefield": ["Arbor Colossus", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "activate": "Arbor Colossus" }, { "resolve": true }, { "resolve": true },
              { "activate": "Arbor Colossus" }, { "resolve": true } ],
   "expect": { "counters": { "Arbor Colossus": { "p1p1": 3 } } } },
 { "name": "ruling: monstrosity resolving after Colossus left the battlefield puts no counters and triggers nothing",
   "players": [ { "hand": [], "battlefield": ["Arbor Colossus", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
                { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Wind Drake", "Mountain", "Mountain"] } ],
   "steps": [ { "activate": "Arbor Colossus" },
              { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Arbor Colossus"] },
              { "pass": true, "player": 1 },
              { "pass": true },
              { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Arbor Colossus"] },
              { "pass": true, "player": 1 },
              { "pass": true },
              { "pass": true },
              { "pass": true, "player": 1 } ],
   "expect": { "players": [ { "graveyard": ["Arbor Colossus"] },
                            { "graveyard": ["Lightning Bolt", "Lightning Bolt"], "battlefield_has": ["Wind Drake"] } ] } },
 { "name": "ruling: a second monstrosity does nothing, so it triggers no second destroy",
   "players": [ { "battlefield": ["Arbor Colossus", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
                { "battlefield": ["Wind Drake", "Wind Drake"] } ],
   "steps": [ { "activate": "Arbor Colossus" }, { "resolve": true, "targets": ["Wind Drake"] }, { "resolve": true },
              { "activate": "Arbor Colossus" }, { "resolve": true } ],
   "expect": { "players": [ { }, { "graveyard": ["Wind Drake"], "battlefield_has": ["Wind Drake"] } ] } }
]
