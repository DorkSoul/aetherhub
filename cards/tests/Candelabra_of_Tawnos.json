[
  {
    "name": "X = 2 untaps exactly the two tapped lands chosen as targets",
    "players": [
      {
        "battlefield": [
          "Candelabra of Tawnos",
          {
            "name": "Forest",
            "tapped": true
          },
          {
            "name": "Mountain",
            "tapped": true
          },
          "Plains",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Candelabra of Tawnos",
        "ability": 0,
        "answers": [
          2
        ],
        "targets": [
          "Forest",
          "Mountain"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Candelabra of Tawnos",
            "Forest",
            "Mountain",
            "Plains",
            "Island"
          ]
        },
        {}
      ],
      "tapped": {
        "Forest": false,
        "Mountain": false,
        "Candelabra of Tawnos": true
      }
    }
  },
  {
    "name": "X = 1 untaps exactly one tapped land",
    "players": [
      {
        "battlefield": [
          "Candelabra of Tawnos",
          {
            "name": "Forest",
            "tapped": true
          },
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Candelabra of Tawnos",
        "ability": 0,
        "answers": [
          1
        ],
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Candelabra of Tawnos",
            "Forest",
            "Plains"
          ]
        },
        {}
      ],
      "tapped": {
        "Forest": false,
        "Candelabra of Tawnos": true
      }
    }
  },
  {
    "name": "ruling: can be activated targeting an untapped land (it stays untapped)",
    "players": [
      { "battlefield": ["Candelabra of Tawnos", "Island", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Candelabra of Tawnos", "ability": 0, "answers": [1], "targets": ["Plains"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Candelabra of Tawnos", "Island", "Plains"] },
        {}
      ],
      "tapped": { "Candelabra of Tawnos": true, "Plains": false }
    }
  },
  {
    "name": "ruling: may untap an opponent's tapped land",
    "players": [
      { "battlefield": ["Candelabra of Tawnos", "Island"] },
      { "battlefield": [{ "name": "Forest", "tapped": true }] }
    ],
    "steps": [
      { "activate": "Candelabra of Tawnos", "ability": 0, "answers": [1], "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "tapped": { "Forest": false, "Candelabra of Tawnos": true }
    }
  }
]