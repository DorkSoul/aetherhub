[
  {
    "name": "exiles a card from a graveyard",
    "players": [
      {
        "hand": [
          "Purify the Grave"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "graveyard": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Purify the Grave",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Purify the Grave"
          ]
        },
        {
          "exile": [
            "Grizzly Bears"
          ],
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "flashback {W} from the graveyard exiles the card after it resolves",
    "players": [
      {
        "graveyard": [
          "Purify the Grave"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "graveyard": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Purify the Grave",
        "alt": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [],
          "exile": [
            "Purify the Grave"
          ]
        },
        {
          "exile": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a flashback spell that is countered is still exiled",
    "players": [
      { "graveyard": ["Purify the Grave"], "battlefield": ["Plains"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"], "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Purify the Grave", "alt": 0, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Purify the Grave" }] },
      { "pass": true, "player": 1 },
      { "pass": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Purify the Grave"], "graveyard": [] },
        { "graveyard": ["Grizzly Bears", "Counterspell"], "exile": [] }
      ]
    }
  }
]
