[
 {
  "name": "beginning of combat gives another creature melee for the turn",
  "players": [
   { "battlefield": [ { "name": "Fang of the Pack", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [3, 3], "Fang of the Pack": [5, 3] }
  }
 },
 {
  "name": "granted melee does nothing if the creature does not attack",
  "players": [
   { "battlefield": [ { "name": "Fang of the Pack", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [2, 2] }
  }
 },
 {
  "name": "melee: attacking gets +1/+1 for each opponent attacked (one here)",
  "players": [ { "battlefield": [ { "name": "Fang of the Pack", "sick": false } ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Fang of the Pack", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "life": 14 } ],
   "pt": { "Fang of the Pack": [6, 4] }
  }
 },
 {
  "name": "melee does nothing when Fang of the Pack does not attack",
  "players": [ { "battlefield": [ { "name": "Fang of the Pack", "sick": false } ] }, {} ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "life": 20 } ],
   "pt": { "Fang of the Pack": [5, 3] }
  }
 },
 {
  "name": "ruling: melee counts opponents attacked, not attacking creatures: two attackers on one opponent give +1/+1 once",
  "players": [
   { "battlefield": [ { "name": "Fang of the Pack", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "resolve": true },
   { "attack": [ { "card": "Fang of the Pack", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "life": 11 } ],
   "pt": { "Fang of the Pack": [6, 4], "Grizzly Bears": [3, 3] }
  }
 }
]
