[
  { "name": "combat damage to a player puts a +1/+1 counter on it",
    "players": [ { "battlefield": ["Slith Ascendant"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Slith Ascendant", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 19 } ], "pt": { "Slith Ascendant": [2, 2] }, "counters": { "Slith Ascendant": { "p1p1": 1 } } } },
  { "name": "no counter without combat damage",
    "players": [ { "battlefield": ["Slith Ascendant"] }, {} ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Slith Ascendant": [1, 1] } } }
]
