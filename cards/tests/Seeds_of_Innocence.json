[
  {
    "name": "destroys every artifact and each controller gains its mana value",
    "players": [
      { "hand": ["Seeds of Innocence"], "battlefield": ["Forest", "Forest", "Forest", "Sol Ring"] },
      { "battlefield": ["Mind Stone", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Seeds of Innocence" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "graveyard": ["Seeds of Innocence", "Sol Ring"], "battlefield_lacks": ["Sol Ring"] },
        { "life": 22, "graveyard": ["Mind Stone"], "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Mind Stone"] }
      ]
    }
  },
  {
    "name": "an artifact with mana value 0 gains no life and creatures survive",
    "players": [
      { "hand": ["Seeds of Innocence"], "battlefield": ["Forest", "Forest", "Forest", "Ornithopter", "Grizzly Bears"] },
      { "battlefield": ["Plains"] }
    ],
    "steps": [
      { "cast": "Seeds of Innocence" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard": ["Seeds of Innocence", "Ornithopter"], "battlefield_has": ["Grizzly Bears"] },
        { "life": 20, "battlefield_has": ["Plains"] }
      ]
    }
  },
  {
    "name": "the controller of a stolen artifact gains its mana value, not the owner",
    "players": [
      { "hand": ["Control Magic", "Seeds of Innocence"], "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Pewter Golem"] }
    ],
    "steps": [
      { "cast": "Control Magic", "targets": ["Pewter Golem"] },
      { "resolve": true },
      { "cast": "Seeds of Innocence" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 25, "battlefield_lacks": ["Pewter Golem"] },
        { "life": 20, "graveyard": ["Pewter Golem"] }
      ]
    }
  }
]
