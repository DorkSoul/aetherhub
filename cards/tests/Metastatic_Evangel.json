[
  {
    "name": "a nontoken creature entering proliferates",
    "players": [
      {
        "hand": [
          "Elite Vanguard"
        ],
        "battlefield": [
          {
            "name": "Grizzly Bears",
            "counters": {
              "p1p1": 1
            }
          },
          "Plains",
          "Metastatic Evangel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Elite Vanguard"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {
          "p1p1": 2
        }
      },
      "players": [
        {
          "battlefield_has": [
            "Elite Vanguard"
          ]
        }
      ]
    }
  },
  {
    "name": "tokens entering do not trigger it",
    "players": [
      {
        "hand": [
          "Raise the Alarm"
        ],
        "battlefield": [
          {
            "name": "Grizzly Bears",
            "counters": {
              "p1p1": 1
            }
          },
          "Plains",
          "Plains",
          "Metastatic Evangel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Raise the Alarm"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {
          "p1p1": 1
        }
      },
      "players": [
        {
          "battlefield_has": [
            "Soldier"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: proliferate may choose only some of the permanents",
    "players": [
      { "hand": ["Elite Vanguard"], "battlefield": [ {"name": "Grizzly Bears", "counters": {"p1p1": 1}}, {"name": "Hill Giant", "counters": {"p1p1": 1}}, "Plains", "Metastatic Evangel" ] },
      {}
    ],
    "steps": [
      { "cast": "Elite Vanguard" },
      { "resolve": true, "answers": [["Grizzly Bears"]] }
    ],
    "expect": {
      "counters": { "Grizzly Bears": {"p1p1": 2}, "Hill Giant": {"p1p1": 1} }
    }
  },
  {
    "name": "ruling: choosing no permanents and no players adds no counters",
    "players": [
      { "hand": ["Elite Vanguard"], "battlefield": [ {"name": "Grizzly Bears", "counters": {"p1p1": 1}}, {"name": "Hill Giant", "counters": {"p1p1": 1}}, "Plains", "Metastatic Evangel" ] },
      {}
    ],
    "steps": [
      { "cast": "Elite Vanguard" },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "counters": { "Grizzly Bears": {"p1p1": 1}, "Hill Giant": {"p1p1": 1} }
    }
  },
  {
    "name": "ruling: a player with two kinds of counters gets one of each",
    "players": [
      { "hand": ["Elite Vanguard"], "battlefield": ["Plains", "Metastatic Evangel"] },
      { "poison": 2, "energy": 1 }
    ],
    "steps": [
      { "cast": "Elite Vanguard" },
      { "resolve": true, "answers": [["p1"]] }
    ],
    "expect": {
      "players": [ {}, { "poison": 3, "energy": 2 } ]
    }
  },
  {
    "name": "ruling: proliferate can choose an opponent's permanent and player",
    "players": [
      { "hand": ["Elite Vanguard"], "battlefield": ["Plains", "Metastatic Evangel"] },
      { "battlefield": [ {"name": "Grizzly Bears", "counters": {"p1p1": 1}} ], "poison": 2 }
    ],
    "steps": [
      { "cast": "Elite Vanguard" },
      { "resolve": true, "answers": [["Grizzly Bears", "p1"]] }
    ],
    "expect": {
      "counters": { "Grizzly Bears": {"p1p1": 2} },
      "players": [ {}, { "poison": 3 } ]
    }
  }
]
