[
  {
    "name": "ruling: kindred counts as a card type for delirium",
    "players": [
      { "battlefield": ["Inexorable Blob"], "graveyard": ["Lightning Bolt", "Grizzly Bears", "Divination", "Hunting Triad"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Inexorable Blob", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "pt": { "Ooze 3-3 Green": [3, 3] },
      "players": [ { "battlefield_has": ["Inexorable Blob", "Ooze 3-3 Green"] }, { "life": 14 } ]
    }
  },
  {
    "name": "ruling: card types are counted, not cards",
    "players": [
      { "battlefield": ["Inexorable Blob"], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Grizzly Bears", "Divination"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Inexorable Blob", "at": "p1" } ] },
      { "advance_to": "End" }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "creates a tapped attacking 3/3 Ooze when delirious",
