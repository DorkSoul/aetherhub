[
  {
    "name": "pay and sacrifice at end step puts the first nonland permanent off the top onto the battlefield",
    "players": [
      {
        "battlefield": [
          "Dreamshaper Shaman",
          "Mountain",
          "Mountain",
          "Mountain",
          "Grizzly Bears"
        ],
        "library": [
          "Forest",
          "Llanowar Elves"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End",
        "answers": [
          true,
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Llanowar Elves",
            "Dreamshaper Shaman"
          ],
          "battlefield_lacks": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "declining the payment changes nothing",
    "players": [
      {
        "battlefield": [
          "Dreamshaper Shaman",
          "Mountain",
          "Mountain",
          "Mountain",
          "Grizzly Bears"
        ],
        "library": [
          "Llanowar Elves"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End",
        "answers": [
          false
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears",
            "Dreamshaper Shaman"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: no nonland card in library: nothing is put onto the battlefield and the library is kept",
    "players": [
      { "battlefield": ["Dreamshaper Shaman", "Mountain", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [true, "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dreamshaper Shaman"], "battlefield_lacks": ["Grizzly Bears"], "library_top": ["Forest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: with only two mana the cost can't be paid, so no sacrifice and no reveal",
    "players": [
      { "battlefield": ["Dreamshaper Shaman", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dreamshaper Shaman", "Grizzly Bears"], "library_top": ["Llanowar Elves"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Dreamshaper Shaman can be sacrificed to pay for its own trigger",
    "players": [
      { "battlefield": ["Dreamshaper Shaman", "Mountain", "Mountain", "Mountain"], "library": ["Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Llanowar Elves"], "battlefield_lacks": ["Dreamshaper Shaman"], "graveyard": ["Dreamshaper Shaman"] },
        {}
      ]
    }
  }
]
