    "attached": {"Bronzeplate Boar": "Ogre Geargrabber"}
  }},
 {"name": "losing control of the Equipment at end of turn returns it and unattaches it",
  "players": [
    {"battlefield": [{"name": "Ogre Geargrabber", "sick": false}]},
    {"battlefield": [{"name": "Bonesplitter", "sick": false}]}
  ],
  "steps": [
    {"attack": [{"card": "Ogre Geargrabber", "at": "p1"}]},
    {"block": []},
    {"advance_to": "Upkeep", "auto": true}
  ],
  "expect": {
    "players": [
      {"battlefield_lacks": ["Bonesplitter"]},
      {"battlefield_has": ["Bonesplitter"]}
    ],
    "attached": {}
  }},
 {"name": "no opposing Equipment: the attack trigger does nothing",
  "players": [
    {"battlefield": [{"name": "Ogre Geargrabber", "sick": false}, {"name": "Bronzeplate Boar", "sick": false}]},
    {}
  ],
  "steps": [
    {"attack": [{"card": "Ogre Geargrabber", "at": "p1"}]},
    {"block": []},
    {"advance_to": "Main2"}
  ],
  "expect": {
    "players": [
      {"battlefield_has": ["Ogre Geargrabber", "Bronzeplate Boar"]},
      {}
    ],
    "attached": {}
  }},
 {"name": "ruling: Equipment that is attached during the attack declaration does not trigger its own 'whenever equipped creature attacks' ability",
  "players": [
    {"battlefield": [{"name": "Ogre Geargrabber", "sick": false}]},
    {"battlefield": ["Bone Sabres"]}
  ],
  "steps": [
    {"attack": [{"card": "Ogre Geargrabber", "at": "p1"}]},
    {"block": []},
    {"advance_to": "Main2"}
  ],
  "expect": {
    "players": [
      {"battlefield_has": ["Ogre Geargrabber", "Bone Sabres"], "life": 20},
      {"battlefield_lacks": ["Bone Sabres"], "life": 16}
    ],
    "attached": {"Bone Sabres": "Ogre Geargrabber"},
    "pt": {"Ogre Geargrabber": [4, 4]}
  }}
]
