[
 {"name": "attack: gain control of an opposing Equipment and attach it to this creature",
  "players": [
    {"battlefield": [{"name": "Ogre Geargrabber", "sick": false}]},
    {"battlefield": [{"name": "Bronzeplate Boar", "sick": false}]}
  ],
