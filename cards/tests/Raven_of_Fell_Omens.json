[
  {
    "name": "targeting an opponent's creature commits a crime: drain 1",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Raven of Fell Omens"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21 },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "a crime only triggers once each turn",
    "players": [
      { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain", "Raven of Fell Omens"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "targeting only your own permanent is not a crime",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Raven of Fell Omens", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: the crime is committed on casting, so the drain happens even though the Shock fizzles",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Raven of Fell Omens"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "graveyard": ["Shock"] },
        { "life": 19, "graveyard": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: a spell with several opponent targets commits only one crime",
    "players": [
      { "hand": ["Water Whip"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Raven of Fell Omens"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Water Whip", "targets": ["Grizzly Bears", "Hill Giant"], "answers": [0] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21 },
        { "life": 19 }
      ]
    }
  }
]
