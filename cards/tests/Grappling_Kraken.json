[
 { "name": "landfall taps target opponent creature and puts a stun counter on it",
   "players": [ { "hand": ["Forest"], "battlefield": ["Grappling Kraken"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "play_land": "Forest" }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 1 } } } },
 { "name": "no landfall trigger when an opponent has no creature",
   "players": [ { "hand": ["Forest"], "battlefield": ["Grappling Kraken"] }, {} ],
   "steps": [ { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": ["Forest", "Grappling Kraken"] }, {} ] } },
 { "name": "ruling: lands Elemental Teachings puts onto the battlefield each trigger landfall (two stun counters)",
   "players": [ { "hand": ["Elemental Teachings"], "battlefield": ["Grappling Kraken", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Island", "Plains", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Elemental Teachings" }, { "resolve": true, "answers": [["Forest", "Island", "Plains", "Swamp"], ["Forest", "Island"]] } ],
   "expect": { "players": [ { "battlefield_has": ["Plains", "Swamp"], "battlefield_lacks": ["Island"] }, {} ], "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 2 } } } },
 { "name": "ruling: a tapped creature can still be targeted and gets the stun counter",
   "players": [ { "hand": ["Forest"], "battlefield": ["Grappling Kraken"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "play_land": "Forest" }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 1 } } } },
 { "name": "ruling: Hydro-Man becoming a land at end step does not trigger landfall",
   "players": [ { "battlefield": ["Grappling Kraken", "Hydro-Man, Fluid Felon"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "advance_to": "End" }, { "resolve": true }, { "tap_for_mana": "Hydro-Man, Fluid Felon", "color": "U" } ],
   "expect": { "players": [ { "pool": { "U": 1 } }, {} ], "tapped": { "Grizzly Bears": false } } }
]
