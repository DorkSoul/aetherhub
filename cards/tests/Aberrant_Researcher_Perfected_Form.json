[
  {
    "name": "upkeep mill of an instant transforms it into Perfected Form",
    "players": [
      { "battlefield": ["Aberrant Researcher // Perfected Form"], "library": ["Lightning Bolt", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"], "library_count": 1 },
        {}
      ],
      "pt": { "Perfected Form": [5, 4] }
    }
  },
  {
    "name": "upkeep mill of a non-instant/sorcery does not transform",
    "players": [
      { "battlefield": ["Aberrant Researcher // Perfected Form"], "library": ["Forest", "Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Forest"], "library_count": 1 },
        {}
      ],
      "pt": { "Aberrant Researcher // Perfected Form": [3, 2] }
    }
  },
  {
    "name": "ruling: a milled sorcery also transforms it",
    "players": [
      { "battlefield": ["Aberrant Researcher // Perfected Form"], "library": ["Rooftop Nuisance", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Rooftop Nuisance"], "library_count": 1 },
        {}
      ],
      "pt": { "Perfected Form": [5, 4] }
    }
  }
]
