[
  {
    "name": "opponent's black spell during my turn adds a counter",
    "players": [
      { "battlefield": ["Forest", "Forest", "Witchstalker"] },
      { "hand": ["Dark Ritual"], "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Dark Ritual", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Witchstalker": { "p1p1": 1 } }
    }
  },
  {
    "name": "opponent's red spell does not add a counter",
    "players": [
      { "battlefield": ["Forest", "Forest", "Witchstalker"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Witchstalker": [3, 3] },
      "players": [{ "life": 17 }, {}]
    }
  },
  {
    "name": "ruling: a copy put directly on the stack (Twincast) of an opponent's black spell does not trigger Witchstalker",
    "players": [
      { "battlefield": ["Forest", "Forest", "Witchstalker"] },
      { "hand": ["Dark Ritual", "Twincast"], "battlefield": ["Swamp", "Island", "Island"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Dark Ritual", "player": 1 },
      { "cast": "Twincast", "player": 1, "targets": [{ "stack": "Dark Ritual" }] },
      { "pass": true, "player": 1 },
      { "pass": true, "player": 0 },
      { "pass": true, "player": 1 },
      { "pass": true, "player": 0 },
      { "pass": true, "player": 1 },
      { "pass": true, "player": 0 },
      { "pass": true, "player": 1 },
      { "pass": true, "player": 0 }
    ],
    "expect": {
      "counters": { "Witchstalker": { "p1p1": 2 } }
    }
  }
]
