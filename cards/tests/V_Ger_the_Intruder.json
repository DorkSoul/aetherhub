      { "hand": ["V'Ger, the Intruder"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Exocomp"], "library": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "V'Ger, the Intruder" },
      { "resolve": true, "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Exocomp": [3, 1] },
      "players": [
        { "battlefield_has": ["V'Ger, the Intruder", "Exocomp"] },
        {}
      ]
    }
  },
  {
    "name": "enters: look at target opponent's hand, then draw a card",
    "players": [
      { "hand": ["V'Ger, the Intruder"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Forest"] },
      { "hand": ["Lightning Bolt"] }
