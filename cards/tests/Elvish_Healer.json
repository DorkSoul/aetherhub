[
  { "name": "prevents 1 damage to a player target (Bolt does 2)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Elvish Healer", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Elvish Healer", "ability": 0, "targets": ["p1"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "prevents 2 damage to a green creature (Bolt does 1, Bears survive)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Elvish Healer", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Elvish Healer", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "tapped healer cannot activate again",
    "players": [ { "battlefield": ["Elvish Healer"] }, {} ],
    "steps": [
      { "activate": "Elvish Healer", "ability": 0, "targets": ["p1"] }, { "resolve": true },
      { "activate": "Elvish Healer", "ability": 0, "targets": ["p1"], "illegal": true } ],
    "expect": { "tapped": { "Elvish Healer": true } } },
  { "name": "ruling: color is checked on resolution: Deathlace makes the Bears black in response, so only 1 is prevented and Bolt kills them",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Elvish Healer", "Mountain"] },
                 { "hand": ["Deathlace"], "battlefield": ["Swamp", "Grizzly Bears"] } ],
    "steps": [
      { "activate": "Elvish Healer", "ability": 0, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Deathlace", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Deathlace", "Grizzly Bears"] } ] } }
]
