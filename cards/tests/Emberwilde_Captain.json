  {
    "name": "ruling: attacking only your planeswalker does not trigger the monarch damage",
    "players": [
      {
        "hand": ["Emberwilde Captain"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Ajani Goldmane"]
      },
      {
        "battlefield": ["Grizzly Bears"],
        "hand": ["Lightning Bolt", "Shock"]
      }
