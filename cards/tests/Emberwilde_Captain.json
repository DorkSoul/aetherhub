      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "BeginCombat", "player": 1 },
      { "attack": [ { "card": "Grizzly Bears", "at": "Ajani Goldmane" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2", "player": 1 }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 20 }
      ]
    }
