  {
    "name": "ruling: the monarch damage triggers once per attacking player, not per attacking creature",
    "players": [
      {
        "hand": ["Emberwilde Captain"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears", "Hill Giant"],
