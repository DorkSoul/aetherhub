  {
    "name": "ruling: combat damage to the monarch makes its attacker the monarch, who draws at their end step",
    "players": [
      {
        "hand": ["Emberwilde Captain"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"],
        "hand": ["Lightning Bolt", "Shock"]
      }
    ],
    "steps": [
      { "cast": "Emberwilde Captain" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "BeginCombat", "player": 1 },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "resolve": true, "player": 1 },
      { "advance_to": "Main2", "player": 1 },
      { "advance_to": "End", "player": 1 }
    ],
    "expect": {
      "players": [
        { "life": 18, "hand_count": 1 },
        { "life": 17, "hand_count": 4 }
      ]
    }
