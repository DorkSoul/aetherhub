[
  {
    "name": "casting an instant gives +1/+1 until end of turn",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Aven Wind Mage"] }, {}],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }],
    "expect": {
      "pt": { "Aven Wind Mage": [3, 3] },
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "casting a creature spell does not pump it",
    "players": [{ "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Aven Wind Mage"] }, {}],
    "steps": [{ "cast": "Grizzly Bears" }, { "resolve": true }],
    "expect": { "pt": { "Aven Wind Mage": [2, 2] } }
  },
 {
  "name": "ruling: Aven Wind Mage's trigger resolves even if the instant is countered",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Aven Wind Mage"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Aven Wind Mage": [3, 3] },
   "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Counterspell"], "life": 20 } ]
  }
 }
]
