   {
    "hand": [
     "Flusterstorm"
    ],
    "battlefield": [
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "cast": "Flusterstorm",
    "player": 1,
    "targets": [
     {
      "stack": "Lightning Bolt"
     }
    ]
   },
