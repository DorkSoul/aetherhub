   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Mountain"
    ]
   },
   {
    "hand": [
     "Flusterstorm"
    ],
    "battlefield": [
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "cast": "Flusterstorm",
    "player": 1,
    "targets": [
     {
      "stack": "Lightning Bolt"
     }
    ]
   },
   {
    "resolve": true,
    "auto": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Lightning Bolt"
     ]
    },
    {
     "life": 20,
     "graveyard": [
      "Flusterstorm"
     ]
    }
   ],
   "stack_empty": true
  }
 },
 {
