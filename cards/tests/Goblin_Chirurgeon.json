[
  {
    "name": "sacrifice a Goblin: regenerate target creature (can sacrifice itself)",
    "players": [
      { "battlefield": ["Goblin Chirurgeon"] },
      {}
    ],
    "steps": [
      { "activate": "Goblin Chirurgeon", "ability": 0, "targets": ["Goblin Chirurgeon"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Goblin Chirurgeon"] }, {}]
    }
  },
  {
    "name": "the cost is a Goblin, so a non-Goblin creature is never sacrificed",
    "players": [
      { "battlefield": ["Goblin Chirurgeon", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Goblin Chirurgeon", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Goblin Chirurgeon"] }, {}]
    }
  },
  {
    "name": "ruling: regenerates itself by sacrificing another Goblin (regeneration shield saves it from Lightning Bolt)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Goblin Chirurgeon", "Bloodcrazed Goblin", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Goblin Chirurgeon", "ability": 0, "targets": ["Goblin Chirurgeon"], "answers": ["Bloodcrazed Goblin"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Goblin Chirurgeon"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Goblin Chirurgeon"], "graveyard_has": ["Bloodcrazed Goblin", "Lightning Bolt"] }, {}]
    }
  }
