[
  { "name": "instant paid with one mana: +1/+0",
    "players": [ { "hand": ["Shock"], "battlefield": ["Aberrant Manawurm", "Mountain"] }, {} ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Aberrant Manawurm"] }, { "life": 18 } ], "pt": { "Aberrant Manawurm": [3, 5] } } },
  { "name": "sorcery-speed instant paid with two mana: +2/+0",
    "players": [ { "hand": ["Lightning Strike"], "battlefield": ["Aberrant Manawurm", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Strike", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Aberrant Manawurm": [4, 5] } } },
  { "name": "creature spell does not pump it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Aberrant Manawurm", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Aberrant Manawurm": [2, 5] } } },
  { "name": "ruling: the pump resolves even though the instant it was cast for is countered",
    "players": [ { "hand": ["Shock"], "battlefield": ["Aberrant Manawurm", "Mountain"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "targets": [{ "stack": "Shock" }], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Shock"] }, { "life": 20, "graveyard": ["Counterspell"] } ], "pt": { "Aberrant Manawurm": [3, 5] } } }
]
