[
  { "name": "ETB returns another creature to its owner's hand",
    "players": [ { "hand": ["Matterbending Mage"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Matterbending Mage" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Matterbending Mage"] }, { "hand": ["Grizzly Bears"] } ] } },
  { "name": "ETB with no other creature on the battlefield: nothing bounced",
    "players": [ { "hand": ["Matterbending Mage"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Matterbending Mage" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Matterbending Mage"] }, {} ] } },
  { "name": "casting an X spell makes it unblockable this turn",
    "players": [ { "hand": ["Blaze"], "battlefield": ["Matterbending Mage", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Blaze", "targets": ["p1"], "answers": [2] }, { "resolve": true }, { "resolve": true },
               { "attack": [ { "card": "Matterbending Mage", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Matterbending Mage" } ], "illegal": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Matterbending Mage"] }, { "life": 16, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "a spell without {X} does not make it unblockable",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Matterbending Mage", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Matterbending Mage"] }, { "resolve": true },
               { "attack": [ { "card": "Matterbending Mage", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Matterbending Mage" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Matterbending Mage"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: the Mage's trigger still resolves when the X spell is countered",
    "players": [ { "hand": ["Blaze"], "battlefield": ["Matterbending Mage", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Blaze", "targets": ["p1"], "answers": [2] },
               { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Blaze" } ] },
               { "resolve": true }, { "resolve": true },
               { "attack": [ { "card": "Matterbending Mage", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Matterbending Mage" } ], "illegal": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Matterbending Mage"] }, { "life": 18, "battlefield_has": ["Grizzly Bears"] } ] } }
]
