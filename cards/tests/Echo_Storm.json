 {
  "name": "ruling: a countered commander still counts as cast, so the Storm copies once more",
  "commander": true,
  "players": [
   { "hand": ["Echo Storm"], "command": ["Savannah Lions"], "battlefield": ["Plains", "Island", "Island", "Island", "Island", "Island"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Sol Ring"] }
  ],
  "steps": [
   { "cast": "Savannah Lions" },
   { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Savannah Lions" } ] },
   { "resolve": true },
   { "cast": "Echo Storm", "targets": ["Sol Ring"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Echo Storm"], "battlefield_has": ["Sol Ring", "Sol Ring"] },
    { "graveyard_has": ["Counterspell"], "battlefield_has": ["Sol Ring"] }
   ]
  }
 },
 {
  "name": "ruling: each commander cast from the command zone adds a copy (two commanders cast once: three tokens)",
  "commander": true,
  "players": [
   { "hand": ["Echo Storm"], "command": ["Savannah Lions", "Grizzly Bears"], "battlefield": ["Plains", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "cast": "Savannah Lions" },
   { "resolve": true },
   { "cast": "Grizzly Bears" },
   { "resolve": true },
   { "cast": "Echo Storm", "targets": ["Sol Ring"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Echo Storm"], "battlefield_has": ["Sol Ring", "Sol Ring", "Sol Ring"] },
    { "battlefield_has": ["Sol Ring"] }
   ]
  }
 }
