[
  {
    "name": "gets +2/+0 when another creature entered this turn",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Bristlebane Outrider", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Bristlebane Outrider": [5, 5], "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "no bonus when only itself entered this turn",
    "players": [
      { "hand": ["Bristlebane Outrider"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Bristlebane Outrider" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Bristlebane Outrider": [3, 5] }
    }
  },
  {
    "name": "can't be blocked by a creature with power 2 or less",
    "players": [
      { "battlefield": [{ "name": "Bristlebane Outrider", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Bristlebane Outrider", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Bristlebane Outrider" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {}
  },
  {
    "name": "a power-2 creature cannot block it: the attack is unblocked for 3",
    "players": [
      { "battlefield": [{ "name": "Bristlebane Outrider", "sick": false }] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Bristlebane Outrider", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Bristlebane Outrider" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Bristlebane Outrider"] }, { "life": 17, "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ] }
  },
  {
    "name": "ruling: a blocked Outrider stays blocked when the blocker's power is reduced after blocking",
    "players": [
      { "hand": ["Hezrou // Demonic Stench"], "battlefield": [{ "name": "Bristlebane Outrider", "sick": false }, "Swamp"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Bristlebane Outrider", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Bristlebane Outrider" } ] },
      { "cast": "Hezrou // Demonic Stench", "face": true },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bristlebane Outrider"] },
        { "life": 20, "battlefield_lacks": ["Hill Giant"] }
      ]
    }
  }
]
