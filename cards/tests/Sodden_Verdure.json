[
 { "name": "enters untapped with two basic lands",
   "players": [ { "hand": ["Sodden Verdure"], "battlefield": ["Forest", "Island"] }, {} ],
   "steps": [ { "play_land": "Sodden Verdure" } ],
   "expect": { "tapped": { "Sodden Verdure": false } } },
 { "name": "enters tapped with only one basic land",
   "players": [ { "hand": ["Sodden Verdure"], "battlefield": ["Forest"] }, {} ],
   "steps": [ { "play_land": "Sodden Verdure" } ],
   "expect": { "tapped": { "Sodden Verdure": true } } },
 { "name": "nonbasic lands and opponent's basics do not count",
   "players": [ { "hand": ["Sodden Verdure"], "battlefield": ["Forest", "Command Tower"] }, { "battlefield": ["Island", "Island"] } ],
   "steps": [ { "play_land": "Sodden Verdure" } ],
   "expect": { "tapped": { "Sodden Verdure": true } } },
 { "name": "taps for blue (it is a Forest Island)",
   "players": [ { "battlefield": ["Sodden Verdure"], "hand": ["Augury Owl"] }, {} ],
   "steps": [ { "tap_for_mana": "Sodden Verdure", "color": "U" } ],
   "expect": { "players": [ { "pool": { "U": 1 } } ] } },
 { "name": "ruling: Tend the Sprigs cannot find Sodden Verdure, which is not a basic land",
   "players": [ { "hand": ["Tend the Sprigs"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Sodden Verdure"] }, {} ],
   "steps": [ { "cast": "Tend the Sprigs" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Sodden Verdure"], "graveyard": ["Tend the Sprigs"] }, {} ] } },
 { "name": "ruling: Sodden Verdure has the Island type, so Kishla Village enters untapped",
   "players": [ { "hand": ["Kishla Village"], "battlefield": ["Sodden Verdure"] }, {} ],
   "steps": [ { "play_land": "Kishla Village" } ],
   "expect": { "tapped": { "Kishla Village": false } } },
 { "name": "ruling: without an Island or Swamp, Kishla Village enters tapped",
   "players": [ { "hand": ["Kishla Village"], "battlefield": ["Forest"] }, {} ],
   "steps": [ { "play_land": "Kishla Village" } ],
   "expect": { "tapped": { "Kishla Village": true } } }
]
