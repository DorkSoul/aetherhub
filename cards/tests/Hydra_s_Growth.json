[
  {
    "name": "ETB puts a +1/+1 counter on the enchanted creature",
    "players": [
      { "hand": ["Hydra's Growth"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Hydra's Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] },
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "players": [
        { "battlefield_has": ["Hydra's Growth", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "upkeep doubles the +1/+1 counters, each of your upkeeps",
    "players": [
      { "hand": ["Hydra's Growth"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Hydra's Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "counters": { "Grizzly Bears": { "p1p1": 2 } }
    }
  },
  {
    "name": "two of your upkeeps: 1 -> 2 -> 4 counters",
    "players": [
      { "hand": ["Hydra's Growth"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Hydra's Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [6, 6] },
      "counters": { "Grizzly Bears": { "p1p1": 4 } }
    }
  },
  {
    "name": "no doubling on the opponent's upkeep",
    "players": [
      { "hand": ["Hydra's Growth"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Hydra's Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] },
      "counters": { "Grizzly Bears": { "p1p1": 1 } }
    }
  },
  {
    "name": "Aura leaves before its ETB resolves: the creature it last enchanted still gets the counter",
    "players": [
      { "hand": ["Hydra's Growth", "Disenchant"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Hydra's Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Disenchant", "targets": ["Hydra's Growth"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] },
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "players": [
        { "graveyard": ["Hydra's Growth", "Disenchant"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: doubling adds as many counters as are already there",
    "players": [
      { "hand": ["Hydra's Growth"], "battlefield": ["Forest", "Forest", "Forest", { "name": "Grizzly Bears", "counters": { "+1/+1": 2 } }] },
      {}
    ],
    "steps": [
      { "cast": "Hydra's Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [8, 8] },
      "counters": { "Grizzly Bears": { "p1p1": 6 } }
    }
  }
]
