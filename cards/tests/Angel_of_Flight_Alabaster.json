[
  {
    "name": "upkeep: returns a Spirit card from graveyard to hand",
    "start": "Untap",
    "players": [
      {
        "battlefield": [
          "Angel of Flight Alabaster"
        ],
        "graveyard": [
          "Blessed Spirits"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Blessed Spirits"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "no Spirit in graveyard: nothing happens",
    "start": "Untap",
    "players": [
      {
        "battlefield": [
          "Angel of Flight Alabaster"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "graveyard_has": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Spirit card still in hand when upkeep begins is not returned",
    "start": "Untap",
    "players": [
      {
        "hand": ["Blessed Spirits"],
        "battlefield": ["Angel of Flight Alabaster"],
        "graveyard": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "hand": ["Blessed Spirits"], "graveyard_has": ["Grizzly Bears"] },
        {}
      ]
    }
  }
]
