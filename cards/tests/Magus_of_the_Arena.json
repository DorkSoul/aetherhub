  {
    "name": "ruling: if the targeted creature leaves in response, the ability does nothing: opponent's creature survives, Magus stays tapped",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Magus of the Arena", "Hill Giant", "Mountain", "Mountain", "Mountain", "Mountain"] },
