[
  {
    "name": "taps target creature when you control a creature with flying",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Plains",
          "Celestial Enforcer",
          "Celestial Kirin"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Celestial Enforcer",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "cannot activate without a creature with flying",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Plains",
          "Celestial Enforcer"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Celestial Enforcer",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "ruling: once activated, the ability resolves even if the flier that enabled it is killed in response",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Plains",
          "Celestial Enforcer",
          "Celestial Kirin"
        ]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Grizzly Bears"]
      }
    ],
    "steps": [
      {
        "activate": "Celestial Enforcer",
        "ability": 0,
        "targets": ["Grizzly Bears"]
      },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Celestial Kirin"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true
      },
      "players": [
        { "graveyard": ["Celestial Kirin"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]