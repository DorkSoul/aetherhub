[
 {
  "name": "its own ward: the Bolt caster pays 2 life, the Squelcher still dies",
  "players": [ { "battlefield": ["Hexing Squelcher"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
  "steps": [
   { "pass": true },
   { "player": 1, "cast": "Lightning Bolt", "targets": ["Hexing Squelcher"] },
   { "resolve": true, "auto": true }
  ],
  "expect": { "players": [ { "graveyard": ["Hexing Squelcher"] }, { "life": 18, "graveyard": ["Lightning Bolt"] } ] }
 },
 {
  "name": "spells you control can't be countered: your Bolt resolves through Counterspell",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Hexing Squelcher", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "player": 1, "cast": "Counterspell", "targets": [ { "stack": "Lightning Bolt" } ] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "graveyard": ["Counterspell"] } ] }
 },
 {
  "name": "can't be countered and spells you control can't be countered",
  "players": [
   {
    "hand": [
     "Hexing Squelcher"
    ],
    "battlefield": [
     "Mountain",
     "Mountain"
    ]
   },
   {
    "hand": [
     "Counterspell"
    ],
    "battlefield": [
     "Island",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Hexing Squelcher"
   },
   {
    "player": 1,
    "cast": "Counterspell",
    "targets": [
     {
      "stack": "Hexing Squelcher"
     }
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Hexing Squelcher"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "other creatures you control have ward pay 2 life",
  "players": [
   {
    "battlefield": [
     "Hexing Squelcher",
     "Grizzly Bears"
    ]
   },
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Mountain"
    ]
   }
  ],
  "steps": [
   {
    "pass": true
   },
   {
    "player": 1,
    "cast": "Lightning Bolt",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Hexing Squelcher"
     ],
     "graveyard": [
      "Grizzly Bears"
     ]
    },
    {
     "life": 18,
     "graveyard": [
      "Lightning Bolt"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: a counter may target a spell that can't be countered; it does nothing to it",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hexing Squelcher"] },
   { "hand": ["Memory Lapse"], "battlefield": ["Island", "Island", "Island"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "player": 1, "cast": "Memory Lapse", "targets": [ { "stack": "Lightning Bolt" } ] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hexing Squelcher"], "graveyard": ["Lightning Bolt"] },
    { "life": 17, "graveyard": ["Memory Lapse"] }
   ]
  }
 }
]
