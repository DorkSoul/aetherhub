[
  {
    "name": "untaps two different target lands",
    "players": [
      { "battlefield": [{ "name": "Argothian Elder", "sick": false }, { "name": "Forest", "tapped": true }, { "name": "Mountain", "tapped": true }] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Argothian Elder", "ability": 0, "targets": ["Forest", "Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Argothian Elder", "Forest", "Mountain"] },
        {}
      ]
    }
  },
  {
    "name": "needs two lands to target",
    "players": [
      { "battlefield": [{ "name": "Argothian Elder", "sick": false }, "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Argothian Elder", "ability": 0, "targets": ["Forest"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Argothian Elder", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an already untapped land can be targeted; the tapped one untaps",
    "players": [
      { "battlefield": [{ "name": "Argothian Elder", "sick": false }, "Forest", { "name": "Mountain", "tapped": true }] },
      {}
    ],
    "steps": [
      { "activate": "Argothian Elder", "ability": 0, "targets": ["Forest", "Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Argothian Elder", "Forest", "Mountain"] },
        {}
      ],
      "tapped": { "Argothian Elder": true, "Forest": false, "Mountain": false }
    }
  }
]
