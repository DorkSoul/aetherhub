[
  {
    "name": "at your upkeep destroys the nonland permanent with the lowest mana value",
    "players": [
      { "battlefield": ["Culling Scales", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Serra Angel"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Grizzly Bears"], "battlefield": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "lands do not count toward the lowest mana value",
    "players": [
      { "battlefield": ["Culling Scales"] },
      { "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Grizzly Bears"], "battlefield": ["Forest"] }
      ]
    }
  },
  {
    "name": "when it is the lowest, Culling Scales can destroy itself",
    "players": [
      { "battlefield": ["Culling Scales"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Culling Scales"] },
        { "battlefield": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling: with a tie for lowest mana value the controller chooses the target",
    "players": [
      { "battlefield": ["Culling Scales", "Sol Ring"] },
      { "battlefield": ["Spectral Sailor"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "targets": ["Spectral Sailor"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Sol Ring"] },
        { "graveyard": ["Spectral Sailor"] }
      ]
    }
  }
]
