[
 { "name": "the named top card goes to the target player's hand",
   "players": [ { "battlefield": ["Petra Sphinx"], "library": ["Lightning Bolt", "Forest"] }, {} ],
   "steps": [ { "activate": "Petra Sphinx", "targets": ["p0"] }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"], "library_count": 1 }, {} ] } },
 { "name": "a revealed card with a different name goes to the graveyard",
   "players": [ { "battlefield": ["Petra Sphinx"], "library": ["Forest", "Lightning Bolt"] }, {} ],
   "steps": [ { "activate": "Petra Sphinx", "targets": ["p0"] }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard": ["Forest"] }, {} ] } },
 { "name": "the opponent is the target: they name the card and receive it",
   "players": [ { "battlefield": ["Petra Sphinx"] }, { "library": ["Giant Growth", "Forest"] } ],
   "steps": [ { "activate": "Petra Sphinx", "targets": ["p1"] }, { "resolve": true, "answers": ["Giant Growth"] } ],
   "expect": { "players": [ {}, { "hand": ["Giant Growth"], "library_count": 1 } ] } },
 { "name": "tapping: a second activation the same turn is illegal",
   "players": [ { "battlefield": ["Petra Sphinx"], "library": ["Lightning Bolt", "Forest"] }, {} ],
   "steps": [ { "activate": "Petra Sphinx", "targets": ["p0"] }, { "resolve": true, "answers": ["Lightning Bolt"] }, { "activate": "Petra Sphinx", "targets": ["p0"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"] }, {} ] } },
 { "name": "ruling: an empty library: the target still names a card, nothing happens and the player does not lose",
   "players": [ { "battlefield": ["Petra Sphinx"] }, { "library": [], "exact_library": true } ],
   "steps": [ { "activate": "Petra Sphinx", "targets": ["p1"] }, { "resolve": true, "answers": ["Forest"] } ],
   "expect": { "players": [ {}, { "life": 20, "hand_count": 0, "library_count": 0 } ] } }
]
