[
 {
  "name": "sacrifice a snow land to return it from the graveyard to hand",
  "players": [
   {
    "graveyard": [
     "Whiteout"
    ],
    "battlefield": [
     "Snow-Covered Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Whiteout"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Whiteout"
     ],
     "graveyard": [
      "Snow-Covered Forest"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "no snow land: cannot return it",
  "players": [
   {
    "graveyard": [
     "Whiteout"
    ],
    "battlefield": [
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Whiteout",
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Whiteout"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "removes flying from all creatures so a ground creature can block the flyer",
  "players": [
   { "hand": ["Whiteout"], "battlefield": ["Forest", "Forest", "Serra Angel"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Whiteout" },
   { "resolve": true },
   { "attack": [{ "card": "Serra Angel", "at": "p1" }] },
   { "block": [{ "blocker": "Grizzly Bears", "attacker": "Serra Angel" }] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Serra Angel"] },
    { "graveyard": ["Grizzly Bears"], "life": 20 }
   ]
  }
 },
 {
  "name": "without Whiteout a ground creature cannot block the flyer",
  "players": [
   { "battlefield": ["Serra Angel"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [{ "card": "Serra Angel", "at": "p1" }] },
   { "block": [{ "blocker": "Grizzly Bears", "attacker": "Serra Angel" }], "illegal": true },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Serra Angel"] },
    { "life": 16, "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 }
]