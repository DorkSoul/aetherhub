[
  {
    "name": "heroic: a spell targeting it destroys an enchantment creature an opponent controls",
    "players": [
      { "hand": ["Leo's Guidance"], "battlefield": ["Plains", "Plains", "Plains", "Leonin Iconoclast"] },
      { "battlefield": ["Bearer of Memory"] }
    ],
    "steps": [
      { "cast": "Leo's Guidance", "targets": ["Leonin Iconoclast"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Leonin Iconoclast"] }, { "graveyard_has": ["Bearer of Memory"] } ]
    }
  },
  {
    "name": "a spell that targets another creature does not trigger heroic",
    "players": [
      { "hand": ["Leo's Guidance"], "battlefield": ["Plains", "Plains", "Plains", "Leonin Iconoclast", "Grizzly Bears"] },
      { "battlefield": ["Bearer of Memory"] }
    ],
    "steps": [
      { "cast": "Leo's Guidance", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Bearer of Memory"] } ]
    }
  },
  {
    "name": "ruling: heroic trigger resolves before the spell that caused it",
    "players": [
      { "hand": ["Leo's Guidance"], "battlefield": ["Plains", "Plains", "Plains", "Leonin Iconoclast"] },
      { "battlefield": ["Bearer of Memory"] }
    ],
    "steps": [
      { "cast": "Leo's Guidance", "targets": ["Leonin Iconoclast"] },
      { "pass": true },
      { "pass": true }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ { "battlefield_has": ["Leonin Iconoclast"] }, { "graveyard_has": ["Bearer of Memory"] } ]
    }
  }
]
