[
 {
  "name": "enters with three energy, pays them for a Thopter",
  "players": [
   {
    "hand": [
     "Whirler Virtuoso"
    ],
    "battlefield": [
     "Island",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Whirler Virtuoso"
   },
   {
    "resolve": true
   },
   {
    "activate": "Whirler Virtuoso"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 0,
     "battlefield_has": [
      "Whirler Virtuoso",
      "Thopter"
     ]
    }
   ]
  }
 },
 {
  "name": "gets energy on entering",
  "players": [
   {
    "hand": [
     "Whirler Virtuoso"
    ],
    "battlefield": [
     "Island",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Whirler Virtuoso"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 3
    }
   ]
  }
 },
 {
  "name": "cannot activate without energy",
  "players": [
   {
    "battlefield": [
     "Whirler Virtuoso"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Whirler Virtuoso",
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 0,
     "battlefield": [
      "Whirler Virtuoso"
     ]
    }
   ]
  }
 },
  {
    "name": "ruling: energy is not mana and does not go away at end of turn",
    "players": [
      {
        "hand": ["Whirler Virtuoso"],
        "battlefield": ["Island", "Mountain", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Whirler Virtuoso" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Whirler Virtuoso", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "energy": 0, "battlefield_has": ["Whirler Virtuoso", "Thopter"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: cannot pay more energy than you have",
    "players": [
      {
        "hand": ["Whirler Virtuoso"],
        "battlefield": ["Island", "Mountain", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Whirler Virtuoso" },
      { "resolve": true },
      { "activate": "Whirler Virtuoso", "ability": 0 },
      { "resolve": true },
      { "activate": "Whirler Virtuoso", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "energy": 0, "battlefield_has": ["Whirler Virtuoso", "Thopter"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: energy belongs to the player, so it stays when Whirler Virtuoso leaves",
    "players": [
      {
        "hand": ["Whirler Virtuoso", "Lightning Bolt"],
        "battlefield": ["Island", "Mountain", "Forest", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Whirler Virtuoso" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p0:Whirler Virtuoso"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "energy": 3, "graveyard_has": ["Whirler Virtuoso", "Lightning Bolt"] },
        {}
      ]
    }
  }
]