      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "library_count": 1 },
        { "hand": [], "graveyard_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "opponent with an empty hand counts as not discarding a big card, so you draw",
    "players": [
