      ]
    }
  },
  {
    "name": "ruling: two target opponents each discard their own chosen card; you draw only for the one who discarded a small card",
    "players": [
      {
        "hand": ["Hollow Marauder"],
        "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"],
        "graveyard": ["Grizzly Bears"],
