    "steps": [
      { "cast": "Hollow Marauder" },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Island"] },
        {}
      ]
    }
  },
  {
    "name": "costs one less for each creature card in your graveyard",
    "players": [
      {
        "hand": ["Hollow Marauder"],
        "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"],
