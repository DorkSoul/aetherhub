[
 {
  "name": "four basic lands pay for it",
  "players": [ { "hand": ["Imperiosaur"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Imperiosaur" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield": ["Imperiosaur", "Forest", "Forest", "Forest", "Forest"] }, {} ] }
 },
 {
  "name": "a mana creature cannot help pay",
  "players": [ { "hand": ["Imperiosaur"], "battlefield": ["Llanowar Elves", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Imperiosaur", "illegal": true } ],
  "expect": { "players": [ { "hand": ["Imperiosaur"] }, {} ] }
 },
 {
  "name": "a nonbasic land cannot help pay",
  "players": [ { "hand": ["Imperiosaur"], "battlefield": ["Overgrown Tomb", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Imperiosaur", "illegal": true } ],
  "expect": { "players": [ { "hand": ["Imperiosaur"] }, {} ] }
 },
 {
  "name": "extra basic lands pay and nonbasic stays untapped",
  "players": [ { "hand": ["Imperiosaur"], "battlefield": ["Overgrown Tomb", "Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Imperiosaur" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield": ["Imperiosaur", "Overgrown Tomb", "Forest", "Forest", "Forest", "Forest"] }, {} ], "tapped": { "Overgrown Tomb": false } }
 },
 {
  "name": "ruling: mana from a Wild Growth trigger on a Forest cannot be spent on Imperiosaur",
  "players": [ { "hand": ["Wild Growth", "Imperiosaur"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [
    { "cast": "Wild Growth", "targets": ["Forest"] },
    { "resolve": true },
    { "cast": "Imperiosaur", "illegal": true }
  ],
  "expect": { "players": [ { "hand": ["Imperiosaur"], "battlefield_has": ["Wild Growth"] }, {} ], "attached": { "Wild Growth": "Forest" } }
 }
]
