[
  {
    "name": "ETB steals a creature until end of turn; end step land deals 3 damage to it",
    "players": [
      { "hand": ["Swooping Pteranodon"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Swooping Pteranodon" },
      { "resolve": true },
      { "advance_to": "End", "answers": ["Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swooping Pteranodon"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "another flying Dinosaur entering triggers the ability too",
    "players": [
      { "hand": ["Akim, the Soaring Wind"], "battlefield": ["Swooping Pteranodon", "Island", "Mountain", "Plains", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Akim, the Soaring Wind" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swooping Pteranodon", "Akim, the Soaring Wind", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "a non-Dinosaur entering does not trigger the ability",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Swooping Pteranodon", "Forest", "Forest"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swooping Pteranodon", "Grizzly Bears"] },
        { "battlefield_has": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: the end-step damage land is chosen then and can be one the opponent controls",
    "players": [
      { "hand": ["Swooping Pteranodon"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Island"] }
    ],
    "steps": [
      { "cast": "Swooping Pteranodon" },
      { "resolve": true },
      { "advance_to": "End", "answers": ["Island"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swooping Pteranodon"] },
        { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Island"] }
      ]
    }
  }
]
