[
  {
    "name": "casting a noncreature spell puts an oil counter on it (flying ability becomes usable)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Atmosphere Surgeon", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Atmosphere Surgeon", "targets": ["Atmosphere Surgeon"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Atmosphere Surgeon"] }, { "graveyard": ["Grizzly Bears"] } ],
      "keywords": { "Atmosphere Surgeon": ["Flying"] }
    }
  },
  {
    "name": "casting a creature spell does not put an oil counter on it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Atmosphere Surgeon", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "activate": "Atmosphere Surgeon", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": [] }
    }
  },
  {
    "name": "the oil counter is removed as the cost: a second activation is illegal",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Atmosphere Surgeon", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Atmosphere Surgeon", "targets": ["Atmosphere Surgeon"] },
      { "resolve": true },
      { "activate": "Atmosphere Surgeon", "targets": ["Atmosphere Surgeon"], "illegal": true }
    ],
    "expect": {
      "keywords": { "Atmosphere Surgeon": ["Flying"] }
    }
  },
  {
    "name": "no oil counter: the flying ability is not activatable",
    "players": [
      { "battlefield": ["Atmosphere Surgeon", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Atmosphere Surgeon", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": [] }
    }
  }
]
