[
 {
  "name": "copies an opponent's creature ETB trigger",
  "players": [
   { "hand": ["Elvish Visionary"], "battlefield": ["Forest", "Plains"] },
   { "battlefield": ["Aboleth Spawn"] }
  ],
  "steps": [
   { "cast": "Elvish Visionary" },
   { "resolve": true, "answers": [true] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 1, "battlefield_has": ["Elvish Visionary"] },
    { "hand_count": 1 }
   ],
   "stack_empty": true
  }
 },
 {
  "name": "ward {2}: the opponent has only 1 spare mana, cannot pay, Bolt is countered",
  "players": [ { "battlefield": ["Aboleth Spawn"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
  "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Aboleth Spawn"] }, { "resolve": true, "auto": true } ],
  "expect": { "players": [ { "battlefield_has": ["Aboleth Spawn"] }, { "graveyard_has": ["Lightning Bolt"], "life": 20 } ] }
 },
 {
  "name": "ward {2}: the opponent pays 2 with spare mana, Bolt resolves and kills it",
  "players": [ { "battlefield": ["Aboleth Spawn"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
  "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Aboleth Spawn"] }, { "resolve": true, "auto": true } ],
  "expect": { "players": [ { "graveyard": ["Aboleth Spawn"] }, { "life": 20 } ] }
 },
 {
  "name": "ruling: a non-creature permanent's ETB trigger is not copied by Aboleth Spawn",
  "players": [ { "hand": ["Witching Well"], "battlefield": ["Island"], "library": ["Lightning Bolt", "Grizzly Bears"] }, { "battlefield": ["Aboleth Spawn"] } ],
  "steps": [ { "cast": "Witching Well" }, { "resolve": true, "answers": [[]] } ],
  "expect": { "players": [ { "library_top": ["Lightning Bolt", "Grizzly Bears"] }, {} ], "stack_empty": true }
 }
]
