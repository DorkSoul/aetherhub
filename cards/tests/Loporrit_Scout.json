[
  {
    "name": "another creature entering gives +1/+1 until end of turn",
    "players": [ { "hand": ["Loporrit Scout", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Loporrit Scout" }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Loporrit Scout": [4, 3] } }
  },
  {
    "name": "does not trigger on its own entering",
    "players": [ { "hand": ["Loporrit Scout"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Loporrit Scout" }, { "resolve": true } ],
    "expect": { "pt": { "Loporrit Scout": [3, 2] } }
  }
]
