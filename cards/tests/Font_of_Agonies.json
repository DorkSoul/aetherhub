[
 {
  "name": "paying life puts that many blood counters",
  "players": [
   {
    "battlefield": [
     "Font of Agonies",
     "Flooded Strand"
    ],
    "library": [
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Flooded Strand",
    "ability": 0
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 19
    },
    {}
   ],
   "counters": {
    "Font of Agonies": {
     "blood": 1
    }
   }
  }
 },
 {
  "name": "{1}{B}, remove four blood counters: destroy target creature",
  "players": [
   { "battlefield": [ { "name": "Font of Agonies", "counters": { "blood": 4 } }, "Swamp", "Swamp" ] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "activate": "Font of Agonies", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Font of Agonies"] }, { "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "with only three blood counters the destroy ability is illegal",
  "players": [
   { "battlefield": [ { "name": "Font of Agonies", "counters": { "blood": 3 } }, "Swamp", "Swamp" ] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "activate": "Font of Agonies", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "counters": { "Font of Agonies": { "blood": 3 } } }
 },
 {
  "name": "ruling: damage to yourself is not paying life, so no blood counters",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Font of Agonies", "Mountain"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true } ],
  "expect": { "players": [ { "life": 17 }, {} ], "counters": { "Font of Agonies": { "blood": 0 } } }
 }
]
