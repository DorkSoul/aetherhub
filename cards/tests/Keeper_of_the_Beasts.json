[
  { "name": "opponent with more creatures can be targeted; Beast token is created",
    "players": [ { "battlefield": ["Keeper of the Beasts", "Forest"] }, { "battlefield": ["Grizzly Bears", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Keeper of the Beasts", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Beast 2-2"] }, {} ],
      "tapped": { "Keeper of the Beasts": true }
    } },
  { "name": "opponent with the same number of creatures is not a legal target",
    "players": [ { "battlefield": ["Keeper of the Beasts", "Forest", "Grizzly Bears"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Keeper of the Beasts", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Keeper of the Beasts"] }, {} ] }
  },
  { "name": "ruling: the condition is only checked on activation; the Beast is still made if the opponent loses the lead in response",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Keeper of the Beasts", "Forest", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [
      { "activate": "Keeper of the Beasts", "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Beast 2-2", "Keeper of the Beasts"] }, { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Hill Giant"] } ]
    }
  }
]
