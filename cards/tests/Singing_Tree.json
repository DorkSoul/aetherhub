[
  {
    "name": "target attacking creature has base power 0 until end of turn: it deals no combat damage",
    "players": [
      { "battlefield": ["Grizzly Bears", "Singing Tree"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "activate": "Singing Tree", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ],
      "pt": { "Grizzly Bears": [0, 2] },
      "tapped": { "Singing Tree": true }
    }
  },
  {
    "name": "the base power comes back at the next turn",
    "players": [
      { "battlefield": ["Grizzly Bears", "Singing Tree"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "activate": "Singing Tree", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "a creature that is not attacking is not a legal target",
    "players": [
      { "battlefield": ["Grizzly Bears", "Singing Tree"] },
      {}
    ],
    "steps": [
      { "activate": "Singing Tree", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "tapped": { "Singing Tree": false }
    }
  },
  {
    "name": "ruling: a pump after base power 0 still raises its power",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Grizzly Bears", "Singing Tree"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "activate": "Singing Tree", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ],
      "pt": { "Grizzly Bears": [3, 5] }
    }
  }
]
