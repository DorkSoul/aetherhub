[
 { "name": "damage from the chosen attacker is dealt to you and reflected to its controller",
   "players": [ { "battlefield": ["Hill Giant"] },
                { "hand": ["Eye for an Eye"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "pass": true },
              { "cast": "Eye for an Eye", "player": 1 },
              { "resolve": true, "answers": ["Hill Giant"] },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 17 }, { "life": 17, "graveyard": ["Eye for an Eye"] } ] } },
 { "name": "damage from an unchosen source is not reflected",
   "players": [ { "battlefield": ["Hill Giant", "Grizzly Bears"] },
                { "hand": ["Eye for an Eye"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
              { "pass": true },
              { "cast": "Eye for an Eye", "player": 1 },
              { "resolve": true, "answers": ["Grizzly Bears"] },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 18 }, { "life": 15 } ] } },
 { "name": "only the next time: the double striker's second hit is not reflected",
   "players": [ { "battlefield": ["Fencing Ace"] },
                { "hand": ["Eye for an Eye"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Fencing Ace", "at": "p1" } ] },
              { "pass": true },
              { "cast": "Eye for an Eye", "player": 1 },
              { "resolve": true, "answers": ["Fencing Ace"] },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 19 }, { "life": 18 } ] } },
 { "name": "a spell on the stack can be the chosen source",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                { "hand": ["Eye for an Eye"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "pass": true },
              { "cast": "Eye for an Eye", "player": 1 },
              { "resolve": true, "answers": ["Lightning Bolt"] } ],
   "expect": { "players": [ { "life": 17 }, { "life": 17 } ] } },
 { "name": "ruling: damage already dealt this turn before Eye for an Eye resolves is not reflected",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"] },
                { "hand": ["Eye for an Eye"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [] },
              { "advance_to": "Main2" },
              { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "pass": true },
              { "cast": "Eye for an Eye", "player": 1 },
              { "resolve": true, "answers": ["Lightning Bolt"] } ],
   "expect": { "players": [ { "life": 17 }, { "life": 14, "graveyard": ["Eye for an Eye"] } ] } }
]
