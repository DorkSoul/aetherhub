[
  { "name": "ETB earthbend 2 onto a land; Toph's power counts the counters on lands you control",
    "players": [ { "hand": ["Toph, the Blind Bandit"], "battlefield": ["Forest", "Forest", "Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Toph, the Blind Bandit" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, the Blind Bandit", "Plains"] }, {} ], "pt": { "Toph, the Blind Bandit": [2, 3], "Plains": [2, 2] }, "counters": { "Plains": { "p1p1": 2 } } } },
  { "name": "counters on a non-land creature do not add to Toph's power",
    "players": [ { "battlefield": [ { "name": "Toph, the Blind Bandit" }, { "name": "Grizzly Bears", "counters": { "p1p1": 3 } } ] }, {} ],
    "steps": [],
    "expect": { "pt": { "Toph, the Blind Bandit": [0, 3] } } },
  { "name": "ruling: an earthbent land that dies returns to the battlefield tapped",
    "players": [ { "hand": ["Toph, the Blind Bandit", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Mountain"] }, {} ],
    "steps": [ { "cast": "Toph, the Blind Bandit" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, the Blind Bandit", "Plains"], "graveyard": ["Lightning Bolt"] }, {} ], "tapped": { "Plains": true } } },
  { "name": "ruling: an earthbent land that leaves for hand is not returned",
    "players": [ { "hand": ["Toph, the Blind Bandit", "Unsummon"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Toph, the Blind Bandit" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Unsummon", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Plains"], "battlefield_has": ["Toph, the Blind Bandit"], "battlefield_lacks": ["Plains"] }, {} ] } },
  { "name": "ruling: a second earthbend on an animated land adds counters on top (Earthbending Lesson)",
    "players": [ { "hand": ["Toph, the Blind Bandit", "Earthbending Lesson"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Plains"] }, {} ],
    "steps": [ { "cast": "Toph, the Blind Bandit" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Earthbending Lesson", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, the Blind Bandit", "Plains"] }, {} ], "pt": { "Plains": [6, 6], "Toph, the Blind Bandit": [6, 3] }, "counters": { "Plains": { "p1p1": 6 } } } }
