[
  {
    "name": "unblocked 5-power attacker's damage goes to Protector and kills it, you stay at 20",
    "players": [ { "battlefield": ["Protector of the Crown"] }, { "battlefield": [{ "name": "Juggernaut", "sick": false }] } ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Juggernaut", "at": "p0" } ], "player": 1 }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "battlefield_lacks": ["Protector of the Crown"] }, {} ] }
  },
  {
    "name": "2-power attacker's damage goes to Protector (survives), you stay at 20",
    "players": [ { "battlefield": ["Protector of the Crown"] }, { "battlefield": [{ "name": "Grizzly Bears", "sick": false }] } ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Protector of the Crown"] }, {} ] }
  },
  {
    "name": "enters and makes you the monarch, so you draw at your end step",
    "players": [ { "hand": ["Protector of the Crown"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Protector of the Crown" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Protector of the Crown"], "hand_count": 1 }, {} ] }
  },
  {
    "name": "without the enters trigger you are not the monarch: no end-step draw",
    "players": [ { "battlefield": ["Protector of the Crown"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Protector of the Crown"], "hand_count": 0 }, {} ] }
  },
  {
    "name": "ruling: combat damage redirected to Protector does not make the attacker the monarch; I still draw at my end steps",
    "players": [ { "hand": ["Protector of the Crown"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] } ],
    "steps": [
      { "cast": "Protector of the Crown" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "life": 20, "hand_count": 3, "battlefield_has": ["Protector of the Crown"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  }
]
