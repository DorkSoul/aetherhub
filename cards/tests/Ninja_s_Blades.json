[
 {
  "name": "job select creates a 1/1 Hero token and attaches the Blades to it",
  "players": [
   { "hand": ["Ninja's Blades"], "battlefield": ["Swamp", "Island", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Ninja's Blades" },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Hero", "Ninja's Blades"] }, {} ],
   "pt": { "Hero": [2, 2] }
  }
 },
 {
  "name": "equipped creature that deals combat damage draws, then discards a card and the damaged player loses that much life",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Swamp", "Island", "Grizzly Bears", "Ninja's Blades"] },
   {}
  ],
  "steps": [
   { "activate": "Ninja's Blades", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2", "answers": ["Lightning Bolt"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "life": 16 } ],
   "pt": { "Grizzly Bears": [3, 3] }
  }
 },
 {
  "name": "equipped creature is a Ninja in addition to its other types",
  "players": [
   { "battlefield": ["Swamp", "Island", "Grizzly Bears", "Ninja's Blades"] },
   {}
  ],
  "steps": [
   { "activate": "Ninja's Blades", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears", "Ninja's Blades"] }, {} ],
   "subtypes": { "Grizzly Bears": ["Ninja", "Bear"] }
  }
 },
 {
  "name": "ruling: equip cost moves the Equipment from the Hero token to another creature",
  "players": [
   { "hand": ["Ninja's Blades"], "battlefield": ["Swamp", "Island", "Forest", "Forest", "Forest", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Ninja's Blades" },
   { "resolve": true },
   { "resolve": true },
   { "activate": "Ninja's Blades", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Hero", "Ninja's Blades", "Grizzly Bears"] }, {} ],
   "pt": { "Hero": [1, 1], "Grizzly Bears": [3, 3] },
   "attached": { "Ninja's Blades": "Grizzly Bears" }
  }
 },
 {
  "name": "ruling: if the Hero token is destroyed the Equipment stays on the battlefield",
  "players": [
