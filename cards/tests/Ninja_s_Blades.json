   {}
  ],
  "steps": [
   { "cast": "Ninja's Blades" },
   { "resolve": true },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Hero"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Ninja's Blades"], "battlefield_lacks": ["Hero"], "graveyard_has": ["Lightning Bolt"] }, {} ]
  }
 },
 {
