          "Breeches, Brazen Plunderer",
          "Swamp"
        ]
      },
      {
        "library": [
          "Lightning Bolt",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Breeches, Brazen Plunderer",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      },
      {
