[
  { "name": "draws a card when Raise Dead returns a card from your graveyard",
    "players": [ { "hand": ["Raise Dead"], "battlefield": ["Vash, Freelance Archaeologist", "Swamp"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Raise Dead", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Raise Dead"] }, {} ] } },
  { "name": "ruling: only once each turn, so a second card leaving the graveyard does not draw again",
    "players": [ { "hand": ["Raise Dead", "Raise Dead"], "battlefield": ["Vash, Freelance Archaeologist", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] }, {} ],
    "steps": [
      { "cast": "Raise Dead", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "cast": "Raise Dead", "targets": ["Llanowar Elves"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 3 }, {} ] } },
  { "name": "upkeep: surveil 1, putting the top card into your graveyard",
    "players": [ { "battlefield": ["Vash, Freelance Archaeologist"], "library": ["Lightning Bolt"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [["Lightning Bolt"]] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, {} ] } },
  { "name": "upkeep: surveil 1, keeping the top card on top of your library",
    "players": [ { "battlefield": ["Vash, Freelance Archaeologist"], "library": ["Lightning Bolt"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [[]] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": [], "library_top": ["Lightning Bolt"] }, {} ] } }
]
