 {
  "name": "ruling: if the target is gone on resolution the spell fizzles and no card is put on the bottom",
  "players": [ { "hand": ["Fire Prophecy", "Knight of Meadowgrain"], "battlefield": ["Mountain", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
