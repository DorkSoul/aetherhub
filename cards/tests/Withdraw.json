[
  {
    "name": "second creature returns unless its controller pays: no mana, so it returns",
    "players": [
      { "hand": ["Withdraw"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Withdraw", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Withdraw"] },
        { "hand_count": 2, "battlefield_lacks": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "second creature stays when its controller pays {1}",
    "players": [
      { "hand": ["Withdraw"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Plains", "Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Withdraw", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Withdraw"] },
        { "hand_count": 1, "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the controller of the second creature (not the caster) pays; their payment keeps it",
    "players": [
      { "hand": ["Withdraw"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      { "battlefield": ["Plains", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Withdraw", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Withdraw"], "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: the second creature's controller without untapped mana cannot pay, so it returns",
    "players": [
      { "hand": ["Withdraw"], "battlefield": ["Island", "Island", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Withdraw", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Withdraw"], "hand": ["Hill Giant"] },
        { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: must target two different creatures (same creature twice is illegal)",
    "players": [
      { "hand": ["Withdraw"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Withdraw", "targets": ["Grizzly Bears", "Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Withdraw"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
