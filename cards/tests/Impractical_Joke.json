[
  {
    "name": "deals 3 damage to target creature",
    "players": [
      { "hand": ["Impractical Joke"], "battlefield": ["Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Impractical Joke", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Impractical Joke"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "up to one target: cast with no target does no damage",
    "players": [
      { "hand": ["Impractical Joke"], "battlefield": ["Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Impractical Joke", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Impractical Joke"] }, { "battlefield_has": ["Grizzly Bears"], "life": 20 } ]
    }
  },
  {
    "name": "ruling: Impractical Joke's damage cannot be prevented, so Blessed Sanctuary does not save your own creature",
    "players": [
      { "hand": ["Impractical Joke"], "battlefield": ["Mountain", "Blessed Sanctuary", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Impractical Joke", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Impractical Joke", "Grizzly Bears"], "battlefield_has": ["Blessed Sanctuary"] }, {}]
    }
  },
  {
    "name": "ruling: cannot target a creature with protection from red even though Impractical Joke deals damage",
    "players": [
      { "hand": ["Impractical Joke"], "battlefield": ["Mountain"] },
      { "battlefield": ["Silver Knight"] }
    ],
    "steps": [
      { "cast": "Impractical Joke", "targets": ["Silver Knight"], "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Impractical Joke"] }, { "battlefield_has": ["Silver Knight"] }]
    }
  }
]
