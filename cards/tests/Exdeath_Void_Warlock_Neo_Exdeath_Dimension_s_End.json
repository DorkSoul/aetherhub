[
  {
    "name": "entering gains 3 life",
    "players": [ { "hand": ["Exdeath, Void Warlock"], "battlefield": ["Swamp", "Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Exdeath, Void Warlock" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "life": 23, "battlefield_has": ["Exdeath, Void Warlock"] }, {} ]
    }
  },
  {
    "name": "at my end step with six permanent cards in my graveyard it transforms, and its power is the number of them",
    "players": [
      {
        "battlefield": ["Exdeath, Void Warlock"],
        "graveyard": ["Grizzly Bears", "Hill Giant", "Serra Angel", "Plains", "Forest", "Island"]
      },
      {}
    ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": {
      "pt": { "Neo Exdeath, Dimension's End": [6, 3] },
      "players": [ { "battlefield_has": ["Neo Exdeath, Dimension's End"] }, {} ]
    }
  },
  {
    "name": "with only five permanent cards in my graveyard it does not transform",
    "players": [
      {
        "battlefield": ["Exdeath, Void Warlock"],
        "graveyard": ["Grizzly Bears", "Hill Giant", "Serra Angel", "Plains", "Forest"]
      },
      {}
    ],
    "steps": [ { "advance_to": "End" } ],
    "expect": {
      "pt": { "Exdeath, Void Warlock": [3, 3] },
      "players": [ { "battlefield_has": ["Exdeath, Void Warlock"] }, {} ]
    }
  }
]
