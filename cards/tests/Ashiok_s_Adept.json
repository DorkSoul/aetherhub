[
 {
  "name": "heroic: opponent discards when a spell targets it",
  "players": [
   { "hand": ["Aspect of Hydra"], "battlefield": ["Forest", { "name": "Ashiok's Adept", "sick": false }] },
   { "hand": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Aspect of Hydra", "targets": ["Ashiok's Adept"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, { "graveyard": ["Hill Giant"], "hand_count": 0 } ] }
 },
 {
  "name": "spell targeting another creature does not trigger heroic",
  "players": [
   { "hand": ["Aspect of Hydra"], "battlefield": ["Forest", { "name": "Ashiok's Adept", "sick": false }, "Grizzly Bears"] },
   { "hand": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Aspect of Hydra", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, { "hand_count": 1 } ] }
 },
 {
  "name": "ruling: a copy or a target change onto the heroic creature does not trigger heroic",
  "players": [
   { "hand": ["Twincast", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain", { "name": "Ashiok's Adept", "sick": false }, "Grizzly Bears"] },
   { "hand": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "cast": "Twincast", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true, "answers": ["Ashiok's Adept"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, { "hand": ["Hill Giant"] } ] }
 }
]
