[
  { "name": "returns a non-Aura enchantment from the graveyard",
    "players": [
      { "battlefield": ["Ghen, Arcanum Weaver", "Propaganda", "Mountain", "Plains", "Swamp"], "graveyard": ["Leyline of Sanctity"] },
      {}
    ],
    "steps": [
      { "activate": "Ghen, Arcanum Weaver", "targets": ["Leyline of Sanctity"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Leyline of Sanctity"], "graveyard": ["Propaganda"] }, {} ]
    }
  },
  { "name": "returns an Aura, which enchants the only legal creature",
    "players": [
      { "battlefield": ["Ghen, Arcanum Weaver", "Propaganda", "Mountain", "Plains", "Swamp"], "graveyard": ["Arrest"] },
      {}
    ],
    "steps": [
      { "activate": "Ghen, Arcanum Weaver", "targets": ["Arrest"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Arrest": "Ghen, Arcanum Weaver" }
    }
  },
  { "name": "needs an enchantment to sacrifice",
    "players": [
      { "battlefield": ["Ghen, Arcanum Weaver", "Mountain", "Plains", "Swamp"], "graveyard": ["Leyline of Sanctity"] },
      {}
    ],
    "steps": [
      { "activate": "Ghen, Arcanum Weaver", "targets": ["Leyline of Sanctity"], "illegal": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Leyline of Sanctity"] }, {} ]
    }
  },
  { "name": "needs an enchantment card in the graveyard to target",
    "players": [
      { "battlefield": ["Ghen, Arcanum Weaver", "Propaganda", "Mountain", "Plains", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Ghen, Arcanum Weaver", "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Propaganda"] }, {} ]
    }
  },
  { "name": "ruling: targets are chosen before the sacrifice, so the enchantment being sacrificed cannot be the target",
    "players": [
      { "battlefield": ["Ghen, Arcanum Weaver", "Propaganda", "Mountain", "Plains", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Ghen, Arcanum Weaver", "targets": ["Propaganda"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Propaganda"] }, {} ]
    }
  }
]
