[
  {
    "name": "two {R} activations make it 1/3 (printed power -1)",
    "players": [
      { "battlefield": ["Mountain", "Mountain", "Char-Rumbler"] },
      {}
    ],
    "steps": [
      { "activate": "Char-Rumbler" },
      { "resolve": true },
      { "activate": "Char-Rumbler" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Char-Rumbler"] }, {}],
      "pt": { "Char-Rumbler": [1, 3] }
    }
  },
  {
    "name": "printed -1 power deals no combat damage",
    "players": [
      { "battlefield": ["Char-Rumbler"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Char-Rumbler", "at": "p1" }] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "pt": { "Char-Rumbler": [-1, 3] }
    }
  },
  {
    "name": "ruling: power 0 after one pump: double strike deals no damage",
    "players": [{ "battlefield": ["Mountain", "Char-Rumbler"] }, {}],
    "steps": [
      { "activate": "Char-Rumbler" },
      { "resolve": true },
      { "attack": [{ "card": "Char-Rumbler", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 20 }] }
  },
  {
    "name": "ruling: power 1 after two pumps: double strike deals 1 + 1 damage",
    "players": [{ "battlefield": ["Mountain", "Mountain", "Char-Rumbler"] }, {}],
    "steps": [
      { "activate": "Char-Rumbler" },
      { "resolve": true },
      { "activate": "Char-Rumbler" },
      { "resolve": true },
      { "attack": [{ "card": "Char-Rumbler", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 18 }] }
  }
]
