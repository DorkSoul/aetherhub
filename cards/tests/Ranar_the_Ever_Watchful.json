[
  {
    "name": "stats and keywords",
    "players": [{ "battlefield": ["Ranar the Ever-Watchful"] }, {}],
    "steps": [],
    "expect": {
      "pt": { "Ranar the Ever-Watchful": [2, 3] },
      "keywords": { "Ranar the Ever-Watchful": ["Flying", "Vigilance"] }
    }
  },
  {
    "name": "the first foretell each turn costs 0 and the hand exile makes a Spirit",
    "players": [
      { "hand": ["Demon Bolt"], "battlefield": ["Ranar the Ever-Watchful"] },
      {}
    ],
    "steps": [
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Demon Bolt"], "battlefield": ["Ranar the Ever-Watchful", "Spirit"] },
        {}
      ],
      "stack_empty": true
    }
  },
  {
    "name": "the second foretell each turn costs 2",
    "players": [
      { "hand": ["Demon Bolt", "Demon Bolt"], "battlefield": ["Ranar the Ever-Watchful", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Demon Bolt", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Demon Bolt"], "exile": ["Demon Bolt"], "battlefield": ["Ranar the Ever-Watchful", "Mountain", "Spirit"] },
        {}
      ]
    }
  },
  {
    "name": "the second foretell with two lands works and makes another Spirit",
    "players": [
      { "hand": ["Demon Bolt", "Demon Bolt"], "battlefield": ["Ranar the Ever-Watchful", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Demon Bolt", "ability": 0 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Demon Bolt", "Demon Bolt"], "battlefield": ["Ranar the Ever-Watchful", "Mountain", "Mountain", "Spirit", "Spirit"] },
        {}
      ],
      "stack_empty": true
    }
  },
  {
    "name": "your spell exiling a permanent makes a Spirit",
    "players": [
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Ranar the Ever-Watchful"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Swords to Plowshares", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Swords to Plowshares"], "battlefield": ["Plains", "Ranar the Ever-Watchful", "Spirit"] },
        { "exile": ["Hill Giant"] }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "an opponent's spell exiling a permanent makes no Spirit",
    "players": [
      { "battlefield": ["Ranar the Ever-Watchful", "Hill Giant"] },
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Swords to Plowshares", "player": 1, "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Ranar the Ever-Watchful"] },
        { "graveyard": ["Swords to Plowshares"], "battlefield": ["Plains"] }
      ]
    }
  },
  {
    "name": "the first foretell is free for a card that foretells through another effect too",
    "players": [
      { "hand": ["Hill Giant"], "battlefield": ["Ranar the Ever-Watchful", "Bohn, Beguiling Balladeer"] },
      {}
    ],
    "steps": [
      { "activate": "Hill Giant", "ability": 32768 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Hill Giant"], "battlefield": ["Ranar the Ever-Watchful", "Bohn, Beguiling Balladeer", "Spirit"] },
        {}
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: a spell exiling your own Spirit token (a token permanent) still makes a Spirit",
    "players": [
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Ranar the Ever-Watchful", "Spirit"] },
      {}
    ],
    "steps": [
      { "cast": "Swords to Plowshares", "targets": ["Spirit"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Swords to Plowshares"], "battlefield": ["Plains", "Ranar the Ever-Watchful", "Spirit"] },
        {}
      ],
      "stack_empty": true
    }
  }
]
