[
  {
    "name": "cast with life for the Phyrexian symbols",
    "players": [
      {
        "hand": [
          "K'rrik, Son of Yawgmoth"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "K'rrik, Son of Yawgmoth"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 16,
          "battlefield_has": [
            "K'rrik, Son of Yawgmoth"
          ]
        },
        {}
      ],
      "pt": {
        "K'rrik, Son of Yawgmoth": [
          2,
          2
        ]
      },
      "keywords": {
        "K'rrik, Son of Yawgmoth": [
          "Lifelink"
        ]
      }
    }
  },
  {
    "name": "a black spell can be cast by paying 2 life for the {B}, and K'rrik grows",
    "players": [
      {
        "hand": [
          "Disfigure"
        ],
        "battlefield": [
          "K'rrik, Son of Yawgmoth"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Disfigure",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ],
      "counters": {
        "K'rrik, Son of Yawgmoth": {
          "PlusOnePlusOne": 1
        }
      },
      "pt": {
        "K'rrik, Son of Yawgmoth": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "a nonblack spell does not grow K'rrik, and red mana still needs red",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Disfigure"
        ],
        "battlefield": [
          "K'rrik, Son of Yawgmoth"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {}
      ],
      "pt": {
        "K'rrik, Son of Yawgmoth": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "without K'rrik the black spell is not castable with life",
    "players": [
      {
        "hand": [
          "Disfigure"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Disfigure",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: K'rrik's trigger resolves even when the black spell is countered",
    "players": [
      { "hand": ["Disfigure"], "battlefield": ["K'rrik, Son of Yawgmoth", "Swamp"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Disfigure", "targets": ["Grizzly Bears"] },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Disfigure" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Disfigure"] },
        { "graveyard": ["Counterspell"], "battlefield_has": ["Grizzly Bears"] }
      ],
      "counters": { "K'rrik, Son of Yawgmoth": { "PlusOnePlusOne": 1 } },
      "pt": { "K'rrik, Son of Yawgmoth": [3, 3] }
    }
  },
  {
    "name": "ruling: 2 life pays only the {B} of Doom Blade, its {1} still needs a land",
    "players": [
      { "hand": ["Doom Blade"], "battlefield": ["K'rrik, Son of Yawgmoth", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Doom Blade", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "graveyard": ["Doom Blade"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: 2 life cannot pay the generic {1} of Doom Blade, so with no land it is not castable",
    "players": [
      { "hand": ["Doom Blade"], "battlefield": ["K'rrik, Son of Yawgmoth"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Doom Blade", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "hand": ["Doom Blade"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]