[
  { "name": "an opponent casting an enchantment spell makes it a 5/5 Treefolk",
    "players": [ { "battlefield": ["Hidden Ancients"] }, { "hand": ["Angelic Exaltation"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] } ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Main1" }, { "player": 1, "cast": "Angelic Exaltation" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hidden Ancients"] }, {} ], "pt": { "Hidden Ancients": [5, 5] } } },
  { "name": "an opponent casting an instant does not turn it into a creature",
    "players": [ { "battlefield": ["Hidden Ancients"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, {} ] } },
  { "name": "ruling: the creature change happens even if the enchantment spell is countered",
    "players": [ { "hand": ["Negate"], "battlefield": ["Hidden Ancients", "Island", "Island"] }, { "hand": ["Angelic Exaltation"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] } ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Main1" }, { "player": 1, "cast": "Angelic Exaltation" }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Negate", "targets": [ { "stack": "Angelic Exaltation" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Negate"] }, { "graveyard_has": ["Angelic Exaltation"] } ], "pt": { "Hidden Ancients": [5, 5] } } }
]
