[
  { "name": "casting a creature spell adds two counters",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", { "name": "Herald of Ilharg", "sick": false }] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Herald of Ilharg": [5, 5] }, "counters": { "Herald of Ilharg": { "p1p1": 2 } }, "players": [ {}, { "life": 20 } ] } },
  { "name": "a creature spell with mana value 5 or more also deals damage equal to its counters",
    "players": [ { "hand": ["Hellkite Punisher"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Herald of Ilharg", "sick": false }] }, {} ],
    "steps": [ { "cast": "Hellkite Punisher" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Herald of Ilharg": [5, 5] }, "players": [ {}, { "life": 18 } ] } },
  { "name": "ruling: the counters trigger still resolves when the creature spell that caused it is countered",
    "players": [ { "hand": ["Hellkite Punisher"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Herald of Ilharg", "sick": false }] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Hellkite Punisher" },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Hellkite Punisher" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Herald of Ilharg": [5, 5] }, "counters": { "Herald of Ilharg": { "p1p1": 2 } }, "players": [ { "graveyard": ["Hellkite Punisher"] }, { "life": 18, "graveyard": ["Counterspell"] } ], "stack_empty": true }
  }
]
