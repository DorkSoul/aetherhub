[
 { "name": "returns a creature card from your graveyard with a finality counter",
   "players": [ { "hand": ["Rite of the Moth"], "battlefield": ["Plains", "Swamp", "Swamp", "Island"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Rite of the Moth", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Rite of the Moth"] }, {} ], "counters": { "Grizzly Bears": { "finality": 1 } } } },
 { "name": "a creature with a finality counter is exiled instead of dying",
   "players": [ { "hand": ["Rite of the Moth", "Lightning Bolt"], "battlefield": ["Plains", "Swamp", "Swamp", "Island", "Mountain"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Rite of the Moth", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Rite of the Moth", "Lightning Bolt"], "exile": ["Grizzly Bears"] }, {} ] } },
 { "name": "flashback for {3}{W}{W}{B} returns the creature and exiles the Rite",
   "players": [ { "battlefield": ["Plains", "Plains", "Swamp", "Island", "Island", "Island"], "graveyard": ["Rite of the Moth", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Rite of the Moth", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": ["Rite of the Moth"] }, {} ] } },
 { "name": "flashback needs {W}{W}: one Plains is illegal",
   "players": [ { "battlefield": ["Plains", "Swamp", "Island", "Island", "Island", "Island"], "graveyard": ["Rite of the Moth", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Rite of the Moth", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Rite of the Moth", "Grizzly Bears"] }, {} ] } },
 { "name": "ruling: a creature that loses all abilities with a finality counter is still exiled when it dies",
   "players": [ { "hand": ["Rite of the Moth", "Turn to Frog", "Lightning Bolt"], "battlefield": ["Plains", "Swamp", "Swamp", "Island", "Island", "Island", "Mountain"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Rite of the Moth", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Turn to Frog", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Rite of the Moth", "Turn to Frog", "Lightning Bolt"], "exile": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: a finality counter does not stop the creature being returned to its owner's hand",
   "players": [ { "hand": ["Rite of the Moth", "Unsummon"], "battlefield": ["Plains", "Swamp", "Swamp", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Rite of the Moth", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Unsummon", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Rite of the Moth", "Unsummon"] }, {} ] } }
]
