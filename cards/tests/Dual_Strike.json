  {
    "name": "foretell pays {2} and exiles it face down",
    "players": [
      {
        "hand": [
          "Dual Strike"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Dual Strike",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Dual Strike"
          ],
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "foretold card is cast for {R} on a later turn",
    "players": [
      {
        "hand": [
          "Dual Strike"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Dual Strike",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Dual Strike",
        "alt": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Dual Strike"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a foretold instant can be cast on the opponent's turn for its foretell cost",
    "players": [
      {
        "hand": ["Dual Strike"],
        "battlefield": ["Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Dual Strike", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Dual Strike", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dual Strike"], "exile": [] },
        {}
      ]
    }
  },
  {
    "name": "ruling: copies a Blaze with X=3 (mana value 4) using the same X",
    "players": [
      {
        "hand": ["Dual Strike", "Blaze"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Dual Strike" },
      { "resolve": true, "auto": true },
      { "cast": "Blaze", "targets": ["p1"], "answers": [3] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dual Strike", "Blaze"] },
        { "life": 14 }
      ]
    }
  },
  {
    "name": "ruling: Blaze with X=4 (mana value 5) is not copied",
    "players": [
      {
        "hand": ["Dual Strike", "Blaze"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Dual Strike" },
      { "resolve": true, "auto": true },
      { "cast": "Blaze", "targets": ["p1"], "answers": [4] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dual Strike", "Blaze"] },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "ruling: copies a non-targeting instant (Brainstorm) too: two resolutions draw 6 and put back 4 (hand 2, not 1)",
    "players": [
      {
        "hand": ["Dual Strike", "Brainstorm"],
        "battlefield": ["Mountain", "Mountain", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Dual Strike" },
      { "resolve": true, "auto": true },
      { "cast": "Brainstorm" },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 2 },
        {}
      ]
    }
  },
  {
    "name": "ruling: foretelling is a special action that can be taken while a spell is on the stack",
    "players": [
      {
        "hand": ["Lightning Bolt", "Dual Strike"],
        "battlefield": ["Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Dual Strike", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Dual Strike"], "hand_count": 0 },
        { "life": 17 }
      ]
    }
  }
