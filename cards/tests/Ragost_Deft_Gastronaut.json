[
 {
  "name": "sacrifice a Food to deal 3 damage to each opponent",
  "players": [
   {
    "battlefield": [
     "Ragost, Deft Gastronaut",
     "Sol Ring",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Main1"
   },
   {
    "advance_to": "Main1"
   },
   {
    "activate": "Ragost, Deft Gastronaut",
    "ability": 0
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Ragost, Deft Gastronaut"
     ],
