 },
 {
  "name": "cannot sacrifice a Food when you control none",
  "players": [
   {
    "battlefield": [
     "Ragost, Deft Gastronaut",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Main1"
   },
   {
    "advance_to": "Main1"
   },
   {
    "activate": "Ragost, Deft Gastronaut",
    "ability": 0,
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Ragost, Deft Gastronaut",
      "Mountain"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "end step untaps Ragost after you gained life this turn",
  "players": [
   {
    "life": 20,
    "battlefield": [
     { "name": "Ragost, Deft Gastronaut", "tapped": true },
     "Sol Ring",
     "Mountain",
     "Plains",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   { "activate": "Sol Ring", "ability": 32768 },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 23, "battlefield_has": ["Ragost, Deft Gastronaut"] },
    {}
   ],
   "tapped": { "Ragost, Deft Gastronaut": false }
  }
 },
 {
  "name": "Ragost stays tapped at end step when no life was gained this turn",
  "players": [
   {
    "battlefield": [
     { "name": "Ragost, Deft Gastronaut", "tapped": true },
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    {}
   ],
   "tapped": { "Ragost, Deft Gastronaut": true }
  }
 },
 {
  "name": "ruling: life gained during the end step is too late to untap Ragost",
  "players": [
    {
      "battlefield": [
        { "name": "Ragost, Deft Gastronaut", "tapped": true },
        "Sol Ring",
        "Mountain",
        "Plains",
        "Forest"
      ]
    },
    {}
  ],
  "steps": [
    { "advance_to": "End" },
    { "activate": "Sol Ring", "ability": 32768 },
    { "resolve": true }
  ],
  "expect": {
    "players": [ { "life": 23 }, {} ],
    "tapped": { "Ragost, Deft Gastronaut": true }
  }
 },
 {
  "name": "ruling: a Food cannot pay for its own ability and also for Ragost's sacrifice cost",
  "players": [
    {
      "battlefield": [ "Ragost, Deft Gastronaut", "Sol Ring", "Mountain", "Plains", "Forest" ]
    },
    {}
  ],
  "steps": [
    { "activate": "Sol Ring", "ability": 32768 },
    { "activate": "Ragost, Deft Gastronaut", "ability": 0, "illegal": true },
    { "resolve": true }
  ],
  "expect": {
    "players": [ { "life": 23, "graveyard": ["Sol Ring"] }, { "life": 20 } ]
  }
 },
 {
  "name": "ruling: a Food artifact keeps its own mana ability",
  "players": [
    {
      "hand": ["Grizzly Bears"],
      "battlefield": ["Ragost, Deft Gastronaut", "Sol Ring", "Forest"]
    },
    {}
  ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": {
    "players": [ { "battlefield_has": ["Grizzly Bears", "Sol Ring"] }, {} ],
    "tapped": { "Sol Ring": true, "Forest": true }
  }
 }
]
