    "expect": { "players": [ { "graveyard_has": ["Nadier, Agent of the Duskenel"], "battlefield": ["Mountain", "Mountain", "Elf Warrior 1-1 Green", "Elf Warrior 1-1 Green", "Elf Warrior 1-1 Green", "Elf Warrior 1-1 Green"] }, {} ] } }
