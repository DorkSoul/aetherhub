  { "name": "ruling: the token count uses Nadier's power as it last was on the battlefield (4, not its base 3)",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", { "name": "Nadier, Agent of the Duskenel", "counters": { "+1/+1": 1 } }] }, {} ],
