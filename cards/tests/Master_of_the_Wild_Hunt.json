   "steps": [ { "activate": "Master of the Wild Hunt", "ability": 0, "targets": ["Serra Angel"] }, { "resolve": true, "answers": [1] } ],
   "expect": { "players": [ { "battlefield_has": ["Master of the Wild Hunt", "Wolf 2-2"], "battlefield_lacks": ["Wolf 3-2"] }, { "graveyard": ["Serra Angel"] } ], "tapped": { "Wolf 2-2": true } } },
 { "name": "any number of Wolves: the whole damage can go to one Wolf",
