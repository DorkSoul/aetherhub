[
  {
    "name": "ETB damage equals creatures you control",
    "players": [
      {
        "hand": [
          "Foundry Champion"
        ],
        "battlefield": [
          "Grizzly Bears",
          "Mountain",
          "Plains",
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Foundry Champion"
      },
      {
        "resolve": true,
        "targets": [
          "p1"
        ]
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "counts only creatures you control",
    "players": [
      {
        "hand": [
          "Foundry Champion"
        ],
        "battlefield": [
          "Mountain",
          "Plains",
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Foundry Champion"
      },
      {
        "resolve": true,
        "targets": [
          "p1"
        ]
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 19
        }
      ]
    }
  },
  {
    "name": "{R}: gets +1/+0 until end of turn",
    "players": [ {"battlefield": ["Foundry Champion", "Mountain"]}, {} ],
    "steps": [ {"activate": "Foundry Champion", "ability": 0}, {"resolve": true} ],
    "expect": {"players": [{}, {}], "pt": {"Foundry Champion": [5, 4]}}
  },
  {
    "name": "{W}: gets +0/+1 until end of turn",
    "players": [ {"battlefield": ["Foundry Champion", "Plains"]}, {} ],
    "steps": [ {"activate": "Foundry Champion", "ability": 1}, {"resolve": true} ],
    "expect": {"players": [{}, {}], "pt": {"Foundry Champion": [4, 5]}}
  },
  {
    "name": "without mana the {W} ability cannot be activated",
    "players": [ {"battlefield": ["Foundry Champion"]}, {} ],
    "steps": [ {"activate": "Foundry Champion", "ability": 1, "illegal": true} ],
    "expect": {"players": [{}, {}], "pt": {"Foundry Champion": [4, 4]}}
  },
  {
    "name": "ruling: the creature count is taken on resolution (Bears killed in response: 1 damage, not 2)",
    "players": [
      {
        "hand": ["Foundry Champion"],
        "battlefield": ["Grizzly Bears", "Mountain", "Plains", "Forest", "Forest", "Forest", "Forest"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Foundry Champion" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true, "targets": ["p1"] },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        { "life": 19 }
      ]
    }
  }
]