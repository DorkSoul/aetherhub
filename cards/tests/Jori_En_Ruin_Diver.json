[
  {"name": "second spell each turn draws a card",
   "players": [{"hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Jori En, Ruin Diver", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 1}, {"life": 14}]}},
  {"name": "first spell of the turn does not draw",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Jori En, Ruin Diver", "Mountain"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 0}, {"life": 17}]}},
  {"name": "third spell does not draw again",
   "players": [{"hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Jori En, Ruin Diver", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 1}, {"life": 11}]}},
  {"name": "ruling: the trigger happens when the second spell is cast, even while the first is still on the stack",
   "players": [{"hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Jori En, Ruin Diver", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 1}, {"life": 14}]}},
  {"name": "ruling: Jori En must be on the battlefield: casting it as the second spell does not draw",
   "players": [{"hand": ["Lightning Bolt", "Jori En, Ruin Diver"], "battlefield": ["Mountain", "Mountain", "Mountain", "Island"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Jori En, Ruin Diver"}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 0, "battlefield_has": ["Jori En, Ruin Diver"]}, {"life": 17}]}}
]
