[
  {
    "name": "monstrosity adds three counters; each player sacrifices three lands",
    "players": [
      {
        "battlefield": ["Ember Swallower", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Forest", "Forest", "Forest"]
      }
    ],
    "steps": [
      { "activate": "Ember Swallower" },
      { "resolve": true, "auto": true },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "pt": { "Ember Swallower": [7, 8] },
      "counters": { "Ember Swallower": { "p1p1": 3 } },
      "players": [
        { "graveyard": ["Mountain", "Mountain", "Mountain"] },
        { "battlefield": [], "graveyard": ["Forest", "Forest", "Forest"] }
      ]
    }
  },
  {
    "name": "not enough mana to activate monstrosity",
    "players": [
      {
        "battlefield": ["Ember Swallower", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [{ "activate": "Ember Swallower", "illegal": true }],
    "expect": {}
  },
  {
    "name": "ruling: Ember dies in response to monstrosity, so the becomes-monstrous trigger does not happen",
    "players": [
      { "battlefield": ["Ember Swallower", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "activate": "Ember Swallower" },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Ember Swallower"], "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Ember Swallower"], "player": 1 },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Ember Swallower"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
        { "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Mountain"] }
      ]
    }
  },
  {
    "name": "ruling: already monstrous, a second monstrosity activation does nothing (no counters, no second sacrifice)",
    "players": [
      { "battlefield": ["Ember Swallower", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Ember Swallower" },
      { "resolve": true, "auto": true },
      { "resolve": true, "auto": true },
      { "activate": "Ember Swallower" },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "pt": { "Ember Swallower": [7, 8] },
      "counters": { "Ember Swallower": { "p1p1": 3 } }
    }
  }
]
