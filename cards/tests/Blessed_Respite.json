[
  { "name": "shuffles your own graveyard into your library (the spell itself ends in the graveyard)",
    "players": [ { "hand": ["Blessed Respite"], "battlefield": ["Forest", "Forest"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Blessed Respite", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blessed Respite"], "library_count": 21 }, {} ] } },
  { "name": "shuffles an opponent's graveyard into their library",
    "players": [ { "hand": ["Blessed Respite"], "battlefield": ["Forest", "Forest"] }, { "graveyard": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Blessed Respite", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blessed Respite"] }, { "graveyard": [], "library_count": 21 } ] } },
  { "name": "ruling: cast with an empty graveyard still prevents this turn's combat damage",
    "players": [ { "hand": ["Blessed Respite"], "battlefield": ["Forest", "Forest", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [
      { "cast": "Blessed Respite", "targets": ["p1"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20, "graveyard": [] } ] } }
]
