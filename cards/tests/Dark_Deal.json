[
  { "name": "each player discards the whole hand and draws one fewer than the number discarded",
    "players": [
      { "hand": ["Dark Deal", "Lightning Bolt", "Island", "Forest"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears", "Mountain"] }
    ],
    "steps": [
      { "cast": "Dark Deal" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "hand_count": 2, "graveyard_has": ["Dark Deal", "Lightning Bolt", "Island", "Forest"] },
      { "hand_count": 1, "graveyard_has": ["Grizzly Bears", "Mountain"] }
    ] } },
  { "name": "a player with an empty hand discards nothing and draws nothing, even after another player discarded",
    "players": [
      { "hand": ["Dark Deal", "Island", "Island"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { }
    ],
    "steps": [
      { "cast": "Dark Deal" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "hand_count": 1 },
      { "hand_count": 0 }
    ] } },
  { "name": "holding only one card (the one discarded) draws nothing",
    "players": [
      { "hand": ["Dark Deal"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Dark Deal" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "hand_count": 0, "graveyard_has": ["Dark Deal"] },
      { "hand_count": 0, "graveyard_has": ["Mountain"] }
    ] } },
  { "name": "ruling: a player holding one card draws nothing; the other draws one fewer than the number discarded",
    "players": [
      { "hand": ["Dark Deal", "Island", "Island"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Dark Deal" },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "hand_count": 1, "graveyard_has": ["Dark Deal", "Island", "Island"] },
      { "hand_count": 0, "graveyard_has": ["Mountain"] }
    ] } }
]
