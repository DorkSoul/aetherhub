[
  {
    "name": "black creature cannot block",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Razorjaw Oni"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 18, "battlefield_has": ["Razorjaw Oni"] }
      ]
    }
  },
  {
    "name": "non-black creature can still block",
    "players": [
      { "battlefield": ["Razorjaw Oni"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Razorjaw Oni", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Razorjaw Oni" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Razorjaw Oni"], "life": 20 },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "black Oni's block is not applied: the unblocked Hill Giant hits, the Elves blocks Bears",
    "players": [
      { "battlefield": ["Hill Giant", "Grizzly Bears"] },
      { "battlefield": ["Razorjaw Oni", "Llanowar Elves"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Razorjaw Oni", "attacker": "Hill Giant" }, { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "battlefield_has": ["Razorjaw Oni"], "graveyard": ["Llanowar Elves"] }
      ]
    }
  }
]
