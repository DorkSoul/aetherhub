[
 {
  "name": "entering creates two 1/1 Human Soldier tokens",
  "players": [
   {
    "hand": ["White Glove Gourmand"],
    "battlefield": ["Plains", "Swamp", "Forest", "Forest"]
   },
   {}
  ],
  "steps": [
   {
    "cast": "White Glove Gourmand"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": ["Plains", "Swamp", "Forest", "Forest", "White Glove Gourmand", "Human Soldier", "Human Soldier"]
    }
   ]
  }
 },
 {
  "name": "no Human died this turn: no Food at the end step",
  "players": [
   {
    "battlefield": ["White Glove Gourmand", "Plains"]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": ["Food"],
     "battlefield_has": ["White Glove Gourmand"]
    }
   ]
  }
 },
 {
  "name": "another Human you control died this turn: Food at the end step",
  "players": [
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["White Glove Gourmand", "Human Soldier", "Mountain"]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": ["Human Soldier"]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": ["White Glove Gourmand", "Food"]
    }
   ]
  }
 },
 {
  "name": "ruling: two Humans die but only one Food is created at the end step",
  "players": [
   {
    "hand": ["Lightning Bolt", "Lightning Bolt"],
    "battlefield": ["White Glove Gourmand", "Human Soldier", "Human Soldier", "Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Human Soldier"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Human Soldier"] },
   { "resolve": true },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    {
     "battlefield": ["White Glove Gourmand", "Food", "Mountain", "Mountain"]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: the Gourmand need not have been on the battlefield when the Human died",
  "players": [
   {
    "hand": ["Lightning Bolt", "White Glove Gourmand"],
    "battlefield": ["Human Soldier", "Mountain", "Plains", "Swamp", "Forest", "Forest"]
   },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Human Soldier"] },
   { "resolve": true },
   { "cast": "White Glove Gourmand" },
   { "resolve": true },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": ["White Glove Gourmand", "Food"]
    },
    {}
   ]
  }
 },
 {
  "name": "a Human an opponent controls dying does not create Food",
  "players": [
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["White Glove Gourmand", "Mountain"]
   },
   {
    "battlefield": ["Human Soldier"]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": ["Human Soldier"]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": ["Food"],
     "battlefield_has": ["White Glove Gourmand"]
    },
    {}
   ]
  }
 }
]
