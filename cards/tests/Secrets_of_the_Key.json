[
  { "name": "investigates once from hand",
    "players": [ { "hand": ["Secrets of the Key"], "battlefield": ["Island"] }, {} ],
    "steps": [
      { "cast": "Secrets of the Key" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Secrets of the Key"], "battlefield_has": ["Clue"] }, {} ] } },
  { "name": "flashback: investigates twice and is exiled",
    "players": [ { "graveyard": ["Secrets of the Key"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Secrets of the Key", "alt": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Secrets of the Key"], "graveyard": [], "battlefield_has": ["Clue", "Clue"] }, {} ] } },
  { "name": "ruling: a flashback spell that is countered is still exiled",
    "players": [ { "graveyard": ["Secrets of the Key"], "battlefield": ["Island", "Island", "Island", "Island"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Secrets of the Key", "alt": 0 },
               { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Secrets of the Key" }] },
               { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Secrets of the Key"], "graveyard": [] }, { "graveyard": ["Counterspell"] } ], "stack_empty": true } },
  { "name": "ruling: flashback uses its full cost, so three lands are not enough",
    "players": [ { "graveyard": ["Secrets of the Key"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Secrets of the Key", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Secrets of the Key"] }, {} ] } }
]
