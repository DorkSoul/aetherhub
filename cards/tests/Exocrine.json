[
  {
    "name": "X=3 enters with three counters and deals 3 to each player and each other creature",
    "players": [
      { "hand": ["Exocrine"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Exocrine", "answers": [3] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "counters": { "Exocrine": { "p1p1": 3 } },
      "pt": { "Exocrine": [5, 5] },
      "players": [ { "life": 17, "battlefield_has": ["Exocrine"] }, { "life": 17, "graveyard_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "X=5 also draws a card when it enters",
    "players": [
      { "hand": ["Exocrine"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [ { "cast": "Exocrine", "answers": [5] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "pt": { "Exocrine": [7, 7] },
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "X=4 does not draw a card",
    "players": [
      { "hand": ["Exocrine"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [ { "cast": "Exocrine", "answers": [4] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "ruling: with Hardened Scales X=5 still draws a card, while the counters are 6 (the replacement applies after X is chosen)",
    "players": [
      { "hand": ["Exocrine"], "battlefield": ["Hardened Scales", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [ { "cast": "Exocrine", "answers": [5] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "counters": { "Exocrine": { "p1p1": 6 } },
      "pt": { "Exocrine": [8, 8] },
      "players": [ { "hand_count": 1 }, {} ]
    }
  }
]
