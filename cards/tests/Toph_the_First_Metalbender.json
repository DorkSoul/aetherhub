[
  { "name": "end step earthbend 2 makes the target land a 2/2 haste creature",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Plains"] }, {} ],
    "steps": [ { "advance_to": "End", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, the First Metalbender", "Plains"] }, {} ], "pt": { "Plains": [2, 2] }, "keywords": { "Plains": ["Haste"] }, "counters": { "Plains": { "p1p1": 2 } } } },
  { "name": "a nontoken artifact is a land and can be earthbent",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Sol Ring", "Forest"] }, {} ],
    "steps": [ { "advance_to": "End", "targets": ["Sol Ring"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sol Ring"] }, {} ], "pt": { "Sol Ring": [2, 2] }, "counters": { "Sol Ring": { "p1p1": 2 } } } },
  { "name": "a token artifact is not a land: no land to earthbend, no end step trigger",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Treasure"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure"] }, {} ], "stack_empty": true, "counters": {} } },
  { "name": "ruling: a land that is already a creature is earthbent again: counters stack and base P/T stays 0/0",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Plains"] }, {} ],
    "steps": [ { "advance_to": "End", "targets": ["Plains"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, the First Metalbender", "Plains"] }, {} ], "pt": { "Plains": [4, 4] }, "counters": { "Plains": { "p1p1": 4 } } } },
  { "name": "ruling: earthbend gives the land no colour, so the resulting creature stays colourless",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Plains"] }, {} ],
    "steps": [ { "advance_to": "End", "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Plains"] }, {} ], "pt": { "Plains": [2, 2] }, "colors": { "Plains": [] } } },
  { "name": "ruling: Toph's first ability does not let a nontoken artifact in hand be played as a land",
    "players": [ { "hand": ["Sol Ring"], "battlefield": ["Toph, the First Metalbender", "Forest"] }, {} ],
    "steps": [ { "play_land": "Sol Ring", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Sol Ring"], "battlefield_lacks": ["Sol Ring"] }, {} ] } },
  { "name": "ruling: an earthbent Forest keeps its Forest subtype and its mana ability",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Forest"] }, {} ],
    "steps": [ { "advance_to": "End", "targets": ["Forest"] }, { "resolve": true }, { "tap_for_mana": "Forest" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ], "subtypes": { "Forest": ["Forest"] } } },
  { "name": "ruling: an earthbent land that dies returns to the battlefield tapped",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "advance_to": "End", "targets": ["Plains"] }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Toph, the First Metalbender", "Plains"] }, { "graveyard": ["Lightning Bolt"] } ], "tapped": { "Plains": true } } },
  { "name": "ruling: an earthbent land returned to hand is not returned to the battlefield by the delayed trigger",
    "players": [ { "battlefield": ["Toph, the First Metalbender", "Plains"] }, { "hand": ["Unsummon"], "battlefield": ["Island"] } ],
    "steps": [ { "advance_to": "End", "targets": ["Plains"] }, { "resolve": true }, { "pass": true }, { "cast": "Unsummon", "player": 1, "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Plains"], "battlefield_lacks": ["Plains"] }, {} ] } }
]
