[
  {
    "name": "creates an Elf Warrior token at the beginning of each upkeep",
    "players": [
      {
        "battlefield": [
          "Wolverine Riders"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Elf Warrior 1-1 Green"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "gains life equal to the toughness of another Elf entering",
    "players": [
      {
        "hand": [
          "Woodland Mystic"
        ],
        "battlefield": [
          "Wolverine Riders",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Woodland Mystic"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 21,
          "battlefield_has": [
            "Woodland Mystic"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Elf's last known toughness is used once it has left the battlefield",
    "players": [
      { "hand": ["Woodland Mystic"], "battlefield": ["Wolverine Riders", "Forest", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Woodland Mystic" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Woodland Mystic"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "graveyard_has": ["Woodland Mystic"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]