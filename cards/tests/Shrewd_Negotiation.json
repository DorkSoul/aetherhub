[
  { "name": "exchanges control of my artifact and an opposing creature",
    "players": [ { "hand": ["Shrewd Negotiation"], "battlefield": ["Sol Ring", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Shrewd Negotiation", "targets": ["Sol Ring", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Sol Ring"] } ] } },
  { "name": "needs an artifact you control",
    "players": [ { "hand": ["Shrewd Negotiation"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Shrewd Negotiation", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Shrewd Negotiation"] }, {} ] } },
  { "name": "ruling: if the opposing target is gone on resolution, no exchange happens",
    "players": [ { "hand": ["Shrewd Negotiation", "Lightning Bolt"], "battlefield": ["Sol Ring", "Island", "Island", "Island", "Island", "Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Shrewd Negotiation", "targets": ["Sol Ring", "Grizzly Bears"] },
               { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
               { "pass": true }, { "pass": true, "player": 1 },
               { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sol Ring"], "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"] } ] } }
]
