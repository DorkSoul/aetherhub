[
  {
    "name": "gives nonsnow creatures -X/-X where X is your snow permanents",
    "players": [
      {
        "battlefield": [
          "Boreal Shelf",
          "Boreal Shelf",
          "Swamp"
        ],
        "hand": [
          "Dead of Winter"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Dead of Winter"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard_has": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Hill Giant"
          ]
        }
      ],
      "pt": {
        "Hill Giant": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "only your snow permanents count (opponent's snow land does not)",
    "players": [
      {
        "battlefield": [
          "Boreal Shelf",
          "Swamp",
          "Swamp"
        ],
        "hand": [
          "Dead of Winter"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Boreal Shelf"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Dead of Winter"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ],
      "pt": {
        "Grizzly Bears": [
          1,
          1
        ]
      }
    }
  },
  { "name": "ruling: a creature that enters after Dead of Winter resolves does not get -X/-X",
    "players": [
      { "battlefield": ["Boreal Shelf", "Boreal Shelf", "Swamp", "Forest", "Forest", "Forest"], "hand": ["Dead of Winter", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [ { "cast": "Dead of Winter" }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ], "pt": { "Grizzly Bears": [2, 2], "Hill Giant": [1, 1] } } },
  { "name": "ruling: X is fixed on resolution; a snow land played afterwards does not shrink the Hill Giant again",
    "players": [
      { "battlefield": ["Boreal Shelf", "Boreal Shelf", "Swamp"], "hand": ["Dead of Winter", "Boreal Shelf"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "cast": "Dead of Winter" }, { "resolve": true }, { "play_land": "Boreal Shelf" } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Hill Giant"] } ], "pt": { "Hill Giant": [1, 1] } } }
]
