  {
    "name": "upkeep trigger makes you sacrifice a creature at threshold",
    "players": [
      {
        "battlefield": [
          "Wayward Angel",
          "Grizzly Bears"
        ],
        "graveyard": [
          "Grizzly Bears",
          "Lightning Bolt",
          "Shock",
          "Giant Growth",
          "Dark Ritual",
          "Sol Ring",
          "Mind Stone"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep",
        "answers": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Wayward Angel"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "threshold: the Angel is black (SetColors)",
    "players": [ { "battlefield": ["Wayward Angel"], "graveyard": ["Lightning Bolt", "Shock", "Giant Growth", "Dark Ritual", "Sol Ring", "Mind Stone", "Island"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "colors": { "Wayward Angel": ["B"] } }
  },
  {
    "name": "below threshold the Angel stays white",
    "players": [ { "battlefield": ["Wayward Angel"], "graveyard": ["Lightning Bolt", "Shock", "Giant Growth"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "colors": { "Wayward Angel": ["W"] } }
  },
  {
    "name": "threshold grants the upkeep sacrifice: Grizzly Bears is sacrificed (no Bears in graveyard before)",
    "players": [ { "battlefield": ["Wayward Angel", "Grizzly Bears"], "graveyard": ["Lightning Bolt", "Shock", "Giant Growth", "Dark Ritual", "Sol Ring", "Mind Stone", "Island"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Wayward Angel"], "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "below threshold there is no upkeep sacrifice",
    "players": [ { "battlefield": ["Wayward Angel", "Grizzly Bears"], "graveyard": ["Lightning Bolt", "Shock", "Giant Growth"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "battlefield_has": ["Wayward Angel", "Grizzly Bears"] }, {} ] }
  },
  {
    "name": "ruling: at threshold the Angel is black, not white and black",
    "players": [ { "battlefield": ["Wayward Angel"], "graveyard": ["Lightning Bolt", "Shock", "Giant Growth", "Dark Ritual", "Sol Ring", "Mind Stone", "Island"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "colors": { "Wayward Angel": ["B"] } }
  }
