[
  {
    "name": "enchanted creature becomes base 0/4",
    "players": [
      {
        "hand": [
          "Lignify"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lignify",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          0,
          4
        ]
      }
    }
  },
  {
    "name": "enchanted creature loses its abilities (flying)",
    "players": [
      {
        "hand": [
          "Lignify"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Serra Angel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lignify",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Serra Angel": [
          0,
          4
        ]
      },
      "keywords": {
        "Serra Angel": []
      }
    }
  },
  {
    "name": "other creatures are unaffected",
    "players": [
      {
        "hand": [
          "Lignify"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Grizzly Bears",
          "Hill Giant"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lignify",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Hill Giant": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "abilities granted after Lignify still apply (Acrobatic Leap gives flying)",
    "players": [
      {
        "hand": [
          "Lignify",
          "Acrobatic Leap"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Plains",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lignify",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Acrobatic Leap",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          1,
          7
        ]
      },
      "keywords": {
        "Grizzly Bears": [
          "Flying"
        ]
      }
    }
  },
 {
  "name": "ruling: Lignify overwrites the static ability of the creature itself (Elvish Archdruid's Elf bonus is lost)",
  "players": [
   { "hand": ["Lignify"], "battlefield": ["Forest", "Forest", "Elvish Archdruid", "Llanowar Elves"] },
   {}
  ],
  "steps": [
   { "cast": "Lignify", "targets": ["Elvish Archdruid"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Llanowar Elves": [1, 1], "Elvish Archdruid": [0, 4] }
  }
 },
 {
  "name": "ruling: when Lignify leaves, the creature reverts but Giant Growth still applies",
  "players": [
   { "hand": ["Lignify", "Giant Growth", "Disenchant"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lignify", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Disenchant", "targets": ["Lignify"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Lignify", "Disenchant"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ],
   "pt": { "Grizzly Bears": [5, 5] }
  }
 },
 {
  "name": "ruling: Giant Growth applied after Lignify is not overwritten (0/4 becomes 3/7)",
  "players": [
   { "hand": ["Lignify", "Giant Growth"], "battlefield": ["Forest", "Forest", "Forest"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lignify", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [3, 7] }
  }
 },
 {
  "name": "ruling: Lignify makes the creature a Treefolk, replacing its other creature types",
  "players": [
   { "hand": ["Lignify"], "battlefield": ["Forest", "Forest"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lignify", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "subtypes": { "Grizzly Bears": ["Treefolk"] },
   "not_subtypes": { "Grizzly Bears": ["Bear"] }
  }
 },
 {
  "name": "ruling: Lignify overwrites a characteristic-defining power and toughness (Dauntless Dourbark becomes 0/4)",
  "players": [
   { "hand": ["Lignify"], "battlefield": ["Dauntless Dourbark", "Forest", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Lignify", "targets": ["Dauntless Dourbark"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Dauntless Dourbark": [0, 4] }
  }
 }
]