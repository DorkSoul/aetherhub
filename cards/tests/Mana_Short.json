[
  {
    "name": "taps all lands the target opponent controls, not the caster's",
    "players": [
      { "hand": ["Mana Short"], "battlefield": ["Island", "Island", "Island", "Swamp"] },
      { "battlefield": ["Forest", "Mountain"] }
    ],
    "steps": [
      { "cast": "Mana Short", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Forest": true, "Mountain": true, "Swamp": false }
    }
  },
  {
    "name": "targeting yourself taps your own non-mana lands too",
    "players": [
      { "hand": ["Mana Short"], "battlefield": ["Island", "Island", "Island", "Plains"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Mana Short", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Plains": true, "Forest": false }
    }
  },
  {
    "name": "ruling: Mana Short cast in response to a spell does not stop that spell (its mana is already paid)",
    "players": [
      { "hand": ["Mana Short"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Forest"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Mana Short", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Forest": true },
      "players": [ { "life": 17 }, {} ]
    }
  },
  {
    "name": "ruling: an instant cast in response to Mana Short resolves first, Mana Short still taps the lands",
    "players": [
      { "hand": ["Mana Short"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Forest"] }
    ],
    "steps": [
      { "cast": "Mana Short", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Forest": true },
      "players": [ { "life": 17 }, {} ]
    }
  }
]
