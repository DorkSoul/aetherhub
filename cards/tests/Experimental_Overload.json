[
  { "name": "X/X token with X = instants and sorceries in graveyard; return one of them",
    "players": [ { "hand": ["Experimental Overload"], "battlefield": ["Island", "Mountain", "Island", "Mountain"], "graveyard": ["Lightning Bolt", "Counterspell"] }, {} ],
    "steps": [ { "cast": "Experimental Overload" }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"], "graveyard": ["Counterspell"], "exile": ["Experimental Overload"], "battlefield_has": ["Weird 0-0 Blue Red"] }, {} ], "pt": { "Weird 0-0 Blue Red": [2, 2] } } },
  { "name": "may return: declining keeps the graveyard",
    "players": [ { "hand": ["Experimental Overload"], "battlefield": ["Island", "Mountain", "Island", "Mountain"], "graveyard": ["Lightning Bolt", "Counterspell"] }, {} ],
    "steps": [ { "cast": "Experimental Overload" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Counterspell"], "exile": ["Experimental Overload"] }, {} ], "pt": { "Weird 0-0 Blue Red": [2, 2] } } },
  { "name": "ruling: Overload on the stack does not count toward X",
    "players": [ { "hand": ["Experimental Overload"], "battlefield": ["Island", "Mountain", "Island", "Mountain"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Experimental Overload" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Weird 0-0 Blue Red": [1, 1] } } },
  { "name": "ruling: later graveyard growth does not change the Weird's P/T",
    "players": [ { "hand": ["Experimental Overload", "Shock"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Lightning Bolt", "Counterspell"] }, {} ],
    "steps": [ { "cast": "Experimental Overload" }, { "resolve": true }, { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Shock"] }, { "life": 18 } ], "pt": { "Weird 0-0 Blue Red": [2, 2] } } }
]
