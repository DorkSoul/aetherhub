[
  { "name": "exiles the cards in hand when it enters",
    "players": [ { "hand": ["Wormfang Behemoth", "Lightning Bolt", "Grizzly Bears"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Wormfang Behemoth" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Wormfang Behemoth"], "exile": ["Lightning Bolt", "Grizzly Bears"] }, {} ] } },
  { "name": "returns the exiled cards to hand when it leaves the battlefield",
    "players": [ { "hand": ["Wormfang Behemoth", "Lightning Bolt", "Grizzly Bears"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
                 { "hand": ["Swords to Plowshares"], "battlefield": ["Plains"] } ],
    "steps": [ { "cast": "Wormfang Behemoth" }, { "resolve": true },
               { "pass": true },
               { "cast": "Swords to Plowshares", "player": 1, "targets": ["Wormfang Behemoth"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "battlefield_lacks": ["Wormfang Behemoth"] }, {} ] } }
]
