      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hushbringer"], "exile": ["Grizzly Bears"] },
        { "graveyard": ["Lightning Bolt"], "battlefield_has": ["Leyline of the Void"] }
      ]
    }
  },
