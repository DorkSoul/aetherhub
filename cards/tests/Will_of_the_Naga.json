[
 {
  "name": "taps a target creature for six mana with delve paid by the mana",
  "players": [ { "hand": ["Will of the Naga"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "cast": "Will of the Naga", "targets": ["Grizzly Bears"] },
    { "resolve": true }
  ],
  "expect": { "tapped": { "Grizzly Bears": true }, "players": [ { "graveyard": ["Will of the Naga"] }, {} ] }
 },
 {
  "name": "the tapped creature does not untap during its controller's next untap step",
  "players": [ { "hand": ["Will of the Naga"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "cast": "Will of the Naga", "targets": ["Grizzly Bears"] },
    { "resolve": true },
    { "advance_to": "Main1" }
  ],
  "expect": { "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "ruling: an already tapped target is still affected and does not untap during its controller's next untap step",
  "players": [ { "hand": ["Will of the Naga"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
  "steps": [
    { "cast": "Will of the Naga", "targets": ["Grizzly Bears"] },
    { "resolve": true },
    { "advance_to": "Main1" }
  ],
  "expect": { "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "ruling: if one target is gone on resolution, the other is still tapped and skips its untap step",
  "players": [ { "hand": ["Will of the Naga"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
               { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears", "Hill Giant"] } ],
  "steps": [
    { "cast": "Will of the Naga", "targets": ["Grizzly Bears", "Hill Giant"] },
    { "pass": true },
    { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
    { "pass": true, "player": 1 },
    { "resolve": true },
    { "resolve": true },
    { "advance_to": "Main1" }
  ],
  "expect": { "tapped": { "Grizzly Bears": true }, "players": [ {}, { "graveyard": ["Hill Giant", "Lightning Bolt"] } ] }
 },
 {
  "name": "ruling: delve exiles at most the generic amount; four exiled cards pay {4} and two Islands pay {U}{U}",
  "players": [ { "hand": ["Will of the Naga"], "battlefield": ["Island", "Island"], "graveyard": ["Forest", "Lightning Bolt", "Divination", "Counterspell", "Mulldrifter", "Plains"] },
               { "battlefield": ["Hill Giant"] } ],
  "steps": [
    { "cast": "Will of the Naga", "targets": ["Hill Giant"], "answers": [["Forest", "Lightning Bolt", "Divination", "Counterspell"]] },
    { "resolve": true }
  ],
  "expect": { "tapped": { "Hill Giant": true }, "players": [ { "graveyard_has": ["Mulldrifter", "Plains", "Will of the Naga"] }, {} ] }
 }
]
