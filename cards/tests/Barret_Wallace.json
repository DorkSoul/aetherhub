[
  {
    "name": "attack trigger deals 1 to defending player per equipped creature you control",
    "players": [
      { "battlefield": ["Barret Wallace", "Bonesplitter", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Barret Wallace"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Barret Wallace", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 13 }]
    }
  },
  {
    "name": "no equipped creature: trigger deals no damage (combat damage only)",
    "players": [
      { "battlefield": ["Barret Wallace"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Barret Wallace", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  },
  {
    "name": "ruling: the attack trigger counts equipped creatures when it resolves, not when it triggers",
    "players": [
      { "battlefield": ["Barret Wallace", "Grizzly Bears", "Bonesplitter", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Barret Wallace", "at": "p1" }] },
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  }
]
