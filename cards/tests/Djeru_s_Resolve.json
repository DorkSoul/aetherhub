[
 { "name": "untaps the target creature",
   "players": [ { "hand": ["Djeru's Resolve"], "battlefield": ["Plains"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "cast": "Djeru's Resolve", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Djeru's Resolve"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": false } } },
 { "name": "prevents all damage dealt to the target this turn",
   "players": [ { "hand": ["Djeru's Resolve", "Lightning Bolt"], "battlefield": ["Plains", "Mountain"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "cast": "Djeru's Resolve", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "cycling for 2 draws a card",
   "players": [ { "hand": ["Djeru's Resolve"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "activate": "Djeru's Resolve" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Djeru's Resolve"], "hand_count": 1 }, {} ] } },
 { "name": "ruling: untapping an attacking creature does not remove it from combat",
   "players": [ { "hand": ["Djeru's Resolve"], "battlefield": ["Plains", "Grizzly Bears"] }, {} ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "cast": "Djeru's Resolve", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ], "tapped": { "Grizzly Bears": false } } },
 { "name": "ruling: an untapped creature can be targeted and its damage is still prevented",
   "players": [ { "hand": ["Djeru's Resolve", "Lightning Bolt"], "battlefield": ["Plains", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Djeru's Resolve", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard_has": ["Lightning Bolt"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": false } } }
]
