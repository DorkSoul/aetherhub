[
 {
  "name": "tap: target Assembly-Worker gets +1/+1 until end of turn (itself)",
  "players": [
   {
    "battlefield": [
     {
      "name": "Assembly-Worker",
      "sick": false
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Assembly-Worker",
    "targets": [
     "Assembly-Worker"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Assembly-Worker": [
     3,
     3
    ]
   },
   "tapped": {
    "Assembly-Worker": true
   }
  }
 },
 {
  "name": "ruling: can target another creature with the Assembly-Worker subtype (not only one named Assembly-Worker)",
  "players": [
   {
    "battlefield": [
     { "name": "Assembly-Worker", "sick": false },
     { "name": "Mine Worker", "sick": false }
    ]
   },
   {}
  ],
  "steps": [
   { "activate": "Assembly-Worker", "targets": ["Mine Worker"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Mine Worker": [3, 2], "Assembly-Worker": [2, 2] },
   "tapped": { "Assembly-Worker": true, "Mine Worker": false }
  }
 }
]
