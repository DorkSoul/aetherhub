[
 {
  "name": "inspired: exchanges a creature for an opponent's creature",
  "players": [
   {
    "battlefield": [
     {
      "name": "Daring Thief",
      "tapped": true
     },
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep",
    "targets": [
     "Grizzly Bears",
     "Hill Giant"
    ],
    "answers": [
     true
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Daring Thief",
      "Hill Giant"
     ]
    },
    {
     "battlefield_has": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "no permanent sharing a card type: nothing is exchanged",
  "players": [
   {
    "battlefield": [
     {
      "name": "Daring Thief",
      "tapped": true
     },
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "advance_to": "Upkeep",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Daring Thief",
      "Grizzly Bears"
     ]
    },
    {
     "battlefield_has": [
      "Island"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: untapped by a spell still triggers inspired, and the exchange happens on resolution",
  "players": [
   { "hand": ["Djeru's Resolve"], "battlefield": ["Plains", { "name": "Daring Thief", "tapped": true }, "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Djeru's Resolve", "targets": ["Daring Thief"] },
   { "resolve": true, "targets": ["Grizzly Bears"], "answers": [true] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Daring Thief", "Hill Giant"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: the exchange of control lasts after Daring Thief leaves the battlefield",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Daring Thief", "tapped": true }, "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep", "targets": ["Grizzly Bears"], "answers": [true] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Daring Thief"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Daring Thief"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: the exchange still happens when Daring Thief leaves the battlefield in response",
  "players": [
   { "battlefield": ["Mountain", { "name": "Daring Thief", "tapped": true }, "Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] }
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep", "targets": ["Grizzly Bears"], "answers": [true] },
   { "pass": true },
   { "player": 1, "cast": "Lightning Bolt", "targets": ["Daring Thief"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Daring Thief"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: entering the battlefield does not trigger inspired",
  "players": [
   { "hand": ["Daring Thief"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Daring Thief" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Daring Thief", "Grizzly Bears"] },
    { "battlefield_has": ["Hill Giant"] }
   ]
  }
 }
]