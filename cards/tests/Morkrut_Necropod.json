[
  {
    "name": "attacking: sacrifice the only other choice (a land)",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Morkrut Necropod"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Morkrut Necropod",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Swamp"
          ],
          "battlefield_lacks": [
            "Swamp"
          ]
        },
        {
          "life": 13
        }
      ]
    }
  },
  {
    "name": "attacking: choose which creature or land to sacrifice",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Grizzly Bears",
          "Morkrut Necropod"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Morkrut Necropod",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true,
        "answers": [
          "Grizzly Bears"
        ]
      },
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Swamp"
          ]
        },
        {
          "life": 13
        }
      ]
    }
  },
  {
    "name": "blocking: sacrifice the creature chosen from the list",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Savannah Lions",
          "Morkrut Necropod"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ] },
      { "block": [ { "blocker": "Morkrut Necropod", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true, "answers": ["Savannah Lions"] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Savannah Lions"], "battlefield_has": ["Swamp", "Morkrut Necropod"], "life": 20 },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "blocking: the necropod is never its own sacrifice choice",
    "players": [
      {
        "battlefield": [
          "Savannah Lions",
          "Morkrut Necropod"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ] },
      { "block": [ { "blocker": "Morkrut Necropod", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Savannah Lions"], "battlefield_has": ["Morkrut Necropod"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: with no other creature or land to sacrifice the trigger does nothing and the Necropod attacks normally",
    "players": [ { "battlefield": ["Morkrut Necropod"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Morkrut Necropod", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Morkrut Necropod"] }, { "life": 13 } ] }
  },
  {
    "name": "ruling: the sacrifice happens after all attackers are declared, so another attacker can be sacrificed",
    "players": [ { "battlefield": ["Swamp", "Savannah Lions", "Morkrut Necropod"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Morkrut Necropod", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
      { "resolve": true, "answers": ["Savannah Lions"] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Savannah Lions"], "battlefield_has": ["Swamp", "Morkrut Necropod"] },
        { "life": 13 }
      ]
    }
  }
]
