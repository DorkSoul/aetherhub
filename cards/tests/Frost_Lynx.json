[
  {
    "name": "taps the target and it stays tapped through its controller's next untap step",
    "players": [
      { "hand": ["Frost Lynx"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Frost Lynx" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "untaps in the following untap step",
    "players": [
      { "hand": ["Frost Lynx"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Frost Lynx" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": { "tapped": { "Grizzly Bears": false } }
  },
  {
    "name": "only creatures an opponent controls can be chosen",
    "players": [
      { "hand": ["Frost Lynx"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Frost Lynx" },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": false } }
  },
  {
    "name": "ruling: can target an already tapped creature, which stays tapped through its controller's next untap step",
    "players": [
      { "hand": ["Frost Lynx"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Frost Lynx" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  }
]
