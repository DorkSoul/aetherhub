      {}
    ],
    "steps": [
      {
        "cast": "Way of the Paradox"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Way of the Paradox",
            "Jace"
          ]
        },
        {}
      ],
      "counters": {
        "Jace": {
          "loyalty": 5
        }
      }
    }
  },
  {
    "name": "activating a loyalty ability gains 1 life",
