[
  { "name": "enters: creates a Food token",
    "players": [ { "hand": ["Elanor Gardner"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Elanor Gardner" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Elanor Gardner", "Food"] }, {} ] } },
  { "name": "end step after sacrificing a Food: may search for a basic land tapped",
    "players": [ { "battlefield": ["Elanor Gardner", "Food", "Forest", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Food", "ability": 0 }, { "resolve": true }, { "advance_to": "End", "answers": [true, "Mountain"] } ],
    "expect": { "players": [ { "battlefield_has": ["Elanor Gardner", "Mountain"] }, {} ], "tapped": { "Mountain": true } } },
  { "name": "end step without sacrificing a Food: no search",
    "players": [ { "battlefield": ["Elanor Gardner", "Forest", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Elanor Gardner", "Forest", "Forest"] }, {} ] } },
  { "name": "ruling: sacrificing two Foods still searches only once",
    "players": [ { "battlefield": ["Elanor Gardner", "Food", "Food", "Forest", "Forest", "Forest", "Forest"], "library": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Food", "ability": 0 }, { "resolve": true }, { "activate": "Food", "ability": 0 }, { "resolve": true }, { "advance_to": "End", "answers": [true, "Mountain"] } ],
    "expect": { "players": [ { "battlefield_has": ["Elanor Gardner", "Mountain"], "library_count": 1 }, {} ] } },
  { "name": "ruling: Elanor cast after the Food was sacrificed still searches at the end step",
    "players": [ { "hand": ["Elanor Gardner"], "battlefield": ["Food", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Food", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" }, { "cast": "Elanor Gardner" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End", "answers": [true, "Mountain"] } ],
    "expect": { "players": [ { "battlefield_has": ["Elanor Gardner", "Mountain"] }, {} ] } },
  { "name": "ruling: sacrificing a Food artifact creature (Tough Cookie) counts as sacrificing a Food",
    "players": [ { "battlefield": ["Elanor Gardner", "Maraleaf Rider", "Tough Cookie", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Elanor Gardner"] }, { "resolve": true }, { "advance_to": "End", "answers": [true, "Mountain"] } ],
    "expect": { "players": [ { "battlefield_has": ["Elanor Gardner", "Mountain"], "battlefield_lacks": ["Tough Cookie"], "graveyard_has": ["Tough Cookie"] }, {} ] } }
]
