[
  {"name": "mills X, where X is the number of creatures with defender you control",
   "players": [{"battlefield": ["Doorkeeper", "Wall of Stone", "Island", "Island", "Island"]}, {}],
   "steps": [{"activate": "Doorkeeper", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{}, {"library_count": 18}], "tapped": {"Doorkeeper": true}}},
  {"name": "non-defender creatures are not counted",
   "players": [{"battlefield": ["Doorkeeper", "Grizzly Bears", "Island", "Island", "Island"]}, {}],
   "steps": [{"activate": "Doorkeeper", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{}, {"library_count": 19}]}},
  {"name": "ruling: the defender count is taken on resolution, so a defender killed in response is not counted",
   "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Doorkeeper", "Wall of Wood", "Island", "Island", "Island", "Mountain"]}, {}],
   "steps": [
     {"activate": "Doorkeeper", "targets": ["p1"]},
     {"cast": "Lightning Bolt", "targets": ["Wall of Wood"]},
     {"pass": true},
     {"pass": true, "player": 1},
     {"resolve": true}
   ],
   "expect": {"players": [{"graveyard_has": ["Lightning Bolt", "Wall of Wood"], "battlefield_has": ["Doorkeeper"]}, {"library_count": 19}]}}
]
