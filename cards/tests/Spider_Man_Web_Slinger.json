[
  { "name": "web-slinging: returns a tapped creature and costs only W",
    "players": [ { "hand": ["Spider-Man, Web-Slinger"], "battlefield": ["Plains", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Spider-Man, Web-Slinger", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Spider-Man, Web-Slinger"], "hand": ["Grizzly Bears"] }, {} ] } },
  { "name": "web-slinging needs a tapped creature to return",
    "players": [ { "hand": ["Spider-Man, Web-Slinger"], "battlefield": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Spider-Man, Web-Slinger", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Spider-Man, Web-Slinger"] }, {} ] } },
  { "name": "normal cost {2}{W} without web-slinging",
    "players": [ { "hand": ["Spider-Man, Web-Slinger"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Spider-Man, Web-Slinger" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Spider-Man, Web-Slinger"] }, {} ] } },
  { "name": "ruling: web-slinging follows normal timing, so it cannot be cast during combat",
    "players": [ { "hand": ["Spider-Man, Web-Slinger"], "battlefield": ["Plains", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Spider-Man, Web-Slinger", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a creature tapped for mana can still be returned to pay web-slinging",
    "players": [ { "hand": ["Spider-Man, Web-Slinger"], "battlefield": ["Birds of Paradise"] }, {} ],
    "steps": [ { "tap_for_mana": "Birds of Paradise", "color": "W" }, { "cast": "Spider-Man, Web-Slinger", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Spider-Man, Web-Slinger"], "hand": ["Birds of Paradise"] }, {} ] } }
]
