    "players": [
      { "battlefield": [ { "name": "Dimir Doppelganger", "sick": false }, "Island", "Swamp", "Swamp" ] },
      { "graveyard": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Dimir Doppelganger" },
      { "resolve": true }
    ],
