    "expect": {
      "players": [ { "battlefield": ["Dimir Doppelganger", "Island", "Swamp", "Swamp"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  },
  {
    "name": "ruling: a copy of a copy overwrites the earlier copy: P/T follows the newest copied card",
    "players": [
      { "battlefield": [ { "name": "Dimir Doppelganger", "sick": false }, "Island", "Swamp", "Swamp", "Island", "Swamp", "Swamp" ] },
      { "graveyard": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Dimir Doppelganger", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Hill Giant", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "exile": ["Hill Giant", "Grizzly Bears"] } ],
