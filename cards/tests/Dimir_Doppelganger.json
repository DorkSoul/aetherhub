      { "battlefield": [ { "name": "Dimir Doppelganger", "sick": false }, "Island", "Swamp", "Swamp", "Island", "Swamp", "Swamp" ] },
      { "graveyard": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Dimir Doppelganger", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Hill Giant", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield": ["Grizzly Bears", "Island", "Swamp", "Swamp", "Island", "Swamp", "Swamp"] }, { "exile": ["Hill Giant", "Grizzly Bears"] } ]
    }
  },
  {
    "name": "no creature card in any graveyard: the ability has no legal target and cannot be activated",
    "players": [
      { "battlefield": [ { "name": "Dimir Doppelganger", "sick": false }, "Island", "Swamp", "Swamp" ] },
      { "graveyard": ["Lightning Bolt"] }
