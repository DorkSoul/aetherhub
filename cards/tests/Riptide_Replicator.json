[
  {
    "name": "enters with X charge counters and chooses a color and type",
    "players": [{ "hand": ["Riptide Replicator"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [{ "cast": "Riptide Replicator", "answers": [2] }, { "resolve": true, "answers": ["U", "Elf"] }],
    "expect": {
      "counters": { "Riptide Replicator": { "charge": 2 } }
    }
  },
  {
    "name": "{4},{T}: creates an X/X token where X is the charge counter count",
    "players": [{ "hand": ["Riptide Replicator"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [
      { "cast": "Riptide Replicator", "answers": [2] },
      { "resolve": true, "answers": ["U", "Elf"] },
      { "activate": "Riptide Replicator", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Zombie 0-0 Blue"] }, {}],
      "pt": { "Zombie 0-0 Blue": [2, 2] },
      "tapped": { "Riptide Replicator": true }
    }
  },
  {
    "name": "a Replicator with no charge counters makes a 0/0 token that dies",
    "players": [{ "hand": ["Riptide Replicator"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [
      { "cast": "Riptide Replicator", "answers": [0] },
      { "resolve": true, "answers": ["U", "Elf"] },
      { "activate": "Riptide Replicator", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Zombie 0-0 Blue"] }, {}]
    }
  }
]
