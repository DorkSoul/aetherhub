[
  {
    "name": "colored permanents are sacrificed, colorless stay",
    "players": [
      {
        "hand": [
          "All Is Dust"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Grizzly Bears",
          "Sol Ring",
          "Glorious Anthem"
        ]
      },
      {
        "battlefield": [
          "Hill Giant",
          "Mountain",
          "Mind Stone"
        ]
      }
    ],
    "steps": [
      {
        "cast": "All Is Dust"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Plains",
            "Sol Ring"
          ],
          "battlefield_lacks": [
            "Grizzly Bears",
            "Glorious Anthem"
          ],
          "graveyard_has": [
            "Grizzly Bears",
            "Glorious Anthem",
            "All Is Dust"
          ]
        },
        {
          "battlefield_has": [
            "Mountain",
            "Mind Stone"
          ],
          "battlefield_lacks": [
            "Hill Giant"
          ],
          "graveyard_has": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "nothing happens to colorless permanents and a lone colored permanent of each player goes",
    "players": [
      {
        "hand": [
          "All Is Dust"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Mind Stone"
        ]
      },
      {
        "battlefield": [
          "Serra Angel",
          "Sol Ring"
        ]
      }
    ],
    "steps": [
      {
        "cast": "All Is Dust"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Mind Stone"
          ]
        },
        {
          "battlefield_has": [
            "Sol Ring"
          ],
          "battlefield_lacks": [
            "Serra Angel"
          ],
          "graveyard_has": [
            "Serra Angel"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: colorless lands survive, even ones with colored mana abilities",
    "players": [
      { "hand": ["All Is Dust"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Sokenzan, Crucible of Defiance", "Mountain"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [{ "cast": "All Is Dust" }, { "resolve": true, "auto": true }],
    "expect": {
      "players": [
        { "battlefield_has": ["Sokenzan, Crucible of Defiance", "Mountain"] },
        { "battlefield_has": ["Mountain"] }
      ]
    }
  },
  {
    "name": "ruling: a colored token (white Soldier) is sacrificed",
    "players": [
      { "hand": ["Raise the Alarm", "All Is Dust"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Raise the Alarm" },
      { "resolve": true },
      { "cast": "All Is Dust" },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Plains"], "battlefield_lacks": ["Soldier"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an indestructible colored creature is still sacrificed",
    "players": [
      { "hand": ["All Is Dust"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Avacyn, Angel of Hope"] }
    ],
    "steps": [{ "cast": "All Is Dust" }, { "resolve": true, "auto": true }],
    "expect": {
      "players": [
        {},
        { "battlefield_lacks": ["Avacyn, Angel of Hope"], "graveyard_has": ["Avacyn, Angel of Hope"] }
      ]
    }
  }
]
