[
  {
    "name": "opponent casting a white instant takes 2 damage",
    "players": [
      {
        "battlefield": [
          "Mindsparker",
          "Grizzly Bears"
        ]
      },
      {
        "hand": [
          "Swords to Plowshares"
        ],
        "battlefield": [
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Swords to Plowshares",
        "player": 1,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "opponent casting a red instant does not trigger it",
    "players": [
      {
        "battlefield": [
          "Mindsparker"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "Mindsparker"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: the trigger still resolves when the spell is countered",
    "players": [
      { "battlefield": ["Mindsparker", "Grizzly Bears", "Island", "Island"], "hand": ["Counterspell"] },
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Swords to Plowshares", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "cast": "Counterspell" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Mindsparker", "Grizzly Bears"], "graveyard": ["Counterspell"] }, { "life": 18, "graveyard": ["Swords to Plowshares"] } ] }
  },
  {
    "name": "ruling: a white and blue spell triggers Mindsparker only once",
    "players": [
      { "battlefield": ["Mindsparker", "Mountain"], "hand": ["Lightning Bolt"] },
      { "hand": ["Dovin's Veto"], "battlefield": ["Plains", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Mindsparker"] },
      { "pass": true },
      { "cast": "Dovin's Veto", "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Mindsparker"] }, { "life": 18 } ] }
  }
]