[
 { "name": "once each turn a noncreature spell from hand can be cast for {0}; the second one can't",
   "players": [ { "hand": ["Sol Ring", "Thran Dynamo"], "battlefield": ["Vision, Spectral Synthezoid"] }, {} ],
   "steps": [ { "cast": "Sol Ring", "alt": 100 }, { "resolve": true }, { "cast": "Thran Dynamo", "alt": 100, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Sol Ring"], "hand": ["Thran Dynamo"] }, {} ] } },
 { "name": "a Robot creature spell from hand can be cast for {0}",
   "players": [ { "hand": ["A.I.M. Bot"], "battlefield": ["Vision, Spectral Synthezoid"] }, {} ],
   "steps": [ { "cast": "A.I.M. Bot", "alt": 100 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["A.I.M. Bot"] }, {} ] } },
 { "name": "a non-Robot creature spell can't use the free cast",
   "players": [ { "hand": ["Juggernaut"], "battlefield": ["Vision, Spectral Synthezoid"] }, {} ],
   "steps": [ { "cast": "Juggernaut", "alt": 100, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Juggernaut"] }, {} ] } },
 { "name": "a non-Robot creature spell is still cast normally for its mana cost",
   "players": [ { "hand": ["Juggernaut"], "battlefield": ["Vision, Spectral Synthezoid", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Juggernaut" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Juggernaut"] }, {} ] } }
