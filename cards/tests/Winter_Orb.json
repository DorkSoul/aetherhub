[
  {
    "name": "tapped Winter Orb imposes no limit: both tapped lands untap",
    "start": "End",
    "players": [
      { "battlefield": [{ "name": "Winter Orb", "tapped": true }, { "name": "Mountain", "tapped": true }, { "name": "Forest", "tapped": true }] },
      {}
    ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": {
      "tapped": { "Mountain": false, "Forest": false }
    }
  },
  {
    "name": "untapped Winter Orb: only one tapped land untaps during your untap step",
    "players": [
      { "battlefield": ["Winter Orb", { "name": "Mountain", "tapped": true }, { "name": "Forest", "tapped": true }] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "turn": 3,
      "tapped": { "Mountain": false, "Forest": true }
    }
  },
  {
    "name": "ruling: a tapped Winter Orb when the untap step begins lets every tapped permanent untap",
    "players": [
      { "battlefield": [{ "name": "Winter Orb", "tapped": true }, { "name": "Mountain", "tapped": true }, { "name": "Forest", "tapped": true }] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "turn": 3,
      "tapped": { "Winter Orb": false, "Mountain": false, "Forest": false }
    }
  }
]
