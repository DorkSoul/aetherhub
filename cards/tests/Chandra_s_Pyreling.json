[
  {
    "name": "noncombat damage from a spell to an opponent pumps and grants double strike",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Chandra's Pyreling"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 17 } ],
      "pt": { "Chandra's Pyreling": [2, 3] }
    }
  },
  {
    "name": "noncombat damage to a creature does not trigger",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Chandra's Pyreling", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 20 } ],
      "pt": { "Chandra's Pyreling": [1, 3] }
    }
  },
  {
    "name": "combat damage to an opponent does not trigger",
    "players": [
      { "battlefield": ["Chandra's Pyreling"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Chandra's Pyreling", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 19 } ],
      "pt": { "Chandra's Pyreling": [1, 3] }
    }
  },
  {
    "name": "ruling: noncombat damage dealt during combat still triggers",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Chandra's Pyreling", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Chandra's Pyreling", "at": "p1" } ] },
      { "block": [] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 13 } ],
      "pt": { "Chandra's Pyreling": [2, 3] }
    }
  }
]
