[
  { "name": "creatures able to block the target must block it",
    "players": [ { "hand": ["Roar of Challenge"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Roar of Challenge", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Roar of Challenge"] }, {} ] } },
  { "name": "blocking with the able creature is accepted",
    "players": [ { "hand": ["Roar of Challenge"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Roar of Challenge", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Roar of Challenge"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ferocious: target gains indestructible with a power 4+ creature",
    "players": [ { "hand": ["Roar of Challenge"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears", "Serra Angel"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Roar of Challenge", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Roar of Challenge"], "battlefield_has": ["Grizzly Bears", "Serra Angel"] }, { "battlefield_has": ["Hill Giant"] } ], "keywords": { "Grizzly Bears": ["Indestructible"] } } },
  { "name": "no ferocious bonus without a power 4+ creature",
    "players": [ { "hand": ["Roar of Challenge"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Roar of Challenge", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Roar of Challenge"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: Roar does not make a creature that cannot block the target block it (Hill Giant cannot block a flyer)",
    "players": [ { "hand": ["Roar of Challenge"], "battlefield": ["Forest", "Forest", "Forest", "Merfolk Skydiver"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Roar of Challenge", "targets": ["Merfolk Skydiver"] }, { "resolve": true }, { "attack": [ { "card": "Merfolk Skydiver", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 19 } ] } }
]
