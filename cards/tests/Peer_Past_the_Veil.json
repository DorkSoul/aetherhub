[
  {
    "name": "discards the hand then draws one per card type in your graveyard",
    "players": [
      { "hand": ["Peer Past the Veil", "Mountain", "Forest"], "graveyard": ["Lightning Bolt", "Grizzly Bears"], "battlefield": ["Mountain", "Forest", "Plains", "Plains"] },
      { "graveyard": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Peer Past the Veil" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3, "graveyard_has": ["Lightning Bolt", "Grizzly Bears", "Mountain", "Forest"] },
        { "graveyard": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "empty hand and empty graveyard draws nothing; opponent's graveyard does not count",
    "players": [
      { "hand": ["Peer Past the Veil"], "battlefield": ["Mountain", "Forest", "Plains", "Plains"] },
      { "graveyard": ["Lightning Bolt", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Peer Past the Veil" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        { "graveyard": ["Lightning Bolt", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: X does not count Peer Past the Veil itself (it is on the stack, so the instant type is not counted)",
    "players": [
      { "hand": ["Peer Past the Veil", "Mountain"], "graveyard": ["Grizzly Bears"], "battlefield": ["Mountain", "Forest", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Peer Past the Veil" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 2, "graveyard_has": ["Grizzly Bears", "Mountain"] },
        {}
      ]
    }
  }
]
