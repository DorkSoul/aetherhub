[
 { "name": "untap target land by removing a charge counter",
   "players": [ { "battlefield": [ { "name": "Lost Jitte", "counters": { "charge": 2 } }, { "name": "Forest", "tapped": true } ] }, {} ],
   "steps": [ { "activate": "Lost Jitte", "ability": 0, "targets": ["Forest"] }, { "resolve": true } ],
   "expect": { "tapped": { "Forest": false }, "counters": { "Lost Jitte": { "charge": 1 } } } },
 { "name": "equip, then remove a charge counter for a +1/+1 counter on the equipped creature",
   "players": [ { "battlefield": [ { "name": "Lost Jitte", "counters": { "charge": 1 } }, "Island", "Grizzly Bears" ] }, {} ],
   "steps": [ { "activate": "Lost Jitte", "ability": 3, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Lost Jitte", "ability": 2 }, { "resolve": true } ],
   "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 }, "Lost Jitte": { "charge": 0 } }, "attached": { "Lost Jitte": "Grizzly Bears" }, "pt": { "Grizzly Bears": [3, 3] } } },
 { "name": "equipped creature dealing combat damage puts a charge counter on Lost Jitte",
   "players": [ { "battlefield": [ "Lost Jitte", "Island", "Grizzly Bears" ] }, {} ],
   "steps": [ { "activate": "Lost Jitte", "ability": 3, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 18 } ], "counters": { "Lost Jitte": { "charge": 1 } }, "attached": { "Lost Jitte": "Grizzly Bears" } } },
 { "name": "an unequipped creature dealing combat damage does not add a charge counter",
   "players": [ { "battlefield": [ "Lost Jitte", "Island", "Grizzly Bears" ] }, {} ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ], "counters": { "Lost Jitte": { "charge": 0 } } } },
 { "name": "remove a charge counter: target creature can't block this turn",
   "players": [ { "battlefield": [ { "name": "Lost Jitte", "counters": { "charge": 1 } }, "Grizzly Bears" ] }, { "battlefield": [ "Hill Giant" ] } ],
   "steps": [ { "activate": "Lost Jitte", "ability": 1, "targets": ["Hill Giant"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18, "battlefield_has": ["Hill Giant"] } ], "counters": { "Lost Jitte": { "charge": 0 } } } },
 { "name": "ruling: choosing an already-declared blocker for the can't-block mode does not stop it blocking",
   "players": [ { "battlefield": [ { "name": "Lost Jitte", "counters": { "charge": 1 } }, "Island", "Grizzly Bears" ] }, { "battlefield": [ "Hill Giant" ] } ],
   "steps": [
     { "activate": "Lost Jitte", "ability": 3, "targets": ["Grizzly Bears"] }, { "resolve": true },
     { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
     { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
     { "activate": "Lost Jitte", "ability": 1, "targets": ["Hill Giant"] }, { "resolve": true },
     { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ] } },
 { "name": "ruling: the untap mode may target a land that is already untapped",
   "players": [ { "battlefield": [ { "name": "Lost Jitte", "counters": { "charge": 1 } }, "Island" ] }, {} ],
   "steps": [ { "activate": "Lost Jitte", "ability": 0, "targets": ["Island"] }, { "resolve": true } ],
   "expect": { "tapped": { "Island": false }, "counters": { "Lost Jitte": { "charge": 0 } } } }
]
