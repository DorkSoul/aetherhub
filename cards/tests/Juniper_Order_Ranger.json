[
  {
    "name": "counters on the entering creature and on the Ranger",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Juniper Order Ranger",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          3,
          3
        ],
        "Juniper Order Ranger": [
          3,
          5
        ]
      }
    }
  },
  {
    "name": "tokens count too",
    "players": [
      {
        "hand": [
          "Raise the Alarm"
        ],
        "battlefield": [
          "Juniper Order Ranger",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Raise the Alarm"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Juniper Order Ranger": {
          "p1p1": 2
        }
      }
    }
  },
  {
    "name": "opponent's creature does nothing",
    "players": [
      {
        "battlefield": [
          "Juniper Order Ranger"
        ]
      },
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Grizzly Bears",
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          2,
          2
        ],
        "Juniper Order Ranger": [
          2,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: Ranger still gets its counter if the entering creature is killed in response to the trigger",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Juniper Order Ranger", "Forest", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Juniper Order Ranger": [3, 5] },
      "players": [
        { "battlefield_has": ["Juniper Order Ranger"], "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: the entering creature still gets its counter if Juniper is killed in response to the trigger",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Juniper Order Ranger", "Forest", "Forest"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Juniper Order Ranger"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] },
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Juniper Order Ranger"] },
        { "graveyard_has": ["Murder"] }
      ]
    }
  }
]