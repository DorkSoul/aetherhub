[
 { "name": "artifact entering under your control pings the opponent",
   "players": [ { "hand": ["Hedgewitch's Mask"], "battlefield": ["Plains","Hedron Detonator"] }, {} ],
   "steps": [ { "cast": "Hedgewitch's Mask" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 19 } ] } },
 { "name": "sacrifice two artifacts to exile the top card and play it this turn",
   "players": [ { "battlefield": ["Hedron Detonator", "Hedron Matrix", "Hedgewitch's Mask", "Mountain"], "library": ["Lightning Bolt"] }, {} ],
   "steps": [ { "activate": "Hedron Detonator", "ability": 0 }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": [] }, { "life": 17 } ] } },
 { "name": "ruling: an exiled card you do not play stays exiled",
   "players": [ { "battlefield": ["Hedron Detonator", "Hedron Matrix", "Hedgewitch's Mask"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Hedron Detonator", "ability": 0 }, { "resolve": true }, { "advance_to": "End" } ],
   "expect": { "players": [ { "exile": ["Grizzly Bears"], "hand_count": 0 }, {} ] } },
 { "name": "ruling: an exiled creature follows normal timing (not castable in combat, castable in main phase 2)",
   "players": [ { "battlefield": ["Hedron Detonator", "Hedron Matrix", "Hedgewitch's Mask", "Forest", "Forest"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "activate": "Hedron Detonator", "ability": 0 }, { "resolve": true },
              { "cast": "Grizzly Bears", "illegal": true }, { "advance_to": "Main2" }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: an exiled land can be played as the land for the turn",
   "players": [ { "battlefield": ["Hedron Detonator", "Hedron Matrix", "Hedgewitch's Mask"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Hedron Detonator", "ability": 0 }, { "resolve": true }, { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": ["Forest"], "exile": [] }, {} ] } },
 { "name": "ruling: an exiled land cannot be played once a land was already played this turn",
   "players": [ { "hand": ["Mountain"], "battlefield": ["Hedron Detonator", "Hedron Matrix", "Hedgewitch's Mask"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Hedron Detonator", "ability": 0 }, { "resolve": true }, { "play_land": "Mountain" }, { "play_land": "Forest", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Mountain"], "exile": ["Forest"] }, {} ] } },
 { "name": "ruling: the exiled card stays playable after Hedron Detonator leaves the battlefield",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Hedron Detonator", "Hedron Matrix", "Hedgewitch's Mask", "Mountain", "Mountain"], "library": ["Shock"] }, {} ],
   "steps": [ { "activate": "Hedron Detonator", "ability": 0 }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Hedron Detonator"] }, { "resolve": true },
              { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Hedron Detonator"], "exile": [] }, { "life": 18 } ] } }
]
