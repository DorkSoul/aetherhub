[
  {
    "name": "doubles the target creature's power until end of turn",
    "players": [ { "hand": ["Bulk Up"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Bulk Up", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2] },
      "players": [ { "graveyard": ["Bulk Up"] }, {} ]
    }
  },
  {
    "name": "flashback for {4}{R}{R} exiles it after it resolves",
    "players": [ { "graveyard": ["Bulk Up"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Bulk Up", "alt": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2] },
      "players": [ { "exile": ["Bulk Up"], "graveyard": [] }, {} ]
    }
  },
  {
    "name": "ruling: a countered flashback spell is still exiled",
    "players": [ { "graveyard": ["Bulk Up"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Bulk Up", "alt": 0, "targets": ["Grizzly Bears"] },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Bulk Up" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Bulk Up"], "graveyard": [] }, { "graveyard": ["Counterspell"] } ]
    }
  },
  {
    "name": "ruling: the +X/+0 is fixed by the power when Bulk Up resolves (a pump that resolves first counts)",
    "players": [ { "hand": ["Bulk Up", "Giant Growth"], "battlefield": ["Mountain", "Mountain", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Bulk Up", "targets": ["Grizzly Bears"] },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [10, 5] }
    }
  }
]
