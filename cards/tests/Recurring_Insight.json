 {"name": "ruling: rebound cast from exile at upkeep resolves to the graveyard, not back to exile",
  "players": [{"hand": ["Recurring Insight"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"]}, {"hand": ["Island", "Island", "Island"]}],
