  "steps": [{"cast": "Recurring Insight"}, {"pass": true}, {"player": 1, "cast": "Counterspell", "targets": [{"stack": "Recurring Insight"}]}, {"resolve": true}, {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}],
