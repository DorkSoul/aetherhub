[
  {
    "name": "unpaid squad: one Powder Ganger, destroys an artifact",
    "players": [
      { "hand": ["Powder Ganger"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Powder Ganger" },
      { "resolve": true, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Powder Ganger"] }, { "graveyard": ["Sol Ring"] } ],
      "pt": { "Powder Ganger": [2, 2] }
    }
  },
  {
    "name": "squad paid twice: two token copies enter as well",
    "players": [
      { "hand": ["Powder Ganger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Powder Ganger", "answers": [2] },
      { "resolve": true, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield": ["Powder Ganger", "Powder Ganger", "Powder Ganger", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "graveyard": ["Sol Ring"] } ]
    }
  },
  {
    "name": "ruling: countered Powder Ganger makes no squad tokens",
    "players": [
      { "hand": ["Powder Ganger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Essence Scatter"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Powder Ganger", "answers": [1] },
      { "pass": true },
      { "cast": "Essence Scatter", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Powder Ganger"], "battlefield_lacks": ["Powder Ganger"] }, { "graveyard": ["Essence Scatter"] } ]
    }
  },
  {
    "name": "ruling: Powder Ganger killed before its squad trigger resolves still gets the token copy",
    "players": [
      { "hand": ["Powder Ganger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Shock"], "battlefield": ["Mountain", "Sol Ring"] }
    ],
    "steps": [
      { "cast": "Powder Ganger", "answers": [1] },
      { "resolve": true, "targets": ["Sol Ring"] },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Powder Ganger"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Powder Ganger"], "battlefield": ["Powder Ganger", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
        { "graveyard": ["Sol Ring", "Shock"] }
      ]
    }
  },
  {
    "name": "ruling: squad may be paid any number of times (three copies)",
    "players": [
      { "hand": ["Powder Ganger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Powder Ganger", "answers": [3] },
      { "resolve": true, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield": ["Powder Ganger", "Powder Ganger", "Powder Ganger", "Powder Ganger", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "graveyard": ["Sol Ring"] } ]
    }
  }
]
