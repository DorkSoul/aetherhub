[
 { "name": "casting an instant lets you switch it to 5/1",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fluxcharger", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
   "expect": { "pt": { "Fluxcharger": [5, 1] } } },
 { "name": "declining the switch leaves it 1/5",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Fluxcharger", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
   "expect": { "pt": { "Fluxcharger": [1, 5] } } },
 { "name": "ruling: switching twice returns it to 1/5",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Fluxcharger", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
   "expect": { "pt": { "Fluxcharger": [1, 5] } } },
 { "name": "ruling: nonlethal damage becomes lethal when the switch makes toughness 1",
   "players": [ { "hand": ["Guerrilla Tactics", "Lightning Bolt"], "battlefield": ["Fluxcharger", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Guerrilla Tactics", "targets": ["Fluxcharger"] }, { "resolve": true, "answers": [false] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Guerrilla Tactics", "Fluxcharger", "Lightning Bolt"] }, { "life": 17 } ] } }
]
