[
  {
    "name": "exiles your own creature; you (its owner) may cast it later at no extra cost",
    "players": [
      {"hand": ["Soul Partition"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Grizzly Bears"]},
      {}
    ],
    "steps": [
      {"cast": "Soul Partition", "targets": ["Grizzly Bears"]},
      {"resolve": true},
      {"cast": "Grizzly Bears"},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"battlefield_has": ["Grizzly Bears"], "exile": []}, {}]
    }
  },
  {
    "name": "owner (opponent) casting the exiled creature on their turn pays {2} more",
    "players": [
      {"hand": ["Soul Partition"], "battlefield": ["Plains", "Plains"]},
      {"battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]}
    ],
    "steps": [
      {"cast": "Soul Partition", "targets": ["Hill Giant"]},
      {"resolve": true},
      {"advance_to": "End"},
      {"advance_to": "Main1"},
      {"cast": "Hill Giant", "player": 1},
      {"resolve": true}
    ],
    "expect": {
      "players": [{}, {"battlefield_has": ["Hill Giant"]}]
    }
  },
  {
    "name": "owner (opponent) with 3 Mountains (4 mana with a land drop) cannot cast the exiled Hill Giant: the {2} tax applies",
    "players": [
      {"hand": ["Soul Partition"], "battlefield": ["Plains", "Plains"]},
      {"battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"]}
    ],
    "steps": [
      {"cast": "Soul Partition", "targets": ["Hill Giant"]},
      {"resolve": true},
      {"advance_to": "End"},
      {"advance_to": "Main1"},
      {"cast": "Hill Giant", "player": 1, "illegal": true}
    ],
    "expect": {
      "players": [{}, {"exile": ["Hill Giant"]}]
    }
  },
  {
    "name": "an opponent-owned exiled card can't be cast by the card's non-owner",
    "players": [
      {"hand": ["Soul Partition"], "battlefield": ["Plains", "Plains", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]},
      {"battlefield": ["Hill Giant"]}
    ],
    "steps": [
      {"cast": "Soul Partition", "targets": ["Hill Giant"]},
      {"resolve": true},
      {"cast": "Hill Giant", "illegal": true}
    ],
    "expect": {
      "players": [{}, {"exile": ["Hill Giant"]}]
    }
  },
  {
    "name": "ruling: the owner can't cast the exiled creature on your turn (creatures only at sorcery speed)",
    "players": [
      {"hand": ["Soul Partition"], "battlefield": ["Plains", "Plains"]},
      {"battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]}
    ],
    "steps": [
      {"cast": "Soul Partition", "targets": ["Hill Giant"]},
      {"resolve": true},
      {"pass": true},
      {"cast": "Hill Giant", "player": 1, "illegal": true}
    ],
    "expect": {"players": [{}, {"exile": ["Hill Giant"]}]}
  }
]
