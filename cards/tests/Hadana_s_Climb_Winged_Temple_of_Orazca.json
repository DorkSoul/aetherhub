[
  {
    "name": "beginning of combat puts a counter on your creature",
    "players": [
      {
        "battlefield": [
          "Hadana's Climb",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {
          "PlusOnePlusOne": 1
        }
      },
      "pt": {
        "Grizzly Bears": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "third counter transforms it into the land",
    "players": [
      {
        "battlefield": [
          "Hadana's Climb",
          {
            "name": "Grizzly Bears",
            "counters": {
              "PlusOnePlusOne": 2
            }
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {
          "PlusOnePlusOne": 3
        }
      },
      "players": [
        {
          "battlefield_has": [
            "Winged Temple of Orazca"
          ],
          "battlefield_lacks": [
            "Hadana's Climb"
          ]
        }
      ]
    }
  },
  {
    "name": "Winged Temple: {1}{G}{U}, {T} gives a creature flying and +X/+X where X is its power",
    "players": [ { "battlefield": ["Hadana's Climb", { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 2 } }, "Forest", "Island", "Plains"] }, {} ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true },
      { "activate": "Winged Temple of Orazca", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "keywords": { "Grizzly Bears": ["Flying"] }, "pt": { "Grizzly Bears": [10, 10] }, "tapped": { "Winged Temple of Orazca": true } }
  },
  {
    "name": "Winged Temple: no blue source, so the ability cannot be activated",
    "players": [ { "battlefield": ["Hadana's Climb", { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 2 } }, "Forest", "Plains"] }, {} ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "resolve": true },
      { "activate": "Winged Temple of Orazca", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [5, 5] }, "keywords": { "Grizzly Bears": [] } }
  }
]
