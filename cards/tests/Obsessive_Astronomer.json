[
  {
    "name": "entering when it is neither day nor night makes it day; neither-to-day does not trigger",
    "players": [
      { "hand": ["Obsessive Astronomer", "Island", "Mountain"], "battlefield": ["Mountain", "Island"], "library": ["Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Obsessive Astronomer" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Island", "Mountain"], "graveyard": [], "battlefield_has": ["Obsessive Astronomer"] }, {}]
    }
  },
  {
    "name": "day becomes night: discard up to two, then draw that many",
    "players": [
      { "hand": ["Obsessive Astronomer", "Island", "Mountain"], "battlefield": ["Mountain", "Island"], "library": ["Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Obsessive Astronomer" },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true, "answers": [["Island", "Mountain"]] }
    ],
    "expect": {
      "players": [{ "hand": ["Swamp", "Forest"], "graveyard": ["Island", "Mountain"], "battlefield_has": ["Obsessive Astronomer"] }, {}],
      "turn": 3
    }
  },
  {
    "name": "day becomes night: choosing no cards to discard draws nothing",
    "players": [
      { "hand": ["Obsessive Astronomer", "Island"], "battlefield": ["Mountain", "Island"], "library": ["Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Obsessive Astronomer" },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true, "answers": [[]] }
    ],
    "expect": {
      "players": [{ "hand": ["Island"], "graveyard": [], "battlefield_has": ["Obsessive Astronomer"] }, {}],
      "turn": 3
    }
  },
  {
    "name": "ruling: night becomes day when the previous turn's player cast two spells",
    "players": [
      { "hand": ["Obsessive Astronomer", "Accumulated Knowledge", "Accumulated Knowledge"], "battlefield": ["Mountain", "Island", "Island", "Island"], "library": ["Swamp", "Forest", "Island", "Plains", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Obsessive Astronomer" },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true, "answers": [[]] },
      { "cast": "Accumulated Knowledge" },
      { "resolve": true },
      { "cast": "Accumulated Knowledge" },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true, "answers": [["Island"]] }
    ],
    "expect": {
      "players": [{ "hand": ["Swamp", "Forest", "Plains", "Mountain"], "graveyard": ["Accumulated Knowledge", "Accumulated Knowledge", "Island"], "battlefield_has": ["Obsessive Astronomer"] }, {}],
      "turn": 4
    }
  }
]
