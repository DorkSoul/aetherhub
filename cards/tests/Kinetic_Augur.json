[
  { "name": "ETB: discard two chosen cards, then draw two",
    "players": [ { "hand": ["Kinetic Augur", "Island", "Swamp", "Forest"], "library": ["Plains", "Plains", "Plains"], "battlefield": ["Mountain", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Kinetic Augur" }, { "resolve": true, "answers": [["Island", "Swamp"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Kinetic Augur"], "hand_count": 3, "graveyard": ["Island", "Swamp"] } ] } },
  { "name": "ETB: discarding zero cards draws nothing",
    "players": [ { "hand": ["Kinetic Augur", "Island", "Swamp", "Forest"], "library": ["Plains", "Plains", "Plains"], "battlefield": ["Mountain", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Kinetic Augur" }, { "resolve": true, "answers": [[]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Kinetic Augur"], "hand_count": 3, "graveyard": [] } ] } },
  { "name": "power is the number of instant and sorcery cards in your graveyard",
    "players": [ { "battlefield": ["Kinetic Augur"], "graveyard": ["Lightning Bolt", "Giant Growth", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "pt": { "Kinetic Augur": [2, 4] } } },
  { "name": "ETB: discarding exactly one chosen card draws exactly one",
    "players": [ { "hand": ["Kinetic Augur", "Island", "Swamp", "Forest"], "library": ["Plains", "Plains", "Plains"], "battlefield": ["Mountain", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Kinetic Augur" }, { "resolve": true, "answers": [["Island"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Kinetic Augur"], "hand_count": 3, "graveyard": ["Island"] } ] } },
  { "name": "ruling: the discard choice is made once; the two cards drawn afterwards are not discarded again",
    "players": [ { "hand": ["Kinetic Augur", "Island", "Swamp", "Forest"], "library": ["Plains", "Plains", "Plains"], "battlefield": ["Mountain", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Kinetic Augur" }, { "resolve": true, "answers": [["Island", "Swamp"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Kinetic Augur"], "hand_count": 3, "library_count": 1, "graveyard": ["Island", "Swamp"] } ] } }
]
