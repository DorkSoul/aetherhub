      { "cast": "Llanowar Elves" },
      { "resolve": true },
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "lands entering this turn do not count toward celebration",
    "players": [
      {
        "hand": ["Forest", "Llanowar Elves"],
        "battlefield": ["Bespoke Battlegarb", "Grizzly Bears", "Forest"]
      },
      {}
