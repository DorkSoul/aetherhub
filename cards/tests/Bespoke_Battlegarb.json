      { "resolve": true },
      { "cast": "Llanowar Elves" },
      { "resolve": true },
      { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2] },
      "attached": { "Bespoke Battlegarb": "Grizzly Bears" }
