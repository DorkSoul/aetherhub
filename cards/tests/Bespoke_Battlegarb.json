[
  {
    "name": "celebration: two nonland permanents entered this turn, attach to a target creature at beginning of combat",
    "players": [
      {
        "hand": ["Llanowar Elves", "Llanowar Elves"],
        "battlefield": ["Bespoke Battlegarb", "Grizzly Bears", "Forest", "Forest"]
