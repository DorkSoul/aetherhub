[
  { "name": "at end of combat the creature blocked by Wall of Nets is exiled",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Wall of Nets"] } ],
    "steps": [ { "attack": [{"card": "Grizzly Bears", "at": "p1"}] }, { "block": [{"blocker": "Wall of Nets", "attacker": "Grizzly Bears"}] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Wall of Nets"] } ] } },
  { "name": "an unblocked attacker is not exiled",
    "players": [ { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }, { "battlefield": ["Wall of Nets"] } ],
    "steps": [ { "attack": [{"card": "Grizzly Bears", "at": "p1"}, {"card": "Llanowar Elves", "at": "p1"}] }, { "block": [{"blocker": "Wall of Nets", "attacker": "Grizzly Bears"}] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Llanowar Elves"], "exile": ["Grizzly Bears"] }, { "battlefield_has": ["Wall of Nets"] } ] } },
  { "name": "when Wall of Nets leaves the battlefield the exiled creature returns under its owner's control",
    "players": [ { "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Swamp"], "hand": ["Murder"] }, { "battlefield": ["Wall of Nets"] } ],
    "steps": [ { "attack": [{"card": "Grizzly Bears", "at": "p1"}] }, { "block": [{"blocker": "Wall of Nets", "attacker": "Grizzly Bears"}] },
               { "advance_to": "Main2" }, { "cast": "Murder", "targets": ["Wall of Nets"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": [] }, { "graveyard": ["Wall of Nets"] } ] } },
  { "name": "ruling: Wall of Nets removed before end of combat exiles nothing",
    "players": [ { "hand": ["Murder"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Wall of Nets"] } ],
    "steps": [ { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "block": [{ "blocker": "Wall of Nets", "attacker": "Grizzly Bears" }] }, { "cast": "Murder", "targets": ["Wall of Nets"] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": [] }, { "graveyard": ["Wall of Nets"] } ] } }
]
