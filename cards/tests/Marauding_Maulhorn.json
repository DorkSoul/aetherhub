  {
    "name": "ruling: with Advocate of the Beast it may still attack when declared",
    "players": [{"battlefield": ["Marauding Maulhorn", "Advocate of the Beast"]}, {}],
    "steps": [{"attack": [{"card": "Marauding Maulhorn", "at": "p1"}]}, {"advance_to": "Main2"}],
