[
  {
    "name": "attacking with an Elf scries 1, then gets +1/+1 for the card looked at",
    "players": [
      { "battlefield": ["Celeborn the Wise", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Llanowar Elves", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Celeborn the Wise": [4, 4] }
    }
  },
  {
    "name": "attacking with a non-Elf does not scry",
    "players": [
      { "battlefield": ["Celeborn the Wise", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Celeborn the Wise": [3, 3] }
    }
  },
  {
    "name": "its +1/+1 wears off at end of turn",
    "players": [
      { "battlefield": ["Celeborn the Wise", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Llanowar Elves", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 }
    ],
    "expect": {
      "pt": { "Celeborn the Wise": [3, 3] }
    }
  },
  {
    "name": "ruling: attacking with two Elves scries only once, Celeborn gets +1/+1 once",
    "players": [
      { "battlefield": ["Celeborn the Wise", "Llanowar Elves", "Elvish Mystic"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Llanowar Elves", "at": "p1" }, { "card": "Elvish Mystic", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Celeborn the Wise": [4, 4] }
    }
  }
]
