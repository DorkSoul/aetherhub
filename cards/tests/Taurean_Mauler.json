 {
  "name": "ruling: the trigger resolves before the spell and still resolves when that spell is countered",
  "players": [
   {"hand": ["Counterspell"], "battlefield": ["Taurean Mauler", "Island", "Island"]},
   {"hand": ["Shock"], "battlefield": ["Mountain"]}
  ],
  "steps": [
   {"pass": true},
   {"cast": "Shock", "player": 1, "targets": ["p0"]},
   {"cast": "Counterspell", "targets": [{"stack": "Shock"}]},
   {"resolve": true, "answers": [true]},
   {"resolve": true}
  ],
  "expect": {
   "players": [{"battlefield_has": ["Taurean Mauler"]}, {"graveyard": ["Shock"]}],
   "counters": {"Taurean Mauler": {"p1p1": 1}},
