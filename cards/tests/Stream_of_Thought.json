[
  {
    "name": "mills four and shuffles up to four graveyard cards into library",
    "players": [
      { "hand": ["Stream of Thought"], "battlefield": ["Island"], "graveyard": ["Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Stream of Thought", "targets": ["p1"] },
      { "resolve": true, "answers": [["Grizzly Bears", "Hill Giant"]] }
    ],
    "expect": {
      "players": [{ "library_count": 22 }, { "library_count": 16 }]
    }
  },
  {
    "name": "replicate once: the copy mills four before the original",
    "players": [
      { "hand": ["Stream of Thought"], "battlefield": ["Island", "Island", "Island", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Stream of Thought", "targets": ["p1"], "answers": [1] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "library_count": 12 }]
    }
  },
  {
    "name": "ruling: targeting yourself, the milled cards may be shuffled back and Stream of Thought stays in the graveyard",
    "players": [
      { "hand": ["Stream of Thought"], "battlefield": ["Island"], "library": ["Grizzly Bears", "Hill Giant", "Llanowar Elves", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Stream of Thought", "targets": ["p0"] },
      { "resolve": true, "answers": [["Grizzly Bears", "Hill Giant", "Llanowar Elves", "Swamp"]] }
    ],
    "expect": {
      "players": [{ "graveyard": ["Stream of Thought"] }, {}]
    }
  }
]
