[
  {
    "name": "casting a spell with convoke: 1 damage to each opponent and 1 to each battle you control",
    "players": [
      { "hand": ["Gather Courage"], "battlefield": ["Forest", { "name": "Joyful Stormsculptor", "sick": false }, { "name": "Invasion of Belenon // Belenon War Anthem", "counters": { "Defense": 5 } }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Gather Courage", "targets": ["Joyful Stormsculptor"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ],
      "counters": { "Invasion of Belenon // Belenon War Anthem": { "Defense": 4 } },
      "pt": { "Joyful Stormsculptor": [4, 5] }
    }
  },
  {
    "name": "a spell without convoke does not trigger it",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Joyful Stormsculptor", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "a convoke spell cast by the opponent does not trigger it",
    "players": [
      { "battlefield": ["Plains", { "name": "Joyful Stormsculptor", "sick": false }] },
      { "hand": ["Gather Courage"], "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Gather Courage", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, {} ]
    }
  },
  {
    "name": "the ETB trigger creates two 1/1 blue and red Elemental tokens",
    "players": [
      { "hand": ["Joyful Stormsculptor"], "battlefield": ["Island", "Mountain", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Joyful Stormsculptor" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Joyful Stormsculptor", "Elemental 1-1 UR", "Elemental 1-1 UR"] }, {} ]
    }
  },
  {
    "name": "ruling: a convoke spell paid only with lands still triggers the last ability",
    "players": [
      {
        "hand": ["Conclave Tribunal"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", { "name": "Joyful Stormsculptor", "sick": false }]
      },
      {}
    ],
    "steps": [
      { "cast": "Conclave Tribunal" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Conclave Tribunal", "Joyful Stormsculptor"] }, { "life": 19 } ]
    }
  }
]
