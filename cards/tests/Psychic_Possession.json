[
  {
    "name": "skip your draw step: the controller draws nothing in their draw step",
    "players": [
      { "hand": ["Psychic Possession"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Forest", "Forest"] },
      { "library": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Psychic Possession", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main1", "auto": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "library_count": 2 }, {} ]
    }
  },
  {
    "name": "enchanted opponent draws: you may draw a card (answer yes)",
    "players": [
      { "hand": ["Psychic Possession"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Forest", "Forest"] },
      { "library": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Psychic Possession", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Draw", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand_count": 1 } ]
    }
  },
  {
    "name": "enchanted opponent draws: you may decline and draw nothing",
    "players": [
      { "hand": ["Psychic Possession"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Forest", "Forest"] },
      { "library": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Psychic Possession", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Draw", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, { "hand_count": 1 } ]
    }
  },
  {
    "name": "skip your draw step: on your next turn's draw step you draw nothing (library stays at 2)",
    "players": [
      { "hand": ["Psychic Possession"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Forest", "Forest"] },
      { "library": ["Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Psychic Possession", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "answers": [false] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "library_count": 2 }, {} ]
    }
  },
  {
    "name": "ruling: enchant opponent Aura enters attached to the player and stays on the battlefield",
    "players": [
      { "hand": ["Psychic Possession"], "battlefield": ["Island", "Island", "Island", "Island"], "library": ["Forest", "Forest"] },
      { "library": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Psychic Possession", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Psychic Possession"] }, {} ]
    }
  }
]
