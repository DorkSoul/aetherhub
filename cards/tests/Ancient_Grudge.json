    "name": "ruling: flashback copy whose target is gone when it resolves fizzles and is still exiled",
    "players": [
      {
        "hand": ["Ancient Grudge"],
        "graveyard": ["Ancient Grudge"],
        "battlefield": ["Forest", "Mountain", "Mountain"]
      },
