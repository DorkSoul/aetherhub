  {
    "name": "ruling: an instant's flashback can be cast in response to another spell",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "graveyard": ["Ancient Grudge"],
        "battlefield": ["Mountain", "Forest"]
      },
      {
        "battlefield": ["Sol Ring"]
      }
