        "battlefield": ["Sol Ring"]
      }
    ],
    "steps": [
      { "cast": "Ancient Grudge", "alt": 0, "targets": ["Sol Ring"] },
      { "cast": "Ancient Grudge", "targets": ["Sol Ring"] },
      { "resolve": true }
