    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Ancient Grudge", "alt": 0, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Lightning Bolt"], "exile": ["Ancient Grudge"] },
