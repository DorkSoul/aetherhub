[
  {
    "name": "attacking makes a d20 roll and creates Treasure tokens",
    "seed": 1,
    "players": [
      { "battlefield": [{"name": "Hoarding Ogre", "sick": false}] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Hoarding Ogre", "at": "p1" }] },
      { "block": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Hoarding Ogre", "Treasure"] }, {}]
    }
  },
  {
    "name": "no attack, no roll, no Treasure",
    "players": [
      { "battlefield": ["Hoarding Ogre"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Hoarding Ogre"], "battlefield_lacks": ["Treasure"] }, {}]
    }
  },
  {
    "name": "ruling: a roll of 9 is in the 1-9 row: one Treasure",
    "rolls": [9],
    "players": [ { "battlefield": [{ "name": "Hoarding Ogre", "sick": false }] }, {} ],
    "steps": [ { "attack": [{ "card": "Hoarding Ogre", "at": "p1" }] }, { "block": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Hoarding Ogre", "Treasure"] }, {} ] }
  },
  {
    "name": "ruling: a roll of 10 is in the 10-19 row: two Treasures",
    "rolls": [10],
    "players": [ { "battlefield": [{ "name": "Hoarding Ogre", "sick": false }] }, {} ],
    "steps": [ { "attack": [{ "card": "Hoarding Ogre", "at": "p1" }] }, { "block": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Hoarding Ogre", "Treasure", "Treasure"] }, {} ] }
  },
  {
    "name": "ruling: a roll of 20 creates three Treasures",
    "rolls": [20],
    "players": [ { "battlefield": [{ "name": "Hoarding Ogre", "sick": false }] }, {} ],
    "steps": [ { "attack": [{ "card": "Hoarding Ogre", "at": "p1" }] }, { "block": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Hoarding Ogre", "Treasure", "Treasure", "Treasure"] }, {} ] }
  }
]
