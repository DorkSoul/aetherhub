[
  {
    "name": "ETB may search for a legendary card and put it into hand",
    "players": [ { "hand": ["Thalia's Lancers"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Forest"], "library": ["Forest", "Marrow-Gnawer"] }, {} ],
    "steps": [ { "cast": "Thalia's Lancers" }, { "resolve": true, "answers": [true, "Marrow-Gnawer"] } ],
    "expect": {
      "players": [ { "hand": ["Marrow-Gnawer"], "battlefield_has": ["Thalia's Lancers"] }, {} ]
    }
  },
  {
    "name": "declining the search leaves the hand empty",
    "players": [ { "hand": ["Thalia's Lancers"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Forest"], "library": ["Marrow-Gnawer"] }, {} ],
    "steps": [ { "cast": "Thalia's Lancers" }, { "resolve": true, "answers": [false] } ],
    "expect": {
      "players": [ { "hand_count": 0, "battlefield_has": ["Thalia's Lancers"] }, {} ]
    }
  },
  {
    "name": "a library with no legendary card finds nothing",
    "players": [ { "hand": ["Thalia's Lancers"], "battlefield": ["Plains", "Plains", "Forest", "Forest", "Forest"], "library": ["Forest", "Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Thalia's Lancers" }, { "resolve": true, "answers": [true] } ],
    "expect": {
      "players": [ { "hand_count": 0, "battlefield_has": ["Thalia's Lancers"] }, {} ]
    }
  }
]
