[
  {
    "name": "X spell makes a Hydra with X counters",
    "players": [
      { "hand": ["Fireball"], "battlefield": ["Zaxara, the Exemplary", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Fireball", "targets": ["p1"], "answers": [3] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Hydra 0-0 Green": [3, 3] }, "players": [{}, { "life": 17 }] }
  },
  {
    "name": "a spell without X makes no Hydra",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Zaxara, the Exemplary", "Mountain"] },
      {}
    ],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_lacks": ["Hydra 0-0 Green"] }, { "life": 17 }] }
  },
  {
    "name": "ruling: an X=0 spell makes a 0/0 Hydra that dies at once",
    "players": [
      { "hand": ["Fireball"], "battlefield": ["Zaxara, the Exemplary", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Fireball", "targets": ["p1"], "answers": [0] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Hydra 0-0 Green"] }, { "life": 20 } ] }
  }
]
