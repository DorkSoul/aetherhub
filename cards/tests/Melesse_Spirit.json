[
  {
    "name": "is a 3/3 flyer",
    "players": [
      { "hand": ["Melesse Spirit"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Melesse Spirit" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Melesse Spirit": [3, 3] },
      "players": [{ "battlefield_has": ["Melesse Spirit"] }, {}]
    }
  },
  {
    "name": "protection from black: black removal can't target it",
    "players": [
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Melesse Spirit"] }
    ],
    "steps": [
      { "cast": "Doom Blade", "targets": ["Melesse Spirit"], "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Doom Blade"] }, { "battlefield_has": ["Melesse Spirit"] }]
    }
  },
  {
    "name": "a red spell can still target and kill it",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Melesse Spirit"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Melesse Spirit"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Melesse Spirit"] }]
    }
  }
]
