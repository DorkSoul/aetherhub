[
  {
    "name": "draw replaced by a study counter when accepted",
    "players": [
      {
        "hand": ["Opt"],
        "battlefield": ["Pursuit of Knowledge", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Opt" },
      { "resolve": true, "answers": [[], true] }
    ],
    "expect": {
      "players": [{ "hand_count": 0 }, {}],
      "counters": { "Pursuit of Knowledge": { "study": 1 } }
    }
  },
  {
    "name": "declining the replacement draws normally",
    "players": [
      {
        "hand": ["Opt"],
        "battlefield": ["Pursuit of Knowledge", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Opt" },
      { "resolve": true, "answers": [[], false] }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, {}],
      "counters": { "Pursuit of Knowledge": { "study": 0 } }
    }
  },
  {
    "name": "remove three study counters and sacrifice: draw seven",
    "players": [
      {
        "battlefield": [{ "name": "Pursuit of Knowledge", "counters": { "study": 3 } }]
      },
      {}
    ],
    "steps": [
      { "activate": "Pursuit of Knowledge", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 7, "graveyard_has": ["Pursuit of Knowledge"] }, {}]
    }
  },
  {
    "name": "two study counters are not enough to draw seven",
    "players": [
      {
        "battlefield": [{ "name": "Pursuit of Knowledge", "counters": { "study": 2 } }]
      },
      {}
    ],
    "steps": [
      { "activate": "Pursuit of Knowledge", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [{ "hand_count": 0 }, {}],
      "counters": { "Pursuit of Knowledge": { "study": 2 } }
    }
  }
]
