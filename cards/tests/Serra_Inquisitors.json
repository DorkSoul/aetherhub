      { "block": [ { "blocker": "Serra Inquisitors", "attacker": "Scathe Zombies" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Serra Inquisitors": [5, 3] }
    }
  },
  {
