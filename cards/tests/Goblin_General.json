[
  {
    "name": "attack pumps Goblins you control but not other creatures",
    "players": [{ "battlefield": ["Goblin General", "Goblin Glory Chaser", "Grizzly Bears"] }, {}],
    "steps": [{ "attack": [{ "card": "Goblin General", "at": "p1" }] }, { "advance_to": "Main2" }],
    "expect": {
      "players": [{}, { "life": 18 }],
      "pt": { "Goblin General": [2, 2], "Goblin Glory Chaser": [2, 2], "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "opponent's Goblins are not pumped",
    "players": [{ "battlefield": ["Goblin General"] }, { "battlefield": ["Goblin Glory Chaser"] }],
    "steps": [{ "attack": [{ "card": "Goblin General", "at": "p1" }] }, { "advance_to": "Main2" }],
    "expect": { "players": [{}, { "life": 18 }], "pt": { "Goblin Glory Chaser": [1, 1] } }
  }
]
