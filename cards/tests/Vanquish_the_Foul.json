[
  {
    "name": "destroys a creature with power 4 or greater",
    "players": [{ "hand": ["Vanquish the Foul"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Serra Angel"] }],
    "steps": [{ "cast": "Vanquish the Foul", "targets": ["Serra Angel"] }, { "resolve": true }],
    "expect": { "players": [{}, { "graveyard_has": ["Serra Angel"] }] }
  },
  {
    "name": "cannot target a creature with power below 4",
    "players": [{ "hand": ["Vanquish the Foul"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Vanquish the Foul", "illegal": true }],
    "expect": { "players": [{ "hand": ["Vanquish the Foul"] }, { "battlefield_has": ["Grizzly Bears"] }] }
  },
  {
    "name": "ruling: if its only target is gone on resolution, it does not resolve and there is no scry",
    "players": [{ "hand": ["Vanquish the Foul"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "library": ["Lightning Bolt", "Grizzly Bears"] }, { "hand": ["Unsummon"], "battlefield": ["Island", "Serra Angel"] }],
    "steps": [{ "cast": "Vanquish the Foul", "targets": ["Serra Angel"] }, { "pass": true }, { "cast": "Unsummon", "targets": ["Serra Angel"], "player": 1 }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Vanquish the Foul"], "library_top": ["Lightning Bolt", "Grizzly Bears"] }, { "graveyard": ["Unsummon"], "battlefield_lacks": ["Serra Angel"] }] }
  },
  {
    "name": "ruling: scry 1 can keep the card on top (order unchanged) while the spell still destroys",
    "players": [{ "hand": ["Vanquish the Foul"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "library": ["Lightning Bolt", "Grizzly Bears"] }, { "battlefield": ["Serra Angel"] }],
    "steps": [{ "cast": "Vanquish the Foul", "targets": ["Serra Angel"] }, { "resolve": true, "answers": [[]] }],
    "expect": { "players": [{ "graveyard": ["Vanquish the Foul"], "library_top": ["Lightning Bolt", "Grizzly Bears"] }, { "graveyard": ["Serra Angel"] }] }
  },
  {
    "name": "ruling: scry 1 can put the card on the bottom, so the next card is the one below it",
    "players": [{ "hand": ["Vanquish the Foul"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "library": ["Lightning Bolt", "Grizzly Bears"] }, { "battlefield": ["Serra Angel"] }],
    "steps": [{ "cast": "Vanquish the Foul", "targets": ["Serra Angel"] }, { "resolve": true, "answers": [["Lightning Bolt"]] }],
    "expect": { "players": [{ "graveyard": ["Vanquish the Foul"], "library_top": ["Grizzly Bears"] }, { "graveyard": ["Serra Angel"] }] }
  }
]
