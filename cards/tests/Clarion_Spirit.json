[
  {
    "name": "second spell each turn creates a flying Spirit",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Clarion Spirit", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Clarion Spirit", "Spirit"] },
        { "life": 14 }
      ],
      "keywords": { "Spirit": ["Flying"] }
    }
  },
  {
    "name": "first spell of the turn creates no token",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Clarion Spirit", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Spirit"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: spells cast before it entered count, so a later third spell does not trigger it",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt", "Clarion Spirit", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Clarion Spirit" }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Clarion Spirit"], "battlefield_lacks": ["Spirit"] }, { "life": 11 } ]
    }
  },
  {
    "name": "ruling: casting it as your own second spell does not trigger it",
    "players": [
      { "hand": ["Lightning Bolt", "Clarion Spirit"], "battlefield": ["Mountain", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Clarion Spirit" }, { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Clarion Spirit"], "battlefield_lacks": ["Spirit"] }, { "life": 17 } ]
    }
  },
  {
    "name": "ruling: the trigger still fires when the first spell is on the stack, resolving before the second spell",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Clarion Spirit", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Clarion Spirit", "Spirit"] }, { "life": 14 } ],
      "keywords": { "Spirit": ["Flying"] }
    }
  }
]
