[
  {
    "name": "{4}: becomes a 4/2 Golem artifact creature until end of turn",
    "players": [
      { "battlefield": ["Dread Statuary", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Dread Statuary", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Dread Statuary": [4, 2] },
      "players": [
        { "battlefield_has": ["Dread Statuary"] },
        {}
      ]
    }
  },
  {
    "name": "three mana (including its own colourless) is not enough",
    "players": [
      { "battlefield": ["Dread Statuary", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Dread Statuary", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        {},
        {}
      ]
    }
  },
  {
    "name": "taps for colourless mana",
    "players": [
      { "hand": ["Sol Ring"], "battlefield": ["Dread Statuary"] },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Sol Ring"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a land under your control since the turn began can attack once animated",
    "players": [ { "battlefield": ["Dread Statuary", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Dread Statuary", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Dread Statuary", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Dread Statuary": [4, 2] }, "players": [ { "battlefield_has": ["Dread Statuary"] }, { "life": 16 } ] }
  },
  {
    "name": "ruling: becoming a creature does not make a creature enter (Soul Warden does not trigger)",
    "players": [ { "hand": ["Mogg Fanatic"], "battlefield": ["Dread Statuary", "Soul Warden", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Dread Statuary", "ability": 0 },
      { "resolve": true },
      { "cast": "Mogg Fanatic" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Dread Statuary": [4, 2] }, "players": [ { "life": 21, "battlefield_has": ["Dread Statuary", "Mogg Fanatic"] }, {} ] }
  }
]
