  {
    "name": "ruling: scry 2 can put some cards on top and the rest on the bottom",
    "players": [
      {
        "hand": ["Fated Conflagration"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Lightning Bolt", "Grizzly Bears", "Island"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Fated Conflagration", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": [["Lightning Bolt"]] }
