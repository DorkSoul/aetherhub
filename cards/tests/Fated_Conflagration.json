  {
    "name": "ruling: all targets illegal on resolution means no scry",
    "players": [
      {
        "hand": ["Fated Conflagration"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Grizzly Bears", "Island"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Hill Giant", "Mountain"]
      }
    ],
    "steps": [
      { "cast": "Fated Conflagration", "targets": ["Hill Giant"] },
