[
  {
    "name": "entering creates a tapped Meteorite token",
    "players": [
      { "hand": ["Roxanne, Starfall Savant"], "battlefield": ["Mountain", "Forest", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Roxanne, Starfall Savant" },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Roxanne, Starfall Savant", "Meteorite"] },
        { "life": 18 }
      ],
      "tapped": { "Meteorite": true }
    }
  },
  {
    "name": "attacking creates a tapped Meteorite token",
    "players": [
      { "battlefield": [{ "name": "Roxanne, Starfall Savant", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Roxanne, Starfall Savant", "at": "p1" }] },
      { "block": [], "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Roxanne, Starfall Savant", "Meteorite"] },
        { "life": 14 }
      ],
      "tapped": { "Meteorite": true }
    }
  },
  {
    "name": "tapping a Treasure token for mana adds one more mana of the type it produced",
    "players": [
      { "hand": ["Dockside Extortionist"], "battlefield": ["Roxanne, Starfall Savant", "Mountain", "Sol Ring"] },
      { "battlefield": ["Sol Ring", "Pacifism"] }
    ],
    "steps": [
      { "cast": "Dockside Extortionist" },
      { "resolve": true },
      { "resolve": true },
      { "tap_for_mana": "Treasure", "color": "G" }
    ],
    "expect": {
      "players": [{ "pool": { "G": 2 } }, {}]
    }
  },
  {
    "name": "a nontoken artifact tapped for mana does not trigger it",
    "players": [
      { "battlefield": ["Roxanne, Starfall Savant", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Sol Ring" }
    ],
    "expect": {
      "players": [{ "pool": { "C": 2 } }, {}]
    }
  },
  {
    "name": "tapping a Treasure token for mana adds one more mana of that colour",
    "players": [ { "battlefield": ["Roxanne, Starfall Savant", "Treasure"] }, {} ],
    "steps": [ { "tap_for_mana": "Treasure", "color": "R" } ],
    "expect": { "players": [ { "pool": { "R": 2 } }, {} ] }
  },
  {
    "name": "ruling: a Treasure tapped for white adds one more white mana (white is one of the five colour types)",
    "players": [ { "battlefield": ["Roxanne, Starfall Savant", "Treasure"] }, {} ],
    "steps": [ { "tap_for_mana": "Treasure", "color": "W" } ],
    "expect": { "players": [ { "pool": { "W": 2 } }, {} ] }
  }
]
