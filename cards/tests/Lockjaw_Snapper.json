[
  {
    "name": "dies: a -1/-1 counter goes on each creature that already has one",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Lockjaw Snapper"] },
      {
        "battlefield": [
          { "name": "Hill Giant", "counters": { "m1m1": 1 } },
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Lockjaw Snapper"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt", "Lockjaw Snapper"] }, { "battlefield_has": ["Hill Giant", "Grizzly Bears"] }],
      "counters": { "Hill Giant": { "m1m1": 2 } },
      "pt": { "Hill Giant": [1, 1], "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "dies with no creature carrying a -1/-1 counter: nothing else changes",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Lockjaw Snapper"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Lockjaw Snapper"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt", "Lockjaw Snapper"] }, { "battlefield_has": ["Grizzly Bears"] }],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: each creature gets just one new -1/-1 counter regardless of how many it already has",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Lockjaw Snapper"] },
      { "battlefield": [ { "name": "Garrison Excavator", "counters": { "m1m1": 2 } } ] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Lockjaw Snapper"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt", "Lockjaw Snapper"] }, { "battlefield_has": ["Garrison Excavator"] }],
      "counters": { "Garrison Excavator": { "m1m1": 3 } },
      "pt": { "Garrison Excavator": [0, 1] }
    }
  }
]
