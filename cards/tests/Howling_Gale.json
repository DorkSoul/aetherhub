[
 {
  "name": "1 damage to each flyer and each player",
  "players": [
   {
    "hand": [
     "Howling Gale"
    ],
    "battlefield": [
     "Forest",
     "Forest"
    ]
   },
   {
    "battlefield": [
     "Serra Angel",
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Howling Gale"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 19,
     "graveyard": [
      "Howling Gale"
     ]
    },
    {
     "life": 19,
     "battlefield_has": [
      "Serra Angel",
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "flashback from the graveyard, then exiled",
  "players": [
   {
    "graveyard": [
     "Howling Gale"
    ],
    "battlefield": [
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Howling Gale",
    "alt": 0
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 19,
     "exile": [
      "Howling Gale"
     ]
    },
    {
     "life": 19
    }
   ]
  }
 },
 {
  "name": "ruling: flashback the same turn the card hits the graveyard, then it is exiled",
  "players": [ { "hand": ["Howling Gale"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Howling Gale" }, { "resolve": true }, { "cast": "Howling Gale", "alt": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "life": 18, "exile": ["Howling Gale"] }, { "life": 18 } ] }
 },
 {
  "name": "ruling: a countered flashback spell is still exiled",
  "players": [ { "graveyard": ["Howling Gale"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Island", "Island"], "hand": ["Counterspell"] } ],
  "steps": [ { "cast": "Howling Gale", "alt": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1 }, { "pass": true, "player": 1 }, { "pass": true } ],
  "expect": { "players": [ { "life": 20, "exile": ["Howling Gale"] }, { "life": 20 } ] }
 }
]