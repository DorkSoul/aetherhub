[
  {
    "name": "creature dies: damage equal to target player's hand size",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Vicious Shadows"
        ]
      },
      {
        "hand": [
          "Swamp",
          "Swamp"
        ],
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true,
        "targets": [
          "p1"
        ],
        "answers": [
          true
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 18,
          "graveyard_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "declining the may: no damage",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Vicious Shadows"
        ]
      },
      {
        "hand": [
          "Swamp",
          "Swamp"
        ],
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true,
        "targets": [
          "p1"
        ],
        "answers": [
          false
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: the hand size is counted when the ability resolves, after the targeted player responds",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Vicious Shadows"]
      },
      {
        "hand": ["Lightning Bolt", "Swamp", "Swamp"],
        "battlefield": ["Mountain", "Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true, "targets": ["p1"] },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "life": 17 },
        { "life": 18, "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the targeted player does not have to be the controller of the creature that died",
    "players": [
      {
        "hand": ["Lightning Bolt", "Swamp", "Swamp"],
        "battlefield": ["Mountain", "Vicious Shadows"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "targets": ["p0"], "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18 },
        { "life": 20, "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]
