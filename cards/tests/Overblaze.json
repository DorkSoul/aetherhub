[
 {
  "name": "plain cast: the target permanent's combat damage is doubled",
  "players": [ { "hand": ["Overblaze"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
  "steps": [ { "cast": "Overblaze", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
  "expect": { "players": [ { "hand": [] }, { "life": 16 } ] }
 },
 {
  "name": "a permanent that was not the target is not doubled",
  "players": [ { "hand": ["Overblaze"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] }, {} ],
  "steps": [ { "cast": "Overblaze", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
  "expect": { "players": [ { "hand": [] }, { "life": 13 } ] }
 },
 {
  "name": "spliced onto Blind with Anger: the second target (Hill Giant) deals double damage",
  "players": [ { "hand": ["Blind with Anger", "Overblaze"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Swamp", "Swamp", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Blind with Anger", "targets": ["Grizzly Bears", "Hill Giant"], "answers": [true] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
  "expect": { "players": [ { "hand": ["Overblaze"] }, { "life": 12 } ] }
 },
 {
  "name": "ruling: if the only target becomes illegal in response, Overblaze does not resolve at all",
  "players": [ { "hand": ["Overblaze"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, { "hand": ["Unsummon"], "battlefield": ["Island"] } ],
  "steps": [
    { "cast": "Overblaze", "targets": ["Grizzly Bears"] },
    { "pass": true },
    { "cast": "Unsummon", "targets": ["Grizzly Bears"], "player": 1 },
    { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Overblaze"] }, { "graveyard": ["Unsummon"] } ] }
 }
]
