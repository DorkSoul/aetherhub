[
 { "name": "enters untapped with two basic lands",
   "players": [ { "hand": ["Canopy Vista"], "battlefield": ["Forest", "Island"] }, {} ],
   "steps": [ { "play_land": "Canopy Vista" } ],
   "expect": { "tapped": { "Canopy Vista": false } } },
 { "name": "enters tapped with only one basic land",
   "players": [ { "hand": ["Canopy Vista"], "battlefield": ["Forest"] }, {} ],
   "steps": [ { "play_land": "Canopy Vista" } ],
   "expect": { "tapped": { "Canopy Vista": true } } },
 { "name": "enters tapped with no basic lands",
   "players": [ { "hand": ["Canopy Vista"], "battlefield": [] }, {} ],
   "steps": [ { "play_land": "Canopy Vista" } ],
   "expect": { "tapped": { "Canopy Vista": true } } },
 { "name": "nonbasic lands do not count; opponent's basics do not count",
   "players": [ { "hand": ["Canopy Vista"], "battlefield": ["Forest", "Command Tower"] }, { "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "play_land": "Canopy Vista" } ],
   "expect": { "tapped": { "Canopy Vista": true } } },
 { "name": "taps for green (it is a Forest Plains)",
   "players": [ { "battlefield": ["Canopy Vista"], "hand": ["Llanowar Elves"] }, {} ],
   "steps": [ { "cast": "Llanowar Elves" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield": ["Canopy Vista", "Llanowar Elves"] } ] } },
 { "name": "taps for white",
   "players": [ { "battlefield": ["Canopy Vista"], "hand": ["Savannah Lions"] }, {} ],
   "steps": [ { "cast": "Savannah Lions" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield": ["Canopy Vista", "Savannah Lions"] } ] } },
 { "name": "ruling: a Canopy Vista is a Forest, so Arbor Elf can target and untap it",
   "players": [ { "battlefield": ["Arbor Elf", { "name": "Canopy Vista", "tapped": true }] }, {} ],
   "steps": [ { "activate": "Arbor Elf", "targets": ["Canopy Vista"] }, { "resolve": true } ],
   "expect": { "tapped": { "Canopy Vista": false } } },
 { "name": "ruling: two Prairie Streams do not make a Canopy Vista enter untapped",
   "players": [ { "hand": ["Canopy Vista"], "battlefield": ["Prairie Stream", "Prairie Stream"] }, {} ],
   "steps": [ { "play_land": "Canopy Vista" } ],
   "expect": { "tapped": { "Canopy Vista": true } } }
]
