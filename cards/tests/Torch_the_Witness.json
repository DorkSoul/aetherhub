[
  {
    "name": "X=2 deals 4 to a 2/2: excess investigates",
    "players": [
      {
        "hand": ["Torch the Witness"],
        "battlefield": ["Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Torch the Witness", "targets": ["Grizzly Bears"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Torch the Witness"], "battlefield": ["Mountain", "Mountain", "Mountain", "Clue"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "X=1 deals exactly lethal to a 2/2: no excess, no Clue",
    "players": [
      {
        "hand": ["Torch the Witness"],
        "battlefield": ["Mountain", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Torch the Witness", "targets": ["Grizzly Bears"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Torch the Witness"] },
        { "graveyard": ["Grizzly Bears"], "battlefield": [] }
      ]
    }
  },
  { "name": "ruling: excess is measured against damage already dealt this turn (Serra Angel has 3 damage)",
    "players": [ { "hand": ["Lightning Bolt", "Torch the Witness"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Serra Angel"] }, { "resolve": true }, { "cast": "Torch the Witness", "targets": ["Serra Angel"], "answers": [1] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Clue"] }, { "graveyard_has": ["Serra Angel"] } ] } },
  { "name": "ruling: target gone when Torch resolves (opponent kills it in response): no Clue",
    "players": [ { "hand": ["Torch the Witness"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Torch the Witness", "targets": ["Grizzly Bears"], "answers": [2] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Torch the Witness"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] } }
]
