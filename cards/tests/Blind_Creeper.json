[
  { "name": "a spell cast by you gives it -1/-1 until end of turn",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Blind Creeper"] }, { } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Blind Creeper": [2, 2] } } },
  { "name": "a spell cast by the opponent also gives it -1/-1",
    "players": [ { "battlefield": ["Blind Creeper"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "pt": { "Blind Creeper": [2, 2] } } },
  { "name": "ruling: the controller's own spell and then an opponent's spell each give it -1/-1",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Blind Creeper"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, { "life": 17 } ], "pt": { "Blind Creeper": [1, 1] } } }
]
