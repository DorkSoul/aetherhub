[
  { "name": "ruling: a foretold non-instant cannot be cast on the turn it was foretold (5 lands would otherwise pay {3}{U}{R})",
    "players": [ { "hand": ["Frost Fair Lure Fish"], "battlefield": ["Island", "Mountain", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Frost Fair Lure Fish", "ability": 0 }, { "resolve": true }, { "cast": "Frost Fair Lure Fish", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Frost Fair Lure Fish"] }, {} ] } },
  { "name": "ruling: foretell is a special action, so it can be taken in response to a spell during your turn",
    "players": [ { "hand": ["Frost Fair Lure Fish", "Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "activate": "Frost Fair Lure Fish", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Frost Fair Lure Fish"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "enters: two 1/1 Fish tokens and two tapped Treasures",
    "players": [ { "hand": ["Frost Fair Lure Fish"], "battlefield": ["Island", "Mountain", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Frost Fair Lure Fish" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Frost Fair Lure Fish", "Fish", "Fish", "Treasure", "Treasure"] }, {} ] } },
  { "name": "Fish have haste: a fresh Fish attacks the turn it comes in",
    "players": [ { "battlefield": [ { "name": "Frost Fair Lure Fish", "sick": true } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Frost Fair Lure Fish", "at": "p1" } ] }, { "block": [] , "player": 1 }, { "advance_to": "Main2", "auto": true }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ {}, { "life": 13 } ] } },
  { "name": "Fish can't be blocked by Humans",
    "players": [ { "battlefield": [ { "name": "Frost Fair Lure Fish", "sick": true } ] }, { "battlefield": ["Haliya, Guided by Light"] } ],
    "steps": [ { "attack": [ { "card": "Frost Fair Lure Fish", "at": "p1" } ] },
               { "block": [ { "blocker": "Haliya, Guided by Light", "attacker": "Frost Fair Lure Fish" } ], "player": 1, "illegal": true },
               { "block": [], "player": 1 }, { "advance_to": "Main2", "auto": true }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ {}, { "life": 13 } ] } },
  { "name": "foretold: pay {2} on your turn, then cast from exile on a later turn for {3}{U}{R}",
    "players": [ { "hand": ["Frost Fair Lure Fish"], "battlefield": ["Island", "Mountain", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Frost Fair Lure Fish", "ability": 0 }, { "resolve": true }, { "advance_to": "End" },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Frost Fair Lure Fish", "alt": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Frost Fair Lure Fish", "Fish", "Fish", "Treasure", "Treasure"], "exile": [] }, {} ] } },
  { "name": "Fish can't be blocked by Humans: Haliya's block is dropped, the Bears are not declared, so the 7/7 is unblocked",
    "players": [ { "battlefield": ["Frost Fair Lure Fish"] }, { "battlefield": ["Haliya, Guided by Light", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Frost Fair Lure Fish", "at": "p1" } ] },
               { "block": [ { "blocker": "Haliya, Guided by Light", "attacker": "Frost Fair Lure Fish" } ], "player": 1 },
               { "advance_to": "Main2", "auto": true }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ {}, { "life": 13 } ] } }
]
