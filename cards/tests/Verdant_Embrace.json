      { "hand": ["Verdant Embrace"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Verdant Embrace", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [5, 5] },
      "attached": { "Verdant Embrace": "Grizzly Bears" }
    }
  },
  {
    "name": "each upkeep makes a Saproling for the enchanted creature's controller",
    "players": [
      { "hand": ["Verdant Embrace"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Verdant Embrace", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Saproling"] },
        {}
      ]
    }
  },
  {
    "name": "enchanting an opponent's creature: the token comes under the opponent's control",
    "players": [
      { "hand": ["Verdant Embrace"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Verdant Embrace", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Saproling"] },
        { "battlefield_has": ["Saproling"] }
      ]
    }
  },
  {
    "name": "ruling: the upkeep token is controlled by the enchanted creature's controller, not Verdant Embrace's controller",
    "players": [
      { "hand": ["Verdant Embrace"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Verdant Embrace", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Saproling"], "battlefield_has": ["Verdant Embrace"] },
        { "battlefield_has": ["Grizzly Bears", "Saproling"] }
      ]
    }
  }
]
