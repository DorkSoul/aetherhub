[
  {
    "name": "with metalcraft, opposing creatures lose abilities and become 1/1 until end of turn",
    "players": [
      {
        "battlefield": [
          "Vedalken Humiliator",
          "Sol Ring",
          "Chromatic Lantern",
          "Abzan Banner"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Vedalken Humiliator",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "pt": {
        "Serra Angel": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "without metalcraft the trigger does nothing",
    "players": [
      {
        "battlefield": [
          "Vedalken Humiliator",
          "Sol Ring",
          "Abzan Banner"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Vedalken Humiliator",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17
        }
      ],
      "pt": {
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "ruling: counters on an opposing creature apply on top of its new base 1/1",
    "players": [
      { "battlefield": ["Vedalken Humiliator", "Sol Ring", "Chromatic Lantern", "Abzan Banner"] },
      { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } } ] }
    ],
    "steps": [
      { "attack": [ { "card": "Vedalken Humiliator", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: losing the metalcraft artifacts after the trigger resolves does not end the effect",
    "players": [
      { "battlefield": ["Vedalken Humiliator", "Sol Ring", "Chromatic Lantern", "Mishra's Bauble"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Vedalken Humiliator", "at": "p1" } ] },
      { "resolve": true },
      { "activate": "Mishra's Bauble", "ability": 0, "targets": ["p0"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Grizzly Bears": [1, 1] }
    }
  },
  {
    "name": "ruling: every opposing creature is affected, not only one",
    "players": [
      { "battlefield": ["Vedalken Humiliator", "Sol Ring", "Chromatic Lantern", "Abzan Banner"] },
      { "battlefield": ["Serra Angel", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Vedalken Humiliator", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Serra Angel": [1, 1], "Grizzly Bears": [1, 1] }
    }
  }
]