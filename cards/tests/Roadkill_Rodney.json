      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Roadkill Rodney", "Roadkill Rodney"] },
        {}
      ]
    }
  },
  {
    "name": "combat damage to a player creates a Mutagen token",
    "players": [
      { "battlefield": ["Roadkill Rodney", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Roadkill Rodney", "at": "p1" } ] },
      { "block": [] },
