    "expect": {
      "players": [
        { "hand_count": 1, "battlefield_has": ["Roadkill Rodney", "Roadkill Rodney"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: squad paid twice creates two token copies",
    "players": [
      { "hand": ["Roadkill Rodney"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
