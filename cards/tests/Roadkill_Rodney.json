      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Roadkill Rodney", "Mutagen"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "blocked by a creature: no Mutagen token",
    "players": [
      { "battlefield": ["Roadkill Rodney", "Mountain"] },
      { "battlefield": ["Wall of Stone"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Roadkill Rodney", "at": "p1" } ] },
      { "block": [ { "blocker": "Wall of Stone", "attacker": "Roadkill Rodney" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Mutagen"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: a countered squad spell creates no token copies",
    "players": [
      { "hand": ["Roadkill Rodney"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Force Spike"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "cast": "Roadkill Rodney", "answers": [1] },
      { "cast": "Force Spike", "player": 1, "targets": [{ "stack": "Roadkill Rodney" }] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Roadkill Rodney"], "graveyard_has": ["Roadkill Rodney"] },
        { "graveyard_has": ["Force Spike"] }
      ]
    }
  },
  {
    "name": "ruling: Rodney leaves before its squad trigger resolves; the token copy is still created",
    "players": [
      { "hand": ["Roadkill Rodney", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Roadkill Rodney", "answers": [1] },
      { "resolve": true },
