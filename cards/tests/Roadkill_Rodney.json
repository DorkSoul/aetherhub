[
  {
    "name": "unkicked: a single 2/1 and no token copies",
    "players": [
      { "hand": ["Roadkill Rodney"], "battlefield": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Roadkill Rodney" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Roadkill Rodney": [2, 1] },
      "players": [
        { "battlefield_has": ["Roadkill Rodney"], "battlefield_lacks": ["Mutagen"] },
        {}
      ]
    }
  },
  {
    "name": "squad paid once: one token copy enters",
