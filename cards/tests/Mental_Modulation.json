[
  {
    "name": "costs {U} on your turn and taps the target creature, then draws",
    "players": [{ "hand": ["Mental Modulation"], "battlefield": ["Island"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Mental Modulation", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "players": [{ "hand_count": 1, "graveyard": ["Mental Modulation"] }, {}], "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "still costs {1}{U} on the bumped cost: one land is not enough off-turn",
    "players": [{ "hand": ["Mental Modulation"], "battlefield": [] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Mental Modulation", "targets": ["Grizzly Bears"], "illegal": true }],
    "expect": { "players": [{ "hand": ["Mental Modulation"] }, {}] }
  },
  {
    "name": "ruling: if the target is gone on resolution, nothing happens and you draw no card",
    "players": [{ "hand": ["Mental Modulation"], "battlefield": ["Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }],
    "steps": [
      { "cast": "Mental Modulation", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "hand_count": 0, "graveyard": ["Mental Modulation"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }] }
  }
]
