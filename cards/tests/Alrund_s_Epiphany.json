    "steps": [ { "cast": "Alrund's Epiphany" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Alrund's Epiphany"], "battlefield_has": ["Bird 1-1 Blue Flying"] }, {} ] } },
  { "name": "foretold for {2}, cast for {4}{U}{U} on a later turn",
    "players": [ { "hand": ["Alrund's Epiphany"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Alrund's Epiphany", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" },
               { "advance_to": "Main1" }, { "cast": "Alrund's Epiphany", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Alrund's Epiphany"], "battlefield_has": ["Bird 1-1 Blue Flying"] }, {} ] } },
  { "name": "cannot be cast for its foretell cost the same turn it was foretold",
    "players": [ { "hand": ["Alrund's Epiphany"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Alrund's Epiphany", "ability": 0 }, { "resolve": true }, { "cast": "Alrund's Epiphany", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Alrund's Epiphany"] }, {} ] } },
  { "name": "ruling: foretelling is a special action that can be taken in response to a spell",
    "players": [ { "hand": ["Alrund's Epiphany", "Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Alrund's Epiphany", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Alrund's Epiphany"] }, { "life": 17 } ] } },
  { "name": "ruling: an Epiphany exiled by its own resolution is face up, not foretold, so it cannot be cast from exile for the foretell cost",
    "players": [ { "hand": ["Alrund's Epiphany"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Alrund's Epiphany" }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Alrund's Epiphany", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Alrund's Epiphany"] }, {} ] } },
  { "name": "ruling: a foretold sorcery cannot be cast on the opponent's turn, only on your later turn",
    "players": [ { "hand": ["Alrund's Epiphany"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Alrund's Epiphany", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Alrund's Epiphany", "alt": 0, "illegal": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Alrund's Epiphany", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Alrund's Epiphany"], "battlefield_has": ["Bird 1-1 Blue Flying"] }, {} ] } }
