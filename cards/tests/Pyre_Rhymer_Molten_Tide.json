[
 { "name": "enters prepared; until end of turn tapping a Mountain adds an additional R",
   "players": [ { "hand": ["Pyre Rhymer // Molten Tide"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Stomping Ground"] }, {} ],
   "steps": [ { "cast": "Pyre Rhymer // Molten Tide" }, { "resolve": true },
              { "cast": "Molten Tide" }, { "resolve": true },
              { "tap_for_mana": "Stomping Ground" } ],
   "expect": { "players": [ { "pool": { "R": 2 } }, {} ] } },
 { "name": "only Mountains get the extra mana",
   "players": [ { "hand": ["Pyre Rhymer // Molten Tide"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Island"] }, {} ],
   "steps": [ { "cast": "Pyre Rhymer // Molten Tide" }, { "resolve": true },
              { "cast": "Molten Tide" }, { "resolve": true },
              { "tap_for_mana": "Island" } ],
   "expect": { "players": [ { "pool": { "U": 1 } }, {} ] } },
 { "name": "the instant cannot be cast from hand",
   "players": [ { "hand": ["Pyre Rhymer // Molten Tide"], "battlefield": ["Mountain"] }, {} ],
   "steps": [ { "cast": "Molten Tide", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Pyre Rhymer // Molten Tide"] }, {} ] } }
]
