[
  {
    "name": "combat damage to a player creates a Food",
    "players": [
      {
        "battlefield": [
          "Rapacious Guest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Rapacious Guest",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Food"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "leaves the battlefield: target opponent loses life equal to its power",
    "players": [
      {
        "battlefield": [
          "Rapacious Guest"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "Rapacious Guest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Rapacious Guest"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "sacrificing a Food (Ragost) puts a +1/+1 counter on Rapacious Guest",
    "players": [ { "battlefield": ["Rapacious Guest", "Ragost, Deft Gastronaut", "Food", "Swamp"] }, {} ],
    "steps": [ { "activate": "Ragost, Deft Gastronaut", "ability": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Rapacious Guest": [3, 3] }, "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "ruling: the power used is on the battlefield (3 with a counter), not in the graveyard",
    "players": [
      { "battlefield": [ { "name": "Rapacious Guest", "counters": { "PlusOnePlusOne": 1 } } ] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Rapacious Guest"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Rapacious Guest"] }, { "life": 17 } ] }
  },
  {
    "name": "ruling: a Food sacrificed as another permanent's cost still triggers Rapacious Guest",
    "players": [ { "battlefield": ["Rapacious Guest", "Maraleaf Rider", "Food"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Rapacious Guest": [3, 3] } }
  },
  {
    "name": "ruling: a Food artifact creature (Tough Cookie) can be sacrificed to Ragost and triggers Rapacious Guest",
    "players": [ { "battlefield": ["Rapacious Guest", "Ragost, Deft Gastronaut", "Tough Cookie", "Swamp"] }, {} ],
    "steps": [ { "activate": "Ragost, Deft Gastronaut", "ability": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Rapacious Guest": [3, 3] } }
  },
  {
    "name": "ruling: one Food cannot pay for two abilities",
    "players": [ { "battlefield": ["Rapacious Guest", "Ragost, Deft Gastronaut", "Maraleaf Rider", "Food", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Ragost, Deft Gastronaut", "ability": 0 }, { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  }
]
