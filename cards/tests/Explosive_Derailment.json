[
 {
  "name": "first mode only: 4 damage to a creature for {R}+{2}",
  "players": [
   { "hand": ["Explosive Derailment"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Explosive Derailment", "answers": [[0]], "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Explosive Derailment"] }, { "graveyard": ["Hill Giant"] } ] }
 },
 {
  "name": "second mode only: destroy an artifact for {R}+{2}",
  "players": [
   { "hand": ["Explosive Derailment"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Accorder's Shield"] }
  ],
  "steps": [
   { "cast": "Explosive Derailment", "answers": [[1]], "targets": ["Accorder's Shield"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, { "graveyard": ["Accorder's Shield"] } ] }
 },
 {
  "name": "both modes for {R}+{2}+{2}: the creature and the artifact both die",
  "players": [
   { "hand": ["Explosive Derailment"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant", "Accorder's Shield"] }
  ],
  "steps": [
   { "cast": "Explosive Derailment", "answers": [[0, 1]], "targets": ["Hill Giant", "Accorder's Shield"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, { "graveyard": ["Hill Giant", "Accorder's Shield"] } ] }
 },
 {
  "name": "a spree mode cannot be chosen without its additional cost",
  "players": [
   { "hand": ["Explosive Derailment"], "battlefield": ["Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Explosive Derailment", "answers": [[0]], "targets": ["Hill Giant"], "illegal": true }
  ],
  "expect": { "players": [ { "hand": ["Explosive Derailment"] }, { "battlefield_has": ["Hill Giant"] } ] }
 },
 {
  "name": "ruling: an unchosen creature mode is ignored, so the creature stays when only the artifact mode is chosen",
  "players": [
   { "hand": ["Explosive Derailment"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant", "Accorder's Shield"] }
  ],
  "steps": [
   { "cast": "Explosive Derailment", "answers": [[1]], "targets": ["Accorder's Shield"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, { "graveyard": ["Accorder's Shield"], "battlefield_has": ["Hill Giant"] } ] }
 },
 {
  "name": "ruling: Bolt kills the creature in response; the artifact mode still resolves",
  "players": [
   { "hand": ["Explosive Derailment"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant", "Accorder's Shield"] }
  ],
  "steps": [
   { "cast": "Explosive Derailment", "answers": [[0, 1]], "targets": ["Hill Giant", "Accorder's Shield"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Explosive Derailment"] }, { "graveyard_has": ["Hill Giant", "Accorder's Shield", "Lightning Bolt"] } ] }
 }
]
