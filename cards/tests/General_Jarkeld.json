      {
        "battlefield": [
          {
            "name": "General Jarkeld",
            "sick": false
          },
          "Savannah Lions",
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears",
          "Craw Wurm"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End",
        "auto": true
      },
      {
        "advance_to": "Main1",
        "auto": true
      },
      {
        "player": 1,
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p0"
          },
          {
            "card": "Craw Wurm",
            "at": "p0"
          }
        ]
      },
      {
        "player": 0,
        "block": [
          {
            "blocker": "Hill Giant",
            "attacker": "Grizzly Bears"
          },
          {
            "blocker": "Savannah Lions",
            "attacker": "Craw Wurm"
          }
        ]
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "player": 0,
        "activate": "General Jarkeld",
        "targets": [
          "Grizzly Bears",
          "Craw Wurm"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Hill Giant",
            "Savannah Lions"
          ]
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
