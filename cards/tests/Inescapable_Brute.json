[
  { "name": "must be blocked if able: declining to block is illegal",
    "players": [ { "battlefield": ["Inescapable Brute"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Inescapable Brute", "at": "p1" } ] }, { "block": [], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Inescapable Brute"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "blocked by a creature that can block: wither puts -1/-1 counters on the blocker",
    "players": [ { "battlefield": ["Inescapable Brute"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Inescapable Brute", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Inescapable Brute" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Inescapable Brute"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "must be blocked if able: an undeclared Grizzly Bears is forced to block (Bears dies, no damage)",
    "players": [ { "battlefield": ["Inescapable Brute"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Inescapable Brute", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Inescapable Brute"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: with two possible blockers, blocking with just one satisfies the must-be-blocked requirement",
    "players": [ { "battlefield": ["Inescapable Brute"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Inescapable Brute", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Inescapable Brute" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Inescapable Brute"], "life": 20 }, { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"], "life": 20 } ] } }
]
