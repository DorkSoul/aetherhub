 {
  "name": "ruling: other mana tapped during combat is lost at the next step, firebending mana stays",
  "players": [
   { "battlefield": ["Azula, On the Hunt", "Swamp"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Azula, On the Hunt", "at": "p1" } ] },
   { "resolve": true },
   { "tap_for_mana": "Swamp" },
   { "advance_to": "EndCombat" }
  ],
  "expect": {
   "players": [
    { "life": 19, "pool": { "R": 2 } },
    { "life": 16 }
   ]
  }
 },
 {
  "name": "ruling: firebending mana can be spent after combat damage, before combat ends",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Azula, On the Hunt"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [ { "card": "Azula, On the Hunt", "at": "p1" } ] },
   { "resolve": true },
   { "block": [] },
   { "advance_to": "EndCombat" },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": [], "life": 19, "pool": { "R": 1 } },
    { "graveyard_has": ["Grizzly Bears"], "life": 16 }
   ]
  }
 },
 {
  "name": "ruling: firebending is a triggered ability on the stack, the opponent can respond to it",
  "players": [
   { "battlefield": ["Azula, On the Hunt"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "attack": [ { "card": "Azula, On the Hunt", "at": "p1" } ] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Azula, On the Hunt"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Azula, On the Hunt"], "battlefield_has": ["Clue"], "life": 19, "pool": { "R": 2 } },
    { "life": 20, "graveyard_has": ["Lightning Bolt"] }
   ]
  }
 }
]