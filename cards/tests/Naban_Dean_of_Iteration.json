[
  {
    "name": "a Wizard entering alongside Naban itself makes Soul Warden trigger twice (Naban counts itself)",
    "players": [
      { "hand": ["Naban, Dean of Iteration"], "battlefield": ["Soul Warden", "Island", "Island"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Naban, Dean of Iteration" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 22, "battlefield_has": ["Naban, Dean of Iteration", "Soul Warden"] }, { "life": 20 }]
    }
  },
  {
    "name": "a Wizard you control entering makes Soul Warden trigger an additional time",
    "players": [
      { "hand": ["Tolarian Scholar"], "battlefield": ["Naban, Dean of Iteration", "Soul Warden", "Island", "Island", "Island"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Tolarian Scholar" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 22, "battlefield_has": ["Tolarian Scholar"] }, { "life": 20 }]
    }
  },
  {
    "name": "a non-Wizard entering is not doubled",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Naban, Dean of Iteration", "Soul Warden", "Forest", "Forest"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 21, "battlefield_has": ["Grizzly Bears"] }, { "life": 20 }]
    }
  },
  {
    "name": "an opponent's Wizard entering is not doubled by your Naban",
    "players": [
      { "battlefield": ["Naban, Dean of Iteration", "Soul Warden"] },
      { "hand": ["Tolarian Scholar"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Draw" },
      { "advance_to": "Main1" },
      { "cast": "Tolarian Scholar", "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 21, "battlefield_has": ["Naban, Dean of Iteration", "Soul Warden"] }, { "life": 20, "battlefield_has": ["Tolarian Scholar"] }]
    }
  },
  {
    "name": "ruling: a Wizard's own enters trigger triggers an extra time, and each instance makes its own choice (Elite Arcanist)",
    "players": [
      { "hand": ["Elite Arcanist", "Lightning Bolt", "Shock"], "battlefield": ["Naban, Dean of Iteration", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Elite Arcanist" },
      { "resolve": true, "answers": ["Lightning Bolt", "Shock"] }
    ],
    "expect": {
      "players": [{ "hand_count": 0, "exile": ["Lightning Bolt", "Shock"], "battlefield_has": ["Elite Arcanist"] }, {}]
    }
  },
  {
    "name": "ruling: a trigger on a creature you control entering (Impact Tremors) also triggers an extra time for a Wizard entering",
    "players": [
      { "hand": ["Tolarian Scholar"], "battlefield": ["Naban, Dean of Iteration", "Impact Tremors", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Tolarian Scholar" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Tolarian Scholar"] }, { "life": 18 }]
    }
  },
  {
    "name": "ruling: a Runeclaw Bear that is a Wizard only through Arcane Adaptation makes Soul Warden trigger an additional time",
    "players": [
      { "hand": ["Arcane Adaptation", "Runeclaw Bear"], "battlefield": ["Naban, Dean of Iteration", "Soul Warden", "Island", "Island", "Island", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Arcane Adaptation" },
      { "resolve": true, "answers": ["Wizard"] },
      { "cast": "Runeclaw Bear" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 22, "battlefield_has": ["Runeclaw Bear", "Arcane Adaptation"] }, { "life": 20 }]
    }
  }
]
