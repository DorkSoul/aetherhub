[
  { "name": "dies, returns at the next end step and its controller skips the next draw step",
    "players": [
      { "battlefield": ["Plains", "Ivory Gargoyle"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Ivory Gargoyle"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "advance_to": "End", "auto": true },
      { "advance_to": "Main1", "auto": true }
    ],
    "expect": {
      "turn": 3,
      "players": [ { "battlefield_has": ["Ivory Gargoyle"], "hand_count": 0 }, {} ]
    }
  },
  { "name": "pay 4W to exile it: it does not return",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Ivory Gargoyle"] },
      {}
    ],
    "steps": [
      { "activate": "Ivory Gargoyle" },
      { "advance_to": "End", "auto": true }
    ],
    "expect": {
      "players": [ { "exile": ["Ivory Gargoyle"] }, {} ]
    }
  },
  { "name": "ruling: the exile ability cannot be activated from the graveyard",
    "players": [ { "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Ivory Gargoyle"] }, {} ],
    "steps": [ { "activate": "Ivory Gargoyle", "illegal": true } ],
    "expect": { "players": [ { "graveyard_has": ["Ivory Gargoyle"] }, {} ] } }
]
