[
  { "name": "enters: draw a card then discard a card",
    "players": [ { "hand": ["Oracle of Tragedy"], "battlefield": ["Island", "Plains"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Oracle of Tragedy" }, { "resolve": true, "answers": [[0]] } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Forest"], "battlefield_has": ["Oracle of Tragedy"] }, {} ] } },
  { "name": "enters: shuffle a graveyard card with mana value 3 or greater into the library",
    "players": [ { "hand": ["Oracle of Tragedy"], "battlefield": ["Island", "Plains"], "graveyard": ["Serra Angel"] }, {} ],
    "steps": [ { "cast": "Oracle of Tragedy" }, { "resolve": true, "answers": [[1], ["Serra Angel"]] } ],
    "expect": { "players": [ { "graveyard": [], "library_count": 21 }, {} ] } },
  { "name": "dies: choose draw then discard",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Oracle of Tragedy"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Oracle of Tragedy"] }, { "resolve": true, "answers": [[0]] } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Lightning Bolt", "Oracle of Tragedy", "Forest"] }, {} ] } },
  { "name": "dies: shuffle up to four graveyard cards with mana value 3 or greater (Opt is too cheap)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Oracle of Tragedy"], "graveyard": ["Serra Angel", "Opt"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Oracle of Tragedy"] }, { "resolve": true, "answers": [[1], ["Serra Angel"]] } ],
    "expect": { "players": [ { "graveyard_has": ["Opt", "Lightning Bolt", "Oracle of Tragedy"], "library_count": 21 }, {} ] } }
]
