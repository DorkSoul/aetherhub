[
  { "name": "counters a spell; its controller loses life equal to your creatures",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Deny the Witch"], "battlefield": ["Plains", "Island", "Swamp", "Swamp", "Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Deny the Witch", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 18, "graveyard_has": ["Lightning Bolt"] }, { "life": 20, "graveyard_has": ["Deny the Witch"] } ], "stack_empty": true } },
  { "name": "with no creatures of your own, its controller loses no life",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears", "Llanowar Elves"] },
      { "hand": ["Deny the Witch"], "battlefield": ["Plains", "Island", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Deny the Witch", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } }
]
