[
  { "name": "exiles your creature and returns it, then draws",
    "players": [ { "hand": ["Scrollshift"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Scrollshift", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand_count": 1 }, {} ] } },
  { "name": "up to one: choosing no target still draws",
    "players": [ { "hand": ["Scrollshift"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Scrollshift", "targets": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: if the target is gone on resolution, nothing happens and no card is drawn",
    "players": [ { "hand": ["Scrollshift"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Scrollshift", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Scrollshift", "Grizzly Bears"], "hand_count": 0, "battlefield_lacks": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ] } }
]
