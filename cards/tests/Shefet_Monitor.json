[
  { "name": "cycle: may search for a basic land onto the battlefield, then draw",
    "players": [ { "hand": ["Shefet Monitor"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "activate": "Shefet Monitor" }, { "resolve": true, "answers": [true, "Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"], "hand_count": 1, "graveyard": ["Shefet Monitor"] }, {} ] } },
  { "name": "cycle: declining the search still draws",
    "players": [ { "hand": ["Shefet Monitor"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "activate": "Shefet Monitor" }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Shefet Monitor"] }, {} ] } },
  { "name": "ruling: the search resolves before the cycling draw, so the fetched basic is not drawn",
    "players": [ { "hand": ["Shefet Monitor"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "activate": "Shefet Monitor" }, { "resolve": true, "answers": [true, "Island"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "battlefield_has": ["Island"], "graveyard": ["Shefet Monitor"] }, {} ] } }
]
