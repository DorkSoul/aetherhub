[
 {"name": "cast on a flyer: resolves to graveyard",
  "players": [{"hand": ["Canopy Claws"], "battlefield": ["Forest"]}, {"battlefield": ["Serra Angel"]}],
  "steps": [{"cast": "Canopy Claws", "targets": ["Serra Angel"]}, {"resolve": true}],
  "expect": {"players": [{"graveyard": ["Canopy Claws"]}, {"battlefield_has": ["Serra Angel"]}]}},
 {"name": "flashback from graveyard for G exiles the card",
  "players": [{"graveyard": ["Canopy Claws"], "battlefield": ["Forest"]}, {"battlefield": ["Serra Angel"]}],
  "steps": [{"cast": "Canopy Claws", "alt": 0, "targets": ["Serra Angel"]}, {"resolve": true}],
  "expect": {"players": [{"exile": ["Canopy Claws"], "graveyard": []}, {"battlefield_has": ["Serra Angel"]}]}},
 {"name": "flashback needs its G (no mana, illegal)",
  "players": [{"graveyard": ["Canopy Claws"]}, {"battlefield": ["Serra Angel"]}],
  "steps": [{"cast": "Canopy Claws", "alt": 0, "targets": ["Serra Angel"], "illegal": true}],
  "expect": {"players": [{"graveyard": ["Canopy Claws"]}, {}]}},
 {"name": "ruling: countered flashback spell is still exiled",
  "players": [{"graveyard": ["Canopy Claws"], "battlefield": ["Forest"]}, {"hand": ["Counterspell"], "battlefield": ["Island", "Island", "Serra Angel"]}],
  "steps": [{"cast": "Canopy Claws", "alt": 0, "targets": ["Serra Angel"]}, {"cast": "Counterspell", "player": 1, "targets": [{"stack": "Canopy Claws"}]}, {"resolve": true}],
  "expect": {"players": [{"exile": ["Canopy Claws"], "graveyard": []}, {"graveyard": ["Counterspell"], "battlefield_has": ["Serra Angel"]}]}}
]
