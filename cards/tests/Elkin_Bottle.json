[
  { "name": "exiled card can be played this turn",
    "players": [ { "library": ["Forest", "Island"], "battlefield": ["Elkin Bottle", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Elkin Bottle" }, { "resolve": true }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"], "exile": [] }, {} ] } },
  { "name": "permission lapses at the next upkeep",
    "players": [ { "library": ["Forest", "Island"], "battlefield": ["Elkin Bottle", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Elkin Bottle" }, { "resolve": true }, { "advance_to": "Main1", "auto": true }, { "advance_to": "Main1", "auto": true }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Forest"] }, {} ] } },
  { "name": "ruling: the exiled card is not drawn into hand",
    "players": [ { "library": ["Forest", "Island"], "battlefield": ["Elkin Bottle", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Elkin Bottle" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "exile": ["Forest"] }, {} ] } },
  { "name": "ruling: the exiled card stays playable after the Bottle leaves the battlefield",
    "players": [ { "library": ["Forest", "Island"], "hand": ["Bant Charm"], "battlefield": ["Elkin Bottle", "Plains", "Plains", "Plains", "Plains", "Forest", "Island"] }, {} ],
    "steps": [ { "activate": "Elkin Bottle" }, { "cast": "Bant Charm", "answers": [0], "targets": ["Elkin Bottle"] }, { "resolve": true }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "exile": [], "graveyard_has": ["Elkin Bottle"] }, {} ] } },
  { "name": "ruling: a nonland card exiled by the Bottle can be cast from exile",
    "players": [ { "library": ["Savannah Lions", "Island"], "battlefield": ["Elkin Bottle", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Elkin Bottle" }, { "resolve": true }, { "cast": "Savannah Lions" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Savannah Lions"], "exile": [] }, {} ] } },
  { "name": "ruling: a sorcery-speed card exiled on the opponent's turn cannot be cast then",
    "players": [ { "library": ["Savannah Lions", "Island"], "battlefield": ["Elkin Bottle", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "advance_to": "Main1", "auto": true }, { "pass": true, "player": 1 }, { "activate": "Elkin Bottle", "player": 0 }, { "resolve": true }, { "pass": true, "player": 1 }, { "cast": "Savannah Lions", "player": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Savannah Lions"] }, {} ] } },
  { "name": "ruling: an instant exiled by the Bottle can be cast on the opponent's turn",
    "players": [ { "library": ["Giant Growth", "Island"], "battlefield": ["Elkin Bottle", "Plains", "Plains", "Plains", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "Main1", "auto": true }, { "pass": true, "player": 1 }, { "activate": "Elkin Bottle", "player": 0 }, { "resolve": true }, { "pass": true, "player": 1 }, { "cast": "Giant Growth", "player": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": [], "battlefield_has": ["Grizzly Bears"] }, {} ], "pt": { "Grizzly Bears": [5, 5] } } }
]
