[
  {
    "name": "phasing out mills three cards",
    "players": [ { "battlefield": ["Ertai's Familiar"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Ertai's Familiar"], "graveyard": ["Forest","Forest","Forest"] }, {} ] }
  },
  {
    "name": "leaving the battlefield mills three cards",
    "players": [ { "battlefield": ["Ertai's Familiar", "Island"] }, { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] } ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Doom Blade", "targets": ["Ertai's Familiar"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Ertai's Familiar","Forest","Forest","Forest"] }, {} ] }
  },
  {
    "name": "paying U keeps it from phasing out until your next upkeep",
    "players": [ { "battlefield": ["Ertai's Familiar", "Island"] }, {} ],
    "steps": [
      { "activate": "Ertai's Familiar", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Ertai's Familiar"], "graveyard": [] }, {} ] }
  },
  {
    "name": "ruling: activated on the opponent's turn, it still cannot phase out in your next untap step",
    "players": [ { "battlefield": ["Ertai's Familiar", "Island"] }, {} ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "activate": "Ertai's Familiar", "ability": 0, "player": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Ertai's Familiar"] }, {} ] }
  }
]
