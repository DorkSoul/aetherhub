[
  {
    "name": "can't be blocked",
    "players": [
      { "battlefield": ["Walking Dream"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Walking Dream", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Walking Dream" } ], "illegal": true }
    ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "stays tapped while an opponent controls two creatures",
    "players": [
      { "battlefield": [ { "name": "Walking Dream", "tapped": true } ] },
      { "battlefield": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": { "turn": 3, "tapped": { "Walking Dream": true } }
  },
  {
    "name": "untaps when no opponent controls two creatures (your own creatures do not count)",
    "players": [
      { "battlefield": [ { "name": "Walking Dream", "tapped": true }, "Grizzly Bears", "Grizzly Bears" ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": { "turn": 3, "tapped": { "Walking Dream": false } }
  },
  {
    "name": "stays tapped if any one opponent controls two creatures",
    "players": [
      { "battlefield": [ { "name": "Walking Dream", "tapped": true } ] },
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": { "turn": 3, "tapped": { "Walking Dream": true } }
  }
]
