[
  {
    "name": "heroic puts a +1/+1 counter on each creature you control",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Phalanx Leader", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Phalanx Leader"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Phalanx Leader": [5, 5], "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "a spell targeting an opposing creature does not trigger heroic",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Phalanx Leader"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Phalanx Leader": [1, 1] }
    }
  },
  {
    "name": "ruling: heroic counters are placed before the spell resolves",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Phalanx Leader"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Phalanx Leader"] },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "stack_empty": false,
      "pt": { "Phalanx Leader": [2, 2] }
    }
  }
]
