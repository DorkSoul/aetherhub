[
  {
    "name": "makes an Egg",
    "players": [
      {
        "battlefield": [
          "Atla Palani, Nest Tender",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Atla Palani, Nest Tender"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Egg 0-1 Defender"
          ]
        },
        {}
      ],
      "pt": {
        "Egg 0-1 Defender": [
          0,
          1
        ]
      }
    }
  },
  {
    "name": "an Egg dying reveals until a creature and puts it onto the battlefield",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Atla Palani, Nest Tender",
          "Egg 0-1 Defender",
          "Mountain"
        ],
        "library": [
          "Forest",
          "Island",
          "Grizzly Bears",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Egg 0-1 Defender"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears",
            "Atla Palani, Nest Tender"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "a non-Egg dying does not trigger",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Atla Palani, Nest Tender",
          "Mountain"
        ],
        "library": [
          "Grizzly Bears",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Atla Palani, Nest Tender",
            "Mountain"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: an Egg dies but the library has no creature, so nothing enters",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Atla Palani, Nest Tender", "Egg 0-1 Defender", "Mountain"],
        "library": ["Island", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Egg 0-1 Defender"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield": ["Atla Palani, Nest Tender", "Mountain"] }, {}]
    }
  },
  {
    "name": "ruling: Atla dies together with two Eggs (Wrath of God), so its trigger happens once per Egg",
    "players": [
      {
        "hand": ["Wrath of God"],
        "battlefield": ["Atla Palani, Nest Tender", "Egg 0-1 Defender", "Egg 0-1 Defender", "Plains", "Plains", "Forest", "Forest"],
        "library": ["Grizzly Bears", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      { "cast": "Wrath of God" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears", "Hill Giant"] }, {}]
    }
  }
]