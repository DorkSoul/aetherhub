[
 { "name": "enters with five +1/+1 counters as a 5/5",
   "players": [ { "hand": ["Pentavus"], "battlefield": ["Sol Ring","Sol Ring","Sol Ring","Sol Ring"] }, {} ],
   "steps": [ { "cast": "Pentavus" }, { "resolve": true } ],
   "expect": { "pt": { "Pentavus": [5,5] }, "counters": { "Pentavus": { "p1p1": 5 } } } },
 { "name": "remove a counter and pay {1}: create a Pentavite",
   "players": [ { "battlefield": [ { "name": "Pentavus", "counters": { "p1p1": 5 } }, "Mountain" ] }, {} ],
   "steps": [ { "activate": "Pentavus", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Pentavus": [4,4], "Pentavite": [1,1] }, "keywords": { "Pentavite": ["Flying"] } } },
 { "name": "sacrifice a Pentavite and pay {1}: put a counter on it",
   "players": [ { "battlefield": [ { "name": "Pentavus", "counters": { "p1p1": 4 } }, "Pentavite", "Mountain" ] }, {} ],
   "steps": [ { "activate": "Pentavus", "ability": 1 }, { "resolve": true } ],
   "expect": { "pt": { "Pentavus": [5,5] }, "players": [ { "battlefield": ["Pentavus","Mountain"] }, {} ] } },
 { "name": "cannot sacrifice a non-Pentavite",
   "players": [ { "battlefield": [ { "name": "Pentavus", "counters": { "p1p1": 4 } }, "Grizzly Bears", "Mountain" ] }, {} ],
   "steps": [ { "activate": "Pentavus", "ability": 1, "illegal": true } ] },
 { "name": "removing the last counter kills it",
   "players": [ { "battlefield": [ { "name": "Pentavus", "counters": { "p1p1": 1 } }, "Mountain" ] }, {} ],
   "steps": [ { "activate": "Pentavus", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Pentavus"], "battlefield_has": ["Pentavite"] }, {} ] } },
 { "name": "ruling: an opponent's Pentavite is not one you control, so it cannot be sacrificed",
   "players": [ { "battlefield": [ { "name": "Pentavus", "counters": { "p1p1": 4 } }, "Mountain" ] }, { "battlefield": ["Pentavite"] } ],
   "steps": [ { "activate": "Pentavus", "ability": 1, "illegal": true } ],
   "expect": { "pt": { "Pentavus": [4,4] }, "players": [ {}, { "battlefield_has": ["Pentavite"] } ] } },
 { "name": "ruling: a +1/+1 counter from any source can be removed for the first ability",
   "players": [ { "battlefield": [ { "name": "Pentavus", "counters": { "p1p1": 2 } }, "Mountain" ] }, {} ],
   "steps": [ { "activate": "Pentavus", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Pentavus": [1,1], "Pentavite": [1,1] } } }
]
