[
  {
    "name": "tap to make a treasure",
    "players": [
      {
        "battlefield": [
          "Black Market Tycoon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Black Market Tycoon"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Treasure"
          ]
        },
        {}
      ],
      "tapped": {
        "Black Market Tycoon": true
      }
    }
  },
  {
    "name": "upkeep damage is 2 per treasure you control",
    "players": [
      {
        "battlefield": [
          "Black Market Tycoon",
          "Treasure",
          "Treasure",
          "Treasure"
        ]
      },
      {}
    ],
    "start": "Untap",
    "steps": [
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 14
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "opponent's treasures and their upkeep do not matter",
    "players": [
      {
        "battlefield": [
          "Black Market Tycoon",
          "Treasure"
        ]
      },
      {
        "battlefield": [
          "Treasure",
          "Treasure"
        ]
      }
    ],
    "start": "End",
    "steps": [
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "turn": 2,
      "players": [
        {
          "life": 20
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: the upkeep trigger counts Treasures as it resolves, so one made in response is counted",
    "players": [
      {
        "battlefield": [
          "Black Market Tycoon"
        ]
      },
      {}
    ],
    "start": "Untap",
    "steps": [
      {
        "advance_to": "Upkeep",
        "hold": true
      },
      {
        "activate": "Black Market Tycoon"
      },
      {
        "pass": true
      },
      {
        "pass": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18,
          "battlefield_has": [
            "Treasure"
          ]
        },
        {}
      ]
    }
  }
]
