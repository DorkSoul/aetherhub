[
  {
    "name": "-1 creates a Mask token attached to another target permanent",
    "players": [
      { "battlefield": ["Estrid, the Masked"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Estrid, the Masked"] }, { "battlefield_has": ["Grizzly Bears"] }],
      "counters": { "Estrid, the Masked": { "loyalty": 2 } },
      "attached": { "Mask": "Grizzly Bears" }
    }
  },
  {
    "name": "umbra armor: destroying the enchanted creature destroys the Mask instead",
    "players": [
      { "hand": ["Doom Blade"], "battlefield": ["Estrid, the Masked", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Doom Blade", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Doom Blade"], "battlefield_has": ["Estrid, the Masked"], "battlefield_lacks": ["Mask"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "+2 untaps an enchanted permanent you control",
    "players": [
      { "battlefield": ["Estrid, the Masked", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 1, "targets": ["Island"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "tap_for_mana": "Island" },
      { "activate": "Estrid, the Masked", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Island": false }
    }
  },
  {
    "name": "+2 does not untap a tapped permanent that is not enchanted",
    "players": [
      { "battlefield": ["Estrid, the Masked", { "name": "Island", "tapped": true }] },
      {}
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Island": true }
    }
  },
  {
    "name": "-7 mills seven and returns non-Aura enchantments from the graveyard",
    "players": [
      {
        "battlefield": [{ "name": "Estrid, the Masked", "counters": { "loyalty": 7 } }],
        "library": ["Glorious Anthem", "Island", "Island", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 2 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Glorious Anthem"], "graveyard_has": ["Island", "Estrid, the Masked"] },
        {}
      ]
    }
  },
  {
    "name": "-7 returns an Aura card only if a legal permanent exists to enchant",
    "players": [
      {
        "battlefield": [{ "name": "Estrid, the Masked", "counters": { "loyalty": 7 } }],
        "library": ["Pacifism", "Island", "Island", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 2 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Pacifism"], "battlefield_lacks": ["Pacifism"] },
        {}
      ]
    }
  },
  {
    "name": "-7 returns an Aura card attached to a creature of your choice",
    "players": [
      {
        "battlefield": [{ "name": "Estrid, the Masked", "counters": { "loyalty": 7 } }],
        "library": ["Pacifism", "Island", "Island", "Island", "Island", "Island", "Island"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 2 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Pacifism"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "attached": { "Pacifism": "Grizzly Bears" }
    }
  },
  {
    "name": "ruling: umbra armor replaces lethal damage, the Mask dies and the creature survives",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Estrid, the Masked", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Estrid, the Masked", "ability": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt"], "battlefield_has": ["Estrid, the Masked"], "battlefield_lacks": ["Mask"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
