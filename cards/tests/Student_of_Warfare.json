[
  {
    "name": "level up twice: level 2 is a 3/3 first strike",
    "players": [
      { "battlefield": ["Student of Warfare", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Student of Warfare" },
      { "resolve": true },
      { "activate": "Student of Warfare" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "counters": { "Student of Warfare": { "level": 2 } },
      "pt": { "Student of Warfare": [3, 3] },
      "keywords": { "Student of Warfare": ["FirstStrike"] }
    }
  },
  {
    "name": "level 7 is a 4/4 double strike",
    "players": [
      { "battlefield": [{ "name": "Student of Warfare", "counters": { "level": 7 } }] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": { "Student of Warfare": [4, 4] },
      "keywords": { "Student of Warfare": ["DoubleStrike"] }
    }
  },
  {
    "name": "ruling: level comes from the level counters however they were placed (2 counters = 3/3 first strike)",
    "players": [ { "battlefield": [ { "name": "Student of Warfare", "counters": { "level": 2 } } ] }, {} ],
    "steps": [],
    "expect": { "pt": { "Student of Warfare": [3, 3] }, "keywords": { "Student of Warfare": ["FirstStrike"] } }
  },
  {
    "name": "ruling: a pump applied before level up still applies (1/1 +3/+3, level 2 base 3/3 = 6/6)",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Student of Warfare", "Plains", "Plains", "Forest"] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Student of Warfare"] }, { "resolve": true }, { "activate": "Student of Warfare" }, { "resolve": true }, { "activate": "Student of Warfare" }, { "resolve": true } ],
    "expect": { "pt": { "Student of Warfare": [6, 6] } }
  }
]
