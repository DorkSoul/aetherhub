[
  {
    "name": "mills the target player when it enters",
    "players": [
      { "hand": ["Thassa's Devourer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Thassa's Devourer" },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [ {}, { "library_count": 18 } ]
    }
  },
  {
    "name": "a non-enchantment creature entering does not trigger it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Thassa's Devourer", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "library_count": 20 } ]
    }
  },
  {
    "name": "another enchantment entering triggers constellation",
    "players": [
      { "hand": ["Thassa's Ire"], "battlefield": ["Thassa's Devourer", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Thassa's Ire" },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [ {}, { "library_count": 18 } ]
    }
  },
  {
    "name": "ruling: each constellation ability triggers when an enchantment enters",
    "players": [
      { "hand": ["Thassa's Ire"], "battlefield": ["Thassa's Devourer", "Thassa's Devourer", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Thassa's Ire" },
      { "resolve": true, "targets": ["p1", "p1"] }
    ],
    "expect": {
      "players": [ {}, { "library_count": 16 } ]
    }
  }
]
