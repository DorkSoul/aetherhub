   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Goka the Unjust"], "battlefield_lacks": ["Initiate of Blood"] },
    { "graveyard": ["Hill Giant"] }
