[
 {
  "name": "enchanted artifact's {3} ability costs only {1} (two less)",
  "players": [ { "hand": [ "Power Artifact" ], "battlefield": [ "Island", "Island", "Plains", "Arcane Encyclopedia" ] }, {} ],
  "steps": [
    { "cast": "Power Artifact", "targets": [ "Arcane Encyclopedia" ] },
    { "resolve": true },
    { "activate": "Arcane Encyclopedia" },
    { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 1, "battlefield_has": [ "Arcane Encyclopedia", "Power Artifact" ] }, {} ] }
 },
 {
  "name": "still needs one mana after the reduction (no spare mana: illegal)",
  "players": [ { "hand": [ "Power Artifact" ], "battlefield": [ "Island", "Island", "Arcane Encyclopedia" ] }, {} ],
  "steps": [
    { "cast": "Power Artifact", "targets": [ "Arcane Encyclopedia" ] },
    { "resolve": true },
    { "activate": "Arcane Encyclopedia", "illegal": true }
  ],
  "expect": { "players": [ { "hand_count": 0, "battlefield_has": [ "Arcane Encyclopedia", "Power Artifact" ] }, {} ] }
 },
 {
  "name": "ruling: it may enchant an artifact with no activated abilities and stays attached",
  "players": [ { "hand": [ "Power Artifact" ], "battlefield": [ "Island", "Island", "Sol Ring" ] }, {} ],
  "steps": [
    { "cast": "Power Artifact", "targets": [ "Sol Ring" ] },
    { "resolve": true }
  ],
  "expect": { "players": [ { "hand_count": 0, "battlefield_has": [ "Sol Ring", "Power Artifact" ] }, {} ], "attached": { "Power Artifact": "Sol Ring" } }
 }
]
