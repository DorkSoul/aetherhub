    "expect": {
      "players": [
        { "life": 22, "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "triggers once for each card discarded",
    "players": [
      { "hand": ["Plains", "Island"], "battlefield": ["Spiritual Focus"] },
      { "hand": ["Mind Rot"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
