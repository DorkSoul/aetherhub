[
 {
  "name": "Shock on Spitemare reflects 2 damage to the Shock's controller",
  "players": [
   { "battlefield": ["Spitemare"] },
   { "hand": ["Shock"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "player": 1, "cast": "Shock", "targets": ["Spitemare"] },
   { "resolve": true, "targets": ["p1"] }
  ],
  "expect": {
   "players": [ {}, { "life": 18 } ]
  }
 },
 {
  "name": "lethal damage still reflects: Bolt kills it and deals 3 back",
  "players": [
   { "battlefield": ["Spitemare"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "player": 1, "cast": "Lightning Bolt", "targets": ["Spitemare"] },
   { "resolve": true, "targets": ["p1"] }
  ],
  "expect": {
   "players": [ { "graveyard": ["Spitemare"] }, { "life": 17 } ]
  }
 },
 {
  "name": "costs {2}{R/W}{R/W}: payable with red and white mana",
  "players": [
   { "hand": ["Spitemare"], "battlefield": ["Plains", "Plains", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Spitemare" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Spitemare"] }, {} ]
  }
 },
 {
  "name": "ruling: lethal combat damage still triggers and deals the full damage (6) to any target",
  "players": [
   { "battlefield": ["Craw Wurm"] },
   { "battlefield": ["Spitemare", "Plains"] }
  ],
  "steps": [
   { "attack": [ { "card": "Craw Wurm", "at": "p1" } ] },
   { "block": [ { "blocker": "Spitemare", "attacker": "Craw Wurm" } ] },
   { "advance_to": "Main2", "targets": ["p0"] }
  ],
  "expect": {
   "players": [ { "life": 14 }, { "graveyard": ["Spitemare"] } ]
  }
 }
]
