[
 { "name": "counts itself as the only Wizard",
   "players": [ { "hand": ["Nameless One"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Nameless One" }, { "resolve": true } ],
   "expect": { "pt": { "Nameless One": [1, 1] } } },
 { "name": "counts Wizards on the battlefield under any player's control",
   "players": [ { "hand": ["Nameless One"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Aegis Sculptor"] } ],
   "steps": [ { "cast": "Nameless One" }, { "resolve": true } ],
   "expect": { "pt": { "Nameless One": [2, 2] } } },
 { "name": "cast face down for {3} it is a 2/2 with no abilities (no Wizard count)",
   "players": [ { "hand": ["Nameless One"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Nameless One", "alt": 254 }, { "resolve": true } ],
   "expect": { "pt": { "Nameless One": [2, 2] }, "not_subtypes": { "Nameless One": ["Wizard"] } } },
 { "name": "turned face up for its morph cost {2}{U}: it is a 1/1 Wizard counting itself",
   "players": [ { "hand": ["Nameless One"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [
     { "cast": "Nameless One", "alt": 254 },
     { "resolve": true },
     { "activate": "Nameless One" },
     { "resolve": true }
   ],
   "expect": { "pt": { "Nameless One": [1, 1] }, "subtypes": { "Nameless One": ["Wizard"] } } }
]
