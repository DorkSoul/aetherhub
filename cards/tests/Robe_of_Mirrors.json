[
  {
    "name": "ruling: an Aura already attached stays attached when shroud arrives",
    "players": [ { "hand": ["Pacifism", "Robe of Mirrors"], "battlefield": ["Plains", "Plains", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Robe of Mirrors", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "attached": { "Pacifism": "Grizzly Bears", "Robe of Mirrors": "Grizzly Bears" } }
  },
  {
    "name": "ruling: shroud stops an Aura spell from targeting the creature",
    "players": [ { "hand": ["Robe of Mirrors", "Pacifism"], "battlefield": ["Island", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Robe of Mirrors", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Pacifism", "illegal": true } ],
    "expect": { "attached": { "Robe of Mirrors": "Grizzly Bears" }, "players": [ { "hand_count": 1 }, {} ] }
  },
  {
    "name": "ruling: without shroud the same Aura can target the creature",
    "players": [ { "hand": ["Pacifism"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "attached": { "Pacifism": "Grizzly Bears" } }
  },
  {
    "name": "enchanted creature has shroud",
    "players": [
      { "hand": ["Robe of Mirrors"], "battlefield": ["Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Robe of Mirrors", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Robe of Mirrors": "Grizzly Bears" },
      "keywords": { "Grizzly Bears": ["Shroud"] }
    }
  },
  {
    "name": "shroud: a creature-only spell has no legal target",
    "players": [
      { "hand": ["Robe of Mirrors", "Roast"], "battlefield": ["Island", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Robe of Mirrors", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Roast", "illegal": true }
    ],
    "expect": {
      "attached": { "Robe of Mirrors": "Grizzly Bears" }
    }
  }
]
