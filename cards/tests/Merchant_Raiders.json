[
 {
  "name": "ruling: a creature that is already tapped when targeted stays tapped through its controller's untap step",
    "players": [ { "hand": ["Merchant Raiders"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Merchant Raiders" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "tapped": { "Grizzly Bears": true } } },
  {
   "name": "control: without Merchant Raiders a tapped creature untaps in its controller's untap step",
   "players": [ { "battlefield": ["Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "advance_to": "Upkeep" } ],
   "expect": { "tapped": { "Grizzly Bears": false } } },
  {
   "name": "ruling: after control changes it still does not untap in its new controller's untap step",
   "players": [ { "hand": ["Merchant Raiders", "Control Magic"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Merchant Raiders" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Control Magic", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
   "expect": { "players": [ { "battlefield_has": ["Merchant Raiders", "Control Magic", "Grizzly Bears"] }, {} ], "tapped": { "Grizzly Bears": true } } },
  {
   "name": "ETB taps the target creature, which stays tapped through its controller's untap step",
  "players": [
   {
    "hand": [
     "Merchant Raiders"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Merchant Raiders"
   },
   {
    "resolve": true,
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true
   }
  }
 }
]