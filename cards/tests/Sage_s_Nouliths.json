[
  {
    "name": "job select: Hero token is created and equipped",
    "players": [
      {
        "hand": [
          "Sage's Nouliths"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sage's Nouliths"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "attached": {
        "Sage's Nouliths": "Hero"
      },
      "pt": {
        "Hero": [
          2,
          1
        ]
      }
    }
  },
  {
    "name": "equip {3} moves it to another creature",
    "players": [
      {
        "battlefield": [
          "Sage's Nouliths",
          "Grizzly Bears",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sage's Nouliths",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "attached": {
        "Sage's Nouliths": "Grizzly Bears"
      },
      "pt": {
        "Grizzly Bears": [
          3,
          2
        ]
      }
    }
  },
  {
    "name": "the Hero token is a Cleric in addition to its other types",
    "players": [ { "hand": ["Sage's Nouliths"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Sage's Nouliths" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "subtypes": { "Hero": ["Cleric"] } }
  },
  {
    "name": "equipped creature is a Cleric; an unequipped creature is not",
    "players": [ { "battlefield": ["Sage's Nouliths", "Grizzly Bears", "Savannah Lions", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Sage's Nouliths", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "subtypes": { "Grizzly Bears": ["Cleric"] }, "not_subtypes": { "Savannah Lions": ["Cleric"] } }
  },
  {
    "name": "equipped creature's attack trigger untaps the target attacking creature",
    "players": [ { "battlefield": ["Sage's Nouliths", "Grizzly Bears", "Hill Giant", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Sage's Nouliths", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "resolve": true, "targets": ["Hill Giant"] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 14 } ], "tapped": { "Hill Giant": false, "Grizzly Bears": true } }
  },
  {
    "name": "ruling: destroying the Hero token leaves the Equipment on the battlefield",
    "players": [ { "hand": ["Sage's Nouliths", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain"] }, {} ],
    "steps": [ { "cast": "Sage's Nouliths" }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Hero"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sage's Nouliths"], "battlefield_lacks": ["Hero"] }, {} ] }
  }
]
