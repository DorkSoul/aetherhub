[
 {
  "name": "constellation: an enchantment you control entering taps target opposing creature",
  "players": [
   {
    "hand": [
     "Call the Bloodline"
    ],
    "battlefield": [
     "Swamp",
     "Swamp",
     "Captivating Unicorn"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Call the Bloodline"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Call the Bloodline",
      "Captivating Unicorn"
     ]
    },
    {
     "battlefield_has": [
      "Grizzly Bears"
     ]
    }
   ],
   "tapped": {
    "Grizzly Bears": true
   }
  }
 },
 {
  "name": "a creature entering does not trigger constellation",
  "players": [
   {
    "hand": [
     "Grizzly Bears"
    ],
    "battlefield": [
     "Forest",
     "Forest",
     "Captivating Unicorn"
    ]
   },
   {
    "battlefield": [
     "Llanowar Elves"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Grizzly Bears"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Llanowar Elves": false
   }
  }
 },
 {
  "name": "ruling: an Aura whose target is gone does not enter, so constellation does not trigger",
  "players": [
   { "hand": ["Holy Strength"], "battlefield": ["Plains", "Captivating Unicorn"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears", "Llanowar Elves"] }
  ],
  "steps": [
   { "cast": "Holy Strength", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Holy Strength"] },
    { "graveyard": ["Grizzly Bears", "Lightning Bolt"], "battlefield_has": ["Llanowar Elves"] }
   ],
   "tapped": { "Llanowar Elves": false }
  }
 }
]
