  "steps": [
   { "cast": "Warbringer", "alt": 0 },
   { "pass": true },
   { "cast": "Essence Scatter", "player": 1, "targets": [{ "stack": "Warbringer" }] },
   { "pass": true, "player": 1 },
   { "pass": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Warbringer"] },
    { "graveyard_has": ["Essence Scatter"] }
