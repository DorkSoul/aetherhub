    "steps": [ { "cast": "Bitter Ordeal", "targets": ["p1"] }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
    "expect": { "players": [ {}, { "exile": ["Lightning Bolt"] } ] } },
  { "name": "gravestorm: one permanent put into a graveyard this turn gives one copy",
    "players": [ { "hand": ["Lightning Bolt", "Bitter Ordeal"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"], "library": ["Island", "Forest"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Bitter Ordeal", "targets": ["p1"] }, { "resolve": true, "answers": ["p1", "Island", "Forest"] } ],
    "expect": { "players": [ {}, { "exile": ["Island", "Forest"] } ] } },
  { "name": "gravestorm: no permanent put into a graveyard this turn means no copy",
    "players": [ { "hand": ["Bitter Ordeal"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "library": ["Island", "Forest"] } ],
    "steps": [ { "cast": "Bitter Ordeal", "targets": ["p1"] }, { "resolve": true, "answers": ["Island"] } ],
    "expect": { "players": [ {}, { "exile": ["Island"], "library_count": 1 } ] } }
