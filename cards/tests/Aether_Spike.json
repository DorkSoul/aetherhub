[
  {
    "name": "pay 2 energy; the caster has two spare mana and pays: Bolt resolves",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Aether Spike"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Aether Spike", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true, 2, true] }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "energy": 0 } ] }
  },
  {
    "name": "pay 2 energy; the caster declines to pay: Bolt is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Aether Spike"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Aether Spike", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true, 2, false] }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 20, "energy": 0 } ] }
  },
  {
    "name": "pay no energy: nothing happens",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Aether Spike"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Aether Spike", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ {}, { "life": 17, "energy": 2 } ] }
  },
  {
    "name": "ruling: paying zero energy still gives two energy; the spell resolves when its controller pays 0",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Aether Spike"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Aether Spike", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true, 0] }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "energy": 2 } ] }
  },
  {
    "name": "ruling: unspent energy stays with the player after turns pass",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Aether Spike"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Aether Spike", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [false] },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "energy": 2 } ] }
  }
]
