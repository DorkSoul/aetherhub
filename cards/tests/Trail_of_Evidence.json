[
  {
    "name": "casting an instant investigates",
    "players": [
      {
        "hand": [
          "Trail of Evidence",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Trail of Evidence"
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Trail of Evidence",
            "Clue"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "casting a creature does not investigate",
    "players": [
      {
        "hand": [
          "Trail of Evidence",
          "Grizzly Bears"
        ],
        "battlefield": [
          "Island",
          "Mountain",
          "Mountain",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Trail of Evidence"
      },
      {
        "resolve": true
      },
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears"
          ],
          "battlefield_lacks": [
            "Clue"
          ]
        },
        {}
      ]
    }
  },
  {"name": "ruling: a Clue is an artifact, not a creature (Doom Blade cannot target it)",
   "players": [{"hand": ["Lightning Bolt", "Doom Blade"], "battlefield": ["Trail of Evidence", "Mountain", "Swamp", "Swamp"]}, {}],
   "steps": [
     {"cast": "Lightning Bolt", "targets": ["p1"]},
     {"resolve": true},
     {"cast": "Doom Blade", "targets": ["Clue"], "illegal": true}
   ],
   "expect": {"players": [{"battlefield_has": ["Trail of Evidence", "Clue"], "hand": ["Doom Blade"], "graveyard": ["Lightning Bolt"]}, {"life": 17}]}},
  {"name": "ruling: a Clue sacrificed to pay for Alquist's ability cannot also pay for the Clue's own ability",
   "players": [{"battlefield": ["Alquist Proft, Master Sleuth", "Clue", "Plains", "Island", "Island", "Island", "Island", "Island"]}, {}],
   "steps": [
     {"activate": "Alquist Proft, Master Sleuth", "ability": 0, "answers": [1]},
     {"resolve": true},
     {"activate": "Clue", "ability": 0, "illegal": true}
   ],
   "expect": {"players": [{"hand_count": 1, "battlefield": ["Alquist Proft, Master Sleuth", "Plains", "Island", "Island", "Island", "Island", "Island"]}, {}]}},
  {"name": "ruling: Wrench (a Clue) can be sacrificed to pay for Alquist's ability",
   "players": [{"battlefield": ["Alquist Proft, Master Sleuth", "Wrench", "Plains", "Island", "Island", "Island"]}, {}],
   "steps": [
     {"activate": "Alquist Proft, Master Sleuth", "ability": 0, "answers": [1]},
     {"resolve": true}
   ],
   "expect": {"players": [{"hand_count": 1, "graveyard": ["Wrench"], "battlefield": ["Alquist Proft, Master Sleuth", "Plains", "Island", "Island", "Island"]}, {}]}}
]
