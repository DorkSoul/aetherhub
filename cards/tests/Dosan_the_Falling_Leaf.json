    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "ruling: Dosan stops spells only, the opponent can still activate an ability on your turn",
    "players": [ { "battlefield": ["Dosan the Falling Leaf"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Witching Well", "Island", "Island", "Island", "Island", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"], "illegal": true }, { "activate": "Witching Well", "ability": 0, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Witching Well"], "hand_count": 3 } ] }
