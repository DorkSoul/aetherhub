[
  {
    "name": "exiles target graveyard card and makes a 1/1 W/B flying Spirit for you",
    "players": [
      {
        "hand": [
          "Beckon Apparition"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "graveyard": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Beckon Apparition",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Spirit 1-1 White Black Flying"
          ]
        },
        {
          "exile": [
            "Grizzly Bears"
          ],
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "cannot target a card on the battlefield",
    "players": [
      {
        "hand": [
          "Beckon Apparition"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Beckon Apparition",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Beckon Apparition"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: the controller of Beckon Apparition gets the token (cast by the opponent)",
    "players": [
      { "graveyard": ["Grizzly Bears"] },
      { "hand": ["Beckon Apparition"], "battlefield": ["Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Beckon Apparition", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Spirit 1-1 White Black Flying"], "exile": ["Grizzly Bears"] },
        { "battlefield_has": ["Spirit 1-1 White Black Flying"] }
      ]
    }
  },
  {
    "name": "ruling: Beckon Apparition cannot target itself",
    "players": [
      { "hand": ["Beckon Apparition"], "battlefield": ["Plains"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Beckon Apparition", "targets": ["Beckon Apparition"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Beckon Apparition"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: if its target is exiled in response, Beckon Apparition does not resolve and makes no token",
    "players": [
      { "hand": ["Beckon Apparition"], "battlefield": ["Plains"], "graveyard": ["Grizzly Bears"] },
      { "hand": ["Beckon Apparition"], "battlefield": ["Plains"] }
    ],
    "steps": [
      { "cast": "Beckon Apparition", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Beckon Apparition", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Spirit 1-1 White Black Flying"] },
        { "battlefield_has": ["Spirit 1-1 White Black Flying"] }
      ]
    }
  }
]
