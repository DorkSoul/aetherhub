[
 {
  "name": "mode 1: return a creature card with MV 4 or less from my graveyard, tapped",
  "players": [ { "battlefield": ["Phoenix Down", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] }, {} ],
  "steps": [ { "activate": "Phoenix Down", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": ["Phoenix Down"] }, {} ] }
 },
 {
  "name": "mode 2: exile target Zombie",
  "players": [ { "battlefield": ["Phoenix Down", "Plains", "Plains"] }, { "battlefield": ["Zombie"] } ],
  "steps": [ { "activate": "Phoenix Down", "ability": 1, "targets": ["Zombie"] }, { "resolve": true } ],
  "expect": { "players": [ { "exile": ["Phoenix Down"] }, { "battlefield_lacks": ["Zombie"] } ] }
 },
 {
  "name": "mode 1 cannot return a creature with MV 5",
