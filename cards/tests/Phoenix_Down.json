  "steps": [ { "activate": "Phoenix Down", "ability": 0, "illegal": true } ],
  "expect": { "players": [ { "graveyard": ["Serra Angel"] }, {} ] }
 },
 {
  "name": "ruling: an {X} in a graveyard card's cost counts as 0, so Broodlord (MV 4) can be returned",
  "players": [ { "battlefield": ["Phoenix Down", "Plains", "Plains"], "graveyard": ["Broodlord"] }, {} ],
  "steps": [ { "activate": "Phoenix Down", "ability": 0, "targets": ["Broodlord"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Broodlord"], "exile": ["Phoenix Down"] }, {} ] }
 }
