[
  {
    "name": "X counts the Caves you control plus Caves in your graveyard",
    "players": [
      { "hand": ["Calamitous Cave-In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Captivating Cave", "Captivating Cave", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Calamitous Cave-In" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Hill Giant"], "graveyard": ["Calamitous Cave-In"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "a Cave in the graveyard adds to X",
    "players": [
      { "hand": ["Calamitous Cave-In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Captivating Cave"], "graveyard": ["Captivating Cave"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Calamitous Cave-In" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Calamitous Cave-In", "Captivating Cave"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "with no Caves X is 0 and nothing dies",
    "players": [
      { "hand": ["Calamitous Cave-In"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Calamitous Cave-In" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
