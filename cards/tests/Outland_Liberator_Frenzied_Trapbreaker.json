[
  {
    "name": "{1}, sacrifice: destroy target artifact",
    "players": [
      { "battlefield": ["Outland Liberator", "Forest"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "activate": "Outland Liberator", "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Outland Liberator"] },
        { "graveyard": ["Sol Ring"] }
      ]
    }
  },
  {
    "name": "target must be an artifact or enchantment",
    "players": [
      { "battlefield": ["Outland Liberator", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Outland Liberator", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Outland Liberator"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "night side: {1}, sacrifice: destroy target artifact or enchantment",
    "players": [
      {
        "battlefield": ["Frenzied Trapbreaker", "Island"]
      },
      {
        "battlefield": ["Orzhov Signet"]
      }
    ],
    "steps": [
      { "activate": "Frenzied Trapbreaker", "ability": 0, "targets": ["Orzhov Signet"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Outland Liberator"] },
        { "graveyard": ["Orzhov Signet"] }
      ]
    }
  },
  {
    "name": "night side: attacking destroys the artifact the defending player controls",
    "players": [
      {
        "battlefield": ["Frenzied Trapbreaker"]
      },
      {
        "battlefield": ["Orzhov Signet"]
      }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Frenzied Trapbreaker", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Frenzied Trapbreaker"] },
        { "graveyard": ["Orzhov Signet"], "life": 17 }
      ]
    }
  },
  {
    "name": "night side: attacking with no artifact or enchantment to destroy deals damage only",
    "players": [
      {
        "battlefield": ["Frenzied Trapbreaker"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Frenzied Trapbreaker", "at": "p1" } ] },
      { "resolve": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Frenzied Trapbreaker"] },
        { "battlefield_has": ["Grizzly Bears"], "life": 17 }
      ]
    }
  }
]
