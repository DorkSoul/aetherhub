[
  { "name": "attaches to a creature and keeps it tapped",
    "players": [ { "hand": ["Coma Veil"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Coma Veil", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "attached": { "Coma Veil": "Grizzly Bears" }, "players": [ { "battlefield_has": ["Coma Veil"] }, {} ] } },
  { "name": "cannot be cast without an artifact or creature to enchant",
    "players": [ { "hand": ["Coma Veil"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Coma Veil", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Coma Veil"] }, {} ] } },
  { "name": "enchanted creature stays tapped through its controller's untap step",
    "players": [ { "hand": ["Coma Veil"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Coma Veil", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "tapped": { "Grizzly Bears": true } } },
  { "name": "ruling: may enchant an untapped creature",
    "players": [ { "hand": ["Coma Veil"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Coma Veil", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "attached": { "Coma Veil": "Grizzly Bears" }, "players": [ { "battlefield_has": ["Coma Veil"] }, {} ] } }
]
