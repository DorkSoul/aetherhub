[
 { "name": "each player adds {B}{R}{G}",
   "players": [ { "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }, "Forest"] }, {} ],
   "steps": [ { "activate": "Yurlok of Scorch Thrash" }, { "resolve": true } ],
   "expect": { "players": [ { "pool": { "B": 1, "R": 1, "G": 1 }, "life": 20 }, { "pool": { "B": 1, "R": 1, "G": 1 }, "life": 20 } ], "tapped": { "Yurlok of Scorch Thrash": true } } },
 { "name": "unspent mana is lost at the end of the phase and costs that much life for each player",
   "players": [ { "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }, "Forest"] }, {} ],
   "steps": [ { "activate": "Yurlok of Scorch Thrash" }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 17, "pool": {} }, { "life": 17, "pool": {} } ] } },
 { "name": "spent mana is not lost: only the leftover costs life",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }, "Forest"] }, {} ],
   "steps": [ { "activate": "Yurlok of Scorch Thrash" }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 18, "graveyard": ["Lightning Bolt"] }, { "life": 14 } ] } },
 { "name": "any player's lost mana counts, including the opponent's floating land mana",
   "players": [ { "battlefield": ["Mountain"] }, { "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }] } ],
   "steps": [ { "tap_for_mana": "Mountain" }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 19 }, { "life": 20 } ] } },
 { "name": "no mana floating, no life lost",
   "players": [ { "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }] }, {} ],
   "steps": [ { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
 { "name": "ruling: unspent mana is lost as the main phase ends, before combat begins",
   "players": [ { "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }, "Forest"] }, {} ],
   "steps": [ { "activate": "Yurlok of Scorch Thrash" }, { "resolve": true }, { "advance_to": "BeginCombat" } ],
   "expect": { "players": [ { "life": 17, "pool": {} }, { "life": 17, "pool": {} } ] } },
 { "name": "ruling: two Yurloks on the battlefield still cost only the unspent amount (3, not 6)",
   "players": [ { "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }, "Forest"] }, { "battlefield": [{ "name": "Yurlok of Scorch Thrash", "sick": false }] } ],
   "steps": [ { "activate": "Yurlok of Scorch Thrash" }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 17, "pool": {} }, { "life": 17, "pool": {} } ] } }
]
