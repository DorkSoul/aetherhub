  {
    "name": "tap a Gate to untap the Sage",
    "players": [
      {
        "battlefield": [
          "Sage of the Maze",
          "Forest",
          "Boros Guildgate"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sage of the Maze",
        "ability": 0,
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      },
      {
        "activate": "Sage of the Maze",
        "ability": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Sage of the Maze": false,
        "Boros Guildgate": true
      }
    }
  },
  {
    "name": "ruling: X is calculated once as the ability resolves (a Gate played later does not change it)",
    "players": [
      {
        "hand": ["Boros Guildgate"],
        "battlefield": ["Sage of the Maze", "Forest", "Boros Guildgate", "Boros Guildgate"]
      },
      {}
    ],
    "steps": [
      { "activate": "Sage of the Maze", "ability": 0, "targets": ["Forest"] },
      { "resolve": true },
      { "play_land": "Boros Guildgate" }
    ],
    "expect": {
      "pt": { "Forest": [4, 4] },
      "players": [
        { "battlefield_has": ["Forest", "Boros Guildgate"] },
        {}
      ]
    }
