[
  {
    "name": "animate: land becomes X/X haste with X twice the Gates",
    "players": [
      {
        "battlefield": [
          "Sage of the Maze",
          "Forest",
          "Boros Guildgate",
          "Boros Guildgate"
        ]
      },
      {}
