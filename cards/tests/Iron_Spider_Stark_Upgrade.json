[
  {
    "name": "tap: +1/+1 counter on each artifact creature and Vehicle you control, not on other creatures",
    "players": [
      {
        "battlefield": [
          "Island", "Island", "Island",
          { "name": "Iron Spider, Stark Upgrade" },
          "Ornithopter",
          "Bespoke Battlewagon",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      { "activate": "Iron Spider, Stark Upgrade", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Iron Spider, Stark Upgrade": true },
      "counters": {
        "Iron Spider, Stark Upgrade": { "p1p1": 1 },
        "Ornithopter": { "p1p1": 1 },
        "Bespoke Battlewagon": { "p1p1": 1 }
      },
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "draw: pay 2 and remove two +1/+1 counters spread over two artifacts",
    "players": [
      {
        "battlefield": [
          "Island", "Island",
          { "name": "Iron Spider, Stark Upgrade", "counters": { "p1p1": 1 } },
          { "name": "Ornithopter", "counters": { "p1p1": 1 } }
        ],
        "library": ["Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Iron Spider, Stark Upgrade", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "counters": {
        "Iron Spider, Stark Upgrade": { "p1p1": 0 },
        "Ornithopter": { "p1p1": 0 }
      },
      "players": [{ "hand_count": 1 }, {}]
    }
  },
  {
    "name": "draw needs two +1/+1 counters: one counter is not enough",
    "players": [
      {
        "battlefield": [
          "Island", "Island",
          { "name": "Iron Spider, Stark Upgrade", "counters": { "p1p1": 1 } }
        ],
        "library": ["Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Iron Spider, Stark Upgrade", "ability": 1, "illegal": true }
    ],
    "expect": {
      "counters": { "Iron Spider, Stark Upgrade": { "p1p1": 1 } },
      "players": [{ "hand_count": 0 }, {}]
    }
  },
  {
    "name": "draw: counters on a non-artifact creature do not pay the cost",
    "players": [
      {
        "battlefield": [
          "Island", "Island",
          { "name": "Iron Spider, Stark Upgrade" },
          { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }
        ],
        "library": ["Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Iron Spider, Stark Upgrade", "ability": 1, "illegal": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "players": [{ "hand_count": 0 }, {}]
    }
  }
