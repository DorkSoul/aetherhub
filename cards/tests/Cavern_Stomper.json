[
  { "name": "activated ability stops power 2 or less blockers",
    "players": [ { "battlefield": ["Cavern Stomper", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Cavern Stomper", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Cavern Stomper", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Cavern Stomper" } ], "illegal": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 13 } ] } },
  { "name": "a power 3 creature can still block",
    "players": [ { "battlefield": ["Cavern Stomper", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Cavern Stomper", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Cavern Stomper", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Cavern Stomper" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "graveyard": ["Hill Giant"] } ] } },
  { "name": "enters and scry 2 puts both looked-at cards on the bottom",
    "players": [ { "hand": ["Cavern Stomper"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Island", "Swamp"] }, {} ],
    "steps": [ { "cast": "Cavern Stomper" }, { "resolve": true, "answers": [[0, 1]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Cavern Stomper"], "library_top": ["Swamp"] }, {} ] } },
  { "name": "scry 2 keeping both cards on top leaves them in order",
    "players": [ { "hand": ["Cavern Stomper"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Island", "Swamp"] }, {} ],
    "steps": [ { "cast": "Cavern Stomper" }, { "resolve": true, "answers": [[]] }, { "resolve": true } ],
    "expect": { "players": [ { "library_top": ["Forest", "Island"] }, {} ] } },
  { "name": "ruling: activating the ability after blocks does not undo the block",
    "players": [ { "battlefield": ["Cavern Stomper", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Cavern Stomper", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Cavern Stomper" } ] }, { "activate": "Cavern Stomper", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"], "life": 20 } ] } }
]
