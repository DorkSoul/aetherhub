[
 {
  "name": "when it enters you may gain life equal to its power",
  "players": [ { "hand": ["Archon of Redemption"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
  "steps": [
   { "cast": "Archon of Redemption" },
   { "resolve": true, "answers": [true] }
  ],
  "expect": { "players": [ { "life": 23, "battlefield_has": ["Archon of Redemption"] }, {} ] }
 },
 {
  "name": "another flying creature entering gains you life equal to its power",
  "players": [ { "hand": ["Air Elemental"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Archon of Redemption"] }, {} ],
  "steps": [
   { "cast": "Air Elemental" },
   { "resolve": true, "answers": [true] }
  ],
  "expect": { "players": [ { "life": 24, "battlefield_has": ["Air Elemental", "Archon of Redemption"] }, {} ] }
 },
 {
  "name": "a creature without flying entering does not trigger it",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Archon of Redemption"] }, {} ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 20 }, {} ] }
 },
 {
  "name": "ruling: power is read on resolution, so a pump cast in response to the trigger adds to the life gained",
  "players": [ { "hand": ["Air Elemental"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Archon of Redemption"] }, { "hand": ["Giant Growth"], "battlefield": ["Forest"] } ],
  "steps": [
   { "cast": "Air Elemental" },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "cast": "Giant Growth", "player": 1, "targets": ["Air Elemental"] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": { "players": [ { "life": 27, "battlefield_has": ["Air Elemental", "Archon of Redemption"] }, {} ] }
 }
]
