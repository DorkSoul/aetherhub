[
  { "name": "enters tapping the enchanted creature, which stays tapped",
    "players": [ { "hand": ["Sleeping Potion"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Sleeping Potion", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Sleeping Potion"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": true }
    } },
  { "name": "sacrificed when the enchanted creature becomes the target of a spell",
    "players": [ { "hand": ["Sleeping Potion", "Slaughter Cry"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Sleeping Potion", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Slaughter Cry", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Sleeping Potion", "Slaughter Cry"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    } },
  { "name": "enchanted creature stays tapped through its controller's untap step",
    "players": [ { "hand": ["Sleeping Potion"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Sleeping Potion", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Sleeping Potion"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": true }
    } }
]
