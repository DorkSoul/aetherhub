[
  {
    "name": "dealt damage: its controller gains 2 life",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Imperial Ceratops"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Imperial Ceratops"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 22, "battlefield_has": ["Imperial Ceratops"] }
      ]
    }
  },
  {
    "name": "lethal damage still triggers enrage",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Imperial Ceratops"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Imperial Ceratops"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Imperial Ceratops"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 24, "graveyard": ["Imperial Ceratops"] }
      ]
    }
  },
  {
    "name": "ruling: damage from several blockers at once triggers enrage only once",
    "players": [
      { "battlefield": [ { "name": "Imperial Ceratops", "sick": false } ] },
      { "battlefield": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Imperial Ceratops", "at": "p1" } ] },
      { "block": [
          { "blocker": "Hill Giant", "attacker": "Imperial Ceratops" },
          { "blocker": "Grizzly Bears", "attacker": "Imperial Ceratops" }
        ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 22, "graveyard_has": ["Imperial Ceratops"] },
        {}
      ]
    }
  }
]
