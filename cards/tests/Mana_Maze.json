[
 {
  "name": "after a red spell no red spell can be cast, but a green one can",
  "players": [
   { "hand": ["Lightning Bolt", "Hill Giant", "Grizzly Bears"], "battlefield": ["Mana Maze", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "cast": "Hill Giant", "illegal": true },
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand": ["Hill Giant"] }, { "life": 17 } ] }
 },
 {
  "name": "the first spell of the turn is unrestricted and an opponent is restricted too",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mana Maze", "Mountain"] },
   { "hand": ["Shock"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Shock", "player": 1, "illegal": true }
  ],
  "expect": { "players": [ {}, { "hand": ["Shock"] } ] }
 },
 {
  "name": "a colorless spell cast last shares no color, so a red spell may follow",
  "players": [
   { "hand": ["Ornithopter", "Lightning Bolt"], "battlefield": ["Mana Maze", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Ornithopter" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Ornithopter"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] }
 },
 {
  "name": "after a red spell a blue spell is still castable",
  "players": [
   { "hand": ["Lightning Bolt", "Merfolk of the Pearl Trident"], "battlefield": ["Mana Maze", "Mountain", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "cast": "Merfolk of the Pearl Trident" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Merfolk of the Pearl Trident"] }, {} ] }
 },
 {
  "name": "ruling: the first spell cast this turn is never restricted",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mana Maze", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] }
 }
]
