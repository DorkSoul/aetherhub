[
  {
    "name": "power and toughness count the Fungi and Saprolings you control (itself included)",
    "players": [
      {"battlefield": ["The Mycotyrant", "Fungusaur"]},
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {"The Mycotyrant": [2, 2]}
    }
  },
  {
    "name": "no descend this turn: no Fungus tokens at your end step",
    "players": [
      {"battlefield": ["The Mycotyrant"]},
      {}
    ],
    "steps": [
      {"advance_to": "End"}
    ],
    "expect": {
      "players": [
        {"battlefield_lacks": ["Fungus 1-1 Black Cant Block"]},
        {}
      ]
    }
  },
  {
    "name": "descended once this turn: one Fungus token at your end step",
    "players": [
      {"hand": ["Lightning Bolt"], "battlefield": ["The Mycotyrant", "Grizzly Bears", "Mountain"]},
      {}
    ],
    "steps": [
      {"cast": "Lightning Bolt", "targets": ["Grizzly Bears"]},
      {"resolve": true},
      {"advance_to": "End"}
    ],
    "expect": {
      "players": [
        {"battlefield_has": ["Fungus 1-1 Black Cant Block"]},
        {}
      ]
    }
  },
  {
    "name": "ruling: each permanent card put into your graveyard counts, so two descends make two Fungus tokens",
    "players": [
      {"hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["The Mycotyrant", "Grizzly Bears", "Hill Giant", "Mountain", "Mountain"]},
      {}
    ],
    "steps": [
      {"cast": "Lightning Bolt", "targets": ["Grizzly Bears"]},
      {"resolve": true},
      {"cast": "Lightning Bolt", "targets": ["Hill Giant"]},
      {"resolve": true},
      {"advance_to": "End"}
    ],
    "expect": {
      "players": [
        {"battlefield_has": ["Fungus 1-1 Black Cant Block", "Fungus 1-1 Black Cant Block"]},
        {}
      ]
    }
  },
  {
    "name": "ruling: a Fungus token dying does not count as descending",
    "players": [
      {"hand": ["Lightning Bolt"], "battlefield": ["The Mycotyrant", "Fungus 1-1 Black Cant Block", "Mountain"]},
      {}
    ],
    "steps": [
      {"cast": "Lightning Bolt", "targets": ["Fungus 1-1 Black Cant Block"]},
      {"resolve": true},
      {"advance_to": "End"}
    ],
    "expect": {
      "players": [
        {"battlefield_lacks": ["Fungus 1-1 Black Cant Block"]},
        {}
      ]
    }
  }
]
