[
  { "name": "keeping the targets copies the spell and the copy hits the same target",
    "players": [ { "hand": ["Wild Ricochet"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
               { "cast": "Wild Ricochet", "targets": [ { "stack": "Lightning Bolt" } ] },
               { "resolve": true, "answers": [ [0] ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 14 }, { "life": 20 } ] } },
  { "name": "a creature spell on the stack cannot be targeted",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] },
                 { "hand": ["Wild Ricochet"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] } ],
    "steps": [ { "cast": "Grizzly Bears" },
               { "pass": true },
               { "cast": "Wild Ricochet", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ], "illegal": true } ],
    "expect": {} },
  { "name": "ruling: the copy's 'you' is its controller, so Ricochet's controller gains the life from the copy",
    "players": [ { "hand": ["Wild Ricochet"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] },
                 { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Helix", "player": 1, "targets": ["p0"] },
               { "cast": "Wild Ricochet", "targets": [ { "stack": "Lightning Helix" } ] },
               { "resolve": true, "answers": [ [0] ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, { "life": 23 } ] } },
  { "name": "ruling: copying an untargeted sorcery; the copy's controller draws the cards",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island"] },
                 { "hand": ["Wild Ricochet"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] } ],
    "steps": [ { "cast": "Divination" },
               { "cast": "Wild Ricochet", "player": 1, "targets": [ { "stack": "Divination" } ] },
               { "resolve": true },
               { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, { "hand_count": 2 } ] } },
  { "name": "ruling: the copy of Volcanic Geyser has the same X",
    "players": [ { "hand": ["Wild Ricochet"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] },
                 { "hand": ["Volcanic Geyser"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] } ],
    "steps": [ { "pass": true },
               { "cast": "Volcanic Geyser", "player": 1, "targets": ["p0"], "answers": [2] },
               { "cast": "Wild Ricochet", "targets": [ { "stack": "Volcanic Geyser" } ] },
               { "resolve": true, "answers": [ [0] ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 16 }, { "life": 20 } ] } },
  { "name": "ruling: the copy of Fling repeats the sacrifice damage (costs paid for the original are copied)",
    "players": [ { "hand": ["Wild Ricochet"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] },
                 { "hand": ["Fling"], "battlefield": ["Mountain", "Mountain", "Hill Giant"] } ],
    "steps": [ { "pass": true },
               { "cast": "Fling", "player": 1, "targets": ["p0"] },
               { "cast": "Wild Ricochet", "targets": [ { "stack": "Fling" } ] },
               { "resolve": true, "answers": [ [0] ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 14 }, { "graveyard_has": ["Hill Giant", "Fling"] } ] } },
  { "name": "ruling: the copy can be given a new target",
    "players": [ { "hand": ["Wild Ricochet"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] },
                 { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Helix", "player": 1, "targets": ["p0"] },
               { "cast": "Wild Ricochet", "targets": [ { "stack": "Lightning Helix" } ] },
               { "resolve": true, "answers": [ [0], [1] ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } }
]
