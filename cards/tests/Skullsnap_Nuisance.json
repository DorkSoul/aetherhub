[
  {
    "name": "enchantment entering: surveil 1 (top card to graveyard)",
    "players": [
      { "hand": ["Blood Spatter Analysis"], "battlefield": ["Swamp", "Mountain", "Skullsnap Nuisance"], "library": ["Forest", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Blood Spatter Analysis" },
      { "resolve": true, "answers": [ ["Mountain"] ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Forest", "Mountain"] }, { "graveyard": ["Hill Giant"] } ]
    }
  },
  {
    "name": "creature entering does not surveil",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Skullsnap Nuisance"], "library": ["Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": [] }, {} ]
    }
  },
  {
    "name": "fully unlocking a Room surveils 1 (bin the top card)",
    "players": [
      { "battlefield": ["Skullsnap Nuisance", "Bottomless Pool // Locker Room", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "unlock": "Bottomless Pool // Locker Room", "door": 1, "answers": [] },
      { "resolve": true },
      { "unlock": "Bottomless Pool // Locker Room", "door": 2 },
      { "resolve": true, "answers": [ ["Forest"] ] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Forest"], "library_top": ["Mountain"] }, {} ]
    }
  },
  {
    "name": "unlocking only one door does not surveil",
    "players": [
      { "battlefield": ["Skullsnap Nuisance", "Bottomless Pool // Locker Room", "Island"], "library": ["Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "unlock": "Bottomless Pool // Locker Room", "door": 1, "answers": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": [], "library_top": ["Forest", "Mountain"] }, {} ]
    }
  },
  {
    "name": "ruling: unlocking door 2 first and door 1 second also fully unlocks the Room and surveils",
    "players": [
      { "battlefield": ["Skullsnap Nuisance", "Bottomless Pool // Locker Room", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "unlock": "Bottomless Pool // Locker Room", "door": 2, "answers": [] },
      { "resolve": true },
      { "unlock": "Bottomless Pool // Locker Room", "door": 1 },
      { "resolve": true, "answers": [ ["Forest"] ] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Forest"], "library_top": ["Mountain"] }, {} ]
    }
  }
]
