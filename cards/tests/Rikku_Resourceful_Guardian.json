[
 {
  "name": "steal moves one counter from an opponent's creature onto yours",
  "players": [
   { "battlefield": ["Island", { "name": "Rikku, Resourceful Guardian", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
   { "battlefield": [ { "name": "Hill Giant", "counters": { "p1p1": 2 } } ] }
  ],
  "steps": [
   { "activate": "Rikku, Resourceful Guardian", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Hill Giant": { "p1p1": 1 }, "Grizzly Bears": { "p1p1": 1 } }
  }
 },
 {
  "name": "the controller picks which kind of counter moves",
  "players": [
   { "battlefield": ["Island", { "name": "Rikku, Resourceful Guardian", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
   { "battlefield": [ { "name": "Hill Giant", "counters": { "p1p1": 1, "vigilance": 1 } } ] }
  ],
  "steps": [
   { "activate": "Rikku, Resourceful Guardian", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [1] }
  ],
  "expect": {
   "counters": { "Hill Giant": { "p1p1": 1, "vigilance": 0 }, "Grizzly Bears": { "vigilance": 1 } }
  }
 },
 {
  "name": "a creature that received a counter can't be blocked by opposing creatures this turn",
  "players": [
   { "battlefield": ["Island", { "name": "Rikku, Resourceful Guardian", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
   { "battlefield": [ { "name": "Hill Giant", "counters": { "p1p1": 2 } } ] }
  ],
  "steps": [
   { "activate": "Rikku, Resourceful Guardian", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "illegal": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "counters": { "Grizzly Bears": { "p1p1": 1 } }
  }
 },
 {
  "name": "ruling: moving a counter takes it off the source and puts it on the target (the target's power reflects it)",
  "players": [
   { "battlefield": ["Island", { "name": "Rikku, Resourceful Guardian", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
   { "battlefield": [ { "name": "Hill Giant", "counters": { "p1p1": 2 } } ] }
  ],
  "steps": [
   { "activate": "Rikku, Resourceful Guardian", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Hill Giant": { "p1p1": 1 }, "Grizzly Bears": { "p1p1": 1 } },
   "pt": { "Hill Giant": [4, 4], "Grizzly Bears": [3, 3] }
  }
 }
]
