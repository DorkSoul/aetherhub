[
  { "name": "cycling another card gains 1 life",
    "players": [ { "hand": ["Akroma's Blessing"], "battlefield": ["Drannith Healer", "Plains"] }, {} ],
    "steps": [ { "activate": "Akroma's Blessing" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Akroma's Blessing"] }, {} ] } },
  { "name": "cycling Drannith Healer from hand draws a card (no Healer in play, so no life)",
    "players": [ { "hand": ["Drannith Healer"], "battlefield": ["Plains"], "library": ["Island"] }, {} ],
    "steps": [ { "activate": "Drannith Healer" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "hand": ["Island"], "graveyard": ["Drannith Healer"] }, {} ] } },
  { "name": "ruling: Disallow on the cycling ability does not stop Drannith Healer's life gain (no draw, since the cycling was countered)",
    "players": [ { "hand": ["Akroma's Blessing"], "battlefield": ["Drannith Healer", "Plains"], "library": ["Island"] }, { "hand": ["Disallow"], "battlefield": ["Island", "Island", "Island"] } ],
    "steps": [ { "activate": "Akroma's Blessing" }, { "pass": true }, { "cast": "Disallow", "player": 1, "targets": [{ "stack": "Akroma's Blessing" }] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "hand": [], "graveyard": ["Akroma's Blessing"] }, { "graveyard": ["Disallow"] } ] } },
  { "name": "ruling: Disallow on the Healer's cycling trigger does not stop the cycling draw",
    "players": [ { "hand": ["Akroma's Blessing"], "battlefield": ["Drannith Healer", "Plains"], "library": ["Island"] }, { "hand": ["Disallow"], "battlefield": ["Island", "Island", "Island"] } ],
    "steps": [ { "activate": "Akroma's Blessing" }, { "pass": true }, { "cast": "Disallow", "player": 1, "targets": [{ "stack": "Drannith Healer" }] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "hand": ["Island"], "graveyard": ["Akroma's Blessing"] }, { "graveyard": ["Disallow"] } ] } },
  { "name": "ruling: Cancel cannot target the cycling ability or the cycling trigger (they are not spells)",
    "players": [ { "hand": ["Akroma's Blessing"], "battlefield": ["Drannith Healer", "Plains"], "library": ["Island"] }, { "hand": ["Cancel"], "battlefield": ["Island", "Island", "Island"] } ],
    "steps": [ { "activate": "Akroma's Blessing" }, { "pass": true }, { "cast": "Cancel", "player": 1, "illegal": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "hand": ["Island"], "graveyard": ["Akroma's Blessing"] }, { "hand": ["Cancel"] } ] } }
]
