[
  {
    "name": "equipped, it can attack",
    "players": [
      {
        "battlefield": [
          "Training Drone",
          "Bonesplitter",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Bonesplitter",
        "ability": 0,
        "targets": [
          "Training Drone"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Training Drone",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 14
        }
      ]
    }
  },
  { "name": "unequipped Drone cannot attack: its attack is dropped and only the Bears connects",
    "players": [ { "battlefield": ["Training Drone", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [ { "attack": [ { "card": "Training Drone", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "unequipped Drone cannot block: Hill Giant goes through, Bears blocks the Lions",
    "players": [ { "battlefield": ["Training Drone", { "name": "Grizzly Bears", "sick": false }] }, { "battlefield": [ { "name": "Hill Giant", "sick": false }, { "name": "Savannah Lions", "sick": false } ] } ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "attack": [ { "card": "Hill Giant", "at": "p0" }, { "card": "Savannah Lions", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Training Drone", "attacker": "Hill Giant" }, { "blocker": "Grizzly Bears", "attacker": "Savannah Lions" } ], "player": 0 },
      { "advance_to": "Main2", "player": 1 }
    ],
    "expect": { "players": [ { "life": 17 }, {} ] } },
  { "name": "ruling: Drone declared as attacker keeps attacking after its equipment is destroyed",
    "players": [ { "battlefield": ["Training Drone", "Bonesplitter", "Mountain", "Mountain", "Mountain"], "hand": ["Shatter"] }, {} ],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Training Drone"] },
      { "resolve": true },
      { "attack": [ { "card": "Training Drone", "at": "p1" } ] },
      { "cast": "Shatter", "targets": ["Bonesplitter"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Shatter"] }, { "life": 16 } ] } }
