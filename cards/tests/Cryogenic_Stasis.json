[
  {
    "name": "taps the target, puts a stun counter on it and draws a card",
    "players": [
      { "hand": ["Cryogenic Stasis"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Cryogenic Stasis", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "Stun": 1 } },
      "players": [ { "hand_count": 1, "graveyard": ["Cryogenic Stasis"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "boundary: an already tapped target still gets the stun counter and the card still draws",
    "players": [
      { "hand": ["Cryogenic Stasis"], "battlefield": ["Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Cryogenic Stasis", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "Stun": 1 } },
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "the stun counter is removed instead of untapping in its controller's untap step",
    "players": [
      { "hand": ["Cryogenic Stasis"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Cryogenic Stasis", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "Stun": 0 } },
      "players": [ {}, {} ]
    }
  }
]
