[
  {
    "name": "blitz: haste, then sacrificed at the end step and its death draws a card",
    "players": [
      { "hand": ["Caldaia Strongarm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Caldaia Strongarm", "alt": 0 },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "players": [ { "graveyard": ["Caldaia Strongarm"], "hand": ["Island"] }, {} ]
    }
  },
  {
    "name": "normal cast: not sacrificed at the end step",
    "players": [
      { "hand": ["Caldaia Strongarm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Caldaia Strongarm" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Caldaia Strongarm"] }, {} ]
    }
  },
  {
    "name": "ruling: a blitzed creature that dies before the end step still draws a card when it dies",
    "players": [
      { "hand": ["Caldaia Strongarm"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"], "library": ["Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Caldaia Strongarm", "alt": 0 },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Caldaia Strongarm"], "player": 1 },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Caldaia Strongarm"], "hand": ["Island"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  }
]
