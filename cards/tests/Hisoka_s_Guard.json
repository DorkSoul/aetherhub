[
  {
    "name": "target creature you control gains shroud while Hisoka's Guard stays tapped",
    "players": [
      { "battlefield": ["Hisoka's Guard", "Grizzly Bears", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Hisoka's Guard", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Shroud"] },
      "tapped": { "Hisoka's Guard": true }
    }
  },
  {
    "name": "cannot target itself",
    "players": [
      { "battlefield": ["Hisoka's Guard", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Hisoka's Guard", "targets": ["Hisoka's Guard"], "illegal": true }
    ]
  },
  {
    "name": "shroud ends when Hisoka's Guard untaps in its controller's untap step",
    "players": [
      { "battlefield": ["Hisoka's Guard", "Grizzly Bears", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Hisoka's Guard", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "turn": 4,
      "keywords": { "Grizzly Bears": [] },
      "tapped": { "Hisoka's Guard": false }
    }
  },
  {
    "name": "choosing not to untap keeps the shroud",
    "players": [
      { "battlefield": ["Hisoka's Guard", "Grizzly Bears", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Hisoka's Guard", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "turn": 4,
      "keywords": { "Grizzly Bears": ["Shroud"] },
      "tapped": { "Hisoka's Guard": true }
    }
  }
]
