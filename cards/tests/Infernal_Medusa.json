[
  {
    "name": "blocking a creature destroys it at end of combat",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Infernal Medusa"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Infernal Medusa", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Hill Giant"] },
        { "battlefield": ["Infernal Medusa"] }
      ]
    }
  },
  {
    "name": "blocker is not destroyed until end of combat",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Infernal Medusa"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Infernal Medusa", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "CombatDamage" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Hill Giant"] },
        { "battlefield": ["Infernal Medusa"] }
      ]
    }
  },
  {
    "name": "becoming blocked by a non-Wall creature destroys the blocker at end of combat",
    "players": [
      { "battlefield": ["Infernal Medusa"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Infernal Medusa", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Infernal Medusa" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Infernal Medusa"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "becoming blocked by a Wall does not destroy it",
    "players": [
      { "battlefield": ["Infernal Medusa"] },
      { "battlefield": ["Wall of Stone"] }
    ],
    "steps": [
      { "attack": [{ "card": "Infernal Medusa", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Stone", "attacker": "Infernal Medusa" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Infernal Medusa"] },
        { "battlefield": ["Wall of Stone"] }
      ]
    }
  }
]
