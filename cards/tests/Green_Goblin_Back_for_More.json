[
  {
    "name": "combat: you discard a card, each opponent discards a card",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Green Goblin, Back for More"] },
      { "hand": ["Island"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat", "answers": [true, ["Forest"]] },
      { "resolve": true, "answers": [] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Forest"] },
        { "graveyard": ["Island"] }
      ]
    }
  },
  {
    "name": "combat: declining the optional discard discards nothing",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Green Goblin, Back for More"] },
      { "hand": ["Island"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"] },
        { "hand": ["Island"] }
      ]
    }
  },
  {
    "name": "mayhem: discarded this turn, cast from graveyard for 3BB",
    "players": [
      { "hand": ["Wild Guess", "Green Goblin, Back for More"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Wild Guess" },
      { "resolve": true },
      { "cast": "Green Goblin, Back for More", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Wild Guess"], "battlefield_has": ["Green Goblin, Back for More"] },
        {}
      ]
    }
  },
  {
    "name": "mayhem: not discarded this turn, cannot be cast for mayhem",
    "players": [
      { "graveyard": ["Green Goblin, Back for More"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Green Goblin, Back for More", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Green Goblin, Back for More"] },
        {}
      ]
    }
  }
]
