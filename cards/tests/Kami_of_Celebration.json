   "players": [ { "battlefield": ["Kami of Celebration", "Grizzly Bears"], "library": ["Plains", "Forest"] }, {} ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": [] }, {} ] } },
 { "name": "casting a spell from exile puts a +1/+1 counter on target creature you control",
   "players": [ { "battlefield": ["Kami of Celebration", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }, "Mountain", "Mountain"], "library": ["Lightning Bolt"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true },
              { "advance_to": "Main2" },
              { "cast": "Lightning Bolt", "targets": ["Hill Giant", "Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Hill Giant"] } ],
               "counters": { "Grizzly Bears": { "p1p1": 2 } } } },
 { "name": "ruling: the exiled land is playable only in your main phase, and only if no land was played this turn",
   "players": [ { "hand": ["Forest"], "battlefield": ["Kami of Celebration", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }], "library": ["Plains"] }, {} ],
   "steps": [ { "play_land": "Forest" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true },
              { "advance_to": "Main2" }, { "play_land": "Plains", "illegal": true } ],
   "expect": { "players": [ { "exile": ["Plains"] }, {} ] } },
 { "name": "ruling: a creature with any kind of counter is modified (here a -1/-1 counter)",
   "players": [ { "battlefield": ["Kami of Celebration", { "name": "Grizzly Bears", "counters": { "m1m1": 1 } }], "library": ["Plains", "Forest"] }, {} ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true } ],
