[
 {
  "name": "taps for G or U",
  "players": [
   {
    "hand": [
     "Grizzly Bears"
    ],
    "battlefield": [
     "Forest",
     "Simic Keyrune"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Grizzly Bears"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Grizzly Bears"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "{G}{U}: becomes a 2/3 hexproof creature until end of turn",
  "players": [
   {
    "battlefield": [
     "Forest",
     "Island",
     "Simic Keyrune"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Simic Keyrune",
    "ability": 0
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Simic Keyrune": [
     2,
     3
    ]
   },
   "keywords": {
    "Simic Keyrune": [
     "Hexproof"
    ]
   }
  }
 },
 {
  "name": "needs both green and blue to animate",
  "players": [
   {
    "battlefield": [
     "Forest",
     "Forest",
     {
      "name": "Simic Keyrune",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Simic Keyrune",
    "ability": 0,
    "illegal": true
   }
  ]
 },
 {
  "name": "ruling: until the animate ability resolves the Keyrune is colorless",
  "players": [{"battlefield": ["Forest", "Island", "Simic Keyrune"]}, {}],
  "steps": [{"activate": "Simic Keyrune", "ability": 0}],
  "expect": {"stack_empty": false, "colors": {"Simic Keyrune": []}}
 },
 {
  "name": "ruling: once the animate ability resolves the Keyrune is green and blue",
  "players": [{"battlefield": ["Forest", "Island", "Simic Keyrune"]}, {}],
  "steps": [{"activate": "Simic Keyrune", "ability": 0}, {"resolve": true}],
  "expect": {"colors": {"Simic Keyrune": ["G", "U"]}}
 },
 {
  "name": "ruling: re-animating resets the 2/3 base but a +3/+3 pump still applies",
  "players": [{"hand": ["Giant Growth"], "battlefield": ["Forest", "Forest", "Forest", "Island", "Island", "Simic Keyrune"]}, {}],
  "steps": [
   {"activate": "Simic Keyrune", "ability": 0}, {"resolve": true},
   {"cast": "Giant Growth", "targets": ["Simic Keyrune"]}, {"resolve": true},
   {"activate": "Simic Keyrune", "ability": 0}, {"resolve": true}
  ],
  "expect": {"pt": {"Simic Keyrune": [5, 6]}}
 }
]
