[
  {
    "name": "vigilance: attacking does not tap it",
    "players": [
      { "battlefield": ["Charging Troll"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Charging Troll", "at": "p1" }] },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }],
      "tapped": { "Charging Troll": false }
    }
  },
  {
    "name": "regenerate: blocked by a 3/3 and survives with {G}",
    "players": [
      { "battlefield": ["Forest", "Charging Troll"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Charging Troll", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Charging Troll" }], "player": 1 },
      { "activate": "Charging Troll" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Charging Troll"] }, { "graveyard_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "regenerate needs {G}: cannot activate with only Plains",
    "players": [
      { "battlefield": ["Plains", "Charging Troll"] },
      {}
    ],
    "steps": [
      { "activate": "Charging Troll", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Charging Troll"] }, {}]
    }
  }
]
