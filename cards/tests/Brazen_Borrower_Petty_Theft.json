      { "hand": ["Brazen Borrower // Petty Theft"], "battlefield": ["Island", "Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Brazen Borrower // Petty Theft", "face": true, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Petty Theft" } ] },
      { "resolve": true }
    ],
    "expect": {
