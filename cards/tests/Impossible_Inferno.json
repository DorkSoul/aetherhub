    "players": [
      { "hand": ["Impossible Inferno"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Lightning Bolt", "Grizzly Bears", "Sol Ring", "Forest"], "library": ["Island", "Plains"] },
