[
  {
    "name": "cannot be blocked by a non-flying, non-reach creature",
    "players": [ { "battlefield": ["Spire Tracer"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Spire Tracer", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Spire Tracer" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 19 } ] }
  },
  {
    "name": "can be blocked by a flying creature",
    "players": [ { "battlefield": ["Spire Tracer"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "attack": [ { "card": "Spire Tracer", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Spire Tracer" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Spire Tracer"] }, { "battlefield_has": ["Serra Angel"] } ] }
  },
  {
    "name": "can't be blocked by a non-flier: the Grizzly Bears block is dropped and the Tracer hits for 1",
    "players": [
      { "battlefield": ["Spire Tracer"] },
      { "battlefield": ["Grizzly Bears", "Serra Angel"] }
    ],
    "steps": [
      { "attack": [ { "card": "Spire Tracer", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Spire Tracer" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ]
    }
  },
  {
    "name": "a flier can block it: Serra Angel's block stops the damage",
    "players": [
      { "battlefield": ["Spire Tracer"] },
      { "battlefield": ["Grizzly Bears", "Serra Angel"] }
    ],
    "steps": [
      { "attack": [ { "card": "Spire Tracer", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Spire Tracer" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Spire Tracer"] }, { "life": 20 } ]
    }
  }
]
