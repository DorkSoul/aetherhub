[
  {
    "name": "each player sacrifices a land for each card in your hand",
    "players": [
      { "hand": ["Thoughts of Ruin", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Thoughts of Ruin" },
      { "resolve": true, "answers": ["Mountain", "Forest"] }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Mountain", "Thoughts of Ruin"] }, { "graveyard_has": ["Forest"] }]
    }
  },
  {
    "name": "two cards in hand: two lands each",
    "players": [
      { "hand": ["Thoughts of Ruin", "Grizzly Bears", "Island"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Thoughts of Ruin" },
      { "resolve": true, "answers": ["Mountain", "Forest", "Mountain", "Forest"] }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Mountain", "Mountain"] }, { "graveyard_has": ["Forest", "Forest"] }]
    }
  },
  {
    "name": "no cards in hand: nothing is sacrificed",
    "players": [
      { "hand": ["Thoughts of Ruin"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Thoughts of Ruin" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield_has": ["Forest"] }]
    }
  }
]
