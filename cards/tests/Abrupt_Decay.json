  {
    "name": "ruling: X counts as 0, so Hangarback Walker cast for X=2 has mana value 0 and can be destroyed",
    "players": [
      { "hand": ["Hangarback Walker", "Abrupt Decay"], "battlefield": ["Island", "Island", "Island", "Island", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Hangarback Walker", "answers": [2] },
      { "resolve": true },
      { "cast": "Abrupt Decay", "targets": ["Hangarback Walker"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Abrupt Decay", "Hangarback Walker"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: ward can't be paid (only 1 life), but Abrupt Decay is still not countered",
    "players": [
      { "hand": ["Abrupt Decay"], "battlefield": ["Swamp", "Forest"] },
      { "life": 1, "battlefield": ["Dwarven Forge-Chanter"] }
    ],
    "steps": [
      { "cast": "Abrupt Decay", "targets": ["Dwarven Forge-Chanter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Abrupt Decay"] },
        { "graveyard_has": ["Dwarven Forge-Chanter"], "life": 1 }
      ]
    }
