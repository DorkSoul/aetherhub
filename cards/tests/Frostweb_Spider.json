[
  {
    "name": "blocking a flyer puts a +1/+1 counter on it at end of combat",
    "players": [ { "battlefield": ["Robot Hero 1-1 Flying"] }, { "battlefield": ["Frostweb Spider"] } ],
    "steps": [
      { "attack": [ { "card": "Robot Hero 1-1 Flying", "at": "p1" } ] },
      { "block": [ { "blocker": "Frostweb Spider", "attacker": "Robot Hero 1-1 Flying" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Frostweb Spider": [2, 4] } }
  },
  {
    "name": "blocking a non-flyer gives no counter",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Frostweb Spider"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Frostweb Spider", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Frostweb Spider": [1, 3] } }
  },
  {
    "name": "ruling: a flyer that kills the blocker leaves no +1/+1 counter",
    "players": [ { "battlefield": ["Serra Angel"] }, { "battlefield": ["Frostweb Spider"] } ],
    "steps": [
      { "attack": [ { "card": "Serra Angel", "at": "p1" } ] },
      { "block": [ { "blocker": "Frostweb Spider", "attacker": "Serra Angel" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Serra Angel"] }, { "graveyard": ["Frostweb Spider"] } ] }
  }
]
