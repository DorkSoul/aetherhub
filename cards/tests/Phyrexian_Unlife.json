[
 { "name": "at 0 life, Lightning Bolt damage is dealt as poison and you keep 0 life",
   "players": [ { "life": 0, "battlefield": ["Phyrexian Unlife", "Plains"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 0, "poison": 3 }, {} ] } },
 { "name": "above 0 life, damage is not converted: Bolt takes you from 3 to 0 with no poison",
   "players": [ { "life": 3, "battlefield": ["Phyrexian Unlife", "Plains"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 0, "poison": 0 }, {} ] } },
 { "name": "ruling: at 0 life, Phyrexian Unlife leaving the battlefield makes you lose the game",
   "players": [ { "life": 0, "battlefield": ["Phyrexian Unlife", "Plains"] },
                { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "pass": true },
              { "cast": "Disenchant", "player": 1 },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 0 }, {} ], "winner": 1 } },
 { "name": "ruling: at 0 life you cannot pay 2 life for Dismember's Phyrexian symbol, so it is illegal",
   "players": [ { "life": 0, "hand": ["Dismember"], "battlefield": ["Phyrexian Unlife", "Swamp", "Swamp"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Dismember", "illegal": true } ],
   "expect": { "players": [ { "life": 0, "hand": ["Dismember"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: at 20 life the same Dismember is castable, paying 2 life for the second Phyrexian symbol",
   "players": [ { "life": 20, "hand": ["Dismember"], "battlefield": ["Phyrexian Unlife", "Swamp", "Swamp"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Dismember" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 18 }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "ruling: two Shocks take you from 3 to -1 with no poison (the second goes from positive life to 0 or less)",
   "players": [ { "life": 3, "battlefield": ["Phyrexian Unlife", "Plains"] },
                { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true },
              { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true } ],
   "expect": { "players": [ { "life": -1, "poison": 0 }, {} ] } },
 { "name": "ruling: a third Shock at -1 life is dealt as infect: two poison counters, life stays -1",
   "players": [ { "life": 3, "battlefield": ["Phyrexian Unlife", "Plains"] },
                { "hand": ["Shock", "Shock", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true },
              { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true },
              { "pass": true },
              { "cast": "Shock", "player": 1, "targets": ["p0"] },
              { "resolve": true } ],
