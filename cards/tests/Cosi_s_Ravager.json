[
  {
    "name": "landfall pings the targeted player for 1",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Cosi's Ravager"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true, "targets": ["p1"], "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Cosi's Ravager", "Forest"] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "landfall ping can be declined",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Cosi's Ravager"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true, "targets": ["p1"], "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Cosi's Ravager"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: each landfall ability of the permanents you control triggers when a land enters",
    "players": [ { "hand": ["Forest"], "battlefield": ["Cosi's Ravager", "Cosi's Ravager"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "resolve": true, "targets": ["p1", "p1"], "answers": [true, true] } ],
    "expect": { "players": [ { "battlefield_has": ["Cosi's Ravager", "Forest"] }, { "life": 18 } ] }
  }
]
