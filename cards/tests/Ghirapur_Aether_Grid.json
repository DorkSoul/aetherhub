[
  {
    "name": "tap two artifacts: 1 damage to any target",
    "players": [
      { "battlefield": ["Ghirapur Aether Grid", "Ornithopter", "Ornithopter"] },
      {}
    ],
    "steps": [
      { "activate": "Ghirapur Aether Grid", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Ghirapur Aether Grid", "Ornithopter", "Ornithopter"] },
        { "life": 19 }
      ],
      "tapped": { "Ornithopter": true }
    }
  },
  {
    "name": "needs two artifacts: one artifact is not enough",
    "players": [
      { "battlefield": ["Ghirapur Aether Grid", "Ornithopter"] },
      {}
    ],
    "steps": [
      { "activate": "Ghirapur Aether Grid", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: summoning-sick artifact creatures can be tapped for the cost",
    "players": [
      { "battlefield": ["Ghirapur Aether Grid", {"name": "Ornithopter", "sick": true}, {"name": "Ornithopter", "sick": true}] },
      {}
    ],
    "steps": [
      { "activate": "Ghirapur Aether Grid", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield": ["Ghirapur Aether Grid", "Ornithopter", "Ornithopter"] }, { "life": 19 } ],
      "tapped": { "Ornithopter": true }
    }
  }
]
