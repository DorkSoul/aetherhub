[
  {
    "name": "draw three cards",
    "players": [
      {
        "hand": [
          "Lórien Revealed"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ],
        "library": [
          "Island",
          "Forest",
          "Plains",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lórien Revealed"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3,
          "graveyard": [
            "Lórien Revealed"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "islandcycling {1}: discard it to search for an Island",
    "players": [
      {
        "hand": [
          "Lórien Revealed"
        ],
        "battlefield": [
          "Island"
        ],
        "library": [
          "Forest",
          "Island",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Lórien Revealed"
      },
      {
        "resolve": true,
        "answers": [
          "Island"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Island"
          ],
          "graveyard": [
            "Lórien Revealed"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: islandcycling searches only for an Island, so a Forest is not fetched and nothing is drawn",
    "players": [ { "hand": ["Lórien Revealed"], "battlefield": ["Island"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Lórien Revealed" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Lórien Revealed"] }, {} ] }
  },
  {
    "name": "ruling: typecycling is cycling, so a 'whenever a player cycles' Aura gets a counter",
    "players": [
      { "hand": ["Withering Hex", "Lórien Revealed"], "battlefield": ["Swamp", "Island"], "library": ["Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Withering Hex", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Lórien Revealed" },
      { "resolve": true, "answers": ["Island"] }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "battlefield_has": ["Withering Hex"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "counters": { "Withering Hex": { "plague": 1 } },
      "pt": { "Grizzly Bears": [1, 1] }
    }
  }
]
