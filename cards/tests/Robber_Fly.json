[
  {
    "name": "blocked: defending player discards the hand and draws that many",
    "players": [
      {
        "battlefield": [
          "Robber Fly"
        ]
      },
      {
        "battlefield": [
          "Giant Spider"
        ],
        "hand": [
          "Plains",
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Robber Fly",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Giant Spider",
            "attacker": "Robber Fly"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard_has": [
            "Plains",
            "Mountain"
          ],
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "blocked with an empty hand: nothing is drawn",
    "players": [
      {
        "battlefield": [
          "Robber Fly"
        ]
      },
      {
        "battlefield": [
          "Giant Spider"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Robber Fly",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Giant Spider",
            "attacker": "Robber Fly"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "ruling: blocked by two creatures, the trigger happens only once",
    "players": [
      { "battlefield": ["Robber Fly"] },
      { "battlefield": ["Giant Spider", "Serra Angel"], "hand": ["Mountain"], "library": ["Lightning Bolt"] }
    ],
    "steps": [
      { "attack": [ { "card": "Robber Fly", "at": "p1" } ] },
      { "block": [ { "blocker": "Giant Spider", "attacker": "Robber Fly" }, { "blocker": "Serra Angel", "attacker": "Robber Fly" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "graveyard_has": ["Mountain"], "hand": ["Lightning Bolt"], "hand_count": 1 } ] }
  }
]
