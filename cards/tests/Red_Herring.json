[
  {
    "name": "haste: attacks the turn it is cast",
    "players": [
      { "hand": ["Red Herring"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Red Herring" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "block": [] }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "tapped": { "Red Herring": true }
    }
  },
  {
    "name": "{2}, sacrifice: draw a card",
    "players": [
      { "battlefield": ["Red Herring", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Red Herring" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Red Herring"], "hand_count": 1 }, {}]
    }
  },
  {
    "name": "ruling: a tapped Red Herring does not attack",
    "players": [
      { "battlefield": [ { "name": "Red Herring", "tapped": true } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "tapped": { "Red Herring": true }
    }
  }
]
