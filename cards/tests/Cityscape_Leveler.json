    "players": [
      { "graveyard": ["Cityscape Leveler"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Kozilek's Command"], "battlefield": ["Sol Ring", "Mountain"] }
    ],
    "steps": [
      { "activate": "Cityscape Leveler", "ability": 0 },
      { "pass": true },
      { "cast": "Kozilek's Command", "player": 1, "targets": ["p1", "Cityscape Leveler"], "answers": [[0, 3], 1] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Cityscape Leveler"], "battlefield_lacks": ["Cityscape Leveler"] }, { "battlefield_has": ["Eldrazi Spawn"], "graveyard": ["Kozilek's Command"] } ] }
