[
 {
  "name": "attacking adds RRRGGG that persists through steps until end of turn",
  "players": [
   { "battlefield": [{ "name": "Savage Ventmaw", "sick": false }] },
   {}
  ],
  "steps": [
   { "attack": [{ "card": "Savage Ventmaw", "at": "p1" }] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "pool": { "R": 3, "G": 3 } },
    { "life": 16 }
   ]
  }
 },
 {
  "name": "the mana is gone by the next turn",
  "players": [
   { "battlefield": [{ "name": "Savage Ventmaw", "sick": false }] },
   {}
  ],
  "steps": [
   { "attack": [{ "card": "Savage Ventmaw", "at": "p1" }] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Upkeep", "auto": true }
  ],
  "expect": {
   "turn": 2,
   "players": [
    { "pool": {} },
    {}
   ]
  }
 },
 {
  "name": "ruling: the attack mana lasts for the turn even after Savage Ventmaw dies in combat",
  "players": [ { "battlefield": [{ "name": "Savage Ventmaw", "sick": false }] }, { "battlefield": ["Serra Angel"] } ],
  "steps": [
   { "attack": [{ "card": "Savage Ventmaw", "at": "p1" }] },
   { "resolve": true },
   { "block": [{ "blocker": "Serra Angel", "attacker": "Savage Ventmaw" }] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "pool": { "R": 3, "G": 3 }, "graveyard": ["Savage Ventmaw"] }, { "life": 20, "graveyard": ["Serra Angel"] } ] }
 }
]
