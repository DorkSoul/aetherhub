[
  {
    "name": "draws with a 4-power creature",
    "players": [
      {
        "battlefield": [
          "Bonders' Enclave",
          "Forest",
          "Forest",
          "Forest",
          "Hill Giant",
          "Beast 4-4"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Bonders' Enclave"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "can't activate with only 3-power creatures",
    "players": [
      {
        "battlefield": [
          "Bonders' Enclave",
          "Forest",
          "Forest",
          "Forest",
          "Hill Giant"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Bonders' Enclave",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "ruling: the check is made once; the draw happens even if the 4-power creature dies in response",
    "players": [
      {
        "battlefield": ["Bonders' Enclave", "Forest", "Forest", "Forest", "Beast 4-4"]
      },
      {
        "hand": ["Terror"],
        "battlefield": ["Swamp", "Swamp"]
      }
    ],
    "steps": [
      { "activate": "Bonders' Enclave" },
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Beast 4-4"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "battlefield_lacks": ["Beast 4-4"] },
        { "graveyard": ["Terror"] }
      ]
    }
  }
]