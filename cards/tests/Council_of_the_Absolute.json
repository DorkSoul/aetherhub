[
  {
    "name": "chosen noncreature nonland name: the opponent cannot cast Lightning Bolt, Giant Growth is not affected",
    "players": [
      { "hand": ["Council of the Absolute"], "battlefield": ["Plains", "Island", "Plains", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Council of the Absolute" },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"], "illegal": true }
    ],
    "expect": { "players": [ { "life": 20 }, { "hand": ["Lightning Bolt"] } ] }
  },
  {
    "name": "the controller's own spell with the chosen name costs {2} less: Divination costs only {U}",
    "players": [
      { "hand": ["Council of the Absolute", "Divination"], "battlefield": ["Plains", "Island", "Plains", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Council of the Absolute" },
      { "resolve": true, "answers": ["Divination"] },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Divination"] }, {} ] }
  },
  {
    "name": "the cost reduction applies only to the chosen name: Divination (not named) still costs {2}{U}",
    "players": [
      { "hand": ["Council of the Absolute", "Divination", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Plains", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Council of the Absolute" },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "cast": "Divination", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Divination", "Lightning Bolt"] }, {} ] }
  },
  {
    "name": "ruling: the reduction cannot reduce a colored requirement: Lightning Bolt still needs {R} (no free cast with the lands used for Council)",
    "players": [
      { "hand": ["Council of the Absolute", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Plains", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Council of the Absolute" },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "life": 20 } ] }
  }
]
