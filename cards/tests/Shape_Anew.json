[
  {
    "name": "controller sacrifices the artifact, then the first artifact found enters under their control",
    "players": [
      { "hand": ["Shape Anew"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Ornithopter"], "library": ["Forest", "Sol Ring", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shape Anew", "targets": ["Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": ["Sol Ring"], "graveyard": ["Ornithopter"] }
      ]
    }
  },
  {
    "name": "no other artifact in the library: nothing enters",
    "players": [
      { "hand": ["Shape Anew"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Ornithopter"], "library": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shape Anew", "targets": ["Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": [], "graveyard": ["Ornithopter"] }
      ]
    }
  },
  {
    "name": "ruling: artifact killed in response, so Shape Anew does nothing else",
    "players": [
      { "hand": ["Shape Anew"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Ornithopter"], "library": ["Forest", "Sol Ring"] }
    ],
    "steps": [
      { "cast": "Shape Anew", "targets": ["Ornithopter"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Ornithopter"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": ["Mountain"], "graveyard": ["Ornithopter", "Lightning Bolt"], "library_top": ["Forest", "Sol Ring"] }
      ]
    }
  }
]
