[
 {
  "name": "targeted by a spell: sacrificed before the spell resolves",
  "players": [ { "hand": ["Shock"], "battlefield": ["Mountain"] }, { "battlefield": ["Phantasmal Dreadmaw"] } ],
  "steps": [ { "cast": "Shock", "targets": ["Phantasmal Dreadmaw"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Shock"] }, { "graveyard": ["Phantasmal Dreadmaw"], "life": 20 } ] }
 },
 {
  "name": "a spell targeting only the player leaves it alone",
  "players": [ { "hand": ["Shock"], "battlefield": ["Mountain"] }, { "battlefield": ["Phantasmal Dreadmaw"] } ],
  "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ {}, { "battlefield_has": ["Phantasmal Dreadmaw"], "life": 18 } ] }
 },
 {
  "name": "ruling: countering the spell does not save it from the sacrifice",
  "players": [ { "hand": ["Shock"], "battlefield": ["Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Phantasmal Dreadmaw"] } ],
  "steps": [ { "cast": "Shock", "targets": ["Phantasmal Dreadmaw"] }, { "pass": true }, { "cast": "Counterspell", "player": 1 }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Shock"] }, { "graveyard": ["Phantasmal Dreadmaw", "Counterspell"], "life": 20 } ] }
 }
]
