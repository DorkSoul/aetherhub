 {
  "name": "a flier cannot block it: the Wind Drake's block is dropped and Stone Spirit deals 4",
  "players": [ { "battlefield": ["Stone Spirit", "Hill Giant"] }, { "battlefield": ["Wind Drake", "Grizzly Bears"] } ],
  "steps": [
   { "attack": [ { "card": "Stone Spirit", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
   { "block": [ { "blocker": "Wind Drake", "attacker": "Stone Spirit" }, { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ], "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 16, "battlefield_has": ["Wind Drake"], "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: a reach creature (not a flier) can block it while a flier beside it cannot",
  "players": [ { "battlefield": ["Stone Spirit"] }, { "battlefield": ["Giant Spider", "Wind Drake"] } ],
  "steps": [
   { "attack": [ { "card": "Stone Spirit", "at": "p1" } ] },
   { "block": [ { "blocker": "Giant Spider", "attacker": "Stone Spirit" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 20, "graveyard": ["Giant Spider"], "battlefield_has": ["Wind Drake"] } ] }
 }
]