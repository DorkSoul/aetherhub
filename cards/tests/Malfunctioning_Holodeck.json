[
  {
    "name": "enters: exiles an opposing nonland permanent until it leaves",
    "players": [
      { "hand": ["Malfunctioning Holodeck"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Malfunctioning Holodeck" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Malfunctioning Holodeck"] },
        { "exile": ["Hill Giant"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "exiled creature returns under its owner's control when the Holodeck leaves",
    "players": [
      { "hand": ["Malfunctioning Holodeck"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "hand": ["Naturalize"], "battlefield": ["Hill Giant", "Forest", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Malfunctioning Holodeck" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Naturalize", "player": 1, "targets": ["Malfunctioning Holodeck"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Malfunctioning Holodeck"] },
        { "graveyard": ["Naturalize"], "battlefield_has": ["Hill Giant"], "exile": [] }
      ]
    }
  },
  {
    "name": "ward {2}: opponent with no spare mana cannot pay, Naturalize is countered",
    "players": [
      { "hand": ["Naturalize"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Malfunctioning Holodeck", "Hill Giant", "Plains"] }
    ],
    "steps": [
      { "cast": "Naturalize", "targets": ["Malfunctioning Holodeck"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Naturalize"] },
        { "battlefield_has": ["Malfunctioning Holodeck", "Hill Giant"] }
      ]
    }
  }
]
