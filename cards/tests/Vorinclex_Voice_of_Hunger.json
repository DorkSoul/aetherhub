    "hand": ["Murder"],
    "battlefield": ["Vorinclex, Voice of Hunger", "Swamp", "Swamp", "Swamp"]
   },
   {
    "battlefield": ["Forest"]
   }
  ],
  "steps": [
   { "pass": true },
   { "tap_for_mana": "Forest", "player": 1 },
   { "pass": true, "player": 1 },
   { "cast": "Murder", "targets": ["Vorinclex, Voice of Hunger"] },
   { "resolve": true },
   { "advance_to": "Main1" },
   { "advance_to": "Main1" }
  ],
  "expect": {
