[
  {
    "name": "equip costs {1} less: Bonesplitter equips with no mana",
    "players": [
      { "battlefield": ["Auriok Steelshaper", "Bonesplitter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [4, 2] }, "attached": { "Bonesplitter": "Grizzly Bears" } }
  },
  {
    "name": "as long as equipped, it gets +1/+1 for itself (Soldier) and not other creatures",
    "players": [
      { "battlefield": ["Auriok Steelshaper", "Bonesplitter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Bonesplitter", "targets": ["Auriok Steelshaper"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Auriok Steelshaper": [4, 2], "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "not equipped: no +1/+1 bonus",
    "players": [
      { "battlefield": ["Auriok Steelshaper", "Grizzly Bears"] },
      {}
    ],
    "steps": [],
    "expect": { "pt": { "Auriok Steelshaper": [1, 1] } }
  },
  {
    "name": "a non-equip ability of other Equipment is not reduced (Batterskull {3} return)",
    "players": [
      { "battlefield": ["Auriok Steelshaper", "Batterskull", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Batterskull", "ability": 0, "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Batterskull"] }, {} ] }
  }
]
