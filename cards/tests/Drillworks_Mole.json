[
  {
    "name": "puts a +1/+1 counter on itself and on target commander you control",
    "commander": true,
    "players": [
      {
        "command": [
          "Test Commander"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Drillworks Mole"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Test Commander"
      },
      {
        "resolve": true
      },
      {
        "activate": "Drillworks Mole",
        "ability": 0,
        "targets": [
          "Test Commander"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Drillworks Mole": [
          2,
          2
        ],
        "Test Commander": [
          4,
          4
        ]
      },
      "players": [
        {
          "battlefield_has": [
            "Drillworks Mole",
            "Test Commander"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "with no commander it still puts a counter on itself",
    "players": [
      {
        "battlefield": [
          "Forest",
          "Forest",
          "Drillworks Mole",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Drillworks Mole",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Drillworks Mole": [
          2,
          2
        ],
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "ruling: commander target gone in response: the ability fizzles, no counter on Drillworks Mole",
    "commander": true,
    "players": [
      { "command": ["Test Commander"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Drillworks Mole"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Test Commander" },
      { "resolve": true },
      { "activate": "Drillworks Mole", "ability": 0, "targets": ["Test Commander"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Test Commander"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Drillworks Mole": [1, 1] },
      "players": [ { "battlefield_has": ["Drillworks Mole"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  },
  {
    "name": "ruling: Drillworks Mole gone in response: the commander target still gets its counter",
    "commander": true,
    "players": [
      { "command": ["Test Commander"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Drillworks Mole"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Test Commander" },
      { "resolve": true },
      { "activate": "Drillworks Mole", "ability": 0, "targets": ["Test Commander"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Drillworks Mole"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Test Commander": [4, 4] },
      "players": [ { "graveyard": ["Drillworks Mole"], "battlefield_has": ["Test Commander"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  }
]