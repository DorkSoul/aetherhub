[
 { "name": "draws one card when no other instant or sorcery was cast this turn",
   "players": [ { "hand": ["Lock and Load"], "battlefield": ["Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Lock and Load" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Island"] }, {} ] } },
 { "name": "draws one extra card per other instant or sorcery cast this turn",
   "players": [ { "hand": ["Lightning Bolt", "Lock and Load"], "battlefield": ["Island", "Island", "Island", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lock and Load" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2 }, {} ] } },
 { "name": "plot pays {3}{U} and the card is cast for free on a later turn, drawing one card",
   "players": [ { "hand": ["Lock and Load"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "activate": "Lock and Load", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
              { "cast": "Lock and Load", "alt": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2 }, {} ] } },
 { "name": "ruling: a plotted card cannot be cast on the turn it was plotted, but can on a later turn",
   "players": [ { "hand": ["Lock and Load"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "activate": "Lock and Load", "ability": 0 }, { "resolve": true }, { "cast": "Lock and Load", "alt": 0, "illegal": true },
              { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Lock and Load", "alt": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2 }, {} ] } },
 { "name": "ruling: a countered instant still counts as another spell cast this turn",
   "players": [ { "hand": ["Lightning Bolt", "Lock and Load"], "battlefield": ["Mountain", "Island", "Island", "Island"] },
                { "hand": ["Abjure"], "battlefield": ["Island", "Air Elemental"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Abjure", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
              { "resolve": true }, { "cast": "Lock and Load" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Abjure"], "life": 20 } ] } }
]
