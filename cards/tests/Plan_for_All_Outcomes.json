[
  {
    "name": "ETB: owner puts target nonland permanent on top",
    "players": [
      { "hand": ["Plan for All Outcomes"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Plan for All Outcomes" },
      { "resolve": true, "targets": ["Grizzly Bears"], "answers": [true] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Plan for All Outcomes"] }, { "battlefield": [] } ] }
  },
  {
    "name": "ETB: owner may choose the bottom, no target is fine",
    "players": [
      { "hand": ["Plan for All Outcomes"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Plan for All Outcomes" },
      { "resolve": true, "targets": ["Grizzly Bears"], "answers": [false] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Plan for All Outcomes"] }, { "battlefield": [] } ] }
  },
  {
    "name": "first noncreature spell each turn makes a Jace token with 1 loyalty; second does not add",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Plan for All Outcomes", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Jace": { "loyalty": 1 } },
      "players": [ { "battlefield_has": ["Jace"] }, {} ]
    }
  },
  {
    "name": "creature spells do not empower",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Plan for All Outcomes", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
  }
]
