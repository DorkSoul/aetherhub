    "steps": [ { "cast": "Thirst", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": true }, "attached": { "Thirst": "Grizzly Bears" } } },
  { "name": "sacrificed at upkeep when {U} is not paid",
    "players": [ { "hand": ["Thirst"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Thirst", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Thirst"] }, {} ] } },
  { "name": "enchanted creature stays tapped through its controller's untap step",
    "players": [ { "hand": ["Thirst"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Thirst", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "tapped": { "Grizzly Bears": true }, "attached": { "Thirst": "Grizzly Bears" } } }
]
