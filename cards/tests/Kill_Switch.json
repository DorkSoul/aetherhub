[
  { "name": "other artifacts are tapped and skip their controller's untap while Kill Switch is tapped",
    "players": [ { "battlefield": ["Kill Switch", "Sol Ring", "Mountain", "Mountain"] }, { "battlefield": ["Mind Stone"] } ],
    "steps": [ { "activate": "Kill Switch" }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 2, "tapped": { "Kill Switch": true, "Sol Ring": true, "Mind Stone": true } } },
  { "name": "Kill Switch untaps in the same step, so Sol Ring stays tapped once more; Mind Stone is free on turn 4",
    "players": [ { "battlefield": ["Kill Switch", "Sol Ring", "Mountain", "Mountain"] }, { "battlefield": ["Mind Stone"] } ],
    "steps": [ { "activate": "Kill Switch" }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 3, "tapped": { "Kill Switch": false, "Sol Ring": true } } },
  { "name": "turn 4: everything untaps",
    "players": [ { "battlefield": ["Kill Switch", "Sol Ring", "Mountain", "Mountain"] }, { "battlefield": ["Mind Stone"] } ],
    "steps": [ { "activate": "Kill Switch" }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "tapped": { "Mind Stone": false } } },
  { "name": "ruling: an artifact that enters after the tap is not locked and untaps normally",
    "players": [ { "hand": ["Mind Stone"], "battlefield": ["Kill Switch", "Sol Ring", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Kill Switch" }, { "resolve": true }, { "cast": "Mind Stone" }, { "resolve": true }, { "tap_for_mana": "Mind Stone" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 3, "tapped": { "Kill Switch": false, "Sol Ring": true, "Mind Stone": false } } }
]
