[
  {
    "name": "enters tapped",
    "players": [ { "hand": ["Ancient Spring"] }, {} ],
    "steps": [ { "play_land": "Ancient Spring" } ],
    "expect": { "tapped": { "Ancient Spring": true } }
  },
  {
    "name": "T: add U",
    "players": [ { "battlefield": ["Ancient Spring"] }, {} ],
    "steps": [ { "tap_for_mana": "Ancient Spring", "color": "U" } ],
    "expect": { "players": [ { "pool": { "U": 1 }, "battlefield_has": ["Ancient Spring"] }, {} ] }
  },
  {
    "name": "T, sacrifice this land: add W and B",
    "players": [ { "battlefield": ["Ancient Spring"] }, {} ],
    "steps": [ { "tap_for_mana": "Ancient Spring", "color": "W" } ],
    "expect": { "players": [ { "pool": { "W": 1, "B": 1 }, "battlefield_lacks": ["Ancient Spring"] }, {} ] }
  }
]
