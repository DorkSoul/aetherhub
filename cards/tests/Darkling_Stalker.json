[
  {
    "name": "B: +1/+1 until end of turn",
    "players": [{ "battlefield": ["Darkling Stalker", "Swamp"] }, {}],
    "steps": [{ "activate": "Darkling Stalker", "ability": 1 }, { "resolve": true }],
    "expect": { "pt": { "Darkling Stalker": [2, 2] } }
  },
  {
    "name": "pump can be activated twice with two black mana",
    "players": [{ "battlefield": ["Darkling Stalker", "Swamp", "Swamp"] }, {}],
    "steps": [
      { "activate": "Darkling Stalker", "ability": 1 }, { "resolve": true },
      { "activate": "Darkling Stalker", "ability": 1 }, { "resolve": true }
    ],
    "expect": { "pt": { "Darkling Stalker": [3, 3] } }
  },
  {
    "name": "regeneration ability needs black mana",
    "players": [{ "battlefield": ["Darkling Stalker", "Forest"] }, {}],
    "steps": [{ "activate": "Darkling Stalker", "ability": 0, "illegal": true }]
  },
  {
    "name": "B: regeneration saves the Stalker from lethal combat damage",
    "players": [{ "battlefield": ["Darkling Stalker", "Swamp"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [ { "card": "Darkling Stalker", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Darkling Stalker" } ] },
      { "activate": "Darkling Stalker", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Darkling Stalker"] }, { "battlefield_has": ["Grizzly Bears"] }],
      "tapped": { "Darkling Stalker": true }
    }
  },
  {
    "name": "without B mana the Stalker dies to lethal combat damage",
    "players": [{ "battlefield": ["Darkling Stalker", "Forest"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [ { "card": "Darkling Stalker", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Darkling Stalker" } ] },
      { "activate": "Darkling Stalker", "ability": 0, "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "graveyard": ["Darkling Stalker"] }, {}]
    }
  }
]
