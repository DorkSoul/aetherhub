[
  { "name": "opponent exiles a creature and a graveyard card; cast them with any mana",
    "players": [ { "hand": ["Azula, Cunning Usurper"], "battlefield": ["Island", "Swamp", "Swamp", "Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant"], "graveyard": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Azula, Cunning Usurper" }, { "resolve": true }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Azula, Cunning Usurper", "Grizzly Bears"] }, { "life": 17, "battlefield_lacks": ["Hill Giant"], "exile": ["Hill Giant"] } ] } },
 { "name": "firebending 2: attacking adds RR until end of combat",
   "players": [ { "battlefield": ["Azula, Cunning Usurper"] }, {} ],
   "steps": [ { "attack": [ { "card": "Azula, Cunning Usurper", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "players": [ { "pool": { "R": 2 } }, {} ] } },
 { "name": "the firebending mana is gone after combat",
   "players": [ { "battlefield": ["Azula, Cunning Usurper"] }, {} ],
   "steps": [ { "attack": [ { "card": "Azula, Cunning Usurper", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": {} }, {} ] } },
 { "name": "exiled creature can be cast in your end step (as though it had flash)",
   "players": [ { "hand": ["Azula, Cunning Usurper"], "battlefield": ["Island", "Swamp", "Swamp", "Island", "Island", "Island", "Island", "Island", "Island"] },
                { "battlefield": ["Hill Giant"], "graveyard": ["Lightning Bolt"] } ],
   "steps": [ { "cast": "Azula, Cunning Usurper" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "cast": "Hill Giant" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Azula, Cunning Usurper", "Hill Giant"] }, { "battlefield_lacks": ["Hill Giant"] } ] } },
 { "name": "ruling: firebending is a triggered ability on the stack; no mana until it resolves",
   "players": [ { "battlefield": ["Azula, Cunning Usurper"] }, {} ],
   "steps": [ { "attack": [ { "card": "Azula, Cunning Usurper", "at": "p1" } ] } ],
   "expect": { "players": [ { "pool": {} }, {} ], "stack_empty": false } },
 { "name": "ruling: firebending mana is still available after combat damage",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Azula, Cunning Usurper"] }, {} ],
   "steps": [ { "attack": [ { "card": "Azula, Cunning Usurper", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "life": 13 } ] } },
 { "name": "ruling: other mana added in combat is lost between combat steps, firebending mana is kept",
   "players": [ { "battlefield": ["Azula, Cunning Usurper", "Plains"] }, {} ],
   "steps": [ { "attack": [ { "card": "Azula, Cunning Usurper", "at": "p1" } ] }, { "resolve": true }, { "tap_for_mana": "Plains" }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 2 } }, { "life": 16 } ] } },
 { "name": "ruling: a card cast from exile leaves exile and cannot be cast again",
   "players": [ { "hand": ["Azula, Cunning Usurper"], "battlefield": ["Island", "Swamp", "Swamp", "Island", "Island", "Island", "Island", "Island", "Island"] },
                { "battlefield": ["Hill Giant"], "graveyard": ["Lightning Bolt"] } ],
   "steps": [ { "cast": "Azula, Cunning Usurper" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "cast": "Hill Giant" }, { "resolve": true }, { "cast": "Hill Giant", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Azula, Cunning Usurper", "Hill Giant"] }, { "battlefield_lacks": ["Hill Giant"] } ] } }
]
