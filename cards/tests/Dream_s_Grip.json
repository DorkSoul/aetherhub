[
 { "name": "tap mode taps the target creature",
   "players": [ { "hand": ["Dream's Grip"], "battlefield": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Dream's Grip", "answers": [0], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true }, "players": [ { }, { "life": 20 } ] } },
 { "name": "untap mode untaps a tapped target",
   "players": [ { "hand": ["Dream's Grip"], "battlefield": ["Island"] }, { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] } ],
   "steps": [ { "cast": "Dream's Grip", "answers": [1], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": false } } },
 { "name": "entwined ({1} more): taps one target and untaps another",
   "players": [ { "hand": ["Dream's Grip"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears", { "name": "Hill Giant", "tapped": true }] } ],
   "steps": [ { "cast": "Dream's Grip", "answers": [true], "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true, "Hill Giant": false } } },
 { "name": "not entwined with one mode: the other target is untouched",
   "players": [ { "hand": ["Dream's Grip"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Grizzly Bears", { "name": "Hill Giant", "tapped": true }] } ],
   "steps": [ { "cast": "Dream's Grip", "answers": [false, 0], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true, "Hill Giant": true } } }
