  {
    "name": "ruling: a Food cannot be sacrificed to pay two costs (its own ability, then Maraleaf Rider's)",
    "players": [
      { "battlefield": ["Plains", "Plains", "Maraleaf Rider", "Food"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Food", "ability": 0 },
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "battlefield_has": ["Maraleaf Rider"], "battlefield_lacks": ["Food"] },
