[
  { "name": "discover 4 casts the revealed nonland card for free",
    "players": [ { "battlefield": ["Hidden Nursery", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "activate": "Hidden Nursery", "ability": 0 }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Hidden Nursery"], "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "enters tapped",
    "players": [ { "hand": ["Hidden Nursery"] }, {} ],
    "steps": [ { "play_land": "Hidden Nursery" } ],
    "expect": { "players": [ { "battlefield_has": ["Hidden Nursery"] }, {} ], "tapped": { "Hidden Nursery": true } } },
  { "name": "ruling: a discovered card that cannot be cast goes to hand (no creature to target with Doom Blade)",
    "players": [ { "battlefield": ["Hidden Nursery", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Doom Blade", "Forest"] }, {} ],
    "steps": [ { "activate": "Hidden Nursery", "ability": 0 }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Hidden Nursery"], "hand": ["Doom Blade"] }, {} ] } },
  { "name": "ruling: declining to cast the discovered card puts it in hand",
    "players": [ { "battlefield": ["Hidden Nursery", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Hidden Nursery", "ability": 0 }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a discovered spell with {X} in its cost is cast with X = 0 (Fireball deals no damage)",
    "players": [ { "battlefield": ["Hidden Nursery", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Fireball", "Forest"] }, {} ],
    "steps": [ { "activate": "Hidden Nursery", "ability": 0 }, { "resolve": true, "answers": [true], "targets": ["p1"] } ],
    "expect": { "players": [ { "graveyard_has": ["Fireball"] }, { "life": 20 } ] } }
]
