[
  {
    "name": "second card drawn in a turn makes a Drake",
    "players": [
      {
        "hand": [
          "Divination"
        ],
        "battlefield": [
          "Alandra, Sky Dreamer",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Drake 2-2 Flying"
          ],
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "a single draw makes no Drake",
    "players": [
      {
        "hand": [
          "Wall of Omens"
        ],
        "battlefield": [
          "Alandra, Sky Dreamer",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Wall of Omens"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Drake 2-2 Flying"
          ],
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "only the second card triggers: four draws still make exactly one Drake",
    "players": [
      {
        "hand": [
          "Divination",
          "Divination"
        ],
        "battlefield": [
          "Alandra, Sky Dreamer",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      },
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Alandra, Sky Dreamer",
            "Drake 2-2 Flying",
            "Island",
            "Island",
            "Island",
            "Island",
            "Island",
            "Island"
          ],
          "hand_count": 4
        }
      ],
      "pt": {
        "Alandra, Sky Dreamer": [
          2,
          4
        ],
        "Drake 2-2 Flying": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "fifth card pumps Alandra and Drakes by cards in hand",
    "players": [
      {
        "hand": [
          "Divination",
          "Divination",
          "Wall of Omens"
        ],
        "battlefield": [
          "Alandra, Sky Dreamer",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      },
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      },
      {
        "cast": "Wall of Omens"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 5
        }
      ],
      "pt": {
        "Alandra, Sky Dreamer": [
          7,
          9
        ],
        "Drake 2-2 Flying": [
          7,
          7
        ],
        "Wall of Omens": [
          0,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: a second draw while Alandra is off the battlefield makes no Drake, even if she is back for later draws",
    "players": [
      {
        "hand": ["Divination", "Alandra, Sky Dreamer", "Divination"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Alandra, Sky Dreamer" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Alandra, Sky Dreamer"], "battlefield_lacks": ["Drake 2-2 Flying"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: X is locked in when the fifth-draw ability resolves; later hand changes do not change it",
    "players": [
      {
        "hand": ["Divination", "Divination", "Wall of Omens", "Plains"],
        "battlefield": ["Alandra, Sky Dreamer", "Island", "Island", "Island", "Island", "Island", "Island", "Plains", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Wall of Omens" },
      { "resolve": true },
      { "play_land": "Plains" }
    ],
    "expect": {
      "players": [
        { "hand_count": 5 }
      ],
      "pt": {
        "Alandra, Sky Dreamer": [8, 10],
        "Drake 2-2 Flying": [8, 8]
      }
    }
  }
]
