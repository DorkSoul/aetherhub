[
  {
    "name": "counters a spell",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Neutralize"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Neutralize", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Neutralize"] }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "cycles for two to draw a card",
    "players": [
      { "hand": ["Neutralize"], "battlefield": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Neutralize", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Neutralize"], "hand_count": 1 },
        {}
      ]
    }
  }
]
