[
  {
    "name": "a non-artifact creature that shares no color cannot block it, so damage gets through",
    "players": [
      { "battlefield": ["Bladetusk Boar"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Bladetusk Boar", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield": ["Bladetusk Boar"] }, { "life": 17, "battlefield": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "a red creature can block it",
    "players": [
      { "battlefield": ["Bladetusk Boar"] },
      { "battlefield": ["Raging Goblin"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Bladetusk Boar", "at": "p1" }] },
      { "block": [{ "blocker": "Raging Goblin", "attacker": "Bladetusk Boar" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield": ["Bladetusk Boar"], "life": 20 }, { "graveyard": ["Raging Goblin"], "battlefield": [], "life": 20 }]
    }
  },
  {
    "name": "ruling: intimidate uses the Boar's current colour (turned blue, so a red Raging Goblin cannot block)",
    "players": [
      { "hand": ["Thoughtlace"], "battlefield": ["Bladetusk Boar", "Island"] },
      { "battlefield": ["Raging Goblin"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Bladetusk Boar", "at": "p1" }] },
      { "cast": "Thoughtlace", "targets": ["Bladetusk Boar"] },
      { "resolve": true },
      { "block": [{ "blocker": "Raging Goblin", "attacker": "Bladetusk Boar" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Bladetusk Boar"], "life": 20 }, { "life": 17, "battlefield_has": ["Raging Goblin"] }],
      "colors": { "Bladetusk Boar": ["U"] }
    }
  },
  {
    "name": "ruling: changing colour after a block does not undo the block",
    "players": [
      { "hand": ["Thoughtlace"], "battlefield": ["Bladetusk Boar", "Island"] },
      { "battlefield": ["Raging Goblin"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Bladetusk Boar", "at": "p1" }] },
      { "block": [{ "blocker": "Raging Goblin", "attacker": "Bladetusk Boar" }] },
      { "cast": "Thoughtlace", "targets": ["Bladetusk Boar"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Bladetusk Boar"], "life": 20 }, { "life": 20, "graveyard_has": ["Raging Goblin"] }],
      "colors": { "Bladetusk Boar": ["U"] }
    }
  }
]
