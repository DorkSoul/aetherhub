[
  {
    "name": "affinity: one artifact makes it cost {4}{U}",
    "players": [
      { "hand": ["Steelfin Whale"], "battlefield": ["Darksteel Ingot", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Steelfin Whale" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Steelfin Whale"] }, {}]
    }
  },
  {
    "name": "without artifacts it costs six: five lands are not enough",
    "players": [
      { "hand": ["Steelfin Whale"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Steelfin Whale", "illegal": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, {}]
    }
  },
  {
    "name": "untaps when an artifact you control enters",
    "players": [
      { "hand": ["Darksteel Ingot"], "battlefield": [{ "name": "Steelfin Whale", "tapped": true }, "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Darksteel Ingot" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Steelfin Whale", "Darksteel Ingot"] }, {}],
      "tapped": { "Steelfin Whale": false }
    }
  }
]
