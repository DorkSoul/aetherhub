[
  {
    "name": "upkeep: put a -2/-2 counter on it",
    "players": [
      { "battlefield": ["Ebon Praetor"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "pt": { "Ebon Praetor": [3, 3] }
    }
  },
  {
    "name": "sacrifice a Thrull in upkeep: remove the counter and get +1/+0",
    "players": [
      { "battlefield": ["Ebon Praetor", "Derelor", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "advance_to": "Upkeep" },
      { "activate": "Ebon Praetor", "answers": ["Derelor"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ebon Praetor": [6, 5] }
    }
  },
  {
    "name": "sacrificing a non-Thrull only removes the counter",
    "players": [
      { "battlefield": ["Ebon Praetor", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "advance_to": "Upkeep" },
      { "activate": "Ebon Praetor", "answers": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ebon Praetor": [5, 5] }
    }
  },
  {
    "name": "only once each turn and only during your upkeep",
    "players": [
      { "battlefield": ["Ebon Praetor", "Derelor", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "advance_to": "Upkeep" },
      { "activate": "Ebon Praetor", "answers": ["Derelor"] },
      { "resolve": true },
      { "activate": "Ebon Praetor", "answers": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "pt": { "Ebon Praetor": [6, 5] }
    }
  },
  {
    "name": "not during the main phase",
    "players": [
      { "battlefield": ["Ebon Praetor", "Derelor"] },
      {}
    ],
    "steps": [
      { "activate": "Ebon Praetor", "answers": ["Derelor"], "illegal": true }
    ],
    "expect": {
      "pt": { "Ebon Praetor": [5, 5] }
    }
  }
]
