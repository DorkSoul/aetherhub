[
  { "name": "prevents all damage to a creature with power 5 or greater",
    "players": [ { "hand": ["Lightning Strike"], "battlefield": ["Godtoucher", "Plains", "Plains", "Mountain", "Mountain"] },
                 { "battlefield": ["Arc Runner"] } ],
    "steps": [ { "activate": "Godtoucher", "ability": 0, "targets": ["Arc Runner"] }, { "resolve": true },
               { "cast": "Lightning Strike", "targets": ["Arc Runner"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Arc Runner"] } ] } },
  { "name": "no legal target below power 5",
    "players": [ { "battlefield": ["Godtoucher", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Godtoucher", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: the target is checked again on resolution; power dropping below 5 in response makes the ability fizzle",
    "players": [ { "hand": ["Lightning Strike"], "battlefield": ["Godtoucher", "Plains", "Plains", "Mountain", "Mountain"] },
                 { "hand": ["Disfigure"], "battlefield": ["Craw Wurm", "Swamp"] } ],
    "steps": [ { "activate": "Godtoucher", "ability": 0, "targets": ["Craw Wurm"] },
               { "player": 1, "cast": "Disfigure", "targets": ["Craw Wurm"] },
               { "pass": true, "player": 0 }, { "pass": true, "player": 1 },
               { "resolve": true },
               { "cast": "Lightning Strike", "targets": ["Craw Wurm"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Craw Wurm", "Disfigure"] } ] } },
  { "name": "ruling: once resolved the prevention keeps applying when the power later drops below 5",
    "players": [ { "hand": ["Lightning Strike"], "battlefield": ["Godtoucher", "Plains", "Plains", "Mountain", "Mountain"] },
                 { "hand": ["Disfigure"], "battlefield": ["Craw Wurm", "Swamp"] } ],
    "steps": [ { "activate": "Godtoucher", "ability": 0, "targets": ["Craw Wurm"] }, { "resolve": true },
               { "pass": true, "player": 0 },
               { "player": 1, "cast": "Disfigure", "targets": ["Craw Wurm"] }, { "resolve": true },
               { "cast": "Lightning Strike", "targets": ["Craw Wurm"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Craw Wurm"], "graveyard": ["Disfigure"] } ], "pt": { "Craw Wurm": [4, 2] } } }
]
