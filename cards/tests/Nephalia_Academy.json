    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Glimpse the Unthinkable", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": ["Forest", "Island"],
          "hand": []
        },
        {}
      ]
