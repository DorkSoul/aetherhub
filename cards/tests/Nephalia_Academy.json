[
  {
    "name": "opponent's spell discards your card: put on top of library instead",
    "players": [
      {
        "hand": ["Island"],
        "battlefield": ["Nephalia Academy"]
      },
      {
        "hand": ["Mind Rot"],
        "battlefield": ["Swamp", "Swamp", "Swamp"]
      }
    ],
    "steps": [
