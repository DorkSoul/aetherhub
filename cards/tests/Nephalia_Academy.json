  {
    "name": "ruling: milling is not discarding; milled cards go to the graveyard, not back on top",
    "players": [
      {
        "battlefield": ["Nephalia Academy"],
        "library": ["Forest", "Island"]
      },
      {
        "hand": ["Glimpse the Unthinkable"],
