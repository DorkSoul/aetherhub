      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        {
          "hand": [],
          "library_count": 21,
          "graveyard": []
        },
        {}
      ]
    }
  },
  {
    "name": "declining: the discarded card goes to the graveyard",
    "players": [
      {
        "hand": ["Island"],
        "battlefield": ["Nephalia Academy"]
      },
      {
        "hand": ["Mind Rot"],
        "battlefield": ["Swamp", "Swamp", "Swamp"]
      }
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        {
          "hand": [],
          "graveyard": ["Island"]
        },
        {}
      ]
    }
  },
  {
    "name": "a card an opponent of the Academy's controller discards is not affected",
    "players": [
      {
        "hand": ["Mind Rot"],
        "battlefield": ["Nephalia Academy", "Swamp", "Swamp", "Swamp"]
      },
      {
        "hand": ["Island", "Forest"]
      }
    ],
    "steps": [
      { "cast": "Mind Rot", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand": [],
          "graveyard": ["Island", "Forest"]
        }
      ]
    }
  },
  {
    "name": "ruling: discarding by an opponent's choice (Mind Rot, you pick two) uses the Academy on each chosen card",
    "players": [
      {
        "hand": ["Island", "Forest", "Swamp"],
        "battlefield": ["Nephalia Academy"]
      },
      {
        "hand": ["Mind Rot"],
        "battlefield": ["Swamp", "Swamp", "Swamp"]
      }
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "resolve": true, "answers": [["Island", "Forest"], true, true] }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Swamp"],
          "graveyard": []
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a card put on top by the Academy is still discarded, so Megrim triggers",
    "players": [
      {
        "hand": ["Island"],
        "battlefield": ["Nephalia Academy"]
      },
      {
        "hand": ["Mind Rot"],
        "battlefield": ["Megrim", "Swamp", "Swamp", "Swamp"]
      }
    ],
    "steps": [
      { "advance_to": "End" },
      { "pass": true },
      { "advance_to": "Main1" },
      { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        {
          "hand": [],
          "life": 18,
          "library_top": ["Island"]
        },
        {}
      ]
