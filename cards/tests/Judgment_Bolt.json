      { "hand": ["Judgment Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Bonesplitter", "Short Sword"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Judgment Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
