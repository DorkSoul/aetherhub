    }
  },
  { "name": "with no Equipment only the creature is damaged",
    "players": [
      { "hand": ["Judgment Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Judgment Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20, "graveyard": ["Hill Giant"] } ]
    }
  },
  { "name": "ruling: X is counted as Judgment Bolt resolves: Equipment destroyed in response leaves the controller undamaged",
    "players": [
      { "hand": ["Judgment Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Bonesplitter"] },
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Judgment Bolt", "targets": ["Hill Giant"] },
      { "pass": true },
      { "cast": "Disenchant", "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Bonesplitter", "Judgment Bolt"] }, { "life": 20, "graveyard": ["Hill Giant", "Disenchant"] } ]
    }
  }
