[
  {
    "name": "doubles power of target creature",
    "players": [
      {
        "hand": [
          "Unleash Fury"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Unleash Fury",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          4,
          2
        ]
      }
    }
  },
  {
    "name": "works on an opponent's creature; toughness unchanged",
    "players": [
      {
        "hand": [
          "Unleash Fury"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Unleash Fury",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Serra Angel": [
          8,
          4
        ]
      }
    }
  },
  {"name": "ruling: the doubled amount is fixed when the effect begins (later pumps do not change it)",
   "players": [{"hand": ["Unleash Fury", "Giant Growth"], "battlefield": ["Mountain", "Mountain", "Forest", "Grizzly Bears"]}, {}],
   "steps": [{"cast": "Unleash Fury", "targets": ["Grizzly Bears"]}, {"resolve": true}, {"cast": "Giant Growth", "targets": ["Grizzly Bears"]}, {"resolve": true}],
   "expect": {"pt": {"Grizzly Bears": [7, 5]}}},
  {"name": "ruling: doubling negative power gives -X/-0 for how far below 0 it is",
   "players": [{"hand": ["Unleash Fury", "Dismember"], "battlefield": ["Mountain", "Mountain", "Mountain", "Swamp", "Wall of Stone"]}, {}],
   "steps": [{"cast": "Dismember", "targets": ["Wall of Stone"]}, {"resolve": true}, {"cast": "Unleash Fury", "targets": ["Wall of Stone"]}, {"resolve": true}],
   "expect": {"pt": {"Wall of Stone": [-10, 3]}}}
]
