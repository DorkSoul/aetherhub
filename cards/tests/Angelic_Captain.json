[
  {
    "name": "gets +1/+1 for each other attacking Ally",
    "players": [
      {
        "battlefield": [
          "Angelic Captain",
          "Affa Protector"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Angelic Captain",
            "at": "p1"
          },
          {
            "card": "Affa Protector",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Angelic Captain": [
          5,
          4
        ]
      }
    }
  },
  {
    "name": "no bonus when attacking alone",
    "players": [
      {
        "battlefield": [
          "Angelic Captain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Angelic Captain",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Angelic Captain": [
          4,
          3
        ]
      }
    }
  },
  {
    "name": "ruling: the bonus is fixed on resolution even if the other attacking Ally dies in combat",
    "players": [
      { "battlefield": ["Angelic Captain", "Affa Protector"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [ { "card": "Angelic Captain", "at": "p1" }, { "card": "Affa Protector", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Affa Protector" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Affa Protector"] }, { "life": 15 } ],
      "pt": { "Angelic Captain": [5, 4] }
    }
  }
]
