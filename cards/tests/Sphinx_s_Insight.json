  {
    "name": "ruling: countered Insight gives no addendum life and no draw",
    "players": [
      { "hand": ["Sphinx's Insight"], "battlefield": ["Plains", "Island", "Forest", "Forest"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
