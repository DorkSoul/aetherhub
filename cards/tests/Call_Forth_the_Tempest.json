[
  { "name": "damage equals the total mana value of the other spells cast this turn",
    "players": [ { "hand": ["Call Forth the Tempest", "Shock", "Lightning Bolt"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Call Forth the Tempest" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"], "life": 15 } ] } },
  { "name": "with no other spell cast it deals no damage",
    "players": [ { "hand": ["Call Forth the Tempest"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Call Forth the Tempest" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: declined cascade: the exiled cards go to the bottom and nothing is cast",
    "players": [ { "hand": ["Call Forth the Tempest"], "library": ["Forest", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Call Forth the Tempest" }, { "resolve": true, "answers": [false, false] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Call Forth the Tempest"] }, { "battlefield_has": ["Hill Giant"], "life": 20 } ] } },
  { "name": "ruling: a spell cast by cascade counts toward the damage like an earlier spell",
    "players": [ { "hand": ["Lightning Bolt", "Call Forth the Tempest"], "library": ["Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Call Forth the Tempest" }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "life": 17 } ] } },
  { "name": "ruling: the second cascade looks below Call Forth's mana value 8, whatever the first cascade cast",
    "players": [ { "hand": ["Call Forth the Tempest"], "library": ["Grizzly Bears", "Elesh Norn, Grand Cenobite"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Call Forth the Tempest" }, { "resolve": true, "answers": [true, true] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Elesh Norn, Grand Cenobite"] }, {} ] } },
  { "name": "ruling: a countered Call Forth still lets its cascade cast a spell",
    "players": [ { "hand": ["Call Forth the Tempest"], "library": ["Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Call Forth the Tempest" }, { "pass": true }, { "cast": "Counterspell", "player": 1 }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Call Forth the Tempest"] }, { "graveyard": ["Counterspell"], "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: cascade skips a card with mana value 8 (not less than 8) and casts the next cheaper one",
    "players": [ { "hand": ["Call Forth the Tempest"], "library": ["Bosh, Iron Golem", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Call Forth the Tempest" }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Bosh, Iron Golem"] }, {} ] } }
]
