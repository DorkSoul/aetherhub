   "players": [ { "hand": ["Broadcast Takeover"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Mind Stone", "tapped": true }] }, { "battlefield": ["Sol Ring"] } ],
   "steps": [ { "cast": "Broadcast Takeover" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Sol Ring", "Mind Stone"] }, { "battlefield_lacks": ["Sol Ring"] } ], "tapped": { "Mind Stone": true } } }
