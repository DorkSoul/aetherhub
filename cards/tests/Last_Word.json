      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Last Word"] } ] }
  },
  {
    "name": "needs a spell to target",
    "players": [ {}, { "hand": ["Last Word"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
    "steps": [ { "pass": true }, { "cast": "Last Word", "player": 1, "illegal": true } ],
    "expect": { "players": [ {}, { "hand": ["Last Word"] } ] }
  }
