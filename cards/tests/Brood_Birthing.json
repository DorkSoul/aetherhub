[
  {
    "name": "without an Eldrazi Spawn creates one token",
    "players": [{ "hand": ["Brood Birthing"], "battlefield": ["Mountain", "Mountain"] }, {}],
    "steps": [{ "cast": "Brood Birthing" }, { "resolve": true }],
    "expect": {
      "players": [{ "battlefield": ["Mountain", "Mountain", "Eldrazi Spawn"], "graveyard": ["Brood Birthing"] }, {}]
    }
  },
  {
    "name": "with an Eldrazi Spawn creates three tokens",
    "players": [{ "hand": ["Brood Birthing", "Brood Birthing"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {}],
    "steps": [
      { "cast": "Brood Birthing" },
      { "resolve": true },
      { "cast": "Brood Birthing" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Eldrazi Spawn", "Eldrazi Spawn", "Eldrazi Spawn", "Eldrazi Spawn"],
          "graveyard": ["Brood Birthing", "Brood Birthing"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a single token is a 0/1 colorless Eldrazi Spawn",
    "players": [{ "hand": ["Brood Birthing"], "battlefield": ["Mountain", "Mountain"] }, {}],
    "steps": [{ "cast": "Brood Birthing" }, { "resolve": true }],
    "expect": {
      "players": [{ "battlefield_has": ["Eldrazi Spawn"] }, {}],
      "pt": { "Eldrazi Spawn": [0, 1] },
      "colors": { "Eldrazi Spawn": [] }
    }
  },
  {
    "name": "ruling: whether you control a Spawn is checked as Brood Birthing resolves (one killed in response leaves one token)",
    "players": [{ "hand": ["Brood Birthing", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain", "Eldrazi Spawn"] }, {}],
    "steps": [
      { "cast": "Brood Birthing" },
      { "cast": "Shock", "targets": ["Eldrazi Spawn"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield": ["Mountain", "Mountain", "Mountain", "Eldrazi Spawn"], "graveyard_has": ["Shock", "Brood Birthing"] }, {}]
    }
  }
]
