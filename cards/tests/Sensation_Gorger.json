[
  { "name": "kinship: revealed creature-type match makes each player discard hand and draw four",
    "players": [ { "battlefield": ["Sensation Gorger"], "hand": ["Lightning Bolt"], "library": ["Goblin Guide"] }, { "hand": ["Island", "Swamp"], "library": ["Forest"] } ],
    "start": "Untap",
    "steps": [ { "advance_to": "Main1", "answers": [true, true] } ],
    "expect": { "players": [ { "hand": ["Goblin Guide", "Forest", "Forest", "Forest"] }, { "hand_count": 4 } ] } },
  { "name": "kinship: a card with no shared creature type does not trigger the discard",
    "players": [ { "battlefield": ["Sensation Gorger"], "hand": ["Lightning Bolt"], "library": ["Grizzly Bears"] }, { "hand": ["Island"] } ],
    "start": "Untap",
    "steps": [ { "advance_to": "Main1", "answers": [true] } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "hand": ["Island"] } ] } },
  { "name": "kinship: declining to reveal a matching card changes nothing",
    "players": [ { "battlefield": ["Sensation Gorger"], "hand": ["Lightning Bolt"], "library": ["Goblin Guide"] }, { "hand": ["Island"] } ],
    "start": "Untap",
    "steps": [ { "advance_to": "Main1", "answers": [true, false] } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "hand": ["Island"] } ] } },
  { "name": "kinship: declining to look does nothing even with a matching card",
    "players": [ { "battlefield": ["Sensation Gorger"], "hand": ["Lightning Bolt"], "library": ["Goblin Guide"] }, { "hand": ["Island"] } ],
    "start": "Untap",
    "steps": [ { "advance_to": "Main1", "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "hand": ["Island"] } ] } },
 { "name": "ruling: kinship look without reveal: the looked-at card stays on top of the library",
   "players": [ { "battlefield": ["Sensation Gorger"], "hand": ["Lightning Bolt"], "library": ["Goblin Guide", "Forest"] }, { "hand": ["Island"] } ],
   "start": "Untap",
   "steps": [ { "advance_to": "Main1", "answers": [true, false] } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"], "library_top": ["Goblin Guide", "Forest"] }, { "hand": ["Island"] } ] } }
]
