[
  {
    "name": "shuffles two graveyard cards into the target player's library",
    "players": [
      { "hand": ["Stream of Consciousness"], "battlefield": ["Island", "Island"], "graveyard": ["Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Stream of Consciousness", "targets": ["p0", "Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Stream of Consciousness"], "library_count": 22 }, {}]
    }
  },
  {
    "name": "zero target cards: the player just shuffles",
    "players": [
      { "hand": ["Stream of Consciousness"], "battlefield": ["Island", "Island"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Stream of Consciousness", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Grizzly Bears", "Stream of Consciousness"], "library_count": 20 }, {}]
    }
  },
  {
    "name": "ruling: every target card becomes illegal in response: nothing moves and the spell still resolves",
    "players": [
      { "hand": ["Stream of Consciousness"], "battlefield": ["Island", "Island"], "graveyard": ["Grizzly Bears"] },
      { "battlefield": ["Tormod's Crypt"] }
    ],
    "steps": [
      { "cast": "Stream of Consciousness", "targets": ["p0", "Grizzly Bears"] },
      { "pass": true },
      { "activate": "Tormod's Crypt", "targets": ["p0"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Stream of Consciousness"], "exile": ["Grizzly Bears"], "library_count": 20 },
        { "graveyard_has": ["Tormod's Crypt"] }
      ]
    }
  }
]
