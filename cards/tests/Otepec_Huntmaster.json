[
  {
    "name": "Dinosaur spell costs {1} less",
    "players": [ { "hand": ["Ornery Dilophosaur"], "battlefield": ["Forest", "Forest", "Forest", "Otepec Huntmaster"] }, {} ],
    "steps": [ { "cast": "Ornery Dilophosaur" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ornery Dilophosaur"], "hand_count": 0 }, {} ] }
  },
  {
    "name": "non-Dinosaur spell is not reduced",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Otepec Huntmaster"] }, {} ],
    "steps": [ { "cast": "Hill Giant", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Hill Giant"] }, {} ] }
  },
  {
    "name": "tap: target Dinosaur gains haste",
    "players": [ { "battlefield": ["Otepec Huntmaster", { "name": "Ornery Dilophosaur", "sick": true }] }, {} ],
    "steps": [ { "activate": "Otepec Huntmaster", "targets": ["Ornery Dilophosaur"] }, { "resolve": true } ],
    "expect": { "keywords": { "Ornery Dilophosaur": ["Haste"] } }
  },
  {
    "name": "ruling: cost increase then reduction nets the printed cost (Lodestone Golem + Huntmaster)",
    "players": [ { "hand": ["Ornery Dilophosaur"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Otepec Huntmaster", "Lodestone Golem"] }, {} ],
    "steps": [ { "cast": "Ornery Dilophosaur" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ornery Dilophosaur"], "hand_count": 0 }, {} ] }
  },
  {
    "name": "ruling: cost increase still applies without the reduction (Lodestone Golem alone)",
    "players": [ { "hand": ["Ornery Dilophosaur"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Lodestone Golem"] }, {} ],
    "steps": [ { "cast": "Ornery Dilophosaur", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Ornery Dilophosaur"] }, {} ] }
  },
  {
    "name": "ruling: 'Dinosaur Stampede' is not a Dinosaur spell (the name is not the subtype)",
    "players": [ { "hand": ["Dinosaur Stampede"], "battlefield": ["Mountain", "Mountain", "Otepec Huntmaster"] }, {} ],
    "steps": [ { "cast": "Dinosaur Stampede", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Dinosaur Stampede"] }, {} ] }
  }
]
