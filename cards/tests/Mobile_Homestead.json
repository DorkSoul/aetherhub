  {
    "name": "ruling: a land put onto the battlefield by the trigger is not a land drop",
    "players": [
      { "hand": ["Plains"], "battlefield": ["Mobile Homestead", "Grizzly Bears"], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "play_land": "Plains" },
