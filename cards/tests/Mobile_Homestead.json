  {
    "name": "ruling: an attacking Vehicle keeps attacking after its Mount leaves",
    "players": [
      { "hand": ["Terror"], "battlefield": ["Mobile Homestead", "Bridled Bighorn", "Swamp", "Swamp", "Plains"], "library": ["Grizzly Bears"] },
