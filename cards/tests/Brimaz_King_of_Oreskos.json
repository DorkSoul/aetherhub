[
  {"name": "attacking: Brimaz's attack trigger creates an attacking Cat Soldier token",
   "players": [{"battlefield": ["Brimaz, King of Oreskos"]}, {}],
   "steps": [
    {"attack": [{"card": "Brimaz, King of Oreskos", "at": "p1"}]},
    {"advance_to": "Main2"}],
   "expect": {"players": [{"battlefield_has": ["Brimaz, King of Oreskos", "Cat Soldier 1-1 White Vigilance"]}, {}]}},
  {"name": "blocking: Brimaz's block trigger puts a Cat Soldier token blocking the attacker",
   "players": [{"battlefield": ["Grizzly Bears"]}, {"battlefield": ["Brimaz, King of Oreskos"]}],
   "steps": [
    {"attack": [{"card": "Grizzly Bears", "at": "p1"}]},
    {"block": [{"blocker": "Brimaz, King of Oreskos", "attacker": "Grizzly Bears"}]},
    {"advance_to": "Main2"}],
   "expect": {"players": [{"graveyard_has": ["Grizzly Bears"]}, {"battlefield_has": ["Brimaz, King of Oreskos"]}]}},
  {"name": "negative: a creature that is not Brimaz blocking makes no token",
   "players": [{"battlefield": ["Grizzly Bears"]}, {"battlefield": ["Brimaz, King of Oreskos", "Hill Giant"]}],
   "steps": [
    {"attack": [{"card": "Grizzly Bears", "at": "p1"}]},
    {"block": [{"blocker": "Hill Giant", "attacker": "Grizzly Bears"}]},
    {"advance_to": "Main2"}],
   "expect": {"players": [{}, {"battlefield_lacks": ["Cat Soldier 1-1 White Vigilance"]}]}},
  {"name": "ruling: a token that enters attacking does not trigger 'whenever a creature attacks' (Hellrider counts only Brimaz)",
   "players": [{"battlefield": ["Brimaz, King of Oreskos", "Hellrider"]}, {}],
   "steps": [
    {"attack": [{"card": "Brimaz, King of Oreskos", "at": "p1"}]},
    {"advance_to": "Main2"}],
   "expect": {"players": [{"battlefield_has": ["Cat Soldier 1-1 White Vigilance"]}, {"life": 15}]}}
]
