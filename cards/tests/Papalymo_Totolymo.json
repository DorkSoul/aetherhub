[
  { "name": "noncreature spell: 1 damage to each opponent and you gain 1",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Papalymo Totolymo", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Lightning Bolt"] }, { "life": 19, "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "creature spell does not trigger it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Papalymo Totolymo", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "opponent who lost life sacrifices its greatest-power creature",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Papalymo Totolymo", "sick": false }, "Mountain", "Plains", "Plains", "Plains", "Plains" ] },
                 { "battlefield": ["Grizzly Bears", "Serra Angel"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "activate": "Papalymo Totolymo", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Papalymo Totolymo", "Lightning Bolt"] }, { "life": 16, "graveyard": ["Serra Angel"] } ] } },
  { "name": "opponent who did not lose life sacrifices nothing",
    "players": [ { "battlefield": [ { "name": "Papalymo Totolymo", "sick": false }, "Plains", "Plains", "Plains", "Plains" ] },
                 { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "activate": "Papalymo Totolymo", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Papalymo Totolymo"] }, { "life": 20, "graveyard": [] } ] } },
  { "name": "ruling: the cast trigger resolves even though the Bolt is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Papalymo Totolymo", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Lightning Bolt"] }, { "life": 19, "graveyard": ["Counterspell"] } ] } }
]
