[
  {
    "name": "deals X to target and to itself, X = Elemental cards in your graveyard",
    "players": [
      {
        "battlefield": [
          "Sunflare Shaman",
          "Mountain",
          "Mountain"
        ],
        "graveyard": [
          "Air Elemental",
          "Air Elemental"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sunflare Shaman",
        "ability": 0,
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Sunflare Shaman"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "ruling: if the target becomes illegal, the ability does nothing and the Shaman takes no damage",
    "players": [
      { "battlefield": ["Sunflare Shaman", "Mountain", "Mountain"], "graveyard": ["Air Elemental", "Air Elemental"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Sunflare Shaman", "ability": 0, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Sunflare Shaman"], "life": 20 },
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: if the Shaman leaves before its ability resolves, it still deals damage and counts itself in the graveyard",
    "players": [
      { "battlefield": ["Sunflare Shaman", "Mountain", "Mountain"], "graveyard": ["Air Elemental", "Air Elemental"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Sunflare Shaman", "ability": 0, "targets": ["p1"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Sunflare Shaman"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Sunflare Shaman"] },
        { "life": 17, "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "no Elementals in graveyard means no damage",
    "players": [
      {
        "battlefield": [
          "Sunflare Shaman",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sunflare Shaman",
        "ability": 0,
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Sunflare Shaman"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  }
]
