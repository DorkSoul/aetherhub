[
  {
    "name": "targets itself: draws two, then discards two",
    "players": [
      { "battlefield": ["Cephalid Broker"], "library": ["Plains", "Island"] },
      {}
    ],
    "steps": [ { "activate": "Cephalid Broker", "targets": ["p0"] }, { "resolve": true } ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Plains", "Island"] },
        {}
      ]
    }
  },
  {
    "name": "targets an opponent: the opponent draws and discards",
    "players": [
      { "battlefield": ["Cephalid Broker"] },
      { "library": ["Plains", "Island"] }
    ],
    "steps": [ { "activate": "Cephalid Broker", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [
        { "hand_count": 0, "battlefield": ["Cephalid Broker"] },
        { "hand_count": 0, "graveyard": ["Plains", "Island"] }
      ]
    }
  },
  {
    "name": "ruling: the two draws happen before the two discards; the card in hand is kept",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Cephalid Broker"], "library": ["Plains", "Island"] },
      {}
    ],
    "steps": [ { "activate": "Cephalid Broker", "targets": ["p0"] }, { "resolve": true, "answers": [["Plains", "Island"]] } ],
    "expect": {
      "players": [
        { "hand": ["Lightning Bolt"], "graveyard": ["Plains", "Island"] },
        {}
      ]
    }
  }
]
