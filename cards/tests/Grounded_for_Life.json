[
  {
    "name": "costs {3} less to destroy a tapped creature",
    "players": [
      { "hand": ["Grounded for Life"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Grounded for Life", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grounded for Life"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "an untapped target costs the full {4}{W}",
    "players": [
      { "hand": ["Grounded for Life"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Grounded for Life", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "ruling: the reduced cost does not change mana value (Sound the Trumpets gets no recruit)",
    "players": [
      { "hand": ["Sound the Trumpets"], "battlefield": ["Island", "Island", "Island", { "name": "Grizzly Bears", "tapped": true }] },
      { "hand": ["Grounded for Life"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true, "player": 0 },
      { "cast": "Grounded for Life", "player": 1, "targets": ["Grizzly Bears"] },
      { "cast": "Sound the Trumpets", "targets": [{ "stack": "Grounded for Life" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Sound the Trumpets"], "hand_count": 0, "library_count": 20, "battlefield_has": ["Grizzly Bears"] },
        { "graveyard": ["Grounded for Life"] }
      ]
    }
  }
]
