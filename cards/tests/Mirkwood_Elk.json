[
  {
    "name": "ruling: an Elf card with no power (Heedless One in the graveyard) is returned and gains 0 life",
    "players": [{ "hand": ["Mirkwood Elk"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Heedless One"] }, {}],
    "steps": [
      { "cast": "Mirkwood Elk" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 20, "hand": ["Heedless One"], "graveyard": [], "battlefield_has": ["Mirkwood Elk"] }, {}] }
  },
  {
    "name": "ETB returns an Elf from graveyard to hand and gains life equal to its power",
    "players": [{ "hand": ["Mirkwood Elk"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Bloodbraid Elf"] }, {}],
    "steps": [
      { "cast": "Mirkwood Elk" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 23, "hand": ["Bloodbraid Elf"], "graveyard": [], "battlefield_has": ["Mirkwood Elk"] }, {}] }
  },
  {
    "name": "no Elf in graveyard: nothing returned and no life gained",
    "players": [{ "hand": ["Mirkwood Elk"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {}],
    "steps": [
      { "cast": "Mirkwood Elk" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 20, "hand": [], "graveyard": ["Grizzly Bears"] }, {}] }
  },
  {
    "name": "attack trigger returns an Elf from graveyard and gains life equal to its power",
    "players": [{ "battlefield": ["Mirkwood Elk"], "graveyard": ["Bloodbraid Elf"] }, {}],
    "steps": [
      { "attack": [{ "card": "Mirkwood Elk", "at": "p1" }], "targets": ["Bloodbraid Elf"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": { "players": [{ "life": 23, "hand": ["Bloodbraid Elf"], "graveyard": [] }, { "life": 14 }] }
  },
  {
    "name": "attack trigger with no Elf in your graveyard does nothing (opponent's Elf is not a target)",
    "players": [{ "battlefield": ["Mirkwood Elk"] }, { "graveyard": ["Bloodbraid Elf"] }],
    "steps": [
      { "attack": [{ "card": "Mirkwood Elk", "at": "p1" }] },
      { "advance_to": "End" }
    ],
    "expect": { "players": [{ "life": 20, "hand": [] }, { "life": 14, "graveyard": ["Bloodbraid Elf"] }] }
  }
]
