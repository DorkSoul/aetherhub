  {
    "name": "ruling: a flashback spell that is countered is still exiled, not put in the graveyard",
    "players": [
      { "graveyard": ["Increasing Ambition"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"], "library": ["Grizzly Bears", "Lightning Bolt"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
