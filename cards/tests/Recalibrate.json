[
  {
    "name": "bounces and draws when you discarded a card this turn",
    "players": [
      {
        "hand": ["Recall", "Recalibrate", "Forest"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Recall", "answers": [1] },
      { "resolve": true, "answers": [["Forest"]] },
      { "cast": "Recalibrate", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 2, "exile": ["Recall"] },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "no discard this turn: bounce only, no draw",
    "players": [
      { "hand": ["Recalibrate"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Recalibrate", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  }
]
