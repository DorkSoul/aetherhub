[
  { "name": "upkeep with an even number of permanents: opponent gains control of Chaos Lord",
    "players": [ { "battlefield": ["Chaos Lord", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Chaos Lord"] }, { "battlefield_has": ["Chaos Lord"] } ] } },
  { "name": "opponent permanents count toward the even total",
    "players": [ { "battlefield": ["Chaos Lord", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Chaos Lord"] }, { "battlefield_has": ["Chaos Lord"] } ] } },
  { "name": "upkeep with an odd number of permanents: Chaos Lord stays",
    "players": [ { "battlefield": ["Chaos Lord", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Chaos Lord"] }, { "battlefield_lacks": ["Chaos Lord"] } ] } },
  { "name": "attacks with haste when it did not enter this turn",
    "players": [ { "battlefield": ["Chaos Lord"] }, {} ],
    "steps": [ { "attack": [ { "card": "Chaos Lord", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 13 } ] } },
  { "name": "cannot attack the turn it enters the battlefield",
    "players": [ { "hand": ["Chaos Lord"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Chaos Lord" }, { "resolve": true }, { "attack": [ { "card": "Chaos Lord", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Chaos Lord"] }, { "life": 20 } ] } },
  { "name": "gained control this turn: Chaos Lord can attack as though it had haste",
    "players": [ { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Chaos Lord"] } ],
    "steps": [ { "cast": "Control Magic" }, { "resolve": true }, { "attack": [ { "card": "Chaos Lord", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 13 } ] } },
  { "name": "ruling: a control effect from Control Magic is superseded by Chaos Lord's new upkeep effect",
    "players": [ { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Chaos Lord"] } ],
    "steps": [ { "cast": "Control Magic", "targets": ["Chaos Lord"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Chaos Lord"] }, { "battlefield_has": ["Chaos Lord"] } ] } }
]
