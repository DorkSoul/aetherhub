[
  { "name": "tap: switches the target's power and toughness until end of turn",
    "players": [ { "battlefield": ["Merfolk Thaumaturgist", "Goblin Piker"] }, {} ],
    "steps": [ { "activate": "Merfolk Thaumaturgist", "targets": ["Goblin Piker"] }, { "resolve": true } ],
    "expect": { "pt": { "Goblin Piker": [1, 2] }, "tapped": { "Merfolk Thaumaturgist": true } } },
  { "name": "a tapped Thaumaturgist cannot activate again",
    "players": [ { "battlefield": ["Merfolk Thaumaturgist", "Goblin Piker"] }, {} ],
    "steps": [ { "activate": "Merfolk Thaumaturgist", "targets": ["Goblin Piker"] }, { "resolve": true },
               { "activate": "Merfolk Thaumaturgist", "targets": ["Goblin Piker"], "illegal": true } ],
    "expect": { "pt": { "Goblin Piker": [1, 2] } } },
  { "name": "summoning sick Thaumaturgist cannot use its tap ability",
    "players": [ { "battlefield": [ { "name": "Merfolk Thaumaturgist", "sick": true }, "Goblin Piker" ] }, {} ],
    "steps": [ { "activate": "Merfolk Thaumaturgist", "targets": ["Goblin Piker"], "illegal": true } ],
    "expect": { "pt": { "Goblin Piker": [2, 1] } } },
  { "name": "ruling: the switch applies after other effects: Rancor (+2/+0) after the switch still gives 1/4",
    "players": [ { "hand": ["Rancor"], "battlefield": ["Merfolk Thaumaturgist", "Goblin Piker", "Forest"] }, {} ],
    "steps": [ { "activate": "Merfolk Thaumaturgist", "targets": ["Goblin Piker"] }, { "resolve": true },
               { "cast": "Rancor", "targets": ["Goblin Piker"] }, { "resolve": true } ],
    "expect": { "pt": { "Goblin Piker": [1, 4] } } },
  { "name": "ruling: nonlethal damage becomes lethal when the switch lowers toughness (Bolt 3 on a 3/4, then switch to 4/3)",
    "players": [ { "battlefield": ["Merfolk Thaumaturgist", "Rowan Treefolk"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Rowan Treefolk"] }, { "resolve": true },
               { "activate": "Merfolk Thaumaturgist", "targets": ["Rowan Treefolk"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Rowan Treefolk"], "battlefield_has": ["Merfolk Thaumaturgist"] }, {} ] } },
  { "name": "ruling: switching twice returns the creature to its original power and toughness",
    "players": [ { "battlefield": ["Merfolk Thaumaturgist", "Merfolk Thaumaturgist", "Goblin Piker"] }, {} ],
    "steps": [ { "activate": "Merfolk Thaumaturgist", "targets": ["Goblin Piker"] }, { "resolve": true },
               { "activate": "Merfolk Thaumaturgist", "targets": ["Goblin Piker"] }, { "resolve": true } ],
    "expect": { "pt": { "Goblin Piker": [2, 1] } } }
]
