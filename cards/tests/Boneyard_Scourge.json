  },
  {
    "name": "declining the payment leaves it in the graveyard",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Swamp",
          "Swamp",
          "Acid-Spewer Dragon"
        ],
        "graveyard": [
          "Boneyard Scourge"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Acid-Spewer Dragon"
        ]
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Boneyard Scourge"
          ],
          "battlefield_lacks": [
            "Boneyard Scourge"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: if the card leaves the graveyard before the trigger resolves, it does not return",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Swamp", "Swamp", "Acid-Spewer Dragon", "Tormod's Crypt"],
        "graveyard": ["Boneyard Scourge"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Acid-Spewer Dragon"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "activate": "Tormod's Crypt", "targets": ["p0"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "exile": ["Acid-Spewer Dragon", "Boneyard Scourge", "Lightning Bolt", "Tormod's Crypt"], "battlefield_lacks": ["Boneyard Scourge"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Scourge that dies together with another Dragon does not trigger",
    "players": [
      {
        "hand": ["Damnation"],
        "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Boneyard Scourge", "Acid-Spewer Dragon"]
      },
      {}
    ],
    "steps": [
      { "cast": "Damnation" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Acid-Spewer Dragon", "Boneyard Scourge", "Damnation"], "battlefield_lacks": ["Boneyard Scourge"] },
        {}
      ]
    }
  }
]
