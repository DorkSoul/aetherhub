[
  {
    "name": "pay 1B when another Dragon dies to return from the graveyard",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Swamp",
          "Swamp",
          "Acid-Spewer Dragon"
        ],
        "graveyard": [
          "Boneyard Scourge"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Acid-Spewer Dragon"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Boneyard Scourge"
          ]
        },
        {}
      ]
