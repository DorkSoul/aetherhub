[
  {
    "name": "enters: creates a 0/4 white Wall token",
    "players": [
      { "hand": ["Builder's Talent"], "battlefield": ["Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Builder's Talent" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Wall 0-4 White Defender"] } ],
      "pt": { "Wall 0-4 White Defender": [0, 4] },
      "counters": { "Builder's Talent": { "level": 1 } }
    }
  },
  {
    "name": "level 2 ability (W) gains level 2 at sorcery speed",
    "players": [
      { "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 1 } }, "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Builder's Talent", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Builder's Talent": { "level": 2 } }
    }
  },
  {
    "name": "level 3 ability is not activatable at level 1",
    "players": [
      { "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 1 } }, "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Builder's Talent", "ability": 1, "illegal": true }
    ],
    "expect": {
      "counters": { "Builder's Talent": { "level": 1 } }
    }
  },
  {
    "name": "level 2: noncreature nonland permanent entering puts +1/+1 counter on your creature",
    "players": [
      { "hand": ["Sol Ring"], "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 2 } }, "Grizzly Bears", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "level 2: a creature entering does not trigger the counter ability",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 2 } }, "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "level 3: returns a noncreature nonland card from graveyard to battlefield",
    "players": [
      { "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 2 } }, "Plains", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Sol Ring"] },
      {}
    ],
    "steps": [
      { "activate": "Builder's Talent", "ability": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Builder's Talent": { "level": 3 } },
      "players": [ { "battlefield_has": ["Sol Ring"], "graveyard_has": [] } ]
    }
  },
  {
    "name": "ruling: a level 2 Class cannot gain level 2 again",
    "players": [
      { "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 2 } }, "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Builder's Talent", "ability": 0, "illegal": true }
    ],
    "expect": {
      "counters": { "Builder's Talent": { "level": 2 } }
    }
  },
  {
    "name": "ruling: at level 1 the level 2 counter ability is not yet present",
    "players": [
      {
        "hand": ["Sol Ring"],
        "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 1 } }, "Grizzly Bears", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: a level 3 Class keeps the level 2 counter ability",
    "players": [
      {
        "hand": ["Sol Ring"],
        "battlefield": [{ "name": "Builder's Talent", "counters": { "level": 3 } }, "Grizzly Bears", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
