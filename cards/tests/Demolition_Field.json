    ],
    "illegal": true
   }
  ]
 },
 {
  "name": "ruling: controller of an indestructible land still searches",
  "players": [
   {
    "battlefield": ["Demolition Field", "Mountain", "Mountain"],
    "library": ["Plains"]
   },
   {
    "battlefield": ["Darksteel Citadel"],
    "library": ["Island"]
   }
  ],
  "steps": [
   { "activate": "Demolition Field", "ability": 0, "targets": ["p1:Darksteel Citadel"] },
   { "resolve": true, "answers": ["Island", "Plains"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Plains", "Mountain"], "battlefield_lacks": ["Demolition Field"], "graveyard_has": ["Demolition Field"] },
    { "battlefield_has": ["Darksteel Citadel", "Island"] }
   ]
  }
 },
 {
  "name": "ruling: if the target became illegal, neither player searches",
  "players": [
   {
    "battlefield": ["Demolition Field", "Mountain", "Mountain"],
    "library": ["Plains"]
   },
   {
    "battlefield": ["Darkslick Shores", "Strip Mine"],
    "library": ["Island"]
   }
  ],
  "steps": [
   { "activate": "Demolition Field", "ability": 0, "targets": ["p1:Darkslick Shores"] },
   { "activate": "Strip Mine", "player": 1, "ability": 0, "targets": ["p1:Darkslick Shores"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Mountain", "Mountain"], "library_count": 1, "graveyard_has": ["Demolition Field"] },
    { "battlefield": [], "library_count": 1, "graveyard_has": ["Darkslick Shores", "Strip Mine"] }
   ]
  }
 }
]