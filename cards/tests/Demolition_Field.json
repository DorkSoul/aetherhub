[
 {
  "name": "destroys nonbasic land; both players fetch a basic",
  "players": [
   {
    "battlefield": [
     "Demolition Field",
     "Mountain",
     "Mountain"
    ],
    "library": [
     "Plains",
     "Forest"
    ]
   },
   {
    "battlefield": [
     "Darkslick Shores"
    ],
    "library": [
     "Island",
     "Swamp"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Demolition Field",
    "ability": 0,
    "targets": [
     "p1:Darkslick Shores"
    ]
   },
   {
    "resolve": true,
    "answers": [
     "Island",
     "Plains"
    ]
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Plains",
      "Mountain"
     ],
     "battlefield_lacks": [
      "Demolition Field"
     ],
     "graveyard_has": [
      "Demolition Field"
     ]
    },
    {
     "battlefield": [
      "Island"
     ],
     "graveyard": [
      "Darkslick Shores"
     ]
    }
   ]
  }
 },
 {
  "name": "cannot target a basic land",
  "players": [
   {
    "battlefield": [
     "Demolition Field",
     "Mountain",
     "Mountain"
    ]
   },
   {
    "battlefield": [
     "Forest"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Demolition Field",
    "ability": 0,
    "targets": [
     "p1:Forest"
    ],
    "illegal": true
   }
  ]
 },
 {
  "name": "cannot target own nonbasic land",
