[
  {
    "name": "ETB taps the creature and deals its power to you",
    "players": [{ "hand": ["Bind the Monster"], "battlefield": ["Island"] }, { "battlefield": ["Hill Giant"] }],
    "steps": [{ "cast": "Bind the Monster", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true }],
    "expect": {
      "tapped": { "Hill Giant": true },
      "attached": { "Bind the Monster": "Hill Giant" },
      "players": [{ "life": 17 }, {}]
    }
  },
  {
    "name": "an already tapped creature still deals damage to you",
    "players": [{ "hand": ["Bind the Monster"], "battlefield": ["Island"] }, { "battlefield": [{ "name": "Hill Giant", "tapped": true }] }],
    "steps": [{ "cast": "Bind the Monster", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true }],
    "expect": {
      "players": [{ "life": 17 }, {}]
    }
  },
  { "name": "enchanted creature does not untap during its controller's untap step",
    "players": [ { "hand": ["Bind the Monster"], "battlefield": ["Island"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Bind the Monster", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Hill Giant": true } } },
  {
    "name": "ruling: ETB damage uses the enchanted creature's current power (pumped by landfall) as it resolves",
    "players": [
      { "hand": ["Bind the Monster", "Forest"], "battlefield": ["Adventuring Gear", "Forest", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Adventuring Gear", "ability": 0 },
      { "resolve": true },
      { "play_land": "Forest" },
      { "resolve": true },
      { "cast": "Bind the Monster", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 16 }, {}],
      "tapped": { "Grizzly Bears": true }
    }
  }
]
