[
  {
    "name": "no Villain: steal, untap, haste attack; back at end of turn",
    "players": [
      { "hand": ["Evil's Thrall"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Evil's Thrall", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "no Villain: control returns in the next turn",
    "players": [
      { "hand": ["Evil's Thrall"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Evil's Thrall", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "Villain with greater MV: control lasts through the opponent's turn",
    "players": [
      { "hand": ["Evil's Thrall"], "battlefield": ["Mountain", "Mountain", "Mountain", "A.I.M. Scientists"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Evil's Thrall", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "A.I.M. Scientists"] },
        { "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "Villain with greater MV: control ends at the end of my next turn",
    "players": [
      { "hand": ["Evil's Thrall"], "battlefield": ["Mountain", "Mountain", "Mountain", "A.I.M. Scientists"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Evil's Thrall", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "Villain with equal MV is not greater: control ends at end of turn",
    "players": [
      { "hand": ["Evil's Thrall"], "battlefield": ["Mountain", "Mountain", "Mountain", "A.I.M. Scientists"] },
      { "battlefield": ["Pillarfield Ox"] }
    ],
    "steps": [
      { "cast": "Evil's Thrall", "targets": ["Pillarfield Ox"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Pillarfield Ox"] },
        { "battlefield_has": ["Pillarfield Ox"] }
      ]
    }
  }
]
