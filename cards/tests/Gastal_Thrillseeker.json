[
 { "name": "enters: 1 damage to the opponent and 1 life for me",
   "players": [ { "hand": ["Gastal Thrillseeker"], "battlefield": ["Swamp", "Mountain"] }, {} ],
   "steps": [ { "cast": "Gastal Thrillseeker" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 21 }, { "life": 19 } ] } },
 { "name": "not max speed: no haste, so no attack on the turn it enters",
   "players": [ { "hand": ["Gastal Thrillseeker"], "battlefield": ["Swamp", "Mountain"] }, {} ],
   "steps": [ { "cast": "Gastal Thrillseeker" }, { "resolve": true }, { "attack": [{ "card": "Gastal Thrillseeker", "at": "p1" }], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 19 } ] } },
 { "name": "max speed: haste lets it attack the turn it enters",
   "players": [ { "hand": ["Gastal Thrillseeker"], "battlefield": ["Swamp", "Mountain"] }, {} ],
   "steps": [ { "cast": "Gastal Thrillseeker" }, { "resolve": true }, { "set_speed": 4 }, { "attack": [{ "card": "Gastal Thrillseeker", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 17 } ] } },
 { "name": "start your engines: speed starts at 1, then its ETB damage to the opponent raises it to 2",
   "players": [ { "hand": ["Gastal Thrillseeker"], "battlefield": ["Swamp", "Mountain"] }, {} ],
   "steps": [ { "cast": "Gastal Thrillseeker" }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 2 }, { "life": 19 } ] } },
 { "name": "max speed: has Deathtouch and Haste",
   "players": [ { "hand": ["Gastal Thrillseeker"], "battlefield": ["Swamp", "Mountain"] }, {} ],
   "steps": [ { "cast": "Gastal Thrillseeker" }, { "resolve": true }, { "set_speed": 4 } ],
   "expect": { "keywords": { "Gastal Thrillseeker": ["Deathtouch", "Haste"] } } },
 { "name": "max speed: deathtouch kills the Hill Giant that blocks it",
   "players": [ { "battlefield": [ { "name": "Gastal Thrillseeker", "sick": false } ] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "set_speed": 4 }, { "attack": [ { "card": "Gastal Thrillseeker", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Gastal Thrillseeker" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "battlefield_lacks": ["Hill Giant"] } ] } },
 { "name": "ruling: speed is tracked per player, so the opponent stays at speed 0",
   "players": [ { "hand": ["Gastal Thrillseeker"], "battlefield": ["Swamp", "Mountain"] }, {} ],
   "steps": [ { "cast": "Gastal Thrillseeker" }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 2 }, { "speed": 0 } ] } },
 { "name": "ruling: speed 3 is not max speed, so no deathtouch and the Hill Giant survives the block",
   "players": [ { "battlefield": [ { "name": "Gastal Thrillseeker", "sick": false } ] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "set_speed": 3 }, { "attack": [ { "card": "Gastal Thrillseeker", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Gastal Thrillseeker" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard_has": ["Gastal Thrillseeker"] }, { "battlefield_has": ["Hill Giant"] } ] } }
