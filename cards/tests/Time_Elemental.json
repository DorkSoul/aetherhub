      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Time Elemental"] },
        { "battlefield": [] }
      ]
    }
  },
  {
    "name": "an Aura that isn't enchanted can be returned to its owner's hand",
    "players": [
      {
        "hand": ["Control Magic"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Time Elemental"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Control Magic", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Time Elemental", "targets": ["Control Magic"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Control Magic"], "battlefield_has": ["Time Elemental"] },
        {}
      ]
    }
  },
  {
    "name": "blocks: sacrificed at end of combat and deals 5 damage to its controller",
    "players": [
      { "battlefield": ["Time Elemental"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Time Elemental", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
