  {
    "name": "ruling: an enchanted permanent can't be targeted by the bounce ability",
    "players": [
      { "hand": ["Pacifism"], "battlefield": ["Plains", "Island", "Island", "Island", "Island", "Island", "Time Elemental"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Pacifism", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Time Elemental", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Time Elemental", "Pacifism"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "attached": { "Pacifism": "Grizzly Bears" }
    }
  }
