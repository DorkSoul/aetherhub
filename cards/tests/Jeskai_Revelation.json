  { "name": "ruling: a spell returned to hand leaves the stack without being countered, even an uncounterable spell",
    "players": [ { "hand": ["Carnage Tyrant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Jeskai Revelation"], "battlefield": ["Island", "Mountain", "Plains", "Forest", "Forest", "Forest", "Forest"] } ],
    "steps": [ { "cast": "Carnage Tyrant" }, { "pass": true }, { "cast": "Jeskai Revelation", "player": 1, "targets": [ { "stack": "Carnage Tyrant" }, "p0" ] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 16, "hand": ["Carnage Tyrant"] }, { "life": 24, "graveyard": ["Jeskai Revelation"] } ] } }
