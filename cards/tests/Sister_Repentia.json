[
  { "name": "martyrdom: when it dies, gain 2 life and draw two cards",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Sister Repentia"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Sister Repentia"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Sister Repentia", "Lightning Bolt"], "life": 22, "hand_count": 2 }, {} ] } },
  { "name": "martyrdom does not trigger while it stays on the battlefield",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Sister Repentia"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sister Repentia"], "life": 20, "hand_count": 0 }, { "life": 17 } ] } },
  { "name": "miracle: first card drawn this turn is cast for {W}{B}",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Plains", "Swamp"], "library": ["Sister Repentia", "Forest"] }, {} ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sister Repentia"], "graveyard_has": ["Tormenting Voice"] }, {} ] } },
  { "name": "miracle is declined: Sister Repentia stays in hand",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Plains", "Swamp"], "library": ["Sister Repentia", "Forest"] }, {} ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Sister Repentia", "Forest"], "battlefield_lacks": ["Sister Repentia"] }, {} ] } },
  { "name": "ruling: only the first card drawn this turn can be revealed for miracle",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Plains", "Swamp"], "library": ["Forest", "Sister Repentia"] }, {} ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "battlefield_lacks": ["Sister Repentia"] }, {} ] } }
]
