[
  {
    "name": "creates three 1/1 Boar tokens",
    "players": [
      { "hand": ["Wolf's Quarry"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Wolf's Quarry" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Wolf's Quarry"], "battlefield_has": ["Boar 1-1", "Boar 1-1", "Boar 1-1"] },
        {}
      ],
      "pt": { "Boar 1-1": [1, 1] }
    }
  },
  {
    "name": "a Boar that dies creates a Food",
    "players": [
      { "battlefield": ["Boar 1-1"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Boar 1-1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Food"], "battlefield_lacks": ["Boar 1-1"] },
        { "graveyard": ["Shock"] }
      ]
    }
  },
  {
    "name": "ruling: a Food sacrificed for its own ability can't also pay Maraleaf Rider's cost",
    "players": [
      { "battlefield": ["Forest", "Forest", "Maraleaf Rider", "Food"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Food", "ability": 0 },
      { "resolve": true },
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "battlefield_has": ["Maraleaf Rider"], "battlefield_lacks": ["Food"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
