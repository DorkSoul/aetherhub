[
  {
    "name": "enters tapped with one opponent",
    "players": [ { "hand": ["Vault of Champions"] }, {} ],
    "steps": [ { "play_land": "Vault of Champions" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Vault of Champions"] }, {} ],
      "tapped": { "Vault of Champions": true }
    }
  },
  {
    "name": "enters untapped with two opponents",
    "players": [ { "hand": ["Vault of Champions"] }, {}, {} ],
    "steps": [ { "play_land": "Vault of Champions" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Vault of Champions"] }, {}, {} ],
      "tapped": { "Vault of Champions": false }
    }
  },
  {
    "name": "ruling: land put onto the battlefield by an effect stays tapped with two opponents",
    "players": [ { "hand": ["Arboreal Grazer", "Vault of Champions"], "battlefield": ["Forest"] }, {}, {} ],
    "steps": [ { "cast": "Arboreal Grazer" }, { "resolve": true, "answers": ["Vault of Champions"] } ],
    "expect": {
      "players": [ { "battlefield_has": ["Vault of Champions", "Arboreal Grazer"] }, {}, {} ],
      "tapped": { "Vault of Champions": true }
    }
  },
  {
    "name": "ruling: counts current opponents; enters tapped once one of two has conceded",
    "players": [ { "hand": ["Vault of Champions"] }, {}, {} ],
    "steps": [ { "concede": true, "player": 2 }, { "play_land": "Vault of Champions" } ],
    "expect": { "tapped": { "Vault of Champions": true } }
  }
]
