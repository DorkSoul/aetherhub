[
  {
    "name": "returns the creature card with the greatest power from your graveyard",
    "players": [
      {
        "hand": ["Desecrator Hag"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Grizzly Bears", "Hill Giant", "Llanowar Elves"]
      },
      {}
    ],
    "steps": [
      { "cast": "Desecrator Hag" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Desecrator Hag"],
          "hand": ["Hill Giant"],
          "graveyard_has": ["Grizzly Bears", "Llanowar Elves"]
        },
        {}
      ]
    }
  },
  {
    "name": "opponent's creature cards in their graveyard do not count",
    "players": [
      {
        "hand": ["Desecrator Hag"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Grizzly Bears"]
      },
      {
        "graveyard": ["Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Desecrator Hag" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Grizzly Bears"]
        },
        {
          "graveyard_has": ["Hill Giant"]
        }
      ]
    }
  },
  {
    "name": "ruling: tied for greatest power, the controller chooses which card returns",
    "players": [
      {
        "hand": ["Desecrator Hag"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Grizzly Bears", "Savannah Lions"]
      },
      {}
    ],
    "steps": [
      { "cast": "Desecrator Hag" },
      { "resolve": true, "answers": ["Savannah Lions"] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Desecrator Hag"],
          "hand": ["Savannah Lions"],
          "graveyard_has": ["Grizzly Bears"]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: tied for greatest power, the other tied card can be chosen instead",
    "players": [
      {
        "hand": ["Desecrator Hag"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Grizzly Bears", "Savannah Lions"]
      },
      {}
    ],
    "steps": [
      { "cast": "Desecrator Hag" },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Desecrator Hag"],
          "hand": ["Grizzly Bears"],
          "graveyard_has": ["Savannah Lions"]
        },
        {}
      ]
    }
  }
