[
  {
    "name": "enters with four -1/-1 counters",
    "players": [ { "hand": ["Voracious Hatchling"], "battlefield": ["Plains", "Plains", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Voracious Hatchling" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Voracious Hatchling": [2, 2] }, "counters": { "Voracious Hatchling": { "m1m1": 4 } } }
  },
  {
    "name": "casting a white spell removes a -1/-1 counter",
    "players": [ { "hand": ["Savannah Lions"], "battlefield": [ "Plains", { "name": "Voracious Hatchling", "sick": false, "counters": { "m1m1": 4 } } ] }, {} ],
    "steps": [ { "cast": "Savannah Lions" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Voracious Hatchling": [3, 3] }, "counters": { "Voracious Hatchling": { "m1m1": 3 } } }
  },
  {
    "name": "casting a black spell removes a -1/-1 counter",
    "players": [ { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", { "name": "Voracious Hatchling", "sick": false, "counters": { "m1m1": 4 } }] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "cast": "Doom Blade" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Voracious Hatchling": [3, 3] }, "counters": { "Voracious Hatchling": { "m1m1": 3 } } }
  },
  {
    "name": "casting a red spell does not remove a -1/-1 counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Voracious Hatchling", "sick": false, "counters": { "m1m1": 4 } }] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Voracious Hatchling": [2, 2] }, "counters": { "Voracious Hatchling": { "m1m1": 4 } } }
  },
  {
    "name": "ruling: a white and black spell removes two -1/-1 counters",
    "players": [
      { "hand": ["Vindicate"], "battlefield": ["Plains", "Swamp", "Swamp", { "name": "Voracious Hatchling", "sick": false, "counters": { "m1m1": 4 } }] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Vindicate", "targets": ["Llanowar Elves"] },
      { "pass": true }, { "pass": true, "player": 1 },
      { "pass": true }, { "pass": true, "player": 1 },
      { "pass": true }, { "pass": true, "player": 1 }
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Voracious Hatchling": [4, 4] }, "counters": { "Voracious Hatchling": { "m1m1": 2 } } }
  },
  {
    "name": "ruling: with no -1/-1 counters left, the extra removal does nothing",
    "players": [
      { "hand": ["Vindicate"], "battlefield": ["Plains", "Swamp", "Swamp", { "name": "Voracious Hatchling", "sick": false, "counters": { "m1m1": 1 } }] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Vindicate", "targets": ["Llanowar Elves"] },
      { "pass": true }, { "pass": true, "player": 1 },
      { "pass": true }, { "pass": true, "player": 1 },
      { "pass": true }, { "pass": true, "player": 1 }
    ],
    "expect": { "players": [ {}, {} ], "pt": { "Voracious Hatchling": [6, 6] } }
  }
]
