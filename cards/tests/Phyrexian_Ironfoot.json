[
  {
    "name": "pay {1}{S} with snow lands to untap and attack",
    "players": [
      {
        "hand": [],
        "battlefield": [{ "name": "Phyrexian Ironfoot", "tapped": true }, "Snow-Covered Forest", "Snow-Covered Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Phyrexian Ironfoot", "ability": 0 },
      { "resolve": true },
      { "attack": [{ "card": "Phyrexian Ironfoot", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Phyrexian Ironfoot"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "non-snow mana cannot pay the {S} part",
    "players": [
      {
        "hand": [],
        "battlefield": [{ "name": "Phyrexian Ironfoot", "tapped": true }, "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Phyrexian Ironfoot", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Phyrexian Ironfoot"] },
        {}
      ]
    }
  },
  {
    "name": "stays tapped through my untap step",
    "players": [
      {
        "hand": [],
        "battlefield": [{ "name": "Phyrexian Ironfoot", "tapped": true }, "Snow-Covered Forest", "Snow-Covered Forest"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Phyrexian Ironfoot", "at": "p1" }], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Phyrexian Ironfoot"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "does not untap during my untap step",
    "players": [
      {
        "hand": [],
        "battlefield": [{ "name": "Phyrexian Ironfoot", "tapped": true }, "Snow-Covered Forest", "Snow-Covered Forest"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Phyrexian Ironfoot"] }, {} ],
      "tapped": { "Phyrexian Ironfoot": true }
    }
  }
]
