  {
    "name": "ruling: when your commander leaves the battlefield the lieutenant bonus stops immediately (7/7 becomes 5/5)",
    "commander": true,
    "players": [
      {
        "command": ["Savannah Lions"],
        "hand": ["Lightning Bolt"],
        "battlefield": ["Plains", "Mountain", "Stormsurge Kraken"]
