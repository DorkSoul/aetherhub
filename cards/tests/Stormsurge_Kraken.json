  {
    "name": "ruling: a commander in the command zone (not on the battlefield) does not enable lieutenant: 5/5",
    "commander": true,
    "players": [
      {
        "command": ["Savannah Lions"],
        "hand": ["Stormsurge Kraken"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island"]
