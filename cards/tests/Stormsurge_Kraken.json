      {}
    ],
    "steps": [
      { "cast": "Savannah Lions" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Lightning Bolt"] }, {} ],
      "pt": { "Stormsurge Kraken": [5, 5] }
    }
