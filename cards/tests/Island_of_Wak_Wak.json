[
  { "name": "sets a flier's base power to 0 but keeps toughness",
    "players": [ { "battlefield": ["Island of Wak-Wak"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "activate": "Island of Wak-Wak", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Serra Angel": [0, 4] } } },
  { "name": "a creature without flying is not a legal target",
    "players": [ { "battlefield": ["Island of Wak-Wak"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Island of Wak-Wak", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: base power is set to 0 (not -X/-0), so a pump resolved earlier still applies on top",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Island of Wak-Wak", "Serra Angel"] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Serra Angel"] }, { "resolve": true },
               { "activate": "Island of Wak-Wak", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Serra Angel": [3, 7] } } }
]
