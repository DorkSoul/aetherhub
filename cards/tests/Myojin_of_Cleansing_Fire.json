[
  {
    "name": "enters with a divinity counter when cast from hand",
    "players": [
      { "hand": ["Myojin of Cleansing Fire"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Cleansing Fire" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Cleansing Fire"] }, {} ],
      "counters": { "Myojin of Cleansing Fire": { "divinity": 1 } }
    }
  },
  {
    "name": "removing the counter destroys all other creatures",
    "players": [
      { "battlefield": [ { "name": "Myojin of Cleansing Fire", "counters": { "divinity": 1 } }, "Grizzly Bears" ] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Myojin of Cleansing Fire", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Myojin of Cleansing Fire"], "graveyard_has": ["Grizzly Bears"] },
        { "graveyard_has": ["Grizzly Bears", "Llanowar Elves"] }
      ],
      "counters": { "Myojin of Cleansing Fire": { "divinity": 0 } }
    }
  },
  {
    "name": "indestructible while it has a divinity counter: Bitter Triumph does not destroy it",
    "players": [ { "hand": ["Bitter Triumph"], "battlefield": ["Swamp", "Swamp", { "name": "Myojin of Cleansing Fire", "counters": { "divinity": 1 } }] }, {} ],
    "steps": [ { "cast": "Bitter Triumph", "targets": ["Myojin of Cleansing Fire"], "answers": [1] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Myojin of Cleansing Fire"], "graveyard_has": ["Bitter Triumph"] }, {} ], "counters": { "Myojin of Cleansing Fire": { "divinity": 1 } } }
  },
  {
    "name": "without a divinity counter Bitter Triumph destroys it",
    "players": [ { "hand": ["Bitter Triumph"], "battlefield": ["Swamp", "Swamp", "Myojin of Cleansing Fire"] }, {} ],
    "steps": [ { "cast": "Bitter Triumph", "targets": ["Myojin of Cleansing Fire"], "answers": [1] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Myojin of Cleansing Fire", "Bitter Triumph"] }, {} ] }
  },
  {
    "name": "ruling: cast from the command zone is not a cast from hand, so no divinity counter",
    "players": [
      { "command": ["Myojin of Cleansing Fire"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [ { "cast": "Myojin of Cleansing Fire" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Cleansing Fire"] }, {} ],
      "counters": { "Myojin of Cleansing Fire": { "divinity": 0 } }
    }
  }
]
