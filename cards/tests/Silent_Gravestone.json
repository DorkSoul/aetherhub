[
  {
    "name": "graveyard cards cannot be targeted",
    "players": [{ "hand": ["Raise Dead"], "graveyard": ["Grizzly Bears"], "battlefield": ["Silent Gravestone", "Swamp"] }, {}],
    "steps": [{ "cast": "Raise Dead", "targets": ["Grizzly Bears"], "illegal": true }],
    "expect": { "players": [{ "graveyard": ["Grizzly Bears"] }, {}] }
  },
  {
    "name": "{4},{T}: exile itself and every graveyard, draw a card",
    "players": [
      { "graveyard": ["Grizzly Bears"], "battlefield": ["Silent Gravestone", "Island", "Island", "Island", "Island"] },
      { "graveyard": ["Hill Giant"] }
    ],
    "steps": [{ "activate": "Silent Gravestone", "ability": 0 }, { "resolve": true }],
    "expect": { "players": [{ "exile": ["Silent Gravestone", "Grizzly Bears"], "hand_count": 1 }, { "exile": ["Hill Giant"] }] }
  },
  {
    "name": "ruling: Gravestone and graveyard cards stay in place until its ability resolves",
    "players": [
      { "graveyard": ["Grizzly Bears"], "battlefield": ["Silent Gravestone", "Island", "Island", "Island", "Island"] },
      { "graveyard": ["Hill Giant"] }
    ],
    "steps": [{ "activate": "Silent Gravestone", "ability": 0 }],
    "expect": { "players": [{ "battlefield_has": ["Silent Gravestone"], "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Hill Giant"] }] }
  },
  {
    "name": "ruling: non-targeting Extract from Darkness still takes a creature card from a graveyard under Gravestone",
    "players": [
      { "hand": ["Extract from Darkness"], "battlefield": ["Silent Gravestone", "Island", "Island", "Island", "Island", "Swamp"], "library": ["Island", "Island"] },
      { "graveyard": ["Hill Giant"], "library": ["Island", "Island"] }
    ],
    "steps": [{ "cast": "Extract from Darkness" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Hill Giant"] }, {}] }
  }
]
