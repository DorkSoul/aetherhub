[
  {
    "name": "enters the battlefield tapped",
    "players": [
      { "hand": ["Renegade Map"], "battlefield": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Renegade Map" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Renegade Map"] }, {} ],
      "tapped": { "Renegade Map": true }
    }
  },
  {
    "name": "tap and sacrifice: search for a basic land card into your hand",
    "players": [
      { "battlefield": ["Renegade Map"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Renegade Map", "ability": 0 },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": ["Renegade Map"] }, {} ]
    }
  },
  {
    "name": "cannot activate while tapped",
    "players": [
      { "battlefield": [{ "name": "Renegade Map", "tapped": true }], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Renegade Map", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Renegade Map"] }, {} ]
    }
  }
]
