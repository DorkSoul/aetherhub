[
  {
    "name": "tapping a Forest adds an extra G",
    "players": [
      {
        "battlefield": [
          "Groundchuck & Dirtbag",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Forest"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "G": 2
          }
        },
        {}
      ]
    }
  },
  {
    "name": "a Forest and a Swamp make G, then B and G",
    "players": [
      {
        "battlefield": [
          "Groundchuck & Dirtbag",
          "Forest",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Forest"
      },
      {
        "tap_for_mana": "Swamp"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "G": 3,
            "B": 1
          }
        },
        {}
      ]
    }
  },
  {
    "name": "a Plains taps for W and an extra G",
    "players": [
      {
        "battlefield": [
          "Groundchuck & Dirtbag",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Plains"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "W": 1,
            "G": 1
          }
        },
        {}
      ]
    }
  },
  {
    "name": "boundary: tapping a creature for mana (not a land) does not trigger it",
    "players": [ { "battlefield": ["Groundchuck & Dirtbag", "Llanowar Elves"] }, {} ],
    "steps": [ { "tap_for_mana": "Llanowar Elves", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ] }
  },
  {
    "name": "ruling: the trigger is a mana ability, so the extra G is in the pool with an empty stack",
    "players": [ { "battlefield": ["Groundchuck & Dirtbag", "Forest"] }, {} ],
    "steps": [ { "tap_for_mana": "Forest" } ],
    "expect": { "stack_empty": true, "players": [ { "pool": { "G": 2 } }, {} ] }
  }
]
