    "players": [ { "hand": ["Elemental Teachings"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Elemental Teachings" }, { "resolve": true, "answers": [["Plains"]] } ],
    "expect": { "players": [ { "graveyard_has": ["Elemental Teachings", "Plains"], "battlefield_lacks": ["Plains"] }, {} ] } },
  { "name": "ruling: finding two cards, both go to your graveyard and none enter the battlefield",
    "players": [ { "hand": ["Elemental Teachings"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Plains", "Swamp", "Grizzly Bears"] }, {} ],
