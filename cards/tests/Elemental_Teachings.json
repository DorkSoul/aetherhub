    "steps": [ { "cast": "Elemental Teachings" }, { "resolve": true, "answers": [["Forest", "Island", "Plains", "Swamp"], ["Forest", "Island"]] } ],
    "expect": { "players": [ { "graveyard_has": ["Elemental Teachings", "Forest", "Island"], "battlefield_has": ["Plains", "Swamp"], "battlefield_lacks": ["Island"] }, {} ], "tapped": { "Plains": true, "Swamp": true } } },
  { "name": "duplicate land names: only one Forest is found",
    "players": [ { "hand": ["Elemental Teachings"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Elemental Teachings" }, { "resolve": true, "answers": [["Forest", "Forest", "Island"]] } ],
    "expect": { "players": [ { "graveyard_has": ["Elemental Teachings", "Forest", "Island"], "battlefield_lacks": ["Island"] }, {} ] } },
