[
  { "name": "0: the chosen creature deals triple combat damage to an opponent",
    "players": [ { "battlefield": [ { "name": "Jeska, Thrice Reborn", "counters": { "loyalty": 3 } }, { "name": "Grizzly Bears", "sick": false } ] }, {} ],
    "steps": [ { "activate": "Jeska, Thrice Reborn", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 14 } ] } },
  { "name": "without the 0 ability the damage is normal",
    "players": [ { "battlefield": [ { "name": "Jeska, Thrice Reborn", "counters": { "loyalty": 3 } }, { "name": "Grizzly Bears", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
  { "name": "only the chosen creature is tripled",
    "players": [ { "battlefield": [ { "name": "Jeska, Thrice Reborn", "counters": { "loyalty": 3 } }, { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false } ] }, {} ],
    "steps": [ { "activate": "Jeska, Thrice Reborn", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 17 } ] } },
  { "name": "-X: X damage to each of up to three targets",
    "players": [ { "battlefield": [ { "name": "Jeska, Thrice Reborn", "counters": { "loyalty": 3 } } ] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "activate": "Jeska, Thrice Reborn", "ability": 1, "answers": [2], "targets": ["Grizzly Bears", "Hill Giant", "p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 18, "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "enters with a loyalty counter per commander cast from the command zone this game",
    "commander": true,
    "players": [ { "hand": ["Jeska, Thrice Reborn"], "command": ["Grizzly Bears"], "battlefield": ["Forest", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "cast": "Jeska, Thrice Reborn" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Jeska, Thrice Reborn", "Grizzly Bears"] }, {} ], "counters": { "Jeska, Thrice Reborn": { "loyalty": 1 } } } },
  { "name": "with no commander cast this game she enters with no loyalty and dies",
    "players": [ { "hand": ["Jeska, Thrice Reborn"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Jeska, Thrice Reborn" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Jeska, Thrice Reborn"] }, {} ] } },
  { "name": "ruling: casting her from the command zone as your commander counts for her loyalty",
    "commander": true,
    "players": [ { "command": ["Jeska, Thrice Reborn"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Jeska, Thrice Reborn" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Jeska, Thrice Reborn"] }, {} ], "counters": { "Jeska, Thrice Reborn": { "loyalty": 1 } } } }
]
