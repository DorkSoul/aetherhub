[
  { "name": "pumps by creature cards in your graveyard, once per turn",
    "players": [ { "battlefield": ["Graverobber Spider", "Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears", "Grizzly Bears", "Lightning Bolt"] }, {} ],
    "steps": [ { "activate": "Graverobber Spider", "ability": 0 }, { "resolve": true }, { "activate": "Graverobber Spider", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Graverobber Spider"] }, {} ], "pt": { "Graverobber Spider": [4, 6] } } },
  { "name": "counts only creature cards in your own graveyard",
    "players": [ { "battlefield": ["Graverobber Spider", "Swamp", "Forest", "Forest", "Forest"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Graverobber Spider", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Graverobber Spider": [2, 4] } } },
  { "name": "ruling: the creature count is fixed as the ability resolves; a creature dying later does not raise the bonus",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Graverobber Spider", "Swamp", "Forest", "Forest", "Forest", "Mountain", "Grizzly Bears"], "graveyard": ["Grizzly Bears", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Graverobber Spider", "ability": 0 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Lightning Bolt"] }, {} ], "pt": { "Graverobber Spider": [4, 6] } } }
]
