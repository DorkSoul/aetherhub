[
  {
    "name": "Aura spells can't target it",
    "players": [
      {
        "hand": ["Dead Weight"],
        "battlefield": ["Swamp"]
      },
      {
        "battlefield": ["Bartel Runeaxe"]
      }
    ],
    "steps": [
      {
        "cast": "Dead Weight",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Dead Weight"]
        },
        {
          "battlefield": ["Bartel Runeaxe"]
        }
      ]
    }
  },
  {
    "name": "a non-Aura targeted spell can still target it",
    "players": [
      {
        "hand": ["Murder"],
        "battlefield": ["Swamp", "Swamp", "Swamp"]
      },
      {
        "battlefield": ["Bartel Runeaxe"]
      }
    ],
    "steps": [
      {
        "cast": "Murder",
        "targets": ["Bartel Runeaxe"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard": ["Bartel Runeaxe"]
        }
      ]
    }
  },
  {
    "name": "abilities can still target it",
    "players": [
      {
        "battlefield": ["Vampire Hexmage"]
      },
      {
        "battlefield": ["Bartel Runeaxe"]
      }
    ],
    "steps": [
      {
        "activate": "Vampire Hexmage",
        "targets": ["Bartel Runeaxe"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Vampire Hexmage"]
        },
        {
          "battlefield": ["Bartel Runeaxe"]
        }
      ],
      "pt": {
        "Bartel Runeaxe": [6, 5]
      }
    }
  },
  {
    "name": "ruling: an Aura moved onto it by Aura Graft stays attached (it can be enchanted)",
    "players": [
      {
        "hand": ["Dead Weight", "Aura Graft"],
        "battlefield": ["Swamp", "Island", "Island"]
      },
      {
        "battlefield": ["Hill Giant", "Bartel Runeaxe"]
      }
    ],
    "steps": [
      { "cast": "Dead Weight", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Aura Graft", "targets": ["Dead Weight"] },
      { "resolve": true, "answers": [[0]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dead Weight"] },
        { "battlefield_has": ["Hill Giant", "Bartel Runeaxe"] }
      ],
      "pt": {
        "Bartel Runeaxe": [4, 3],
        "Hill Giant": [3, 3]
      },
      "attached": { "Dead Weight": "Bartel Runeaxe" }
    }
  },
  {
    "name": "ruling: an enchantment's ability (Oblivion Ring ETB) can target it",
    "players": [
      {
        "hand": ["Oblivion Ring"],
        "battlefield": ["Plains", "Plains", "Plains"]
      },
      {
        "battlefield": ["Bartel Runeaxe"]
      }
    ],
    "steps": [
      { "cast": "Oblivion Ring" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Oblivion Ring"] },
        { "exile": ["Bartel Runeaxe"] }
      ]
    }
  }
]
