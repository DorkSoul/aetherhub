[
  {
    "name": "boast after attacking deals 1 damage to any target, once per turn",
    "players": [
      { "battlefield": ["Hagi Mob", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hagi Mob", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Hagi Mob", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Hagi Mob", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Hagi Mob"] }, { "life": 14 } ]
    }
  },
  {
    "name": "boast is not available if Hagi Mob did not attack this turn",
    "players": [
      { "battlefield": ["Hagi Mob", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "activate": "Hagi Mob", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: boast can be activated after blockers are declared and before combat damage",
    "players": [
      { "battlefield": ["Hagi Mob", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hagi Mob", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hagi Mob" } ] },
      { "activate": "Hagi Mob", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 19, "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
