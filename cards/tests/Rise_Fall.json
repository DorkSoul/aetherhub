   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Rise"] },
    { "battlefield": [], "hand": ["Hill Giant", "Grizzly Bears"], "graveyard": [] }
   ]
  }
 },
 {
  "name": "Rise can't be cast without a creature card in a graveyard",
  "players": [
   { "hand": ["Rise"], "battlefield": ["Island", "Swamp"] },
   { "battlefield": ["Grizzly Bears"], "graveyard": ["Lightning Bolt"] }
  ],
  "steps": [
   { "cast": "Rise", "targets": ["Lightning Bolt", "Grizzly Bears"], "illegal": true }
  ],
  "expect": {
   "players": [ { "hand": ["Rise"] }, { "battlefield": ["Grizzly Bears"] } ]
  }
 },
 {
  "name": "Fall: the two revealed cards are both seen, the nonland one is discarded",
  "players": [
   { "hand": ["Rise"], "battlefield": ["Swamp", "Mountain"] },
   { "hand": ["Hill Giant", "Mountain"] }
  ],
  "steps": [
   { "cast": "Rise", "face": true, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Rise"] },
    { "hand": ["Mountain"], "graveyard": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "Fall: revealed lands are not discarded",
  "players": [
   { "hand": ["Rise"], "battlefield": ["Swamp", "Mountain"] },
   { "hand": ["Forest", "Island"] }
  ],
  "steps": [
   { "cast": "Rise", "face": true, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Rise"] },
    { "hand": ["Forest", "Island"], "graveyard": [] }
   ]
  }
 }
