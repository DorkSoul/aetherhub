[
 {
  "name": "is a 7/7 trample haste",
  "players": [
   {
    "battlefield": [
     "Blitz Hellion"
    ]
   },
   {}
  ],
  "steps": [
   {
    "pass": true
   }
  ],
  "expect": {
   "pt": {
    "Blitz Hellion": [
