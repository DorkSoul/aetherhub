     "Haste"
    ]
   }
  }
 },
 {
  "name": "is shuffled into its owner's library at the end step",
  "players": [
   {
    "battlefield": [
     "Blitz Hellion"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "library_count": 21,
     "battlefield_lacks": [
      "Blitz Hellion"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: a token copy is shuffled and ceases to exist; the original still goes to the library",
  "players": [
   {
    "hand": ["Rite of Replication"],
    "battlefield": ["Blitz Hellion", "Island", "Island", "Island", "Island"]
   },
   {}
  ],
  "steps": [
   { "cast": "Rite of Replication" },
   { "resolve": true },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "library_count": 21, "battlefield_lacks": ["Blitz Hellion"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: if it is no longer on the battlefield when the end step trigger resolves, nothing happens",
  "players": [
   {
    "hand": ["Murder"],
    "battlefield": ["Blitz Hellion", "Swamp", "Swamp", "Swamp"]
   },
   {}
  ],
  "steps": [
   { "advance_to": "End", "hold": true },
   { "cast": "Murder" },
   { "pass": true },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Blitz Hellion", "Murder"], "library_count": 20 },
    {}
   ]
  }
 }
]
