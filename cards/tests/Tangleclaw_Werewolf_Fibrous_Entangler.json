[
  {
    "name": "{6}{G}: transforms into Fibrous Entangler (4/6, vigilance)",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Tangleclaw Werewolf // Fibrous Entangler" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Fibrous Entangler": [4, 6] }, "keywords": { "Fibrous Entangler": ["Vigilance"] } }
  },
  {
    "name": "Fibrous Entangler must be blocked if able",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Tangleclaw Werewolf // Fibrous Entangler" },
      { "resolve": true },
      { "attack": [ { "card": "Fibrous Entangler", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Hill Giant"], "life": 20 } ], "tapped": { "Fibrous Entangler": false } }
  },
  {
    "name": "the front face has no blocking requirement",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Tangleclaw Werewolf // Fibrous Entangler", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18, "battlefield_has": ["Hill Giant"] } ] }
  },
  {
    "name": "front face can block two attackers in one combat: Tangleclaw blocks Grizzly Bears and Llanowar Elves, I take no damage",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
    "steps": [
      { "advance_to": "Main1", "player": 1 },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Llanowar Elves", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Tangleclaw Werewolf // Fibrous Entangler", "attacker": "Grizzly Bears" }, { "blocker": "Tangleclaw Werewolf // Fibrous Entangler", "attacker": "Llanowar Elves" } ], "player": 0 },
      { "advance_to": "Main2", "player": 1 }
    ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Tangleclaw Werewolf // Fibrous Entangler"] }, { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Llanowar Elves"] } ] }
  },
  {
    "name": "back face (Fibrous Entangler) can also block two attackers in one combat: I take no damage",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
    "steps": [
      { "activate": "Tangleclaw Werewolf // Fibrous Entangler" },
      { "resolve": true },
      { "advance_to": "Main1", "player": 1 },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Llanowar Elves", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Fibrous Entangler", "attacker": "Grizzly Bears" }, { "blocker": "Fibrous Entangler", "attacker": "Llanowar Elves" } ], "player": 0 },
      { "advance_to": "Main2", "player": 1 }
    ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Fibrous Entangler"] }, { "graveyard_has": ["Grizzly Bears", "Llanowar Elves"] } ] }
  },
  {
    "name": "ruling: one forced blocker is enough; the second creature may stay out of combat",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [
      { "activate": "Tangleclaw Werewolf // Fibrous Entangler" },
      { "resolve": true },
      { "attack": [ { "card": "Fibrous Entangler", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Fibrous Entangler" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20 }, { "graveyard": ["Hill Giant"], "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: transforming while attacking does not untap it (the front face has no vigilance)",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Tangleclaw Werewolf // Fibrous Entangler", "at": "p1" } ] },
      { "activate": "Tangleclaw Werewolf // Fibrous Entangler" },
      { "resolve": true },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Fibrous Entangler" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20 }, { "graveyard": ["Hill Giant"] } ], "tapped": { "Fibrous Entangler": true } }
  },
  {
    "name": "ruling: no creature can block (the only one is tapped), so the must-be-blocked requirement does nothing",
    "players": [ { "battlefield": ["Tangleclaw Werewolf // Fibrous Entangler", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": [ { "name": "Hill Giant", "tapped": true } ] } ],
    "steps": [
      { "activate": "Tangleclaw Werewolf // Fibrous Entangler" },
      { "resolve": true },
      { "attack": [ { "card": "Fibrous Entangler", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 16 } ] }
  }
]
