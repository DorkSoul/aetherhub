[
  {
    "name": "can't attack alone",
    "players": [ { "battlefield": ["Bonded Construct"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Bonded Construct", "at": "p1" } ], "illegal": true }
    ],
    "expect": { "tapped": { "Bonded Construct": false } }
  },
  {
    "name": "can attack together with another creature",
    "players": [ { "battlefield": ["Bonded Construct", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Bonded Construct", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "tapped": { "Bonded Construct": true, "Grizzly Bears": true } }
  },
  {
    "name": "an attack by it alone is dropped: no damage and it stays untapped",
    "players": [ { "battlefield": ["Bonded Construct"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Bonded Construct", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20 } ], "tapped": { "Bonded Construct": false } }
  },
  {
    "name": "ruling: attacking together with another creature, both deal damage",
    "players": [ { "battlefield": ["Bonded Construct", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Bonded Construct", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "ruling: two creatures that can't attack alone may attack together with no other attacker",
    "players": [ { "battlefield": ["Bonded Construct", "Bonded Construct"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Bonded Construct", "at": "p1" }, { "card": "Bonded Construct", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  }
]
