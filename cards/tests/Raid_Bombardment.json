[
  {
    "name": "a creature with power 2 or less attacking a player deals 1 damage to that player",
    "players": [
      { "battlefield": ["Raid Bombardment", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "a creature with power 3 does not trigger",
    "players": [
      { "battlefield": ["Raid Bombardment", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "a creature with power 2 or less attacking a planeswalker deals 1 damage to that planeswalker",
    "players": [
      { "battlefield": ["Raid Bombardment", "Grizzly Bears"] },
      { "battlefield": ["Test Walker"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "Test Walker" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "counters": { "Test Walker": { "Loyalty": 1 } }
    }
  },
  {
    "name": "ruling: a creature with 0 power that attacks still triggers the damage",
    "players": [
      { "battlefield": ["Raid Bombardment", "Ornithopter"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Ornithopter", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 19 }]
    }
  },
  {
    "name": "ruling: each attacking creature with power 2 or less triggers separately",
    "players": [
      { "battlefield": ["Raid Bombardment", "Ornithopter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Ornithopter", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  },
  {
    "name": "ruling: the attacker leaving before the trigger resolves still deals the damage to the player it was attacking",
    "players": [
      { "battlefield": ["Raid Bombardment", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "graveyard": ["Grizzly Bears"] }, { "life": 19, "graveyard": ["Lightning Bolt"] }]
    }
  },
  {
    "name": "ruling: power is checked when the ability triggers, so a later pump does not stop the damage",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Raid Bombardment", "Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "life": 14 }]
    }
  }
]
