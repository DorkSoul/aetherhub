  },
  {
    "name": "a creature of another type entering does nothing",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Valley Mightcaller", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Valley Mightcaller": [1, 1] }
    }
  },
  {
    "name": "the Mightcaller does not trigger on its own entering",
    "players": [
      { "hand": ["Valley Mightcaller"], "battlefield": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Valley Mightcaller" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Valley Mightcaller": [1, 1] }
    }
  },
  {
    "name": "ruling: two Squirrels entering together each trigger the Mightcaller",
    "players": [
      { "hand": ["Chatterstorm", "Giant Growth"], "battlefield": ["Valley Mightcaller", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Chatterstorm" },
      { "resolve": true }
