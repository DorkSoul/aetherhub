      { "hand": ["Valley Rotcaller"], "battlefield": ["Valley Mightcaller", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Valley Rotcaller" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Valley Mightcaller": [2, 2] },
      "counters": { "Valley Mightcaller": { "PlusOnePlusOne": 1 } }
