[
  {
    "name": "enters tapped",
    "players": [{ "hand": ["Witherbloom Campus"] }, {}],
    "steps": [{ "play_land": "Witherbloom Campus" }],
    "expect": {
      "players": [{ "battlefield": ["Witherbloom Campus"] }, {}],
      "tapped": { "Witherbloom Campus": true }
    }
  },
  {
    "name": "taps for B or G",
    "players": [{ "battlefield": ["Witherbloom Campus"] }, {}],
    "steps": [{ "tap_for_mana": "Witherbloom Campus", "color": "B" }],
    "expect": { "players": [{ "pool": { "B": 1 } }, {}] }
  },
  {
    "name": "{4},{T}: scry needs four other mana",
    "players": [{ "battlefield": ["Witherbloom Campus", "Forest", "Forest", "Forest"] }, {}],
    "steps": [{ "activate": "Witherbloom Campus", "illegal": true }],
    "expect": { "tapped": { "Witherbloom Campus": false } }
  },
  {
    "name": "{4},{T}: scry 1 bottoms the top card",
    "players": [{ "battlefield": ["Witherbloom Campus", "Forest", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt", "Grizzly Bears"] }, {}],
    "steps": [
      { "activate": "Witherbloom Campus", "ability": 0 },
      { "resolve": true, "answers": [["Lightning Bolt"]] }
    ],
    "expect": {
      "players": [{ "library_top": ["Grizzly Bears"] }, {}],
      "tapped": { "Witherbloom Campus": true }
    }
  },
  {
    "name": "{4},{T}: scry 1 keeping the card on top leaves it there",
    "players": [{ "battlefield": ["Witherbloom Campus", "Forest", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt", "Grizzly Bears"] }, {}],
    "steps": [
      { "activate": "Witherbloom Campus", "ability": 0 },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [{ "library_top": ["Lightning Bolt", "Grizzly Bears"] }, {}]
    }
  }
]
