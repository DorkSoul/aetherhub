[
  {
    "name": "mode 1 only: destroys an artifact",
    "players": [
      { "hand": ["Fissure Vent"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Fissure Vent", "answers": [[0]], "targets": ["p1:Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fissure Vent"] },
        { "graveyard": ["Sol Ring"] }
      ]
    }
  },
  {
    "name": "both modes: destroys an artifact and a nonbasic land",
    "players": [
      { "hand": ["Fissure Vent"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sol Ring", "Fabled Passage"] }
    ],
    "steps": [
      { "cast": "Fissure Vent", "answers": [[0, 1]], "targets": ["p1:Sol Ring", "p1:Fabled Passage"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fissure Vent"] },
        { "graveyard_has": ["Sol Ring", "Fabled Passage"], "battlefield_lacks": ["Sol Ring", "Fabled Passage"] }
      ]
    }
  },
  {
    "name": "a basic land is not a legal target for the land mode",
    "players": [
      { "hand": ["Fissure Vent"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Fissure Vent", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Fissure Vent"] },
        { "battlefield": ["Forest"] }
      ]
    }
  },
  {
    "name": "ruling: choosing only the nonbasic land mode destroys just the land",
    "players": [
      { "hand": ["Fissure Vent"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Fabled Passage"] }
    ],
    "steps": [
      { "cast": "Fissure Vent", "answers": [[1]], "targets": ["p1:Fabled Passage"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fissure Vent"] },
        { "graveyard_has": ["Fabled Passage"], "battlefield_lacks": ["Fabled Passage"] }
      ]
    }
  },
  {
    "name": "ruling: with no artifact to target, the artifact mode cannot be chosen",
    "players": [
      { "hand": ["Fissure Vent"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Fabled Passage"] }
    ],
    "steps": [
      { "cast": "Fissure Vent", "answers": [[0]], "targets": ["p1:Fabled Passage"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Fissure Vent"] },
        { "battlefield": ["Fabled Passage"] }
      ]
    }
  }
]
