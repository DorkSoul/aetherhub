[
  { "name": "counters an artifact's activated ability",
    "players": [ { "battlefield": ["Millstone","Brown Ouphe","Forest","Forest","Forest","Forest"] }, {} ],
    "steps": [ { "activate": "Millstone", "targets": ["p1"] },
               { "activate": "Brown Ouphe", "targets": [{"stack": "Millstone"}] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "library_count": 20 } ], "tapped": { "Brown Ouphe": true } } },
  { "name": "without Brown Ouphe the artifact ability resolves",
    "players": [ { "battlefield": ["Millstone","Forest","Forest"] }, {} ],
    "steps": [ { "activate": "Millstone", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "library_count": 18 } ] } },
  { "name": "cannot target a non-artifact source's ability",
    "players": [ { "battlefield": ["Prodigal Sorcerer","Brown Ouphe","Forest","Forest"] }, {} ],
    "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["p1"] },
               { "activate": "Brown Ouphe", "illegal": true } ],
    "expect": { "players": [ {}, {} ] } },
  { "name": "ruling: an equip ability (keyword activated ability of an artifact) can be countered",
    "players": [ { "battlefield": ["Bonesplitter","Grizzly Bears","Brown Ouphe","Forest","Forest","Forest"] }, {} ],
    "steps": [ { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
               { "activate": "Brown Ouphe", "targets": [{"stack": "Bonesplitter"}] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [2, 2] }, "tapped": { "Brown Ouphe": true } } }
]
