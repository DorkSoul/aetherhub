[
  {
    "name": "opponent exiles their creature with the greatest mana value",
    "players": [
      { "hand": ["End of the Hunt"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Llanowar Elves", "Grizzly Bears", "Serra Angel"] }
    ],
    "steps": [
      { "cast": "End of the Hunt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "exile": ["Serra Angel"], "battlefield_has": ["Llanowar Elves", "Grizzly Bears"], "battlefield_lacks": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "a planeswalker counts toward the greatest mana value",
    "players": [
      { "hand": ["End of the Hunt"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Ajani Goldmane"] }
    ],
    "steps": [
      { "cast": "End of the Hunt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "exile": ["Ajani Goldmane"], "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "only the targeted opponent's permanents count, not the caster's",
    "players": [
      { "hand": ["End of the Hunt"], "battlefield": ["Swamp", "Swamp", "Serra Angel"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "End of the Hunt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Serra Angel"] },
        { "exile": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: tied for greatest mana value, the opponent chooses which one is exiled",
    "players": [
      { "hand": ["End of the Hunt"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Blightcaster", "Ajani Goldmane"] }
    ],
    "steps": [
      { "cast": "End of the Hunt", "targets": ["p1"] },
      { "resolve": true, "answers": ["Ajani Goldmane"] }
    ],
    "expect": {
      "players": [
        {},
        { "exile": ["Ajani Goldmane"], "battlefield_has": ["Blightcaster"], "battlefield_lacks": ["Ajani Goldmane"] }
      ]
    }
  },
  {
    "name": "ruling: tied for greatest mana value, the opponent may pick the creature instead",
    "players": [
      { "hand": ["End of the Hunt"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Blightcaster", "Ajani Goldmane"] }
    ],
    "steps": [
      { "cast": "End of the Hunt", "targets": ["p1"] },
      { "resolve": true, "answers": ["Blightcaster"] }
    ],
    "expect": {
      "players": [
        {},
        { "exile": ["Blightcaster"], "battlefield_has": ["Ajani Goldmane"], "battlefield_lacks": ["Blightcaster"] }
      ]
    }
  }
]
