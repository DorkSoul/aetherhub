[
  {
    "name": "sacrifice to deal 2 damage to a creature",
    "players": [
      { "battlefield": ["Vial of Dragonfire", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Vial of Dragonfire", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Vial of Dragonfire"], "battlefield_lacks": ["Vial of Dragonfire"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "needs {2} to activate",
    "players": [
      { "battlefield": ["Vial of Dragonfire", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Vial of Dragonfire", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Vial of Dragonfire"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
