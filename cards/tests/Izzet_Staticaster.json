[
 { "name": "pings the target and each other creature with its name",
   "players": [ { "hand": ["Izzet Staticaster"], "battlefield": ["Island", "Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Llanowar Elves", "Llanowar Elves", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Izzet Staticaster" }, { "resolve": true },
              { "activate": "Izzet Staticaster", "ability": 0, "targets": ["Llanowar Elves"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Llanowar Elves", "Llanowar Elves"], "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "a creature with a different name is not damaged",
   "players": [ { "battlefield": ["Izzet Staticaster"] },
                { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
   "steps": [ { "activate": "Izzet Staticaster", "ability": 0, "targets": ["Llanowar Elves"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Grizzly Bears"], "graveyard": ["Llanowar Elves"] } ] } },
 { "name": "ruling: two tokens with the same name (Squirrel Token) are both dealt damage",
   "players": [ { "battlefield": ["Izzet Staticaster", "Squirrel Wrangler", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "activate": "Squirrel Wrangler", "ability": 0, "answers": ["Forest"] }, { "resolve": true },
              { "activate": "Izzet Staticaster", "ability": 0, "targets": ["Squirrel"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Izzet Staticaster", "Squirrel Wrangler"], "battlefield_lacks": ["Squirrel"] }, {} ] } }
]
