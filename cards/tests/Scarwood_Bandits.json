[
  {
    "name": "opponent who cannot pay loses the artifact",
    "players": [
      { "battlefield": ["Forest", "Forest", "Forest", "Scarwood Bandits"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "activate": "Scarwood Bandits", "targets": ["Sol Ring"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Sol Ring"] },
        { "battlefield_lacks": ["Sol Ring"] }
      ],
      "tapped": { "Scarwood Bandits": true }
    }
  },
  {
    "name": "opponent who pays {2} keeps the artifact",
    "players": [
      { "battlefield": ["Forest", "Forest", "Forest", "Scarwood Bandits"] },
      { "battlefield": ["Sol Ring", "Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Scarwood Bandits", "targets": ["Sol Ring"] },
      { "resolve": true, "player": 1, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Sol Ring"] },
        { "battlefield_has": ["Sol Ring"] }
      ]
    }
  }
]
