[
  {
    "name": "unblocked Zombie combat damage makes the opponent mill that many instead",
    "players": [
      {"battlefield": ["Undead Alchemist"]},
      {"battlefield": [], "library": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}
    ],
    "steps": [
      {"attack": [{"card": "Undead Alchemist", "at": "p1"}]},
      {"advance_to": "Main2"}
    ],
    "expect": {
      "players": [
        {},
        {"life": 20, "library_count": 2, "graveyard": ["Forest", "Forest", "Forest", "Forest"]}
      ]
    }
  },
  {
    "name": "opponent's creature card milled from their library is exiled and a 2/2 Zombie is created",
    "players": [
      {"battlefield": ["Undead Alchemist"]},
      {"library": ["Grizzly Bears", "Forest", "Forest", "Forest"]}
    ],
    "steps": [
      {"attack": [{"card": "Undead Alchemist", "at": "p1"}]},
      {"advance_to": "Main2"}
    ],
    "expect": {
      "players": [
        {"battlefield_has": ["Zombie 2-2 Black"]},
        {"library_count": 0, "exile": ["Grizzly Bears"]}
      ]
    }
  },
  {
    "name": "a non-Zombie attacker's combat damage is not replaced: no mill",
    "players": [
      {"battlefield": ["Undead Alchemist", "Grizzly Bears"]},
      {"library": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}
    ],
    "steps": [
      {"attack": [{"card": "Grizzly Bears", "at": "p1"}]},
      {"advance_to": "Main2"}
    ],
    "expect": {
      "players": [
        {},
        {"life": 18, "library_count": 6}
      ]
    }
  },
  {
    "name": "ruling: with two Undead Alchemists each milled creature card is exiled once and makes a Zombie per Alchemist",
    "players": [
      {"battlefield": ["Undead Alchemist", "Undead Alchemist"]},
      {"rad": 2, "library": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears"]}
    ],
    "steps": [
      {"advance_to": "Main1"}
    ],
    "expect": {
      "players": [
        {"battlefield_has": ["Zombie 2-2 Black", "Zombie 2-2 Black", "Zombie 2-2 Black", "Zombie 2-2 Black"]},
        {"life": 18, "exile": ["Grizzly Bears", "Grizzly Bears"]}
      ]
    }
  },
  {
    "name": "ruling: with two Undead Alchemists a Zombie's combat damage is replaced only once",
    "players": [
      {"battlefield": ["Undead Alchemist", "Undead Alchemist", "Undead Gladiator"]},
      {"library": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}
    ],
    "steps": [
      {"attack": [{"card": "Undead Gladiator", "at": "p1"}]},
      {"advance_to": "Main2"}
    ],
    "expect": {
      "players": [
        {},
        {"life": 20, "library_count": 3, "graveyard": ["Forest", "Forest", "Forest"]}
      ]
    }
  }
]
