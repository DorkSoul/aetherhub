[
  { "name": "has haste when cast",
    "players": [ { "hand": ["Viashino Sandscout"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Viashino Sandscout" }, { "resolve": true } ],
    "expect": { "keywords": { "Viashino Sandscout": ["Haste"] }, "players": [ { "battlefield_has": ["Viashino Sandscout"] } ] } },
  { "name": "returns to its owner's hand at the beginning of the end step",
    "players": [ { "battlefield": ["Viashino Sandscout"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Viashino Sandscout"], "battlefield": [] }, {} ] } },
  { "name": "ruling: if it died before the end step it is not returned to hand",
    "players": [ { "battlefield": ["Viashino Sandscout"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Viashino Sandscout", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Viashino Sandscout" } ], "player": 1 },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "graveyard": ["Viashino Sandscout"], "hand_count": 0 }, { "graveyard": ["Grizzly Bears"] } ] } }
]
