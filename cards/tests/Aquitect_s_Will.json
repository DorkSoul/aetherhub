[
  { "name": "flood counter makes the target land an Island (still a Forest, taps for blue too)",
    "players": [ { "hand": ["Aquitect's Will"], "battlefield": ["Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Aquitect's Will", "targets": ["Forest"] }, { "resolve": true }, { "tap_for_mana": "Forest", "color": "U" } ],
    "expect": { "players": [ { "pool": { "U": 1 } }, {} ] } },
  { "name": "draws a card only if you control a Merfolk",
    "players": [ { "hand": ["Aquitect's Will"], "battlefield": ["Island", "Forest", "Arctic Merfolk"] }, {} ],
    "steps": [ { "cast": "Aquitect's Will", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "no Merfolk, no draw",
    "players": [ { "hand": ["Aquitect's Will"], "battlefield": ["Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Aquitect's Will", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "ruling: kindred is a card type, so Tarmogoyf counts it (Sorcery, Kindred and Instant in graveyards)",
    "players": [ { "hand": ["Aquitect's Will"], "battlefield": ["Island", "Forest", "Tarmogoyf"], "graveyard": ["Peppersmoke"] }, {} ],
    "steps": [ { "cast": "Aquitect's Will", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "pt": { "Tarmogoyf": [3, 4] }, "players": [ { "graveyard": ["Aquitect's Will", "Peppersmoke"] }, {} ] } },
  { "name": "ruling: a noncreature kindred Merfolk counts as controlling a Merfolk",
    "players": [ { "hand": ["Aquitect's Will"], "battlefield": ["Island", "Forest", "Merrow Commerce"] }, {} ],
    "steps": [ { "cast": "Aquitect's Will", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } }
]
