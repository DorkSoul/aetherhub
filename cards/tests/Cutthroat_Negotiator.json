   ]
  }
 },
 {
  "name": "each nonland revealed card makes a tapped Treasure; then each player draws",
  "players": [
   { "battlefield": ["Cutthroat Negotiator"], "library": ["Sol Ring", "Forest", "Forest"] },
   { "library": ["Grizzly Bears", "Forest", "Forest"] }
  ],
  "steps": [
   { "attack": [{ "card": "Cutthroat Negotiator", "at": "p1" }] },
   { "block": [] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Treasure", "Treasure"], "hand": ["Sol Ring"], "library_count": 2 },
    { "hand": ["Grizzly Bears"], "library_count": 2 }
   ]
  }
 },
 {
  "name": "lands revealed make no Treasure but still draw",
  "players": [
   { "battlefield": ["Cutthroat Negotiator"], "library": ["Forest", "Forest"] },
   { "library": ["Island", "Forest"] }
  ],
  "steps": [
   { "attack": [{ "card": "Cutthroat Negotiator", "at": "p1" }] },
   { "block": [] },
   { "resolve": true }
  ],
  "expect": {
