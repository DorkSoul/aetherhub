    { "battlefield_lacks": ["Treasure"], "hand": ["Forest"] },
    { "hand": ["Island"] }
   ]
  }
 },
 {
  "name": "one nonland revealed by the opponent gives one Treasure",
  "players": [
   { "battlefield": ["Cutthroat Negotiator"], "library": ["Forest", "Forest"] },
   { "library": ["Sol Ring", "Forest"] }
  ],
  "steps": [
   { "attack": [{ "card": "Cutthroat Negotiator", "at": "p1" }] },
   { "block": [] },
   { "resolve": true }
  ],
  "expect": {
