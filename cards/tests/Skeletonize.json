[
 {
  "name": "a creature killed by the damage leaves a regenerating Skeleton token",
  "players": [
   { "hand": ["Skeletonize"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Skeletonize", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Skeletonize"], "battlefield_has": ["Skeleton 1-1 Black Regenerate"] },
    { "graveyard": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "a creature that survives the damage makes no token",
  "players": [
   { "hand": ["Skeletonize"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "cast": "Skeletonize", "targets": ["Serra Angel"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Skeletonize"], "battlefield_lacks": ["Skeleton 1-1 Black Regenerate"] },
    { "battlefield_has": ["Serra Angel"] }
   ]
  }
 },
 {
  "name": "ruling: the token is yours even when the creature that died was your own",
  "players": [
   { "hand": ["Skeletonize"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Skeletonize", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Skeletonize", "Grizzly Bears"], "battlefield_has": ["Skeleton 1-1 Black Regenerate"] },
    {}
   ]
  }
 }
]
