    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "cast": "Vex", "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Vex"] }, { "graveyard_has": ["Lightning Bolt"], "hand_count": 0 } ] } },
