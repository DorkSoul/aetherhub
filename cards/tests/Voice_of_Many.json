[
  {
    "name": "draws a card when an opponent controls fewer creatures",
    "players": [
      { "hand": ["Voice of Many"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Voice of Many" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] }
  },
  {
    "name": "no draw when opponent controls as many creatures",
    "players": [
      { "hand": ["Voice of Many"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Voice of Many" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] }
  },
  {
    "name": "draws once per opponent with fewer creatures",
    "players": [
      { "hand": ["Voice of Many"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Voice of Many" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 1 }, {}, {} ] }
  },
  {
    "name": "ruling: the creature count is taken when the trigger resolves (Bears killed in response)",
    "players": [
      { "hand": ["Voice of Many"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"] }
    ],
    "steps": [
      { "cast": "Voice of Many" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] } ] }
  }
]
