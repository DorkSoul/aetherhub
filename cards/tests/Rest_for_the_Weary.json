[
  {
    "name": "no land this turn: target player gains 4",
    "players": [ { "hand": ["Rest for the Weary"], "battlefield": ["Chromatic Lantern", "Sol Ring"] }, {} ],
    "steps": [
      { "cast": "Rest for the Weary", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 24 } ] }
  },
  {
    "name": "landfall this turn: target player gains 8",
    "players": [ { "hand": ["Rest for the Weary", "Mountain"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [
      { "play_land": "Mountain" },
      { "cast": "Rest for the Weary", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 28 } ] }
  },
  {
    "name": "ruling: a land played after the spell resolved adds nothing to it",
    "players": [ { "hand": ["Rest for the Weary", "Mountain"], "battlefield": ["Plains", "Forest"] }, {} ],
    "steps": [
      { "cast": "Rest for the Weary", "targets": ["p0"] },
      { "resolve": true },
      { "play_land": "Mountain" }
    ],
    "expect": { "players": [ { "life": 24 }, {} ] }
  },
  {
    "name": "ruling: landfall gives 8 to the target, not 4 plus 8",
    "players": [ { "hand": ["Rest for the Weary", "Mountain"], "battlefield": ["Plains", "Forest"] }, {} ],
    "steps": [
      { "play_land": "Mountain" },
      { "cast": "Rest for the Weary", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 28 }, {} ] }
  }
]
