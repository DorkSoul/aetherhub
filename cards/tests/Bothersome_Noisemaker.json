[
  {
    "name": "casting a noncreature spell amasses a Goblin Army",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Bothersome Noisemaker"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Bothersome Noisemaker", "Army"] }, { "life": 17 } ],
      "pt": { "Army": [1, 1] }
    }
  },
  {
    "name": "a creature spell does not trigger it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Island", "Bothersome Noisemaker"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Bothersome Noisemaker"], "battlefield_lacks": ["Army"] }, {} ] }
  },
  { "name": "ruling: a changeling that is already an Army is the Army amassed (no new token, counter goes on it)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Bothersome Noisemaker", "Changeling Outcast"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Bothersome Noisemaker", "Changeling Outcast"], "battlefield_lacks": ["Army"] }, { "life": 17 } ],
      "pt": { "Changeling Outcast": [2, 2] }
    }
  },
  { "name": "ruling: later amass adds counters to the same Army token rather than making another",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Bothersome Noisemaker"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Bothersome Noisemaker", "Army"] }, { "life": 14 } ],
      "pt": { "Army": [2, 2] }
    }
  }
]
