[
  {
    "name": "tap: target player gains control of a creature you control",
    "players": [
      { "battlefield": [{"name": "Bazaar Trader", "sick": false}, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Bazaar Trader", "ability": 0, "targets": ["p1", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Bazaar Trader"] }, { "battlefield_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "tap: targeting yourself as the player keeps control",
    "players": [
      { "battlefield": [{"name": "Bazaar Trader", "sick": false}, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Bazaar Trader", "ability": 0, "targets": ["p0", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Bazaar Trader", "Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "ruling: targeting yourself overrides Act of Treason's until-end-of-turn control",
    "players": [
      { "hand": ["Act of Treason"], "battlefield": [{"name": "Bazaar Trader", "sick": false}, "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Act of Treason", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Bazaar Trader", "ability": 0, "targets": ["p0", "Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Bazaar Trader", "Hill Giant"] }, { "battlefield_lacks": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: the gained control has no duration and persists through later turns",
    "players": [
      { "battlefield": [{"name": "Bazaar Trader", "sick": false}, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Bazaar Trader", "ability": 0, "targets": ["p1", "Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] }]
    }
  }
]
