[
  {
    "name": "deals 4 to its controller at the end step when they control no commander",
    "players": [
      { "battlefield": ["Crimson Honor Guard"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 16 }, { "life": 20 } ]
    }
  },
  {
    "name": "no damage when the player controls a commander",
    "commander": true,
    "players": [
      { "command": ["Test Commander"], "battlefield": ["Crimson Honor Guard", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Test Commander" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: opponent's end step deals 4 to the opponent who controls no commander",
    "players": [
      { "battlefield": ["Crimson Honor Guard"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 16 }, { "life": 16 } ]
    }
  }
]
