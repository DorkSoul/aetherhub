[
  {
    "name": "declining the upkeep payment keeps the Djinn with its controller",
    "players": [
      { "battlefield": ["Mountain", "Mountain", "Emberwilde Djinn"] },
      { "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Emberwilde Djinn"], "life": 20 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "the upkeep player pays RR and gains control of the Djinn",
    "players": [
      { "battlefield": ["Mountain", "Mountain", "Emberwilde Djinn"] },
      { "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "advance_to": "Upkeep", "answers": [true, 0] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "battlefield_has": ["Emberwilde Djinn"], "life": 20 }
      ]
    }
  },
  {
    "name": "the upkeep player pays 2 life and gains control of the Djinn",
    "players": [
      { "battlefield": ["Mountain", "Emberwilde Djinn"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "Upkeep", "answers": [true, 1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "battlefield_has": ["Emberwilde Djinn"], "life": 18 }
      ]
    }
  }
]
