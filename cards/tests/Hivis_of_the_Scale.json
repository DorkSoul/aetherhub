    "steps": [ { "activate": "Hivis of the Scale", "ability": 0, "targets": ["Shivan Dragon"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "advance_to": "Upkeep" } ],
