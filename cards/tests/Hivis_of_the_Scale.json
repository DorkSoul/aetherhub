    "expect": { "turn": 4, "players": [ { "battlefield_has": ["Shivan Dragon", "Hivis of the Scale"] }, { "battlefield_lacks": ["Shivan Dragon"] } ], "tapped": { "Hivis of the Scale": true } } }
