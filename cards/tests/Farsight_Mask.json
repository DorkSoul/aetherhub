[
  {
    "name": "opponent's spell damage lets you draw while untapped",
    "players": [
      {
        "battlefield": [
          "Farsight Mask"
        ]
      },
      {
        "hand": [
          "Shock"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Shock",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18,
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "no draw if the Mask is tapped",
    "players": [
      {
        "battlefield": [
          {
            "name": "Farsight Mask",
            "tapped": true
          }
        ]
      },
      {
        "hand": [
          "Shock"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Shock",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18,
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "your own damage to yourself does not trigger it",
    "players": [
      {
        "battlefield": [
          "Farsight Mask",
          "Mountain"
        ],
        "hand": [
          "Shock"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Shock",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18,
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "ruling: each damage event from the same opponent source draws a card (two Shocks, two draws)",
    "players": [
      { "battlefield": ["Farsight Mask"] },
      { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["p0"] },
      { "resolve": true, "answers": [true] },
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["p0"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "life": 16, "hand_count": 2 },
        {}
      ]
    }
  },
  {
    "name": "ruling: one draw per damaging event regardless of the amount of damage (Lightning Bolt)",
    "players": [
      { "battlefield": ["Farsight Mask"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "life": 17, "hand_count": 1 },
        {}
      ]
    }
  }
]