[
  {
    "name": "upkeep puts a bounty counter on an opponent's creature",
    "players": [
      {
        "battlefield": [
          "Chevill, Bane of Monsters"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Hill Giant": {
          "bounty": 1
        }
      }
    }
  },
  {
    "name": "gain 3 and draw when the bounty permanent dies",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Chevill, Bane of Monsters",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Hill Giant",
            "counters": {
              "bounty": 1
            }
          }
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 23,
          "hand_count": 1
        },
        {
          "graveyard": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "no new counter while an opponent already has a bounty permanent",
    "players": [
      {
        "battlefield": [
          "Chevill, Bane of Monsters"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Hill Giant",
            "counters": {
              "bounty": 1
            }
          },
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {}
      }
    }
  },
  {
    "name": "a creature without a bounty counter dying does nothing",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Chevill, Bane of Monsters",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20,
          "hand_count": 0
        },
        {
          "graveyard": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a bounty permanent dying after Chevill has left the battlefield does not trigger it",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Chevill, Bane of Monsters", "Mountain", "Mountain"] },
      { "battlefield": [ { "name": "Grizzly Bears", "counters": { "bounty": 1 } } ] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Chevill, Bane of Monsters"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "hand_count": 0, "graveyard_has": ["Chevill, Bane of Monsters"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  }
]
