[
  {
    "name": "sacrifice another creature: exile the top card, playable this turn cycle",
    "players": [
      { "battlefield": ["Snowslope Hunter", "Grizzly Bears"], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Snowslope Hunter", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Forest"], "graveyard": ["Grizzly Bears"], "library_count": 1 }, {} ]
    }
  },
  {
    "name": "only once each turn",
    "players": [
      { "battlefield": ["Snowslope Hunter", "Grizzly Bears", "Llanowar Elves"], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Snowslope Hunter", "ability": 0, "answers": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Snowslope Hunter", "ability": 0, "answers": ["Llanowar Elves"], "illegal": true }
    ],
    "expect": {
      "players": [ { "library_count": 1, "battlefield_has": ["Llanowar Elves"] }, {} ]
    }
  },
  {
    "name": "ruling: an exiled land is played as the land drop during your main phase with an empty stack",
    "players": [
      { "battlefield": ["Snowslope Hunter", "Grizzly Bears"], "library": ["Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Snowslope Hunter", "ability": 0 },
      { "resolve": true },
      { "play_land": "Mountain" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mountain", "Snowslope Hunter"], "exile": [], "graveyard": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: an exiled land cannot be played once the land drop for the turn is used",
    "players": [
      { "hand": ["Plains"], "battlefield": ["Snowslope Hunter", "Grizzly Bears"], "library": ["Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "play_land": "Plains" },
      { "activate": "Snowslope Hunter", "ability": 0 },
      { "resolve": true },
      { "play_land": "Mountain", "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Plains"], "exile": ["Mountain"] }, {} ]
    }
  }
]
