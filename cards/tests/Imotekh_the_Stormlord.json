      { "battlefield": ["Imotekh the Stormlord", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "pt": { "Imotekh the Stormlord": [3, 3], "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "artifact cards leaving your graveyard create two 2/2 Necron Warriors",
    "players": [
      { "battlefield": ["Imotekh the Stormlord", "Immortal Coil"], "graveyard": ["Sol Ring", "Bonesplitter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Immortal Coil", "ability": 0, "answers": [["Sol Ring", "Bonesplitter"]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "exile": ["Sol Ring", "Bonesplitter"], "graveyard": ["Grizzly Bears"] }, {}],
      "pt": { "Necron Warrior 2-2": [2, 2] }
    }
  },
  {
    "name": "a non-artifact card leaving your graveyard creates no Necron Warriors",
    "players": [
      { "battlefield": ["Imotekh the Stormlord", "Immortal Coil"], "graveyard": ["Grizzly Bears", "Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Immortal Coil", "ability": 0, "answers": [["Grizzly Bears", "Forest"]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "exile": ["Grizzly Bears", "Forest"], "battlefield_lacks": ["Necron Warrior 2-2"] }, {}]
    }
  },
  {
    "name": "ruling: several artifact cards leaving at once make one trigger, so only two Necron Warriors",
    "players": [
      { "battlefield": ["Imotekh the Stormlord", "Immortal Coil"], "graveyard": ["Sol Ring", "Bonesplitter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Immortal Coil", "ability": 0, "answers": [["Sol Ring", "Bonesplitter"]] },
      { "resolve": true }
    ],
    "expect": {
