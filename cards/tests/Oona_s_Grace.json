[
  {
    "name": "target player draws a card",
    "players": [
      { "hand": ["Oona's Grace"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Oona's Grace", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Oona's Grace"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "retrace: cast from graveyard by discarding a land",
    "players": [
      { "graveyard": ["Oona's Grace"], "hand": ["Forest"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Oona's Grace", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Oona's Grace", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "retrace needs a land card to discard",
    "players": [
      { "graveyard": ["Oona's Grace"], "hand": ["Lightning Bolt"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Oona's Grace", "alt": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Oona's Grace"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a retrace spell goes back to the graveyard after it resolves and can be cast again with retrace",
    "players": [
      { "hand": ["Oona's Grace", "Forest"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Oona's Grace", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Oona's Grace", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Oona's Grace", "Forest"] },
        { "hand_count": 2 }
      ]
    }
  }
]
