[
  {
    "name": "ruling: boast can be activated after attackers are declared, before combat damage",
    "players": [
      { "battlefield": ["Duskwielder", "Swamp"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Duskwielder", "at": "p1" } ] },
      { "activate": "Duskwielder", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: boast can be activated in the end step after attacking",
    "players": [
      { "battlefield": ["Duskwielder", "Swamp"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Duskwielder", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "activate": "Duskwielder", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 18 } ]
    }
  },
  {
    "name": "boast after attacking: opponent loses 1 and you gain 1",
    "players": [
      { "battlefield": ["Duskwielder", "Swamp"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Duskwielder", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Duskwielder", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 18 } ]
    }
  },
  {
    "name": "boast is not available if Duskwielder did not attack this turn",
    "players": [
      { "battlefield": ["Duskwielder", "Swamp"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "activate": "Duskwielder", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 20 } ]
    }
  },
  {
    "name": "boast works only once each turn",
    "players": [
      { "battlefield": ["Duskwielder", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Duskwielder", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Duskwielder", "ability": 0 },
      { "resolve": true },
      { "activate": "Duskwielder", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 18 } ]
    }
  }
]
