[
  {
    "name": "unblocked attack gives the defending player a poison counter",
    "players": [
      { "battlefield": [ { "name": "Suq'Ata Assassin", "sick": false } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Suq'Ata Assassin", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 19, "poison": 1 } ]
    }
  },
  {
    "name": "fear: a black blocker is legal and stops the poison counter",
    "players": [
      { "battlefield": [ { "name": "Suq'Ata Assassin", "sick": false } ] },
      { "battlefield": [ "Black Knight" ] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Suq'Ata Assassin", "at": "p1" } ] },
      { "block": [ { "blocker": "Black Knight", "attacker": "Suq'Ata Assassin" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "poison": 0 } ]
    }
  },
  {
    "name": "ruling: blocked by a black creature that dies before damage is still blocked, so no poison counter",
    "players": [
      { "battlefield": [ { "name": "Suq'Ata Assassin", "sick": false } ] },
      { "hand": [ "Shock" ], "battlefield": [ "Black Knight", "Mountain" ] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Suq'Ata Assassin", "at": "p1" } ] },
      { "block": [ { "blocker": "Black Knight", "attacker": "Suq'Ata Assassin" } ] },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": [ "Black Knight" ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20, "poison": 0, "graveyard_has": [ "Black Knight" ] } ]
    }
  }
]
