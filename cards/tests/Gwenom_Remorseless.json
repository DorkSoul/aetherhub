[
  {
    "name": "attacking lets you cast the top library card (an instant, in combat), paying life equal to its mana value",
    "players": [
      { "life": 20, "battlefield": ["Gwenom, Remorseless"], "library": ["Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Gwenom, Remorseless", "at": "p1" }] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 19, "battlefield_has": ["Gwenom, Remorseless"], "graveyard": ["Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "the permission comes from attacking: before an attack the top card cannot be cast for free",
    "players": [
      { "life": 20, "battlefield": ["Gwenom, Remorseless"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "library_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "the library permission is only for the top card; a card in hand still needs mana",
    "players": [
      { "life": 20, "battlefield": ["Gwenom, Remorseless"], "hand": ["Grizzly Bears"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Gwenom, Remorseless", "at": "p1" }] },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "hand": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the top card is a sorcery-speed spell, so it cannot be cast during combat",
    "players": [ { "life": 20, "battlefield": ["Gwenom, Remorseless"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [{ "card": "Gwenom, Remorseless", "at": "p1" }] },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": { "players": [ { "library_top": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "ruling: the same top card can be cast in the postcombat main phase (paying 2 life)",
    "players": [ { "life": 20, "battlefield": ["Gwenom, Remorseless"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [{ "card": "Gwenom, Remorseless", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22, "battlefield_has": ["Grizzly Bears"] }, { "life": 16 } ] }
  },
  {
    "name": "ruling: a land can be played from the top of the library when a land drop is still available",
    "players": [ { "battlefield": ["Gwenom, Remorseless"], "library": ["Forest"] }, {} ],
    "steps": [
      { "attack": [{ "card": "Gwenom, Remorseless", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "play_land": "Forest" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, {} ] }
  },
  {
    "name": "ruling: no land drop left (a Mountain was played), so the top-of-library Forest is illegal",
    "players": [ { "hand": ["Mountain"], "battlefield": ["Gwenom, Remorseless"], "library": ["Forest"] }, {} ],
    "steps": [
      { "attack": [{ "card": "Gwenom, Remorseless", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "play_land": "Mountain" },
      { "play_land": "Forest", "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Mountain"], "hand": [] }, {} ] }
  }
]
