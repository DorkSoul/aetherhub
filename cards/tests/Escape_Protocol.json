[
  { "name": "cycling and paying 1 blinks an artifact or creature you control",
    "players": [ { "hand": ["Bloated Toad", "Forest"], "library": ["Island"], "battlefield": ["Escape Protocol", "Island", "Island", "Island", "Island", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] }, {} ],
    "steps": [ { "activate": "Bloated Toad" }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ { "battlefield_has": ["Grizzly Bears", "Escape Protocol"], "graveyard": ["Bloated Toad"] }, {} ] } },
  { "name": "declining the payment does not blink",
    "players": [ { "hand": ["Bloated Toad"], "library": ["Island"], "battlefield": ["Escape Protocol", "Island", "Island", "Island", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] }, {} ],
    "steps": [ { "activate": "Bloated Toad" }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4] }, "players": [ { "graveyard": ["Bloated Toad"] }, {} ] } },
  { "name": "ruling: the blinked creature is a new object, so its Aura goes to the graveyard and its counters are gone",
    "players": [ { "hand": ["Ordeal of Heliod", "Bloated Toad"], "library": ["Island"], "battlefield": ["Escape Protocol", "Plains", "Plains", "Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Ordeal of Heliod", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "activate": "Bloated Toad" }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Escape Protocol"], "battlefield_lacks": ["Ordeal of Heliod"], "graveyard": ["Ordeal of Heliod", "Bloated Toad"] }, {} ] } },
  { "name": "ruling: an exiled token ceases to exist and does not return",
    "players": [ { "hand": ["Bloated Toad"], "library": ["Island"], "battlefield": ["Escape Protocol", "Island", "Island", "Island", "Island", "Inkling 1-1 White Black Flying"] }, {} ],
    "steps": [ { "activate": "Bloated Toad" }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Escape Protocol"], "battlefield_lacks": ["Inkling 1-1 White Black Flying"], "graveyard": ["Bloated Toad"] }, {} ] } }
]
