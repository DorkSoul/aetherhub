[
  {
    "name": "tap: put a land from hand onto the battlefield",
    "players": [
      {
        "hand": [
          "Forest"
        ],
        "battlefield": [
          "Llanowar Scout"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Llanowar Scout",
        "ability": 0
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Llanowar Scout",
            "Forest"
          ],
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "tapping it again is not allowed",
    "players": [
      {
        "hand": [
          "Forest"
        ],
        "battlefield": [
          {
            "name": "Llanowar Scout",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Llanowar Scout",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Forest"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the ability works on the opponent's turn, since it is not a land play",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Llanowar Scout"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "player": 1, "pass": true },
      { "activate": "Llanowar Scout", "ability": 0 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Llanowar Scout", "Forest"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: it can be used after you have already played a land this turn",
    "players": [
      { "hand": ["Island", "Plains"], "battlefield": ["Llanowar Scout"] },
      {}
    ],
    "steps": [
      { "play_land": "Island" },
      { "activate": "Llanowar Scout", "ability": 0 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Llanowar Scout", "Island", "Plains"], "hand_count": 0 },
        {}
      ]
    }
  }
]
