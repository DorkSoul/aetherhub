[
  {
    "name": "untaps only one of its controller's tapped lands",
    "players": [
      {
        "battlefield": [
          "Mungha Wurm",
          {
            "name": "Forest",
            "tapped": true
          },
          {
            "name": "Plains",
            "tapped": true
          },
          {
            "name": "Island",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          [
            "Forest"
          ]
        ]
      }
    ],
    "expect": {
      "turn": 3,
      "tapped": {
        "Forest": false,
        "Plains": true,
        "Island": true
      }
    }
  },
  {
    "name": "creatures are not limited",
    "players": [
      {
        "battlefield": [
          "Mungha Wurm",
          {
            "name": "Grizzly Bears",
            "tapped": true,
            "sick": false
          },
          "Forest",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "turn": 3,
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "opponent's lands are not limited",
    "players": [
      {
        "battlefield": [
          "Mungha Wurm"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Forest",
            "tapped": true
          },
          {
            "name": "Plains",
            "tapped": true
          }
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "turn": 2,
      "tapped": {
        "Forest": false,
        "Plains": false
      }
    }
  }
]
