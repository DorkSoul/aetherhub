[
 { "name": "opponent casting on your turn draws a card",
   "players": [ { "battlefield": ["Glademuse"] }, { "hand": ["Dark Ritual"], "battlefield": ["Swamp"] } ],
   "steps": [ { "pass": true }, { "cast": "Dark Ritual", "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ {}, { "hand_count": 1 } ] } },
 { "name": "casting on your own turn does not draw",
   "players": [ { "hand": ["Dark Ritual"], "battlefield": ["Glademuse", "Swamp"] }, {} ],
   "steps": [ { "cast": "Dark Ritual" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0 }, {} ] } },
 { "name": "casting your own spell on the opponent's turn draws a card",
   "players": [ { "hand": ["Dark Ritual"], "battlefield": ["Glademuse", "Swamp"] }, {} ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Dark Ritual" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "ruling: the draw trigger resolves even though the opponent's spell is countered",
   "players": [ { "hand": ["Counterspell"], "battlefield": ["Glademuse", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Counterspell"], "life": 20 }, { "hand_count": 1, "graveyard": ["Lightning Bolt"] } ] } }
]
