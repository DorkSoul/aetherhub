[
  {
    "name": "GU: becomes 4/4 with flying until end of turn",
    "players": [
      { "battlefield": ["Beetleform Mage", "Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Beetleform Mage" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Beetleform Mage"] }, {}],
      "pt": { "Beetleform Mage": [4, 4] },
      "keywords": { "Beetleform Mage": ["Flying"] }
    }
  },
  {
    "name": "activate only once each turn",
    "players": [
      { "battlefield": ["Beetleform Mage", "Forest", "Island", "Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Beetleform Mage" },
      { "resolve": true },
      { "activate": "Beetleform Mage", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Beetleform Mage"] }, {}],
      "pt": { "Beetleform Mage": [4, 4] }
    }
  },
  {
    "name": "ruling: activating after a block does not make the attacker unblocked",
    "players": [
      { "battlefield": [{ "name": "Beetleform Mage", "sick": false }, "Forest", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Beetleform Mage", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Beetleform Mage" }], "player": 1 },
      { "activate": "Beetleform Mage" },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20, "graveyard": ["Grizzly Bears"] }],
      "pt": { "Beetleform Mage": [4, 4] }
    }
  }
]
