[
  {
    "name": "X damage to a player with no creatures",
    "players": [
      { "hand": ["Flaming Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Flaming Gambit", "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "opponent declines to redirect: the player takes the damage",
    "players": [
      { "hand": ["Flaming Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Flaming Gambit", "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "opponent redirects the damage to their creature",
    "players": [
      { "hand": ["Flaming Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Flaming Gambit", "targets": ["p1"], "answers": [2] },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ {}, { "life": 20, "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "flashback for X R R from the graveyard",
    "players": [
      { "graveyard": ["Flaming Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Flaming Gambit", "alt": 0, "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: flashback can be cast right after the spell hits the graveyard, in the same turn",
    "players": [
      { "hand": ["Flaming Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Flaming Gambit", "targets": ["p1"], "answers": [2] },
      { "resolve": true },
      { "cast": "Flaming Gambit", "alt": 0, "targets": ["p1"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "ruling: a spell cast with flashback is exiled when it resolves",
    "players": [
      { "graveyard": ["Flaming Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Flaming Gambit", "alt": 0, "targets": ["p1"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Flaming Gambit"] }, { "life": 19 } ]
    }
  }
]
