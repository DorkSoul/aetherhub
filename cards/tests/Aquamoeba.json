[
 { "name": "discarding a card switches 1/3 to 3/1",
   "players": [ { "hand": ["Island"], "battlefield": ["Aquamoeba"] }, {} ],
   "steps": [ { "activate": "Aquamoeba", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Island"] }, {} ], "pt": { "Aquamoeba": [3, 1] } } },
 { "name": "switching twice returns to 1/3",
   "players": [ { "hand": ["Island", "Mountain"], "battlefield": ["Aquamoeba"] }, {} ],
   "steps": [ { "activate": "Aquamoeba", "ability": 0, "answers": [0] }, { "resolve": true }, { "activate": "Aquamoeba", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Aquamoeba": [1, 3] } } },
 { "name": "no card in hand: cannot activate",
   "players": [ { "hand": [], "battlefield": ["Aquamoeba"] }, {} ],
   "steps": [ { "activate": "Aquamoeba", "ability": 0, "illegal": true } ],
   "expect": { "pt": { "Aquamoeba": [1, 3] } } },
 { "name": "ruling: damage stays marked, switching makes the 2 damage lethal",
   "players": [ { "hand": ["Island"], "battlefield": ["Aquamoeba"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Aquamoeba", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Aquamoeba" } ], "player": 1 }, { "advance_to": "Main2" }, { "activate": "Aquamoeba", "ability": 0, "answers": [0] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Aquamoeba", "Island"] }, {} ] } }
]
