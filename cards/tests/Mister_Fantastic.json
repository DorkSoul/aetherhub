[
  {
    "name": "copies an enters trigger twice: three cards drawn",
    "players": [
      {
        "hand": ["Elvish Visionary"],
        "battlefield": ["Mister Fantastic", "Forest", "Forest", "Forest", "Mountain", "Plains", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Elvish Visionary" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "activate": "Mister Fantastic" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3 },
        {}
      ]
    }
  },
  {
    "name": "cannot activate without a Blue mana source (no RGWU)",
    "players": [
      {
        "hand": ["Elvish Visionary"],
        "battlefield": ["Mister Fantastic", "Forest", "Mountain", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Elvish Visionary" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "activate": "Mister Fantastic", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "beginning of combat draw after casting a noncreature spell this turn",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mister Fantastic", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "no draw at beginning of combat when only a creature spell was cast",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Mister Fantastic", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        {}
      ]
    }
  }
