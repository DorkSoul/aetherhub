[
  {
    "name": "exiles a non-Human creature and you lose life equal to its toughness",
    "players": [ { "hand": ["Dire Tactics"], "battlefield": ["Plains", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Dire Tactics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 18 }, { "exile": ["Grizzly Bears"] } ] }
  },
  {
    "name": "controlling a Human: no life lost",
    "players": [ { "hand": ["Dire Tactics"], "battlefield": ["Plains", "Swamp", { "name": "Disciple of Law", "sick": false }] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Dire Tactics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20 }, { "exile": ["Grizzly Bears"] } ] }
  },
  {
    "name": "life loss uses the toughness the creature had (1 for Discordant Piper)",
    "players": [ { "hand": ["Dire Tactics"], "battlefield": ["Plains", "Swamp"] }, { "battlefield": ["Discordant Piper"] } ],
    "steps": [
      { "cast": "Dire Tactics", "targets": ["Discordant Piper"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 19 }, { "exile": ["Discordant Piper"] } ] }
  },
  {
    "name": "ruling: toughness is the last value on the battlefield (a +1/+1 counter makes it 3)",
    "players": [ { "hand": ["Dire Tactics"], "battlefield": ["Plains", "Swamp"] }, { "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] } ],
    "steps": [
      { "cast": "Dire Tactics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 17 }, { "exile": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: a Human exiled by the target creature returns before the Human check, so no life is lost",
    "players": [ { "hand": ["Dire Tactics"], "battlefield": ["Plains", "Swamp", "Disciple of Law"] }, { "hand": ["Banisher Priest"], "battlefield": ["Plains", "Plains", "Plains"] } ],
    "steps": [
      { "advance_to": "Main1" },
      { "cast": "Banisher Priest", "player": 1 },
      { "resolve": true },
      { "pass": true, "player": 1 },
      { "cast": "Dire Tactics", "targets": ["Banisher Priest"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Disciple of Law"] }, { "exile": ["Banisher Priest"] } ] }
  }
]
