[
  {
    "name": "untaps a tapped land",
    "players": [
      { "battlefield": ["Blossom Dryad", "Forest"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Forest" },
      { "activate": "Blossom Dryad", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Blossom Dryad", "Forest"] }, {} ],
      "tapped": { "Forest": false, "Blossom Dryad": true }
    }
  },
  {
    "name": "its own tap cost: cannot activate again while tapped",
    "players": [
      { "battlefield": ["Blossom Dryad", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Blossom Dryad", "targets": ["Forest"] },
      { "resolve": true },
      { "activate": "Blossom Dryad", "targets": ["Forest"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Blossom Dryad", "Forest"] }, {} ]
    }
  }
]
