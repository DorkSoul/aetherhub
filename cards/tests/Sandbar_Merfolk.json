[
 { "name": "cycles for {2} and draws a card",
   "players": [ { "hand": ["Sandbar Merfolk"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "activate": "Sandbar Merfolk", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Sandbar Merfolk"], "hand_count": 1 }, {} ] } },
 { "name": "cannot cycle with only one land",
   "players": [ { "hand": ["Sandbar Merfolk"], "battlefield": ["Island"] }, {} ],
   "steps": [ { "activate": "Sandbar Merfolk", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Sandbar Merfolk"] }, {} ] } },
 { "name": "ruling: Stifle can counter the cycling ability: the card is discarded but nothing is drawn",
   "players": [ { "hand": ["Sandbar Merfolk"], "battlefield": ["Island", "Island"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
   "steps": [ { "activate": "Sandbar Merfolk", "ability": 0 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Sandbar Merfolk" }] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Sandbar Merfolk"], "hand_count": 0 }, { "graveyard_has": ["Stifle"] } ] } },
 { "name": "ruling: Remove Soul cannot counter cycling because the cycling ability is not a spell",
   "players": [ { "hand": ["Sandbar Merfolk"], "battlefield": ["Island", "Island"] }, { "hand": ["Remove Soul"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "activate": "Sandbar Merfolk", "ability": 0 }, { "pass": true }, { "cast": "Remove Soul", "player": 1, "illegal": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Sandbar Merfolk"], "hand_count": 1 }, { "hand": ["Remove Soul"] } ] } }
]
