[
  {
    "name": "cast two cheap sorceries free; the rest go to the bottom",
    "players": [
      { "hand": ["Collected Conjuring"], "battlefield": ["Island", "Island", "Mountain", "Mountain"], "library": ["Divination", "Divination", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [{ "cast": "Collected Conjuring" }, { "resolve": true, "answers": [["Divination", "Divination"]] }],
    "expect": { "players": [{ "hand_count": 4, "graveyard": ["Collected Conjuring", "Divination", "Divination"], "exile": [] }, {}] }
  },
  {
    "name": "casting none leaves everything on the bottom",
    "players": [
      { "hand": ["Collected Conjuring"], "battlefield": ["Island", "Island", "Mountain", "Mountain"], "library": ["Divination", "Divination", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [{ "cast": "Collected Conjuring" }, { "resolve": true, "answers": [[]] }],
    "expect": { "players": [{ "hand_count": 0, "graveyard": ["Collected Conjuring"] }, {}] }
  },
  {
    "name": "ruling: exiled cards not cast go to the library bottom and cannot be cast later",
    "players": [
      { "hand": ["Collected Conjuring"], "battlefield": ["Island", "Island", "Mountain", "Mountain"], "library": ["Divination", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [{ "cast": "Collected Conjuring" }, { "resolve": true, "answers": [[]] }, { "cast": "Divination", "illegal": true }],
    "expect": { "players": [{ "hand_count": 0, "library_count": 12, "exile": [] }, {}] }
  },
  {
    "name": "ruling: a mandatory discard is still paid when the spell is cast without paying its mana cost",
    "players": [
      { "hand": ["Collected Conjuring", "Grizzly Bears"], "battlefield": ["Island", "Island", "Mountain", "Mountain"], "library": ["Tormenting Voice", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [{ "cast": "Collected Conjuring" }, { "resolve": true, "answers": [["Tormenting Voice"]] }, { "resolve": true }],
    "expect": { "players": [{ "hand_count": 2, "graveyard": ["Collected Conjuring", "Tormenting Voice", "Grizzly Bears"] }, {}] }
  }
]
