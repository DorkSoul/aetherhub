    "expect": { "players": [ { "battlefield_has": ["Mountain", "Plains", "Murasa Rootgrazer"], "hand_count": 0 }, {} ] }
  },
  { "name": "ruling: a tapped-for-ability attacker stays in combat and still deals combat damage",
    "players": [ { "battlefield": ["Murasa Rootgrazer", "Forest"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Murasa Rootgrazer", "at": "p1" } ] },
