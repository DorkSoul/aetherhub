[
  {
    "name": "enchanted creature becomes a 1/1 Citizen with defender and loses its abilities",
    "players": [
      { "hand": ["Spider-Man No More"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Spider-Man No More", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Spider-Man No More"] }, { "battlefield_has": ["Serra Angel"] } ],
      "pt": { "Serra Angel": [1, 1] },
      "keywords": { "Serra Angel": ["Defender"] }
    }
  },
  {
    "name": "enchanted creature can't attack",
    "players": [
      { "hand": ["Spider-Man No More"], "battlefield": ["Island", "Island", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Spider-Man No More", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ], "illegal": true }
    ],
    "expect": {
      "players": [ {}, {} ]
    }
  },
  {
    "name": "SetTypes: the enchanted Serra Angel is a Citizen and no longer an Angel",
    "players": [
      { "hand": ["Spider-Man No More"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Spider-Man No More", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "subtypes": { "Serra Angel": ["Citizen"] },
      "not_subtypes": { "Serra Angel": ["Angel"] }
    }
  },
  {
    "name": "RemoveAbilities: the enchanted Serra Angel lost flying, so it cannot block a creature only fliers and reach can block",
    "players": [
      { "hand": ["Spider-Man No More"], "battlefield": ["Island", "Island", "Spire Tracer"] },
      { "battlefield": ["Serra Angel", "Giant Spider"] }
    ],
    "steps": [
      { "cast": "Spider-Man No More", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "attack": [ { "card": "Spire Tracer", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Spire Tracer" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ]
    }
  }
