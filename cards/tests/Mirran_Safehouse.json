[
  {
    "name": "taps for mana using the mana ability of a Plains in a graveyard",
    "players": [
      {
        "battlefield": [
          "Mirran Safehouse"
        ],
        "graveyard": [
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Mirran Safehouse",
        "color": "W"
      }
    ],
    "expect": {
      "tapped": {
        "Mirran Safehouse": true
      }
    }
  },
  {
    "name": "land cards in an opponent's graveyard also give their abilities",
    "players": [
      {
        "battlefield": [
          "Mirran Safehouse"
        ]
      },
      {
        "graveyard": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "tap_for_mana": "Mirran Safehouse",
        "color": "W"
      }
    ],
    "expect": {
      "tapped": {
        "Mirran Safehouse": true
      }
    }
  },
  {
    "name": "non-land cards in graveyards give no abilities",
    "players": [
      {
        "battlefield": [
          "Mirran Safehouse"
        ],
        "graveyard": [
          "Shivan Dragon",
          "Shadowspear"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Mirran Safehouse",
        "ability": 32768,
        "illegal": true
      }
    ],
    "expect": {
      "tapped": {
        "Mirran Safehouse": false
      }
    }
  },
  {
    "name": "no lands in any graveyard means no granted abilities",
    "players": [
      {
        "battlefield": [
          "Mirran Safehouse",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Mirran Safehouse",
        "ability": 32768,
        "illegal": true
      }
    ],
    "expect": {
      "tapped": {
        "Mirran Safehouse": false
      }
    }
  },
  {
    "name": "ruling: a basic Island in a graveyard grants its intrinsic blue mana ability",
    "players": [
      {
        "battlefield": ["Mirran Safehouse"],
        "graveyard": ["Island"]
      },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Mirran Safehouse", "color": "U" }
    ],
    "expect": {
      "tapped": { "Mirran Safehouse": true }
    }
  }
]