[
  {
    "name": "gets -4/-0 when you control an outlaw, and you draw",
    "players": [
      {
        "hand": ["Take the Fall"],
        "battlefield": ["Island", "Talas Air Ship"],
        "library": ["Forest"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Take the Fall", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Forest"] }, {}],
      "pt": { "Grizzly Bears": [-2, 2] }
    }
  },
  {
    "name": "gets only -1/-0 without an outlaw",
    "players": [
      {
        "hand": ["Take the Fall"],
        "battlefield": ["Island", "Llanowar Elves"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Take the Fall", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Hill Giant": [2, 3] }
    }
  },
  {
    "name": "ruling: an outlaw card in hand does not count (only battlefield)",
    "players": [
      { "hand": ["Take the Fall", "Talas Air Ship"], "battlefield": ["Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Take the Fall", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Grizzly Bears": [1, 2] }
    }
  }
]
