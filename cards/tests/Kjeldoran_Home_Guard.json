[
  {
    "name": "attacked this combat: at end of combat it gets a -0/-1 counter and a 0/1 Deserter token",
    "players": [
      { "battlefield": [ { "name": "Kjeldoran Home Guard", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Kjeldoran Home Guard", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "EndCombat" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Kjeldoran Home Guard": [1, 5] },
      "players": [ { "battlefield_has": ["Deserter 0-1 White"] }, {} ]
    }
  },
  {
    "name": "did not attack or block: no counter and no token at end of combat",
    "players": [
      { "battlefield": [ { "name": "Kjeldoran Home Guard", "sick": false } ] },
      {}
    ],
    "steps": [
      { "advance_to": "EndCombat" }
    ],
    "expect": {
      "pt": { "Kjeldoran Home Guard": [1, 6] },
      "players": [ { "battlefield_has": ["Kjeldoran Home Guard"] }, {} ]
    }
  },
  {
    "name": "ruling: killed in combat before end of combat, no counter and no token",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", { "name": "Kjeldoran Home Guard", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Kjeldoran Home Guard", "at": "p1" } ] },
      { "block": [] },
      { "cast": "Murder", "targets": ["Kjeldoran Home Guard"] },
      { "resolve": true },
      { "advance_to": "EndCombat" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Kjeldoran Home Guard"], "battlefield_lacks": ["Deserter 0-1 White"] }, {} ] }
  },
  {
    "name": "ruling: Deserter still made when the Guard leaves in response to its end-of-combat trigger",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", { "name": "Kjeldoran Home Guard", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Kjeldoran Home Guard", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "EndCombat" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Murder", "targets": ["Kjeldoran Home Guard"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Kjeldoran Home Guard"], "battlefield_has": ["Deserter 0-1 White"] }, {} ] }
  }
]
