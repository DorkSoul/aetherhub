[
 {
  "name": "copies a legendary planeswalker's loyalty ability on the stack (same target)",
  "players": [
   {
    "battlefield": [
     "The Peregrine Dynamo",
     { "name": "Ajani Vengeant", "counters": { "Loyalty": 3 } },
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   { "activate": "Ajani Vengeant", "ability": 1, "targets": ["p1"] },
   { "activate": "The Peregrine Dynamo" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 14 }
   ],
   "tapped": { "The Peregrine Dynamo": true },
   "counters": { "Ajani Vengeant": { "Loyalty": 1 } }
  }
 },
 {
  "name": "the Dynamo cannot copy an ability from a non-legendary source",
  "players": [
   {
    "battlefield": [
     "The Peregrine Dynamo",
     { "name": "Prodigal Sorcerer", "sick": false },
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   { "activate": "Prodigal Sorcerer", "targets": ["p1"] },
   { "activate": "The Peregrine Dynamo", "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 19 }
   ],
   "tapped": { "The Peregrine Dynamo": false }
  }
 },
 {
  "name": "the Dynamo's own ability is not a legal target (needs another legendary source)",
  "players": [
   {
    "battlefield": [
     "The Peregrine Dynamo",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   { "activate": "The Peregrine Dynamo", "illegal": true }
  ],
  "expect": {
   "tapped": { "The Peregrine Dynamo": false }
  }
 },
 {
  "name": "ruling: the copy still resolves after its source Ajani Vengeant leaves (same source)",
  "players": [
   {
    "battlefield": [
     "The Peregrine Dynamo",
     { "name": "Ajani Vengeant", "counters": { "Loyalty": 5 } },
     "Mountain"
    ]
   },
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Mountain"]
   }
  ],
  "steps": [
   { "activate": "Ajani Vengeant", "ability": 1, "targets": ["p1"] },
   { "activate": "The Peregrine Dynamo" },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Ajani Vengeant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Ajani Vengeant"] },
    { "life": 14 }
   ]
  }
 }
]
