[
  {
    "name": "+2 deals 2 damage to each opponent",
    "players": [
      { "battlefield": ["Chandra, Pyrogenius"] },
      {}
    ],
    "steps": [
      { "activate": "Chandra, Pyrogenius", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "counters": { "Chandra, Pyrogenius": { "loyalty": 7 } }
    }
  },
  {
    "name": "-3 deals 4 damage to target creature",
    "players": [
      { "battlefield": ["Chandra, Pyrogenius"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "activate": "Chandra, Pyrogenius", "ability": 1, "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Serra Angel"] }],
      "counters": { "Chandra, Pyrogenius": { "loyalty": 2 } }
    }
  },
  {
    "name": "-10 deals 6 to target player and each creature they control",
    "players": [ { "battlefield": [ { "name": "Chandra, Pyrogenius", "counters": { "loyalty": 10 } } ] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "activate": "Chandra, Pyrogenius", "ability": 2, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Chandra, Pyrogenius"] }, { "life": 14, "battlefield_lacks": ["Grizzly Bears", "Hill Giant"] } ] }
  },
  {
    "name": "-10 is illegal at nine loyalty",
    "players": [ { "battlefield": [ { "name": "Chandra, Pyrogenius", "counters": { "loyalty": 9 } } ] }, {} ],
    "steps": [ { "activate": "Chandra, Pyrogenius", "ability": 2, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ], "counters": { "Chandra, Pyrogenius": { "loyalty": 9 } } }
  },
  {
    "name": "ruling: -10 is not targeted at creatures, so it still damages a hexproof Angelic Overseer",
    "players": [
      { "battlefield": [ { "name": "Chandra, Pyrogenius", "counters": { "loyalty": 10 } } ] },
      { "battlefield": ["Angelic Overseer", "Angelfire Crusader"] }
    ],
    "steps": [ { "activate": "Chandra, Pyrogenius", "ability": 2, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Chandra, Pyrogenius"] }, { "life": 14, "graveyard_has": ["Angelic Overseer", "Angelfire Crusader"] } ] }
  }
]
