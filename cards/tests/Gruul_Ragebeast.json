[
  {
    "name": "entering creature fights the opposing creature",
    "players": [
      { "hand": ["Gruul Ragebeast"], "battlefield": ["Mountain", "Forest", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Gruul Ragebeast" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Gruul Ragebeast"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "another creature you control entering fights too",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Gruul Ragebeast", "Forest", "Forest"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: no opposing creature when it enters: the trigger is removed, nothing fights",
    "players": [
      { "hand": ["Gruul Ragebeast"], "battlefield": ["Mountain", "Forest", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Gruul Ragebeast" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Gruul Ragebeast"], "life": 20 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: if the entering creature leaves before the fight resolves, no fight happens",
    "players": [
      { "hand": ["Gruul Ragebeast"], "battlefield": ["Mountain", "Forest", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "hand": ["Murder"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Gruul Ragebeast" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Gruul Ragebeast"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Gruul Ragebeast"] },
        { "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Swamp"], "graveyard": ["Murder"] }
      ]
    }
  }
]
