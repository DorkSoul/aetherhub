[
 { "name": "prevents the next damage from a blue source",
   "players": [ { "battlefield": ["Air Elemental"] },
                { "battlefield": ["Rune of Protection: Blue", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Air Elemental", "at": "p1" } ] },
              { "pass": true },
              { "activate": "Rune of Protection: Blue", "player": 1 },
              { "resolve": true },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "a non-blue attacker is not prevented",
   "players": [ { "battlefield": ["Grizzly Bears"] },
                { "battlefield": ["Rune of Protection: Blue", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "pass": true },
              { "activate": "Rune of Protection: Blue", "player": 1 },
              { "resolve": true },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 {
  "name": "cycling {2}: discard it and draw a card",
  "players": [{"hand": ["Rune of Protection: Blue"], "battlefield": ["Island", "Island"], "library": ["Hill Giant"]}, {}],
  "steps": [{"activate": "Rune of Protection: Blue", "ability": 1}, {"resolve": true}],
  "expect": {"players": [{"hand": ["Hill Giant"], "graveyard_has": ["Rune of Protection: Blue"]}, {}]}
 },
 {
  "name": "cycling needs {2}: one Island is not enough",
  "players": [{"hand": ["Rune of Protection: Blue"], "battlefield": ["Island"]}, {}],
  "steps": [{"activate": "Rune of Protection: Blue", "ability": 1, "illegal": true}],
  "expect": {"players": [{"hand": ["Rune of Protection: Blue"]}, {}]}
 },
 {
  "name": "ruling: can be activated before combat with no damage pending, and still prevents the later damage",
  "players": [ { "battlefield": ["Air Elemental"] },
               { "battlefield": ["Rune of Protection: Blue", "Plains"] } ],
  "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
             { "pass": true },
             { "activate": "Rune of Protection: Blue", "player": 1 },
             { "resolve": true },
             { "attack": [ { "card": "Air Elemental", "at": "p1" } ] },
             { "block": [] },
             { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 20 } ] } },
 {
  "name": "ruling: a blue source with 0 power is a legal choice; the chosen source is the one prevented",
  "players": [ { "battlefield": ["Air Elemental", "Wall of Frost"] },
               { "battlefield": ["Rune of Protection: Blue", "Plains"] } ],
  "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
             { "attack": [ { "card": "Air Elemental", "at": "p1" } ] },
             { "pass": true },
             { "activate": "Rune of Protection: Blue", "player": 1 },
             { "resolve": true, "answers": ["Wall of Frost"] },
             { "block": [] },
             { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 16 } ] } }
]
