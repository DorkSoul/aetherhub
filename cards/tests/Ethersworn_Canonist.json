[
 { "name": "second nonartifact spell is barred",
   "players": [ { "hand": ["Grizzly Bears", "Hill Giant"], "battlefield": ["Ethersworn Canonist", "Forest", "Snow-Covered Forest", "Mountain", "Swamp", "Plains"] }, {} ],
   "steps": [ { "tap_for_mana": "Forest" }, { "tap_for_mana": "Snow-Covered Forest" }, { "cast": "Grizzly Bears" }, { "resolve": true },
              { "tap_for_mana": "Mountain" }, { "tap_for_mana": "Swamp" }, { "tap_for_mana": "Plains" }, { "cast": "Hill Giant", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "artifact spells are still allowed after a nonartifact spell",
   "players": [ { "hand": ["Grizzly Bears", "Sol Ring"], "battlefield": ["Ethersworn Canonist", "Forest", "Snow-Covered Forest", "Mountain"] }, {} ],
   "steps": [ { "tap_for_mana": "Forest" }, { "tap_for_mana": "Snow-Covered Forest" }, { "cast": "Grizzly Bears" }, { "resolve": true },
              { "tap_for_mana": "Mountain" }, { "cast": "Sol Ring" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Sol Ring"] }, {} ] } },
 { "name": "after a nonartifact spell, a second nonartifact instant (Lightning Bolt) is barred",
   "players": [ { "hand": ["Grizzly Bears", "Lightning Bolt"], "battlefield": ["Ethersworn Canonist", "Forest", "Snow-Covered Forest", "Mountain"] }, {} ],
   "steps": [ { "tap_for_mana": "Forest" }, { "tap_for_mana": "Snow-Covered Forest" }, { "cast": "Grizzly Bears" }, { "resolve": true },
              { "cast": "Lightning Bolt", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "hand": ["Lightning Bolt"] }, {} ] } },
 { "name": "ruling: a spell cast earlier this turn counts even if Canonist entered afterwards (Canonist itself is an artifact spell)",
   "players": [ { "hand": ["Lightning Bolt", "Ethersworn Canonist", "Grizzly Bears"], "battlefield": ["Mountain", "Plains", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
              { "cast": "Ethersworn Canonist" }, { "resolve": true },
              { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ethersworn Canonist"], "hand": ["Grizzly Bears"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
 { "name": "ruling: the restriction is per player; the opponent may still cast one nonartifact spell",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Ethersworn Canonist", "Mountain"] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true },
              { "player": 1, "cast": "Shock", "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 18, "graveyard": ["Lightning Bolt"] }, { "life": 17, "graveyard": ["Shock"] } ] } }
