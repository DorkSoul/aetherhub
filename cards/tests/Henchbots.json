   "expect": { "players": [ { "battlefield_lacks": ["Henchbots"], "graveyard": ["Henchbots"] }, { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Murder"] } ] }
  },
  {
   "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard",
   "players": [ { "hand": ["Pacifism", "Henchbots"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Henchbots" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Henchbots"], "graveyard": ["Pacifism"] }, { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] } ] }
  }
