  { "name": "an untapped creature cannot be targeted",
    "players": [ { "hand": ["Henchbots"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Henchbots" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Henchbots"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  {
   "name": "ruling: Henchbots leaving before its trigger resolves: the target is not exiled",
