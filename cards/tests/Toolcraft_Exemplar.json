[
  { "name": "gets +2/+1 at the beginning of combat when you control an artifact",
    "players": [ { "battlefield": ["Toolcraft Exemplar", "Ornithopter"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Toolcraft Exemplar": [3, 2] } } },
  { "name": "gains first strike with three or more artifacts",
    "players": [ { "battlefield": ["Toolcraft Exemplar", "Ornithopter", "Ornithopter", "Sol Ring"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Toolcraft Exemplar": [3, 2] }, "keywords": { "Toolcraft Exemplar": ["FirstStrike"] } } },
  { "name": "no trigger without an artifact",
    "players": [ { "battlefield": ["Toolcraft Exemplar"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" } ],
    "expect": { "players": [ {}, {} ], "pt": { "Toolcraft Exemplar": [1, 1] } } },
  { "name": "ruling: artifact count for first strike is checked only as the trigger resolves (3 at trigger, 2 at resolution: no first strike, still +2/+1)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Toolcraft Exemplar", "Ornithopter", "Ornithopter", "Sol Ring", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "BeginCombat", "hold": true }, { "cast": "Lightning Bolt", "targets": ["Ornithopter"] }, { "pass": true }, { "pass": true }, { "resolve": true },
               { "attack": [ { "card": "Toolcraft Exemplar", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Toolcraft Exemplar" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Toolcraft Exemplar", "Ornithopter"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: if no artifact is controlled when the trigger resolves, the ability has no effect (Exemplar stays 1/1)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Toolcraft Exemplar", "Ornithopter", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "hold": true }, { "cast": "Lightning Bolt", "targets": ["Ornithopter"] }, { "pass": true }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Ornithopter"] }, {} ], "pt": { "Toolcraft Exemplar": [1, 1] } } }
]
