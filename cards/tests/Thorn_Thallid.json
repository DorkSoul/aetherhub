[
  {
    "name": "removes three spore counters to deal 1 damage",
    "players": [
      { "battlefield": [{ "name": "Thorn Thallid", "counters": { "spore": 3 } }] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Thorn Thallid", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Llanowar Elves"] }],
      "counters": { "Thorn Thallid": { "spore": 0 } }
    }
  },
  {
    "name": "two spore counters are not enough",
    "players": [
      { "battlefield": [{ "name": "Thorn Thallid", "counters": { "spore": 2 } }] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Thorn Thallid", "targets": ["Llanowar Elves"], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "battlefield": ["Llanowar Elves"] }],
      "counters": { "Thorn Thallid": { "spore": 2 } }
    }
  },
  {
    "name": "gets a spore counter in your upkeep",
    "players": [
      { "battlefield": ["Thorn Thallid"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "counters": { "Thorn Thallid": { "spore": 1 } }
    }
  }
]
