   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [{ "card": "Snapping Thragg", "at": "p1" }] },
   { "block": [] },
   { "advance_to": "Main2", "answers": [true] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 17, "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "declining the optional damage leaves the creature alive",
  "players": [
   { "battlefield": ["Snapping Thragg"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [{ "card": "Snapping Thragg", "at": "p1" }] },
   { "block": [] },
   { "advance_to": "Main2", "answers": [false] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 17, "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "face-down morph turns face up for {4}{R}{R} and is a 3/3",
  "players": [{ "battlefield": [{ "name": "Snapping Thragg", "face_down": true }, "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {}],
  "steps": [{ "activate": "Snapping Thragg", "ability": 0 }, { "resolve": true }],
  "expect": { "pt": { "Snapping Thragg": [3, 3] } }
 },
 {
  "name": "cannot turn face up with only five mana",
  "players": [{ "battlefield": [{ "name": "Snapping Thragg", "face_down": true }, "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {}],
  "steps": [{ "activate": "Snapping Thragg", "ability": 0, "illegal": true }],
  "expect": { "pt": { "Snapping Thragg": [2, 2] } }
 },
 {
  "name": "turning face up costs all six mana: no mana is left for a Bolt",
  "players": [{ "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Snapping Thragg", "face_down": true }, "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {}],
  "steps": [{ "activate": "Snapping Thragg", "ability": 0 }, { "resolve": true }, { "cast": "Lightning Bolt", "illegal": true }],
  "expect": { "pt": { "Snapping Thragg": [3, 3] }, "players": [{ "hand": ["Lightning Bolt"] }, {}] }
 }
]
