 {
  "name": "ruling: a land that enters after the spell resolves is not a creature",
  "players": [
   {
    "hand": ["Sylvan Awakening", "Mountain"],
    "battlefield": ["Forest", "Forest", "Forest", "Plains"]
   },
   {}
  ],
  "steps": [
   { "cast": "Sylvan Awakening" },
   { "resolve": true },
   { "play_land": "Mountain" }
  ],
  "expect": {
   "subtypes": { "Plains": ["Elemental"] },
   "not_subtypes": { "Mountain": ["Elemental"] }
  }
 },
 {
  "name": "ruling: lands that become creatures do not untap",
  "players": [
   {
    "hand": ["Sylvan Awakening"],
    "battlefield": ["Forest", "Forest", "Forest", { "name": "Plains", "tapped": true }]
   },
   {}
  ],
  "steps": [
   { "cast": "Sylvan Awakening" },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Plains": true },
   "subtypes": { "Plains": ["Elemental"] }
  }
 },
 {
  "name": "ruling: the lands stop being creatures as your next untap step begins",
  "players": [
