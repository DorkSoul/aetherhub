[
  {
    "name": "other creatures you control have evolve",
    "players": [ { "battlefield": ["Tyranid Prime", "Grizzly Bears"] }, {} ],
    "steps": [],
    "expect": {
      "keywords": { "Grizzly Bears": ["Evolve"] },
      "players": [ {}, {} ]
    }
  },
  {
    "name": "a bigger creature entering makes it evolve",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Tyranid Prime"] }, {} ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Tyranid Prime": { "p1p1": 1 } },
      "pt": { "Tyranid Prime": [1, 5] }
    }
  },
  {
    "name": "ruling: counters on a creature entering count for evolve (Walking Ballista X=2 is a 2/2)",
    "players": [ { "hand": ["Walking Ballista"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Tyranid Prime"] }, {} ],
    "steps": [ { "cast": "Walking Ballista", "answers": [2] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Tyranid Prime": [1, 5] } }
  },
  {
    "name": "ruling: a creature with no greater power or toughness does not make evolve grow it",
    "players": [ { "hand": ["Wall of Wood"], "battlefield": ["Forest", "Tyranid Prime"] }, {} ],
    "steps": [ { "cast": "Wall of Wood" }, { "resolve": true } ],
    "expect": { "pt": { "Tyranid Prime": [0, 4] } }
  },
  {
    "name": "ruling: toughness is compared to toughness (a 0/7 wall still makes evolve grow it)",
    "players": [ { "hand": ["Wall of Ice"], "battlefield": ["Forest", "Forest", "Forest", "Tyranid Prime"] }, {} ],
    "steps": [ { "cast": "Wall of Ice" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Tyranid Prime": [1, 5] } }
  },
  {
    "name": "ruling: evolve uses the last known P/T when the entering creature dies in response",
    "players": [ { "hand": ["Hill Giant", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Tyranid Prime"] }, {} ],
    "steps": [ { "cast": "Hill Giant" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "pt": { "Tyranid Prime": [1, 5] } }
  }
]
