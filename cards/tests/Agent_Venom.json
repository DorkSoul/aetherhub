[
 {
  "name": "another nontoken creature you control dies: draw and lose 1 life",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Agent Venom", "Grizzly Bears", "Mountain"] },
   {}
  ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "life": 19, "hand_count": 1, "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, {} ] }
 },
 {
  "name": "itself dying does not trigger",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Agent Venom", "Mountain"] },
   {}
  ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Agent Venom"] }, { "resolve": true } ],
  "expect": { "players": [ { "life": 20, "hand_count": 0, "graveyard": ["Lightning Bolt", "Agent Venom"] }, {} ] }
 },
 {
  "name": "opponent's creature dying does not trigger",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Agent Venom", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "life": 20, "hand_count": 0 }, { "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: simultaneous death with Agent Venom triggers once per other creature",
  "players": [
   { "hand": ["Languish"], "battlefield": ["Agent Venom", "Grizzly Bears", "Kor Skyfisher", "Swamp", "Swamp", "Swamp", "Swamp"] },
   {}
  ],
  "steps": [ { "cast": "Languish" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 18, "hand_count": 2, "graveyard": ["Languish", "Agent Venom", "Grizzly Bears", "Kor Skyfisher"] }, {} ] }
 }
