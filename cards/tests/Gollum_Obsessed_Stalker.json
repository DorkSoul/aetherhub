[
  {
    "name": "an opponent it damaged loses life equal to the life you gained this turn",
    "players": [ { "hand": ["Revitalize"], "battlefield": ["Gollum, Obsessed Stalker", "Plains", "Plains"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Gollum, Obsessed Stalker", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Revitalize" }, { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 23 }, { "life": 16 } ] }
  },
  {
    "name": "never damaged: no life loss",
    "players": [ { "hand": ["Revitalize"], "battlefield": ["Gollum, Obsessed Stalker", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Revitalize" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "life": 23 }, { "life": 20 } ] }
  },
  {
    "name": "ruling: the life counted is the total gained this turn, ignoring life lost earlier in the turn",
    "players": [ { "hand": ["Revitalize", "Lightning Bolt"], "battlefield": ["Gollum, Obsessed Stalker", "Plains", "Plains", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Gollum, Obsessed Stalker", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Revitalize" }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 16 } ] }
  }
