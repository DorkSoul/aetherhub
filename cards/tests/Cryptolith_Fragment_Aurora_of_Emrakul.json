[
  {
    "name": "tap for any color: each player loses 1 life",
    "players": [
      { "battlefield": ["Cryptolith Fragment // Aurora of Emrakul"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Cryptolith Fragment // Aurora of Emrakul", "color": "U" }
    ],
    "expect": {
      "players": [
        { "life": 19, "pool": { "U": 1 } },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "enters tapped",
    "players": [
      { "hand": ["Cryptolith Fragment // Aurora of Emrakul"], "battlefield": ["Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Cryptolith Fragment // Aurora of Emrakul" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Cryptolith Fragment // Aurora of Emrakul"] },
        {}
      ],
      "tapped": { "Cryptolith Fragment // Aurora of Emrakul": true }
    }
  },
  {
    "name": "upkeep with both players at 10 or less life: transforms into Aurora of Emrakul (1/4 flying deathtouch)",
    "players": [
      { "life": 10, "battlefield": ["Cryptolith Fragment // Aurora of Emrakul"] },
      { "life": 10 }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Aurora of Emrakul"] },
        {}
      ],
      "pt": { "Aurora of Emrakul": [1, 4] },
      "keywords": { "Aurora of Emrakul": ["Flying", "Deathtouch"] }
    }
  },
  {
    "name": "upkeep with an 11-life player: does not transform",
    "players": [
      { "life": 11, "battlefield": ["Cryptolith Fragment // Aurora of Emrakul"] },
      { "life": 10 }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Cryptolith Fragment // Aurora of Emrakul"], "life": 11 },
        {}
      ]
    }
  },
  {
    "name": "Aurora of Emrakul attacks: each opponent loses 3 (plus 1 unblocked combat damage)",
    "players": [ { "battlefield": [ { "name": "Aurora of Emrakul", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Aurora of Emrakul", "at": "p1" } ] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "ruling: tapping for mana is a mana ability, so the life loss happens without using the stack",
    "players": [
      { "battlefield": ["Cryptolith Fragment // Aurora of Emrakul"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Cryptolith Fragment // Aurora of Emrakul", "color": "U" }
    ],
    "expect": {
      "stack_empty": true,
      "players": [
        { "life": 19, "pool": { "U": 1 } },
        { "life": 19 }
      ]
    }
  }
]
