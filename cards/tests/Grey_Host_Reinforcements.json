[
  {
    "name": "ETB exiles target player's graveyard and gets a +1/+1 counter for each creature card exiled",
    "players": [
      { "hand": [ "Grey Host Reinforcements" ], "battlefield": [ "Plains", "Plains", "Plains", "Plains" ] },
      { "graveyard": [ "Grizzly Bears", "Hill Giant", "Lightning Bolt" ] }
    ],
    "steps": [
      { "cast": "Grey Host Reinforcements" },
      { "resolve": true, "targets": [ "p1" ] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grey Host Reinforcements": { "p1p1": 2 } },
      "players": [
        { "battlefield_has": [ "Grey Host Reinforcements" ] },
        { "exile": [ "Grizzly Bears", "Hill Giant", "Lightning Bolt" ], "graveyard": [] }
      ]
    }
  },
  {
    "name": "no creature cards exiled means no counters",
    "players": [
      { "hand": [ "Grey Host Reinforcements" ], "battlefield": [ "Plains", "Plains", "Plains", "Plains" ] },
      { "graveyard": [ "Lightning Bolt" ] }
    ],
    "steps": [
      { "cast": "Grey Host Reinforcements" },
      { "resolve": true, "targets": [ "p1" ] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grey Host Reinforcements": { "p1p1": 0 } },
      "players": [
        { "battlefield_has": [ "Grey Host Reinforcements" ] },
        { "exile": [ "Lightning Bolt" ], "graveyard": [] }
      ]
    }
  },
  {
    "name": "ward {3}: opponent with no spare mana to pay has the Bolt countered, the 1/1 survives",
    "players": [
      { "battlefield": [ "Grey Host Reinforcements" ] },
      { "hand": [ "Lightning Bolt" ], "battlefield": [ "Mountain" ] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "player": 1, "cast": "Lightning Bolt", "targets": [ "Grey Host Reinforcements" ] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": [ "Grey Host Reinforcements" ] },
        { "graveyard": [ "Lightning Bolt" ] }
      ]
    }
  }
]
