[
  {
    "name": "returns a nonland permanent to its owner's hand",
    "players": [
      { "hand": ["Void Snare"], "battlefield": ["Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Void Snare" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Island"] }, { "hand": ["Grizzly Bears"], "battlefield": [] }]
    }
  },
  {
    "name": "cannot target a land",
    "players": [
      { "hand": ["Void Snare"], "battlefield": ["Island"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Void Snare", "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Void Snare"] }, { "battlefield": ["Forest"] }]
    }
  }
]
