[
  {
    "name": "destroys target artifact creature",
    "players": [
      { "battlefield": [{ "name": "Chandler", "sick": false }, "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Juggernaut"] }
    ],
    "steps": [
      { "activate": "Chandler", "targets": ["Juggernaut"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chandler"] },
        { "graveyard": ["Juggernaut"] }
      ]
    }
  },
  {
    "name": "no legal target without an artifact creature",
    "players": [
      { "battlefield": [{ "name": "Chandler", "sick": false }, "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Chandler", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chandler"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
