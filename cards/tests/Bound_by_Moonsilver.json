[
  {
    "name": "enchanted creature can't transform at night",
    "players": [
      {
        "hand": ["Bound by Moonsilver"],
        "battlefield": ["Plains", "Plains", "Plains", "Brutal Cathar"]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Bound by Moonsilver",
        "targets": ["Brutal Cathar"]
      },
      {
        "resolve": true
      },
      {
