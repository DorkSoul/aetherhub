[
  {
    "name": "whenever you attack, target gets +X/+X where X is the number of attackers",
    "players": [
      { "battlefield": [{ "name": "Marshal of the Lost", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Marshal of the Lost", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4], "Marshal of the Lost": [3, 3] }
    }
  },
  {
    "name": "deathtouch",
    "players": [
      { "battlefield": ["Marshal of the Lost"] },
      {}
    ],
    "steps": [],
    "expect": {
      "keywords": { "Marshal of the Lost": ["Deathtouch"] }
    }
  },
  {
    "name": "ruling: X counts only the attacking creatures when the trigger resolves",
    "players": [
      { "battlefield": [{ "name": "Marshal of the Lost", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Marshal of the Lost", "at": "p1" }] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
