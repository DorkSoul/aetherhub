[
  {
    "name": "destroyed at end of combat after attacking",
    "players": [
      { "battlefield": ["Ceremonial Guard"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Ceremonial Guard", "at": "p1" } ] },
      { "advance_to": "EndCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Ceremonial Guard"] }, { "life": 17 } ]
    }
  },
  {
    "name": "stays on the battlefield when it does not attack or block",
    "players": [
      { "battlefield": ["Ceremonial Guard"] },
      {}
    ],
    "steps": [
      { "advance_to": "EndCombat" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Ceremonial Guard"] }, {} ]
    }
  },
  {
    "name": "blocking destroys it at end of combat",
    "players": [
      { "battlefield": ["Ceremonial Guard"] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Ceremonial Guard", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "advance_to": "EndCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Ceremonial Guard"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
