      {}
    ],
    "steps": [
      { "activate": "Three Bowls of Porridge", "ability": 2 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 23, "battlefield_lacks": ["Three Bowls of Porridge"], "graveyard_has": ["Three Bowls of Porridge"] }, {} ] }
  },
  { "name": "each mode can be chosen only once: the damage mode is gone after it was used",
