      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "activate": "Three Bowls of Porridge", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "advance_to": "End", "auto": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Main1", "auto": true },
      { "activate": "Three Bowls of Porridge", "ability": 0, "illegal": true },
      { "activate": "Three Bowls of Porridge", "ability": 1 },
      { "resolve": true }
    ],
    "expect": { "turn": 3, "tapped": { "Serra Angel": true }, "players": [ {}, { "battlefield_has": ["Serra Angel"] } ] }
  },
  { "name": "the tap mode needs {2} as well as tapping the artifact",
    "players": [
      { "battlefield": ["Three Bowls of Porridge", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Three Bowls of Porridge", "ability": 1, "illegal": true }
