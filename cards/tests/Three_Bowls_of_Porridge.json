      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Three Bowls of Porridge", "ability": 1 },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true }, "players": [ { "battlefield_has": ["Three Bowls of Porridge"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
