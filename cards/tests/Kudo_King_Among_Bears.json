[
  {
    "name": "other creatures (any controller) become 2/2",
    "players": [
      {
        "battlefield": [
          "Kudo, King Among Bears",
          "Serra Angel"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Serra Angel": [
          2,
          2
        ],
        "Hill Giant": [
          2,
          2
        ],
        "Kudo, King Among Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "base P/T only: pump and counters still apply, not creatures lose anything",
    "players": [
      {
        "battlefield": [
          "Kudo, King Among Bears",
          "Serra Angel",
          "Forest"
        ],
        "hand": [
          "Giant Growth"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Serra Angel": [
          5,
          5
        ]
      }
    }
  },
  {
    "name": "other creatures are Bears in addition to their own types",
    "players": [ { "battlefield": ["Kudo, King Among Bears", "Serra Angel"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [],
    "expect": { "subtypes": { "Serra Angel": ["Angel", "Bear"], "Hill Giant": ["Giant", "Bear"] } }
  },
  {
    "name": "ruling: a +1/+1 counter still applies on top of Kudo's base 2/2",
    "players": [
      { "battlefield": ["Kudo, King Among Bears", { "name": "Serra Angel", "counters": { "p1p1": 1 } }] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Serra Angel": [3, 3]
      }
    }
  },
  {
    "name": "ruling: damage already marked becomes lethal when Kudo enters (Serra Angel 4/4 with 3 damage dies)",
    "players": [
      { "hand": ["Lightning Bolt", "Kudo, King Among Bears"], "battlefield": ["Mountain", "Forest", "Plains"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "cast": "Kudo, King Among Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Kudo, King Among Bears"] },
        { "graveyard_has": ["Serra Angel"] }
      ]
    }
  }
]
