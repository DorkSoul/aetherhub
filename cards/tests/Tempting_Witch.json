[
  { "name": "ETB creates a Food token",
    "players": [ { "hand": ["Tempting Witch"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Tempting Witch" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tempting Witch", "Food"] }, {} ] } },
  { "name": "{2},{T}, sacrifice a Food: target player loses 3 life",
    "players": [ { "battlefield": [{ "name": "Tempting Witch", "sick": false }, "Food", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Tempting Witch", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Tempting Witch"] }, { "life": 17 } ] } },
  { "name": "no Food to sacrifice: the ability can't be activated",
    "players": [ { "battlefield": [{ "name": "Tempting Witch", "sick": false }, "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Tempting Witch", "ability": 0, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "ruling: a Food artifact creature (Tough Cookie) can be sacrificed to the ability",
    "players": [ { "battlefield": [{ "name": "Tempting Witch", "sick": false }, "Tough Cookie", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Tempting Witch", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tempting Witch"], "graveyard_has": ["Tough Cookie"] }, { "life": 17 } ] } },
  { "name": "ruling: one Food can't pay both the Witch and Maraleaf Rider",
    "players": [ { "battlefield": [{ "name": "Tempting Witch", "sick": false }, { "name": "Maraleaf Rider", "sick": false }, "Food", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Tempting Witch", "ability": 0, "targets": ["p1"] }, { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Tempting Witch"], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tempting Witch", "Maraleaf Rider"] }, { "life": 17 } ] } }
]
