[
  { "name": "unblocked attack steals the defending player's land and deals no combat damage",
    "players": [ { "battlefield": ["Orcish Squatters"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "attack": [ { "card": "Orcish Squatters", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Orcish Squatters", "Forest"], "life": 20 }, { "battlefield": [], "life": 20 } ] } },
  { "name": "declining the optional trigger takes no land and the creature still deals damage",
    "players": [ { "battlefield": ["Orcish Squatters"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "attack": [ { "card": "Orcish Squatters", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2", "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Orcish Squatters"] }, { "battlefield_has": ["Forest"], "life": 18 } ] } },
  { "name": "a blocked attacker does not trigger the ability",
    "players": [ { "battlefield": ["Orcish Squatters"] }, { "battlefield": ["Forest", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Orcish Squatters", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Orcish Squatters" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Orcish Squatters"] }, { "battlefield_has": ["Forest"], "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an unblocked Squatters triggers even though another attacker was blocked",
    "players": [ { "battlefield": ["Orcish Squatters", "Savannah Lions"] }, { "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Orcish Squatters", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Savannah Lions" } ] }, { "advance_to": "Main2", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Orcish Squatters", "Mountain"] }, { "battlefield_lacks": ["Mountain"] } ] } },
  { "name": "ruling: Squatters destroyed in response to its trigger, the controller gains no land",
    "players": [ { "battlefield": ["Orcish Squatters"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Orcish Squatters", "at": "p1" } ] }, { "block": [] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Orcish Squatters"] }, { "pass": true }, { "pass": true }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard_has": ["Orcish Squatters"], "battlefield_lacks": ["Mountain"] }, { "battlefield_has": ["Mountain"] } ] } }
]
