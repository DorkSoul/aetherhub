[
 {
  "name": "end step makes a 1/1 Sculpture",
  "players": [
   {
    "battlefield": [
     "Doomed Artisan"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Sculpture"
     ]
    }
   ],
   "pt": {
    "Sculpture": [
     1,
     1
    ],
    "Doomed Artisan": [
     1,
     1
    ]
   }
  }
 },
 {
  "name": "two Sculptures are each 2/2",
  "players": [
   {
    "battlefield": [
     "Doomed Artisan",
     "Sculpture"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Sculpture": [
     2,
     2
    ]
   }
  }
 },
 {
  "name": "only on its controller's end step",
  "players": [
   {
    "battlefield": [
     "Doomed Artisan"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "turn": 2,
   "players": [
    {
     "battlefield_has": [
      "Sculpture"
     ]
    }
   ],
   "pt": {
    "Sculpture": [
     1,
     1
    ]
   }
  }
 },
 {
  "name": "Sculptures can't attack",
  "players": [
   {
    "battlefield": [
     "Doomed Artisan",
     "Sculpture"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Sculpture",
      "at": "p1"
     }
    ]
   },
   {
    "block": []
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 20
    }
   ]
  }
 },
 {
  "name": "Sculptures can't block",
  "players": [
   {
    "battlefield": [
     "Hill Giant"
    ]
   },
   {
    "battlefield": [
     "Sculpture",
     "Doomed Artisan"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Hill Giant",
      "at": "p1"
     }
    ]
   },
   {
    "block": [
     {
      "blocker": "Sculpture",
      "attacker": "Hill Giant"
     }
    ],
    "player": 1
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 17
    }
   ]
  }
 },
 {
  "name": "ruling: once Doomed Artisan has left the battlefield, its Sculptures can attack again",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Doomed Artisan", "Sculpture"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Doomed Artisan"] }, { "resolve": true }, { "attack": [ { "card": "Sculpture", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 19 } ] }
 }
]