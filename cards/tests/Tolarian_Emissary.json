[
  {
    "name": "kicked: destroys target enchantment on ETB",
    "players": [ { "hand": ["Tolarian Emissary"], "battlefield": ["Island", "Island", "Island", "Plains", "Plains"] }, { "battlefield": ["Glorious Anthem"] } ],
    "steps": [ { "cast": "Tolarian Emissary", "answers": [true] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tolarian Emissary"] }, { "battlefield_lacks": ["Glorious Anthem"] } ],
      "pt": { "Tolarian Emissary": [1, 2] }
    }
  },
  {
    "name": "unkicked: no ETB, the enchantment stays",
    "players": [ { "hand": ["Tolarian Emissary"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Glorious Anthem"] } ],
    "steps": [ { "cast": "Tolarian Emissary" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tolarian Emissary"] }, { "battlefield_has": ["Glorious Anthem"] } ]
    }
  },
  {
    "name": "ruling: kicker is part of the total cost; four lands cannot pay for a kicked Emissary",
    "players": [ { "hand": ["Tolarian Emissary"], "battlefield": ["Island", "Island", "Island", "Plains"] }, { "battlefield": ["Glorious Anthem"] } ],
    "steps": [ { "cast": "Tolarian Emissary" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tolarian Emissary"] }, { "battlefield_has": ["Glorious Anthem"] } ]
    }
  }
]
