[
  { "name": "no spells last turn: transforms into Ironfang at the next upkeep",
    "players": [ { "battlefield": ["Village Ironsmith"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "pt": { "Ironfang": [3, 1] } } },
  { "name": "a spell was cast last turn: does not transform",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Village Ironsmith"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Upkeep" } ],
    "expect": { "pt": { "Village Ironsmith": [1, 1] } } },
  { "name": "Ironfang: a player cast two spells last turn, so it transforms back at the next upkeep",
    "players": [ { "battlefield": ["Village Ironsmith"] }, { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Village Ironsmith": [1, 1] } } }
]
