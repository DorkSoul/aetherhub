[
 {
  "name": "activating Prodigal Sorcerer and paying {2} copies the ability: 2 damage",
  "players": [
   {
    "battlefield": [
     "Rings of Brighthearth",
     {
      "name": "Prodigal Sorcerer",
      "sick": false
     },
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Prodigal Sorcerer",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true,
    "answers": [
     true
    ]
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 18
    }
   ]
  }
 },
 {
  "name": "ruling: the copy does not trigger Rings again, so {2} is paid once",
  "players": [ { "battlefield": ["Rings of Brighthearth", { "name": "Prodigal Sorcerer", "sick": false }, "Island", "Island", "Island", "Island"] }, {} ],
  "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "stack_empty": true, "players": [ {}, { "life": 18 } ] }
 },
 {
  "name": "ruling: tapping a land for mana does not trigger Rings",
  "players": [ { "battlefield": ["Rings of Brighthearth", "Island"] }, {} ],
  "steps": [ { "tap_for_mana": "Island" } ],
  "expect": { "stack_empty": true, "players": [ { "pool": { "U": 1 } }, {} ] }
 },
 {
  "name": "ruling: the copy keeps the original target unless new targets are chosen",
  "players": [ { "battlefield": ["Rings of Brighthearth", { "name": "Prodigal Sorcerer", "sick": false }, "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "stack_empty": true, "players": [ {}, { "life": 20, "graveyard": ["Grizzly Bears"] } ] }
 }
]