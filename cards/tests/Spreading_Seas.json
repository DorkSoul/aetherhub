   "subtypes": { "Forest": ["Island"] }
  }
 },
 {
  "name": "enchanted land loses its printed Forest mana: it cannot tap for G",
  "players": [
   { "hand": ["Spreading Seas"], "battlefield": ["Island", "Island", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Spreading Seas", "targets": ["Forest"] },
   { "resolve": true },
   { "resolve": true },
