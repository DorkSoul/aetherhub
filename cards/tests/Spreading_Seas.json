 },
 {
  "name": "ruling: the enchanted Forest loses its Forest type and keeps its name",
  "players": [
   { "hand": ["Spreading Seas"], "battlefield": ["Island", "Island", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Spreading Seas", "targets": ["Forest"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
