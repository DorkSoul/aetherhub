[
 {"name": "charge counter when you cast an instant",
  "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", {"name": "Relic Amulet"}]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["Grizzly Bears"]}, {"resolve": true}, {"resolve": true}],
  "expect": {"counters": {"Relic Amulet": {"charge": 1}}, "players": [{"graveyard": ["Lightning Bolt"]}, {"graveyard": ["Grizzly Bears"]}]}},
 {"name": "{2},{T}, remove all charge counters: deals that much damage to target creature",
  "players": [{"battlefield": ["Mountain", "Mountain", {"name": "Relic Amulet", "counters": {"charge": 3}}]}, {"battlefield": ["Grizzly Bears", "Grizzly Bears"]}],
  "steps": [{"activate": "Relic Amulet", "targets": ["Grizzly Bears"]}, {"resolve": true}],
  "expect": {"counters": {"Relic Amulet": {"charge": 0}}, "tapped": {"Relic Amulet": true}, "players": [{}, {"graveyard": ["Grizzly Bears"], "battlefield_has": ["Grizzly Bears"]}]}},
 {"name": "no charge counters: deals 0 damage",
  "players": [{"battlefield": ["Mountain", "Mountain", "Relic Amulet"]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"activate": "Relic Amulet"}, {"resolve": true}],
  "expect": {"players": [{}, {"battlefield_has": ["Grizzly Bears"]}]}},
 {"name": "ruling: a creature spell without the Wizard type (Grizzly Bears) adds no charge counter",
  "players": [{"hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", {"name": "Relic Amulet"}]}, {}],
  "steps": [{"cast": "Grizzly Bears"}, {"resolve": true}],
  "expect": {"counters": {"Relic Amulet": {"charge": 0}}, "players": [{"battlefield_has": ["Grizzly Bears"]}, {}]}},
 {"name": "ruling: a Wizard creature spell (Snapcaster Mage is a Human Wizard) adds a charge counter",
  "players": [{"hand": ["Snapcaster Mage"], "battlefield": ["Island", "Mountain", {"name": "Relic Amulet"}]}, {}],
  "steps": [{"cast": "Snapcaster Mage"}, {"resolve": true}, {"resolve": true}],
  "expect": {"counters": {"Relic Amulet": {"charge": 1}}, "players": [{"battlefield_has": ["Snapcaster Mage"]}, {}]}},
 {"name": "ruling: the cast trigger still adds its counter when the spell it triggered on is countered",
  "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", {"name": "Relic Amulet"}]}, {"hand": ["Counterspell"], "battlefield": ["Grizzly Bears", "Island", "Island"]}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["Grizzly Bears"]}, {"pass": true}, {"cast": "Counterspell", "player": 1, "targets": [{"stack": "Lightning Bolt"}]}, {"pass": true, "player": 1}, {"pass": true}, {"resolve": true}],
  "expect": {"counters": {"Relic Amulet": {"charge": 1}}, "players": [{"graveyard": ["Lightning Bolt"]}, {"battlefield_has": ["Grizzly Bears"], "graveyard": ["Counterspell"]}]}}
]
