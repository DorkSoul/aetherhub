[
 { "name": "a Villain you control dies and returns with a finality counter",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Thunderbolts Conspiracy", "A.I.M. Synthoids"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["A.I.M. Synthoids"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["A.I.M. Synthoids"], "graveyard": ["Lightning Bolt"] }, {} ],
               "counters": { "A.I.M. Synthoids": { "finality": 1 } }, "pt": { "A.I.M. Synthoids": [1, 3] } } },
 { "name": "a creature that is not a Villain stays in the graveyard",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Thunderbolts Conspiracy", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
 { "name": "a Villain an opponent controls does not return",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Thunderbolts Conspiracy"] }, { "battlefield": ["A.I.M. Synthoids"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["A.I.M. Synthoids"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["A.I.M. Synthoids"] }, { "graveyard": ["A.I.M. Synthoids"] } ] } },
 { "name": "a Villain with a finality counter that would die is exiled instead",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Thunderbolts Conspiracy", { "name": "A.I.M. Synthoids", "counters": { "finality": 1 } }] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["A.I.M. Synthoids"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["A.I.M. Synthoids"], "battlefield_lacks": ["A.I.M. Synthoids"] }, {} ] } }
]
