 {
  "name": "ruling: Stifle (an activated-ability counter) counters cycling; the discarded card stays in the graveyard and no card is drawn",
  "players": [
   { "hand": ["Yoked Plowbeast"], "battlefield": ["Plains", "Plains"] },
   { "hand": ["Stifle"], "battlefield": ["Island"] }
  ],
  "steps": [
   { "activate": "Yoked Plowbeast", "ability": 0 },
   { "pass": true },
   { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Yoked Plowbeast" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Yoked Plowbeast"], "hand_count": 0 },
    { "graveyard": ["Stifle"] }
   ]
  }
 },
 {
  "name": "ruling: Remove Soul (a spell counter) cannot counter cycling, so the card is drawn",
  "players": [
   { "hand": ["Yoked Plowbeast"], "battlefield": ["Plains", "Plains"] },
   { "hand": ["Remove Soul"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "activate": "Yoked Plowbeast", "ability": 0 },
   { "pass": true },
   { "cast": "Remove Soul", "player": 1, "targets": [{ "stack": "Yoked Plowbeast" }], "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Yoked Plowbeast"], "hand_count": 1 },
    {}
   ]
  }
