[
  {
    "name": "damage equals creatures you control",
    "players": [
      { "hand": ["Massive Raid"], "battlefield": ["Mountain", "Mountain", "Forest", "Grizzly Bears", "Human 1-1 Red"] },
      {}
    ],
    "steps": [ { "cast": "Massive Raid", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "opponent creatures are not counted",
    "players": [
      { "hand": ["Massive Raid"], "battlefield": ["Mountain", "Mountain", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Massive Raid", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19 } ] }
  },
  {
    "name": "ruling: the damage counts the creatures you control when it resolves, so a creature killed in response is not counted",
    "players": [
      { "hand": ["Massive Raid"], "battlefield": ["Mountain", "Mountain", "Forest", "Grizzly Bears", "Human 1-1 Red"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Massive Raid", "targets": ["p1"] },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Human 1-1 Red"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Human 1-1 Red"] },
        { "life": 19 }
      ]
    }
  }
]
