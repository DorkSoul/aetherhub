[
 { "name": "opponent's spell costs one more on your turn",
   "players": [ { "battlefield": ["Tithe Taker"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Tithe Taker"], "illegal": true } ],
   "expect": { "players": [ {}, { "hand": ["Lightning Bolt"] } ] } },
 { "name": "opponent can pay the extra for a spell",
   "players": [ { "battlefield": ["Tithe Taker"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Swamp"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["Tithe Taker"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Tithe Taker"] }, { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "your own spells are not taxed",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Tithe Taker", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Tithe Taker"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Tithe Taker"] }, {} ] } },
 { "name": "opponent's cycling from hand costs one more on your turn",
   "players": [ { "battlefield": ["Tithe Taker"] }, { "hand": ["Lonely Sandbar"], "battlefield": ["Island"], "library": ["Forest"] } ],
   "steps": [ { "pass": true },
              { "activate": "Lonely Sandbar", "player": 1, "illegal": true } ],
   "expect": { "players": [ {}, { "hand": ["Lonely Sandbar"] } ] } },
 { "name": "opponent can pay the extra for cycling",
   "players": [ { "battlefield": ["Tithe Taker"] }, { "hand": ["Lonely Sandbar"], "battlefield": ["Island", "Swamp"], "library": ["Forest"] } ],
   "steps": [ { "pass": true },
              { "activate": "Lonely Sandbar", "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ {}, { "hand": ["Forest"], "graveyard": ["Lonely Sandbar"] } ] } },
 { "name": "cycling is not taxed on the opponent's own turn",
   "players": [ { "hand": ["Lonely Sandbar"], "battlefield": ["Island"], "library": ["Forest"] }, { "battlefield": ["Tithe Taker"] } ],
   "steps": [ { "activate": "Lonely Sandbar" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Lonely Sandbar"] }, {} ] } },
 { "name": "afterlife makes a flying Spirit when it dies",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Tithe Taker", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Tithe Taker"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Tithe Taker"], "battlefield_has": ["Spirit 1-1 White Black Flying"] }, {} ] } },
 { "name": "ruling: opponent's mana ability is not taxed on your turn",
   "players": [ { "battlefield": ["Tithe Taker"] }, { "battlefield": ["Spectral Searchlight"] } ],
   "steps": [ { "pass": true }, { "tap_for_mana": "Spectral Searchlight", "player": 1, "color": "G", "answers": [1, "G"] } ],
   "expect": { "players": [ {}, { "pool": { "G": 1 } } ], "tapped": { "Spectral Searchlight": true } } },
 { "name": "ruling: opponent's activated ability costs {1} more on your turn (4 Islands are not enough)",
   "players": [ { "battlefield": ["Tithe Taker"] }, { "battlefield": ["Witching Well", "Island", "Island", "Island", "Island"] } ],
   "steps": [ { "pass": true }, { "activate": "Witching Well", "ability": 0, "player": 1, "illegal": true } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Witching Well"] } ] } },
 { "name": "ruling: opponent pays the extra {1} with a fifth Island",
   "players": [ { "battlefield": ["Tithe Taker"] }, { "battlefield": ["Witching Well", "Island", "Island", "Island", "Island", "Island"] } ],
   "steps": [ { "pass": true }, { "activate": "Witching Well", "ability": 0, "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Witching Well"], "hand_count": 2 } ] } }
]
