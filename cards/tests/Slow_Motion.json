[
  {
    "name": "enchanted creature's controller with no mana sacrifices it at their upkeep, and Slow Motion returns to hand",
    "players": [
      { "hand": ["Slow Motion"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Slow Motion", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [{ "hand": ["Slow Motion"] }, { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "paying {2} at their upkeep keeps the creature",
    "players": [
      { "hand": ["Slow Motion"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Slow Motion", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Grizzly Bears"] }],
      "attached": { "Slow Motion": "Grizzly Bears" }
    }
  },
  {
    "name": "the caster's own creature is not affected at the caster's opponent's upkeep",
    "players": [
      { "hand": ["Slow Motion"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Slow Motion", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "ruling: declining to pay with mana available sacrifices the creature at upkeep",
    "players": [
      { "hand": ["Slow Motion"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Slow Motion", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Slow Motion"] }, { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }]
    }
  }
]
