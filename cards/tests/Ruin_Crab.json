   "steps": [{"cast": "Rampant Growth"}, {"resolve": true, "answers": [["Island"]]}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Ruin Crab", "Island"]}, {"graveyard": ["Island", "Island", "Island"]}], "tapped": {"Island": true}}},
