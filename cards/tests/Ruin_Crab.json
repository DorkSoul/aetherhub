   "steps": [{"play_land": "Forest"}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{}, {"graveyard": ["Island", "Island", "Island", "Island", "Island", "Island"]}]}},
  {"name": "ruling: a spell that puts a land onto the battlefield triggers landfall",
