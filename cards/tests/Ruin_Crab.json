   "steps": [{"cast": "Grizzly Bears"}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Grizzly Bears"]}, {"graveyard": []}]}},
  {"name": "ruling: two Ruin Crabs each trigger on one land drop (six cards milled)",
