[
  {
    "name": "tap: exchange control of two nonlegendary creatures",
    "players": [
      { "battlefield": [{"name": "Djinn of Infinite Deceits", "sick": false}, "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Djinn of Infinite Deceits", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Djinn of Infinite Deceits", "Hill Giant"] }, { "battlefield_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "cannot be activated during combat",
    "players": [
      { "battlefield": [{"name": "Djinn of Infinite Deceits", "sick": false}, {"name": "Grizzly Bears", "sick": false}] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "activate": "Djinn of Infinite Deceits", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant"], "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Djinn of Infinite Deceits", "Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: the controller need not control either target (two opposing creatures are unchanged)",
    "players": [
      { "battlefield": [{"name": "Djinn of Infinite Deceits", "sick": false}] },
      { "battlefield": ["Hill Giant", "Runeclaw Bear"] }
    ],
    "steps": [
      { "activate": "Djinn of Infinite Deceits", "ability": 0, "targets": ["Hill Giant", "Runeclaw Bear"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield": ["Djinn of Infinite Deceits"] }, { "battlefield": ["Hill Giant", "Runeclaw Bear"] }]
    }
  },
  {
    "name": "ruling: if one target is gone on resolution the exchange does not happen",
    "players": [
      { "battlefield": [{"name": "Djinn of Infinite Deceits", "sick": false}, {"name": "Grizzly Bears", "sick": false}] },
      { "battlefield": ["Hill Giant", "Mountain"], "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "activate": "Djinn of Infinite Deceits", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield": ["Djinn of Infinite Deceits"], "graveyard": ["Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Mountain"] }]
    }
  }
]
