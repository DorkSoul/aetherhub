[
 { "name": "upkeep: adds R for the age counter and stays",
   "players": [ { "battlefield": ["Braid of Fire"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
   "expect": { "players": [ { "battlefield_has": ["Braid of Fire"] }, {} ], "counters": { "Braid of Fire": { "age": 1 } } } },
 { "name": "two age counters still never sacrifices it",
   "players": [ { "battlefield": [ { "name": "Braid of Fire", "counters": { "Age": 1 } } ] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
   "expect": { "players": [ { "battlefield_has": ["Braid of Fire"] }, {} ], "counters": { "Braid of Fire": { "age": 2 } } } },
 { "name": "declining the payment sacrifices it",
   "players": [ { "battlefield": ["Braid of Fire"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
   "expect": { "players": [ { "graveyard_has": ["Braid of Fire"] }, {} ] } },
 { "name": "ruling: the R added in upkeep and not spent is gone before the draw step",
   "players": [ { "battlefield": ["Braid of Fire"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "Draw" } ],
   "expect": { "players": [ { "battlefield_has": ["Braid of Fire"], "pool": {} }, {} ] } },
 { "name": "ruling: the R added in upkeep can be spent on an instant in that upkeep",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Braid of Fire"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "life": 17 } ] } }
]
