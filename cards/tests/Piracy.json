[
 { "name": "tap an opponent's Mountain for mana to cast a spell",
   "players": [ { "hand": ["Piracy", "Lightning Bolt"], "battlefield": ["Island", "Island"] }, { "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Piracy" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Piracy"] }, { "life": 17 } ], "tapped": { "Mountain": true } } },
 { "name": "without Piracy the opponent's land can't pay",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Island"] }, { "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "the mana can only cast spells: an ability can't be paid with it",
   "players": [ { "hand": ["Piracy"], "battlefield": ["Island", "Island", "Shivan Dragon"] }, { "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Piracy" }, { "resolve": true }, { "activate": "Shivan Dragon", "ability": 0, "illegal": true } ],
   "expect": { "players": [ {}, {} ], "tapped": { "Mountain": false } } }
]
