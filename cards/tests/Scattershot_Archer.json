[
  {
    "name": "tap: 1 damage to each creature with flying, not to others",
    "players": [
      { "battlefield": ["Forest", "Scattershot Archer", "Grizzly Bears"] },
      { "battlefield": ["Aesthir Glider", "Savannah Lions"] }
    ],
    "steps": [
      { "activate": "Scattershot Archer" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Scattershot Archer", "Grizzly Bears"] },
        { "graveyard": ["Aesthir Glider"], "battlefield": ["Savannah Lions"] }
      ],
      "tapped": { "Scattershot Archer": true }
    }
  },
  {
    "name": "summoning sick: cannot tap",
    "players": [
      { "battlefield": ["Forest", { "name": "Scattershot Archer", "sick": true }] },
      { "battlefield": ["Aesthir Glider"] }
    ],
    "steps": [
      { "activate": "Scattershot Archer", "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield": ["Aesthir Glider"] } ]
    }
  }
]
