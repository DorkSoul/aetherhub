[
  {
    "name": "counters a spell and gains 3 life",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Absorb"
        ],
        "battlefield": [
          "Plains",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "cast": "Absorb",
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 23,
          "graveyard": [
            "Absorb"
          ]
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "needs a spell to target",
    "players": [
      {
        "hand": [
          "Absorb"
        ],
        "battlefield": [
          "Plains",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Absorb",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20,
          "hand": [
            "Absorb"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a spell that can't be countered can be targeted; Absorb does not counter it but still gains 3 life",
    "players": [
      {
        "hand": [ "Absorb" ],
        "battlefield": [ "Plains", "Island", "Island" ]
      },
      {
        "hand": [ "Blurred Mongoose" ],
        "battlefield": [ "Forest", "Forest" ]
      }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Blurred Mongoose", "player": 1 },
      { "cast": "Absorb", "targets": [ { "stack": "Blurred Mongoose" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "graveyard": [ "Absorb" ] },
        { "battlefield_has": [ "Blurred Mongoose" ] }
      ]
    }
  }
]
