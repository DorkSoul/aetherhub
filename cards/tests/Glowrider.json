    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Glowrider", "Mountain"] }, {}],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true }],
    "expect": { "players": [{ "hand": ["Lightning Bolt"] }] }
  },
  {
    "name": "noncreature spell is castable with the extra mana",
