[
 { "name": "damage equals Islands the opponent controls (own Islands ignored)",
   "players": [ { "hand": ["Typhoon"], "battlefield": ["Forest","Forest","Forest","Island"] },
                { "battlefield": ["Island","Island","Island","Forest"] } ],
   "steps": [ { "cast": "Typhoon" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard": ["Typhoon"] }, { "life": 17 } ] } },
 { "name": "no Islands means no damage",
   "players": [ { "hand": ["Typhoon"], "battlefield": ["Forest","Forest","Forest","Island"] },
                { "battlefield": ["Forest","Swamp"] } ],
   "steps": [ { "cast": "Typhoon" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
 { "name": "ruling: Islands counted on resolution: opponent bounces one of its Islands in response, so only 2 damage",
   "players": [ { "hand": ["Typhoon"], "battlefield": ["Forest","Forest","Forest","Island"] },
                { "hand": ["Boomerang"], "battlefield": ["Island","Island","Island","Forest"] } ],
   "steps": [ { "cast": "Typhoon" },
              { "cast": "Boomerang", "player": 1, "targets": ["p1:Island"] },
              { "pass": true },
              { "pass": true },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard": ["Typhoon"] }, { "life": 18 } ] } }
]
