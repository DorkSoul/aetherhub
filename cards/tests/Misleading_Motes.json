[
  {
    "name": "owner puts the Bears on top of their library",
    "players": [
      { "hand": ["Misleading Motes"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Misleading Motes", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Misleading Motes"] },
        { "library_count": 2, "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "owner puts the Bears on the bottom of their library",
    "players": [
      { "hand": ["Misleading Motes"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Misleading Motes", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Misleading Motes"] },
        { "library_count": 2, "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: owner chooses top, so the Bears become the top card of the library",
    "players": [
      { "hand": ["Misleading Motes"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Misleading Motes", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ {}, { "library_top": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: owner chooses bottom, so the Mountain stays on top of the library",
    "players": [
      { "hand": ["Misleading Motes"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Misleading Motes", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ {}, { "library_top": ["Mountain"] } ] }
  }
]
