[
 { "name": "enters and creates a 1/1 Phyrexian Goblin",
   "players": [ { "hand": ["Charforger"], "battlefield": ["Swamp", "Mountain", "Forest"] }, {} ],
   "steps": [ { "cast": "Charforger" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Charforger", "Phyrexian Goblin"] }, {} ] } },
 { "name": "oil counter when another creature you control dies",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Charforger", "Grizzly Bears", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, {} ],
               "counters": { "Charforger": { "oil": 1 } } } },
 { "name": "exile ability needs three oil counters",
   "players": [ { "battlefield": ["Charforger"] }, {} ],
   "steps": [ { "activate": "Charforger", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "library_count": 20 }, {} ] } },
 { "name": "remove three oil counters: exile the top card, which can be cast this turn",
   "players": [ { "library": ["Grizzly Bears"], "battlefield": [ { "name": "Charforger", "counters": { "oil": 3 } }, "Forest", "Forest" ] }, {} ],
   "steps": [ { "activate": "Charforger", "ability": 0 }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "exile": [], "battlefield_has": ["Grizzly Bears"] }, {} ], "counters": { "Charforger": { "oil": 0 } } } },
 { "name": "two oil counters are not enough to exile the top card",
   "players": [ { "library": ["Grizzly Bears"], "battlefield": [ { "name": "Charforger", "counters": { "oil": 2 } } ] }, {} ],
   "steps": [ { "activate": "Charforger", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "exile": [] }, {} ], "counters": { "Charforger": { "oil": 2 } } } },
 { "name": "ruling: a card exiled by the last ability follows normal timing (creature not castable on the opponent's turn)",
   "players": [ { "library": ["Grizzly Bears"], "battlefield": [ { "name": "Charforger", "counters": { "oil": 3 } }, "Forest", "Forest" ] }, {} ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "activate": "Charforger", "ability": 0 }, { "resolve": true }, { "pass": true, "player": 1 }, { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": { "players": [ { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ], "counters": { "Charforger": { "oil": 0 } } } }
]
