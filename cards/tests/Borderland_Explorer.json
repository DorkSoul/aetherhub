  {
    "name": "ruling: an opponent who declines neither discards nor searches while the caster discards and searches",
    "players": [
      {
        "hand": ["Borderland Explorer", "Shock", "Island"],
        "battlefield": ["Forest", "Forest", "Forest"],
        "library": ["Mountain", "Forest"]
      },
