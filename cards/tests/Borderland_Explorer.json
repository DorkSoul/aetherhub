          "hand_count": 2,
          "graveyard_has": ["Giant Growth"]
        }
      ]
    }
  },
  {
    "name": "a player who declines neither discards nor searches",
    "players": [
      {
        "hand": ["Borderland Explorer", "Shock", "Island"],
        "battlefield": ["Forest", "Forest", "Forest"],
        "library": ["Mountain", "Forest"]
      },
      {
        "hand": ["Grizzly Bears", "Giant Growth"],
        "library": ["Plains", "Swamp"]
      }
    ],
    "steps": [
      {
        "cast": "Borderland Explorer"
      },
      {
        "resolve": true,
        "answers": [false, false]
