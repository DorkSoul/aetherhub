[
  {
    "name": "each player discards a card and searches for a basic land",
    "players": [
      {
        "hand": ["Borderland Explorer", "Shock", "Island"],
        "battlefield": ["Forest", "Forest", "Forest"],
        "library": ["Mountain", "Forest"]
      },
      {
        "hand": ["Grizzly Bears", "Giant Growth"],
        "library": ["Plains", "Swamp"]
      }
    ],
    "steps": [
