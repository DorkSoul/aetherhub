[
  { "name": "second spell each turn investigates",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Lavinia, Foil to Conspiracy", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Clue"] }, { "life": 14 } ] } },
  { "name": "first spell of the turn does not investigate",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lavinia, Foil to Conspiracy", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Clue"] }, { "life": 17 } ] } },
  { "name": "ruling: Lavinia cast as your first spell still makes the next spell your second, so it investigates",
    "players": [ { "hand": ["Lavinia, Foil to Conspiracy", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lavinia, Foil to Conspiracy" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Clue", "Lavinia, Foil to Conspiracy"] }, { "life": 17 } ] } }
]
