[
  {
    "name": "station taps another creature and adds charge counters equal to its power",
    "players": [
      { "battlefield": ["Borg Scout Sphere", "Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Borg Scout Sphere" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Borg Scout Sphere": false },
      "counters": { "Borg Scout Sphere": { "charge": 2 } }
    }
  },
  {
    "name": "6 charge counters: the Sphere is a 5/5 artifact creature with flying",
    "players": [
      { "battlefield": [ { "name": "Borg Scout Sphere", "counters": { "charge": 4 } }, "Hill Giant", "Forest" ] },
      {}
    ],
    "steps": [
      { "activate": "Borg Scout Sphere" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Borg Scout Sphere": { "charge": 7 } },
      "pt": { "Borg Scout Sphere": [5, 5] },
      "keywords": { "Borg Scout Sphere": ["Flying"] }
    }
  },
  {
    "name": "5 charge counters is below the 6+ threshold: not a creature, no flying",
    "players": [
      { "battlefield": [ { "name": "Borg Scout Sphere", "counters": { "charge": 3 } }, "Grizzly Bears" ] },
      {}
    ],
    "steps": [
      { "activate": "Borg Scout Sphere" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Borg Scout Sphere": { "charge": 5 } }
    }
  },
  {
    "name": "ruling: entering the battlefield draws a card (ability 0)",
    "players": [
      { "hand": ["Borg Scout Sphere"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Borg Scout Sphere" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Borg Scout Sphere"], "hand": ["Grizzly Bears"] }, {} ]
    }
  }
]
