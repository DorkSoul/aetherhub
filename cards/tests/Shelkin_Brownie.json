[
  {
    "name": "the ability taps the Brownie and leaves ordinary banding alone",
    "players": [ { "battlefield": ["Shelkin Brownie"] }, { "battlefield": ["Benalish Hero"] } ],
    "steps": [
      { "activate": "Shelkin Brownie", "ability": 0, "targets": ["Benalish Hero"] },
      { "resolve": true }
    ],
    "expect": { "keywords": { "Benalish Hero": ["Banding"] }, "tapped": { "Shelkin Brownie": true } }
  },
  {
    "name": "can target its own controller's creature",
    "players": [ { "battlefield": ["Shelkin Brownie", "Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Shelkin Brownie", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Shelkin Brownie": true }, "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "needs to untap: second activation is illegal",
    "players": [ { "battlefield": ["Shelkin Brownie", "Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Shelkin Brownie", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Shelkin Brownie", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "tapped": { "Shelkin Brownie": true } }
  }
]
