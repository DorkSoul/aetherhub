[
  { "name": "ETB taps the enchanted creature",
    "players": [ { "hand": ["Tamiyo's Compleation"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Tamiyo's Compleation", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tamiyo's Compleation", "Grizzly Bears"] }, {} ],
      "tapped": { "Grizzly Bears": true }, "attached": { "Tamiyo's Compleation": "Grizzly Bears" } } },
  { "name": "no artifact, creature or planeswalker to enchant: cannot cast",
    "players": [ { "hand": ["Tamiyo's Compleation"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Tamiyo's Compleation", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Tamiyo's Compleation"] }, {} ] } },
  { "name": "enchanted creature loses all abilities: enchanted Leaping Lizard cannot use its {1}{G} flying ability",
    "players": [ { "hand": ["Tamiyo's Compleation"], "battlefield": ["Island", "Island", "Island", "Island", "Forest", "Forest", "Leaping Lizard"] }, {} ],
    "steps": [ { "cast": "Tamiyo's Compleation", "targets": ["Leaping Lizard"] }, { "resolve": true }, { "resolve": true },
               { "activate": "Leaping Lizard", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tamiyo's Compleation", "Leaping Lizard"] }, {} ], "tapped": { "Leaping Lizard": true } } },
  { "name": "control: without the Aura, Leaping Lizard's {1}{G} ability can be activated (Lizard becomes 2/2 with flying)",
    "players": [ { "battlefield": ["Forest", "Forest", "Leaping Lizard"] }, {} ],
    "steps": [ { "activate": "Leaping Lizard", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Leaping Lizard"] }, {} ], "pt": { "Leaping Lizard": [2, 2] } } },
  { "name": "enchanted creature does not untap during its controller's untap step: enchanted Grizzly Bears is still tapped in my next upkeep",
    "players": [ { "hand": ["Tamiyo's Compleation"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Tamiyo's Compleation", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "battlefield_has": ["Tamiyo's Compleation", "Grizzly Bears"] }, {} ], "tapped": { "Grizzly Bears": true } } },
  { "name": "ruling: an Equipment creature enchanted by Tamiyo's Compleation loses reconfigure and cannot be attached by any effect",
    "players": [ { "hand": ["Tamiyo's Compleation"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Lion Sash", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Tamiyo's Compleation", "targets": ["Lion Sash"] }, { "resolve": true }, { "resolve": true },
               { "activate": "Lion Sash", "ability": 1, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tamiyo's Compleation", "Lion Sash", "Grizzly Bears"] }, {} ], "tapped": { "Lion Sash": true } } },
  { "name": "ruling: once the ETB trigger resolves, the Equipment is unattached (and tapped by the Aura)",
    "players": [ { "hand": ["Tamiyo's Compleation"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Lion Sash", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Lion Sash", "ability": 1, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Tamiyo's Compleation", "targets": ["Lion Sash"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tamiyo's Compleation", "Lion Sash", "Grizzly Bears"] }, {} ], "stack_empty": true, "tapped": { "Lion Sash": true } } },
  { "name": "ruling: attacking a planeswalker enchanted by Tamiyo's Compleation still removes loyalty counters",
    "players": [ { "hand": ["Tamiyo's Compleation"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, { "battlefield": ["Tamiyo, the Moon Sage"] } ],
    "steps": [ { "cast": "Tamiyo's Compleation", "targets": ["Tamiyo, the Moon Sage"] }, { "resolve": true }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "Tamiyo, the Moon Sage" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, {} ], "counters": { "Tamiyo, the Moon Sage": { "loyalty": 2 } } } }
]
