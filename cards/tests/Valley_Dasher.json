[
  {
    "name": "must attack each combat if able (haste, attacks the turn it comes in)",
    "players": [ { "battlefield": ["Valley Dasher"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ], "tapped": { "Valley Dasher": true } }
  },
  {
    "name": "a tapped Valley Dasher cannot attack, so no damage",
    "players": [ { "battlefield": [ { "name": "Valley Dasher", "tapped": true } ] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "ruling: a Propaganda attack cost you do not pay means Valley Dasher does not attack",
    "players": [ { "battlefield": ["Valley Dasher"] }, { "battlefield": ["Propaganda"] } ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ], "tapped": { "Valley Dasher": false } }
  }
]
