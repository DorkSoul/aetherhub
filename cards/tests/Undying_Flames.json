[
  { "name": "exiles cards until a nonland card and deals its mana value to the target",
    "players": [ { "hand": ["Undying Flames"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Undying Flames", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Undying Flames"] }, { "life": 18 } ] } },
  { "name": "epic: can't cast spells for the rest of the game",
    "players": [ { "hand": ["Undying Flames", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": [] }, {} ],
    "steps": [ { "cast": "Undying Flames", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, {} ] } },
  { "name": "epic upkeep copy: the emblem reveals again and deals damage to a new target",
    "players": [ { "hand": ["Undying Flames"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Undying Flames", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "targets": ["p1"] } ],
    "expect": { "players": [ { "graveyard": ["Undying Flames"] }, { "life": 16 } ] } },
  { "name": "ruling: empty library, nothing is revealed or exiled and the target takes no damage",
    "players": [ { "hand": ["Undying Flames"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": [], "exact_library": true }, {} ],
    "steps": [ { "cast": "Undying Flames", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Undying Flames"], "library_count": 0 }, { "life": 20 } ] } }
]
