[
 {
  "name": "taps target creature; its controller declines to pay",
  "players": [
   { "hand": ["Chain Stasis"], "battlefield": ["Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Chain Stasis", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "untaps a tapped target creature",
  "players": [
   { "hand": ["Chain Stasis"], "battlefield": ["Island"] },
   { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
  ],
  "steps": [
   { "cast": "Chain Stasis", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false }
  }
 },
 {
  "name": "may tap or untap: declining leaves the creature alone",
  "players": [
   { "hand": ["Chain Stasis"], "battlefield": ["Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Chain Stasis", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [false] }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false }
  }
 },
 {
  "name": "creature's controller pays {2}{U} and declines to copy",
  "players": [
   { "hand": ["Chain Stasis"], "battlefield": ["Island"] },
   { "battlefield": ["Grizzly Bears", "Island", "Forest", "Forest"] }
  ],
  "steps": [
   { "cast": "Chain Stasis", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true, true, false] }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "ruling: a copy can itself be copied; each copy is controlled by the player who copies it",
  "players": [
   { "hand": ["Chain Stasis"], "battlefield": ["Island"] },
   { "battlefield": ["Grizzly Bears", "Island", "Island", "Forest", "Forest", "Forest", "Forest"] }
  ],
  "steps": [
   { "cast": "Chain Stasis", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true, true, true, true, true, true, false] }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false }
  }
 }
]
