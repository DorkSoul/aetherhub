[
  {
    "name": "sacrificed to counter an instant the opponent cannot pay for",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Cursecatcher"] }, { "life": 20 } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Cursecatcher", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt", "Cursecatcher"], "battlefield_lacks": ["Cursecatcher"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "counter is removed when its controller pays {1}",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Cursecatcher"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Cursecatcher", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Cursecatcher"] }, { "life": 17 } ]
    }
  },
  {
    "name": "cannot target a creature spell",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Cursecatcher"] }, {} ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "activate": "Cursecatcher", "targets": [{ "stack": "Grizzly Bears" }], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears", "Cursecatcher"] }, {} ]
    }
  }
]
