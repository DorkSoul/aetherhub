[
  {
    "name": "attacking creates two attacking 4/4 Angels",
    "players": [
      { "battlefield": ["Parhelion II", "Hill Giant", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Parhelion II" },
      { "resolve": true },
      { "attack": [{ "card": "Parhelion II", "at": "p1" }] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Parhelion II", "Angel 4-4 Flying Vigilance", "Angel 4-4 Flying Vigilance"] },
        { "life": 7 }
      ]
    }
  },
  {
    "name": "in a three-player game each token may attack a different player",
    "players": [
      { "battlefield": ["Parhelion II", "Hill Giant", "Grizzly Bears"] },
      {},
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Parhelion II" },
      { "resolve": true },
      { "attack": [{ "card": "Parhelion II", "at": "p1" }] },
      { "resolve": true, "answers": ["p1", "p2"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 11 },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "both tokens can attack the same player",
    "players": [
      { "battlefield": ["Parhelion II", "Hill Giant", "Grizzly Bears"] },
      {},
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Parhelion II" },
      { "resolve": true },
      { "attack": [{ "card": "Parhelion II", "at": "p1" }] },
      { "resolve": true, "answers": ["p2", "p2"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 15 },
        { "life": 12 }
      ]
    }
  },
  {
    "name": "ruling: tokens entering attacking are not declared attackers, so Hellrider triggers only for the two declared attackers",
    "players": [
      { "hand": ["Hellrider"], "battlefield": ["Parhelion II", "Hill Giant", "Grizzly Bears", "Mountain", "Mountain", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Parhelion II" },
      { "resolve": true },
      { "cast": "Hellrider" },
      { "resolve": true },
      { "attack": [{ "card": "Parhelion II", "at": "p1" }, { "card": "Hellrider", "at": "p1" }] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Parhelion II", "Hellrider", "Angel 4-4 Flying Vigilance", "Angel 4-4 Flying Vigilance"] },
        { "life": 2 }
      ]
    }
  }
]
