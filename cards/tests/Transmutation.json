 {
  "name": "ruling: a later +2/+0 applies before the switch (switch is applied last)",
  "players": [
   { "hand": ["Transmutation"], "battlefield": ["Goblin Piker", "Swamp", "Swamp", "Swamp", "Bonesplitter"] },
   {}
  ],
  "steps": [
   { "cast": "Transmutation", "player": 0, "targets": ["Goblin Piker"] },
   { "resolve": true },
   { "activate": "Bonesplitter", "ability": 0, "targets": ["Goblin Piker"] },
   { "resolve": true }
  ],
  "expect": { "pt": { "Goblin Piker": [1, 4] } }
 },
 {
  "name": "ruling: switching after nonlethal damage can make the damage lethal",
  "players": [
   { "hand": ["Transmutation", "Scorch the Fields", "Scorch the Fields"], "battlefield": ["Woodland Sleuth", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Swamp", "Swamp"] },
   { "battlefield": ["Forest", "Forest", "Forest"] }
  ],
  "steps": [
   { "cast": "Scorch the Fields", "targets": ["Forest"] },
   { "resolve": true },
   { "cast": "Scorch the Fields", "targets": ["Forest"] },
   { "resolve": true },
   { "cast": "Transmutation", "targets": ["Woodland Sleuth"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Scorch the Fields", "Scorch the Fields", "Transmutation", "Woodland Sleuth"], "battlefield_lacks": ["Woodland Sleuth"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: switching twice returns the creature to its original power and toughness",
  "players": [
   { "hand": ["Transmutation", "Transmutation"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
   { "battlefield": ["Goblin Piker"] }
  ],
  "steps": [
   { "cast": "Transmutation", "player": 0, "targets": ["Goblin Piker"] },
   { "resolve": true },
   { "cast": "Transmutation", "player": 0, "targets": ["Goblin Piker"] },
   { "resolve": true }
  ],
  "expect": { "pt": { "Goblin Piker": [2, 1] } }
 }
