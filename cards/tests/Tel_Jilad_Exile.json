[
  {
    "name": "regenerate survives lethal damage and taps",
    "players": [
      { "battlefield": ["Tel-Jilad Exile", "Forest", "Mountain", "Mountain"], "hand": ["Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "activate": "Tel-Jilad Exile" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Tel-Jilad Exile"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Tel-Jilad Exile": true },
      "players": [ { "battlefield_has": ["Tel-Jilad Exile"] }, {} ]
    }
  },
  {
    "name": "without regeneration lethal damage kills it",
    "players": [
      { "battlefield": ["Tel-Jilad Exile", "Mountain"], "hand": ["Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Tel-Jilad Exile"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Tel-Jilad Exile"] }, {} ]
    }
  }
]
