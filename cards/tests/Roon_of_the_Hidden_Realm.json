[
  {
    "name": "exiles another creature until the beginning of the next end step",
    "players": [
      { "battlefield": ["Roon of the Hidden Realm", "Plains", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Roon of the Hidden Realm", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Roon of the Hidden Realm"] },
        { "exile": ["Hill Giant"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "the creature returns at the beginning of the end step",
    "players": [
      { "battlefield": ["Roon of the Hidden Realm", "Plains", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Roon of the Hidden Realm", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Roon of the Hidden Realm"] },
        { "battlefield_has": ["Hill Giant"], "exile": [] }
      ]
    }
  },
  {
    "name": "cannot target itself: 'another' creature only",
    "players": [
      { "battlefield": ["Roon of the Hidden Realm", "Plains", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Roon of the Hidden Realm", "targets": ["Roon of the Hidden Realm"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Roon of the Hidden Realm"], "exile": [] },
        {}
      ]
    }
  }
]
