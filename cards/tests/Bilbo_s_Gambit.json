[
  { "name": "gift promised: the opponent gets a Treasure, the spell returns to hand and nobody can cast spells this turn",
    "players": [ { "hand": ["Divination", "Bilbo's Gambit"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "cast": "Bilbo's Gambit", "answers": [true], "targets": [ { "stack": "Divination" } ] }, { "resolve": true }, { "cast": "Divination", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Divination"] }, { "battlefield_has": ["Treasure"] } ] } },
  { "name": "no gift: the spell returns to hand, no Treasure, spells can still be cast",
    "players": [ { "hand": ["Divination", "Bilbo's Gambit"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "cast": "Bilbo's Gambit", "answers": [false], "targets": [ { "stack": "Divination" } ] }, { "resolve": true }, { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Bilbo's Gambit", "Divination"] }, {} ] } },
  { "name": "ruling: a gift spell that is countered gives no gift: the opponent gets no Treasure",
    "players": [ { "hand": ["Divination", "Bilbo's Gambit"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Plains", "Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Divination" }, { "cast": "Bilbo's Gambit", "answers": [true], "targets": [ { "stack": "Divination" } ] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Bilbo's Gambit" } ] }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Bilbo's Gambit"] }, { "battlefield_lacks": ["Treasure"], "graveyard_has": ["Counterspell"] } ] } }
]
