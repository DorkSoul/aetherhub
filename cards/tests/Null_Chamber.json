  ],
  "expect": { "players": [ { "battlefield_has": ["Null Chamber"] }, { "hand": ["Lightning Bolt", "Shock"] } ] }
 },
 {
  "name": "the name the opponent chooses bars that spell too",
  "players": [
   { "hand": ["Null Chamber"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
