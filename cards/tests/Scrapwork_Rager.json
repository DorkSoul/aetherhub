[
  {
    "name": "ETB draws a card and costs 1 life",
    "players": [ { "hand": ["Scrapwork Rager"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Scrapwork Rager" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 19, "hand_count": 1 }, {} ] }
  },
  {
    "name": "unearth returns it with haste and the ETB triggers again",
    "players": [ { "graveyard": ["Scrapwork Rager"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Scrapwork Rager" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Scrapwork Rager"], "life": 19 }, {} ] }
  },
  {
    "name": "ruling: unearth gives the returned creature haste, so it can attack this turn",
    "players": [ { "graveyard": ["Scrapwork Rager"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Scrapwork Rager" }, { "resolve": true }, { "resolve": true }, { "attack": [ { "card": "Scrapwork Rager", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 19 }, { "life": 18 } ] }
  },
  {
    "name": "ruling: an unearthed creature is exiled at the beginning of the next end step",
    "players": [ { "graveyard": ["Scrapwork Rager"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Scrapwork Rager" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Scrapwork Rager"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"], "life": 19 }, {} ] }
  },
  {
    "name": "ruling: an unearthed creature that would die is exiled instead",
    "players": [ { "graveyard": ["Scrapwork Rager"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "activate": "Scrapwork Rager" }, { "resolve": true }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Scrapwork Rager"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Scrapwork Rager"], "graveyard": [], "life": 19 }, { "graveyard": ["Lightning Bolt"] } ] }
  }
]
