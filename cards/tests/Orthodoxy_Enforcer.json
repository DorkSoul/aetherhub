[
  {
    "name": "gets +2/+0 with two or more artifacts",
    "players": [ { "battlefield": [ { "name": "Orthodoxy Enforcer", "sick": false }, "Azorius Keyrune", "Ornithopter" ] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "pt": { "Orthodoxy Enforcer": [4, 4] } }
  },
  {
    "name": "only one artifact: no bonus",
    "players": [ { "battlefield": [ { "name": "Orthodoxy Enforcer", "sick": false }, "Azorius Keyrune" ] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "pt": { "Orthodoxy Enforcer": [2, 4] } }
  },
  {
    "name": "vigilance: attacks without tapping",
    "players": [ { "battlefield": [ { "name": "Orthodoxy Enforcer", "sick": false } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Orthodoxy Enforcer", "at": "p1" } ] } ],
    "expect": { "tapped": { "Orthodoxy Enforcer": false } }
  }
]
