[
  {
    "name": "your creature enters: you exchange it for a creature an opponent controls",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Confusion in the Ranks",
          "Forest",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Hill Giant",
            "Confusion in the Ranks"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "no permanent of an opponent shares a card type: nothing is exchanged",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Confusion in the Ranks",
          "Forest",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears",
            "Confusion in the Ranks"
          ]
        },
        {
          "battlefield_has": [
            "Mountain"
          ]
        }
      ]
    }
  },
  {
    "name": "opponent controls the enchantment: your creature enters, you exchange it for a creature that enchantment controller controls",
    "players": [
      {
        "hand": [
          "Hill Giant"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Confusion in the Ranks",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Hill Giant"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield_has": [
            "Confusion in the Ranks",
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: Confusion in the Ranks triggers on itself and is exchanged for an opponent's enchantment",
    "players": [
      { "hand": ["Confusion in the Ranks"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Welcome to Sweettooth"] }
    ],
    "steps": [ { "cast": "Confusion in the Ranks" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Welcome to Sweettooth"], "battlefield_lacks": ["Confusion in the Ranks"] },
        { "battlefield_has": ["Confusion in the Ranks"], "battlefield_lacks": ["Welcome to Sweettooth"] }
      ]
    }
  },
  {
    "name": "ruling: if the target is gone when the exchange resolves (Bolt in response), nothing is exchanged",
    "players": [
      { "hand": ["Grizzly Bears", "Lightning Bolt"], "battlefield": ["Confusion in the Ranks", "Forest", "Forest", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Confusion in the Ranks"], "graveyard_has": ["Lightning Bolt"] },
        { "graveyard_has": ["Hill Giant"] }
      ]
    }
  }
]
