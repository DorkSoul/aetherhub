[
 { "name": "discarding a card switches it to 4/2 until end of turn",
   "players": [ { "hand": ["Mountain"], "battlefield": ["Island", "Island", "Island", "Island", "Aeromoeba"] }, {} ],
   "steps": [ { "activate": "Aeromoeba", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Mountain"] }, {} ], "pt": { "Aeromoeba": [4, 2] } } },
 { "name": "with no card in hand the ability cannot be activated",
   "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Aeromoeba"] }, {} ],
   "steps": [ { "activate": "Aeromoeba", "ability": 0, "illegal": true } ],
   "expect": { "pt": { "Aeromoeba": [2, 4] } } },
 { "name": "ruling: nonlethal damage becomes lethal when its power and toughness are switched",
   "players": [ { "hand": ["Lightning Bolt", "Mountain"], "battlefield": ["Mountain", "Island", "Island", "Island", "Island", "Aeromoeba"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Aeromoeba"] }, { "resolve": true }, { "activate": "Aeromoeba", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Aeromoeba", "Lightning Bolt", "Mountain"] }, {} ] } },
 { "name": "ruling: three damage alone does not kill Aeromoeba (it is 2/4 until switched)",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Aeromoeba"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Aeromoeba"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Aeromoeba"] }, {} ], "pt": { "Aeromoeba": [2, 4] } } },
 { "name": "ruling: a +1/+0 later in the turn is applied before the switch, so it is 4/3 (not 5/2)",
   "players": [ { "hand": ["Mountain"], "battlefield": ["Dawnhart Wardens", "Llanowar Elves", "Island", "Island", "Island", "Island", "Aeromoeba"] }, {} ],
   "steps": [ { "activate": "Aeromoeba", "ability": 0 }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Aeromoeba": [4, 3] } } },
 { "name": "ruling: switching twice returns Aeromoeba to 2/4",
   "players": [ { "hand": ["Mountain", "Island"], "battlefield": ["Aeromoeba"] }, {} ],
   "steps": [ { "activate": "Aeromoeba", "ability": 0, "answers": ["Mountain"] }, { "resolve": true },
              { "activate": "Aeromoeba", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Mountain", "Island"] }, {} ], "pt": { "Aeromoeba": [2, 4] } } }
]
