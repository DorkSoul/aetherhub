[
  {
    "name": "casting an enchantment: may draw",
    "players": [
      {
        "hand": [
          "Pacifism"
        ],
        "battlefield": [
          "Mesa Enchantress",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Pacifism",
        "targets": [
          "p1:Hill Giant"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "may decline",
    "players": [
      {
        "hand": [
          "Pacifism"
        ],
        "battlefield": [
          "Mesa Enchantress",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Pacifism",
        "targets": [
          "p1:Hill Giant"
        ]
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "a non-enchantment spell doesn't trigger",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mesa Enchantress",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "ruling: the draw still happens when the enchantment spell is countered",
    "players": [
      { "hand": ["Pacifism"], "battlefield": ["Mesa Enchantress", "Plains", "Plains"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Pacifism", "targets": ["p1:Hill Giant"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Pacifism" }] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ { "hand_count": 1, "graveyard_has": ["Pacifism"] }, { "graveyard_has": ["Counterspell"] } ]
    }
  },
  {
    "name": "ruling: an enchantment returned to the battlefield without being cast does not trigger",
    "players": [
      { "hand": ["Replenish"], "graveyard": ["Leyline of Sanctity"], "battlefield": ["Mesa Enchantress", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Replenish" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "battlefield_has": ["Leyline of Sanctity"] }, {} ]
    }
  }
]
