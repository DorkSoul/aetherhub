      { "resolve": true, "answers": [true, "Grizzly Bears"] }
    ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Lightning Bolt", "Island"] }, { "hand": ["Grizzly Bears"], "graveyard": ["Unsummon"] } ] }
