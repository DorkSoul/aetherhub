[
  {
    "name": "ETB puts a shield counter on the opponent's creature and takes control of it",
    "players": [
      {
        "hand": [
          "Shield Broker"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Shield Broker"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Island",
            "Island",
            "Island",
            "Island",
            "Island",
            "Shield Broker",
            "Grizzly Bears"
          ]
        },
        {
          "battlefield": []
        }
      ],
      "counters": {
        "Grizzly Bears": {
          "shield": 1
        }
      }
    }
  },
  {
    "name": "ruling: two shield counters: one damage event is prevented and removes only one counter, control stays",
    "players": [
      {
        "hand": ["Shield Broker", "Lightning Bolt"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Mountain"]
      },
      {
        "battlefield": [{ "name": "Grizzly Bears", "counters": { "shield": 1 } }]
      }
    ],
    "steps": [
      { "cast": "Shield Broker" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Shield Broker"], "graveyard_has": ["Lightning Bolt"] },
        { "battlefield_lacks": ["Grizzly Bears"] }
      ],
      "counters": { "Grizzly Bears": { "shield": 1 } }
    }
  },
  {
    "name": "ruling: shield counters do not prevent sacrifice",
    "players": [
      { "battlefield": ["Relic Vial", "Island", "Island", { "name": "Grizzly Bears", "counters": { "shield": 1 } }] },
      {}
    ],
    "steps": [ { "activate": "Relic Vial" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "hand_count": 1 }, {} ] }
  }
]