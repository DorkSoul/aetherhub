[
 {
  "name": "airbends a creature; its owner may cast it from exile for {2}",
  "players": [
   { "hand": ["Airbender Ascension"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Airbender Ascension" },
   { "resolve": true, "targets": ["Grizzly Bears"] },
   { "cast": "Grizzly Bears", "alt": 100 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Plains", "Plains", "Plains", "Plains", "Airbender Ascension", "Grizzly Bears"] },
    {}
   ]
  }
 },
 {
  "name": "with no other creature to target, airbends nothing",
  "players": [
   { "hand": ["Airbender Ascension"], "battlefield": ["Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Airbender Ascension" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Plains", "Plains", "Airbender Ascension"] },
    {}
   ]
  }
 },
 {
  "name": "each creature you control entering puts a quest counter on it",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Airbender Ascension", "Forest", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Airbender Ascension", "Forest", "Plains", "Grizzly Bears"] },
    {}
   ],
   "counters": { "Airbender Ascension": { "quest": 1 } }
  }
 },
 {
  "name": "with three quest counters, the end step does nothing",
  "players": [
   { "battlefield": [{ "name": "Airbender Ascension", "counters": { "quest": 3 } }, { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] },
   {}
  ],
  "steps": [
   { "advance_to": "End", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Airbender Ascension", "Grizzly Bears"] },
    {}
   ],
   "counters": { "Grizzly Bears": { "p1p1": 1 }, "Airbender Ascension": { "quest": 3 } }
  }
 },
 {
  "name": "with four quest counters, at your end step exiles and returns a creature you control (its counters are lost)",
  "players": [
   { "battlefield": [{ "name": "Airbender Ascension", "counters": { "quest": 4 } }, { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] },
   {}
  ],
  "steps": [
   { "advance_to": "End", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Airbender Ascension", "Grizzly Bears"] },
    {}
   ],
   "counters": { "Grizzly Bears": { "p1p1": 0 } }
  }
 },
 {
  "name": "ruling: an Aura on the airbent creature goes to its owner's graveyard",
  "players": [
   { "hand": ["Pacifism", "Airbender Ascension"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Pacifism", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Airbender Ascension" },
   { "resolve": true, "targets": ["Grizzly Bears"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Airbender Ascension"], "graveyard": ["Pacifism"] },
    { "exile": ["Grizzly Bears"] }
   ]
  }
 }
]
