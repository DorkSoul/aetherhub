[
  { "name": "tap ability prevents 1 damage to a target and stays on the battlefield",
    "players": [ { "battlefield": ["Barrenton Medic"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Barrenton Medic", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Barrenton Medic"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Barrenton Medic": [0, 4] } } },
  { "name": "putting a -1/-1 counter to untap makes it a -1/3",
    "players": [ { "battlefield": ["Barrenton Medic"] }, {} ],
    "steps": [ { "activate": "Barrenton Medic", "ability": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Barrenton Medic": [-1, 3] } } },
  { "name": "ruling: the -1/-1 cost is paid on activation; if it kills the Medic it goes to the graveyard before the untap resolves",
    "players": [ { "battlefield": [ { "name": "Barrenton Medic", "counters": { "MinusOneMinusOne": 3 } } ] }, {} ],
    "steps": [ { "activate": "Barrenton Medic", "ability": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Barrenton Medic"] }, {} ] } }
]
