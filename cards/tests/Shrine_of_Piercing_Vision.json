[
  { "name": "upkeep adds a charge counter",
    "players": [ { "battlefield": ["Shrine of Piercing Vision"], "library": ["Grizzly Bears", "Island", "Swamp"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Shrine of Piercing Vision": { "charge": 1 } } } },
  { "name": "sacrifice with two charge counters: look at two cards, take one",
    "players": [ { "battlefield": [ { "name": "Shrine of Piercing Vision", "counters": { "charge": 2 } } ], "library": ["Grizzly Bears", "Island", "Swamp"] }, {} ],
    "steps": [ { "activate": "Shrine of Piercing Vision" }, { "resolve": true, "answers": ["Island"] } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Shrine of Piercing Vision"] }, {} ] } },
  { "name": "no charge counters: nothing to look at",
    "players": [ { "battlefield": ["Shrine of Piercing Vision"], "library": ["Grizzly Bears", "Island"] }, {} ],
    "steps": [ { "activate": "Shrine of Piercing Vision" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "graveyard": ["Shrine of Piercing Vision"] }, {} ] } },
  { "name": "casting a blue spell adds a charge counter",
    "players": [ { "hand": ["Divination"], "battlefield": ["Shrine of Piercing Vision", "Island", "Island", "Island"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ], "counters": { "Shrine of Piercing Vision": { "charge": 1 } } } },
  { "name": "casting a red spell does not add a charge counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Shrine of Piercing Vision", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Shrine of Piercing Vision": { "charge": 0 } } } }
]
