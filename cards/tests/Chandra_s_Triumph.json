[
  {
    "name": "3 damage kills a 3/3 when you control no Chandra",
    "players": [
      { "hand": ["Chandra's Triumph"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Chandra's Triumph", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Hill Giant"] }]
    }
  },
  {
    "name": "3 damage does not kill a 4/4 without a Chandra",
    "players": [
      { "hand": ["Chandra's Triumph"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Chandra's Triumph", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Serra Angel"] }]
    }
  },
  {
    "name": "5 damage with a Chandra planeswalker you control",
    "players": [
      { "hand": ["Chandra's Triumph"], "battlefield": ["Mountain", "Mountain", "Chandra, Bold Pyromancer"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Chandra's Triumph", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Serra Angel"] }]
    }
  },
  {
    "name": "ruling: two Chandra planeswalkers still deal only 5 damage",
    "players": [
      { "hand": ["Chandra's Triumph"], "battlefield": ["Mountain", "Mountain", "Chandra, Bold Pyromancer", "Chandra, Torch of Defiance"] },
      { "battlefield": ["Bulwark Giant"] }
    ],
    "steps": [
      { "cast": "Chandra's Triumph", "targets": ["Bulwark Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Bulwark Giant"] }]
    }
  },
  {
    "name": "ruling: Chandra check is made on resolution (Chandra removed in response means 3 damage)",
    "players": [
      { "hand": ["Chandra's Triumph", "Hero's Downfall"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp", "Swamp", "Chandra, Bold Pyromancer"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Chandra's Triumph", "targets": ["Serra Angel"] },
      { "cast": "Hero's Downfall", "targets": ["Chandra, Bold Pyromancer"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Chandra, Bold Pyromancer"] }, { "battlefield_has": ["Serra Angel"] }]
    }
  }
]
