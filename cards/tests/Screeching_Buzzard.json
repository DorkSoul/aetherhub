    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Screeching Buzzard"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Screeching Buzzard"] }, { "hand_count": 0 } ] }
