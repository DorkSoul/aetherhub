[
  {
    "name": "{3}{G}: base 5/3 with trample until end of turn",
    "players": [ { "battlefield": ["Werewolf Pack Leader", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Werewolf Pack Leader", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Werewolf Pack Leader": [5, 3] },
      "keywords": { "Werewolf Pack Leader": ["Trample"] }
    }
  },
  {
    "name": "animated 5/3 reverts to 3/3 without trample at cleanup",
    "players": [ { "battlefield": ["Werewolf Pack Leader", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Werewolf Pack Leader", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Cleanup", "auto": true }
    ],
    "expect": {
      "pt": { "Werewolf Pack Leader": [3, 3] }
    }
  },
  {
    "name": "activation needs four mana: three Forests is not enough",
    "players": [ { "battlefield": ["Werewolf Pack Leader", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Werewolf Pack Leader", "ability": 0, "illegal": true }
    ],
    "expect": {
      "pt": { "Werewolf Pack Leader": [3, 3] }
    }
  },
  {
    "name": "pack tactics: attacking with total power 5 draws nothing",
    "players": [ { "battlefield": ["Werewolf Pack Leader", "Grizzly Bears"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Werewolf Pack Leader", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "pack tactics: attacking with total power 7 draws a card",
    "players": [ { "battlefield": ["Werewolf Pack Leader", "Serra Angel"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Werewolf Pack Leader", "at": "p1" }, { "card": "Serra Angel", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "hand_count": 2 }, {} ]
    }
  },
  {
    "name": "ruling: a +1/+1 counter still adds on top of the 5/3 base set by the ability (6/4)",
    "players": [ { "battlefield": [ { "name": "Werewolf Pack Leader", "counters": { "p1p1": 1 } }, "Forest", "Forest", "Forest", "Forest" ] }, {} ],
    "steps": [ { "activate": "Werewolf Pack Leader", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Werewolf Pack Leader": [6, 4] } }
  },
  {
    "name": "ruling: a pump resolved before the ability still applies on top of the 5/3 base (8/6)",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Werewolf Pack Leader", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Giant Growth" },
      { "resolve": true },
      { "activate": "Werewolf Pack Leader", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Werewolf Pack Leader": [8, 6] } }
  }
]
