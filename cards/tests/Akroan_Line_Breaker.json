[
  {
    "name": "heroic: your spell targeting it gets +2/+0 (and intimidate)",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Akroan Line Breaker",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Giant Growth",
        "targets": [
          "Akroan Line Breaker"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Akroan Line Breaker": [
          7,
          4
        ]
      }
    }
  },
  {
    "name": "a spell targeting another creature does not trigger heroic",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Akroan Line Breaker",
          "Grizzly Bears",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Giant Growth",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Akroan Line Breaker": [
          2,
          1
        ],
        "Grizzly Bears": [
          5,
          5
        ]
      }
    }
  },
  {
    "name": "ruling: a spell copy retargeted onto it does not trigger heroic",
    "players": [
      { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Akroan Line Breaker", "Forest", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "cast": "Twincast", "targets": [{ "stack": "Giant Growth" }] },
      { "pass": true },
      { "pass": true, "answers": ["Akroan Line Breaker"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Akroan Line Breaker": [5, 4],
        "Grizzly Bears": [5, 5]
      }
    }
  },
  {
    "name": "ruling: two target slots on the same creature trigger heroic only once",
    "players": [
      { "hand": ["Common Bond"], "battlefield": ["Akroan Line Breaker", "Forest", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Common Bond", "targets": ["Akroan Line Breaker", "Akroan Line Breaker"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": {
        "Akroan Line Breaker": [6, 3]
      }
    }
  },
  {
    "name": "ruling: the heroic trigger resolves before the spell that caused it",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Akroan Line Breaker", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Giant Growth", "targets": ["Akroan Line Breaker"] },
      { "pass": true },
      { "pass": true }
    ],
    "expect": {
      "pt": {
        "Akroan Line Breaker": [4, 1]
      },
      "stack_empty": false
    }
  }
]
