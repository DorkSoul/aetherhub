[
  { "name": "its own enters gains 1 life",
    "players": [ { "hand": ["Haliya, Guided by Light"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Haliya, Guided by Light" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "battlefield_has": ["Haliya, Guided by Light"] }, {} ] } },
  { "name": "gaining 3 life this turn draws a card at your end step",
    "players": [ { "hand": ["Haliya, Guided by Light", "Biomechan Engineer"], "battlefield": ["Plains", "Plains", "Plains", "Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Haliya, Guided by Light" }, { "resolve": true }, { "resolve": true },
               { "cast": "Biomechan Engineer" }, { "resolve": true }, { "resolve": true }, { "resolve": true },
               { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 23, "hand_count": 1, "battlefield_has": ["Haliya, Guided by Light", "Biomechan Engineer", "Lander"] }, {} ] } },
  { "name": "gaining only 1 life this turn does not draw",
    "players": [ { "hand": ["Haliya, Guided by Light"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Haliya, Guided by Light" }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "life": 21, "hand_count": 0 }, {} ] } },
  { "name": "warp: cast for {W}, exiled at the next end step",
    "players": [ { "hand": ["Haliya, Guided by Light"], "battlefield": ["Plains"] }, {} ],
    "steps": [ { "cast": "Haliya, Guided by Light", "alt": 0 }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Haliya, Guided by Light"], "battlefield_lacks": ["Haliya, Guided by Light"] }, {} ] } },
  { "name": "ruling: the check counts life gained, so gaining 3 and losing 3 later still draws",
    "players": [ { "hand": ["Haliya, Guided by Light", "Biomechan Engineer", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Forest", "Island", "Mountain"] }, {} ],
    "steps": [ { "cast": "Haliya, Guided by Light" }, { "resolve": true }, { "resolve": true },
               { "cast": "Biomechan Engineer" }, { "resolve": true }, { "resolve": true }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["p0"] }, { "resolve": true },
               { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "hand_count": 1, "battlefield_has": ["Haliya, Guided by Light", "Biomechan Engineer", "Lander"] }, {} ] } }
]
