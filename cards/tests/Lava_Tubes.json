[
  {
    "name": "tapping for mana puts a depletion counter on it",
    "players": [
      {
        "battlefield": [
          "Lava Tubes"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Lava Tubes",
        "color": "B"
      }
    ],
    "expect": {
      "tapped": {
        "Lava Tubes": true
      },
      "counters": {
        "Lava Tubes": {
          "depletion": 1
        }
      }
    }
  },
  {
    "name": "the red ability also puts a depletion counter on it",
    "players": [
      {
        "battlefield": [
          "Lava Tubes"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Lava Tubes",
        "color": "R"
      }
    ],
    "expect": {
      "tapped": {
        "Lava Tubes": true
      },
      "counters": {
        "Lava Tubes": {
          "depletion": 1
        }
      }
    }
  },
  { "name": "your upkeep removes a depletion counter",
    "players": [ { "battlefield": [ { "name": "Lava Tubes", "counters": { "depletion": 2 } } ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "counters": { "Lava Tubes": { "depletion": 1 } } } },
  { "name": "the opponent's upkeep does not remove the counter",
    "players": [ { "battlefield": [ { "name": "Lava Tubes", "counters": { "depletion": 2 } } ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "counters": { "Lava Tubes": { "depletion": 2 } } } },
  { "name": "a tapped land with a depletion counter does not untap in our untap step",
    "players": [ { "battlefield": [ { "name": "Lava Tubes", "tapped": true, "counters": { "depletion": 1 } } ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "tapped": { "Lava Tubes": true }, "counters": { "Lava Tubes": { "depletion": 0 } } } },
  { "name": "control: a tapped land without a depletion counter untaps in our untap step",
    "players": [ { "battlefield": [ { "name": "Lava Tubes", "tapped": true } ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "tapped": { "Lava Tubes": false } } }
]