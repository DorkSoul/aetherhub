[
  {
    "name": "ETB returns target Sliver to its owner's hand",
    "players": [
      { "hand": ["Vedalken Aethermage"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Muscle Sliver"] }
    ],
    "steps": [
      { "cast": "Vedalken Aethermage" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Vedalken Aethermage"] }, { "hand": ["Muscle Sliver"] } ]
    }
  },
  {
    "name": "wizardcycling {3}: search for a Wizard card and put it into your hand",
    "players": [
      { "hand": ["Vedalken Aethermage"], "battlefield": ["Island", "Island", "Island"], "library": ["Benthic Biomancer"] },
      {}
    ],
    "steps": [
      { "activate": "Vedalken Aethermage", "ability": 0 },
      { "resolve": true, "answers": ["Benthic Biomancer"] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Vedalken Aethermage"], "hand": ["Benthic Biomancer"] }, {} ]
    }
  },
  {
    "name": "ruling: wizardcycling does not draw; the library top card stays in the library",
    "players": [
      { "hand": ["Vedalken Aethermage"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears", "Benthic Biomancer"] },
      {}
    ],
    "steps": [
      { "activate": "Vedalken Aethermage", "ability": 0 },
      { "resolve": true, "answers": ["Benthic Biomancer"] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Vedalken Aethermage"], "hand": ["Benthic Biomancer"], "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "ruling: wizardcycling may find nothing even when a Wizard is in the library",
    "players": [
      { "hand": ["Vedalken Aethermage"], "battlefield": ["Island", "Island", "Island"], "library": ["Benthic Biomancer"] },
      {}
    ],
    "steps": [
      { "activate": "Vedalken Aethermage", "ability": 0 },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Vedalken Aethermage"], "hand_count": 0 }, {} ]
    }
  }
]
