 {
  "name": "ruling: a token made on your turn counts itself and Voice (2/2 with Voice alive)",
  "players": [
   { "battlefield": ["Voice of Resurgence"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Elemental GW Voice": [2, 2] }
  }
 },
 {
  "name": "ruling: the trigger resolves before the spell and still makes the token when that spell is countered",
  "players": [
   { "hand": ["Cancel"], "battlefield": ["Voice of Resurgence", "Island", "Island", "Island"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
   { "cast": "Cancel", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20, "battlefield_has": ["Elemental GW Voice"] },
    { "life": 20, "graveyard": ["Lightning Bolt"] }
   ]
  }
 }
