[
  {
    "name": "sacrifice to return an artifact card from the graveyard",
    "players": [{ "battlefield": ["Protomatter Powder", "Plains", "Island", "Island", "Island", "Island"], "graveyard": ["Sol Ring"] }, {}],
    "steps": [{ "activate": "Protomatter Powder", "ability": 0, "targets": ["Sol Ring"] }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Sol Ring"], "graveyard": ["Protomatter Powder"] }, {}] }
  },
  {
    "name": "no artifact card in the graveyard: cannot activate",
    "players": [{ "battlefield": ["Protomatter Powder", "Plains", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [{ "activate": "Protomatter Powder", "ability": 0, "illegal": true }],
    "expect": { "players": [{ "battlefield_has": ["Protomatter Powder"] }, {}] }
  },
  {
    "name": "ruling: a colored artifact needs coloured mana: three Plains cannot cast it",
    "players": [{ "hand": ["Protomatter Powder"], "battlefield": ["Plains", "Plains", "Plains"] }, {}],
    "steps": [{ "cast": "Protomatter Powder", "illegal": true }],
    "expect": { "players": [{ "hand_count": 1 }, {}] }
  },
  {
    "name": "ruling: with a blue source Protomatter Powder is castable",
    "players": [{ "hand": ["Protomatter Powder"], "battlefield": ["Plains", "Plains", "Island"] }, {}],
    "steps": [{ "cast": "Protomatter Powder" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Protomatter Powder"] }, {}] }
  }
]
