   "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Whirlwind Adept": [5, 3] } } },
 { "name": "ruling: prowess resolves on top of the spell; a 2-damage Shock on the 4/2 Adept survives it",
   "players": [ { "hand": ["Shock"], "battlefield": ["Whirlwind Adept", "Mountain"] }, {} ],
   "steps": [ { "cast": "Shock", "targets": ["Whirlwind Adept"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Whirlwind Adept"] }, {} ], "pt": { "Whirlwind Adept": [5, 3] } } },
 { "name": "ruling: a creature spell does not cause prowess to trigger",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Whirlwind Adept", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ], "pt": { "Whirlwind Adept": [4, 2] } } },
 { "name": "ruling: playing a land does not cause prowess to trigger",
   "players": [ { "hand": ["Forest"], "battlefield": ["Whirlwind Adept"] }, {} ],
   "steps": [ { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": ["Forest"] }, {} ], "pt": { "Whirlwind Adept": [4, 2] } } },
 { "name": "ruling: prowess is not connected to its spell; countering the spell does not stop prowess",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Whirlwind Adept", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [
