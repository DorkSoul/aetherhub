   ],
   "expect": { "players": [ { "battlefield_has": ["Whirlwind Adept"], "graveyard": ["Lightning Bolt"] }, { "life": 20, "graveyard": ["Counterspell"] } ], "pt": { "Whirlwind Adept": [5, 3] } } }
