[
  {
    "name": "regeneration saves a creature from Terror",
    "players": [
      { "hand": ["Reknit"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Reknit", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "graveyard": ["Reknit"] }, { "graveyard": ["Doom Blade"] }]
    }
  },
  {
    "name": "regenerates a noncreature artifact against Shatter",
    "players": [
      { "hand": ["Reknit"], "battlefield": ["Forest", "Forest", "Ornithopter"] },
      { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Reknit", "targets": ["Ornithopter"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Shatter", "player": 1, "targets": ["Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Ornithopter"] }, { "graveyard": ["Shatter"] }]
    }
  },
  {
    "name": "ruling: a regenerated noncreature permanent is tapped the next time it would be destroyed",
    "players": [
      { "hand": ["Reknit"], "battlefield": ["Forest", "Forest", "Ornithopter"] },
      { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Reknit", "targets": ["Ornithopter"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Shatter", "player": 1, "targets": ["Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Ornithopter"], "graveyard": ["Reknit"] }, { "graveyard": ["Shatter"] }],
      "tapped": { "Ornithopter": true }
    }
  },
  {
    "name": "ruling: the regeneration shield lasts only that turn, so a destroy effect in the opponent's turn kills it",
    "players": [
      { "hand": ["Reknit"], "battlefield": ["Forest", "Forest", "Ornithopter"] },
      { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Reknit", "targets": ["Ornithopter"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "cast": "Shatter", "player": 1, "targets": ["Ornithopter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Reknit", "Ornithopter"] }, { "graveyard": ["Shatter"] }]
    }
  }
]
