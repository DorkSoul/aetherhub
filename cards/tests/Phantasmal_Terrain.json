[
  {
    "name": "enchanted land becomes the chosen basic land type",
    "players": [
      {
        "hand": [
          "Phantasmal Terrain"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Phantasmal Terrain",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true,
        "answers": [
          "Island"
        ]
      },
      {
        "resolve": true
      },
      {
        "tap_for_mana": "Forest",
        "color": "U"
      }
    ],
    "expect": {
      "attached": {
        "Phantasmal Terrain": "Forest"
      }
    }
  },
  {
    "name": "the land stays the chosen type while the Aura is attached",
    "players": [
      {
        "hand": [
          "Phantasmal Terrain"
        ],
        "battlefield": [
          "Plains",
          "Island",
          "Island",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Phantasmal Terrain",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true,
        "answers": [
          "Plains"
        ]
      },
      {
        "resolve": true
      },
      {
        "tap_for_mana": "Forest",
        "color": "W"
      }
    ],
    "expect": {
      "attached": {
        "Phantasmal Terrain": "Forest"
      }
    }
  },
  {
    "name": "ruling: the Aura does not add snow, and a snow land stays snow (it still pays {S} for Boreal Centaur)",
    "players": [
      { "hand": ["Phantasmal Terrain"], "battlefield": ["Boreal Centaur", "Snow-Covered Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Phantasmal Terrain", "targets": ["Snow-Covered Forest"] },
      { "resolve": true, "answers": ["Island"] },
      { "resolve": true },
      { "activate": "Boreal Centaur", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Boreal Centaur": [3, 3] },
      "attached": { "Phantasmal Terrain": "Snow-Covered Forest" },
      "tapped": { "Snow-Covered Forest": true }
    }
  },
  {
    "name": "ruling: the Aura does not make a non-snow land snow, so it cannot pay {S}",
    "players": [
      { "hand": ["Phantasmal Terrain"], "battlefield": ["Boreal Centaur", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Phantasmal Terrain", "targets": ["Forest"] },
      { "resolve": true, "answers": ["Island"] },
      { "resolve": true },
      { "activate": "Boreal Centaur", "ability": 0, "illegal": true }
    ],
    "expect": {
      "pt": { "Boreal Centaur": [2, 2] },
      "attached": { "Phantasmal Terrain": "Forest" }
    }
  }
]
