 {
  "name": "ruling: populate resolves before the spell and still happens when that spell is countered",
  "players": [
   {
    "hand": [ "Lightning Bolt" ],
    "battlefield": [ "Song of the Worldsoul", "Mountain", "Soldier" ]
   },
   {
    "hand": [ "Counterspell" ],
    "battlefield": [ "Island", "Island" ]
   }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": [ "p1" ] },
   { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": [ "Song of the Worldsoul", "Mountain", "Soldier", "Soldier" ], "graveyard": [ "Lightning Bolt" ] },
    { "graveyard": [ "Counterspell" ] }
   ]
  }
 },
 {
  "name": "ruling: populate chooses the token to copy (a Zombie rather than the first Soldier)",
  "players": [
   {
    "hand": [ "Lightning Bolt" ],
    "battlefield": [ "Song of the Worldsoul", "Mountain", "Soldier", "Zombie" ]
   },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": [ "p1" ] },
   { "resolve": true, "answers": [ [ "Zombie" ] ] }
  ],
  "expect": {
   "players": [
    { "battlefield": [ "Song of the Worldsoul", "Mountain", "Soldier", "Zombie", "Zombie" ] },
    {}
   ]
  }
 }
]