[
  { "name": "exiles up to three target cards that all come from one graveyard",
    "players": [ { "hand": ["Rapid Decay"], "battlefield": ["Swamp", "Island"] }, { "graveyard": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ],
    "steps": [
      { "cast": "Rapid Decay", "targets": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Rapid Decay"] }, { "graveyard": [], "exile": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ] }
  },
  { "name": "a set spanning two graveyards keeps only the first owner's cards",
    "players": [ { "hand": ["Rapid Decay"], "battlefield": ["Swamp", "Island"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Rapid Decay", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Rapid Decay"], "exile": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "exile": [] } ] }
  },
  { "name": "cycling {2}: discard it to draw a card",
    "players": [ { "hand": ["Rapid Decay"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Rapid Decay" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Rapid Decay"] }, {} ] }
  },
  { "name": "ruling: a target that already left is skipped; the other targets are still exiled",
    "players": [ { "hand": ["Rapid Decay", "Rapid Decay"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ],
    "steps": [
      { "cast": "Rapid Decay", "targets": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] },
      { "cast": "Rapid Decay", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Rapid Decay"] }, { "graveyard": [], "exile": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ] }
  }
]
