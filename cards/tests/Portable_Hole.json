[
  {
    "name": "exiles an opposing nonland permanent with mana value 2 or less",
    "players": [
      {
        "hand": [
          "Portable Hole"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Portable Hole"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Portable Hole"
          ]
        },
        {
          "exile": [
            "Grizzly Bears"
          ],
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "does not exile a permanent with mana value 3 or more",
    "players": [
      {
        "hand": [
          "Portable Hole"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Portable Hole"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield_has": [
            "Serra Angel"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: if Portable Hole leaves before its ability resolves, the target is not exiled",
    "players": [
      { "hand": ["Portable Hole", "Shatter"], "battlefield": ["Plains", "Mountain", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Portable Hole" },
      { "resolve": true },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Shatter", "targets": ["Portable Hole"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Shatter"], "battlefield_lacks": ["Portable Hole"] },
        { "battlefield_has": ["Grizzly Bears"], "exile": [] }
      ]
    }
  },
  {
    "name": "ruling: an Aura attached to the exiled permanent goes to its owner's graveyard",
    "players": [
      { "hand": ["Holy Strength", "Portable Hole"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Holy Strength", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Portable Hole" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Holy Strength"], "battlefield_has": ["Portable Hole"] },
        { "exile": ["Grizzly Bears"], "battlefield": [] }
      ]
    }
  }
]
