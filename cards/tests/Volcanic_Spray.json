[
  {
    "name": "damages each non-flying creature and each player",
    "players": [
      { "hand": ["Volcanic Spray"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Llanowar Elves", "Birds of Paradise"] }
    ],
    "steps": [
      { "cast": "Volcanic Spray" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 19, "graveyard": ["Volcanic Spray"] },
        { "life": 19, "battlefield_has": ["Birds of Paradise"], "battlefield_lacks": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "flashback from the graveyard for 1R then exiled",
    "players": [
      { "graveyard": ["Volcanic Spray"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Volcanic Spray", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 19, "exile": ["Volcanic Spray"] }, { "life": 19 }]
    }
  },
  {
    "name": "ruling: flashback keeps sorcery timing, so it cannot be cast on the opponent's turn",
    "players": [
      { "graveyard": ["Volcanic Spray"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Volcanic Spray", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Volcanic Spray"] }, { "life": 20 }]
    }
  }
]
