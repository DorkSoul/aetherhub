[
 {
  "name": "cannot pick a graveyard artifact that belongs to another player's controller",
  "players": [
   {
    "battlefield": [
     "Goblin Welder"
    ],
    "graveyard": [
     "Mind Stone"
    ]
   },
   {
    "battlefield": [
     "Sol Ring"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Goblin Welder",
    "targets": [
     "Sol Ring",
     "Mind Stone"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Goblin Welder"
     ],
     "graveyard": [
      "Mind Stone"
     ]
    },
    {
     "battlefield": [
      "Sol Ring"
     ]
    }
   ]
  }
 },
 {
  "name": "sacrifices the artifact and returns the graveyard artifact card to the battlefield",
  "players": [
   {
    "battlefield": [
     "Goblin Welder"
    ]
   },
   {
    "battlefield": [
     "Sol Ring"
    ],
    "graveyard": [
     "Mind Stone"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Goblin Welder",
    "ability": 0,
    "targets": [
     "Sol Ring",
     "Mind Stone"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Goblin Welder"
     ],
     "battlefield_lacks": [
      "Mind Stone"
     ]
    },
    {
     "battlefield_has": [
      "Mind Stone"
     ],
     "battlefield_lacks": [
      "Sol Ring"
     ],
     "graveyard_has": [
      "Sol Ring"
     ]
    }
   ]
  }
 },
 {
  "name": "does nothing when the graveyard card is not an artifact of the same player",
  "players": [
   {
    "battlefield": [
     "Goblin Welder"
    ],
    "graveyard": [
     "Lightning Bolt"
    ]
   },
   {
    "battlefield": [
     "Sol Ring"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Goblin Welder",
    "ability": 0,
    "targets": [
     "Sol Ring",
     "Lightning Bolt"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard_has": [
      "Lightning Bolt"
     ]
    },
    {
     "battlefield_has": [
      "Sol Ring"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: if the graveyard card is exiled in response, nothing is sacrificed",
  "players": [
   {
    "battlefield": ["Goblin Welder"]
   },
   {
    "battlefield": ["Sol Ring", "Tormod's Crypt"],
    "graveyard": ["Mind Stone"]
   }
  ],
  "steps": [
   {
    "activate": "Goblin Welder",
    "ability": 0,
    "targets": ["Sol Ring", "Mind Stone"]
   },
   {
    "pass": true
   },
   {
    "activate": "Tormod's Crypt",
    "player": 1,
    "targets": ["p1"]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": ["Goblin Welder"]
    },
    {
     "battlefield_has": ["Sol Ring"],
     "battlefield_lacks": ["Mind Stone"]
    }
   ]
  }
 },
 {
  "name": "ruling: if the targeted artifact is destroyed in response, nothing is returned",
  "players": [
   {
    "battlefield": ["Goblin Welder"]
   },
   {
    "hand": ["Abrade"],
    "battlefield": ["Sol Ring", "Mountain", "Mountain"],
    "graveyard": ["Mind Stone"]
   }
  ],
  "steps": [
   {
    "activate": "Goblin Welder",
    "ability": 0,
    "targets": ["Sol Ring", "Mind Stone"]
   },
   {
    "pass": true
   },
   {
    "cast": "Abrade",
    "player": 1,
    "targets": ["Sol Ring"],
    "answers": [1]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": ["Goblin Welder"]
    },
    {
     "battlefield_lacks": ["Mind Stone"],
     "graveyard_has": ["Sol Ring", "Mind Stone"]
    }
   ]
  }
 }
]