[
  {
    "name": "tap: gets +3/+3 until end of turn",
    "players": [ { "battlefield": ["Boa Constrictor"] }, {} ],
    "steps": [
      { "activate": "Boa Constrictor", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Boa Constrictor": [6, 6] }, "tapped": { "Boa Constrictor": true } }
  },
  {
    "name": "tapped Boa Constrictor cannot activate again",
    "players": [ { "battlefield": ["Boa Constrictor"] }, {} ],
    "steps": [
      { "activate": "Boa Constrictor", "ability": 0 },
      { "resolve": true },
      { "activate": "Boa Constrictor", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Boa Constrictor": [6, 6] } }
  }
]
