[
  { "name": "without the initiative nothing is drawn at your end step",
    "players": [ { "battlefield": ["Imoen, Mystic Trickster"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "with the initiative you draw a card at your end step",
    "players": [ { "hand": [], "battlefield": ["Dungeoneer's Pack", "Swamp", "Swamp", "Imoen, Mystic Trickster"], "library": ["Island"] }, {} ],
    "steps": [ { "activate": "Dungeoneer's Pack", "ability": 0 }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] } },
  { "name": "ward {2}: the opponent has only 1 spare mana, cannot pay, Bolt is countered and Imoen survives",
    "players": [ { "battlefield": ["Imoen, Mystic Trickster"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Imoen, Mystic Trickster"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Imoen, Mystic Trickster"] }, { "graveyard_has": ["Lightning Bolt"] } ] } },
  { "name": "ward {2}: the opponent pays 2 with spare mana, Bolt resolves and kills Imoen",
    "players": [ { "battlefield": ["Imoen, Mystic Trickster"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Imoen, Mystic Trickster"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "graveyard_has": ["Imoen, Mystic Trickster"] }, { "life": 20 } ] } },
  { "name": "ruling: with two commanders the commander tax is tracked per commander",
    "commander": true,
    "players": [ { "command": ["Imoen, Mystic Trickster", "Grizzly Bears"], "battlefield": ["Island", "Island", "Island", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Imoen, Mystic Trickster" }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Imoen, Mystic Trickster", "Grizzly Bears"] }, {} ] } }
]
