[
  {
    "name": "creature tokens get +1/+1 (Fractal token from Leyline Invocation)",
    "players": [
      { "hand": ["Leyline Invocation"], "battlefield": ["Leyline of the Meek", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Leyline Invocation" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Fractal 0-0 Green Blue": [7, 7] }
    }
  },
  {
    "name": "non-token creatures are not affected",
    "players": [
      { "battlefield": ["Leyline of the Meek", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "opening hand: may begin the game with it on the battlefield",
    "players": [ { "hand": ["Leyline of the Meek"] }, {} ],
    "steps": [],
    "expect": { "players": [ { "battlefield_has": ["Leyline of the Meek"] }, {} ] }
  },
  {
    "name": "ruling: a Clone copy of a Fractal token is not a token and gets no bonus (dies as a 0/0)",
    "players": [
      { "hand": ["Leyline Invocation", "Clone"], "battlefield": ["Leyline of the Meek", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Leyline Invocation" },
      { "resolve": true },
      { "cast": "Clone" },
      { "resolve": true, "answers": [0] }
    ],
    "expect": {
      "pt": { "Fractal 0-0 Green Blue": [11, 11] },
      "players": [ { "graveyard": ["Clone", "Leyline Invocation"], "battlefield_has": ["Leyline of the Meek", "Fractal 0-0 Green Blue"] }, {} ]
    }
  }
]
