 {
  "name": "ruling: if the only target is gone when Bolt of Keranos resolves, it fizzles and does not scry",
  "players": [
   { "hand": ["Bolt of Keranos"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island", "Forest"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] }
  ],
  "steps": [
   { "cast": "Bolt of Keranos", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Bolt of Keranos"], "library_top": ["Island", "Forest"] },
    { "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: scry 1, keeping the top card on top leaves it there",
  "players": [
   { "hand": ["Bolt of Keranos"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Bolt of Keranos", "targets": ["p1"] },
   { "resolve": true, "answers": [[]] }
  ],
  "expect": {
   "players": [ { "library_top": ["Island", "Forest"] }, { "life": 17 } ]
  }
 },
 {
  "name": "ruling: scry 1, putting the top card on the bottom makes Forest the new top",
  "players": [
   { "hand": ["Bolt of Keranos"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Bolt of Keranos", "targets": ["p1"] },
   { "resolve": true, "answers": [[0]] }
  ],
  "expect": {
   "players": [ { "library_top": ["Forest"] }, { "life": 17 } ]
  }
 }
]
