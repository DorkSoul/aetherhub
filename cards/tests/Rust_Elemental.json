  },
  {
    "name": "ruling: the required artifact sacrifice is not optional (no tap, no life loss)",
    "players": [
      { "battlefield": ["Rust Elemental", "Rusted Sentinel"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
