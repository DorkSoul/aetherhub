[
 { "name": "empower 8: with no Jace token one is created with eight loyalty",
   "players": [ { "hand": ["Jace's Machinations"], "battlefield": ["Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Jace's Machinations" },
              { "resolve": true } ],
   "expect": { "counters": { "Jace": { "loyalty": 8 } }, "players": [ { "battlefield_has": ["Jace"], "graveyard": ["Jace's Machinations"] }, {} ] } },
 { "name": "empower 8 adds to an existing Jace token",
   "players": [ { "hand": ["Jace's Machinations"], "battlefield": ["Island", "Island", "Island", { "name": "Jace", "counters": { "loyalty": 2 } }] }, {} ],
   "steps": [ { "cast": "Jace's Machinations" },
              { "resolve": true } ],
   "expect": { "counters": { "Jace": { "loyalty": 10 } } } },
 { "name": "cast on an opponent's turn, a Jace can then be activated at instant speed",
   "players": [ { "hand": ["Jace's Machinations"], "battlefield": ["Island", "Island", "Island"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" },
              { "pass": true, "player": 1 },
              { "cast": "Jace's Machinations", "player": 0 },
              { "resolve": true },
              { "pass": true, "player": 1 },
              { "activate": "Jace", "ability": 1, "player": 0 },
              { "resolve": true } ],
   "expect": { "turn": 2, "counters": { "Jace": { "loyalty": 5 } }, "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "on your own turn a Jace can be activated with a spell on the stack",
   "players": [ { "hand": ["Jace's Machinations", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"] }, {} ],
   "steps": [ { "cast": "Jace's Machinations" },
              { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "activate": "Jace", "ability": 1 },
              { "resolve": true } ],
   "expect": { "counters": { "Jace": { "loyalty": 5 } }, "players": [ { "hand_count": 1 }, { "life": 17 } ] } },
 { "name": "only until end of turn: next turn it is sorcery speed again",
   "players": [ { "hand": ["Jace's Machinations"], "battlefield": ["Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Jace's Machinations" },
              { "resolve": true },
              { "advance_to": "Upkeep" },
              { "pass": true, "player": 1 },
              { "activate": "Jace", "ability": 1, "player": 0, "illegal": true } ],
   "expect": { "turn": 2, "counters": { "Jace": { "loyalty": 8 } } } },
 { "name": "it only covers Jace planeswalkers",
   "players": [ { "hand": ["Jace's Machinations"], "battlefield": ["Island", "Island", "Island", { "name": "Garruk Wildspeaker", "counters": { "loyalty": 3 } }] }, {} ],
   "steps": [ { "advance_to": "Upkeep" },
              { "pass": true, "player": 1 },
              { "cast": "Jace's Machinations", "player": 0 },
              { "resolve": true },
              { "pass": true, "player": 1 },
              { "activate": "Garruk Wildspeaker", "ability": 0, "player": 0, "illegal": true } ],
   "expect": { "counters": { "Garruk Wildspeaker": { "loyalty": 3 } } } }
]
