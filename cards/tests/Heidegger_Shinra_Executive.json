[
 { "name": "beginning of combat pump equals number of Soldiers you control",
   "players": [ { "battlefield": ["Plains","Plains","Heidegger, Shinra Executive","Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [3, 2] } } },
 { "name": "end step makes a Soldier for each opponent with more creatures",
   "players": [ { "battlefield": ["Plains","Plains","Heidegger, Shinra Executive"] }, { "battlefield": ["Grizzly Bears", "Grizzly Bears"] } ],
   "steps": [ { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Soldier"] }, {} ] } },
 { "name": "no token when opponent does not control more creatures",
   "players": [ { "battlefield": ["Plains","Plains","Heidegger, Shinra Executive"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Soldier"] }, {} ] } },
 { "name": "ruling: X is counted once as the pump resolves, so Heidegger dying afterwards does not shrink the bonus",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Plains", "Plains", "Heidegger, Shinra Executive", "Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Heidegger, Shinra Executive"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Heidegger, Shinra Executive"] }, {} ], "pt": { "Grizzly Bears": [3, 2] } } }
]
