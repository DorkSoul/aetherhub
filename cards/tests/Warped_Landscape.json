[
  {
    "name": "sacrifices itself to fetch a basic land onto the battlefield tapped",
    "players": [
      { "battlefield": ["Warped Landscape", "Forest", "Swamp"], "library": ["Island", "Steam Vents", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Warped Landscape" },
      { "resolve": true, "answers": ["Island"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Island", "Forest", "Swamp"], "battlefield_lacks": ["Warped Landscape"], "graveyard_has": ["Warped Landscape"] },
        {}
      ],
      "tapped": { "Island": true }
    }
  },
  {
    "name": "cannot fetch without paying {2} from other permanents",
    "players": [
      { "battlefield": ["Warped Landscape", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "activate": "Warped Landscape", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Warped Landscape"] },
        {}
      ]
    }
  }
]
