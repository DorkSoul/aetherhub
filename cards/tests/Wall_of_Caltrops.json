[
  {
    "name": "blocks together with another Wall only: gains banding until end of turn",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": [{"name": "Wall of Caltrops", "counters": {"p1p1": 3}}, "Academy Wall"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Caltrops", "attacker": "Hill Giant" }, { "blocker": "Academy Wall", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "keywords": { "Wall of Caltrops": ["Defender", "Banding"] }
    }
  },
  {
    "name": "non-Wall blocker alongside: does not gain banding",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": [{"name": "Wall of Caltrops", "counters": {"p1p1": 3}}, "Academy Wall", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Caltrops", "attacker": "Hill Giant" }, { "blocker": "Academy Wall", "attacker": "Hill Giant" }, { "blocker": "Grizzly Bears", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "keywords": { "Wall of Caltrops": ["Defender"] }
    }
  },
  {
    "name": "blocking alone: does not gain banding",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": [{"name": "Wall of Caltrops", "counters": {"p1p1": 3}}] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Caltrops", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "keywords": { "Wall of Caltrops": ["Defender"] }
    }
  },
  {
    "name": "ruling: banding is gained when the trigger resolves in the declare blockers step",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": [{"name": "Wall of Caltrops", "counters": {"p1p1": 3}}, "Academy Wall"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Caltrops", "attacker": "Hill Giant" }, { "blocker": "Academy Wall", "attacker": "Hill Giant" }] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Wall of Caltrops": ["Defender", "Banding"] }
    }
  }
]
