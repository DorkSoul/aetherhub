[
  {
    "name": "ruling: destroying the Hero token leaves the Equipment on the battlefield",
    "players": [ { "hand": ["Dragoon's Lance", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Mountain"] }, {} ],
    "steps": [ { "cast": "Dragoon's Lance" }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Hero"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dragoon's Lance"], "battlefield_lacks": ["Hero"] }, {} ] }
  },
  {
    "name": "ruling: equip moves the Equipment from the Hero token to another creature",
    "players": [ { "hand": ["Dragoon's Lance"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Dragoon's Lance" }, { "resolve": true }, { "resolve": true }, { "activate": "Dragoon's Lance", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Dragoon's Lance", "Grizzly Bears", "Hero"] }, {} ],
      "pt": { "Hero": [1, 1], "Grizzly Bears": [3, 2] },
      "attached": { "Dragoon's Lance": "Grizzly Bears" }
    }
  },
  {
    "name": "job select creates a Hero and attaches to it",
    "players": [ { "hand": ["Dragoon's Lance"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Dragoon's Lance" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Dragoon's Lance", "Hero"] }, {} ],
      "pt": { "Hero": [2, 1] },
      "attached": { "Dragoon's Lance": "Hero" }
    }
  },
  {
    "name": "equipped creature has flying during your turn",
    "players": [ { "battlefield": ["Dragoon's Lance", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Dragoon's Lance", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Dragoon's Lance", "Grizzly Bears"] }, {} ],
      "pt": { "Grizzly Bears": [3, 2] },
      "keywords": { "Grizzly Bears": ["Flying"] },
      "attached": { "Dragoon's Lance": "Grizzly Bears" }
    }
  },
  {
    "name": "equipped creature is a Knight in addition to its other types",
    "players": [ { "battlefield": ["Dragoon's Lance", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Dragoon's Lance", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "subtypes": { "Grizzly Bears": ["Knight"] } }
  },
  {
    "name": "an unequipped creature is not a Knight",
    "players": [ { "battlefield": ["Dragoon's Lance", "Grizzly Bears"] }, {} ],
    "steps": [],
    "expect": { "not_subtypes": { "Grizzly Bears": ["Knight"] } }
  }
]
