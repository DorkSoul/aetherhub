[
  {
    "name": "fight mode: your creature fights an opposing creature",
    "players": [
      { "hand": ["Clash of the Eikons"], "battlefield": ["Forest", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Clash of the Eikons", "answers": [[0]], "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "put a lore counter on a Saga you control",
    "players": [
      { "hand": ["Clash of the Eikons"], "battlefield": ["Forest", "Book of Mazarbul"] },
      {}
    ],
    "steps": [
      { "cast": "Clash of the Eikons", "answers": [[2]], "targets": ["Book of Mazarbul"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Book of Mazarbul"] },
        {}
      ],
      "counters": { "Book of Mazarbul": { "lore": 2 } }
    }
  },
  {
    "name": "remove a lore counter from a Saga you control",
    "players": [
      { "hand": ["Clash of the Eikons"], "battlefield": ["Forest", "Book of Mazarbul"] },
      {}
    ],
    "steps": [
      { "cast": "Clash of the Eikons", "answers": [[1]], "targets": ["Book of Mazarbul"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Book of Mazarbul"] },
        {}
      ],
      "counters": { "Book of Mazarbul": { "lore": 0 } }
    }
  },
  {
    "name": "ruling: removing a lore counter does not trigger a chapter ability",
    "players": [
      { "hand": ["Clash of the Eikons"], "battlefield": ["Forest", { "name": "Book of Mazarbul", "counters": { "lore": 2 } }] },
      {}
    ],
    "steps": [
      { "cast": "Clash of the Eikons", "answers": [[1]], "targets": ["Book of Mazarbul"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Book of Mazarbul"], "battlefield_lacks": ["Army"] },
        {}
      ],
      "counters": { "Book of Mazarbul": { "lore": 1 } }
    }
  },
  {
    "name": "ruling: a chapter ability triggers again after a removed lore counter is put back",
    "players": [
      { "hand": ["Clash of the Eikons", "Clash of the Eikons"], "battlefield": ["Forest", "Forest", { "name": "Book of Mazarbul", "counters": { "lore": 2 } }] },
      {}
    ],
    "steps": [
      { "cast": "Clash of the Eikons", "answers": [[1]], "targets": ["Book of Mazarbul"] },
      { "resolve": true },
      { "cast": "Clash of the Eikons", "answers": [[2]], "targets": ["Book of Mazarbul"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Book of Mazarbul", "Army"] },
        {}
      ],
      "counters": { "Book of Mazarbul": { "lore": 2 } }
    }
  }
]
