[
  {
    "name": "opponent reveals hand; you pick a nonland card to discard",
    "players": [
      { "hand": ["Dark Inquiry"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt", "Grizzly Bears", "Forest"] }
    ],
    "steps": [{ "cast": "Dark Inquiry", "targets": ["p1"] }, { "resolve": true, "answers": ["Lightning Bolt"] }],
    "expect": { "players": [{}, { "graveyard": ["Lightning Bolt"], "hand": ["Grizzly Bears", "Forest"] }] }
  },
  {
    "name": "creature cards are eligible too",
    "players": [
      { "hand": ["Dark Inquiry"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [{ "cast": "Dark Inquiry", "targets": ["p1"] }, { "resolve": true, "answers": ["Grizzly Bears"] }],
    "expect": { "players": [{}, { "graveyard": ["Grizzly Bears"], "hand": ["Forest"] }] }
  },
  {
    "name": "only lands in hand: nothing happens",
    "players": [
      { "hand": ["Dark Inquiry"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Forest"] }
    ],
    "steps": [{ "cast": "Dark Inquiry", "targets": ["p1"] }, { "resolve": true }],
    "expect": { "players": [{}, { "graveyard": [], "hand": ["Forest"] }] }
  }
]
