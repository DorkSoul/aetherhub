[
  {
    "name": "counters a noncreature spell and draws a card",
    "players": [
      { "hand": ["Scatter Arc"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] },
      { "cast": "Scatter Arc", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Scatter Arc"], "hand_count": 1 },
        { "graveyard": ["Lightning Bolt"], "life": 20 }
      ]
    }
  },
  {
    "name": "cannot target a creature spell",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] },
      { "hand": ["Scatter Arc"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "player": 1, "cast": "Scatter Arc", "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield": ["Forest", "Forest"] }, { "hand": ["Scatter Arc"] } ]
    }
  }
]
