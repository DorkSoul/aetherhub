[
  { "name": "ETB exiles a permanent card from your graveyard and you may cast it from exile for one less",
    "players": [ { "hand": ["Savvy Trader"], "graveyard": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Savvy Trader" }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Savvy Trader", "Grizzly Bears"], "exile": [] }, {} ] } },
  { "name": "a spell cast from hand gets no reduction",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Savvy Trader"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] } },
  { "name": "an instant card in the graveyard is not a legal target for the ETB exile",
    "players": [ { "hand": ["Savvy Trader"], "graveyard": ["Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Savvy Trader" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "exile": [] }, {} ] } },
  { "name": "ruling: the reduction only pays generic, so Grizzly Bears from exile still needs its G (a Swamp cannot pay it)",
    "players": [ { "hand": ["Savvy Trader"], "graveyard": ["Grizzly Bears"], "battlefield": ["Forest", "Plains", "Island", "Mountain", "Swamp"] }, {} ],
    "steps": [ { "tap_for_mana": "Plains" }, { "tap_for_mana": "Island" }, { "tap_for_mana": "Mountain" }, { "cast": "Savvy Trader" }, { "resolve": true }, { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: the exiled card stays castable after Savvy Trader leaves, at its full cost",
    "players": [ { "hand": ["Savvy Trader"], "graveyard": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Savvy Trader" }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Savvy Trader"] }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Savvy Trader"], "exile": [] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: an exiled land can be played in a main phase with an empty stack",
    "players": [ { "hand": ["Savvy Trader"], "graveyard": ["Forest"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Savvy Trader" }, { "resolve": true }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "exile": [], "battlefield_has": ["Savvy Trader"] }, {} ] } },
  { "name": "ruling: an exiled land cannot be played during combat",
    "players": [ { "hand": ["Savvy Trader"], "graveyard": ["Forest"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Savvy Trader" }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Forest"] }, {} ] } }
]
