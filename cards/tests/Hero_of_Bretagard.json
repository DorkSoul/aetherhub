[
  {
    "name": "five counters make it an Angel",
    "players": [ { "battlefield": [ { "name": "Hero of Bretagard", "counters": { "p1p1": 5 } } ] }, {} ],
    "steps": [],
    "expect": { "subtypes": { "Hero of Bretagard": ["Angel"] } }
  },
  {
    "name": "four counters: not an Angel",
    "players": [ { "battlefield": [ { "name": "Hero of Bretagard", "counters": { "p1p1": 4 } } ] }, {} ],
    "steps": [],
    "expect": { "not_subtypes": { "Hero of Bretagard": ["Angel"] } }
  },
  {
    "name": "ten counters make it a God",
    "players": [ { "battlefield": [ { "name": "Hero of Bretagard", "counters": { "p1p1": 10 } } ] }, {} ],
    "steps": [],
    "expect": { "subtypes": { "Hero of Bretagard": ["God"] } }
  },
  {
    "name": "nine counters: not a God",
    "players": [ { "battlefield": [ { "name": "Hero of Bretagard", "counters": { "p1p1": 9 } } ] }, {} ],
    "steps": [],
    "expect": { "not_subtypes": { "Hero of Bretagard": ["God"] } }
  },
  {
    "name": "stats",
    "players": [{ "battlefield": ["Hero of Bretagard"] }, {}],
    "steps": [],
    "expect": { "pt": { "Hero of Bretagard": [1, 1] } }
  },
  {
    "name": "a card exiled from your hand puts a counter",
    "players": [
      { "hand": ["Simian Spirit Guide", "Lightning Bolt"], "battlefield": ["Hero of Bretagard"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Hero of Bretagard": { "p1p1": 1 } },
      "pt": { "Hero of Bretagard": [2, 2] }
    }
  },
  {
    "name": "your spell exiling a permanent puts a counter",
    "players": [
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Hero of Bretagard"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Swords to Plowshares", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Hero of Bretagard": { "p1p1": 1 } },
      "players": [{}, { "exile": ["Hill Giant"] }]
    }
  },
  {
    "name": "five counters give flying",
    "players": [
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", { "name": "Hero of Bretagard", "counters": { "p1p1": 4 } }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Swords to Plowshares", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Hero of Bretagard": { "p1p1": 5 } },
      "keywords": { "Hero of Bretagard": ["Flying"] },
      "pt": { "Hero of Bretagard": [6, 6] }
    }
  },
  {
    "name": "ten counters give indestructible",
    "players": [
      { "battlefield": [{ "name": "Hero of Bretagard", "counters": { "p1p1": 10 } }] },
      {}
    ],
    "steps": [],
    "expect": { "keywords": { "Hero of Bretagard": ["Flying", "Indestructible"] }, "pt": { "Hero of Bretagard": [11, 11] } }
  },
  {
    "name": "an opponent's spell exiling a permanent gives no counter",
    "players": [
      { "battlefield": ["Hero of Bretagard", "Hill Giant"] },
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Swords to Plowshares", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "counters": { "Hero of Bretagard": { "p1p1": 0 } } }
  },
  {
    "name": "ruling: any kind of counter counts toward the Angel threshold",
    "players": [ { "battlefield": [ { "name": "Hero of Bretagard", "counters": { "charge": 5 } } ] }, {} ],
    "steps": [],
    "expect": { "subtypes": { "Hero of Bretagard": ["Angel"] } }
  },
  {
    "name": "ruling: a permanent exiled by your spell counts even if you do not control it",
    "players": [
      { "hand": ["Journey to Nowhere"], "battlefield": ["Plains", "Plains", "Hero of Bretagard"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Journey to Nowhere" },
      { "resolve": true, "answers": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Hero of Bretagard": { "p1p1": 1 } },
      "players": [ {}, { "exile": ["Hill Giant"] } ]
    }
  },
  {
    "name": "ruling: ten counters make it an Angel, God, Human and Warrior",
    "players": [ { "battlefield": [ { "name": "Hero of Bretagard", "counters": { "p1p1": 10 } } ] }, {} ],
    "steps": [],
    "expect": { "subtypes": { "Hero of Bretagard": ["Angel", "God", "Human", "Warrior"] } }
  }
]
