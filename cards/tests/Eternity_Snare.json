[
 {
  "name": "enters and draws a card",
  "players": [
   { "hand": ["Eternity Snare"], "battlefield": ["Island", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Eternity Snare", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 1, "battlefield_has": ["Eternity Snare"] }, {} ],
   "attached": { "Eternity Snare": "Grizzly Bears" }
  }
 },
 {
  "name": "enchanted creature does not untap during its controller's untap step",
  "players": [
   { "hand": ["Eternity Snare"], "battlefield": ["Island", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Eternity Snare", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "without the aura the creature untaps normally",
  "players": [
   { "battlefield": ["Island"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "advance_to": "Main1" }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false }
  }
 }
]
