[
  {
    "name": "another nontoken Spirit entering creates a Spirit token",
    "players": [
      { "hand": ["Blessed Spirits"], "battlefield": ["Baboon Spirit", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Blessed Spirits" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Baboon Spirit", "Blessed Spirits", "Spirit 1-1 Colorless Interacts Only With Spirits"] },
        {}
      ]
    }
  },
  {
    "name": "a non-Spirit entering does not create a token",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Baboon Spirit", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Spirit 1-1 Colorless Interacts Only With Spirits"] },
        {}
      ]
    }
  },
  {
    "name": "exiles another creature and returns it at the next end step",
    "players": [
      { "battlefield": ["Baboon Spirit", "Grizzly Bears", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Baboon Spirit", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Baboon Spirit", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "cannot target itself",
    "players": [
      { "battlefield": ["Baboon Spirit", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Baboon Spirit", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Baboon Spirit"] },
        {}
      ]
    }
  }
]
