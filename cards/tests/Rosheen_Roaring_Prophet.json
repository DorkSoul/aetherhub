[
  { "name": "enters: mill six and put the X card milled into hand",
    "players": [ { "hand": ["Rosheen, Roaring Prophet"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest"], "library": ["Blaze", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Rosheen, Roaring Prophet" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand": ["Blaze"], "battlefield_has": ["Rosheen, Roaring Prophet"] }, {} ] } },
  { "name": "enters: declining leaves the X card in the graveyard",
    "players": [ { "hand": ["Rosheen, Roaring Prophet"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest"], "library": ["Blaze", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Rosheen, Roaring Prophet" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": [], "graveyard_has": ["Blaze"] }, {} ] } },
  { "name": "tap: two colorless per X card in hand pays for an X spell",
    "players": [ { "hand": ["Blaze", "Blaze"], "battlefield": ["Rosheen, Roaring Prophet", "Mountain"] }, {} ],
    "steps": [ { "cast": "Blaze", "targets": ["p1"], "answers": [2] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blaze"], "hand": ["Blaze"] }, { "life": 18 } ], "tapped": { "Rosheen, Roaring Prophet": true } } },
  { "name": "tap: the mana cannot pay for a spell without X in its cost",
    "players": [ { "hand": ["Blaze", "Grizzly Bears"], "battlefield": ["Rosheen, Roaring Prophet", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Blaze", "Grizzly Bears"] }, {} ] } },
  { "name": "ruling: Rosheen's mana pays the generic part of an X cost (Tyrant Guard X=2 costs {2}{2}{G})",
    "players": [ { "hand": ["Tyrant Guard", "Blaze", "Blaze"], "battlefield": ["Rosheen, Roaring Prophet", "Forest"] }, {} ],
    "steps": [ { "cast": "Tyrant Guard", "answers": [2] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Blaze", "Blaze"], "battlefield_has": ["Tyrant Guard"] }, {} ], "pt": { "Tyrant Guard": [5, 5] }, "tapped": { "Rosheen, Roaring Prophet": true } } },
  { "name": "ruling: Rosheen's mana can be spent across two X spells, not all on the same cost",
    "players": [ { "hand": ["Blaze", "Blaze", "Blaze"], "battlefield": ["Rosheen, Roaring Prophet", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Blaze", "targets": ["p1"], "answers": [1] }, { "resolve": true },
      { "cast": "Blaze", "targets": ["p1"], "answers": [1] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Blaze"] }, { "life": 18 } ], "tapped": { "Rosheen, Roaring Prophet": true } } }
]
