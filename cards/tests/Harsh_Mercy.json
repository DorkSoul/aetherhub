  },
  {
    "name": "both players choosing the same type spares only that type",
    "players": [
      { "hand": ["Harsh Mercy"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears", "Savannah Lions"] }
    ],
    "steps": [ { "cast": "Harsh Mercy" }, { "resolve": true, "answers": ["Bear", "Bear"] } ],
    "expect": { "players": [ { "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] }, { "battlefield": ["Grizzly Bears"] } ] }
  },
  {
    "name": "a regenerating creature is still destroyed",
    "players": [
      { "hand": ["Harsh Mercy"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Drudge Skeletons"] }
    ],
    "steps": [ { "cast": "Harsh Mercy" }, { "resolve": true, "answers": ["Bear", "Bear"] } ],
    "expect": { "players": [ { "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] }, { "graveyard_has": ["Drudge Skeletons"] } ] }
