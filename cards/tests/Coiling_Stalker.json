[
  {
    "name": "ninjutsu swap; combat damage puts a counter on the only creature without one",
    "players": [
      { "hand": ["Coiling Stalker"], "battlefield": [{"name": "Grizzly Bears", "sick": false}, "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "activate": "Coiling Stalker", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Coiling Stalker"], "hand_count": 1 }, { "life": 18 }],
      "counters": { "Coiling Stalker": { "P1P1": 1 } }
    }
  },
  {
    "name": "trigger cannot target a creature that already has a +1/+1 counter",
    "players": [
      { "hand": ["Coiling Stalker"], "battlefield": [{"name": "Grizzly Bears", "sick": false}, "Forest", "Forest", {"name": "Llanowar Elves", "counters": {"P1P1": 1}}] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "activate": "Coiling Stalker", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Coiling Stalker", "Llanowar Elves"] }, { "life": 18 }],
      "counters": { "Coiling Stalker": { "P1P1": 1 }, "Llanowar Elves": { "P1P1": 1 } }
    }
  },
  {
    "name": "ninjutsu is not available when the attacker was blocked",
    "players": [
      { "hand": ["Coiling Stalker"], "battlefield": [{"name": "Grizzly Bears", "sick": false}, "Forest", "Forest"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" }] },
      { "activate": "Coiling Stalker", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, { "life": 20 }]
    }
  },
  {
    "name": "ruling: ninjutsu cannot be activated before blockers are declared",
    "players": [
      { "hand": ["Coiling Stalker"], "battlefield": [{"name": "Grizzly Bears", "sick": false}, "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "activate": "Coiling Stalker", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1, "battlefield_lacks": ["Coiling Stalker"] }, { "life": 20 }]
    }
  }
]
