    ],
    "steps": [
      { "cast": "Roamer's Routine", "alt": 3 },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [
        { "exile": ["Roamer's Routine"], "battlefield_has": ["Forest", "Alpine Guide"] },
        {}
      ]
    }
  },
  {
    "name": "harmonize tap alternative needs a creature of exactly the reduction power",
    "players": [
      {
        "graveyard": ["Roamer's Routine"],
        "battlefield": ["Forest", "Forest", "Grizzly Bears"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Roamer's Routine", "alt": 3, "illegal": true },
      { "cast": "Roamer's Routine", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Roamer's Routine"] },
        {}
      ]
    }
  },
  {
    "name": "tapping a 4-power creature (Serra Angel) makes harmonize cost just G: one Forest pays, basic fetched",
    "players": [
      {
        "graveyard": ["Roamer's Routine"],
        "battlefield": ["Forest", "Serra Angel"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
