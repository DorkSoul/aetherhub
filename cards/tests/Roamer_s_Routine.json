      {
        "graveyard": ["Roamer's Routine"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Roamer's Routine", "alt": 0 },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [
        { "exile": ["Roamer's Routine"], "battlefield_has": ["Forest"], "library_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "tapping a 3-power creature reduces harmonize to 1G",
