[
  { "name": "tap: prevent the next 2 damage to a target",
    "players": [ { "battlefield": ["Loxodon Anchorite"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "activate": "Loxodon Anchorite", "ability": 0, "targets": ["p0"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 19 }, {} ] } },
  { "name": "without the ability, Lightning Bolt deals all 3",
    "players": [ { "battlefield": ["Loxodon Anchorite"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, {} ] } },
  { "name": "tapping twice in one turn is illegal",
    "players": [ { "battlefield": ["Loxodon Anchorite"] }, {} ],
    "steps": [ { "activate": "Loxodon Anchorite", "ability": 0, "targets": ["p0"] }, { "resolve": true }, { "activate": "Loxodon Anchorite", "ability": 0, "targets": ["p0"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } }
]
