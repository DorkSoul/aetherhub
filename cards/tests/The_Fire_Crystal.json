[
  {
    "name": "creatures you control have haste",
    "players": [
      { "battlefield": ["The Fire Crystal", "Grizzly Bears"] },
      {}
    ],
    "steps": [],
    "expect": {
      "keywords": { "Grizzly Bears": ["Haste"] }
    }
  },
  {
    "name": "copy ability makes a token copy that is sacrificed at the next end step",
    "players": [
      { "battlefield": ["The Fire Crystal", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "The Fire Crystal" },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "The Fire Crystal"], "graveyard": [] },
        {}
      ],
      "tapped": { "The Fire Crystal": true }
    }
  },
  {
    "name": "copy ability needs {4}{R}{R}: illegal with five lands",
    "players": [
      { "battlefield": ["The Fire Crystal", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "The Fire Crystal", "illegal": true }
    ]
  },
  {
    "name": "red spell costs {1} less: Hill Giant ({3}{R}) is castable with three Mountains",
    "players": [
      { "hand": ["Hill Giant"], "battlefield": ["The Fire Crystal", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [ { "cast": "Hill Giant" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "hand_count": 0 }, {} ] }
  },
  {
    "name": "ruling: a token copy of Mulldrifter has its enters trigger and draws two",
    "players": [
      { "battlefield": ["The Fire Crystal", "Mulldrifter", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [ { "activate": "The Fire Crystal", "targets": ["Mulldrifter"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] }
  },
  {
    "name": "ruling: a token copy of Walking Ballista enters with X = 0 counters and dies",
    "players": [
      { "battlefield": ["The Fire Crystal", { "name": "Walking Ballista", "counters": { "p1p1": 2 } }, "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [ { "activate": "The Fire Crystal", "targets": ["Walking Ballista"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield": ["The Fire Crystal", "Walking Ballista", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
      "counters": { "Walking Ballista": { "p1p1": 2 } }
    }
  },
  {
    "name": "ruling: the cost reduction only lowers generic mana, so Lightning Bolt still needs red mana",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["The Fire Crystal"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ]
  }
]
