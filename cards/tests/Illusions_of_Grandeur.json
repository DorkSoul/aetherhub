[
  { "name": "enters: gain 20 life",
    "players": [ { "hand": ["Illusions of Grandeur"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Illusions of Grandeur" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 40 }, {} ] } },
  { "name": "leaves the battlefield: lose 20 life",
    "players": [ { "hand": ["Illusions of Grandeur"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] } ],
    "steps": [ { "cast": "Illusions of Grandeur" }, { "resolve": true }, { "pass": true }, { "player": 1, "cast": "Disenchant", "targets": ["Illusions of Grandeur"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Illusions of Grandeur"] }, {} ] } },
  { "name": "cumulative upkeep {2} is paid with two Islands",
    "players": [ { "battlefield": [ "Illusions of Grandeur", "Island", "Island" ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Illusions of Grandeur"] }, {} ], "counters": { "Illusions of Grandeur": { "age": 1 } } } },
  { "name": "ruling: control change of Illusions does not make its previous controller lose 20 life",
    "players": [ { "hand": ["Kefnet's Last Word"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Illusions of Grandeur"] } ],
    "steps": [ { "cast": "Kefnet's Last Word", "targets": ["Illusions of Grandeur"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Illusions of Grandeur"] }, { "life": 20, "battlefield_lacks": ["Illusions of Grandeur"] } ] } }
]
