  {
    "name": "attacks and mills a non-land: damage goes through",
    "players": [
      {
        "battlefield": [
          "Loafing Giant"
        ],
        "library": [
          "Hill Giant",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Loafing Giant",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      },
