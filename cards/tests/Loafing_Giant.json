  {
    "name": "blocks and mills a land: the combat damage it would deal is prevented, so the attacker survives",
    "players": [
      {
        "battlefield": ["Loafing Giant"],
        "library": ["Forest", "Hill Giant"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Loafing Giant", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Forest"],
          "battlefield_has": ["Loafing Giant"]
        },
        {
          "battlefield_has": ["Grizzly Bears"]
        }
      ]
    }
  },
  {
    "name": "blocks and mills a non-land: the blocked creature's damage is not prevented and the attacker dies",
    "players": [
      {
        "battlefield": ["Loafing Giant"],
        "library": ["Hill Giant", "Forest"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Loafing Giant", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Hill Giant"],
          "battlefield_has": ["Loafing Giant"]
        },
        {
          "graveyard": ["Grizzly Bears"]
        }
      ]
    }
  },
  {
    "name": "ruling: blocking two attackers still triggers the blocks ability only once (one card milled)",
    "players": [
      {
        "battlefield": ["Loafing Giant"],
        "library": ["Mountain", "Forest"]
      },
      {
        "battlefield": ["Grizzly Bears", "Hill Giant"]
      }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Loafing Giant", "attacker": "Grizzly Bears" }, { "blocker": "Loafing Giant", "attacker": "Hill Giant" } ], "player": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Mountain"],
          "battlefield_has": ["Loafing Giant"]
        },
        {}
      ]
    }
  }
