[
  { "name": "damage from our own Bolt gives us poison",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Reaper of Sheoldred"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Reaper of Sheoldred"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "poison": 1, "life": 20 }, {} ] } },
  { "name": "opponent's Bolt gives the opponent poison",
    "players": [ { "battlefield": ["Reaper of Sheoldred"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Reaper of Sheoldred"], "player": 1 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "poison": 0 }, { "poison": 1, "life": 20 } ] } },
  { "name": "damage to another creature gives no poison",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Reaper of Sheoldred"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "poison": 0 }, { "poison": 0 } ] } },
  { "name": "ruling: each damage event gives its controller a poison counter (two Bolts, two poison)",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }, { "battlefield": ["Reaper of Sheoldred"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Reaper of Sheoldred"] }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Reaper of Sheoldred"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "poison": 2, "life": 20 }, {} ] } }
]
