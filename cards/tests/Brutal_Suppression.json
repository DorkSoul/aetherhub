[
  { "name": "a nontoken Rebel's ability costs an additional land sacrifice",
    "players": [ { "battlefield": ["Brutal Suppression", { "name": "Rathi Trapper", "sick": false }, "Swamp", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Rathi Trapper", "targets": ["p1:Grizzly Bears"], "answers": ["Plains"] }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": true, "Rathi Trapper": true }, "players": [ { "graveyard": ["Plains"], "battlefield": ["Brutal Suppression", "Rathi Trapper", "Swamp"] }, {} ] } },
  { "name": "a Rebel's ability can't be activated with no land to sacrifice",
    "players": [ { "battlefield": ["Brutal Suppression", { "name": "Saltfield Recluse", "sick": false }] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Saltfield Recluse", "targets": ["p1:Grizzly Bears"], "illegal": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "a Rebel with a land to sacrifice may activate it for the extra cost",
    "players": [ { "battlefield": ["Brutal Suppression", { "name": "Saltfield Recluse", "sick": false }, "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Saltfield Recluse", "targets": ["p1:Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [0, 2] }, "players": [ { "graveyard": ["Forest"] }, {} ] } },
  { "name": "a non-Rebel's ability is unaffected",
    "players": [ { "battlefield": ["Brutal Suppression", { "name": "Prodigal Sorcerer", "sick": false }] }, {} ],
    "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19 } ] } }
]
