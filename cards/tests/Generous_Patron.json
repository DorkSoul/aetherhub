   "expect": { "counters": { "Hill Giant": { "p1p1": 1 }, "Savannah Lions": { "p1p1": 1 } }, "players": [ { "hand": ["Island", "Island"] }, {} ] } },
 { "name": "ruling: a spell with support can also target the same creature with its other targeting ability (Captured by Lagacs)",
   "players": [ { "hand": ["Captured by Lagacs"], "battlefield": ["Forest", "Plains", "Forest"] },
