   "steps": [ { "cast": "Generous Patron" }, { "resolve": true, "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "counters": { "Hill Giant": { "p1p1": 1 } }, "players": [ { "hand": ["Island"] }, {} ] } },
 { "name": "counters you put on your own creature do not draw",
   "players": [ { "hand": ["Generous Patron"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"], "library": ["Island"] }, {} ],
   "steps": [ { "cast": "Generous Patron" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": [] }, {} ] } },
 { "name": "ruling: supporting two creatures you don't control draws one card per creature",
   "players": [ { "hand": ["Generous Patron"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island", "Island"] },
                { "battlefield": ["Hill Giant", "Savannah Lions"] } ],
