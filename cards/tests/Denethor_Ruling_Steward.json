[
  { "name": "sacrifice drains and then the end step makes a token",
    "players": [ { "battlefield": ["Denethor, Ruling Steward", "Grizzly Bears", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Denethor, Ruling Steward", "ability": 0 }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Grizzly Bears"], "battlefield_has": ["Denethor, Ruling Steward", "Human Soldier"] }, { "life": 19 } ] } },
  { "name": "no creature died under your control: no token",
    "players": [ { "battlefield": ["Denethor, Ruling Steward"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Human Soldier"] }, {} ] } },
  { "name": "an opponent's creature dying does not count",
    "players": [ { "battlefield": ["Denethor, Ruling Steward", "Mountain"], "hand": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Human Soldier"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a creature that died before Denethor entered still lets the end step make a token",
    "players": [ { "hand": ["Lightning Bolt", "Denethor, Ruling Steward"], "battlefield": ["Mountain", "Plains", "Plains", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" }, { "cast": "Denethor, Ruling Steward" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Denethor, Ruling Steward", "Human Soldier"], "graveyard_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: two creatures died this turn still make only one token",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Denethor, Ruling Steward", "Grizzly Bears", "Human 1-1 White", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Human 1-1 White"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Denethor, Ruling Steward", "Mountain", "Mountain", "Human Soldier"], "graveyard_has": ["Grizzly Bears"] }, {} ] } }
]
