[
  {
    "name": "casting an instant makes a Drake",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Talrand, Sky Summoner",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Talrand, Sky Summoner",
            "Drake 2-2 Flying"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "casting a creature spell does not",
    "players": [
      {
        "hand": [
          "Raging Goblin"
        ],
        "battlefield": [
          "Talrand, Sky Summoner",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Raging Goblin"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Talrand, Sky Summoner",
            "Raging Goblin"
          ],
          "battlefield_lacks": [
            "Drake 2-2 Flying"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "opponent's spell does not",
    "players": [
      {
        "battlefield": [
          "Talrand, Sky Summoner"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p0"
        ],
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Talrand, Sky Summoner"
          ],
          "life": 17
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Drake trigger resolves even if the spell is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Talrand, Sky Summoner", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Talrand, Sky Summoner", "Drake 2-2 Flying"], "graveyard_has": ["Lightning Bolt"] },
        { "graveyard_has": ["Counterspell"], "life": 20 }
      ]
    }
  }
]