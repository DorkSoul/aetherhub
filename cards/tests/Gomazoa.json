[
  {
    "name": "tap to put itself and the creature it is blocking on top of their owners' libraries",
    "players": [
      {
        "battlefield": [
          "Gomazoa"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p0"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Gomazoa",
            "attacker": "Hill Giant"
          }
        ],
        "player": 0
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "activate": "Gomazoa",
        "player": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [],
          "library_count": 21
        },
        {
          "battlefield": [],
          "library_count": 20
        }
      ]
    }
  },
  {
    "name": "without a blocked creature only Gomazoa leaves the battlefield",
    "players": [
      {
        "battlefield": [
          "Gomazoa",
          "Llanowar Elves"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Gomazoa"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Llanowar Elves"
          ],
          "library_count": 21
        },
        {
          "battlefield": [
            "Hill Giant"
          ],
          "library_count": 20
        }
      ]
    }
  },
  {
    "name": "ruling: can be activated at any time its controller has priority, even when not blocking",
    "players": [
      { "battlefield": ["Gomazoa"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "activate": "Gomazoa", "player": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": [], "library_count": 21 },
        { "battlefield": ["Hill Giant"], "library_count": 20 }
      ]
    }
  },
  {
    "name": "ruling: blocked creature removed before resolution: only Gomazoa goes to the library and only its controller shuffles",
    "players": [
      { "battlefield": ["Gomazoa"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "attack": [ { "card": "Hill Giant", "at": "p0" } ] },
      { "block": [ { "blocker": "Gomazoa", "attacker": "Hill Giant" } ], "player": 0 },
      { "pass": true, "player": 1 },
      { "activate": "Gomazoa", "player": 0 },
      { "pass": true, "player": 0 },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
      { "pass": true, "player": 1 },
      { "pass": true, "player": 0 },
      { "pass": true, "player": 1 },
      { "pass": true, "player": 0 }
    ],
    "expect": {
      "players": [
        { "battlefield": [], "library_count": 21 },
        { "library_count": 19, "graveyard_has": ["Hill Giant", "Lightning Bolt"] }
      ]
    }
  }
]
