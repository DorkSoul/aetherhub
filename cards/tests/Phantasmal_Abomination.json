[
  {
    "name": "is sacrificed when it becomes the target of a spell",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Phantasmal Abomination"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Phantasmal Abomination"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt"] },
        { "graveyard_has": ["Phantasmal Abomination"] }
      ]
    }
  },
  {
    "name": "has defender",
    "players": [ { "battlefield": ["Phantasmal Abomination"] }, {} ],
    "steps": [],
    "expect": {
      "keywords": { "Phantasmal Abomination": ["Defender"] },
      "pt": { "Phantasmal Abomination": [5, 5] }
    }
  },
  {
    "name": "ruling: its sacrifice trigger resolves first, so the Bolt that targeted it is still on the stack",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Phantasmal Abomination"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Phantasmal Abomination"] },
      { "pass": true },
      { "pass": true }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ {}, { "graveyard_has": ["Phantasmal Abomination"] } ]
    }
  }
]
