[
  { "name": "untaps target creature",
    "players": [ { "hand": ["Seize the Day"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Seize the Day", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Seize the Day"], "battlefield_has": ["Grizzly Bears"] }, {} ], "tapped": { "Grizzly Bears": false } } },
  { "name": "after this main phase a second combat happens: a creature that attacked can attack again",
    "players": [ { "hand": ["Seize the Day"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "advance_to": "Main2" },
              { "cast": "Seize the Day", "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "advance_to": "End" } ],
    "expect": { "turn": 1, "players": [ {}, { "life": 16 } ] } },
  { "name": "flashback {2}{R} from the graveyard, then the card is exiled",
    "players": [ { "graveyard": ["Seize the Day"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Seize the Day", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Seize the Day"] }, {} ], "tapped": { "Grizzly Bears": false } } },
  { "name": "flashback needs three mana: illegal with two lands",
    "players": [ { "graveyard": ["Seize the Day"], "battlefield": ["Mountain", "Mountain", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Seize the Day", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Seize the Day"] }, {} ] } },
  { "name": "ruling: can target a creature that is already untapped",
    "players": [ { "hand": ["Seize the Day"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Seize the Day", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Seize the Day"], "battlefield_has": ["Grizzly Bears"] }, {} ], "tapped": { "Grizzly Bears": false } } },
  { "name": "ruling: a flashback spell whose target became illegal is still exiled",
    "players": [ { "graveyard": ["Seize the Day"], "battlefield": ["Mountain", "Mountain", "Mountain", "Savannah Lions"] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Seize the Day", "alt": 0, "targets": ["Savannah Lions"] }, { "cast": "Shock", "player": 1, "targets": ["Savannah Lions"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Seize the Day"], "battlefield_lacks": ["Savannah Lions"] }, { "graveyard": ["Shock"] } ] } },
  { "name": "ruling: flashback follows sorcery timing: illegal in combat",
    "players": [ { "graveyard": ["Seize the Day"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Seize the Day", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Seize the Day"] }, {} ] } }
]
