[
  { "name": "may play a land from the top of your library",
    "players": [ { "battlefield": ["Mikey & Don, Party Planners"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Mikey & Don, Party Planners"] }, {} ] } },
  { "name": "casts a Turtle from the top of your library and it enters with an additional +1/+1 counter",
    "players": [ { "battlefield": ["Mikey & Don, Party Planners", "Island"], "library": ["Aegis Turtle"] }, {} ],
    "steps": [ { "cast": "Aegis Turtle" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Aegis Turtle"] }, {} ], "pt": { "Aegis Turtle": [1, 6] } } },
  { "name": "a creature that is not a Mutant, Ninja or Turtle cannot be cast from the top of your library",
    "players": [ { "battlefield": ["Mikey & Don, Party Planners", "Forest", "Forest"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ] },
  { "name": "ward {2}: the opponent has only 1 spare mana, cannot pay, Swords is countered and Mikey stays",
    "players": [ { "battlefield": ["Mikey & Don, Party Planners"] }, { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Plains"] } ],
    "steps": [ { "pass": true }, { "cast": "Swords to Plowshares", "targets": ["Mikey & Don, Party Planners"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mikey & Don, Party Planners"] }, { "graveyard": ["Swords to Plowshares"] } ] } },
  { "name": "ward {2}: the opponent pays 2 with spare mana, Swords exiles Mikey",
    "players": [ { "battlefield": ["Mikey & Don, Party Planners"] }, { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Plains", "Plains"] } ],
    "steps": [ { "pass": true }, { "cast": "Swords to Plowshares", "targets": ["Mikey & Don, Party Planners"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Mikey & Don, Party Planners"] }, { "graveyard": ["Swords to Plowshares"] } ] } },
  { "name": "ruling: a non-flash Turtle on top cannot be cast on an opponent's turn (timing applies)",
    "players": [ { "battlefield": ["Mikey & Don, Party Planners", "Island", "Island"], "library": ["Aegis Turtle"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Aegis Turtle", "illegal": true } ],
    "expect": { "players": [ { "library_top": ["Aegis Turtle"], "battlefield_lacks": ["Aegis Turtle"] }, {} ] } }
]
