   "expect": { "players": [ { "hand": ["Lightning Bolt"], "graveyard": [] }, {} ] } },
 { "name": "attacking with seven lands does not prepare it",
   "players": [ { "battlefield": ["Emeritus of Abundance // Regrowth", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Lightning Bolt"] }, {} ],
   "steps": [ { "attack": [ { "card": "Emeritus of Abundance // Regrowth", "at": "p1" } ] },
              { "advance_to": "Main2" },
              { "cast": "Regrowth", "illegal": true } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard": ["Lightning Bolt"] }, {} ] } },
