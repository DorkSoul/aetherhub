   "players": [ { "battlefield": ["Emeritus of Abundance // Regrowth", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Lightning Bolt", "Giant Growth"] }, {} ],
   "steps": [ { "attack": [ { "card": "Emeritus of Abundance // Regrowth", "at": "p1" } ] },
