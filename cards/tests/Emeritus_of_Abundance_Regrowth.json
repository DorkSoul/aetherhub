   "players": [ { "hand": ["Emeritus of Abundance // Regrowth"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Lightning Bolt"] }, {} ],
   "steps": [ { "cast": "Emeritus of Abundance // Regrowth" }, { "resolve": true }, { "cast": "Regrowth" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"], "graveyard": [], "battlefield_has": ["Emeritus of Abundance // Regrowth"] }, {} ] } },
