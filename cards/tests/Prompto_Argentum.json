[
  { "name": "noncreature spell with four mana spent: Treasure",
    "players": [ { "hand": ["Wrath of God"], "battlefield": ["Prompto Argentum", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Wrath of God" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure"] }, {} ] } },
  { "name": "noncreature spell with three mana spent: no Treasure",
    "players": [ { "hand": ["Divination"], "battlefield": ["Prompto Argentum", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Treasure"] }, {} ] } },
  { "name": "creature spell with four mana spent: no Treasure",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Prompto Argentum", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Hill Giant" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Treasure"] }, {} ] } },
  { "name": "ruling: Selfie Shot resolves before the spell, even if that spell is countered",
    "players": [ { "hand": ["Fireball"], "battlefield": ["Prompto Argentum", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Fireball", "targets": ["p1"], "answers": [3] },
               { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Fireball" } ] },
               { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Treasure"], "graveyard": ["Fireball"] }, { "graveyard": ["Counterspell"], "life": 20 } ] } }
]
