[
 { "name": "max speed: the top card is exiled in upkeep and can be cast this turn",
   "players": [ { "battlefield": [{ "name": "Endrider Spikespitter", "sick": false }, "Forest", "Forest"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "set_speed": 4 }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "Main1" }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "below max speed nothing is exiled: the card is drawn",
   "players": [ { "battlefield": [{ "name": "Endrider Spikespitter", "sick": false }], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "set_speed": 3 }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "start your engines: entering with no speed starts it at 1",
   "players": [ { "hand": ["Endrider Spikespitter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Endrider Spikespitter" }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1, "battlefield_has": ["Endrider Spikespitter"] }, {} ] } },
 { "name": "ruling: a sorcery-speed card exiled by max speed cannot be cast in upkeep",
   "players": [ { "battlefield": [{ "name": "Endrider Spikespitter", "sick": false }, "Forest", "Forest"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "set_speed": 4 }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": { "players": [ { "exile": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: speed is tracked per player; the opponent losing life does not give them speed",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Endrider Spikespitter", "sick": false }, "Mountain"] }, {} ],
   "steps": [ { "set_speed": 1 }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 2 }, { "speed": 0, "life": 17 } ] } },
 { "name": "ruling: gaining control of a start-your-engines permanent gives you speed 1",
   "players": [ { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": [{ "name": "Endrider Spikespitter", "sick": false }] } ],
   "steps": [ { "cast": "Control Magic", "targets": ["Endrider Spikespitter"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1, "battlefield_has": ["Endrider Spikespitter"] }, { "speed": 1 } ] } }
]
