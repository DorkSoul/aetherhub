[
  {
    "name": "bushido 2 when blocking makes it 3/3",
    "players": [
      {
        "battlefield": [
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      },
      {
        "battlefield": [
          {
            "name": "Numai Outcast",
            "sick": false
          }
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Numai Outcast",
            "attacker": "Grizzly Bears"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield_has": [
            "Numai Outcast"
          ]
        }
      ],
      "pt": {
        "Numai Outcast": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "becomes blocked: +2/+2 (3/3) and it kills the 2/2 blocker",
    "players": [ { "battlefield": [ { "name": "Numai Outcast", "sick": false } ] }, { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Numai Outcast", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Numai Outcast" } ], "player": 1 }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Numai Outcast"] }, { "graveyard": ["Grizzly Bears"] } ], "pt": { "Numai Outcast": [3, 3] } }
  },
  {
    "name": "unblocked: no pump, deals 1 damage",
    "players": [ { "battlefield": [ { "name": "Numai Outcast", "sick": false } ] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Numai Outcast", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 19 } ], "pt": { "Numai Outcast": [1, 1] } }
  },
  {
    "name": "{B}, pay 5 life: regenerate, so a lethal Lightning Bolt does not destroy it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Swamp", "Mountain", { "name": "Numai Outcast", "sick": false }] }, {} ],
    "steps": [ { "activate": "Numai Outcast", "ability": 0 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Numai Outcast"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Numai Outcast"], "life": 15 }, {} ] }
  },
  {
    "name": "regenerate needs {B}: with only a Mountain it cannot be activated",
    "players": [ { "battlefield": ["Mountain", { "name": "Numai Outcast", "sick": false }] }, {} ],
    "steps": [ { "activate": "Numai Outcast", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Numai Outcast"], "life": 20 }, {} ] }
  }
]
