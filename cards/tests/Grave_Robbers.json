[
  { "name": "exiles target artifact card in a graveyard and gains 2 life",
    "players": [ { "battlefield": ["Grave Robbers", "Swamp"] }, { "graveyard": ["Mind Stone"] } ],
    "steps": [ { "activate": "Grave Robbers", "ability": 0, "targets": ["Mind Stone"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22 }, { "exile": ["Mind Stone"] } ] } },
  { "name": "a non-artifact card cannot be targeted",
    "players": [ { "battlefield": ["Grave Robbers", "Swamp"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Grave Robbers", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: if the target is gone on resolution, no life is gained",
    "players": [ { "battlefield": ["Grave Robbers", "Swamp"] }, { "battlefield": ["Grave Robbers", "Swamp"], "graveyard": ["Mind Stone"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "activate": "Grave Robbers", "ability": 0, "targets": ["Mind Stone"], "player": 1 }, { "pass": true, "player": 1 }, { "activate": "Grave Robbers", "ability": 0, "targets": ["Mind Stone"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22 }, { "life": 20, "exile": ["Mind Stone"] } ] } }
]
