[
  {
    "name": "a creature with an infection counter dies: you get a token copy of it (Tyranid added)",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          {
            "name": "Genestealer Patriarch",
            "sick": false
          },
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Genestealer Patriarch",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Genestealer Patriarch",
            "Grizzly Bears"
          ]
        },
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "a creature without an infection counter dying does not make a copy",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          {
            "name": "Genestealer Patriarch",
            "sick": false
          },
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Genestealer Patriarch"
          ],
          "battlefield_lacks": [
            "Grizzly Bears"
          ]
        },
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: two Patriarchs each trigger when an infected creature dies, so two token copies are made",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Genestealer Patriarch", "sick": false }, { "name": "Genestealer Patriarch", "sick": false }, "Mountain" ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Genestealer Patriarch", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Genestealer Patriarch", "Genestealer Patriarch", "Grizzly Bears", "Grizzly Bears", "Mountain"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the token copy enters, so the copied creature's enters-the-battlefield ability (suspect) triggers",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Genestealer Patriarch", "sick": false }, "Mountain" ] },
      { "battlefield": ["Frantic Scapegoat"] }
    ],
    "steps": [
      { "attack": [ { "card": "Genestealer Patriarch", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["Frantic Scapegoat"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Genestealer Patriarch", "Frantic Scapegoat"] },
        { "graveyard_has": ["Frantic Scapegoat"] }
      ],
      "keywords": { "Frantic Scapegoat": ["Menace", "CantBlock"] }
    }
  },
  {
    "name": "ruling: the token copies only the printed creature, not the counters the dead creature had",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Genestealer Patriarch", "sick": false }, "Mountain" ] },
      { "battlefield": [ { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 1 } } ] }
    ],
    "steps": [
      { "attack": [ { "card": "Genestealer Patriarch", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Genestealer Patriarch", "Grizzly Bears"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]