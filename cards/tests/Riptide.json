[
 {
  "name": "taps all blue creatures, leaves others untapped",
  "players": [ { "hand": ["Riptide"], "battlefield": ["Island"] }, { "battlefield": ["Riptide Turtle", "Grizzly Bears"] } ],
  "steps": [ { "cast": "Riptide" }, { "resolve": true } ],
  "expect": { "tapped": { "Riptide Turtle": true, "Grizzly Bears": false } }
 },
 {
  "name": "does not tap your own non-blue creatures",
  "players": [ { "hand": ["Riptide"], "battlefield": ["Island", "Hill Giant"] }, { "battlefield": ["Riptide Turtle"] } ],
  "steps": [ { "cast": "Riptide" }, { "resolve": true } ],
  "expect": { "tapped": { "Hill Giant": false, "Riptide Turtle": true } }
 }
]
