[
  { "name": "cycling {2} discards it and draws a card",
    "players": [ { "hand": ["Viscera Dragger"], "battlefield": ["Island", "Island"], "library": ["Lightning Bolt"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"], "graveyard": ["Viscera Dragger"] }, {} ] } },
  { "name": "unearth from the graveyard returns it to the battlefield",
    "players": [ { "graveyard": ["Viscera Dragger"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Viscera Dragger"] }, {} ], "keywords": { "Viscera Dragger": ["Haste"] } } },
  { "name": "cycling is not available from the graveyard",
    "players": [ { "graveyard": ["Viscera Dragger"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Viscera Dragger"] }, {} ] } },
  { "name": "unearthed creature is exiled at the beginning of the next end step",
    "players": [ { "graveyard": ["Viscera Dragger"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "exile": ["Viscera Dragger"], "graveyard": [] }, {} ] } },
  { "name": "unearthed creature that would leave the battlefield is exiled instead",
    "players": [ { "graveyard": ["Viscera Dragger"], "battlefield": ["Swamp", "Swamp", "Mountain"], "hand": ["Lightning Bolt"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Viscera Dragger"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Viscera Dragger"], "graveyard": ["Lightning Bolt"] }, {} ] } },
  { "name": "ruling: Lignify (loses all abilities) does not stop the unearthed creature being exiled at end step",
    "players": [ { "hand": ["Lignify"], "graveyard": ["Viscera Dragger"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 }, { "resolve": true }, { "cast": "Lignify", "targets": ["Viscera Dragger"] }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "exile": ["Viscera Dragger"] }, {} ] } },
  { "name": "ruling: an unearthed creature bounced to hand is exiled instead",
    "players": [ { "hand": ["Unsummon"], "graveyard": ["Viscera Dragger"], "battlefield": ["Swamp", "Swamp", "Island"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 }, { "resolve": true }, { "cast": "Unsummon", "targets": ["Viscera Dragger"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Viscera Dragger"], "hand": [], "graveyard": ["Unsummon"] }, {} ] } },
  { "name": "ruling: Stifle can counter the unearth ability, and the creature stays in the graveyard",
    "players": [ { "graveyard": ["Viscera Dragger"], "battlefield": ["Swamp", "Swamp"] }, { "hand": ["Stifle"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Viscera Dragger" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Viscera Dragger"] }, {} ], "stack_empty": true } },
  { "name": "ruling: unearth is an ability, so while it is on the stack the creature card is still in the graveyard",
    "players": [ { "graveyard": ["Viscera Dragger"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 } ],
    "expect": { "players": [ { "graveyard": ["Viscera Dragger"], "battlefield_lacks": ["Viscera Dragger"] }, {} ], "stack_empty": false } },
  { "name": "ruling: a card removed from the graveyard before unearth resolves means the ability does nothing",
    "players": [ { "graveyard": ["Viscera Dragger", "Grizzly Bears"], "battlefield": ["Relic of Progenitus", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Viscera Dragger", "ability": 1 }, { "activate": "Relic of Progenitus", "ability": 0, "targets": ["p0"] }, { "resolve": true, "answers": [["Viscera Dragger"]] } ],
    "expect": { "players": [ { "exile": ["Viscera Dragger"], "graveyard": ["Grizzly Bears"], "battlefield_lacks": ["Viscera Dragger"] }, {} ], "tapped": { "Relic of Progenitus": true } } }
]
