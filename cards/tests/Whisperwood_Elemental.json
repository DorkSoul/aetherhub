[
 { "name": "at the beginning of your end step, manifest the top card of your library",
   "players": [ { "battlefield": ["Whisperwood Elemental"] }, {} ],
   "steps": [ { "advance_to": "End" } ],
   "expect": { "players": [ { "library_count": 19, "battlefield_has": ["Whisperwood Elemental"] }, {} ] } },
 { "name": "sacrifice: a creature you control that dies later this turn manifests the top card",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Whisperwood Elemental", "Grizzly Bears", "Mountain"] }, {} ],
   "steps": [ { "activate": "Whisperwood Elemental" },
              { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "library_count": 19, "graveyard": ["Lightning Bolt", "Whisperwood Elemental", "Grizzly Bears"] }, {} ] } },
 { "name": "boundary: an opponent's creature dying does not manifest for you",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Whisperwood Elemental", "Grizzly Bears", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "activate": "Whisperwood Elemental" },
              { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
              { "resolve": true } ],
   "expect": { "players": [ { "library_count": 20 }, { "graveyard": ["Hill Giant"] } ] } },
 { "name": "ruling: a manifested card is a colourless 2/2 without its creature types",
   "players": [ { "battlefield": ["Whisperwood Elemental"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "End" } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] }, "colors": { "Grizzly Bears": [] }, "not_subtypes": { "Grizzly Bears": ["Bear"] },
               "players": [ { "battlefield_has": ["Whisperwood Elemental"] }, {} ] } },
 { "name": "ruling: a creature that enters after the sacrifice does not gain the dies-manifest ability",
   "players": [ { "hand": ["Grizzly Bears", "Lightning Bolt"], "battlefield": ["Whisperwood Elemental", "Forest", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Whisperwood Elemental" },
              { "resolve": true },
              { "cast": "Grizzly Bears" },
              { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "library_count": 20, "graveyard_has": ["Whisperwood Elemental", "Grizzly Bears", "Lightning Bolt"] }, {} ] } },
 { "name": "ruling: turning a manifested creature face up is a special action that uses no stack and pays its mana cost",
   "players": [ { "battlefield": ["Whisperwood Elemental", "Forest", "Island"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "End" },
              { "activate": "Grizzly Bears" } ],
   "expect": { "stack_empty": true, "pt": { "Grizzly Bears": [2, 2] }, "subtypes": { "Grizzly Bears": ["Bear"] }, "tapped": { "Forest": true, "Island": true },
               "players": [ { "battlefield_has": ["Whisperwood Elemental"] }, {} ] } },
 { "name": "ruling: turning a face-down creature face up does not change whether it is tapped",
   "players": [ { "battlefield": ["Whisperwood Elemental", "Forest", "Island", { "name": "Grizzly Bears", "face_down": true, "tapped": true }] }, {} ],
   "steps": [ { "activate": "Grizzly Bears" } ],
   "expect": { "tapped": { "Grizzly Bears": true }, "subtypes": { "Grizzly Bears": ["Bear"] } } }
]
