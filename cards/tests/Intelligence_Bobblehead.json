[
 {
  "name": "draws a card for each Bobblehead you control",
  "players": [
   { "battlefield": ["Intelligence Bobblehead", "Charisma Bobblehead", "Plains", "Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "activate": "Intelligence Bobblehead" },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Intelligence Bobblehead": true, "Charisma Bobblehead": false },
   "players": [ { "hand_count": 2 }, {} ]
  }
 },
 {
  "name": "draws one card when it is the only Bobblehead",
  "players": [
   { "battlefield": ["Intelligence Bobblehead", "Plains", "Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [
   { "activate": "Intelligence Bobblehead" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 1 }, {} ]
  }
 },
 {
  "name": "ruling: X is counted as the ability resolves; a Bobblehead removed in response is not counted (draws 1, not 2)",
  "players": [
   { "battlefield": ["Intelligence Bobblehead", "Charisma Bobblehead", "Plains", "Plains", "Plains", "Plains", "Plains"] },
   { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] }
  ],
  "steps": [
   { "activate": "Intelligence Bobblehead" },
   { "pass": true },
   { "cast": "Shatter", "player": 1, "targets": ["Charisma Bobblehead"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 1, "graveyard_has": ["Charisma Bobblehead"] }, { "graveyard_has": ["Shatter"] } ]
  }
 }
]
