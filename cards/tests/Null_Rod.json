  {
    "name": "an artifact's mana ability (Talisman of Unity) cannot pay for a spell while Null Rod is out",
    "players": [
      {
        "hand": ["Savannah Lions"],
        "battlefield": ["Null Rod", "Talisman of Unity"]
      },
      {}
    ],
    "steps": [
      { "cast": "Savannah Lions", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "ruling: a triggered ability of an artifact (Solemn Simulacrum dies trigger) still triggers",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Null Rod", "Solemn Simulacrum", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Solemn Simulacrum"] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "graveyard": ["Lightning Bolt", "Solemn Simulacrum"] }, {} ]
    }
  },
  {
    "name": "ruling: a static ability of an artifact still works (Emissary Escort gets +2/+0 from Mind Stone)",
    "players": [
      { "battlefield": ["Null Rod", "Emissary Escort", "Mind Stone"] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": { "Emissary Escort": [2, 4] }
    }
  },
  {
    "name": "ruling: a non-mana activated ability of an artifact (Sensei's Divining Top rearrange) cannot be activated",
    "players": [
      { "battlefield": ["Null Rod", "Sensei's Divining Top", "Island"] },
      {}
    ],
    "steps": [
