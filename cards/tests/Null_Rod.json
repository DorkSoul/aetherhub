  {
    "name": "ruling: equip is an activated ability (colon in its reminder text) and is stopped for artifacts",
    "players": [
      { "battlefield": ["Null Rod", "Short Sword", "Grizzly Bears", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Short Sword", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
