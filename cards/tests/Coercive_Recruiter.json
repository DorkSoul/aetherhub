[
 {
  "name": "gains control of target creature until end of turn when it enters",
  "players": [
   { "hand": ["Coercive Recruiter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Coercive Recruiter" },
   { "resolve": true, "targets": ["p1:Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Coercive Recruiter", "Grizzly Bears"] }, { "battlefield": [] }]
  }
 },
 {
  "name": "untaps the creature it takes",
  "players": [
   { "hand": ["Coercive Recruiter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
  ],
  "steps": [
   { "cast": "Coercive Recruiter" },
   { "resolve": true, "targets": ["p1:Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Coercive Recruiter", "Grizzly Bears"] }, {}],
   "tapped": { "Grizzly Bears": false }
  }
 },
 {
  "name": "ruling: can target a creature you already control, and untaps it",
  "players": [
   { "hand": ["Coercive Recruiter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "tapped": true }] },
   {}
  ],
  "steps": [
   { "cast": "Coercive Recruiter" },
   { "resolve": true, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Coercive Recruiter", "Grizzly Bears"] }, {}],
   "tapped": { "Grizzly Bears": false }
  }
 },
 {
  "name": "ruling: can target itself, and it gains haste",
  "players": [
   { "hand": ["Coercive Recruiter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Coercive Recruiter" },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Coercive Recruiter"] }, {}],
   "keywords": { "Coercive Recruiter": ["Haste"] }
  }
 },
 {
  "name": "ruling: gaining control of a creature does not take the opponent's Aura attached to it",
  "players": [
   { "hand": ["Coercive Recruiter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "hand": ["Pacifism"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "cast": "Pacifism", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "cast": "Coercive Recruiter" },
   { "resolve": true, "targets": ["p1:Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Coercive Recruiter", "Grizzly Bears"] }, { "battlefield_has": ["Pacifism"] }],
   "attached": { "Pacifism": "Grizzly Bears" }
  }
 }
]
