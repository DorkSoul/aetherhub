[
  { "name": "target creature gets +1/+0 and infect until end of turn",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Grizzly Bears", "Swamp"] }, {} ],
    "steps": [ { "cast": "Tainted Strike", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 2] }, "keywords": { "Grizzly Bears": ["Infect"] } } },
  { "name": "needs a creature to target",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Swamp"] }, {} ],
    "steps": [ { "cast": "Tainted Strike", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Tainted Strike"] }, {} ] } },
  { "name": "ruling: infect damage from combat gives poison counters, not life loss",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Grizzly Bears", "Swamp"] }, {} ],
    "steps": [ { "cast": "Tainted Strike", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20, "poison": 3 } ] } },
  { "name": "ruling: ten poison counters lose the game (7 + 3 infect damage)",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Grizzly Bears", "Swamp"] }, { "poison": 7 } ],
    "steps": [ { "cast": "Tainted Strike", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "winner": 0, "players": [ {}, { "poison": 10 } ] } },
  { "name": "ruling: nine poison counters do not yet lose the game (6 + 3 infect damage)",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Grizzly Bears", "Swamp"] }, { "poison": 6 } ],
    "steps": [ { "cast": "Tainted Strike", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "winner": -1, "players": [ {}, { "poison": 9, "life": 20 } ] } },
  { "name": "ruling: infect applies to non-combat damage: an infected Sorcerer's ping gives poison",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Prodigal Sorcerer", "Swamp"] }, {} ],
    "steps": [ { "cast": "Tainted Strike", "targets": ["Prodigal Sorcerer"] }, { "resolve": true }, { "activate": "Prodigal Sorcerer", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20, "poison": 1 } ] } },
  { "name": "ruling: -1/-1 counters from infect damage stay on the creature after the turn ends",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Prodigal Sorcerer", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Tainted Strike", "targets": ["Prodigal Sorcerer"] }, { "resolve": true }, { "activate": "Prodigal Sorcerer", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [1, 1] } } },
  { "name": "ruling: infect damage to a planeswalker removes loyalty normally",
    "players": [ { "hand": ["Tainted Strike"], "battlefield": ["Prodigal Sorcerer", "Swamp"] }, { "battlefield": ["Chandra, Torch of Defiance"] } ],
    "steps": [ { "cast": "Tainted Strike", "targets": ["Prodigal Sorcerer"] }, { "resolve": true }, { "activate": "Prodigal Sorcerer", "ability": 0, "targets": ["Chandra, Torch of Defiance"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Chandra, Torch of Defiance"], "poison": 0 } ], "counters": { "Chandra, Torch of Defiance": { "Loyalty": 3 } } } }
]
