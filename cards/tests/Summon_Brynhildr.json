  {
    "name": "an exiled land cannot be played once the land drop is used on a lore-counter turn",
    "players": [ { "hand": ["Summon: Brynhildr", "Mountain"], "battlefield": ["Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Summon: Brynhildr" }, { "resolve": true }, { "resolve": true }, { "play_land": "Mountain" }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Forest"], "battlefield_lacks": ["Forest"] }, {} ] }
  },
  {
    "name": "ruling: a chapter ability can be responded to: Stifle counters chapter I, so no card is exiled",
    "players": [
      { "hand": ["Summon: Brynhildr"], "battlefield": ["Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [ { "cast": "Summon: Brynhildr" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Summon: Brynhildr" }] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Summon: Brynhildr"], "exile": [], "library_top": ["Forest", "Grizzly Bears"] }, { "graveyard": ["Stifle"] } ] }
  },
  {
    "name": "ruling: the chapter I ability still exiles the top card after the Saga is killed in response",
    "players": [
      { "hand": ["Summon: Brynhildr"], "battlefield": ["Mountain", "Mountain"], "library": ["Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [ { "cast": "Summon: Brynhildr" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Summon: Brynhildr"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Summon: Brynhildr"], "exile": ["Forest"], "library_top": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ] }
