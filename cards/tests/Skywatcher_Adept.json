   {}
  ],
  "steps": [ { "advance_to": "Main2" } ],
  "expect": {
   "pt": { "Skywatcher Adept": [4, 2] },
   "keywords": { "Skywatcher Adept": ["Flying"] }
  }
 },
 {
  "name": "ruling: a pump spell applies to the leveler whenever it was cast, even before a level was added",
  "players": [
   { "hand": ["Giant Growth"], "battlefield": ["Island", "Island", "Island", "Forest", { "name": "Skywatcher Adept", "counters": { "level": 2 } }] },
