  "name": "ruling: level up stays available at level 3+ and its counters still raise the level",
  "players": [
   { "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", { "name": "Skywatcher Adept", "counters": { "level": 2 } }] },
