[
 {"name": "returns target permanent to its owner's hand",
  "players": [{"hand": ["Rescind"], "battlefield": ["Island", "Island", "Island"]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"cast": "Rescind", "targets": ["Grizzly Bears"]}, {"resolve": true}],
  "expect": {"players": [{"graveyard": ["Rescind"]}, {"battlefield_lacks": ["Grizzly Bears"]}]}},
 {"name": "cycling {2}: discard to draw a card",
  "players": [{"hand": ["Rescind"], "battlefield": ["Island", "Island"]}, {}],
  "steps": [{"activate": "Rescind"}, {"resolve": true}],
  "expect": {"players": [{"hand_count": 1, "graveyard_has": ["Rescind"]}, {}]}},
 {"name": "ruling: Stifle can counter the cycling ability, so no card is drawn",
  "players": [{"hand": ["Rescind"], "battlefield": ["Island", "Island"]}, {"hand": ["Stifle"], "battlefield": ["Island"]}],
  "steps": [{"activate": "Rescind"}, {"pass": true}, {"cast": "Stifle", "player": 1, "targets": [{"stack": "Rescind"}]}, {"resolve": true}],
  "expect": {"players": [{"hand_count": 0, "graveyard_has": ["Rescind"]}, {"graveyard_has": ["Stifle"]}]}},
 {"name": "ruling: Counterspell cannot target the cycling ability (it is not a spell)",
  "players": [{"hand": ["Rescind"], "battlefield": ["Island", "Island"]}, {"hand": ["Counterspell"], "battlefield": ["Island", "Island"]}],
  "steps": [{"activate": "Rescind"}, {"pass": true}, {"cast": "Counterspell", "player": 1, "illegal": true}, {"resolve": true}],
  "expect": {"players": [{"hand_count": 1, "graveyard_has": ["Rescind"]}, {"hand_count": 1}]}}
]
