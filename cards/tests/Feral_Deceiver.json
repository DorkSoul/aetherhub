[
  {"name": "reveal a land: gets +2/+2 and trample until end of turn",
   "players": [{"battlefield": ["Feral Deceiver", "Forest", "Forest"], "library": ["Forest"]}, {}],
   "steps": [{"activate": "Feral Deceiver", "ability": 1}, {"resolve": true}],
   "expect": {"pt": {"Feral Deceiver": [5, 4]}, "keywords": {"Feral Deceiver": ["Trample"]}}},
  {"name": "reveal a nonland: no bonus",
   "players": [{"battlefield": ["Feral Deceiver", "Forest", "Forest"], "library": ["Grizzly Bears"]}, {}],
   "steps": [{"activate": "Feral Deceiver", "ability": 1}, {"resolve": true}],
   "expect": {"pt": {"Feral Deceiver": [3, 2]}}},
  {"name": "only once each turn",
   "players": [{"battlefield": ["Feral Deceiver", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Forest"]}, {}],
   "steps": [{"activate": "Feral Deceiver", "ability": 1}, {"resolve": true},
             {"activate": "Feral Deceiver", "ability": 1, "illegal": true}],
   "expect": {"pt": {"Feral Deceiver": [5, 4]}}},
  {"name": "look ability (one mana) changes nothing",
   "players": [{"battlefield": ["Feral Deceiver", "Forest"], "library": ["Forest"]}, {}],
   "steps": [{"activate": "Feral Deceiver", "ability": 0}, {"resolve": true}],
   "expect": {"pt": {"Feral Deceiver": [3, 2]}}}
]
