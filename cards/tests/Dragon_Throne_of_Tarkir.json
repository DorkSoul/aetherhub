      { "activate": "Dragon Throne of Tarkir", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": [] }
    }
  },
  {
    "name": "the granted ability gives other creatures trample and +X/+X, X = the equipped creature's power",
    "players": [
