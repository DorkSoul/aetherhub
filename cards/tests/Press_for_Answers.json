[
  {
    "name": "taps the creature and gives its controller a Clue",
    "players": [
      { "hand": ["Press for Answers"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Press for Answers", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Press for Answers"], "battlefield_has": ["Clue"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "the creature stays tapped through its controller's next untap step",
    "players": [
      { "hand": ["Press for Answers"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Press for Answers", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: all targets illegal on resolution, so no Clue",
    "players": [
      { "hand": ["Press for Answers"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Press for Answers", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Press for Answers", "Grizzly Bears"], "battlefield": ["Island", "Island"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
