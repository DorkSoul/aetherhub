      { "advance_to": "End" }
    ],
    "expect": { "players": [ { "hand": ["Island"] }, {} ] }
  },
  {
    "name": "ruling: a creature dealing combat damage to the monarch makes its controller the monarch",
    "players": [
      { "battlefield": ["Coin of Fate", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears", "Serra Angel"], "library": ["Island", "Forest"] },
      { "battlefield": ["Hill Giant"], "library": ["Plains", "Forest"] }
    ],
    "steps": [
      { "activate": "Coin of Fate", "ability": 0 },
      { "resolve": true, "answers": [["Grizzly Bears"]] },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
