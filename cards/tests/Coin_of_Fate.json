    "steps": [ { "cast": "Coin of Fate" }, { "resolve": true, "answers": [ [ "Grizzly Bears" ] ] } ],
    "expect": { "players": [ { "battlefield_has": [ "Coin of Fate" ], "graveyard": [ "Grizzly Bears" ], "library_top": [ "Forest" ] }, {} ] }
  },
  {
    "name": "ETB surveil 1: the top card can stay on top",
    "players": [ { "hand": [ "Coin of Fate" ], "battlefield": [ "Plains", "Plains" ], "library": [ "Grizzly Bears", "Forest" ] }, {} ],
    "steps": [ { "cast": "Coin of Fate" }, { "resolve": true, "answers": [ [] ] } ],
    "expect": { "players": [ { "library_top": [ "Grizzly Bears", "Forest" ] }, {} ] }
  },
  {
    "name": "ruling: the monarch draws a card at the beginning of their own end step",
    "players": [
      { "battlefield": ["Coin of Fate", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears", "Serra Angel"], "library": ["Island", "Forest"] },
