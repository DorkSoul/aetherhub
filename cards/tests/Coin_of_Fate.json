[
  {
    "name": "pay {3}{W} tap and exile two creature cards: opponent picks one to library bottom, the other returns tapped",
    "players": [
      { "battlefield": ["Coin of Fate", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears", "Serra Angel"] },
      {}
    ],
    "steps": [
      { "activate": "Coin of Fate", "ability": 0 },
      { "resolve": true, "answers": [["Grizzly Bears"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Serra Angel"], "battlefield_lacks": ["Coin of Fate", "Grizzly Bears"], "graveyard": ["Coin of Fate"] },
        {}
      ],
      "tapped": { "Serra Angel": true }
    }
  },
  {
    "name": "cannot activate with only one creature card in graveyard",
    "players": [
      { "battlefield": ["Coin of Fate", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Coin of Fate", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Coin of Fate"] }, {} ]
    }
  },
  {
    "name": "ETB surveil 1: the top card goes to the graveyard",
