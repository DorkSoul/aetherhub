        "hand": [
          "Dragonfly Swarm"
        ],
        "battlefield": [
          "Island",
          "Mountain",
          "Plains"
        ],
        "graveyard": [
          "Lightning Bolt",
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Dragonfly Swarm"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
