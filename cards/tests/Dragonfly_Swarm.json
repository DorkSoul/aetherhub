  {
    "name": "draws a card on death when a Lesson is in your graveyard",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Dragonfly Swarm"
        ],
        "graveyard": [
          "Abandon Attachments"
        ],
        "library": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Dragonfly Swarm"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Island"
          ],
          "graveyard": [
            "Abandon Attachments",
            "Lightning Bolt",
            "Dragonfly Swarm"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ward {1}: an opponent's Lightning Bolt with no spare mana is countered",
    "players": [
      { "battlefield": ["Dragonfly Swarm"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Dragonfly Swarm"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Dragonfly Swarm"] }, { "graveyard": ["Lightning Bolt"] }]
    }
  },
  {
    "name": "ruling: with no Lesson in the graveyard, dying does not trigger the draw at all",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Dragonfly Swarm"],
        "graveyard": ["Sol Ring"],
        "library": ["Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Dragonfly Swarm"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_top": ["Island"], "graveyard": ["Sol Ring", "Lightning Bolt", "Dragonfly Swarm"] },
        {}
      ]
    }
  }
