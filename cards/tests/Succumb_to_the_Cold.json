[
  {
    "name": "taps two opposing creatures and stuns each",
    "players": [
      { "hand": ["Succumb to the Cold"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Succumb to the Cold", "targets": ["Grizzly Bears", "Llanowar Elves"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": ["Succumb to the Cold"] }, { "battlefield_has": ["Grizzly Bears", "Llanowar Elves"] } ],
      "tapped": { "Grizzly Bears": true, "Llanowar Elves": true },
      "counters": { "Grizzly Bears": { "stun": 1 }, "Llanowar Elves": { "stun": 1 } }
    }
  },
  {
    "name": "one target is enough",
    "players": [
      { "hand": ["Succumb to the Cold"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Succumb to the Cold", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 1 } }
    }
  },
  {
    "name": "ruling: an already tapped creature can be targeted and still gets a stun counter",
    "players": [
      { "hand": ["Succumb to the Cold"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [ { "cast": "Succumb to the Cold", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": ["Succumb to the Cold"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 1 } }
    }
  }
]
