[
  {
    "name": "searches for a basic land into hand when it enters",
    "players": [
      { "hand": ["Environmental Scientist"], "battlefield": ["Forest", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Environmental Scientist" },
      { "resolve": true, "answers": [true, "Island"] }
    ],
    "expect": {
      "players": [
        { "hand": ["Island"], "library_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "declining the search leaves the hand empty",
    "players": [
      { "hand": ["Environmental Scientist"], "battlefield": ["Forest", "Forest"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Environmental Scientist" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 1 },
        {}
      ]
    }
  }
]
