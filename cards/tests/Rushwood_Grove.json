[
  {
    "name": "enters tapped",
    "players": [
      {
        "hand": [
          "Rushwood Grove"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Rushwood Grove"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Rushwood Grove"
          ]
        }
      ],
      "tapped": {
        "Rushwood Grove": true
      }
    }
  },
  {
    "name": "Rushwood Grove: remove all storage counters: adds one G per counter removed",
    "players": [
      {
        "battlefield": [
          {
            "name": "Rushwood Grove",
            "counters": {
              "storage": 3
            }
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Rushwood Grove",
        "color": "G"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "G": 3
          }
        },
        {}
      ],
      "counters": {
        "Rushwood Grove": {
          "storage": 0
        }
      },
      "tapped": {
        "Rushwood Grove": true
      }
    }
  },
  {
    "name": "Rushwood Grove: no storage counters: taps for no mana",
    "players": [
      {
        "battlefield": [
          "Rushwood Grove"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Rushwood Grove",
        "color": "G"
      }
    ],
    "expect": {
      "players": [
        {
          "pool": {
            "G": 0
          }
        },
        {}
      ],
      "tapped": {
        "Rushwood Grove": true
      }
    }
  },
  {
    "name": "{T}: put a storage counter on this land",
    "players": [ { "battlefield": ["Rushwood Grove"] }, {} ],
    "steps": [ { "activate": "Rushwood Grove" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Rushwood Grove"] }, {} ],
      "counters": { "Rushwood Grove": { "storage": 1 } },
      "tapped": { "Rushwood Grove": true }
    }
  },
  {
    "name": "{T}: a tapped Rushwood Grove cannot put a storage counter",
    "players": [ { "battlefield": [ { "name": "Rushwood Grove", "tapped": true } ] }, {} ],
    "steps": [ { "activate": "Rushwood Grove", "illegal": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Rushwood Grove"] }, {} ],
      "counters": { "Rushwood Grove": { "storage": 0 } }
    }
  }
]
