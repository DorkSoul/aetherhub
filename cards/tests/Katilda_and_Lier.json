 {
  "name": "casting a non-Human spell does not give flashback",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Katilda and Lier", "Forest", "Forest", "Mountain"], "graveyard": ["Lightning Bolt"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt"] },
    { "life": 20 }
   ]
  }
 },
 {
  "name": "ruling: an instant put into the graveyard without being cast can still be flashbacked",
  "players": [
   { "hand": ["Alaborn Trooper"], "battlefield": ["Katilda and Lier", "Plains", "Mountain", "Mountain", "Mountain"], "graveyard": ["Shock"] },
   {}
  ],
  "steps": [
   { "cast": "Alaborn Trooper" },
   { "resolve": true },
   { "cast": "Shock", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Shock"] },
    { "life": 18 }
   ]
  }
 }
