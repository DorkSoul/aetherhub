[
  { "name": "normal cast on your own turn for {2}{G} still works",
    "players": [ { "hand": ["Oakshade Stalker"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Oakshade Stalker" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Oakshade Stalker"], "hand_count": 0 }, {} ] } },
  { "name": "paying {2} more ({4}{G}) lets it be cast in the opponent's upkeep",
    "players": [ { "hand": ["Oakshade Stalker"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Oakshade Stalker", "alt": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Oakshade Stalker"] }, {} ] } },
  { "name": "flash costs {4}{G}: four Forests are not enough in the opponent's upkeep",
    "players": [ { "hand": ["Oakshade Stalker"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Oakshade Stalker", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Oakshade Stalker"] }, {} ] } },
  { "name": "three Forests: neither the flash cost nor sorcery-speed cost works in the opponent's upkeep",
    "players": [ { "hand": ["Oakshade Stalker"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Oakshade Stalker", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Oakshade Stalker"] }, {} ] } }
]
