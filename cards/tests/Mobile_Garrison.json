 {
  "name": "ruling: an attacker untapped by the attack trigger stays in combat and still deals damage",
  "players": [
   { "battlefield": ["Mobile Garrison", "Grizzly Bears", "Hill Giant"] },
   {}
  ],
  "steps": [
   { "activate": "Mobile Garrison", "ability": 0 },
   { "resolve": true },
   { "attack": [ { "card": "Mobile Garrison", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "resolve": true, "targets": ["Grizzly Bears"] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "life": 15 } ],
   "tapped": { "Grizzly Bears": false, "Hill Giant": true }
  }
 },
 {
  "name": "ruling: a crewed Vehicle is a creature with its printed 3/4 and deals 3 when unblocked",
  "players": [
   { "battlefield": ["Mobile Garrison", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Mobile Garrison", "ability": 0 },
   { "resolve": true },
   { "attack": [ { "card": "Mobile Garrison", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "life": 17 } ],
   "pt": { "Mobile Garrison": [3, 4] }
  }
 },
 {
  "name": "ruling: crewing an artifact creature again changes nothing about its P/T",
  "players": [
   { "battlefield": ["Mobile Garrison", "Grizzly Bears", "Hill Giant"] },
   {}
  ],
  "steps": [
   { "activate": "Mobile Garrison", "ability": 0 },
   { "resolve": true },
   { "activate": "Mobile Garrison", "ability": 0 },
   { "resolve": true }
  ],
