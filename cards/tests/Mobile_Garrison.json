   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Mobile Garrison", "Grapple with Death"] }, {} ],
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
