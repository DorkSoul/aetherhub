  {
    "name": "ruling: historic trigger resolves even if the spell is countered",
    "players": [
      { "hand": ["Daily Bugle Newspaper"], "battlefield": ["D'Avenant Trapper", "Plains", "Plains"] },
      { "hand": ["Counterspell"], "battlefield": ["Grizzly Bears", "Island", "Island"] }
