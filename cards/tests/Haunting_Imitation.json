[
  {
    "name": "both top cards are creatures: two 1/1 flying Spirit copies",
    "players": [
      { "hand": ["Haunting Imitation"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears"] },
      { "library": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Haunting Imitation" }, { "resolve": true }],
    "expect": {
      "players": [{ "graveyard": ["Haunting Imitation"], "battlefield_has": ["Grizzly Bears", "Hill Giant"] }, {}],
      "pt": { "Grizzly Bears": [1, 1], "Hill Giant": [1, 1] },
      "keywords": { "Grizzly Bears": ["Flying"], "Hill Giant": ["Flying"] }
    }
  },
  {
    "name": "no creature card revealed: Haunting Imitation returns to its owner's hand",
    "players": [
      { "hand": ["Haunting Imitation"], "battlefield": ["Island", "Island", "Island"], "library": ["Lightning Bolt"] },
      { "library": ["Forest"] }
    ],
    "steps": [{ "cast": "Haunting Imitation" }, { "resolve": true }],
    "expect": { "players": [{ "hand": ["Haunting Imitation"], "graveyard": [], "battlefield": ["Island", "Island", "Island"] }, {}] }
  },
  {
    "name": "only the opponent's top card is a creature: one token, the spell stays in the graveyard",
    "players": [
      { "hand": ["Haunting Imitation"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] },
      { "library": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Haunting Imitation" }, { "resolve": true }],
    "expect": {
      "players": [{ "graveyard": ["Haunting Imitation"], "battlefield": ["Island", "Island", "Island", "Hill Giant"] }, {}],
      "pt": { "Hill Giant": [1, 1] },
      "keywords": { "Hill Giant": ["Flying"] }
    }
  },
  {
    "name": "the revealed cards stay on top of their libraries",
    "players": [
      { "hand": ["Haunting Imitation"], "battlefield": ["Island", "Island", "Island"], "library": ["Grizzly Bears"] },
      { "library": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Haunting Imitation" }, { "resolve": true }],
    "expect": { "players": [{ "library_top": ["Grizzly Bears"] }, { "library_top": ["Hill Giant"] }] }
  },
  {
    "name": "ruling: revealed non-creature cards also stay on top of their libraries",
    "players": [
      { "hand": ["Haunting Imitation"], "battlefield": ["Island", "Island", "Island"], "library": ["Lightning Bolt"] },
      { "library": ["Forest"] }
    ],
    "steps": [{ "cast": "Haunting Imitation" }, { "resolve": true }],
    "expect": { "players": [{ "hand": ["Haunting Imitation"], "library_top": ["Lightning Bolt"] }, { "library_top": ["Forest"] }] }
  }
]
