[
  {
    "name": "enters and deals 5 to an opposing 2/2: excess damage makes a Treasure",
    "players": [
      {
        "hand": ["Magmatic Galleon"],
        "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Plains"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Magmatic Galleon" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Magmatic Galleon", "Treasure", "Mountain", "Mountain", "Plains", "Plains", "Plains"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "exactly lethal noncombat damage to an opposing 3/3 is not excess and makes no Treasure",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Magmatic Galleon", "Mountain"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Magmatic Galleon", "Mountain"], "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "excess damage to your own creature does not make a Treasure",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Magmatic Galleon", "Mountain", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Magmatic Galleon", "Mountain"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "crew 2 with a 3-power creature: the Galleon attacks as a 5/5",
    "players": [
      { "battlefield": ["Magmatic Galleon", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "activate": "Magmatic Galleon", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Magmatic Galleon", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magmatic Galleon", "Hill Giant"] },
        { "life": 15 }
      ],
      "tapped": { "Hill Giant": true }
    }
  },
  {
    "name": "crew 2 needs total power 2: a 1-power creature cannot crew",
    "players": [
      { "battlefield": ["Magmatic Galleon", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "activate": "Magmatic Galleon", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magmatic Galleon", "Llanowar Elves"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: damage already marked counts: Lightning Bolt on a 3/3 that took 2 from Shock is excess and makes a Treasure",
    "players": [
      { "hand": ["Shock", "Lightning Bolt"], "battlefield": ["Magmatic Galleon", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magmatic Galleon", "Treasure"], "graveyard_has": ["Shock", "Lightning Bolt"] },
        { "graveyard_has": ["Hill Giant"] }
      ]
    }
  }
]
