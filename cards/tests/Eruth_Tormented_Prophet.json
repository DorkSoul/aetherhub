[
  {
    "name": "draw is replaced by exiling the top two cards, which may be played this turn",
    "players": [
      {
        "hand": ["Glimpse of Freedom"],
        "battlefield": ["Eruth, Tormented Prophet", "Island", "Island", "Mountain"],
        "library": ["Forest", "Lightning Bolt", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Glimpse of Freedom" },
      { "resolve": true },
      { "play_land": "Forest" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "battlefield_has": ["Forest"],
          "graveyard_has": ["Glimpse of Freedom", "Lightning Bolt"]
        },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "without Eruth the same draw is an ordinary draw",
    "players": [
      {
        "hand": ["Glimpse of Freedom"],
        "battlefield": ["Island", "Island", "Mountain"],
        "library": ["Forest", "Lightning Bolt", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Glimpse of Freedom" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "graveyard_has": ["Glimpse of Freedom"]
        },
        {}
      ]
    }
  },
  {
    "name": "an opponent's draw is not replaced by Eruth",
    "players": [
      {
        "battlefield": ["Eruth, Tormented Prophet", "Island", "Island"],
        "library": ["Forest", "Lightning Bolt", "Island"]
      },
      {
        "hand": ["Glimpse of Freedom"],
        "battlefield": ["Island", "Island"],
        "library": ["Mountain", "Lightning Bolt", "Island"]
      }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Glimpse of Freedom", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 1,
          "graveyard_has": ["Glimpse of Freedom"]
        }
      ]
    }
  },
  {
    "name": "ruling: with fewer than two cards in library Eruth exiles what is there, and the draw does not lose the game",
    "players": [
      {
        "hand": ["Divination"],
        "battlefield": ["Eruth, Tormented Prophet", "Island", "Island", "Island"],
        "library": ["Forest"],
        "exact_library": true
      },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Forest"], "library_count": 0, "hand_count": 0 },
        {}
      ],
      "winner": -1
    }
  }
]
