[
  { "name": "its own combat damage equals its toughness (toughness 3 with the Backup counter)",
    "players": [ { "hand": ["Streetwise Negotiator"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Streetwise Negotiator" }, { "resolve": true }, { "resolve": true },
      { "advance_to": "Main1", "player": 1 }, { "advance_to": "Main1" }, { "attack": [ { "card": "Streetwise Negotiator", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "counters": { "Streetwise Negotiator": { "p1p1": 1 } }, "pt": { "Streetwise Negotiator": [1, 3] }, "players": [ {}, { "life": 17 } ] } },
  { "name": "backup on another creature grants the toughness rule until end of turn",
    "players": [ { "hand": ["Streetwise Negotiator"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Streetwise Negotiator" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 } }, "pt": { "Grizzly Bears": [3, 3] }, "players": [ {}, { "life": 17 } ] } },
  { "name": "backup on itself does not grant the rule to another creature",
    "players": [ { "hand": ["Streetwise Negotiator"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Streetwise Negotiator" }, { "resolve": true, "targets": ["Streetwise Negotiator"] }, { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ {}, { "life": 18 } ] } },
  { "name": "ruling: backup on another creature leaves the Negotiator's own toughness damage intact (it blocks for 2 and kills the 2/2)",
    "players": [ { "hand": ["Streetwise Negotiator"], "battlefield": ["Forest", "Forest", "Giant Spider"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Streetwise Negotiator" }, { "resolve": true, "targets": ["Giant Spider"] },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [ { "blocker": "Streetwise Negotiator", "attacker": "Grizzly Bears" } ], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Streetwise Negotiator"] }, { "graveyard_has": ["Grizzly Bears"] } ] } }
]
