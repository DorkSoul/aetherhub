[
  {
    "name": "4 damage to target creature you don't control",
    "players": [
      {
        "hand": ["Mizzium Mortars"],
        "battlefield": ["Mountain", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Mizzium Mortars", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Mizzium Mortars"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "overload deals 4 to each creature you don't control and not yours",
    "players": [
      {
        "hand": ["Mizzium Mortars"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"]
      },
      {
        "battlefield": ["Grizzly Bears", "Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Mizzium Mortars", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Grizzly Bears"],
          "graveyard": ["Mizzium Mortars"]
        },
        {
          "graveyard": ["Grizzly Bears", "Grizzly Bears"]
        }
      ]
    }
  },
  {
    "name": "ruling: without overload there is one target, so the other creature survives",
    "players": [
      { "hand": ["Mizzium Mortars"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Slippery Bogle"] }
    ],
    "steps": [
      { "cast": "Mizzium Mortars", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Mizzium Mortars"] },
        { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Slippery Bogle"] }
      ]
    }
  },
  {
    "name": "ruling: overloaded damage from a red spell is still prevented by protection from red",
    "players": [
      { "hand": ["Mizzium Mortars"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Silver Knight", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Mizzium Mortars", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Mizzium Mortars"] },
        { "battlefield_has": ["Silver Knight"], "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: overload does not target, so it kills a hexproof creature",
    "players": [
      { "hand": ["Mizzium Mortars"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Slippery Bogle"] }
    ],
    "steps": [
      { "cast": "Mizzium Mortars", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Mizzium Mortars"] },
        { "graveyard": ["Slippery Bogle"] }
      ]
    }
  }
]
