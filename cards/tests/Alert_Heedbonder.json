[
  {
    "name": "gains 1 life per vigilance creature at your end step",
    "players": [
      {
        "hand": [
          "Alert Heedbonder"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Alert Heedbonder"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 21
        },
        {}
      ]
    }
  },
  {
    "name": "counts the other vigilance creatures too",
    "players": [
      {
        "hand": [
          "Alert Heedbonder"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Alert Shu Infantry"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Alert Heedbonder"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 22
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the count is made as the trigger resolves, so a vigilance creature killed in response is not counted",
    "players": [
      {
        "battlefield": ["Alert Heedbonder", "Alert Shu Infantry"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "advance_to": "End", "hold": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Alert Shu Infantry"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "graveyard_has": ["Alert Shu Infantry"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]
