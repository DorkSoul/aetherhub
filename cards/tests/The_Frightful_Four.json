[
  { "name": "opponent's first noncreature spell: loses life equal to its mana value",
    "players": [ { "battlefield": ["The Frightful Four"] }, { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island"] } ],
    "steps": [ { "advance_to": "Main1" }, { "cast": "Divination", "player": 1 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["The Frightful Four"] }, { "life": 17 } ] } },
  { "name": "only the first noncreature spell each turn causes life loss",
    "players": [ { "battlefield": ["The Frightful Four"] }, { "hand": ["Divination", "Shock"], "battlefield": ["Island", "Island", "Island", "Mountain"] } ],
    "steps": [ { "advance_to": "Main1" }, { "cast": "Divination", "player": 1 }, { "resolve": true }, { "resolve": true }, { "cast": "Shock", "player": 1, "targets": ["The Frightful Four"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["The Frightful Four"] }, { "life": 17 } ] } },
  { "name": "a creature spell does not trigger it",
    "players": [ { "battlefield": ["The Frightful Four"] }, { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] } ],
    "steps": [ { "advance_to": "Main1" }, { "cast": "Grizzly Bears", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["The Frightful Four"] }, { "life": 20 } ] } }
]
