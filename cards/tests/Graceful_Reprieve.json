[
  {
    "name": "target creature that dies this turn returns to the battlefield",
    "players": [
      {
        "hand": [ "Graceful Reprieve" ],
        "battlefield": [ { "name": "Grizzly Bears", "sick": false }, "Plains", "Plains" ]
      },
      { "battlefield": [ "Hill Giant" ] }
    ],
    "steps": [
      { "cast": "Graceful Reprieve", "targets": [ "Grizzly Bears" ] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": [ "Grizzly Bears" ], "graveyard": [ "Graceful Reprieve" ] },
        { "battlefield_has": [ "Hill Giant" ] }
      ]
    }
  },
  {
    "name": "target creature that does not die this turn stays and the effect ends at end of turn",
    "players": [
      {
        "hand": [ "Graceful Reprieve" ],
        "battlefield": [ { "name": "Grizzly Bears", "sick": false }, "Plains", "Plains" ]
      },
      {}
    ],
    "steps": [
      { "cast": "Graceful Reprieve", "targets": [ "Grizzly Bears" ] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": [ "Grizzly Bears" ], "graveyard": [ "Graceful Reprieve" ] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: the return works once; if the returned creature dies again this turn it stays in the graveyard",
    "players": [
      { "hand": ["Graceful Reprieve", "Lightning Bolt"], "battlefield": [ { "name": "Grizzly Bears", "sick": false }, "Plains", "Plains", "Mountain", "Mountain" ] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Graceful Reprieve", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Graceful Reprieve", "Lightning Bolt", "Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] } ] }
  }
]
