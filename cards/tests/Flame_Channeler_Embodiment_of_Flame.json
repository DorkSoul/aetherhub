[
 { "name": "own burn spell dealing damage transforms it",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain","Flame Channeler // Embodiment of Flame"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Embodiment of Flame": [3,3] } } },
 { "name": "an opponent's spell damage does not transform it",
   "players": [ { "battlefield": ["Flame Channeler // Embodiment of Flame"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "life": 17 }, {} ], "pt": { "Flame Channeler // Embodiment of Flame": [2,2] } } },
 { "name": "a spell that deals no damage does not transform it",
   "players": [ { "hand": ["Divination"], "battlefield": ["Island","Island","Island","Flame Channeler // Embodiment of Flame"] }, {} ],
   "steps": [ { "cast": "Divination" }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Flame Channeler // Embodiment of Flame": [2,2] } } },
 { "name": "transformed: spell damage adds a flame counter, spend it to exile and play the top card",
   "players": [ { "hand": ["Lightning Bolt","Lightning Bolt"], "battlefield": ["Mountain","Mountain","Mountain","Flame Channeler // Embodiment of Flame"], "library": ["Forest","Plains"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true },
              { "activate": "Embodiment of Flame", "ability": 0 }, { "resolve": true },
              { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": ["Forest"], "library_count": 1 }, { "life": 14 } ],
               "counters": { "Embodiment of Flame": { "flame": 0 } } } },
 { "name": "ruling: a creature's combat damage is not a spell dealing damage, so no transform",
   "players": [ { "battlefield": ["Flame Channeler // Embodiment of Flame", "Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ], "pt": { "Flame Channeler // Embodiment of Flame": [2,2] } } },
 { "name": "ruling: a creature's enters-the-battlefield damage (Flametongue Kavu) is not a spell dealing damage",
   "players": [ { "hand": ["Flametongue Kavu"], "battlefield": ["Flame Channeler // Embodiment of Flame", "Mountain", "Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Flametongue Kavu" }, { "resolve": true, "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Hill Giant"] } ], "pt": { "Flame Channeler // Embodiment of Flame": [2,2] } } },
 { "name": "ruling: a fight spell's damage is dealt by the creatures, not the spell, so no transform",
   "players": [ { "hand": ["Prey Upon"], "battlefield": ["Forest", "Flame Channeler // Embodiment of Flame", "Grizzly Bears"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Prey Upon", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Prey Upon"] }, { "battlefield_has": ["Hill Giant"] } ],
               "pt": { "Flame Channeler // Embodiment of Flame": [2,2] } } }
]
