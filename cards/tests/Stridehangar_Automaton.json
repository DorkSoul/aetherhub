[
  {
    "name": "artifact tokens create one extra Thopter per event",
    "players": [
      { "hand": ["Brass's Bounty"], "battlefield": ["Stridehangar Automaton", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Brass's Bounty" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Stridehangar Automaton", "Treasure", "Thopter 1-1 Colorless Flying"] }, {} ]
    }
  },
  {
    "name": "without Stridehangar Automaton no Thopter is created",
    "players": [
      { "hand": ["Brass's Bounty"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Brass's Bounty" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Treasure"], "battlefield_lacks": ["Thopter 1-1 Colorless Flying"] }, {} ]
    }
  },
  {
    "name": "non-artifact tokens do not create a Thopter",
    "players": [
      { "hand": ["Pest Summoning"], "battlefield": ["Swamp", "Forest", "Forest", "Stridehangar Automaton"] },
      {}
    ],
    "steps": [
      { "cast": "Pest Summoning" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Pest 1-1", "Pest 1-1"], "battlefield_lacks": ["Thopter 1-1 Colorless Flying"] }, {} ]
    }
  },
  {
    "name": "Thopters get +1/+1 but other creatures do not",
    "players": [
      { "battlefield": ["Stridehangar Automaton", "Thopter 1-1 Colorless Flying", "Grizzly Bears"] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Thopter 1-1 Colorless Flying": [2, 2],
        "Grizzly Bears": [2, 2],
        "Stridehangar Automaton": [1, 4]
      }
    }
  },
  {
    "name": "ruling: an opponent's token spell gives no Thopter to the Automaton's controller",
    "players": [
      { "battlefield": ["Stridehangar Automaton"] },
      { "hand": ["Brass's Bounty"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Brass's Bounty", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Stridehangar Automaton"], "battlefield_lacks": ["Thopter 1-1 Colorless Flying"] },
        { "battlefield_has": ["Treasure"], "battlefield_lacks": ["Thopter 1-1 Colorless Flying"] }
      ]
    }
  }
]
