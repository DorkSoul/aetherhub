[
  {
    "name": "untaps during an opponent's untap step",
    "players": [
      { "hand": ["Plains"], "battlefield": [{ "name": "Thousand Moons Infantry", "tapped": true }, { "name": "Grizzly Bears", "tapped": true }] },
      { "hand": [], "library": [] }
    ],
    "steps": [
      { "play_land": "Plains" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "turn": 2,
      "tapped": { "Thousand Moons Infantry": false, "Grizzly Bears": true }
    }
  },
  {
    "name": "the untap trigger resolves during the opponent's untap step",
    "players": [
      { "hand": ["Plains"], "battlefield": [{ "name": "Thousand Moons Infantry", "tapped": true }, { "name": "Grizzly Bears", "tapped": true }] },
      { "hand": [], "library": [] }
    ],
    "steps": [
      { "play_land": "Plains" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "turn": 2,
      "tapped": { "Thousand Moons Infantry": false, "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: still untaps during its controller's own untap step",
    "players": [
      { "hand": [], "battlefield": [{ "name": "Thousand Moons Infantry", "tapped": true }, { "name": "Grizzly Bears", "tapped": true }] },
      { "hand": [], "library": [] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "turn": 3,
      "tapped": { "Thousand Moons Infantry": false, "Grizzly Bears": false }
    }
  }
]
