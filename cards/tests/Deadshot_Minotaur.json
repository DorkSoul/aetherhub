[
 { "name": "enters: deals 3 damage to target creature with flying",
   "players": [ { "hand": ["Deadshot Minotaur"], "battlefield": ["Mountain", "Forest", "Swamp", "Swamp", "Swamp"] },
                { "battlefield": ["Wind Drake", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Deadshot Minotaur" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Deadshot Minotaur"] }, { "graveyard_has": ["Wind Drake"], "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "no creature with flying: the enters trigger does nothing",
   "players": [ { "hand": ["Deadshot Minotaur"], "battlefield": ["Mountain", "Forest", "Swamp", "Swamp", "Swamp"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Deadshot Minotaur" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Deadshot Minotaur"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "cycling {R/G}: discard to draw a card",
   "players": [ { "hand": ["Deadshot Minotaur"], "battlefield": ["Forest"] }, {} ],
   "steps": [ { "activate": "Deadshot Minotaur", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Deadshot Minotaur"] }, {} ] } },
 { "name": "ruling: the enters ability is mandatory, so when I control the only flyer it must hit my own Wind Drake",
   "players": [ { "hand": ["Deadshot Minotaur"], "battlefield": ["Mountain", "Forest", "Swamp", "Swamp", "Swamp", "Wind Drake"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Deadshot Minotaur" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Deadshot Minotaur"], "graveyard_has": ["Wind Drake"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
