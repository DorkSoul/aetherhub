[
  { "name": "a land entering creates a tapped Powerstone token",
    "players": [ { "hand": ["Forest"], "battlefield": ["Sarinth Greatwurm"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sarinth Greatwurm", "Forest", "Powerstone"] }, {} ], "tapped": { "Powerstone": true } } },
  { "name": "a nonland permanent entering does not create a Powerstone",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Sarinth Greatwurm"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Powerstone"] }, {} ] } },
  { "name": "ruling: a land entering under any player's control makes the Powerstone for Sarinth's controller",
    "players": [ { "battlefield": ["Sarinth Greatwurm"] }, { "hand": ["Forest"] } ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Main1" }, { "play_land": "Forest", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sarinth Greatwurm", "Powerstone"] }, { "battlefield_has": ["Forest"], "battlefield_lacks": ["Powerstone"] } ], "tapped": { "Powerstone": true } } },
  { "name": "ruling: Powerstone mana cannot be spent on a nonartifact spell",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Powerstone"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: Powerstone mana can pay the cost of an activated ability (Witching Well)",
    "players": [ { "battlefield": ["Witching Well", "Island", "Island", "Island", "Powerstone"] }, {} ],
    "steps": [ { "activate": "Witching Well", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Witching Well"], "hand_count": 2 }, {} ] } }
]
