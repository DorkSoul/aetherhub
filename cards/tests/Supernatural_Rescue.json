[
  {
    "name": "cast: taps up to two creatures you don't control, then enchants your creature",
    "players": [
      { "hand": ["Supernatural Rescue"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Supernatural Rescue", "targets": ["Hill Giant", "Llanowar Elves"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Supernatural Rescue"] }, {} ],
      "pt": { "Grizzly Bears": [3, 4] },
      "tapped": { "Hill Giant": true, "Llanowar Elves": true }
    }
  },
  {
    "name": "cast choosing no targets for the trigger: only the aura applies",
    "players": [
      { "hand": ["Supernatural Rescue"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Supernatural Rescue" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 4] },
      "tapped": { "Hill Giant": false }
    }
  },
  {
    "name": "with a Spirit you control it has flash: cast in your end step onto your creature",
    "players": [
      { "hand": ["Supernatural Rescue"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears", "Moon Heron"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Supernatural Rescue", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Supernatural Rescue", "Moon Heron"] }, {} ],
      "pt": { "Grizzly Bears": [3, 4] }
    }
  },
  {
    "name": "without a Spirit it has no flash: cast in your end step is illegal",
    "players": [
      { "hand": ["Supernatural Rescue"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Supernatural Rescue", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Supernatural Rescue"], "battlefield_has": ["Grizzly Bears"] }, {} ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]
