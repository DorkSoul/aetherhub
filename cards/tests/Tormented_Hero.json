[
 { "name": "heroic: each opponent loses 1 life and you gain that much",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Tormented Hero"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Tormented Hero"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "life": 21 }, { "life": 19 } ], "pt": { "Tormented Hero": [5, 4] } } },
 { "name": "spell targeting another creature does not trigger",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Tormented Hero"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
 { "name": "enters tapped",
   "players": [ { "hand": ["Tormented Hero"], "battlefield": ["Swamp"] }, {} ],
   "steps": [ { "cast": "Tormented Hero" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Tormented Hero"] }, {} ], "tapped": { "Tormented Hero": true } } },
 { "name": "ruling: a spell whose target is changed onto a heroic creature does not trigger heroic",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Tormented Hero", "Goblin Flectomancer"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Hill Giant"] }, { "activate": "Goblin Flectomancer", "ability": 0, "targets": [ { "stack": "Giant Growth" } ] }, { "resolve": true, "answers": [[0]] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20 } ], "pt": { "Tormented Hero": [5, 4] } } }
]
