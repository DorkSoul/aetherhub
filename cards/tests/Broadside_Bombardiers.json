[
 {
  "name": "ruling: boast can be activated in the postcombat main phase, after combat damage",
  "players": [
   { "battlefield": ["Broadside Bombardiers", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Broadside Bombardiers", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" },
   { "activate": "Broadside Bombardiers", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "life": 14 } ] }
 },
 {
  "name": "ruling: a back face with no mana cost on the battlefield has the front face's mana value (Harnfel: 3, not 5)",
  "players": [
   { "hand": ["Birgi, God of Storytelling"], "battlefield": ["Broadside Bombardiers", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Birgi, God of Storytelling", "face": true },
   { "resolve": true },
   { "attack": [ { "card": "Broadside Bombardiers", "at": "p1" } ] },
   { "resolve": true },
   { "activate": "Broadside Bombardiers", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Birgi, God of Storytelling"] }, { "life": 15 } ] }
 },
 {
  "name": "ruling: an additional combat does not let a creature boast a second time",
  "players": [
   { "hand": ["Fury of the Horde", "Lightning Bolt", "Shock"], "battlefield": ["Broadside Bombardiers", "Grizzly Bears", "Hill Giant"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Broadside Bombardiers", "at": "p1" } ] },
   { "block": [] },
   { "activate": "Broadside Bombardiers", "targets": ["p1"], "answers": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "cast": "Fury of the Horde", "alt": 0 },
   { "resolve": true },
   { "attack": [ { "card": "Broadside Bombardiers", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" },
   { "activate": "Broadside Bombardiers", "targets": ["p1"], "illegal": true }
  ],
  "expect": { "players": [ { "exile": ["Lightning Bolt", "Shock"], "graveyard_has": ["Fury of the Horde", "Grizzly Bears"] }, { "life": 12 } ] }
 },
 {
