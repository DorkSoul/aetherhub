[
  {
    "name": "enters and creates a Food",
    "players": [
      {
        "hand": [
          "Trail of Crumbs"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Trail of Crumbs"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Trail of Crumbs",
            "Food"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "sacrificing a Food: declining to pay {1} gives nothing",
    "players": [
      {
        "hand": [
          "Trail of Crumbs"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Trail of Crumbs"
      },
      {
        "resolve": true
      },
      {
        "activate": "Food",
        "ability": 0
      },
      {
        "resolve": true,
        "answers": [
          false
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "life": 23,
          "battlefield_has": [
            "Trail of Crumbs"
          ],
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a permanent card is taken from the top two; an instant on top is not",
    "players": [
      { "hand": ["Trail of Crumbs"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Trail of Crumbs" },
      { "resolve": true },
      { "activate": "Food", "ability": 0 },
      { "resolve": true, "answers": [true, "Forest"] }
    ],
    "expect": {
      "players": [
        { "life": 23, "hand": ["Forest"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "ruling: one Food cannot pay for two sacrifice costs (Pizza's ability first, then Maraleaf Rider has no Food)",
    "players": [
      { "battlefield": ["Maraleaf Rider", "Anchovy & Banana Pizza", "Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Anchovy & Banana Pizza", "ability": 0 },
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Hill Giant"], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "graveyard": ["Anchovy & Banana Pizza"], "battlefield_has": ["Maraleaf Rider"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: Tough Cookie (a Food creature) can be sacrificed to Maraleaf Rider and triggers Trail of Crumbs",
    "players": [
      { "battlefield": ["Trail of Crumbs", "Maraleaf Rider", "Tough Cookie", "Forest"], "library": ["Lightning Bolt", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true, "answers": [true, "Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Tough Cookie"], "hand": ["Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
