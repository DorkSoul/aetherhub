   "steps": [ { "cast": "Hint of Insanity", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Hint of Insanity"] }, { "hand": ["Grizzly Bears", "Forest"], "graveyard": ["Lightning Bolt", "Lightning Bolt"] } ] } },
 { "name": "all copies of a name are discarded, not just all but one",
   "players": [ { "hand": ["Hint of Insanity"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] } ],
   "steps": [ { "cast": "Hint of Insanity", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "hand": [], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] } ] } },
 { "name": "duplicate lands are not discarded",
   "players": [ { "hand": ["Hint of Insanity"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Forest", "Forest"] } ],
   "steps": [ { "cast": "Hint of Insanity", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "hand": ["Forest", "Forest"] } ] } },
 { "name": "ruling: targeting yourself, your own duplicate nonland cards are discarded and the land stays",
   "players": [ { "hand": ["Hint of Insanity", "Lightning Bolt", "Lightning Bolt", "Forest"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {} ],
   "steps": [ { "cast": "Hint of Insanity", "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Hint of Insanity", "Lightning Bolt", "Lightning Bolt"] }, {} ] } }
