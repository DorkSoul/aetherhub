[
  { "name": "surge: after another spell this turn, ETB deals 3 damage to any target",
    "players": [ { "hand": ["Lightning Bolt", "Tyrant of Valakut"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true }, { "cast": "Tyrant of Valakut", "alt": 0 }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tyrant of Valakut"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Hill Giant", "Grizzly Bears"] } ] } },
  { "name": "full cost with no other spell this turn: no surge, no damage",
    "players": [ { "hand": ["Tyrant of Valakut"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Tyrant of Valakut" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tyrant of Valakut"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "surge is illegal when no other spell was cast this turn",
    "players": [ { "hand": ["Tyrant of Valakut"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Tyrant of Valakut", "alt": 0, "illegal": true } ],
    "expect": {} },
  { "name": "ruling: a spell cast by the opponent does not enable surge for you",
    "players": [ { "hand": ["Tyrant of Valakut"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Tyrant of Valakut", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Tyrant of Valakut"], "life": 17 }, { "graveyard": ["Lightning Bolt"] } ] } }
