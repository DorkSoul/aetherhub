[
  { "name": "a modified Guardians can attack even though it has defender",
    "players": [ { "battlefield": [{ "name": "Guardians of Oboro", "sick": false, "counters": { "+1/+1": 1 } }] }, {} ],
    "steps": [ { "attack": [ { "card": "Guardians of Oboro", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ] } },
  { "name": "an unmodified Guardians still cannot attack because of defender",
    "players": [ { "battlefield": [{ "name": "Guardians of Oboro", "sick": false }] }, {} ],
    "steps": [ { "attack": [ { "card": "Guardians of Oboro", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "ruling: an Aura controlled by an opponent does not make a creature modified",
    "players": [ { "battlefield": [{ "name": "Guardians of Oboro", "sick": false }] }, { "hand": ["Rancor"], "battlefield": ["Forest"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Rancor", "player": 1, "targets": ["Guardians of Oboro"] }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Guardians of Oboro", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "ruling: an Aura you control makes the creature modified (control for the opponent-Aura case)",
    "players": [ { "hand": ["Rancor"], "battlefield": ["Forest", { "name": "Guardians of Oboro", "sick": false }] }, {} ],
    "steps": [ { "cast": "Rancor", "targets": ["Guardians of Oboro"] }, { "resolve": true }, { "attack": [ { "card": "Guardians of Oboro", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "ruling: a creature with a -1/-1 counter is modified, whatever kind of counter it has",
    "players": [ { "battlefield": [{ "name": "Guardians of Oboro", "sick": false, "counters": { "-1/-1": 1 } }] }, {} ],
    "steps": [ { "attack": [ { "card": "Guardians of Oboro", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] } }
]
