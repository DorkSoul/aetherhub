[
  {
    "name": "creates a 3/3 green Elephant",
    "players": [ { "hand": ["Elephant Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Elephant Ambush" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Elephant 3-3"], "graveyard": ["Elephant Ambush"] }, {} ],
      "pt": { "Elephant 3-3": [3, 3] }
    }
  },
  {
    "name": "flashback casts it from the graveyard and then exiles it",
    "players": [ { "graveyard": ["Elephant Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Elephant Ambush", "alt": 0 }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Elephant 3-3"], "exile": ["Elephant Ambush"], "graveyard": [] }, {} ]
    }
  },
  {
    "name": "ruling: the normal mana cost cannot cast it from the graveyard, only flashback can",
    "players": [ { "graveyard": ["Elephant Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Elephant Ambush", "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Elephant Ambush"], "battlefield_lacks": ["Elephant 3-3"] }, {} ] }
  }
]
