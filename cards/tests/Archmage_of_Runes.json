     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Divination",
    "illegal": true
   }
  ],
  "expect": {}
 },
 {
  "name": "creature spells are not discounted",
  "players": [
   {
    "hand": [
     "Grizzly Bears"
    ],
    "battlefield": [
     "Archmage of Runes",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Grizzly Bears",
    "illegal": true
