 {
  "name": "ruling: the discount reduces only generic, so Divination still needs blue",
  "players": [
   { "hand": ["Divination"], "battlefield": ["Archmage of Runes", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [ { "cast": "Divination", "illegal": true } ],
  "expect": { "players": [ { "hand": ["Divination"] }, {} ] }
 },
 {
  "name": "ruling: the draw resolves even if the instant is countered",
  "players": [
   { "hand": ["Divination"], "battlefield": ["Archmage of Runes", "Island", "Island"], "library": ["Forest", "Swamp"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Divination" },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [ {"stack": "Divination"} ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Divination"], "hand_count": 1 }, { "graveyard": ["Counterspell"] } ] }
 }
