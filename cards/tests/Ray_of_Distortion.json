[
  {
    "name": "destroys an enchantment",
    "players": [
      { "hand": ["Ray of Distortion"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Glorious Anthem", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ray of Distortion", "targets": ["Glorious Anthem"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Ray of Distortion"] },
        { "graveyard": ["Glorious Anthem"], "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "flashback for 4WW exiles it",
    "players": [
      { "graveyard": ["Ray of Distortion"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Ray of Distortion", "alt": 0, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": [], "exile": ["Ray of Distortion"] },
        { "graveyard": ["Sol Ring"] }
      ]
    }
  },
  {
    "name": "cannot target a creature",
    "players": [
      { "hand": ["Ray of Distortion"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ray of Distortion", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Ray of Distortion"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a flashback spell that fizzles is still exiled",
    "players": [
      { "hand": ["Ray of Distortion"], "graveyard": ["Ray of Distortion"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Ray of Distortion", "alt": 0, "targets": ["Sol Ring"] },
      { "cast": "Ray of Distortion", "targets": ["Sol Ring"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Ray of Distortion"], "exile": ["Ray of Distortion"] },
        { "graveyard": ["Sol Ring"] }
      ]
    }
  }
]
