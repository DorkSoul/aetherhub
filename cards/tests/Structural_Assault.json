[
  {
    "name": "two artifacts destroyed deal 2 to each creature",
    "players": [
      { "hand": ["Structural Assault"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Aether Vial", "Grizzly Bears", "Hill Giant"] },
      { "battlefield": ["Alchemist's Vial", "Savannah Lions", "Serra Angel"] }
    ],
    "steps": [
      { "cast": "Structural Assault" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Structural Assault", "Aether Vial", "Grizzly Bears"], "battlefield_has": ["Hill Giant"] },
        { "graveyard": ["Alchemist's Vial", "Savannah Lions"], "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "no artifacts means no damage",
    "players": [
      { "hand": ["Structural Assault"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "cast": "Structural Assault" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Savannah Lions"] } ] }
  },
  {
    "name": "artifact creatures count as artifacts and take the damage too",
    "players": [
      { "hand": ["Structural Assault"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Juggernaut", "Aether Vial", "Wayfarer's Bauble", "Hill Giant"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Structural Assault" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Structural Assault", "Juggernaut", "Aether Vial", "Wayfarer's Bauble", "Hill Giant"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling: an artifact sacrificed earlier this turn counts, so Assault deals 1 damage to each creature",
    "players": [
      { "hand": ["Structural Assault"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Wayfarer's Bauble", "Grizzly Bears"] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "activate": "Wayfarer's Bauble", "ability": 0 },
      { "resolve": true },
      { "cast": "Structural Assault" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Wayfarer's Bauble", "Structural Assault"], "battlefield_has": ["Grizzly Bears"] },
        { "graveyard": ["Savannah Lions"] }
      ]
    }
  }
]
