[
  {
    "name": "renowned: menace, so a single blocker is dropped and the 2/2 connects",
    "players": [{"battlefield": ["Goblin Glory Chaser"]}, {"battlefield": ["Grizzly Bears", "Savannah Lions"]}],
    "steps": [{"attack": [{"card": "Goblin Glory Chaser", "at": "p1"}]}, {"block": []}, {"advance_to": "Main2"}, {"resolve": true}, {"advance_to": "Main1"}, {"advance_to": "Main1"}, {"attack": [{"card": "Goblin Glory Chaser", "at": "p1"}]}, {"block": [{"blocker": "Grizzly Bears", "attacker": "Goblin Glory Chaser"}]}, {"advance_to": "Main2"}],
    "expect": {"players": [{}, {"life": 17}]}
  },
  {
    "name": "unblocked combat damage to a player renowns it",
    "players": [{ "battlefield": ["Goblin Glory Chaser"] }, {}],
    "steps": [{ "attack": [{ "card": "Goblin Glory Chaser", "at": "p1" }] }, { "advance_to": "Main2" }, { "resolve": true }],
    "expect": { "players": [{}, { "life": 19 }], "counters": { "Goblin Glory Chaser": { "p1p1": 1 } }, "pt": { "Goblin Glory Chaser": [2, 2] } }
  },
  {
    "name": "damage to a blocker does not renown it",
    "players": [{ "battlefield": ["Goblin Glory Chaser"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [{ "card": "Goblin Glory Chaser", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Goblin Glory Chaser" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "graveyard": ["Goblin Glory Chaser"] }, { "life": 20 }] }
  },
  {
    "name": "ruling: removing one of two menace blockers (Bolt) does not undo the block, so no damage to the player",
    "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Goblin Glory Chaser", "Mountain"]}, {"battlefield": ["Grizzly Bears", "Savannah Lions"]}],
    "steps": [
      {"attack": [{"card": "Goblin Glory Chaser", "at": "p1"}]},
      {"block": []},
      {"advance_to": "Main2"},
      {"resolve": true},
      {"advance_to": "Main1"},
      {"advance_to": "Main1"},
      {"attack": [{"card": "Goblin Glory Chaser", "at": "p1"}]},
      {"block": [{"blocker": "Grizzly Bears", "attacker": "Goblin Glory Chaser"}, {"blocker": "Savannah Lions", "attacker": "Goblin Glory Chaser"}]},
      {"cast": "Lightning Bolt", "targets": ["Savannah Lions"]},
      {"resolve": true},
      {"advance_to": "Main2"}
    ],
    "expect": {"players": [{"graveyard_has": ["Lightning Bolt"]}, {"life": 19, "graveyard_has": ["Savannah Lions"]}]}
  }
