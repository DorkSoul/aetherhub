[
  { "name": "attack exiles the targeted instant and casts a free copy that may target",
    "players": [ { "battlefield": ["Renegade Bull"], "graveyard": ["Lightning Bolt", "Shock"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Renegade Bull", "at": "p1" } ] },
      { "block": [], "answers": ["Lightning Bolt", true, "p1"] }
    ],
    "expect": { "players": [ { "exile": ["Lightning Bolt"], "graveyard": ["Shock"] }, { "life": 17 } ] } },
  { "name": "up to one: choosing no target exiles nothing and casts nothing",
    "players": [ { "battlefield": ["Renegade Bull"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Renegade Bull", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 20 } ] } },
  { "name": "+X/+0 where X is the mana value of the instant cast",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Renegade Bull", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Renegade Bull"] }, { "life": 17 } ], "pt": { "Renegade Bull": [1, 5] } } },
  { "name": "ruling: declining the free copy casts nothing and the card stays exiled",
    "players": [ { "battlefield": ["Renegade Bull"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Renegade Bull", "at": "p1" } ] },
      { "block": [], "answers": ["Lightning Bolt", false] }
    ],
    "expect": { "players": [ { "exile": ["Lightning Bolt"] }, { "life": 20 } ] } },
  { "name": "ruling: the free copy of an X spell is cast with X 0",
    "players": [ { "battlefield": ["Renegade Bull"], "graveyard": ["Fireball"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Renegade Bull", "at": "p1" } ] },
      { "block": [], "answers": ["Fireball", true, "Grizzly Bears", 0] }
    ],
    "expect": { "players": [ { "exile": ["Fireball"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: the pump uses the mana value of the spell with the X it was cast with",
    "players": [ { "hand": ["Fireball"], "battlefield": ["Renegade Bull", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Fireball", "targets": ["p1"], "answers": [3] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Renegade Bull"] }, { "life": 17 } ], "pt": { "Renegade Bull": [4, 5] } } }
]
