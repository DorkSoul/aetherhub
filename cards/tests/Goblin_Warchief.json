  {
    "name": "Goblins have haste, non-Goblins do not; opponent's Goblins unaffected",
    "players": [
      {
        "battlefield": [
          "Goblin Warchief",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Raging Goblin"
        ]
      }
    ],
    "steps": [],
    "expect": {
      "keywords": {
        "Goblin Warchief": [
          "Haste"
        ],
        "Grizzly Bears": [],
        "Raging Goblin": []
      }
    }
  },
  {
    "name": "non-Goblin spells are not reduced",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Goblin Warchief",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the reduction is generic only, so Skirk Prospector ({R}) still needs a red source",
    "players": [ { "hand": ["Skirk Prospector"], "battlefield": ["Goblin Warchief", "Mountain"] }, {} ],
    "steps": [ { "cast": "Skirk Prospector" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Goblin Warchief", "Skirk Prospector"] }, {} ] }
  },
  {
    "name": "ruling: with no lands Skirk Prospector cannot be cast (its colored cost is not reduced away)",
    "players": [ { "hand": ["Skirk Prospector"], "battlefield": ["Goblin Warchief"] }, {} ],
    "steps": [ { "cast": "Skirk Prospector", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Skirk Prospector"] }, {} ] }
  }
