[
  {
    "name": "at the beginning of your end step it phases out",
    "players": [ { "battlefield": ["Crystal Golem"] }, {} ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_lacks": ["Crystal Golem"] }, {} ] }
  },
  {
    "name": "it phases back in before its controller's next untap step",
    "players": [ { "battlefield": ["Crystal Golem"] }, {} ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Crystal Golem"] }, {} ] }
  }
]
