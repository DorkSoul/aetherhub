[
 {
  "name": "a Forest tapped for mana adds an additional G",
  "players": [
   {
    "battlefield": [
     "Vernal Bloom",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Forest"
   }
  ],
  "expect": {
   "players": [
    {
     "pool": {
      "G": 2
     }
    },
    {}
   ]
  }
 },
 {
  "name": "non-Forest lands don't",
  "players": [
   {
    "battlefield": [
     "Vernal Bloom",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Mountain"
   }
  ],
  "expect": {
   "players": [
    {
     "pool": {
      "R": 1
     }
    },
    {}
   ]
  }
 },
 {
  "name": "an opponent's Forest gives its controller the extra G",
  "players": [
   {
    "battlefield": [
     "Vernal Bloom"
    ]
   },
   {
    "battlefield": [
     "Forest"
    ]
   }
  ],
  "steps": [
   {
    "pass": true
   },
   {
    "tap_for_mana": "Forest",
    "player": 1
   }
  ],
  "expect": {
   "players": [
    {
     "pool": {}
    },
    {
     "pool": {
      "G": 2
     }
    }
   ]
  }
 },
 {
  "name": "ruling: the extra G is a mana ability, usable at once (a 1G spell is cast with one Forest)",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Vernal Bloom", "Forest"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Forest" },
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": { "stack_empty": true, "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
 }
]