[
 { "name": "repartee: casting an instant that targets a creature puts a +1/+1 counter on a creature you control",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Graduation Day", "Llanowar Elves"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ], "counters": { "Llanowar Elves": { "p1p1": 1 } } } },
 { "name": "a spell that targets only a player does not trigger it",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Graduation Day", "Llanowar Elves"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ], "pt": { "Llanowar Elves": [1, 1] } } },
 { "name": "ruling: the repartee trigger resolves before the spell that caused it",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Graduation Day", "Llanowar Elves"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 } ],
   "expect": { "stack_empty": false, "counters": { "Llanowar Elves": { "p1p1": 1 } }, "players": [ {}, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: repartee still resolves when the targeted creature leaves before the spell resolves",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Graduation Day", "Llanowar Elves"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "counters": { "Llanowar Elves": { "p1p1": 1 } }, "players": [ { "graveyard": ["Lightning Bolt"], "battlefield_has": ["Graduation Day", "Llanowar Elves"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] } }
]
