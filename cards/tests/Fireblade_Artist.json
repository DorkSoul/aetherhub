[
  {
    "name": "upkeep: sacrifice a creature, then 2 damage to target opponent",
    "players": [
      { "battlefield": [{ "name": "Fireblade Artist", "sick": false }] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Fireblade Artist"] }, { "life": 18 }]
    }
  },
  {
    "name": "upkeep: declining to sacrifice deals no damage",
    "players": [
      { "battlefield": [{ "name": "Fireblade Artist", "sick": false }] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Fireblade Artist"] }, { "life": 20 }]
    }
  },
  {
    "name": "ruling: the reflexive trigger's target is chosen after the sacrifice (2 damage to a planeswalker)",
    "players": [
      { "battlefield": [{ "name": "Fireblade Artist", "sick": false }, "Grizzly Bears"] },
      { "battlefield": ["Test Walker"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true, "Grizzly Bears", "Test Walker"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Fireblade Artist"] },
        { "life": 20, "battlefield_has": ["Test Walker"] }
      ],
      "counters": { "Test Walker": { "loyalty": 2 } }
    }
  }
]
