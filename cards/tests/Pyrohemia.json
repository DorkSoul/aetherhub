[
  {
    "name": "R: 1 damage to each creature and each player",
    "players": [
      {
        "battlefield": [
          "Pyrohemia",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Pyrohemia"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 19,
          "battlefield": [
            "Pyrohemia",
            "Mountain",
            "Grizzly Bears"
          ]
        },
        {
          "life": 19,
          "battlefield": [
            "Hill Giant"
          ]
        }
      ],
      "pt": {
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "kills 1-toughness creatures",
    "players": [
      {
        "battlefield": [
          "Pyrohemia",
          "Mountain",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Raging Goblin"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Pyrohemia"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 19,
          "graveyard": []
        },
        {
          "life": 19,
          "graveyard": [
            "Raging Goblin"
          ]
        }
      ]
    }
  },
  {
    "name": "sacrificed at the end step when no creatures are on the battlefield",
    "players": [
      {
        "battlefield": [
          "Pyrohemia"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [],
          "graveyard": [
            "Pyrohemia"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "stays if any creature is on the battlefield (opponent's too)",
    "players": [
      {
        "battlefield": [
          "Pyrohemia"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Pyrohemia"
          ]
        },
        {
          "battlefield": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: each activation is its own 1 damage, so two activations kill a 2-toughness creature",
    "players": [
      { "battlefield": ["Pyrohemia", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Pyrohemia" },
      { "resolve": true },
      { "activate": "Pyrohemia" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "graveyard": ["Grizzly Bears"], "battlefield": ["Pyrohemia", "Mountain", "Mountain"] },
        { "life": 18, "battlefield": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: an artifact creature animated until end of turn keeps Pyrohemia at the end step",
    "players": [ { "battlefield": ["Pyrohemia", "Mishra's Factory", "Mountain"] }, {} ],
    "steps": [ { "activate": "Mishra's Factory", "ability": 0 }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Pyrohemia", "Mishra's Factory"] }, {} ], "pt": { "Mishra's Factory": [2, 2] } }
  },
  {
    "name": "ruling: a creature dying during the end step does not make Pyrohemia be sacrificed",
    "players": [ { "battlefield": ["Pyrohemia", "Mountain", "Raging Goblin"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "activate": "Pyrohemia" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Pyrohemia"], "graveyard_has": ["Raging Goblin"] }, {} ] }
  }
]
