 {
  "name": "ruling: an exiled land can be played in your main phase when you have a land play left",
  "players": [
   {
    "battlefield": ["Lightning, Security Sergeant"],
    "library": ["Mountain"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Lightning, Security Sergeant", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" },
   { "play_land": "Mountain" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Lightning, Security Sergeant", "Mountain"], "exile": [] },
    { "life": 18 }
   ]
  }
 },
 {
