    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Clinging Anemones", "Grizzly Bears"] }, {} ], "counters": { "Clinging Anemones": { "p1p1": 1 } }, "pt": { "Clinging Anemones": [2, 5] } }
  },
  {
    "name": "does not evolve when neither stat is greater",
