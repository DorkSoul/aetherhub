    "steps": [ { "cast": "Llanowar Elves" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Clinging Anemones": [1, 4] } }
  },
  {
    "name": "ruling: a creature entering with +1/+1 counters is compared with those counters",
    "players": [ { "hand": ["Hangarback Walker"], "battlefield": ["Clinging Anemones", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Hangarback Walker", "answers": [2] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Clinging Anemones", "Hangarback Walker"] }, {} ], "counters": { "Clinging Anemones": { "p1p1": 1 }, "Hangarback Walker": { "p1p1": 2 } }, "pt": { "Clinging Anemones": [2, 5], "Hangarback Walker": [2, 2] } }
  },
  {
    "name": "ruling: power is compared with power and toughness with toughness (a same-sized creature does not evolve)",
    "players": [ { "hand": ["Clinging Anemones"], "battlefield": ["Clinging Anemones", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Clinging Anemones" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Clinging Anemones": { "p1p1": 0 } }, "pt": { "Clinging Anemones": [1, 4] } }
  },
  {
    "name": "ruling: if the entering creature dies before evolve resolves, its last known power and toughness are used",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Clinging Anemones", "Forest", "Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Clinging Anemones"] }, { "graveyard": ["Lightning Bolt"] } ], "counters": { "Clinging Anemones": { "p1p1": 1 } }, "pt": { "Clinging Anemones": [2, 5] } }
  }
]
