[
  {
    "name": "Shock on Lichenthrope puts two -1/-1 counters instead of dealing damage",
    "players": [
      {
        "hand": [],
        "battlefield": ["Lichenthrope"]
      },
      {
        "hand": ["Shock"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Lichenthrope"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lichenthrope"] },
        { "graveyard": ["Shock"] }
      ],
      "counters": { "Lichenthrope": { "MinusOneMinusOne": 2 } },
      "pt": { "Lichenthrope": [3, 3] }
    }
  },
  {
    "name": "at the beginning of your upkeep one -1/-1 counter is removed",
    "players": [
      {
        "hand": [],
        "battlefield": [
          { "name": "Lichenthrope", "counters": { "m1m1": 2 } }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lichenthrope"] },
        {}
      ],
      "counters": { "Lichenthrope": { "MinusOneMinusOne": 1 } },
      "pt": { "Lichenthrope": [4, 4] }
    }
  },
  {
    "name": "ruling: damage replaced by counters has no side effects: lifelink gains nothing and deathtouch does not destroy",
    "players": [
      { "hand": [], "battlefield": ["Lichenthrope"] },
      { "battlefield": ["Vampire Nighthawk"] }
    ],
    "steps": [
      { "attack": [ { "card": "Lichenthrope", "at": "p1" } ] },
      { "block": [ { "blocker": "Vampire Nighthawk", "attacker": "Lichenthrope" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Lichenthrope"], "life": 20 },
        { "graveyard_has": ["Vampire Nighthawk"], "life": 20 }
      ],
      "counters": { "Lichenthrope": { "MinusOneMinusOne": 2 } },
      "pt": { "Lichenthrope": [3, 3] }
    }
  }
]
