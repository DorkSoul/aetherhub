[
  {
    "name": "evolves when a bigger creature enters",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Cloudfin Raptor",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Cloudfin Raptor": [
          1,
          2
        ]
      }
    }
  },
  {
    "name": "a smaller creature does not evolve it",
    "players": [
      {
        "hand": [
          "Cloudfin Raptor"
        ],
        "battlefield": [
          "Grizzly Bears",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Cloudfin Raptor"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Cloudfin Raptor": [
          0,
          1
        ]
      }
    }
  },
  {
    "name": "ruling: a creature with greater toughness but equal power still makes evolve trigger",
    "players": [
      { "hand": ["Wall of Stone"], "battlefield": ["Cloudfin Raptor", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Wall of Stone" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Cloudfin Raptor": [1, 2] }
    }
  },
  {
    "name": "ruling: equal power and smaller toughness does not evolve it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": [{ "name": "Cloudfin Raptor", "counters": { "p1p1": 2 } }, "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Cloudfin Raptor": [2, 3] }
    }
  }
]
