[
  { "name": "ruling: if its only target is gone when it resolves, nothing happens and no Clue is created",
    "players": [ { "hand": ["The Chase Is On"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "The Chase Is On", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["The Chase Is On"], "battlefield_lacks": ["Clue"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } },
  { "name": "+3/+0, first strike on own creature, and investigate",
    "players": [ { "hand": ["The Chase Is On"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "The Chase Is On", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "pt": { "Grizzly Bears": [5, 2] },
      "keywords": { "Grizzly Bears": ["FirstStrike"] },
      "players": [ { "battlefield_has": ["Clue"] }, {} ] } },
  { "name": "targets an opposing creature; investigate still happens for the caster",
    "players": [ { "hand": ["The Chase Is On"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "The Chase Is On", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "pt": { "Grizzly Bears": [5, 2] },
      "keywords": { "Grizzly Bears": ["FirstStrike"] },
      "players": [ { "battlefield_has": ["Clue"] }, {} ] } },
  { "name": "cannot be cast without a creature to target",
    "players": [ { "hand": ["The Chase Is On"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "The Chase Is On", "illegal": true } ],
    "expect": { "players": [ { "hand": ["The Chase Is On"] }, {} ] } }
