[
  {
    "name": "job select creates a Hero with the Planisphere attached",
    "players": [
      {
        "hand": [
          "Astrologian's Planisphere"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Astrologian's Planisphere"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Hero"
          ]
        }
      ],
      "attached": {
        "Astrologian's Planisphere": "Hero"
      }
    }
  },
  {
    "name": "casting a noncreature spell puts a counter on the equipped creature",
    "players": [
      {
        "hand": [
          "Divination"
        ],
        "battlefield": [
          "Astrologian's Planisphere",
          "Grizzly Bears",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Astrologian's Planisphere",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "casting a creature spell does not put a counter on the equipped creature",
    "players": [
      {
        "hand": [
          "Wall of Omens"
        ],
        "battlefield": [
          "Astrologian's Planisphere",
          "Grizzly Bears",
          "Plains",
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Astrologian's Planisphere",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Wall of Omens"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "only the third card drawn in a turn adds a counter",
    "players": [
      {
        "hand": [
          "Divination",
          "Divination"
        ],
        "battlefield": [
          "Astrologian's Planisphere",
          "Grizzly Bears",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Astrologian's Planisphere",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      },
      {
        "cast": "Divination"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          5,
          5
        ]
      }
    }
  },
  {
    "name": "equipped creature is a Wizard, so Naru Meha's 'other Wizards get +1/+1' applies to it",
    "players": [
      { "battlefield": ["Astrologian's Planisphere", "Grizzly Bears", "Naru Meha, Master Wizard", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Astrologian's Planisphere", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "ruling: destroying the Hero token leaves the Planisphere on the battlefield",
    "players": [
      { "hand": ["Astrologian's Planisphere", "Lightning Bolt"], "battlefield": ["Island", "Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Astrologian's Planisphere" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hero"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Astrologian's Planisphere"], "battlefield_lacks": ["Hero"] }, {} ]
    }
  },
  {
    "name": "ruling: paying equip moves the Planisphere from the Hero token to another creature I control",
    "players": [
      { "hand": ["Astrologian's Planisphere"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Astrologian's Planisphere" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Astrologian's Planisphere", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Hero", "Grizzly Bears"] }, {} ],
      "attached": { "Astrologian's Planisphere": "Grizzly Bears" }
    }
  }
]
