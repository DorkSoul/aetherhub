[
  {
    "name": "tap: exile the bottom (oldest) card of target player's graveyard",
    "players": [
      { "battlefield": ["Phyrexian Furnace"] },
      { "graveyard": ["Grizzly Bears", "Shock", "Island"] }
    ],
    "steps": [
      { "activate": "Phyrexian Furnace", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Shock", "Island"], "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "sacrifice: exile target card from a graveyard and draw",
    "players": [
      { "battlefield": ["Phyrexian Furnace", "Plains"], "library": ["Mountain"] },
      { "graveyard": ["Grizzly Bears", "Shock"] }
    ],
    "steps": [
      { "activate": "Phyrexian Furnace", "ability": 1, "targets": ["Shock"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Phyrexian Furnace"], "hand": ["Mountain"] },
        { "graveyard": ["Grizzly Bears"], "exile": ["Shock"] }
      ]
    }
  }
]
