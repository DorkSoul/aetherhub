[
 {
  "name": "heroic: a spell targeting it puts a +1/+1 counter on it",
  "players": [
   {
    "hand": [
     "Giant Growth"
    ],
    "battlefield": [
     "Forest",
     "Fabled Hero"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Giant Growth",
    "targets": [
     "Fabled Hero"
    ]
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {}
   ],
   "counters": {
    "Fabled Hero": {
     "p1p1": 1
    }
   },
   "pt": {
    "Fabled Hero": [
     6,
     6
    ]
   }
  }
 },
 {
  "name": "a spell targeting another creature does not trigger heroic",
  "players": [
   {
    "hand": [
     "Giant Growth"
    ],
    "battlefield": [
     "Forest",
     "Fabled Hero",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Giant Growth",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {}
   ],
   "pt": {
    "Fabled Hero": [
     2,
     2
    ]
   }
  }
 },
 {
  "name": "ruling: the heroic trigger resolves before the spell that caused it",
  "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Fabled Hero"] }, {} ],
  "steps": [ { "cast": "Giant Growth", "targets": ["Fabled Hero"] }, { "pass": true }, { "pass": true } ],
  "expect": {
   "players": [ {}, {} ],
   "stack_empty": false,
   "counters": { "Fabled Hero": { "p1p1": 1 } },
   "pt": { "Fabled Hero": [3, 3] }
  }
 },
 {
  "name": "ruling: a copy of a spell created on the stack does not trigger heroic",
  "players": [ { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Forest", "Island", "Island", "Fabled Hero"] }, {} ],
  "steps": [
   { "cast": "Giant Growth", "targets": ["Fabled Hero"] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "cast": "Twincast", "targets": [ { "stack": "Giant Growth" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ {}, {} ],
   "counters": { "Fabled Hero": { "p1p1": 1 } },
   "pt": { "Fabled Hero": [9, 9] }
  }
 }
]