[
  {
    "name": "bounces a nonland permanent; no surveil without a Desert",
    "players": [
      { "hand": ["Failed Fording"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Failed Fording", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Failed Fording"] },
        { "hand": ["Grizzly Bears"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "cannot target a land",
    "players": [
      { "hand": ["Failed Fording"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "cast": "Failed Fording", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Failed Fording"] }, {} ]
    }
  },
  {
    "name": "with a Desert the controller surveils 1",
    "players": [
      { "hand": ["Failed Fording"], "battlefield": ["Island", "Island", "Desert"], "library": ["Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Failed Fording", "targets": ["Grizzly Bears"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Desert"] },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: target gone in response: Failed Fording does not resolve, no surveil",
    "players": [
      { "hand": ["Failed Fording"], "battlefield": ["Island", "Island", "Desert"], "library": ["Forest", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Failed Fording", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_top": ["Forest", "Forest"], "graveyard_has": ["Failed Fording"] },
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  }
]
