[
  { "name": "enters tapped",
    "players": [ { "hand": ["Arctic Treeline"] }, {} ],
    "steps": [ { "play_land": "Arctic Treeline" } ],
    "expect": { "tapped": { "Arctic Treeline": true } } },
  { "name": "taps for green or white (pays {1}{G} for Grizzly Bears)",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Arctic Treeline", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: {S} is paid by one snow mana: Arctic Treeline pumps Boreal Centaur",
    "players": [ { "battlefield": ["Boreal Centaur", "Arctic Treeline"] }, {} ],
    "steps": [ { "activate": "Boreal Centaur" }, { "resolve": true } ],
    "expect": { "pt": { "Boreal Centaur": [3, 3] } } },
  { "name": "ruling: {S} cannot be paid with non-snow mana: a basic Forest cannot pump Boreal Centaur",
    "players": [ { "battlefield": ["Boreal Centaur", "Forest"] }, {} ],
    "steps": [ { "activate": "Boreal Centaur", "illegal": true } ],
    "expect": { "pt": { "Boreal Centaur": [2, 2] } } },
  { "name": "ruling: a colorless snow source (Mouth of Ronom) also pays {S}",
    "players": [ { "battlefield": ["Boreal Centaur", "Mouth of Ronom"] }, {} ],
    "steps": [ { "activate": "Boreal Centaur" }, { "resolve": true } ],
    "expect": { "pt": { "Boreal Centaur": [3, 3] } } },
  { "name": "ruling: a snow spell cast with no snow mana still resolves; its snow effect does nothing",
    "players": [ { "hand": ["Blessing of Frost"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Blessing of Frost" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Blessing of Frost"], "hand_count": 0 }, {} ] } }
]
