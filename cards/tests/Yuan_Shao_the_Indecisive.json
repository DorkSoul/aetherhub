[
 { "name": "a creature can't be blocked by more than one creature",
   "players": [ { "battlefield": ["Yuan Shao, the Indecisive", "Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Goblin Piker"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" }, { "blocker": "Goblin Piker", "attacker": "Hill Giant" } ], "illegal": true },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Goblin Piker"] } ] } },
 { "name": "horsemanship: a non-horsemanship creature can't block Yuan Shao",
   "players": [ { "battlefield": ["Yuan Shao, the Indecisive"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Yuan Shao, the Indecisive", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Yuan Shao, the Indecisive" } ], "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Yuan Shao, the Indecisive"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "MaxBlockers: a double block by Grizzly Bears and Llanowar Elves counts only one blocker, so the 3/3 Hill Giant survives",
   "players": [ { "battlefield": ["Yuan Shao, the Indecisive", "Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" }, { "blocker": "Llanowar Elves", "attacker": "Hill Giant" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, {} ] } },
 { "name": "without Yuan Shao the same double block kills Hill Giant",
   "players": [ { "battlefield": ["Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" }, { "blocker": "Llanowar Elves", "attacker": "Hill Giant" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard_has": ["Hill Giant"] }, {} ] } },
 { "name": "ruling: a flying creature without horsemanship can't block Yuan Shao",
   "players": [ { "battlefield": ["Yuan Shao, the Indecisive"] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "attack": [ { "card": "Yuan Shao, the Indecisive", "at": "p1" } ] },
              { "block": [ { "blocker": "Serra Angel", "attacker": "Yuan Shao, the Indecisive" } ], "illegal": true },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Yuan Shao, the Indecisive"] }, { "life": 18, "battlefield_has": ["Serra Angel"] } ] } }
]
