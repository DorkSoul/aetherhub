 { "name": "a 4/4 survives as a 1/1 until end of turn; a 3/3 dies",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Serra Angel", "Hill Giant"] }, { "battlefield": ["Elvish Dreadlord"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Elvish Dreadlord"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Serra Angel"], "graveyard_has": ["Hill Giant"] }, {} ], "pt": { "Serra Angel": [1, 1] } } },
 { "name": "encore {5}{B}{B} from the graveyard: a hasty token copy enters",
   "players": [ { "graveyard": ["Elvish Dreadlord"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "activate": "Elvish Dreadlord", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Elvish Dreadlord"], "battlefield_has": ["Elvish Dreadlord"] }, {} ] } },
 { "name": "encore needs seven mana: with six lands it is illegal",
   "players": [ { "graveyard": ["Elvish Dreadlord"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "activate": "Elvish Dreadlord", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Elvish Dreadlord"] }, {} ] } },
 { "name": "ruling: a non-Elf creature that enters after the death trigger is not affected",
   "players": [ { "hand": ["Lightning Bolt", "Grizzly Bears"], "battlefield": ["Mountain", "Forest", "Forest", "Serra Angel"] }, { "battlefield": ["Elvish Dreadlord"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Elvish Dreadlord"] }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "graveyard_has": ["Elvish Dreadlord"] } ],
               "pt": { "Grizzly Bears": [2, 2] } } },
 { "name": "ruling: an encore token is a copy of the printed card only, not of counters the Dreadlord had on the battlefield",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": [{ "name": "Elvish Dreadlord", "counters": { "p1p1": 1 } }, "Mountain", "Mountain", "Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Elvish Dreadlord"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Elvish Dreadlord"] }, { "resolve": true }, { "activate": "Elvish Dreadlord", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Elvish Dreadlord"], "battlefield_has": ["Elvish Dreadlord"] }, {} ], "pt": { "Elvish Dreadlord": [3, 3] } } }
