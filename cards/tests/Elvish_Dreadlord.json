   "steps": [ { "cast": "Lightning Bolt", "targets": ["Elvish Dreadlord"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Llanowar Elves"], "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Elvish Dreadlord"] } ],
