[
  {
    "name": "enchanted permanent has hexproof",
    "players": [
      { "hand": ["Curator's Ward"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Curator's Ward", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Curator's Ward", "Grizzly Bears"] }, {} ],
      "keywords": { "Grizzly Bears": ["Hexproof"] }
    }
  },
  {
    "name": "historic permanent leaves the battlefield: you draw two",
    "players": [
      { "hand": ["Curator's Ward"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Clue"] },
      {}
    ],
    "steps": [
      { "cast": "Curator's Ward", "targets": ["Clue"] },
      { "resolve": true },
      { "activate": "Clue" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Clue"], "hand_count": 3 }, {} ]
    }
  },
  {
    "name": "ruling: the enchanted permanent's controller can still target it: the opponent's own Terror kills the hexproof bears",
    "players": [
      { "hand": ["Curator's Ward"], "battlefield": ["Island", "Island", "Island"] },
      { "hand": ["Terror"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Curator's Ward", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Terror", "Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: the Ward's controller cannot target the enchanted permanent: their Terror is illegal against the opponent's bears",
    "players": [
      { "hand": ["Curator's Ward", "Terror"], "battlefield": ["Island", "Island", "Island", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Curator's Ward", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Terror", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Grizzly Bears"], "hand": ["Terror"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: when a historic permanent the opponent controls leaves, the Ward's controller draws two (not its controller)",
    "players": [
      { "hand": ["Curator's Ward"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Clue", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Curator's Ward", "targets": ["Clue"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Clue", "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 2 }, { "hand_count": 1, "battlefield_lacks": ["Clue"] } ]
    }
  }
]
