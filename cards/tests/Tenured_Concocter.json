[
  {
    "name": "an opponent's spell targets it: you may draw a card",
    "players": [
      { "battlefield": ["Mountain", "Tenured Concocter"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Tenured Concocter"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "battlefield_has": ["Tenured Concocter"] },
        { "graveyard": ["Shock"] }
      ],
      "pt": { "Tenured Concocter": [4, 5] }
    }
  },
  {
    "name": "declining the draw",
    "players": [
      { "battlefield": ["Mountain", "Tenured Concocter"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Tenured Concocter"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [{ "hand_count": 0 }, { "graveyard": ["Shock"] }]
    }
  },
  {
    "name": "infusion: after you gain life this turn it gets +2/+0",
    "players": [
      { "hand": ["Swords to Plowshares"], "battlefield": ["Plains", "Tenured Concocter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Swords to Plowshares", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 22, "battlefield_lacks": ["Grizzly Bears"] }, {}],
      "pt": { "Tenured Concocter": [6, 5] }
    }
  },
  {
    "name": "ruling: the draw still happens after the targeting spell is countered",
    "players": [
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Tenured Concocter"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Tenured Concocter"] },
      { "cast": "Counterspell", "targets": [ { "stack": "Shock" } ] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "battlefield_has": ["Tenured Concocter"] },
        { "graveyard": ["Shock"] }
      ]
    }
  }
]
