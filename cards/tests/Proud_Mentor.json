[
  {
    "name": "tap ability taps a creature",
    "players": [
      { "battlefield": ["Plains", "Proud Mentor"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Proud Mentor", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Proud Mentor"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "tapped": { "Grizzly Bears": true, "Proud Mentor": true }
    }
  },
  {
    "name": "partner search finds nothing without Impetuous Protege",
    "players": [
      { "hand": ["Proud Mentor"], "battlefield": ["Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Proud Mentor" },
      { "resolve": true, "targets": ["p0"] }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "battlefield_has": ["Proud Mentor"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the target player (here the opponent) searches their own library for Impetuous Protege",
    "players": [
      { "hand": ["Proud Mentor"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "library": ["Impetuous Protege"] }
    ],
    "steps": [
      { "cast": "Proud Mentor" },
      { "resolve": true, "targets": ["p1"], "answers": ["Impetuous Protege"] }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "battlefield_has": ["Proud Mentor"] },
        { "hand": ["Impetuous Protege"] }
      ]
    }
  }
]
