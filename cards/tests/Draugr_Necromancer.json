[
  { "name": "an opponent's nontoken creature that would die is exiled instead",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Draugr Necromancer", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "exile": ["Grizzly Bears"], "graveyard": [] } ] } },
  { "name": "your own creature still dies",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Draugr Necromancer", "Grizzly Bears", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, {} ] } },
  { "name": "cast the exiled card paying coloured mana with snow mana of another color",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Draugr Necromancer", "Mountain", "Snow-Covered Swamp", "Snow-Covered Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "exile": [] } ] } },
  { "name": "nonsnow mana can't pay a coloured symbol of the wrong color",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Draugr Necromancer", "Mountain", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a card exiled with an ice counter (not by this Necromancer) can be cast; casting is still sorcery speed for a creature",
    "players": [ { "battlefield": ["Draugr Necromancer", "Forest", "Forest"] }, { "exile": [ { "name": "Grizzly Bears", "counters": { "ice": 1 } } ] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 },
               { "cast": "Grizzly Bears", "illegal": true },
               { "advance_to": "Main1" }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "exile": [] } ] } },
  { "name": "ruling: a land exiled with an ice counter can't be played from exile",
    "players": [ { "battlefield": ["Draugr Necromancer"] }, { "exile": [ { "name": "Forest", "counters": { "ice": 1 } } ] } ],
    "steps": [ { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ {}, { "exile": ["Forest"] } ] } },
  { "name": "ruling: a creature you own but an opponent controls, exiled when it dies, can't be cast by you",
    "players": [ { "battlefield": ["Draugr Necromancer", "Forest", "Forest", "Grizzly Bears"] },
                 { "hand": ["Control Magic", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Mountain"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" },
               { "cast": "Control Magic", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "advance_to": "Main1" }, { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"] }, {} ] } }
]
