[
  {
    "name": "unpaid squad: enters as a 1/2 and draws a card",
    "players": [ { "hand": ["Sicarian Infiltrator"], "battlefield": ["Island", "Island", "Island"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Sicarian Infiltrator" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sicarian Infiltrator"], "hand": ["Island"] }, {} ], "pt": { "Sicarian Infiltrator": [1, 2] } }
  },
  {
    "name": "squad paid once: two Infiltrators enter and each draws a card",
    "players": [ { "hand": ["Sicarian Infiltrator"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Sicarian Infiltrator", "answers": [1] }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sicarian Infiltrator", "Sicarian Infiltrator"], "hand": ["Island", "Island"] }, {} ] }
  },
  {
    "name": "squad paid twice: three Infiltrators enter and each draws a card",
    "players": [ { "hand": ["Sicarian Infiltrator"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Sicarian Infiltrator", "answers": [2] }, { "resolve": true }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sicarian Infiltrator", "Sicarian Infiltrator", "Sicarian Infiltrator"], "hand": ["Island", "Island", "Island"] }, {} ] }
