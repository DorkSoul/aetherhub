  {
    "name": "ruling: countering the spell means no squad tokens and no draws",
    "players": [
      { "hand": ["Sicarian Infiltrator"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Sicarian Infiltrator", "answers": [1] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Sicarian Infiltrator" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "battlefield_lacks": ["Sicarian Infiltrator"], "library_top": ["Island"] },
        { "graveyard_has": ["Counterspell"] }
      ]
    }
