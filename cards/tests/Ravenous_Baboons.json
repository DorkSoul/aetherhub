[
 { "name": "ETB destroys an opponent's nonbasic land",
   "players": [ { "hand": ["Ravenous Baboons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Ravaged Highlands"] } ],
   "steps": [ { "cast": "Ravenous Baboons" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ravenous Baboons"] }, { "graveyard": ["Ravaged Highlands"] } ] } },
