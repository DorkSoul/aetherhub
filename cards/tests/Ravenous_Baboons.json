   "players": [ { "hand": ["Ravenous Baboons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest"] } ],
   "steps": [ { "cast": "Ravenous Baboons" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ravenous Baboons"] }, { "battlefield_has": ["Forest"] } ] } },
 { "name": "ruling: with no nonbasic land anywhere the ETB does nothing and nothing goes on the stack",
   "players": [ { "hand": ["Ravenous Baboons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Ravenous Baboons" }, { "resolve": true } ],
   "expect": { "stack_empty": true, "players": [ { "battlefield_has": ["Ravenous Baboons", "Mountain"] }, {} ] } },
 { "name": "ruling: with no opposing nonbasic land, the controller must destroy their own nonbasic land",
   "players": [ { "hand": ["Ravenous Baboons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Ravaged Highlands"] }, {} ],
   "steps": [ { "cast": "Ravenous Baboons" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ravenous Baboons"], "graveyard": ["Ravaged Highlands"] }, {} ] } }
