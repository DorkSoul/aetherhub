[
 {
  "name": "look at an opponent's face-down creature",
  "players": [
   {
    "battlefield": [
     "Smoke Teller",
     "Island",
     "Forest"
    ]
   },
   {
    "battlefield": [
     {
      "name": "Grizzly Bears",
      "face_down": true
     }
    ]
   }
  ],
  "steps": [
   {
    "activate": "Smoke Teller",
    "targets": [
     "p1:Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Island": true,
    "Forest": true
   },
   "players": [
    {
     "battlefield_has": [
      "Smoke Teller"
     ]
    },
    {
     "battlefield_has": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "look at your own face-down creature",
  "players": [
   {
    "battlefield": [
     "Smoke Teller",
     "Island",
     "Forest",
     {
      "name": "Grizzly Bears",
      "face_down": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Smoke Teller",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Island": true,
    "Forest": true
   }
  }
 },
 {
  "name": "no face-down creature to target",
  "players": [
   {
    "battlefield": [
     "Smoke Teller",
     "Island",
     "Forest"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Smoke Teller",
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Island": false,
    "Forest": false
   }
  }
 },
 {
  "name": "a face-up creature is not a legal target even with a face-down one around",
  "players": [
   {
    "battlefield": [
     "Smoke Teller",
     "Island",
     "Forest"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Smoke Teller",
    "targets": [
     "Hill Giant"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Island": false
   }
  }
 },
 {
  "name": "needs blue mana",
  "players": [
   {
    "battlefield": [
     "Smoke Teller",
     "Forest",
     "Forest"
    ]
   },
   {
    "battlefield": [
     {
      "name": "Grizzly Bears",
      "face_down": true
     }
    ]
   }
  ],
  "steps": [
   {
    "activate": "Smoke Teller",
    "targets": [
     "p1:Grizzly Bears"
    ],
    "illegal": true
   }
  ],
  "expect": {
