[
  {
    "name": "attacking with a non-Gnome creature puts a counter and makes one tapped attacking Gnome",
    "players": [
      { "battlefield": ["Anim Pakal, Thousandth Moon", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Anim Pakal, Thousandth Moon", "Grizzly Bears", "Gnome 1-1"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "a second attack adds a counter and creates two Gnomes",
    "players": [
      { "battlefield": [ { "name": "Anim Pakal, Thousandth Moon", "counters": { "P1P1": 1 } }, "Grizzly Bears" ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Anim Pakal, Thousandth Moon", "Grizzly Bears", "Gnome 1-1", "Gnome 1-1"] },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "attacking with only a Gnome does not trigger",
    "players": [
      { "battlefield": ["Anim Pakal, Thousandth Moon", "Gnome 1-1"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Gnome 1-1", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Anim Pakal, Thousandth Moon", "Gnome 1-1"] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "ruling: Gnomes use the counters Anim Pakal had when it last left the battlefield",
    "players": [
      { "battlefield": [ { "name": "Anim Pakal, Thousandth Moon", "counters": { "P1P1": 1 } }, "Grizzly Bears" ] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Anim Pakal, Thousandth Moon"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Anim Pakal, Thousandth Moon"], "battlefield": ["Grizzly Bears", "Gnome 1-1"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: Anim Pakal does not have to attack for its trigger to work",
    "players": [
      { "battlefield": ["Anim Pakal, Thousandth Moon", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Anim Pakal, Thousandth Moon", "Grizzly Bears", "Gnome 1-1"] },
        { "life": 17 }
      ],
      "counters": { "Anim Pakal, Thousandth Moon": { "P1P1": 1 } }
    }
  }
]
