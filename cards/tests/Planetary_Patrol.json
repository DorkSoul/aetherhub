[
  {
    "name": "landfall: a land entering gives +1/+1 until end of turn",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Planetary Patrol"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Planetary Patrol": [3, 3] }
    }
  },
  {
    "name": "the bonus is gone on the next turn",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Planetary Patrol"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "pt": { "Planetary Patrol": [2, 2] }
    }
  },
  {
    "name": "a nonland permanent entering does not trigger landfall",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Mountain", "Forest", "Planetary Patrol"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Planetary Patrol": [2, 2] }
    }
  }
]
