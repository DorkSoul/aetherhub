[
  {
    "name": "a land entering puts four charge counters on the Enterprise (landfall)",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Starship Enterprise"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Starship Enterprise": { "charge": 4 } }
    }
  },
  {
    "name": "16 charge counters: a flying 4/6 creature that draws 4 cards on combat damage to a player",
    "players": [
      { "battlefield": [{ "name": "Starship Enterprise", "counters": { "charge": 16 } }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Starship Enterprise", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "hand_count": 4 }, { "life": 16 }]
    }
  },
  {
    "name": "with 15 charge counters the Enterprise is not a creature and cannot attack",
    "players": [
      { "battlefield": [{ "name": "Starship Enterprise", "counters": { "charge": 15 } }] },
      {}
    ],
    "steps": [
      { "illegal": true, "attack": [{ "card": "Starship Enterprise", "at": "p1" }] }
    ],
    "expect": {
      "counters": { "Starship Enterprise": { "charge": 15 } }
    }
  },
  {
    "name": "station taps another creature and adds charge counters equal to its power",
    "players": [
      { "battlefield": ["Starship Enterprise", "Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Starship Enterprise" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Starship Enterprise": false },
      "counters": { "Starship Enterprise": { "charge": 2 } }
    }
  }
]
