[
  {
    "name": "B, T: becomes an Aura attached to target creature, which gains fear",
    "players": [
      { "battlefield": ["Corrupting Licid", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Corrupting Licid", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Corrupting Licid"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "attached": { "Corrupting Licid": "Grizzly Bears" },
      "tapped": { "Corrupting Licid": true },
      "keywords": { "Grizzly Bears": ["Fear"] }
    }
  },
  {
    "name": "paying B ends the effect and the creature is no longer enchanted",
    "players": [
      { "battlefield": ["Corrupting Licid", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Corrupting Licid", "ability": 0 },
      { "resolve": true },
      { "activate": "Corrupting Licid", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Corrupting Licid"], "battlefield_lacks": ["Grizzly Bears"] },
        { "battlefield": ["Grizzly Bears"] }
      ],
      "attached": {}
    }
  },
  {
    "name": "can't activate without a black mana",
    "players": [
      { "battlefield": ["Corrupting Licid", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Corrupting Licid", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Corrupting Licid", "Island", "Island"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: Disenchant cast at the Licid after it became an Aura fizzles once its controller pays B to end the effect",
    "players": [
      { "battlefield": ["Corrupting Licid", "Swamp", "Swamp"] },
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Corrupting Licid", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Corrupting Licid"] },
      { "pass": true, "player": 1 },
      { "activate": "Corrupting Licid", "ability": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Corrupting Licid"] },
        { "graveyard": ["Disenchant"], "battlefield_has": ["Grizzly Bears"] }
      ],
      "attached": {}
    }
  }
]
