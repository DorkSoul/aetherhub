[
 { "name": "the named permanent's non-mana activated ability can't be activated",
   "players": [ { "hand": ["Pithing Needle"], "battlefield": ["Plains", "Plains", "Plains", "Bonesplitter", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Pithing Needle" }, { "resolve": true, "answers": ["Bonesplitter"] }, { "activate": "Bonesplitter", "ability": 0, "illegal": true } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] }, "attached": {} } },
 { "name": "a different chosen name does not stop the equip ability",
   "players": [ { "hand": ["Pithing Needle"], "battlefield": ["Plains", "Plains", "Plains", "Bonesplitter", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Pithing Needle" }, { "resolve": true, "answers": ["Grizzly Bears"] }, { "activate": "Bonesplitter", "ability": 0 }, { "resolve": true } ],
   "expect": { "pt": { "Grizzly Bears": [4, 2] }, "attached": { "Bonesplitter": "Grizzly Bears" } } }
,
 { "name": "ruling: a named Wasteland keeps its mana ability but its sacrifice ability can't be activated",
   "players": [ { "hand": ["Pithing Needle"], "battlefield": ["Plains", "Plains", "Wasteland"] }, { "battlefield": ["Wasteland"] } ],
   "steps": [ { "cast": "Pithing Needle" }, { "resolve": true, "answers": ["Wasteland"] }, { "activate": "Wasteland", "ability": 0, "targets": ["p1:Wasteland"], "illegal": true }, { "tap_for_mana": "Wasteland" } ],
   "expect": { "players": [ { "pool": { "C": 1 }, "battlefield_has": ["Wasteland"] }, { "battlefield_has": ["Wasteland"] } ] } },
 { "name": "ruling: a named Eternal Dragon in hand can't be cycled (plainscycling is an activated ability)",
   "players": [ { "hand": ["Pithing Needle", "Eternal Dragon"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Pithing Needle" }, { "resolve": true, "answers": ["Eternal Dragon"] }, { "activate": "Eternal Dragon", "ability": 1, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Eternal Dragon"] }, {} ] } },
 { "name": "ruling: control - naming another card, Eternal Dragon in hand can be cycled",
   "players": [ { "hand": ["Pithing Needle", "Eternal Dragon"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Plains"] }, {} ],
   "steps": [ { "cast": "Pithing Needle" }, { "resolve": true, "answers": ["Forest"] }, { "activate": "Eternal Dragon", "ability": 1 }, { "resolve": true, "answers": ["Plains"] } ],
   "expect": { "players": [ { "graveyard_has": ["Eternal Dragon"], "hand": ["Plains"] }, {} ] } },
 { "name": "ruling: once Pithing Needle leaves the battlefield, the named Bonesplitter's equip works again",
   "players": [ { "hand": ["Pithing Needle"], "battlefield": ["Plains", "Plains", "Plains", "Bonesplitter", "Grizzly Bears"] }, { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] } ],
   "steps": [ { "cast": "Pithing Needle" }, { "resolve": true, "answers": ["Bonesplitter"] }, { "pass": true }, { "cast": "Shatter", "player": 1, "targets": ["Pithing Needle"] }, { "resolve": true }, { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Pithing Needle"] }, {} ], "pt": { "Grizzly Bears": [4, 2] }, "attached": { "Bonesplitter": "Grizzly Bears" } } },
 { "name": "ruling: a named Tanuki Transplanter still gets its attack trigger (only activated abilities are stopped)",
   "players": [ { "hand": ["Pithing Needle"], "battlefield": ["Plains", "Plains", { "name": "Tanuki Transplanter", "sick": false }] }, {} ],
   "steps": [ { "cast": "Pithing Needle" }, { "resolve": true, "answers": ["Tanuki Transplanter"] }, { "attack": [ { "card": "Tanuki Transplanter", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "players": [ { "pool": { "G": 2 } }, {} ] } }
]
