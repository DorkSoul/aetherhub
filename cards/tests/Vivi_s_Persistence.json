    { "graveyard_has": ["Vivi's Persistence"], "battlefield_has": ["Grizzly Bears"] },
    {}
   ]
  }
 },
 {
  "name": "commander attacks, pay {2}: Vivi's Persistence returns to hand",
  "commander": true,
  "players": [
   {
    "command": ["Savannah Lions"],
    "battlefield": ["Plains", "Plains", "Plains"],
    "graveyard": ["Vivi's Persistence"]
   },
   {}
  ],
  "steps": [
   { "cast": "Savannah Lions" },
   { "resolve": true, "answers": [false] },
