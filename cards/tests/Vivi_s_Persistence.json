   { "resolve": true, "answers": [false] }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Vivi's Persistence"], "battlefield_has": ["Savannah Lions"] },
    {}
   ]
  }
 },
 {
  "name": "a non-commander creature entering does not trigger it",
  "players": [
   {
    "battlefield": ["Forest", "Forest"],
    "hand": ["Grizzly Bears"],
    "graveyard": ["Vivi's Persistence"]
   },
   {}
  ],
  "steps": [
