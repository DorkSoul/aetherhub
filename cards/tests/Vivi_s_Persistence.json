[
 {
  "name": "instant: create a 0/1 black Wizard token",
  "players": [
   {
    "battlefield": ["Mountain", "Island"],
    "hand": ["Vivi's Persistence"]
   },
   {}
  ],
  "steps": [
   { "cast": "Vivi's Persistence" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Wizard 0-1"] },
    {}
   ]
  }
 },
 {
  "name": "your commander enters, pay {2}: return Vivi's Persistence from the graveyard to hand",
  "commander": true,
  "players": [
   {
    "command": ["Savannah Lions"],
    "battlefield": ["Plains", "Plains", "Plains"],
    "graveyard": ["Vivi's Persistence"]
   },
   {}
  ],
  "steps": [
   { "cast": "Savannah Lions" },
