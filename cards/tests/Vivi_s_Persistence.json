   { "advance_to": "Main1" },
   { "attack": [ { "card": "Savannah Lions", "at": "p1" } ] },
   { "resolve": true, "answers": [true] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
