 {
  "name": "ruling: the Wizard's trigger resolves before the Bolt and still deals 1 when the Bolt is countered",
  "players": [
   { "hand": ["Vivi's Persistence", "Lightning Bolt"], "battlefield": ["Mountain", "Island", "Mountain"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Vivi's Persistence" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Wizard 0-1"], "graveyard_has": ["Lightning Bolt"] },
    { "life": 19, "graveyard_has": ["Counterspell"] }
   ]
  }
 }
]
