 {
  "name": "commander attacks, decline to pay: Vivi's Persistence stays in the graveyard",
  "commander": true,
  "players": [
   {
    "command": ["Savannah Lions"],
    "battlefield": ["Plains", "Plains", "Plains"],
    "graveyard": ["Vivi's Persistence"]
   },
   {}
  ],
  "steps": [
   { "cast": "Savannah Lions" },
   { "resolve": true, "answers": [false] },
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "attack": [ { "card": "Savannah Lions", "at": "p1" } ] },
   { "resolve": true, "answers": [false] },
   { "block": [] },
   { "advance_to": "Main2" }
