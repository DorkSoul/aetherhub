   "steps": [ { "cast": "Messenger Jays" }, { "resolve": true, "answers": [0, 1, "Lightning Bolt"] }, { "cast": "Messenger Jays" }, { "resolve": true, "answers": [0, 0] } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 18 } ] } },
 { "name": "ruling 2: an opponent with an extra vote loses 2 life once for the unchosen choice",
