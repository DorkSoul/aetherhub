[
  {
    "name": "ruling: training counter still comes if the other attacker is destroyed in response",
    "players": [ { "battlefield": ["Gryff Rider", "Hill Giant"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "attack": [ { "card": "Gryff Rider", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Hill Giant"], "battlefield_has": ["Gryff Rider"] }, {} ],
      "counters": { "Gryff Rider": { "p1p1": 1 } }
    }
  },
  {
    "name": "flying 2/1 with flying keyword",
    "players": [ { "battlefield": ["Gryff Rider"] }, {} ],
    "steps": [],
    "expect": { "pt": { "Gryff Rider": [2, 1] }, "keywords": { "Gryff Rider": ["Flying"] } }
  },
  {
    "name": "training puts a +1/+1 counter when attacking with a greater-power creature",
    "players": [ { "battlefield": ["Gryff Rider", "Hill Giant"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Gryff Rider", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "counters": { "Gryff Rider": { "p1p1": 1 } } }
  },
  {
    "name": "no training counter with an equal-power attacker",
    "players": [ { "battlefield": ["Gryff Rider", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Gryff Rider", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Gryff Rider": [2, 1] } }
  }
]
