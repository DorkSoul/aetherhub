[
  {
    "name": "normal sorcery-speed cast: each opposing creature gets a Cursed Role (controlled by caster) and becomes 1/1",
    "players": [
      { "hand": ["Asinine Antics"], "battlefield": ["Island", "Island", "Plains", "Plains", "Savannah Lions"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Asinine Antics" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Asinine Antics"], "battlefield_has": ["Savannah Lions", "Cursed Role"] },
        { "battlefield_has": ["Grizzly Bears", "Hill Giant"], "battlefield_lacks": ["Cursed Role"] }
      ],
      "pt": { "Grizzly Bears": [1, 1], "Hill Giant": [1, 1], "Savannah Lions": [2, 1] }
    }
  },
  {
    "name": "flash: the {4}{U}{U} alternative cost casts it on the opponent's turn, Role on the opposing creature",
    "players": [
      { "hand": ["Asinine Antics"], "battlefield": ["Island", "Island", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Asinine Antics", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Asinine Antics"], "battlefield_has": ["Cursed Role"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "pt": { "Grizzly Bears": [1, 1] }
    }
  },
  {
    "name": "boundary: without the extra {2} it is a sorcery and can't be cast on the opponent's turn",
    "players": [
      { "hand": ["Asinine Antics"], "battlefield": ["Island", "Island", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Asinine Antics", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Asinine Antics"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "boundary: the flash alternative cost needs six mana",
    "players": [
      { "hand": ["Asinine Antics"], "battlefield": ["Island", "Island", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Asinine Antics", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Asinine Antics"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: the Role is not a targeting ability, so a hexproof creature still gets it",
    "players": [
      { "hand": ["Asinine Antics"], "battlefield": ["Island", "Island", "Plains", "Plains"] },
      { "battlefield": ["Slippery Bogle"] }
    ],
    "steps": [ { "cast": "Asinine Antics" }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": ["Asinine Antics"], "battlefield_has": ["Cursed Role"] }, { "battlefield_has": ["Slippery Bogle"] } ],
      "attached": { "Cursed Role": "Slippery Bogle" }
    }
  },
  {
    "name": "ruling: a second Role from the same player replaces the first (only the newest stays)",
    "players": [
      { "hand": ["Asinine Antics", "Asinine Antics"], "battlefield": ["Island", "Island", "Island", "Island", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Asinine Antics" }, { "resolve": true }, { "cast": "Asinine Antics" }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": ["Asinine Antics", "Asinine Antics"], "battlefield": ["Island", "Island", "Island", "Island", "Plains", "Plains", "Plains", "Plains", "Cursed Role"] }, {} ],
      "pt": { "Grizzly Bears": [1, 1] }
    }
  }
]
