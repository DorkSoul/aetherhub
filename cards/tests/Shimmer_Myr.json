[
  {
    "name": "artifact spell can be cast with flash timing",
    "players": [
      { "hand": ["Arcane Signet"], "battlefield": ["Shimmer Myr", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Arcane Signet" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Arcane Signet", "Shimmer Myr"], "hand": [] },
        {}
      ]
    }
  },
  {
    "name": "artifact flash needs Shimmer Myr on the battlefield",
    "players": [
      { "hand": ["Arcane Signet"], "battlefield": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Arcane Signet", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Arcane Signet"] },
        {}
      ]
    }
  },
  {
    "name": "non-artifact spells do not gain flash",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Shimmer Myr", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: once cast, removing Shimmer Myr in response does not stop the artifact spell",
    "players": [
      { "hand": ["Arcane Signet"], "battlefield": ["Shimmer Myr", "Forest", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Arcane Signet" },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Shimmer Myr"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Arcane Signet"], "battlefield_lacks": ["Shimmer Myr"], "graveyard_has": ["Shimmer Myr"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]
