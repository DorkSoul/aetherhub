[
  {
    "name": "adds a counter, doubles the counters, gains life equal to the total",
    "players": [
      { "hand": ["Study the Classics"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Study the Classics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "players": [
        { "graveyard": ["Study the Classics"], "life": 22 },
        {}
      ]
    }
  },
  {
    "name": "an existing counter is doubled too",
    "players": [
      { "hand": ["Study the Classics"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Study the Classics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "players": [
        { "life": 22 },
        {}
      ]
    }
  },
  {
    "name": "ruling: doubling uses the counters already there (second cast doubles 2 to 6)",
    "players": [
      { "hand": ["Study the Classics", "Study the Classics"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Study the Classics", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Study the Classics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [8, 8] },
      "counters": { "Grizzly Bears": { "p1p1": 6 } },
      "players": [
        { "life": 28 },
        {}
      ]
    }
  }
]
