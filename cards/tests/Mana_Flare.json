[
  {
    "name": "a Forest tapped for mana adds an additional G for its controller",
    "players": [
      { "battlefield": ["Mana Flare", "Forest"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Forest" }
    ],
    "expect": {
      "players": [
        { "pool": { "G": 2 } },
        {}
      ]
    }
  },
  {
    "name": "an opponent who taps their own Mountain also gets the additional R",
    "players": [
      { "battlefield": ["Mana Flare"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "tap_for_mana": "Mountain", "player": 1 }
    ],
    "expect": {
      "players": [
        {},
        { "pool": { "R": 2 } }
      ]
    }
  },
  {
    "name": "a creature mana source does not trigger it",
    "players": [
      { "battlefield": ["Mana Flare", { "name": "Llanowar Elves", "sick": false }] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Llanowar Elves" }
    ],
    "expect": {
      "players": [
        { "pool": { "G": 1 } },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Wastes tapped for colorless adds one more colorless from Mana Flare",
    "players": [ { "battlefield": ["Mana Flare", "Wastes"] }, {} ],
    "steps": [ { "tap_for_mana": "Wastes" } ],
    "expect": { "players": [ { "pool": { "C": 2 } }, {} ] }
  },
  {
    "name": "ruling: a Lotus Field tapped for three of one colour adds one extra mana of that colour only (4 total)",
    "players": [ { "battlefield": ["Mana Flare", "Lotus Field"] }, {} ],
    "steps": [ { "tap_for_mana": "Lotus Field", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 4 } }, {} ] }
  }
]
