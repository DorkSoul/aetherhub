      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "cast": "Assert Authority", "targets": [{ "stack": "Lightning Bolt" }] }
    ],
    "expect": {
      "players": [{ "hand_count": 0 }, {}]
    }
  },
  {
    "name": "affinity: two artifacts make the cost {3}{U}{U}, payable with five Islands",
    "players": [
      { "hand": ["Assert Authority"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Ornithopter", "Ornithopter"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "cast": "Assert Authority", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Assert Authority"] }, { "exile": ["Lightning Bolt"] }]
    }
