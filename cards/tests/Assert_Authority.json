[
  {
    "name": "counters a spell and exiles it",
    "players": [
      { "hand": ["Assert Authority"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "cast": "Assert Authority", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Assert Authority"] }, { "exile": ["Lightning Bolt"] }],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "affinity: each artifact you control reduces the cost by {1}",
