[
  { "name": "leaving the battlefield creates an Eldrazi Spawn",
    "players": [ { "hand": [], "battlefield": ["Chittering Dispatcher"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Chittering Dispatcher"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Eldrazi Spawn"], "graveyard": ["Chittering Dispatcher"] }, {} ] } },
  { "name": "no token while it stays on the battlefield",
    "players": [ { "battlefield": ["Chittering Dispatcher"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Chittering Dispatcher"], "battlefield_lacks": ["Eldrazi Spawn"] }, {} ] } },
  { "name": "devoid: the Dispatcher has no colour", "players": [ { "battlefield": ["Chittering Dispatcher"] }, {} ], "steps": [], "expect": { "colors": {"Chittering Dispatcher": []}, "players": [ {}, {} ] } },
  { "name": "ruling: with no opponent other than the defending player, myriad makes no tokens",
    "players": [ { "battlefield": ["Chittering Dispatcher"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Chittering Dispatcher", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield": ["Chittering Dispatcher"] }, { "life": 18 } ] } }
]
