[
  {
    "name": "gains life when the enchanted creature deals combat damage",
    "players": [
      { "hand": ["Soul Link"], "battlefield": ["Plains", "Swamp", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Soul Link", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "battlefield_has": ["Soul Link"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "gains life from both damage events when blocked",
    "players": [
      { "hand": ["Soul Link"], "battlefield": ["Plains", "Swamp", "Plains", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Soul Link", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 25 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: when the enchanted creature damages itself, both abilities trigger",
    "players": [
      { "hand": ["Soul Link"], "battlefield": ["Plains", "Swamp", "Plains", "Psionic Entity"] },
      {}
    ],
    "steps": [
      { "cast": "Soul Link", "targets": ["Psionic Entity"] },
      { "resolve": true },
      { "activate": "Psionic Entity", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 28 },
        { "life": 18 }
      ]
    }
  }
]
