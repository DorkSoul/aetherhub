[
  {
    "name": "instant targeting a creature: each opponent loses 1, you gain 1",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Melancholic Poet", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21 },
        { "life": 19, "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "spell targeting a player does not trigger repartee",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Melancholic Poet", "Mountain"] },
      { }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: repartee still resolves if the spell is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Melancholic Poet", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "graveyard": ["Lightning Bolt"] },
        { "life": 19, "graveyard": ["Counterspell"], "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
