[
  {
    "name": "takes a card with the same name from the opponent's library",
    "players": [
      { "hand": ["Mimeofacture"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Grizzly Bears"] }
    ],
    "steps": [{ "cast": "Mimeofacture", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": ["Grizzly Bears"] }],
    "expect": { "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] }] }
  },
  {
    "name": "no card with the same name: nothing is taken",
    "players": [
      { "hand": ["Mimeofacture"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Mimeofacture", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "players": [{ "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] }] }
  },
  {
    "name": "replicate paid once (8 mana): two copies each search, so two same-named cards are taken",
    "players": [
      { "hand": ["Mimeofacture"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"], "library": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [{ "cast": "Mimeofacture", "targets": ["Grizzly Bears"], "answers": [1] }, { "resolve": true, "answers": ["Grizzly Bears", "Grizzly Bears"] }],
    "expect": { "players": [{ "battlefield_has": ["Grizzly Bears", "Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] }] }
  }
]
