[
  { "name": "a tapped Plains produces mana of the chosen color",
    "players": [ { "battlefield": ["Pulse of Llanowar", "Plains"] }, {} ],
    "steps": [ { "tap_for_mana": "Plains", "color": "R" } ],
    "expect": { "players": [ { "pool": { "R": 1 } }, {} ], "tapped": { "Plains": true } } },
  { "name": "a nonbasic land is unaffected",
    "players": [ { "battlefield": ["Pulse of Llanowar", "Ancient Tomb"] }, {} ],
    "steps": [ { "tap_for_mana": "Ancient Tomb" } ],
    "expect": { "players": [ { "pool": { "C": 2 }, "life": 18 }, {} ] } },
  { "name": "an opponent's basic land is unaffected",
    "players": [ { "battlefield": ["Pulse of Llanowar"] }, { "battlefield": ["Plains"] } ],
    "steps": [ { "pass": true }, { "player": 1, "tap_for_mana": "Plains" } ],
    "expect": { "players": [ {}, { "pool": { "W": 1 } } ] } },
  { "name": "Forest cast: can pay for a spell of another color",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Pulse of Llanowar", "Forest"] }, { } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
  { "name": "ruling: each tapped basic land can produce a different chosen colour",
    "players": [ { "battlefield": ["Pulse of Llanowar", "Plains", "Forest"] }, {} ],
    "steps": [ { "tap_for_mana": "Plains", "color": "R" }, { "tap_for_mana": "Forest", "color": "B" } ],
    "expect": { "players": [ { "pool": { "R": 1, "B": 1 } }, {} ] } }
]
