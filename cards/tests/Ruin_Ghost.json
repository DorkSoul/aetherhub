[
 { "name": "exile target land you control and return it to the battlefield",
   "players": [ { "battlefield": ["Ruin Ghost", "Plains", "Forest"] }, {} ],
   "steps": [ { "activate": "Ruin Ghost", "ability": 0, "targets": ["Forest"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Forest", "Ruin Ghost", "Plains"] }, {} ] } },
