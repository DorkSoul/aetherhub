   "players": [ { "battlefield": ["Ruin Ghost", "Forest"] }, {} ],
   "steps": [ { "activate": "Ruin Ghost", "ability": 0, "targets": ["Forest"], "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ruin Ghost", "Forest"] }, {} ] } },
 { "name": "ruling: the returned land enters untapped, so it can pay for a spell right away",
   "players": [ { "battlefield": ["Ruin Ghost", "Plains", "Forest", "Island"], "hand": ["Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Ruin Ghost", "ability": 0, "targets": ["Forest"] }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Grizzly Bears", "Forest", "Ruin Ghost", "Island", "Plains"] }, {} ] } }
