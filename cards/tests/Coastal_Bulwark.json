 {
  "name": "{2}, {T}: surveil 1 puts the top card in the graveyard",
  "players": [ { "battlefield": [ { "name": "Coastal Bulwark", "sick": false }, "Island", "Island" ], "library": [ "Grizzly Bears", "Forest" ] }, {} ],
  "steps": [ { "activate": "Coastal Bulwark", "ability": 0 }, { "resolve": true, "answers": [ [ "Grizzly Bears" ] ] } ],
  "expect": { "players": [ { "graveyard": [ "Grizzly Bears" ], "library_top": [ "Forest" ] }, {} ], "tapped": { "Coastal Bulwark": true } }
 },
 {
  "name": "{2}, {T}: surveil 1 keeps the top card on top",
  "players": [ { "battlefield": [ { "name": "Coastal Bulwark", "sick": false }, "Island", "Island" ], "library": [ "Grizzly Bears", "Forest" ] }, {} ],
  "steps": [ { "activate": "Coastal Bulwark", "ability": 0 }, { "resolve": true, "answers": [ [] ] } ],
  "expect": { "players": [ { "library_top": [ "Grizzly Bears", "Forest" ] }, {} ] }
 },
 {
  "name": "surveil ability needs {2} as well as tapping",
  "players": [ { "battlefield": [ { "name": "Coastal Bulwark", "sick": false }, "Island" ] }, {} ],
  "steps": [ { "activate": "Coastal Bulwark", "ability": 0, "illegal": true } ],
  "expect": { "players": [ { "battlefield_has": [ "Coastal Bulwark" ] }, {} ] }
 }
]
