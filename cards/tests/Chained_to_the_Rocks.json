[
  {
    "name": "exiles an opposing creature until the aura leaves",
    "players": [
      { "hand": ["Chained to the Rocks"], "battlefield": ["Mountain", "Plains"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Chained to the Rocks", "targets": ["Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chained to the Rocks"] },
        { "exile": ["Hill Giant"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "creature returns when the aura is destroyed",
    "players": [
      { "hand": ["Chained to the Rocks", "Naturalize"], "battlefield": ["Mountain", "Plains", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Chained to the Rocks", "targets": ["Mountain"] },
      { "resolve": true },
      { "cast": "Naturalize", "targets": ["Chained to the Rocks"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Chained to the Rocks", "Naturalize"] },
        { "battlefield": ["Hill Giant"], "exile": [] }
      ]
    }
  },
  {
    "name": "cannot be cast without a Mountain you control",
    "players": [
      { "hand": ["Chained to the Rocks"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Chained to the Rocks", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Plains", "Plains"] },
        { "battlefield": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: if the aura leaves before its trigger resolves, the creature is not exiled",
    "players": [
      { "hand": ["Chained to the Rocks", "Naturalize"], "battlefield": ["Mountain", "Plains", "Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Chained to the Rocks", "targets": ["Mountain"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Naturalize", "targets": ["Chained to the Rocks"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Chained to the Rocks", "Naturalize"] },
        { "battlefield": ["Hill Giant"], "exile": [] }
      ]
    }
  },
  {
    "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard",
    "players": [
      { "hand": ["Chained to the Rocks", "Pacifism"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Pacifism", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Chained to the Rocks", "targets": ["Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Pacifism"], "battlefield_has": ["Chained to the Rocks"] },
        { "exile": ["Hill Giant"], "battlefield": [] }
      ]
    }
  }
]
