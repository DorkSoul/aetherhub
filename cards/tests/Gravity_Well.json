[
  { "name": "a creature with flying loses flying when it attacks",
    "players": [ { "hand": ["Gravity Well"], "battlefield": ["Forest", "Forest", "Forest", "Serra Angel"] }, {} ],
    "steps": [ { "cast": "Gravity Well" }, { "resolve": true }, { "attack": [ { "card": "Serra Angel", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Gravity Well"] }, { "life": 16 } ], "keywords": { "Serra Angel": [] } } },
  { "name": "a creature without flying is unaffected",
    "players": [ { "hand": ["Gravity Well"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Gravity Well" }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Gravity Well"] }, { "life": 18 } ] } },
  { "name": "ruling: the flying loss is in effect at declare blockers, so Grizzly Bears can block the Angel",
    "players": [ { "battlefield": ["Gravity Well", "Serra Angel"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Serra Angel", "at": "p1" } ] }, { "resolve": true }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Serra Angel" } ], "player": 1 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Gravity Well"] }, { "life": 20, "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "control: without Gravity Well the flyer cannot be blocked by Grizzly Bears (damage goes through)",
    "players": [ { "battlefield": ["Serra Angel"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Serra Angel", "at": "p1" } ] }, { "block": [], "player": 1 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: flying granted after the attack trigger resolved is not removed",
    "players": [ { "hand": ["Feather of Flight"], "battlefield": ["Gravity Well", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "cast": "Feather of Flight", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Feather of Flight"] }, { "life": 17 } ], "keywords": { "Grizzly Bears": ["Flying"] } } }
]
