[
  {
    "name": "enters: exile up to one other target creature",
    "players": [
      { "hand": ["Koh, the Face Stealer"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Koh, the Face Stealer" }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
    "expect": { "players": [ { "battlefield_has": ["Koh, the Face Stealer"] }, { "exile": ["Grizzly Bears"], "battlefield": [] } ] }
  },
  {
    "name": "another nontoken creature dying may be exiled",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Koh, the Face Stealer", "sick": false }, "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "exile": ["Grizzly Bears"], "graveyard": [] } ] }
  },
  {
    "name": "declining leaves the creature in the graveyard",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Koh, the Face Stealer", "sick": false }, "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"], "exile": [] } ] }
  },
  {
    "name": "pay 1 life: Koh gains the activated ability of the chosen exiled creature",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Koh, the Face Stealer", "sick": false }, "Mountain"] },
      { "battlefield": ["Prodigal Sorcerer"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Prodigal Sorcerer"] },
      { "resolve": true, "answers": [true] },
      { "activate": "Koh, the Face Stealer", "ability": 0 },
      { "resolve": true },
      { "activate": "Koh, the Face Stealer", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 19 }, { "life": 19, "exile": ["Prodigal Sorcerer"] } ] }
  },
  {
    "name": "without a chosen card Koh has no extra abilities",
    "players": [
      { "battlefield": [{ "name": "Koh, the Face Stealer", "sick": false }] },
      {}
    ],
    "steps": [ { "activate": "Koh, the Face Stealer", "ability": 32768, "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] }
  },
  {
    "name": "Koh gains triggered abilities of the chosen creature too",
    "players": [
      { "hand": ["Lightning Bolt", "Grizzly Bears"], "battlefield": [{ "name": "Koh, the Face Stealer", "sick": false }, "Mountain", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Soul Warden"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Soul Warden"] },
      { "resolve": true, "answers": [true] },
      { "activate": "Koh, the Face Stealer", "ability": 0 },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Grizzly Bears"] }, {} ] }
  }
]
