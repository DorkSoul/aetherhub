[
  { "name": "mode 1 exiles the top two cards of your library",
    "players": [ { "hand": ["Seize Opportunity"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Plains"] }, {} ],
    "steps": [ { "cast": "Seize Opportunity", "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears", "Plains"], "library_count": 20, "graveyard": ["Seize Opportunity"] }, {} ] } },
  { "name": "mode 2 gives up to two target creatures +2/+1",
    "players": [ { "hand": ["Seize Opportunity"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Seize Opportunity", "answers": [1], "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [4, 3], "Hill Giant": [5, 4] } } },
  { "name": "mode 2 with a single target only pumps that creature",
    "players": [ { "hand": ["Seize Opportunity"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Seize Opportunity", "answers": [1], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [4, 3], "Hill Giant": [3, 3] } } },
  { "name": "ruling: an exiled land can't be played during combat (timing rules still apply)",
    "players": [ { "hand": ["Seize Opportunity"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Seize Opportunity", "answers": [0] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "play_land": "Plains", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Plains", "Grizzly Bears"], "battlefield_lacks": ["Plains"] }, {} ] } },
  { "name": "ruling: an exiled land can be played in your main phase with the stack empty",
    "players": [ { "hand": ["Seize Opportunity"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Seize Opportunity", "answers": [0] }, { "resolve": true }, { "advance_to": "Main2" }, { "play_land": "Plains" } ],
    "expect": { "players": [ { "battlefield_has": ["Plains"], "exile": ["Grizzly Bears"] }, {} ] } }
]
