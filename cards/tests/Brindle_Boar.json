[
  { "name": "sacrifice: gain 4 life",
    "players": [ { "battlefield": ["Brindle Boar"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Brindle Boar", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 24, "graveyard_has": ["Brindle Boar"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "can be sacrificed while summoning sick (no tap cost)",
    "players": [ { "battlefield": [ { "name": "Brindle Boar", "sick": true } ] }, {} ],
    "steps": [ { "activate": "Brindle Boar", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 24, "graveyard_has": ["Brindle Boar"] }, {} ] } },
  { "name": "ruling: sacrificed while attacking in the declare attackers step deals no combat damage",
    "players": [ { "battlefield": ["Brindle Boar"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Brindle Boar", "at": "p1" } ] },
      { "activate": "Brindle Boar", "ability": 0 },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 24, "graveyard_has": ["Brindle Boar"] }, { "life": 20 } ] } },
  { "name": "ruling: sacrificed while blocked in the declare blockers step: blocker survives and no combat damage",
    "players": [ { "battlefield": ["Brindle Boar"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Brindle Boar", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Brindle Boar" } ] },
      { "activate": "Brindle Boar", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 24, "graveyard_has": ["Brindle Boar"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } }
]
