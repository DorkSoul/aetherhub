[
  { "name": "tap: target land becomes the chosen basic land type until end of turn",
    "players": [ { "battlefield": ["Sea Snidd", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Sea Snidd", "targets": ["Forest"] }, { "resolve": true, "answers": [[1]] } ],
    "expect": { "players": [ { "battlefield": ["Sea Snidd", "Forest", "Forest"] }, {} ], "tapped": { "Sea Snidd": true } } },
  { "name": "the chosen basic land type gives that mana (Forest becomes an Island)",
    "players": [ { "hand": ["Opt"], "battlefield": ["Sea Snidd", "Forest"] }, {} ],
    "steps": [ { "activate": "Sea Snidd", "targets": ["Forest"] }, { "resolve": true, "answers": [[1]] }, { "cast": "Opt" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Sea Snidd", "Forest"], "graveyard": ["Opt"] }, {} ] } },
  { "name": "without the type change a Forest cannot pay for Opt",
    "players": [ { "hand": ["Opt"], "battlefield": ["Sea Snidd", "Forest"] }, {} ],
    "steps": [ { "cast": "Opt", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Opt"] }, {} ] } },
  { "name": "cannot target a nonland permanent",
    "players": [ { "battlefield": ["Sea Snidd", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Sea Snidd", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield": ["Sea Snidd", "Grizzly Bears"] }, {} ], "tapped": { "Sea Snidd": false } } },
  { "name": "tapped Sea Snidd cannot activate again",
    "players": [ { "battlefield": ["Sea Snidd", "Forest"] }, {} ],
    "steps": [ { "activate": "Sea Snidd", "targets": ["Forest"] }, { "resolve": true, "answers": [[0]] }, { "activate": "Sea Snidd", "targets": ["Forest"], "illegal": true } ],
    "expect": { "players": [ { "battlefield": ["Sea Snidd", "Forest"] }, {} ], "tapped": { "Sea Snidd": true } } }
]
