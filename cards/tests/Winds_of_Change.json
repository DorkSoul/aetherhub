[
  {
    "name": "each player draws as many as they shuffled in",
    "players": [
      {
        "hand": [
          "Winds of Change",
          "Grizzly Bears",
          "Hill Giant"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Shock",
          "Shock",
          "Shock",
          "Shock"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Winds of Change"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2,
          "graveyard": [
            "Winds of Change"
          ],
          "library_count": 0
        },
        {
          "hand_count": 4
        }
      ]
    }
  },
  {
    "name": "empty hands draw nothing",
    "players": [
      {
        "hand": [
          "Winds of Change"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Winds of Change"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "graveyard": [
            "Winds of Change"
          ]
        },
        {
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "hand cards are really shuffled into the library",
    "players": [
      {
        "hand": [
          "Winds of Change",
          "Grizzly Bears"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Shock"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Winds of Change"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "ruling: each player draws a number equal to the cards they shuffled into their own library",
    "players": [
      {
        "hand": [
          "Winds of Change",
          "Grizzly Bears",
          "Hill Giant",
          "Shock"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Shock"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Winds of Change"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3,
          "graveyard": [
            "Winds of Change"
          ]
        },
        {
          "hand_count": 1
        }
      ]
    }
  }
]