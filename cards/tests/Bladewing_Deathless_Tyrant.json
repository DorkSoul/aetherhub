[
  { "name": "combat damage makes a Zombie Knight for each creature card in your graveyard",
    "players": [ { "battlefield": ["Bladewing, Deathless Tyrant"], "graveyard": ["Grizzly Bears", "Serra Angel"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Bladewing, Deathless Tyrant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Zombie Knight", "Zombie Knight"] }, { "life": 14 } ] } },
  { "name": "no creature cards in your graveyard means no tokens",
    "players": [ { "battlefield": ["Bladewing, Deathless Tyrant"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Bladewing, Deathless Tyrant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Bladewing, Deathless Tyrant"] }, { "life": 14 } ] } },
  { "name": "ruling: creature cards dying in the same combat damage step are counted when the trigger resolves",
    "players": [ { "battlefield": ["Bladewing, Deathless Tyrant", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "attack": [ { "card": "Bladewing, Deathless Tyrant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Zombie Knight"], "graveyard": ["Grizzly Bears"] }, { "life": 14, "battlefield_has": ["Hill Giant"] } ] } }
]
