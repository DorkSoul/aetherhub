[
  { "name": "enters with counters equal to the mana spent",
    "players": [ { "hand": ["Marath, Will of the Wild"], "battlefield": ["Mountain", "Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Marath, Will of the Wild" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Marath, Will of the Wild"] }, {} ], "pt": { "Marath, Will of the Wild": [3, 3] } } },
  { "name": "remove X counters to deal X damage to any target",
    "players": [ { "battlefield": [{ "name": "Marath, Will of the Wild", "counters": { "p1p1": 3 } }, "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Marath, Will of the Wild", "ability": 1, "targets": ["p1"], "answers": [2] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 18 } ], "pt": { "Marath, Will of the Wild": [1, 1] } } },
  { "name": "remove X counters to put X counters on a creature",
    "players": [ { "battlefield": [{ "name": "Marath, Will of the Wild", "counters": { "p1p1": 3 } }, "Grizzly Bears", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Marath, Will of the Wild", "ability": 0, "targets": ["Grizzly Bears"], "answers": [2] }, { "resolve": true } ],
    "expect": { "pt": { "Marath, Will of the Wild": [1, 1], "Grizzly Bears": [4, 4] } } },
  { "name": "remove X counters to create an X/X Elemental",
    "players": [ { "battlefield": [{ "name": "Marath, Will of the Wild", "counters": { "p1p1": 3 } }, "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Marath, Will of the Wild", "ability": 2, "answers": [2] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Marath, Will of the Wild", "Elemental 0-0 Green"] }, {} ], "pt": { "Marath, Will of the Wild": [1, 1] } } },
  { "name": "X can't be 0 (no counters, no activation)",
    "players": [ { "battlefield": ["Marath, Will of the Wild", "Grizzly Bears", "Swamp"] }, {} ],
    "steps": [ { "activate": "Marath, Will of the Wild", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: X is paid in mana as well as the counters removed",
    "players": [ { "battlefield": [{ "name": "Marath, Will of the Wild", "counters": { "p1p1": 3 } }, "Grizzly Bears", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Marath, Will of the Wild", "ability": 0, "targets": ["Grizzly Bears"], "answers": [2] }, { "resolve": true } ],
    "expect": { "pt": { "Marath, Will of the Wild": [1, 1], "Grizzly Bears": [4, 4] }, "tapped": { "Swamp": true } } }
]
