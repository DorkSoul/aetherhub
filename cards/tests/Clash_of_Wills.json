[
  {
    "name": "controller pays X and the spell resolves",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Clash of Wills"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Clash of Wills", "player": 1, "answers": [2], "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 17, "graveyard": ["Clash of Wills"] }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "controller declines to pay X and the spell is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Clash of Wills"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Clash of Wills", "player": 1, "answers": [2], "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 20 }
      ],
      "stack_empty": true
    }
  }
]
