[
  { "name": "an instant exiled to pay for delve can be returned to hand when it attacks",
    "players": [ { "hand": ["Ethereal Forager"], "battlefield": ["Island", "Island"], "graveyard": ["Lightning Bolt", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Ethereal Forager", "answers": [["Lightning Bolt", "Forest", "Forest", "Forest"]] }, { "resolve": true },
               { "advance_to": "End", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true },
               { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Ethereal Forager", "at": "p1" } ] },
               { "advance_to": "Main2", "answers": [0] } ],
    "expect": { "players": [ { "battlefield_has": ["Ethereal Forager"], "hand": ["Island", "Lightning Bolt"], "exile": ["Forest", "Forest", "Forest"] }, {} ] } },
  { "name": "lands exiled to pay for delve are never returned",
    "players": [ { "hand": ["Ethereal Forager"], "battlefield": ["Island", "Island"], "graveyard": ["Forest", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Ethereal Forager", "answers": [["Forest", "Forest", "Forest", "Forest"]] }, { "resolve": true },
               { "advance_to": "End", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true },
               { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Ethereal Forager", "at": "p1" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Island"], "exile": ["Forest", "Forest", "Forest", "Forest"] }, {} ] } },
  { "name": "with nothing exiled with it, attacking returns nothing",
    "players": [ { "hand": ["Ethereal Forager"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Ethereal Forager" }, { "resolve": true },
               { "advance_to": "End", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true },
               { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Ethereal Forager", "at": "p1" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Island"], "exile": [] }, { "life": 17 } ] } },
  { "name": "ruling: Forager leaves the battlefield in response to its attack trigger, and the trigger still finds the exiled instant",
    "players": [ { "hand": ["Ethereal Forager"], "battlefield": ["Island", "Island"], "graveyard": ["Lightning Bolt", "Forest", "Forest", "Forest"], "library": ["Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Ethereal Forager", "answers": [["Lightning Bolt", "Forest", "Forest", "Forest"]] }, { "resolve": true },
               { "advance_to": "End", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true },
               { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Ethereal Forager", "at": "p1" } ] },
               { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["Ethereal Forager"] },
               { "resolve": true, "answers": [0] } ],
    "expect": { "players": [ { "hand": ["Island", "Lightning Bolt"], "exile": ["Forest", "Forest", "Forest"], "graveyard": ["Ethereal Forager"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: a spell returned by the attack trigger can be cast before blockers are declared",
    "players": [ { "hand": ["Ethereal Forager"], "battlefield": ["Island", "Island", "Mountain"], "graveyard": ["Lightning Bolt", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Ethereal Forager", "answers": [["Lightning Bolt", "Forest", "Forest", "Forest"]] }, { "resolve": true },
               { "advance_to": "End", "auto": true }, { "advance_to": "Upkeep", "auto": true }, { "advance_to": "Upkeep", "auto": true },
               { "advance_to": "BeginCombat", "auto": true },
               { "attack": [ { "card": "Ethereal Forager", "at": "p1" } ] },
               { "resolve": true, "answers": [0] },
               { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Lightning Bolt"], "exile": ["Forest", "Forest", "Forest"] }, { "life": 14 } ] } }
]
