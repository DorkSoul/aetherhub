[
  { "name": "foretell pays {2} and exiles the card face down from hand",
    "players": [ { "hand": ["Scorn Effigy"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Scorn Effigy", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Scorn Effigy"], "hand_count": 0 }, {} ] } },
  { "name": "foretold card is cast from exile for {0} on a later turn",
    "players": [ { "hand": ["Scorn Effigy"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Scorn Effigy", "ability": 0 }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Scorn Effigy", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Scorn Effigy"] }, {} ] } },
  { "name": "foretold card cannot be cast on the turn it was exiled",
    "players": [ { "hand": ["Scorn Effigy"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Scorn Effigy", "ability": 0 }, { "resolve": true },
               { "cast": "Scorn Effigy", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Scorn Effigy"] }, {} ] } },
  { "name": "ruling: a foretold non-instant cannot be cast on the opponent's turn",
    "players": [ { "hand": ["Scorn Effigy"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Scorn Effigy", "ability": 0 }, { "resolve": true },
               { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "pass": true, "player": 1 },
               { "cast": "Scorn Effigy", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Scorn Effigy"] }, {} ] } },
  { "name": "ruling: foretelling is a special action that can be taken in response to a spell",
    "players": [ { "hand": ["Scorn Effigy", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "activate": "Scorn Effigy", "ability": 0 },
               { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Scorn Effigy"], "hand_count": 0 }, { "life": 17 } ] } }
]
