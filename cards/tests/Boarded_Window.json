[
  {
    "name": "dealt 5 damage this turn: exiled at the end step",
    "players": [
      {
        "battlefield": [
          "Boarded Window"
        ]
      },
      {
        "hand": [
          "Lightning Bolt",
          "Shock"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Lightning Bolt",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      },
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Shock",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 15,
          "battlefield_lacks": [
            "Boarded Window"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "dealt only 3 damage this turn: the artifact stays",
    "players": [
      {
        "battlefield": [
          "Boarded Window"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Lightning Bolt",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 17,
          "battlefield_has": [
            "Boarded Window"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "creatures attacking you get -1/-0",
    "players": [ { "battlefield": ["Boarded Window"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "Main2" }, { "advance_to": "End" }, { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
      { "block": [], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 19 }, {} ] }
  },
  {
    "name": "your own attacking creatures are not affected",
    "players": [ { "battlefield": ["Boarded Window", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "ruling: damage dealt before the artifact entered still counts (5 damage, artifact cast afterwards)",
    "players": [
      { "hand": ["Boarded Window"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "cast": "Shock", "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Boarded Window" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 15, "battlefield_lacks": ["Boarded Window"] }, {} ] }
  },
  {
    "name": "ruling: life gained this turn does not offset damage (3 damage + 2 life gained: artifact stays)",
    "players": [
      { "hand": ["Pharika's Cure"], "battlefield": ["Boarded Window", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Pharika's Cure", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 19, "battlefield_has": ["Boarded Window"] }, {} ] }
  }
]