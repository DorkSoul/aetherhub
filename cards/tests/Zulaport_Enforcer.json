 {
  "name": "level 3: a non-black Grizzly Bears block is dropped, Zulaport connects for 5 while Elves chump Hill Giant",
  "players": [ { "battlefield": [ { "name": "Zulaport Enforcer", "counters": { "Level": 3 } }, "Hill Giant" ] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
  "steps": [ { "attack": [ { "card": "Zulaport Enforcer", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Zulaport Enforcer" }, { "blocker": "Llanowar Elves", "attacker": "Hill Giant" } ] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 15 } ] }
 },
 {
  "name": "level 3: a black creature can still block it",
  "players": [ { "battlefield": [ { "name": "Zulaport Enforcer", "counters": { "Level": 3 } } ] }, { "battlefield": ["Gray Merchant of Asphodel"] } ],
  "steps": [ { "attack": [ { "card": "Zulaport Enforcer", "at": "p1" } ] }, { "block": [ { "blocker": "Gray Merchant of Asphodel", "attacker": "Zulaport Enforcer" } ] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 20 } ] }
 },
 {
  "name": "ruling: a +1/+1 counter applies to the leveler after it levels up",
  "players": [ { "battlefield": [ { "name": "Zulaport Enforcer", "counters": { "p1p1": 1 } }, "Swamp", "Swamp", "Swamp", "Swamp" ] }, {} ],
  "steps": [ { "activate": "Zulaport Enforcer", "ability": 0 }, { "resolve": true } ],
  "expect": { "pt": { "Zulaport Enforcer": [4, 4] } }
 },
 {
  "name": "ruling: the level comes from the counters, so one level up on a level 2 leveler reaches 5/5",
  "players": [ { "battlefield": [ { "name": "Zulaport Enforcer", "counters": { "Level": 2 } }, "Swamp", "Swamp", "Swamp", "Swamp" ] }, {} ],
  "steps": [ { "activate": "Zulaport Enforcer", "ability": 0 }, { "resolve": true } ],
  "expect": { "pt": { "Zulaport Enforcer": [5, 5] }, "counters": { "Zulaport Enforcer": { "Level": 3 } } }
 },
 {
  "name": "ruling: the level up ability is still there at level 3 and adds a level counter",
  "players": [ { "battlefield": [ { "name": "Zulaport Enforcer", "counters": { "Level": 3 } }, "Swamp", "Swamp", "Swamp", "Swamp" ] }, {} ],
  "steps": [ { "activate": "Zulaport Enforcer", "ability": 0 }, { "resolve": true } ],
  "expect": { "pt": { "Zulaport Enforcer": [5, 5] }, "counters": { "Zulaport Enforcer": { "Level": 4 } } }
 }
