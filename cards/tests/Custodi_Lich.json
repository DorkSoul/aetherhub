[
  {
    "name": "enters, becomes monarch, and the opponent sacrifices a creature",
    "players": [ { "hand": ["Custodi Lich"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Custodi Lich" },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Custodi Lich"] }, { "battlefield_lacks": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "target player with no creatures sacrifices nothing",
    "players": [ { "hand": ["Custodi Lich"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Custodi Lich" },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Custodi Lich", "Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: already the monarch, so the becomes-monarch ability does not trigger",
    "players": [
      { "hand": ["Palace Jailer", "Custodi Lich"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Palace Jailer" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Custodi Lich" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Palace Jailer", "Custodi Lich"] },
        { "battlefield_has": ["Hill Giant"], "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the monarch draws a card at the beginning of their end step",
    "players": [
      { "hand": ["Custodi Lich"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Custodi Lich" },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Custodi Lich"], "hand_count": 1 },
        { "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  }
]
