[
  {
    "name": "a Goblin dealing combat damage to a player makes that player discard",
    "players": [
      { "battlefield": ["Cabal Slaver", "Goblin Brigand"] },
      { "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "attack": [{ "card": "Goblin Brigand", "at": "p1" }] },
      { "advance_to": "CombatDamage" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 18, "hand_count": 0 }]
    }
  },
  {
    "name": "a non-Goblin dealing combat damage does not",
    "players": [
      { "battlefield": ["Cabal Slaver", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "CombatDamage" }
    ],
    "expect": {
      "players": [{}, { "life": 18, "hand_count": 1 }]
    }
  }
]
