        {}
      ]
    }
  },
  {
    "name": "non-creature top card cannot be cast from the library",
    "players": [
      {
        "battlefield": ["Elven Chorus", "Forest", "Forest", "Forest", "Forest"],
        "library": ["Giant Growth", "Island"]
      },
      {}
    ],
    "steps": [
      {"cast": "Giant Growth", "illegal": true}
    ],
    "expect": {}
  },
  {
    "name": "creatures you control tap for any color",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Elven Chorus", "Grizzly Bears"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      {"cast": "Lightning Bolt", "targets": ["Hill Giant"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {},
        {"graveyard": ["Hill Giant"]}
      ],
      "tapped": {"Grizzly Bears": true}
    }
