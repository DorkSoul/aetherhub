 {
  "name": "ruling: the top creature cannot be cast from the library in combat, only at normal timing",
  "players": [
   { "battlefield": ["Elven Chorus", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Island"] },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "cast": "Grizzly Bears", "illegal": true }
  ],
  "expect": {
   "players": [ { "library_top": ["Grizzly Bears", "Island"] }, {} ]
  }
 },
 {
  "name": "ruling: the top creature is still paid for in full (not enough mana to cast it)",
  "players": [
   { "battlefield": ["Elven Chorus", "Forest"], "library": ["Grizzly Bears", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears", "illegal": true }
  ],
  "expect": {
   "players": [ { "library_top": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ]
  }
 }
