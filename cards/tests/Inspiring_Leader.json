    ],
    "steps": [
      { "cast": "Savannah Lions" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Bird Soldier 4-4 Flying": [6, 6] }
    }
  },
  { "name": "ruling: two commanders each grant the +2/+2, so tokens get +4/+4",
    "commander": true,
    "players": [
      { "command": ["Test Commander", "Savannah Lions"], "battlefield": ["Inspiring Leader", "Bird Soldier 4-4 Flying", "Forest", "Forest", "Forest", "Forest", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Test Commander" },
      { "resolve": true },
      { "cast": "Savannah Lions" },
