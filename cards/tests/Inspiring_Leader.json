  { "name": "a nontoken creature you control is not affected",
    "commander": true,
    "players": [
      { "command": ["Test Commander"], "battlefield": ["Inspiring Leader", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Test Commander" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  { "name": "ruling: one of two commanders is enough for the effect",
    "commander": true,
    "players": [
      { "command": ["Test Commander", "Savannah Lions"], "battlefield": ["Inspiring Leader", "Bird Soldier 4-4 Flying", "Forest", "Forest", "Forest", "Forest", "Plains"] },
