[
  { "name": "every creature able to block the Unicorn must do so",
    "players": [ { "battlefield": ["Prized Unicorn"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Prized Unicorn", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Prized Unicorn"] }, { "life": 20 } ] } },
  { "name": "ruling: tapped creatures don't block: with both potential blockers tapped the Unicorn is unblocked",
    "players": [ { "battlefield": ["Prized Unicorn"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, { "name": "Hill Giant", "tapped": true } ] } ],
    "steps": [ { "attack": [ { "card": "Prized Unicorn", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Prized Unicorn"] }, { "life": 18 } ] } },
  { "name": "ruling: a tapped creature doesn't block, so the untapped Hill Giant must block alone",
    "players": [ { "battlefield": ["Prized Unicorn"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, "Hill Giant" ] } ],
    "steps": [ { "attack": [ { "card": "Prized Unicorn", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Prized Unicorn"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ] } }
]
