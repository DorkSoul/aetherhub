[
  {
    "name": "ruling: an instant going to the graveyard does not count as descending (Hill Giant survives Shock)",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Broodrage Mycoid", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Shock"], "battlefield_has": ["Broodrage Mycoid"], "battlefield_lacks": ["Fungus 1-1 Black Cant Block"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: a Mycoid cast after you descended still triggers at your end step",
    "players": [
      { "hand": ["Shock", "Broodrage Mycoid"], "battlefield": ["Llanowar Elves", "Mountain", "Mountain", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Llanowar Elves"] },
      { "resolve": true },
      { "cast": "Broodrage Mycoid" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Broodrage Mycoid", "Fungus 1-1 Black Cant Block"], "graveyard": ["Llanowar Elves", "Shock"] },
        {}
      ]
    }
  },
  {
    "name": "end step after a permanent card of yours hit the graveyard makes a 1/1 Fungus that can't block",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Broodrage Mycoid", "Llanowar Elves", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Llanowar Elves"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Shock", "Llanowar Elves"], "battlefield_has": ["Broodrage Mycoid", "Fungus 1-1 Black Cant Block"] },
        {}
      ]
    }
  },
  {
    "name": "no permanent card put into your graveyard this turn: no token at end step",
    "players": [
      { "battlefield": ["Broodrage Mycoid", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Broodrage Mycoid"], "battlefield_lacks": ["Fungus 1-1 Black Cant Block"] },
        {}
      ]
    }
  },
  {
    "name": "an opponent's permanent dying does not count as you descending",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Broodrage Mycoid", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Fungus 1-1 Black Cant Block"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  }
]
