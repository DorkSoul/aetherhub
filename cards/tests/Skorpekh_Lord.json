 {
  "name": "ruling: the unearth ability does nothing if the card is gone from the graveyard before it resolves",
  "players": [ { "battlefield": ["Swamp", "Swamp", "Swamp"], "graveyard": ["Skorpekh Lord"] }, { "battlefield": ["Relic of Progenitus"] } ],
  "steps": [
