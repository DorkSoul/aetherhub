  ],
  "expect": { "players": [ { "battlefield_lacks": ["Skorpekh Lord"], "graveyard": [], "exile": ["Skorpekh Lord"] }, { "battlefield": ["Relic of Progenitus"] } ] }
 },
 {
  "name": "ruling: unearth is an ability, so Stifle can counter it and the card stays in the graveyard",
  "players": [ { "battlefield": ["Swamp", "Swamp", "Swamp"], "graveyard": ["Skorpekh Lord"] }, { "battlefield": ["Island"], "hand": ["Stifle"] } ],
  "steps": [
