[
  {
    "name": "boast after attacking fetches a basic land to hand, once per turn",
    "players": [
      { "battlefield": ["Horizon Seeker", "Forest", "Forest"], "library": ["Grizzly Bears", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Horizon Seeker", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Horizon Seeker", "ability": 0 },
      { "resolve": true, "answers": ["Mountain"] },
      { "activate": "Horizon Seeker", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Mountain"], "battlefield_has": ["Horizon Seeker"], "library_count": 1 }
      ]
    }
  },
  {
    "name": "boast is not available if Horizon Seeker did not attack this turn",
    "players": [
      { "battlefield": ["Horizon Seeker", "Forest", "Forest"], "library": ["Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "activate": "Horizon Seeker", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 1 }
      ]
    }
  },
  {
    "name": "ruling: boast can be activated right after the attack, before blockers",
    "players": [ { "battlefield": ["Horizon Seeker", "Forest", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Horizon Seeker", "at": "p1" } ] },
      { "activate": "Horizon Seeker", "ability": 0 },
      { "resolve": true, "answers": ["Mountain"] }
    ],
    "expect": { "players": [ { "hand": ["Mountain"], "battlefield_has": ["Horizon Seeker"] }, {} ] }
  },
  {
    "name": "ruling: boast can still be activated in the end step after the creature attacked",
    "players": [ { "battlefield": ["Horizon Seeker", "Forest", "Forest"], "library": ["Mountain"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Horizon Seeker", "at": "p1" } ] },
      { "advance_to": "End" },
      { "activate": "Horizon Seeker", "ability": 0 },
      { "resolve": true, "answers": ["Mountain"] }
    ],
    "expect": { "players": [ { "hand": ["Mountain"], "battlefield_has": ["Horizon Seeker"] }, {} ] }
  }
]
