  {
    "name": "ruling: a creature with several creature types counts as an outlaw if one is an outlaw type (Human Rogue)",
    "players": [
      { "hand": ["Outlaws' Fury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Glint-Sleeve Siphoner"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [ { "cast": "Outlaws' Fury" }, { "resolve": true } ],
    "expect": {
      "players": [ { "exile": ["Grizzly Bears"] }, {} ],
      "pt": { "Glint-Sleeve Siphoner": [4, 1] }
    }
  },
  {
    "name": "ruling: the card exiled by an outlaw can be played as a land in your main phase",
    "players": [
      { "hand": ["Outlaws' Fury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Outlaw Medic"], "library": ["Forest"] },
      {}
    ],
    "steps": [ { "cast": "Outlaws' Fury" }, { "resolve": true }, { "play_land": "Forest" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Forest"], "exile": [] }, {} ]
    }
  },
  {
    "name": "ruling: an opponent's outlaw does not trigger the exile",
    "players": [
      { "hand": ["Outlaws' Fury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"], "library": ["Forest"] },
      { "battlefield": ["Outlaw Medic"] }
    ],
    "steps": [ { "cast": "Outlaws' Fury" }, { "resolve": true } ],
    "expect": {
      "players": [ { "exile": [], "library_top": ["Forest"] }, {} ]
    }
  },
  {
    "name": "ruling: an outlaw card in your graveyard does not trigger the exile",
    "players": [
      { "hand": ["Outlaws' Fury"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"], "graveyard": ["Outlaw Medic"], "library": ["Forest"] },
      {}
    ],
    "steps": [ { "cast": "Outlaws' Fury" }, { "resolve": true } ],
    "expect": {
      "players": [ { "exile": [], "library_top": ["Forest"] }, {} ]
    }
  },
  {
    "name": "ruling: a creature that enters after Outlaws' Fury resolves does not get +2/+0",
    "players": [
      { "hand": ["Outlaws' Fury", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Forest", "Forest", "Hill Giant"] },
