[
  {
    "name": "enters with an oil counter",
    "players": [
      { "hand": ["Meldweb Strider"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Meldweb Strider" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Meldweb Strider": { "oil": 1 } },
      "players": [
        { "battlefield_has": ["Meldweb Strider"] },
        {}
      ]
    }
  },
  {
    "name": "crew 3 taps creatures with total power 3",
    "players": [
      { "battlefield": [ { "name": "Meldweb Strider", "counters": { "oil": 1 } }, "Hill Giant" ] },
      {}
    ],
    "steps": [
      { "activate": "Meldweb Strider", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Hill Giant": true },
      "counters": { "Meldweb Strider": { "oil": 1 } }
    }
  },
  {
    "name": "remove the oil counter: it becomes a creature and the counter is gone",
    "players": [
      { "battlefield": [ { "name": "Meldweb Strider", "counters": { "oil": 1 } } ] },
      {}
    ],
    "steps": [
      { "activate": "Meldweb Strider", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Meldweb Strider": { "oil": 0 } },
      "players": [
        { "battlefield_has": ["Meldweb Strider"] },
        {}
      ]
    }
  }
]
