[
  {
    "name": "ruling: tapping for mana does not remove storage counters",
    "players": [
      { "battlefield": [ { "name": "City of Shadows", "counters": { "storage": 2 } } ] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "City of Shadows" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "counters": { "City of Shadows": { "storage": 2 } },
      "tapped": { "City of Shadows": true }
    }
  },
  {
    "name": "ruling: with no storage counters the land can still be tapped for (no) mana",
    "players": [
      { "battlefield": ["City of Shadows"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "City of Shadows" }
    ],
    "expect": {
      "tapped": { "City of Shadows": true }
    }
  },
  {
    "name": "exiling a creature you control as a cost (the land taps for it)",
    "players": [
      { "battlefield": ["City of Shadows", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "City of Shadows", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Grizzly Bears"], "battlefield_has": ["City of Shadows"] },
        {}
      ],
      "tapped": { "City of Shadows": true }
    }
  },
  {
    "name": "no creature to exile: the storage ability can't be activated",
    "players": [
      { "battlefield": ["City of Shadows"] },
      {}
    ],
    "steps": [
      { "activate": "City of Shadows", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["City of Shadows"] },
        {}
      ]
    }
  },
  {
    "name": "a creature you control that is only an opponent's creature can't be exiled",
    "players": [
      { "battlefield": ["City of Shadows"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "City of Shadows", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["City of Shadows"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
