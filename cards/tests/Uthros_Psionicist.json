[
  {
    "name": "second spell each turn costs 2 less",
    "players": [{ "hand": ["Grizzly Bears", "Hill Giant"], "battlefield": ["Uthros Psionicist", "Forest", "Forest", "Mountain", "Mountain"] }, {}],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Hill Giant" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Grizzly Bears", "Hill Giant", "Uthros Psionicist"] }, {}] }
  },
  {
    "name": "the first spell of the turn is not reduced",
    "players": [{ "hand": ["Hill Giant"], "battlefield": ["Uthros Psionicist", "Mountain", "Mountain"] }, {}],
    "steps": [{ "cast": "Hill Giant", "illegal": true }]
  },
  {
    "name": "ruling: Uthros Psionicist cast this turn counts as the first spell, so the next spell is the discounted second",
    "players": [{ "hand": ["Uthros Psionicist", "Grizzly Bears"], "battlefield": ["Island", "Island", "Island", "Forest"] }, {}],
    "steps": [
      { "cast": "Uthros Psionicist" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "hand": [], "battlefield_has": ["Uthros Psionicist", "Grizzly Bears"] }, {}] }
  },
  {
    "name": "ruling: a countered first spell still counts, so the next spell is the discounted second (Bolt countered, Bears for one Forest)",
    "players": [
      { "hand": ["Lightning Bolt", "Grizzly Bears"], "battlefield": ["Uthros Psionicist", "Mountain", "Forest"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "hand": [], "graveyard": ["Lightning Bolt"], "battlefield_has": ["Uthros Psionicist", "Grizzly Bears"] }, { "graveyard": ["Counterspell"], "life": 20 }] }
  }
]
