[
  {
    "name": "may cast a flash spell from the top of your library",
    "players": [
      { "battlefield": ["Errant and Giada", "Island"], "library": ["Spectral Sailor"] },
      {}
    ],
    "steps": [ { "cast": "Spectral Sailor" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Sailor", "Errant and Giada"] }, {} ] }
  },
  {
    "name": "may cast a flying spell from the top of your library",
    "players": [
      { "battlefield": ["Errant and Giada", "Plains", "Plains", "Plains", "Plains", "Plains"], "library": ["Serra Angel"] },
      {}
    ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Serra Angel" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Serra Angel", "Errant and Giada"] }, {} ] }
  },
  {
    "name": "no non-flash non-flying spell from the top of your library",
    "players": [
      { "battlefield": ["Errant and Giada", "Plains", "Plains", "Plains", "Plains"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Errant and Giada"] }, {} ] }
  },
  {
    "name": "may cast a flash-only (non-flying) spell from the top of your library",
    "players": [
      { "battlefield": ["Errant and Giada", "Forest", "Island"], "library": ["Ambush Viper"] },
      {}
    ],
    "steps": [ { "cast": "Ambush Viper" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ambush Viper", "Errant and Giada"] }, {} ] }
  },
  {
    "name": "ruling: after casting the top card, the next top card can be cast once that cast is finished",
    "players": [
      { "battlefield": ["Errant and Giada", "Island", "Forest", "Island"], "library": ["Spectral Sailor", "Ambush Viper"] },
      {}
    ],
    "steps": [ { "cast": "Spectral Sailor" }, { "cast": "Ambush Viper" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Sailor", "Ambush Viper", "Errant and Giada"] }, {} ] }
  }
]
