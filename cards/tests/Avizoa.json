[
  {
    "name": "{0}: gets +2/+2 until end of turn",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Avizoa"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Avizoa"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Avizoa": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "can only be activated once each turn",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Avizoa"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Avizoa"
      },
      {
        "resolve": true
      },
      {
        "activate": "Avizoa",
        "illegal": true
      }
    ],
    "expect": {
      "pt": {
        "Avizoa": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: activating skips your next untap step, so Avizoa stays tapped",
    "players": [
      { "battlefield": ["Island", "Island", "Island", "Island", "Avizoa"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Avizoa", "at": "p1" } ] },
      { "activate": "Avizoa" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Avizoa": true }
    }
  },
  {
    "name": "control: without activating, Avizoa untaps in your next untap step",
    "players": [
      { "battlefield": ["Island", "Island", "Island", "Island", "Avizoa"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Avizoa", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Avizoa": false }
    }
  }
]
