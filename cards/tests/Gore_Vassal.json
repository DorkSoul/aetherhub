[
  {
    "name": "sacrifice: -1/-1 counter; toughness stays 1 so it regenerates the 2/2 target into a 1/1",
    "players": [
      {
        "battlefield": [
          "Gore Vassal"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Gore Vassal",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Gore Vassal"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ],
      "pt": {
        "Grizzly Bears": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "target that becomes 0 toughness dies",
    "players": [
      {
        "battlefield": [
          "Gore Vassal"
        ]
      },
      {
        "battlefield": [
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Gore Vassal",
        "ability": 0,
        "targets": [
          "Llanowar Elves"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Gore Vassal"
          ]
        },
        {
          "graveyard": [
            "Llanowar Elves"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: regeneration shield lasts until used; a later lethal Shock is regenerated",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Gore Vassal", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Gore Vassal", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Gore Vassal", "Shock"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "pt": { "Grizzly Bears": [1, 1] }
    }
  },
  {
    "name": "ruling: may target itself, but it is gone when the ability resolves so nothing happens",
    "players": [ { "battlefield": ["Gore Vassal"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Gore Vassal", "ability": 0, "targets": ["Gore Vassal"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Gore Vassal"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: lethal damage then the counter; the shield is created first so the creature regenerates",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Gore Vassal", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Gore Vassal", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Gore Vassal", "Shock"] }, { "battlefield_has": ["Hill Giant"] } ],
      "pt": { "Hill Giant": [2, 2] },
      "tapped": { "Hill Giant": true }
    }
  }
]
