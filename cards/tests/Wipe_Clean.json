[
  {
    "name": "exiles target enchantment",
    "players": [
      { "hand": ["Wipe Clean"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Blood Funnel"] }
    ],
    "steps": [
      { "cast": "Wipe Clean", "targets": ["Blood Funnel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Wipe Clean"] },
        { "exile": ["Blood Funnel"] }
      ]
    }
  },
  {
    "name": "cycling for {3} discards it and draws a card",
    "players": [
      { "hand": ["Wipe Clean"], "battlefield": ["Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Wipe Clean", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Wipe Clean"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "cannot target a non-enchantment",
    "players": [
      { "hand": ["Wipe Clean"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Wipe Clean", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: Stifle can counter the cycling ability, so nothing is drawn",
    "players": [
      { "hand": ["Wipe Clean"], "battlefield": ["Plains", "Plains", "Plains"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Wipe Clean", "ability": 0 },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Wipe Clean" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Wipe Clean"], "hand_count": 0 },
        { "graveyard": ["Stifle"] }
      ]
    }
  }
]
