   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Treasure"] },
    {}
   ]
  }
 },
 {
  "name": "with four artifacts Gadrak may attack (5 flying + 2 from the Bears = 7)",
