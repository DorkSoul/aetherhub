   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 18 } ] }
 },
 {
  "name": "ruling: a creature that died before Gadrak entered still counts for its end-step Treasure",
  "players": [
   { "hand": ["Lightning Bolt", "Gadrak, the Crown-Scourge"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
