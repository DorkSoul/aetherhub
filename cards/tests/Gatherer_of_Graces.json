  {
    "name": "sacrifice an Aura to regenerate it",
    "players": [{"hand": ["Holy Strength"], "battlefield": ["Plains", "Gatherer of Graces"]}, {}],
    "steps": [
      {"cast": "Holy Strength", "targets": ["Gatherer of Graces"]},
      {"resolve": true},
      {"activate": "Gatherer of Graces", "ability": 0},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"graveyard": ["Holy Strength"]}, {}],
      "pt": {"Gatherer of Graces": [1, 2]}
    }
  },
  {
    "name": "ruling: the sacrificed Aura need not be attached to Gatherer (Holy Strength on Grizzly Bears); regeneration still saves it",
    "players": [{"hand": ["Holy Strength"], "battlefield": ["Plains", "Gatherer of Graces", "Grizzly Bears"]}, {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}],
    "steps": [
      {"cast": "Holy Strength", "targets": ["Grizzly Bears"]},
      {"resolve": true},
      {"pass": true},
      {"player": 1, "cast": "Lightning Bolt", "targets": ["Gatherer of Graces"]},
      {"pass": true, "player": 1},
      {"activate": "Gatherer of Graces", "ability": 0},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"battlefield_has": ["Gatherer of Graces"], "graveyard": ["Holy Strength"]}, {"graveyard": ["Lightning Bolt"]}]
    }
  },
  {
    "name": "ruling: sacrificing the Aura on Gatherer shrinks it below its damage before the regeneration resolves",
    "players": [{"hand": ["Holy Strength"], "battlefield": ["Plains", "Gatherer of Graces"]}, {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}],
    "steps": [
      {"cast": "Holy Strength", "targets": ["Gatherer of Graces"]},
      {"resolve": true},
      {"pass": true},
      {"player": 1, "cast": "Lightning Bolt", "targets": ["Gatherer of Graces"]},
      {"resolve": true},
      {"activate": "Gatherer of Graces", "ability": 0},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"graveyard": ["Holy Strength", "Gatherer of Graces"]}, {"graveyard": ["Lightning Bolt"]}]
    }
  }
