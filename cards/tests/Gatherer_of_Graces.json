    "steps": [],
    "expect": {"pt": {"Gatherer of Graces": [1, 2]}}
  },
  {
    "name": "+1/+1 for each Aura attached (Holy Strength itself gives +1/+2)",
    "players": [{"hand": ["Holy Strength"], "battlefield": ["Plains", "Gatherer of Graces"]}, {}],
    "steps": [
      {"cast": "Holy Strength", "targets": ["Gatherer of Graces"]},
      {"resolve": true}
    ],
    "expect": {"pt": {"Gatherer of Graces": [3, 5]}}
  },
  {
    "name": "an Aura on another creature does not count",
    "players": [{"hand": ["Holy Strength"], "battlefield": ["Plains", "Gatherer of Graces", "Grizzly Bears"]}, {}],
    "steps": [
      {"cast": "Holy Strength", "targets": ["Grizzly Bears"]},
      {"resolve": true}
    ],
    "expect": {"pt": {"Gatherer of Graces": [1, 2], "Grizzly Bears": [3, 4]}}
