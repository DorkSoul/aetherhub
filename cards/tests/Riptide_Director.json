[
 {
  "name": "draws a card for each Wizard you control",
  "players": [
   {
    "battlefield": ["Riptide Director", "Prodigal Pyromancer", "Island", "Island", "Island", "Island"]
   },
   {}
  ],
  "steps": [
   { "activate": "Riptide Director" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "hand_count": 2 }, {}],
   "tapped": { "Riptide Director": true }
  }
 },
 {
  "name": "a lone Wizard draws one card",
  "players": [
   {
    "battlefield": ["Riptide Director", "Island", "Island", "Island", "Island"]
   },
   {}
  ],
  "steps": [
   { "activate": "Riptide Director" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "hand_count": 1 }, {}]
  }
 },
 {
  "name": "opponent's Wizards do not count",
  "players": [
   {
    "battlefield": ["Riptide Director", "Island", "Island", "Island", "Island"]
   },
   {
    "battlefield": ["Prodigal Pyromancer"]
   }
  ],
  "steps": [
   { "activate": "Riptide Director" },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "hand_count": 1 }, {}]
  }
 }
]
