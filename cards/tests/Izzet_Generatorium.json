[
  {
    "name": "gaining energy gets one extra",
    "players": [
      { "hand": ["Confiscation Coup"], "battlefield": ["Izzet Generatorium", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Craw Wurm"] }
    ],
    "steps": [
      { "cast": "Confiscation Coup", "targets": ["Craw Wurm"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 5 }, {} ] }
  },
  {
    "name": "cannot draw before paying 4 energy, can after",
    "players": [
      { "hand": ["Confiscation Coup"], "library": ["Forest", "Forest"], "battlefield": ["Izzet Generatorium", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Izzet Generatorium", "illegal": true },
      { "cast": "Confiscation Coup", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": [true] },
      { "activate": "Izzet Generatorium" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 1, "hand": ["Forest"] }, {} ] }
  },
  {
    "name": "ruling: two Generatoria each add one energy (4 gained becomes 6)",
    "players": [
      { "hand": ["Confiscation Coup"], "battlefield": ["Izzet Generatorium", "Izzet Generatorium", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Craw Wurm"] }
    ],
    "steps": [
      { "cast": "Confiscation Coup", "targets": ["Craw Wurm"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ { "energy": 6 }, {} ] }
  },
  {
    "name": "ruling: energy stays on the player across steps and turns",
    "players": [
      { "energy": 4, "battlefield": ["Izzet Generatorium"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": { "turn": 3, "players": [ { "energy": 4 }, {} ] }
  },
  {
    "name": "ruling: Coup whose only target became illegal does not resolve, so no energy",
    "players": [
      { "hand": ["Confiscation Coup"], "battlefield": ["Izzet Generatorium", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"] }
    ],
    "steps": [
      { "cast": "Confiscation Coup", "targets": ["Hill Giant"] },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 0 }, { "graveyard_has": ["Hill Giant"] } ] }
  }
]
