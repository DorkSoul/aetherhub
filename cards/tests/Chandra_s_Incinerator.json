[
  {
    "name": "costs {1} less per noncombat damage dealt to opponents this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Chandra's Incinerator"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Chandra's Incinerator" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Chandra's Incinerator"] }, { "life": 17 } ] }
  },
  {
    "name": "noncombat damage to an opponent: that much damage to their creature",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Chandra's Incinerator", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 17, "graveyard": ["Hill Giant"] } ] }
  },
  {
    "name": "ruling: combat damage does not reduce the cost",
    "players": [
      { "hand": ["Chandra's Incinerator"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Chandra's Incinerator", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Chandra's Incinerator"] }, { "life": 18 } ] }
  },
  {
    "name": "ruling: all noncombat damage counts, even when the opponent's life total is back up",
    "players": [
      { "hand": ["Lightning Bolt", "Healing Salve", "Chandra's Incinerator"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Healing Salve", "targets": ["p1"], "answers": [0] },
      { "resolve": true },
      { "cast": "Chandra's Incinerator" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Chandra's Incinerator"] }, { "life": 20 } ] }
  },
  {
    "name": "ruling: the reduction only applies to generic mana, the {R} stays",
    "players": [
      { "hand": ["Lightning Bolt", "Chandra's Incinerator"], "battlefield": ["Mountain", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Chandra's Incinerator", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Chandra's Incinerator"] }, { "life": 17 } ] }
  }
]
