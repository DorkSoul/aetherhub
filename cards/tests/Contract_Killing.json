  {
    "name": "destroys target creature and makes two Treasures",
    "players": [
      { "hand": ["Contract Killing"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Contract Killing", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Treasure", "Treasure"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "needs a creature to target",
    "players": [
      { "hand": ["Contract Killing"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Contract Killing", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Contract Killing"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: if the target is gone when it resolves, the whole spell fizzles and no Treasures are made",
    "players": [
      { "hand": ["Contract Killing"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Contract Killing", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"], "graveyard_has": ["Contract Killing"] },
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  }
