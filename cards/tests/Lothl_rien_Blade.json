[
  {
    "name": "unequipped attacker deals no damage",
    "players": [
      {
        "battlefield": [
          "Lothl\u00f3rien Blade",
          {
            "name": "Llanowar Elves",
            "sick": false
          }
        ]
      },
      {
        "battlefield": [
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Llanowar Elves",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield_has": [
            "Llanowar Elves"
          ]
        }
      ]
    }
  },
  {
    "name": "equip Elf for {2} attaches the Blade to an Elf",
    "players": [ { "battlefield": ["Lothlórien Blade", "Island", "Island", "Llanowar Elves"] }, {} ],
    "steps": [ { "activate": "Lothlórien Blade", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "attached": { "Lothlórien Blade": "Llanowar Elves" } }
  },
  {
    "name": "equip Elf cannot attach to a creature that is not an Elf",
    "players": [ { "battlefield": ["Lothlórien Blade", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Lothlórien Blade", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "equip {5} attaches the Blade to any creature you control",
    "players": [ { "battlefield": ["Lothlórien Blade", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Lothlórien Blade", "ability": 1 }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "attached": { "Lothlórien Blade": "Grizzly Bears" } }
  },
  {
    "name": "equipped Elf attacks: the Blade deals 1 damage to the creature defending player controls, killing it",
    "players": [ { "battlefield": ["Lothlórien Blade", "Island", "Island", { "name": "Llanowar Elves", "sick": false }] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "activate": "Lothlórien Blade", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Llanowar Elves", "at": "p1" } ] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 19, "graveyard": ["Llanowar Elves"] } ] }
  },
  {
    "name": "equipped creature's power sets the damage: a 3-power Hill Giant kills an opposing Hill Giant",
    "players": [ { "battlefield": ["Lothlórien Blade", "Forest", "Forest", "Forest", "Forest", "Forest", "Hill Giant"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Lothlórien Blade", "ability": 1 }, { "resolve": true }, { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17, "graveyard": ["Hill Giant"] } ] }
  }
]