[
  {
    "name": "at your upkeep with exactly 1 life you win",
    "players": [
      {
        "battlefield": [
          "Near-Death Experience"
        ],
        "life": 1
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "winner": 0
    }
  },
  {
    "name": "with 2 life nothing happens",
    "players": [
      {
        "battlefield": [
          "Near-Death Experience"
        ],
        "life": 2
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "winner": -1
    }
  },
  {
    "name": "ruling: intervening if is rechecked on resolution (life changed to 2 before the trigger resolves)",
    "players": [
      {
        "battlefield": [
          "Near-Death Experience"
        ],
        "life": 1
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep",
        "hold": true
      },
      {
        "set_life": 2
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "winner": -1,
      "players": [
        {
          "life": 2
        },
        {}
      ]
    }
  }
]
