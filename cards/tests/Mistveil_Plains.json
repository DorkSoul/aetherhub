[
 {
  "name": "puts a graveyard card on the bottom of the library with two white permanents",
  "players": [
   {
    "battlefield": [
     "Mistveil Plains",
     "Plains",
     "Serra Angel",
     "Soldier"
    ],
    "graveyard": [
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Mistveil Plains",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [],
     "library_count": 21,
     "battlefield_has": [
      "Mistveil Plains"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "cannot activate with only one white permanent",
  "players": [
   {
    "battlefield": [
     "Mistveil Plains",
     "Plains",
     "Serra Angel"
    ],
    "graveyard": [
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Mistveil Plains",
    "targets": [
     "Grizzly Bears"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Grizzly Bears"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "enters tapped",
  "players": [
   {
    "hand": [
     "Mistveil Plains"
    ],
    "battlefield": [
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Mistveil Plains"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Mistveil Plains"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "enters tapped: it is tapped the turn it comes in",
  "players": [
   { "hand": ["Mistveil Plains"], "battlefield": ["Plains"] },
   {}
  ],
  "steps": [
   { "play_land": "Mistveil Plains" }
  ],
  "expect": {
   "tapped": { "Mistveil Plains": true },
   "players": [ { "battlefield_has": ["Mistveil Plains"] }, {} ]
  }
 },
 {
  "name": "ruling: the ability resolves even if a white permanent is lost after activation",
  "players": [
   { "battlefield": ["Mistveil Plains", "Plains", "Serra Angel", "Mentor of the Meek"], "graveyard": ["Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "activate": "Mistveil Plains", "targets": ["Grizzly Bears"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Mentor of the Meek"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "library_count": 21, "graveyard_has": ["Mentor of the Meek"], "battlefield_has": ["Serra Angel", "Mistveil Plains"] },
    { "graveyard_has": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: a land that taps for white mana is colorless, so Plains do not count as white permanents",
  "players": [
   { "battlefield": ["Mistveil Plains", "Plains", "Plains", "Serra Angel"], "graveyard": ["Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Mistveil Plains", "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": {
   "colors": { "Mistveil Plains": [], "Serra Angel": ["W"] },
   "players": [ { "graveyard": ["Grizzly Bears"] }, {} ]
  }
 }
]
