[
 {
  "name": "mana from an artifact source adds a counter",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Coin of Mastery", "Treasure", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": { "pt": { "Grizzly Bears": [3, 3] } }
 },
 {
  "name": "no artifact mana: no counter",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Coin of Mastery", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": { "pt": { "Grizzly Bears": [2, 2] } }
 },
 {
  "name": "{T}: create a Treasure",
  "players": [ { "battlefield": ["Coin of Mastery"] }, {} ],
  "steps": [ { "activate": "Coin of Mastery", "ability": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Treasure"] }, {} ] }
 }
]
