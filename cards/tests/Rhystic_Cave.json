[
  {
    "name": "ruling: the active player is asked to pay first; a decline passes the question on",
    "players": [
      { "battlefield": ["Rhystic Cave", "Island"] },
      { "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "activate": "Rhystic Cave", "ability": 0 },
      { "resolve": true, "answers": [false, true] }
    ],
    "expect": {
      "players": [
        { "pool": {} },
        { "battlefield_has": ["Swamp"] }
      ],
      "tapped": { "Swamp": true, "Island": false }
    }
  },
  {
    "name": "choose red: adds R when no player pays {1}",
    "players": [
      { "battlefield": ["Rhystic Cave"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Rhystic Cave", "ability": 0 },
      { "resolve": true, "answers": [false, "R"] }
    ],
    "expect": {
      "players": [
        { "pool": { "R": 1 } },
        {}
      ]
    }
  },
  {
    "name": "unless any player pays {1}: the opponent pays, so no mana is added",
    "players": [
      { "battlefield": ["Rhystic Cave"] },
      { "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "activate": "Rhystic Cave", "ability": 0 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "pool": {} },
        { "battlefield_has": ["Swamp"] }
      ],
      "tapped": { "Swamp": true }
    }
  },
  {
    "name": "already tapped: cannot activate again",
    "players": [
      { "battlefield": [{ "name": "Rhystic Cave", "tapped": true }] },
      {}
    ],
    "steps": [
      { "activate": "Rhystic Cave", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Rhystic Cave"] },
        {}
      ]
    }
  }
]
