[
  {
    "name": "casting a Spirit spell animates a target land until end of turn",
    "players": [
      { "hand": ["Ascendant Spirit"], "battlefield": ["Soilshaper", "Island", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Ascendant Spirit", "targets": ["Forest"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Forest": [3, 3] }
    }
  },
  {
    "name": "casting a non-Spirit spell does not trigger it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Soilshaper", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: an animated land controlled since the turn began can attack even though it only just became a creature",
    "players": [
      { "hand": ["Ascendant Spirit"], "battlefield": ["Soilshaper", "Island", "Island", "Island", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Ascendant Spirit", "targets": ["Forest"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Forest", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ],
      "pt": { "Forest": [3, 3] }
    }
  }
]
