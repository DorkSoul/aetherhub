[
  {
    "name": "draws for creatures with +1/+1 counters",
    "players": [
      {
        "hand": [
          "Armorcraft Judge"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          {
            "name": "Grizzly Bears",
            "counters": {
              "p1p1": 2
            }
          },
          {
            "name": "Hill Giant",
            "counters": {
              "p1p1": 1
            }
          },
          "Wall of Stone"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Grizzly Bears",
            "counters": {
              "p1p1": 1
            }
          }
        ]
      }
    ],
    "steps": [
      {
        "cast": "Armorcraft Judge"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "draws nothing with no counters (judge itself has none)",
    "players": [
      {
        "hand": [
          "Armorcraft Judge"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Armorcraft Judge"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        }
      ]
    }
  },
  {
    "name": "ruling: the number counts creatures, not counters: one creature with three +1/+1 counters draws one",
    "players": [
      {
        "hand": ["Armorcraft Judge"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 3 } }]
      },
      {}
    ],
    "steps": [ { "cast": "Armorcraft Judge" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 } ] }
  },
  {
    "name": "ruling: the count is made on resolution, so removing the only counter creature in response draws nothing",
    "players": [
      {
        "hand": ["Armorcraft Judge"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Armorcraft Judge" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Grizzly Bears"] }, {} ] }
  }
]