[
  {
    "name": "gains 1 life per creature on the battlefield and prevents combat damage from power 3 or less",
    "players": [
      { "hand": ["Fog of War"], "battlefield": ["Forest", "Forest", "Forest", "Hill Giant", "Craw Wurm"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Fog of War" },
      { "resolve": true },
      { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Craw Wurm", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 23 }, { "life": 14 } ]
    }
  },
  {
    "name": "no creatures on the battlefield means no life gained",
    "players": [
      { "hand": ["Fog of War"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Fog of War" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, { "life": 20 } ]
    }
  },
  {
    "name": "power 4 creature's combat damage is not prevented (power boundary)",
    "players": [
      { "hand": ["Fog of War"], "battlefield": ["Forest", "Forest", "Forest", "Craw Wurm"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Fog of War" },
      { "resolve": true },
      { "attack": [ { "card": "Craw Wurm", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 21 }, { "life": 14 } ]
    }
  }
]
