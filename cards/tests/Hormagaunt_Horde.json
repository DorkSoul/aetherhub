    ],
    "expect": {
      "players": [
        { "hand_count": 0, "battlefield_has": ["Hormagaunt Horde"] },
        {}
      ],
      "counters": { "Hormagaunt Horde": { "p1p1": 4 } }
    }
  },
  {
    "name": "ruling: a land put onto the battlefield by a spell (not a land drop) also triggers Endless Swarm",
    "players": [
      { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Hormagaunt Horde"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Rampant Growth" },
      { "resolve": true, "answers": ["Forest", true] }
    ],
    "expect": {
      "players": [
        { "hand": ["Hormagaunt Horde"], "graveyard": ["Rampant Growth"] },
        {}
      ]
