      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "hand": ["Hormagaunt Horde"], "graveyard": [] },
        {}
      ]
    }
  },
  {
    "name": "Endless Swarm: declining leaves it in the graveyard",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Forest", "Forest", "Forest"], "graveyard": ["Hormagaunt Horde"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Hormagaunt Horde"] },
        {}
      ]
    }
  },
  {
    "name": "Endless Swarm: cannot pay {2}{G} with too little mana",
    "players": [
      { "hand": ["Forest"], "graveyard": ["Hormagaunt Horde"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Hormagaunt Horde"] },
        {}
      ]
    }
  },
  {
    "name": "Ravenous: X of 5 or more draws a card when it enters",
    "players": [
      { "hand": ["Hormagaunt Horde"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Hormagaunt Horde", "answers": [5] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "battlefield_has": ["Hormagaunt Horde"] },
