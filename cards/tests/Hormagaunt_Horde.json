    }
  },
  {
    "name": "Ravenous: X of 4 enters with counters and draws nothing",
    "players": [
      { "hand": ["Hormagaunt Horde"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Hormagaunt Horde", "answers": [4] },
