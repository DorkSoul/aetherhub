[
  {
    "name": "Endless Swarm: paying {2}{G} returns it to hand when a land enters",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Forest", "Forest", "Forest"], "graveyard": ["Hormagaunt Horde"] },
      {}
    ],
    "steps": [
