[
  {
    "name": "two creature cards from your own graveyard make a Saproling",
    "players": [
      { "battlefield": ["Night Soil", "Forest"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "activate": "Night Soil", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Saproling"], "graveyard": [], "exile": ["Grizzly Bears", "Llanowar Elves"] }, {}] }
  },
  {
    "name": "the two cards may come from an opponent's graveyard",
    "players": [
      { "battlefield": ["Night Soil", "Forest"] },
      { "graveyard": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "activate": "Night Soil", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Saproling"] }, { "graveyard": [], "exile": ["Grizzly Bears", "Llanowar Elves"] }] }
  },
  {
    "name": "one creature card in each of two graveyards is not enough",
    "players": [
      { "battlefield": ["Night Soil", "Forest"], "graveyard": ["Grizzly Bears"] },
      { "graveyard": ["Llanowar Elves"] }
    ],
    "steps": [{ "activate": "Night Soil", "ability": 0, "illegal": true }],
    "expect": { "players": [{ "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Llanowar Elves"] }] }
  },
  {
    "name": "noncreature cards in the graveyard don't count",
    "players": [
      { "battlefield": ["Night Soil", "Forest"], "graveyard": ["Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [{ "activate": "Night Soil", "ability": 0, "illegal": true }],
    "expect": { "players": [{ "graveyard": ["Grizzly Bears", "Forest"] }, {}] }
  },
  {
    "name": "with creature cards in two graveyards you choose which graveyard to exile from",
    "players": [
      { "battlefield": ["Night Soil", "Forest"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] },
      { "graveyard": ["Hill Giant", "Serra Angel"] }
    ],
    "steps": [
      { "activate": "Night Soil", "ability": 0, "answers": [[2, 3]] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Saproling"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] }, { "graveyard": [], "exile": ["Hill Giant", "Serra Angel"] }] }
  },
  {
    "name": "ruling: the two creature cards are exiled as the cost, so they are already gone while the ability is on the stack",
    "players": [
      { "battlefield": ["Night Soil", "Forest"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "activate": "Night Soil", "ability": 0 }
    ],
    "expect": { "stack_empty": false, "players": [{ "battlefield_has": ["Night Soil"], "graveyard": [], "exile": ["Grizzly Bears", "Llanowar Elves"] }, {}] }
  }
]
