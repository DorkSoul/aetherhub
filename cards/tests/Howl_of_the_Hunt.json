[
  {
    "name": "untaps an enchanted Wolf when it enters",
    "players": [
      { "hand": ["Howl of the Hunt"], "battlefield": [{ "name": "Brazen Wolves", "tapped": true }, "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Howl of the Hunt", "targets": ["Brazen Wolves"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Brazen Wolves": [4, 5] },
      "tapped": { "Brazen Wolves": false },
      "keywords": { "Brazen Wolves": ["Vigilance"] },
      "attached": { "Howl of the Hunt": "Brazen Wolves" }
    }
  },
  {
    "name": "a non-Wolf creature stays tapped",
    "players": [
      { "hand": ["Howl of the Hunt"], "battlefield": [{ "name": "Grizzly Bears", "tapped": true }, "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Howl of the Hunt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "tapped": { "Grizzly Bears": true }
    }
  }
]
