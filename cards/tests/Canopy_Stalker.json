[
  { "name": "must be blocked: declining to block is illegal",
    "players": [ { "battlefield": ["Canopy Stalker"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Canopy Stalker", "at": "p1" } ] }, { "block": [], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Canopy Stalker"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "dies with Bears in the same combat: gains 2 life (both died this turn)",
    "players": [ { "battlefield": ["Canopy Stalker"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Canopy Stalker", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Canopy Stalker" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "graveyard": ["Canopy Stalker"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "must be blocked: the Bears is forced to block (block declared empty), both die, Stalker gains 2",
    "players": [ { "battlefield": ["Canopy Stalker"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Canopy Stalker", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "graveyard_has": ["Canopy Stalker"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: Stalker counts itself when it dies alone: gains 1 life",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Canopy Stalker"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Canopy Stalker"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard_has": ["Canopy Stalker"] }, {} ] } },
  { "name": "ruling: all creatures the defending player controls are tapped, so Stalker is unblocked",
    "players": [ { "battlefield": ["Canopy Stalker"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "attack": [ { "card": "Canopy Stalker", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: one blocker satisfies must-be-blocked; the other creature need not block",
    "players": [ { "battlefield": ["Canopy Stalker"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Canopy Stalker", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Canopy Stalker" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "graveyard_has": ["Canopy Stalker"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ] } }
]
