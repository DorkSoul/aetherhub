[
 { "name": "destroys an attacker blocked by a legendary creature",
   "players": [ { "battlefield": ["Hill Giant"] }, { "hand": ["You Cannot Pass!"], "battlefield": ["Plains", "Isamaru, Hound of Konda"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [ { "blocker": "Isamaru, Hound of Konda", "attacker": "Hill Giant" } ] },
              { "pass": true },
              { "cast": "You Cannot Pass!", "player": 1, "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Hill Giant"] }, {} ] } },
 { "name": "cannot target a creature that blocked a nonlegendary creature",
   "players": [ { "battlefield": ["Hill Giant"] }, { "hand": ["You Cannot Pass!"], "battlefield": ["Plains", "Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
              { "pass": true },
              { "cast": "You Cannot Pass!", "player": 1, "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ {}, { "hand": ["You Cannot Pass!"] } ] } },
 { "name": "ruling: the legendary blocker died in combat, but the Hill Giant it blocked is still a legal target",
   "players": [ { "battlefield": ["Hill Giant"] }, { "hand": ["You Cannot Pass!"], "battlefield": ["Plains", "Isamaru, Hound of Konda"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "block": [ { "blocker": "Isamaru, Hound of Konda", "attacker": "Hill Giant" } ] },
              { "advance_to": "Main2" },
              { "pass": true },
              { "cast": "You Cannot Pass!", "player": 1, "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Hill Giant"] }, { "graveyard_has": ["Isamaru, Hound of Konda"] } ] } },
 { "name": "ruling: a legendary attacker's blocker can be destroyed by You Cannot Pass! (blocked a legendary creature)",
   "players": [ { "hand": ["You Cannot Pass!"], "battlefield": ["Plains", "Hill Giant"] }, { "battlefield": ["Isamaru, Hound of Konda"] } ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "BeginCombat" },
              { "attack": [ { "card": "Isamaru, Hound of Konda", "at": "p0" } ], "player": 1 },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Isamaru, Hound of Konda" } ] },
              { "pass": true, "player": 1 },
              { "cast": "You Cannot Pass!", "targets": ["Hill Giant"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Hill Giant"] }, {} ] } }
]
