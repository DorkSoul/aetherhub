[
  { "name": "tap ability taps the enchanted creature",
    "players": [ { "hand": ["Second Wind"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Second Wind", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Second Wind", "ability": 0 }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": true } } },
  { "name": "the aura is tapped after using it: second activation illegal",
    "players": [ { "hand": ["Second Wind"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Second Wind", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Second Wind", "ability": 0 }, { "resolve": true }, { "activate": "Second Wind", "ability": 1, "illegal": true } ],
    "expect": { "tapped": { "Grizzly Bears": true } } },
  { "name": "untap ability untaps the enchanted creature and taps the aura",
    "players": [ { "hand": ["Second Wind"], "battlefield": ["Island", "Island", "Island", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Second Wind", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Second Wind", "ability": 1 }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": false, "Second Wind": true } } },
  { "name": "ruling: only the Aura's controller can use its ability: the creature's controller cannot",
    "players": [ { "hand": ["Second Wind"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Second Wind", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "pass": true }, { "activate": "Second Wind", "ability": 0, "player": 1, "illegal": true } ],
    "expect": { "tapped": { "Grizzly Bears": false } } },
  { "name": "ruling: the Aura's controller taps the opponent's creature with the Aura's ability",
    "players": [ { "hand": ["Second Wind"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Second Wind", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Second Wind", "ability": 0 }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": true } } }
]
