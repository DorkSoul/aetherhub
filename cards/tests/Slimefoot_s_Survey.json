[
  {
    "name": "searches up to two basic-type lands onto the battlefield tapped",
    "players": [
      { "hand": ["Slimefoot's Survey"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Plains", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Slimefoot's Survey" },
      { "resolve": true, "answers": [["Plains", "Island"]] }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Plains", "Island"], "library_count": 21 }, {} ],
      "tapped": { "Plains": true, "Island": true }
    }
  },
  {
    "name": "with no basic-type land in the library nothing enters the battlefield",
    "players": [
      { "hand": ["Slimefoot's Survey"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Slimefoot's Survey" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Plains", "Island"] }, {} ]
    }
  },
  {"name": "ruling: a nonbasic land that has a basic land type (Tropical Island) can be found",
   "players": [{ "hand": ["Slimefoot's Survey"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Tropical Island", "Grizzly Bears"] }, {}],
   "steps": [{ "cast": "Slimefoot's Survey" }, { "resolve": true, "answers": [["Tropical Island"]] }],
   "expect": {"players": [{ "battlefield_has": ["Tropical Island"] }, {}], "tapped": { "Tropical Island": true }}},
  {"name": "ruling: two cards with the same basic land type can both be searched for",
   "players": [{ "hand": ["Slimefoot's Survey"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Island", "Island", "Grizzly Bears"] }, {}],
   "steps": [{ "cast": "Slimefoot's Survey" }, { "resolve": true, "answers": [["Island", "Island"]] }],
   "expect": {"players": [{ "battlefield_has": ["Island", "Island"] }, {}], "tapped": { "Island": true }}}
]
