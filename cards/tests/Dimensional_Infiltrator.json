[
  {
    "name": "a nonland card exiled from the top stays on the battlefield",
    "players": [
      { "battlefield": ["Dimensional Infiltrator", "Wastes", "Island"] },
      { "library": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Dimensional Infiltrator", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dimensional Infiltrator"] },
        { "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "a land exiled: may return the creature to hand",
    "players": [
      { "battlefield": ["Dimensional Infiltrator", "Wastes", "Island"] },
      { "library": ["Forest"] }
    ],
    "steps": [
      { "activate": "Dimensional Infiltrator", "ability": 0 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
