        { "exile": ["Forest"] }
      ]
    }
  },
  {
    "name": "a land exiled: declining keeps the creature on the battlefield",
    "players": [
      { "battlefield": ["Dimensional Infiltrator", "Wastes", "Island"] },
      { "library": ["Forest"] }
    ],
    "steps": [
      { "activate": "Dimensional Infiltrator", "ability": 0 },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dimensional Infiltrator"], "hand_count": 0 },
        { "exile": ["Forest"] }
      ]
    }
