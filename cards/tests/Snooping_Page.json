[
  {
    "name": "repartee: a spell targeting a creature makes it unblockable this turn",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Snooping Page"], "library": ["Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true },
      { "attack": [ { "card": "Snooping Page", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Snooping Page" } ], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Hill Giant"] } ]
    }
  },
  {
    "name": "combat damage to a player draws a card and loses 1 life",
    "players": [
      { "battlefield": ["Snooping Page"], "library": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Snooping Page", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "life": 19, "hand_count": 1 }, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: repartee still makes the Page unblockable after the targeted creature has left the battlefield",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Snooping Page"], "library": ["Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "attack": [ { "card": "Snooping Page", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Snooping Page" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 19 },
        { "life": 18, "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  }
]
