   "steps": [ { "activate": "Mist Dancer", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Mist Dancer"] }, {} ] } },
 { "name": "encore exiles it and makes a hasty token copy for the opponent",
   "players": [ { "graveyard": ["Mist Dancer"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "activate": "Mist Dancer", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Mist Dancer"], "graveyard": [] }, {} ] } },
 { "name": "ruling: the encore token copies the printed card, not the counters it had on the battlefield",
   "players": [ { "hand": ["Wrath of God"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Island", "Island", "Island", "Island", "Island", "Island", "Island", { "name": "Mist Dancer", "counters": { "p1p1": 2 } }] }, {} ],
   "steps": [ { "cast": "Wrath of God" }, { "resolve": true }, { "activate": "Mist Dancer", "ability": 0 }, { "resolve": true } ],
