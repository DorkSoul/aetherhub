   "players": [ { "hand": ["Mist Dancer"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Mist Dancer" }, { "resolve": true } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] }, "keywords": { "Grizzly Bears": [] } } },
 { "name": "encore needs seven mana: with six lands it is not available",
