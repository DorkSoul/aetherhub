[
  { "name": "owner puts the creature second from the top; opponent draws the top card first",
    "players": [ { "hand": ["Happy Hogan, Bodyguard"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
                 { "battlefield": ["Grizzly Bears"], "library": ["Mountain", "Forest"] } ],
    "steps": [ { "cast": "Happy Hogan, Bodyguard" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Happy Hogan, Bodyguard"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "owner chooses the bottom of the library",
    "players": [ { "hand": ["Happy Hogan, Bodyguard"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
                 { "battlefield": ["Grizzly Bears"], "library": ["Mountain", "Forest"] } ],
    "steps": [ { "cast": "Happy Hogan, Bodyguard" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Happy Hogan, Bodyguard"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "vigilance: attacks without tapping",
    "players": [ { "battlefield": ["Happy Hogan, Bodyguard"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [ { "card": "Happy Hogan, Bodyguard", "at": "p1" } ] }, { "block": [] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ], "tapped": { "Happy Hogan, Bodyguard": false } } }
]
