[
  {
    "name": "two targets cost {2}{G} + {1}{G}: both get +2/+2 and untap",
    "players": [
      {
        "hand": ["Colossal Heroics"],
        "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest",
          { "name": "Grizzly Bears", "tapped": true },
          { "name": "Hill Giant", "tapped": true }]
      },
      {}
    ],
    "steps": [
      { "cast": "Colossal Heroics", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [5, 5] },
      "players": [ { "graveyard": ["Colossal Heroics"] }, {} ]
    }
  },
  {
