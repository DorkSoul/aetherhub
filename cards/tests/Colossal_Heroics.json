      { "hand": ["Colossal Heroics"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Colossal Heroics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "strive: two targets use all five lands, so Sol Ring (cost 1) is uncastable afterwards",
    "players": [
      { "hand": ["Colossal Heroics", "Sol Ring"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Colossal Heroics", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true },
      { "cast": "Sol Ring", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Sol Ring"] }, {} ],
      "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [5, 5] }
    }
  },
  {
    "name": "ruling: untapped creatures can be targeted; both get +2/+2 and stay untapped",
    "players": [
      { "hand": ["Colossal Heroics"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Colossal Heroics", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
