  {
    "name": "ruling: one target removed in response; the spell still resolves for the legal target only",
    "players": [
      { "hand": ["Colossal Heroics"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears", "Hill Giant"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Colossal Heroics", "targets": ["Grizzly Bears", "Hill Giant"] },
