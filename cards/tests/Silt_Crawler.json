[
  {
    "name": "enters and taps every land you control",
    "players": [
      { "hand": ["Silt Crawler"], "battlefield": ["Forest", "Forest", "Plains", "Island"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Silt Crawler" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Island": true, "Silt Crawler": false },
      "pt": { "Silt Crawler": [3, 3] }
    }
  },
  {
    "name": "does not tap the opponent's lands",
    "players": [
      { "hand": ["Silt Crawler"], "battlefield": ["Forest", "Forest", "Plains"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Silt Crawler" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Mountain": false }
    }
  }
]
