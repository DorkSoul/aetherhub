[
  { "name": "when it dies Dread Whispers can be cast from the graveyard and the creature half cannot",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mosswood Dreadknight // Dread Whispers", "Mountain", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Mosswood Dreadknight // Dread Whispers"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Mosswood Dreadknight // Dread Whispers", "illegal": true },
      { "cast": "Mosswood Dreadknight // Dread Whispers", "face": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Mosswood Dreadknight // Dread Whispers"], "graveyard": ["Lightning Bolt"], "life": 19 }, {} ] } },
  { "name": "the permission lasts through the end of your next turn",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mosswood Dreadknight // Dread Whispers", "Mountain", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Mosswood Dreadknight // Dread Whispers"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Mosswood Dreadknight // Dread Whispers", "face": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Mosswood Dreadknight // Dread Whispers"], "life": 19 }, {} ] } },
  { "name": "after your next turn the permission is gone",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mosswood Dreadknight // Dread Whispers", "Mountain", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Mosswood Dreadknight // Dread Whispers"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Mosswood Dreadknight // Dread Whispers", "face": true, "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Mosswood Dreadknight // Dread Whispers"] }, {} ] } },
  { "name": "the creature half is a 3/2 trampler",
    "players": [ { "hand": ["Mosswood Dreadknight // Dread Whispers"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Mosswood Dreadknight // Dread Whispers" }, { "resolve": true } ],
    "expect": { "pt": { "Mosswood Dreadknight // Dread Whispers": [3, 2] } } },
  { "name": "ruling: a countered adventure goes to the graveyard, not exile, and the creature cannot be cast from there",
    "players": [ { "hand": ["Mosswood Dreadknight // Dread Whispers"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Mosswood Dreadknight // Dread Whispers", "face": true },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Dread Whispers" } ] },
      { "resolve": true },
      { "cast": "Mosswood Dreadknight // Dread Whispers", "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Mosswood Dreadknight // Dread Whispers"], "exile": [] }, {} ] } },
  { "name": "ruling: the creature half cast from exile is sorcery speed, not castable in the end step",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mosswood Dreadknight // Dread Whispers", "Mountain", "Swamp", "Swamp", "Swamp", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Mosswood Dreadknight // Dread Whispers"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Mosswood Dreadknight // Dread Whispers", "face": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "cast": "Mosswood Dreadknight // Dread Whispers", "illegal": true }
    ],
    "expect": { "players": [ { "exile": ["Mosswood Dreadknight // Dread Whispers"] }, {} ] } },
  { "name": "ruling: an adventure spell uses only its adventure characteristics (black sorcery, {1}{B})",
    "players": [ { "hand": ["Mosswood Dreadknight // Dread Whispers"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Mosswood Dreadknight // Dread Whispers", "face": true, "illegal": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } }
]
