[
 { "name": "manifests the top card of an opponent's library at their upkeep",
   "players": [ { "battlefield": ["Thieving Amalgam"] }, { "library": ["Forest", "Island", "Swamp", "Plains"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Thieving Amalgam", "Forest"] }, { "battlefield_lacks": ["Forest"] } ] } },
 { "name": "a creature you control that you don't own dies: its owner loses 2 life and you gain 2",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Thieving Amalgam", "Mountain"] }, { "library": ["Forest", "Island", "Swamp", "Plains"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "Main1" }, { "cast": "Lightning Bolt", "targets": ["Forest"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "life": 22 }, { "life": 18 } ] } },
 { "name": "a creature you own dying does not trigger it",
   "players": [ { "battlefield": ["Thieving Amalgam", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard_has": ["Grizzly Bears"] }, { "life": 20 } ] } },
 { "name": "ruling: a stolen creature dies at the same time as its controller's life reaches 0, so the controller loses before the trigger gains life",
   "players": [ { "life": 2, "battlefield": ["Thieving Amalgam"] }, { "library": ["Forest", "Island", "Swamp", "Plains"], "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "Main1", "player": 1 },
              { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
              { "block": [ { "blocker": "Forest", "attacker": "Hill Giant" } ], "player": 0 },
              { "advance_to": "Main2", "player": 1 } ],
   "expect": { "winner": 1 } }
]
