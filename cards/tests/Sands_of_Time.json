[
  {
    "name": "your upkeep: tapped permanents untap and untapped ones tap",
    "start": "Untap",
    "players": [
      { "battlefield": ["Sands of Time", { "name": "Forest", "tapped": true }, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Forest": false, "Grizzly Bears": true, "Sands of Time": true }
    }
  },
  {
    "name": "your upkeep does not touch an opponent's permanents",
    "start": "Untap",
    "players": [
      { "battlefield": ["Sands of Time"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Sands of Time": true }
    }
  },
  {
    "name": "opponent's upkeep: their tapped creature untaps",
    "start": "Untap",
    "players": [
      { "battlefield": ["Sands of Time"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: a tapped Sands of Time still triggers at your upkeep",
    "start": "Untap",
    "players": [
      { "battlefield": [{ "name": "Sands of Time", "tapped": true }, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Sands of Time": false, "Grizzly Bears": true }
    }
  }
]
