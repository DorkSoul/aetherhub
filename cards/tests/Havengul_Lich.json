[
  {
    "name": "cast a creature from my graveyard; Lich gains its activated ability until end of turn",
    "players": [
      { "graveyard": ["Prodigal Sorcerer"], "battlefield": ["Havengul Lich", "Island", "Island", "Island", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Havengul Lich", "ability": 0, "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "cast": "Prodigal Sorcerer" },
      { "resolve": true },
      { "activate": "Havengul Lich", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Havengul Lich", "Prodigal Sorcerer"] },
        { "life": 19 }
      ],
      "tapped": { "Havengul Lich": true }
    }
  },
  {
    "name": "a creature card in an opponent's graveyard can be cast too",
    "players": [
      { "battlefield": ["Havengul Lich", "Island", "Island", "Island", "Swamp"] },
      { "graveyard": ["Prodigal Sorcerer"] }
    ],
    "steps": [
      { "activate": "Havengul Lich", "ability": 0, "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "cast": "Prodigal Sorcerer" },
      { "resolve": true },
      { "activate": "Havengul Lich", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Havengul Lich", "Prodigal Sorcerer"] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "without the ability the graveyard card can't be cast",
    "players": [
      { "graveyard": ["Prodigal Sorcerer"], "battlefield": ["Havengul Lich", "Island", "Island", "Island", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Prodigal Sorcerer", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Prodigal Sorcerer"] },
        {}
      ]
    }
  },
  {
    "name": "the ability only reaches the targeted card",
    "players": [
      { "graveyard": ["Prodigal Sorcerer", "Grizzly Bears"], "battlefield": ["Havengul Lich", "Island", "Island", "Island", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Havengul Lich", "ability": 0, "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears", "Prodigal Sorcerer"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a creature card targeted but never cast gives Havengul Lich none of its abilities",
    "players": [
      { "graveyard": ["Prodigal Sorcerer"], "battlefield": ["Havengul Lich", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Havengul Lich", "ability": 0, "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "activate": "Havengul Lich", "ability": 32768, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Prodigal Sorcerer"], "battlefield_has": ["Havengul Lich"] },
        { "life": 20 }
      ]
    }
  }
]
