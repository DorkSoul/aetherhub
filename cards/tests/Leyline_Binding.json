   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [ { "cast": "Leyline Binding" }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Leyline Binding"] }, { "exile": ["Grizzly Bears"] } ] }
 },
 {
