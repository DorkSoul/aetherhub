[
 { "name": "kicked: 2 damage to target creature on entering",
   "players": [ { "hand": ["Torch Slinger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Torch Slinger", "answers": [true] },
              { "resolve": true, "targets": ["Grizzly Bears"] },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Torch Slinger"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "unkicked: no trigger",
   "players": [ { "hand": ["Torch Slinger"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Torch Slinger" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Torch Slinger"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: a copy of a kicked permanent is not kicked, so its enters trigger does nothing",
   "players": [ { "hand": ["Torch Slinger", "Clone"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Torch Slinger", "answers": [true] },
              { "resolve": true, "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "cast": "Clone" },
              { "resolve": true, "answers": [0] } ],
   "expect": { "players": [ { "battlefield_has": ["Torch Slinger", "Torch Slinger"], "life": 20 }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "ruling: kicker does not change mana value (Reanimate of a kicked Slinger loses 3 life)",
   "players": [ { "hand": ["Torch Slinger", "Lightning Bolt", "Reanimate"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Torch Slinger", "answers": [true] },
              { "resolve": true, "targets": ["Grizzly Bears"] },
              { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Torch Slinger"] },
              { "resolve": true },
              { "cast": "Reanimate", "targets": ["Torch Slinger"] },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Torch Slinger"], "life": 17 }, { "graveyard": ["Grizzly Bears"] } ] } }
