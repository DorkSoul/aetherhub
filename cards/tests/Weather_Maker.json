[
  {
    "name": "landfall puts a charge counter on it",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Weather Maker"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Weather Maker": { "charge": 1 } }
    }
  },
  {
    "name": "taps for mana of any color",
    "players": [
      { "battlefield": ["Weather Maker"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Weather Maker", "color": "G" }
    ],
    "expect": {
      "players": [ { "pool": { "G": 1 } }, {} ]
    }
  },
  {
    "name": "remove three charge counters: 3 damage to any target",
    "players": [
      { "battlefield": [{ "name": "Weather Maker", "counters": { "charge": 3 } }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Weather Maker", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] } ]
    }
  }
]
