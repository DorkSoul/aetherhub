[
  {
    "name": "ruling: an untap caused by a spell still triggers inspired (-3/-0 to the opponent's creature)",
    "players": [
      { "hand": ["Burst of Energy"], "battlefield": ["Plains", "Island", "Island", { "name": "Deepwater Hypnotist", "tapped": true }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Burst of Energy", "targets": ["Deepwater Hypnotist"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Grizzly Bears": [-1, 2] },
      "tapped": { "Deepwater Hypnotist": false }
    }
  },
  {
    "name": "ruling: the turn-based untap triggers inspired in the opponent's untap step, and it resolves before their main phase",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": [ { "name": "Deepwater Hypnotist", "tapped": true } ] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Grizzly Bears": [-1, 2] }
    }
  },
  {
    "name": "ruling: the inspired trigger from the untap step is put on the stack at the beginning of upkeep, not during the untap step",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": [ { "name": "Deepwater Hypnotist", "tapped": true } ] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Upkeep", "hold": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "stack_empty": false,
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: entering the battlefield does not trigger inspired",
    "players": [
      { "hand": ["Deepwater Hypnotist"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Deepwater Hypnotist" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Deepwater Hypnotist"] }, {} ],
      "stack_empty": true,
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]
