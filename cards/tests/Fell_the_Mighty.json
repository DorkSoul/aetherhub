[
  {
    "name": "destroys creatures with greater power than the target; equal power survives",
    "players": [
      {
        "hand": ["Fell the Mighty"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Hill Giant"]
      },
      {
        "battlefield": ["Grizzly Bears", "Serra Angel"]
      }
    ],
    "steps": [
      { "cast": "Fell the Mighty", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Fell the Mighty"], "battlefield_has": ["Hill Giant"] },
        { "graveyard": ["Serra Angel"], "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "the target survives even when it is the only creature",
    "players": [
      {
        "hand": ["Fell the Mighty"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Fell the Mighty", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Fell the Mighty"], "battlefield_has": ["Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "ruling: a shroud creature with power above the target's is destroyed (the spell does not target it)",
    "players": [
      {
        "hand": ["Fell the Mighty"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"]
      },
      {
        "battlefield": ["Blastoderm"]
      }
    ],
    "steps": [
      { "cast": "Fell the Mighty", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Fell the Mighty"], "battlefield_has": ["Grizzly Bears"] },
        { "graveyard_has": ["Blastoderm"] }
      ]
    }
  },
  {
    "name": "ruling: if the target is gone on resolution, Fell the Mighty does nothing",
    "players": [
      {
        "hand": ["Fell the Mighty"],
        "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Fell the Mighty", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Fell the Mighty", "Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]
