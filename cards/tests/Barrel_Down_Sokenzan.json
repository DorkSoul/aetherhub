[
  {
    "name": "returns the chosen Mountains and deals twice their number as damage",
    "players": [
      { "hand": ["Barrel Down Sokenzan"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Barrel Down Sokenzan", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [["Mountain", "Mountain"]] }
    ],
    "expect": {
      "players": [
        { "hand": ["Mountain", "Mountain"], "battlefield_has": ["Mountain"], "graveyard": ["Barrel Down Sokenzan"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "returning one Mountain deals only 2 damage",
    "players": [
      { "hand": ["Barrel Down Sokenzan"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Barrel Down Sokenzan", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": [["Mountain"]] }
    ],
    "expect": {
      "players": [
        { "hand": ["Mountain"], "graveyard": ["Barrel Down Sokenzan"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "returning no Mountains deals no damage",
    "players": [
      { "hand": ["Barrel Down Sokenzan"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Barrel Down Sokenzan", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Barrel Down Sokenzan"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the Mountains are returned on resolution, not as a cost",
    "players": [
      { "hand": ["Barrel Down Sokenzan"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Barrel Down Sokenzan", "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "battlefield_has": ["Mountain", "Mountain", "Mountain"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
