    "steps": [ { "activate": "Viashino Heretic", "targets": ["Sol Ring"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19, "graveyard": ["Sol Ring"] } ] }
  },
  {
    "name": "illegal without an artifact to target",
