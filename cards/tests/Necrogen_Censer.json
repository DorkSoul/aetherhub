    "players": [ { "hand": ["Necrogen Censer"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Necrogen Censer" }, { "resolve": true }, { "activate": "Necrogen Censer", "ability": 0, "targets": ["p1"] }, { "resolve": true }, { "activate": "Necrogen Censer", "ability": 0, "targets": ["p1"], "illegal": true } ],
