[
 {
  "name": "power equals the number of cards in your hand",
  "players": [
   {
    "hand": [
     "Forest",
     "Island",
     "Plains"
    ],
    "battlefield": [
     "Robobrain War Mind"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "pt": {
    "Robobrain War Mind": [
     3,
     5
    ]
   }
  }
 },
 {
  "name": "ETB gets one energy per artifact creature you control",
  "players": [
   {
    "hand": [
     "Robobrain War Mind"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island",
     "Ornithopter",
     "Ornithopter"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Robobrain War Mind"
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 3
    },
    {}
   ]
  }
 },
 {
  "name": "attacking: paying EEE draws a card",
  "players": [
   { "energy": 3, "hand": ["Forest", "Island", "Plains"], "battlefield": ["Robobrain War Mind"], "library": ["Island"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Robobrain War Mind", "at": "p1" } ] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": { "players": [ { "energy": 0, "hand_count": 4 }, {} ] }
 },
 {
  "name": "attacking: declining to pay keeps the energy and draws nothing",
  "players": [
   { "energy": 3, "hand": ["Forest", "Island", "Plains"], "battlefield": ["Robobrain War Mind"], "library": ["Island"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Robobrain War Mind", "at": "p1" } ] },
   { "resolve": true, "answers": [false] }
  ],
  "expect": { "players": [ { "energy": 3, "hand_count": 3 }, {} ] }
 },
 {
  "name": "attacking with only two energy: no payment and no draw",
  "players": [
   { "energy": 2, "hand": ["Forest", "Island", "Plains"], "battlefield": ["Robobrain War Mind"], "library": ["Island"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Robobrain War Mind", "at": "p1" } ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "energy": 2, "hand_count": 3 }, {} ] }
 },
 {
  "name": "ruling: ETB energy counts Robobrain itself when it is the only artifact creature",
  "players": [
   { "hand": ["Robobrain War Mind"], "battlefield": ["Island", "Island", "Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Robobrain War Mind" },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": { "players": [ { "energy": 1 }, {} ] }
 },
 {
  "name": "ruling: energy stays with the player across turns",
  "players": [
   { "energy": 3, "battlefield": ["Robobrain War Mind"] },
   {}
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1" }
  ],
  "expect": { "players": [ { "energy": 3 }, {} ] }
 },
 {
  "name": "ruling: a single payment of EEE draws one card even with six energy",
  "players": [
   { "energy": 6, "hand": ["Forest", "Island", "Plains"], "battlefield": ["Robobrain War Mind"], "library": ["Island", "Island"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Robobrain War Mind", "at": "p1" } ] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": { "players": [ { "energy": 3, "hand_count": 4 }, {} ] }
 },
 {
  "name": "ruling: energy is not tied to the permanent that gained it",
  "players": [
   { "energy": 3, "battlefield": ["Robobrain War Mind"] },
   { "battlefield": ["Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["Robobrain War Mind"], "player": 1 },
   { "resolve": true },
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["Robobrain War Mind"], "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "energy": 3, "graveyard": ["Robobrain War Mind"] },
    {}
   ]
  }
 }
]
