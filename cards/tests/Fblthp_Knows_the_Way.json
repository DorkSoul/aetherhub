[
  { "name": "X=2: finds two basics with different names and puts them in hand",
    "players": [ { "hand": ["Fblthp, Knows the Way"], "battlefield": ["Forest", "Forest", "Island", "Island"], "library": ["Forest", "Island", "Forest", "Swamp"] }, {} ],
    "steps": [ { "cast": "Fblthp, Knows the Way", "answers": [2] }, { "resolve": true, "answers": [["Forest", "Island"]] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest", "Island"], "battlefield_has": ["Fblthp, Knows the Way"] }, {} ] } },
  { "name": "duplicate names cannot both be taken: second Forest is not a distinct pick",
    "players": [ { "hand": ["Fblthp, Knows the Way"], "battlefield": ["Forest", "Forest", "Island", "Island"], "library": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Fblthp, Knows the Way", "answers": [2] }, { "resolve": true, "answers": [["Forest", "Forest"]] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"] }, {} ] } },
  { "name": "X=0: finds nothing",
    "players": [ { "hand": ["Fblthp, Knows the Way"], "battlefield": ["Forest", "Forest"], "library": ["Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Fblthp, Knows the Way", "answers": [0] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "battlefield_has": ["Fblthp, Knows the Way"] }, {} ] } },
  { "name": "domain: three basic land types among my lands make it 3/2",
    "players": [ { "battlefield": ["Forest", "Island", "Swamp", "Fblthp, Knows the Way"] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "pt": { "Fblthp, Knows the Way": [3, 2] } } },
  { "name": "domain: one basic land type makes it 1/2",
    "players": [ { "battlefield": ["Forest", "Fblthp, Knows the Way"] }, {} ],
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "pt": { "Fblthp, Knows the Way": [1, 2] } } }
]
