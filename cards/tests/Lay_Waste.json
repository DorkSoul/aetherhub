[
  { "name": "destroys target land",
    "players": [ { "hand": ["Lay Waste"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Lay Waste", "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lay Waste", "Forest"] }, {} ] } },
  { "name": "cycling {2}: discard it and draw a card",
    "players": [ { "hand": ["Lay Waste"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Lay Waste", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Lay Waste"] }, {} ] } },
  { "name": "cycling needs {2}",
    "players": [ { "hand": ["Lay Waste"], "battlefield": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Lay Waste", "ability": 0, "illegal": true } ] },
  { "name": "ruling: cycling is an activated ability, so Stifle can counter it and no card is drawn",
    "players": [ { "hand": ["Lay Waste"], "battlefield": ["Mountain", "Mountain"] },
                 { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Lay Waste", "ability": 0 }, { "pass": true },
               { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Lay Waste" }] },
               { "pass": true, "player": 1 }, { "pass": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard_has": ["Lay Waste"] }, { "graveyard_has": ["Stifle"] } ] } },
  { "name": "ruling: cycling is not a spell, so Counterspell has no legal target and the card is still drawn",
    "players": [ { "hand": ["Lay Waste"], "battlefield": ["Mountain", "Mountain"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Lay Waste", "ability": 0 }, { "pass": true },
               { "cast": "Counterspell", "player": 1, "illegal": true },
               { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Lay Waste"] }, { "hand": ["Counterspell"] } ] } }
]
