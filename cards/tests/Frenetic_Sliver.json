[
  {
    "name": "winning the flip exiles it and returns it at the next end step",
    "seed": 3,
    "players": [ { "battlefield": ["Frenetic Sliver"] }, {} ],
    "steps": [
      { "activate": "Frenetic Sliver", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Frenetic Sliver"] }, {} ]
    }
  },
  {
    "name": "winning the flip: it is back on the battlefield after the end step",
    "seed": 3,
    "players": [ { "battlefield": ["Frenetic Sliver"] }, {} ],
    "steps": [
      { "activate": "Frenetic Sliver", "ability": 32768 },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Frenetic Sliver"] }, {} ]
    }
  },
  {
    "name": "losing the flip sacrifices it",
    "seed": 1,
    "players": [ { "battlefield": ["Frenetic Sliver"] }, {} ],
    "steps": [
      { "activate": "Frenetic Sliver", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Frenetic Sliver"] }, {} ]
    }
  },
  {
    "name": "ruling: activating again in response to itself still flips only one coin (a lost flip sacrifices it, the second activation does not exile it from the graveyard)",
    "seed": 1,
    "players": [ { "battlefield": ["Frenetic Sliver"] }, {} ],
    "steps": [
      { "activate": "Frenetic Sliver", "ability": 32768 },
      { "activate": "Frenetic Sliver", "ability": 32768 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Frenetic Sliver"], "exile": [] }, {} ]
    }
  },
  {
    "name": "a non-Sliver does not get the ability",
    "players": [ { "battlefield": ["Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Grizzly Bears", "ability": 32768, "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ]
    }
  }
]
