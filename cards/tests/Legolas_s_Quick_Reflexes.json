  ],
  "expect": {
   "players": [
    {},
    { "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: during split second the opponent can still tap for mana but not activate an ability",
  "players": [
   { "hand": ["Legolas's Quick Reflexes"], "battlefield": ["Forest", "Hill Giant"] },
   { "battlefield": [ { "name": "Prodigal Sorcerer", "sick": false }, "Mountain" ] }
  ],
  "steps": [
   { "cast": "Legolas's Quick Reflexes", "targets": ["Hill Giant"] },
   { "pass": true },
   { "activate": "Prodigal Sorcerer", "player": 1, "targets": ["p0"], "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "battlefield_has": ["Prodigal Sorcerer"] }
   ],
   "tapped": { "Prodigal Sorcerer": false }
  }
 },
 {
  "name": "ruling: a triggered ability still triggers while split second is on the stack",
  "players": [
   { "hand": ["Chalice of the Void", "Legolas's Quick Reflexes"], "battlefield": ["Island", "Island", "Forest"] },
   { "battlefield": ["Giant Spider"] }
  ],
  "steps": [
   { "cast": "Chalice of the Void", "answers": [1] },
   { "resolve": true },
   { "cast": "Legolas's Quick Reflexes", "targets": ["Giant Spider"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Legolas's Quick Reflexes"] },
    { "battlefield_has": ["Giant Spider"] }
   ]
  }
 }
