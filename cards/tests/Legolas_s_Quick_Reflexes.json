      { "hand": ["Legolas's Quick Reflexes"], "battlefield": ["Forest", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Legolas's Quick Reflexes", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "resolve": true, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Grizzly Bears"] } ],
      "tapped": { "Hill Giant": true }
    }
  },
 {
  "name": "ruling: after split second resolves, a spell can be cast again before the spell below it resolves",
  "players": [
   { "hand": ["Lightning Bolt", "Lightning Bolt", "Legolas's Quick Reflexes"], "battlefield": ["Mountain", "Mountain", "Forest", "Hill Giant"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "cast": "Legolas's Quick Reflexes", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 17, "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: a spell cast before split second resolves normally after it",
  "players": [
   { "hand": ["Lightning Bolt", "Legolas's Quick Reflexes"], "battlefield": ["Mountain", "Forest", "Hill Giant"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "cast": "Legolas's Quick Reflexes", "targets": ["Hill Giant"] },
   { "resolve": true },
