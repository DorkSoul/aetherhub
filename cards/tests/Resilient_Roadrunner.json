[
  {
    "name": "after {3} only creatures with haste can block it",
    "players": [
      { "battlefield": ["Resilient Roadrunner", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Resilient Roadrunner", "ability": 0 },
      { "resolve": true },
      { "attack": [{ "card": "Resilient Roadrunner", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Resilient Roadrunner" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 18 }] }
  },
  {
    "name": "a creature with haste can still block it",
    "players": [
      { "battlefield": ["Resilient Roadrunner", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Legion Loyalist"] }
    ],
    "steps": [
      { "activate": "Resilient Roadrunner", "ability": 0 },
      { "resolve": true },
      { "attack": [{ "card": "Resilient Roadrunner", "at": "p1" }] },
      { "block": [{ "blocker": "Legion Loyalist", "attacker": "Resilient Roadrunner" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "graveyard": ["Legion Loyalist"] }] }
  },
  {
    "name": "protection from Coyotes: a Coyote cannot block it (both attackers unblocked)",
    "players": [
      { "battlefield": ["Resilient Roadrunner", "Grizzly Bears", "Mountain"] },
      { "battlefield": ["Cunning Coyote"] }
    ],
    "steps": [
      { "attack": [{ "card": "Resilient Roadrunner", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Cunning Coyote", "attacker": "Resilient Roadrunner" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Resilient Roadrunner"] }, { "life": 16 }] }
  },
  {
    "name": "ruling: activating the last ability after being blocked does not make it unblocked",
    "players": [ { "battlefield": ["Resilient Roadrunner", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [{ "card": "Resilient Roadrunner", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Resilient Roadrunner" }] },
      { "activate": "Resilient Roadrunner", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Resilient Roadrunner"] }, { "graveyard": ["Grizzly Bears"], "life": 20 } ] }
  }
]
