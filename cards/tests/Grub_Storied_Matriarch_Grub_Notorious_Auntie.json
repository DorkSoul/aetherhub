[
  {
    "name": "first main phase: pay R to transform into Grub, Notorious Auntie",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Grub, Storied Matriarch", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Main1", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Grub, Notorious Auntie"] }, {} ] }
  },
  {
    "name": "declining to pay R keeps the front face",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Grub, Storied Matriarch", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Main1", "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Grub, Storied Matriarch"] }, {} ] }
  },
  {
    "name": "attacking: blight 1 on Grizzly Bears makes a tapped attacking copy that is sacrificed at the end step",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Grub, Storied Matriarch", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [
      { "advance_to": "Main1", "answers": [true] },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grub, Notorious Auntie", "at": "p1" } ] },
      { "resolve": true, "answers": [[1]] },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grub, Notorious Auntie", "Grizzly Bears"] }, { "life": 16 } ],
      "pt": { "Grizzly Bears": [1, 1] }
    }
  },
  {
    "name": "declining the blight makes no copy",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Grub, Storied Matriarch", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [
      { "advance_to": "Main1", "answers": [true] },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grub, Notorious Auntie", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grub, Notorious Auntie", "Grizzly Bears"] }, { "life": 18 } ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  { "name": "ETB: returns up to one target Goblin card from your graveyard to hand",
    "players": [ { "hand": ["Grub, Storied Matriarch"], "battlefield": ["Swamp", "Swamp", "Swamp"], "graveyard": ["Goblin Fire Fiend"] }, {} ],
    "steps": [ { "cast": "Grub, Storied Matriarch" }, { "resolve": true, "targets": ["Goblin Fire Fiend"] } ],
    "expect": { "players": [ { "hand": ["Goblin Fire Fiend"], "graveyard": [] }, {} ] } },
  { "name": "boundary: no Goblin in the graveyard: nothing returns",
    "players": [ { "hand": ["Grub, Storied Matriarch"], "battlefield": ["Swamp", "Swamp", "Swamp"], "graveyard": ["Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Grub, Storied Matriarch" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Lightning Bolt"] }, {} ] } },
  { "name": "transforming back into Grub, Storied Matriarch returns a Goblin card from the graveyard",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Grub, Storied Matriarch", "Mountain", "Swamp"], "graveyard": ["Goblin Fire Fiend"] }, {} ],
    "steps": [
      { "advance_to": "Main1", "answers": [true] },
      { "advance_to": "Main1" },
      { "advance_to": "Main1", "answers": [true], "targets": ["Goblin Fire Fiend"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grub, Storied Matriarch"], "graveyard": [], "hand_count": 2 }, {} ] } },
  { "name": "Notorious Auntie: pay B in your first main phase to transform back",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Grub, Storied Matriarch", "Mountain", "Swamp"] }, {} ],
    "steps": [ { "advance_to": "Main1", "answers": [true] }, { "advance_to": "Main1" }, { "advance_to": "Main1", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Grub, Storied Matriarch"] }, {} ] } }
]
