  "name": "with no counters it ends with two",
  "players": [
   { "hand": ["Invigorating Surge"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Invigorating Surge", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
