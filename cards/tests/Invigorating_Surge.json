   "players": [ {}, {} ]
  }
 },
 {
  "name": "ruling: the doubling uses the counters already there and Hardened Scales replaces each put (2 -> 4 -> 9)",
  "players": [
   { "hand": ["Invigorating Surge"], "battlefield": ["Forest", "Forest", "Forest", "Hardened Scales", { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 2 } }] },
   {}
  ],
  "steps": [
   { "cast": "Invigorating Surge", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Grizzly Bears": { "PlusOnePlusOne": 9 } },
   "pt": { "Grizzly Bears": [11, 11] },
   "players": [ {}, {} ]
  }
 }
