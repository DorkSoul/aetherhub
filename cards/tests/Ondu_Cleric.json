[
  { "name": "ruling: the Allies are counted as the trigger resolves (an Ally that leaves in response is not counted)",
    "players": [ { "hand": ["Ondu Cleric"], "battlefield": ["Plains", "Plains", "Ondu War Cleric"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Ondu Cleric" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["p0:Ondu War Cleric"], "player": 1 }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "life": 21, "graveyard_has": ["Ondu War Cleric"] }, { "life": 20 } ] } },
  { "name": "entering itself gains life equal to the number of Allies you control",
    "players": [ { "hand": ["Ondu Cleric"], "battlefield": ["Plains", "Plains", "Ondu War Cleric"] }, {} ],
    "steps": [ { "cast": "Ondu Cleric" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "life": 22 }, {} ] } },
  { "name": "another Ally entering triggers it",
    "players": [ { "hand": ["Ondu War Cleric"], "battlefield": ["Plains", "Plains", "Ondu Cleric"] }, {} ],
    "steps": [ { "cast": "Ondu War Cleric" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "life": 22 }, {} ] } },
  { "name": "a non-Ally creature entering does not trigger it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Plains", "Ondu Cleric"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } }
]
