    "steps": [ { "cast": "Claim the Precious", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Hill Giant"] } ] } },
  { "name": "cannot be cast without a creature to target",
