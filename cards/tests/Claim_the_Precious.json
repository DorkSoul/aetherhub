    "steps": [ { "cast": "Claim the Precious", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Claim the Precious"] }, {} ] } },
  { "name": "ruling: the Ring tempts you without a creature and the emblem is still gained",
    "players": [ { "hand": ["Claim the Precious"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Claim the Precious", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 1"] }, { "graveyard_has": ["Hill Giant"] } ] } },
  { "name": "ruling: a second tempt keeps one emblem, upgraded to The Ring 2",
    "players": [ { "hand": ["Claim the Precious", "Claim the Precious"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Hill Giant", "Coral Merfolk"] } ],
    "steps": [ { "cast": "Claim the Precious", "targets": ["Hill Giant"] }, { "resolve": true },
               { "cast": "Claim the Precious", "targets": ["Coral Merfolk"] }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 2"] }, { "graveyard_has": ["Hill Giant", "Coral Merfolk"] } ] } },
  { "name": "ruling: choosing the same Ring-bearer again still counts (Call of the Ring draws again)",
    "players": [ { "hand": ["Claim the Precious", "Claim the Precious"], "battlefield": ["Call of the Ring", "Grizzly Bears", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Hill Giant", "Coral Merfolk"] } ],
    "steps": [ { "cast": "Claim the Precious", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [true] },
               { "cast": "Claim the Precious", "targets": ["Coral Merfolk"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "life": 16, "hand_count": 2 }, {} ] } },
  { "name": "ruling: if every target is illegal when Claim the Precious resolves, the Ring does not tempt you",
    "players": [ { "hand": ["Claim the Precious"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] } ],
