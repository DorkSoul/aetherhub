[
  {
    "name": "boast after attacking taps target creature",
    "players": [
      {
        "battlefield": [
          "Goldmaw Champion",
          "Plains",
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Goldmaw Champion",
            "at": "p1"
          }
        ]
      },
      {
        "activate": "Goldmaw Champion",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "boast is not available if this creature did not attack this turn",
    "players": [
      {
        "battlefield": [
          "Goldmaw Champion",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Goldmaw Champion",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "boast works only once each turn",
    "players": [
      {
        "battlefield": [
          "Goldmaw Champion",
          "Plains",
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Goldmaw Champion",
            "at": "p1"
          }
        ]
      },
      {
        "activate": "Goldmaw Champion",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "activate": "Goldmaw Champion",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: boast can be activated after blockers are declared, before damage",
    "players": [{ "battlefield": ["Goldmaw Champion", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [{ "card": "Goldmaw Champion", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Goldmaw Champion" }], "player": 1 },
      { "activate": "Goldmaw Champion", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "ruling: boast can be activated in the postcombat main phase after combat damage",
    "players": [{ "battlefield": ["Goldmaw Champion", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [{ "card": "Goldmaw Champion", "at": "p1" }] },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" },
      { "activate": "Goldmaw Champion", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Grizzly Bears": true }, "players": [{}, { "life": 18 }] }
  }
]
