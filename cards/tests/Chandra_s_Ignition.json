 {
  "name": "ruling: if the target dies in response, Ignition does nothing (no damage at all)",
  "players": [
   { "hand": ["Chandra's Ignition"], "battlefield": ["Mountain", "Mountain", "Mountain", "Forest", "Forest", "Hill Giant", "Llanowar Elves"] },
