  {
    "name": "after a historic spell a Grizzly Bears block is illegal: the Runner is unblocked and survives",
    "players": [
      { "hand": ["Sol Ring"], "battlefield": ["Island", "Relic Runner", "Savannah Lions"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Sol Ring" },
      { "resolve": true },
      { "attack": [ { "card": "Relic Runner", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Relic Runner" }, { "blocker": "Hill Giant", "attacker": "Savannah Lions" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Relic Runner"] }, { "life": 18 } ] }
