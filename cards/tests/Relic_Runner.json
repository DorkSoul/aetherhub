      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Relic Runner" } ] },
      { "cast": "Sol Ring" },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Relic Runner"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] }
