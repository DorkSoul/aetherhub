  {
    "name": "ruling: a historic spell cast after the block does not make the blocked Runner unblocked",
    "players": [
      { "hand": ["Sol Ring"], "battlefield": ["Island", "Vedalken Orrery", "Relic Runner"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
