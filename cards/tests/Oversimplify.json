[
  { "name": "exiles every creature; each player gets a Fractal with counters equal to the power of their exiled creatures",
    "players": [ { "hand": ["Oversimplify"], "battlefield": ["Forest", "Forest", "Forest", "Island", "Island", "Grizzly Bears", "Hill Giant"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Oversimplify" }, { "resolve": true } ],
    "expect": { "pt": { "Fractal 0-0 Green Blue": [5, 5] },
      "players": [ { "exile": ["Grizzly Bears", "Hill Giant"], "graveyard": ["Oversimplify"] }, { "exile": ["Serra Angel"] } ] } },
  { "name": "a player with no creatures gets a 0/0 Fractal that dies",
    "players": [ { "hand": ["Oversimplify"], "battlefield": ["Forest", "Forest", "Forest", "Island", "Island", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Oversimplify" }, { "resolve": true } ],
    "expect": { "pt": { "Fractal 0-0 Green Blue": [3, 3] }, "players": [ { "exile": ["Hill Giant"] }, { "battlefield": [] } ] } },
  { "name": "counters on an exiled creature raise the power that counts",
    "players": [ { "hand": ["Oversimplify"], "battlefield": [ "Forest", "Forest", "Forest", "Island", "Island", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } } ] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Oversimplify" }, { "resolve": true } ],
    "expect": { "pt": { "Fractal 0-0 Green Blue": [4, 4] }, "players": [ { "exile": ["Grizzly Bears"], "battlefield_has": ["Fractal 0-0 Green Blue"] }, { "exile": ["Hill Giant"], "battlefield_has": ["Fractal 0-0 Green Blue"] } ] } },
  { "name": "noncreature permanents stay and the Fractals are not exiled",
    "players": [ { "hand": ["Oversimplify"], "battlefield": ["Forest", "Forest", "Forest", "Island", "Island"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Oversimplify" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Fractal 0-0 Green Blue"] }, { "battlefield_has": ["Sol Ring"] } ] } },
  { "name": "ruling: last-known power includes an anthem bonus the exiled creature had on the battlefield",
    "players": [ { "hand": ["Oversimplify"], "battlefield": ["Glorious Anthem", "Forest", "Forest", "Forest", "Island", "Island", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Oversimplify" }, { "resolve": true } ],
    "expect": { "pt": { "Fractal 0-0 Green Blue": [5, 5] }, "players": [ { "exile": ["Hill Giant"], "graveyard": ["Oversimplify"], "battlefield_has": ["Glorious Anthem"] }, { "battlefield": [] } ] } },
  { "name": "ruling: a commander exiled this way is counted along with the other creatures",
    "commander": true,
    "players": [ { "hand": ["Oversimplify"], "command": ["Hill Giant"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Forest", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Hill Giant" }, { "resolve": true }, { "cast": "Oversimplify" }, { "resolve": true } ],
    "expect": { "pt": { "Fractal 0-0 Green Blue": [5, 5] }, "players": [ { "exile": ["Grizzly Bears"], "graveyard": ["Oversimplify"] }, { "battlefield": [] } ] } }
]
