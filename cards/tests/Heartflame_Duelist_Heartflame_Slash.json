[
  {
    "name": "lifelink from Heartflame Duelist: Heartflame Slash gains its controller 3 life",
    "players": [
      { "hand": ["Heartflame Duelist // Heartflame Slash"], "battlefield": ["Heartflame Duelist // Heartflame Slash", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "battlefield_has": ["Heartflame Duelist // Heartflame Slash"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "without Heartflame Duelist on the battlefield the Slash does not gain life",
    "players": [
      { "hand": ["Heartflame Duelist // Heartflame Slash"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "lifelink applies to the Slash when it hits a creature too",
    "players": [
      { "hand": ["Heartflame Duelist // Heartflame Slash"], "battlefield": ["Heartflame Duelist // Heartflame Slash", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "battlefield_has": ["Heartflame Duelist // Heartflame Slash"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: lifelink from a Slash aimed at its own controller gains and loses 3 at once, so life is unchanged",
    "players": [
      { "hand": ["Heartflame Duelist // Heartflame Slash"], "battlefield": ["Heartflame Duelist // Heartflame Slash", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": true, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield_has": ["Heartflame Duelist // Heartflame Slash"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: a resolved Adventure spell is exiled, not put into the graveyard",
    "players": [
      { "hand": ["Heartflame Duelist // Heartflame Slash"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Heartflame Duelist // Heartflame Slash"], "graveyard": [] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: an Adventure spell countered on the stack is not exiled and goes to the graveyard",
    "players": [
      { "hand": ["Heartflame Duelist // Heartflame Slash"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": true, "targets": ["p1"] },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Heartflame Slash" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": [], "graveyard_has": ["Heartflame Duelist // Heartflame Slash"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: after the Slash resolves its controller may cast the creature from exile as a permanent spell",
    "players": [
      { "hand": ["Heartflame Duelist // Heartflame Slash"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": true, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Heartflame Duelist // Heartflame Slash", "face": false },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": [], "battlefield_has": ["Heartflame Duelist // Heartflame Slash"] },
        { "life": 17 }
      ]
    }
  }
]
