[
  {"name": "takes the creature blocking it at end of combat",
   "players": [
     {"battlefield": ["The Wretched"]},
     {"battlefield": ["Hill Giant"]}
   ],
   "steps": [
     {"attack": [{"card": "The Wretched", "at": "p1"}]},
     {"block": [{"blocker": "Hill Giant", "attacker": "The Wretched"}]},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"battlefield_has": ["The Wretched", "Hill Giant"]}, {"battlefield": []}]}},
  {"name": "does not take creatures blocking a different attacker",
   "players": [
     {"battlefield": ["The Wretched", "Savannah Lions"]},
     {"battlefield": ["Grizzly Bears", "Hill Giant"]}
   ],
   "steps": [
     {"attack": [{"card": "The Wretched", "at": "p1"}, {"card": "Savannah Lions", "at": "p1"}]},
     {"block": [{"blocker": "Grizzly Bears", "attacker": "The Wretched"}, {"blocker": "Hill Giant", "attacker": "Savannah Lions"}]},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"battlefield_has": ["The Wretched"], "battlefield_lacks": ["Hill Giant"]}, {"battlefield_has": ["Hill Giant"]}]}},
  {"name": "ruling: takes every creature blocking it, not just one",
   "players": [
     {"battlefield": ["The Wretched"]},
     {"battlefield": ["Wall of Wood", "Wall of Stone"]}
   ],
   "steps": [
     {"attack": [{"card": "The Wretched", "at": "p1"}]},
     {"block": [{"blocker": "Wall of Wood", "attacker": "The Wretched"}, {"blocker": "Wall of Stone", "attacker": "The Wretched"}]},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"battlefield_has": ["The Wretched", "Wall of Wood", "Wall of Stone"]}, {"battlefield": []}]}},
  {"name": "ruling: a blocker that regenerated was removed from combat, so it is not taken",
   "players": [
     {"battlefield": ["The Wretched"]},
     {"battlefield": ["Drudge Skeletons", "Hill Giant", "Swamp"]}
   ],
   "steps": [
     {"attack": [{"card": "The Wretched", "at": "p1"}]},
     {"block": [{"blocker": "Drudge Skeletons", "attacker": "The Wretched"}, {"blocker": "Hill Giant", "attacker": "The Wretched"}]},
     {"pass": true},
     {"activate": "Drudge Skeletons", "ability": 0, "player": 1},
     {"pass": true, "player": 1},
     {"pass": true},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"battlefield_has": ["The Wretched", "Hill Giant"]}, {"battlefield_has": ["Drudge Skeletons"], "battlefield_lacks": ["Hill Giant"]}]}},
  {"name": "ruling: destroyed during combat, the ability does not trigger and the blocker is not taken",
   "players": [
     {"battlefield": ["The Wretched"]},
     {"battlefield": ["Craw Wurm"]}
   ],
   "steps": [
     {"attack": [{"card": "The Wretched", "at": "p1"}]},
     {"block": [{"blocker": "Craw Wurm", "attacker": "The Wretched"}]},
     {"advance_to": "Main2"}
   ],
   "expect": {"players": [{"graveyard_has": ["The Wretched"], "battlefield_lacks": ["Craw Wurm"]}, {"battlefield_has": ["Craw Wurm"]}]}},
  {"name": "ruling: when The Wretched leaves the battlefield, the stolen blocker returns to its controller",
   "players": [
     {"hand": ["Murder"], "battlefield": ["The Wretched", "Swamp", "Swamp", "Swamp"]},
     {"battlefield": ["Hill Giant"]}
   ],
   "steps": [
     {"attack": [{"card": "The Wretched", "at": "p1"}]},
     {"block": [{"blocker": "Hill Giant", "attacker": "The Wretched"}]},
     {"advance_to": "Main2"},
     {"cast": "Murder", "targets": ["The Wretched"]},
     {"resolve": true}
   ],
   "expect": {"players": [{"graveyard_has": ["The Wretched"], "battlefield_lacks": ["Hill Giant"]}, {"battlefield_has": ["Hill Giant"]}]}}
]
