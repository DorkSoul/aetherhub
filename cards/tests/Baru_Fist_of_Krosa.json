[
  { "name": "a Forest entering pumps your green creatures and gives them trample",
    "players": [ { "hand": ["Forest"], "battlefield": ["Baru, Fist of Krosa", "Grizzly Bears"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [3, 3], "Baru, Fist of Krosa": [5, 5] }, "keywords": { "Grizzly Bears": ["Trample"] } } },
  { "name": "grandeur discards another Baru to make an X/X Wurm with X your lands",
