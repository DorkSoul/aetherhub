    "steps": [ { "activate": "Baru, Fist of Krosa", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Baru, Fist of Krosa"], "battlefield_has": ["Wurm 0-0"] }, {} ], "pt": { "Wurm 0-0": [3, 3] } } },
