    "expect": { "players": [ { "hand": ["Baru, Fist of Krosa"] }, {} ] } },
  { "name": "ruling: an opponent's Forest pumps only your green creatures",
    "players": [ { "battlefield": ["Baru, Fist of Krosa"] }, { "hand": ["Forest"], "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "play_land": "Forest", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Baru, Fist of Krosa": [5, 5], "Grizzly Bears": [2, 2] }, "keywords": { "Baru, Fist of Krosa": ["Trample"] } } },
  { "name": "ruling: the Wurm's X is fixed on resolution and ignores a land played later",
    "players": [ { "hand": ["Baru, Fist of Krosa", "Baru, Fist of Krosa", "Forest"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Baru, Fist of Krosa", "ability": 0 }, { "resolve": true }, { "play_land": "Forest" } ],
