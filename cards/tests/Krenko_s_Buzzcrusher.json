      {
        "hand": [
          "Krenko's Buzzcrusher"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Forest"
        ]
      }
