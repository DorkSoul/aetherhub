[
  {
    "name": "each player may destroy a nonbasic land, its controller searches for a basic tapped",
    "players": [
      {
        "hand": [
          "Krenko's Buzzcrusher"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Boros Garrison"
        ],
        "library": [
          "Island"
        ]
      },
      {
        "battlefield": [
          "Fountain of Cho",
          "Forest"
        ],
        "library": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Krenko's Buzzcrusher"
      },
      {
        "resolve": true,
