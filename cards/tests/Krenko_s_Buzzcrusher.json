  {
    "name": "ruling: the choice is not targeting, so a hexproof nonbasic land (Lotus Field) is still destroyed",
    "players": [
      {
        "hand": ["Krenko's Buzzcrusher"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Island"]
      },
      {
        "battlefield": ["Lotus Field"],
        "library": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Krenko's Buzzcrusher" },
      { "resolve": true, "answers": [["Lotus Field"], true, "Mountain"] }
