 {
  "name": "ruling: an Aura stays attached to its creature when that creature is stolen",
  "players": [
   { "hand": ["Agent of Treachery"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "hand": ["Pacifism"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "cast": "Pacifism", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "cast": "Agent of Treachery" },
   { "resolve": true, "targets": ["Grizzly Bears"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Agent of Treachery", "Grizzly Bears"] },
    { "battlefield_has": ["Pacifism", "Plains"] }
   ],
   "attached": { "Pacifism": "Grizzly Bears" }
  }
 },
 {
  "name": "ruling: gaining control of an Aura does not change what it is attached to",
  "players": [
   { "hand": ["Agent of Treachery"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "hand": ["Pacifism"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] }
