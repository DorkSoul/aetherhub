   { "advance_to": "Main1" },
   { "cast": "Pacifism", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Main1" },
   { "cast": "Agent of Treachery" },
   { "resolve": true, "targets": ["Pacifism"] }
