    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Fumulus, the Infestation", "Insect 1-1 Black Flying", "Viscera Seer"], "graveyard": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: sacrificing Fumulus itself still creates an Insect",
    "players": [
      { "battlefield": ["Fumulus, the Infestation", "Viscera Seer"], "library": ["Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "activate": "Viscera Seer", "answers": ["Fumulus, the Infestation"] },
