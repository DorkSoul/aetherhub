        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a nontoken creature sacrificed to pay an ability's cost still creates an Insect",
    "players": [
      { "battlefield": ["Fumulus, the Infestation", "Viscera Seer", "Grizzly Bears"], "library": ["Lightning Bolt"] },
      {}
