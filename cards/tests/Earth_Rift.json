[
  { "name": "destroys target land",
    "players": [ { "hand": ["Earth Rift"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Plains"] } ],
    "steps": [
      { "cast": "Earth Rift", "targets": ["Plains"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Earth Rift"] }, { "battlefield": [], "graveyard": ["Plains"] } ]
    }
  },
  { "name": "flashback for {5}{R}{R} destroys a land and exiles the card afterward",
    "players": [ { "graveyard": ["Earth Rift"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest"] } ],
    "steps": [
      { "cast": "Earth Rift", "alt": 0, "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Earth Rift"], "graveyard": [] }, { "battlefield": [], "graveyard": ["Forest"] } ]
    }
  },
  { "name": "ruling: flashback needs the full seven mana, so six lands cannot pay {5}{R}{R}",
    "players": [ { "graveyard": ["Earth Rift"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "cast": "Earth Rift", "alt": 0, "targets": ["Forest"], "illegal": true } ],
    "expect": { "players": [ { "graveyard_has": ["Earth Rift"] }, { "battlefield_has": ["Forest"] } ] } },
  { "name": "ruling: flashback is cast at sorcery speed, so it is illegal on the opponent's turn",
    "players": [ { "graveyard": ["Earth Rift"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Earth Rift", "alt": 0, "targets": ["Forest"], "illegal": true } ],
    "expect": { "players": [ { "graveyard_has": ["Earth Rift"] }, { "battlefield_has": ["Forest"] } ] } }
]
