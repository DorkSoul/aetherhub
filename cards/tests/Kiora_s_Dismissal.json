[
 {
  "name": "two enchantments for {U}{U}: both return to their owners' hands",
  "players": [
   {
    "hand": [
     "Kiora's Dismissal"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Journey to Nowhere"
    ]
   },
   {
    "battlefield": [
     "Ghostly Prison"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Kiora's Dismissal",
    "targets": [
     "Journey to Nowhere",
     "Ghostly Prison"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Journey to Nowhere"
     ],
     "graveyard": [
      "Kiora's Dismissal"
     ]
    },
    {
     "hand": [
      "Ghostly Prison"
     ]
    }
   ]
  }
 },
 {
  "name": "one target costs only {U}: the single enchantment returns",
  "players": [
   {
    "hand": [
     "Kiora's Dismissal"
    ],
    "battlefield": [
     "Island",
     "Journey to Nowhere"
    ]
   },
   {
    "battlefield": [
     "Ghostly Prison"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Kiora's Dismissal",
    "targets": [
     "Journey to Nowhere"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [
      "Journey to Nowhere"
     ]
    },
    {
     "battlefield_has": [
      "Ghostly Prison"
     ]
    }
   ]
  }
 },
 {
  "name": "strive: two targets cost UU, so with two Islands a {U} Opt is no longer castable afterwards",
  "players": [
   { "hand": ["Kiora's Dismissal", "Opt"], "battlefield": ["Island", "Island", "Journey to Nowhere"] },
   { "battlefield": ["Ghostly Prison"] }
  ],
  "steps": [
   { "cast": "Kiora's Dismissal", "targets": ["Journey to Nowhere", "Ghostly Prison"] },
   { "resolve": true },
   { "cast": "Opt", "illegal": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 2, "graveyard": ["Kiora's Dismissal"] },
    { "hand": ["Ghostly Prison"] }
   ]
  }
 },
 {
  "name": "ruling: an illegal target is skipped and the legal enchantment still returns",
  "players": [
   { "hand": ["Pacifism", "Kiora's Dismissal"], "battlefield": ["Plains", "Plains", "Island", "Island", "Blessed Sanctuary"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Savannah Lions"] }
  ],
  "steps": [
   { "cast": "Pacifism", "targets": ["Savannah Lions"] },
   { "resolve": true },
   { "cast": "Kiora's Dismissal", "targets": ["Pacifism", "Blessed Sanctuary"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Savannah Lions"] },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Blessed Sanctuary"], "graveyard_has": ["Pacifism", "Kiora's Dismissal"] },
    { "graveyard_has": ["Savannah Lions", "Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: all targets illegal: the spell does nothing",
  "players": [
   { "hand": ["Pacifism", "Kiora's Dismissal"], "battlefield": ["Plains", "Plains", "Island", "Blessed Sanctuary"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Savannah Lions"] }
  ],
  "steps": [
   { "cast": "Pacifism", "targets": ["Savannah Lions"] },
   { "resolve": true },
   { "cast": "Kiora's Dismissal", "targets": ["Pacifism"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Savannah Lions"] },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": [], "graveyard_has": ["Pacifism", "Kiora's Dismissal"], "battlefield_has": ["Blessed Sanctuary"] },
    { "graveyard_has": ["Savannah Lions"] }
   ]
  }
 },
 {
  "name": "ruling: a strive spell may be cast with no targets",
  "players": [
   { "hand": ["Kiora's Dismissal"], "battlefield": ["Island", "Blessed Sanctuary"] },
   {}
  ],
  "steps": [
   { "cast": "Kiora's Dismissal", "targets": [] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Blessed Sanctuary"], "graveyard": ["Kiora's Dismissal"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: strive: a second target costs {U} more, so one Island cannot pay for two targets",
  "players": [
   { "hand": ["Kiora's Dismissal"], "battlefield": ["Island", "Journey to Nowhere"] },
   { "battlefield": ["Ghostly Prison"] }
  ],
  "steps": [
   { "cast": "Kiora's Dismissal", "targets": ["Journey to Nowhere", "Ghostly Prison"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Kiora's Dismissal"], "battlefield_has": ["Journey to Nowhere"] },
    { "battlefield_has": ["Ghostly Prison"] }
   ]
  }
 }
]
