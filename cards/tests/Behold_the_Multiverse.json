[
  { "name": "cast for {3}{U}: draws two cards",
    "players": [ { "hand": ["Behold the Multiverse"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Behold the Multiverse" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Behold the Multiverse"], "hand_count": 2 }, {} ] } },
  { "name": "foretold for {2} then cast for {1}{U} on a later turn",
    "players": [ { "hand": ["Behold the Multiverse"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Behold the Multiverse", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" },
               { "cast": "Behold the Multiverse", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Behold the Multiverse"], "hand_count": 2 }, {} ] } },
  { "name": "foretold card cannot be cast the same turn",
    "players": [ { "hand": ["Behold the Multiverse"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Behold the Multiverse", "ability": 0 }, { "resolve": true }, { "cast": "Behold the Multiverse", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Behold the Multiverse"] }, {} ] } },
  { "name": "ruling: a foretold instant can be cast on the opponent's turn",
    "players": [ { "hand": ["Behold the Multiverse"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Behold the Multiverse", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" },
               { "pass": true, "player": 1 }, { "cast": "Behold the Multiverse", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Behold the Multiverse"], "hand_count": 2 }, {} ] } },
  { "name": "ruling: a foretold sorcery cannot be cast on the opponent's turn",
    "players": [ { "hand": ["Doomskar"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Doomskar", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" },
               { "pass": true, "player": 1 }, { "cast": "Doomskar", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Doomskar"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: foretelling is a special action that can be taken in response to a spell",
    "players": [ { "hand": ["Behold the Multiverse", "Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Behold the Multiverse", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Behold the Multiverse"], "graveyard": ["Lightning Bolt"], "hand_count": 0 }, { "life": 17 } ] } }
]
