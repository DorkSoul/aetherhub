[
  {
    "name": "enchanting a nonbasic land destroys it when it becomes tapped",
    "players": [
      {
        "hand": [
          "Uncontrolled Infestation"
        ],
        "battlefield": [
          "Undercity Sewers",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Uncontrolled Infestation",
        "targets": [
          "Undercity Sewers"
        ]
      },
      {
        "resolve": true
      },
      {
        "tap_for_mana": "Undercity Sewers",
        "color": "B"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Undercity Sewers"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "cannot enchant a basic land",
    "players": [
      {
        "hand": [
          "Uncontrolled Infestation"
        ],
        "battlefield": [
          "Forest",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Uncontrolled Infestation",
        "targets": [
          "Forest"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Uncontrolled Infestation"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: enchanting an already-tapped land does not destroy it",
    "players": [
      {
        "hand": ["Uncontrolled Infestation"],
        "battlefield": ["Undercity Sewers", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Undercity Sewers", "color": "B" },
      { "cast": "Uncontrolled Infestation", "targets": ["Undercity Sewers"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Undercity Sewers"] },
        {}
      ],
      "tapped": { "Undercity Sewers": true }
    }
  }
]