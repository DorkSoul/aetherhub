[
  {
    "name": "enters and draws a card",
    "players": [
      {
        "hand": [
          "Sarulf's Packmate"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Sarulf's Packmate"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "battlefield_has": [
            "Sarulf's Packmate"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "foretold on your turn, then cast later for 1G and draws a card",
    "players": [
      {
        "hand": [
          "Sarulf's Packmate"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sarulf's Packmate",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Sarulf's Packmate",
        "alt": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2,
          "battlefield_has": [
            "Sarulf's Packmate"
          ],
          "exile": []
        },
        {}
      ]
    }
  },
  {
    "name": "foretell is not allowed on the opponent's turn",
    "players": [
      {
        "hand": [
          "Sarulf's Packmate"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "pass": true,
        "player": 1
      },
      {
        "activate": "Sarulf's Packmate",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Sarulf's Packmate"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: foretell is a special action, so it can be taken in response to your own spell",
    "players": [
      { "hand": ["Sarulf's Packmate", "Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "activate": "Sarulf's Packmate", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Sarulf's Packmate"], "graveyard_has": ["Lightning Bolt"], "hand": [] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a non-instant foretold card cannot be cast on the opponent's turn, even with mana open",
    "players": [
      { "hand": ["Sarulf's Packmate"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Sarulf's Packmate", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Sarulf's Packmate", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "exile": ["Sarulf's Packmate"], "hand": [] }, {} ]
    }
  }
]
