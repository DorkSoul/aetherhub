[
  { "name": "must be blocked if able (blocked by the only creature)",
    "players": [ { "battlefield": ["Gaea's Protector"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Gaea's Protector", "at": "p1" } ] }, { "block": [], "illegal": true }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Gaea's Protector" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Gaea's Protector"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "unblocked when no creature can block",
    "players": [ { "battlefield": ["Gaea's Protector"] }, {} ],
    "steps": [ { "attack": [ { "card": "Gaea's Protector", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ] } },
  { "name": "ruling: one blocker satisfies must-be-blocked; the other creature need not block",
    "players": [ { "battlefield": ["Gaea's Protector"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Gaea's Protector", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Gaea's Protector" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Gaea's Protector"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"], "life": 20 } ] } },
  { "name": "ruling: the defending player chooses which creature blocks (Hill Giant blocks instead)",
    "players": [ { "battlefield": ["Gaea's Protector"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Gaea's Protector", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Gaea's Protector" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Gaea's Protector"] }, { "graveyard": ["Hill Giant"], "battlefield_has": ["Grizzly Bears"], "life": 20 } ] } }
]
