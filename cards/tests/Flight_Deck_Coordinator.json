[
 {
  "name": "end step with two tapped creatures gains 2 life",
  "players": [
   { "battlefield": ["Flight-Deck Coordinator", { "name": "Grizzly Bears", "tapped": true }, { "name": "Hill Giant", "tapped": true }] },
   {}
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 22 },
    {}
   ]
  }
 },
 {
  "name": "only one tapped creature: no life gain",
  "players": [
   { "battlefield": ["Flight-Deck Coordinator", { "name": "Grizzly Bears", "tapped": true }] },
   {}
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    {}
   ]
  }
 },
 {
  "name": "ruling: creatures tapped by attacking still count when the end step begins",
  "players": [
   { "battlefield": ["Flight-Deck Coordinator", { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false }] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "life": 22 }, {} ] }
 }
]
