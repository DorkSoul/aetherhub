[
  {
    "name": "returns a nonland permanent to its owner's hand",
    "players": [
      {
        "hand": [
          "Depart the Realm"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Depart the Realm",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Depart the Realm"
          ]
        },
        {
          "hand": [
            "Grizzly Bears"
          ],
          "battlefield": []
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "a land is not a legal target",
    "players": [
      {
        "hand": [
          "Depart the Realm"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Depart the Realm",
        "targets": [
          "Forest"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Depart the Realm"
          ]
        },
        {
          "battlefield": [
            "Forest"
          ]
        }
      ]
    }
  },
  {
    "name": "foretell for 2 then cast from exile for U on a later turn",
    "players": [
      {
        "hand": [
          "Depart the Realm"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Depart the Realm",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "cast": "Depart the Realm",
        "alt": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Depart the Realm"
          ],
          "battlefield": [
            "Island",
            "Island"
          ]
        },
        {
          "hand": [
            "Forest",
            "Grizzly Bears"
          ]
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: foretelling is a special action taken in response to a spell (Bolt on the stack)",
    "players": [
      { "hand": ["Depart the Realm", "Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "activate": "Depart the Realm", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Lightning Bolt"], "exile": ["Depart the Realm"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a foretold instant can be cast on the opponent's turn",
    "players": [
      { "hand": ["Depart the Realm"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Depart the Realm", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Depart the Realm", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Depart the Realm"], "exile": [] },
        { "hand_count": 2, "battlefield": [] }
      ]
    }
  }
]
