[
  { "name": "draws one card per card type in your graveyard",
    "players": [ { "hand": ["Lucid Dreams"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Forest"] }, {} ],
    "steps": [ { "cast": "Lucid Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 3 }, {} ] } },
  { "name": "opponent's graveyard does not count",
    "players": [ { "hand": ["Lucid Dreams"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt", "Forest"] } ],
    "steps": [ { "cast": "Lucid Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "ruling: a supertype or subtype is not a card type: two Bears and a Forest are two types",
    "players": [ { "hand": ["Lucid Dreams"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears", "Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "cast": "Lucid Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] } },
  { "name": "ruling: an artifact creature counts as both artifact and creature",
    "players": [ { "hand": ["Lucid Dreams"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Solemn Simulacrum", "Forest"] }, {} ],
    "steps": [ { "cast": "Lucid Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 3 }, {} ] } },
  { "name": "ruling: Lucid Dreams is still on the stack, so with an empty graveyard it draws nothing",
    "players": [ { "hand": ["Lucid Dreams"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Lucid Dreams" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } }
]
