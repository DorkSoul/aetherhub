[
  { "name": "at the beginning of each upkeep, its controller creates a Treasure",
    "players": [ { "battlefield": ["Quark, Humble Proprietor", "Mountain"] }, { "battlefield": ["Mountain"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Quark, Humble Proprietor", "Treasure"] }, { "battlefield_lacks": ["Treasure"] } ] } },
  { "name": "the Treasure goes to Quark's controller even on the opponent's upkeep",
    "players": [ { "battlefield": ["Mountain"] }, { "battlefield": ["Quark, Humble Proprietor", "Mountain"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Treasure"] }, { "battlefield_has": ["Quark, Humble Proprietor", "Treasure"] } ] } }
]
