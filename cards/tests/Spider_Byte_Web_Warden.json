[
  {
    "name": "enters: returns an opponent's nonland permanent to hand",
    "players": [
      { "hand": ["Spider-Byte, Web Warden"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Spider-Byte, Web Warden" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Spider-Byte, Web Warden"] },
        { "battlefield_lacks": ["Grizzly Bears"], "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "up to one: choosing no target does nothing",
    "players": [
      { "hand": ["Spider-Byte, Web Warden"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Spider-Byte, Web Warden" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Spider-Byte, Web Warden"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
