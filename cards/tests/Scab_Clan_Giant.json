[
  {
    "name": "fights the only opposing creature",
    "players": [
      {
        "hand": ["Scab-Clan Giant"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Scab-Clan Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scab-Clan Giant"] },
        { "graveyard": ["Grizzly Bears"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "no opposing creature: no target, the Giant just enters",
    "players": [
      {
        "hand": ["Scab-Clan Giant"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Scab-Clan Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scab-Clan Giant", "Grizzly Bears"], "graveyard": [] },
        {}
      ]
    }
  },
  {
    "name": "two opposing creatures: exactly one is chosen at random and fights",
    "players": [
      {
        "hand": ["Scab-Clan Giant"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest"]
      },
      { "battlefield": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Scab-Clan Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scab-Clan Giant"] },
        { "graveyard": ["Grizzly Bears"], "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "never fights its controller's creatures; a big opposing creature trades with it",
    "players": [
      {
        "hand": ["Scab-Clan Giant"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Grizzly Bears"]
      },
      { "battlefield": ["Craw Wurm"] }
    ],
    "steps": [
      { "cast": "Scab-Clan Giant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Scab-Clan Giant"], "graveyard": ["Scab-Clan Giant"] },
        { "graveyard": ["Craw Wurm"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "ruling: if the Giant leaves before its ability resolves, no fight happens",
    "players": [
      {
        "hand": ["Scab-Clan Giant", "Unsummon"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Island"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Scab-Clan Giant" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Unsummon", "targets": ["Scab-Clan Giant"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "battlefield_lacks": ["Scab-Clan Giant"] },
        { "battlefield_has": ["Grizzly Bears"], "graveyard": [] }
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]
