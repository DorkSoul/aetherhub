[
  {
    "name": "the opponent's lands of the chosen basic type phase out at their untap step",
    "players": [
      { "hand": ["Shimmer"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Swamp", "Mountain"] }
    ],
    "steps": [
      { "cast": "Shimmer" },
      { "resolve": true, "answers": ["Swamp"] },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Shimmer"] }, { "battlefield_has": ["Mountain"], "battlefield_lacks": ["Swamp"] } ] }
  },
  {
    "name": "your own lands of the chosen type phase out too, and lands of other types stay",
    "players": [
      { "hand": ["Shimmer"], "battlefield": ["Island", "Island", "Island", "Island", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Shimmer" },
      { "resolve": true, "answers": ["Island"] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Shimmer"], "battlefield_lacks": ["Island"] }, {} ] }
  },
  {
    "name": "a nonbasic land type can be chosen: Gates phase out",
    "players": [
      { "hand": ["Shimmer"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Azorius Guildgate", "Plains"] }
    ],
    "steps": [
      { "cast": "Shimmer" },
      { "resolve": true, "answers": ["Gate"] },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Plains"], "battlefield_lacks": ["Azorius Guildgate"] } ] }
  },
  {
    "name": "phased-out lands phase back in at their controller's next untap step",
    "players": [
      { "hand": ["Shimmer"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "cast": "Shimmer" },
      { "resolve": true, "answers": ["Swamp"] },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Swamp"] } ] }
  },
  {
    "name": "ruling: a nonbasic existing land type (Gate) can be chosen; the Plains is not affected",
    "players": [
      { "hand": ["Shimmer"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Azorius Guildgate", "Plains"] }
    ],
    "steps": [
      { "cast": "Shimmer" },
      { "resolve": true, "answers": ["Gate"] },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Plains"], "battlefield_lacks": ["Azorius Guildgate"] } ] }
  }
]
