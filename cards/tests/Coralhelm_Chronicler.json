[
  {
    "name": "casting a kicked spell draws a card, then discards a card",
    "players": [
      { "hand": ["Duskwalker"], "battlefield": ["Coralhelm Chronicler", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Duskwalker", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Duskwalker"], "hand_count": 0, "graveyard_has": ["Forest"] }, {}]
    }
  },
  {
    "name": "casting an unkicked spell does not trigger it",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Coralhelm Chronicler", "Forest", "Forest"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"], "hand_count": 0, "graveyard_has": [] }, {}]
    }
  },
  {
    "name": "enters: may put a card with a kicker ability from the top five into hand",
    "players": [
      { "hand": ["Coralhelm Chronicler"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Duskwalker", "Grizzly Bears", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Coralhelm Chronicler" },
      { "resolve": true, "answers": [["Duskwalker"]] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Coralhelm Chronicler"], "hand": ["Duskwalker"] }, {}]
    }
  },
  {
    "name": "ruling: multikicker triggers once however many times the spell was kicked",
    "players": [
      { "hand": ["Deathforge Shaman"], "battlefield": ["Coralhelm Chronicler", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Deathforge Shaman", "answers": [2] },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 0, "graveyard_has": ["Forest"], "library_top": ["Island"] }, { "life": 16 }]
    }
  },
  {
    "name": "ruling: a copy of a kicked spell is also kicked (Twincast copy of kicked Burst Lightning deals 4)",
    "players": [
      { "hand": ["Burst Lightning", "Twincast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Burst Lightning", "targets": ["p1"], "answers": [true] },
      { "cast": "Twincast", "targets": [{ "stack": "Burst Lightning" }] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Twincast", "Burst Lightning"] }, { "life": 12 }],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: a permanent put onto the battlefield without being cast is not kicked (Reanimate)",
    "players": [
      { "hand": ["Reanimate"], "battlefield": ["Swamp"], "graveyard": ["Duskwalker"] },
      {}
    ],
    "steps": [
      { "cast": "Reanimate", "targets": ["Duskwalker"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 19, "battlefield_has": ["Duskwalker"] }, {}],
      "pt": { "Duskwalker": [1, 1] }
    }
  }
]
