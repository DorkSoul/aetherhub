[
  {
    "name": "prevents the chosen source's damage to you; another source still hits",
    "players": [
      { "battlefield": ["Hill Giant", "Grizzly Bears"] },
      { "hand": ["Shadowbane"], "battlefield": ["Plains", "Island"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Shadowbane", "player": 1 },
      { "resolve": true, "answers": ["Hill Giant"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "prevents damage to a creature you control from the chosen source",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "hand": ["Shadowbane"], "battlefield": ["Plains", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Shadowbane", "player": 1 },
      { "resolve": true, "answers": ["Hill Giant"] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20, "battlefield": ["Plains", "Island", "Grizzly Bears"] } ] }
  },
  {
    "name": "damage from a black source is prevented and you gain that much life",
    "players": [
      { "battlefield": ["Walking Corpse"] },
      { "hand": ["Shadowbane"], "battlefield": ["Plains", "Island"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Walking Corpse", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Shadowbane", "player": 1 },
      { "resolve": true, "answers": ["Walking Corpse"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 22 } ] }
  },
  {
    "name": "ruling: the chosen source's damage to another player is not prevented",
    "players": [
      { "hand": ["Shadowbane"], "battlefield": ["Hill Giant", "Plains", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Shadowbane" },
      { "resolve": true, "answers": ["Hill Giant"] },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "ruling: the chosen source's damage to a creature you don't control is not prevented",
    "players": [
      { "hand": ["Shadowbane"], "battlefield": ["Hill Giant", "Plains", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shadowbane" },
      { "resolve": true, "answers": ["Hill Giant"] },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"], "life": 20 } ] }
  }
]
