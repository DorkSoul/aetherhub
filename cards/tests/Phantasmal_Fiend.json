[
  {
    "name": "B: gets +1/-1 until end of turn",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Phantasmal Fiend"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Phantasmal Fiend",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Phantasmal Fiend": [
          2,
          4
        ]
      }
    }
  },
  {
    "name": "1U: switches power and toughness",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          "Phantasmal Fiend"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Phantasmal Fiend",
        "ability": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Phantasmal Fiend": [
          5,
          1
        ]
      }
    }
  },
  {
    "name": "pump then switch: 1/5 -> 2/4 -> 4/2",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Island",
          "Island",
          "Phantasmal Fiend"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Phantasmal Fiend",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "activate": "Phantasmal Fiend",
        "ability": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Phantasmal Fiend": [
          4,
          2
        ]
      }
    }
  },
  {
    "name": "without blue mana the switch is not activatable",
    "players": [
      {
        "battlefield": [
          "Swamp",
          "Swamp",
          "Phantasmal Fiend"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Phantasmal Fiend",
        "ability": 1,
        "illegal": true
      }
    ],
    "expect": {
      "pt": {
        "Phantasmal Fiend": [
          1,
          5
        ]
      }
    }
  },
  {
    "name": "ruling: pump, switch, pump gives 3/3 because the switch applies last",
    "players": [ { "battlefield": ["Swamp", "Swamp", "Island", "Island", "Phantasmal Fiend"] }, {} ],
    "steps": [
      { "activate": "Phantasmal Fiend", "ability": 0 },
      { "resolve": true },
      { "activate": "Phantasmal Fiend", "ability": 1 },
      { "resolve": true },
      { "activate": "Phantasmal Fiend", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Phantasmal Fiend": [3, 3] } }
  },
  {
    "name": "ruling: switch then pump still gives 4/2 because the switch applies last",
    "players": [ { "battlefield": ["Swamp", "Island", "Island", "Phantasmal Fiend"] }, {} ],
    "steps": [
      { "activate": "Phantasmal Fiend", "ability": 1 },
      { "resolve": true },
      { "activate": "Phantasmal Fiend", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Phantasmal Fiend": [4, 2] } }
  },
  {
    "name": "ruling: switching twice returns the original 1/5",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Phantasmal Fiend"] }, {} ],
    "steps": [
      { "activate": "Phantasmal Fiend", "ability": 1 },
      { "resolve": true },
      { "activate": "Phantasmal Fiend", "ability": 1 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Phantasmal Fiend": [1, 5] } }
  },
  {
    "name": "ruling: damage marked this turn becomes lethal when toughness is switched to 1",
    "players": [
      { "battlefield": ["Island", "Island", "Phantasmal Fiend"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Phantasmal Fiend", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Phantasmal Fiend" } ] },
      { "advance_to": "Main2" },
      { "activate": "Phantasmal Fiend", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Phantasmal Fiend"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]