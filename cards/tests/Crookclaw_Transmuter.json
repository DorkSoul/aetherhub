   { "resolve": true, "targets": ["Spirit of the Spires"] }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Crookclaw Transmuter"], "graveyard_has": ["Lightning Bolt"] }, { "graveyard": ["Spirit of the Spires"] } ]
