[
  { "name": "shuffles up to three cards from the graveyard into the library",
    "players": [ { "hand": ["Memory's Journey"], "battlefield": ["Island", "Island"], "graveyard": ["Grizzly Bears", "Hill Giant", "Giant Growth", "Lightning Bolt"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Memory's Journey", "targets": ["p0", "Grizzly Bears", "Hill Giant", "Giant Growth"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 4, "graveyard_has": ["Lightning Bolt", "Memory's Journey"] }, {} ] } },
  { "name": "the opponent's cards go to the opponent's library",
    "players": [ { "hand": ["Memory's Journey"], "battlefield": ["Island", "Island"], "library": ["Plains"] }, { "graveyard": ["Grizzly Bears"], "library": ["Plains"] } ],
    "steps": [ { "cast": "Memory's Journey", "targets": ["p1", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 1 }, { "library_count": 2 } ] } },
  { "name": "flashback for {G} from the graveyard, then exile",
    "players": [ { "battlefield": ["Forest"], "graveyard": ["Memory's Journey", "Grizzly Bears"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Memory's Journey", "alt": 0, "targets": ["p0", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 2, "exile": ["Memory's Journey"] }, {} ] } },
  { "name": "ruling: casting with only the target player still resolves (no cards targeted)",
    "players": [ { "hand": ["Memory's Journey"], "battlefield": ["Island", "Island"], "graveyard": ["Grizzly Bears"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Memory's Journey", "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 1, "graveyard_has": ["Grizzly Bears", "Memory's Journey"] }, {} ] } },
  { "name": "ruling: flashback spell that is countered is still exiled",
    "players": [ { "battlefield": ["Forest"], "graveyard": ["Memory's Journey", "Grizzly Bears"], "library": ["Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Memory's Journey", "alt": 0, "targets": ["p0", "Grizzly Bears"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Memory's Journey" }] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Memory's Journey"], "graveyard_has": ["Grizzly Bears"] }, { "graveyard": ["Counterspell"] } ] } }
]
