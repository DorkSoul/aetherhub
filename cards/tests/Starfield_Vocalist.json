[
  { "name": "your permanent's enters trigger happens an additional time",
    "players": [ { "hand": ["Spinewoods Paladin"], "battlefield": ["Starfield Vocalist", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Spinewoods Paladin" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 26, "battlefield_has": ["Spinewoods Paladin"] }, {} ] } },
  { "name": "without it, a permanent's enters trigger happens once",
    "players": [ { "hand": ["Spinewoods Paladin"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Spinewoods Paladin" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 23, "battlefield_has": ["Spinewoods Paladin"] }, {} ] } },
  { "name": "warp: cast from hand for {1}{U}, exiled at the next end step",
    "players": [ { "hand": ["Starfield Vocalist"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Starfield Vocalist", "alt": 0 }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "exile": ["Starfield Vocalist"] }, {} ] } },
  { "name": "ruling: Vocalist's own enters trigger doubles Soul Warden's trigger for the Vocalist entering",
    "players": [ { "hand": ["Starfield Vocalist"], "battlefield": ["Soul Warden", "Island", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Starfield Vocalist" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "battlefield_has": ["Starfield Vocalist", "Soul Warden"] }, {} ] } },
  { "name": "ruling: with two Vocalists an enters trigger happens three times, not four",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Starfield Vocalist", "Starfield Vocalist", "Soul Warden", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 23, "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: the entering creature's own enters trigger also happens an extra time",
    "players": [ { "hand": ["Mulldrifter"], "battlefield": ["Starfield Vocalist", "Island", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Mulldrifter" }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 4, "battlefield_has": ["Mulldrifter"] }, {} ] } }
]
