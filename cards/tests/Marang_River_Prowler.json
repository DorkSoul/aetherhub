[
  {
    "name": "casts from graveyard while you control a green permanent",
    "players": [
      {
        "graveyard": ["Marang River Prowler"],
        "battlefield": ["Island", "Island", "Island", "Llanowar Elves"]
      },
      {}
    ],
    "steps": [
      { "cast": "Marang River Prowler" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Marang River Prowler"] },
        {}
      ]
    }
  },
  {
    "name": "cannot cast from graveyard without a black or green permanent",
    "players": [
      {
        "graveyard": ["Marang River Prowler"],
        "battlefield": ["Island", "Island", "Island", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Marang River Prowler", "illegal": true }
    ]
  },
  {
    "name": "can't block: Prowler's block is dropped, Bears hits for 2",
    "players": [
      { "battlefield": [{ "name": "Grizzly Bears", "sick": false }, { "name": "Savannah Lions", "sick": false }, "Island"] },
      { "battlefield": ["Marang River Prowler", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" }] },
      { "block": [{ "blocker": "Marang River Prowler", "attacker": "Grizzly Bears" }, { "blocker": "Hill Giant", "attacker": "Savannah Lions" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "ruling: the color check happens as the cast begins; killing the Elves in response does not stop it",
    "players": [
      { "hand": ["Lightning Bolt"], "graveyard": ["Marang River Prowler"], "battlefield": ["Island", "Island", "Island", "Mountain", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "cast": "Marang River Prowler" },
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Marang River Prowler"], "graveyard_has": ["Lightning Bolt", "Llanowar Elves"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: casting from the graveyard follows sorcery timing (not on the opponent's turn)",
    "players": [
      { "graveyard": ["Marang River Prowler"], "battlefield": ["Island", "Island", "Island", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Marang River Prowler", "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Marang River Prowler"] }, {} ] }
  },
  {
    "name": "ruling: casting from the graveyard still requires paying its cost (summoning-sick Elves gives no mana)",
    "players": [
      { "graveyard": ["Marang River Prowler"], "battlefield": ["Island", "Island", { "name": "Llanowar Elves", "sick": true }] },
      {}
    ],
    "steps": [
      { "cast": "Marang River Prowler", "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Marang River Prowler"] }, {} ] }
  }
]
