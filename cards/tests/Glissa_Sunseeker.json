     { "tap_for_mana": "Forest" },
     { "activate": "Glissa Sunseeker", "targets": ["Sol Ring"] },
     { "resolve": true }
   ],
   "expect": { "players": [ {}, { "battlefield_lacks": ["Sol Ring"] } ] } },
 { "name": "no unspent mana: mana value 1 artifact survives",
