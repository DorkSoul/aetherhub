   "steps": [
     { "activate": "Glissa Sunseeker", "targets": ["Sol Ring"] },
     { "resolve": true }
   ],
   "expect": { "players": [ {}, { "battlefield_has": ["Sol Ring"] } ] } },
 { "name": "mismatched mana value: one unspent vs mana value 2",
   "players": [ { "battlefield": ["Glissa Sunseeker", "Forest"] }, { "battlefield": ["Mind Stone"] } ],
   "steps": [
     { "tap_for_mana": "Forest" },
     { "activate": "Glissa Sunseeker", "targets": ["Mind Stone"] },
     { "resolve": true }
   ],
   "expect": { "players": [ {}, { "battlefield_has": ["Mind Stone"] } ] } },
 { "name": "two unspent mana destroys a mana value 2 artifact",
   "players": [ { "battlefield": ["Glissa Sunseeker", "Forest", "Swamp"] }, { "battlefield": ["Mind Stone"] } ],
   "steps": [
     { "tap_for_mana": "Forest" },
     { "tap_for_mana": "Swamp" },
     { "activate": "Glissa Sunseeker", "targets": ["Mind Stone"] },
     { "resolve": true }
   ],
   "expect": { "players": [ {}, { "battlefield_lacks": ["Mind Stone"] } ] } },
 { "name": "ruling: mana added in response to the ability counts when it resolves",
   "players": [ { "battlefield": ["Glissa Sunseeker", "Forest", "Swamp"] }, { "battlefield": ["Mind Stone"] } ],
   "steps": [
     { "activate": "Glissa Sunseeker", "targets": ["Mind Stone"] },
