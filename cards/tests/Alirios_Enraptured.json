[
 {"name": "enters tapped and creates a 3/2 Reflection",
  "players": [{"hand": ["Alirios, Enraptured"], "battlefield": ["Island", "Island", "Island"]}, {}],
  "steps": [{"cast": "Alirios, Enraptured"}, {"resolve": true}],
  "expect": {"players": [{"battlefield_has": ["Alirios, Enraptured", "Reflection 3-2 Blue"]}, {}], "tapped": {"Alirios, Enraptured": true}, "pt": {"Reflection 3-2 Blue": [3, 2]}}},
 {"name": "does not untap during untap step while controlling a Reflection",
  "players": [{"hand": ["Alirios, Enraptured"], "battlefield": ["Island", "Island", "Island"]}, {}],
  "steps": [{"cast": "Alirios, Enraptured"}, {"resolve": true}, {"advance_to": "Untap", "auto": true}, {"advance_to": "Untap", "auto": true}],
  "expect": {"players": [{"battlefield_has": ["Alirios, Enraptured", "Reflection 3-2 Blue"]}, {}], "tapped": {"Alirios, Enraptured": true}}},
 {"name": "untaps normally in untap step without a Reflection",
  "players": [{"battlefield": [{"name": "Alirios, Enraptured", "tapped": true}]}, {}],
  "steps": [{"advance_to": "Untap", "auto": true}, {"advance_to": "Untap", "auto": true}],
  "expect": {"players": [{"battlefield_has": ["Alirios, Enraptured"]}, {}], "tapped": {"Alirios, Enraptured": false}}},
 {"name": "ruling: once its Reflection is gone Alirios stays tapped until the next untap step",
  "players": [{"hand": ["Alirios, Enraptured", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"]}, {}],
  "steps": [{"cast": "Alirios, Enraptured"}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["Reflection 3-2 Blue"]}, {"resolve": true}],
  "expect": {"players": [{"battlefield_has": ["Alirios, Enraptured"], "graveyard_has": ["Lightning Bolt"]}, {}], "tapped": {"Alirios, Enraptured": true}}},
 {"name": "ruling: Alirios untaps in the untap step after its Reflection is gone",
  "players": [{"hand": ["Alirios, Enraptured", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain"]}, {}],
  "steps": [{"cast": "Alirios, Enraptured"}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["Reflection 3-2 Blue"]}, {"resolve": true}, {"advance_to": "Untap", "auto": true}, {"advance_to": "Untap", "auto": true}],
  "expect": {"players": [{"battlefield_has": ["Alirios, Enraptured"], "graveyard_has": ["Lightning Bolt"]}, {}], "tapped": {"Alirios, Enraptured": false}}}
]
