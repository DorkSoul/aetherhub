[
  { "name": "granted ability: the target creature can't block the enchanted creature this turn",
    "players": [ { "hand": ["Fearsome Temper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Fearsome Temper", "targets": ["Grizzly Bears"] },
               { "resolve": true },
               { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Hill Giant"] },
               { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Fearsome Temper"] }, { "life": 16, "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "the target creature can still block other attackers",
    "players": [ { "hand": ["Fearsome Temper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant", "Savannah Lions"] } ],
    "steps": [ { "cast": "Fearsome Temper", "targets": ["Grizzly Bears"] },
               { "resolve": true },
               { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Hill Giant"] },
               { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Savannah Lions"], "battlefield_has": ["Hill Giant"], "life": 20 } ] } },
  { "name": "without activating the ability, the Hill Giant can block the enchanted creature",
    "players": [ { "hand": ["Fearsome Temper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Fearsome Temper", "targets": ["Grizzly Bears"] },
               { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "life": 20 } ] } },
  { "name": "ruling: the target creature can still block other attacking creatures",
    "players": [ { "hand": ["Fearsome Temper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", { "name": "Savannah Lions", "sick": false }] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Fearsome Temper", "targets": ["Grizzly Bears"] },
               { "resolve": true },
               { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Hill Giant"] },
               { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Savannah Lions" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Savannah Lions"], "battlefield_has": ["Grizzly Bears"] }, { "graveyard": [], "battlefield_has": ["Hill Giant"], "life": 16 } ] } },
  { "name": "ruling: the ability cannot undo a block already declared; the blocked creature stays blocked",
    "players": [ { "hand": ["Fearsome Temper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Fearsome Temper", "targets": ["Grizzly Bears"] },
               { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
               { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Hill Giant"] },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Fearsome Temper"] }, { "graveyard": ["Hill Giant"], "life": 20 } ] } }
]
