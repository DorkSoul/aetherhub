[
 {
  "name": "exiles one creature per controller; they return when Lagrella leaves, only the one under your control gets counters",
  "players": [
   { "hand": ["Lagrella, the Magpie", "Lightning Bolt"], "battlefield": ["Forest", "Plains", "Island", "Mountain", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Lagrella, the Magpie" },
   { "resolve": true, "targets": ["Grizzly Bears", "Hill Giant"] },
   { "cast": "Lightning Bolt", "targets": ["Lagrella, the Magpie"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Lagrella, the Magpie"] }, { "battlefield": ["Hill Giant"] } ],
   "counters": { "Grizzly Bears": { "p1p1": 2 }, "Hill Giant": {} },
   "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [3, 3] }
  }
 },
 {
  "name": "while Lagrella stays the targets remain exiled",
  "players": [
   { "hand": ["Lagrella, the Magpie"], "battlefield": ["Forest", "Plains", "Island", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Lagrella, the Magpie" },
   { "resolve": true, "targets": ["Grizzly Bears", "Hill Giant"] }
  ],
  "expect": { "players": [ { "battlefield": ["Forest", "Plains", "Island", "Lagrella, the Magpie"], "exile": ["Grizzly Bears"] }, { "battlefield": [], "exile": ["Hill Giant"] } ] }
 },
 {
  "name": "any number includes none: nothing is exiled",
  "players": [
   { "hand": ["Lagrella, the Magpie"], "battlefield": ["Forest", "Plains", "Island", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Lagrella, the Magpie" },
   { "resolve": true, "targets": [] }
  ],
  "expect": { "players": [ { "battlefield_has": ["Lagrella, the Magpie", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ] }
 },
 {
  "name": "a lone opponent creature is exiled and returns without counters",
  "players": [
   { "hand": ["Lagrella, the Magpie", "Lightning Bolt"], "battlefield": ["Forest", "Plains", "Island", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Lagrella, the Magpie" },
   { "resolve": true, "targets": ["Hill Giant"] },
   { "cast": "Lightning Bolt", "targets": ["Lagrella, the Magpie"] },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, { "battlefield": ["Hill Giant"] } ], "pt": { "Hill Giant": [3, 3] } }
 },
 {
  "name": "ruling: the return still happens after Lagrella loses all abilities (Turn to Frog)",
  "players": [
   { "hand": ["Lagrella, the Magpie", "Turn to Frog", "Lightning Bolt"], "battlefield": ["Forest", "Plains", "Island", "Island", "Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Lagrella, the Magpie" },
   { "resolve": true, "targets": ["Hill Giant"] },
   { "cast": "Turn to Frog", "targets": ["Lagrella, the Magpie"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Lagrella, the Magpie"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Lagrella, the Magpie"] }, { "battlefield": ["Hill Giant"] } ], "pt": { "Hill Giant": [3, 3] } }
 }
]
