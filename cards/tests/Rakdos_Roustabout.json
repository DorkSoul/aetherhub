[
  {
    "name": "blocked attacking a player deals 1 damage to that player",
    "players": [
      { "battlefield": ["Rakdos Roustabout"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rakdos Roustabout", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Rakdos Roustabout" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 19 }]
    }
  },
  {
    "name": "blocked attacking a planeswalker deals 1 damage to that planeswalker",
    "players": [
      { "battlefield": ["Rakdos Roustabout"] },
      { "battlefield": ["Test Walker", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rakdos Roustabout", "at": "Test Walker" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Rakdos Roustabout" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "counters": { "Test Walker": { "Loyalty": 3 } }
    }
  },
  {
    "name": "unblocked it does not trigger",
    "players": [
      { "battlefield": ["Rakdos Roustabout"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Rakdos Roustabout", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "ruling: blocked by two creatures, the becomes-blocked trigger deals 1 damage only once",
    "players": [
      { "battlefield": ["Rakdos Roustabout"] },
      { "battlefield": ["Hill Giant", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rakdos Roustabout", "at": "p1" }] },
      { "block": [
          { "blocker": "Hill Giant", "attacker": "Rakdos Roustabout" },
          { "blocker": "Grizzly Bears", "attacker": "Rakdos Roustabout" }
        ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 19 }]
    }
  }
]
