[
  {
    "name": "single target: +1/+0 and first strike until end of turn",
    "players": [
      { "hand": ["Weapon Surge"], "battlefield": ["Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Weapon Surge", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 2] },
      "keywords": { "Grizzly Bears": ["FirstStrike"] }
    }
  },
  {
    "name": "overload: each creature you control",
    "players": [
      { "hand": ["Weapon Surge"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Weapon Surge", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Hill Giant": [4, 3] },
      "keywords": { "Hill Giant": ["FirstStrike"] }
    }
  },
  {
    "name": "overload does not affect opposing creatures",
    "players": [
      { "hand": ["Weapon Surge"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Weapon Surge", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 2], "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "ruling: a single-target cast leaves the other creatures alone",
    "players": [{ "hand": ["Weapon Surge"], "battlefield": ["Mountain", "Grizzly Bears", "Hill Giant"] }, {}],
    "steps": [{ "cast": "Weapon Surge", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "pt": { "Grizzly Bears": [3, 2], "Hill Giant": [3, 3] } }
  },
  {
    "name": "ruling: overload pumps a protection-from-red creature that a targeted spell cannot touch",
    "players": [{ "hand": ["Weapon Surge"], "battlefield": ["Mountain", "Mountain", "Silver Knight"] }, {}],
    "steps": [{ "cast": "Weapon Surge", "alt": 0 }, { "resolve": true }],
    "expect": { "pt": { "Silver Knight": [3, 2] } }
  },
  {
    "name": "ruling: a targeted Weapon Surge cannot target a creature with protection from red",
    "players": [{ "hand": ["Weapon Surge"], "battlefield": ["Mountain", "Silver Knight"] }, {}],
    "steps": [{ "cast": "Weapon Surge", "targets": ["Silver Knight"], "illegal": true }],
    "expect": { "players": [{ "hand": ["Weapon Surge"] }, {}] }
  }
]
