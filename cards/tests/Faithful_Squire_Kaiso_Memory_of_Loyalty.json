[
  {
    "name": "two ki counters: at the end step you may flip it into Kaiso",
    "start": "Main2",
    "players": [
      { "battlefield": [{ "name": "Faithful Squire", "counters": { "ki": 2 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Kaiso, Memory of Loyalty"], "battlefield_lacks": ["Faithful Squire"] }, {}],
      "counters": { "Kaiso, Memory of Loyalty": { "ki": 2 } }
    }
  },
  {
    "name": "declining the flip keeps Faithful Squire on the front face",
    "start": "Main2",
    "players": [
      { "battlefield": [{ "name": "Faithful Squire", "counters": { "ki": 2 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "End", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Faithful Squire"] }, {}],
      "counters": { "Faithful Squire": { "ki": 2 } }
    }
  },
  {
    "name": "one ki counter: no flip question at the end step",
    "start": "Main2",
    "players": [
      { "battlefield": [{ "name": "Faithful Squire", "counters": { "ki": 1 } }] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Faithful Squire"] }, {}],
      "counters": { "Faithful Squire": { "ki": 1 } }
    }
  },
  {
    "name": "casting a Spirit spell adds a ki counter to Faithful Squire",
    "players": [
      { "hand": ["Petalmane Baku"], "battlefield": ["Faithful Squire", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Petalmane Baku" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Faithful Squire", "Petalmane Baku"] }, {}],
      "counters": { "Faithful Squire": { "ki": 1 } }
    }
  },
  {
    "name": "Kaiso: remove a ki counter to prevent all damage to a creature this turn",
    "start": "Main2",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Faithful Squire", "counters": { "ki": 2 } }, "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End", "answers": [true] },
      { "resolve": true },
      { "activate": "Kaiso, Memory of Loyalty", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt"], "battlefield_has": ["Kaiso, Memory of Loyalty"] }, { "battlefield_has": ["Grizzly Bears"] }],
      "counters": { "Kaiso, Memory of Loyalty": { "ki": 1 } }
    }
  }
]
