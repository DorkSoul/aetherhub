    ],
    "expect": {
      "players": [ { "battlefield": ["Ellie, Brick Master", "Grizzly Bears", "Cordyceps Infected"] }, { "life": 17 } ],
      "tapped": { "Cordyceps Infected": true }
    }
  },
  {
    "name": "several attackers still create only one token",
