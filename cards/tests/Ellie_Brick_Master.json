      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield": ["Ellie, Brick Master", "Grizzly Bears", "Hill Giant", "Cordyceps Infected"] }, { "life": 14 } ] }
  },
  {
    "name": "attacking a planeswalker is not attacking an opponent: no token",
    "players": [
      { "battlefield": ["Ellie, Brick Master", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Jace Beleren"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "Jace Beleren" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield": ["Ellie, Brick Master", "Grizzly Bears"] }, { "life": 20 } ] }
  },
  {
    "name": "an opponent of Ellie's controller attacking Ellie's controller is not attacking one of Ellie's opponents",
    "players": [
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] },
      { "battlefield": ["Ellie, Brick Master"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
