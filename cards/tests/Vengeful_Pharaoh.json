      {"graveyard": ["Vengeful Pharaoh"], "library": ["Island"]}
    ],
    "steps": [
      {"attack": [{"card": "Grizzly Bears", "at": "p1"}]},
      {"block": []},
      {"advance_to": "Main2"}
    ],
    "expect": {"players": [{"graveyard": ["Grizzly Bears"]}, {"life": 18, "graveyard": [], "library_top": ["Vengeful Pharaoh", "Island"]}]}
  },
  {
    "name": "combat damage to your planeswalker also triggers",
    "players": [
      {"battlefield": [{"name": "Grizzly Bears", "sick": false}]},
      {"graveyard": ["Vengeful Pharaoh"], "battlefield": ["Jace Beleren"], "library": ["Island"]}
    ],
    "steps": [
      {"attack": [{"card": "Grizzly Bears", "at": "Jace Beleren"}]},
      {"block": []},
      {"advance_to": "Main2"}
    ],
    "expect": {"players": [{"graveyard": ["Grizzly Bears"]}, {"life": 20, "library_top": ["Vengeful Pharaoh", "Island"]}]}
  },
  {
    "name": "no damage dealt: Pharaoh stays in the graveyard",
    "players": [
      {"battlefield": [{"name": "Hill Giant", "sick": false}]},
      {"graveyard": ["Vengeful Pharaoh"], "battlefield": [{"name": "Grizzly Bears", "sick": false}]}
    ],
    "steps": [
      {"attack": [{"card": "Hill Giant", "at": "p1"}]},
      {"block": [{"blocker": "Grizzly Bears", "attacker": "Hill Giant"}]},
      {"advance_to": "Main2"}
    ],
    "expect": {"players": [{}, {"life": 20, "graveyard_has": ["Vengeful Pharaoh"]}]}
  },
  {
    "name": "ruling: simultaneous combat damage to you triggers once; one attacker is destroyed and Pharaoh goes on top",
    "players": [
      {"battlefield": [{"name": "Grizzly Bears", "sick": false}, {"name": "Goblin Piker", "sick": false}]},
      {"graveyard": ["Vengeful Pharaoh"], "library": ["Island"]}
    ],
    "steps": [
      {"attack": [{"card": "Grizzly Bears", "at": "p1"}, {"card": "Goblin Piker", "at": "p1"}]},
      {"block": []},
      {"advance_to": "Main2", "targets": ["Grizzly Bears"]}
    ],
    "expect": {"players": [{"graveyard": ["Grizzly Bears"], "battlefield_has": ["Goblin Piker"]}, {"life": 16, "graveyard": [], "library_top": ["Vengeful Pharaoh", "Island"]}]}
  },
  {
    "name": "ruling: Pharaoh dies in the same combat damage step, so it does not trigger from the graveyard",
    "players": [
      {"hand": ["Giant Growth"], "battlefield": ["Forest", {"name": "Grizzly Bears", "sick": false}, {"name": "Hill Giant", "sick": false}]},
      {"battlefield": ["Vengeful Pharaoh"]}
    ],
    "steps": [
      {"attack": [{"card": "Grizzly Bears", "at": "p1"}, {"card": "Hill Giant", "at": "p1"}]},
      {"block": [{"blocker": "Vengeful Pharaoh", "attacker": "Hill Giant"}]},
      {"cast": "Giant Growth", "targets": ["Hill Giant"]},
      {"resolve": true},
      {"advance_to": "Main2"}
    ],
    "expect": {"players": [{"battlefield_has": ["Grizzly Bears"]}, {"life": 18, "graveyard_has": ["Vengeful Pharaoh"]}]}
  }
