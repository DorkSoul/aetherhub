[
  { "name": "discard an artifact: search for an artifact with mana value 1 or less",
    "players": [ { "hand": ["Sol Ring"], "battlefield": ["Island", "Artificer's Intuition"], "library": ["Sol Ring"] }, {} ],
    "steps": [ { "activate": "Artificer's Intuition" }, { "resolve": true, "answers": ["Sol Ring"] } ],
    "expect": { "players": [ { "hand": ["Sol Ring"], "graveyard_has": ["Sol Ring"] }, {} ] } },
  { "name": "mana value 2 artifacts cannot be found",
    "players": [ { "hand": ["Sol Ring"], "battlefield": ["Island", "Artificer's Intuition"], "library": ["Mind Stone"] }, {} ],
    "steps": [ { "activate": "Artificer's Intuition" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "graveyard_has": ["Sol Ring"] }, {} ] } },
  { "name": "needs an artifact card to discard",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Island", "Artificer's Intuition"] }, {} ],
    "steps": [ { "activate": "Artificer's Intuition", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] } }
