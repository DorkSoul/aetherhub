[
  {
    "name": "entering adds RRR",
    "players": [
      { "hand": ["Priest of Urabrask"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Priest of Urabrask" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "pool": { "R": 3 }, "battlefield_has": ["Priest of Urabrask"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the ETB mana is a triggered ability that can be responded to; Priest dying in response still adds RRR",
    "players": [
      { "hand": ["Priest of Urabrask"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Priest of Urabrask" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Priest of Urabrask"] },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "pool": { "R": 3 }, "graveyard": ["Priest of Urabrask"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: unspent RRR empties at the end of the phase",
    "players": [
      { "hand": ["Priest of Urabrask"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Priest of Urabrask" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "pool": { "R": 0 }, "battlefield_has": ["Priest of Urabrask"] },
        {}
      ]
    }
  }
]
