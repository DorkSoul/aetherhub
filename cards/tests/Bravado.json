[
  {
    "name": "enchanted creature gets +1/+1 for each other creature you control",
    "players": [ { "hand": ["Bravado"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears", "Serra Angel", "Runeclaw Bear"] }, {} ],
    "steps": [
      { "cast": "Bravado", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": [] }, {} ],
      "pt": { "Grizzly Bears": [4, 4], "Serra Angel": [4, 4] }
    }
  },
  {
    "name": "enchanting an opponent's creature counts only your creatures",
    "players": [ { "hand": ["Bravado"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears", "Serra Angel"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Bravado", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Hill Giant": [5, 5] }
    }
  },
  {
    "name": "ruling: the bonus is recalculated when another creature enters",
    "players": [ { "hand": ["Bravado", "Runeclaw Bear"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Bravado", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Runeclaw Bear" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
