[
  { "name": "a creature of yours dealing combat damage gains life for both players",
    "players": [ { "battlefield": ["Angel of Destiny", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 22 }, { "life": 20 } ] } },
  { "name": "with 15 more than starting life, the player it attacked loses the game",
    "players": [ { "life": 35, "battlefield": ["Angel of Destiny"] }, {} ],
    "steps": [ { "attack": [ { "card": "Angel of Destiny", "at": "p1" } ] }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "winner": 0, "players": [ {}, {} ] } },
  { "name": "without the life lead nobody loses",
    "players": [ { "battlefield": ["Angel of Destiny"] }, {} ],
    "steps": [ { "attack": [ { "card": "Angel of Destiny", "at": "p1" } ] }, { "advance_to": "End" } ],
    "expect": { "winner": -1, "players": [ {}, {} ] } },
  { "name": "ruling: Angel gone before your end step, its last ability does not make the attacked player lose",
    "players": [ { "life": 35, "battlefield": ["Angel of Destiny", "Mountain", "Mountain"], "hand": ["Lightning Bolt", "Lightning Bolt"] }, {} ],
    "steps": [ { "attack": [ { "card": "Angel of Destiny", "at": "p1" } ] }, { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["Angel of Destiny"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Angel of Destiny"] }, { "resolve": true },
      { "advance_to": "End" } ],
    "expect": { "winner": -1, "players": [ { "graveyard": ["Angel of Destiny", "Lightning Bolt", "Lightning Bolt"] }, {} ] } }
]
