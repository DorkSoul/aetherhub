[
  { "name": "exerted: combat damage to it is prevented",
    "players": [ { "battlefield": ["Oketra's Avenger"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Oketra's Avenger", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Oketra's Avenger" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield": ["Oketra's Avenger"] }, { "graveyard": ["Hill Giant"] } ] }
  },
  { "name": "not exerted: it takes the combat damage",
    "players": [ { "battlefield": ["Oketra's Avenger"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Oketra's Avenger", "at": "p1" } ] },
      { "resolve": true, "answers": [false] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Oketra's Avenger" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Oketra's Avenger"] }, { "graveyard": ["Hill Giant"] } ] }
  },
  { "name": "ruling: exerted after gaining control of it, it untaps in its owner's untap step",
    "players": [ { "hand": ["Threaten"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Oketra's Avenger"] } ],
    "steps": [
      { "cast": "Threaten" },
      { "resolve": true },
      { "attack": [ { "card": "Oketra's Avenger", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Oketra's Avenger"] }, { "battlefield_has": ["Oketra's Avenger"] } ],
      "tapped": { "Oketra's Avenger": false }
    }
  }
]
