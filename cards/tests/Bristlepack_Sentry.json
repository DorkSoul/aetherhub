[
  {
    "name": "with a power 4 creature it attacks despite defender",
    "players": [ { "battlefield": ["Bristlepack Sentry", "Serra Angel"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Bristlepack Sentry", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Bristlepack Sentry": true },
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "without a power 4 creature it cannot attack (power 3 and 2 do not count)",
    "players": [ { "battlefield": ["Bristlepack Sentry", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Bristlepack Sentry", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Bristlepack Sentry": false },
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: an Equipment that makes it power 4 lets it attack despite defender",
    "players": [ { "hand": ["Quick-Draw Dagger"], "battlefield": ["Plains", "Plains", "Plains", "Bristlepack Sentry"] }, {} ],
    "steps": [ { "cast": "Quick-Draw Dagger" }, { "resolve": true }, { "resolve": true }, { "attack": [ { "card": "Bristlepack Sentry", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "tapped": { "Bristlepack Sentry": true }, "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "ruling: once attacking, losing the power-4 creature does not stop it",
    "players": [ { "battlefield": ["Bristlepack Sentry", "Serra Angel"] }, { "hand": ["Perilous Voyage"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "attack": [ { "card": "Bristlepack Sentry", "at": "p1" } ] }, { "pass": true }, { "cast": "Perilous Voyage", "player": 1, "targets": ["Serra Angel"] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "tapped": { "Bristlepack Sentry": true }, "players": [ {}, { "life": 17 } ] }
  }
]
