[
  { "name": "pumps an attacker by its power and destroys it at end step",
    "players": [ { "hand": ["Berserk"], "battlefield": [{ "name": "Grizzly Bears", "sick": false }, "Forest"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "cast": "Berserk", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Berserk", "Grizzly Bears"] }, { "life": 16 } ] } },
  { "name": "non-attacking creature survives the end step destruction",
    "players": [ { "hand": ["Berserk"], "battlefield": [{ "name": "Grizzly Bears", "sick": false }, { "name": "Llanowar Elves", "sick": false }, "Forest"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "cast": "Berserk", "targets": ["Llanowar Elves"] }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Llanowar Elves"] }, { "life": 18 } ] } },
  { "name": "cannot be cast after combat damage",
    "players": [ { "hand": ["Berserk"], "battlefield": [{ "name": "Grizzly Bears", "sick": false }, "Forest"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" }, { "cast": "Berserk", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Berserk"], "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a creature that stops being a creature (Song of the Dryads) is still destroyed at end step",
    "players": [ { "hand": ["Berserk", "Song of the Dryads"], "battlefield": [{ "name": "Grizzly Bears", "sick": false }, "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "cast": "Berserk", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" }, { "cast": "Song of the Dryads", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Berserk", "Grizzly Bears", "Song of the Dryads"] }, {} ] } }
]
