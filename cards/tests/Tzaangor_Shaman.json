[
  {
    "name": "combat damage to a player: the next instant is copied when cast",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Tzaangor Shaman", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Tzaangor Shaman", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 11 }]
    }
  },
  {
    "name": "without combat damage to a player nothing is copied",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Tzaangor Shaman", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "only the next instant or sorcery is copied",
    "players": [
      { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Tzaangor Shaman", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Tzaangor Shaman", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 9 }]
    }
  },
  {
    "name": "ruling: double strike means two combat damage triggers, so the next spell is copied twice",
    "players": [
      { "hand": ["Double Cleave", "Lightning Bolt"], "battlefield": ["Tzaangor Shaman", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Double Cleave", "targets": ["Tzaangor Shaman"] },
      { "resolve": true },
      { "attack": [{ "card": "Tzaangor Shaman", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 5 }]
    }
  }
]
