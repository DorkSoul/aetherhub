[
 { "name": "damage equal to artifact cards in your graveyard",
   "players": [ { "hand": ["Scrapyard Salvo"], "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Scrap Compactor", "Scrapheap", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Scrapyard Salvo", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "no artifacts in graveyard deals no damage",
   "players": [ { "hand": ["Scrapyard Salvo"], "battlefield": ["Mountain", "Mountain", "Mountain"], "graveyard": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Scrapyard Salvo", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "ruling: counted on resolution, so an artifact put into the graveyard in response is counted",
   "players": [ { "hand": ["Scrapyard Salvo", "Shatter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Island", "Scrap Compactor"] }, {} ],
   "steps": [ { "cast": "Scrapyard Salvo", "targets": ["p1"] }, { "cast": "Shatter" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Shatter", "Scrap Compactor"] }, { "life": 19 } ] } }
]
