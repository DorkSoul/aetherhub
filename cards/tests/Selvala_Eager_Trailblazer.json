[
  { "name": "taps for one mana per different creature power, of the chosen colour",
    "players": [ { "battlefield": ["Selvala, Eager Trailblazer", "Grizzly Bears", "Llanowar Elves"] }, {} ],
    "steps": [ { "tap_for_mana": "Selvala, Eager Trailblazer", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 3 } } ], "tapped": { "Selvala, Eager Trailblazer": true } } },
  { "name": "creatures with the same power count once",
    "players": [ { "battlefield": ["Selvala, Eager Trailblazer", "Grizzly Bears", "Grizzly Bears"] }, {} ],
    "steps": [ { "tap_for_mana": "Selvala, Eager Trailblazer", "color": "W" } ],
    "expect": { "players": [ { "pool": { "W": 2 } } ] } },
  { "name": "casting a creature spell creates a Mercenary token",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Selvala, Eager Trailblazer", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Selvala, Eager Trailblazer", "Grizzly Bears", "Mercenary 1-1"] } ] } },
  { "name": "casting a noncreature spell creates no token",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Selvala, Eager Trailblazer", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Mercenary 1-1"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: chosen colour is independent of the creatures' colours (blue chosen, green and white creatures)",
    "players": [ { "battlefield": ["Selvala, Eager Trailblazer", "Grizzly Bears", "Serra Angel", "Llanowar Elves"] }, {} ],
    "steps": [ { "tap_for_mana": "Selvala, Eager Trailblazer", "color": "U" } ],
    "expect": { "players": [ { "pool": { "U": 3 } } ] } },
  { "name": "ruling: the mana ability uses no stack, so the mana is in the pool at once",
    "players": [ { "battlefield": ["Selvala, Eager Trailblazer", "Grizzly Bears", "Llanowar Elves"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "tap_for_mana": "Selvala, Eager Trailblazer", "color": "G" } ],
    "expect": { "stack_empty": true, "players": [ { "pool": { "G": 3 } }, {} ] } }
]
