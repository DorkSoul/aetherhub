[
 {
  "name": "counts card types among all graveyards",
  "players": [
   { "battlefield": ["Tarmogoyf"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] },
   { "graveyard": ["Sol Ring"] }
  ],
  "steps": [],
  "expect": { "pt": { "Tarmogoyf": [3, 4] } }
 },
 {
  "name": "empty graveyards: 0/1",
  "players": [ { "battlefield": ["Tarmogoyf"] }, {} ],
  "steps": [],
  "expect": { "pt": { "Tarmogoyf": [0, 1] } }
 },
 {
  "name": "ruling: counts card types, not cards (six artifact creature cards give 2/3)",
  "players": [
   { "battlefield": ["Tarmogoyf"], "graveyard": ["Ornithopter", "Ornithopter", "Ornithopter"] },
   { "graveyard": ["Ornithopter", "Ornithopter", "Ornithopter"] }
  ],
  "steps": [],
  "expect": { "pt": { "Tarmogoyf": [2, 3] } }
 },
 {
  "name": "ruling: Tarmogoyf in a graveyard counts itself (creature type)",
  "players": [
   { "battlefield": ["Tarmogoyf"], "graveyard": ["Tarmogoyf"] },
   {}
  ],
  "steps": [],
  "expect": { "pt": { "Tarmogoyf": [1, 2] } }
 },
 {
  "name": "ruling: supertypes such as basic and legendary are not card types",
  "players": [
   { "battlefield": ["Tarmogoyf"], "graveyard": ["Forest", "Isamaru, Hound of Konda"] },
   {}
  ],
  "steps": [],
  "expect": { "pt": { "Tarmogoyf": [2, 3] } }
 },
 {
  "name": "ruling: an instant that damages it enters the graveyard before the toughness check",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Mountain", "Tarmogoyf"], "graveyard": ["Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Shock", "targets": ["Tarmogoyf"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{ "battlefield_has": ["Tarmogoyf"], "graveyard_has": ["Shock"] }, {}],
   "pt": { "Tarmogoyf": [2, 3] }
  }
 }
]
