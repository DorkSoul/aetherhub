[
  {
    "name": "exiles the target player's graveyard",
    "players": [
      {
        "hand": [
          "Bojuka Bog"
        ]
      },
      {
        "graveyard": [
          "Lightning Bolt",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "play_land": "Bojuka Bog"
      },
      {
        "resolve": true,
        "targets": [
          "p1"
        ]
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "graveyard": [],
          "exile": [
            "Lightning Bolt",
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "enters tapped",
    "players": [
      { "hand": ["Bojuka Bog"] },
      { "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "play_land": "Bojuka Bog" },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [ {}, { "graveyard": [], "exile": ["Lightning Bolt"] } ],
      "tapped": { "Bojuka Bog": true }
    }
  }
]