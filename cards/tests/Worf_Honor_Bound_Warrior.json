[
  { "name": "attacking with total power 8 or more doubles Worf's power",
    "players": [ { "battlefield": ["Worf, Honor-Bound Warrior", "Rust Scarab", "Rust Scarab"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Worf, Honor-Bound Warrior", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Worf, Honor-Bound Warrior" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Worf, Honor-Bound Warrior"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "total power under 8 does not double Worf's power",
    "players": [ { "battlefield": ["Worf, Honor-Bound Warrior", "Rust Scarab", "Ornithopter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Worf, Honor-Bound Warrior", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Worf, Honor-Bound Warrior" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Worf, Honor-Bound Warrior"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling-gap: tapping two untapped artifacts/creatures (Worf itself may be one) puts a +1/+1 counter on Worf",
    "players": [ { "battlefield": ["Worf, Honor-Bound Warrior", "Ornithopter"] }, {} ],
    "steps": [ { "activate": "Worf, Honor-Bound Warrior" }, { "resolve": true } ],
    "expect": { "pt": { "Worf, Honor-Bound Warrior": [2, 2] } } },
  { "name": "ruling-gap: Worf alone cannot pay the two-permanent tap cost (illegal)",
    "players": [ { "battlefield": ["Worf, Honor-Bound Warrior"] }, {} ],
    "steps": [ { "activate": "Worf, Honor-Bound Warrior", "illegal": true } ],
    "expect": { "pt": { "Worf, Honor-Bound Warrior": [1, 1] } } },
  { "name": "ruling-gap: a tapped artifact cannot be tapped for the cost (illegal with only Worf untapped)",
    "players": [ { "battlefield": ["Worf, Honor-Bound Warrior", { "name": "Ornithopter", "tapped": true }] }, {} ],
    "steps": [ { "activate": "Worf, Honor-Bound Warrior", "illegal": true } ],
    "expect": { "pt": { "Worf, Honor-Bound Warrior": [1, 1] } } }
]
