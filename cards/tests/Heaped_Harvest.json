[
  {
    "name": "ETB: may search for a basic land put onto the battlefield tapped",
    "players": [ { "hand": ["Heaped Harvest"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Heaped Harvest" }, { "resolve": true, "answers": [true, "Island"] } ],
    "expect": { "tapped": { "Island": true }, "players": [ { "battlefield_has": ["Island"] }, {} ] }
  },
  {
    "name": "sacrifice for 3 life",
    "players": [ { "battlefield": ["Heaped Harvest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Heaped Harvest", "ability": 0 },
      { "resolve": true, "answers": [true] }
    ],
    "expect": { "players": [ { "life": 23 }, {} ] }
  },
  {
    "name": "ruling: sacrificed to another spell's effect still triggers the search",
    "players": [ { "hand": ["Tragic Arrogance"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Heaped Harvest", "Sol Ring", "Grizzly Bears"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Tragic Arrogance" }, { "resolve": true, "answers": ["Sol Ring", true, "Island"] } ],
    "expect": { "tapped": { "Island": true }, "players": [ { "battlefield_has": ["Island", "Sol Ring", "Grizzly Bears"], "graveyard_has": ["Heaped Harvest"] }, {} ] }
  },
  {
    "name": "ruling: a Food cannot be sacrificed to pay for two abilities",
    "players": [ { "battlefield": ["Heaped Harvest", "Maraleaf Rider", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Heaped Harvest", "ability": 0 },
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["p1:Grizzly Bears"], "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Heaped Harvest"], "battlefield_has": ["Maraleaf Rider"] }, {} ] }
  }
]
