[
  { "name": "four colors spent: finds a creature with mana value 4 and casts it free",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Plains", "Swamp", "Swamp"], "library": ["Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Hill Giant", true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "exile": [] }, {} ] } },
  { "name": "two colors spent: mana value 2 creature is found and cast free",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Grizzly Bears", true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "exile": [] }, {} ] } },
  { "name": "declining the free cast leaves the found card exiled",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Grizzly Bears", false] } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
  { "name": "finding nothing: nothing is exiled",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Island", "Island", "Island"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": [], "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: the found sorcery is cast during resolution, so its timing restriction is ignored (three colors, Divination)",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Plains", "Island", "Island"], "library": ["Divination"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Divination", true] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Divination"], "exile": [] }, {} ] } },
  { "name": "ruling: a found instant cast this way goes to the graveyard, not back to exile",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Island", "Island", "Island"], "library": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Lightning Bolt", true, "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"], "exile": [] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: five colors spent (the maximum) finds a mana value 5 creature",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Plains", "Swamp", "Mountain"], "library": ["Serra Angel"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Serra Angel", true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Serra Angel"], "exile": [] }, {} ] } },
  { "name": "ruling: a tax on the spell is paid with mana that counts toward colors spent (Thalia, six lands)",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Plains", "Swamp", "Mountain", "Island"], "library": ["Serra Angel"] }, { "battlefield": ["Thalia, Guardian of Thraben"] } ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Serra Angel", true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Serra Angel"], "exile": [] }, {} ] } },
  { "name": "ruling: a converge spell cast without spending mana (free cast of Bring to Light itself) spends zero colors and finds nothing",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Plains", "Swamp", "Mountain"], "library": ["Bring to Light", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Bring to Light", true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Bring to Light"], "exile": [] }, {} ] } },
  { "name": "ruling: a copy of a converge spell spends no mana, so it finds nothing (Twincast copies Bring to Light)",
    "players": [ { "hand": ["Bring to Light", "Twincast"], "battlefield": ["Forest", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "cast": "Twincast", "targets": [{ "stack": "Bring to Light" }] }, { "resolve": true, "answers": ["Grizzly Bears", true] } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "library_count": 21 }, {} ] } },
  { "name": "ruling: a converge spell cast free by an effect with X in its cost (Fireball) chooses X as 0",
    "players": [ { "hand": ["Bring to Light"], "battlefield": ["Forest", "Island", "Island", "Island", "Island"], "library": ["Fireball"] }, {} ],
    "steps": [ { "cast": "Bring to Light" }, { "resolve": true, "answers": ["Fireball", true, "p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Fireball"] }, { "life": 20 } ] } }
]
