[
 {
  "name": "ruling: at 1 life the Phyrexian symbols cannot be paid with life",
  "players": [
   { "life": 1, "hand": ["Act of Aggression"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Act of Aggression", "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": { "players": [ { "life": 1, "hand_count": 1 }, { "battlefield_has": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: Phyrexian symbols count as 1 for mana value, so Act of Aggression (MV 5) is not a nonland card with MV 3 or less",
  "players": [
   { "hand": ["Inquisition of Kozilek"], "battlefield": ["Swamp"] },
   { "hand": ["Act of Aggression", "Mountain", "Serra Angel"] }
  ],
  "steps": [
   { "cast": "Inquisition of Kozilek", "targets": ["p1"] },
   { "resolve": true, "auto": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Inquisition of Kozilek"] },
    { "hand": ["Act of Aggression", "Mountain", "Serra Angel"], "graveyard": [] }
   ]
  }
 },
 {
  "name": "ruling: an untapped opposing creature can be targeted and taken",
  "players": [
   { "hand": ["Act of Aggression"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Act of Aggression", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 16, "battlefield_has": ["Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] } ],
   "tapped": { "Grizzly Bears": false },
   "keywords": { "Grizzly Bears": ["Haste"] }
  }
 },
 {
  "name": "gains control of an opposing creature, untaps it and gives haste (paying 4 life for the Phyrexian symbols)",
  "players": [
   { "hand": ["Act of Aggression"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
  ],
  "steps": [
   { "cast": "Act of Aggression", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 16, "battlefield_has": ["Grizzly Bears"] },
    { "battlefield_lacks": ["Grizzly Bears"] }
   ],
   "tapped": { "Grizzly Bears": false },
   "keywords": { "Grizzly Bears": ["Haste"] }
  }
 },
 {
  "name": "can't be cast without an opposing creature to target",
  "players": [
   { "hand": ["Act of Aggression"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": [] }
  ],
  "steps": [
   { "cast": "Act of Aggression", "illegal": true }
  ],
  "expect": { "players": [{ "life": 20 }, {}] }
 }
]
