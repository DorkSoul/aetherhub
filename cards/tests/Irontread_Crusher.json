[
 {
  "name": "ruling: destroying a crewed Vehicle does not affect the creature that crewed it",
  "players": [
   { "hand": ["Doom Blade"], "battlefield": ["Irontread Crusher", "Hill Giant", "Swamp", "Swamp"] },
   { }
  ],
  "steps": [
   { "activate": "Irontread Crusher", "auto": true },
   { "resolve": true },
   { "cast": "Doom Blade", "targets": ["Irontread Crusher"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard_has": ["Irontread Crusher"], "battlefield_has": ["Hill Giant"] }, { } ],
   "tapped": { "Hill Giant": true }
  }
 },
 {
  "name": "ruling: an uncrewed Vehicle is not a creature, so Doom Blade cannot target it",
  "players": [
   { "hand": ["Doom Blade"], "battlefield": ["Irontread Crusher", "Hill Giant", "Swamp", "Swamp"] },
   { }
  ],
  "steps": [
   { "cast": "Doom Blade", "targets": ["Irontread Crusher"], "illegal": true }
  ],
  "expect": {
   "players": [ { "hand": ["Doom Blade"], "battlefield_has": ["Irontread Crusher"] }, { } ]
  }
 },
 {
  "name": "ruling: a creature that just came under your control can crew",
  "players": [
   { "battlefield": ["Irontread Crusher", { "name": "Hill Giant", "sick": true }] },
   { }
  ],
  "steps": [
   { "activate": "Irontread Crusher", "auto": true },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Irontread Crusher": [6, 6] },
   "tapped": { "Hill Giant": true }
  }
 },
 {
  "name": "ruling: crewed during the beginning of combat, the Crusher can still attack for 6",
  "players": [
   { "battlefield": ["Irontread Crusher", "Hill Giant"] },
   { }
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "activate": "Irontread Crusher", "auto": true },
   { "resolve": true },
   { "attack": [ { "card": "Irontread Crusher", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { }, { "life": 14 } ]
  }
 },
 {
  "name": "crewed with power 3 it becomes a 6/6 creature until end of turn",
  "players": [
   { "battlefield": ["Irontread Crusher", "Hill Giant"] },
   { }
  ],
  "steps": [
   { "activate": "Irontread Crusher", "auto": true }
  ],
  "expect": {
   "pt": { "Irontread Crusher": [6, 6] },
   "tapped": { "Hill Giant": true }
  }
 },
 {
  "name": "crew 3 needs total power 3: a 2/2 alone cannot crew it",
  "players": [
   { "battlefield": ["Irontread Crusher", "Grizzly Bears"] },
   { }
  ],
  "steps": [
   { "activate": "Irontread Crusher", "illegal": true }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false }
  }
 },
 {
  "name": "crew 3 resolves: the crewed Crusher is a 6/6 creature once the crew ability resolves",
  "players": [
   { "battlefield": ["Irontread Crusher", "Hill Giant"] },
   { }
  ],
  "steps": [
   { "activate": "Irontread Crusher", "auto": true },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Irontread Crusher": [6, 6] },
   "tapped": { "Hill Giant": true }
  }
 }
