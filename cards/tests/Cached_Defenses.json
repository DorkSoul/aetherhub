[
  {
    "name": "bolster 3 puts the counters on the creature with least toughness",
    "players": [
      { "hand": ["Cached Defenses"], "battlefield": ["Forest", "Forest", "Forest", "Hill Giant", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Cached Defenses" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [5, 5], "Hill Giant": [3, 3] },
      "players": [ { "graveyard": ["Cached Defenses"] }, {} ]
    }
  },
  {
    "name": "bolster with no creature does nothing",
    "players": [
      { "hand": ["Cached Defenses"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Cached Defenses" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Cached Defenses"] }, {} ]
    }
  },
  {
    "name": "ruling: the creature is chosen as bolster resolves (a response that kills the least-toughness creature)",
    "players": [
      { "hand": ["Cached Defenses", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Cached Defenses" },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Hill Giant": [6, 6] },
      "players": [ { "graveyard_has": ["Grizzly Bears", "Lightning Bolt", "Cached Defenses"] }, {} ]
    }
  },
  {
    "name": "ruling: bolster does not target, so a creature with protection from green still gets the counters",
    "players": [
      { "hand": ["Cached Defenses"], "battlefield": ["Forest", "Forest", "Forest", "Spectral Lynx", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Cached Defenses" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Spectral Lynx": [5, 4], "Grizzly Bears": [2, 2] },
      "players": [ { "graveyard": ["Cached Defenses"] }, {} ]
    }
  }
]
