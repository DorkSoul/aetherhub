  {
    "name": "ruling: a blocked attacker is not an unblocked creature (illegal target)",
    "players": [ { "battlefield": ["Gossamer Chains", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ], "player": 1 },
      { "activate": "Gossamer Chains", "ability": 0, "targets": ["Hill Giant"], "illegal": true }
