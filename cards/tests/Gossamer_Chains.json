    "expect": { "players": [ { "battlefield_has": ["Gossamer Chains"] }, {} ] }
  },
  {
    "name": "ruling: returning the Chains is the cost, so once it is in hand it cannot be activated again",
    "players": [ { "battlefield": ["Gossamer Chains", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
