  {
    "name": "ruling: a creature that is not attacking is not an unblocked creature (illegal target)",
    "players": [ { "battlefield": ["Gossamer Chains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Gossamer Chains", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Gossamer Chains"] }, {} ] }
