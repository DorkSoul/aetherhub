[
  {
    "name": "descended this turn and opponent cannot pay: 3 damage to each opponent",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Zoyowa Lava-Tongue", "Grizzly Bears", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "no descend this turn: no trigger at the end step",
