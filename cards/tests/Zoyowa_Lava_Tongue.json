      { "battlefield": ["Zoyowa Lava-Tongue", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "opponent discards a card instead of taking damage",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Zoyowa Lava-Tongue", "Grizzly Bears", "Mountain"] },
      { "hand": ["Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End", "answers": [true, 0] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        { "life": 20, "hand_count": 0, "graveyard_has": ["Island"] }
      ]
    }
  },
  {
    "name": "opponent who could discard declines and takes 3 damage",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Zoyowa Lava-Tongue", "Grizzly Bears", "Mountain"] },
      { "hand": ["Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
