    "expect": {
      "players": [
        { "life": 20 },
        { "life": 17, "hand": ["Island"] }
      ]
    }
  },
  {
    "name": "opponent sacrifices a permanent instead of taking damage",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Zoyowa Lava-Tongue", "Grizzly Bears", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End", "answers": [true, 1] },
