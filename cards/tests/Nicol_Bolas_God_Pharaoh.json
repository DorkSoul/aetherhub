    ],
    "steps": [
      { "activate": "Nicol Bolas, God-Pharaoh", "ability": 1 },
      { "resolve": true, "answers": [["Island", "Forest"]] }
    ],
    "expect": {
      "counters": { "Nicol Bolas, God-Pharaoh": { "Loyalty": 8 } },
      "players": [
        { "hand_count": 0 },
        { "hand": ["Grizzly Bears"], "exile": ["Island", "Forest"] }
      ]
