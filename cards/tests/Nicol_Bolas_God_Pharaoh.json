    "name": "ruling: the exiled card can still be cast after Nicol Bolas has left the battlefield",
    "players": [
      { "battlefield": [ { "name": "Nicol Bolas, God-Pharaoh", "counters": { "Loyalty": 1 } } ] },
      { "hand": [ "Lightning Bolt" ], "battlefield": [ "Mountain" ], "library": [ "Island", "Grizzly Bears", "Forest" ] }
    ],
    "steps": [
      { "activate": "Nicol Bolas, God-Pharaoh", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Nicol Bolas, God-Pharaoh"], "player": 1 },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
