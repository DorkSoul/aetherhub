[
  {
    "name": "+2: opponent exiles through the first nonland card, which you may cast free this turn",
    "players": [
      { "battlefield": [ { "name": "Nicol Bolas, God-Pharaoh", "counters": { "Loyalty": 7 } } ] },
      { "library": [ "Island", "Grizzly Bears", "Forest" ] }
    ],
    "steps": [
      { "activate": "Nicol Bolas, God-Pharaoh", "ability": 0, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Nicol Bolas, God-Pharaoh": { "Loyalty": 9 } },
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "exile": ["Island"], "library_count": 1 }
      ]
    }
  },
  {
    "name": "+2: a card exiled this way stays exiled if you do not cast it this turn",
    "players": [
      { "battlefield": [ { "name": "Nicol Bolas, God-Pharaoh", "counters": { "Loyalty": 7 } } ] },
      { "library": [ "Island", "Grizzly Bears", "Forest" ] }
    ],
    "steps": [
      { "activate": "Nicol Bolas, God-Pharaoh", "ability": 0, "targets": ["p1"] },
