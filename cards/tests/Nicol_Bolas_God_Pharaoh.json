      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"] },
        { "exile": ["Island", "Grizzly Bears"] }
      ]
    }
  },
  {
