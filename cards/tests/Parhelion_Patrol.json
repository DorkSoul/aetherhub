[
  {
    "name": "attacks without tapping (vigilance)",
    "players": [
      { "battlefield": ["Parhelion Patrol"] },
      { }
    ],
    "steps": [
      { "attack": [{ "card": "Parhelion Patrol", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 18 }
      ],
      "tapped": { "Parhelion Patrol": false }
    }
  },
  {
    "name": "mentor puts a +1/+1 counter on a lesser-power attacker",
    "players": [
      { "battlefield": ["Parhelion Patrol", "Llanowar Elves"] },
      { }
    ],
    "steps": [
      { "attack": [{ "card": "Parhelion Patrol", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" }] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Llanowar Elves": { "p1p1": 1 } }
    }
  },
  {
    "name": "ruling: mentor uses the attacker's last known power when it leaves before the trigger resolves",
    "players": [
      { "battlefield": ["Parhelion Patrol", "Llanowar Elves"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "attack": [{ "card": "Parhelion Patrol", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" }] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Parhelion Patrol"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Llanowar Elves"], "graveyard": ["Parhelion Patrol"] },
        { "graveyard": ["Lightning Bolt"] }
      ],
      "counters": { "Llanowar Elves": { "p1p1": 1 } },
      "pt": { "Llanowar Elves": [2, 2] }
    }
  },
  {
    "name": "ruling: a second mentor trigger adds no counter once the target no longer has less power",
    "players": [
      { "battlefield": ["Parhelion Patrol", "Parhelion Patrol", "Llanowar Elves"] },
      { }
    ],
    "steps": [
      { "attack": [{ "card": "Parhelion Patrol", "at": "p1" }, { "card": "Parhelion Patrol", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" }] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Llanowar Elves": { "p1p1": 1 } },
      "pt": { "Llanowar Elves": [2, 2] }
    }
  }
]
