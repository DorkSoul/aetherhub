[
  {
    "name": "bounces an opposing creature and draws (full cost on a mana value 2 target)",
    "players": [
      { "hand": ["Roadside Blowout"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Roadside Blowout", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand": ["Grizzly Bears"], "battlefield": [] } ]
    }
  },
  {
    "name": "costs {2} less when targeting a mana value 1 permanent",
    "players": [
      { "hand": ["Roadside Blowout"], "battlefield": ["Island"] },
      { "battlefield": ["Birds of Paradise"] }
    ],
    "steps": [ { "cast": "Roadside Blowout", "targets": ["Birds of Paradise"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand": ["Birds of Paradise"] } ]
    }
  },
  {
    "name": "without the discount, one Island cannot pay for a mana value 2 target",
    "players": [
      { "hand": ["Roadside Blowout"], "battlefield": ["Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Roadside Blowout", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Roadside Blowout"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: X counts as 0 in a permanent's mana cost, so Slumbering Trudge ({X}{G}) has mana value 1 and the discount applies",
    "players": [
      { "hand": ["Roadside Blowout"], "battlefield": ["Island"] },
      { "battlefield": ["Slumbering Trudge"] }
    ],
    "steps": [ { "cast": "Roadside Blowout", "targets": ["Slumbering Trudge"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "hand": ["Slumbering Trudge"], "battlefield": [] } ]
    }
  }
]
