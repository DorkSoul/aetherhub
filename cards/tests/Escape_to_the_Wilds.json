[
  {
    "name": "exiles the top five cards of the library",
    "players": [
      { "hand": ["Escape to the Wilds"], "battlefield": ["Mountain", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Lightning Bolt", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Escape to the Wilds" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Forest", "Lightning Bolt", "Island", "Island", "Island"], "graveyard": ["Escape to the Wilds"] },
        {}
      ]
    }
  },
  {
    "name": "an exiled land can be played this turn as the additional land drop",
    "players": [
      { "hand": ["Escape to the Wilds"], "battlefield": ["Mountain", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Escape to the Wilds" },
      { "resolve": true },
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Forest"], "exile": ["Island", "Island", "Island", "Island"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: exiled cards you never play stay in exile after their window ends",
    "players": [
      { "hand": ["Escape to the Wilds"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt", "Divination", "Grizzly Bears", "Serra Angel", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Escape to the Wilds" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "turn": 4,
      "players": [
        { "exile": ["Lightning Bolt", "Divination", "Grizzly Bears", "Serra Angel", "Hill Giant"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an exiled sorcery cannot be cast on the opponent's turn but can on your own turn",
    "players": [
      { "hand": ["Escape to the Wilds"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest", "Island", "Island", "Island"], "library": ["Divination", "Lightning Bolt", "Grizzly Bears", "Serra Angel", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Escape to the Wilds" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Divination", "illegal": true },
      { "advance_to": "Main1" },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "turn": 3,
      "players": [
        { "graveyard_has": ["Divination"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: casting an exiled card moves it out of exile",
    "players": [
      { "hand": ["Escape to the Wilds"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt", "Divination", "Grizzly Bears", "Serra Angel", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Escape to the Wilds" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt"], "exile": ["Divination", "Grizzly Bears", "Serra Angel", "Hill Giant"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the additional land can be played from hand, not only from the exiled cards",
    "players": [
      { "hand": ["Escape to the Wilds", "Island", "Island"], "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Forest"], "library": ["Lightning Bolt", "Divination", "Grizzly Bears", "Serra Angel", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Escape to the Wilds" },
      { "resolve": true },
      { "play_land": "Island" },
      { "play_land": "Island" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Island", "Island"], "hand_count": 0 },
        {}
      ]
    }
  }
]
