[
 {
  "name": "enters: each opposing creature gets a rejection counter; end step: the rejected creature goes to its owner's library (top)",
  "players": [
   {
    "hand": ["Tolarian Contempt"],
    "battlefield": ["Island", "Island", "Island", "Island", "Island"]
   },
   {
    "battlefield": ["Grizzly Bears", "Llanowar Elves"],
    "library": ["Mountain"]
   }
  ],
  "steps": [
   { "cast": "Tolarian Contempt" },
   { "resolve": true },
   {
    "advance_to": "End",
    "targets": ["Grizzly Bears"],
    "answers": [true]
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "battlefield_lacks": ["Grizzly Bears"],
     "battlefield_has": ["Llanowar Elves"],
     "library_count": 2
    }
   ],
   "counters": {
    "Llanowar Elves": { "rejection": 1 }
   }
  }
 },
 {
  "name": "owner chooses the bottom of the library instead",
  "players": [
   {
    "battlefield": ["Tolarian Contempt"]
   },
   {
    "battlefield": [{ "name": "Grizzly Bears", "counters": { "rejection": 1 } }],
    "library": ["Mountain"]
   }
  ],
  "steps": [
   {
    "advance_to": "End",
    "targets": ["Grizzly Bears"],
    "answers": [false]
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "battlefield_lacks": ["Grizzly Bears"],
     "library_count": 2
    }
   ]
  }
 },
 {
  "name": "no rejected creature on the opponent's side: the end step trigger does nothing",
  "players": [
   {
    "battlefield": ["Tolarian Contempt"]
   },
   {
    "battlefield": ["Grizzly Bears"],
    "library": ["Mountain"]
   }
  ],
  "steps": [
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    {},
    {
     "battlefield_has": ["Grizzly Bears"],
     "library_count": 1
    }
   ]
  }
 }
]
