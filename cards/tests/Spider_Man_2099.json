[
  {
    "name": "can't be cast during your first turn",
    "players": [
      { "hand": ["Spider-Man 2099"], "battlefield": ["Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Spider-Man 2099", "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "can't be cast during your third turn but can during your fourth",
    "players": [
      { "hand": ["Spider-Man 2099"], "battlefield": ["Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Spider-Man 2099", "illegal": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Spider-Man 2099" },
      { "resolve": true }
    ],
    "expect": {
      "turn": 7,
      "pt": { "Spider-Man 2099": [2, 3] },
      "keywords": { "Spider-Man 2099": ["DoubleStrike", "Vigilance"] }
    }
  },
  {
    "name": "playing a land from your graveyard makes him deal damage equal to his power at your end step",
    "players": [
      { "battlefield": ["Spider-Man 2099", "Crucible of Worlds"], "graveyard": ["Mountain"] },
      {}
    ],
    "steps": [
      { "play_land": "Mountain" },
      { "advance_to": "End", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "playing a land from your hand doesn't trigger him",
    "players": [
      { "hand": ["Mountain"], "battlefield": ["Spider-Man 2099"] },
      {}
    ],
    "steps": [
      { "play_land": "Mountain" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "casting a spell from your graveyard makes him deal damage at your end step",
    "players": [
      { "battlefield": ["Spider-Man 2099", "Mountain", "Mountain", "Mountain"], "graveyard": ["Faithless Looting"] },
      {}
    ],
    "steps": [
      { "cast": "Faithless Looting", "alt": 0 },
      { "resolve": true },
      { "advance_to": "End", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "nothing from outside the hand: no damage",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Spider-Man 2099", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  }
]
