[
  {
    "name": "your creatures get +1/+1 until end of turn, opponents' creatures do not",
    "players": [
      { "hand": ["Charge"], "battlefield": ["Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Charge" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Hill Giant"] }],
      "pt": { "Grizzly Bears": [3, 3], "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "creatures that enter after the spell resolves are not affected",
    "players": [
      { "hand": ["Charge"], "battlefield": ["Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Charge" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: a creature cast after Charge resolves does not get +1/+1",
    "players": [
      { "hand": ["Charge", "Grizzly Bears"], "battlefield": ["Plains", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Charge" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  }
]
