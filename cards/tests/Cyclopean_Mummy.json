[
  {
    "name": "dies to a sacrifice and is exiled instead of staying in the graveyard",
    "players": [ { "hand": ["Diabolic Edict"], "battlefield": ["Swamp", "Swamp", "Cyclopean Mummy"] }, {} ],
    "steps": [
      { "cast": "Diabolic Edict", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Cyclopean Mummy"], "graveyard_has": ["Diabolic Edict"] }, {} ]
    }
  },
  {
    "name": "dies to damage and is exiled",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Cyclopean Mummy"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Cyclopean Mummy"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Cyclopean Mummy"] }, {} ]
    }
  },
  {
    "name": "ruling: the Mummy goes to the graveyard first, so Blood Artist sees its death, then it is exiled",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Blood Artist", "Mountain", "Cyclopean Mummy"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Cyclopean Mummy"] },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [ { "life": 21, "exile": ["Cyclopean Mummy"] }, { "life": 19 } ]
    }
  },
  {
    "name": "ruling: a Mummy spell that is countered is not exiled (it did not die from the battlefield)",
    "players": [ { "hand": ["Cyclopean Mummy"], "battlefield": ["Swamp", "Swamp"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      { "cast": "Cyclopean Mummy" },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Cyclopean Mummy" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Cyclopean Mummy"], "exile": [] }, { "graveyard_has": ["Counterspell"] } ]
    }
  }
]
