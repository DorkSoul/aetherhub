[
  {
    "name": "one nontoken creature you control died this turn: one Bear token",
    "players": [
      { "hand": ["Lightning Bolt", "Caller of the Claw"], "battlefield": ["Mountain", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Caller of the Claw" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Caller of the Claw", "Bear 2-2 Green"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "a creature that died on an earlier turn does not count",
    "players": [{ "hand": ["Caller of the Claw"], "battlefield": ["Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {}],
    "steps": [{ "cast": "Caller of the Claw" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Caller of the Claw"], "battlefield_lacks": ["Bear 2-2 Green"] }, {}] }
  },
  {
    "name": "an opponent's creature dying this turn does not count",
    "players": [
      { "hand": ["Lightning Bolt", "Caller of the Claw"], "battlefield": ["Mountain", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Caller of the Claw" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Caller of the Claw"], "battlefield_lacks": ["Bear 2-2 Green"] }, { "graveyard": ["Grizzly Bears"] }]
    }
  }
]
