      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Ninja of the Deep Hours" } ] },
      { "activate": "Turtle Lair", "ability": 0, "targets": ["Ninja of the Deep Hours"] },
      { "resolve": true },
      { "advance_to": "Main2" }
