  },
  {
    "name": "ruling: Lair's can't-be-blocked ability used after the block does not unblock the Ninja",
    "players": [
      { "battlefield": ["Turtle Lair", "Plains", "Plains", "Plains", "Ninja of the Deep Hours"] },
      { "battlefield": ["Grizzly Bears"] }
