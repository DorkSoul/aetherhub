[
  {
    "name": "taps the target, it stays tapped through its controller's next untap step, and you draw",
    "players": [
      { "hand": ["Crippling Chill"], "battlefield": ["Island", "Island", "Island"], "library": ["Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Crippling Chill", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "players": [{ "hand": ["Mountain"], "graveyard": ["Crippling Chill"] }, {}]
    }
  },
  {
    "name": "untaps in the untap step after the skipped one",
    "players": [
      { "hand": ["Crippling Chill"], "battlefield": ["Island", "Island", "Island"], "library": ["Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Crippling Chill", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": { "tapped": { "Grizzly Bears": false } }
  },
  {
    "name": "can target an already tapped creature and still skips the untap step",
    "players": [
      { "hand": ["Crippling Chill"], "battlefield": ["Island", "Island", "Island", { "name": "Grizzly Bears", "tapped": true }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Crippling Chill", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "ruling: can target a creature that is already tapped; it still does not untap in its controller's next untap step",
    "players": [
      { "hand": ["Crippling Chill"], "battlefield": ["Island", "Island", "Island"], "library": ["Mountain"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Crippling Chill", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  }
]
