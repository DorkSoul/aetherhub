[
  {
    "name": "can attack when no enchantment is on the battlefield",
    "players": [
      { "battlefield": [{ "name": "Wirecat", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Wirecat", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  },
  {
    "name": "cannot attack while an enchantment is on the battlefield",
    "players": [
      { "battlefield": [{ "name": "Wirecat", "sick": false }] },
      { "battlefield": ["Blood Funnel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Wirecat", "at": "p1" }], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "cannot attack while an enchantment is out: Wirecat is dropped from the attack, the Bears hit for 2",
    "players": [
      { "battlefield": [{ "name": "Wirecat", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Blood Funnel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Wirecat", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  },
  {
    "name": "cannot block while an enchantment is out: Wirecat's block is dropped and the Bears connect",
    "players": [
      { "battlefield": [{ "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false }] },
      { "battlefield": ["Wirecat", "Ornithopter", "Blood Funnel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Wirecat", "attacker": "Grizzly Bears" }, { "blocker": "Ornithopter", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  }
]
