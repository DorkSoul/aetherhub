[
  {
    "name": "cast in main phase: -4/-0, draw, tap it and it skips its next untap",
    "players": [ { "hand": ["Code of Constraint"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Code of Constraint", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [-2, 2] },
      "tapped": { "Grizzly Bears": true },
      "players": [ { "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "cast in the end step: -4/-0 and a draw but no tap (addendum needs main phase)",
    "players": [ { "hand": ["Code of Constraint"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Code of Constraint", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [-2, 2] },
      "tapped": { "Grizzly Bears": false },
      "players": [ { "hand_count": 1 }, {} ]
    }
  }
,
{
  "name": "ruling: a creature removed in response makes the spell fizzle: no draw",
  "players": [ { "hand": ["Code of Constraint"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] }, { "battlefield": ["Grizzly Bears", "Mountain"], "hand": ["Lightning Bolt"] } ],
  "steps": [ { "cast": "Code of Constraint", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true, "player": 1 } ],
  "expect": { "players": [ { "hand_count": 0, "library_top": ["Forest"], "graveyard_has": ["Code of Constraint"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] }
},
{
  "name": "ruling: the creature stays tapped through its controller's next untap step",
  "players": [ { "hand": ["Code of Constraint"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Code of Constraint", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main1" } ],
  "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": true } }
}
]
