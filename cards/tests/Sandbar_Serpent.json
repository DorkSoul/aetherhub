[
 { "name": "cycles for {2} and draws a card",
   "players": [ { "hand": ["Sandbar Serpent"], "battlefield": ["Island", "Island"] }, {} ],
   "steps": [ { "activate": "Sandbar Serpent", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Sandbar Serpent"], "hand_count": 1 }, {} ] } },
 { "name": "cannot cycle with only one land",
   "players": [ { "hand": ["Sandbar Serpent"], "battlefield": ["Island"] }, {} ],
   "steps": [ { "activate": "Sandbar Serpent", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Sandbar Serpent"] }, {} ] } },
 { "name": "ruling: Stifle counters cycling (an activated ability)",
   "players": [ { "hand": ["Sandbar Serpent"], "battlefield": ["Island", "Island"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
   "steps": [ { "activate": "Sandbar Serpent", "ability": 0 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Sandbar Serpent" }] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Sandbar Serpent"], "hand_count": 0 }, { "graveyard": ["Stifle"] } ] } },
 { "name": "ruling: a spell counter cannot target cycling",
   "players": [ { "hand": ["Sandbar Serpent"], "battlefield": ["Island", "Island"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "activate": "Sandbar Serpent", "ability": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Sandbar Serpent" }], "illegal": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Sandbar Serpent"], "hand_count": 1 }, { "hand": ["Counterspell"] } ] } }
]
