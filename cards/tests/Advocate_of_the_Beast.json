[
 {
  "name": "puts a +1/+1 counter on a Beast you control at the beginning of your end step",
  "players": [{ "battlefield": ["Advocate of the Beast", "Beast 4-4"] }, {}],
  "steps": [
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": { "players": [{}, {}], "counters": { "Beast 4-4": { "p1p1": 1 } }, "pt": { "Beast 4-4": [5, 5] } }
 },
 {
  "name": "does nothing without a Beast you control (opponent's Beast is not a legal target)",
  "players": [{ "battlefield": ["Advocate of the Beast"] }, { "battlefield": ["Beast 4-4"] }],
  "steps": [
   { "advance_to": "End" }
  ],
  "expect": { "players": [{}, {}], "pt": { "Advocate of the Beast": [2, 3], "Beast 4-4": [4, 4] } }
 },
 {
  "name": "ruling: if no Beast is controlled as the end step begins, the ability is removed and does nothing (Beast killed in main phase)",
  "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Advocate of the Beast", "Anurid Barkripper"] }, {}],
  "steps": [
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "targets": ["Anurid Barkripper"] },
   { "resolve": true },
   { "advance_to": "End" }
  ],
  "expect": { "stack_empty": true, "players": [{ "graveyard_has": ["Anurid Barkripper"], "battlefield_has": ["Advocate of the Beast"] }, {}], "pt": { "Advocate of the Beast": [2, 3] } }
 }
]
