  {
    "name": "cycling a card puts a counter on it and shrinks the enchanted creature",
    "players": [
      { "hand": ["Withering Hex", "Wipe Clean"], "battlefield": ["Swamp", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Withering Hex", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Wipe Clean", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [1, 1] },
      "players": [{ "graveyard": ["Wipe Clean"] }, {}]
    }
  },
  {
    "name": "no cycling: enchanted creature keeps its printed P/T",
    "players": [
      { "hand": ["Withering Hex"], "battlefield": ["Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Withering Hex", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "players": [{ "battlefield_has": ["Withering Hex"] }, {}]
    }
  }
]
