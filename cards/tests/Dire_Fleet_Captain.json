[
  { "name": "attacking alone it gets no bonus",
    "players": [ { "battlefield": ["Mountain", "Swamp", { "name": "Dire Fleet Captain", "sick": false }] }, {} ],
    "steps": [
      { "attack": [ { "card": "Dire Fleet Captain", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Dire Fleet Captain": [2, 2] } }
  },
  { "name": "gets +1/+1 for each other attacking Pirate",
    "players": [ { "battlefield": ["Mountain", "Swamp", { "name": "Dire Fleet Captain", "sick": false }, { "name": "Brazen Buccaneers", "sick": false }] }, {} ],
    "steps": [
      { "attack": [ { "card": "Dire Fleet Captain", "at": "p1" }, { "card": "Brazen Buccaneers", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Dire Fleet Captain": [3, 3], "Brazen Buccaneers": [2, 2] } }
  },
  {
    "name": "ruling: bonus is fixed on resolution; still +1/+1 after the other Pirate dies in combat",
    "players": [
      { "battlefield": ["Mountain", "Swamp", { "name": "Dire Fleet Captain", "sick": false }, { "name": "Brazen Buccaneers", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dire Fleet Captain", "at": "p1" }, { "card": "Brazen Buccaneers", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Brazen Buccaneers" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Brazen Buccaneers"] }, { "life": 17, "graveyard": ["Grizzly Bears"] } ],
      "pt": { "Dire Fleet Captain": [3, 3] }
    }
  }
]
