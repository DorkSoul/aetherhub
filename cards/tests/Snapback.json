[
  {
    "name": "returns target creature to its owner's hand",
    "players": [
      { "hand": ["Snapback"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Snapback", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Snapback"] },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "alternative cost: exile a blue card from hand instead of paying",
    "players": [
      { "hand": ["Snapback", "Snow Devil"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Snapback", "alt": 0, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Snow Devil"], "graveyard": ["Snapback"] },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the alternative cost is still increased by Thalia's {1} tax: a land pays it",
    "players": [
      { "hand": ["Snapback", "Snow Devil"], "battlefield": ["Island"] },
      { "battlefield": ["Thalia, Guardian of Thraben", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Snapback", "alt": 0, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Snow Devil"], "graveyard": ["Snapback"] },
        { "hand": ["Grizzly Bears"], "battlefield_has": ["Thalia, Guardian of Thraben"] }
      ]
    }
  },
  {
    "name": "ruling: the alternative cost plus Thalia's {1} tax cannot be paid with no mana",
    "players": [
      { "hand": ["Snapback", "Snow Devil"] },
      { "battlefield": ["Thalia, Guardian of Thraben", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Snapback", "alt": 0, "targets": ["p1:Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Snapback", "Snow Devil"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
