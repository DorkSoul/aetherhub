[
 { "name": "you can't cast creature spells",
   "players": [ { "hand": ["Hill Giant"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grid Monitor"] }, {} ],
   "steps": [ { "cast": "Hill Giant", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Hill Giant"] }, {} ] } },
 { "name": "noncreature spells are not affected",
   "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Mountain", "Grid Monitor"] }, { } ],
   "steps": [ { "cast": "Shock", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Shock"] }, { "life": 18 } ] } },
 { "name": "opponents can still cast creature spells (flash creature)",
   "players": [ { "battlefield": ["Grid Monitor"] }, { "hand": ["Spectral Sailor"], "battlefield": ["Island"] } ],
   "steps": [ { "pass": true }, { "cast": "Spectral Sailor", "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Spectral Sailor"] } ] } },
 { "name": "ruling: creature tokens can still be created while creature spells are barred",
   "players": [ { "hand": ["Raise the Alarm"], "battlefield": ["Plains", "Plains", "Grid Monitor"] }, {} ],
   "steps": [ { "cast": "Raise the Alarm" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Soldier", "Soldier"] }, {} ] } },
 { "name": "ruling: an artifact creature spell is a creature spell and cannot be cast",
   "players": [ { "hand": ["Arcbound Worker"], "battlefield": ["Plains", "Grid Monitor"] }, {} ],
   "steps": [ { "cast": "Arcbound Worker", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Arcbound Worker"] }, {} ] } }
