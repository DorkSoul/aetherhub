[
  {
    "name": "adds R for each creature you control",
    "players": [
      { "hand": ["Battle Hymn"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears", "Hill Giant", "Savannah Lions"] },
      {}
    ],
    "steps": [
      { "cast": "Battle Hymn" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "pool": { "R": 3 } }, {}]
    }
  },
  {
    "name": "no creatures: adds no mana",
    "players": [
      { "hand": ["Battle Hymn"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Battle Hymn" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "pool": { "R": 0 } }, {}]
    }
  },
  {
    "name": "ruling: the amount is counted on resolution, so a creature killed in response is not counted",
    "players": [
      { "hand": ["Battle Hymn", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears", "Savannah Lions"] },
      {}
    ],
    "steps": [
      { "cast": "Battle Hymn" },
      { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "pool": { "R": 1 }, "graveyard_has": ["Savannah Lions"] }, {}]
    }
  }
]
