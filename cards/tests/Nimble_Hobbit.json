[
  {
    "name": "paying 2W taps target creature an opponent controls",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Nimble Hobbit"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Nimble Hobbit",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "no food and no mana: nothing happens",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Nimble Hobbit"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Nimble Hobbit",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "ruling: the reflexive target is chosen when it goes on the stack (Hill Giant tapped, not Grizzly Bears)",
    "players": [
      { "battlefield": ["Plains", "Plains", "Plains", "Nimble Hobbit"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Nimble Hobbit", "at": "p1" } ] },
      { "resolve": true, "answers": [true, "Hill Giant"] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, {} ],
      "tapped": { "Hill Giant": true, "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: a Food artifact creature (Tough Cookie) can be sacrificed to pay the cost",
    "players": [
      { "battlefield": ["Nimble Hobbit", "Tough Cookie"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Nimble Hobbit", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Tough Cookie"] }, {} ],
      "tapped": { "Grizzly Bears": true }
    }
  }
]
