[
  {
    "name": "enters: gain control of the enchanted land until end of turn",
    "players": [
      { "hand": ["Wellspring"], "battlefield": ["Forest", "Plains", "Island"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Wellspring", "targets": ["Mountain"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mountain", "Wellspring"] },
        { "battlefield_lacks": ["Mountain"] }
      ]
    }
  },
  {
    "name": "your upkeep: untaps the enchanted land and you gain control of it until end of turn",
    "players": [
      { "hand": ["Wellspring"], "battlefield": ["Forest", "Plains", "Island"] },
      { "battlefield": [ { "name": "Mountain", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Wellspring", "targets": ["Mountain"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mountain", "Wellspring"] },
        { "battlefield_lacks": ["Mountain"] }
      ],
      "tapped": { "Mountain": false }
    }
  },
  {
    "name": "opponent's upkeep: no untap and no control change",
    "players": [
      { "hand": ["Wellspring"], "battlefield": ["Forest", "Plains", "Island"] },
      { "battlefield": [ { "name": "Mountain", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Wellspring", "targets": ["Mountain"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Mountain"] },
        { "battlefield_has": ["Mountain"] }
      ]
    }
  },
  {
    "name": "ruling: control lasts until end of turn even if Wellspring leaves the battlefield",
    "players": [
      { "hand": ["Wellspring", "Disenchant"], "battlefield": ["Forest", "Plains", "Island", "Plains", "Island"] },
      { "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Wellspring", "targets": ["Mountain"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Disenchant", "targets": ["Wellspring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mountain"], "graveyard_has": ["Wellspring"] },
        { "battlefield_lacks": ["Mountain"] }
      ]
    }
  }
]
