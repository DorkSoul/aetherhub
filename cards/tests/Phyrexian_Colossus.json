[
  {
    "name": "doesn't untap during your untap step",
    "players": [
      {
        "battlefield": [
          { "name": "Phyrexian Colossus", "tapped": true }
        ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "advance_to": "Main2", "player": 1 },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Phyrexian Colossus"] },
        {}
      ],
      "tapped": { "Phyrexian Colossus": true }
    }
  },
  {
    "name": "pay 8 life: untap this creature",
    "players": [
      {
        "battlefield": [
          { "name": "Phyrexian Colossus", "tapped": true }
        ]
      },
      {}
    ],
    "steps": [
      { "activate": "Phyrexian Colossus", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 12 },
        {}
      ],
      "tapped": { "Phyrexian Colossus": false }
    }
  },
  {
    "name": "can't be blocked except by three or more creatures: two blockers do not block",
    "players": [
      {
        "battlefield": ["Grizzly Bears", "Hill Giant", "Forest"]
      },
      {
        "battlefield": ["Phyrexian Colossus"]
      }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "attack": [{ "card": "Phyrexian Colossus", "at": "p0" }] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Phyrexian Colossus" },
          { "blocker": "Hill Giant", "attacker": "Phyrexian Colossus" }
        ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 12 },
        {}
      ]
    }
  },
  {
    "name": "can't be blocked except by three or more creatures: three blockers can block",
    "players": [
      {
        "battlefield": ["Grizzly Bears", "Hill Giant", "Savannah Lions"]
      },
      {
        "battlefield": ["Phyrexian Colossus"]
      }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "attack": [{ "card": "Phyrexian Colossus", "at": "p0" }] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Phyrexian Colossus" },
          { "blocker": "Hill Giant", "attacker": "Phyrexian Colossus" },
          { "blocker": "Savannah Lions", "attacker": "Phyrexian Colossus" }
        ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        {}
      ]
    }
  }
