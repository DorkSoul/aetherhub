[
  {
    "name": "heroic: a spell that targets it puts two +1/+1 counters on it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Pheres-Band Thunderhoof", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Pheres-Band Thunderhoof"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Pheres-Band Thunderhoof": [5, 6] },
      "counters": { "Pheres-Band Thunderhoof": { "p1p1": 2 } }
    }
  },
  {
    "name": "a spell that targets another creature does not trigger heroic",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Pheres-Band Thunderhoof", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Pheres-Band Thunderhoof": [3, 4] } }
  },
  {
    "name": "ruling: heroic resolves before the spell (Flame Slash does not kill the 5/6 after the trigger)",
    "players": [ { "hand": ["Flame Slash"], "battlefield": ["Pheres-Band Thunderhoof", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Flame Slash", "targets": ["Pheres-Band Thunderhoof"] },
      { "pass": true },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Pheres-Band Thunderhoof"] }, {} ],
      "pt": { "Pheres-Band Thunderhoof": [5, 6] },
      "counters": { "Pheres-Band Thunderhoof": { "p1p1": 2 } }
    }
  },
  {
    "name": "ruling: a copy of a spell that targets it does not trigger heroic again",
    "players": [ { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Pheres-Band Thunderhoof", "Forest", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Pheres-Band Thunderhoof"] },
      { "cast": "Twincast", "targets": [ { "stack": "Giant Growth" } ] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Pheres-Band Thunderhoof": [11, 12] },
      "counters": { "Pheres-Band Thunderhoof": { "p1p1": 2 } }
    }
  }
]
