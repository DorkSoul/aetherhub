[
  {
    "name": "3B and tap: put a shadow counter on target creature",
    "players": [
      {
        "battlefield": [ "Minas Morgul, Dark Fortress", "Swamp", "Swamp", "Swamp", "Swamp", "Hill Giant" ]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Minas Morgul, Dark Fortress", "ability": 0, "targets": [ "Hill Giant" ] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Hill Giant": { "shadow": 1 } }
    }
  },
  {
    "name": "can target an opponent's creature",
    "players": [
      {
        "battlefield": [ "Minas Morgul, Dark Fortress", "Swamp", "Swamp", "Swamp", "Swamp" ]
      },
      {
        "battlefield": [ "Grizzly Bears" ]
      }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Minas Morgul, Dark Fortress", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "shadow": 1 } }
    }
  },
  {
    "name": "enters tapped",
    "players": [{ "hand": ["Minas Morgul, Dark Fortress"] }, {}],
    "steps": [{ "play_land": "Minas Morgul, Dark Fortress" }],
    "expect": { "tapped": { "Minas Morgul, Dark Fortress": true } }
  },
  {
    "name": "shadow counter makes the creature a Wraith in addition to its other types",
    "players": [
      { "battlefield": ["Minas Morgul, Dark Fortress", "Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Minas Morgul, Dark Fortress", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "subtypes": { "Grizzly Bears": ["Wraith", "Bear"] }
    }
  },
  {
    "name": "ruling: a creature with shadow and flying can only be blocked by a creature with both",
    "players": [
      { "battlefield": ["Minas Morgul, Dark Fortress", "Swamp", "Swamp", "Swamp", "Swamp", "Serra Angel"] },
      { "battlefield": ["Air Elemental"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Minas Morgul, Dark Fortress", "ability": 0, "targets": ["Serra Angel"] },
      { "resolve": true },
      { "attack": [ { "card": "Serra Angel", "at": "p1" } ] },
      { "block": [ { "blocker": "Air Elemental", "attacker": "Serra Angel" } ], "player": 1, "illegal": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  },
  {
    "name": "ruling: a permanent with a shadow counter has shadow",
    "players": [
      { "battlefield": ["Minas Morgul, Dark Fortress", "Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Minas Morgul, Dark Fortress", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1, "illegal": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  }
]
