[
  { "name": "paying by exiling another Elemental keeps it on the battlefield and exiles the Elemental until this leaves",
    "players": [ { "hand": ["Supreme Exemplar"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Air Elemental"] }, {} ],
    "steps": [ { "cast": "Supreme Exemplar" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Supreme Exemplar"], "exile": ["Air Elemental"] }, {} ], "pt": { "Supreme Exemplar": [10, 10] } } },
  { "name": "not paying sacrifices it and the other Elemental stays",
    "players": [ { "hand": ["Supreme Exemplar"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Air Elemental"] }, {} ],
    "steps": [ { "cast": "Supreme Exemplar" }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Supreme Exemplar"], "battlefield_has": ["Air Elemental"] }, {} ] } },
  { "name": "the exiled Elemental returns when Supreme Exemplar leaves the battlefield",
