    "expect": { "players": [ { "battlefield_has": ["Air Elemental"], "graveyard_has": ["Supreme Exemplar"] }, {} ] } },
  { "name": "without another Elemental to exile, the ETB trigger sacrifices it",
    "players": [ { "hand": ["Supreme Exemplar"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Supreme Exemplar" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Supreme Exemplar"] }, {} ] } }
