[
  {
    "name": "assist pays the generic part and the spell is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Out of Bounds"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
