  "players": [
   { "hand": [ "Twinflame", "Lightning Bolt" ], "battlefield": [ "Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Grizzly Bears", "Llanowar Elves" ] },
   {}
  ],
  "steps": [
   { "cast": "Twinflame", "targets": [ "Grizzly Bears", "Llanowar Elves" ] },
