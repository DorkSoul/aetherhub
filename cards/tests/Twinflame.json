    },
    {}
   ]
  }
 },
 {
  "name": "strive: two targets cost 5 in total, so after casting nothing is left for a Lightning Bolt",
  "players": [
   { "hand": [ "Twinflame", "Lightning Bolt" ], "battlefield": [ "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Grizzly Bears", "Hill Giant" ] },
   {}
  ],
  "steps": [
   { "cast": "Twinflame", "targets": [ "Grizzly Bears", "Hill Giant" ] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": [ "p1" ], "illegal": true }
  ],
  "expect": {
   "players": [ { "hand": [ "Lightning Bolt" ] }, { "life": 20 } ]
  }
 },
 {
  "name": "ruling: the token copy's enters-the-battlefield trigger fires (Mulldrifter's copy draws two)",
  "players": [
   { "hand": [ "Twinflame" ], "battlefield": [ "Mountain", "Mountain", "Mulldrifter" ] },
   {}
  ],
  "steps": [
   { "cast": "Twinflame", "targets": [ "Mulldrifter" ] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 2, "battlefield_has": [ "Mulldrifter" ] },
    {}
   ]
  }
 },
 {
  "name": "ruling: the copy tokens see each other enter (Soul Warden gains life for the Mulldrifter copy too)",
  "players": [
   { "hand": [ "Twinflame" ], "battlefield": [ "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Soul Warden", "Mulldrifter" ] },
   {}
  ],
  "steps": [
   { "cast": "Twinflame", "targets": [ "Soul Warden", "Mulldrifter" ] },
   { "resolve": true },
   { "resolve": true },
   { "resolve": true },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 23 }, {} ]
  }
 },
 {
  "name": "ruling: a copy of a creature with {X} in its cost has X = 0, so the Hangarback token enters as a 0/0 and dies",
  "players": [
