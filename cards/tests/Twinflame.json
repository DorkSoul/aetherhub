   {}
  ],
  "steps": [
   { "cast": "Twinflame", "targets": [ "Hangarback Walker" ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": [ "Mountain", "Mountain", "Hangarback Walker" ], "graveyard_has": [ "Twinflame" ] },
    {}
   ]
  }
 },
 {
