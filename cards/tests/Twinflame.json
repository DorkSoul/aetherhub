  "expect": {
   "players": [
    { "battlefield": [ "Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest", "Grizzly Bears", "Grizzly Bears" ], "graveyard_has": [ "Lightning Bolt", "Llanowar Elves" ] },
    {}
   ]
  }
 },
 {
  "name": "ruling: if every target is illegal on resolution, Twinflame does nothing",
  "players": [
