   {
    "hand": [ "Twinflame" ],
    "battlefield": [ "Mountain", "Mountain", "Forest", "Forest", "Grizzly Bears", "Hill Giant" ]
   },
   {}
  ],
  "steps": [
   { "cast": "Twinflame", "targets": [ "Grizzly Bears" ] },
