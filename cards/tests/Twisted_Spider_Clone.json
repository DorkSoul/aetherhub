[
  {
    "name": "ETB puts a counter on your creatures that already have one",
    "players": [ { "hand": ["Twisted Spider-Clone"], "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }, "Hill Giant", "Forest", "Forest", "Forest", "Forest" ] }, {} ],
    "steps": [ { "cast": "Twisted Spider-Clone" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4], "Hill Giant": [3, 3], "Twisted Spider-Clone": [4, 4] } }
  },
  {
    "name": "no creature with a counter: nothing extra",
    "players": [ { "hand": ["Twisted Spider-Clone"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Twisted Spider-Clone" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2], "Twisted Spider-Clone": [4, 4] } }
  },
  {
    "name": "does not affect opponent's creatures",
    "players": [ { "hand": ["Twisted Spider-Clone"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } } ] } ],
    "steps": [ { "cast": "Twisted Spider-Clone" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } }
  }
]
