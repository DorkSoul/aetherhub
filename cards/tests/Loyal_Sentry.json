[
  {
    "name": "blocking destroys both",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Loyal Sentry"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Loyal Sentry",
            "attacker": "Hill Giant"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Hill Giant"
          ],
          "battlefield": []
        },
        {
          "graveyard": [
            "Loyal Sentry"
          ],
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "not blocking: nothing is destroyed",
    "players": [
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Loyal Sentry"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield": [
            "Loyal Sentry"
          ],
          "life": 18
        }
      ]
    }
  },
  {
    "name": "ruling: blocked creature is destroyed even if Loyal Sentry leaves before the trigger resolves",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"] },
      { "battlefield": ["Loyal Sentry"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Loyal Sentry", "attacker": "Hill Giant" } ], "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Loyal Sentry"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Hill Giant", "Lightning Bolt"], "battlefield_lacks": ["Hill Giant"] },
        { "graveyard_has": ["Loyal Sentry"], "battlefield_lacks": ["Loyal Sentry"] }
      ]
    }
  }
]
