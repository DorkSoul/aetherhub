[
 {
  "name": "{3}: becomes a copy of target artifact until end of turn",
  "players": [
   { "battlefield": ["Mizzium Transreliquat", "Island", "Mountain", "Forest"] },
   { "battlefield": ["Scrying Glass"] }
  ],
  "steps": [
   { "activate": "Mizzium Transreliquat", "ability": 0, "targets": ["Scrying Glass"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Scrying Glass"] },
    { "battlefield_has": ["Scrying Glass"] }
   ]
  }
 },
 {
  "name": "{3} copy wears off at the end of the turn",
  "players": [
   { "battlefield": ["Mizzium Transreliquat", "Island", "Mountain", "Forest"] },
   { "battlefield": ["Scrying Glass"] }
  ],
  "steps": [
   { "activate": "Mizzium Transreliquat", "ability": 0, "targets": ["Scrying Glass"] },
   { "resolve": true },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Mizzium Transreliquat"] },
    {}
   ]
  }
 },
 {
  "name": "{1}{U}{R}: becomes a copy permanently (keeps this ability)",
  "players": [
   { "battlefield": ["Mizzium Transreliquat", "Island", "Mountain", "Forest"] },
   { "battlefield": ["Scrying Glass"] }
  ],
  "steps": [
   { "activate": "Mizzium Transreliquat", "ability": 1, "targets": ["Scrying Glass"] },
   { "resolve": true },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Scrying Glass"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: two copy activations in response: the copy is what the last one to resolve targeted",
  "players": [
   { "battlefield": ["Mizzium Transreliquat", "Sol Ring", "Island", "Island", "Mountain", "Mountain", "Forest", "Forest"] },
   { "battlefield": ["Scrying Glass"] }
  ],
  "steps": [
   { "activate": "Mizzium Transreliquat", "ability": 0, "targets": ["Scrying Glass"] },
   { "activate": "Mizzium Transreliquat", "ability": 0, "targets": ["Sol Ring"] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Scrying Glass", "Sol Ring"], "battlefield_lacks": ["Mizzium Transreliquat"] },
    { "battlefield_has": ["Scrying Glass"] }
   ]
  }
 },
 {
  "name": "ruling: a {3} copy removes the {1}{U}{R} copy ability until it wears off",
  "players": [
   { "battlefield": ["Mizzium Transreliquat", "Forest", "Forest", "Island", "Island", "Mountain", "Mountain"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "activate": "Mizzium Transreliquat", "ability": 0, "targets": ["Sol Ring"] },
   { "resolve": true },
   { "activate": "Mizzium Transreliquat", "ability": 1, "targets": ["Sol Ring"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Sol Ring"], "battlefield_lacks": ["Mizzium Transreliquat"] },
    {}
   ]
  }
 }
]
