  {
    "name": "ruling: the extra draw is a trigger after the normal draw (at draw-step priority the normal card is in hand, the extra draw is still on the stack)",
    "players": [
      {
        "battlefield": [
          "Kami of the Crescent Moon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Draw",
        "hold": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 1
        }
      ],
      "stack_empty": false
    }
  },
  {
    "name": "ruling: the extra draw trigger resolves after the normal draw (two cards in hand once it resolves)",
    "players": [
      {
        "battlefield": [
          "Kami of the Crescent Moon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Draw",
        "hold": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 2
        }
      ],
      "stack_empty": true
    }
  }
