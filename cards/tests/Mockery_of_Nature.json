[
  { "name": "ruling: colored mana in an emerge cost is not reduced: with no green source the emerge cast is illegal",
    "players": [ { "hand": ["Mockery of Nature"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
                 { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Mockery of Nature", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Mockery of Nature"], "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Sol Ring"] } ] } },
  { "name": "emerge sacrificing Grizzly Bears (MV 2) reduces {7}{G} to {5}{G}; the cast trigger destroys the opponent's artifact when you say yes",
    "players": [ { "hand": ["Mockery of Nature"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
                 { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Mockery of Nature", "alt": 0 }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mockery of Nature"], "graveyard": ["Grizzly Bears"] },
                             { "graveyard": ["Sol Ring"] } ] } },
  { "name": "the cast trigger's destroy is optional: saying no leaves the artifact on the battlefield",
    "players": [ { "hand": ["Mockery of Nature"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
                 { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Mockery of Nature", "alt": 0 }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mockery of Nature"] },
                             { "battlefield_has": ["Sol Ring"] } ] } },
  { "name": "hard-cast for {9} with nine lands also triggers on cast: destroys the opponent's artifact",
    "players": [ { "hand": ["Mockery of Nature"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
                 { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Mockery of Nature" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mockery of Nature"] },
                             { "graveyard": ["Sol Ring"] } ] } }
]
