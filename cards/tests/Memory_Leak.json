[
  {
    "name": "exiles the chosen nonland card from the opponent's graveyard",
    "players": [
      { "hand": ["Memory Leak"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt", "Forest"], "graveyard": ["Doom Blade"] }
    ],
    "steps": [
      { "cast": "Memory Leak", "targets": ["p1"] },
      { "resolve": true, "answers": ["Doom Blade"] }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": [], "hand": ["Lightning Bolt", "Forest"], "exile": ["Doom Blade"] }
      ]
    }
  },
  {
    "name": "takes a nonland card from the opponent's hand, lands are not eligible",
    "players": [
      { "hand": ["Memory Leak"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Lightning Bolt", "Forest"] }
    ],
    "steps": [
      { "cast": "Memory Leak", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "hand": ["Forest"], "exile": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "cycling {1} draws a card",
    "players": [
      { "hand": ["Memory Leak"], "battlefield": ["Swamp"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Memory Leak" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"], "graveyard": ["Memory Leak"] },
        {}
      ]
    }
  }
]
