  {
    "name": "flying: a ground blocker cannot block it, so its 2 damage goes through",
    "players": [ { "battlefield": ["Starlit Soothsayer", { "name": "Grizzly Bears", "sick": false }] }, { "battlefield": ["Hill Giant", "Serra Angel"] } ],
    "steps": [
      { "attack": [ { "card": "Starlit Soothsayer", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Starlit Soothsayer" }, { "blocker": "Serra Angel", "attacker": "Grizzly Bears" } ] },
