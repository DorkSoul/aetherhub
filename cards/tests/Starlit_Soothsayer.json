  {
    "name": "ruling: life gained during your end step does not make the end-step surveil trigger",
    "players": [
      { "hand": ["Lightning Helix"], "battlefield": ["Starlit Soothsayer", "Mountain", "Plains"], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "cast": "Lightning Helix", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "library_count": 2 },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: gaining and losing life in the same turn counts even though the total is unchanged",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Helix"], "battlefield": ["Starlit Soothsayer", "Mountain", "Mountain", "Plains"], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Lightning Helix", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End", "answers": [["Forest"]] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Forest"], "library_count": 1 },
        { "life": 17 }
      ]
    }
  }
