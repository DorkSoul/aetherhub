 },
 {
  "name": "ruling: a finality counter exiles a creature that would die",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": [ { "name": "Grizzly Bears", "counters": { "finality": 1 } } ] } ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "exile": ["Grizzly Bears"], "graveyard": [] } ] }
 },
 {
  "name": "ruling: a finality counter does not stop a bounce to hand",
  "players": [ { "hand": ["Unsummon"], "battlefield": ["Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "counters": { "finality": 1 } } ] } ],
  "steps": [ { "cast": "Unsummon", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ {}, { "hand": ["Grizzly Bears"] } ] }
 }
