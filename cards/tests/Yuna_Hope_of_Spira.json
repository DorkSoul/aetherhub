 {
  "name": "on your turn Yuna has ward {2}: 3 lands can't pay Terminate's cost plus ward",
  "players": [
   { "battlefield": ["Yuna, Hope of Spira"] },
   { "hand": ["Terminate"], "battlefield": ["Swamp", "Mountain", "Mountain"] }
  ],
  "steps": [
