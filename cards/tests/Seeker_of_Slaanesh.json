[
  {
    "name": "opponent with one able creature must attack with it",
    "players": [
      { "battlefield": ["Seeker of Slaanesh"] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Main1", "auto": true },
      { "player": 1, "attack": [] },
      { "player": 0, "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 18 },
        {}
      ]
    }
  },
  {
    "name": "controller is not forced to attack",
    "players": [
      { "battlefield": [ { "name": "Seeker of Slaanesh", "sick": false } ] },
      { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] }
    ],
    "steps": [
      { "advance_to": "Main1", "auto": true },
      { "attack": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: a summoning-sick opposing creature is not forced to attack",
    "players": [
      { "battlefield": [ { "name": "Seeker of Slaanesh", "sick": false } ] },
      { "hand": [ "Memnite" ] }
    ],
    "steps": [
      { "advance_to": "Main1", "auto": true },
      { "cast": "Memnite", "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "turn": 2,
      "players": [
        { "life": 20 },
        {}
      ]
    }
  }
]
