[
  {
    "name": "taps the opposing creature; no stun counter without another Knight",
    "players": [{ "hand": ["Protocol Knight"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Protocol Knight" }, { "resolve": true }, { "resolve": true }],
    "expect": { "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 0 } } }
  },
  {
    "name": "stun counter when you control another Knight",
    "players": [{ "hand": ["Protocol Knight"], "battlefield": ["Island", "Island", "Island", "Island", "Knight of the Keep"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Protocol Knight" }, { "resolve": true }, { "resolve": true }],
    "expect": { "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 1 } } }
  },
  {
    "name": "ruling: the tap target may already be tapped; a Knight still puts a stun counter on it",
    "players": [
      { "hand": ["Protocol Knight"], "battlefield": ["Island", "Island", "Island", "Island", "Knight of the Keep"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [ { "cast": "Protocol Knight" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "counters": { "Grizzly Bears": { "stun": 1 } }
    }
  }
]
