[
 {
  "name": "restricted mana pays for a Sliver spell",
  "players": [ { "hand": ["Brood Sliver"], "battlefield": ["Sliver Hive", "Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Brood Sliver" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Brood Sliver"] }, {} ] }
 },
 {
  "name": "restricted mana cannot pay for a non-Sliver spell",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Sliver Hive"] }, {} ],
  "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
  "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] }
 },
 {
  "name": "{5},{T}: create a 1/1 Sliver token when I control a Sliver",
  "players": [ { "battlefield": ["Sliver Hive", "Brood Sliver", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "activate": "Sliver Hive", "ability": 0 }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Sliver Hive", "Brood Sliver", "Sliver 1-1"] }, {} ] }
 },
 {
  "name": "ruling: the Sliver check happens on activation; killing the Sliver in response still makes the token",
  "players": [ { "battlefield": ["Sliver Hive", "Brood Sliver", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
  "steps": [ { "activate": "Sliver Hive", "ability": 0 }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Brood Sliver"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Brood Sliver"], "battlefield_has": ["Sliver Hive", "Sliver 1-1"], "battlefield_lacks": ["Brood Sliver"] }, { "graveyard": ["Lightning Bolt"] } ] }
 }
]
