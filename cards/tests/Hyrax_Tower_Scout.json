[
  { "name": "enters and untaps a tapped creature you target",
    "players": [
      { "hand": ["Hyrax Tower Scout"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [ { "cast": "Hyrax Tower Scout" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hyrax Tower Scout"] }, {} ], "tapped": { "Grizzly Bears": false } } },
  { "name": "can target itself when no creature is tapped",
    "players": [
      { "hand": ["Hyrax Tower Scout"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Hyrax Tower Scout" }, { "resolve": true, "targets": ["Hyrax Tower Scout"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hyrax Tower Scout"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Hyrax Tower Scout": false } } },
  { "name": "ruling: may target an untapped creature when no creature is tapped (the target is accepted and the trigger resolves)",
    "players": [
      { "hand": ["Hyrax Tower Scout"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Hyrax Tower Scout" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hyrax Tower Scout"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": false, "Hyrax Tower Scout": false } } }
]
