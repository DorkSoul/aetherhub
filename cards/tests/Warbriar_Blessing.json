[
  {
    "name": "enchanted creature fights a creature you don't control; +0/+2 keeps it alive",
    "players": [
      { "hand": ["Warbriar Blessing"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Warbriar Blessing", "targets": ["Grizzly Bears"] },
      { "resolve": true, "targets": ["Hill Giant"] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears", "Warbriar Blessing"] }, { "battlefield_has": ["Hill Giant"] }],
      "pt": { "Grizzly Bears": [2, 4], "Hill Giant": [3, 3] },
      "attached": { "Warbriar Blessing": "Grizzly Bears" }
    }
  },
  {
    "name": "a 2/2 opponent dies to the 2 damage; the enchanted creature survives",
    "players": [
      { "hand": ["Warbriar Blessing"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Warbriar Blessing", "targets": ["Grizzly Bears"] },
      { "resolve": true, "targets": ["p1:Grizzly Bears"] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: the Aura is destroyed before its trigger resolves; the creature it last enchanted still fights",
    "players": [
      { "hand": ["Warbriar Blessing"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Naturalize"], "battlefield": ["Forest", "Forest", "Serra Angel"] }
    ],
    "steps": [
      { "cast": "Warbriar Blessing", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "targets": ["Serra Angel"] },
      { "cast": "Naturalize", "player": 1, "targets": ["Warbriar Blessing"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"] },
        { "battlefield_has": ["Serra Angel"], "graveyard_has": ["Naturalize"] }
      ]
    }
  },
  {
    "name": "ruling: if the fight target has left the battlefield, neither creature deals or is dealt damage",
    "players": [
      { "hand": ["Warbriar Blessing"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Unsummon"], "battlefield": ["Island", "Serra Angel"] }
    ],
    "steps": [
      { "cast": "Warbriar Blessing", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "targets": ["Serra Angel"] },
      { "cast": "Unsummon", "player": 1, "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Warbriar Blessing"] },
        { "hand": ["Serra Angel"] }
      ],
      "pt": { "Grizzly Bears": [2, 4] }
    }
  }
