[
  { "name": "an opponent's creature dying is exiled",
    "players": [ { "battlefield": [ "Mari, the Killing Quill", "Mountain" ], "hand": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "exile": ["Grizzly Bears"], "graveyard": [], "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "my own creature dying is not exiled",
    "players": [ { "battlefield": [ "Mari, the Killing Quill", "Grizzly Bears", "Mountain" ], "hand": ["Lightning Bolt"] }, { } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Lightning Bolt"], "exile": [] }, { } ] } },
  { "name": "combat damage: remove a hit counter from their exiled card, draw and two Treasures",
    "players": [ { "battlefield": [ { "name": "Mari, the Killing Quill", "sick": false } ], "library": ["Forest"] },
                 { "exile": [ { "name": "Grizzly Bears", "counters": { "Hit": 1 } } ] } ],
    "steps": [ { "attack": [ { "card": "Mari, the Killing Quill", "at": "p1" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Treasure"] }, { "life": 17 } ] } },
  { "name": "no hit counter in exile: nothing happens",
    "players": [ { "battlefield": [ { "name": "Mari, the Killing Quill", "sick": false } ], "library": ["Forest"] },
                 { "exile": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Mari, the Killing Quill", "at": "p1" } ] }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_lacks": ["Treasure"] }, { "life": 17 } ] } },
  { "name": "Mari has deathtouch: she kills a big blocker, which is exiled with a hit counter",
    "players": [ { "battlefield": [ { "name": "Mari, the Killing Quill", "sick": false } ] }, { "battlefield": ["Fortress Crab"] } ],
    "steps": [ { "attack": [ { "card": "Mari, the Killing Quill", "at": "p1" } ] }, { "block": [ { "blocker": "Fortress Crab", "attacker": "Mari, the Killing Quill" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Mari, the Killing Quill"] }, { "exile": ["Fortress Crab"], "graveyard": [] } ] } }
]
