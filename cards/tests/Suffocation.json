[
  {
    "name": "hits the controller of the red spell that damaged you, then draws at the next upkeep",
    "players": [
      {
        "hand": [
          "Suffocation"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Lightning Bolt",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Suffocation"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 17,
          "hand_count": 1,
          "graveyard": [
            "Suffocation"
          ]
        },
        {
          "life": 16,
          "graveyard": [
            "Lightning Bolt"
          ]
        }
      ]
    }
  },
  {
    "name": "can't be cast when no red instant or sorcery has damaged you",
    "players": [
      {
        "hand": [
          "Suffocation"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Suffocation",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Suffocation"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "the last red spell counts: your own Bolt at yourself makes you the target",
    "players": [
      {
        "hand": [
          "Suffocation",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Mountain"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "player": 1,
        "cast": "Lightning Bolt",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p0"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Suffocation"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 10
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: a non-red sorcery's damage does not enable it (red instant or red sorcery only)",
    "players": [
      { "hand": ["Suffocation", "Bee Sting"], "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Bee Sting", "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Suffocation", "illegal": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "hand": ["Suffocation"], "graveyard": ["Bee Sting"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: a red sorcery's damage does enable it (it need not be an instant); Suffocation hits its controller for 4",
    "players": [
      { "hand": ["Suffocation", "Fireball"], "battlefield": ["Island", "Island", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Fireball", "targets": ["p0"], "answers": [1] },
      { "resolve": true },
      { "cast": "Suffocation" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 15, "graveyard": ["Suffocation", "Fireball"] },
        { "life": 20 }
      ]
    }
  }
]