[
  {
    "name": "exiles an Assassin from graveyard to destroy a creature",
    "players": [
      { "battlefield": ["Scarblade Elite"], "graveyard": ["Scarblade Elite"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Scarblade Elite", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Scarblade Elite"], "exile": ["Scarblade Elite"], "graveyard": [] },
        { "graveyard": ["Grizzly Bears"] }
      ],
      "tapped": { "Scarblade Elite": true }
    }
  },
  {
    "name": "no Assassin card in graveyard means no activation",
    "players": [
      { "battlefield": ["Scarblade Elite"], "graveyard": ["Scarblade Scout"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Scarblade Elite", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Scarblade Elite"], "graveyard": ["Scarblade Scout"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "tap cost: a second activation the same turn is illegal",
    "players": [
      { "battlefield": ["Scarblade Elite"], "graveyard": ["Scarblade Elite", "Scarblade Elite"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Scarblade Elite", "targets": ["Grizzly Bears"], "answers": ["Scarblade Elite"] },
      { "resolve": true },
      { "activate": "Scarblade Elite", "illegal": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Scarblade Elite"] },
        { "graveyard": ["Grizzly Bears"], "battlefield": ["Hill Giant"] }
      ]
    }
  }
]
