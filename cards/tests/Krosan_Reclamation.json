[
  { "name": "shuffles two cards from their graveyard into their library",
    "players": [ { "hand": ["Krosan Reclamation"], "battlefield": ["Forest", "Forest"], "graveyard": ["Grizzly Bears", "Hill Giant", "Giant Growth"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Krosan Reclamation", "targets": ["p0", "Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 3, "graveyard_has": ["Giant Growth", "Krosan Reclamation"] }, {} ] } },
  { "name": "flashback {1}{G}, then exiled",
    "players": [ { "battlefield": ["Forest", "Forest"], "graveyard": ["Krosan Reclamation", "Grizzly Bears"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Krosan Reclamation", "alt": 0, "targets": ["p0", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 2, "exile": ["Krosan Reclamation"] }, {} ] } },
  { "name": "ruling: a countered flashback spell is still exiled",
    "players": [ { "battlefield": ["Forest", "Forest"], "graveyard": ["Krosan Reclamation", "Grizzly Bears"], "library": ["Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Krosan Reclamation", "alt": 0, "targets": ["p0", "Grizzly Bears"] }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Krosan Reclamation" }] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Krosan Reclamation"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Counterspell"] } ] } },
  { "name": "ruling: flashback follows the card type's timing, so this instant can be cast on the opponent's turn",
    "players": [ { "battlefield": ["Forest", "Forest"], "graveyard": ["Krosan Reclamation", "Grizzly Bears"], "library": ["Plains"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "BeginCombat" }, { "pass": true, "player": 1 }, { "cast": "Krosan Reclamation", "alt": 0, "targets": ["p0", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "library_count": 2, "exile": ["Krosan Reclamation"] }, {} ] } },
  { "name": "ruling: flashback's total cost includes cost increases (Thalia makes {1}{G} cost three)",
    "players": [ { "battlefield": ["Forest", "Forest"], "graveyard": ["Krosan Reclamation", "Grizzly Bears"], "library": ["Plains"] }, { "battlefield": ["Thalia, Guardian of Thraben"] } ],
    "steps": [ { "cast": "Krosan Reclamation", "alt": 0, "targets": ["p0", "Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Krosan Reclamation", "Grizzly Bears"] }, {} ] } },
  { "name": "ruling: with three mana, the flashback cost including Thalia's increase is payable",
    "players": [ { "battlefield": ["Forest", "Forest", "Forest"], "graveyard": ["Krosan Reclamation", "Grizzly Bears"], "library": ["Plains"] }, { "battlefield": ["Thalia, Guardian of Thraben"] } ],
    "steps": [ { "cast": "Krosan Reclamation", "alt": 0, "targets": ["p0", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Krosan Reclamation"], "library_count": 2 }, {} ] } }
]
