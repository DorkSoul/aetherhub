   "players": [ { "hand": ["Aberrant Mind Sorcerer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt"] }, { } ],
   "steps": [ { "cast": "Aberrant Mind Sorcerer" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"], "graveyard": [] } ] } },
 { "name": "roll of 1-9: choosing yes puts the instant on top of the library",
   "seed": 1,
   "players": [ { "hand": ["Aberrant Mind Sorcerer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt"] }, { } ],
   "steps": [ { "cast": "Aberrant Mind Sorcerer" }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ { "graveyard": [], "hand_count": 0, "library_count": 21 } ] } },
 { "name": "roll of 1-9: declining leaves the instant in the graveyard",
   "seed": 1,
   "players": [ { "hand": ["Aberrant Mind Sorcerer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt"] }, { } ],
   "steps": [ { "cast": "Aberrant Mind Sorcerer" }, { "resolve": true, "answers": [false] } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "library_count": 20 } ] } },
 { "name": "ruling: the target is chosen when the trigger goes on the stack and the roll then moves that card",
   "seed": 3,
   "players": [ { "hand": ["Aberrant Mind Sorcerer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt", "Counterspell"] }, { } ],
   "steps": [ { "cast": "Aberrant Mind Sorcerer" }, { "resolve": true, "targets": ["Counterspell"] }, { "resolve": true } ],
