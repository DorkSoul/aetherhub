[
  { "name": "upkeep adds a doom counter; draw step deals damage equal to the doom counters to each player",
    "players": [ { "battlefield": [ { "name": "Armageddon Clock", "counters": { "doom": 2 } } ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "Draw" }, { "resolve": true } ],
    "expect": { "counters": { "Armageddon Clock": { "doom": 3 } }, "players": [ { "life": 17 }, { "life": 17 } ] } },
  { "name": "the opponent may pay {4} in an upkeep to remove a doom counter",
    "players": [ { "battlefield": [ { "name": "Armageddon Clock", "counters": { "doom": 2 } } ] }, { "battlefield": ["Plains", "Plains", "Plains", "Plains"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "pass": true }, { "activate": "Armageddon Clock", "player": 1 }, { "resolve": true } ],
    "expect": { "counters": { "Armageddon Clock": { "doom": 2 } } } },
  { "name": "outside an upkeep step the {4} ability can't be activated, even by the opponent",
    "players": [ { "battlefield": [ { "name": "Armageddon Clock", "counters": { "doom": 2 } } ] }, { "battlefield": ["Plains", "Plains", "Plains", "Plains"] } ],
    "steps": [ { "pass": true }, { "activate": "Armageddon Clock", "player": 1, "illegal": true } ],
    "expect": { "counters": { "Armageddon Clock": { "doom": 2 } } } },
  { "name": "ruling: the opponent may remove several doom counters in one upkeep, paying {4} each time",
    "players": [ { "battlefield": [ { "name": "Armageddon Clock", "counters": { "doom": 2 } } ] }, { "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "pass": true }, { "activate": "Armageddon Clock", "player": 1 }, { "resolve": true }, { "pass": true }, { "activate": "Armageddon Clock", "player": 1 }, { "resolve": true } ],
    "expect": { "counters": { "Armageddon Clock": { "doom": 1 } }, "players": [ {}, { "battlefield_has": ["Plains"] } ] } }
]
