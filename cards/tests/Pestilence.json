[
 {
  "name": "B deals 1 to each creature and each player",
  "players": [
   {
    "battlefield": [
     "Pestilence",
     "Swamp",
     {
      "name": "Grizzly Bears"
     },
     "Typhoid Rats"
    ]
   },
   {
    "battlefield": [
     "Giant Spider"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Pestilence"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 19,
     "graveyard": [
      "Typhoid Rats"
     ]
    },
    {
     "life": 19,
     "battlefield": [
      "Giant Spider"
     ]
    }
   ],
   "pt": {
    "Giant Spider": [
     2,
     4
    ]
   }
  }
 },
 {
  "name": "sacrificed at end step when no creatures are on the battlefield",
  "players": [
   {
    "battlefield": [
     "Pestilence"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Pestilence"
     ]
    }
   ]
  }
 },
 {
  "name": "stays at end step when a creature is on the battlefield",
  "players": [
   {
    "battlefield": [
     "Pestilence",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Pestilence",
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: each activation is a separate 1-damage effect (two activations kill a 2/2)",
  "players": [ { "battlefield": ["Pestilence", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "activate": "Pestilence" }, { "resolve": true }, { "activate": "Pestilence" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 18, "battlefield_has": ["Pestilence"] }, { "life": 18, "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: a creature dying during the end step does not sacrifice Pestilence",
  "players": [ { "battlefield": ["Pestilence", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "advance_to": "End" }, { "activate": "Pestilence" }, { "resolve": true }, { "activate": "Pestilence" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 18, "battlefield_has": ["Pestilence"] }, { "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: a creature animated until end of turn keeps Pestilence at the end step",
  "players": [ { "battlefield": ["Pestilence", "Mishra's Factory", "Swamp"] }, {} ],
  "steps": [ { "activate": "Mishra's Factory", "ability": 0 }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Pestilence"] }, {} ] }
 }
]