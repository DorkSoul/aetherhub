[
  {
    "name": "X=2 proliferates twice: a +1/+1 counter goes from 1 to 3",
    "players": [
      { "hand": ["Expansion Algorithm"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }
    ],
    "steps": [
      { "cast": "Expansion Algorithm", "answers": [2] },
      { "resolve": true, "answers": [["Grizzly Bears"], ["Grizzly Bears"]] }
    ],
    "expect": {
      "players": [{ "graveyard": ["Expansion Algorithm"] }, {}],
      "counters": { "Grizzly Bears": { "PlusOnePlusOne": 3 } }
    }
  },
  {
    "name": "X=0 does nothing",
    "players": [
      { "hand": ["Expansion Algorithm"], "battlefield": ["Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }
    ],
    "steps": [
      { "cast": "Expansion Algorithm", "answers": [0] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Expansion Algorithm"] }, {}],
      "counters": { "Grizzly Bears": { "PlusOnePlusOne": 1 } }
    }
  },
  {
    "name": "ruling: proliferate chooses my permanent and an opponent's permanent that have counters",
    "players": [
      { "hand": ["Expansion Algorithm"], "battlefield": ["Island", "Island", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] },
      { "battlefield": [{ "name": "Hill Giant", "counters": { "p1p1": 1 } }] }
    ],
    "steps": [
      { "cast": "Expansion Algorithm", "answers": [1] },
      { "resolve": true, "answers": [["Grizzly Bears", "Hill Giant"]] }
    ],
    "expect": {
      "players": [{ "graveyard": ["Expansion Algorithm"] }, {}],
      "counters": { "Grizzly Bears": { "PlusOnePlusOne": 2 }, "Hill Giant": { "PlusOnePlusOne": 2 } }
    }
  },
  {
    "name": "ruling: proliferate may choose no permanents (no counters added)",
    "players": [
      { "hand": ["Expansion Algorithm"], "battlefield": ["Island", "Island", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] },
      { "battlefield": [{ "name": "Hill Giant", "counters": { "p1p1": 1 } }] }
    ],
    "steps": [
      { "cast": "Expansion Algorithm", "answers": [1] },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [{ "graveyard": ["Expansion Algorithm"] }, {}],
      "counters": { "Grizzly Bears": { "PlusOnePlusOne": 1 }, "Hill Giant": { "PlusOnePlusOne": 1 } }
    }
  },
  {
    "name": "ruling: repeated proliferate may choose a different set each time",
    "players": [
      { "hand": ["Expansion Algorithm"], "battlefield": ["Island", "Island", "Forest", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] },
      { "battlefield": [{ "name": "Hill Giant", "counters": { "p1p1": 1 } }] }
    ],
    "steps": [
      { "cast": "Expansion Algorithm", "answers": [2] },
      { "resolve": true, "answers": [["Hill Giant"], ["Grizzly Bears"]] }
    ],
    "expect": {
      "players": [{ "graveyard": ["Expansion Algorithm"] }, {}],
      "counters": { "Grizzly Bears": { "PlusOnePlusOne": 2 }, "Hill Giant": { "PlusOnePlusOne": 2 } }
    }
  },
  {
    "name": "ruling: a permanent with two kinds of counters gets one of each kind",
    "players": [
      { "hand": ["Expansion Algorithm"], "battlefield": ["Island", "Island", "Forest"] },
      { "battlefield": [{ "name": "Hill Giant", "counters": { "p1p1": 1, "decayed": 1 } }] }
