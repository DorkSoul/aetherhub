[
  {
    "name": "destroys target artifact",
    "players": [
      { "hand": ["Shattering Pulse"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Sapphire Medallion"] }
    ],
    "steps": [
      { "cast": "Shattering Pulse", "targets": ["Sapphire Medallion"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Shattering Pulse"] },
        { "graveyard": ["Sapphire Medallion"], "battlefield_lacks": ["Sapphire Medallion"] }
      ]
    }
  },
  {
    "name": "buyback returns it to hand",
    "players": [
      { "hand": ["Shattering Pulse"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Sapphire Medallion"] }
    ],
    "steps": [
      { "cast": "Shattering Pulse", "targets": ["Sapphire Medallion"], "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Shattering Pulse"], "graveyard": [] },
        { "graveyard": ["Sapphire Medallion"] }
      ]
    }
  },
  {
    "name": "cannot target a non-artifact",
    "players": [
      { "hand": ["Shattering Pulse"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shattering Pulse", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Shattering Pulse"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
