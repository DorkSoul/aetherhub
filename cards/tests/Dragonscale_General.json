[
  {
    "name": "end step bolster X equals tapped creatures, counters the least-toughness creature",
    "players": [
      { "battlefield": ["Dragonscale General", {"name": "Grizzly Bears", "tapped": true}, "Hill Giant"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Dragonscale General", "Grizzly Bears", "Hill Giant"] }, {}],
      "counters": { "Grizzly Bears": { "p1p1": 1 } }
    }
  },
  {
    "name": "no tapped creatures: bolster 0 does nothing",
    "players": [
      { "battlefield": ["Dragonscale General", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Dragonscale General", "Grizzly Bears"] }, {}],
      "counters": {}
    }
  },
  {
    "name": "ruling: X counts tapped creatures and the counters can go on an untapped least-toughness creature",
    "players": [
      { "battlefield": ["Dragonscale General", {"name": "Hill Giant", "tapped": true}, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Dragonscale General", "Hill Giant", "Grizzly Bears"] }, {}],
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Hill Giant": [3, 3] }
    }
  }
]
