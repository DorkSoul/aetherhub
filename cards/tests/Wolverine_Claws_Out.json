[
  {
    "name": "attacking Mutant doubles its power until end of turn",
    "players": [
      { "battlefield": ["Wolverine, Claws Out"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Wolverine, Claws Out", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Wolverine, Claws Out": [4, 5] },
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "a non-Mutant attacker is not doubled",
    "players": [
      { "battlefield": ["Wolverine, Claws Out", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2], "Wolverine, Claws Out": [2, 5] }
    }
  },
  {
    "name": "blocked: assigns its doubled combat damage to the defending player as though unblocked",
    "players": [
      { "battlefield": ["Wolverine, Claws Out"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Wolverine, Claws Out", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Wolverine, Claws Out" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16, "battlefield": ["Grizzly Bears"] } ]
    }
  }
]
