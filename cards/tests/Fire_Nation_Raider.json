 {
  "name": "ruling: raid still counts when the creature that attacked died in combat",
  "players": [
   {
    "hand": ["Fire Nation Raider"],
    "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"]
   },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
   { "advance_to": "Main2" },
   { "cast": "Fire Nation Raider" },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Fire Nation Raider", "Clue"], "graveyard_has": ["Grizzly Bears"] },
    { "battlefield_has": ["Hill Giant"] }
   ]
  }
