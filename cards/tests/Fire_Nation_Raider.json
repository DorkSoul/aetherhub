   {
    "hand": ["Fire Nation Raider"],
    "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "advance_to": "Main2" },
   { "cast": "Fire Nation Raider" },
   { "resolve": true },
   { "resolve": true },
   { "activate": "Clue", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Fire Nation Raider"], "hand_count": 1 }, {} ]
