        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Merrow Grimeblotter",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "ruling: a summoning-sick creature cannot pay {Q} even when tapped",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          {
            "name": "Merrow Grimeblotter",
            "tapped": true,
