          },
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Merrow Grimeblotter",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [2, 2]
      }
    }
  },
  {
    "name": "ruling: the untap is a cost, so the Merrow is untapped while its ability is on the stack",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          {
            "name": "Merrow Grimeblotter",
            "tapped": true
          },
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Merrow Grimeblotter",
        "targets": [
          "Grizzly Bears"
        ]
      }
