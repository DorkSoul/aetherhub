[
  {
    "name": "enters with a counter for each creature that died this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Bloodcrazed Paladin"], "battlefield": ["Mountain", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Bloodcrazed Paladin" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bloodcrazed Paladin"] }, { "graveyard": ["Grizzly Bears"] } ],
      "counters": { "Bloodcrazed Paladin": { "p1p1": 1 } },
      "pt": { "Bloodcrazed Paladin": [2, 2] }
    }
  },
  {
    "name": "no creature died this turn: enters as a 1/1",
    "players": [
      { "hand": ["Bloodcrazed Paladin"], "battlefield": ["Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Bloodcrazed Paladin" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bloodcrazed Paladin"] }, {} ],
      "pt": { "Bloodcrazed Paladin": [1, 1] }
    }
  },
  {
    "name": "ruling: creatures that died this turn count even after they left the graveyard",
    "players": [
      { "hand": ["Lightning Bolt", "Ill-Gotten Gains", "Bloodcrazed Paladin"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Ill-Gotten Gains" },
      { "resolve": true, "answers": [["Grizzly Bears", "Bloodcrazed Paladin"]] },
      { "cast": "Bloodcrazed Paladin" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bloodcrazed Paladin"], "hand_count": 1 }, {} ],
      "counters": { "Bloodcrazed Paladin": { "p1p1": 1 } },
      "pt": { "Bloodcrazed Paladin": [2, 2] }
    }
  },
  {
    "name": "ruling: a creature exiled instead of dying does not count",
    "players": [
      { "hand": ["Swords to Plowshares", "Bloodcrazed Paladin"], "battlefield": ["Plains", "Plains", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Swords to Plowshares", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Bloodcrazed Paladin" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bloodcrazed Paladin"] }, { "exile": ["Grizzly Bears"] } ],
      "pt": { "Bloodcrazed Paladin": [1, 1] }
    }
  }
]
