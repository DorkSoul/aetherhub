      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 20, "graveyard_has": ["Snow Day", "Lightning Bolt"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a tapped creature can be chosen as a target",
