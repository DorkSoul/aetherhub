[
  { "name": "taps for one green mana per storage counter removed",
    "players": [ { "battlefield": [{"name": "Hollow Trees", "sick": false, "counters": {"storage": 3}}] }, {} ],
    "steps": [ { "tap_for_mana": "Hollow Trees" } ],
    "expect": { "players": [ { "pool": { "G": 3 } } ], "counters": { "Hollow Trees": { "storage": 0 } }, "tapped": { "Hollow Trees": true } } },
  { "name": "a tapped Hollow Trees gets a storage counter at its controller's upkeep when kept tapped",
    "players": [ { "battlefield": [{"name": "Hollow Trees", "sick": false}] }, {} ],
    "steps": [ { "tap_for_mana": "Hollow Trees" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "turn": 3, "counters": { "Hollow Trees": { "storage": 1 } }, "tapped": { "Hollow Trees": true } } },
  { "name": "choosing to untap Hollow Trees means it gets no storage counter",
    "players": [ { "battlefield": [{"name": "Hollow Trees", "sick": false}] }, {} ],
    "steps": [ { "tap_for_mana": "Hollow Trees" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true } ],
    "expect": { "turn": 3, "counters": { "Hollow Trees": { "storage": 0 } }, "tapped": { "Hollow Trees": false } } },
  { "name": "enters tapped when played from hand",
    "players": [ { "hand": ["Hollow Trees"] }, {} ],
    "steps": [ { "play_land": "Hollow Trees" } ],
    "expect": { "players": [ { "battlefield_has": ["Hollow Trees"] }, {} ], "tapped": { "Hollow Trees": true } } },
  { "name": "ruling: storage counters are kept while Blood Moon turns Hollow Trees into a Mountain",
    "players": [ { "hand": ["Blood Moon"], "battlefield": ["Mountain", "Mountain", "Mountain", {"name": "Hollow Trees", "sick": false, "counters": {"storage": 2}}] }, {} ],
    "steps": [ { "cast": "Blood Moon" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hollow Trees", "Blood Moon"] }, {} ], "counters": { "Hollow Trees": { "storage": 2 } } } }
]
