  {
    "name": "ruling: the flash-spell trigger still resolves when the flash spell it watches is countered",
    "players": [
      { "hand": ["Spectral Sailor"], "battlefield": ["Slitherwisp", "Island"], "library": ["Forest"] },
      { "hand": ["Anticognition"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Spectral Sailor" },
      { "cast": "Anticognition", "player": 1, "targets": [{ "stack": "Spectral Sailor" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "graveyard_has": ["Spectral Sailor"], "battlefield_lacks": ["Spectral Sailor"] },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "ruling: a spell cast as though it had flash (Leyline of Anticipation) does not trigger Slitherwisp",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Slitherwisp", "Leyline of Anticipation", "Forest", "Forest"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "battlefield_has": ["Grizzly Bears", "Slitherwisp"] },
        { "life": 20 }
      ]
    }
  }
