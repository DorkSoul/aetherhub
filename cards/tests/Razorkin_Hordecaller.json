        "battlefield": [
          {
            "name": "Razorkin Hordecaller",
            "sick": false
          },
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Razorkin Hordecaller",
            "at": "p1"
          },
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Razorkin Hordecaller",
            "Grizzly Bears",
            "Gremlin 1-1 Red"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "no attack, no Gremlin",
    "players": [
