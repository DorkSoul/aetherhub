  {
    "name": "ruling: attacking with another creature makes a Gremlin; Hordecaller does not have to attack",
    "players": [
      {
        "battlefield": [
          { "name": "Razorkin Hordecaller", "sick": false },
          { "name": "Grizzly Bears", "sick": false }
