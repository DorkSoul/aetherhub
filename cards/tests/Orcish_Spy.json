[
  {
    "name": "tap: looks at the top three of the target player's library and leaves them there",
    "players": [
      { "battlefield": ["Orcish Spy"] },
      { "library": ["Forest", "Grizzly Bears", "Island", "Swamp"] }
    ],
    "steps": [
      { "activate": "Orcish Spy", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        { "hand_count": 0, "library_count": 24 }
      ],
      "tapped": { "Orcish Spy": true }
    }
  },
  {
    "name": "its own controller's library can be targeted",
    "players": [
      { "battlefield": ["Orcish Spy"], "library": ["Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Orcish Spy", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "library_count": 22 },
        {}
      ],
      "tapped": { "Orcish Spy": true }
    }
  },
  {
    "name": "negative: summoning-sick Spy cannot use its tap ability",
    "players": [
      { "battlefield": [{ "name": "Orcish Spy", "sick": true }] },
      {}
    ],
    "steps": [
      { "activate": "Orcish Spy", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Orcish Spy": false }
    }
  },
  {
    "name": "negative: an already tapped Spy cannot activate",
    "players": [
      { "battlefield": [{ "name": "Orcish Spy", "tapped": true }] },
      {}
    ],
    "steps": [
      { "activate": "Orcish Spy", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Orcish Spy": true }
    }
  }
]
