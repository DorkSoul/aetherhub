[
  {
    "name": "creature tokens get -2/-2, nontoken creatures do not",
    "players": [{ "hand": ["Virulent Plague"], "battlefield": ["Swamp", "Swamp", "Swamp", "Beast 4-4 Green Trample"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Virulent Plague" }, { "resolve": true }],
    "expect": { "players": [{}, {}], "pt": { "Beast 4-4 Green Trample": [2, 2], "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "a 1/1 token dies to the -2/-2",
    "players": [{ "hand": ["Virulent Plague"], "battlefield": ["Swamp", "Swamp", "Swamp", "Faerie Rogue 1-1 Flying"] }, {}],
    "steps": [{ "cast": "Virulent Plague" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Virulent Plague"] }, {}] }
  },
  {
    "name": "ruling: a 1/1 token created under Virulent Plague enters with toughness 0 and is gone",
    "players": [{ "hand": ["Raise the Alarm"], "battlefield": ["Plains", "Plains", "Virulent Plague"] }, {}],
    "steps": [{ "cast": "Raise the Alarm" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield": ["Plains", "Plains", "Virulent Plague"], "graveyard_has": ["Raise the Alarm"] }, {}] }
  },
  {
    "name": "control: without Virulent Plague the same 1/1 tokens stay on the battlefield",
    "players": [{ "hand": ["Raise the Alarm"], "battlefield": ["Plains", "Plains"] }, {}],
    "steps": [{ "cast": "Raise the Alarm" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Soldier", "Soldier"] }, {}] }
  }
]
