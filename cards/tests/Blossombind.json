  {
    "name": "ruling: counters already on the creature stay when Blossombind is attached",
    "players": [
      { "hand": ["Blossombind", "Test Sprinkler"], "battlefield": ["Island", "Island", "Forest", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Test Sprinkler", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Blossombind", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3] }
    }
