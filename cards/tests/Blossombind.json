  {
    "name": "counters can still be put on other creatures",
    "players": [
      {
        "hand": [
          "Blossombind",
          "Test Sprinkler"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Forest",
          {
            "name": "Grizzly Bears",
            "sick": false
          },
          {
            "name": "Llanowar Elves",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Blossombind",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "cast": "Test Sprinkler",
        "targets": [
