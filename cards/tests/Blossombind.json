    "expect": {
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "counters can't be put on the enchanted creature",
    "players": [
      {
        "hand": [
          "Blossombind",
          "Test Sprinkler"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Forest",
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Blossombind",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "cast": "Test Sprinkler",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
