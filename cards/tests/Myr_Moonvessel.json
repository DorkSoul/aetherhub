[
  {
    "name": "when it dies, add {C} (the mana is in the pool after the trigger resolves)",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Myr Moonvessel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Myr Moonvessel"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Myr Moonvessel",
            "Lightning Bolt"
          ],
          "pool": {
            "C": 1
          }
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the death mana is lost at the end of the step if not spent",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Myr Moonvessel"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Myr Moonvessel"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Myr Moonvessel", "Lightning Bolt"], "pool": { "C": 0 } }, {} ]
    }
  }
]
