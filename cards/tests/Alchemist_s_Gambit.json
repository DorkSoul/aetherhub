[
  {
    "name": "normal cast: extra turn, and its end step loses the game",
    "players": [
      { "hand": ["Alchemist's Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Alchemist's Gambit" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "End" }
    ],
    "expect": { "winner": 1, "players": [ { "exile": ["Alchemist's Gambit"] }, {} ] }
  },
  {
    "name": "cleave cast: extra turn but no lose-the-game trigger",
    "players": [
      { "hand": ["Alchemist's Gambit"], "battlefield": ["Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Alchemist's Gambit", "alt": 0 },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "End" }
    ],
    "expect": { "winner": -1, "players": [ { "exile": ["Alchemist's Gambit"] }, {} ] }
  },
  {
    "name": "ruling: a countered Gambit goes to the graveyard, not exile, and gives no extra turn",
    "players": [
      { "hand": ["Alchemist's Gambit"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island", "Island", "Island"] },
      { "hand": ["Dash Hopes"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Alchemist's Gambit" },
      { "pass": true },
      { "cast": "Dash Hopes", "player": 1, "targets": [{ "stack": "Alchemist's Gambit" }] },
      { "resolve": true, "answers": [false, false] },
      { "resolve": true }
    ],
    "expect": { "winner": -1, "players": [ { "graveyard": ["Alchemist's Gambit"] }, { "graveyard": ["Dash Hopes"] } ] }
  }
]
