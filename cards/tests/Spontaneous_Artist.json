[
  { "name": "ETB gives an energy; paying it gives haste",
    "players": [ { "hand": ["Spontaneous Artist"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Spontaneous Artist" }, { "resolve": true }, { "resolve": true },
      { "activate": "Spontaneous Artist", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "energy": 0 }, {} ], "keywords": { "Grizzly Bears": ["Haste"] } } },
  { "name": "no energy: the haste ability cannot be activated",
    "players": [ { "battlefield": [{ "name": "Spontaneous Artist", "sick": false }, "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Spontaneous Artist", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "energy": 0 }, {} ] } },
  { "name": "ruling: energy is not mana and does not go away at end of turn",
    "players": [ { "hand": ["Spontaneous Artist"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Spontaneous Artist" }, { "resolve": true }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "energy": 1 }, {} ] } },
  { "name": "ruling: energy belongs to the player, so it stays after the Artist leaves",
    "players": [ { "hand": ["Spontaneous Artist", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Spontaneous Artist" }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Spontaneous Artist"] }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 1, "graveyard_has": ["Spontaneous Artist", "Lightning Bolt"] }, {} ] } }
]
