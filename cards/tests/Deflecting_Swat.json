[
 {
  "name": "with a commander in play it is free and redirects a spell to the player",
  "commander": true,
  "players": [
   { "command": ["Grizzly Bears"], "hand": ["Lightning Bolt", "Deflecting Swat"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1:Grizzly Bears"] },
   { "cast": "Deflecting Swat", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true, "answers": ["p1"] }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt", "Deflecting Swat"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain", "Grizzly Bears"] },
    { "life": 17, "battlefield": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "without a commander the redirect spell cannot be cast for free",
  "players": [
   { "hand": ["Lightning Bolt", "Deflecting Swat"], "battlefield": ["Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1:Grizzly Bears"] },
   { "cast": "Deflecting Swat", "targets": [{ "stack": "Lightning Bolt" }], "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt"], "hand": ["Deflecting Swat"] },
    { "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "declining the new target keeps the original target",
  "commander": true,
  "players": [
   { "command": ["Grizzly Bears"], "hand": ["Lightning Bolt", "Deflecting Swat"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1:Grizzly Bears"] },
   { "cast": "Deflecting Swat", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true, "answers": [[]] }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt", "Deflecting Swat"] },
    { "life": 20, "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
