   { "resolve": true },
   { "cast": "Wall of Omens" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "cast": "Deflecting Swat", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true, "answers": ["p0"] }
  ],
  "expect": {
   "players": [
    { "life": 17, "graveyard": ["Lightning Bolt", "Deflecting Swat"], "battlefield": ["Forest", "Forest", "Plains", "Plains", "Mountain", "Island", "Island", "Grizzly Bears", "Wall of Omens"] },
    { "life": 20 }
   ]
  }
