   "players": [ { "hand": ["Serpentine Spike"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
     { "battlefield": ["Grizzly Bears", "Hill Giant", "Sewer Rats"] } ],
