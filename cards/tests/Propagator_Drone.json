[
  { "name": "{3}{G}: create a 0/1 Eldrazi Spawn",
    "players": [ { "battlefield": ["Propagator Drone", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Propagator Drone" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Propagator Drone", "Eldrazi Spawn"] }, {} ] } },
  { "name": "three lands: cannot pay {3}{G}",
    "players": [ { "battlefield": ["Propagator Drone", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Propagator Drone", "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Eldrazi Spawn"] }, {} ] } },
  { "name": "creature tokens have evolve: the Spawn token gets a counter when a bigger creature enters",
    "players": [ { "hand": ["Llanowar Elves"], "battlefield": ["Propagator Drone", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Propagator Drone" }, { "resolve": true }, { "cast": "Llanowar Elves" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Propagator Drone", "Eldrazi Spawn", "Llanowar Elves"] }, {} ], "counters": { "Eldrazi Spawn": { "p1p1": 1 } }, "pt": { "Eldrazi Spawn": [1, 2] } } },
  { "name": "ruling: evolve compares toughness too, so a 0/2 Ornithopter entering grows the 0/1 Spawn",
    "players": [ { "hand": ["Ornithopter"], "battlefield": ["Propagator Drone", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Propagator Drone" }, { "resolve": true }, { "cast": "Ornithopter" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Propagator Drone", "Eldrazi Spawn", "Ornithopter"] }, {} ], "counters": { "Eldrazi Spawn": { "p1p1": 1 } }, "pt": { "Eldrazi Spawn": [1, 2] } } },
  { "name": "ruling: a second Llanowar Elves that is neither bigger in power nor toughness does not grow the Spawn again",
    "players": [ { "hand": ["Llanowar Elves", "Llanowar Elves"], "battlefield": ["Propagator Drone", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Propagator Drone" }, { "resolve": true }, { "cast": "Llanowar Elves" }, { "resolve": true }, { "resolve": true }, { "cast": "Llanowar Elves" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Propagator Drone", "Eldrazi Spawn", "Llanowar Elves"] }, {} ], "counters": { "Eldrazi Spawn": { "p1p1": 1 } }, "pt": { "Eldrazi Spawn": [1, 2] } } }
]
