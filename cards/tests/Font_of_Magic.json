[
  {
    "name": "one commander cast from the command zone: Divination costs {1} less",
    "commander": true,
    "players": [
      {
        "hand": ["Font of Magic", "Divination"],
        "command": ["Savannah Lions"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Plains"],
        "library": ["Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Font of Magic" },
      { "resolve": true },
      { "cast": "Savannah Lions" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Divination"],
          "battlefield_has": ["Font of Magic", "Savannah Lions"],
          "hand": ["Island", "Island"]
        },
        {}
      ]
    }
  },
  {
    "name": "no commander cast this game: Divination still costs three",
    "players": [
      {
        "hand": ["Divination"],
        "battlefield": ["Font of Magic", "Island", "Island"],
        "library": ["Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Divination", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Divination"], "battlefield_has": ["Font of Magic"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Background that is your commander counts as a commander cast from the command zone",
    "commander": true,
    "players": [
      {
        "hand": ["Font of Magic", "Divination"],
        "command": ["Criminal Past"],
        "battlefield": ["Font of Magic", "Swamp", "Plains", "Plains", "Island", "Island"],
        "library": ["Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Criminal Past" },
      { "resolve": true },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Divination"], "battlefield_has": ["Criminal Past"] },
        {}
      ]
    }
  }
]
