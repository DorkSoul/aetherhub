[
  {
    "name": "reveals through the fourth land and graveyards everything revealed",
    "players": [
      { "hand": ["Mind Funeral"], "battlefield": ["Island", "Swamp", "Plains"] },
      { "library": ["Grizzly Bears", "Mountain", "Hill Giant", "Island", "Forest", "Swamp"] }
    ],
    "steps": [
      { "cast": "Mind Funeral", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Mind Funeral"] },
        { "graveyard_has": ["Grizzly Bears", "Mountain", "Hill Giant", "Island", "Forest", "Swamp"], "library_count": 20 }
      ]
    }
  },
  {
    "name": "cards below the fourth land stay in the library",
    "players": [
      { "hand": ["Mind Funeral"], "battlefield": ["Island", "Swamp", "Plains"] },
      { "library": ["Mountain", "Hill Giant", "Island", "Forest", "Swamp", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Mind Funeral", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard_has": ["Mountain", "Hill Giant", "Island", "Forest", "Swamp"], "library_count": 21 }
      ]
    }
  },
  {
    "name": "ruling: fewer than four lands in library: the whole library goes to the graveyard",
    "players": [
      { "hand": ["Mind Funeral"], "battlefield": ["Island", "Swamp", "Plains"] },
      { "exact_library": true, "library": ["Grizzly Bears", "Mountain", "Hill Giant", "Island"] }
    ],
    "steps": [
      { "cast": "Mind Funeral", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Mind Funeral"] },
        { "graveyard_has": ["Grizzly Bears", "Mountain", "Hill Giant", "Island"], "library_count": 0 }
      ]
    }
  }
]
