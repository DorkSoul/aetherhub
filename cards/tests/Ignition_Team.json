[
 {
  "name": "enters with a +1/+1 counter for each tapped land",
  "players": [
   {
    "hand": [
     "Ignition Team"
    ],
    "battlefield": [
     {
      "name": "Mountain",
      "tapped": true
     },
     {
      "name": "Mountain",
      "tapped": true
     },
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Ignition Team"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "counters": {
    "Ignition Team": {
     "p1p1": 9
    }
   }
  }
 },
 {
  "name": "removes a counter: target land becomes a 4/4 Elemental until end of turn",
  "players": [
   {
    "battlefield": [
     {
      "name": "Ignition Team",
      "counters": {
       "p1p1": 1
      }
     },
     "Mountain",
     "Mountain",
     "Mountain",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Ignition Team",
    "targets": [
     "Forest"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Forest": [
     4,
     4
    ]
   },
   "players": [
    {
     "battlefield_has": [
      "Forest"
     ]
    },
    {}
   ]
  }
 },
  {
    "name": "ruling: the animated land keeps its own mana ability",
    "players": [
      {
        "hand": ["Llanowar Elves"],
        "battlefield": [
          { "name": "Ignition Team", "counters": { "p1p1": 1 } },
          "Mountain", "Mountain", "Mountain", "Forest"
        ]
      },
      {}
    ],
    "steps": [
      { "activate": "Ignition Team", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Llanowar Elves" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Forest": [4, 4] },
      "tapped": { "Forest": true },
      "players": [ { "battlefield_has": ["Llanowar Elves", "Forest"] }, {} ]
    }
  },
  {
    "name": "ruling: pump effects on the animated land still apply",
    "players": [
      {
        "hand": ["Giant Growth"],
        "battlefield": [
          { "name": "Ignition Team", "counters": { "p1p1": 1 } },
          "Mountain", "Mountain", "Mountain", "Forest"
        ]
      },
      {}
    ],
    "steps": [
      { "activate": "Ignition Team", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Forest": [7, 7] }
    }
  },
  {
    "name": "ruling: a land that came under control this turn cannot tap for mana even when animated",
    "players": [
      {
        "hand": ["Llanowar Elves"],
        "battlefield": [
          { "name": "Ignition Team", "counters": { "p1p1": 1 } },
          "Mountain", "Mountain", "Mountain",
          { "name": "Forest", "sick": true }
        ]
      },
      {}
    ],
    "steps": [
      { "activate": "Ignition Team", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Llanowar Elves", "illegal": true }
    ],
    "expect": {
      "pt": { "Forest": [4, 4] },
      "players": [ { "battlefield_has": ["Forest"] }, {} ]
    }
  }
]