[
  {
    "name": "attacking creatures you control get +2/+0",
    "players": [
      { "battlefield": ["Nobilis of War", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2], "Hill Giant": [3, 3], "Nobilis of War": [3, 4] }
    }
  },
  {
    "name": "bonus applies to creatures you control only while attacking",
    "players": [
      { "battlefield": ["Nobilis of War", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2], "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "ruling: the attacking bonus lasts until the end of combat",
    "players": [
      { "battlefield": ["Nobilis of War", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ],
      "pt": { "Grizzly Bears": [2, 2], "Nobilis of War": [3, 4] }
    }
  }
]
