      { "advance_to": "Main2", "targets": ["p1"] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Dreadhorde Butcher"] },
        { "life": 19, "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "combat damage to a planeswalker adds a +1/+1 counter (the opponent's life is unchanged)",
