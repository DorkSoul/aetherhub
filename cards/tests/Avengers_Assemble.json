[
 { "name": "Heroes you control get +2/+2, other creatures don't",
   "players": [ { "battlefield": ["Avengers Assemble!", "Agent 13, Sharon Carter", "Grizzly Bears"] },
                { "battlefield": ["Agent 13, Sharon Carter"] } ],
   "steps": [],
   "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ { "battlefield_has": ["Avengers Assemble!"] }, {} ] } },
 { "name": "attacking with a Hero draws a card at the end step",
   "players": [ { "battlefield": ["Avengers Assemble!", { "name": "Agent 13, Sharon Carter", "sick": false }] }, {} ],
   "steps": [ { "attack": [ { "card": "Agent 13, Sharon Carter", "at": "p1" } ] },
              { "advance_to": "End" } ],
   "expect": { "players": [ { "hand_count": 1 }, { "life": 15 } ] } },
 { "name": "attacking with a non-Hero draws nothing",
   "players": [ { "battlefield": ["Avengers Assemble!", { "name": "Grizzly Bears", "sick": false }] }, {} ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "advance_to": "End" } ],
   "expect": { "players": [ { "hand_count": 0 }, { "life": 18 } ] } },
 { "name": "a Hero entering under your control draws a card at the end step",
   "players": [ { "hand": ["Agent 13, Sharon Carter"], "battlefield": ["Avengers Assemble!", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Agent 13, Sharon Carter" },
              { "resolve": true },
              { "advance_to": "End" } ],
   "expect": { "players": [ { "hand_count": 1 } ] } },
 { "name": "a non-Hero entering draws nothing",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Avengers Assemble!", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears" },
              { "resolve": true },
              { "advance_to": "End" } ],
   "expect": { "players": [ { "hand_count": 0 } ] } },
 { "name": "the Hero need not still be around: it attacked and then died",
   "players": [ { "hand": ["Doom Blade"], "battlefield": ["Avengers Assemble!", { "name": "Agent 13, Sharon Carter", "sick": false }, "Swamp", "Swamp"] }, {} ],
   "steps": [ { "attack": [ { "card": "Agent 13, Sharon Carter", "at": "p1" } ] },
              { "advance_to": "Main2" },
              { "cast": "Doom Blade", "targets": ["Agent 13, Sharon Carter"] },
              { "resolve": true },
              { "advance_to": "End" } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Agent 13, Sharon Carter"] } ] } }
]
