      { "hand": ["Dance of the Skywise"], "battlefield": ["Island", "Island", "Serra Angel"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dance of the Skywise", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "attack": [ { "card": "Serra Angel", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Serra Angel" } ], "illegal": true }
    ],
    "expect": {
      "pt": { "Serra Angel": [4, 4] }
    }
  },
  {
    "name": "cannot target an opponent's creature",
    "players": [
      { "hand": ["Dance of the Skywise"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dance of the Skywise", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "ruling: the creature loses its other colors and creature types",
    "players": [
      { "hand": ["Dance of the Skywise"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Dance of the Skywise", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "colors": { "Grizzly Bears": ["U"] },
      "subtypes": { "Grizzly Bears": ["Dragon", "Illusion"] },
      "not_subtypes": { "Grizzly Bears": ["Bear"] }
    }
  },
  {
    "name": "ruling: pump effects still apply to the 4/4 (Giant Growth makes it 7/7)",
    "players": [
      { "hand": ["Dance of the Skywise", "Giant Growth"], "battlefield": ["Island", "Island", "Forest", "Grizzly Bears"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Dance of the Skywise", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
