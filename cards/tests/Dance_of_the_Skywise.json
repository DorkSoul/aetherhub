      { "hand": ["Dance of the Skywise"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Dance of the Skywise", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "keywords": { "Grizzly Bears": ["Flying"] }
    }
  },
  {
    "name": "creature loses its printed abilities (vigilance) until end of turn",
