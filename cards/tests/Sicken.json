[
  { "name": "enchanted creature gets -1/-1",
    "players": [ { "hand": ["Sicken"], "battlefield": ["Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sicken", "targets": ["p1:Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [1, 1] }, "attached": { "Sicken": "Grizzly Bears" } } },
  { "name": "cycling pays 2 and draws a card",
    "players": [ { "hand": ["Sicken"], "battlefield": ["Swamp", "Island"] }, {} ],
    "steps": [ { "activate": "Sicken", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Sicken"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: Stifle can counter the cycling ability; Sicken is still discarded and nothing is drawn",
    "players": [ { "hand": ["Sicken"], "battlefield": ["Swamp", "Island"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Sicken", "ability": 0 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Sicken" } ] }, { "pass": true, "player": 1 }, { "pass": true } ],
    "expect": { "players": [ { "graveyard": ["Sicken"], "hand_count": 0 }, { "graveyard": ["Stifle"] } ] } },
  { "name": "ruling: a counterspell cannot target cycling, which is an ability and not a spell",
    "players": [ { "hand": ["Sicken"], "battlefield": ["Swamp", "Island"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Sicken", "ability": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1, "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Sicken"], "hand_count": 1 }, { "hand": ["Counterspell"] } ] } }
]
