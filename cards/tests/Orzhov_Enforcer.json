[
  {
    "name": "deathtouch kills the blocked attacker",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Orzhov Enforcer"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Orzhov Enforcer", "attacker": "Hill Giant" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Hill Giant"] },
        { "graveyard_has": ["Orzhov Enforcer"] }
      ]
    }
  },
  {
    "name": "afterlife 1: dies, creates a 1/1 flying Spirit for its controller",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Orzhov Enforcer"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Orzhov Enforcer"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard_has": ["Orzhov Enforcer"], "battlefield_has": ["Spirit"] }
      ]
    }
  }
]
