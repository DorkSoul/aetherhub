[
  { "name": "without the city's blessing it can't attack",
    "players": [ { "battlefield": ["Wayward Swordtooth", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "attack": [ { "card": "Wayward Swordtooth", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "with ten permanents (the city's blessing) it can attack",
    "players": [ { "battlefield": ["Wayward Swordtooth", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "attack": [ { "card": "Wayward Swordtooth", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "without the city's blessing it can't block",
    "players": [ { "battlefield": ["Wayward Swordtooth", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Wayward Swordtooth", "attacker": "Grizzly Bears" } ], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "may play an additional land each turn",
    "players": [ { "hand": ["Forest", "Forest"], "battlefield": ["Wayward Swordtooth"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "hand": [], "battlefield_has": ["Forest", "Forest"] }, {} ] } },
  { "name": "without the city's blessing Swordtooth's attack is dropped; Grizzly Bears still hits for 2",
    "players": [ { "battlefield": ["Wayward Swordtooth", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Wayward Swordtooth", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "without the city's blessing Swordtooth cannot block: Grizzly Bears gets through for 2",
    "players": [ { "battlefield": ["Wayward Swordtooth", "Forest", "Forest", "Forest", "Forest", "Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Savannah Lions"] } ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Savannah Lions", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Wayward Swordtooth", "attacker": "Grizzly Bears" }, { "blocker": "Hill Giant", "attacker": "Savannah Lions" } ], "player": 0 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 18 }, {} ] } },
  { "name": "ruling: Golden Demise with nine permanents is no city's blessing: all creatures get -2/-2",
    "players": [ { "hand": ["Golden Demise"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Savannah Lions"] } ],
    "steps": [ { "cast": "Golden Demise" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Savannah Lions"] } ] } },
  { "name": "ruling: Golden Demise with ten permanents has the city's blessing: only opposing creatures get -2/-2",
    "players": [ { "hand": ["Golden Demise"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Savannah Lions"] } ],
    "steps": [ { "cast": "Golden Demise" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Savannah Lions"] } ] } },
  { "name": "ruling: a Clue token counts as a permanent toward the ten",
    "players": [ { "hand": ["Thraben Inspector"], "battlefield": ["Wayward Swordtooth", "Plains", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Thraben Inspector" }, { "resolve": true }, { "attack": [ { "card": "Wayward Swordtooth", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "ruling: two Wayward Swordtooths allow three land drops in a turn",
    "players": [ { "hand": ["Forest", "Forest", "Forest", "Forest"], "battlefield": ["Wayward Swordtooth", "Wayward Swordtooth"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "play_land": "Forest" }, { "play_land": "Forest" }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "battlefield_has": ["Forest", "Forest", "Forest"] }, {} ] } },
  { "name": "ruling: the city's blessing is kept after the permanent count drops below ten",
    "players": [ { "hand": ["Forest", "Lightning Bolt"], "battlefield": ["Wayward Swordtooth", "Grizzly Bears", "Mountain", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Wayward Swordtooth", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "life": 15 } ] } },
  { "name": "ruling: a land played as the tenth permanent gives the blessing at once",
    "players": [ { "hand": ["Forest"], "battlefield": ["Wayward Swordtooth", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "attack": [ { "card": "Wayward Swordtooth", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } }
]
