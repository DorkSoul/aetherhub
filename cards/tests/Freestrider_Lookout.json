[
  { "name": "committing a crime (targeting an opponent) lets you put a land from the top five onto the battlefield tapped",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Freestrider Lookout"],
                   "library": ["Grizzly Bears", "Forest", "Island", "Plains", "Hill Giant", "Swamp"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [["Forest"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, { "life": 17 } ], "tapped": { "Forest": true } } },
  { "name": "targeting your own creature is not a crime: no look at the top five",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Freestrider Lookout", "Hill Giant"],
                   "library": ["Forest", "Island", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Forest", "Island"], "graveyard_has": ["Hill Giant"] }, {} ] } },
  { "name": "ruling: the crime is committed when the spell is cast, so the look happens even if the spell is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Freestrider Lookout"],
                   "library": ["Grizzly Bears", "Forest", "Island", "Plains", "Hill Giant", "Swamp"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true, "player": 0 },
               { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true, "answers": [["Forest"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"], "graveyard_has": ["Lightning Bolt"] }, { "life": 20, "graveyard_has": ["Counterspell"] } ], "tapped": { "Forest": true } } },
  { "name": "ruling: targeting an opponent's creature (a permanent) is a crime too: the look happens",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Freestrider Lookout"],
                   "library": ["Grizzly Bears", "Forest", "Island", "Plains", "Hill Giant", "Swamp"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [["Forest"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, { "graveyard_has": ["Grizzly Bears"] } ], "tapped": { "Forest": true } } }
]
