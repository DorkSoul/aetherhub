[
  {
    "name": "opponent's creature is sacrificed by its controller and that player gets tokens equal to its power",
    "players": [
      {
        "hand": ["Mercy Killing"],
        "battlefield": ["Forest", "Forest", "Forest"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Mercy Killing", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Mercy Killing"],
          "battlefield": ["Forest", "Forest", "Forest"]
        },
        {
          "graveyard": ["Grizzly Bears"],
          "battlefield": ["Elf Warrior 1-1 GW", "Elf Warrior 1-1 GW"]
        }
      ]
    }
  },
  {
    "name": "your own creature: you sacrifice it and get the tokens",
    "players": [
      {
        "hand": ["Mercy Killing"],
        "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"]
      },
      {
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Mercy Killing", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Mercy Killing", "Grizzly Bears"],
          "battlefield": ["Forest", "Forest", "Forest", "Elf Warrior 1-1 GW", "Elf Warrior 1-1 GW"]
        },
        {
          "battlefield": ["Mountain"]
        }
      ]
    }
  },
  {
    "name": "ruling: indestructible granted in response does not stop the sacrifice",
    "players": [
      { "hand": ["Mercy Killing"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }, "Ollenbock Escort" ] }
    ],
    "steps": [
      { "cast": "Mercy Killing", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "activate": "Ollenbock Escort", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Mercy Killing"] },
        { "graveyard": ["Ollenbock Escort", "Grizzly Bears"] }
      ]
    }
  }
]
