[
  { "name": "enchanted creature can't attack",
    "players": [ { "hand": ["Captured by the Consulate"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": [{ "name": "Grizzly Bears", "sick": false }] } ],
    "steps": [ { "cast": "Captured by the Consulate", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main1" }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1, "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "an opponent's single-target spell is redirected to the enchanted creature",
    "players": [ { "hand": ["Captured by the Consulate"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Captured by the Consulate", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } },
  { "name": "the target stays when the enchanted creature isn't a legal target",
    "players": [ { "hand": ["Captured by the Consulate"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Soothing Balm"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Captured by the Consulate", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "pass": true }, { "cast": "Soothing Balm", "player": 1, "targets": ["p0"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 25 }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "your own spells are not redirected",
    "players": [ { "hand": ["Captured by the Consulate", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Captured by the Consulate", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "enchanted creature can't attack, but its unrestricted teammate still deals damage",
    "players": [ { "hand": ["Captured by the Consulate"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": [{ "name": "Grizzly Bears", "sick": false }, { "name": "Runeclaw Bear", "sick": false }] } ],
    "steps": [ { "cast": "Captured by the Consulate", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main1" }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Runeclaw Bear", "at": "p0" } ], "player": 1 }, { "block": [], "player": 0 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 18 }, {} ] } },
  { "name": "ruling: a redirect the enchanted creature cannot accept leaves the target unchanged",
    "players": [ { "hand": ["Captured by the Consulate"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Hill Giant"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Silver Knight"] } ],
    "steps": [ { "cast": "Captured by the Consulate", "targets": ["Silver Knight"] }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Hill Giant"] }, { "battlefield_has": ["Silver Knight"], "graveyard": ["Lightning Bolt"] } ] } }
]
