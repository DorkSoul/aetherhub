[
 { "name": "an opponent gains control at the next end step after it is tapped",
   "players": [ { "battlefield": ["Rainbow Vale"] }, {} ],
   "steps": [ { "tap_for_mana": "Rainbow Vale", "color": "G" }, { "advance_to": "End" } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Rainbow Vale"] } ] } },
 { "name": "untapped it does not change control",
   "players": [ { "battlefield": ["Rainbow Vale"] }, {} ],
   "steps": [ { "advance_to": "End" } ],
   "expect": { "players": [ { "battlefield_has": ["Rainbow Vale"] }, {} ] } },
 { "name": "ruling: tapped in the End step, it does not change control until the next turn's end step",
   "players": [ { "battlefield": ["Rainbow Vale"] }, {} ],
   "steps": [ { "advance_to": "End" }, { "tap_for_mana": "Rainbow Vale", "color": "G" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "battlefield_has": ["Rainbow Vale"] }, {} ] } },
 { "name": "ruling: it changes control at the next turn's end step and stays tapped",
   "players": [ { "battlefield": ["Rainbow Vale"] }, {} ],
   "steps": [ { "advance_to": "End" }, { "tap_for_mana": "Rainbow Vale", "color": "G" }, { "advance_to": "Main1" }, { "advance_to": "End" } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Rainbow Vale"] } ], "tapped": { "Rainbow Vale": true } } }
]
