[
 { "name": "same-name instant in graveyard: may put a quest counter",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pyromancer Ascension"], "graveyard": ["Lightning Bolt"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Pyromancer Ascension": { "quest": 1 } } } },
 { "name": "no card with the same name in graveyard: no quest counter",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pyromancer Ascension"], "graveyard": ["Shock"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Pyromancer Ascension": { "quest": 0 } } } },
 { "name": "two quest counters: may copy the instant",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Pyromancer Ascension", "counters": { "quest": 2 } }] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 14 } ] } },
 { "name": "one quest counter: no copy",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Pyromancer Ascension", "counters": { "quest": 1 } }] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ] } },
 { "name": "ruling: the quest counter this spell adds does not make it copyable (copy needs two counters at cast)",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Pyromancer Ascension", "counters": { "quest": 1 } }], "graveyard": ["Lightning Bolt"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Pyromancer Ascension": { "quest": 2 } } } },
 { "name": "ruling: the quest counter is put on even if the spell is countered",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Pyromancer Ascension", "counters": { "quest": 1 } }], "graveyard": ["Lightning Bolt"] }, { "hand": ["Cancel"], "battlefield": ["Island", "Island", "Island"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Cancel", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ {}, { "life": 20 } ], "counters": { "Pyromancer Ascension": { "quest": 2 } } } },
 { "name": "ruling: a copy of a modal spell keeps the same mode (copy sacrifices again, no mode choice)",
   "players": [ { "hand": ["Grab the Reins"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Hill Giant", { "name": "Pyromancer Ascension", "counters": { "quest": 2 } }] }, {} ],
   "steps": [ { "cast": "Grab the Reins", "answers": [1], "targets": ["p1"] }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ { "graveyard": ["Grab the Reins", "Hill Giant"] }, { "life": 17 } ] } },
 { "name": "ruling: the copy has the same X as the original Fireball",
   "players": [ { "hand": ["Fireball"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Pyromancer Ascension", "counters": { "quest": 2 } }] }, {} ],
   "steps": [ { "cast": "Fireball", "targets": ["p1"], "answers": [3] }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ {}, { "life": 14 } ] } },
 { "name": "ruling: a card cast from my graveyard with no other same-name card there gets no quest counter",
   "players": [ { "hand": ["Forest"], "battlefield": ["Island", "Mountain", "Forest", "Pyromancer Ascension"], "graveyard": ["Beacon Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Beacon Bolt", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Beacon Bolt"] }, {} ], "counters": { "Pyromancer Ascension": { "quest": 0 } } } },
 { "name": "ruling: a card cast from my graveyard with another same-name card still there gets a quest counter",
   "players": [ { "hand": ["Forest"], "battlefield": ["Island", "Mountain", "Forest", "Pyromancer Ascension"], "graveyard": ["Beacon Bolt", "Beacon Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Beacon Bolt", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ {}, {} ], "counters": { "Pyromancer Ascension": { "quest": 1 } } } },
 { "name": "ruling: a copy of a Mastery cast with the alternative cost resolves as though paid (copy of a spell with no targets)",
   "players": [ { "hand": ["Verdant Mastery"], "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Pyromancer Ascension", "counters": { "quest": 2 } }], "library": ["Island", "Mountain", "Plains", "Swamp"] }, {} ],
   "steps": [ { "cast": "Verdant Mastery", "alt": 0 }, { "resolve": true, "auto": true, "answers": [true, ["Island", "Mountain", "Plains", "Swamp"], ["Swamp"], ["Island", "Mountain"]] } ],
   "expect": { "players": [ { "battlefield_has": ["Island", "Mountain"] }, { "battlefield_has": ["Swamp"] } ], "tapped": { "Swamp": true } } }
]
