[
 {
  "name": "pay 2 life at upkeep to keep it",
  "players": [ { "battlefield": ["Season of the Witch"] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
  "expect": { "players": [ { "life": 18, "battlefield_has": ["Season of the Witch"] }, {} ] }
 },
 {
  "name": "sacrificed at upkeep if you don't pay",
  "players": [ { "battlefield": ["Season of the Witch"] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
  "expect": { "players": [ { "life": 20, "graveyard": ["Season of the Witch"] }, {} ] }
 },
 {
  "name": "untapped creature that did not attack is destroyed at end step",
  "players": [ { "battlefield": ["Season of the Witch", "Grizzly Bears"] }, {} ],
  "steps": [ { "advance_to": "End" }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Season of the Witch"] }, {} ] }
 },
 {
  "name": "a creature cast this turn (summoning sick) and an opponent's creature both survive",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Season of the Witch", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Season of the Witch", "Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
 },
 {
  "name": "attacking creature survives, a defender that could not attack survives",
  "players": [ { "battlefield": ["Season of the Witch", "Grizzly Bears", "Wall of Wood"] }, {} ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Season of the Witch", "Grizzly Bears", "Wall of Wood"] }, { "life": 18 } ] }
 },
 {
  "name": "ruling: the end step trigger also destroys the opponent's non-attacking creature on the opponent's turn",
  "players": [ { "battlefield": ["Season of the Witch"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "End" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Season of the Witch"] }, { "graveyard": ["Grizzly Bears"] } ] }
 }
]
