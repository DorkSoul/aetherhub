[
  {"name": "damage equals the greatest mana value among the three milled cards",
   "players": [
     {"battlefield": ["Heretic's Punishment", "Mountain", "Mountain", "Mountain", "Mountain"],
      "library": ["Island", "Grizzly Bears", "Lightning Bolt", "Forest"]},
     {}],
   "steps": [
     {"activate": "Heretic's Punishment", "targets": ["p1"]},
     {"resolve": true}
   ],
   "expect": {"players": [{"library_count": 1}, {"life": 18}]}},
  {"name": "all milled cards have mana value 0 so no damage",
   "players": [
     {"battlefield": ["Heretic's Punishment", "Mountain", "Mountain", "Mountain", "Mountain"],
      "library": ["Island", "Forest", "Plains", "Grizzly Bears"]},
     {}],
   "steps": [
     {"activate": "Heretic's Punishment", "targets": ["p1"]},
     {"resolve": true}
   ],
   "expect": {"players": [{"library_count": 1}, {"life": 20}]}},
  {"name": "only milled cards count, not permanents on the battlefield",
   "players": [
     {"battlefield": ["Heretic's Punishment", "Mountain", "Mountain", "Mountain", "Mountain"],
      "library": ["Island", "Forest", "Plains", "Grizzly Bears"]},
     {"battlefield": ["Serra Angel"]}],
   "steps": [
     {"activate": "Heretic's Punishment", "targets": ["p1"]},
     {"resolve": true}
   ],
   "expect": {"players": [{}, {"life": 20}]}},
  {"name": "ruling: with two cards in library, all are milled and damage is the highest mana value among them",
   "players": [
     {"battlefield": ["Heretic's Punishment", "Mountain", "Mountain", "Mountain", "Mountain"],
      "library": ["Island", "Grizzly Bears"]},
     {}],
   "steps": [
     {"activate": "Heretic's Punishment", "targets": ["p1"]},
     {"resolve": true}
   ],
   "expect": {"players": [{"graveyard_has": ["Grizzly Bears"]}, {"life": 18}]}},
  {"name": "ruling: if the target is illegal on resolution, nothing is milled and no damage is dealt",
   "players": [
     {"battlefield": ["Heretic's Punishment", "Mountain", "Mountain", "Mountain", "Mountain"],
      "library": ["Island", "Grizzly Bears", "Lightning Bolt", "Forest"]},
     {"battlefield": ["Grizzly Bears", "Mountain"], "hand": ["Lightning Bolt"]}],
   "steps": [
     {"activate": "Heretic's Punishment", "targets": ["Grizzly Bears"]},
     {"pass": true},
     {"cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1},
     {"resolve": true}
   ],
   "expect": {"players": [{"library_count": 4}, {"graveyard_has": ["Grizzly Bears", "Lightning Bolt"]}]}}
]
