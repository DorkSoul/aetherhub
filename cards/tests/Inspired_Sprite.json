    "Inspired Sprite": true
   }
  }
 },
 {
  "name": "tapped after looting: cannot loot again",
  "players": [
   {
    "battlefield": [
     "Inspired Sprite"
    ],
    "library": [
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Inspired Sprite",
    "ability": 0
   },
   {
    "resolve": true
   },
   {
    "activate": "Inspired Sprite",
    "ability": 0,
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 0
    },
    {}
   ]
  }
 },
 {
  "name": "casting a Wizard spell may untap the tapped Sprite",
  "players": [
   {
    "hand": ["Mindspring Merfolk"],
    "battlefield": [{"name": "Inspired Sprite", "tapped": true}, "Island"]
   },
   {}
  ],
  "steps": [
   {"cast": "Mindspring Merfolk"},
   {"resolve": true, "answers": [true]}
  ],
  "expect": {
   "players": [
    {"battlefield_has": ["Inspired Sprite", "Mindspring Merfolk"]},
    {}
   ],
   "tapped": {"Inspired Sprite": false}
  }
 },
 {
  "name": "declining the Wizard untap leaves the Sprite tapped",
  "players": [
   {
    "hand": ["Mindspring Merfolk"],
    "battlefield": [{"name": "Inspired Sprite", "tapped": true}, "Island"]
   },
   {}
  ],
  "steps": [
   {"cast": "Mindspring Merfolk"},
   {"resolve": true, "answers": [false]}
  ],
  "expect": {
   "players": [
    {"battlefield_has": ["Inspired Sprite", "Mindspring Merfolk"]},
    {}
   ],
   "tapped": {"Inspired Sprite": true}
  }
 },
 {
  "name": "casting a non-Wizard spell does not untap the Sprite",
  "players": [
   {
    "hand": ["Shock"],
    "battlefield": [{"name": "Inspired Sprite", "tapped": true}, "Mountain"]
   },
   {}
  ],
  "steps": [
   {"cast": "Shock", "targets": ["p1"]},
   {"resolve": true}
  ],
  "expect": {
   "players": [
    {"battlefield_has": ["Inspired Sprite"]},
    {"life": 18}
   ],
   "tapped": {"Inspired Sprite": true}
  }
 }
]
