    "hand": [],
    "battlefield": [
     "Inspired Sprite"
    ],
    "library": [
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Inspired Sprite",
    "ability": 0
   },
   {
    "resolve": true
   }
  ],
