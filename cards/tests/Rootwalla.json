[
 {
  "name": "pump once",
  "players": [
   {
    "battlefield": [
     "Rootwalla",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Rootwalla"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Rootwalla": [
     4,
     4
    ]
   }
  }
 },
 {
  "name": "second activation in the same turn is illegal",
  "players": [
   {
    "battlefield": [
     "Rootwalla",
     "Forest",
     "Forest",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Rootwalla"
   },
   {
    "resolve": true
   },
   {
    "activate": "Rootwalla",
    "illegal": true
   }
  ],
  "expect": {
   "pt": {
    "Rootwalla": [
     4,
     4
    ]
   }
  }
 },
 {
  "name": "can activate again next turn",
  "players": [
   {
    "battlefield": [
     "Rootwalla",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Rootwalla"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main1"
   },
   {
    "advance_to": "Main1"
   },
   {
    "activate": "Rootwalla"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "pt": {
    "Rootwalla": [
     4,
     4
    ]
   }
  }
 },
 {
  "name": "ruling: after another player gains control the same turn, the new controller can't activate it again",
  "start": "End",
  "players": [
   { "battlefield": ["Rootwalla", "Forest", "Forest"] },
   { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Forest"] }
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "pass": true, "player": 1 },
   { "activate": "Rootwalla" },
   { "resolve": true },
   { "cast": "Control Magic", "player": 1, "targets": ["Rootwalla"] },
   { "resolve": true },
   { "activate": "Rootwalla", "player": 1, "illegal": true }
  ],
  "expect": {
   "pt": { "Rootwalla": [4, 4] },
   "players": [ {}, { "battlefield_has": ["Rootwalla"] } ]
  }
 },
 {
  "name": "boundary: without an earlier activation the new controller can activate it that turn",
  "start": "End",
  "players": [
   { "battlefield": ["Rootwalla", "Forest", "Forest"] },
   { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Forest"] }
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "cast": "Control Magic", "player": 1, "targets": ["Rootwalla"] },
   { "resolve": true },
   { "activate": "Rootwalla", "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Rootwalla": [4, 4] },
   "players": [ {}, { "battlefield_has": ["Rootwalla"] } ]
  }
 }
]