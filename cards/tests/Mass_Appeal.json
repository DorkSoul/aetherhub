[
  {
    "name": "draws a card for each Human you control",
    "players": [
      { "hand": ["Mass Appeal"], "battlefield": ["Island", "Island", "Island", "Human 1-1 White", "Human 1-1 Red", "Grizzly Bears"] },
      {}
    ],
    "steps": [ { "cast": "Mass Appeal" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] }
  },
  {
    "name": "no Humans means no cards",
    "players": [
      { "hand": ["Mass Appeal"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [ { "cast": "Mass Appeal" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] }
  },
  { "name": "ruling: Humans are counted when Mass Appeal resolves (a Human killed in response is not counted)",
    "players": [ { "hand": ["Mass Appeal", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Mountain", "Human 1-1 White", "Human 1-1 Red"] }, {} ],
    "steps": [ { "cast": "Mass Appeal" }, { "cast": "Lightning Bolt", "targets": ["Human 1-1 White"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_lacks": ["Human 1-1 White"] }, {} ] } }
]
