[
  { "name": "turns a Forest into a 4/4 creature until it leaves",
    "players": [ { "battlefield": ["Woodwraith Corrupter", "Swamp", "Forest", "Plains"] }, {} ],
    "steps": [ { "activate": "Woodwraith Corrupter", "ability": 0, "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Woodwraith Corrupter"] }, {} ], "pt": { "Forest": [4, 4] } } },
  { "name": "the animated Forest stays a 4/4 after the turn ends",
    "players": [ { "battlefield": ["Woodwraith Corrupter", "Swamp", "Forest", "Plains"] }, {} ],
    "steps": [ { "activate": "Woodwraith Corrupter", "ability": 0, "targets": ["Forest"] }, { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, {} ], "pt": { "Forest": [4, 4] } } },
  { "name": "ruling: the animated Forest stays a 4/4 into the opponent's turn (no duration)",
    "players": [ { "battlefield": ["Woodwraith Corrupter", "Swamp", "Forest", "Plains"] }, {} ],
    "steps": [ { "activate": "Woodwraith Corrupter", "ability": 0, "targets": ["Forest"] }, { "resolve": true },
               { "advance_to": "Main1" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, {} ], "pt": { "Forest": [4, 4] } } },
  { "name": "ruling: a Forest animated since the start of the turn can attack for 4",
    "players": [ { "battlefield": ["Woodwraith Corrupter", "Swamp", "Forest", "Llanowar Elves", "Plains"] }, {} ],
    "steps": [ { "tap_for_mana": "Swamp" }, { "tap_for_mana": "Llanowar Elves" }, { "tap_for_mana": "Plains" }, { "activate": "Woodwraith Corrupter", "ability": 0, "targets": ["Forest"] }, { "resolve": true },
               { "attack": [ { "card": "Forest", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 16 } ] } }
]
