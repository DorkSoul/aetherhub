[
  {
    "name": "two targets cost {2}{G} + {2}{G}: destroys an artifact and an enchantment",
    "players": [
      { "hand": ["Consign to Dust"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Sol Ring", "Journey to Nowhere"] }
    ],
    "steps": [
      { "cast": "Consign to Dust", "targets": ["Sol Ring", "Journey to Nowhere"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Consign to Dust"] }, { "graveyard": ["Sol Ring", "Journey to Nowhere"] } ]
    }
  },
  {
    "name": "one target costs only {2}{G}: an enchantment is destroyed",
    "players": [
      { "hand": ["Consign to Dust"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Journey to Nowhere", "Sol Ring"] }
    ],
    "steps": [
      { "cast": "Consign to Dust", "targets": ["Journey to Nowhere"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Journey to Nowhere"], "battlefield_has": ["Sol Ring"] } ]
    }
  },
  {
    "name": "strive: the two-target cost takes all six Forests, so Grizzly Bears can't be cast afterwards",
    "players": [
      { "hand": ["Consign to Dust", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Sol Ring", "Journey to Nowhere"] }
    ],
    "steps": [
      { "cast": "Consign to Dust", "targets": ["Sol Ring", "Journey to Nowhere"] },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Consign to Dust"] }, { "graveyard": ["Sol Ring", "Journey to Nowhere"] } ]
    }
  },
  {
    "name": "ruling: a strive spell may be cast with no targets and does nothing",
    "players": [
      { "hand": ["Consign to Dust"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Consign to Dust", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Consign to Dust"] }, { "battlefield_has": ["Sol Ring"] } ]
    }
  }
]
