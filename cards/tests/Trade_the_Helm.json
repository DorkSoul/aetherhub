[
  { "name": "exchanges control of a creature you control and one an opponent controls",
    "players": [ { "hand": ["Trade the Helm"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Trade the Helm" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "graveyard": ["Trade the Helm"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "cycling for two: discard it and draw a card",
    "players": [ { "hand": ["Trade the Helm"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Trade the Helm", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard": ["Trade the Helm"] }, {} ] } },
  { "name": "ruling: if one target is illegal on resolution, the exchange does not happen",
    "players": [ { "hand": ["Trade the Helm"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] } ],
    "steps": [ { "cast": "Trade the Helm", "targets": ["Grizzly Bears", "Hill Giant"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Trade the Helm"] }, { "graveyard_has": ["Hill Giant"] } ] } }
]
