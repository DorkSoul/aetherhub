[
 {
  "name": "no Treasure before your end step",
  "players": [
   {
    "hand": ["Trove of Temptation"],
    "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Trove of Temptation"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": ["Treasure"]
    },
    {}
   ]
  }
 },
 {
  "name": "at the beginning of your end step, create a Treasure",
  "players": [
   {
    "hand": ["Trove of Temptation"],
    "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Trove of Temptation"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": ["Treasure"]
    },
    {}
   ]
  }
 },
 {
  "name": "the opponent's creature must attack you: Grizzly Bears attacks and deals 2",
  "players": [
   { "battlefield": ["Trove of Temptation"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1", "player": 1 },
   { "advance_to": "BeginCombat", "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "life": 18 }, {} ] }
 },
 {
  "name": "a summoning-sick creature is not forced to attack",
  "players": [
   { "battlefield": ["Trove of Temptation"] },
   { "hand": [ "Memnite" ] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1", "player": 1 },
   { "cast": "Memnite", "player": 1 },
   { "resolve": true },
   { "advance_to": "BeginCombat", "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": { "turn": 2, "players": [ { "life": 20 }, {} ] }
 },
 {
  "name": "ruling: one attacker satisfies the requirement; the other creature may stay home",
  "players": [
   { "battlefield": ["Trove of Temptation"] },
   { "battlefield": ["Grizzly Bears", "Goblin Piker"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1", "player": 1 },
   { "advance_to": "BeginCombat", "player": 1 },
   { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "life": 18 }, { "battlefield_has": ["Goblin Piker"] } ] }
 }
]
