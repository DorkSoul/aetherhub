[
  {
    "name": "attacking flyers get +1/+1 when it attacks, including itself",
    "players": [
      { "battlefield": ["Kangee's Lieutenant"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Kangee's Lieutenant", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] }
    ],
    "expect": {
      "pt": { "Kangee's Lieutenant": [2, 2] }
    }
  },
  {
    "name": "non-flying attackers are not pumped",
    "players": [
      { "battlefield": ["Kangee's Lieutenant", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Kangee's Lieutenant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] }
    ],
    "expect": {
      "pt": { "Kangee's Lieutenant": [2, 2], "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "encore from the graveyard: a token copy is created for the opponent",
    "players": [
      { "graveyard": ["Kangee's Lieutenant"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Kangee's Lieutenant", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Kangee's Lieutenant"] }, {} ]
    }
  },
  {
    "name": "ruling: the encore token copies only the printed card, not counters the original had",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": [ { "name": "Kangee's Lieutenant", "counters": { "p1p1": 2 } }, "Mountain", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains" ]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Kangee's Lieutenant"] },
      { "resolve": true },
      { "activate": "Kangee's Lieutenant", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Kangee's Lieutenant"], "battlefield_has": ["Kangee's Lieutenant"] }, {} ],
      "pt": { "Kangee's Lieutenant": [1, 1] }
    }
  },
  {
    "name": "ruling: a flyer that gains flying after the attack trigger resolves gets no +1/+1",
    "players": [
      { "hand": ["Feather of Flight"], "battlefield": ["Kangee's Lieutenant", "Grizzly Bears", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Kangee's Lieutenant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "cast": "Feather of Flight", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] }
    ],
    "expect": {
      "pt": { "Kangee's Lieutenant": [2, 2], "Grizzly Bears": [3, 2] },
      "keywords": { "Grizzly Bears": ["Flying"] }
    }
  }
]
