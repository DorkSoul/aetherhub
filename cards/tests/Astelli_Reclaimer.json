[
  { "name": "cast for 5 mana: returns a permanent card with mana value 4 or less",
    "players": [ { "hand": ["Astelli Reclaimer"], "graveyard": ["Thran Dynamo"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Astelli Reclaimer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Astelli Reclaimer", "Thran Dynamo"] }, {} ] } },
  { "name": "warp for 3 mana: X is 3, so a mana value 4 permanent card stays in the graveyard",
    "players": [ { "hand": ["Astelli Reclaimer"], "graveyard": ["Thran Dynamo"], "battlefield": ["Plains", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Astelli Reclaimer", "alt": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Astelli Reclaimer"], "battlefield_lacks": ["Thran Dynamo"], "graveyard": ["Thran Dynamo"] }, {} ] } },
  { "name": "warp for 3 mana returns a mana value 2 permanent card",
    "players": [ { "hand": ["Astelli Reclaimer"], "graveyard": ["Mind Stone"], "battlefield": ["Plains", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Astelli Reclaimer", "alt": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Astelli Reclaimer", "Mind Stone"] }, {} ] } },
  { "name": "creature cards in the graveyard are never returned",
    "players": [ { "hand": ["Astelli Reclaimer"], "graveyard": ["Grizzly Bears"], "battlefield": ["Plains", "Plains", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Astelli Reclaimer" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Astelli Reclaimer"], "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a graveyard card with {X} in its cost has mana value 0 and can be returned",
    "players": [ { "hand": ["Astelli Reclaimer"], "graveyard": ["Chalice of the Void"], "battlefield": ["Plains", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Astelli Reclaimer", "alt": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Astelli Reclaimer", "Chalice of the Void"] }, {} ] } }
]
