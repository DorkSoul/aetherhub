[
  {
    "name": "raid: returns a creature card with mana value 2 or less from the graveyard",
    "players": [
      { "hand": ["Timely Hordemate"], "battlefield": ["Hill Giant", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Timely Hordemate" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Timely Hordemate"], "graveyard": [] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "no raid when you did not attack: nothing returns",
    "players": [
      { "hand": ["Timely Hordemate"], "battlefield": ["Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Timely Hordemate" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Timely Hordemate"], "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "raid but mana value 4 creature is not a legal target",
    "players": [
      { "hand": ["Timely Hordemate"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Timely Hordemate" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Timely Hordemate"], "battlefield_lacks": ["Hill Giant"], "graveyard": ["Hill Giant"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: raid still counts after the attacking creature died in combat",
    "players": [
      { "hand": ["Timely Hordemate"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" },
      { "cast": "Timely Hordemate" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Timely Hordemate", "Grizzly Bears"], "graveyard": [] },
        { "battlefield_has": ["Hill Giant"], "life": 20 }
      ]
    }
  }
]
