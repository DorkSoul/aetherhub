    "steps": [ { "cast": "Visage Bandit" }, { "resolve": true, "answers": ["Walking Ballista"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Visage Bandit"], "battlefield_has": ["Walking Ballista"] }, {} ] } },
  { "name": "ruling: the copy's enters-the-battlefield ability triggers (Mulldrifter draws two)",
    "players": [ { "hand": ["Visage Bandit"], "battlefield": ["Island", "Island", "Island", "Island", "Mulldrifter"] }, {} ],
    "steps": [ { "cast": "Visage Bandit" }, { "resolve": true, "answers": ["Mulldrifter"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "battlefield_has": ["Mulldrifter", "Mulldrifter"] }, {} ] } },
  { "name": "ruling: choosing not to copy makes it a 2/2 Shapeshifter Rogue",
    "players": [ { "hand": ["Visage Bandit"], "battlefield": ["Island", "Island", "Island", "Island", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Visage Bandit" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "battlefield_has": ["Visage Bandit", "Hill Giant"] }, {} ], "pt": { "Visage Bandit": [2, 2] } } }
