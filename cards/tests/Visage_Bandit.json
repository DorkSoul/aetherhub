    "players": [ { "hand": ["Visage Bandit"], "battlefield": ["Island", "Island", "Island", "Hill Giant"] }, {} ],
    "steps": [ { "activate": "Visage Bandit", "ability": 0 }, { "resolve": true },
               { "cast": "Visage Bandit", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Visage Bandit"] }, {} ] } },
