[
  {
    "name": "enters and deals damage equal to its power to a flyer an opponent controls",
    "players": [
      { "hand": ["Sharpshooter Elf"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Wind Drake"] }
    ],
    "steps": [
      { "cast": "Sharpshooter Elf" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Sharpshooter Elf"] },
        { "graveyard": ["Wind Drake"] }
      ],
      "pt": { "Sharpshooter Elf": [2, 2] }
    }
  },
  {
    "name": "ruling: leaving before its ETB resolves: damage uses power as it last existed (2, not 0)",
    "players": [
      { "hand": ["Sharpshooter Elf"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Wind Drake"] }
    ],
    "steps": [
      { "cast": "Sharpshooter Elf" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Sharpshooter Elf"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Sharpshooter Elf"], "battlefield_has": ["Grizzly Bears"] },
        { "graveyard_has": ["Wind Drake", "Lightning Bolt"] }
      ]
    }
  }
]
