[
  {
    "name": "draws when an opponent's spell targets it",
    "players": [
      {
        "battlefield": [
          "Old Fat Spider"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Old Fat Spider"
        ],
        "player": 1
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "battlefield": [
            "Old Fat Spider"
          ]
        },
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        }
      ]
    }
  },
  {
    "name": "no draw when its own controller targets it",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Old Fat Spider",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Old Fat Spider"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "battlefield": [
            "Mountain",
            "Old Fat Spider"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "power-2 Lions cannot block the Spider; the Hill Giant blocks the Bears and the Spider hits for 6",
    "players": [
      { "battlefield": [ { "name": "Old Fat Spider", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      { "battlefield": ["Savannah Lions", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Old Fat Spider", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Savannah Lions", "attacker": "Old Fat Spider" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"] },
        { "life": 14, "battlefield_has": ["Savannah Lions", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: the draw resolves before the Bolt, so it still happens when Counterspell counters the Bolt",
    "players": [
      { "hand": ["Counterspell"], "battlefield": ["Old Fat Spider", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Old Fat Spider"] },
      { "pass": true, "player": 1 },
      { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Counterspell"], "battlefield_has": ["Old Fat Spider"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
