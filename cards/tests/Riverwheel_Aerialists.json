[
  {
    "name": "prowess: noncreature spell gives +1/+1 on top of the spell's own effect",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Riverwheel Aerialists"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Riverwheel Aerialists"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Riverwheel Aerialists": [8, 9] }
    }
  },
  {
    "name": "a creature spell does not trigger prowess",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Riverwheel Aerialists"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Riverwheel Aerialists": [4, 5] }
    }
  },
  {
    "name": "ruling: playing a land does not trigger prowess",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Riverwheel Aerialists"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Riverwheel Aerialists": [4, 5] }
    }
  },
  {
    "name": "ruling: a countered noncreature spell still lets its prowess trigger resolve",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Riverwheel Aerialists"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Riverwheel Aerialists"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Giant Growth" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Giant Growth"] }, { "graveyard": ["Counterspell"] } ],
      "pt": { "Riverwheel Aerialists": [5, 6] }
    }
  }
]
