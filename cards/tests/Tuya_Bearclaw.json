 {
  "name": "ruling: X is read as the ability resolves; removing the other creature in response makes X 0",
  "players": [
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Tuya Bearclaw", "Hill Giant", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Tuya Bearclaw", "at": "p1" } ] },
   { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Tuya Bearclaw"] },
    {}
   ],
   "pt": { "Tuya Bearclaw": [2, 2] }
  }
 },
 {
  "name": "ruling: the bonus is fixed once applied; removing the other creature afterwards does not shrink it",
  "players": [
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Tuya Bearclaw", "Hill Giant", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Tuya Bearclaw", "at": "p1" } ] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Hill Giant", "Lightning Bolt"] },
    {}
   ],
   "pt": { "Tuya Bearclaw": [5, 5] }
  }
 },
 {
  "name": "ruling: a greatest other power of 0 gives X = 0 (a 0-power Wall with 7 toughness adds nothing)",
  "players": [
