  {
    "name": "ruling: if the creature target is gone when the ability resolves, the Equipment does not attach to anything else",
    "players": [
      {
        "hand": ["Kor Outfitter"],
        "battlefield": ["Plains", "Plains", "Bonesplitter", "Grizzly Bears"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Kor Outfitter" },
      { "resolve": true, "targets": ["Grizzly Bears"], "answers": [true] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bonesplitter", "Kor Outfitter"], "battlefield_lacks": ["Grizzly Bears"] },
