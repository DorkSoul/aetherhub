[
  { "name": "redirects the next 1 damage to a white creature onto Daughter (Bolt 3 to Courser: Courser survives, Daughter takes 1)",
    "players": [ { "battlefield": ["Daughter of Autumn", "Plains", "Pegasus Courser"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "activate": "Daughter of Autumn", "targets": ["Pegasus Courser"] }, { "resolve": true },
               { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["Pegasus Courser"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Daughter of Autumn", "Pegasus Courser"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "the redirected damage counts toward Daughter's toughness (1 + Bolt 3 kills her)",
    "players": [ { "battlefield": ["Daughter of Autumn", "Plains", "Pegasus Courser"] },
                 { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "activate": "Daughter of Autumn", "targets": ["Pegasus Courser"] }, { "resolve": true },
               { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["Pegasus Courser"] }, { "resolve": true },
               { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["Daughter of Autumn"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Pegasus Courser"], "battlefield_lacks": ["Daughter of Autumn"], "graveyard": ["Daughter of Autumn"] }, { "graveyard": ["Lightning Bolt", "Lightning Bolt"] } ] } },
  { "name": "target must be a white creature (Hill Giant is red)",
    "players": [ { "battlefield": ["Daughter of Autumn", "Plains", "Hill Giant"] }, {} ],
    "steps": [ { "activate": "Daughter of Autumn", "targets": ["Hill Giant"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Daughter of Autumn"] }, {} ] } },
  { "name": "needs {W} to activate",
    "players": [ { "battlefield": ["Daughter of Autumn", "Mountain", "Pegasus Courser"] }, {} ],
    "steps": [ { "activate": "Daughter of Autumn", "targets": ["Pegasus Courser"], "illegal": true } ],
    "expect": { "players": [ {}, {} ] } }
]
