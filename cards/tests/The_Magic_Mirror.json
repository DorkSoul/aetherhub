[
  { "name": "costs 1 less per instant or sorcery in your graveyard (7 mana with two)",
    "players": [ { "hand": ["The Magic Mirror"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt", "Counterspell"] }, {} ],
    "steps": [ { "cast": "The Magic Mirror" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["The Magic Mirror"], "hand_count": 0 }, {} ] } },
  { "name": "with only six lands and two instants in the graveyard the Mirror is not castable",
    "players": [ { "hand": ["The Magic Mirror"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Lightning Bolt", "Counterspell"] }, {} ],
    "steps": [ { "cast": "The Magic Mirror", "illegal": true } ],
    "expect": { "players": [ { "hand": ["The Magic Mirror"] }, {} ] } },
  { "name": "creature cards and opponent's instants do not reduce its cost",
    "players": [ { "hand": ["The Magic Mirror"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt", "Counterspell"] } ],
    "steps": [ { "cast": "The Magic Mirror", "illegal": true } ],
    "expect": { "players": [ { "hand": ["The Magic Mirror"] }, {} ] } },
  { "name": "upkeep: adds a knowledge counter and draws a card per counter",
    "players": [ { "battlefield": [ { "name": "The Magic Mirror", "sick": false, "counters": { "knowledge": 2 } } ] }, {} ],
    "start": "Untap",
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "counters": { "The Magic Mirror": { "knowledge": 3 } }, "players": [ { "hand_count": 3 }, {} ] } },
  { "name": "first upkeep: one counter, one card drawn (no draw on the first turn)",
    "players": [ { "battlefield": ["The Magic Mirror"] }, {} ],
    "start": "Untap",
    "steps": [ { "advance_to": "Main1" } ],
    "expect": { "counters": { "The Magic Mirror": { "knowledge": 1 } }, "players": [ { "hand_count": 1 }, {} ] } },
  { "name": "no maximum hand size: nine cards stay in hand at end step",
    "players": [ { "battlefield": ["The Magic Mirror"], "hand": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "start": "End",
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "hand_count": 9 }, {} ] } },
  { "name": "ruling: a split card with two instant halves is counted once for the cost reduction",
    "players": [ { "hand": ["The Magic Mirror"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Fire // Ice"] }, {} ],
    "steps": [ { "cast": "The Magic Mirror", "illegal": true } ],
    "expect": { "players": [ { "hand": ["The Magic Mirror"] }, {} ] } },
  { "name": "ruling: the reduction removes only generic mana, the blue mana must still be paid",
    "players": [ { "hand": ["The Magic Mirror"], "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Lightning Bolt", "Counterspell"] }, {} ],
    "steps": [ { "cast": "The Magic Mirror", "illegal": true } ],
    "expect": { "players": [ { "hand": ["The Magic Mirror"] }, {} ] } },
  { "name": "ruling: an adventure card in the graveyard is a creature card, not an instant or sorcery, so it does not reduce the cost",
    "players": [ { "hand": ["The Magic Mirror"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "graveyard": ["Brazen Borrower // Petty Theft"] }, {} ],
    "steps": [ { "cast": "The Magic Mirror", "illegal": true } ],
    "expect": { "players": [ { "hand": ["The Magic Mirror"] }, {} ] } }
]
