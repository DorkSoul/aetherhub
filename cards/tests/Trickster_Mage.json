[
  {
    "name": "tap mode taps the target",
    "players": [ { "hand": ["Forest"], "battlefield": ["Trickster Mage", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Trickster Mage", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [[0]] }
    ],
    "expect": { "tapped": { "Grizzly Bears": true, "Trickster Mage": true }, "players": [ { "graveyard": ["Forest"] }, {} ] }
  },
  {
    "name": "untap mode untaps the target",
    "players": [ { "hand": ["Forest"], "battlefield": ["Trickster Mage", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [
      { "activate": "Trickster Mage", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [[1]] }
    ],
    "expect": { "tapped": { "Grizzly Bears": false } }
  }
]
