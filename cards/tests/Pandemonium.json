[
  {
    "name": "controller of an entering creature may have it deal damage equal to its power to any target",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Pandemonium", "Forest", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true, "targets": ["p1"], "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "declining the may deals no damage",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Pandemonium", "Forest", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true, "targets": ["p1"], "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "a noncreature permanent entering does not trigger it",
    "players": [
      {
        "hand": ["Forest"],
        "battlefield": ["Pandemonium"]
      },
      {}
    ],
    "steps": [
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: a creature that leaves before the trigger resolves still deals damage equal to its last power",
    "players": [
      {
        "hand": ["Grizzly Bears", "Lightning Bolt"],
        "battlefield": ["Pandemonium", "Forest", "Forest", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["p1", "Grizzly Bears"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: the creature's controller (not Pandemonium's) chooses the target and whether to deal damage",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] },
      { "battlefield": ["Pandemonium"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true, "targets": ["p1"], "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "life": 18 }
      ]
    }
  }
]
