[
  { "name": "deathtouch and a forced block: the blocker dies",
    "players": [ { "hand": ["Deadly Allure"], "battlefield": ["Swamp", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Deadly Allure", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [], "illegal": true },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Deadly Allure", "Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ]
    } },
  { "name": "flashback for {G} exiles it after it resolves",
    "players": [ { "graveyard": ["Deadly Allure"], "battlefield": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Deadly Allure", "alt": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Deadly Allure"], "graveyard": [] }, {} ],
      "keywords": { "Grizzly Bears": ["Deathtouch"] }
    } },
  { "name": "ruling: a flashback spell that fizzles is still exiled",
    "players": [ { "battlefield": ["Forest", "Grizzly Bears"], "graveyard": ["Deadly Allure"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Deadly Allure", "alt": 0, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Deadly Allure"], "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ]
    } },
  { "name": "ruling: a flashback sorcery cannot be cast on the opponent's turn",
    "players": [ { "graveyard": ["Deadly Allure"], "battlefield": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Deadly Allure", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Deadly Allure"] }, {} ]
    } }
]
