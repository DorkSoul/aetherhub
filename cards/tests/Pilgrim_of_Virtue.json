[
 { "name": "sacrifice prevents the next damage from the chosen black source",
   "players": [ { "battlefield": ["Black Knight"] },
                { "battlefield": ["Pilgrim of Virtue", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Black Knight", "at": "p1" } ] },
              { "pass": true },
              { "activate": "Pilgrim of Virtue", "player": 1 },
              { "resolve": true },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 20, "graveyard": ["Pilgrim of Virtue"] } ] } },
 { "name": "a non-black attacker still deals its damage",
   "players": [ { "battlefield": ["Grizzly Bears", "Black Knight"] },
                { "battlefield": ["Pilgrim of Virtue", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Black Knight", "at": "p1" } ] },
              { "pass": true },
              { "activate": "Pilgrim of Virtue", "player": 1 },
              { "resolve": true },
              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "protection from black: a black blocker cannot block the Pilgrim, so its damage gets through",
   "players": [ { "battlefield": ["Pilgrim of Virtue", "Grizzly Bears"] },
                { "battlefield": ["Black Knight", "Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Pilgrim of Virtue", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
              { "block": [ { "blocker": "Black Knight", "attacker": "Pilgrim of Virtue" }, { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Pilgrim of Virtue"] }, { "life": 19, "battlefield_has": ["Black Knight"] } ] } }
