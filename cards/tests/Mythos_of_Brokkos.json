[
  { "name": "U and B spent: search for a card into the graveyard, then return a permanent card",
    "players": [ { "hand": ["Mythos of Brokkos"], "battlefield": ["Forest", "Forest", "Island", "Swamp"], "library": ["Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Mythos of Brokkos" }, { "resolve": true, "answers": ["Hill Giant"] } ],
    "expect": { "players": [ { "graveyard": ["Mythos of Brokkos", "Hill Giant"], "library_count": 1 }, {} ] } },
  { "name": "only U spent: no search, the library is untouched",
    "players": [ { "hand": ["Mythos of Brokkos"], "battlefield": ["Forest", "Forest", "Island", "Island"], "library": ["Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Mythos of Brokkos" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Mythos of Brokkos"], "library_count": 2 }, {} ] } },
  { "name": "up to two: returns the two chosen permanent cards and leaves the third",
    "players": [ { "hand": ["Mythos of Brokkos"], "battlefield": ["Forest", "Forest", "Island", "Island"], "graveyard": ["Grizzly Bears", "Hill Giant", "Forest"] }, {} ],
    "steps": [ { "cast": "Mythos of Brokkos", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears", "Hill Giant"], "graveyard": ["Mythos of Brokkos", "Forest"] }, {} ] } },
  { "name": "ruling: artifact and enchantment cards are permanent cards and can be returned; the instant stays in the graveyard",
    "players": [ { "hand": ["Mythos of Brokkos"], "battlefield": ["Forest", "Forest", "Island", "Island"], "graveyard": ["Lightning Bolt", "Ornithopter", "Shadows of the Past"] }, {} ],
    "steps": [ { "cast": "Mythos of Brokkos", "targets": ["Ornithopter", "Shadows of the Past"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Ornithopter", "Shadows of the Past"], "graveyard": ["Mythos of Brokkos", "Lightning Bolt"] }, {} ] } }
]
