[
 { "name": "losing the clash: the creature returns to its owner's hand",
   "players": [ { "hand": ["Whirlpool Whelm"], "battlefield": ["Island", "Island"], "library": ["Mountain"] }, { "battlefield": ["Hill Giant"], "library": ["Mountain"] } ],
   "steps": [ { "cast": "Whirlpool Whelm", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [false, false] } ],
