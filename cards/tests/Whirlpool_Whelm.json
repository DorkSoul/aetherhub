 { "name": "winning the clash and choosing the library: on top of its owner's library",
   "players": [ { "hand": ["Whirlpool Whelm"], "battlefield": ["Island", "Island"], "library": ["Hill Giant"] }, { "battlefield": ["Hill Giant"], "library": ["Mountain"] } ],
   "steps": [ { "cast": "Whirlpool Whelm", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [false, false, true] } ],
   "expect": { "players": [ {}, { "hand_count": 0, "library_count": 2 } ] } },
 { "name": "winning the clash but returning it to hand instead",
   "players": [ { "hand": ["Whirlpool Whelm"], "battlefield": ["Island", "Island"], "library": ["Hill Giant"] }, { "battlefield": ["Hill Giant"], "library": ["Mountain"] } ],
   "steps": [ { "cast": "Whirlpool Whelm", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [false, false, false] } ],
   "expect": { "players": [ {}, { "hand": ["Hill Giant"], "library_count": 1 } ] } },
 { "name": "ruling: the owner decides where its revealed card goes before I decide to put the creature on top (owner keeps its card on top, then my choice puts the creature above it)",
   "players": [ { "hand": ["Whirlpool Whelm"], "battlefield": ["Island", "Island"], "library": ["Hill Giant"] }, { "battlefield": ["Hill Giant"], "library": ["Mountain"] } ],
   "steps": [ { "cast": "Whirlpool Whelm", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [false, false, true] } ],
   "expect": { "players": [ {}, { "hand_count": 0, "library_top": ["Hill Giant", "Mountain"] } ] } },
 { "name": "ruling: the target is chosen on cast, so the clash does not change which creature returns (the other creature stays)",
   "players": [ { "hand": ["Whirlpool Whelm"], "battlefield": ["Island", "Island"], "library": ["Mountain"] }, { "battlefield": ["Hill Giant", "Grizzly Bears"], "library": ["Mountain"] } ],
   "steps": [ { "cast": "Whirlpool Whelm", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [false, false] } ],
   "expect": { "players": [ {}, { "hand": ["Hill Giant"], "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Hill Giant"] } ] } },
 { "name": "ruling: if I do not win the clash the creature always goes to hand (the top-of-library option is never offered)",
   "players": [ { "hand": ["Whirlpool Whelm"], "battlefield": ["Island", "Island"], "library": ["Mountain"] }, { "battlefield": ["Hill Giant"], "library": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Whirlpool Whelm", "targets": ["Hill Giant"] }, { "resolve": true, "answers": [false, false] } ],
