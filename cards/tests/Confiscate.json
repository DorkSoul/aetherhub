[
  {
    "name": "gain control of a creature",
    "players": [
      {
        "hand": [
          "Confiscate"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Confiscate",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears",
            "Confiscate"
          ]
        },
        {
          "battlefield": []
        }
      ],
      "attached": {
        "Confiscate": "Grizzly Bears"
      }
    }
  },
  {
    "name": "gain control of a land (any permanent)",
    "players": [
      {
        "hand": [
          "Confiscate"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Confiscate",
        "targets": [
          "p1:Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest",
            "Confiscate"
          ]
        },
        {
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "ruling: controlling an opponent's Aura keeps it attached to the creature it enchants",
    "players": [
      { "hand": ["Confiscate"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Predatory Hunger"], "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "cast": "Predatory Hunger", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Confiscate", "targets": ["p1:Predatory Hunger"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Confiscate", "Predatory Hunger"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "attached": { "Predatory Hunger": "Grizzly Bears" }
    }
  },
  {
    "name": "ruling: taking control of a creature does not take the Aura its controller put on it",
    "players": [
      { "hand": ["Confiscate"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Predatory Hunger"], "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1", "player": 1 },
      { "cast": "Predatory Hunger", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Confiscate", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Confiscate"] },
        { "battlefield_has": ["Predatory Hunger"], "battlefield": ["Forest", "Predatory Hunger"] }
      ],
      "attached": { "Predatory Hunger": "Grizzly Bears" }
    }
  }
]
