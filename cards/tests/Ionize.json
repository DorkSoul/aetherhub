[
  {
    "name": "counters a spell and deals 2 damage to its controller",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Ionize"
        ],
        "battlefield": [
          "Island",
          "Mountain",
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "cast": "Ionize",
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 18,
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 20,
          "graveyard": [
            "Ionize"
          ]
        }
      ]
    }
  },
  {
    "name": "no spell on the stack: can't cast",
    "players": [
      {
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Ionize"
        ],
        "battlefield": [
          "Island",
          "Mountain",
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Ionize",
        "player": 1,
        "illegal": true
      }
    ]
  },
  {
    "name": "ruling: a spell that can't be countered is a legal target; Ionize still deals 2 damage",
    "players": [
      { "hand": ["Carnage Tyrant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Ionize"], "battlefield": ["Island", "Mountain", "Plains"] }
    ],
    "steps": [
      { "cast": "Carnage Tyrant" },
      { "cast": "Ionize", "player": 1, "targets": [{ "stack": "Carnage Tyrant" }] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 18, "battlefield_has": ["Carnage Tyrant"] }, { "life": 20, "graveyard": ["Ionize"] } ] }
  }
]
