[
  { "name": "{0}: taps your lands and becomes a 3/3 until end of turn",
    "players": [ { "battlefield": ["Chimeric Idol", "Plains", "Forest"] }, {} ],
    "steps": [
      { "activate": "Chimeric Idol" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Chimeric Idol"] }, {} ], "pt": { "Chimeric Idol": [3, 3] }, "tapped": { "Plains": true, "Forest": true } } },
  { "name": "does not tap opponent lands",
    "players": [ { "battlefield": ["Chimeric Idol", "Plains"] }, { "battlefield": ["Island"] } ],
    "steps": [
      { "activate": "Chimeric Idol" },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Plains": true, "Island": false } } },
  { "name": "ruling: lands are tapped by the effect, not as a cost, so a land can still tap for mana in response",
    "players": [ { "battlefield": ["Chimeric Idol", "Plains", "Forest"] }, {} ],
    "steps": [ { "activate": "Chimeric Idol" }, { "tap_for_mana": "Plains" }, { "resolve": true } ],
    "expect": { "players": [ { "pool": { "W": 1 } }, {} ], "pt": { "Chimeric Idol": [3, 3] }, "tapped": { "Plains": true, "Forest": true } } }
]
