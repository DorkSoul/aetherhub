[
 {
  "name": "hard-cast: the team gets +1/+1 until end of turn",
  "players": [
   { "hand": ["Dwarven Lightsmith"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
   { "battlefield": ["Llanowar Elves"] }
  ],
  "steps": [ { "cast": "Dwarven Lightsmith" }, { "resolve": true } ],
  "expect": {
   "players": [ { "battlefield_has": ["Dwarven Lightsmith", "Grizzly Bears"] }, {} ],
   "pt": { "Dwarven Lightsmith": [4, 5], "Grizzly Bears": [3, 3], "Llanowar Elves": [1, 1] }
  }
 },
 {
  "name": "assist: another player pays the generic part",
  "players": [
   { "hand": ["Dwarven Lightsmith"], "battlefield": ["Plains"] },
   { "battlefield": ["Island", "Island", "Island", "Island", "Island"] }
  ],
  "steps": [ { "cast": "Dwarven Lightsmith", "answers": ["p1", 5] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Dwarven Lightsmith"], "hand_count": 0 }, {} ], "pt": { "Dwarven Lightsmith": [4, 5] } }
 },
 {
  "name": "the bonus ends at end of turn",
  "players": [
   { "hand": ["Dwarven Lightsmith"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [ { "cast": "Dwarven Lightsmith" }, { "resolve": true }, { "advance_to": "Upkeep" } ],
  "expect": { "pt": { "Dwarven Lightsmith": [3, 4] } }
 },
 {
  "name": "illegal when even the helper cannot cover the generic part",
  "players": [
   { "hand": ["Dwarven Lightsmith"], "battlefield": ["Plains"] },
   { "battlefield": ["Island", "Island", "Island", "Island"] }
  ],
  "steps": [ { "cast": "Dwarven Lightsmith", "illegal": true } ]
 },
 {
  "name": "ruling: a creature that comes under your control later in the turn does not get +1/+1",
  "players": [
   { "hand": ["Dwarven Lightsmith", "Llanowar Elves"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Forest"] },
   {}
  ],
  "steps": [ { "cast": "Dwarven Lightsmith" }, { "resolve": true }, { "cast": "Llanowar Elves" }, { "resolve": true } ],
  "expect": { "pt": { "Dwarven Lightsmith": [4, 5], "Llanowar Elves": [1, 1] } }
 },
 {
  "name": "ruling: assist pays only generic mana, so the caster must pay the white pip",
  "players": [
   { "hand": ["Dwarven Lightsmith"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
   { "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }
  ],
  "steps": [ { "cast": "Dwarven Lightsmith", "answers": ["p1", 5], "illegal": true } ],
  "expect": { "players": [ { "battlefield_has": [], "hand_count": 1 }, {} ] }
 }
]
