  {
    "name": "ruling: replacement effects (enters with counters) are not doubled by Yarok",
    "players": [
      { "hand": ["Hangarback Walker"], "battlefield": ["Yarok, the Desecrated", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Hangarback Walker", "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Hangarback Walker"] }, {} ],
      "pt": { "Hangarback Walker": [1, 1] }
    }
