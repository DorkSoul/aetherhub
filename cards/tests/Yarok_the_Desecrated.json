  {
    "name": "ruling: Yarok doubles a trigger caused by an opponent's creature entering",
    "players": [
      { "battlefield": ["Yarok, the Desecrated", "Soul Warden"] },
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }
