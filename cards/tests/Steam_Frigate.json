[
  {
    "name": "cannot attack when the defending player controls no Island",
    "players": [
      { "battlefield": ["Steam Frigate"] },
      { "battlefield": ["Plains"] }
    ],
    "steps": [
      { "attack": [{ "card": "Steam Frigate", "at": "p1" }], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "can attack when the defending player controls an Island",
    "players": [
      { "battlefield": ["Steam Frigate"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "attack": [{ "card": "Steam Frigate", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "without an Island it is dropped from the attack while another attacker still deals damage",
    "players": [
      { "battlefield": [{ "name": "Steam Frigate", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Plains"] }
    ],
    "steps": [
      { "attack": [{ "card": "Steam Frigate", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "tapped": { "Steam Frigate": false }
    }
  }
]
