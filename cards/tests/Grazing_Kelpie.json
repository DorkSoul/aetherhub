[
  { "name": "sacrifice to put a card from a graveyard into its owner's library; persist returns the Kelpie",
    "players": [ { "battlefield": ["Grazing Kelpie", "Forest"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Grazing Kelpie", "ability": 0, "targets": ["p1:Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grazing Kelpie"] }, { "graveyard": [], "library_count": 21 } ], "pt": { "Grazing Kelpie": [1, 2] } } },
  { "name": "persist returns it with a -1/-1 counter when it dies without counters",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grazing Kelpie"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p0:Grazing Kelpie"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grazing Kelpie"] }, {} ], "pt": { "Grazing Kelpie": [1, 2] } } },
  { "name": "ruling: a Kelpie that returned with a -1/-1 counter does not persist again (counters checked on the way out)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Grazing Kelpie", "Forest", "Mountain"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Grazing Kelpie", "ability": 0, "targets": ["p1:Grizzly Bears"] }, { "resolve": true }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["p0:Grazing Kelpie"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grazing Kelpie", "Lightning Bolt"] }, {} ] } }
]
