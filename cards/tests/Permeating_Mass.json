[
  {
    "name": "combat damage to a creature makes it a copy of Permeating Mass",
    "players": [
      {
        "battlefield": [
          "Permeating Mass"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Permeating Mass",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Grizzly Bears",
            "attacker": "Permeating Mass"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Permeating Mass"
          ]
        },
        {
          "battlefield_has": [
            "Permeating Mass"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: the creature it damaged still becomes a copy when Permeating Mass dies in that combat",
    "players": [
      { "battlefield": ["Permeating Mass"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Permeating Mass", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Permeating Mass" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Permeating Mass"] },
        { "battlefield_has": ["Permeating Mass"] }
      ]
    }
  },
  {
    "name": "ruling: a creature with 3 damage that becomes a copy of Permeating Mass is destroyed",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Permeating Mass"] },
      { "battlefield": ["Deathless Angel"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Deathless Angel"] },
      { "resolve": true },
      { "attack": [ { "card": "Permeating Mass", "at": "p1" } ] },
      { "block": [ { "blocker": "Deathless Angel", "attacker": "Permeating Mass" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Permeating Mass", "Shock"] },
        { "graveyard": ["Deathless Angel"] }
      ]
    }
  }
]
