[
 { "name": "all revealed cards are creatures: both enter under their owners' control",
   "players": [ { "battlefield": ["Game Preserve"], "library": ["Grizzly Bears", "Forest"] },
                { "library": ["Island", "Hill Giant", "Mountain"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Game Preserve", "Grizzly Bears"], "exile": [] }, { "battlefield_has": ["Hill Giant"], "exile": [] } ] } },
 { "name": "one revealed card is not a creature: nothing enters and the cards stay on top",
   "players": [ { "battlefield": ["Game Preserve"], "library": ["Grizzly Bears", "Forest"] },
                { "library": ["Island", "Mountain", "Hill Giant"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield": ["Game Preserve"], "exile": [], "library_count": 2 }, { "battlefield": [], "exile": [], "library_count": 2 } ] } },
 { "name": "the trigger only happens on your own upkeep",
   "players": [ { "battlefield": ["Game Preserve"], "library": ["Grizzly Bears", "Forest"] },
                { "library": ["Island", "Hill Giant", "Mountain"] } ],
   "steps": [ { "advance_to": "Upkeep" } ],
   "expect": { "players": [ { "battlefield": ["Game Preserve"] }, { "battlefield": [] } ] } }
]
