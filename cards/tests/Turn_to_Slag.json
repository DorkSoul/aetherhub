[
  {
    "name": "deals 5 damage and destroys Equipment attached to the target",
    "players": [
      {
        "hand": ["Turn to Slag"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Bonesplitter"]
      },
      {}
    ],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Turn to Slag", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Turn to Slag", "Grizzly Bears", "Bonesplitter"] },
        {}
      ]
    }
  },
  {
    "name": "leaves Equipment attached to a different creature alone",
    "players": [
      {
        "hand": ["Turn to Slag"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant", "Bonesplitter"]
      },
      {}
    ],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "cast": "Turn to Slag", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Turn to Slag", "Grizzly Bears"] },
        {}
      ],
      "attached": { "Bonesplitter": "Hill Giant" }
    }
  },
  {
    "name": "cannot target a noncreature permanent",
    "players": [
      {
        "hand": ["Turn to Slag"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Forest"]
      }
    ],
    "steps": [
      {
        "cast": "Turn to Slag",
        "targets": ["Forest"],
        "illegal": true
      }
    ]
  },
  {
    "name": "ruling: can target a creature with no Equipment attached",
    "players": [
      {
        "hand": ["Turn to Slag"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Turn to Slag", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Turn to Slag", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: target gone on resolution means the spell does nothing and Equipment survives",
    "players": [
      {
        "hand": ["Turn to Slag"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Bonesplitter"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Turn to Slag", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Turn to Slag", "Grizzly Bears"], "battlefield_has": ["Bonesplitter"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
