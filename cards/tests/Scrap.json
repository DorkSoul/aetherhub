[
  { "name": "destroys target artifact",
    "players": [ { "hand": ["Scrap"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Ornithopter"] } ],
    "steps": [ { "cast": "Scrap", "targets": ["Ornithopter"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scrap"] }, { "graveyard": ["Ornithopter"] } ] } },
  { "name": "cycling discards it and draws a card",
    "players": [ { "hand": ["Scrap"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Scrap", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scrap"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: Stifle can counter the cycling ability, so no card is drawn",
    "players": [ { "hand": ["Scrap"], "battlefield": ["Mountain", "Mountain"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Scrap", "ability": 0 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Scrap" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scrap"], "hand_count": 0 }, { "graveyard": ["Stifle"] } ] } }
]
