[
  { "name": "target player exiles a creature card from their graveyard and you gain 2 life",
    "players": [ { "battlefield": ["Graveyard Shovel", "Forest", "Forest"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Graveyard Shovel", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22 }, { "exile": ["Grizzly Bears"] } ] } },
  { "name": "no life when the exiled card is not a creature",
    "players": [ { "battlefield": ["Graveyard Shovel", "Forest", "Forest"] }, { "graveyard": ["Lightning Bolt"] } ],
    "steps": [ { "activate": "Graveyard Shovel", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "exile": ["Lightning Bolt"] } ] } },
  { "name": "empty graveyard: nothing exiled and no life gained",
    "players": [ { "battlefield": ["Graveyard Shovel", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Graveyard Shovel", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, {} ] } },
  { "name": "ruling: the targeted player chooses which card is exiled (chooses a non-creature, so no life)",
    "players": [ { "battlefield": ["Graveyard Shovel", "Forest", "Forest"] }, { "graveyard": ["Grizzly Bears", "Lightning Bolt"] } ],
    "steps": [ { "activate": "Graveyard Shovel", "ability": 0, "targets": ["p1"] }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
    "expect": { "players": [ { "life": 20 }, { "exile": ["Lightning Bolt"], "graveyard": ["Grizzly Bears"] } ] } }
]
