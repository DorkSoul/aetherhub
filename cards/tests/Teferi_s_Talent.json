 { "name": "ruling: one loyalty ability per turn counts granted and printed abilities together (printed first)",
   "players": [ { "hand": ["Teferi's Talent"], "battlefield": [ { "name": "Jace", "counters": { "loyalty": 14 } }, "Island", "Island", "Island", "Island", "Island" ] }, {} ],
