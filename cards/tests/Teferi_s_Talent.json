   "expect": { "counters": { "Jace": { "loyalty": 11 } } } },
 { "name": "whenever you draw a card, a loyalty counter goes on the enchanted planeswalker",
   "players": [ { "hand": ["Teferi's Talent", "Divination"], "battlefield": [ { "name": "Jace", "counters": { "loyalty": 4 } }, "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island" ] }, {} ],
   "steps": [ { "cast": "Teferi's Talent" },
              { "resolve": true },
              { "cast": "Divination" },
              { "resolve": true } ],
   "expect": { "counters": { "Jace": { "loyalty": 6 } } } },
 { "name": "a planeswalker that is not enchanted gets no counters",
   "players": [ { "hand": ["Teferi's Talent", "Divination"], "battlefield": [ { "name": "Jace", "counters": { "loyalty": 4 } }, { "name": "Garruk Wildspeaker", "counters": { "loyalty": 3 } }, "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island" ] }, {} ],
   "steps": [ { "cast": "Teferi's Talent", "targets": ["Jace"] },
              { "resolve": true },
              { "cast": "Divination" },
              { "resolve": true } ],
   "expect": { "counters": { "Jace": { "loyalty": 6 }, "Garruk Wildspeaker": { "loyalty": 3 } } } },
 { "name": "with the emblem you can activate loyalty abilities on an opponent's turn",
   "players": [ { "command": ["Teferi's Talent Emblem"], "battlefield": [ { "name": "Jace", "counters": { "loyalty": 5 } } ] }, {} ],
   "steps": [ { "advance_to": "Upkeep" },
              { "pass": true, "player": 1 },
              { "activate": "Jace", "ability": 1, "player": 0 },
              { "resolve": true } ],
   "expect": { "turn": 2, "counters": { "Jace": { "loyalty": 2 } }, "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "without the emblem it is not allowed on an opponent's turn",
   "players": [ { "battlefield": [ { "name": "Jace", "counters": { "loyalty": 5 } } ] }, {} ],
   "steps": [ { "advance_to": "Upkeep" },
              { "pass": true, "player": 1 },
              { "activate": "Jace", "ability": 1, "player": 0, "illegal": true } ],
   "expect": { "turn": 2, "counters": { "Jace": { "loyalty": 5 } } } },
 { "name": "with the emblem you can activate in response on your own turn, but only once per planeswalker per turn",
   "players": [ { "command": ["Teferi's Talent Emblem"], "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Jace", "counters": { "loyalty": 7 } }, "Mountain" ] }, {} ],
