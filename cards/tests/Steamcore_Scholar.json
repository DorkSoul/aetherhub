[
 {
  "name": "ETB: draw two, then discard two (hand has no matching card)",
  "players": [
   {
    "hand": [
     "Steamcore Scholar"
    ],
    "battlefield": [
     "Island",
     "Forest",
     "Forest"
    ],
    "library": [
     "Forest",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Steamcore Scholar"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand": [],
     "graveyard": [
      "Forest",
      "Island"
     ],
     "battlefield_has": [
      "Steamcore Scholar"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: discarding an instant satisfies the Unless, so only one card is discarded",
  "players": [
   { "hand": ["Steamcore Scholar"], "battlefield": ["Island", "Forest", "Forest"], "library": ["Lightning Bolt", "Forest"] },
   {}
  ],
  "steps": [ { "cast": "Steamcore Scholar" }, { "resolve": true, "answers": [true] } ],
  "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Lightning Bolt"], "battlefield_has": ["Steamcore Scholar"] }, {} ] }
 },
 {
  "name": "ruling: declining the Unless discards two cards even when an instant is among them",
  "players": [
   { "hand": ["Steamcore Scholar"], "battlefield": ["Island", "Forest", "Forest"], "library": ["Lightning Bolt", "Forest"] },
   {}
  ],
  "steps": [ { "cast": "Steamcore Scholar" }, { "resolve": true, "answers": [false] } ],
  "expect": { "players": [ { "hand": [], "graveyard": ["Lightning Bolt", "Forest"], "battlefield_has": ["Steamcore Scholar"] }, {} ] }
 },
 {
  "name": "ruling: discarding a creature card with flying satisfies the Unless",
  "players": [
   { "hand": ["Steamcore Scholar"], "battlefield": ["Island", "Forest", "Forest"], "library": ["Serra Angel", "Forest"] },
   {}
  ],
  "steps": [ { "cast": "Steamcore Scholar" }, { "resolve": true, "answers": [true] } ],
  "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Serra Angel"], "battlefield_has": ["Steamcore Scholar"] }, {} ] }
 }
]
