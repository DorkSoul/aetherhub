[
  {
    "name": "two verse counters: sacrifice to destroy up to two lands",
    "players": [
      {
        "battlefield": ["Mountain", {"name": "Rumbling Crescendo", "counters": {"verse": 2}}]
      },
      {
        "battlefield": ["Forest", "Island"]
      }
    ],
    "steps": [
      {
        "activate": "Rumbling Crescendo",
        "targets": ["Forest", "Island"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Rumbling Crescendo"]
        },
        {
          "graveyard": ["Forest", "Island"],
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "one verse counter: only one land is destroyed",
    "players": [
      {
        "battlefield": ["Mountain", {"name": "Rumbling Crescendo", "counters": {"verse": 1}}]
      },
      {
        "battlefield": ["Forest", "Island"]
      }
    ],
    "steps": [
      {
        "activate": "Rumbling Crescendo",
        "targets": ["Forest"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Rumbling Crescendo"]
        },
        {
          "graveyard": ["Forest"],
          "battlefield_has": ["Island"]
        }
      ]
    }
  },
  {
    "name": "no verse counters: sacrifice with no targets, no land is destroyed",
    "players": [
      {
        "battlefield": ["Mountain", "Rumbling Crescendo"]
      },
      {
        "battlefield": ["Forest"]
      }
    ],
    "steps": [
      {
        "activate": "Rumbling Crescendo"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Rumbling Crescendo"]
        },
        {
          "battlefield_has": ["Forest"]
        }
      ]
    }
  },
  {
    "name": "upkeep (our turn): accepting the optional counter gives X = 1",
    "players": [
      {
        "battlefield": ["Mountain", "Rumbling Crescendo"]
      },
      {
        "battlefield": ["Forest"]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep",
        "answers": [true]
      },
      {
        "resolve": true
      },
      {
        "activate": "Rumbling Crescendo",
        "targets": ["Forest"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Rumbling Crescendo"]
        },
        {
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "ruling: declining the upkeep counter means none can be added later in the turn",
    "players": [
      { "battlefield": ["Mountain", "Rumbling Crescendo"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "End" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true },
      { "activate": "Rumbling Crescendo", "targets": ["Forest"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Rumbling Crescendo"] },
        { "battlefield_has": ["Forest"] }
      ]
    }
  }
]
