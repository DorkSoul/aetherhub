[
  {
    "name": "first spell each turn: its caster creates a Treasure",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Pain Distributor"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Pain Distributor",
            "Treasure"
          ],
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "opponent's artifact dies: 1 damage to that opponent",
    "players": [
      {
        "hand": [
          "Shatter"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Pain Distributor"
        ]
      },
      {
        "battlefield": [
          "Sol Ring"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Shatter",
        "targets": [
          "Sol Ring"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Shatter"
          ]
        },
        {
          "life": 19,
          "graveyard": [
            "Sol Ring"
          ]
        }
      ]
    }
  },
  {
    "name": "own artifact dies: no damage to anyone",
    "players": [
      {
        "hand": [
          "Shatter"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Pain Distributor",
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Shatter",
        "targets": [
          "Sol Ring"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Shatter",
            "Sol Ring"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: an opponent's first spell on your turn makes them a Treasure",
    "players": [
      { "battlefield": ["Pain Distributor"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 17, "battlefield_lacks": ["Treasure"] },
        { "battlefield_has": ["Treasure"] }
      ]
    }
  },
  {
    "name": "ruling: the Treasure appears before the triggering spell resolves, but after its cost is paid",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pain Distributor"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "stack_empty": false,
      "players": [
        { "battlefield_has": ["Treasure"], "graveyard": [] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: Pain Distributor's first-spell ability does not trigger on the turn it is cast",
    "players": [
      { "hand": ["Pain Distributor"], "battlefield": ["Mountain", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Pain Distributor" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Pain Distributor"], "battlefield_lacks": ["Treasure"] },
        {}
      ]
    }
  }
]
