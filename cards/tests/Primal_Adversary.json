[
  { "name": "pay once: one counter and one land becomes a 3/3 Wolf",
    "players": [ { "hand": ["Primal Adversary"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Primal Adversary" }, { "resolve": true, "answers": [true, 1, ["Mountain"]] }, { "resolve": true } ],
    "expect": { "pt": { "Primal Adversary": [5, 4], "Mountain": [3, 3] }, "keywords": { "Mountain": ["Haste"] } } },
  { "name": "pay nothing: no counters and no Wolves",
    "players": [ { "hand": ["Primal Adversary"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Primal Adversary" }, { "resolve": true, "answers": [false] } ],
    "expect": { "pt": { "Primal Adversary": [4, 3] } } },
  { "name": "pay twice: two counters and up to two lands",
    "players": [ { "hand": ["Primal Adversary"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Mountain", "Swamp", "Plains"] }, {} ],
    "steps": [ { "cast": "Primal Adversary" }, { "resolve": true, "answers": [true, 2, ["Mountain", "Swamp"]] }, { "resolve": true } ],
    "expect": { "pt": { "Primal Adversary": [6, 5], "Mountain": [3, 3], "Swamp": [3, 3] } } },
  { "name": "ruling: an animated land keeps its land type (Mountain Wolf is still a Mountain)",
    "players": [ { "hand": ["Primal Adversary"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Primal Adversary" }, { "resolve": true, "answers": [true, 1, ["Mountain"]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mountain"] }, {} ], "subtypes": { "Mountain": ["Mountain", "Wolf"] }, "pt": { "Mountain": [3, 3] } } }
]
