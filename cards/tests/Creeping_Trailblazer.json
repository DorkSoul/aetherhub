[
  { "name": "pumps +1/+1 for each Elemental you control (itself counts)",
    "players": [ { "battlefield": ["Creeping Trailblazer", "Mountain", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Creeping Trailblazer", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Creeping Trailblazer": [3, 3] } } },
  { "name": "other Elementals get +1/+0, and the pump counts each one",
    "players": [ { "battlefield": ["Creeping Trailblazer", "Blizzard Elemental", "Mountain", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Creeping Trailblazer", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Creeping Trailblazer": [4, 4] } } },
  { "name": "other Elementals get +1/+0 without activating: Blizzard Elemental is 6/5, Grizzly Bears stays 2/2",
    "players": [ { "battlefield": ["Creeping Trailblazer", "Blizzard Elemental", "Grizzly Bears"] }, {} ],
    "steps": [],
    "expect": { "pt": { "Blizzard Elemental": [6, 5], "Grizzly Bears": [2, 2], "Creeping Trailblazer": [2, 2] } } },
  { "name": "ruling: the bonus is counted as the ability begins to resolve, so an Elemental killed in response is not counted",
    "players": [ { "battlefield": ["Creeping Trailblazer", "Brushfire Elemental", "Mountain", "Forest", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "activate": "Creeping Trailblazer", "ability": 0 }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Brushfire Elemental"] }, { "pass": true, "player": 1 }, { "pass": true }, { "resolve": true } ],
    "expect": { "pt": { "Creeping Trailblazer": [3, 3] }, "players": [ { "graveyard": ["Brushfire Elemental"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: the bonus is fixed once it resolves, so an Elemental that dies later does not shrink it",
    "players": [ { "battlefield": ["Creeping Trailblazer", "Brushfire Elemental", "Mountain", "Forest", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "activate": "Creeping Trailblazer", "ability": 0 }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Brushfire Elemental"] }, { "pass": true, "player": 1 }, { "pass": true } ],
    "expect": { "pt": { "Creeping Trailblazer": [4, 4] }, "players": [ { "graveyard": ["Brushfire Elemental"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: Creeping Trailblazer counts itself as an Elemental even with only non-Elementals around",
    "players": [ { "battlefield": ["Creeping Trailblazer", "Grizzly Bears", "Mountain", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Creeping Trailblazer", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Creeping Trailblazer": [3, 3], "Grizzly Bears": [2, 2] } } }
]
