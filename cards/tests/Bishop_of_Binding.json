    "name": "ruling: exiled token ceases to exist and does not return when Bishop leaves",
    "players": [
      { "hand": ["Bishop of Binding"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Zombie 2-2 Decayed", "Mountain"] }
