[
  {
    "name": "has deathtouch while you control three artifacts",
    "players": [
      {
        "battlefield": ["Teething Wurmlet", "Sol Ring", "Sol Ring", "Sol Ring"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "attack": [ { "card": "Teething Wurmlet", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Teething Wurmlet" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Teething Wurmlet"] }, { "graveyard_has": ["Hill Giant"] } ]
    }
  },
  {
    "name": "no deathtouch with only two artifacts",
    "players": [
      {
        "battlefield": ["Teething Wurmlet", "Sol Ring", "Sol Ring"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "attack": [ { "card": "Teething Wurmlet", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Teething Wurmlet" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Teething Wurmlet"] }, { "battlefield_has": ["Hill Giant"] } ]
    }
  },
  {
    "name": "an artifact entering gains you 1 life",
    "players": [
      {
        "hand": ["Sol Ring"],
        "battlefield": ["Teething Wurmlet", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 21 }, {} ],
      "counters": { "Teething Wurmlet": { "p1p1": 1 } }
    }
  },
  {
    "name": "only the first artifact each turn adds a +1/+1 counter, but every one gains life",
    "players": [
      {
        "hand": ["Sol Ring", "Sol Ring"],
        "battlefield": ["Teething Wurmlet", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Sol Ring" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 22 }, {} ],
      "counters": { "Teething Wurmlet": { "p1p1": 1 } }
    }
  }
]
