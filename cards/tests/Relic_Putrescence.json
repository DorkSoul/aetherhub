[
  {
    "name": "enchanted artifact becoming tapped gives its controller a poison counter",
    "players": [
      { "hand": ["Relic Putrescence"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Aether Vial"] }
    ],
    "steps": [
      { "cast": "Relic Putrescence", "targets": ["Aether Vial"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Aether Vial", "ability": 0, "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "poison": 1 }]
    }
  },
  {
    "name": "enchanted artifact that does not become tapped gives no poison",
    "players": [
      { "hand": ["Relic Putrescence"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Aether Vial"] }
    ],
    "steps": [
      { "cast": "Relic Putrescence", "targets": ["Aether Vial"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "poison": 0 }]
    }
  },
  {
    "name": "ruling: enchanting an already tapped artifact gives no poison until it becomes tapped",
    "players": [
      { "hand": ["Relic Putrescence"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": [{ "name": "Aether Vial", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Relic Putrescence", "targets": ["Aether Vial"] },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "poison": 0 }] }
  },
  {
    "name": "ruling: poison trigger from tapping for a non-mana ability goes on top and resolves before the ability",
    "players": [
      { "hand": ["Relic Putrescence"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Aether Vial"] }
    ],
    "steps": [
      { "cast": "Relic Putrescence", "targets": ["Aether Vial"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Aether Vial", "ability": 0, "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true }
    ],
    "expect": { "players": [{}, { "poison": 1 }] }
  },
  {
    "name": "ruling: enchanted artifact destroyed in response to its poison trigger still poisons its controller",
    "players": [
      { "hand": ["Relic Putrescence"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Forest", "Sylvok Replica"] },
      { "battlefield": ["Aether Vial"] }
    ],
    "steps": [
      { "cast": "Relic Putrescence", "targets": ["Aether Vial"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Aether Vial", "ability": 0, "player": 1 },
      { "pass": true, "player": 1 },
      { "activate": "Sylvok Replica", "targets": ["Aether Vial"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": { "players": [{ "graveyard": ["Sylvok Replica", "Relic Putrescence"] }, { "poison": 1, "graveyard": ["Aether Vial"] }] }
  }
]
