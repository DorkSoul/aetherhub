[
 {"name": "returns target opposing creature to its owner's hand",
  "players": [{"hand": ["Wipe Away"], "battlefield": ["Island", "Island", "Island"]}, {"battlefield": ["Hill Giant"]}],
  "steps": [{"cast": "Wipe Away", "targets": ["Hill Giant"]}, {"resolve": true}],
  "expect": {"players": [{"graveyard_has": ["Wipe Away"]}, {"hand": ["Hill Giant"]}]}},
 {"name": "can return your own permanent",
  "players": [{"hand": ["Wipe Away"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"]}, {}],
  "steps": [{"cast": "Wipe Away", "targets": ["Grizzly Bears"]}, {"resolve": true}],
  "expect": {"players": [{"hand": ["Grizzly Bears"]}, {}]}},
 {"name": "ruling: players still get priority with split second on the stack, but cannot cast an instant",
  "players": [{"hand": ["Wipe Away"], "battlefield": ["Island", "Island", "Island"]}, {"hand": ["Lightning Bolt"], "battlefield": ["Hill Giant", "Mountain"]}],
  "steps": [{"cast": "Wipe Away", "targets": ["Hill Giant"]}, {"pass": true}, {"cast": "Lightning Bolt", "player": 1, "targets": ["p0"], "illegal": true}, {"resolve": true}],
  "expect": {"players": [{"graveyard_has": ["Wipe Away"]}, {"hand_count": 2, "battlefield_lacks": ["Hill Giant"]}]}},
 {"name": "ruling: a triggered ability (Razzle's second-spell trigger) still triggers while split second is on the stack",
  "players": [{"hand": ["Lightning Bolt", "Wipe Away"], "battlefield": [{"name": "Razzle-Dazzler", "sick": false}, "Mountain", "Island", "Island", "Island"]}, {"battlefield": ["Hill Giant"]}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Wipe Away", "targets": ["Hill Giant"]}, {"resolve": true}, {"resolve": true}],
  "expect": {"counters": {"Razzle-Dazzler": {"p1p1": 1}}, "players": [{}, {"life": 17, "battlefield_lacks": ["Hill Giant"]}]}},
 {"name": "ruling: a spell already on the stack is unaffected by a split second spell cast in response (the Bolt still resolves)",
  "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"]}, {"hand": ["Wipe Away"], "battlefield": ["Island", "Island", "Island"]}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"pass": true}, {"cast": "Wipe Away", "player": 1, "targets": ["Grizzly Bears"]}, {"resolve": true}, {"resolve": true}],
  "expect": {"players": [{"hand": ["Grizzly Bears"]}, {"life": 17, "graveyard_has": ["Wipe Away"]}]}},
 {"name": "ruling: after the split second spell leaves the stack, a spell can be cast again before the next object resolves",
  "players": [{"hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"]}, {"hand": ["Wipe Away"], "battlefield": ["Island", "Island", "Island"]}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"pass": true}, {"cast": "Wipe Away", "player": 1, "targets": ["Grizzly Bears"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"resolve": true}],
  "expect": {"players": [{"hand": ["Grizzly Bears"]}, {"life": 14, "graveyard_has": ["Wipe Away"]}], "stack_empty": true}}
]
