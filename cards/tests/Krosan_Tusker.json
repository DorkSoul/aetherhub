[
 { "name": "cycling searches a basic land first, then draws",
   "players": [ { "hand": ["Krosan Tusker"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
   "steps": [ { "activate": "Krosan Tusker" }, { "resolve": true, "answers": [true, "Island"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Forest", "Island"], "graveyard": ["Krosan Tusker"] }, {} ] } },
 { "name": "declining the cycle search still draws the top card",
   "players": [ { "hand": ["Krosan Tusker"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island", "Forest"] }, {} ],
   "steps": [ { "activate": "Krosan Tusker" }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Krosan Tusker"] }, {} ] } },
 { "name": "casting it as a creature does not search",
   "players": [ { "hand": ["Krosan Tusker"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
   "steps": [ { "cast": "Krosan Tusker" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": [], "battlefield_has": ["Krosan Tusker"] }, {} ] } },
 { "name": "ruling: the cycle search resolves before the draw, so the drawn card is the next library card",
   "players": [ { "hand": ["Krosan Tusker"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island", "Forest"] }, {} ],
   "steps": [ { "activate": "Krosan Tusker" }, { "resolve": true, "answers": [true, "Island"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island", "Forest"], "graveyard": ["Krosan Tusker"] }, {} ] } },
 { "name": "ruling: countering the cycle trigger with Stifle does not stop the cycling draw",
   "players": [ { "hand": ["Krosan Tusker"], "battlefield": ["Forest", "Forest", "Forest"], "library": ["Island", "Forest"] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
   "steps": [ { "activate": "Krosan Tusker" }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Krosan Tusker" }] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Krosan Tusker"] }, { "graveyard": ["Stifle"] } ] } }
]
