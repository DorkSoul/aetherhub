[
  {
    "name": "own graveyard: lose life equal to mana value",
    "players": [
      {
        "hand": [
          "Reanimate"
        ],
        "battlefield": [
          "Swamp"
        ],
        "graveyard": [
          "Hill Giant"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Reanimate",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 16,
          "battlefield": [
            "Swamp",
            "Hill Giant"
          ],
          "graveyard": [
            "Reanimate"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "opponent's graveyard: you control it",
    "players": [
      {
        "hand": [
          "Reanimate"
        ],
        "battlefield": [
          "Swamp"
        ]
      },
      {
        "graveyard": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Reanimate",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 15,
          "battlefield_has": [
            "Serra Angel"
          ]
        },
        {
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "noncreature card is not a legal target",
    "players": [
      {
        "hand": [
          "Reanimate"
        ],
        "battlefield": [
          "Swamp"
        ],
        "graveyard": [
          "Lightning Bolt"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Reanimate",
        "targets": [
          "Lightning Bolt"
        ],
        "illegal": true
      }
    ]
  },
  {
    "name": "ruling: the entering creature's trigger resolves after the life loss",
    "players": [
      { "hand": ["Reanimate"], "battlefield": ["Swamp"], "graveyard": ["Mulldrifter"] },
      {}
    ],
    "steps": [
      { "cast": "Reanimate", "targets": ["Mulldrifter"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 15, "hand_count": 2, "battlefield_has": ["Mulldrifter"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: losing the game from the life loss means the entering creature's trigger does not resolve",
    "players": [
      { "life": 4, "hand": ["Reanimate"], "battlefield": ["Swamp"], "graveyard": ["Mulldrifter"] },
      {}
    ],
    "steps": [
      { "cast": "Reanimate", "targets": ["Mulldrifter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        {}
      ],
      "winner": 1
    }
  },
  {
    "name": "ruling: Platinum Emperion reanimated by you means your life total does not change",
    "players": [
      { "hand": ["Reanimate"], "battlefield": ["Swamp"], "graveyard": ["Platinum Emperion"] },
      {}
    ],
    "steps": [
      { "cast": "Reanimate", "targets": ["Platinum Emperion"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield_has": ["Platinum Emperion"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: {X} in the graveyard counts as 0, so the life loss is 0",
    "players": [
      { "hand": ["Reanimate"], "battlefield": ["Swamp"], "graveyard": ["Hangarback Walker"] },
      {}
    ],
    "steps": [
      { "cast": "Reanimate", "targets": ["Hangarback Walker"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20 },
        {}
      ]
    }
  }
]