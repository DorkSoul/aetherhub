[
  {
    "name": "toughness equals the number of basic land types among your lands",
    "players": [ { "hand": ["Aven Trailblazer"], "battlefield": ["Plains", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Aven Trailblazer" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Aven Trailblazer"] }, {} ],
      "pt": { "Aven Trailblazer": [2, 3] },
      "keywords": { "Aven Trailblazer": ["Flying"] }
    }
  },
  {
    "name": "a repeated basic land type counts once",
    "players": [ { "hand": ["Aven Trailblazer"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Aven Trailblazer" }, { "resolve": true } ],
    "expect": { "pt": { "Aven Trailblazer": [2, 1] } }
  },
  {"name": "ruling: a Desert (no basic land type) adds nothing to domain",
   "players": [ { "hand": ["Aven Trailblazer"], "battlefield": ["Plains", "Island", "Desert"] }, {} ],
   "steps": [ { "cast": "Aven Trailblazer" }, { "resolve": true } ],
   "expect": { "pt": { "Aven Trailblazer": [2, 2] } } }
]
