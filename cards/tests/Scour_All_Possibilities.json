[
  { "name": "cast for 1U draws a card",
    "players": [ { "hand": ["Scour All Possibilities"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Scour All Possibilities" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scour All Possibilities"], "hand_count": 1 }, {} ] } },
  { "name": "flashback for 4U exiles the card",
    "players": [ { "graveyard": ["Scour All Possibilities"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Scour All Possibilities", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Scour All Possibilities"], "graveyard": [], "hand_count": 1 }, {} ] } },
  { "name": "ruling: a countered flashback spell is still exiled",
    "players": [ { "graveyard": ["Scour All Possibilities"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Scour All Possibilities", "alt": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Scour All Possibilities" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Scour All Possibilities"], "graveyard": [] }, {} ] } },
  { "name": "ruling: flashback is a sorcery-speed cast, illegal while another spell is on the stack",
    "players": [ { "hand": ["Lightning Bolt"], "graveyard": ["Scour All Possibilities"], "battlefield": ["Mountain", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "Scour All Possibilities", "alt": 0, "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Scour All Possibilities", "Lightning Bolt"] }, { "life": 17 } ] } }
]
