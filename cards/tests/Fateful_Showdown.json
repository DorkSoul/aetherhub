[
  {
    "name": "damage equal to hand size; discard the hand, draw that many",
    "players": [
      {
        "hand": [
          "Fateful Showdown",
          "Grizzly Bears",
          "Hill Giant",
          "Forest"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Fateful Showdown",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3,
          "graveyard": [
            "Fateful Showdown",
            "Grizzly Bears",
            "Hill Giant",
            "Forest"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "empty hand: no damage and no cards drawn",
    "players": [
      {
        "hand": [
          "Fateful Showdown"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Fateful Showdown",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: if its target is gone on resolution, the spell does nothing: no discard and no draw",
    "players": [
      { "hand": ["Fateful Showdown", "Grizzly Bears", "Hill Giant", "Forest"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Fateful Showdown", "targets": ["p1:Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3, "graveyard": ["Fateful Showdown"] },
        { "life": 20, "graveyard_has": ["Grizzly Bears", "Lightning Bolt"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the spell is not counted in hand size: with only Forest in hand it deals 1, discards it and draws 1",
    "players": [
      { "hand": ["Fateful Showdown", "Forest"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Fateful Showdown", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard_has": ["Fateful Showdown", "Forest"] },
        { "life": 19 }
      ]
    }
  }
]
