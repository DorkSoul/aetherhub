[
  {
    "name": "tap to gain 1 life",
    "players": [
      { "battlefield": ["Silent Attendant"] },
      {}
    ],
    "steps": [
      { "activate": "Silent Attendant", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 21 }, {} ],
      "tapped": { "Silent Attendant": true }
    }
  },
  {
    "name": "a tapped attendant cannot gain life again",
    "players": [
      { "battlefield": [{ "name": "Silent Attendant", "tapped": true }] },
      {}
    ],
    "steps": [
      { "activate": "Silent Attendant", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "life": 20 }, {} ]
    }
  }
