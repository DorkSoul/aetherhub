[
  {
    "name": "casts an Equipment from the graveyard",
    "players": [
      {
        "battlefield": ["Plains", "Forest", "Island", "Mountain", "Swamp", "Plains", { "name": "Danitha, New Benalia's Light", "sick": false }],
        "graveyard": ["Bonesplitter"]
      },
      {}
    ],
    "steps": [
      { "cast": "Bonesplitter" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bonesplitter"] },
        {}
      ]
    }
  },
  {
    "name": "only once per turn: a second Aura or Equipment cannot be cast from the graveyard",
    "players": [
      {
        "battlefield": ["Plains", "Forest", "Island", "Mountain", "Swamp", "Plains", { "name": "Danitha, New Benalia's Light", "sick": false }],
        "graveyard": ["Bonesplitter", "Bonesplitter"]
      },
      {}
    ],
    "steps": [
      { "cast": "Bonesplitter" },
      { "resolve": true },
      { "cast": "Bonesplitter", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bonesplitter"] },
        {}
      ]
    }
  },
  {
    "name": "a non-Aura non-Equipment card cannot be cast from the graveyard",
    "players": [
      {
        "battlefield": ["Plains", "Forest", "Island", "Mountain", "Swamp", "Plains", { "name": "Danitha, New Benalia's Light", "sick": false }],
        "graveyard": ["Lightning Bolt"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Aura or Equipment cast from the graveyard still follows sorcery timing (not on the opponent's turn)",
    "players": [
      {
        "battlefield": ["Plains", "Forest", "Island", "Mountain", "Swamp", "Plains", { "name": "Danitha, New Benalia's Light", "sick": false }],
        "graveyard": ["Bonesplitter"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Bonesplitter", "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Bonesplitter"] },
        {}
      ]
    }
  }
