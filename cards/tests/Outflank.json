[
  {
    "name": "deals damage equal to the number of creatures you control",
    "players": [ { "hand": ["Outflank"], "battlefield": ["Plains", "Hill Giant", "Grizzly Bears", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "cast": "Outflank", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Hill Giant", "Outflank"] }, {} ] }
  },
  {
    "name": "one creature: 1 damage does not kill a 3/3 attacker",
    "players": [ { "hand": ["Outflank"], "battlefield": ["Plains", "Hill Giant"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "cast": "Outflank", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Outflank"] }, {} ] }
  },
  {
    "name": "ruling: only creatures you control are counted, not the opponent's",
    "players": [ { "hand": ["Outflank"], "battlefield": ["Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Knight of Meadowgrain"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "cast": "Outflank" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Outflank"] }, {} ] }
  }
]
