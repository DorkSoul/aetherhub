[
  {
    "name": "makes a Treasure in upkeep",
    "players": [
      {
        "battlefield": [
          "Smaug the Magnificent"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Treasure"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "needs RR and four mana",
    "players": [
      {
        "hand": [
          "Smaug the Magnificent"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Smaug the Magnificent",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Smaug the Magnificent"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "attack trigger deals damage equal to the Treasures you control",
    "players": [{ "battlefield": ["Smaug the Magnificent", "Treasure", "Treasure"] }, {}],
    "steps": [
      { "attack": [{ "card": "Smaug the Magnificent", "at": "p1" }] },
      { "resolve": true, "targets": ["p1"] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 14 }] }
  },
  {
    "name": "attack trigger with no Treasures deals no damage",
    "players": [{ "battlefield": ["Smaug the Magnificent"] }, {}],
    "steps": [
      { "attack": [{ "card": "Smaug the Magnificent", "at": "p1" }] },
      { "resolve": true, "targets": ["p1"] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 16 }] }
  }
]
