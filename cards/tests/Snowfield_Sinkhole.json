[
  {
    "name": "enters tapped",
    "players": [
      { "hand": ["Snowfield Sinkhole"] },
      {}
    ],
    "steps": [
      { "play_land": "Snowfield Sinkhole" }
    ],
    "expect": {
      "tapped": { "Snowfield Sinkhole": true }
    }
  },
  {
    "name": "taps for W",
    "players": [
      { "battlefield": ["Snowfield Sinkhole"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Snowfield Sinkhole", "color": "W" }
    ],
    "expect": {
      "players": [
        { "pool": { "W": 1 } },
        {}
      ]
    }
  },
  {
    "name": "ruling: {S} is paid by one mana from a snow source (Snowfield Sinkhole and a Snow-Covered Forest pay {S}{S})",
    "players": [
      { "battlefield": ["Icehide Troll", "Snowfield Sinkhole", "Snow-Covered Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Icehide Troll", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Icehide Troll": [4, 3] },
      "tapped": { "Icehide Troll": true }
    }
  },
  {
    "name": "ruling: a non-snow land cannot pay {S}: Plains and a Snow-Covered Forest cannot pay {S}{S}",
    "players": [
      { "battlefield": ["Icehide Troll", "Plains", "Snow-Covered Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Icehide Troll", "ability": 0, "illegal": true }
    ],
    "expect": {
      "pt": { "Icehide Troll": [2, 3] }
    }
  },
  {
    "name": "ruling: Berg Strider's {S} clause: snow mana from Snowfield Sinkhole keeps the tapped creature tapped through its controller's untap step",
    "players": [
      { "hand": ["Berg Strider"], "battlefield": ["Snowfield Sinkhole", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Berg Strider" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: without snow mana spent, Berg Strider's target untaps in its controller's untap step",
    "players": [
      { "hand": ["Berg Strider"], "battlefield": ["Plains", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Berg Strider" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  }
]
