[
  {
    "name": "dies: exiled, and creature cards from the graveyard go into the library",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Barishi", "Mountain"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Barishi"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Barishi"], "graveyard": ["Lightning Bolt"], "library_count": 21 },
        {}
      ]
    }
  },
  {
    "name": "a non-creature card in the graveyard stays there",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Barishi", "Mountain"], "graveyard": ["Giant Growth"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Barishi"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Barishi"], "graveyard": ["Lightning Bolt", "Giant Growth"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the ability is controlled by who controlled Barishi when it died (its own graveyard creatures are shuffled)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Barishi"], "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Barishi"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "exile": ["Barishi"], "graveyard": [], "library_count": 21 }
      ]
    }
  },
  {
    "name": "contrast: Crypt Creeper's sacrifice in response to the dies trigger, exiling a different graveyard card",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Barishi", "Crypt Creeper"], "graveyard": ["Grizzly Bears", "Giant Growth"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Barishi"] },
      { "resolve": true },
      { "pass": true },
      { "activate": "Crypt Creeper", "targets": ["Giant Growth"], "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "exile": ["Barishi", "Giant Growth"] }
      ]
    }
  }
]
