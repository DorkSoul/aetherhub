[
  {
    "name": "enters as a copy of a creature (Hill Giant)",
    "players": [
      { "hand": ["Cursed Mirror"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cursed Mirror" },
      { "resolve": true, "answers": [0] }
    ],
    "expect": {
      "pt": { "Hill Giant": [3, 3] },
      "players": [ { "battlefield_has": ["Hill Giant"] }, { "battlefield_has": ["Hill Giant"] } ]
    }
  },
  {
    "name": "the copy has haste and can attack the turn it enters",
    "players": [
      { "hand": ["Cursed Mirror"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cursed Mirror" },
      { "resolve": true, "answers": [0] },
      { "attack": [{ "card": "p0:Hill Giant", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "the copied creature's enters-the-battlefield trigger happens",
    "players": [
      { "hand": ["Cursed Mirror"], "battlefield": ["Mountain", "Mountain", "Mountain", "Elvish Visionary"] },
      {}
    ],
    "steps": [
      { "cast": "Cursed Mirror" },
      { "resolve": true, "answers": [0] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Elvish Visionary"] }, {} ]
    }
  },
  {
    "name": "declining the copy leaves a mana rock that taps for red",
    "players": [
      { "hand": ["Cursed Mirror", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cursed Mirror" },
      { "resolve": true, "answers": [[]] },
      { "tap_for_mana": "Cursed Mirror" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Cursed Mirror"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ]
    }
  },
  {
    "name": "it reverts to Cursed Mirror at end of turn",
    "players": [
      { "hand": ["Cursed Mirror"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cursed Mirror" },
      { "resolve": true, "answers": [0] },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Cursed Mirror"] }, {} ]
    }
  },
  {
    "name": "ruling: a copy of a copy becomes a copy of what the copied creature copied",
    "players": [
      { "hand": ["Clone", "Cursed Mirror"], "battlefield": ["Island", "Island", "Island", "Island", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Clone" },
      { "resolve": true, "answers": [0] },
      { "cast": "Cursed Mirror" },
      { "resolve": true, "answers": [0] }
    ],
    "expect": {
      "players": [ { "battlefield": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Island", "Island", "Island", "Island", "Mountain", "Mountain", "Mountain"] }, {} ]
    }
  }
]
