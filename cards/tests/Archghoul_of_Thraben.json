[
  {
    "name": "dies: a Zombie on top may be revealed into hand",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Archghoul of Thraben", "Mountain"], "library": ["Zombie Master"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Archghoul of Thraben"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "hand": ["Zombie Master"], "graveyard": ["Shock", "Archghoul of Thraben"] },
        {}
      ]
    }
  },
  {
    "name": "dies: a non-Zombie on top may go to the graveyard instead",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Archghoul of Thraben", "Mountain"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Archghoul of Thraben"] },
      { "resolve": true, "answers": [false, true] }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Shock", "Archghoul of Thraben", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "dies: declining both leaves the top card on top",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Archghoul of Thraben", "Mountain"], "library": ["Zombie Master"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Archghoul of Thraben"] },
      { "resolve": true, "answers": [false, false] }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Shock", "Archghoul of Thraben"] },
        {}
      ]
    }
  },
  {
    "name": "another Zombie you control dying triggers it too",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Archghoul of Thraben", "Zombie Master", "Mountain"], "library": ["Zombie Master"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Zombie Master"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "hand": ["Zombie Master"], "graveyard": ["Lightning Bolt", "Zombie Master"], "battlefield_has": ["Archghoul of Thraben"] },
        {}
      ]
    }
  },
  {
    "name": "a non-Zombie creature dying does not trigger it",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Archghoul of Thraben", "Grizzly Bears", "Mountain"], "library": ["Zombie Master"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "graveyard": ["Shock", "Grizzly Bears"], "battlefield_has": ["Archghoul of Thraben"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Archghoul and another Zombie dying together each trigger once",
    "players": [
      { "hand": ["Pyroclasm"], "battlefield": ["Archghoul of Thraben", "Gravecrawler", "Mountain", "Mountain"], "library": ["Zombie Master", "Zombie Master"] },
      {}
    ],
    "steps": [
      { "cast": "Pyroclasm" },
      { "resolve": true, "answers": [true, true] }
    ],
    "expect": {
      "players": [
        { "hand_count": 2, "graveyard": ["Pyroclasm", "Archghoul of Thraben", "Gravecrawler"] },
        {}
      ]
    }
  }
]
