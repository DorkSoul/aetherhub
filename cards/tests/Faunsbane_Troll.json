[
  {
    "name": "enters: Monster Role attached to the Troll (5/5 trample)",
    "players": [
      { "hand": ["Faunsbane Troll"], "battlefield": ["Swamp", "Forest", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Faunsbane Troll" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Faunsbane Troll"] },
        {}
      ],
      "attached": { "Monster Role": "Faunsbane Troll" },
      "pt": { "Faunsbane Troll": [5, 5] }
    }
  },
  {
    "name": "sorcery-speed: sacrifice the Aura, fight a creature, it is exiled if it dies",
    "players": [
      { "hand": ["Faunsbane Troll"], "battlefield": ["Swamp", "Forest", "Plains", "Plains", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Faunsbane Troll" },
      { "resolve": true },
      { "activate": "Faunsbane Troll", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Faunsbane Troll"], "battlefield_lacks": ["Monster Role"] },
        { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"] }
      ],
      "pt": { "Faunsbane Troll": [4, 4] }
    }
  },
  {
    "name": "no Aura attached any more: the fight ability is not legal",
    "players": [
      { "hand": ["Faunsbane Troll"], "battlefield": ["Swamp", "Forest", "Plains", "Plains", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Faunsbane Troll" },
      { "resolve": true },
      { "activate": "Faunsbane Troll", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Faunsbane Troll", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Faunsbane Troll"] },
        { "battlefield_has": [] }
      ]
    }
  },
  {
    "name": "ruling: Troll removed in response, the fight does not happen (Bears survive)",
    "players": [
      { "hand": ["Faunsbane Troll"], "battlefield": ["Swamp", "Forest", "Plains", "Plains", "Island"] },
      { "hand": ["Murder"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Faunsbane Troll" },
      { "resolve": true },
      { "activate": "Faunsbane Troll", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Faunsbane Troll"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Faunsbane Troll"] },
        { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Murder"] }
      ]
    }
  }
]
