    ],
    "steps": [
      { "cast": "Coils of the Medusa", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Wood", "attacker": "Grizzly Bears" }] },
      { "activate": "Coils of the Medusa" },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "life": 20, "battlefield_has": ["Wall of Wood"] }]
    }
  },
  {
    "name": "enchanted creature gets +1/-1",
    "players": [ { "battlefield": ["Grizzly Bears", "Swamp", "Swamp"], "hand": ["Coils of the Medusa"] }, {} ],
    "steps": [ { "cast": "Coils of the Medusa", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 1] } }
