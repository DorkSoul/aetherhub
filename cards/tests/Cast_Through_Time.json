[
 { "name": "an instant you cast from hand is exiled and cast again from exile at your next upkeep",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Cast Through Time", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "resolve": true },
              { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep", "answers": [true], "targets": ["p1"] } ],
   "expect": { "turn": 3, "players": [ { "graveyard": ["Lightning Bolt"], "exile": [] }, { "life": 14 } ] } },
 { "name": "right after resolving the instant waits in exile",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Cast Through Time", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Lightning Bolt"], "graveyard": [] }, { "life": 17 } ] } },
 { "name": "a sorcery gets rebound as well",
   "players": [ { "hand": ["Divination"], "battlefield": ["Cast Through Time", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Divination" },
              { "resolve": true },
              { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep", "answers": [true] } ],
   "expect": { "turn": 3, "players": [ { "graveyard": ["Divination"], "hand_count": 4 }, {} ] } },
 { "name": "declining the rebound cast leaves the card in exile",
   "players": [ { "hand": ["Divination"], "battlefield": ["Cast Through Time", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Divination" },
              { "resolve": true },
              { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep", "answers": [false] } ],
   "expect": { "turn": 3, "players": [ { "hand_count": 2 }, {} ] } },
 { "name": "only your own spells have rebound",
   "players": [ { "battlefield": ["Cast Through Time"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true },
              { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
              { "resolve": true } ],
   "expect": { "players": [ { "life": 17 }, { "graveyard": ["Lightning Bolt"], "exile": [] } ] } },
 { "name": "ruling: a rebound spell that fizzles goes to the graveyard and does not rebound",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Cast Through Time", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Island"], "hand": ["Unsummon"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
              { "pass": true },
              { "cast": "Unsummon", "targets": ["Grizzly Bears"], "player": 1 },
              { "resolve": true },
              { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep" } ],
   "expect": { "turn": 3, "players": [ { "graveyard": ["Lightning Bolt"], "exile": [] }, { "graveyard": ["Unsummon"] } ] } },
 { "name": "ruling: rebound still works after Cast Through Time has left the battlefield",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Cast Through Time", "Mountain"] }, { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "resolve": true },
              { "pass": true },
              { "cast": "Disenchant", "targets": ["Cast Through Time"], "player": 1 },
              { "resolve": true },
              { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep", "answers": [true], "targets": ["p1"] } ],
   "expect": { "turn": 3, "players": [ { "graveyard": ["Cast Through Time", "Lightning Bolt"], "exile": [] }, { "life": 14, "graveyard": ["Disenchant"] } ] } }
]
