[
 {
  "name": "pings the chosen target and the opponent's chosen target",
  "players": [
   {
    "battlefield": [
     "Cuombajj Witches"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Cuombajj Witches",
    "targets": [
     "p1",
     "p0"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "life": 19
    },
    {
     "life": 19
    }
   ],
   "tapped": {
    "Cuombajj Witches": true
   }
  }
 },
 {
  "name": "opponent's choice can hit a creature",
  "players": [
   {
    "battlefield": [
     "Cuombajj Witches"
    ]
   },
   {
    "battlefield": [
     "Savannah Lions"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Cuombajj Witches",
    "targets": [
     "p1",
     "Savannah Lions"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 19,
     "graveyard": [
      "Savannah Lions"
     ]
    }
   ]
  }
 },
 {
  "name": "tapped witches can't ping again",
  "players": [
   {
    "battlefield": [
     {
      "name": "Cuombajj Witches",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Cuombajj Witches",
    "illegal": true
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 20
    }
   ]
  }
 },
 {
  "name": "ruling: opponent can't choose their own hexproof creature as the second target",
  "players": [
   { "battlefield": ["Cuombajj Witches"] },
   { "battlefield": ["Slippery Bogle"] }
  ],
  "steps": [
   { "activate": "Cuombajj Witches", "targets": ["p1", "Slippery Bogle"], "illegal": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 20, "battlefield_has": ["Slippery Bogle"] }
   ]
  }
 },
 {
  "name": "ruling: opponent's choice still hits their other, non-hexproof creature",
  "players": [
   { "battlefield": ["Cuombajj Witches"] },
   { "battlefield": ["Slippery Bogle", "Savannah Lions"] }
  ],
  "steps": [
   { "activate": "Cuombajj Witches", "targets": ["p1", "Savannah Lions"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 19, "graveyard": ["Savannah Lions"], "battlefield_has": ["Slippery Bogle"] }
   ]
  }
 }
]
