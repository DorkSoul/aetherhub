[
  {
    "name": "controller cannot pay: the attacking red creature's combat damage is prevented",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Heroism", "Savannah Lions"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "pass": true },
      { "activate": "Heroism", "ability": 0, "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Hill Giant"] },
        { "battlefield": ["Heroism"], "graveyard": ["Savannah Lions"], "life": 20 }
      ]
    }
  },
  {
    "name": "controller pays {2}{R}: the damage is not prevented",
    "players": [
      { "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Heroism", "Savannah Lions"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "pass": true },
      { "activate": "Heroism", "ability": 0, "player": 1 },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"] },
        { "battlefield": ["Heroism"], "graveyard": ["Savannah Lions"], "life": 17 }
      ]
    }
  },
  {
    "name": "controller declines to pay: the damage is prevented",
    "players": [
      { "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Heroism", "Savannah Lions"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "pass": true },
      { "activate": "Heroism", "ability": 0, "player": 1 },
      { "resolve": true, "answers": [false] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"] },
        { "battlefield": ["Heroism"], "graveyard": ["Savannah Lions"], "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: paying the cost does not stop other prevention; Fog still prevents the damage",
    "players": [
      { "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Fog"], "battlefield": ["Heroism", "Savannah Lions", "Forest"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "pass": true },
      { "activate": "Heroism", "ability": 0, "player": 1 },
      { "resolve": true, "answers": [true] },
      { "pass": true },
      { "cast": "Fog", "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"] },
        { "battlefield_has": ["Heroism"], "graveyard": ["Savannah Lions", "Fog"], "life": 20 }
      ]
    }
  }
]
