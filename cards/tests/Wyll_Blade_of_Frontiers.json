[
 { "name": "rolls two dice keeps the highest and Wyll gets a counter",
   "players": [ { "battlefield": ["Wyll, Blade of Frontiers", "Clay Golem", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "rolls": [2, 6],
   "steps": [ { "activate": "Clay Golem" }, { "resolve": true, "targets": ["Forest"] } ],
   "expect": { "counters": { "Clay Golem": { "p1p1": 6 }, "Wyll, Blade of Frontiers": { "p1p1": 1 } }, "pt": { "Wyll, Blade of Frontiers": [2, 2] } } },
 { "name": "ignored die can be the second",
   "players": [ { "battlefield": ["Wyll, Blade of Frontiers", "Clay Golem", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
   "rolls": [5, 1],
   "steps": [ { "activate": "Clay Golem" }, { "resolve": true, "targets": ["Forest"] } ],
   "expect": { "counters": { "Clay Golem": { "p1p1": 5 }, "Wyll, Blade of Frontiers": { "p1p1": 1 } } } },
 { "name": "opponent's roll does not trigger Wyll or get the extra die",
   "players": [ { "battlefield": ["Wyll, Blade of Frontiers"] }, { "battlefield": ["Clay Golem", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] } ],
   "rolls": [3],
   "steps": [ { "advance_to": "End" }, { "pass": true }, { "advance_to": "Main1" }, { "player": 1, "activate": "Clay Golem" }, { "resolve": true, "targets": ["Forest"] } ],
   "expect": { "counters": { "Clay Golem": { "p1p1": 3 } }, "pt": { "Wyll, Blade of Frontiers": [1, 1] } } },
 { "name": "ruling: each commander's first cast from the command zone has no tax of its own (the other commander's cast does not add {2})",
   "players": [ { "command": ["Wyll, Blade of Frontiers", "Savannah Lions"], "battlefield": ["Mountain", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Wyll, Blade of Frontiers" }, { "resolve": true }, { "cast": "Savannah Lions" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Wyll, Blade of Frontiers", "Savannah Lions"] }, {} ] },
   "commander": true }
]
