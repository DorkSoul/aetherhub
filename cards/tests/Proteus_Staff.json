[
 {
  "name": "the target goes to the bottom of its owner's library and its controller puts the first creature card onto the battlefield",
  "players": [
   { "battlefield": ["Proteus Staff", "Island", "Island", "Island"] },
   { "battlefield": ["Hill Giant"], "library": ["Mountain", "Llanowar Elves", "Swamp"] }
  ],
  "steps": [
   { "activate": "Proteus Staff", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "battlefield": ["Llanowar Elves"], "library_count": 3 }
   ]
  }
 },
 {
  "name": "the reveal uses the target's controller, not the activator",
  "players": [
   { "battlefield": ["Proteus Staff", "Island", "Island", "Island"], "library": ["Grizzly Bears"] },
   { "battlefield": ["Hill Giant"], "library": ["Forest", "Craw Wurm"] }
  ],
  "steps": [
   { "activate": "Proteus Staff", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "library_count": 1 },
    { "battlefield": ["Craw Wurm"] }
   ]
  }
 },
 {
  "name": "the activator may target their own creature and reveals from their own library",
  "players": [
   { "battlefield": ["Proteus Staff", "Island", "Island", "Island", "Grizzly Bears"], "library": ["Forest", "Llanowar Elves"] },
   { "library": ["Mountain"] }
  ],
  "steps": [
   { "activate": "Proteus Staff", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Llanowar Elves"] },
    {}
   ]
  }
 }
]
