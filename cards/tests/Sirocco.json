        { "hand_count": 2, "life": 16, "graveyard": [] }
      ]
    }
  },
  {
    "name": "blue instant revealed, opponent declines: card is discarded",
    "players": [
      { "hand": ["Sirocco"], "battlefield": ["Mountain", "Island"] },
      { "hand": ["Counterspell", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sirocco", "targets": ["p1"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Sirocco"] },
        { "hand": ["Grizzly Bears"], "graveyard": ["Counterspell"], "life": 20 }
      ]
    }
  },
  {
    "name": "no blue instant in hand: nothing is discarded and no payment is asked",
    "players": [
      { "hand": ["Sirocco"], "battlefield": ["Mountain", "Island"] },
      { "hand": ["Lightning Bolt", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sirocco", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Sirocco"] },
        { "hand_count": 2, "life": 20, "graveyard": [] }
      ]
    }
  },
  {
    "name": "ruling: targeting yourself, declining to pay makes you discard the blue instant",
    "players": [
      { "hand": ["Sirocco", "Counterspell"], "battlefield": ["Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Sirocco", "targets": ["p0"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "life": 20, "graveyard_has": ["Sirocco", "Counterspell"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: targeting yourself, paying 4 life keeps the blue instant in hand",
    "players": [
      { "hand": ["Sirocco", "Counterspell"], "battlefield": ["Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Sirocco", "targets": ["p0"] },
      { "resolve": true, "answers": [true] }
