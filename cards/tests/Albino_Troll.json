[
  {
    "name": "echo: paying {1}{G} keeps the Troll",
    "players": [
      {
        "hand": ["Albino Troll"],
        "battlefield": ["Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Albino Troll" },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Albino Troll"] },
        {}
      ]
    }
  },
  {
    "name": "echo: not paying sacrifices the Troll",
    "players": [
      {
        "hand": ["Albino Troll"],
        "battlefield": ["Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Albino Troll" },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Albino Troll"] },
        {}
      ]
    }
  },
  {
    "name": "regenerate: the shield saves it from lethal damage",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Albino Troll", "Forest", "Forest", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Albino Troll", "ability": 0 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Albino Troll"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Albino Troll"] },
        {}
      ]
    }
  },
  {
    "name": "without regeneration lethal damage kills the Troll",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Albino Troll", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Albino Troll"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Albino Troll", "Lightning Bolt"] },
        {}
      ]
    }
  }
]
