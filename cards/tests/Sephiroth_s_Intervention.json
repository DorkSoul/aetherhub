[
  {
    "name": "destroy target creature and gain 2 life",
    "players": [
      { "hand": ["Sephiroth's Intervention"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sephiroth's Intervention", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "graveyard": ["Sephiroth's Intervention"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "needs a creature target",
    "players": [
      { "hand": ["Sephiroth's Intervention"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Sentinel Totem"] },
      {}
    ],
    "steps": [
      { "cast": "Sephiroth's Intervention", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Sephiroth's Intervention"], "life": 20 },
        {}
      ]
    }
  },
  {
    "name": "ruling: if the target is gone on resolution, nothing happens and no life is gained",
    "players": [
      { "hand": ["Sephiroth's Intervention"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Unsummon"], "battlefield": ["Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sephiroth's Intervention", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Unsummon", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard": ["Sephiroth's Intervention"] },
        { "hand": ["Grizzly Bears"], "graveyard": ["Unsummon"], "battlefield": ["Island"] }
      ]
    }
  }
]
