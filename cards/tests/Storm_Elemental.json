[
  { "name": "taps a flyer, exiling the top card",
    "players": [ { "library": ["Forest", "Forest"], "battlefield": ["Storm Elemental", "Island", "Island"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "activate": "Storm Elemental", "ability": 0, "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "tapped": { "Serra Angel": true }, "players": [ { "exile": ["Forest"] }, {} ] } },
  { "name": "a non-snow land gives no bonus",
    "players": [ { "library": ["Forest", "Forest"], "battlefield": ["Storm Elemental", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Storm Elemental", "ability": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Storm Elemental": [3, 4] }, "players": [ { "exile": ["Forest"] }, {} ] } },
  { "name": "a snow land gives +1/+1",
    "players": [ { "library": ["Snow-Covered Forest", "Forest"], "battlefield": ["Storm Elemental", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Storm Elemental", "ability": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Storm Elemental": [4, 5] }, "players": [ { "exile": ["Snow-Covered Forest"] }, {} ] } },
  { "name": "ruling: the tap ability exiles a snow land but its effect ignores that card: no +1/+1, Serra Angel is tapped",
    "players": [ { "library": ["Snow-Covered Forest", "Forest"], "battlefield": ["Storm Elemental", "Island", "Island"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "activate": "Storm Elemental", "ability": 0, "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "tapped": { "Serra Angel": true }, "pt": { "Storm Elemental": [3, 4] }, "players": [ { "exile": ["Snow-Covered Forest"] }, {} ] } }
]
