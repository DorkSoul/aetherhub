[
 {
  "name": "end step makes a servo after a permanent left under your control",
  "players": [
   {
    "battlefield": [
     "Hidden Stockpile",
     "Grizzly Bears",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Hidden Stockpile",
    "ability": 0,
    "targets": []
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Hidden Stockpile",
      "Servo"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "no servo when no permanent left the battlefield this turn",
  "players": [
   {
    "battlefield": [
     "Hidden Stockpile"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Hidden Stockpile"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: two permanents leaving the battlefield this turn still make only one Servo",
  "players": [
   { "hand": ["Murder"], "battlefield": ["Hidden Stockpile", "Grizzly Bears", "Grizzly Bears", "Swamp", "Swamp", "Swamp", "Swamp"] },
   {}
  ],
  "steps": [
   { "cast": "Murder", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "activate": "Hidden Stockpile", "ability": 0 },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield": ["Hidden Stockpile", "Servo", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ] }
 },
 {
  "name": "ruling: a creature destroyed by an opponent's Murder counts for revolt",
  "players": [
   { "battlefield": ["Hidden Stockpile", "Grizzly Bears"] },
   { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Murder", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Hidden Stockpile", "Servo"] }, { "hand_count": 0 } ] }
 },
 {
  "name": "ruling: a creature that left before Hidden Stockpile entered still counts for revolt",
  "players": [
   { "hand": ["Murder", "Hidden Stockpile"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp", "Swamp", "Swamp", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Murder", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Hidden Stockpile" },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Hidden Stockpile", "Servo"] }, {} ] }
 }
]
