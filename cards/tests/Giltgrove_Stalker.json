   "steps": [ { "attack": [ { "card": "Giltgrove Stalker", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Giltgrove Stalker" } ] }, { "advance_to": "Main2" } ],
