   "steps": [ { "attack": [ { "card": "Giltgrove Stalker", "at": "p1" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 20 }, { "life": 18 } ] } },
 { "name": "a power 3 creature may block it",
