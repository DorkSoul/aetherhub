   "steps": [ { "attack": [ { "card": "Giltgrove Stalker", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Giltgrove Stalker" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard": ["Giltgrove Stalker"] }, { "battlefield_has": ["Hill Giant"] } ] } },
