   { "cast": "Shock", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true },
   { "cast": "Shock", "targets": ["Savannah Lions"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield": ["Homicide Investigator", "Mountain", "Mountain", "Clue"] }, {} ]
  }
 },
 {
  "name": "opponent's creature dying does not trigger it",
