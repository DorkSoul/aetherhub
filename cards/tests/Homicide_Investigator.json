   { "hand": ["Shock"], "battlefield": ["Homicide Investigator", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Shock", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield": ["Homicide Investigator", "Mountain"] }, { "graveyard": ["Grizzly Bears"] } ]
  }
 },
 {
  "name": "ruling: Homicide Investigator itself dying makes a Clue",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Homicide Investigator", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Shock", "targets": ["Homicide Investigator"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Clue"], "graveyard": ["Shock", "Homicide Investigator"] }, {} ]
