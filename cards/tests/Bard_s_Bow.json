[
  {
    "name": "ETB creates a 1/1 Hero and attaches to it",
    "players": [
      { "hand": ["Bard's Bow"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Bard's Bow" },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Bard's Bow": "Hero" },
      "pt": { "Hero": [3, 3] },
      "keywords": { "Hero": ["Reach"] },
      "players": [
        { "battlefield_has": ["Hero", "Bard's Bow"] },
        {}
      ]
    }
  },
  {
    "name": "equip {6} moves it to another creature",
    "players": [
      { "battlefield": ["Bard's Bow", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Bard's Bow", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Bard's Bow": "Grizzly Bears" },
      "pt": { "Grizzly Bears": [4, 4] }
    }
  },
  {
    "name": "the Hero is a Bard in addition to its other types",
    "players": [
      { "hand": ["Bard's Bow"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Bard's Bow" },
      { "resolve": true }
    ],
    "expect": {
      "subtypes": { "Hero": ["Bard"] },
      "players": [{ "battlefield_has": ["Hero", "Bard's Bow"] }, {}]
    }
  },
  {
    "name": "equipping a creature makes it a Bard too, keeping its own type",
    "players": [
      { "battlefield": ["Bard's Bow", "Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Bard's Bow", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "subtypes": { "Grizzly Bears": ["Bard", "Bear"] }
    }
  },
  {
    "name": "ruling: destroying the Hero token leaves the Equipment on the battlefield",
    "players": [
      { "hand": ["Bard's Bow", "Lightning Bolt"], "battlefield": ["Forest", "Forest", "Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Bard's Bow" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hero"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt"], "battlefield_has": ["Bard's Bow"] }, {}]
    }
  },
  {
    "name": "ruling: paying equip {6} moves the Equipment from the Hero token to another creature",
    "players": [
      { "hand": ["Bard's Bow"], "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Bard's Bow" },
      { "resolve": true },
      { "activate": "Bard's Bow", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Bard's Bow": "Grizzly Bears" },
      "keywords": { "Grizzly Bears": ["Reach"] },
      "players": [{}, {}]
    }
  }
]
