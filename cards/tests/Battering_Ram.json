[
  {
    "name": "destroys the Wall that blocks it at end of combat",
    "players": [
      {
        "battlefield": [
          { "name": "Battering Ram", "sick": false }
        ]
      },
      {
        "battlefield": ["Wall of Frost"]
      }
    ],
    "steps": [
      {
        "attack": [
          { "card": "Battering Ram", "at": "p1" }
        ]
      },
      {
        "block": [
          { "blocker": "Wall of Frost", "attacker": "Battering Ram" }
        ]
      },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": [], "graveyard": ["Wall of Frost"] }
      ]
    }
  },
  {
    "name": "a blocker that is not a Wall is not destroyed",
    "players": [
      {
        "battlefield": [
          { "name": "Battering Ram", "sick": false }
        ]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      {
        "attack": [
          { "card": "Battering Ram", "at": "p1" }
        ]
      },
      {
        "block": [
          { "blocker": "Hill Giant", "attacker": "Battering Ram" }
        ]
      },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "an unblocked Ram does not destroy anything",
    "players": [
      {
        "battlefield": [
          { "name": "Battering Ram", "sick": false }
        ]
      },
      {
        "battlefield": ["Wall of Frost"]
      }
    ],
    "steps": [
      {
        "attack": [
          { "card": "Battering Ram", "at": "p1" }
        ]
      },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": ["Wall of Frost"], "life": 19 }
      ]
    }
  },
  {
    "name": "ruling: a band blocked by one creature is blocked as a whole, so the Ram deals no damage to the player",
    "players": [
      {
        "battlefield": [
          { "name": "Battering Ram", "sick": false },
          { "name": "Grizzly Bears", "sick": false }
        ]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      {
        "attack": [
          { "card": "Battering Ram", "at": "p1", "band": 1 },
          { "card": "Grizzly Bears", "at": "p1", "band": 1 }
        ]
      },
      {
        "block": [
          { "blocker": "Hill Giant", "attacker": "Grizzly Bears" }
        ]
      },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 }
      ]
    }
  }
]
