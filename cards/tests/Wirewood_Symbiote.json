 {
  "name": "ruling: the Elf is the cost, so killing the Symbiote in response does not stop the untap",
  "players": [
   {
    "battlefield": [
     "Wirewood Symbiote",
     "Wirewood Elf",
     {
      "name": "Hill Giant",
      "tapped": true
     }
    ]
   },
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Mountain"]
   }
  ],
  "steps": [
   { "activate": "Wirewood Symbiote", "targets": ["Hill Giant"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Wirewood Symbiote"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Wirewood Elf"], "graveyard_has": ["Wirewood Symbiote"], "battlefield_has": ["Hill Giant"] },
    { "graveyard": ["Lightning Bolt"] }
   ],
   "tapped": { "Hill Giant": false }
  }
 },
 {
  "name": "ruling: the untap target need not be tapped (untapped Hill Giant is a legal target)",
  "players": [
   { "battlefield": ["Wirewood Symbiote", "Wirewood Elf", "Hill Giant"] },
   {}
  ],
  "steps": [
   { "activate": "Wirewood Symbiote", "targets": ["Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Wirewood Elf"], "battlefield_has": ["Wirewood Symbiote", "Hill Giant"] },
    {}
   ],
   "tapped": { "Hill Giant": false }
  }
 }
]