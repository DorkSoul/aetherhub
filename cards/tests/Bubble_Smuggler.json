[
  {
    "name": "turned face up gets four +1/+1 counters",
    "players": [{ "hand": ["Bubble Smuggler"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [
      { "cast": "Bubble Smuggler", "alt": 254 },
      { "resolve": true },
      { "activate": "Bubble Smuggler", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [{}, {}], "pt": { "Bubble Smuggler": [6, 5] }, "counters": { "Bubble Smuggler": { "p1p1": 4 } } }
  },
  {
    "name": "face down it is a 2/2 without abilities",
    "players": [{ "hand": ["Bubble Smuggler"], "battlefield": ["Island", "Island", "Island"] }, {}],
    "steps": [{ "cast": "Bubble Smuggler", "alt": 254 }, { "resolve": true }],
    "expect": { "players": [{}, {}], "pt": { "Bubble Smuggler": [2, 2] } }
  },
  {
    "name": "cannot be turned face up without the disguise cost",
    "players": [{ "hand": ["Bubble Smuggler"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [
      { "cast": "Bubble Smuggler", "alt": 254 },
      { "resolve": true },
      { "activate": "Bubble Smuggler", "ability": 0, "illegal": true }
    ],
    "expect": { "players": [{}, {}], "pt": { "Bubble Smuggler": [2, 2] } }
  },
  {
    "name": "ruling: a face-down permanent has ward {2}, so an unpaid Bolt is countered",
    "players": [
      { "battlefield": [{ "name": "Bubble Smuggler", "face_down": true }] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Bubble Smuggler"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Bubble Smuggler"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: a face-down permanent has ward {2}; paying it lets the Bolt kill the 2/2",
    "players": [
      { "battlefield": [{ "name": "Bubble Smuggler", "face_down": true }] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Bubble Smuggler"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Bubble Smuggler"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a face-down permanent that dies is revealed as its real card",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Bubble Smuggler", "face_down": true }] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Bubble Smuggler"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Bubble Smuggler"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: turning a permanent face up does not change whether it is tapped",
    "players": [
      { "battlefield": [{ "name": "Bubble Smuggler", "face_down": true, "tapped": true }, "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Bubble Smuggler", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Bubble Smuggler": [6, 5] },
      "tapped": { "Bubble Smuggler": true }
    }
  },
  {
    "name": "ruling: a face-down spell cannot be turned face up (only a face-down permanent can)",
    "players": [
      { "hand": ["Bubble Smuggler"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Bubble Smuggler", "alt": 254 },
      { "activate": "Bubble Smuggler", "ability": 0, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "pt": { "Bubble Smuggler": [2, 2] }
    }
  }
