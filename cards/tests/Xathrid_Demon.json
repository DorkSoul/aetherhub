[
  {
    "name": "upkeep: sacrifice another creature and each opponent loses life equal to its power",
    "players": [
      {
        "battlefield": [
          "Xathrid Demon",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Draw"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Xathrid Demon"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "no other creature: tap it and you lose 7 life",
    "players": [
      {
        "battlefield": [
          "Xathrid Demon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Draw"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 13,
          "battlefield_has": [
            "Xathrid Demon"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: two Demons both trigger; the second Demon's trigger sacrifices the first, so each opponent loses 7 twice",
    "players": [ { "battlefield": ["Xathrid Demon", "Xathrid Demon"] }, {} ],
    "steps": [ { "advance_to": "Draw" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Xathrid Demon", "Xathrid Demon"] }, { "life": 6 } ] }
  },
  {
    "name": "ruling: with another creature to sacrifice you must sacrifice it and do not lose 7 life",
    "players": [ { "battlefield": ["Xathrid Demon", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "Draw" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Grizzly Bears"], "battlefield_has": ["Xathrid Demon"] }, { "life": 18 } ] }
  }
]
