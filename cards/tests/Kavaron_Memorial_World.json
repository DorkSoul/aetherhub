[
  {
    "name": "station taps another creature and adds charge counters equal to its power",
    "players": [
      { "battlefield": ["Kavaron, Memorial World", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Kavaron, Memorial World", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Kavaron, Memorial World": false },
      "counters": { "Kavaron, Memorial World": { "charge": 2 } }
    }
  },
  {
    "name": "station needs another untapped creature to tap",
    "players": [
      { "battlefield": ["Kavaron, Memorial World", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Kavaron, Memorial World", "ability": 0, "illegal": true }
    ],
    "expect": {
      "counters": { "Kavaron, Memorial World": { "charge": 0 } }
    }
  },
  {
    "name": "12+ ability makes a Robot and pumps and hastes your creatures until end of turn",
    "players": [
      {
        "battlefield": [
          { "name": "Kavaron, Memorial World", "counters": { "charge": 12 } },
          "Mountain",
          "Forest",
          "Swamp",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      { "activate": "Kavaron, Memorial World", "ability": 1, "answers": ["Swamp"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Kavaron, Memorial World": true },
      "pt": { "Grizzly Bears": [3, 2] },
      "keywords": { "Grizzly Bears": ["Haste"] },
      "players": [
        { "battlefield_has": ["Robot 2-2"], "battlefield_lacks": ["Swamp"] }
      ]
    }
  },
  {
    "name": "12+ ability is not available with 11 charge counters",
    "players": [
      {
        "battlefield": [
          { "name": "Kavaron, Memorial World", "counters": { "charge": 11 } },
          "Mountain",
          "Forest",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      { "activate": "Kavaron, Memorial World", "ability": 1, "illegal": true }
    ],
    "expect": {
      "tapped": { "Kavaron, Memorial World": false }
    }
  },
  {
    "name": "enters tapped when played as a land",
    "players": [ { "hand": ["Kavaron, Memorial World"] }, {} ],
    "steps": [ { "play_land": "Kavaron, Memorial World" } ],
    "expect": { "tapped": { "Kavaron, Memorial World": true } }
  }
]
