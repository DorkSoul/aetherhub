[
  {
    "name": "its controller (the caster) sacrifices a land when it becomes a target",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Mountain", { "name": "Lava Runner" }] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Lava Runner"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Mountain"], "battlefield_lacks": ["Mountain"] }, { "battlefield_has": ["Mountain"], "graveyard_has": ["Lava Runner"] } ] }
  },
  {
    "name": "targeting a player does not trigger it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Mountain", { "name": "Lava Runner" }] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mountain"] }, { "battlefield_has": ["Mountain", "Lava Runner"] } ] }
  }
]
