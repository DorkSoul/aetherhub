  { "name": "ruling: fewer than five cards: you see what is there and still get the shuffle option", "players": [ { "hand": ["Visions"], "battlefield": ["Plains"] }, { "library": ["Island", "Swamp", "Forest"] } ], "steps": [ { "cast": "Visions", "targets": ["p1"] }, { "resolve": true, "answers": [true] } ], "expect": { "players": [ { "graveyard": ["Visions"] }, { "library_count": 3 } ] } },
  { "name": "ruling: fewer than five cards: declining the shuffle is not a draw", "players": [ { "hand": ["Visions"], "battlefield": ["Plains"] }, { "library": ["Island", "Swamp", "Forest"] } ], "steps": [ { "cast": "Visions", "targets": ["p1"] }, { "resolve": true, "answers": [false] } ], "expect": { "players": [ { "graveyard": ["Visions"] }, { "library_count": 3, "hand_count": 0 } ] } }
