  {
    "name": "ruling: a Wasteland can destroy it because it is nonbasic",
    "players": [
      { "battlefield": ["Wasteland"] },
      { "battlefield": ["Bayou"] }
    ],
    "steps": [
      { "activate": "Wasteland", "targets": ["Bayou"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard_has": ["Bayou"] } ]
    }
  },
  {
    "name": "ruling: a Forest search finds it because it has the Forest type",
    "players": [
      {
        "hand": ["Nature's Lore"],
        "battlefield": ["Forest", "Forest"],
        "library": ["Bayou", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Nature's Lore" },
      { "resolve": true, "answers": ["Bayou"] }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Bayou"], "graveyard_has": ["Nature's Lore"] } ]
    }
  },
  {
    "name": "ruling: it has the Swamp type's B mana ability",
    "players": [ { "battlefield": ["Bayou"] }, {} ],
    "steps": [ { "tap_for_mana": "Bayou", "ability": 0 } ],
    "expect": { "players": [ { "pool": { "B": 1 } } ] }
  },
  {
    "name": "ruling: it has the Forest type's G mana ability",
    "players": [ { "battlefield": ["Bayou"] }, {} ],
    "steps": [ { "tap_for_mana": "Bayou", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 1 } } ] }
  }
