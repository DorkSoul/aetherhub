[
  {
    "name": "a tapped Bodyguard does not redirect: the player takes the damage",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Veteran Bodyguard",
            "tapped": true
          }
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17,
          "battlefield_has": [
            "Veteran Bodyguard"
          ]
        }
      ]
    }
  },
  {
    "name": "a blocked attacker's damage is not redirected (Bodyguard blocks it)",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Veteran Bodyguard"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Veteran Bodyguard",
            "attacker": "Hill Giant"
          }
        ]
      },
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 20,
          "battlefield_has": [
            "Veteran Bodyguard"
          ]
        }
      ]
    }
  },
  {
    "name": "untapped Bodyguard takes the damage an unblocked attacker deals to you",
    "players": [ { "battlefield": ["Hill Giant"] }, { "battlefield": ["Veteran Bodyguard"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20, "battlefield_has": ["Veteran Bodyguard"] } ] }
  },
  {
    "name": "ruling: a blocking untapped Bodyguard still takes damage from unblocked attackers",
    "players": [ { "battlefield": ["Hill Giant", "Grizzly Bears"] }, { "battlefield": ["Veteran Bodyguard"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Veteran Bodyguard", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20, "graveyard_has": ["Veteran Bodyguard"] } ] }
  }
]