[
  {"name": "no party: at the beginning of combat creatures you control get +1/+0",
    "players": [
      {"battlefield": [{"name": "The Destined Warrior", "sick": false}, "Grizzly Bears"]},
      {}
    ],
    "steps": [
      {"advance_to": "BeginCombat"},
      {"resolve": true}
    ],
    "expect": {
      "pt": {"The Destined Warrior": [4, 3], "Grizzly Bears": [3, 2]}
    }
  },
  {"name": "full party: at the beginning of combat creatures you control get +3/+0",
    "players": [
      {"battlefield": [{"name": "The Destined Warrior", "sick": false}, "The Destined Black Mage", "Aether Theorist", "Abuna Acolyte"]},
      {}
    ],
    "steps": [
      {"advance_to": "BeginCombat"},
      {"resolve": true}
    ],
    "expect": {
      "pt": {"The Destined Warrior": [6, 3], "Abuna Acolyte": [4, 1]}
    }
  },
  {"name": "a Warrior spell costs {1} less",
    "players": [
      {"hand": ["Grotag Bug-Catcher"], "battlefield": ["Mountain", "The Destined Warrior"]},
      {}
    ],
    "steps": [
      {"cast": "Grotag Bug-Catcher"},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"battlefield_has": ["The Destined Warrior", "Grotag Bug-Catcher"], "hand_count": 0}, {}]
    }
  },
  {"name": "a non-Cleric/Rogue/Warrior/Wizard spell does not get the reduction",
    "players": [
      {"hand": ["Grizzly Bears"], "battlefield": ["Forest", "The Destined Warrior"]},
      {}
    ],
    "steps": [
      {"cast": "Grizzly Bears", "illegal": true}
    ],
    "expect": {
      "players": [{"hand": ["Grizzly Bears"], "battlefield_has": ["The Destined Warrior"]}, {}]
    }
  },
  {"name": "ruling: a party of three is not a full party: creatures get only +1/+0",
    "players": [
      {"battlefield": [{"name": "The Destined Warrior", "sick": false}, "The Destined Black Mage", "Abuna Acolyte"]},
      {}
    ],
    "steps": [
      {"advance_to": "BeginCombat"},
      {"resolve": true}
    ],
    "expect": {
      "pt": {"The Destined Warrior": [4, 3], "Abuna Acolyte": [2, 1]}
    }
  },
  {"name": "ruling: the reduction only pays generic mana: two Islands cannot cast a Warrior with {R} in its cost",
    "players": [
      {"hand": ["Death-Greeter's Champion"], "battlefield": ["The Destined Warrior", "Island", "Island"]},
      {}
    ],
    "steps": [
      {"cast": "Death-Greeter's Champion", "illegal": true}
    ],
    "expect": {
      "players": [{"hand": ["Death-Greeter's Champion"], "battlefield_has": ["The Destined Warrior"]}, {}]
    }
  },
  {"name": "ruling: with a red source the reduced Warrior cost {1}{R} is payable",
    "players": [
      {"hand": ["Death-Greeter's Champion"], "battlefield": ["The Destined Warrior", "Island", "Mountain"]},
      {}
    ],
    "steps": [
      {"cast": "Death-Greeter's Champion"},
      {"resolve": true, "targets": ["The Destined Warrior"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"battlefield_has": ["The Destined Warrior", "Death-Greeter's Champion"], "hand_count": 0}, {}]
    }
  }
]
