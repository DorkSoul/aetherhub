[
  {
    "name": "the creature the defending player chooses must block",
    "players": [ { "battlefield": ["Crashing Boars"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Crashing Boars", "at": "p1" } ] },
      { "resolve": true, "answers": ["Grizzly Bears"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"], "life": 20 } ] }
  },
  {
    "name": "a tapped creature cannot be chosen, so the lone untapped one must block",
    "players": [ { "battlefield": ["Crashing Boars"] }, { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }, "Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Crashing Boars", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Hill Giant"], "life": 20 } ] }
  },
  {
    "name": "no untapped creature to choose: the attack is unblocked",
    "players": [ { "battlefield": ["Crashing Boars"] }, { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] } ],
    "steps": [
      { "attack": [ { "card": "Crashing Boars", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "ruling: the chosen creature tapped before blocks is not forced to block",
    "players": [ { "hand": ["Frost Breath"], "battlefield": ["Crashing Boars", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Crashing Boars", "at": "p1" } ] },
      { "resolve": true },
      { "cast": "Frost Breath", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16, "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: with no creature to choose the trigger does nothing (not optional) and the attack is unblocked",
    "players": [ { "battlefield": ["Crashing Boars"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Crashing Boars", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  }
]
