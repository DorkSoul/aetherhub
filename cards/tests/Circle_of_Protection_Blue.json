              { "block": [] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "ruling: activating before any damage still prevents the next blue damage this turn",
   "players": [ { "battlefield": ["Merfolk of the Pearl Trident"] },
                { "battlefield": ["Circle of Protection: Blue", "Plains"] } ],
   "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" },
