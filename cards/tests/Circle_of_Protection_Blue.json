 { "name": "ruling: a blue spell on the stack is a legal source; Psionic Blast's 4 damage is prevented, its 2 to its controller is not",
   "players": [ { "hand": ["Psionic Blast"], "battlefield": ["Island", "Island", "Island"] },
                { "battlefield": ["Circle of Protection: Blue", "Plains"] } ],
   "steps": [ { "cast": "Psionic Blast", "targets": ["p1"] },
