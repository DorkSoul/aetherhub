[
  {
    "name": "controller taps a Forest and adds one more G",
    "players": [
      { "battlefield": ["Heartbeat of Spring", "Forest"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Forest" }
    ],
    "expect": {
      "players": [
        { "pool": { "G": 2 } },
        {}
      ],
      "tapped": { "Forest": true }
    }
  },
  {
    "name": "opponent taps an Island and adds one more U to their own pool",
    "players": [
      { "battlefield": ["Heartbeat of Spring", "Forest"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "pass": true },
      { "tap_for_mana": "Island", "player": 1, "color": "U" }
    ],
    "expect": {
      "players": [
        {},
        { "pool": { "U": 2 } }
      ],
      "tapped": { "Island": true }
    }
  },
  {
    "name": "a creature's mana ability does not trigger it",
    "players": [
      {
        "battlefield": [
          "Heartbeat of Spring",
          { "name": "Llanowar Elves", "sick": false }
        ]
      },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Llanowar Elves" }
    ],
    "expect": {
      "players": [
        { "pool": { "G": 1 } },
        {}
      ],
      "tapped": { "Llanowar Elves": true }
    }
  },
  { "name": "tapping a Forest adds one extra green mana for its controller",
    "players": [ { "battlefield": ["Heartbeat of Spring", "Forest"] }, {} ],
    "steps": [ { "tap_for_mana": "Forest" } ],
    "expect": { "players": [ { "pool": { "G": 2 } }, {} ] } },
  { "name": "opponent tapping a Forest gives the opponent the extra mana, not you",
    "players": [ { "battlefield": ["Heartbeat of Spring"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "pass": true }, { "tap_for_mana": "Forest", "player": 1 } ],
    "expect": { "players": [ { "pool": {} }, { "pool": { "G": 2 } } ] } },
  { "name": "ruling: colourless land gives one extra colourless (C is a type)",
    "players": [ { "battlefield": ["Heartbeat of Spring", "Wastes"] }, {} ],
    "steps": [ { "tap_for_mana": "Wastes" } ],
    "expect": { "players": [ { "pool": { "C": 2 } }, {} ], "tapped": { "Wastes": true } } },
  { "name": "ruling: a land tapped for two mana adds only one extra mana of the type it produced",
    "players": [ { "battlefield": ["Heartbeat of Spring", "Ancient Tomb"] }, {} ],
    "steps": [ { "tap_for_mana": "Ancient Tomb" } ],
    "expect": { "players": [ { "pool": { "C": 3 }, "life": 18 }, {} ] } }
]
