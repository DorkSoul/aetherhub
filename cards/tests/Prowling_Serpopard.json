[
  { "name": "its own spell can't be countered",
    "players": [ { "hand": ["Prowling Serpopard"], "battlefield": ["Forest", "Forest", "Forest"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Prowling Serpopard" },
               { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Prowling Serpopard" } ] },
               { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Prowling Serpopard"] }, { "graveyard_has": ["Counterspell"] } ] } },
  { "name": "other creature spells you control can't be countered",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Prowling Serpopard", "Forest", "Forest"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Grizzly Bears" },
               { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ] },
               { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Counterspell"] } ] } },
  { "name": "non-creature spells can still be countered",
    "players": [ { "hand": ["Divination"], "battlefield": ["Prowling Serpopard", "Island", "Island", "Island"] },
                 { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Divination" },
               { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Divination" } ] },
               { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Divination"] }, { "graveyard_has": ["Counterspell"] } ] } },
  { "name": "ruling: a counter may target a creature spell you control; it isn't countered, the counter still resolves",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Prowling Serpopard", "Forest", "Forest"] },
                 { "hand": ["Mana Drain"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Grizzly Bears" },
               { "cast": "Mana Drain", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ] },
               { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Mana Drain"] } ] } }
]
