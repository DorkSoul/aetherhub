[
 {
  "name": "Curry Favor drains by the number of Knights you control",
  "players": [{ "hand": ["Smitten Swordmaster // Curry Favor"], "battlefield": ["Swamp", "Smitten Swordmaster // Curry Favor"] }, {}],
  "steps": [{ "cast": "Smitten Swordmaster // Curry Favor", "face": true }, { "resolve": true }],
  "expect": { "players": [{ "life": 21, "exile": ["Smitten Swordmaster // Curry Favor"] }, { "life": 19 }] }
 },
 {
  "name": "no Knights: Curry Favor does not change life totals",
  "players": [{ "hand": ["Smitten Swordmaster // Curry Favor"], "battlefield": ["Swamp"] }, {}],
  "steps": [{ "cast": "Smitten Swordmaster // Curry Favor", "face": true }, { "resolve": true }],
  "expect": { "players": [{ "life": 20 }, { "life": 20 }] }
 },
 {
  "name": "ruling: a resolved Adventure is exiled and its creature half can then be cast from exile",
  "players": [{ "hand": ["Smitten Swordmaster // Curry Favor"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, {}],
  "steps": [{ "cast": "Smitten Swordmaster // Curry Favor", "face": true }, { "resolve": true }, { "cast": "Smitten Swordmaster // Curry Favor" }, { "resolve": true }],
  "expect": { "players": [{ "battlefield_has": ["Smitten Swordmaster // Curry Favor"], "exile": [] }, {}], "pt": { "Smitten Swordmaster // Curry Favor": [2, 1] } }
 },
 {
  "name": "ruling: a countered Adventure goes to the graveyard, so the creature cannot be cast from exile later",
  "players": [{ "hand": ["Smitten Swordmaster // Curry Favor"], "battlefield": ["Swamp"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }],
  "steps": [{ "cast": "Smitten Swordmaster // Curry Favor", "face": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Curry Favor" }] }, { "resolve": true }],
  "expect": { "players": [{ "graveyard": ["Smitten Swordmaster // Curry Favor"], "exile": [] }, { "graveyard": ["Counterspell"] }] }
 },
 {
  "name": "ruling: an Adventure card in the graveyard is a creature card, so Mystic Sanctuary can only target the Bolt",
  "players": [{ "hand": ["Mystic Sanctuary"], "battlefield": ["Island", "Island", "Island"], "graveyard": ["Smitten Swordmaster // Curry Favor", "Lightning Bolt"] }, {}],
  "steps": [{ "play_land": "Mystic Sanctuary" }, { "resolve": true, "answers": [true] }],
  "expect": { "players": [{ "graveyard": ["Smitten Swordmaster // Curry Favor"], "library_top": ["Lightning Bolt"], "battlefield_has": ["Mystic Sanctuary"] }, {}] }
 }
]
