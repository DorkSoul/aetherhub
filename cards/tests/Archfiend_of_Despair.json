[
  {
    "name": "end step: each opponent loses life equal to the life lost this turn",
    "players": [
      { "hand": ["Assault"], "battlefield": ["Archfiend of Despair", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Assault", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Archfiend of Despair"] },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "end step: no life lost this turn means no life lost",
    "players": [
      { "battlefield": ["Archfiend of Despair"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 }
      ]
    }
  },
  {
    "name": "opponent's lifegain is prevented (Lightning Helix)",
    "players": [ { "battlefield": ["Archfiend of Despair"] }, { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Helix", "player": 1, "targets": ["p0"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "life": 17 }, { "life": 20 } ] }
  },
  {
    "name": "ruling: only life lost counts; the controller's own gain (Lightning Helix) does not change the amount",
    "players": [
      { "hand": ["Lightning Helix"], "battlefield": ["Archfiend of Despair", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Helix", "targets": ["p1"] },
      { "resolve": true, "auto": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 23 }, { "life": 14 } ]
    }
  },
  {
    "name": "ruling: two Archfiends; the second trigger counts the life lost by the first (3 then 6)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Archfiend of Despair", "Archfiend of Despair", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 8 } ]
    }
  }
]
