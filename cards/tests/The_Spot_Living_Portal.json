[
  {
    "name": "ETB exiles an opposing nonland permanent and a permanent card from a graveyard",
    "players": [
      { "hand": ["The Spot, Living Portal"], "battlefield": ["Plains", "Plains", "Plains", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"], "graveyard": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "The Spot, Living Portal" },
      { "resolve": true, "targets": ["Grizzly Bears", "Hill Giant"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["The Spot, Living Portal"] },
        { "exile": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "dies: The Spot goes to the bottom of the library and the exiled cards return to their owners' hands",
    "players": [
      { "hand": ["The Spot, Living Portal", "Murder"], "battlefield": ["Plains", "Plains", "Plains", "Swamp", "Swamp", "Swamp", "Swamp", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"], "graveyard": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "The Spot, Living Portal" },
      { "resolve": true, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "cast": "Murder", "targets": ["The Spot, Living Portal"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Murder"] },
        { "hand": ["Grizzly Bears", "Hill Giant"], "exile": [] }
      ]
    }
  },
  {
    "name": "dies with no targets chosen: nothing returns to hand",
    "players": [
      { "hand": ["The Spot, Living Portal", "Murder"], "battlefield": ["Plains", "Plains", "Plains", "Swamp", "Swamp", "Swamp", "Swamp", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "The Spot, Living Portal" },
      { "resolve": true },
      { "cast": "Murder", "targets": ["The Spot, Living Portal"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Murder"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a nontoken The Spot that dies returns the exiled cards to their owners' hands",
    "players": [
      {
        "hand": ["The Spot, Living Portal", "Skulltap"],
        "battlefield": ["Plains", "Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Grizzly Bears"]
      },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "The Spot, Living Portal" },
      { "resolve": true, "targets": ["Llanowar Elves", "Grizzly Bears"] },
      { "cast": "Skulltap" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3, "battlefield_lacks": ["The Spot, Living Portal"] },
        { "hand_count": 1, "battlefield_lacks": ["Llanowar Elves"] }
      ]
    }
  }
]
