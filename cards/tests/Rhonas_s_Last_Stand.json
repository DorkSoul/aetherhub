   "steps": [
     {"cast": "Rhonas's Last Stand"},
     {"resolve": true},
     {"advance_to": "Main1"},
     {"advance_to": "Main1"},
     {"advance_to": "Main1"},
     {"advance_to": "Main1"}],
   "expect": {"tapped": {"Forest": false}}},
  {"name": "a land played after the spell is also locked for your next untap step",
   "players": [{"hand": ["Rhonas's Last Stand", "Island"], "battlefield": ["Forest", "Forest"]}, {}],
   "steps": [
     {"cast": "Rhonas's Last Stand"},
     {"resolve": true},
     {"play_land": "Island"},
     {"tap_for_mana": "Island"},
     {"advance_to": "Main1"},
     {"advance_to": "Main1"}],
   "expect": {"tapped": {"Island": true}}},
  {"name": "ruling: two of these lock lands only through one untap step, then they untap",
   "players": [{"hand": ["Rhonas's Last Stand", "Rhonas's Last Stand"], "battlefield": ["Forest", "Forest", "Forest", "Forest"]}, {}],
   "steps": [
     {"cast": "Rhonas's Last Stand"},
     {"resolve": true},
     {"cast": "Rhonas's Last Stand"},
     {"resolve": true},
     {"advance_to": "Main1"},
     {"advance_to": "Main1"},
     {"advance_to": "Main1"},
     {"advance_to": "Main1"}],
   "expect": {"players": [{"battlefield_has": ["Snake 5-4 Green", "Snake 5-4 Green"]}, {}], "tapped": {"Forest": false}}},
  {"name": "ruling: a land untapped as the spell resolves stays tapped through the next untap step once tapped",
   "players": [{"hand": ["Rhonas's Last Stand"], "battlefield": ["Forest", "Forest", "Island"]}, {}],
   "steps": [
     {"cast": "Rhonas's Last Stand"},
     {"resolve": true},
