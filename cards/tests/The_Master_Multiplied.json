[
  { "name": "the legend rule doesn't apply to a token copy of The Master, and the end-step sacrifice can't take it",
    "players": [ { "hand": ["Molten Duplication"], "battlefield": ["Mountain", "Mountain", "The Master, Multiplied"] }, {} ],
    "steps": [ { "cast": "Molten Duplication", "targets": ["The Master, Multiplied"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard": ["Molten Duplication"], "battlefield": ["Mountain", "Mountain", "The Master, Multiplied", "The Master, Multiplied"] }, {} ] } },
  { "name": "the exile at the beginning of the end step can't take a creature token you control",
    "players": [ { "hand": ["Heat Shimmer"], "battlefield": ["Mountain", "Mountain", "Mountain", "The Master, Multiplied", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Heat Shimmer", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Mountain", "Mountain", "Mountain", "The Master, Multiplied", "Grizzly Bears", "Grizzly Bears"] }, {} ] } },
  { "name": "tokens its controller doesn't have The Master for are still exiled",
    "players": [ { "battlefield": ["The Master, Multiplied"] }, { "hand": ["Heat Shimmer"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Main1" }, { "cast": "Heat Shimmer", "player": 1, "targets": ["p1:Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["The Master, Multiplied"] }, { "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] } ] } },
  { "name": "without The Master the end-step sacrifice takes the token",
    "players": [ { "hand": ["Molten Duplication"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Molten Duplication", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a token copy does not copy tapped status or counters",
    "players": [ { "hand": ["Molten Duplication", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Mulldrifter", "tapped": true, "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "cast": "Molten Duplication", "targets": ["Mulldrifter"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Mulldrifter"] }, { "resolve": true } ],
    "expect": { "pt": { "Mulldrifter": [2, 2] }, "tapped": { "Mulldrifter": false }, "counters": { "Mulldrifter": { "p1p1": 0 } }, "players": [ { "graveyard_has": ["Lightning Bolt"], "battlefield_has": ["Mulldrifter"] }, {} ] } },
  { "name": "ruling: a token copy's enters-the-battlefield ability triggers (Mulldrifter draws two)",
    "players": [ { "hand": ["Molten Duplication"], "battlefield": ["Mountain", "Mountain", "Mulldrifter"] }, {} ],
    "steps": [ { "cast": "Molten Duplication", "targets": ["Mulldrifter"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "battlefield_has": ["Mulldrifter", "Mulldrifter"] }, {} ] } },
  { "name": "ruling: choosing Time Lord with And They Shall Know No Fear affects The Master, Multiplied",
    "players": [ { "hand": ["And They Shall Know No Fear"], "battlefield": ["Plains", "Plains", "The Master, Multiplied"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "And They Shall Know No Fear" }, { "resolve": true, "answers": ["Time Lord"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["The Master, Multiplied"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["The Master, Multiplied"], "graveyard": ["And They Shall Know No Fear"] }, { "graveyard": ["Lightning Bolt"] } ], "pt": { "The Master, Multiplied": [5, 3] } } },
  { "name": "ruling: in a two-player game myriad makes no tokens (no other opponent to attack)",
    "players": [ { "battlefield": ["The Master, Multiplied"] }, {} ],
    "steps": [ { "attack": [ { "card": "The Master, Multiplied", "at": "p1" } ] }, { "resolve": true, "answers": [true] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield": ["The Master, Multiplied"] }, { "life": 16 } ] } }
]
