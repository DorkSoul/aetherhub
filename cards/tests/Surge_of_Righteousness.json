[
  { "name": "destroys an attacking black creature and gains 2 life",
    "players": [ { "hand": ["Surge of Righteousness"], "battlefield": ["Muck Rats", "Plains", "Plains"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Muck Rats", "at": "p1" } ] }, { "block": [] },
      { "cast": "Surge of Righteousness", "targets": ["Muck Rats"] }, { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22, "graveyard_has": ["Muck Rats", "Surge of Righteousness"] }, {} ] } },
  { "name": "a black creature that is not attacking or blocking is not a legal target",
    "players": [ { "hand": ["Surge of Righteousness"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Muck Rats"] } ],
    "steps": [ { "cast": "Surge of Righteousness", "targets": ["Muck Rats"], "illegal": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Muck Rats"], "life": 20 } ] } },
  { "name": "ruling: still gains 2 life when the creature survives (indestructible from Accursed Horde)",
    "players": [ { "hand": ["Surge of Righteousness"], "battlefield": ["Accursed Horde", "Plains", "Plains", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Accursed Horde", "at": "p1" } ] }, { "block": [] },
      { "cast": "Surge of Righteousness", "targets": ["Accursed Horde"] },
      { "activate": "Accursed Horde", "ability": 0, "targets": ["Accursed Horde"] },
      { "pass": true }, { "pass": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22, "battlefield_has": ["Accursed Horde"], "graveyard_has": ["Surge of Righteousness"] }, {} ] } },
  { "name": "ruling: if the target becomes illegal before it resolves, no life is gained",
    "players": [ { "hand": ["Surge of Righteousness"], "battlefield": ["Muck Rats", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "attack": [ { "card": "Muck Rats", "at": "p1" } ] }, { "block": [] },
      { "cast": "Surge of Righteousness", "targets": ["Muck Rats"] },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Muck Rats"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Muck Rats", "Surge of Righteousness"] }, { "graveyard_has": ["Lightning Bolt"] } ] } }
]
