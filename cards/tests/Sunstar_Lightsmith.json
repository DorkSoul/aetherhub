[
  { "name": "second spell each turn: +1/+1 counter and draw a card",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Sunstar Lightsmith", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Sunstar Lightsmith": [4, 4] }, "players": [ { "hand": ["Plains"] }, { "life": 14 } ] } },
  { "name": "the first spell of the turn does nothing",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Sunstar Lightsmith", "Mountain", "Mountain"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "pt": { "Sunstar Lightsmith": [3, 3] }, "players": [ { "hand": [] }, { "life": 17 } ] } },
  { "name": "ruling: the first spell of the turn counts, so casting Sunstar first makes the next spell the second",
    "players": [ { "hand": ["Sunstar Lightsmith", "Lightning Bolt"], "battlefield": ["Plains", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Plains"] }, {} ],
    "steps": [ { "cast": "Sunstar Lightsmith" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "pt": { "Sunstar Lightsmith": [4, 4] }, "players": [ { "hand": ["Plains"] }, { "life": 17 } ] } },
  { "name": "ruling: the trigger resolves even though the second spell is countered",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Sunstar Lightsmith", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }], "player": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Sunstar Lightsmith": [4, 4] }, "players": [ { "hand": ["Plains"], "graveyard": ["Lightning Bolt", "Lightning Bolt"] }, { "life": 17, "graveyard": ["Counterspell"] } ] } }
]
