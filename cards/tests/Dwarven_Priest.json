[
  {
    "name": "gains 1 life for each creature you control, counting itself",
    "players": [ { "hand": ["Dwarven Priest"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Dwarven Priest" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 21 }, {} ] }
  },
  {
    "name": "counts the other creatures you control",
    "players": [ { "hand": ["Dwarven Priest"], "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Dwarven Priest" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22 }, {} ] }
  },
  {
    "name": "ruling: creatures are counted on resolution, so one killed in response is not counted",
    "players": [
      { "hand": ["Dwarven Priest"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Dwarven Priest" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ] }
  }
]
