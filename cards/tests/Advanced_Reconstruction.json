[
  {"name": "first main phase: mill a card, then exile a random card from the graveyard",
   "start": "Upkeep",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 1}}], "library": ["Forest", "Mountain"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"resolve": true}],
   "expect": {"players": [{"exile": ["Forest"], "graveyard": []}, {}]}},
  {"name": "level 2: cards leaving your graveyard deal 2 damage to each opponent (the exiled card leaving counts)",
   "start": "Upkeep",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 2}}], "library": ["Forest", "Mountain"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"resolve": true}],
   "expect": {"players": [{"exile": ["Forest"]}, {"life": 18}]}},
   {"name": "level 1: no damage when a card leaves the graveyard",
   "start": "Upkeep",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 1}}], "library": ["Forest", "Mountain"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"resolve": true}],
   "expect": {"players": [{"exile": ["Forest"]}, {"life": 20}]}},
  {"name": "level 3: spells cast from exile cost {2} less (the exiled Grizzly Bears costs only {G})",
   "start": "Upkeep",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 3}}, "Forest"], "library": ["Grizzly Bears"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"resolve": true}, {"cast": "Grizzly Bears"}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Grizzly Bears"], "exile": []}, {}]}},
  {"name": "level 3: a spell cast from hand still costs full (one Forest is not enough for Grizzly Bears)",
   "players": [{"hand": ["Grizzly Bears"], "battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 3}}, "Forest"]}, {}],
   "steps": [{"cast": "Grizzly Bears", "illegal": true}],
   "expect": {"players": [{"hand": ["Grizzly Bears"]}, {}]}},
  {"name": "level 2 then level 3: each {1}{R} level-up adds one level at sorcery speed",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 1}}, "Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [
     {"activate": "Advanced Reconstruction", "ability": 0}, {"resolve": true},
     {"activate": "Advanced Reconstruction", "ability": 1}, {"resolve": true}
   ],
   "expect": {"players": [{}, {}], "counters": {"Advanced Reconstruction": {"level": 3}}}},
  {"name": "level 2 costs {1}{R} only at level 1: a level-2 Class can't gain level 2 again",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 2}}, "Mountain", "Mountain"]}, {}],
   "steps": [{"activate": "Advanced Reconstruction", "ability": 0, "illegal": true}],
   "expect": {"players": [{}, {}], "counters": {"Advanced Reconstruction": {"level": 2}}}},
  {"name": "level 3 needs level 2 first: at level 1 the level 3 ability is illegal",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 1}}, "Mountain", "Mountain"]}, {}],
   "steps": [{"activate": "Advanced Reconstruction", "ability": 1, "illegal": true}],
   "expect": {"players": [{}, {}], "counters": {"Advanced Reconstruction": {"level": 1}}}},
  {"name": "enters with one level counter",
   "players": [{"hand": ["Advanced Reconstruction"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]}, {}],
   "steps": [{"cast": "Advanced Reconstruction"}, {"resolve": true}],
   "expect": {"counters": {"Advanced Reconstruction": {"level": 1}}}},
  {"name": "ruling: mana value comes from the mana cost, not the reduced cost (Serra Angel cast from exile for {1}{W}{W} is still MV 5 for Rush of Knowledge: draws 5)",
   "players": [{"hand": ["Rush of Knowledge"], "battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 3}}, "Plains", "Plains", "Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Serra Angel"]}, {}],
   "start": "Upkeep",
   "steps": [{"advance_to": "Main1"}, {"resolve": true}, {"cast": "Serra Angel"}, {"resolve": true}, {"cast": "Rush of Knowledge"}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Serra Angel"], "exile": [], "hand_count": 5}, {}]}},
  {"name": "ruling: an exiled land is played under normal timing: once a land is played this turn, the exiled Forest is not playable",
   "start": "Upkeep",
   "players": [{"hand": ["Island"], "battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 1}}], "library": ["Forest", "Mountain"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"resolve": true}, {"play_land": "Island"}, {"play_land": "Forest", "illegal": true}],
   "expect": {"players": [{"exile": ["Forest"], "battlefield_lacks": ["Forest"], "battlefield_has": ["Island"]}, {}]}},
  {"name": "ruling: an exiled land can be played in the main phase while the land drop is unused",
   "start": "Upkeep",
   "players": [{"battlefield": [{"name": "Advanced Reconstruction", "counters": {"level": 1}}], "library": ["Forest", "Mountain"]}, {}],
   "steps": [{"advance_to": "Main1"}, {"resolve": true}, {"play_land": "Forest"}],
   "expect": {"players": [{"battlefield_has": ["Forest"], "exile": []}, {}]}}
]
