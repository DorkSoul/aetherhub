[
  { "name": "enters and the Ring tempts you; end step counter goes on a creature after a permanent you controlled left the battlefield",
    "players": [ { "hand": ["Shortcut to Mushrooms", "Lightning Bolt"], "battlefield": ["Forest", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Shortcut to Mushrooms" }, { "resolve": true, "answers": [0] },
               { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "pt": { "Hill Giant": [4, 4] }, "players": [ { "command": ["The Ring 1"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, {} ] } },
  { "name": "no permanent left the battlefield this turn: no end step counter",
    "players": [ { "battlefield": ["Forest", "Shortcut to Mushrooms", "Hill Giant"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "pt": { "Hill Giant": [3, 3] }, "players": [ {}, {} ] } },
  { "name": "ruling: the Ring tempts you with no creature, so the emblem is still created",
    "players": [ { "hand": ["Shortcut to Mushrooms"], "battlefield": ["Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Shortcut to Mushrooms" }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 1"] }, {} ] } },
  { "name": "ruling: a second Ring tempt keeps a single emblem and advances it",
    "players": [ { "hand": ["Shortcut to Mushrooms", "Shortcut to Mushrooms"], "battlefield": ["Forest", "Mountain", "Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Shortcut to Mushrooms" }, { "resolve": true }, { "cast": "Shortcut to Mushrooms" }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 2"] }, {} ] } },
  { "name": "ruling: several permanents leaving this turn still give only one end step counter",
    "players": [ { "hand": ["Shortcut to Mushrooms", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Forest", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant", "Serra Angel"] }, {} ],
    "steps": [ { "cast": "Shortcut to Mushrooms" }, { "resolve": true, "answers": [0] },
               { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true },
               { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "pt": { "Serra Angel": [5, 5] }, "players": [ { "graveyard_has": ["Grizzly Bears", "Hill Giant"] }, {} ] } },
  { "name": "ruling: a permanent that left before Shortcut was cast still gives the end step counter",
    "players": [ { "hand": ["Lightning Bolt", "Shortcut to Mushrooms"], "battlefield": ["Forest", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Serra Angel"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "advance_to": "Main2" },
               { "cast": "Shortcut to Mushrooms" }, { "resolve": true },
               { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "pt": { "Serra Angel": [5, 5] }, "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ] } }
]
