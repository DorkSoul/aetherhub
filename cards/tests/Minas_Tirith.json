[
  {
    "name": "enters tapped when you control no legendary creature",
    "players": [ { "hand": ["Minas Tirith"], "battlefield": ["Grizzly Bears"] }, {} ],
    "steps": [ { "play_land": "Minas Tirith" } ],
    "expect": { "tapped": { "Minas Tirith": true } }
  },
  {
    "name": "enters untapped when you control a legendary creature",
    "players": [ { "hand": ["Minas Tirith"], "battlefield": ["Gandalf the White"] }, {} ],
    "steps": [ { "play_land": "Minas Tirith" } ],
    "expect": { "tapped": { "Minas Tirith": false } }
  },
  {
    "name": "an opponent's legendary creature does not count",
    "players": [ { "hand": ["Minas Tirith"] }, { "battlefield": ["Gandalf the White"] } ],
    "steps": [ { "play_land": "Minas Tirith" } ],
    "expect": { "tapped": { "Minas Tirith": true } }
  },
  {
    "name": "draws a card after attacking with two creatures",
    "players": [
      { "battlefield": ["Minas Tirith", "Plains", "Plains", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Minas Tirith", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 } ],
      "tapped": { "Minas Tirith": true }
    }
  },
  {
    "name": "cannot draw after attacking with only one creature",
    "players": [
      { "battlefield": ["Minas Tirith", "Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Minas Tirith", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 } ]
    }
  },
  {
    "name": "ruling: a legendary creature still in hand does not count",
    "players": [ { "hand": ["Minas Tirith", "Gandalf the White"] }, {} ],
    "steps": [ { "play_land": "Minas Tirith" } ],
    "expect": { "tapped": { "Minas Tirith": true } }
  }
]
