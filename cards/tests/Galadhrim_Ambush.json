[
  { "name": "makes a token per attacker and prevents only non-Elf combat damage",
    "players": [ { "hand": ["Galadhrim Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears", "Llanowar Elves"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" } ] },
               { "cast": "Galadhrim Ambush" },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Elf Warrior", "Elf Warrior"] }, { "life": 19 } ] } },
  { "name": "a lone non-Elf attacker deals no combat damage, one token",
    "players": [ { "hand": ["Galadhrim Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "cast": "Galadhrim Ambush" },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Elf Warrior"] }, { "life": 20 } ] } },
  { "name": "ruling: attacking creatures count whatever they attack, including a planeswalker",
    "players": [ { "hand": ["Galadhrim Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears", "Hill Giant"] }, { "battlefield": ["Liliana of the Veil"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "Liliana of the Veil" }, { "card": "Hill Giant", "at": "p1" } ] },
               { "cast": "Galadhrim Ambush" },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Elf Warrior", "Elf Warrior"] }, { "life": 20 } ] } },
  { "name": "ruling: creatures attacking you on the opponent's turn count when Galadhrim Ambush is cast",
    "players": [ { "hand": ["Galadhrim Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "advance_to": "Main2" },
               { "advance_to": "Main1" },
               { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
               { "pass": true, "player": 1 },
               { "cast": "Galadhrim Ambush" },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Elf Warrior", "Elf Warrior"], "life": 20 }, {} ] } }
]
