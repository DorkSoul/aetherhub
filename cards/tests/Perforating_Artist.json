[
  {
    "name": "after attacking, opponent with nothing to sacrifice or discard loses 3 life at your end step",
    "players": [
      { "battlefield": ["Perforating Artist", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 15 } ]
    }
  },
  {
    "name": "no attack this turn: no raid trigger",
    "players": [
      { "battlefield": ["Perforating Artist"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: a creature cast after combat still lets raid trigger at your end step",
    "players": [
      { "hand": ["Perforating Artist"], "battlefield": ["Grizzly Bears", "Swamp", "Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Perforating Artist" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Perforating Artist"] }, { "life": 15 } ]
    }
  },
  {
    "name": "ruling: the attacking creature dying before the end step does not stop raid",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Perforating Artist", "Grizzly Bears", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "life": 15 } ]
    }
  }
]
