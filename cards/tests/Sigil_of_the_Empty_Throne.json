 {
  "name": "ruling: the Angel is created even when the enchantment spell is countered",
  "players": [
   { "hand": ["Pacifism"], "battlefield": ["Sigil of the Empty Throne", "Plains", "Plains"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
