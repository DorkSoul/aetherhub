 {
  "name": "ruling: the first-spell draw still happens when that spell is countered",
  "players": [
   {
    "hand": ["Grizzly Bears", "Counterspell"],
    "battlefield": ["Forest", "Forest", "Island", "Island"]
   },
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Wavebreak Hippocamp", "Mountain"]
   }
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
   { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears"], "life": 20 },
    { "hand_count": 1, "graveyard": ["Lightning Bolt"], "life": 20 }
   ]
  }
 },
 {
  "name": "ruling: a spell cast while Wavebreak Hippocamp is still in hand does not trigger",
  "players": [
   {
    "hand": ["Grizzly Bears"],
    "battlefield": ["Forest", "Forest"]
   },
   {
    "hand": ["Lightning Bolt", "Wavebreak Hippocamp"],
    "battlefield": ["Mountain"]
   }
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 17 },
    { "hand": ["Wavebreak Hippocamp"] }
   ]
  }
 }
]