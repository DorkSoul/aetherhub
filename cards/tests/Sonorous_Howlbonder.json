[
  {
    "name": "menace creature you control can't be blocked by only two creatures",
    "players": [
      { "battlefield": ["Sonorous Howlbonder"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Sonorous Howlbonder", "at": "p1" } ] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Sonorous Howlbonder" },
          { "blocker": "Hill Giant", "attacker": "Sonorous Howlbonder" }
        ],
        "illegal": true
      }
    ],
    "expect": { "players": [ { "battlefield": ["Sonorous Howlbonder"] }, {} ] }
  },
  {
    "name": "menace creature you control can be blocked by three creatures",
    "players": [
      { "battlefield": ["Sonorous Howlbonder"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant", "Serra Angel"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Sonorous Howlbonder", "at": "p1" } ] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Sonorous Howlbonder" },
          { "blocker": "Hill Giant", "attacker": "Sonorous Howlbonder" },
          { "blocker": "Serra Angel", "attacker": "Sonorous Howlbonder" }
        ]
      },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Sonorous Howlbonder"] }, {} ] }
  },
  {
    "name": "a non-menace creature can still be blocked by one creature",
    "players": [
      { "battlefield": ["Sonorous Howlbonder", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ] }
  },
  {
    "name": "two blockers on a menace attacker are illegal: Howlbonder is unblocked, Hill Giant too",
    "players": [
      { "battlefield": ["Sonorous Howlbonder", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [ { "card": "Sonorous Howlbonder", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Sonorous Howlbonder" },
          { "blocker": "Llanowar Elves", "attacker": "Sonorous Howlbonder" }
        ]
      },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 15 } ] }
  }
]
