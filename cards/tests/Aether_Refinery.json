[
  { "name": "tap: get energy (doubled), then pay some to make an X/X Aetherborn",
    "players": [ { "battlefield": ["Aether Refinery"] }, {} ],
    "steps": [
      { "activate": "Aether Refinery" },
      { "resolve": true, "answers": [true, 2] }
    ],
    "expect": { "players": [ { "energy": 0, "battlefield_has": ["Aetherborn 0-0 Black"] }, {} ] } },
  { "name": "tap: may decline to pay energy, no token",
    "players": [ { "battlefield": ["Aether Refinery"] }, {} ],
    "steps": [
      { "activate": "Aether Refinery" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "players": [ { "energy": 2, "battlefield_lacks": ["Aetherborn 0-0 Black"] }, {} ] } },
  { "name": "ruling: unpaid energy stays with the player into later turns (it is not mana)",
    "players": [ { "battlefield": ["Aether Refinery"] }, {} ],
    "steps": [
      { "activate": "Aether Refinery" },
      { "resolve": true, "answers": [true, 1] },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "advance_to": "Main1" }
    ],
    "expect": { "players": [ { "energy": 1 }, {} ] } },
  { "name": "ruling: with two Aether Refineries one tap gives four energy, so paying all four makes a 4/4",
    "players": [ { "battlefield": ["Aether Refinery", "Aether Refinery"] }, {} ],
    "steps": [
      { "activate": "Aether Refinery" },
      { "resolve": true, "answers": [true, 4] }
    ],
    "expect": { "players": [ { "energy": 0, "battlefield_has": ["Aetherborn 0-0 Black"] }, {} ], "pt": { "Aetherborn 0-0 Black": [4, 4] } } },
  { "name": "ruling: with three Aether Refineries one tap gives eight energy",
    "players": [ { "battlefield": ["Aether Refinery", "Aether Refinery", "Aether Refinery"] }, {} ],
    "steps": [
      { "activate": "Aether Refinery" },
      { "resolve": true, "answers": [true, 8] }
    ],
    "expect": { "players": [ { "energy": 0, "battlefield_has": ["Aetherborn 0-0 Black"] }, {} ], "pt": { "Aetherborn 0-0 Black": [8, 8] } } }
]
