    "steps": [ { "cast": "Heal", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
