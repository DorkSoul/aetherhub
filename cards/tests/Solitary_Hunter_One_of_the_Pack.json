[
  {
    "name": "no spells last turn transforms it at the next upkeep",
    "players": [
      {
        "battlefield": [
          "Solitary Hunter"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "pt": {
        "One of the Pack": [
          5,
          6
        ]
      }
    }
  },
  {
    "name": "a spell cast last turn stops the transformation",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Solitary Hunter"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "pt": {
        "Solitary Hunter": [
          3,
          4
        ]
      }
    }
  },
  {
    "name": "two spells cast last turn: One of the Pack transforms back at the next upkeep",
    "players": [
      { "battlefield": ["Solitary Hunter"] },
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" }, { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 }, { "resolve": true },
      { "advance_to": "Upkeep" }, { "resolve": true }
    ],
    "expect": { "pt": { "Solitary Hunter": [3, 4] } }
  },
  {
    "name": "only one spell cast last turn: One of the Pack stays transformed",
    "players": [
      { "battlefield": ["Solitary Hunter"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" }, { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 }, { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "pt": { "One of the Pack": [5, 6] } }
  }
]
