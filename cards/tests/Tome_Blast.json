[
  {
    "name": "from hand: 2 damage to target player",
    "players": [ { "hand": ["Tome Blast"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Tome Blast", "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "graveyard": ["Tome Blast"] }, { "life": 18 } ]
    }
  },
  {
    "name": "flashback {4}{R} from the graveyard, then exiled",
    "players": [ { "graveyard": ["Tome Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Tome Blast", "alt": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": {
      "players": [ { "exile": ["Tome Blast"], "graveyard": [] }, { "life": 18 } ]
    }
  },
  {
    "name": "flashback needs {4}{R}: four lands are not enough",
    "players": [ { "graveyard": ["Tome Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Tome Blast", "alt": 0, "targets": ["p1"], "illegal": true } ],
    "expect": {
      "players": [ { "graveyard": ["Tome Blast"] }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: flashback is sorcery speed, so it cannot be cast while another spell is on the stack",
    "players": [ { "hand": ["Lightning Bolt"], "graveyard": ["Tome Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "cast": "Tome Blast", "alt": 0, "targets": ["p1"], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Lightning Bolt", "Tome Blast"] }, { "graveyard": ["Grizzly Bears"] } ] }
  }
]
