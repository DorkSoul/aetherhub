[
 { "name": "a Sliver's combat damage to a creature destroys it, even though the damage would not kill it",
   "players": [
     { "battlefield": ["Toxin Sliver"] },
     { "battlefield": ["Craw Wurm"] }
   ],
   "steps": [
     { "attack": [ { "card": "Toxin Sliver", "at": "p1" } ] },
     { "block": [ { "blocker": "Craw Wurm", "attacker": "Toxin Sliver" } ] },
     { "advance_to": "Main2" }
   ],
   "expect": { "players": [ { "graveyard": ["Toxin Sliver"] }, { "graveyard": ["Craw Wurm"] } ] } },
 { "name": "a non-Sliver's combat damage does not destroy the blocker",
   "players": [
     { "battlefield": ["Toxin Sliver", "Grizzly Bears"] },
     { "battlefield": ["Craw Wurm"] }
   ],
   "steps": [
     { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
     { "block": [ { "blocker": "Craw Wurm", "attacker": "Grizzly Bears" } ] },
     { "advance_to": "Main2" }
   ],
   "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Toxin Sliver"] }, { "battlefield": ["Craw Wurm"] } ] } },
 { "name": "damage dealt to a player does not trigger it",
   "players": [
     { "battlefield": ["Toxin Sliver"] },
     {}
   ],
   "steps": [
     { "attack": [ { "card": "Toxin Sliver", "at": "p1" } ] },
     { "block": [] },
     { "advance_to": "Main2" }
   ],
   "expect": { "players": [ { "battlefield_has": ["Toxin Sliver"] }, { "life": 17 } ] } },
 { "name": "ruling: power/toughness boosts from several Sliver lords are cumulative",
   "players": [ { "battlefield": ["Toxin Sliver", "Muscle Sliver", "Megantic Sliver"] }, {} ],
   "steps": [],
   "expect": { "players": [ { "battlefield_has": ["Toxin Sliver", "Muscle Sliver", "Megantic Sliver"] }, {} ], "pt": { "Toxin Sliver": [7, 7] } } },
 { "name": "ruling: an Oni-possessed Toxin Sliver is no longer a Sliver, so its own trigger does not destroy the creature it damages",
   "players": [ { "hand": ["Oni Possession"], "battlefield": ["Toxin Sliver", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Wall of Stone"] } ],
   "steps": [
     { "cast": "Oni Possession", "targets": ["Toxin Sliver"] },
     { "resolve": true },
     { "attack": [ { "card": "Toxin Sliver", "at": "p1" } ] },
     { "block": [ { "blocker": "Wall of Stone", "attacker": "Toxin Sliver" } ] },
     { "advance_to": "Main2" }
   ],
   "expect": { "players": [ { "battlefield_has": ["Toxin Sliver", "Oni Possession"] }, { "battlefield_has": ["Wall of Stone"] } ], "pt": { "Toxin Sliver": [6, 6] }, "subtypes": { "Toxin Sliver": ["Demon", "Spirit"] } } },
 { "name": "ruling: the Demon-Toxin's ability still destroys a creature dealt combat damage by another Sliver",
   "players": [ { "hand": ["Oni Possession"], "battlefield": ["Toxin Sliver", "Muscle Sliver", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Craw Wurm"] } ],
   "steps": [
     { "cast": "Oni Possession", "targets": ["Toxin Sliver"] },
     { "resolve": true },
     { "attack": [ { "card": "Muscle Sliver", "at": "p1" } ] },
     { "block": [ { "blocker": "Craw Wurm", "attacker": "Muscle Sliver" } ] },
     { "advance_to": "Main2" }
   ],
   "expect": { "players": [ { "battlefield_has": ["Toxin Sliver"] }, { "graveyard_has": ["Craw Wurm"], "battlefield_lacks": ["Craw Wurm"] } ] } }
]
