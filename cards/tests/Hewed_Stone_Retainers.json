[
  { "name": "cannot be cast unless another spell was cast this turn",
    "players": [ { "hand": ["Hewed Stone Retainers"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Hewed Stone Retainers", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Hewed Stone Retainers"] }, {} ] } },
  { "name": "castable after casting another spell this turn",
    "players": [ { "hand": ["Lightning Bolt", "Hewed Stone Retainers"], "battlefield": ["Mountain", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Hewed Stone Retainers" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hewed Stone Retainers"], "graveyard": ["Lightning Bolt"] }, {} ] } },
  { "name": "ruling: a countered spell still counts as cast this turn",
    "players": [ { "hand": ["Lightning Bolt", "Hewed Stone Retainers"], "battlefield": ["Mountain", "Plains", "Plains", "Plains"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }], "player": 1 }, { "resolve": true }, { "cast": "Hewed Stone Retainers" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hewed Stone Retainers"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Counterspell"], "life": 20 } ] } }
]
