   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Scrapdiver Serpent",
      "at": "p1"
     }
    ]
   },
   {
    "block": [
     {
      "blocker": "Grizzly Bears",
      "attacker": "Scrapdiver Serpent"
     }
    ]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 20
    }
   ]
  }
 },
 {
  "name": "defending player controls an artifact: the Serpent's block is dropped, the other block happens",
  "players": [
   { "battlefield": ["Scrapdiver Serpent", "Grizzly Bears"] },
   { "battlefield": ["Sol Ring", "Hill Giant", "Savannah Lions"] }
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Scrapdiver Serpent", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Scrapdiver Serpent" }, { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 15 } ] }
 },
 {
  "name": "defending player has no artifact: the Serpent can be blocked",
  "players": [
   { "battlefield": ["Scrapdiver Serpent", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant", "Savannah Lions"] }
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Scrapdiver Serpent", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Scrapdiver Serpent" }, { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 20 } ] }
 },
 {
  "name": "an artifact you control (the attacker) does not count: the Serpent can be blocked",
  "players": [
   { "battlefield": ["Scrapdiver Serpent", "Grizzly Bears", "Sol Ring"] },
   { "battlefield": ["Hill Giant", "Savannah Lions"] }
  ],
  "steps": [
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Scrapdiver Serpent", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Scrapdiver Serpent" }, { "blocker": "Savannah Lions", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 20 } ] }
 }
