[
 {
  "name": "can't be blocked when the defending player meets the condition",
  "players": [
   {
    "battlefield": [
     "Scrapdiver Serpent"
    ]
   },
   {
    "battlefield": [
     "Sol Ring",
     "Grizzly Bears"
    ]
   }
  ],
