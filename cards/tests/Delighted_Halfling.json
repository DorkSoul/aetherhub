[
  {
    "name": "legendary spell paid with the restricted mana can't be countered",
    "players": [
      { "hand": ["Aang, A Lot to Learn"], "battlefield": ["Delighted Halfling", "Forest", "Forest"] },
      { "hand": ["Abjure"], "battlefield": ["Island", "Air Elemental"] }
    ],
    "steps": [
      { "cast": "Aang, A Lot to Learn" },
      { "pass": true },
      { "cast": "Abjure", "player": 1, "targets": [{ "stack": "Aang, A Lot to Learn" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Aang, A Lot to Learn"] }, { "graveyard_has": ["Abjure", "Air Elemental"] }]
    }
  },
  {
    "name": "the restricted mana cannot pay for a non-legendary creature",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Delighted Halfling"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "ruling: a legendary copy made by Twincast can still be countered",
    "players": [
      { "hand": ["Urza's Ruinous Blast", "Twincast"], "battlefield": ["Aang, A Lot to Learn", "Delighted Halfling", "Forest", "Plains", "Mountain", "Swamp", "Island", "Island", "Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "tap_for_mana": "Plains" },
      { "tap_for_mana": "Forest" },
      { "tap_for_mana": "Mountain" },
      { "tap_for_mana": "Swamp" },
      { "cast": "Urza's Ruinous Blast" },
      { "cast": "Twincast", "targets": [{ "stack": "Urza's Ruinous Blast" }] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Urza's Ruinous Blast" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Aang, A Lot to Learn"], "graveyard_has": ["Twincast", "Urza's Ruinous Blast"] }, { "graveyard_has": ["Counterspell"] }]
    }
  }
]
