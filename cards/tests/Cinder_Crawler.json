[
  { "name": "once blocked, {R} gives +1/+0 until end of turn",
    "players": [
      { "battlefield": ["Cinder Crawler", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Cinder Crawler", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Cinder Crawler" } ] },
      { "activate": "Cinder Crawler" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Cinder Crawler": [2, 2] } } },
  { "name": "cannot be activated when it is unblocked",
    "players": [
      { "battlefield": ["Cinder Crawler", "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Cinder Crawler", "at": "p1" } ] },
      { "block": [] },
      { "activate": "Cinder Crawler", "illegal": true }
    ],
    "expect": { "pt": { "Cinder Crawler": [1, 2] } } },
  { "name": "cannot be activated outside combat, even with mana available",
    "players": [
      { "battlefield": ["Cinder Crawler", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Cinder Crawler", "illegal": true }
    ],
    "expect": { "pt": { "Cinder Crawler": [1, 2] } } }
]
