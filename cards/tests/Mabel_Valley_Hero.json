[
  { "name": "puts a counter on itself when it enters",
    "players": [ { "hand": ["Mabel, Valley Hero"], "battlefield": ["Mountain", "Plains", "Forest"] }, {} ],
    "steps": [ { "cast": "Mabel, Valley Hero" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Mabel, Valley Hero": [2, 3] }, "counters": { "Mabel, Valley Hero": { "p1p1": 1 } } } },
  { "name": "counter goes on a creature that entered this turn, not an older one",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Mabel, Valley Hero", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3], "Mabel, Valley Hero": [1, 2] }, "counters": { "Grizzly Bears": { "p1p1": 1 } } } }
]
