[
  {
    "name": "upkeep adds a time counter; creatures get +1/+0 for each counter",
    "players": [ { "battlefield": [ { "name": "Infinite Hourglass", "counters": { "time": 2 } }, "Grizzly Bears" ] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": {
      "counters": { "Infinite Hourglass": { "time": 3 } },
      "pt": { "Grizzly Bears": [5, 2] }
    }
  },
  {
    "name": "the opponent may pay {3} in an upkeep to remove a time counter",
    "players": [ { "battlefield": [ { "name": "Infinite Hourglass", "counters": { "time": 2 } } ] }, { "battlefield": ["Plains", "Plains", "Plains"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "pass": true }, { "activate": "Infinite Hourglass", "player": 1 }, { "resolve": true } ],
    "expect": { "counters": { "Infinite Hourglass": { "time": 2 } } }
  },
  {
    "name": "outside an upkeep step the {3} ability can't be activated, even by the opponent",
    "players": [ { "battlefield": [ { "name": "Infinite Hourglass", "counters": { "time": 2 } } ] }, { "battlefield": ["Plains", "Plains", "Plains"] } ],
    "steps": [ { "pass": true }, { "activate": "Infinite Hourglass", "player": 1, "illegal": true } ],
    "expect": { "counters": { "Infinite Hourglass": { "time": 2 } } }
  }
]
