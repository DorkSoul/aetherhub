    "expect": { "players": [ { "graveyard": ["Fork", "Officious Interrogation"], "battlefield": ["Plains", "Plains", "Island", "Island", "Mountain", "Mountain", "Grizzly Bears", "Clue", "Clue", "Clue", "Clue", "Clue", "Clue"] }, {} ] } },
  { "name": "ruling: a target that became illegal (hexproof from Blossoming Calm) is not counted; only the other target's creatures make Clues",
