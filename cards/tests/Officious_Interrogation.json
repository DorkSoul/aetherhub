    "steps": [ { "cast": "Officious Interrogation", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Officious Interrogation"], "battlefield": ["Plains","Island","Grizzly Bears","Clue","Clue"] }, {} ] } },
