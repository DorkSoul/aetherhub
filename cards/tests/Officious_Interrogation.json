  { "name": "strive: a second target costs WU more, so four lands pay for one cast and a second cast is impossible",
    "players": [ { "hand": ["Officious Interrogation", "Officious Interrogation"], "battlefield": ["Plains", "Island", "Plains", "Island", "Grizzly Bears"] },
