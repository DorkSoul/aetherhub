      "counters": { "Grizzly Bears": { "stun": 2 } }
    }
  },
  {
    "name": "ETB cannot target a creature you control: no counters on it",
    "players": [
      { "hand": ["T'Pol, Vulcan Representative"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "T'Pol, Vulcan Representative" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["T'Pol, Vulcan Representative", "Grizzly Bears"] }, {} ],
      "tapped": { "Grizzly Bears": false },
      "counters": { "Grizzly Bears": {} }
    }
  }
]
