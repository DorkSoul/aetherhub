[
  {
    "name": "ETB taps an opposing creature and puts two stun counters on it",
    "players": [
      { "hand": ["T'Pol, Vulcan Representative"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "T'Pol, Vulcan Representative" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["T'Pol, Vulcan Representative"] }, { "battlefield_has": ["Grizzly Bears"] } ],
