[
  {
    "name": "ETB puts the target graveyard card on the bottom of its owner's library",
    "players": [
      { "hand": ["Swiftgear Drake"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Swiftgear Drake" },
      { "resolve": true, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swiftgear Drake"] },
        { "graveyard": [], "library_count": 21 }
      ]
    }
  },
  {
    "name": "up to one: choosing no target leaves the graveyard alone",
    "players": [
      { "hand": ["Swiftgear Drake"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Swiftgear Drake" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Swiftgear Drake"] },
        { "graveyard": ["Grizzly Bears"], "library_count": 20 }
      ],
      "keywords": { "Swiftgear Drake": ["Flying", "Haste"] }
    }
  }
]
