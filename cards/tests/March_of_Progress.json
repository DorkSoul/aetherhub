[
  {
    "name": "copies target artifact creature you control",
    "players": [
      {
        "hand": ["March of Progress"],
        "battlefield": ["Island", "Island", "Island", "Aesthir Glider"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "March of Progress", "targets": ["Aesthir Glider"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["March of Progress"],
          "battlefield": ["Island", "Island", "Island", "Aesthir Glider", "Aesthir Glider"]
        },
        {
          "battlefield": ["Grizzly Bears"]
        }
      ]
    }
  },
  {
    "name": "target must be an artifact creature you control",
    "players": [
      {
        "hand": ["March of Progress"],
        "battlefield": ["Island", "Island", "Island", "Grizzly Bears"]
      },
      {
        "battlefield": ["Aesthir Glider"]
      }
    ],
    "steps": [
      { "cast": "March of Progress", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["March of Progress"] },
        { "battlefield": ["Aesthir Glider"] }
      ]
    }
  },
  {
    "name": "overload copies each artifact creature you control and nothing else",
    "players": [
      {
        "hand": ["March of Progress"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Aesthir Glider", "Aesthir Glider", "Grizzly Bears"]
      },
      {
        "battlefield": ["Aesthir Glider"]
      }
    ],
    "steps": [
      { "cast": "March of Progress", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["March of Progress"],
          "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Aesthir Glider", "Aesthir Glider", "Aesthir Glider", "Aesthir Glider", "Grizzly Bears"]
        },
        {
          "battlefield": ["Aesthir Glider"]
        }
      ]
    }
  },
  {
    "name": "ruling: the token copies only printed characteristics; Walking Ballista's X is 0, so the token has no counters and dies",
    "players": [
      {
        "hand": ["March of Progress"],
        "battlefield": ["Island", "Island", "Island", { "name": "Walking Ballista", "counters": { "p1p1": 2 } }]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "March of Progress", "targets": ["Walking Ballista"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["March of Progress"],
          "battlefield": ["Island", "Island", "Island", "Walking Ballista"]
        },
        {
          "battlefield": ["Grizzly Bears"]
        }
      ],
      "counters": { "Walking Ballista": { "p1p1": 2 } }
    }
  },
  {
    "name": "ruling: the copy's enters-the-battlefield ability triggers (Solemn Simulacrum fetches a land)",
    "players": [
      {
        "hand": ["March of Progress"],
        "battlefield": ["Island", "Island", "Island", "Solemn Simulacrum"],
        "library": ["Mountain", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "March of Progress", "targets": ["Solemn Simulacrum"] },
      { "resolve": true, "answers": [true, "Mountain"] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Solemn Simulacrum", "Mountain"],
          "graveyard": ["March of Progress"]
        },
        {}
      ],
      "tapped": { "Mountain": true }
    }
  },
  {
    "name": "ruling: an effect that makes you pay more also applies to the overload cost (Thalia: 8 mana with 8 lands)",
    "players": [
      {
        "hand": ["March of Progress"],
        "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Aesthir Glider"]
      },
      {
        "battlefield": ["Thalia, Guardian of Thraben"]
      }
    ],
    "steps": [
      { "cast": "March of Progress", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["March of Progress"],
          "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Aesthir Glider", "Aesthir Glider"]
        },
        {
          "battlefield": ["Thalia, Guardian of Thraben"]
        }
      ]
    }
  }
]
