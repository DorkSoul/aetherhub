[
  {
    "name": "taps to give target creature you control +2/+0 in main phase before attackers",
    "players": [
      {
        "battlefield": ["Xun Yu, Wei Advisor", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "Xun Yu, Wei Advisor", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2] },
      "tapped": { "Xun Yu, Wei Advisor": true }
    }
  },
  {
    "name": "cannot activate on an opponent's turn",
    "players": [
      {
        "battlefield": ["Xun Yu, Wei Advisor", "Grizzly Bears"]
      },
      {}
    ],
    "start": "End",
    "steps": [
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "activate": "Xun Yu, Wei Advisor", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Xun Yu, Wei Advisor": false }
    }
  },
  {
    "name": "cannot activate after attackers are declared",
    "players": [
      {
        "battlefield": ["Xun Yu, Wei Advisor", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "activate": "Xun Yu, Wei Advisor", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Xun Yu, Wei Advisor": false }
    }
  },
  {
    "name": "ruling: in the additional combat, before its attackers are declared, it can be activated",
    "players": [
      { "battlefield": ["Xun Yu, Wei Advisor", "Grizzly Bears", "Aggravated Assault", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Aggravated Assault" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "activate": "Xun Yu, Wei Advisor", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2] },
      "tapped": { "Xun Yu, Wei Advisor": true }
    }
  },
  {
    "name": "ruling: in the second combat phase of the turn it can't be activated (before its attackers, but after the first combat)",
    "players": [
      { "battlefield": ["Xun Yu, Wei Advisor", "Grizzly Bears", "Aggravated Assault", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Aggravated Assault" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "advance_to": "BeginCombat" },
      { "activate": "Xun Yu, Wei Advisor", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "tapped": { "Xun Yu, Wei Advisor": false }
    }
  }
