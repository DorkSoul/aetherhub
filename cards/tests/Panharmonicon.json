[
  {
    "name": "creature ETB triggers twice",
    "players": [
      {
        "hand": [
          "Wall of Omens"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Panharmonicon"
        ],
        "library": [
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
