        "cast": "Wall of Omens"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "a land entering (not artifact or creature) does not trigger an extra time",
    "players": [
      {
        "hand": [
          "Guildless Commons"
        ],
        "battlefield": [
          "Forest",
          "Mountain",
          "Panharmonicon"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Guildless Commons"
      },
      {
        "resolve": true,
        "answers": [
          "Forest"
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Forest"
          ],
          "battlefield": [
            "Mountain",
            "Panharmonicon",
            "Guildless Commons"
          ]
        }
      ]
    }
  },
  {
    "name": "opponent's permanents are not affected",
    "players": [
      {
        "battlefield": [
          "Panharmonicon"
        ]
      },
      {
        "hand": [
          "Wall of Omens"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ],
        "library": [
          "Forest",
          "Forest",
          "Forest"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1",
        "player": 1
      },
      {
        "cast": "Wall of Omens",
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "ruling: the permanent's own ETB trigger happens twice (Mulldrifter draws four)",
    "players": [
      { "hand": ["Mulldrifter"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Panharmonicon"] },
      {}
    ],
    "steps": [ { "cast": "Mulldrifter" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 4, "battlefield_has": ["Mulldrifter"] }, {} ] }
  },
  {
    "name": "ruling: two Panharmonicons make an ETB trigger happen three times (six cards)",
    "players": [
      { "hand": ["Mulldrifter"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Panharmonicon", "Panharmonicon"] },
      {}
    ],
    "steps": [ { "cast": "Mulldrifter" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 6 }, {} ] }
  },
  {
    "name": "ruling: an opponent's creature entering triggers your Soul Warden twice",
    "players": [
      { "battlefield": ["Soul Warden", "Panharmonicon"] },
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"], "library": ["Forest"] }
    ],
    "steps": [ { "advance_to": "Main1", "player": 1 }, { "cast": "Grizzly Bears", "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22 }, {} ] }
  }
]