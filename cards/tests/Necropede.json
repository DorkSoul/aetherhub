[
  { "name": "dies: may put a -1/-1 counter on target creature",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Necropede", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Necropede"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "counters": { "Grizzly Bears": { "m1m1": 1 } }, "pt": { "Grizzly Bears": [1, 1] }, "players": [ { "graveyard_has": ["Necropede"] }, {} ] } },
  { "name": "dies: declining the may leaves the creature alone",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Necropede", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Necropede"] }, { "resolve": true, "answers": [false] } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "has infect",
    "players": [ { "hand": ["Necropede"], "battlefield": ["Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Necropede" }, { "resolve": true } ],
    "expect": { "keywords": { "Necropede": ["Infect"] }, "pt": { "Necropede": [1, 1] } } },
  { "name": "ruling: infect applies to combat damage dealt to a player as poison counters, not life loss",
    "players": [ { "battlefield": ["Necropede"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Necropede", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20, "poison": 1 } ] } },
  { "name": "ruling: ten poison counters lose the game",
    "players": [ { "battlefield": ["Necropede"] }, { "poison": 9 } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Necropede", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "winner": 0, "players": [ {}, { "poison": 10 } ] } },
  { "name": "ruling: -1/-1 counters from infect damage stay on the creature after the turn ends",
    "players": [ { "battlefield": ["Necropede"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Necropede", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Necropede" } ] }, { "advance_to": "Main2", "answers": [false] }, { "advance_to": "End" }, { "advance_to": "Main1" } ],
    "expect": { "turn": 2, "counters": { "Hill Giant": { "m1m1": 1 } }, "pt": { "Hill Giant": [2, 2] } } },
  { "name": "ruling: infect damage that is prevented gives no poison counters",
    "players": [ { "battlefield": ["Necropede"] }, { "hand": ["Fog"], "battlefield": ["Forest"] } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Necropede", "at": "p1" } ] }, { "pass": true }, { "cast": "Fog", "player": 1 }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20, "poison": 0 } ] } }
]
