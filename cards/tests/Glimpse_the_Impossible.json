[
  {
    "name": "exiled cards can be played this turn; the rest become Spawns at the end step",
    "players": [ { "hand": ["Glimpse the Impossible"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Lightning Bolt", "Island"] }, {} ],
    "steps": [
      { "cast": "Glimpse the Impossible" },
      { "resolve": true },
      { "play_land": "Forest" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Eldrazi Spawn"], "graveyard_has": ["Island"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "cards left in exile at the end step go to the graveyard and make one Spawn each",
    "players": [ { "hand": ["Glimpse the Impossible"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Lightning Bolt", "Island"] }, {} ],
    "steps": [
      { "cast": "Glimpse the Impossible" },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Eldrazi Spawn", "Eldrazi Spawn", "Eldrazi Spawn"], "graveyard_has": ["Forest", "Lightning Bolt", "Island"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a permanent spell cast from exile stays on the battlefield at the end step",
    "players": [ { "hand": ["Glimpse the Impossible"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Forest", "Island"] }, {} ],
    "steps": [
      { "cast": "Glimpse the Impossible" }, { "resolve": true },
      { "play_land": "Forest" },
      { "cast": "Grizzly Bears" }, { "resolve": true },
      { "advance_to": "End" }, { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Eldrazi Spawn"], "graveyard_has": ["Island"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an exiled land can only be played in a main phase",
    "players": [ { "hand": ["Glimpse the Impossible"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Lightning Bolt", "Island"] }, {} ],
    "steps": [
      { "cast": "Glimpse the Impossible" }, { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "play_land": "Forest", "illegal": true },
      { "advance_to": "Main2" },
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Forest"] },
        {}
      ]
    }
  }
]
