[
  {
    "name": "returns all attacking creatures to owners' hands, not non-attackers",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Grizzly Bears",
          "Hill Giant"
        ],
        "hand": [
          "Aetherize"
        ]
      },
      {
        "battlefield": [
          "Savannah Lions"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "cast": "Aetherize"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Hill Giant"
          ],
          "battlefield_lacks": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield": [
            "Savannah Lions"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a creature that attacked is not an attacking creature after combat (cast in Main 2)",
    "players": [
      {
        "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"],
        "hand": ["Aetherize"]
      },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2", "auto": true },
      { "cast": "Aetherize" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an attacking creature stays attacking through the end of combat step",
    "players": [
      {
        "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"],
        "hand": ["Aetherize"]
      },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "EndCombat", "auto": true },
      { "cast": "Aetherize" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] },
        {}
      ]
    }
  }
]