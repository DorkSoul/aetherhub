[
 {
  "name": "taps to make another small creature unblockable",
  "players": [
   {
    "battlefield": [
     "Mountain",
     "Deserter's Disciple",
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Merfolk Looter"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Deserter's Disciple",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Deserter's Disciple": true
   },
   "keywords": {
    "Grizzly Bears": [
     "Unblockable"
    ]
   }
  }
 },
 {
  "name": "a creature with power 3 can't be chosen",
  "players": [
   {
    "battlefield": [
     "Mountain",
     "Deserter's Disciple",
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Deserter's Disciple",
    "targets": [
     "Hill Giant"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Deserter's Disciple": false
   }
  }
 },
 {
  "name": "ruling: ability used after the creature is blocked does not unblock it",
  "players": [ { "battlefield": ["Mountain", "Deserter's Disciple", "Grizzly Bears"] }, { "battlefield": ["Merfolk Looter"] } ],
  "steps": [ { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Merfolk Looter", "attacker": "Grizzly Bears" } ] }, { "activate": "Deserter's Disciple", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 20, "graveyard_has": ["Merfolk Looter"] } ] }
 },
 {
  "name": "ruling: power raised to 5 before the ability resolves: the ability does nothing",
  "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Deserter's Disciple", "Grizzly Bears"] }, {} ],
  "steps": [ { "activate": "Deserter's Disciple", "targets": ["Grizzly Bears"] }, { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ {}, {} ], "keywords": { "Grizzly Bears": [] }, "pt": { "Grizzly Bears": [5, 5] } }
 },
 {
  "name": "ruling: power raised to 5 after the ability resolves: it still can't be blocked",
  "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Deserter's Disciple", "Grizzly Bears"] }, { "battlefield": ["Merfolk Looter"] } ],
  "steps": [ { "activate": "Deserter's Disciple", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 15 } ], "keywords": { "Grizzly Bears": ["Unblockable"] }, "pt": { "Grizzly Bears": [5, 5] } }
 }
]
