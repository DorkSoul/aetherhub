[
  {
    "name": "sacrifice an enchantment to destroy an enchantment",
    "players": [
      { "battlefield": ["Teferi's Care", "Plains"] },
      { "battlefield": ["Tectonic Instability"] }
    ],
    "steps": [
      { "activate": "Teferi's Care", "ability": 0, "targets": ["Tectonic Instability"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Teferi's Care"] }, { "graveyard": ["Tectonic Instability"] } ]
    }
  },
  {
    "name": "counter target enchantment spell",
    "players": [
      { "hand": ["Tectonic Instability"], "battlefield": ["Teferi's Care", "Island", "Island", "Mountain", "Mountain", "Mountain", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Tectonic Instability" },
      { "activate": "Teferi's Care", "ability": 1, "targets": [{ "stack": "Tectonic Instability" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Tectonic Instability"], "battlefield_has": ["Teferi's Care"] }, {} ]
    }
  }
]
