 {
  "name": "dies with counters: every kind of counter goes onto up to one target creature",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     {
      "name": "Scolding Administrator",
      "counters": {
       "vigilance": 1
      }
     },
     "Mountain"
    ]
   },
   {
    "battlefield": [
     {
      "name": "Grizzly Bears",
      "counters": {
       "p1p1": 0
      }
     }
    ]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Scolding Administrator"
    ]
   },
   {
    "resolve": true,
    "answers": [
     [
      "Grizzly Bears"
     ]
    ]
   }
  ],
  "expect": {
   "counters": {
    "Grizzly Bears": {
     "p1p1": 1,
