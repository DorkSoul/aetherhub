 {
  "name": "ruling: repartee resolves before the spell, so the counter is still put on when the Bolt is countered",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Scolding Administrator"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Scolding Administrator"] },
   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Scolding Administrator": { "p1p1": 1 } },
   "players": [
    { "graveyard": ["Lightning Bolt"] },
    { "graveyard": ["Counterspell"] }
   ]
  }
 }
