[
  {
    "name": "costs {2}{U} less after casting an instant this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Stormwing Entity"], "battlefield": ["Mountain", "Island", "Island"], "library": ["Forest", "Plains", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Stormwing Entity" },
      { "resolve": true },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Stormwing Entity"], "graveyard": ["Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "full {3}{U}{U} cost without an instant or sorcery cast this turn",
    "players": [
      { "hand": ["Stormwing Entity"], "battlefield": ["Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Stormwing Entity", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Stormwing Entity"] },
        {}
      ]
    }
  },
  {
    "name": "a creature spell cast this turn does not reduce the cost",
    "players": [
      { "hand": ["Grizzly Bears", "Stormwing Entity"], "battlefield": ["Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Stormwing Entity", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Stormwing Entity"], "battlefield_has": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the cost reduction applies once, not per instant or sorcery cast this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt", "Stormwing Entity"], "battlefield": ["Mountain", "Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Stormwing Entity", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Stormwing Entity"] }, { "life": 14 } ]
    }
  },
  {
    "name": "ruling: after two instants the reduced Stormwing is still castable for two lands",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt", "Stormwing Entity"], "battlefield": ["Mountain", "Mountain", "Island", "Island"], "library": ["Forest", "Plains", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Stormwing Entity" },
      { "resolve": true },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Stormwing Entity"] }, { "life": 14 } ]
    }
  }
]
