[
  {
    "name": "tap and pay 1 to make target player mill three: a creature milled makes one Horror",
    "players": [
      { "battlefield": [ { "name": "Zellix, Sanity Flayer", "sick": false }, "Island" ] },
      { "library": ["Grizzly Bears", "Mountain", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Zellix, Sanity Flayer", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Horror 1-1 Black"] },
        { "graveyard": ["Grizzly Bears", "Mountain", "Hill Giant"], "library_count": 0 }
      ]
    }
  },
  {
    "name": "milling only non-creature cards makes no Horror",
    "players": [
      { "battlefield": [ { "name": "Zellix, Sanity Flayer", "sick": false }, "Island" ] },
      { "library": ["Mountain", "Forest", "Plains"] }
    ],
    "steps": [
      { "activate": "Zellix, Sanity Flayer", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Zellix, Sanity Flayer", "Island"] },
        { "graveyard": ["Mountain", "Forest", "Plains"], "library_count": 0 }
      ]
    }
  },
  {
    "name": "several creatures milled by one mill event make only one Horror",
    "players": [
      { "battlefield": [ { "name": "Zellix, Sanity Flayer", "sick": false }, "Island" ] },
      { "library": ["Grizzly Bears", "Hill Giant", "Gray Ogre"] }
    ],
    "steps": [
      { "activate": "Zellix, Sanity Flayer", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Zellix, Sanity Flayer", "Island", "Horror 1-1 Black"] },
        { "library_count": 0 }
      ]
    }
  }
]
