[
 {
  "name": "unsaddled Newt's combat damage gives an instant in graveyard flashback equal to its mana cost",
  "players": [
   {
    "battlefield": ["Archmage's Newt", "Mountain"],
    "graveyard": ["Lightning Bolt"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Archmage's Newt", "at": "p1" } ] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "alt": 100, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Lightning Bolt"], "exile": ["Lightning Bolt"], "graveyard": [] },
    { "life": 15 }
   ]
  }
 },
 {
  "name": "saddled Newt's combat damage gives flashback {0}",
  "players": [
   {
    "battlefield": ["Archmage's Newt", "Grizzly Bears", "Grizzly Bears"],
    "graveyard": ["Lightning Bolt"]
   },
   {}
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "activate": "Archmage's Newt" },
   { "resolve": true },
   { "attack": [ { "card": "Archmage's Newt", "at": "p1" } ] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "alt": 100, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Lightning Bolt"], "graveyard": [] },
    { "life": 15 }
   ]
  }
 },
 {
  "name": "unsaddled Newt's flashback still costs its mana cost (no Mountain: cannot cast)",
  "players": [
   {
    "battlefield": ["Archmage's Newt"],
    "graveyard": ["Lightning Bolt"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Archmage's Newt", "at": "p1" } ] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "alt": 100, "targets": ["p1"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt"] },
    { "life": 18 }
   ]
  }
 },
 {
  "name": "ruling: a flashback spell that is countered on resolution (its target gone) is still exiled",
  "players": [
   {
    "battlefield": ["Archmage's Newt", "Mountain"],
    "graveyard": ["Lightning Bolt"]
   },
   {
    "hand": ["Shock"],
    "battlefield": ["Mountain", "Mountain", "Grizzly Bears"]
   }
  ],
  "steps": [
   { "attack": [ { "card": "Archmage's Newt", "at": "p1" } ] },
   { "block": [], "player": 1 },
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "alt": 100, "targets": ["Grizzly Bears"] },
   { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Lightning Bolt"], "graveyard": [] },
    { "battlefield_lacks": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: saddle needs other creatures with total power 3; a single power-2 creature cannot saddle Newt",
  "players": [
   {
    "battlefield": ["Archmage's Newt", "Grizzly Bears"],
    "graveyard": ["Lightning Bolt"]
   },
   {}
  ],
  "steps": [
   { "activate": "Archmage's Newt", "ability": 0, "illegal": true }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false },
   "players": [
    { "graveyard": ["Lightning Bolt"], "battlefield_has": ["Archmage's Newt", "Grizzly Bears"] },
    {}
   ]
  }
 },
  {
    "name": "the flashback stays on the chosen card after another spell uses the stored slots",
    "players": [
      { "hand": ["Time and Tide"], "battlefield": ["Archmage's Newt", "Mountain", "Island", "Island"], "graveyard": ["Lightning Bolt"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Archmage's Newt", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "cast": "Time and Tide" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "alt": 100, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "exile": ["Lightning Bolt"], "graveyard": ["Time and Tide"] }, { "life": 15 }]
    }
  }
]
