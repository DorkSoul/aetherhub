[
  { "name": "enchanted creature with vigilance assigns combat damage equal to its toughness",
    "players": [ { "hand": ["Solid Footing"], "battlefield": ["Aerial Responder", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Solid Footing", "targets": ["Aerial Responder"] }, { "resolve": true },
      { "attack": [ { "card": "Aerial Responder", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Aerial Responder": [3, 4] }, "players": [ { "life": 24 }, { "life": 16 } ] } },
  { "name": "enchanted creature without vigilance still assigns combat damage equal to its power",
    "players": [ { "hand": ["Solid Footing"], "battlefield": ["Grizzly Bears", "Plains"] }, {} ],
    "steps": [
      { "cast": "Solid Footing", "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] }, "players": [ {}, { "life": 17 } ] } },
  { "name": "ruling: a bite uses the creature's power (3, not its toughness 4) even with Solid Footing on it",
    "players": [ { "hand": ["Solid Footing", "Mutiny"], "battlefield": ["Plains", "Mountain"] }, { "battlefield": ["Aerial Responder", "Stormcloud Spirit"] } ],
    "steps": [ { "cast": "Solid Footing", "targets": ["Aerial Responder"] }, { "resolve": true },
               { "cast": "Mutiny", "targets": ["Aerial Responder", "Stormcloud Spirit"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Aerial Responder", "Stormcloud Spirit"] } ], "pt": { "Stormcloud Spirit": [4, 4] } } }
]
