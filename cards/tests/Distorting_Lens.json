[
  {
    "name": "tapping targets a creature; it resolves and the Lens is tapped",
    "players": [
      { "battlefield": ["Distorting Lens", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Distorting Lens", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": ["U"] }
    ],
    "expect": {
      "tapped": { "Distorting Lens": true },
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "can target a noncreature permanent such as a land",
    "players": [
      { "battlefield": ["Distorting Lens", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Distorting Lens", "targets": ["Island"] },
      { "resolve": true, "answers": ["G"] }
    ],
    "expect": { "tapped": { "Distorting Lens": true } }
  },
  {
    "name": "a tapped Lens can't be activated again",
    "players": [
      { "battlefield": ["Distorting Lens", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Distorting Lens", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": ["U"] },
      { "activate": "Distorting Lens", "targets": ["Grizzly Bears"], "illegal": true }
    ]
  }
]
