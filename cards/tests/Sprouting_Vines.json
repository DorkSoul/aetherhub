[
  {
    "name": "search for a basic land card into hand",
    "players": [
      { "hand": ["Sprouting Vines"], "battlefield": ["Forest", "Forest", "Island"], "library": ["Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Sprouting Vines" },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [{ "hand": ["Forest"], "library_count": 1 }, {}]
    }
  },
  {
    "name": "storm: the first spell this turn makes no copies",
    "players": [
      { "hand": ["Sprouting Vines"], "battlefield": ["Forest", "Forest", "Island"], "library": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Sprouting Vines" },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, {}]
    }
  },
  {
    "name": "ruling: storm counts an earlier spell this turn, so one copy searches a second time",
    "players": [
      { "hand": ["Lightning Bolt", "Sprouting Vines"], "battlefield": ["Mountain", "Forest", "Island", "Island"], "library": ["Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Sprouting Vines" },
      { "resolve": true, "answers": ["Forest", "Forest"] }
    ],
    "expect": {
      "players": [{ "hand": ["Forest", "Forest"], "library_count": 0 }, { "life": 17 }]
    }
  },
  {
    "name": "ruling: copies are not cast, so a later storm spell counts only spells actually cast",
    "players": [
      { "hand": ["Lightning Bolt", "Sprouting Vines", "Sprouting Vines"], "battlefield": ["Mountain", "Forest", "Forest", "Island", "Island", "Island", "Island"], "library": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Sprouting Vines" },
      { "resolve": true, "answers": ["Forest", "Forest"] },
      { "cast": "Sprouting Vines" },
      { "resolve": true, "answers": ["Forest", "Forest", "Forest"] }
    ],
    "expect": {
      "players": [{ "hand": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library_count": 0 }, { "life": 17 }]
    }
  }
]
