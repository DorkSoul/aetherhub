[
  {
    "name": "searches one basic land for an opponent with two more lands, then exiles itself",
    "players": [
      { "battlefield": ["Surveyor's Scope", "Forest", "Forest"], "library": ["Plains", "Island", "Mountain"] },
      { "battlefield": ["Forest", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Surveyor's Scope" },
      { "resolve": true, "answers": [["Plains"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Plains", "Forest", "Forest"], "battlefield_lacks": ["Surveyor's Scope"], "exile": ["Surveyor's Scope"], "library_count": 22 },
        {}
      ]
    }
  },
  {
    "name": "an opponent with only one more land than you does not count",
    "players": [
      { "battlefield": ["Surveyor's Scope", "Forest", "Forest"], "library": ["Plains", "Island"] },
      { "battlefield": ["Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Surveyor's Scope" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Plains", "Island"], "exile": ["Surveyor's Scope"], "library_count": 22 },
        {}
      ]
    }
  },
  {
    "name": "each opponent with at least two more lands gives one search",
    "players": [
      { "battlefield": ["Surveyor's Scope", "Forest", "Forest", "Forest"], "library": ["Plains", "Island", "Mountain"] },
      { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Surveyor's Scope" },
      { "resolve": true, "answers": [["Plains"], ["Island"]] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Plains", "Island"], "library_count": 21 },
        {},
        {}
      ]
    }
  },
  {
    "name": "ruling: with no opponent two lands ahead the Scope still resolves: it is exiled and finds nothing",
    "players": [
      { "battlefield": ["Surveyor's Scope", "Forest", "Forest"], "library": ["Plains", "Island"] },
      { "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "activate": "Surveyor's Scope" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Plains", "Island"], "exile": ["Surveyor's Scope"], "library_count": 22 },
        {}
      ]
    }
  }
]
