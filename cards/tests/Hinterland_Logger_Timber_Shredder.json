[
 {
  "name": "no spell cast last turn: transforms into Timber Shredder with trample",
  "players": [
   {
    "battlefield": [
     "Hinterland Logger // Timber Shredder"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "pt": {
    "Timber Shredder": [
     4,
     2
    ]
   },
   "keywords": {
    "Timber Shredder": [
     "Trample"
    ]
   }
  }
 },
 {
  "name": "a spell cast last turn: stays Hinterland Logger",
  "players": [
   {
    "hand": [
     "Grizzly Bears"
    ],
    "battlefield": [
     "Hinterland Logger // Timber Shredder",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Grizzly Bears"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "pt": {
    "Hinterland Logger // Timber Shredder": [
     2,
     1
    ]
   }
  }
 },
 {
  "name": "Timber Shredder transforms back at the upkeep after two spells in my turn",
  "players": [
   {"hand": ["Giant Growth", "Giant Growth"], "battlefield": ["Forest", "Forest", "Hinterland Logger // Timber Shredder"]},
   {}
  ],
  "steps": [
   {"advance_to": "Upkeep"},
   {"advance_to": "End"},
   {"advance_to": "Main1"},
   {"cast": "Giant Growth", "targets": ["Timber Shredder"]},
   {"resolve": true},
   {"cast": "Giant Growth", "targets": ["Timber Shredder"]},
   {"resolve": true},
   {"advance_to": "End"},
   {"advance_to": "Upkeep"},
   {"resolve": true}
  ],
  "expect": {
   "pt": {"Hinterland Logger // Timber Shredder": [2, 1]}
  }
 },
 {
  "name": "Timber Shredder stays after only one spell in my turn",
  "players": [
   {"hand": ["Giant Growth"], "battlefield": ["Forest", "Hinterland Logger // Timber Shredder"]},
   {}
  ],
  "steps": [
   {"advance_to": "Upkeep"},
   {"advance_to": "End"},
   {"advance_to": "Main1"},
   {"cast": "Giant Growth", "targets": ["Timber Shredder"]},
   {"resolve": true},
   {"advance_to": "End"},
   {"advance_to": "Upkeep"}
  ],
  "expect": {
   "pt": {"Timber Shredder": [4, 2]}
  }
 },
 {
  "name": "ruling: one spell by each player last turn does not transform Timber Shredder back",
  "players": [
   {"hand": ["Giant Growth"], "battlefield": ["Forest", "Hinterland Logger // Timber Shredder"]},
   {"hand": ["Giant Growth"], "battlefield": ["Forest", "Grizzly Bears"]}
  ],
  "steps": [
   {"advance_to": "Upkeep"},
   {"advance_to": "End"},
   {"advance_to": "Main1"},
   {"cast": "Giant Growth", "targets": ["Timber Shredder"]},
   {"resolve": true},
   {"pass": true},
   {"cast": "Giant Growth", "targets": ["Grizzly Bears"], "player": 1},
   {"resolve": true},
   {"advance_to": "End"},
   {"advance_to": "Upkeep"}
  ],
  "expect": {
   "pt": {"Timber Shredder": [4, 2]}
  }
 }
]
