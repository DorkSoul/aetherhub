[
  {
    "name": "casting Team Tactics with teamwork creates a Robot Hero token",
    "players": [
      { "hand": ["Team Tactics"], "battlefield": ["Virtual Assistant", "Mountain", "Mountain", "Grizzly Bears", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "cast": "Team Tactics", "answers": [true, ["Llanowar Elves"]], "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Team Tactics"], "battlefield_has": ["Robot Hero 1-1 Flying"] }, {} ],
      "keywords": { "Grizzly Bears": ["DoubleStrike", "Trample"] }
    }
  },
  {
    "name": "casting Team Tactics without teamwork creates no token",
    "players": [
      { "hand": ["Team Tactics"], "battlefield": ["Virtual Assistant", "Mountain", "Mountain", "Grizzly Bears", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "cast": "Team Tactics", "answers": [false], "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Team Tactics"], "battlefield_lacks": ["Robot Hero 1-1 Flying"] }, {} ],
      "keywords": { "Grizzly Bears": ["DoubleStrike"] }
    }
  },
  {
    "name": "a spell that is not cast with teamwork (Lightning Bolt) creates no token",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Virtual Assistant", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt"], "battlefield_lacks": ["Robot Hero 1-1 Flying"] }, { "life": 17 } ]
    }
  },
  {
    "name": "Virtual Assistant has defender and cannot attack",
    "players": [
      { "battlefield": ["Virtual Assistant"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Virtual Assistant"] }, { "life": 20 } ],
      "keywords": { "Virtual Assistant": ["Defender"] }
    }
  }
]
