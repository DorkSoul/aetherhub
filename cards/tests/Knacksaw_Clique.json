[
  { "name": "exile the opponent's top card; you may play it this turn",
    "players": [ { "battlefield": ["Knacksaw Clique", "Island", "Island"] }, { "library": ["Forest", "Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Knacksaw Clique", "at": "p1" } ] }, { "advance_to": "Main2" },
               { "activate": "Knacksaw Clique", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "exile": ["Forest"], "library_count": 1 } ], "tapped": { "Knacksaw Clique": false } } },
  { "name": "{Q} untaps it, so a second activation needs it tapped again",
    "players": [ { "battlefield": ["Knacksaw Clique", "Island", "Island", "Island", "Island"] }, { "library": ["Forest", "Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Knacksaw Clique", "at": "p1" } ] }, { "advance_to": "Main2" },
               { "activate": "Knacksaw Clique", "ability": 0, "targets": ["p1"] }, { "resolve": true },
               { "activate": "Knacksaw Clique", "ability": 0, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ {}, { "exile": ["Forest"] } ] } },
  { "name": "ruling: an untapped creature cannot activate its {Q} ability",
    "players": [ { "battlefield": ["Knacksaw Clique", "Island", "Island"] }, { "library": ["Forest", "Mountain"] } ],
    "steps": [ { "activate": "Knacksaw Clique", "ability": 0, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ {}, { "exile": [], "library_count": 2 } ] } },
  { "name": "ruling: an exiled land cannot be played once you have already played a land this turn",
    "players": [ { "hand": ["Island"], "battlefield": ["Knacksaw Clique", "Island", "Island"] }, { "library": ["Forest", "Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Knacksaw Clique", "at": "p1" } ] }, { "advance_to": "Main2" }, { "play_land": "Island" },
               { "activate": "Knacksaw Clique", "ability": 0, "targets": ["p1"] }, { "resolve": true },
               { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Forest"] }, { "exile": ["Forest"] } ] } },
  { "name": "ruling: an exiled land can be played when no land has been played this turn",
    "players": [ { "battlefield": ["Knacksaw Clique", "Island", "Island"] }, { "library": ["Forest", "Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Knacksaw Clique", "at": "p1" } ] }, { "advance_to": "Main2" },
               { "activate": "Knacksaw Clique", "ability": 0, "targets": ["p1"] }, { "resolve": true },
               { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"] }, { "exile": [] } ] } },
  { "name": "ruling: a card exiled but not played stays in exile after the turn ends",
    "players": [ { "battlefield": ["Knacksaw Clique", "Island", "Island"] }, { "library": ["Forest", "Mountain"] } ],
    "steps": [ { "attack": [ { "card": "Knacksaw Clique", "at": "p1" } ] }, { "advance_to": "Main2" },
               { "activate": "Knacksaw Clique", "ability": 0, "targets": ["p1"] }, { "resolve": true },
               { "advance_to": "Main1" } ],
    "expect": { "players": [ { "hand": [] }, { "exile": ["Forest"] } ] } }
]
