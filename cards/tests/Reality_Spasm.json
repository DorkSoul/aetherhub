[
  {
    "name": "tap mode: X=2 taps two target permanents",
    "players": [
      { "hand": ["Reality Spasm"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "cast": "Reality Spasm", "answers": [[0], 2], "targets": ["Grizzly Bears", "Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Forest": true },
      "players": [ { "graveyard": ["Reality Spasm"] }, {} ]
    }
  },
  {
    "name": "untap mode: X=1 untaps a tapped creature",
    "players": [
      { "hand": ["Reality Spasm"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Reality Spasm", "answers": [[1], 1], "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "X=0 targets nothing and goes to the graveyard",
    "players": [
      { "hand": ["Reality Spasm"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Reality Spasm", "answers": [[0], 0] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false },
      "players": [ { "graveyard": ["Reality Spasm"] }, {} ]
    }
  },
  { "name": "ruling: the tap mode can target a permanent that is already tapped",
    "players": [
      { "hand": ["Reality Spasm"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Reality Spasm", "answers": [[0], 1], "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "players": [ { "graveyard": ["Reality Spasm"] }, {} ]
    }
  }
]
