[
  {
    "name": "taps for two colors to cast an Elemental spell",
    "players": [
      {
        "hand": [
          "Brushfire Elemental"
        ],
        "battlefield": [
          "Smokebraider"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Brushfire Elemental"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Brushfire Elemental",
            "Smokebraider"
          ]
        },
        {}
      ],
      "tapped": {
        "Smokebraider": true
      }
    }
  },
  {
    "name": "cannot pay for a non-Elemental spell",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Smokebraider",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "with two Forests, a non-Elemental spell is paid by lands and Smokebraider stays untapped",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Smokebraider",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears",
            "Smokebraider"
          ]
        },
        {}
      ],
      "tapped": {
        "Smokebraider": false
      }
    }
  },
  {
    "name": "ruling: Smokebraider mana cannot pay the cycling cost of an Elemental in hand (Granitic Titan)",
    "players": [
      { "hand": ["Granitic Titan"], "battlefield": ["Smokebraider"] },
      {}
    ],
    "steps": [
      { "activate": "Granitic Titan", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Granitic Titan"] }, {} ]
    }
  },
  {
    "name": "ruling: the same cycling works when paid with lands",
    "players": [
      { "hand": ["Granitic Titan"], "battlefield": ["Forest", "Forest"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Granitic Titan", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Granitic Titan"], "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "ruling: Smokebraider mana pays the alternative evoke cost of an Elemental (Shriekmaw)",
    "players": [
      { "hand": ["Shriekmaw"], "battlefield": ["Smokebraider"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shriekmaw", "alt": 0 },
      { "resolve": true, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Shriekmaw"], "battlefield_has": ["Smokebraider"] }, { "graveyard_has": ["Grizzly Bears"] } ],
      "tapped": { "Smokebraider": true }
    }
  },
  {
    "name": "ruling: Smokebraider's two mana can both be red for Ball Lightning {R}{R}{R}",
    "players": [
      { "hand": ["Ball Lightning"], "battlefield": ["Smokebraider", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Ball Lightning" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Ball Lightning", "Smokebraider"] }, {} ],
      "tapped": { "Smokebraider": true }
    }
  }
]
