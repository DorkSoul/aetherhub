  {
    "name": "ruling: basic lands and repeated types don't add up (two lands are one type)",
    "players": [
      { "battlefield": ["Gouged Zealot"], "graveyard": ["Forest", "Island", "Lightning Bolt", "Grizzly Bears"] },
      { "battlefield": ["Llanowar Elves"] }
