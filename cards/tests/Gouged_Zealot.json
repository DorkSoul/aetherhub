  {
    "name": "ruling: an artifact card in the graveyard is a fourth card type",
    "players": [
      { "battlefield": ["Gouged Zealot"], "graveyard": ["Forest", "Lightning Bolt", "Grizzly Bears", "Razor Boomerang"] },
      { "battlefield": ["Llanowar Elves"] }
