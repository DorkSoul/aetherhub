[
  {
    "name": "combat damage to a player makes a Sand token per land you control",
    "players": [ { "battlefield": ["Plains", "Swamp", "Mountain", "Forest", "Dune-Brood Nephilim"] }, {} ],
    "steps": [
      { "attack": [{ "card": "Dune-Brood Nephilim", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Dune-Brood Nephilim", "Sand 1-1 Colorless", "Sand 1-1 Colorless", "Sand 1-1 Colorless", "Sand 1-1 Colorless"] }, { "life": 17 } ]
    }
  },
  {
    "name": "no Sand tokens when the attack is blocked",
    "players": [ { "battlefield": ["Plains", "Dune-Brood Nephilim"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [{ "card": "Dune-Brood Nephilim", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Dune-Brood Nephilim" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Sand 1-1 Colorless"] }, {} ]
    }
  }
]
