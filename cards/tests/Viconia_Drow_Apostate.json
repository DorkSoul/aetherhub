[
  { "name": "upkeep with four creature cards in graveyard returns one of them to hand",
    "players": [
      { "battlefield": ["Viconia, Drow Apostate"], "graveyard": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Lightning Bolt"] },
      {}
    ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard_has": ["Lightning Bolt"] }, {} ] } },
  { "name": "three creature cards in graveyard is not enough",
    "players": [
      { "battlefield": ["Viconia, Drow Apostate"], "graveyard": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Lightning Bolt", "Lightning Bolt"] },
      {}
    ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "hand": [], "graveyard_has": ["Lightning Bolt", "Grizzly Bears"] }, {} ] } },
  { "name": "only creature cards in your own graveyard count",
    "players": [
      { "battlefield": ["Viconia, Drow Apostate"], "graveyard": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"] },
      { "graveyard": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "hand": [] }, {} ] } }
]
