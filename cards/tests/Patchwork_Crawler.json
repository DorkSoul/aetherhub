[
  {
    "name": "exiles a creature card from your graveyard and puts a +1/+1 counter on it",
    "players": [
      {
        "battlefield": ["Patchwork Crawler", "Island", "Island", "Island"],
        "graveyard": ["Shivan Dragon"]
      },
      {}
    ],
    "steps": [
      { "activate": "Patchwork Crawler", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Shivan Dragon"], "graveyard": [] },
        {}
      ],
      "pt": { "Patchwork Crawler": [2, 3] }
    }
  },
  {
    "name": "has the activated abilities of the creature cards it exiled",
    "players": [
      {
        "battlefield": ["Patchwork Crawler", "Island", "Island", "Island", "Mountain", "Mountain"],
        "graveyard": ["Shivan Dragon"]
      },
      {}
    ],
    "steps": [
      { "activate": "Patchwork Crawler", "ability": 0 },
      { "resolve": true },
      { "activate": "Patchwork Crawler", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Patchwork Crawler": [3, 3] }
    }
  },
  {
    "name": "no exiled creature means no granted ability",
    "players": [
      {
        "battlefield": ["Patchwork Crawler", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Patchwork Crawler", "ability": 32768, "illegal": true }
    ],
    "expect": {
      "pt": { "Patchwork Crawler": [1, 2] }
    }
  },
  {
    "name": "cannot exile a creature card from an opponent's graveyard",
    "players": [
      {
        "battlefield": ["Patchwork Crawler", "Island", "Island", "Island"]
      },
      {
        "graveyard": ["Shivan Dragon"]
      }
    ],
    "steps": [
      { "activate": "Patchwork Crawler", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Shivan Dragon"] }],
      "pt": { "Patchwork Crawler": [1, 2] }
    }
  }
,
  {
    "name": "ruling: gains the tap ability of an exiled creature and can activate it",
    "players": [
      {
        "battlefield": ["Patchwork Crawler", "Island", "Island", "Island"],
        "graveyard": ["Prodigal Sorcerer"]
      },
      {
        "battlefield": ["Soltari Monk"]
      }
    ],
    "steps": [
      { "activate": "Patchwork Crawler", "ability": 0, "targets": ["Prodigal Sorcerer"] },
      { "resolve": true },
      { "activate": "Patchwork Crawler", "ability": 32768, "targets": ["Soltari Monk"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Prodigal Sorcerer"] },
        { "graveyard": ["Soltari Monk"], "battlefield": [] }
      ]
    }
  }
]
