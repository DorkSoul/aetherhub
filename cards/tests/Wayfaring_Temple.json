[
  {
    "name": "power and toughness equal the number of creatures you control",
    "players": [
      {
        "battlefield": [
          "Wayfaring Temple",
          "Grizzly Bears",
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [],
    "expect": {
      "players": [
        {},
        {}
      ],
      "pt": {
        "Wayfaring Temple": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "combat damage to a player populates (copies a creature token you control)",
    "players": [
      {
        "hand": [
          "Raise the Alarm"
        ],
        "battlefield": [
          "Wayfaring Temple",
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Raise the Alarm"
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Wayfaring Temple",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Wayfaring Temple",
            "Plains",
            "Plains",
            "Soldier",
            "Soldier",
            "Soldier"
          ]
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "no populate when blocked (no combat damage to a player)",
    "players": [
      {
        "hand": [
          "Raise the Alarm"
        ],
        "battlefield": [
          "Wayfaring Temple",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Raise the Alarm"
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Wayfaring Temple",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Hill Giant",
            "attacker": "Wayfaring Temple"
          }
        ]
      },
      {
        "advance_to": "Main2",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Plains",
            "Plains",
            "Soldier",
            "Soldier"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: alone it is a 1/1 because it counts itself",
    "players": [
      { "battlefield": ["Wayfaring Temple"] },
      {}
    ],
    "steps": [],
    "expect": {
      "players": [{}, {}],
      "pt": { "Wayfaring Temple": [1, 1] }
    }
  },
  {
    "name": "ruling: with no creature tokens, populate does nothing",
    "players": [
      { "battlefield": ["Wayfaring Temple"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Wayfaring Temple", "at": "p1" } ] },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Wayfaring Temple"] },
        { "life": 19 }
      ]
    }
  }
]
