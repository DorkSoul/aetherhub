[
 {
  "name": "taps another permanent to add one mana of any color",
  "players": [
   {
    "battlefield": [
     {
      "name": "Gene Pollinator",
      "sick": false
     },
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Gene Pollinator",
    "color": "G"
   }
  ],
  "expect": {
   "players": [
    {
     "pool": {
      "G": 1
     }
    },
    {}
   ],
   "tapped": {
    "Gene Pollinator": true,
    "Forest": true
   }
  }
 },
 {
  "name": "needs another untapped permanent",
  "players": [
   {
    "battlefield": [
     {
      "name": "Gene Pollinator",
      "sick": false
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Gene Pollinator",
    "color": "G",
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Gene Pollinator": false
   }
  }
 },
 {
  "name": "ruling: a summoning-sick creature can be tapped to pay the cost",
  "players": [
   {
    "battlefield": [
     { "name": "Gene Pollinator", "sick": false },
     { "name": "Grizzly Bears", "sick": true }
    ]
   },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Gene Pollinator", "color": "G" }
  ],
  "expect": {
   "players": [ { "pool": { "G": 1 } }, {} ],
   "tapped": { "Gene Pollinator": true, "Grizzly Bears": true }
  }
 },
 {
  "name": "ruling: Gene Pollinator itself must have been controlled since the start of your turn",
  "players": [
   {
    "battlefield": [
     { "name": "Gene Pollinator", "sick": true },
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Gene Pollinator", "color": "G", "illegal": true }
  ],
  "expect": {
   "tapped": { "Gene Pollinator": false, "Forest": false }
  }
 }
]
