[
  {
    "name": "counters when you control more creatures",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {
        "hand": [
          "Unified Will"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Grizzly Bears",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Unified Will",
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ],
        "player": 1
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "does nothing when you do not control more",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Grizzly Bears",
          "Grizzly Bears"
        ]
      },
      {
        "hand": [
          "Unified Will"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Unified Will",
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ],
        "player": 1
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "ruling: count is checked on resolution, so killing a creature in response stops the counter",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Unified Will"], "battlefield": ["Island", "Island", "Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Unified Will", "targets": [{ "stack": "Lightning Bolt" }], "player": 1 },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Lightning Bolt"] },
        { "life": 17, "graveyard": ["Unified Will", "Grizzly Bears"], "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: equal creature counts when it resolves, Unified Will does nothing",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] },
      { "hand": ["Unified Will"], "battlefield": ["Island", "Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Unified Will", "targets": [{ "stack": "Lightning Bolt" }], "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 17, "graveyard": ["Unified Will"] }
      ]
    }
  }
]
