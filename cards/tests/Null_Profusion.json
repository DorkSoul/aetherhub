[
  {
    "name": "casting a spell draws a card",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Null Profusion", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "playing a land draws a card",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Null Profusion"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Forest"] }, {} ]
    }
  },
  {
    "name": "skips the draw step of its next turn",
    "players": [
      { "hand": [], "battlefield": ["Null Profusion"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Draw" },
      { "advance_to": "Draw" }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "maximum hand size is two at cleanup",
    "players": [
      { "hand": ["Grizzly Bears", "Lightning Bolt", "Plains"], "battlefield": ["Null Profusion"] },
      {}
    ],
    "steps": [
      { "advance_to": "Cleanup", "auto": true }
    ],
    "expect": {
      "players": [ { "hand_count": 2 }, {} ]
    }
  },
  {
    "name": "ruling: hand size is only checked at cleanup, so three cards are kept until then",
    "players": [
      { "hand": ["Grizzly Bears", "Lightning Bolt", "Plains"], "battlefield": ["Null Profusion"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "hand_count": 3 }, {} ]
    }
  }
]
