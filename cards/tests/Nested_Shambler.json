[
  {
    "name": "makes squirrels equal to its power when it dies",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Nested Shambler"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Nested Shambler"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Nested Shambler"], "battlefield_has": ["Squirrel"] }
      ],
      "pt": { "Squirrel": [1, 1] },
      "tapped": { "Squirrel": true }
    }
  },
  {
    "name": "uses the power it had on the battlefield",
    "players": [
      { "hand": ["Giant Growth", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Forest", "Mountain", "Mountain"] },
      { "battlefield": ["Nested Shambler"] }
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Nested Shambler"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Nested Shambler"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Nested Shambler"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Nested Shambler"], "battlefield_has": ["Squirrel"] }
      ],
      "pt": { "Squirrel": [1, 1] }
    }
  },
  {
    "name": "ruling: power 0 or less when it died (-1 from Weakness) makes no squirrels",
    "players": [
      { "hand": ["Weakness"], "battlefield": ["Swamp"] },
      { "battlefield": ["Nested Shambler"] }
    ],
    "steps": [
      { "cast": "Weakness", "targets": ["Nested Shambler"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Weakness"] },
        { "graveyard": ["Nested Shambler"], "battlefield_lacks": ["Squirrel"] }
      ]
    }
  }
]
