[
  { "name": "with no other colored permanents or spells only First Family's own two colors count: draw 2, gain 2",
    "players": [ { "hand": ["First Family"], "battlefield": ["Forest", "Island", "Forest", "Island"] }, {} ],
    "steps": [ { "cast": "First Family" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "life": 22, "graveyard": ["First Family"] }, {} ] } },
  { "name": "colors of permanents you control count once each: red and white add two",
    "players": [ { "hand": ["First Family"], "battlefield": ["Forest", "Island", "Forest", "Island", "Hill Giant", "Serra Angel", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "First Family" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 4, "life": 24 }, {} ] } },
  { "name": "a spell cast earlier this turn adds its color",
    "players": [ { "hand": ["Lightning Bolt", "First Family"], "battlefield": ["Mountain", "Forest", "Island", "Forest", "Island"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "First Family" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 3, "life": 23 }, { "life": 17 } ] } },
  { "name": "an opponent's permanents do not count",
    "players": [ { "hand": ["First Family"], "battlefield": ["Forest", "Island", "Forest", "Island"] }, { "battlefield": ["Hill Giant", "Serra Angel"] } ],
    "steps": [ { "cast": "First Family" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "life": 22 }, {} ] } }
]
