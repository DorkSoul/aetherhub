[
  {
    "name": "exiling two white cards from hand casts it for free and destroys every creature",
    "players": [
      { "hand": ["Sunscour", "Story Seeker", "Syndic of Tithes"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Sunscour", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "exile": ["Story Seeker", "Syndic of Tithes"], "graveyard": ["Sunscour"] },
        { "battlefield": [], "graveyard": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "only one white card in hand: the alternative cost is not available",
    "players": [
      { "hand": ["Sunscour", "Story Seeker", "Mountain Bandit"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sunscour", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Sunscour", "Story Seeker", "Mountain Bandit"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "two cards of other colours cannot pay the alternative cost",
    "players": [
      { "hand": ["Sunscour", "Mountain Bandit", "Stormchaser Mage"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sunscour", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Sunscour", "Mountain Bandit", "Stormchaser Mage"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the card being cast cannot be exiled to pay for itself",
    "players": [
      { "hand": ["Sunscour", "Story Seeker"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sunscour", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Sunscour", "Story Seeker"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: the alternative cost does not make a sorcery castable outside the main phase",
    "players": [
      { "hand": ["Sunscour", "Story Seeker", "Syndic of Tithes"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Sunscour", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Sunscour", "Story Seeker", "Syndic of Tithes"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
