   {"resolve": true, "answers": ["Forest"]}
  ],
  "expect": {"players": [{"hand": ["Pulse of the Grid", "Swamp"], "graveyard": ["Forest"]}, {}]}},
 {"name": "goes to graveyard when hand sizes are equal",
  "players": [
   {"hand": ["Pulse of the Grid"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Swamp"]},
   {"hand": ["Mountain"]}
  ],
  "steps": [
   {"cast": "Pulse of the Grid"},
   {"resolve": true, "answers": ["Forest"]}
  ],
  "expect": {"players": [{"hand": ["Swamp"], "graveyard": ["Forest", "Pulse of the Grid"]}, {}]}},
 {"name": "goes to graveyard when opponent has fewer cards",
  "players": [
   {"hand": ["Pulse of the Grid"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Swamp"]},
   {}
  ],
  "steps": [
   {"cast": "Pulse of the Grid"},
   {"resolve": true, "answers": ["Forest"]}
  ],
