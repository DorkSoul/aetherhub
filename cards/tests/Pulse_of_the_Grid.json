   {"hand": ["Pulse of the Grid"], "battlefield": ["Island", "Island", "Island"], "library": ["Forest", "Swamp"]},
   {"hand": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]}
  ],
  "steps": [
