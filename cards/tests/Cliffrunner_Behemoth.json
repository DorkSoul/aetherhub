  {
    "name": "has haste while you control a red permanent",
    "players": [
      {
        "battlefield": [
          "Cliffrunner Behemoth",
          "Gruul Ragebeast"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "players": [
        {},
        {}
      ],
      "keywords": {
        "Cliffrunner Behemoth": [
          "Haste"
        ]
      }
    }
  },
  {
    "name": "lifelink while you control a white permanent: combat damage gains you life",
    "players": [
      { "battlefield": [ { "name": "Cliffrunner Behemoth", "sick": false }, "Serra Angel" ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Cliffrunner Behemoth", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "life": 25 }, { "life": 15 }] }
  },
  {
    "name": "no lifelink without a white permanent: combat damage gains nothing",
    "players": [
      { "battlefield": [ { "name": "Cliffrunner Behemoth", "sick": false }, "Hill Giant" ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Cliffrunner Behemoth", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "life": 20 }, { "life": 15 }] }
  },
  {
    "name": "ruling: lifelink still applies when a white creature dies to the same combat damage",
    "players": [
      { "battlefield": [ { "name": "Cliffrunner Behemoth", "sick": false }, { "name": "Savannah Lions", "sick": false } ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Cliffrunner Behemoth", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Savannah Lions" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "life": 25, "graveyard": ["Savannah Lions"] },
        { "life": 15, "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: an attacker keeps its haste after the red permanent leaves",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Cliffrunner Behemoth", "sick": true }, "Hill Giant", "Mountain" ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Cliffrunner Behemoth", "at": "p1" } ] },
      { "block": [] },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Hill Giant", "Lightning Bolt"] },
        { "life": 15 }
      ]
    }
  },
  {
    "name": "ruling: a red permanent need not be a creature for the haste bonus",
    "players": [
      { "battlefield": [ { "name": "Cliffrunner Behemoth", "sick": true }, "Beamtown Beatstick" ] },
      {}
    ],
    "steps": [],
    "expect": {
      "players": [{}, {}],
      "keywords": { "Cliffrunner Behemoth": ["Haste"] }
    }
  }
]
