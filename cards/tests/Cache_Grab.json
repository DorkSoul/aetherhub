  {
    "name": "ruling: a Food sacrificed for its own ability cannot also pay for Maraleaf Rider's ability",
    "players": [
      { "battlefield": ["Food", "Maraleaf Rider", "Grizzly Bears", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Food", "ability": 0 },
