  {
    "name": "ruling: a Food sacrificed for Maraleaf Rider's ability cannot also be activated for its own ability",
    "players": [
      { "battlefield": ["Food", "Maraleaf Rider", "Grizzly Bears", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Food", "ability": 0, "illegal": true }
