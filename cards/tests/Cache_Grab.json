      { "activate": "Maraleaf Rider", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "battlefield_lacks": ["Food"], "battlefield_has": ["Maraleaf Rider"] },
        {}
      ]
