[
 { "name": "ability 1 exiles the top card, you may play it this turn, and puts a brick counter on it",
   "players": [ { "battlefield": ["Oracle's Vault", "Plains", "Plains"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Oracle's Vault", "ability": 0 }, { "resolve": true }, { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield": ["Oracle's Vault", "Plains", "Plains", "Forest"] }, {} ],
     "counters": { "Oracle's Vault": { "brick": 1 } } } },
 { "name": "ability 2 needs three brick counters",
   "players": [ { "battlefield": ["Oracle's Vault"], "library": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Oracle's Vault", "ability": 1, "illegal": true } ],
   "expect": { "players": [ { "battlefield": ["Oracle's Vault"] }, {} ] } },
 { "name": "with three brick counters, ability 2 exiles the top card and you may cast it without paying its mana cost",
   "players": [ { "battlefield": [ { "name": "Oracle's Vault", "counters": { "brick": 3 } } ], "library": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Oracle's Vault", "ability": 1 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ],
     "counters": { "Oracle's Vault": { "brick": 3 } } } },
 { "name": "ruling: a card cast without paying its mana cost has X = 0",
   "players": [ { "battlefield": [ { "name": "Oracle's Vault", "counters": { "brick": 3 } } ], "library": ["Fireball"] }, {} ],
   "steps": [ { "activate": "Oracle's Vault", "ability": 1 }, { "resolve": true }, { "cast": "Fireball", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Fireball"] }, { "life": 20 } ] } },
 { "name": "ruling: playing the exiled land uses the turn's land play, so a second land cannot be played",
   "players": [ { "hand": ["Plains"], "battlefield": ["Oracle's Vault", "Plains", "Plains"], "library": ["Forest"] }, {} ],
   "steps": [ { "play_land": "Plains" }, { "activate": "Oracle's Vault", "ability": 0 }, { "resolve": true }, { "play_land": "Forest", "illegal": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Forest"], "exile": ["Forest"] }, {} ], "counters": { "Oracle's Vault": { "brick": 1 } } } },
 { "name": "ruling: the brick counter is put on even if the card is not played, and the card stays exiled after the turn",
   "players": [ { "battlefield": ["Oracle's Vault", "Plains", "Plains"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Oracle's Vault", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "End" } ],
   "expect": { "players": [ { "battlefield_lacks": ["Forest"], "exile": ["Forest"] }, {} ], "counters": { "Oracle's Vault": { "brick": 1 } } } },
 { "name": "ruling: a creature exiled by Oracle's Vault cannot be cast during combat",
   "players": [ { "battlefield": [ { "name": "Oracle's Vault", "counters": { "brick": 3 } }, "Forest", "Forest" ], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "activate": "Oracle's Vault", "ability": 1 }, { "resolve": true }, { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": { "players": [ { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: the exiled card can still be played after Oracle's Vault leaves the battlefield",
   "players": [ { "hand": ["Disenchant"], "battlefield": ["Oracle's Vault", "Plains", "Plains", "Plains", "Plains"], "library": ["Forest"] }, {} ],
   "steps": [ { "activate": "Oracle's Vault", "ability": 0 }, { "resolve": true }, { "cast": "Disenchant", "targets": ["Oracle's Vault"] }, { "resolve": true }, { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": ["Forest"], "battlefield_lacks": ["Oracle's Vault"], "graveyard_has": ["Oracle's Vault", "Disenchant"] }, {} ] } }
]
