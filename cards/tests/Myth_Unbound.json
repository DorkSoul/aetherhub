[
  {
    "name": "your commander put into the command zone from the battlefield: draw a card",
    "commander": true,
    "players": [
      {
        "command": ["Savannah Lions"],
        "hand": ["Lightning Bolt"],
        "battlefield": ["Plains", "Mountain", "Myth Unbound"]
      },
      {}
    ],
    "steps": [
      { "cast": "Savannah Lions" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard_has": ["Lightning Bolt"] },
        {}
      ]
    }
  },
  {
    "name": "a non-commander put into the graveyard does not draw a card",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", "Myth Unbound", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard_has": ["Lightning Bolt"] },
        {}
      ]
    }
  },
  {
    "name": "commander costs {1} less for each earlier cast from the command zone (commander tax still applies)",
    "commander": true,
    "players": [
      {
        "command": ["Savannah Lions"],
        "hand": ["Lightning Bolt"],
        "battlefield": ["Plains", "Plains", "Mountain", "Forest", "Myth Unbound"]
      },
      {}
    ],
    "steps": [
      { "cast": "Savannah Lions" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
      { "resolve": true },
      { "cast": "Savannah Lions" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Savannah Lions", "Myth Unbound"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "ruling: Myth's reduction applies after the tax, so the second recast costs {1}{W} and is illegal with one land left",
    "commander": true,
    "players": [
      {
        "command": ["Savannah Lions"],
        "hand": ["Lightning Bolt"],
        "battlefield": ["Plains", "Plains", "Mountain", "Myth Unbound"]
      },
      {}
    ],
    "steps": [
      { "cast": "Savannah Lions" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
      { "resolve": true },
      { "cast": "Savannah Lions", "illegal": true }
    ],
    "expect": {
      "players": [
        { "command": ["Savannah Lions"], "hand_count": 1 },
        {}
      ]
    }
  }
]
