  "steps": [ { "cast": "Last Gasp", "targets": ["Cemetery Gate"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard_has": ["Last Gasp"] }, { "battlefield_has": ["Cemetery Gate"] } ], "pt": { "Cemetery Gate": [-3, 2] } }
 },
