[
  {
    "name": "taps all Islands when it enters",
    "players": [
      { "hand": ["Curse of Marit Lage"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Island", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Curse of Marit Lage" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Curse of Marit Lage"] }, { "battlefield_has": ["Island"] } ],
      "tapped": { "Island": true, "Grizzly Bears": false }
    }
  },
  {
    "name": "Islands stay tapped through their controller's untap step",
    "players": [
      { "battlefield": ["Curse of Marit Lage"] },
      { "battlefield": [ { "name": "Island", "tapped": true } ] }
    ],
    "steps": [
      { "advance_to": "Main1" }
    ],
    "expect": {
      "turn": 2,
      "tapped": { "Island": true }
    }
  },
  {
    "name": "without the Curse an Island untaps in its controller's untap step",
    "players": [
      { "battlefield": [] },
      { "battlefield": [ { "name": "Island", "tapped": true } ] }
    ],
    "steps": [
      { "advance_to": "Main1" }
    ],
    "expect": {
      "turn": 2,
      "tapped": { "Island": false }
    }
  }
]
