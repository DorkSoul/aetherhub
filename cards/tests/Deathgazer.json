[
  {
    "name": "blocked by a nonblack creature: the blocker is destroyed at end of combat",
    "players": [
      { "battlefield": ["Deathgazer"] },
      { "battlefield": ["Wall of Wood"] }
    ],
    "steps": [
      { "attack": [ { "card": "Deathgazer", "at": "p1" } ] },
      { "block": [ { "blocker": "Wall of Wood", "attacker": "Deathgazer" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Deathgazer"] },
        { "graveyard": ["Wall of Wood"] }
      ]
    }
  },
  {
    "name": "blocked by a black creature: nothing is destroyed",
    "players": [
      { "battlefield": ["Deathgazer"] },
      { "battlefield": ["Wall of Bone"] }
    ],
    "steps": [
      { "attack": [ { "card": "Deathgazer", "at": "p1" } ] },
      { "block": [ { "blocker": "Wall of Bone", "attacker": "Deathgazer" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Deathgazer"] },
        { "battlefield": ["Wall of Bone"] }
      ]
    }
  },
  {
    "name": "blocks a nonblack attacker: the attacker is destroyed at end of combat even though it survives damage",
    "players": [
      { "battlefield": ["Trained Armodon"] },
      { "battlefield": ["Deathgazer"] }
    ],
    "steps": [
      { "attack": [ { "card": "Trained Armodon", "at": "p1" } ] },
      { "block": [ { "blocker": "Deathgazer", "attacker": "Trained Armodon" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Trained Armodon"] },
        { "graveyard": ["Deathgazer"] }
      ]
    }
  }
]
