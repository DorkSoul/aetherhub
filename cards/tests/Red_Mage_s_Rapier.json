[
 { "name": "job select: a Hero token gets the Rapier attached",
   "players": [ { "hand": ["Red Mage's Rapier"], "battlefield": ["Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Red Mage's Rapier" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "attached": { "Red Mage's Rapier": "Hero" }, "pt": { "Hero": [1, 1] } } },
 { "name": "equipped creature gets +2/+0 when you cast a noncreature spell",
   "players": [ { "hand": ["Red Mage's Rapier", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Red Mage's Rapier" }, { "resolve": true }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "pt": { "Hero": [3, 1] }, "players": [ {}, { "life": 17 } ] } },
 { "name": "equip {3} moves the Rapier to my creature",
   "players": [ { "battlefield": ["Red Mage's Rapier", "Grizzly Bears", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Red Mage's Rapier", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "attached": { "Red Mage's Rapier": "Grizzly Bears" }, "pt": { "Grizzly Bears": [2, 2] } } },
 { "name": "equip needs three mana",
   "players": [ { "battlefield": ["Red Mage's Rapier", "Grizzly Bears", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Red Mage's Rapier", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Red Mage's Rapier", "Grizzly Bears"] }, {} ], "attached": {} } },
 { "name": "the Hero token is a Wizard in addition to its own types",
   "players": [ { "hand": ["Red Mage's Rapier"], "battlefield": ["Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Red Mage's Rapier" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "attached": { "Red Mage's Rapier": "Hero" }, "subtypes": { "Hero": ["Wizard"] } } },
 { "name": "equip gives my Grizzly Bears the Wizard type",
   "players": [ { "battlefield": ["Red Mage's Rapier", "Grizzly Bears", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Red Mage's Rapier", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "attached": { "Red Mage's Rapier": "Grizzly Bears" }, "subtypes": { "Grizzly Bears": ["Wizard"] } } },
 { "name": "ruling: the granted pump resolves before the spell, even when that spell is countered",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Red Mage's Rapier", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "activate": "Red Mage's Rapier", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Counterspell"], "life": 20 } ], "pt": { "Grizzly Bears": [4, 2] } } },
 { "name": "ruling: destroying the Hero token leaves the Equipment on the battlefield",
   "players": [ { "hand": ["Red Mage's Rapier", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Red Mage's Rapier" }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Hero"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Red Mage's Rapier"], "battlefield_lacks": ["Hero"], "graveyard": ["Lightning Bolt"] }, { "life": 20 } ] } },
 { "name": "ruling: equip {3} moves the Rapier from the Hero token to another creature I control",
   "players": [ { "hand": ["Red Mage's Rapier"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Red Mage's Rapier" }, { "resolve": true }, { "resolve": true },
              { "activate": "Red Mage's Rapier", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "attached": { "Red Mage's Rapier": "Grizzly Bears" }, "pt": { "Grizzly Bears": [2, 2], "Hero": [1, 1] } } },
 { "name": "ruling: with Doubling Season the job select makes two Heroes, but the Rapier attaches to only one",
   "players": [ { "hand": ["Red Mage's Rapier"], "battlefield": ["Doubling Season", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Red Mage's Rapier" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hero", "Hero", "Red Mage's Rapier"] }, {} ], "attached": { "Red Mage's Rapier": "Hero" } } }
]
