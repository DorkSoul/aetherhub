 {
  "name": "enlist: tap Hill Giant (not summoning sick) to add its power 3 to the attacker",
  "players": [
   {
    "battlefield": [
     "Balduvian Berserker",
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Balduvian Berserker",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true,
    "answers": [
     [
      "Hill Giant"
     ]
    ]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 16
    }
   ],
   "tapped": {
    "Hill Giant": true
   }
  }
 },
 {
  "name": "ruling: enlist needs a creature without summoning sickness; a sick Hill Giant cannot be tapped",
  "players": [ { "battlefield": ["Balduvian Berserker", { "name": "Hill Giant", "sick": true }] }, {} ],
  "steps": [ { "attack": [ { "card": "Balduvian Berserker", "at": "p1" } ] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 19 } ], "tapped": { "Hill Giant": false } }
 },
 {
  "name": "ruling: an attacking creature cannot be tapped for enlist (Hill Giant attacks too, no bonus)",
  "players": [ { "battlefield": ["Balduvian Berserker", "Hill Giant"] }, {} ],
  "steps": [ { "attack": [ { "card": "Balduvian Berserker", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] }, { "advance_to": "Main2" } ],
  "expect": { "players": [ {}, { "life": 16 } ] }
 },
 {
  "name": "ruling: dies after enlisting Grizzly Bears, death damage uses its power on the battlefield (1 + 2 = 3)",
  "players": [ { "battlefield": ["Balduvian Berserker", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
  "steps": [
   { "attack": [ { "card": "Balduvian Berserker", "at": "p1" } ] },
   { "resolve": true, "answers": [ ["Grizzly Bears"] ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Balduvian Berserker" } ], "player": 1 },
   { "advance_to": "Main2", "targets": ["p1"] }
  ],
  "expect": { "players": [ { "graveyard_has": ["Balduvian Berserker"] }, { "life": 17, "graveyard_has": ["Hill Giant"] } ] }
 }
]