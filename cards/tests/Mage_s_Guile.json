[
  {
    "name": "target creature gains shroud until end of turn",
    "players": [
      { "hand": ["Mage's Guile"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Mage's Guile", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ],
      "keywords": { "Grizzly Bears": ["Shroud"] }
    }
  },
  {
    "name": "cycling for {U} draws a card",
    "players": [
      { "hand": ["Mage's Guile"], "battlefield": ["Island"] },
      {}
    ],
    "steps": [
      { "activate": "Mage's Guile", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "graveyard_has": ["Mage's Guile"] }, {} ]
    }
  },
  {
    "name": "ruling: Stifle can counter the cycling ability, so no card is drawn",
    "players": [
      { "hand": ["Mage's Guile"], "battlefield": ["Island"] },
      { "hand": ["Stifle"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "activate": "Mage's Guile", "ability": 0 },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Mage's Guile" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard_has": ["Mage's Guile"] }, { "graveyard_has": ["Stifle"] } ]
    }
  },
  {
    "name": "ruling: Counterspell cannot target cycling (it is an ability, not a spell)",
    "players": [
      { "hand": ["Mage's Guile"], "battlefield": ["Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "activate": "Mage's Guile", "ability": 0 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "graveyard_has": ["Mage's Guile"] }, { "hand": ["Counterspell"] } ]
    }
  }
]
