[
 {
  "name": "combat damage to a player gives that many energy",
  "players": [
   {
    "battlefield": [
     "Aurora Shifter"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Aurora Shifter",
      "at": "p1"
     }
    ]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 1
    },
    {
     "life": 19
    }
   ]
  }
 },
 {
  "name": "at beginning of combat pay EE to become a copy of another creature you control (keeps the energy trigger)",
  "players": [
   {
    "hand": [
     "Bristling Hydra"
    ],
    "battlefield": [
     "Aurora Shifter",
     "Hill Giant",
     "Forest",
     "Forest",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Bristling Hydra"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "BeginCombat",
    "answers": [
     true,
     "Hill Giant"
    ]
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 1,
     "battlefield_has": [
      "Hill Giant",
      "Bristling Hydra"
     ],
     "battlefield_lacks": [
      "Aurora Shifter"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "declining to pay EE at beginning of combat leaves Aurora Shifter unchanged",
  "players": [
   {
    "hand": [
     "Bristling Hydra"
    ],
    "battlefield": [
     "Aurora Shifter",
     "Hill Giant",
     "Forest",
     "Forest",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Bristling Hydra"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "BeginCombat",
    "answers": [
     false
    ]
   }
  ],
  "expect": {
   "players": [
    {
     "energy": 3,
     "battlefield_has": [
      "Aurora Shifter",
      "Hill Giant",
      "Bristling Hydra"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: with only 1 energy the EE payment is impossible and nothing is copied",
  "players": [
   { "battlefield": ["Aurora Shifter", "Hill Giant"], "energy": 1 },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat" }
  ],
  "expect": { "players": [ { "energy": 1, "battlefield_has": ["Aurora Shifter", "Hill Giant"] }, {} ] }
 },
 {
  "name": "ruling: paying EE once leaves the rest of the energy (4 energy, 2 left after the copy)",
  "players": [
   { "battlefield": ["Aurora Shifter", "Hill Giant"], "energy": 4 },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat", "answers": [true, "Hill Giant"] }
  ],
  "expect": { "players": [ { "energy": 2, "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Aurora Shifter"] }, {} ] }
 },
 {
  "name": "ruling: a copy of a creature with an enters trigger does not enter, so no Mercenary tokens",
  "players": [
   { "battlefield": ["Aurora Shifter", "Hellspur Posse Boss"], "energy": 2 },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat", "answers": [true, "Hellspur Posse Boss"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Hellspur Posse Boss"], "battlefield_lacks": ["Aurora Shifter", "Mercenary 1-1"] }, {} ] }
 },
 {
  "name": "ruling: energy is not removed by turns ending; it is still there on the opponent's turn",
  "players": [
   { "battlefield": ["Aurora Shifter"], "energy": 2 },
   {}
  ],
  "steps": [
   { "advance_to": "BeginCombat", "answers": [false] },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" }
  ],
  "expect": { "turn": 2, "players": [ { "energy": 2 }, {} ] }
 }
]
