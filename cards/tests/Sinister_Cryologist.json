[
  { "name": "ETB gives target opposing creature -3/-0 until end of turn",
    "players": [ { "hand": ["Sinister Cryologist"], "battlefield": ["Island", "Island", "Island"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sinister Cryologist" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [-1, 2], "Sinister Cryologist": [2, 3] } } },
  { "name": "only opposing creatures are legal targets (your own Llanowar Elves is untouched)",
    "players": [ { "hand": ["Sinister Cryologist"], "battlefield": ["Island", "Island", "Island", "Llanowar Elves"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sinister Cryologist" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Llanowar Elves": [1, 1], "Grizzly Bears": [-1, 2] } } },
  { "name": "warp: cast from hand for {U}, exiled at the next end step",
    "players": [ { "hand": ["Sinister Cryologist"], "battlefield": ["Island"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sinister Cryologist", "alt": 0 }, { "resolve": true }, { "resolve": true },
               { "advance_to": "End" } ],
    "expect": { "players": [ { "exile": ["Sinister Cryologist"] }, {} ], "pt": { "Grizzly Bears": [-1, 2] } } }
]
