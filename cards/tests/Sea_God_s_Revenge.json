[
  {
    "name": "returns up to three opposing creatures to hand and scries 1",
    "players": [
      { "hand": ["Sea God's Revenge"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Sea God's Revenge", "targets": ["Grizzly Bears", "Llanowar Elves"] },
      { "resolve": true, "auto": true }
    ],
    "expect": { "players": [{ "graveyard": ["Sea God's Revenge"] }, { "hand": ["Grizzly Bears", "Llanowar Elves"], "battlefield": [] }] }
  },
  {
    "name": "no targets chosen: still resolves and only scries",
    "players": [
      { "hand": ["Sea God's Revenge"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sea God's Revenge", "targets": [] },
      { "resolve": true, "auto": true }
    ],
    "expect": { "players": [{ "graveyard": ["Sea God's Revenge"] }, { "battlefield": ["Grizzly Bears"] }] }
  },
  {
    "name": "ruling: scry 1 with no targets can put the top card on the bottom",
    "players": [
      { "hand": ["Sea God's Revenge"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Lightning Bolt", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sea God's Revenge", "targets": [] },
      { "resolve": true, "answers": [["Lightning Bolt"]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Sea God's Revenge"], "library_top": ["Grizzly Bears"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: after the bounce, scry 1 can keep the top card on top",
    "players": [
      { "hand": ["Sea God's Revenge"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"], "library": ["Lightning Bolt", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Sea God's Revenge", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "library_top": ["Lightning Bolt", "Grizzly Bears"] },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  }
]
