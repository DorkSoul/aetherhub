[
  { "name": "counters an artifact's activated ability and destroys the artifact",
    "players": [ { "hand": ["Green Slime"], "battlefield": ["Sensei's Divining Top", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Sensei's Divining Top", "ability": 1 }, { "cast": "Green Slime" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Sensei's Divining Top"], "battlefield": ["Forest", "Forest", "Forest", "Green Slime"] }, {} ] } },
  { "name": "counters an enchantment's triggered ability and destroys the enchantment",
    "players": [ { "hand": ["Grizzly Bears", "Green Slime"], "battlefield": ["Ajani's Welcome", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "cast": "Green Slime" }, { "resolve": true }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Ajani's Welcome"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears", "Green Slime"] }, {} ] } },
  { "name": "an ability from a creature is not a legal target and nothing is destroyed",
    "players": [ { "hand": ["Green Slime"], "battlefield": ["Prodigal Sorcerer", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Prodigal Sorcerer", "targets": ["p1"] }, { "cast": "Green Slime" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Forest", "Forest", "Forest", "Green Slime", "Prodigal Sorcerer"] }, { "life": 19 } ] } },
  { "name": "foretell for {2}, then cast for {G} on a later turn",
    "players": [ { "hand": ["Green Slime"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Green Slime", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "cast": "Green Slime", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Forest", "Forest", "Forest", "Green Slime"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: a foretold Green Slime (flash) is cast for {G} during the opponent's upkeep",
    "players": [ { "hand": ["Green Slime"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Green Slime", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "pass": true, "player": 1 }, { "cast": "Green Slime", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Forest", "Forest", "Forest", "Green Slime"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: foretelling is a special action, so it can be done in response to your own spell",
    "players": [ { "hand": ["Green Slime", "Lightning Bolt"], "battlefield": ["Mountain", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "activate": "Green Slime", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "exile": ["Green Slime"], "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
  { "name": "ruling: a mana ability is not on the stack, so an artifact's mana ability is never a Green Slime target",
    "players": [ { "hand": ["Green Slime"], "battlefield": ["Forest", "Forest", "Forest"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Green Slime" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Green Slime"] }, { "battlefield_has": ["Sol Ring"] } ] } }
]
