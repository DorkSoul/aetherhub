[
  { "name": "creatures without haste can't block the targeted creature",
    "players": [ { "hand": ["Run for Your Life"], "battlefield": ["Island", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [
      { "cast": "Run for Your Life", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "a creature with haste can still block it",
    "players": [ { "hand": ["Run for Your Life"], "battlefield": ["Island", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Raging Goblin"] } ],
    "steps": [
      { "cast": "Run for Your Life", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Raging Goblin", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Raging Goblin"] } ] } },
  { "name": "escape: cast from the graveyard by exiling four other cards",
    "players": [ { "graveyard": ["Run for Your Life", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["Island", "Mountain", "Island", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [
      { "cast": "Run for Your Life", "alt": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Run for Your Life"] }, {} ] } },
  { "name": "ruling: escape's exile cost is mandatory, three other cards are not enough",
    "players": [ { "graveyard": ["Run for Your Life", "Forest", "Forest", "Forest"], "battlefield": ["Island", "Mountain", "Island", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [
      { "cast": "Run for Your Life", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Run for Your Life"] }, {} ] } }
]
