[
  {
    "name": "deals damage equal to Vampires you control, then draws",
    "players": [
      { "hand": ["Stensia Banquet"], "battlefield": ["Mountain", "Mountain", "Mountain", "Stensia Innkeeper", "Acolyte of Aclazotz"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Stensia Banquet", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, { "life": 18 }]
    }
  },
  {
    "name": "can target an opponent with no Vampires: no damage, still draws",
    "players": [
      { "hand": ["Stensia Banquet"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "cast": "Stensia Banquet", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, { "life": 20 }]
    }
  },
  {
    "name": "ruling: Vampires are counted on resolution (one dies in response)",
    "players": [
      { "hand": ["Stensia Banquet"], "battlefield": ["Mountain", "Mountain", "Mountain", "Stensia Innkeeper", "Acolyte of Aclazotz"], "library": ["Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Stensia Banquet", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Stensia Innkeeper"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 1 }, { "life": 19 }]
    }
  }
]
