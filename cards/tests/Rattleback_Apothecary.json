[
  {
    "name": "committing a crime lets you give a creature menace",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Rattleback Apothecary", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true, "answers": [[0]] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Menace"] },
      "players": [ {}, { "battlefield_has": ["Hill Giant"] } ]
    }
  },
  {
    "name": "the same trigger can give lifelink instead",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Rattleback Apothecary", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "resolve": true, "answers": [[1]] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Lifelink"] }
    }
  },
  {
    "name": "no crime, no trigger: targeting your own creature",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Rattleback Apothecary", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Rattleback Apothecary": ["Deathtouch"] }
    }
  },
  {
    "name": "ruling: the crime happens on casting, so the trigger still resolves when the spell fizzles",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Rattleback Apothecary", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"], "player": 1 },
      { "resolve": true, "answers": [[0]] }
    ],
    "expect": {
      "keywords": { "Grizzly Bears": ["Menace"] },
      "players": [ { "graveyard_has": ["Shock"] }, { "graveyard_has": ["Hill Giant", "Lightning Bolt"] } ]
    }
  }
]
