[
  {
    "name": "enchanted artifact becomes a 4/4 creature and the aura draws a card",
    "players": [
      {
        "hand": [
          "Mightstone's Animation"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Sol Ring"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Mightstone's Animation",
        "targets": [
          "Sol Ring"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Sol Ring": [
          4,
          4
        ]
      },
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "enchant artifact only: cannot enchant a creature",
    "players": [
      {
        "hand": [
          "Mightstone's Animation"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Mightstone's Animation",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {}
  },
  {
    "name": "enchanted artifact is a creature (AddType): it can attack for 4",
    "players": [
      {
        "hand": ["Mightstone's Animation"],
        "battlefield": ["Island", "Island", "Island", "Island", "Sol Ring"]
      },
      {}
    ],
    "steps": [
      { "cast": "Mightstone's Animation", "targets": ["Sol Ring"] },
      { "resolve": true },
      { "resolve": true },
      { "attack": [{ "card": "Sol Ring", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  },
  {
    "name": "ruling: an equip bonus applied after the Animation still applies to the new creature",
    "players": [
      { "hand": ["Mightstone's Animation"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Sol Ring", "Bonesplitter"] },
      {}
    ],
    "steps": [
      { "cast": "Mightstone's Animation", "targets": ["Sol Ring"] },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Sol Ring": [6, 4] },
      "players": [{ "hand_count": 1 }, {}]
    }
  },
  {
    "name": "ruling: an artifact that is already a creature gets base 4/4, overwriting its 0/2",
    "players": [
      { "hand": ["Mightstone's Animation"], "battlefield": ["Island", "Island", "Island", "Island", "Ornithopter"] },
      {}
    ],
    "steps": [
      { "cast": "Mightstone's Animation", "targets": ["Ornithopter"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Ornithopter": [4, 4] },
      "players": [{ "hand_count": 1 }, {}]
    }
  },
  {
    "name": "ruling: an equipment that becomes a creature falls off the creature it was attached to",
    "players": [
      { "hand": ["Mightstone's Animation"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Bonesplitter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Mightstone's Animation", "targets": ["Bonesplitter"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2], "Bonesplitter": [4, 4] },
      "players": [{ "hand_count": 1 }, {}]
    }
  },
  {
    "name": "ruling: an animated equipment cannot be attached to another creature",
    "players": [
      { "hand": ["Mightstone's Animation"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Bonesplitter", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Mightstone's Animation", "targets": ["Bonesplitter"] },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "players": [{ "hand_count": 1 }, {}]
    }
  }
]
