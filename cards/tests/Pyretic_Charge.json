[
 { "name": "plot {3}{R} exiles it from hand; on a later turn it is cast free, discarding the hand (3 cards incl. the turn draw) and pumping by 3",
   "players": [ { "hand": ["Pyretic Charge", "Island", "Plains"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Pyretic Charge", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" }, { "cast": "Pyretic Charge", "alt": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 4, "graveyard_has": ["Pyretic Charge", "Island", "Plains"], "exile": [] }, {} ], "pt": { "Grizzly Bears": [5, 2] } } },
 { "name": "plot needs {3}{R}: with three Mountains the Charge cannot be plotted and stays in hand",
   "players": [ { "hand": ["Pyretic Charge"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Pyretic Charge", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "hand": ["Pyretic Charge"], "exile": [] }, {} ] } },
 { "name": "discards the hand, draws four, and pumps creatures by the number discarded",
   "players": [ { "hand": ["Pyretic Charge", "Island", "Plains"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Pyretic Charge" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 4, "graveyard": ["Pyretic Charge", "Island", "Plains"] }, {} ], "pt": { "Grizzly Bears": [4, 2] } } },
 { "name": "empty hand after casting: nothing discarded, no pump",
   "players": [ { "hand": ["Pyretic Charge"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Pyretic Charge" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 4 }, {} ], "pt": { "Grizzly Bears": [2, 2] } } },
 { "name": "ruling: a plotted card cannot be cast on the turn it was plotted",
   "players": [ { "hand": ["Pyretic Charge"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Pyretic Charge", "ability": 0 }, { "resolve": true }, { "cast": "Pyretic Charge", "alt": 0, "illegal": true } ],
   "expect": { "players": [ { "hand_count": 0, "exile": ["Pyretic Charge"] }, {} ] } },
 { "name": "ruling: a creature that enters after the Charge resolves is not pumped by it",
   "players": [ { "hand": ["Pyretic Charge", "Lightning Bolt", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Hill Giant"], "library": ["Mogg Assassin"] }, {} ],
   "steps": [ { "cast": "Pyretic Charge" }, { "resolve": true }, { "cast": "Mogg Assassin" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant", "Mogg Assassin"] }, {} ], "pt": { "Hill Giant": [5, 3], "Mogg Assassin": [2, 1] } } }
]
