[
  {
    "name": "opposing creatures get -1/-0",
    "players": [
      { "hand": ["Cumber Stone"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Cumber Stone" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Cumber Stone"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "pt": { "Grizzly Bears": [1, 2] }
    }
  },
  {
    "name": "your own creatures are unaffected",
    "players": [
      { "hand": ["Cumber Stone"], "battlefield": ["Island", "Island", "Island", "Island", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Cumber Stone" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Cumber Stone", "Hill Giant"] }, {} ],
      "pt": { "Hill Giant": [3, 3] }
    }
  }
]
