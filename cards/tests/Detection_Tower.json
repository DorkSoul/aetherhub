[
 {
  "name": "after activating, Doom Blade can target a hexproof creature",
  "players": [
   { "hand": ["Doom Blade"], "battlefield": ["Detection Tower", "Island", "Swamp", "Swamp"] },
   { "battlefield": ["Arboretum Elemental"] }
  ],
  "steps": [
   { "activate": "Detection Tower", "ability": 0 },
   { "resolve": true },
   { "cast": "Doom Blade", "targets": ["Arboretum Elemental"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Doom Blade"] }, { "graveyard": ["Arboretum Elemental"] } ] }
 },
 {
  "name": "without activating, hexproof stops Doom Blade",
  "players": [
   { "hand": ["Doom Blade"], "battlefield": ["Detection Tower", "Island", "Swamp", "Swamp"] },
   { "battlefield": ["Arboretum Elemental"] }
  ],
  "steps": [
   { "cast": "Doom Blade", "targets": ["Arboretum Elemental"], "illegal": true }
  ],
  "expect": { "players": [ { "hand": ["Doom Blade"] }, { "battlefield": ["Arboretum Elemental"] } ] }
 },
 {
  "name": "after activating, Duress can target an opponent with hexproof",
  "players": [
   { "hand": ["Duress"], "battlefield": ["Detection Tower", "Island", "Swamp"] },
   { "hand": ["Shock"], "battlefield": ["Leyline of Sanctity"] }
  ],
  "steps": [
   { "activate": "Detection Tower", "ability": 0 },
   { "resolve": true },
   { "cast": "Duress", "targets": ["p1"] },
   { "resolve": true, "answers": ["Shock"] }
  ],
  "expect": { "players": [ { "graveyard": ["Duress"] }, { "graveyard": ["Shock"] } ] }
 },
 {
  "name": "without activating, an opponent with hexproof can't be targeted by Duress",
  "players": [
   { "hand": ["Duress"], "battlefield": ["Detection Tower", "Island", "Swamp"] },
   { "hand": ["Shock"], "battlefield": ["Leyline of Sanctity"] }
  ],
  "steps": [
   { "cast": "Duress", "targets": ["p1"], "illegal": true }
  ],
  "expect": { "players": [ { "hand": ["Duress"] }, { "hand": ["Shock"] } ] }
 },
 {
  "name": "the effect lets only its controller ignore hexproof",
  "players": [
   { "battlefield": ["Detection Tower", "Island", "Leyline of Sanctity", "Arboretum Elemental"] },
   { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "activate": "Detection Tower", "ability": 0 },
   { "resolve": true },
   { "pass": true },
   { "cast": "Doom Blade", "player": 1, "targets": ["Arboretum Elemental"], "illegal": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Arboretum Elemental"] }, { "hand": ["Doom Blade"] } ] }
 },
 {
  "name": "ruling: after activating, Unsummon can target a creature with hexproof from blue",
  "players": [
   { "hand": ["Unsummon"], "battlefield": ["Detection Tower", "Island", "Island"] },
   { "battlefield": ["Sporeweb Weaver"] }
  ],
  "steps": [
   { "activate": "Detection Tower", "ability": 0 },
   { "resolve": true },
   { "cast": "Unsummon", "targets": ["Sporeweb Weaver"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Unsummon"] }, { "hand": ["Sporeweb Weaver"] } ] }
 },
 {
  "name": "ruling: without activating, hexproof from blue stops Unsummon",
  "players": [
   { "hand": ["Unsummon"], "battlefield": ["Detection Tower", "Island", "Island"] },
   { "battlefield": ["Sporeweb Weaver"] }
  ],
  "steps": [
   { "cast": "Unsummon", "targets": ["Sporeweb Weaver"], "illegal": true }
  ],
  "expect": { "players": [ { "hand": ["Unsummon"] }, { "battlefield": ["Sporeweb Weaver"] } ] }
 },
 {
  "name": "ruling: the opponent's creature keeps its hexproof after activating",
  "players": [
   { "battlefield": ["Detection Tower", "Island"] },
   { "battlefield": ["Arboretum Elemental"] }
  ],
  "steps": [
   { "activate": "Detection Tower", "ability": 0 },
   { "resolve": true }
  ],
  "expect": { "players": [ {}, {} ], "keywords": { "Arboretum Elemental": ["Hexproof"] } }
 }
]
