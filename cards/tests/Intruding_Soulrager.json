[
  {
    "name": "tap and sacrifice a Room: 2 damage to each opponent and draw a card",
    "players": [
      {
        "battlefield": ["Intruding Soulrager", "Bottomless Pool // Locker Room"],
        "library": ["Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Intruding Soulrager" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Forest"],
          "library_count": 1,
          "battlefield_has": ["Intruding Soulrager"],
          "battlefield_lacks": ["Bottomless Pool // Locker Room"],
          "graveyard_has": ["Bottomless Pool // Locker Room"]
        },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "no Room to sacrifice: the ability cannot be activated",
    "players": [
      { "battlefield": ["Intruding Soulrager", "Island"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Intruding Soulrager", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Intruding Soulrager"], "library_count": 1 },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "summoning sick: the {T} cost cannot be paid even with a Room to sacrifice",
    "players": [
      {
        "battlefield": [{ "name": "Intruding Soulrager", "sick": true }, "Bottomless Pool // Locker Room"],
        "library": ["Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Intruding Soulrager", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Intruding Soulrager", "Bottomless Pool // Locker Room"] },
        { "life": 20 }
      ]
    }
  }
]
