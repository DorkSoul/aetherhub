[
  {
    "name": "kicked: returns target permanent to its owner's hand",
    "players": [
      { "hand": ["Urborg Emissary"], "battlefield": ["Swamp", "Swamp", "Swamp", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Urborg Emissary", "answers": [true] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Urborg Emissary"] },
        { "battlefield_lacks": ["Grizzly Bears"], "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "unkicked: no bounce trigger",
    "players": [
      { "hand": ["Urborg Emissary"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Urborg Emissary" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Urborg Emissary"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a Clone copying a kicked Urborg Emissary enters unkicked, so its bounce does not trigger",
    "players": [
      { "hand": ["Urborg Emissary", "Clone"], "battlefield": ["Swamp", "Swamp", "Swamp", "Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Urborg Emissary", "answers": [true] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Clone" },
      { "resolve": true, "answers": [0] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Urborg Emissary", "Urborg Emissary"] },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a creature put onto the battlefield with Animate Dead is not kicked, so no bounce trigger",
    "players": [
      { "hand": ["Animate Dead"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"], "graveyard": ["Urborg Emissary"] }
    ],
    "steps": [
      { "cast": "Animate Dead", "targets": ["Urborg Emissary"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Animate Dead", "Urborg Emissary"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
