[
  {
    "name": "strive: the two-target cast uses all six Mountains, so a Lightning Bolt afterwards has no mana",
    "players": [
      { "hand": ["Harness by Force", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Harness by Force", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Hill Giant"], "hand": ["Lightning Bolt"] },
        { "battlefield_lacks": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "two targets cost {1}{R}{R} + {2}{R}: gain control of both until end of turn",
    "players": [
      { "hand": ["Harness by Force"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Harness by Force", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Hill Giant"] },
        { "battlefield_lacks": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "one target costs only {1}{R}{R}: only that creature is stolen",
    "players": [
      { "hand": ["Harness by Force"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Harness by Force", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: strive spell may be cast with no targets at the base cost; nothing happens",
    "players": [
      { "hand": ["Harness by Force"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Harness by Force", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Harness by Force"], "battlefield_lacks": ["Grizzly Bears"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: when one of two targets is gone at resolution, the other is still stolen",
    "players": [
      { "hand": ["Harness by Force", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Harness by Force", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Harness by Force", "Lightning Bolt"] },
        { "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: Harness by Force can target a creature you already control",
    "players": [
      { "hand": ["Harness by Force"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Harness by Force", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Harness by Force"] },
        {}
      ]
    }
  }
]
