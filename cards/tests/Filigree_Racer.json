  {
    "name": "ruling: a sorcery with jump-start cannot be cast during combat, but can in a main phase",
    "players": [
      {
        "battlefield": ["Filigree Racer", "Grizzly Bears", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"],
