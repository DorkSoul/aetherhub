    "steps": [
      { "activate": "Bespoke Battlewagon", "ability": 0 },
      { "resolve": true },
      { "activate": "Filigree Racer", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Filigree Racer", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "cast": "Lightning Bolt", "alt": 100, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "energy": 0, "exile": ["Lightning Bolt"], "graveyard": ["Forest"], "hand": [] },
        { "life": 17 }
      ]
    }
  },
  {
