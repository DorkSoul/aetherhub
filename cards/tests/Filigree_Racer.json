  {
    "name": "attacking: pay two energy to give an instant in your graveyard jump-start (cast it by discarding a card)",
    "players": [
      {
        "battlefield": ["Filigree Racer", "Grizzly Bears", "Bespoke Battlewagon", "Mountain"],
        "graveyard": ["Lightning Bolt"],
        "hand": ["Forest"]
