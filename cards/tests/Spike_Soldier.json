[
  {
    "name": "enters with three +1/+1 counters",
    "players": [
      { "hand": ["Spike Soldier"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Spike Soldier" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Spike Soldier": { "p1p1": 3 } },
      "pt": { "Spike Soldier": [3, 3] }
    }
  },
  {
    "name": "remove a counter: +2/+2 until end of turn",
    "players": [
      { "battlefield": [{ "name": "Spike Soldier", "counters": { "p1p1": 3 } }] },
      {}
    ],
    "steps": [
      { "activate": "Spike Soldier", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Spike Soldier": { "p1p1": 2 } },
      "pt": { "Spike Soldier": [4, 4] }
    }
  },
  {
    "name": "{2}, remove a counter: put a +1/+1 counter on target creature",
    "players": [
      { "battlefield": ["Forest", "Forest", { "name": "Spike Soldier", "counters": { "p1p1": 3 } }, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Spike Soldier", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Spike Soldier": { "p1p1": 2 }, "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3] }
    }
  }
]
