[
  {
    "name": "enchanted creature that is dealt damage is destroyed",
    "players": [ { "hand": ["Mortal Wound"], "battlefield": ["Forest", "Moss Kami"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Mortal Wound", "targets": ["Moss Kami"] }, { "resolve": true }, { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["Moss Kami"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Moss Kami", "Mortal Wound"] }, {} ] }
  },
  {
    "name": "not destroyed while no damage is dealt",
    "players": [ { "hand": ["Mortal Wound"], "battlefield": ["Forest", "Moss Kami"] }, {} ],
    "steps": [ { "cast": "Mortal Wound", "targets": ["Moss Kami"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Moss Kami", "Mortal Wound"] }, {} ], "attached": { "Mortal Wound": "Moss Kami" } }
  }
]
