[
  { "name": "ETB destroys the target land and puts three counters on one other creature (answers unused for one target)",
    "players": [ { "hand": ["Rhino, Terrible Trampler"], "battlefield": ["Forest", "Forest", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Plains"] } ],
    "steps": [ { "cast": "Rhino, Terrible Trampler" }, { "resolve": true, "targets": ["Plains", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Rhino, Terrible Trampler", "Grizzly Bears"] }, { "graveyard_has": ["Plains"] } ],
                "counters": { "Grizzly Bears": { "PlusOnePlusOne": 3 } }, "keywords": { "Grizzly Bears": ["Trample"] } } },
  { "name": "with no other creature to target, the counters are not placed on the destroyed land",
    "players": [ { "hand": ["Rhino, Terrible Trampler"], "battlefield": ["Forest", "Forest", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Plains"] } ],
    "steps": [ { "cast": "Rhino, Terrible Trampler" }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Rhino, Terrible Trampler"] }, { "graveyard_has": ["Plains"] } ] } }
]
