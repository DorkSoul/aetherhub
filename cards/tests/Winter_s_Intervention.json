[
  {
    "name": "2 damage to a creature and gain 2 life",
    "players": [
      { "hand": ["Winter's Intervention"], "battlefield": ["Swamp", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Winter's Intervention", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 22 }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "cannot be cast without a creature target",
    "players": [
      { "hand": ["Winter's Intervention"], "battlefield": ["Swamp", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Winter's Intervention", "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "ruling: an illegal target on resolution means no damage and no life gain",
    "players": [
      { "hand": ["Winter's Intervention"], "battlefield": ["Swamp", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] }
    ],
    "steps": [
      { "cast": "Winter's Intervention", "targets": ["p1:Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Winter's Intervention"] },
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  }
]
