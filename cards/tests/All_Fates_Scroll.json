[
 {"name": "taps for mana of any color",
  "players": [{"battlefield": ["All-Fates Scroll"]}, {}],
  "steps": [{"tap_for_mana": "All-Fates Scroll", "color": "U"}],
  "expect": {"players": [{"pool": {"U": 1}}, {}]}},
 {"name": "seven mana, tap and sacrifice draws one card per differently named land",
  "players": [{"battlefield": ["All-Fates Scroll", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Plains", "Swamp"]}, {}],
  "steps": [{"activate": "All-Fates Scroll", "ability": 0}, {"resolve": true}],
  "expect": {"players": [{"hand_count": 3, "battlefield_lacks": ["All-Fates Scroll"], "graveyard_has": ["All-Fates Scroll"]}, {}]}},
 {"name": "eight Forests draw only one card (same name)",
  "players": [{"battlefield": ["All-Fates Scroll", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}, {}],
  "steps": [{"activate": "All-Fates Scroll", "ability": 0}, {"resolve": true}],
  "expect": {"players": [{"hand_count": 1, "graveyard_has": ["All-Fates Scroll"]}, {}]}},
 {"name": "cannot activate with only six other mana",
  "players": [{"battlefield": ["All-Fates Scroll", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"]}, {}],
  "steps": [{"activate": "All-Fates Scroll", "ability": 0, "illegal": true}],
  "expect": {"players": [{"battlefield_has": ["All-Fates Scroll"], "hand_count": 0}, {}]}},
 {"name": "ruling: lands are counted by English name (Forest and Snow-Covered Forest are different; repeated names count once)",
  "players": [{"battlefield": ["All-Fates Scroll", "Forest", "Snow-Covered Forest", "Mountain", "Mountain", "Island", "Island", "Plains", "Plains"]}, {}],
  "steps": [{"activate": "All-Fates Scroll", "ability": 0}, {"resolve": true}],
  "expect": {"players": [{"hand_count": 5, "graveyard_has": ["All-Fates Scroll"]}, {}]}}
]
