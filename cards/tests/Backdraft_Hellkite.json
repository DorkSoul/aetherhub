 {
  "name": "ruling: the flashback grant still resolves after Backdraft Hellkite leaves the battlefield",
  "players": [
   {
    "battlefield": ["Backdraft Hellkite", "Mountain"],
    "graveyard": ["Lightning Bolt"]
   },
   {
    "hand": ["Lightning Bolt", "Shock"],
    "battlefield": ["Mountain", "Mountain"]
   }
  ],
  "steps": [
   { "attack": [ { "card": "Backdraft Hellkite", "at": "p1" } ], "auto": true },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Backdraft Hellkite"] },
   { "pass": true },
   { "cast": "Shock", "player": 1, "targets": ["Backdraft Hellkite"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_lacks": ["Backdraft Hellkite"], "exile": ["Lightning Bolt"] },
    { "life": 17, "graveyard_has": ["Shock"] }
   ]
  }
 },
 {
  "name": "ruling: flashback from the attack grant is still sorcery-speed; it works again in the main phase",
  "players": [
   {
    "battlefield": ["Backdraft Hellkite", "Island", "Island", "Island"],
    "graveyard": ["Divination"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Backdraft Hellkite", "at": "p1" } ], "auto": true },
   { "resolve": true },
   { "cast": "Divination", "illegal": true },
   { "advance_to": "Main2" },
   { "cast": "Divination" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Divination"], "battlefield_has": ["Backdraft Hellkite"] },
    { "life": 16 }
   ]
  }
 },
 {
  "name": "ruling: an instant put into the graveyard after the attack trigger resolved gets no flashback",
  "players": [
   {
    "hand": ["Shock"],
    "battlefield": ["Backdraft Hellkite", "Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Backdraft Hellkite", "at": "p1" } ], "auto": true },
   { "resolve": true },
   { "cast": "Shock", "targets": ["p1"] },
   { "resolve": true },
   { "cast": "Shock", "targets": ["p1"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Shock"], "battlefield_has": ["Backdraft Hellkite"] },
    { "life": 18 }
   ]
  }
 }
