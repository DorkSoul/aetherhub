[
  {
    "name": "you control the enchanted enchantment and get its effect",
    "players": [
      { "hand": ["Steal Enchantment"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      { "battlefield": ["Glorious Anthem", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Steal Enchantment", "targets": ["Glorious Anthem"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Steal Enchantment": "Glorious Anthem" },
      "players": [
        { "battlefield": ["Island", "Island", "Grizzly Bears", "Steal Enchantment", "Glorious Anthem"] },
        { "battlefield": ["Hill Giant"] }
      ],
      "pt": { "Grizzly Bears": [3, 3], "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "enchant enchantment: cannot target a creature",
    "players": [
      { "hand": ["Steal Enchantment"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Steal Enchantment", "targets": ["Hill Giant"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Steal Enchantment"] }, { "battlefield": ["Hill Giant"] } ]
    }
  },
  {
    "name": "ruling: a stolen Pacifism stays on the same creature; nothing is re-chosen",
    "players": [
      { "hand": ["Steal Enchantment"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
      { "hand": ["Pacifism"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "player": 1, "cast": "Pacifism", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Steal Enchantment", "targets": ["Pacifism"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Pacifism": "Grizzly Bears" },
      "players": [
        { "battlefield": ["Island", "Island", "Grizzly Bears", "Steal Enchantment", "Pacifism"] },
        { "battlefield": ["Plains", "Plains"] }
      ]
    }
  }
]
