[
  {
    "name": "madness: discarded to Wild Guess, pay 1B, cast it; ETB returns a creature card from a graveyard",
    "players": [
      {
        "hand": [
          "Wild Guess",
          "Grave Scrabbler"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Swamp",
          "Swamp"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Wild Guess"
      },
      {
        "resolve": true,
        "answers": [
          true,
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grave Scrabbler"
          ],
          "hand_count": 3
        },
        {}
      ]
    }
  },
  {
    "name": "cast normally from hand: madness cost not paid, no return",
    "players": [
      {
        "hand": [
          "Grave Scrabbler"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Swamp"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grave Scrabbler"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grave Scrabbler"
          ],
          "graveyard": [
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  { "name": "ruling: declining the madness cast sends the discarded card to the graveyard",
    "players": [ { "hand": ["Wild Guess", "Grave Scrabbler"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard_has": ["Grave Scrabbler"], "battlefield_lacks": ["Grave Scrabbler"], "exile": [], "hand_count": 2 }, {} ] } },
  { "name": "ruling: madness cost counts as paid even when Sphere of Resistance adds 1 to the total",
    "players": [ { "hand": ["Wild Guess", "Grave Scrabbler"], "battlefield": ["Sphere of Resistance", "Mountain", "Mountain", "Mountain", "Swamp", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [true, true] } ],
    "expect": { "players": [ { "battlefield_has": ["Grave Scrabbler"], "hand_count": 3 }, {} ] } },
  { "name": "ruling: a madness card discarded still counts as discarded (opponent's Waste Not makes a Zombie)",
    "players": [ { "hand": ["Wild Guess", "Grave Scrabbler"], "battlefield": ["Mountain", "Mountain", "Swamp", "Swamp"] }, { "battlefield": ["Waste Not", "Swamp"] } ],
    "steps": [ { "cast": "Wild Guess" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard_has": ["Grave Scrabbler"], "battlefield_lacks": ["Grave Scrabbler"] }, { "battlefield_has": ["Waste Not", "Zombie"] } ] } }
]