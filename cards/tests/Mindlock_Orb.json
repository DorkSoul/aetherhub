[
  { "name": "Mindlock Orb stops your own search: nothing is fetched",
    "players": [ { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Forest", "Mindlock Orb"], "library": ["Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Rampant Growth" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Mountain"], "graveyard": ["Rampant Growth"] }, {} ] } },
  { "name": "Mindlock Orb controlled by an opponent also stops your search",
    "players": [ { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Forest"], "library": ["Mountain", "Forest"] }, { "battlefield": ["Mindlock Orb"] } ],
    "steps": [ { "cast": "Rampant Growth" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Mountain"] }, {} ] } },
  { "name": "without Mindlock Orb the search still fetches a basic land",
    "players": [ { "hand": ["Rampant Growth"], "battlefield": ["Forest", "Forest"], "library": ["Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Rampant Growth" }, { "resolve": true, "answers": ["Mountain"] } ],
    "expect": { "players": [ { "battlefield_has": ["Mountain"] }, {} ] } },
  { "name": "Mindlock Orb: Enlightened Tutor's only artifact is not searched for, the library top is unchanged",
    "players": [ { "hand": ["Enlightened Tutor"], "battlefield": ["Plains", "Mindlock Orb"], "library": ["Grizzly Bears", "Sol Ring"] }, {} ],
    "steps": [ { "cast": "Enlightened Tutor" }, { "resolve": true } ],
    "expect": { "players": [ { "library_top": ["Forest"] }, {} ] } },
  { "name": "ruling: revealing the top card still works with Mindlock Orb (a reveal is not a search)",
    "players": [ { "battlefield": [ { "name": "Djinn of Wishes", "counters": { "Wish": 3 } }, "Island", "Island", "Island", "Island", "Mindlock Orb" ], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Djinn of Wishes", "ability": 0 }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } }
]
