[
  {
    "name": "exchanges your land for the opponent's land on entering",
    "players": [
      {
        "hand": [
          "Vedalken Plotter"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Mountain",
          "Swamp"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Vedalken Plotter"
      },
      {
        "resolve": true,
        "targets": [
          "Forest",
          "Mountain"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Mountain",
            "Island"
          ],
          "battlefield_lacks": [
            "Forest"
          ]
        },
        {
          "battlefield_has": [
            "Forest",
            "Swamp"
          ],
          "battlefield_lacks": [
            "Mountain"
          ]
        }
      ]
    }
  },
  {
    "name": "exchange is permanent after the Plotter leaves",
    "players": [
      {
        "hand": [
          "Vedalken Plotter",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Mountain",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Vedalken Plotter"
      },
      {
        "resolve": true,
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Vedalken Plotter"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Plains"
          ],
          "graveyard": [
            "Vedalken Plotter",
            "Lightning Bolt"
          ]
        },
        {
          "battlefield_has": [
            "Forest"
          ],
          "battlefield_lacks": [
            "Plains"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: if your target land is destroyed in response, the exchange does not happen",
    "players": [
      {
        "hand": [
          "Vedalken Plotter"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Mountain",
          "Swamp",
          "Strip Mine"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Vedalken Plotter"
      },
      {
        "pass": true
      },
      {
        "pass": true,
        "targets": [
          "Forest",
          "Mountain"
        ]
      },
      {
        "activate": "Strip Mine",
        "player": 1,
        "targets": [
          "Forest"
        ]
      },
      {
        "pass": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Vedalken Plotter",
            "Island"
          ],
          "battlefield_lacks": [
            "Forest",
            "Mountain"
          ],
          "graveyard": [
            "Forest"
          ]
        },
        {
          "battlefield_has": [
            "Mountain",
            "Swamp"
          ],
          "battlefield_lacks": [
            "Strip Mine",
            "Forest"
          ],
          "graveyard": [
            "Strip Mine"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: if the opponent's target land is destroyed in response, the exchange does not happen",
    "players": [
      {
        "hand": [
          "Vedalken Plotter"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Forest",
          "Strip Mine"
        ]
      },
      {
        "battlefield": [
          "Mountain",
          "Swamp"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Vedalken Plotter"
      },
      {
        "pass": true
      },
      {
        "activate": "Strip Mine",
        "targets": [
          "Forest",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "pass": true
      },
      {
        "pass": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Vedalken Plotter",
            "Forest"
          ],
          "battlefield_lacks": [
            "Mountain"
          ]
        },
        {
          "battlefield_has": [
            "Swamp"
          ],
          "battlefield_lacks": [
            "Mountain",
            "Forest"
          ]
        }
      ]
    }
  }
]
