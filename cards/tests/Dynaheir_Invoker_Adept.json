[
 { "name": "the next ability activated with four mana is copied",
   "players": [ { "battlefield": ["Dynaheir, Invoker Adept", "Ant-Man, Scott Lang", "Forest", "Mountain", "Island", "Plains"] }, {} ],
   "steps": [ { "activate": "Dynaheir, Invoker Adept" }, { "resolve": true },
              { "activate": "Ant-Man, Scott Lang" }, { "resolve": true } ],
   "expect": { "counters": { "Ant-Man, Scott Lang": { "p1p1": 2 } } } },
 { "name": "without the delayed trigger there is no copy",
   "players": [ { "battlefield": ["Dynaheir, Invoker Adept", "Ant-Man, Scott Lang", "Forest", "Mountain", "Island", "Plains"] }, {} ],
   "steps": [ { "activate": "Ant-Man, Scott Lang" }, { "resolve": true } ],
   "expect": { "counters": { "Ant-Man, Scott Lang": { "p1p1": 1 } } } },
 { "name": "an ability activated with fewer than four mana is not copied and the trigger waits",
   "players": [ { "battlefield": ["Dynaheir, Invoker Adept", "Dragon Engine", "Ant-Man, Scott Lang", "Forest", "Mountain", "Island", "Plains", "Swamp", "Forest"] }, {} ],
   "steps": [ { "activate": "Dynaheir, Invoker Adept" }, { "resolve": true },
              { "activate": "Dragon Engine" }, { "resolve": true },
              { "activate": "Ant-Man, Scott Lang" }, { "resolve": true } ],
   "expect": { "counters": { "Ant-Man, Scott Lang": { "p1p1": 2 } } } },
 { "name": "other creatures can use {T} abilities while summoning sick",
   "players": [ { "battlefield": ["Dynaheir, Invoker Adept", { "name": "Llanowar Elves", "sick": true }] }, {} ],
   "steps": [ { "tap_for_mana": "Llanowar Elves" } ],
   "expect": { "players": [ { "pool": { "G": 1 } }, {} ] } },
 { "name": "ruling: Dynaheir does not grant haste, so a summoning-sick creature still cannot attack",
   "players": [ { "battlefield": ["Dynaheir, Invoker Adept", { "name": "Grizzly Bears", "sick": true }] }, {} ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 20 } ] } }
]
