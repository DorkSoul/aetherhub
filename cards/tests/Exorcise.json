[
  {
    "name": "exiles a creature with power 4 or greater",
    "players": [ { "hand": ["Exorcise"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Exorcise", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": {
      "players": [ {}, { "battlefield_lacks": ["Serra Angel"] } ]
    }
  },
  {
    "name": "an artifact can be exiled regardless of its power",
    "players": [ { "hand": ["Exorcise"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Exorcise", "targets": ["Sol Ring"] }, { "resolve": true } ],
    "expect": {
      "players": [ {}, { "battlefield_lacks": ["Sol Ring"] } ]
    }
  },
  {
    "name": "a creature with power under 4 is not a legal target",
    "players": [ { "hand": ["Exorcise"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Exorcise", "illegal": true } ],
    "expect": {
      "players": [ { "hand": ["Exorcise"] }, { "battlefield_has": ["Hill Giant"] } ]
    }
  }
]
