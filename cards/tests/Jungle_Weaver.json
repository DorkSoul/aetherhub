[
  { "name": "cycling for {2} draws a card",
    "players": [
      { "hand": ["Jungle Weaver"], "battlefield": ["Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Jungle Weaver", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "graveyard": ["Jungle Weaver"] }, {} ]
    }
  },
  { "name": "cannot cycle with only one land",
    "players": [
      { "hand": ["Jungle Weaver"], "battlefield": ["Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Jungle Weaver", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Jungle Weaver"] }, {} ]
    }
  },
  { "name": "ruling: cycling is an ability, not a spell, so a counterspell cannot respond to it",
    "players": [
      { "hand": ["Jungle Weaver"], "battlefield": ["Plains", "Plains"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "activate": "Jungle Weaver", "ability": 0 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "graveyard": ["Jungle Weaver"] }, { "hand": ["Counterspell"] } ]
    }
  }
]
