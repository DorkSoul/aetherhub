[
  {
    "name": "removing the counter draws a card for each permanent you control",
    "players": [
      { "battlefield": [ { "name": "Myojin of Seeing Winds", "counters": { "divinity": 1 } }, "Island", "Island" ] },
      {}
    ],
    "steps": [
      { "activate": "Myojin of Seeing Winds", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 3, "battlefield_has": ["Myojin of Seeing Winds"] }, {} ],
      "counters": { "Myojin of Seeing Winds": { "divinity": 0 } }
    }
  },
  {
    "name": "enters with a divinity counter when cast from hand",
    "players": [
      { "hand": ["Myojin of Seeing Winds"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Seeing Winds" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Seeing Winds"] }, {} ],
      "counters": { "Myojin of Seeing Winds": { "divinity": 1 } }
    }
  },
  {
    "name": "indestructible while it has a counter: Murder does not destroy it",
    "players": [
      { "battlefield": [ { "name": "Myojin of Seeing Winds", "counters": { "divinity": 1 } } ] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Seeing Winds"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Seeing Winds"] }, {} ],
      "counters": { "Myojin of Seeing Winds": { "divinity": 1 } }
    }
  },
  {
    "name": "without a counter Murder destroys it",
    "players": [
      { "battlefield": ["Myojin of Seeing Winds"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Seeing Winds"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Myojin of Seeing Winds"] }, {} ] }
  },
  {
    "name": "ruling: cast from the command zone in a Commander game is not cast from hand, so no divinity counter",
    "commander": true,
    "players": [
      { "command": ["Myojin of Seeing Winds"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Seeing Winds" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Seeing Winds"] }, {} ],
      "counters": { "Myojin of Seeing Winds": { "divinity": 0 } }
    }
  }
]
