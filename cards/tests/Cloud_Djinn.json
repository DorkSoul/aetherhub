[
 {
  "name": "cannot block a creature without flying",
  "players": [
   { "battlefield": ["Grizzly Bears"] },
   { "battlefield": ["Cloud Djinn"] }
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [{}, { "life": 18, "battlefield_has": ["Cloud Djinn"] }]
  }
 },
 {
  "name": "can block a creature with flying",
  "players": [
   { "battlefield": ["Cloud Spirit"] },
   { "battlefield": ["Cloud Djinn"] }
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "attack": [{ "card": "Cloud Spirit", "at": "p1" }] },
   { "block": [{ "blocker": "Cloud Djinn", "attacker": "Cloud Spirit" }] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Cloud Spirit"] },
    { "battlefield_has": ["Cloud Djinn"], "life": 20 }
   ]
  }
 },
 {
  "name": "cannot block a non-flyer even when declared: the attacker is unblocked",
  "players": [
   { "battlefield": ["Grizzly Bears"] },
   { "battlefield": ["Cloud Djinn", "Hill Giant"] }
  ],
  "steps": [
   { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
   { "block": [{ "blocker": "Cloud Djinn", "attacker": "Grizzly Bears" }], "player": 1 },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [{}, { "life": 18, "battlefield_has": ["Cloud Djinn"] }]
  }
 }
]
