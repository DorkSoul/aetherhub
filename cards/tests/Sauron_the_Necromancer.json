      { "battlefield": ["Sauron, the Necromancer"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Sauron, the Necromancer", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "End" }
