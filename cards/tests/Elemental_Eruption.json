[
  {
    "name": "creates a 4/4 flying prowess Dragon Elemental",
    "players": [ { "hand": ["Elemental Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Elemental Eruption" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Dragon Elemental 4-4 Flying Prowess"], "graveyard": ["Elemental Eruption"] }, {} ],
      "pt": { "Dragon Elemental 4-4 Flying Prowess": [4, 4] },
      "keywords": { "Dragon Elemental 4-4 Flying Prowess": ["Flying", "Prowess"] }
    }
  },
  {
    "name": "storm copies the spell once for one earlier spell",
    "players": [ { "hand": ["Elemental Eruption", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Elemental Eruption" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Dragon Elemental 4-4 Flying Prowess"], "graveyard": ["Elemental Eruption", "Lightning Bolt"] }, { "life": 17 } ],
      "pt": { "Dragon Elemental 4-4 Flying Prowess": [4, 4] }
    }
  },
  {
    "name": "ruling: a countered spell still counts for storm, so Elemental Eruption copies it once",
    "players": [
      { "hand": ["Lightning Bolt", "Elemental Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
      { "resolve": true },
      { "cast": "Elemental Eruption" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dragon Elemental 4-4 Flying Prowess", "Dragon Elemental 4-4 Flying Prowess"], "graveyard": ["Elemental Eruption", "Lightning Bolt"] },
        { "life": 20, "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "ruling: copies go straight onto the stack, so a later storm spell does not count them",
    "players": [
      { "hand": ["Lightning Bolt", "Elemental Eruption", "Elemental Eruption"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Elemental Eruption" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Elemental Eruption" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dragon Elemental 4-4 Flying Prowess", "Dragon Elemental 4-4 Flying Prowess", "Dragon Elemental 4-4 Flying Prowess", "Dragon Elemental 4-4 Flying Prowess", "Dragon Elemental 4-4 Flying Prowess"], "graveyard": ["Elemental Eruption", "Elemental Eruption", "Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  }
]
