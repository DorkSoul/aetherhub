 {
  "name": "pay {R} to end the attached effect: the counter is removed and the Licid is unattached",
  "players": [
   {
    "battlefield": [
     {
      "name": "Convulsing Licid",
      "sick": false
     },
     "Mountain",
     "Mountain"
    ]
   },
   {
    "battlefield": [
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   { "activate": "Convulsing Licid", "ability": 0 },
   { "resolve": true },
   { "activate": "Convulsing Licid", "ability": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Convulsing Licid"] },
    { "battlefield_has": ["Hill Giant"] }
   ],
   "counters": { "Convulsing Licid": { "other": 0 } }
  }
 },
 {
  "name": "no counter on the Licid: ending the attached effect is illegal",
  "players": [
