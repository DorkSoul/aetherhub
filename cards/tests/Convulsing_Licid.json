  ],
  "steps": [
   { "activate": "Convulsing Licid", "ability": 1, "illegal": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Convulsing Licid"] }, {} ]
  }
 },
 {
  "name": "Licid on the opposing Hill Giant: it can't block, so the attacker is unblocked",
  "players": [
   { "battlefield": [ { "name": "Convulsing Licid", "sick": false }, "Mountain", { "name": "Grizzly Bears", "sick": false } ] },
   { "battlefield": [ "Hill Giant", "Llanowar Elves" ] }
  ],
  "steps": [
   { "activate": "Convulsing Licid", "ability": 0, "targets": ["Hill Giant"] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 18 } ], "attached": { "Convulsing Licid": "Hill Giant" } }
 },
 {
  "name": "ruling: Clear on the attached Licid; paying {R} in response makes it a creature again so Clear fizzles",
  "players": [
   { "battlefield": [ { "name": "Convulsing Licid", "sick": false }, "Mountain", "Mountain" ] },
   { "hand": ["Clear"], "battlefield": ["Hill Giant", "Plains", "Plains"] }
  ],
  "steps": [
   { "activate": "Convulsing Licid", "ability": 0, "targets": ["Hill Giant"] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Clear", "player": 1, "targets": ["Convulsing Licid"] },
   { "activate": "Convulsing Licid", "ability": 1 },
   { "pass": true },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Convulsing Licid"] },
    { "graveyard_has": ["Clear"], "battlefield_has": ["Hill Giant"] }
   ],
   "counters": { "Convulsing Licid": { "other": 0 } }
  }
 },
 {
  "name": "ruling control: Clear on the attached Licid with no payment destroys it",
  "players": [
   { "battlefield": [ { "name": "Convulsing Licid", "sick": false }, "Mountain" ] },
   { "hand": ["Clear"], "battlefield": ["Hill Giant", "Plains", "Plains"] }
  ],
  "steps": [
   { "activate": "Convulsing Licid", "ability": 0, "targets": ["Hill Giant"] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Clear", "player": 1, "targets": ["Convulsing Licid"] },
   { "resolve": true }
