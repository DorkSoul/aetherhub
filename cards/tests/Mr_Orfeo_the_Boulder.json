[
  {
    "name": "doubles the power of target creature when you attack",
    "players": [ { "battlefield": ["Mr. Orfeo, the Boulder", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Mr. Orfeo, the Boulder", "at": "p1" } ] }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
    "expect": { "pt": { "Grizzly Bears": [4, 2] } }
  },
  {
    "name": "power is doubled with a larger creature",
    "players": [ { "battlefield": ["Mr. Orfeo, the Boulder", "Serra Angel"] }, {} ],
    "steps": [ { "attack": [ { "card": "Mr. Orfeo, the Boulder", "at": "p1" } ] }, { "resolve": true, "targets": ["Serra Angel"] } ],
    "expect": { "pt": { "Serra Angel": [8, 4] } }
  },
  {
    "name": "ruling: the doubling uses the power when the trigger resolves (pumped in response)",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Mr. Orfeo, the Boulder", "Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "attack": [ { "card": "Mr. Orfeo, the Boulder", "at": "p1" } ] }, { "cast": "Giant Growth", "targets": ["Grizzly Bears", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [10, 5] } }
  }
]
