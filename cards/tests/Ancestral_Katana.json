[
  {
    "name": "equip {3}: attaches to target creature you control (+2/+1)",
    "players": [ { "battlefield": ["Ancestral Katana", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Ancestral Katana", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 3] }, "attached": { "Ancestral Katana": "Grizzly Bears" } }
  },
  {
    "name": "a Warrior attacking alone: pay {1} to attach it",
    "players": [ { "battlefield": ["Ancestral Katana", "Plains", "Rhino Warrior"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Rhino Warrior", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Rhino Warrior": [6, 5] }, "attached": { "Ancestral Katana": "Rhino Warrior" } }
  },
  {
    "name": "a non-Samurai/Warrior attacking alone does not trigger",
    "players": [ { "battlefield": ["Ancestral Katana", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "ruling: declining the {1} means the Katana is not attached",
    "players": [ { "battlefield": ["Ancestral Katana", "Plains", "Rhino Warrior"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Rhino Warrior", "at": "p1" } ] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": { "pt": { "Rhino Warrior": [4, 4] } }
  },
  {
    "name": "ruling: a Warrior that attacks with another creature is not attacking alone: no trigger",
    "players": [ { "battlefield": ["Ancestral Katana", "Plains", "Rhino Warrior", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Rhino Warrior", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }
    ],
    "expect": { "stack_empty": true, "pt": { "Rhino Warrior": [4, 4] } }
  }
]
