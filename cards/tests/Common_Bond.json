  {
    "name": "may target the same creature twice",
    "players": [
      {
        "hand": [
          "Common Bond"
        ],
        "battlefield": [
          "Forest",
          "Plains",
          "Plains",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Common Bond",
        "targets": [
          "Grizzly Bears",
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Grizzly Bears": {
          "p1p1": 2
        }
      }
    }
  },
  {
    "name": "ruling: the same creature chosen twice gets two counters (4/4)",
    "players": [
      { "hand": ["Common Bond"], "battlefield": ["Forest", "Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Common Bond", "targets": ["Grizzly Bears", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "pt": { "Grizzly Bears": [4, 4] }
    }
  },
  {
    "name": "ruling: two different creatures each get one counter",
    "players": [
      { "hand": ["Common Bond"], "battlefield": ["Forest", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Common Bond", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 1 }, "Hill Giant": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3], "Hill Giant": [4, 4] }
    }
  }
