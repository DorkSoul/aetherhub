    "steps": [ { "activate": "Elven Passage" }, { "resolve": true, "answers": ["Forest", false] } ],
    "expect": { "tapped": { "Forest": true }, "players": [ { "life": 19, "hand": ["Elvish Mystic"], "graveyard": ["Elven Passage"], "battlefield_has": ["Forest"] }, {} ] } },
