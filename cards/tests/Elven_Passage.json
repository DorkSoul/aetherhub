  { "name": "ruling: Elven Chorus is not an Elf, so there is no Elf to behold and nothing is asked",
    "players": [ { "hand": ["Elven Chorus"], "battlefield": ["Elven Passage"], "library": ["Forest", "Mountain"] }, {} ],
    "steps": [ { "activate": "Elven Passage" }, { "resolve": true, "answers": ["Forest"] } ],
    "expect": { "tapped": { "Forest": true }, "players": [ { "life": 19, "hand": ["Elven Chorus"], "graveyard": ["Elven Passage"], "battlefield_has": ["Forest"] }, {} ] } }
