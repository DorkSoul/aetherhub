[
  {
    "name": "creates a Treasure",
    "players": [
      {
        "hand": [
          "Strike It Rich"
        ],
        "battlefield": [
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Strike It Rich"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Strike It Rich"
          ],
          "battlefield_has": [
            "Treasure"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "flashback exiles it and still makes a Treasure",
    "players": [
      {
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain"
        ],
        "graveyard": [
          "Strike It Rich"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Strike It Rich",
        "alt": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Strike It Rich"
          ],
          "battlefield_has": [
            "Treasure"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "flashback needs three mana",
    "players": [
      {
        "battlefield": [
          "Mountain",
          "Mountain"
        ],
        "graveyard": [
          "Strike It Rich"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Strike It Rich",
        "alt": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Strike It Rich"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a countered flashback spell is still exiled",
    "players": [
      {
        "battlefield": ["Mountain", "Mountain", "Mountain"],
        "graveyard": ["Strike It Rich"]
      },
      {
        "hand": ["Counterspell"],
        "battlefield": ["Island", "Island"]
      }
    ],
    "steps": [
      { "cast": "Strike It Rich", "alt": 0 },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Strike It Rich" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Strike It Rich"], "battlefield_lacks": ["Treasure"] },
        { "graveyard_has": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "ruling: flashback follows sorcery timing, so it is illegal during combat",
    "players": [
      {
        "battlefield": ["Mountain", "Mountain", "Mountain"],
        "graveyard": ["Strike It Rich"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Strike It Rich", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Strike It Rich"] }, {}]
    }
  }
]