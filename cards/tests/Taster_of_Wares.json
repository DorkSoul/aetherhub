    "steps": [ { "cast": "Taster of Wares" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "exile": ["Forest"] } ] } },
  { "name": "ruling: an exiled sorcery is cast in your main phase with an empty stack",
    "players": [ { "hand": ["Taster of Wares"], "battlefield": ["Swamp", "Swamp", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, { "hand": ["Raise Dead"] } ],
    "steps": [ { "cast": "Taster of Wares" }, { "resolve": true }, { "cast": "Raise Dead", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Taster of Wares"], "hand": ["Grizzly Bears"] }, { "graveyard": ["Raise Dead"] } ] } },
  { "name": "ruling: an exiled sorcery cannot be cast during the opponent's turn",
    "players": [ { "hand": ["Taster of Wares"], "battlefield": ["Swamp", "Swamp", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, { "hand": ["Raise Dead"] } ],
    "steps": [ { "cast": "Taster of Wares" }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Raise Dead", "targets": ["Grizzly Bears"], "player": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Taster of Wares"] }, { "exile": ["Raise Dead"] } ] } }
