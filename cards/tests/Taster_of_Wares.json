    "steps": [ { "cast": "Taster of Wares" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Taster of Wares"] }, { "life": 17, "hand_count": 0 } ] } },
  { "name": "a land is exiled but can't be cast",
