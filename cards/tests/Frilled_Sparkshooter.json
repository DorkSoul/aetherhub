[
  {
    "name": "enters with a +1/+1 counter when an opponent lost life this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Frilled Sparkshooter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Frilled Sparkshooter" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Frilled Sparkshooter": { "p1p1": 1 } },
      "pt": { "Frilled Sparkshooter": [4, 4] }
    }
  },
  {
    "name": "losing life yourself does not count",
    "players": [
      { "hand": ["Lightning Bolt", "Frilled Sparkshooter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Frilled Sparkshooter" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Frilled Sparkshooter": [3, 3] }
    }
  },
  {
    "name": "no life lost this turn: no counter",
    "players": [
      { "hand": ["Frilled Sparkshooter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Frilled Sparkshooter" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Frilled Sparkshooter": [3, 3] }
    }
  },
  {
    "name": "ruling: an opponent who gained life and lost life this turn still counts as having lost life",
    "players": [
      { "hand": ["Frilled Sparkshooter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Helix", "player": 1, "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Frilled Sparkshooter" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Frilled Sparkshooter": { "p1p1": 1 } },
      "pt": { "Frilled Sparkshooter": [4, 4] }
    }
  }
]
