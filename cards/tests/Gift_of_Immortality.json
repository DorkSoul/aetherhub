[
 { "name": "enchanted creature returns and Gift attaches at end step",
   "players": [ { "hand": ["Gift of Immortality"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] },
                { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Gift of Immortality", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "pass": true }, { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "resolve": true },
              { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Gift of Immortality"] }, { "graveyard": ["Shock"] } ],
               "attached": { "Gift of Immortality": "Grizzly Bears" } } },
 { "name": "Gift stays in graveyard if the creature dies again before the end step",
   "players": [ { "hand": ["Gift of Immortality"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] },
                { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain"] } ],
   "steps": [ { "cast": "Gift of Immortality", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "pass": true }, { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "resolve": true },
              { "pass": true }, { "player": 1, "cast": "Shock", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "resolve": true },
              { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Gift of Immortality", "Grizzly Bears"] }, { "graveyard": ["Shock", "Shock"] } ] } },
 { "name": "ruling: a token that dies does not return, so the Gift stays in the graveyard",
   "players": [ { "hand": ["Raise the Alarm", "Gift of Immortality", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Island", "Island", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Raise the Alarm" }, { "resolve": true }, { "cast": "Gift of Immortality", "targets": ["Soldier"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Soldier"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Gift of Immortality", "Lightning Bolt", "Raise the Alarm"], "battlefield_lacks": ["Gift of Immortality"] }, {} ] } }
]
