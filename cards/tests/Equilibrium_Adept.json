[
  {
    "name": "exiles the top card of your library when it enters",
    "players": [
      { "hand": ["Equilibrium Adept"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Equilibrium Adept" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Forest"], "library_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "second spell each turn gives double strike",
    "players": [
      { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Equilibrium Adept", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Equilibrium Adept": ["DoubleStrike"] }
    }
  },
  {
    "name": "ruling: the Adept's own spell counts as the first spell, so the next spell is the second",
    "players": [
      { "hand": ["Equilibrium Adept", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Equilibrium Adept" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "keywords": { "Equilibrium Adept": ["DoubleStrike"] }
    }
  },
  {
    "name": "ruling: an exiled land is played under normal land rules in your main phase",
    "players": [
      { "hand": ["Equilibrium Adept"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Equilibrium Adept" },
      { "resolve": true },
      { "resolve": true },
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Forest", "Equilibrium Adept"] },
        {}
      ]
    }
  }
]
