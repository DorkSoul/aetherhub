   "steps": [ { "cast": "Stolen Goods", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Stolen Goods"] }, { "life": 17, "exile": ["Forest"], "graveyard": ["Lightning Bolt"], "library_count": 1 } ] } },
 { "name": "the exiled creature enters the battlefield for free",
   "players": [ { "hand": ["Stolen Goods"], "battlefield": ["Island", "Plains", "Plains", "Plains"] }, { "library": ["Grizzly Bears", "Lightning Bolt"] } ],
   "steps": [ { "cast": "Stolen Goods", "targets": ["p1"] }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "exile": [], "library_count": 1 } ] } },
 { "name": "the permission expires at the end of the turn",
   "players": [ { "hand": ["Stolen Goods"], "battlefield": ["Island", "Plains", "Plains", "Plains"] }, { "library": ["Grizzly Bears", "Lightning Bolt"] } ],
   "steps": [ { "cast": "Stolen Goods", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": {} },
 { "name": "ruling: declining to cast the exiled creature leaves it exiled",
   "players": [ { "hand": ["Stolen Goods"], "battlefield": ["Island", "Plains", "Plains", "Plains"] }, { "library": ["Grizzly Bears", "Lightning Bolt"] } ],
   "steps": [ { "cast": "Stolen Goods", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ {}, { "exile": ["Grizzly Bears"] } ] } },
 { "name": "ruling: kicker can be paid when a card is cast without paying its mana cost",
   "players": [ { "hand": ["Stolen Goods"], "battlefield": ["Island", "Plains", "Plains", "Plains", "Mountain", "Plains", "Plains", "Plains"] }, { "library": ["Burst Lightning"] } ],
   "steps": [ { "cast": "Stolen Goods", "targets": ["p1"] }, { "resolve": true }, { "cast": "Burst Lightning", "targets": ["p1"], "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Stolen Goods"] }, { "life": 16, "exile": [] } ] } },
 { "name": "ruling: an exiled X spell cast for free has X = 0",
   "players": [ { "hand": ["Stolen Goods"], "battlefield": ["Island", "Plains", "Plains", "Plains"] }, { "library": ["Fireball"] } ],
   "steps": [ { "cast": "Stolen Goods", "targets": ["p1"] }, { "resolve": true }, { "cast": "Fireball", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Stolen Goods"] }, { "life": 20, "graveyard": ["Fireball"] } ] } },
 { "name": "ruling: the exiled creature keeps its normal timing, so it cannot be cast in combat",
   "players": [ { "hand": ["Stolen Goods"], "battlefield": ["Island", "Plains", "Plains", "Plains"] }, { "library": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Stolen Goods", "targets": ["p1"] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "cast": "Grizzly Bears", "illegal": true } ],
