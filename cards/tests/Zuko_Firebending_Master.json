[
 { "name": "attacking with no experience counters adds no mana",
   "players": [ { "battlefield": ["Zuko, Firebending Master"] }, {} ],
   "steps": [ { "attack": [ { "card": "Zuko, Firebending Master", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": {} }, { "life": 18 } ] } },
 { "name": "a spell cast during combat gives an experience counter, so the attack adds R equal to it",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Zuko, Firebending Master", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true }, { "attack": [ { "card": "Zuko, Firebending Master", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, { "life": 15 } ] } },
 { "name": "a spell cast outside combat gives no experience counter",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Zuko, Firebending Master", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "attack": [ { "card": "Zuko, Firebending Master", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": {} }, { "life": 15 } ] } },
 { "name": "first strike: a 2/2 blocker dies before it deals damage to Zuko",
   "players": [ { "battlefield": ["Zuko, Firebending Master"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Zuko, Firebending Master", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Zuko, Firebending Master" } ] }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "battlefield": ["Zuko, Firebending Master"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "ruling: firebending mana is lost when moving from combat to the second main phase",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Zuko, Firebending Master", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true }, { "attack": [ { "card": "Zuko, Firebending Master", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": {} }, { "life": 15 } ] } },
 { "name": "ruling: other mana added during combat is lost when the combat step ends",
   "players": [ { "battlefield": ["Zuko, Firebending Master", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "tap_for_mana": "Mountain" }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": {} }, {} ] } }
]
