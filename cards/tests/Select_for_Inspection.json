[
  { "name": "returns a tapped creature to its owner's hand and scries 1",
    "players": [ { "hand": ["Select for Inspection"], "battlefield": ["Island"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Select for Inspection", "targets": ["Grizzly Bears"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "graveyard": ["Select for Inspection"] }, { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "an untapped creature cannot be targeted",
    "players": [ { "hand": ["Select for Inspection"], "battlefield": ["Island"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Select for Inspection", "targets": ["Grizzly Bears"], "illegal": true } ] },
  { "name": "ruling: if the target is removed in response the spell does not resolve and there is no scry",
    "players": [ { "hand": ["Select for Inspection", "Lightning Bolt"], "battlefield": ["Island", "Mountain"], "library": ["Island", "Grizzly Bears"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Select for Inspection", "targets": ["Grizzly Bears"] },
               { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
               { "pass": true },
               { "pass": true, "player": 1 },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Select for Inspection", "Lightning Bolt"], "hand_count": 0, "library_top": ["Island"] }, { "graveyard": ["Grizzly Bears"], "hand_count": 0 } ] } }
]
