[
  {
    "name": "enters and exiles a creature with shadow",
    "players": [
      {
        "hand": [
          "Faceless Devourer"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Vashta Nerada"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Faceless Devourer"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Faceless Devourer"
          ]
        },
        {
          "exile": [
            "Vashta Nerada"
          ],
          "battlefield_lacks": [
            "Vashta Nerada"
          ]
        }
      ]
    }
  },
  {
    "name": "when it leaves the battlefield the exiled creature returns",
    "players": [
      {
        "hand": [
          "Faceless Devourer",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Vashta Nerada"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Faceless Devourer"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Faceless Devourer"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Faceless Devourer",
            "Lightning Bolt"
          ]
        },
        {
          "battlefield_has": [
            "Vashta Nerada"
          ],
          "exile": []
        }
      ]
    }
  },
  {
    "name": "ruling: leaves before its ETB resolves: the exile still happens and lasts",
    "players": [
      { "hand": ["Faceless Devourer", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain"] },
      { "battlefield": ["Vashta Nerada"] }
    ],
    "steps": [
      {"cast": "Faceless Devourer"},
      {"pass": true},
      {"pass": true, "player": 1},
      {"cast": "Lightning Bolt", "targets": ["Faceless Devourer"]},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"graveyard": ["Faceless Devourer", "Lightning Bolt"]},
        {"exile": ["Vashta Nerada"], "battlefield_lacks": ["Vashta Nerada"]}
      ]
    }
  }
]
