[
  {
    "name": "unkicked: target player discards two",
    "players": [
      { "hand": ["Bog Down"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "hand": ["Forest", "Mountain", "Island"] }
    ],
    "steps": [
      { "cast": "Bog Down", "targets": ["p1"], "answers": [false] },
      { "resolve": true, "answers": [["Forest", "Mountain"]] }
    ],
    "expect": {
      "players": [
        {},
        { "hand": ["Island"], "graveyard": ["Forest", "Mountain"] }
      ]
    }
  },
  {
    "name": "kicked by sacrificing two lands: target player discards three",
    "players": [
      { "hand": ["Bog Down"], "battlefield": ["Swamp", "Swamp", "Swamp", "Forest", "Forest"] },
      { "hand": ["Forest", "Mountain", "Island", "Plains"] }
    ],
    "steps": [
      { "cast": "Bog Down", "targets": ["p1"], "answers": [true, ["Forest", "Forest"]] },
      { "resolve": true, "answers": [["Forest", "Mountain", "Island"]] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Forest", "Bog Down"] },
        { "hand": ["Plains"], "graveyard": ["Forest", "Mountain", "Island"] }
      ]
    }
  },
  {
    "name": "ruling: a copy of a kicked spell is also kicked, so the target discards three more",
    "players": [
      { "hand": ["Bog Down", "Twincast"], "battlefield": ["Swamp", "Plains", "Plains", "Island", "Island", "Forest", "Forest"] },
      { "hand": ["Mountain", "Mountain", "Island", "Island", "Plains", "Plains", "Swamp"] }
    ],
    "steps": [
      { "cast": "Bog Down", "targets": ["p1"], "answers": [true, ["Forest", "Forest"]] },
      { "cast": "Twincast", "targets": [{ "stack": "Bog Down" }] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Bog Down", "Twincast"] },
        { "hand_count": 1 }
      ]
    }
  }
