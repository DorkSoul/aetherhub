[
  {
    "name": "enters with two Thopters",
    "players": [
      {
        "hand": [
          "Whirler Rogue"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Whirler Rogue"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Island",
            "Island",
            "Island",
            "Island",
            "Whirler Rogue",
            "Thopter",
            "Thopter"
          ]
        }
      ]
    }
  },
  {
    "name": "tap two artifacts: target creature can't be blocked",
    "players": [
      {
        "battlefield": [
          "Whirler Rogue",
          "Thopter",
          "Thopter",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Whirler Rogue",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 18,
          "battlefield": [
            "Hill Giant"
          ]
        }
      ],
      "tapped": {
        "Whirler Rogue": false
      }
    }
  },
  {
    "name": "without the ability Hill Giant can block and kill the Bears",
    "players": [
      {
        "battlefield": [
          "Whirler Rogue",
          "Thopter",
          "Thopter",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Hill Giant",
            "attacker": "Grizzly Bears"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Whirler Rogue"
          ],
          "graveyard": [
            "Grizzly Bears"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "needs two untapped artifacts",
    "players": [
      {
        "battlefield": [
          "Whirler Rogue",
          "Thopter",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Whirler Rogue",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ]
  },
  {
    "name": "ruling: a summoning-sick artifact creature can be tapped for the ability's cost",
    "players": [
      { "battlefield": ["Whirler Rogue", "Mind Stone", { "name": "Ornithopter", "sick": true }] },
      {}
    ],
    "steps": [
      { "activate": "Whirler Rogue", "targets": ["Whirler Rogue"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Ornithopter": true, "Mind Stone": true }
    }
  },
  {
    "name": "ruling: activating the ability after the attacker is blocked does not unblock it",
    "players": [
      { "battlefield": ["Whirler Rogue", "Hill Giant", "Mind Stone", "Mind Stone"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "activate": "Whirler Rogue", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant"] },
        { "life": 20, "graveyard": ["Grizzly Bears"] }
      ]
    }
  }
]