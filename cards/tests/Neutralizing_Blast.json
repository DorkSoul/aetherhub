[
  { "name": "counters a multicolored spell",
    "players": [ { "hand": ["Neutralizing Blast"], "battlefield": ["Island", "Island"] },
                 { "hand": ["Lightning Helix"], "battlefield": ["Mountain", "Plains"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Helix", "player": 1, "targets": ["p0"] },
               { "cast": "Neutralizing Blast", "targets": [ { "stack": "Lightning Helix" } ] },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard_has": ["Neutralizing Blast"] }, { "graveyard_has": ["Lightning Helix"] } ] } },
  { "name": "cannot target a mono-colored spell",
    "players": [ { "hand": ["Neutralizing Blast"], "battlefield": ["Island", "Island"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
               { "cast": "Neutralizing Blast", "targets": [ { "stack": "Lightning Bolt" } ], "illegal": true },
               { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, {} ] } }
]
