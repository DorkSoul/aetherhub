[
  {
    "name": "casting an instant gives two energy",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Dynavolt Tower"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "energy": 2
        },
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "pay five energy: 3 damage to any target",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Lightning Bolt",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Dynavolt Tower"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "activate": "Dynavolt Tower",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "energy": 1
        },
        {
          "life": 8
        }
      ]
    }
  },
  {
    "name": "ruling: energy persists across steps and turns (it is not mana)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Dynavolt Tower"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": { "turn": 2, "players": [ { "energy": 2 }, { "life": 17 } ] }
  },
  {
    "name": "ruling: with only four energy the Tower's five-energy cost cannot be paid",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Dynavolt Tower"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Dynavolt Tower", "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [ { "energy": 4 }, { "life": 14 } ] }
  }
]
