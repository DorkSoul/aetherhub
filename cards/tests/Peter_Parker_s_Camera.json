[
  {
    "name": "copies a triggered ability (the enters trigger draws again)",
    "players": [
      {
        "hand": ["Elvish Visionary"],
        "battlefield": ["Peter Parker's Camera", "Forest", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Elvish Visionary" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "activate": "Peter Parker's Camera" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand_count": 2 }, {}]
    }
  },
  {
    "name": "copies an activated ability: the copy also deals its damage",
    "players": [
      {
        "battlefield": ["Peter Parker's Camera", "Rod of Ruin", "Island", "Island", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Rod of Ruin", "targets": ["p1"] },
      { "activate": "Peter Parker's Camera" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "tapped": { "Rod of Ruin": true, "Peter Parker's Camera": true }
    }
  },
  {
    "name": "no activated or triggered ability on the stack: nothing to copy",
    "players": [
      {
        "battlefield": ["Peter Parker's Camera", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Peter Parker's Camera", "illegal": true }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "ruling: a mana ability is not on the stack, so Peter Parker's Camera has nothing to copy",
    "players": [
      { "battlefield": ["Peter Parker's Camera", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Forest" },
      { "activate": "Peter Parker's Camera", "illegal": true }
    ],
    "expect": { "tapped": { "Forest": true }, "players": [{}, {}] }
  }
]
