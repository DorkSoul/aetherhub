    "expect": {
      "players": [{"battlefield_has": ["Creepy Doll"]}, {"graveyard": ["Grizzly Bears"]}]
    }
  },
  {
    "name": "combat damage to a creature: lost flip leaves it alive (seed 2)",
    "seed": 2,
    "players": [{"battlefield": [{"name": "Creepy Doll", "sick": false}]}, {"battlefield": ["Grizzly Bears"]}],
    "steps": [
      {"attack": [{"card": "Creepy Doll", "at": "p1"}]},
      {"block": [{"blocker": "Grizzly Bears", "attacker": "Creepy Doll"}]},
      {"advance_to": "Main2"}
    ],
    "expect": {
      "players": [{"battlefield_has": ["Creepy Doll"]}, {"battlefield_has": ["Grizzly Bears"]}]
    }
  },
  {
    "name": "ruling: lethal combat damage still flips the coin; a regenerated creature can be destroyed again (seed 3, won flip)",
    "seed": 3,
    "players": [{"battlefield": [{"name": "Creepy Doll", "sick": false}]}, {"battlefield": ["Drudge Skeletons", "Swamp"]}],
    "steps": [
      {"attack": [{"card": "Creepy Doll", "at": "p1"}]},
      {"block": [{"blocker": "Drudge Skeletons", "attacker": "Creepy Doll"}]},
      {"pass": true},
      {"activate": "Drudge Skeletons", "player": 1},
      {"resolve": true},
      {"advance_to": "Main2"}
    ],
    "expect": {
      "players": [{"battlefield_has": ["Creepy Doll"]}, {"graveyard": ["Drudge Skeletons"]}]
    }
  },
  {
    "name": "ruling: lethal combat damage still flips the coin; a regenerated creature survives a lost flip (seed 2)",
    "seed": 2,
    "players": [{"battlefield": [{"name": "Creepy Doll", "sick": false}]}, {"battlefield": ["Drudge Skeletons", "Swamp"]}],
    "steps": [
