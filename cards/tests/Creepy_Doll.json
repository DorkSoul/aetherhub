  {
    "name": "combat damage to a creature: won flip destroys it (seed 3)",
    "seed": 3,
    "players": [{"battlefield": [{"name": "Creepy Doll", "sick": false}]}, {"battlefield": ["Grizzly Bears"]}],
    "steps": [
      {"attack": [{"card": "Creepy Doll", "at": "p1"}]},
      {"block": [{"blocker": "Grizzly Bears", "attacker": "Creepy Doll"}]},
      {"advance_to": "Main2"}
