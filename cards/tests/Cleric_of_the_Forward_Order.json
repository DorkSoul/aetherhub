[
  {
    "name": "gains 2 life for itself alone",
    "players": [
      { "hand": ["Cleric of the Forward Order"], "battlefield": ["Plains", "Plains"], "life": 20 },
      {}
    ],
    "steps": [
      { "cast": "Cleric of the Forward Order" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "battlefield_has": ["Cleric of the Forward Order"] },
        {}
      ]
    }
  },
  {
    "name": "gains 2 life for each other Cleric you control, counting itself",
    "players": [
      { "hand": ["Cleric of the Forward Order"], "battlefield": ["Plains", "Plains", "Cleric of the Forward Order"] },
      {}
    ],
    "steps": [
      { "cast": "Cleric of the Forward Order" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 24 },
        {}
      ]
    }
  },
  {
    "name": "a Cleric that left the battlefield is not counted when the trigger resolves",
    "players": [
      {"hand": ["Cleric of the Forward Order", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Mountain", "Mountain"], "life": 20},
      {}
    ],
    "steps": [
      {"cast": "Cleric of the Forward Order"},
      {"pass": true},
      {"pass": true, "player": 1},
      {"cast": "Lightning Bolt", "targets": ["Cleric of the Forward Order"]},
      {"pass": true},
      {"pass": true, "player": 1},
      {"resolve": true}
    ],
    "expect": {"players": [{"life": 20, "graveyard_has": ["Cleric of the Forward Order", "Lightning Bolt"]}, {}]}
  },
  {
    "name": "ruling: counts every Cleric you control, including the one entering, as the ability resolves (6 life with two others)",
    "players": [
      { "hand": ["Cleric of the Forward Order"], "battlefield": ["Plains", "Plains", "Cleric of the Forward Order", "Cleric of the Forward Order"], "life": 20 },
      {}
    ],
    "steps": [
      { "cast": "Cleric of the Forward Order" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {"players": [{ "life": 26, "battlefield_has": ["Cleric of the Forward Order"] }, {}]}
  }
]
