[
  {
    "name": "mountainwalk: unblockable while defender controls a Mountain",
    "players": [
      { "battlefield": ["Rock Badger"] },
      { "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rock Badger", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "no Mountain: can be blocked normally",
    "players": [
      { "battlefield": ["Rock Badger"] },
      { "battlefield": ["Plains", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rock Badger", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Rock Badger" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield": ["Rock Badger"] }, { "life": 20, "graveyard": ["Grizzly Bears"] }]
    }
  }
]
