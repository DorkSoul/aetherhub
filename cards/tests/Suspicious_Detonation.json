[
  {
    "name": "after sacrificing an artifact this turn it costs {1}{R} and deals 4 damage",
    "players": [
      {
        "hand": ["Suspicious Detonation"],
        "battlefield": ["Arcbound Ravager", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Serra Angel"]
      }
    ],
    "steps": [
      {"activate": "Arcbound Ravager"},
      {"resolve": true},
      {"cast": "Suspicious Detonation", "targets": ["Serra Angel"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"battlefield_lacks": ["Arcbound Ravager"]},
        {"battlefield_lacks": ["Serra Angel"]}
      ]
    }
  },
  {
    "name": "without sacrificing an artifact it costs {4}{R} and cannot be cast with two lands",
    "players": [
      {
        "hand": ["Suspicious Detonation"],
        "battlefield": ["Arcbound Ravager", "Mountain", "Mountain"]
      },
      {
        "battlefield": ["Serra Angel"]
      }
    ],
    "steps": [
      {"cast": "Suspicious Detonation", "targets": ["Serra Angel"], "illegal": true}
    ],
    "expect": {
      "players": [
        {"hand": ["Suspicious Detonation"]},
        {"battlefield_has": ["Serra Angel"]}
      ]
    }
  },
  {
    "name": "ruling: can't be countered; Counterspell on it does nothing and the creature dies",
    "players": [
      { "hand": ["Suspicious Detonation"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Serra Angel", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Suspicious Detonation", "targets": ["Serra Angel"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Suspicious Detonation"] },
        { "graveyard": ["Counterspell", "Serra Angel"], "battlefield_lacks": ["Serra Angel"] }
      ]
    }
  }
]
