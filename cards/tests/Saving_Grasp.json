[
  { "name": "returns a creature you own to hand",
    "players": [ { "hand": ["Saving Grasp"], "battlefield": ["Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Saving Grasp", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "hand_count": 1, "graveyard_has": ["Saving Grasp"] }, {} ] } },
  { "name": "flashback for {W} from the graveyard, then exiled",
    "players": [ { "graveyard": ["Saving Grasp"], "battlefield": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Saving Grasp", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "hand_count": 1, "exile": ["Saving Grasp"] }, {} ] } },
  { "name": "ruling: can target a creature you own that an opponent controls",
    "players": [ { "hand": ["Saving Grasp"], "battlefield": ["Island", "Grizzly Bears"] }, { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
    "steps": [ { "advance_to": "End" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Control Magic", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "pass": true, "player": 1 },
               { "cast": "Saving Grasp", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard_has": ["Saving Grasp"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "ruling: flashback works from a graveyard card that was never cast",
    "players": [ { "graveyard": ["Saving Grasp"], "battlefield": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Saving Grasp", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "exile": ["Saving Grasp"] }, {} ] } },
  { "name": "ruling: a flashback spell that is countered is still exiled",
    "players": [ { "graveyard": ["Saving Grasp"], "battlefield": ["Plains", "Grizzly Bears"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Saving Grasp", "alt": 0, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Saving Grasp" }] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Saving Grasp"], "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Counterspell"] } ] } },
  { "name": "ruling: flashback cost is increased by Thalia (total {1}{W}): one Plains is not enough",
    "players": [ { "graveyard": ["Saving Grasp"], "battlefield": ["Plains", "Grizzly Bears"] }, { "battlefield": ["Thalia, Guardian of Thraben"] } ],
    "steps": [ { "cast": "Saving Grasp", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard_has": ["Saving Grasp"], "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: flashback cost increased by Thalia is paid as {1}{W} (two lands)",
    "players": [ { "graveyard": ["Saving Grasp"], "battlefield": ["Plains", "Island", "Grizzly Bears"] }, { "battlefield": ["Thalia, Guardian of Thraben"] } ],
    "steps": [ { "cast": "Saving Grasp", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "exile": ["Saving Grasp"] }, {} ] } }
]
