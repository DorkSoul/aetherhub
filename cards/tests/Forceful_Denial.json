   { "cast": "Forceful Denial", "player": 1, "targets": [ { "stack": "Lightning Bolt" } ] },
   { "pass": true, "player": 1 },
   { "cast": "Forceful Denial", "targets": [ { "stack": "Forceful Denial" } ], "answers": [true] },
   { "resolve": true, "auto": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Lightning Bolt", "Forceful Denial"], "life": 20 },
    { "graveyard_has": ["Forceful Denial"], "battlefield_has": ["Grizzly Bears"], "life": 17 }
   ]
  }
 },
 {
  "name": "ruling: declining the cascade cast still exiles the cards down to the hit, which go to the library bottom",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
   { "hand": ["Forceful Denial"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Plains", "Grizzly Bears"] }
  ],
  "steps": [
