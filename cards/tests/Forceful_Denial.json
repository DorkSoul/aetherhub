 {
  "name": "ruling: can't be cast targeting itself to cascade when no other spell is on the stack",
  "players": [
   {},
   { "hand": ["Forceful Denial"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Forceful Denial", "player": 1, "illegal": true }
  ],
  "expect": { "players": [ {}, { "hand": ["Forceful Denial"], "library_count": 1 } ] }
 },
 {
  "name": "ruling: a countered cascade spell still cascades (cascade happened on cast)",
  "players": [
   { "hand": ["Lightning Bolt", "Forceful Denial"], "battlefield": ["Mountain", "Island", "Island", "Island", "Island", "Island"], "library": ["Plains"] },
   { "hand": ["Forceful Denial"], "battlefield": ["Island", "Island", "Island", "Island", "Island"], "library": ["Grizzly Bears"] }
  ],
  "steps": [
