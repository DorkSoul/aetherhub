    "steps": [ { "cast": "Harmonize" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "Stun": 1 } }, "pt": { "Ultros, Obnoxious Octopus": [2, 1] } } },
  { "name": "three mana spent on a noncreature spell: no trigger",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Ultros, Obnoxious Octopus"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": false }, "counters": { "Grizzly Bears": { "Stun": 0 } }, "pt": { "Ultros, Obnoxious Octopus": [2, 1] } } },
  { "name": "eight mana spent on a noncreature spell: puts eight +1/+1 counters on Ultros",
    "players": [ { "hand": ["Molten Note"], "battlefield": ["Plains", "Mountain", "Swamp", "Forest", "Island", "Island", "Island", "Island", "Ultros, Obnoxious Octopus"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Molten Note", "targets": ["p1:Hill Giant"], "answers": [6] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Ultros, Obnoxious Octopus": [10, 9] } } },
  { "name": "creature spell does not trigger Ultros",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Plains", "Island", "Ultros, Obnoxious Octopus"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Ultros, Obnoxious Octopus": [2, 1] } } },
  { "name": "ruling: Ultros's trigger still resolves when the spell it triggered on is countered",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Ultros, Obnoxious Octopus"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Harmonize", "player": 0 }, { "pass": true, "player": 0 }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Harmonize" }] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Harmonize"] }, { "graveyard": ["Counterspell"] } ], "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "Stun": 1 } } } }
