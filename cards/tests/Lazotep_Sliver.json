[
  { "name": "a Sliver you control has afflict 2: defending player loses 2 when it becomes blocked",
    "players": [ { "battlefield": ["Lazotep Sliver"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Lazotep Sliver", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Lazotep Sliver" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "a nontoken Sliver dying amasses Slivers 2",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Lazotep Sliver", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Lazotep Sliver"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Lazotep Sliver"] }, { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Lazotep Sliver"] }, {} ], "counters": { "Army": { "p1p1": 2 } } } },
  { "name": "ruling: amass with no Army makes a 0/0 Sliver Army token that ends as a 2/2 Sliver",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Lazotep Sliver", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Lazotep Sliver"] }, { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Lazotep Sliver"] }, { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Lazotep Sliver"] }, {} ], "pt": { "Army": [2, 2] }, "subtypes": { "Army": ["Sliver", "Army"] } } },
  { "name": "ruling: afflict triggers once even when two creatures block",
    "players": [ { "battlefield": ["Lazotep Sliver"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Lazotep Sliver", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Lazotep Sliver" }, { "blocker": "Hill Giant", "attacker": "Lazotep Sliver" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] } }
]
