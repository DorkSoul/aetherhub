    "steps": [
      { "activate": "Ethereal Usher", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Craw Wurm", "attacker": "Grizzly Bears" } ], "illegal": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "life": 18 } ] } }
