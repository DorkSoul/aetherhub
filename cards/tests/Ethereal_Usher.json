    "steps": [
      { "activate": "Ethereal Usher", "ability": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0, "graveyard": ["Ethereal Usher"] }, {} ] } },
  { "name": "transmute needs {1}{U}{U}",
