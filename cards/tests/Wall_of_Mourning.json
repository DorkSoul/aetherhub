[
 {
  "name": "ETB exiles the top card of your library for each opponent",
  "players": [
   { "hand": ["Wall of Mourning"], "battlefield": ["Plains", "Island"], "library": ["Forest", "Island"] },
   {}
  ],
  "steps": [
