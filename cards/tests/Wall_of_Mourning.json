   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Forest"], "battlefield_has": ["Wall of Mourning"] },
    {}
   ]
  }
 },
 {
  "name": "ETB exiles one card per opponent in a three player game",
  "players": [
   { "hand": ["Wall of Mourning"], "battlefield": ["Plains", "Island"], "library": ["Forest", "Island", "Swamp"] },
   {},
   {}
  ],
  "steps": [
   { "cast": "Wall of Mourning" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "exile": ["Forest", "Island"] },
    {},
    {}
   ]
  }
 },
 {
  "name": "coven returns a card exiled with it to hand at your end step",
  "players": [
   { "hand": ["Wall of Mourning"], "battlefield": ["Plains", "Island", "Grizzly Bears", "Typhoid Rats"], "library": ["Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Wall of Mourning" },
   { "resolve": true },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "hand": ["Forest"], "exile": [] },
    {}
   ]
  }
 },
 {
  "name": "no return at end step without three creatures with different powers",
  "players": [
   { "hand": ["Wall of Mourning"], "battlefield": ["Plains", "Island", "Grizzly Bears"], "library": ["Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Wall of Mourning" },
   { "resolve": true },
   { "advance_to": "End" }
  ],
  "expect": {
   "players": [
    { "exile": ["Forest"], "hand": [] },
    {}
   ]
  }
 }
]
