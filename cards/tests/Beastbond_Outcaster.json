    "steps": [ { "cast": "Beastbond Outcaster" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Beastbond Outcaster"], "hand_count": 0 }, {} ] } },
  { "name": "plotted for {1}{G}, then cast for free on a later turn (sorcery speed)",
