    "expect": { "players": [ { "battlefield_has": ["Beastbond Outcaster"] }, {} ] } },
  { "name": "ruling: a plotted card cannot be cast on the turn it became plotted",
    "players": [ { "hand": ["Beastbond Outcaster"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Beastbond Outcaster", "ability": 0 }, { "resolve": true },
