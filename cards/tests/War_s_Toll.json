[
  {
    "name": "one attacker forces all other able creatures to attack",
    "players": [
      {
        "battlefield": [
          "War's Toll"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Grizzly Bears",
            "sick": false
          },
          {
            "name": "Runeclaw Bear",
            "sick": false
          }
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1",
        "auto": true
      },
      {
        "player": 1,
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p0"
          }
        ]
      },
      {
        "player": 0,
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 16
        },
        {}
      ]
    }
  },
  {
    "name": "no attack declared stays no attack",
    "players": [
      {
        "battlefield": [
          "War's Toll"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main1",
        "auto": true
      },
      {
        "player": 1,
        "attack": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {}
      ]
    }
  },
  {
    "name": "opponent tapping a land taps all their lands; own land does not trigger",
    "players": [
      {
        "battlefield": [
          "War's Toll",
          "Plains",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Forest",
          "Island",
          "Swamp"
        ]
      }
    ],
    "steps": [
      {
        "tap_for_mana": "Plains"
      },
      {
        "pass": true
      },
      {
        "player": 1,
        "tap_for_mana": "Island"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Plains": true,
        "Mountain": false,
        "Forest": true,
        "Island": true,
        "Swamp": true
      }
    }
  },
  {
    "name": "ruling: the opponent can respond to War's Toll's trigger by casting an instant with mana already tapped",
    "players": [ { "battlefield": ["War's Toll", "Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "tap_for_mana": "Mountain", "player": 1 }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, { "graveyard": ["Lightning Bolt"] } ] }
  }
]