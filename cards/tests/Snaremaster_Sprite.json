[
 {
  "name": "pay 2: tap target creature an opponent controls and put a stun counter on it",
  "players": [
   {
    "hand": ["Snaremaster Sprite"],
    "battlefield": ["Island", "Island", "Island"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "cast": "Snaremaster Sprite" },
   { "resolve": true, "answers": [true] },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true },
   "counters": { "Grizzly Bears": { "stun": 1 } }
  }
 },
 {
  "name": "declining to pay: no tap, no stun counter",
  "players": [
   {
    "hand": ["Snaremaster Sprite"],
    "battlefield": ["Island", "Island", "Island"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "cast": "Snaremaster Sprite" },
   { "resolve": true, "answers": [false] }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false },
   "players": [
    { "battlefield_has": ["Snaremaster Sprite"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: a tapped creature can be targeted and still gets the stun counter",
  "players": [
   {
    "hand": ["Snaremaster Sprite"],
    "battlefield": ["Island", "Island", "Island"]
   },
   {
    "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ]
   }
  ],
  "steps": [
   { "cast": "Snaremaster Sprite" },
   { "resolve": true, "answers": [true] },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true },
   "counters": { "Grizzly Bears": { "stun": 1 } }
  }
 },
 {
  "name": "ruling: the reflexive trigger's target is chosen when it goes on the stack (Hill Giant, not Grizzly Bears)",
  "players": [
   {
    "hand": ["Snaremaster Sprite"],
    "battlefield": ["Island", "Island", "Island"]
   },
   {
    "battlefield": ["Grizzly Bears", "Hill Giant"]
   }
  ],
  "steps": [
   { "cast": "Snaremaster Sprite" },
   { "resolve": true, "answers": [true, "Hill Giant"] },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Hill Giant": true, "Grizzly Bears": false },
   "counters": { "Hill Giant": { "stun": 1 } }
  }
 }
]
