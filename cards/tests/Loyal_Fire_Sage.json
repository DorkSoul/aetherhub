[
 { "name": "attacking adds R that lasts through the rest of combat",
   "players": [ { "battlefield": [ { "name": "Loyal Fire Sage", "sick": false } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Loyal Fire Sage", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, {} ] } },
 { "name": "the firebending mana is gone after combat",
   "players": [ { "battlefield": [ { "name": "Loyal Fire Sage", "sick": false } ] }, {} ],
   "steps": [ { "attack": [ { "card": "Loyal Fire Sage", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "pool": { "R": 0 } }, {} ] } },
 { "name": "no attack: no firebending mana",
   "players": [ { "battlefield": [ { "name": "Loyal Fire Sage", "sick": false } ] }, {} ],
   "steps": [ { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 0 } }, {} ] } },
 { "name": "{5}: create a 1/1 white Ally token",
   "players": [ { "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains", { "name": "Loyal Fire Sage", "sick": false }] }, {} ],
   "steps": [ { "activate": "Loyal Fire Sage" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Loyal Fire Sage", "Ally 1-1"] }, {} ] } },
 { "name": "ruling: firebending is a trigger, so its mana still comes if the creature dies in response",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Loyal Fire Sage", "sick": false }] }, {} ],
   "steps": [ { "attack": [ { "card": "Loyal Fire Sage", "at": "p1" } ] }, { "cast": "Lightning Bolt", "targets": ["Loyal Fire Sage"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Loyal Fire Sage", "Lightning Bolt"], "pool": { "R": 1 } }, {} ] } },
 { "name": "ruling: other mana added in combat is lost between steps; firebending mana stays",
   "players": [ { "battlefield": ["Mountain", { "name": "Loyal Fire Sage", "sick": false }] }, {} ],
   "steps": [ { "attack": [ { "card": "Loyal Fire Sage", "at": "p1" } ] }, { "resolve": true }, { "tap_for_mana": "Mountain" }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, {} ] } },
 { "name": "ruling: firebending mana can still be spent after combat damage",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Loyal Fire Sage", "sick": false }] }, {} ],
   "steps": [ { "attack": [ { "card": "Loyal Fire Sage", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "cast": "Lightning Bolt", "targets": ["Loyal Fire Sage"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Loyal Fire Sage", "Lightning Bolt"], "pool": { "R": 0 } }, {} ] } }
