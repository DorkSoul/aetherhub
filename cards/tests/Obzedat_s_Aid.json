[
  { "name": "returns a creature card from your graveyard to the battlefield",
    "players": [
      { "hand": ["Obzedat's Aid"], "graveyard": ["Grizzly Bears"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [ { "cast": "Obzedat's Aid", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Obzedat's Aid"] }, {} ] } },
  { "name": "an Aura card returns and enchants a creature the controller chooses",
    "players": [
      { "hand": ["Obzedat's Aid"], "graveyard": ["Arrest"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Island", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "cast": "Obzedat's Aid", "targets": ["Arrest"] }, { "resolve": true, "answers": [1] } ],
    "expect": { "players": [ { "battlefield_has": ["Arrest"] }, {} ], "attached": { "Arrest": "Hill Giant" } } },
  { "name": "cannot target a permanent card in the opponent's graveyard",
    "players": [
      { "hand": ["Obzedat's Aid"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Island"] },
      { "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Obzedat's Aid", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Obzedat's Aid"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an Aura with nothing legal to enchant stays in the graveyard",
    "players": [
      { "hand": ["Obzedat's Aid"], "graveyard": ["Arrest"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [ { "cast": "Obzedat's Aid", "targets": ["Arrest"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Arrest"], "graveyard": ["Obzedat's Aid", "Arrest"] }, {} ] } },
  { "name": "ruling: a land card is a permanent card and can be returned",
    "players": [
      { "hand": ["Obzedat's Aid"], "graveyard": ["Island"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [ { "cast": "Obzedat's Aid" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Island"], "graveyard": ["Obzedat's Aid"] }, {} ] } },
  { "name": "ruling: an instant or sorcery card in your graveyard is not a permanent card and can't be targeted",
    "players": [
      { "hand": ["Obzedat's Aid"], "graveyard": ["Lightning Bolt"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [ { "cast": "Obzedat's Aid", "targets": ["Lightning Bolt"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Obzedat's Aid"], "graveyard": ["Lightning Bolt"] }, {} ] } }
]
