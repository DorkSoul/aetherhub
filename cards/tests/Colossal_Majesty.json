[
  {
    "name": "draws with a power-4 creature",
    "start": "Untap",
    "players": [
      {
        "battlefield": [
          "Colossal Majesty",
          "Hill Giant",
          "Rampaging Baloths"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "no draw when the biggest creature has power 3",
    "start": "Untap",
    "players": [
      {
        "battlefield": [
          "Colossal Majesty",
          "Hill Giant"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "only a creature you control counts",
    "start": "Untap",
    "players": [
      {
        "battlefield": [
          "Colossal Majesty"
        ]
      },
      {
        "battlefield": [
          "Rampaging Baloths"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: no power-4 creature as upkeep begins, so no trigger; a pump in upkeep does not add one",
    "start": "Untap",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Colossal Majesty", "Hill Giant", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "cast": "Giant Growth", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ], "pt": { "Hill Giant": [6, 6] } }
  },
  {
    "name": "ruling: a different power-4 creature at resolution still draws the card",
    "start": "Untap",
    "players": [ { "hand": ["Disfigure", "Disfigure", "Giant Growth"], "battlefield": ["Colossal Majesty", "Rampaging Baloths", "Hill Giant", "Swamp", "Swamp", "Forest"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "cast": "Disfigure", "targets": ["Rampaging Baloths"] },
      { "cast": "Disfigure", "targets": ["Rampaging Baloths"] },
      { "cast": "Giant Growth", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 1 }, {} ], "pt": { "Hill Giant": [6, 6], "Rampaging Baloths": [2, 2] } }
  },
  {
    "name": "ruling: two power-4 creatures still draw only one card",
    "start": "Untap",
    "players": [ { "battlefield": ["Colossal Majesty", "Rampaging Baloths", "Rampaging Baloths"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] }
  }
]
