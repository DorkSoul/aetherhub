[
  {
    "name": "destroys an enchantment",
    "players": [
      {
        "hand": [
          "Cloudchaser Eagle"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Pacifism"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Cloudchaser Eagle"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Cloudchaser Eagle"
          ]
        },
        {
          "graveyard": [
            "Pacifism"
          ]
        }
      ]
    }
  },
  {
    "name": "destroys your own enchantment if it is the only one",
    "players": [
      {
        "hand": [
          "Cloudchaser Eagle"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Glorious Anthem"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Cloudchaser Eagle"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Glorious Anthem"
          ],
          "battlefield_has": [
            "Cloudchaser Eagle"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ETB destroys target enchantment (Ghostly Prison)",
    "players": [ { "hand": [ "Cloudchaser Eagle" ], "battlefield": [ "Plains", "Plains", "Plains", "Plains" ] }, { "battlefield": [ "Ghostly Prison" ] } ],
    "steps": [ { "cast": "Cloudchaser Eagle" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": [ "Cloudchaser Eagle" ] }, { "graveyard": [ "Ghostly Prison" ] } ] }
  },
  {
    "name": "ETB with no enchantment in play: no target, creature untouched",
    "players": [ { "hand": [ "Cloudchaser Eagle" ], "battlefield": [ "Plains", "Plains", "Plains", "Plains" ] }, { "battlefield": [ "Grizzly Bears" ] } ],
    "steps": [ { "cast": "Cloudchaser Eagle" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": [ "Cloudchaser Eagle" ] }, { "battlefield_has": [ "Grizzly Bears" ] } ] }
  },
  {
    "name": "ruling: nothing happens with no enchantment to target on entering",
    "players": [ { "hand": [ "Cloudchaser Eagle" ], "battlefield": [ "Plains", "Plains", "Plains", "Plains" ] }, { "battlefield": [ "Hill Giant" ] } ],
    "steps": [ { "cast": "Cloudchaser Eagle" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": [ "Cloudchaser Eagle" ] }, { "battlefield_has": [ "Hill Giant" ] } ] }
  },
  {
    "name": "ruling: if you are the only player with enchantments, you destroy your own",
    "players": [ { "hand": [ "Cloudchaser Eagle" ], "battlefield": [ "Plains", "Plains", "Plains", "Plains", "Glorious Anthem" ] }, { "battlefield": [ "Hill Giant" ] } ],
    "steps": [ { "cast": "Cloudchaser Eagle" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": [ "Glorious Anthem" ], "battlefield_has": [ "Cloudchaser Eagle" ] }, { "battlefield_has": [ "Hill Giant" ] } ] }
  }
]
