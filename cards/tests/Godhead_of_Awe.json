                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Godhead of Awe" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Godhead of Awe"] }, { "battlefield_has": ["Grizzly Bears"] } ],
                "pt": { "Godhead of Awe": [4, 4], "Grizzly Bears": [1, 1] } } },
  { "name": "five hybrid W/U mana needed",
    "players": [ { "hand": ["Godhead of Awe"], "battlefield": ["Plains", "Plains", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Godhead of Awe", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Godhead of Awe"] }, {} ] } },
  { "name": "ruling: pump after Godhead enters still applies on top of base 1/1",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Godhead of Awe", "Forest"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ],
                "pt": { "Grizzly Bears": [4, 4], "Godhead of Awe": [4, 4] } } }
