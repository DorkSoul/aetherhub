[
 {
  "name": "enters with three net counters",
  "players": [
   { "hand": ["Merseine"], "battlefield": ["Island", "Island", "Island", "Island", {"name": "Grizzly Bears", "sick": false}] },
   {}
  ],
  "steps": [
   {"cast": "Merseine", "targets": ["Grizzly Bears"]},
   {"resolve": true}
  ],
  "expect": { "counters": {"Merseine": {"net": 3}}, "attached": {"Merseine": "Grizzly Bears"} }
 },
 {
  "name": "enchanted creature stays tapped through its untap step",
  "players": [
   { "hand": ["Merseine"], "battlefield": ["Island", "Island", "Island", "Island"] },
   { "battlefield": [{"name": "Grizzly Bears", "tapped": true}] }
  ],
  "steps": [
   {"cast": "Merseine", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"advance_to": "Main1"}
  ],
  "expect": { "tapped": {"Grizzly Bears": true}, "turn": 2 }
 },
 {
  "name": "controller of the creature pays its mana cost to remove a net counter",
  "players": [
   { "hand": ["Merseine"], "battlefield": ["Island", "Island", "Island", "Island"] },
   { "battlefield": [{"name": "Grizzly Bears", "tapped": true}, "Forest", "Forest"] }
  ],
  "steps": [
   {"cast": "Merseine", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"advance_to": "Main1"},
   {"player": 1, "activate": "Merseine", "ability": 0},
   {"resolve": true}
  ],
  "expect": { "counters": {"Merseine": {"net": 2}} }
 },
 {
  "name": "the Aura's own controller cannot activate it",
  "players": [
   { "hand": ["Merseine"], "battlefield": ["Island", "Island", "Island", "Island", "Forest", "Forest"] },
   { "battlefield": [{"name": "Grizzly Bears", "tapped": true}] }
  ],
  "steps": [
   {"cast": "Merseine", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"activate": "Merseine", "ability": 0, "illegal": true}
  ],
  "expect": { "counters": {"Merseine": {"net": 3}} }
 },
 {
  "name": "ruling: counters can be removed as many times as wanted, at any time instants are legal",
  "players": [
   { "hand": ["Merseine"], "battlefield": ["Island", "Island", "Island", "Island"] },
   { "battlefield": [{"name": "Grizzly Bears", "tapped": true}, "Forest", "Forest", "Forest", "Forest"] }
  ],
  "steps": [
   {"cast": "Merseine", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"advance_to": "Main1"},
   {"player": 1, "activate": "Merseine", "ability": 0},
   {"resolve": true},
   {"player": 1, "activate": "Merseine", "ability": 0},
   {"resolve": true}
  ],
  "expect": { "counters": {"Merseine": {"net": 1}} }
 },
 {
  "name": "ruling: the cost includes coloured mana, so Islands cannot pay the green part",
  "players": [
   { "hand": ["Merseine"], "battlefield": ["Island", "Island", "Island", "Island"] },
   { "battlefield": [{"name": "Grizzly Bears", "tapped": true}, "Island", "Island"] }
  ],
  "steps": [
   {"cast": "Merseine", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"advance_to": "Main1"},
   {"player": 1, "activate": "Merseine", "ability": 0, "illegal": true}
  ],
  "expect": { "counters": {"Merseine": {"net": 3}} }
 }
]
