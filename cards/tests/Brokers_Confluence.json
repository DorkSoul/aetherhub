[
  {
    "name": "two phase-out modes and a proliferate with no counters around",
    "players": [
      { "hand": ["Brokers Confluence"], "battlefield": ["Forest", "Forest", "Plains", "Island", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Serra Angel"] }
    ],
    "steps": [
      { "cast": "Brokers Confluence", "answers": [[1, 1, 0]], "targets": ["Grizzly Bears", "Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Brokers Confluence"] },
        { "battlefield_lacks": ["Grizzly Bears", "Serra Angel"] }
      ]
    }
  },
  {
    "name": "counter mode counters an enters trigger; the trigger's draw never happens",
    "players": [
      { "hand": ["Elvish Visionary", "Brokers Confluence"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Island", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Elvish Visionary" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Brokers Confluence", "answers": [[2, 1, 0]], "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Elvish Visionary"], "hand_count": 0, "graveyard": ["Brokers Confluence"] },
        { "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: all targets illegal on resolution, so the proliferate mode does nothing",
    "players": [
      { "hand": ["Brokers Confluence"], "battlefield": ["Forest", "Forest", "Plains", "Island", "Swamp", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"], "poison": 1 }
    ],
    "steps": [
      { "cast": "Brokers Confluence", "answers": [[0, 0, 1]], "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Brokers Confluence"] },
        { "poison": 1, "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling control: with the target still legal, the proliferate mode happens",
    "players": [
      { "hand": ["Brokers Confluence"], "battlefield": ["Forest", "Forest", "Plains", "Island", "Swamp", "Grizzly Bears"] },
      { "poison": 1 }
    ],
    "steps": [
      { "cast": "Brokers Confluence", "answers": [[0, 0, 1]], "targets": ["Grizzly Bears"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Brokers Confluence"] },
        { "poison": 3 }
      ]
    }
  }
]
