[
  {"name": "dies: each player searches for a card into hand",
   "players": [
     {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Noble Benefactor"], "library": ["Island"]},
     {"library": ["Forest"]}
   ],
   "steps": [
     {"cast": "Lightning Bolt", "targets": ["Noble Benefactor"]},
     {"resolve": true, "answers": ["Island", "Forest"]},
     {"resolve": true}
   ],
   "expect": {"players": [
     {"hand": ["Island"], "graveyard_has": ["Noble Benefactor", "Lightning Bolt"]},
     {"hand": ["Forest"]}
   ]}},
  {"name": "dies: a player who declines the search gets nothing",
   "players": [
     {"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Noble Benefactor"], "library": ["Island"]},
     {"library": ["Forest"]}
   ],
   "steps": [
     {"cast": "Lightning Bolt", "targets": ["Noble Benefactor"]},
     {"resolve": true, "answers": ["Island", []]},
     {"resolve": true}
   ],
   "expect": {"players": [
     {"hand": ["Island"]},
     {"hand": []}
   ]}},
  {"name": "alive: no search",
   "players": [
     {"battlefield": ["Noble Benefactor"]},
     {}
   ],
   "steps": [{"advance_to": "Main1"}],
   "expect": {"players": [{"battlefield_has": ["Noble Benefactor"]}, {}]}},
  {"name": "ruling: on the opponent's turn the active player searches first (answers come in turn order)",
   "players": [
     {"battlefield": ["Noble Benefactor"], "library": ["Island"]},
     {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"], "library": ["Swamp", "Forest"]}
   ],
   "steps": [
     {"advance_to": "Main2"},
     {"advance_to": "Main1"},
     {"cast": "Lightning Bolt", "player": 1, "targets": ["Noble Benefactor"]},
     {"resolve": true, "answers": ["Forest", "Island"]},
     {"resolve": true}
   ],
   "expect": {"players": [
     {"hand": ["Island"], "graveyard_has": ["Noble Benefactor"]},
     {"hand": ["Swamp", "Forest"]}
   ]}}
]
