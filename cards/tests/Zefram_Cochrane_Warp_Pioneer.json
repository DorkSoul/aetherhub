[
  {
    "name": "a Spacecraft you control enters with two additional charge counters",
    "players": [
      { "hand": ["Class-F Shuttlecraft"], "battlefield": ["Zefram Cochrane, Warp Pioneer", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Class-F Shuttlecraft" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Class-F Shuttlecraft"] }, {}],
      "counters": { "Class-F Shuttlecraft": { "charge": 2 } }
    }
  },
  {
    "name": "once during your turn you may cast an artifact spell from the top of your library",
    "players": [
      { "battlefield": ["Zefram Cochrane, Warp Pioneer", "Island"], "library": ["Sol Ring", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Sol Ring"], "library_count": 1 }, {}]
    }
  },
  {
    "name": "only once each turn: a second artifact from the top of the library cannot be cast",
    "players": [
      {
        "battlefield": ["Zefram Cochrane, Warp Pioneer", "Island", "Island", "Island", "Island"],
        "library": ["Sol Ring", "Class-F Shuttlecraft", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true },
      { "cast": "Class-F Shuttlecraft", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Sol Ring"], "library_count": 2 }, {}]
    }
  }
]
