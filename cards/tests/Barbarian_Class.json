   { "activate": "Barbarian Class", "ability": 0 },
   { "resolve": true },
   { "activate": "Barbarian Class", "ability": 0, "illegal": true },
   { "activate": "Barbarian Class", "ability": 1 },
   { "resolve": true }
  ],
  "expect": {
