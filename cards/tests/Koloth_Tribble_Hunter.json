[
 { "name": "each player gets two Tribbles at your end step",
   "players": [ { "battlefield": ["Koloth, Tribble Hunter"] }, {} ],
   "steps": [ { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Tribble"] }, { "battlefield_has": ["Tribble"] } ] } },
 { "name": "Tribbles are 2/1 (+1/+0) while Koloth is on the battlefield",
   "players": [ { "battlefield": ["Koloth, Tribble Hunter"] }, {} ],
   "steps": [ { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Tribble": [2, 1] } } },
 { "name": "Koloth itself does not get the Tribble bonus",
   "players": [ { "battlefield": ["Koloth, Tribble Hunter"] }, {} ],
   "steps": [ { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Koloth, Tribble Hunter": [3, 3] } } }
