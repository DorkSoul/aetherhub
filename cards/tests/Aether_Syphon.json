[
  { "name": "without max speed the draw ability does not mill the opponent",
    "players": [ { "hand": ["Aether Syphon"], "battlefield": ["Island", "Island", "Swamp", "Plains", "Plains"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Aether Syphon" }, { "resolve": true }, { "activate": "Aether Syphon", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Mountain"] }, { "library_count": 20 } ] } },
  { "name": "max speed: drawing mills each opponent two",
    "players": [ { "hand": ["Aether Syphon"], "battlefield": ["Island", "Island", "Swamp", "Plains", "Plains"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Aether Syphon" }, { "resolve": true }, { "set_speed": 4 }, { "activate": "Aether Syphon", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Mountain"] }, { "library_count": 18 } ] } },
  { "name": "start your engines: speed starts at 1 when the card enters",
    "players": [ { "hand": ["Aether Syphon"], "battlefield": ["Island", "Island", "Swamp", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Aether Syphon" }, { "resolve": true } ],
    "expect": { "players": [ { "speed": 1 }, {} ] } },
  { "name": "ruling: using the draw ability does not change speed",
    "players": [ { "hand": ["Aether Syphon"], "battlefield": ["Island", "Island", "Swamp", "Plains", "Plains"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Aether Syphon" }, { "resolve": true }, { "activate": "Aether Syphon", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Mountain"], "speed": 1 }, { "speed": 0 } ] } },
  { "name": "ruling: a player without speed counts as speed 0; speed is tracked per player",
    "players": [ { "hand": ["Aether Syphon"], "battlefield": ["Island", "Island", "Swamp", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Aether Syphon" }, { "resolve": true } ],
    "expect": { "players": [ { "speed": 1 }, { "speed": 0 } ] } },
  { "name": "ruling: speed 3 is not max speed, so drawing does not mill the opponent",
    "players": [ { "hand": ["Aether Syphon"], "battlefield": ["Island", "Island", "Swamp", "Plains", "Plains"], "library": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Aether Syphon" }, { "resolve": true }, { "set_speed": 3 }, { "activate": "Aether Syphon", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Mountain"] }, { "library_count": 20 } ] } }
]
