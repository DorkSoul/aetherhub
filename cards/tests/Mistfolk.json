[
  {
    "name": "U counters a spell that targets it",
    "players": [
      { "battlefield": ["Island", "Mistfolk"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Mistfolk"] },
      { "activate": "Mistfolk", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mistfolk"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "cannot counter a spell that targets a player",
    "players": [
      { "battlefield": ["Island", "Mistfolk"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "activate": "Mistfolk", "ability": 0, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 17 }, { "life": 20 }]
    }
  }
]
