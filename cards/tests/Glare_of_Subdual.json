[
 {
  "name": "tap a creature to tap an opposing creature",
  "players": [
   {
    "battlefield": [
     "Glare of Subdual",
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Serra Angel"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Glare of Subdual",
    "targets": [
     "Serra Angel"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true,
    "Serra Angel": true
   }
  }
 },
 {
  "name": "can tap a noncreature artifact",
  "players": [
   {
    "battlefield": [
     "Glare of Subdual",
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Sol Ring"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Glare of Subdual",
    "targets": [
     "Sol Ring"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true,
    "Sol Ring": true
   }
  }
 },
 {
  "name": "no untapped creature: cannot activate",
  "players": [
   {
    "battlefield": [
     "Glare of Subdual",
     {
      "name": "Grizzly Bears",
      "tapped": true
     }
    ]
   },
   {
    "battlefield": [
     "Serra Angel"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Glare of Subdual",
    "targets": [
     "Serra Angel"
    ],
    "illegal": true
   }
  ],
  "expect": {
   "tapped": {
    "Serra Angel": false
   }
  }
 },
 {
  "name": "summoning-sick creature can still be tapped for the cost",
  "players": [
   {
    "battlefield": [
     "Glare of Subdual",
     {
      "name": "Grizzly Bears",
      "sick": true
     }
    ]
   },
   {
    "battlefield": [
     "Serra Angel"
    ]
   }
  ],
  "steps": [
   {
    "activate": "Glare of Subdual",
    "targets": [
     "Serra Angel"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Serra Angel": true
   }
  }
 }
]