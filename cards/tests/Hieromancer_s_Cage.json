[
  { "name": "exiles target nonland permanent an opponent controls",
    "players": [ { "hand": ["Hieromancer's Cage"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Hieromancer's Cage" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hieromancer's Cage"] }, { "battlefield": [], "exile": ["Grizzly Bears"] } ] } },
  { "name": "the creature returns when the cage leaves the battlefield",
    "players": [ { "hand": ["Hieromancer's Cage", "Naturalize"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Hieromancer's Cage" }, { "resolve": true }, { "resolve": true }, { "cast": "Naturalize", "targets": ["Hieromancer's Cage"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Naturalize", "Hieromancer's Cage"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: if the cage leaves before its trigger resolves, nothing is exiled",
    "players": [ { "hand": ["Hieromancer's Cage", "Naturalize"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Hieromancer's Cage" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Naturalize", "targets": ["Hieromancer's Cage"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Naturalize", "Hieromancer's Cage"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard",
    "players": [ { "hand": ["Hieromancer's Cage", "Holy Strength"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Holy Strength", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Hieromancer's Cage" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Holy Strength"], "battlefield_has": ["Hieromancer's Cage"] }, { "exile": ["Grizzly Bears"] } ] } }
]
