  {
    "name": "control: without Kruphix the same hand is discarded to seven",
    "players": [ { "hand": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "Upkeep", "auto": true } ],
    "expect": { "turn": 2, "players": [ { "hand_count": 7 }, {} ] }
