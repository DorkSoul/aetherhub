      { "battlefield": ["Kruphix, God of Horizons"] }
    ],
    "steps": [ { "cast": "Doom Blade", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Doom Blade"] }, { "battlefield_has": ["Kruphix, God of Horizons"] } ] }
  },
  {
    "name": "devotion of seven: a 4/7 creature again and indestructible",
    "players": [
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] },
