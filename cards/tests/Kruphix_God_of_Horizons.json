  {
    "name": "ruling: unspent mana stays colorless across steps and can pay for a spell in a later step",
    "players": [ { "hand": ["Smoke Bomb"], "battlefield": ["Kruphix, God of Horizons", "Mountain", "Island", "Island"] }, {} ],
    "steps": [ { "tap_for_mana": "Mountain" }, { "advance_to": "Main2" }, { "cast": "Smoke Bomb" }, { "resolve": true } ],
