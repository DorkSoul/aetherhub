  {
    "name": "no maximum hand size: nine cards survive cleanup",
    "players": [ { "hand": ["Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"], "battlefield": ["Kruphix, God of Horizons"] }, {} ],
    "steps": [ { "advance_to": "Upkeep", "auto": true } ],
    "expect": { "turn": 2, "players": [ { "hand_count": 9 }, {} ] }
