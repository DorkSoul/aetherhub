    "steps": [
      { "cast": "Doom Blade", "targets": ["Kruphix, God of Horizons"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Doom Blade"] }, { "battlefield_has": ["Kruphix, God of Horizons"] } ],
      "pt": { "Kruphix, God of Horizons": [4, 7] }
    }
  },
  {
