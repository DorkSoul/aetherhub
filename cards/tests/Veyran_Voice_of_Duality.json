[
  {
    "name": "casting an instant: Veyran's own magecraft triggers twice (+2/+2)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Veyran, Voice of Duality", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Veyran, Voice of Duality": [4, 4] }, "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "another permanent's magecraft also triggers twice",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Veyran, Voice of Duality", "Clever Lumimancer", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Clever Lumimancer": [4, 5], "Veyran, Voice of Duality": [4, 4] } }
  },
  {
    "name": "casting a creature spell does not trigger anything extra",
    "players": [
      { "hand": ["Elite Vanguard"], "battlefield": ["Veyran, Voice of Duality", "Clever Lumimancer", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Elite Vanguard" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Clever Lumimancer": [0, 1], "Veyran, Voice of Duality": [2, 2] } }
  },
  {
    "name": "an opponent casting an instant triggers nothing",
    "players": [
      { "battlefield": ["Veyran, Voice of Duality", "Clever Lumimancer"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Clever Lumimancer": [0, 1], "Veyran, Voice of Duality": [2, 2] } }
  },
  {
    "name": "a non-spell trigger (a land entering) is not doubled",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Veyran, Voice of Duality", "Clever Lumimancer"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" }
    ],
    "expect": { "pt": { "Clever Lumimancer": [0, 1] } }
  },
  {
    "name": "ruling: a copy made by Twincast triggers magecraft (cast Bolt, cast Twincast, copy Bolt)",
    "players": [
      { "hand": ["Lightning Bolt", "Twincast"], "battlefield": ["Veyran, Voice of Duality", "Mountain", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Twincast", "targets": [ { "stack": "Lightning Bolt" } ] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Veyran, Voice of Duality": [8, 8] } }
  }
]
