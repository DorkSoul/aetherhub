[
  {
    "name": "exiles one creature per player and each controller puts a creature from their own library onto the battlefield",
    "players": [
      {
        "hand": [
          "Chaos Mutation"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Mountain",
          "Mountain",
          "Grizzly Bears"
        ],
        "library": [
          "Forest",
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ],
        "library": [
          "Forest",
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Chaos Mutation",
        "targets": [
          "Grizzly Bears",
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Grizzly Bears"
          ],
          "battlefield_has": [
            "Hill Giant"
          ]
        },
        {
          "exile": [
            "Serra Angel"
          ],
          "battlefield_has": [
            "Llanowar Elves"
          ]
        }
      ]
    }
  },
  {
    "name": "only the targeted opponent creature is exiled; the caster library is not searched for it",
    "players": [
      {
        "hand": [
          "Chaos Mutation"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Mountain",
          "Mountain"
        ],
        "library": [
          "Llanowar Elves"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ],
        "library": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Chaos Mutation",
        "targets": [
          "Serra Angel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Chaos Mutation"
          ]
        },
        {
          "exile": [
            "Serra Angel"
          ],
          "battlefield_has": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "with no legal creature to exile, the spell does nothing",
    "players": [
      {
        "hand": [
          "Chaos Mutation"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Mountain",
          "Mountain"
        ],
        "library": [
          "Llanowar Elves"
        ]
      },
      {
        "library": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Chaos Mutation",
        "targets": []
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Chaos Mutation"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: targets must be controlled by different players, so two opponent creatures cannot both be targeted",
    "players": [
      { "hand": ["Chaos Mutation"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain"], "library": ["Llanowar Elves"] },
      { "battlefield": ["Serra Angel", "Hill Giant"], "library": ["Forest"] }
    ],
    "steps": [ { "cast": "Chaos Mutation", "targets": ["Serra Angel", "Hill Giant"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Chaos Mutation"] }, { "battlefield_has": ["Serra Angel", "Hill Giant"] } ] }
  },
  {
    "name": "ruling: targets must be controlled by different players, so two of your own creatures cannot both be targeted",
    "players": [
      { "hand": ["Chaos Mutation"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [ { "cast": "Chaos Mutation", "targets": ["Grizzly Bears", "Hill Giant"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Chaos Mutation"], "battlefield_has": ["Grizzly Bears", "Hill Giant"] }, { "battlefield_has": ["Serra Angel"] } ] }
  }
]
