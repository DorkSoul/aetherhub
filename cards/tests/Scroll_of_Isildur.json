                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true, "counters": { "stun": 1 } }, { "name": "Hill Giant", "tapped": true, "counters": { "stun": 1 } } ] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 3 }, { "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ] } },
  { "name": "chapter III draws nothing when the opponent has no tapped creatures",
