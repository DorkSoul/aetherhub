    "steps": [ { "cast": "Scroll of Isildur" }, { "resolve": true }, { "resolve": true }, { "cast": "Scroll of Isildur" }, { "resolve": true }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "illegal": true }, { "advance_to": "Main2" } ],
