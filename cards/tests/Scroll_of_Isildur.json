    "steps": [ { "cast": "Scroll of Isildur" }, { "resolve": true }, { "resolve": true }, { "cast": "Scroll of Isildur" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 2"] }, {} ] } },
