 {
  "name": "permanent's controller pays RR and copies, retargeting the copy at the caster",
  "players": [
   { "hand": ["Chain Lightning"], "battlefield": ["Mountain"] },
   { "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Chain Lightning", "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true, "p0"] }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Mountain"], "life": 17 },
    { "battlefield": ["Mountain", "Mountain"] }
   ]
  }
 },
 {
  "name": "ruling: a copy can be copied again by the player it targets (copies of copies)",
  "players": [
   { "hand": ["Chain Lightning"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }
  ],
  "steps": [
   { "cast": "Chain Lightning", "targets": ["p1"] },
   { "resolve": true, "answers": [true, "p0", true, "p1", false] }
  ],
  "expect": {
   "players": [
    { "life": 17 },
    { "life": 14 }
   ]
  }
 },
 {
  "name": "ruling: a spell whose target became illegal fizzles and is not copied",
  "players": [
   { "hand": ["Chain Lightning", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears", "Mountain", "Mountain"] }
  ],
  "steps": [
   { "cast": "Chain Lightning", "targets": ["Grizzly Bears"] },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Chain Lightning", "Lightning Bolt"], "life": 20 },
    { "graveyard": ["Grizzly Bears"], "life": 20 }
   ]
  }
 }
]
