[
  { "name": "taps for one B mana per storage counter removed",
    "players": [ { "battlefield": [{"name": "Bottomless Vault", "sick": false, "counters": {"storage": 3}}] }, {} ],
    "steps": [ { "tap_for_mana": "Bottomless Vault" } ],
    "expect": { "players": [ { "pool": { "B": 3 } } ], "counters": { "Bottomless Vault": { "storage": 0 } }, "tapped": { "Bottomless Vault": true } } },
  { "name": "a tapped Bottomless Vault gets a storage counter at its controller's upkeep when kept tapped",
    "players": [ { "battlefield": [{"name": "Bottomless Vault", "sick": false}] }, {} ],
    "steps": [ { "tap_for_mana": "Bottomless Vault" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "turn": 3, "counters": { "Bottomless Vault": { "storage": 1 } }, "tapped": { "Bottomless Vault": true } } },
  { "name": "choosing to untap Bottomless Vault means it gets no storage counter",
    "players": [ { "battlefield": [{"name": "Bottomless Vault", "sick": false}] }, {} ],
    "steps": [ { "tap_for_mana": "Bottomless Vault" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true } ],
    "expect": { "turn": 3, "counters": { "Bottomless Vault": { "storage": 0 } }, "tapped": { "Bottomless Vault": false } } },
  { "name": "enters tapped when played",
    "players": [ { "hand": ["Bottomless Vault"] }, {} ],
    "steps": [ { "play_land": "Bottomless Vault" } ],
    "expect": { "tapped": { "Bottomless Vault": true } } },
  { "name": "ruling: an untapped Vault gets no trigger and no storage counter at upkeep",
    "players": [ { "battlefield": [{"name": "Bottomless Vault", "sick": false}] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "counters": { "Bottomless Vault": { "storage": 0 } }, "tapped": { "Bottomless Vault": false } } },
  { "name": "ruling: Vault untapped in response to its upkeep trigger gets no storage counter",
    "players": [ { "hand": ["Burst of Energy"], "battlefield": [{"name": "Bottomless Vault", "sick": false}, "Plains"] }, {} ],
    "steps": [ { "tap_for_mana": "Bottomless Vault" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false], "hold": true }, { "cast": "Burst of Energy", "targets": ["Bottomless Vault"] }, { "pass": true }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Burst of Energy"] }, {} ], "counters": { "Bottomless Vault": { "storage": 0 } }, "tapped": { "Bottomless Vault": false } } },
  { "name": "ruling: storage counters survive a Blood Moon land-type change and are used once the land is a land again",
    "players": [ { "hand": ["Reduce to Memory"], "battlefield": ["Plains", "Plains", "Plains", {"name": "Bottomless Vault", "sick": false, "counters": {"storage": 2}}] }, { "battlefield": ["Blood Moon"] } ],
    "steps": [ { "cast": "Reduce to Memory", "targets": ["p1:Blood Moon"] }, { "resolve": true }, { "tap_for_mana": "Bottomless Vault" } ],
    "expect": { "players": [ { "pool": { "B": 2 } }, {} ], "counters": { "Bottomless Vault": { "storage": 0 } } } },
  { "name": "ruling: a Vault tapped by an external effect loses no storage counters",
    "players": [ { "battlefield": ["Icy Manipulator", "Island", {"name": "Bottomless Vault", "sick": false, "counters": {"storage": 3}}] }, {} ],
    "steps": [ { "activate": "Icy Manipulator", "targets": ["Bottomless Vault"] }, { "resolve": true } ],
    "expect": { "counters": { "Bottomless Vault": { "storage": 3 } }, "tapped": { "Bottomless Vault": true } } }
]
