[
  {
    "name": "attacking with two creatures draws a card",
    "players": [
      { "battlefield": ["Military Intelligence", { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 1 }, {} ] }
  },
  {
    "name": "attacking with one creature draws nothing",
    "players": [
      { "battlefield": ["Military Intelligence", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] }
  },
  {
    "name": "ruling: the trigger still resolves when an attacker is removed in response (Bolt on Hill Giant), and draws",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Military Intelligence", "Mountain", { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Military Intelligence", "Grizzly Bears"], "graveyard_has": ["Hill Giant", "Lightning Bolt"] }, {} ] }
  }
]
