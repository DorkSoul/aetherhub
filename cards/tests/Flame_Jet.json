  {
    "name": "ruling: cycling is an activated ability, so Stifle counters it: the card is still discarded and nothing is drawn",
    "players": [
      {
        "hand": ["Flame Jet"],
        "battlefield": ["Mountain", "Mountain"],
        "library": ["Plains"]
      },
