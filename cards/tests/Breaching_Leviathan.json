[
  {
    "name": "cast from hand: taps all nonblue creatures, which skip their next untap",
    "players": [ { "hand": ["Breaching Leviathan"], "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears", "Phantom Monster"] } ],
    "steps": [
      { "cast": "Breaching Leviathan" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Breaching Leviathan"] }, { "battlefield_has": ["Grizzly Bears", "Phantom Monster"] } ],
      "tapped": { "Grizzly Bears": true, "Phantom Monster": false }
    }
  },
  {
    "name": "ruling: the Leviathan taps my own nonblue creatures too (the blue Leviathan itself is not tapped)",
    "players": [ { "hand": ["Breaching Leviathan"], "battlefield": ["Island", "Island", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Phantom Monster"] } ],
    "steps": [ { "cast": "Breaching Leviathan" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Breaching Leviathan", "Grizzly Bears"] }, { "battlefield_has": ["Hill Giant", "Phantom Monster"] } ],
      "tapped": { "Grizzly Bears": true, "Hill Giant": true, "Phantom Monster": false, "Breaching Leviathan": false }
    }
  },
  {
    "name": "ruling: a creature stolen after it was tapped stays tapped through its new controller's next untap step",
    "players": [ { "hand": ["Breaching Leviathan", "Control Magic"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Breaching Leviathan" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Control Magic", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Breaching Leviathan", "Control Magic", "Grizzly Bears"] }, {} ],
      "tapped": { "Grizzly Bears": true }
    }
  }
]
