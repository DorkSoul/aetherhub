  { "name": "choosing to untap Ghosthelm Courier ends the pump and shroud at its controller's untap step",
    "players": [ { "battlefield": [{"name": "Ghosthelm Courier", "sick": false}, "Island", "Island", "Island"] }, { "battlefield": [{"name": "Apprentice Wizard", "sick": false}] } ],
    "steps": [ { "activate": "Ghosthelm Courier", "ability": 0, "targets": ["Apprentice Wizard"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "advance_to": "Upkeep" } ],
    "expect": { "turn": 4, "pt": { "Apprentice Wizard": [0, 1] }, "tapped": { "Ghosthelm Courier": false } } },
  { "name": "choosing not to untap keeps Ghosthelm Courier tapped, so the pump and shroud last into its controller's turn",
    "players": [ { "battlefield": [{"name": "Ghosthelm Courier", "sick": false}, "Island", "Island", "Island"] }, { "battlefield": [{"name": "Apprentice Wizard", "sick": false}] } ],
    "steps": [ { "activate": "Ghosthelm Courier", "ability": 0, "targets": ["Apprentice Wizard"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
    "expect": { "turn": 3, "pt": { "Apprentice Wizard": [2, 3] }, "keywords": { "Apprentice Wizard": ["Shroud"] }, "tapped": { "Ghosthelm Courier": true } } },
  { "name": "ruling: the Wizard check is made on resolution only; after Ixidron turns the target face down (no longer a Wizard) the pump still applies",
    "players": [ { "hand": ["Ixidron"], "battlefield": [{"name": "Ghosthelm Courier", "sick": false}, "Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": [{"name": "Apprentice Wizard", "sick": false}] } ],
    "steps": [ { "activate": "Ghosthelm Courier", "ability": 0, "targets": ["Apprentice Wizard"] }, { "resolve": true }, { "cast": "Ixidron" }, { "resolve": true } ],
    "expect": { "pt": { "Apprentice Wizard": [4, 4] }, "not_subtypes": { "Apprentice Wizard": ["Wizard"] }, "tapped": { "Ghosthelm Courier": true } } }
