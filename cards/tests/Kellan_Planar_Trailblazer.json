[
  { "name": "Scout becomes a Detective; its combat damage to a player exiles the top card",
    "players": [ { "battlefield": ["Kellan, Planar Trailblazer", "Mountain", "Mountain"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Kellan, Planar Trailblazer", "ability": 0 }, { "resolve": true },
               { "attack": [ { "card": "Kellan, Planar Trailblazer", "at": "p1" } ] },
               { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Forest"], "battlefield_has": ["Kellan, Planar Trailblazer"] }, { "life": 18 } ] } },
  { "name": "the second ability does nothing while Kellan is still a Scout",
    "players": [ { "battlefield": ["Kellan, Planar Trailblazer", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Kellan, Planar Trailblazer", "ability": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Kellan, Planar Trailblazer": [2, 1] } } },
  { "name": "Detective becomes a 3/2 double striker: 6 damage unblocked",
    "players": [ { "battlefield": ["Kellan, Planar Trailblazer", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Kellan, Planar Trailblazer", "ability": 0 }, { "resolve": true },
               { "activate": "Kellan, Planar Trailblazer", "ability": 1 }, { "resolve": true },
               { "attack": [ { "card": "Kellan, Planar Trailblazer", "at": "p1" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "pt": { "Kellan, Planar Trailblazer": [3, 2] }, "players": [ {}, { "life": 14 } ] } },
  { "name": "ruling: a +1/+1 counter survives the set-to-3/2 effect (counter is not overwritten)",
    "players": [ { "battlefield": [ { "name": "Kellan, Planar Trailblazer", "counters": { "p1p1": 1 } }, "Mountain", "Mountain", "Mountain", "Mountain", "Mountain" ] }, {} ],
    "steps": [ { "activate": "Kellan, Planar Trailblazer", "ability": 0 }, { "resolve": true },
               { "activate": "Kellan, Planar Trailblazer", "ability": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Kellan, Planar Trailblazer": [4, 3] }, "counters": { "Kellan, Planar Trailblazer": { "p1p1": 1 } } } },
  { "name": "ruling: the Detective and Rogue effects last across turns until Kellan leaves the battlefield",
    "players": [ { "battlefield": ["Kellan, Planar Trailblazer", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Kellan, Planar Trailblazer", "ability": 0 }, { "resolve": true },
               { "advance_to": "End" }, { "advance_to": "Main1" }, { "advance_to": "End" }, { "advance_to": "Main1" },
               { "activate": "Kellan, Planar Trailblazer", "ability": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Kellan, Planar Trailblazer": [3, 2] }, "subtypes": { "Kellan, Planar Trailblazer": ["Human", "Faerie", "Rogue"] } } },
  { "name": "ruling: the Detective type replaces Scout instead of being added to it",
    "players": [ { "battlefield": ["Kellan, Planar Trailblazer", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Kellan, Planar Trailblazer", "ability": 0 }, { "resolve": true } ],
    "expect": { "subtypes": { "Kellan, Planar Trailblazer": ["Human", "Faerie", "Detective"] }, "not_subtypes": { "Kellan, Planar Trailblazer": ["Scout"] } } }
]
