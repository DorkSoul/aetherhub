[
  {
    "name": "combat damage to a player: declining the sacrifice keeps Riptide Entrancer",
    "players": [ { "battlefield": ["Island", "Island", "Riptide Entrancer"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Riptide Entrancer", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2", "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Riptide Entrancer"] },
        { "life": 19, "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "combat damage to a player: sacrifice it to gain control of a creature that player controls",
    "players": [ { "battlefield": ["Island", "Island", "Riptide Entrancer"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Riptide Entrancer", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2", "answers": [true] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Riptide Entrancer"], "battlefield_has": ["Grizzly Bears"] },
        { "life": 19, "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "morph {U}{U}: a face-down 2/2 turned face up for UU is a 1/1 Riptide Entrancer",
    "players": [ { "hand": ["Riptide Entrancer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Riptide Entrancer", "alt": 254 }, { "resolve": true },
      { "activate": "Riptide Entrancer" }, { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Riptide Entrancer"] }, {} ], "pt": { "Riptide Entrancer": [1, 1] } }
  },
  {
    "name": "morph: with only one Island left after the {3} face-down cast, the morph cost cannot be paid",
    "players": [ { "hand": ["Riptide Entrancer"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Riptide Entrancer", "alt": 254 }, { "resolve": true },
      { "activate": "Riptide Entrancer", "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Riptide Entrancer"] }, {} ], "pt": { "Riptide Entrancer": [2, 2] } }
  }
]
