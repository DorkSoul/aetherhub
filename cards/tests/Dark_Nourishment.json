[
  {
    "name": "3 damage to a player and you gain 3 life",
    "players": [{ "hand": ["Dark Nourishment"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {}],
    "steps": [{ "cast": "Dark Nourishment", "targets": ["p1"] }, { "resolve": true }],
    "expect": { "players": [{ "life": 23 }, { "life": 17 }] }
  },
  {
    "name": "3 damage to a creature kills it and you still gain 3 life",
    "players": [{ "hand": ["Dark Nourishment"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Dark Nourishment", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "players": [{ "life": 23 }, { "graveyard": ["Grizzly Bears"] }] }
  },
  {
    "name": "ruling: if the target is gone on resolution the whole spell does nothing (no life gain)",
    "players": [{ "hand": ["Dark Nourishment"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }],
    "steps": [
      { "cast": "Dark Nourishment", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 20, "graveyard": ["Dark Nourishment"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] }] }
  }
]
