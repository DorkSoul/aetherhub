[
  { "name": "chapter I destroys the chosen artifact",
    "players": [ { "hand": ["Balance of Terror"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Balance of Terror" }, { "resolve": true, "targets": ["Sol Ring"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Balance of Terror"] }, { "graveyard": ["Sol Ring"] } ] } },
  { "name": "chapter I cannot target a creature: nothing is destroyed",
    "players": [ { "hand": ["Balance of Terror"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Balance of Terror" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "chapter II exiles my other permanent until the next end step",
    "players": [ { "battlefield": [ { "name": "Balance of Terror", "counters": { "lore": 1 } }, "Grizzly Bears" ] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"], "battlefield_has": ["Balance of Terror"] }, {} ] } },
  { "name": "chapter II: the exiled creature returns at the beginning of that turn's end step",
    "players": [ { "battlefield": [ { "name": "Balance of Terror", "counters": { "lore": 1 } }, "Grizzly Bears" ] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Balance of Terror", "Grizzly Bears"] }, {} ] } },
  { "name": "chapter II with no target chosen: nothing is exiled",
    "players": [ { "battlefield": [ { "name": "Balance of Terror", "counters": { "lore": 1 } }, "Grizzly Bears" ] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Balance of Terror", "Grizzly Bears"] }, {} ] } },
  { "name": "chapter III exiles the target until the end step, then the Saga is sacrificed",
    "players": [ { "battlefield": [ { "name": "Balance of Terror", "counters": { "lore": 2 } }, "Grizzly Bears" ] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard": ["Balance of Terror"], "battlefield_has": ["Grizzly Bears"] }, {} ] } }
]
