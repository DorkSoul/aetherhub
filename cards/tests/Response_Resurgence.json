[
  { "name": "Response deals 5 damage to a blocking creature",
    "players": [ { "hand": ["Response"], "battlefield": ["Mountain", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
              { "cast": "Response", "targets": ["Hill Giant"] },
              { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Response"], "battlefield_has": ["Grizzly Bears"] }, { "graveyard_has": ["Hill Giant"], "battlefield_lacks": ["Hill Giant"] } ] } },
  { "name": "Response cannot target a creature that is neither attacking nor blocking",
    "players": [ { "hand": ["Response"], "battlefield": ["Mountain", "Plains"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Response", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Response"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "Resurgence gives your creatures first strike and vigilance until end of turn",
    "players": [ { "hand": ["Response"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Response", "face": true }, { "resolve": true } ],
    "expect": { "keywords": { "Grizzly Bears": ["FirstStrike", "Vigilance"] } } },
  { "name": "Resurgence: the creature attacks again in the additional combat",
    "players": [ { "hand": ["Response"], "battlefield": ["Mountain", "Mountain", "Mountain", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Response", "face": true }, { "resolve": true },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "advance_to": "Main2" } ],
    "expect": { "turn": 1, "players": [ { "graveyard_has": ["Response"] }, { "life": 16 } ] } },
  { "name": "Resurgence needs {3}{R}{W}: illegal with only four lands",
    "players": [ { "hand": ["Response"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Response", "face": true, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Response"] }, {} ] } }
]
