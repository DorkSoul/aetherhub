[
  { "name": "attach: all creatures able to block the enchanted creature must block it",
    "players": [ { "battlefield": ["Tempting Licid", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Serra Angel"] } ],
    "steps": [
      { "activate": "Tempting Licid", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "illegal": true },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" }, { "blocker": "Serra Angel", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears", "Tempting Licid"] }, { "battlefield_has": ["Hill Giant", "Serra Angel"], "life": 20 } ] } },
  { "name": "boundary: with the Licid not attached the creature may go unblocked",
    "players": [ { "battlefield": ["Tempting Licid", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Tempting Licid", "Grizzly Bears"] }, { "life": 18 } ] } },
  { "name": "paying G ends the effect: blocking is optional again",
    "players": [ { "battlefield": ["Tempting Licid", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "activate": "Tempting Licid", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Tempting Licid", "ability": 1 },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "attached": {}, "players": [ { "battlefield_has": ["Tempting Licid", "Grizzly Bears"] }, { "life": 18 } ] } },
  { "name": "can't become an Aura without {G} for its ability",
    "players": [ { "battlefield": ["Tempting Licid", "Mountain", "Grizzly Bears"] }, { "battlefield": [] } ],
    "steps": [ { "activate": "Tempting Licid", "ability": 0, "illegal": true } ],
    "expect": {} },
  {"name": "attached: the enchanted creature must be blocked by the able creature (declaring no blocks is not allowed)", "players": [{"battlefield": ["Tempting Licid", "Forest", "Grizzly Bears"]}, {"battlefield": ["Hill Giant"]}], "steps": [{"activate": "Tempting Licid", "ability": 0, "targets": ["Grizzly Bears"]}, {"resolve": true}, {"advance_to": "Main1"}, {"advance_to": "Main1"}, {"attack": [{"card": "Grizzly Bears", "at": "p1"}]}, {"block": []}, {"advance_to": "Main2"}], "expect": {"players": [{"graveyard": ["Grizzly Bears", "Tempting Licid"]}, {"battlefield_has": ["Hill Giant"], "life": 20}]}},
  {"name": "ruling: paying G to end the effect in response to an enchantment-removal spell makes it fizzle (Licid stays)",
    "players": [ { "battlefield": ["Tempting Licid", "Forest", "Forest", "Grizzly Bears"] }, { "hand": ["Naturalize"], "battlefield": ["Forest", "Forest"] } ],
    "steps": [
