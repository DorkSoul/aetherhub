[
 { "name": "combat damage to a player exiles the top ten cards of their library",
   "players": [ { "battlefield": ["Raven Guild Master"] }, {} ],
   "steps": [ { "attack": [ { "card": "Raven Guild Master", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "life": 20 }, { "life": 19, "library_count": 10 } ] } },
 { "name": "combat damage to a creature does not trigger it",
   "players": [ { "battlefield": ["Raven Guild Master"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Raven Guild Master", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Raven Guild Master" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "library_count": 20 }, { "library_count": 20 } ] } },
 { "name": "morph {2}{U}{U}: four lands turn it face up as a 1/1",
   "players": [ { "battlefield": [ { "name": "Raven Guild Master", "face_down": true }, "Island", "Island", "Plains", "Plains" ] }, {} ],
   "steps": [ { "activate": "Raven Guild Master" }, { "resolve": true } ],
   "expect": { "pt": { "Raven Guild Master": [1, 1] }, "players": [ { "battlefield_has": ["Raven Guild Master"] }, {} ] } },
 { "name": "morph: three lands cannot turn it face up",
   "players": [ { "battlefield": [ { "name": "Raven Guild Master", "face_down": true }, "Island", "Island", "Island" ] }, {} ],
   "steps": [ { "activate": "Raven Guild Master", "illegal": true } ],
   "expect": { "pt": { "Raven Guild Master": [2, 2] }, "players": [ {}, {} ] } }
]
