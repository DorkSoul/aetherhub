[
 { "name": "survives 6 damage dealt by two different sources",
   "players": [ { "battlefield": ["Ogre Enforcer"] }, { "battlefield": ["Hill Giant", "Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Ogre Enforcer", "at": "p1" } ] },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Ogre Enforcer" }, { "blocker": "Hill Giant", "attacker": "Ogre Enforcer" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield": ["Ogre Enforcer"] }, {} ] } },
 { "name": "destroyed when a single source deals lethal damage",
   "players": [ { "battlefield": ["Ogre Enforcer"] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "attack": [ { "card": "Ogre Enforcer", "at": "p1" } ] },
              { "block": [ { "blocker": "Serra Angel", "attacker": "Ogre Enforcer" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard": ["Ogre Enforcer"] }, {} ] } },
 { "name": "deathtouch still destroys it",
   "players": [ { "battlefield": ["Ogre Enforcer"] }, { "battlefield": ["Typhoid Rats"] } ],
   "steps": [ { "attack": [ { "card": "Ogre Enforcer", "at": "p1" } ] },
              { "block": [ { "blocker": "Typhoid Rats", "attacker": "Ogre Enforcer" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard": ["Ogre Enforcer"] }, { "graveyard": ["Typhoid Rats"] } ] } },
 { "name": "non-lethal damage from one source leaves it alive and kills the blocker",
   "players": [ { "battlefield": ["Ogre Enforcer"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Ogre Enforcer", "at": "p1" } ] },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Ogre Enforcer" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield": ["Ogre Enforcer"] }, { "graveyard": ["Hill Giant"] } ] } },
 { "name": "2 damage from Grizzly Bears plus 2 from Savannah Lions (4 total, no single source lethal): survives",
   "players": [ { "battlefield": [ { "name": "Ogre Enforcer", "sick": false } ] }, { "battlefield": ["Grizzly Bears", "Savannah Lions"] } ],
   "steps": [ { "attack": [ { "card": "Ogre Enforcer", "at": "p1" } ] },
              { "block": [ { "blocker": "Grizzly Bears", "attacker": "Ogre Enforcer" }, { "blocker": "Savannah Lions", "attacker": "Ogre Enforcer" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Ogre Enforcer"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: damage from several sources that adds up to lethal (3 + 2) does not destroy it",
   "players": [ { "battlefield": [ { "name": "Ogre Enforcer", "sick": false } ] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
   "steps": [ { "attack": [ { "card": "Ogre Enforcer", "at": "p1" } ] },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Ogre Enforcer" }, { "blocker": "Grizzly Bears", "attacker": "Ogre Enforcer" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Ogre Enforcer"] }, {} ] } }
]
