[
  { "name": "dash: haste, returns to hand at the end step",
    "players": [ { "hand": ["Death-Greeter's Champion"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Death-Greeter's Champion", "alt": 0 },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Death-Greeter's Champion"] }, {} ] } },
  { "name": "backup on another creature: counter and double strike until end of turn",
    "players": [ { "hand": ["Death-Greeter's Champion"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [
      { "cast": "Death-Greeter's Champion" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 1 } }, "pt": { "Grizzly Bears": [3, 3] }, "players": [ { "battlefield_has": ["Death-Greeter's Champion", "Grizzly Bears"] }, {} ] } },
  { "name": "ruling: backup targeting itself puts the counter on the creature itself",
    "players": [ { "hand": ["Death-Greeter's Champion"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Death-Greeter's Champion" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "counters": { "Death-Greeter's Champion": { "p1p1": 1 } }, "pt": { "Death-Greeter's Champion": [3, 2] }, "players": [ { "battlefield_has": ["Death-Greeter's Champion"] }, {} ] } },
  { "name": "ruling: backup given to another creature does not remove the creature's own printed double strike",
    "players": [ { "hand": ["Death-Greeter's Champion"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [
      { "cast": "Death-Greeter's Champion" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "keywords": { "Death-Greeter's Champion": ["DoubleStrike"], "Grizzly Bears": ["DoubleStrike"] }, "players": [ { "battlefield_has": ["Death-Greeter's Champion", "Grizzly Bears"] }, {} ] } }
]
