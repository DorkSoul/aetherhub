[
 {
  "name": "Spell Crumple counters Lightning Bolt: bolt and Crumple go to library bottoms",
  "players": [
   { "hand": ["Spell Crumple"], "battlefield": ["Island", "Island", "Island", "Hill Giant"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"], "library": ["Forest", "Plains"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
   { "cast": "Spell Crumple", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant"], "graveyard": [], "library_count": 21 },
    { "library_count": 3, "graveyard": [] }
   ]
  }
 },
 {
  "name": "Spell Crumple cannot be cast with no spell on the stack",
  "players": [
   { "hand": ["Spell Crumple"], "battlefield": ["Island", "Island", "Island"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "cast": "Spell Crumple", "illegal": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Spell Crumple"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: Crumple's target countered in response is illegal; Crumple goes to the graveyard, not the library bottom",
  "players": [
   { "hand": ["Spell Crumple", "Counterspell"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Hill Giant"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
   { "cast": "Spell Crumple", "targets": [{ "stack": "Lightning Bolt" }] },
   { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Spell Crumple"], "library_count": 20 },
    { "graveyard_has": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: Crumple on an uncounterable Cragplate Baloth: Baloth stays, Crumple still goes to the library bottom",
  "players": [
   { "hand": ["Cragplate Baloth"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
   { "hand": ["Spell Crumple"], "battlefield": ["Island", "Island", "Island"] }
  ],
  "steps": [
   { "cast": "Cragplate Baloth" },
   { "pass": true },
   { "cast": "Spell Crumple", "player": 1, "targets": [{ "stack": "Cragplate Baloth" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Cragplate Baloth"] },
    { "library_count": 21, "graveyard": [] }
   ]
  }
 }
]
