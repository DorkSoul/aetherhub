[
  {
    "name": "can't block a creature with power 2 or less",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Cyclops Tyrant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [{}, { "life": 18, "battlefield": ["Cyclops Tyrant"] }]
    }
  },
  {
    "name": "can block a creature with power 3",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Cyclops Tyrant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Cyclops Tyrant", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Hill Giant"] }, { "battlefield": ["Cyclops Tyrant"] }]
    }
  },
  {
    "name": "a declared blocker that can't block power 2 or less is dropped: the attacker is unblocked",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Cyclops Tyrant", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Cyclops Tyrant", "attacker": "Grizzly Bears" }], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [{}, { "life": 18, "battlefield_has": ["Cyclops Tyrant", "Hill Giant"] }]
    }
  },
  {
    "name": "ruling: a blocker keeps blocking when the attacker's power drops to 2 or less",
    "players": [
      { "hand": ["Disfigure"], "battlefield": ["Hill Giant", "Swamp"] },
      { "battlefield": ["Cyclops Tyrant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Cyclops Tyrant", "attacker": "Hill Giant" }], "player": 1 },
      { "cast": "Disfigure", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Hill Giant", "Disfigure"] }, { "life": 20, "battlefield_has": ["Cyclops Tyrant"] }]
    }
  }
]
