        {}
      ],
      "pt": { "Grizzly Bears": [2, 2], "Hill Giant": [3, 3] }
    }
  },
  {
    "name": "ruling: bolster is determined on resolution, so the flyer destroyed by the spell is no longer a candidate",
    "players": [
