[
 {
  "name": "an opponent with more cards in hand at the end step: Joined Researchers becomes prepared (copy of Secret Rendezvous in exile)",
  "players": [
   {
    "hand": [
     "Forest"
    ],
    "battlefield": [
     "Joined Researchers // Secret Rendezvous"
    ]
   },
   {
    "hand": [
     "Island",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "End",
    "auto": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Joined Researchers // Secret Rendezvous"
     ],
     "exile": [
      "Secret Rendezvous"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "an opponent with no more cards in hand than you: not prepared",
  "players": [
   {
    "hand": [
     "Forest",
     "Forest"
    ],
    "battlefield": [
     "Joined Researchers // Secret Rendezvous"
    ]
   },
   {
    "hand": [
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "advance_to": "End",
    "auto": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Joined Researchers // Secret Rendezvous"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "prepared copy of Secret Rendezvous cast from exile: each player draws three",
  "players": [{ "hand": ["Forest"], "battlefield": ["Joined Researchers // Secret Rendezvous", "Plains", "Plains", "Plains"] }, { "hand": ["Island", "Island"] }],
  "steps": [{ "advance_to": "End", "auto": true }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Secret Rendezvous", "targets": ["p1"] }, { "resolve": true }],
  "expect": { "players": [{ "hand_count": 5 }, { "hand_count": 6 }] }
 },
 {
  "name": "the Secret Rendezvous back face cannot be cast from hand",
  "players": [{ "hand": ["Joined Researchers // Secret Rendezvous"], "battlefield": ["Plains", "Plains", "Plains"] }, {}],
  "steps": [{ "cast": "Joined Researchers // Secret Rendezvous", "face": true, "targets": ["p1"], "illegal": true }],
  "expect": { "players": [{ "hand_count": 1 }, { "hand_count": 0 }] }
 },
 {
  "name": "ruling: the end-step check is strict; equal hand sizes do not make it prepared",
  "players": [
   { "hand": ["Forest"], "battlefield": ["Joined Researchers // Secret Rendezvous"] },
   { "hand": ["Island"] }
  ],
  "steps": [
   { "advance_to": "End", "auto": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Joined Researchers // Secret Rendezvous"], "exile": [] },
    {}
   ]
  }
 },
 {
  "name": "ruling: casting the prepared copy removes it from exile (the creature is no longer prepared)",
  "players": [{ "hand": ["Forest"], "battlefield": ["Joined Researchers // Secret Rendezvous", "Plains", "Plains", "Plains"] }, { "hand": ["Island", "Island"] }],
  "steps": [{ "advance_to": "End", "auto": true }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Secret Rendezvous", "targets": ["p1"] }, { "resolve": true }],
  "expect": { "players": [{ "exile": [], "battlefield_has": ["Joined Researchers // Secret Rendezvous"] }, {}] }
 }
]