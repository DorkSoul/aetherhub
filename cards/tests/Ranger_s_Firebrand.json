 {
  "name": "ruling: the Ring tempts you even with no creature: you get The Ring 1 emblem",
  "players": [ { "hand": [ "Ranger's Firebrand" ], "battlefield": [ "Mountain" ] }, {} ],
  "steps": [ { "cast": "Ranger's Firebrand", "targets": [ "p1" ] }, { "resolve": true } ],
  "expect": { "players": [ { "command": [ "The Ring 1" ] }, { "life": 18 } ] }
 },
 {
  "name": "ruling: a second tempt keeps one The Ring emblem (now The Ring 2)",
  "players": [ { "hand": [ "Ranger's Firebrand", "Ranger's Firebrand" ], "battlefield": [ "Mountain", "Mountain" ] }, {} ],
  "steps": [
   { "cast": "Ranger's Firebrand", "targets": [ "p1" ] },
   { "resolve": true },
   { "cast": "Ranger's Firebrand", "targets": [ "p1" ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "command": [ "The Ring 2" ] }, { "life": 16 } ] }
 },
 {
  "name": "ruling: a lone creature is chosen as Ring-bearer, so Hill Giant cannot block it (greater power)",
  "players": [ { "hand": [ "Ranger's Firebrand" ], "battlefield": [ "Mountain", "Grizzly Bears" ] }, { "battlefield": [ "Hill Giant" ] } ],
  "steps": [
   { "cast": "Ranger's Firebrand", "targets": [ "p1" ] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "illegal": true },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "battlefield_has": [ "Grizzly Bears" ] }, { "life": 16, "battlefield_has": [ "Hill Giant" ] } ] }
 },
 {
  "name": "ruling: after a second tempt the Ring-bearer keeps the first ring ability (Hill Giant still cannot block it)",
  "players": [ { "hand": [ "Ranger's Firebrand", "Ranger's Firebrand" ], "battlefield": [ "Mountain", "Mountain", "Grizzly Bears" ] }, { "battlefield": [ "Hill Giant" ] } ],
  "steps": [
   { "cast": "Ranger's Firebrand", "targets": [ "p1" ] },
   { "resolve": true },
   { "cast": "Ranger's Firebrand", "targets": [ "p1" ] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "illegal": true },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "command": [ "The Ring 2" ], "battlefield_has": [ "Grizzly Bears" ] }, { "life": 14, "battlefield_has": [ "Hill Giant" ] } ] }
 }
