[
  { "name": "equip {1}: equipped creature gets +0/+2 and toxic 1",
    "players": [ { "battlefield": ["Prosthetic Injector", "Grizzly Bears", "Mountain"] }, {} ],
    "steps": [ { "activate": "Prosthetic Injector", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "attached": { "Prosthetic Injector": "Grizzly Bears" }, "pt": { "Grizzly Bears": [2, 4] } } },
  { "name": "no mana to equip: cannot activate",
