    "steps": [ { "activate": "Prosthetic Injector", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: poison is one counter per combat damage event, whatever the damage (Hill Giant deals 3)",
    "players": [ { "battlefield": ["Prosthetic Injector", "Hill Giant", "Mountain"] }, {} ],
    "steps": [ { "activate": "Prosthetic Injector", "targets": ["Hill Giant"] }, { "resolve": true },
               { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17, "poison": 1 } ], "pt": { "Hill Giant": [3, 5] } } },
  { "name": "ruling: toxic does not change combat damage: a 2-power creature deals 2 (life 18) and gives 1 poison",
    "players": [ { "battlefield": ["Prosthetic Injector", "Grizzly Bears", "Mountain"] }, {} ],
    "steps": [ { "activate": "Prosthetic Injector", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18, "poison": 1 } ] } },
  { "name": "ruling: blocked by a creature, the equipped creature's toxic gives no poison",
    "players": [ { "battlefield": ["Prosthetic Injector", "Grizzly Bears", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Prosthetic Injector", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20, "poison": 0 } ] } },
  { "name": "ruling: a player with ten poison counters loses (state-based, the ninth-to-tenth counter)",
    "players": [ { "battlefield": ["Prosthetic Injector", "Grizzly Bears", "Mountain"] }, { "poison": 9 } ],
    "steps": [ { "activate": "Prosthetic Injector", "targets": ["Grizzly Bears"] }, { "resolve": true },
