    "expect": { "winner": 0 } },
  { "name": "ruling: nine poison counters is not yet a loss (game continues)",
    "players": [ { "battlefield": ["Prosthetic Injector", "Grizzly Bears", "Mountain"] }, { "poison": 8 } ],
    "steps": [ { "activate": "Prosthetic Injector", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "poison": 9 } ], "winner": -1 } },
  { "name": "ruling: other effects of the damage still apply (lifelink gains life alongside the poison)",
    "players": [ { "battlefield": ["Prosthetic Injector", "Vampire Nighthawk", "Mountain"] }, {} ],
