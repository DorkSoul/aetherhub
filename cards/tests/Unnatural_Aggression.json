[
  {
    "name": "fights an opposing creature and exiles it if it dies",
    "players": [
      {
        "hand": [
          "Unnatural Aggression"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Unnatural Aggression",
        "targets": [
          "Hill Giant",
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Hill Giant"
          ]
        },
        {
          "exile": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "your creature dies in the fight and goes to the graveyard, not exile",
    "players": [
      {
        "hand": [
          "Unnatural Aggression"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Unnatural Aggression",
        "targets": [
          "Grizzly Bears",
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield_has": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: an opposing creature that survives the fight but dies later this turn is exiled",
    "players": [
      {
        "hand": ["Unnatural Aggression", "Lightning Bolt"],
        "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Grizzly Bears"]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Unnatural Aggression", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] },
        { "exile": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: if your creature becomes an illegal target, the fight does not happen",
    "players": [
      {
        "hand": ["Unnatural Aggression", "Lightning Bolt"],
        "battlefield": ["Forest", "Forest", "Forest", "Mountain", "Hill Giant"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Unnatural Aggression", "targets": ["Hill Giant", "Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Hill Giant", "Lightning Bolt"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
