  {
    "name": "ruling: while split second is on the stack an instant can't be cast",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Sulfur Elemental"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Sulfur Elemental", "player": 1 },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Lightning Bolt"] },
        { "battlefield_has": ["Sulfur Elemental", "Grizzly Bears"] }
      ]
