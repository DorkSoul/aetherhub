  {
    "name": "ruling: split second does not affect a spell already on the stack: Lightning Bolt still resolves",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Sulfur Elemental"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Sulfur Elemental", "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
