[
  {
    "name": "ETB creates a Royal Role on another creature you control",
    "players": [
      { "hand": ["Redtooth Genealogist"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Redtooth Genealogist" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Redtooth Genealogist", "Royal Role", "Grizzly Bears"] },
        {}
      ],
      "attached": { "Royal Role": "Grizzly Bears" },
      "pt": { "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "no other creature to target: no Royal Role",
    "players": [
      { "hand": ["Redtooth Genealogist"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Redtooth Genealogist" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Redtooth Genealogist"], "battlefield_lacks": ["Royal Role"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: two Royal Roles from one controller on one creature: the older goes to the graveyard, so Bears stay 3/3",
    "players": [
      { "hand": ["Redtooth Genealogist", "Redtooth Genealogist"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Redtooth Genealogist" },
      { "resolve": true },
      { "cast": "Redtooth Genealogist" },
      { "resolve": true, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Redtooth Genealogist", "Grizzly Bears"] },
        {}
      ],
      "pt": { "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "ruling: target gone when the ETB trigger resolves: no Royal Role is created",
    "players": [
      { "hand": ["Redtooth Genealogist"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Redtooth Genealogist" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Redtooth Genealogist"], "battlefield_lacks": ["Royal Role", "Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  }
]
