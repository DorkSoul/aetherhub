      { "resolve": true },
      { "cast": "Pyreswipe Hawk" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hill Giant", "Pyreswipe Hawk"] },
        { "battlefield_has": ["Sol Ring"] }
      ]
    }
  }
