  {
    "name": "ruling: Hawk leaves before its expend 6 ability resolves, so no artifact changes control",
    "players": [
      {
        "hand": ["Hill Giant", "Divination"],
        "battlefield": ["Pyreswipe Hawk", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island", "Island"]
      },
      {
        "hand": ["Terror"],
        "battlefield": ["Sol Ring", "Swamp", "Swamp"]
      }
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true },
      { "cast": "Divination", "targets": ["Sol Ring"] },
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Pyreswipe Hawk"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Divination", "Pyreswipe Hawk"], "battlefield_lacks": ["Sol Ring"] },
        { "battlefield_has": ["Sol Ring"], "graveyard": ["Terror"] }
      ]
    }
  },
  {
    "name": "ruling: Hawk entering after the sixth mana was spent does not get an expend 6 trigger that turn",
