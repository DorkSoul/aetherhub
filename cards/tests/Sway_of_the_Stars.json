  ],
  "steps": [ { "cast": "Drag the Canal" }, { "resolve": true }, { "cast": "Sway of the Stars" }, { "resolve": true } ],
  "expect": {
   "players": [
    { "life": 7, "battlefield": [], "graveyard": ["Sway of the Stars"], "hand_count": 7, "library_count": 26 },
