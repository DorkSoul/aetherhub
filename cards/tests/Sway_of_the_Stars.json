   ]
  }
 },
 {
  "name": "spell is not shuffled into the library: it goes to the graveyard after resolving",
  "players": [
   { "hand": ["Sway of the Stars"], "battlefield": ["Island", "Island", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [ { "cast": "Sway of the Stars" }, { "resolve": true } ],
  "expect": {
   "players": [
    { "graveyard": ["Sway of the Stars"], "library_count": 23, "hand_count": 7 },
    { "library_count": 14, "hand_count": 7 }
   ]
  }
 },
 {
  "name": "ruling: tokens are not shuffled into the library and cease to exist",
  "players": [
   { "hand": ["Drag the Canal", "Sway of the Stars"], "battlefield": ["Island", "Island", "Island", "Swamp", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
