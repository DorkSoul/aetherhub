                { "battlefield": ["Hill Giant", "Serra Angel"] } ],
   "steps": [ { "tap_for_mana": "Plains" }, { "tap_for_mana": "Island" }, { "tap_for_mana": "Swamp" }, { "tap_for_mana": "Mountain" }, { "tap_for_mana": "Forest" },
              { "cast": "Disciple of Caelus Nin" }, { "resolve": true, "answers": [ [ "Grizzly Bears", "Plains" ], [ "Hill Giant" ] ] },
              { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Disciple of Caelus Nin"], "battlefield_lacks": ["Walking Corpse"] }, { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Serra Angel"] } ] } },
 { "name": "ruling: a phased-out permanent does not phase in at its controller's untap step while Caelus Nin is on the battlefield",
   "players": [ { "hand": ["Disciple of Caelus Nin"], "battlefield": ["Plains", "Island", "Swamp", "Mountain", "Forest"] },
                { "battlefield": ["Hill Giant", "Serra Angel"] } ],
   "steps": [ { "tap_for_mana": "Plains" }, { "tap_for_mana": "Island" }, { "tap_for_mana": "Swamp" }, { "tap_for_mana": "Mountain" }, { "tap_for_mana": "Forest" },
              { "cast": "Disciple of Caelus Nin" }, { "resolve": true, "answers": [ [ "Plains" ], [ "Hill Giant" ] ] },
              { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
   "expect": { "players": [ { "battlefield_has": ["Disciple of Caelus Nin"] }, { "battlefield_has": ["Hill Giant"], "battlefield_lacks": ["Serra Angel"] } ] } },
 { "name": "ruling: a phased-out creature can't be the target of a spell",
   "players": [ { "hand": ["Disciple of Caelus Nin", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Swamp", "Mountain", "Forest", "Mountain", "Walking Corpse"] }, {} ],
   "steps": [ { "tap_for_mana": "Plains" }, { "tap_for_mana": "Island" }, { "tap_for_mana": "Swamp" }, { "tap_for_mana": "Forest" }, { "tap_for_mana": "Mountain" },
              { "cast": "Disciple of Caelus Nin" }, { "resolve": true, "answers": [ [ "Mountain", "Mountain", "Plains", "Island", "Swamp" ] ] },
              { "cast": "Lightning Bolt", "targets": ["Walking Corpse"], "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Disciple of Caelus Nin", "Mountain"], "battlefield_lacks": ["Walking Corpse"], "hand_count": 1 }, {} ] } },
 { "name": "ruling: Banisher Priest phasing out does not return the creature it exiled",
   "players": [ { "hand": ["Banisher Priest", "Disciple of Caelus Nin"], "battlefield": ["Plains", "Plains", "Plains", "Island", "Swamp", "Mountain", "Forest", "Forest"] },
                { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Banisher Priest" }, { "resolve": true },
              { "cast": "Disciple of Caelus Nin" }, { "resolve": true, "answers": [ [ "Plains", "Plains", "Plains", "Island", "Swamp" ] ] } ],
   "expect": { "players": [ { "battlefield_has": ["Disciple of Caelus Nin"], "battlefield_lacks": ["Banisher Priest"] }, { "exile": ["Hill Giant"] } ] } }
