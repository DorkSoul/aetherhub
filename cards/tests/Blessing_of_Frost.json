[
 { "name": "distributes snow-mana counters among chosen creatures, then draws per power-4 creature",
   "players": [ { "hand": ["Blessing of Frost"], "battlefield": ["Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Grizzly Bears", "Hill Giant"], "library": ["Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Blessing of Frost" }, { "resolve": true, "answers": [ [ "Grizzly Bears", "Hill Giant" ], 3 ] } ],
   "expect": { "pt": { "Grizzly Bears": [5, 5], "Hill Giant": [4, 4] }, "players": [ { "hand_count": 2 }, {} ] } },
 { "name": "choosing no creatures puts no counters",
   "players": [ { "hand": ["Blessing of Frost"], "battlefield": ["Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Grizzly Bears"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Blessing of Frost" }, { "resolve": true, "answers": [ [] ] } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] }, "players": [ { "hand_count": 0 }, {} ] } },
 { "name": "ruling: the power-4 draw count uses power after the counters are put on",
   "players": [ { "hand": ["Blessing of Frost"], "battlefield": ["Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Hill Giant"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Blessing of Frost" }, { "resolve": true, "answers": [ [ "Hill Giant" ] ] } ],
   "expect": { "pt": { "Hill Giant": [7, 7] }, "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "ruling: snow mana of any color counts toward X",
   "players": [ { "hand": ["Blessing of Frost"], "battlefield": ["Snow-Covered Forest", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Hill Giant"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Blessing of Frost" }, { "resolve": true, "answers": [ [ "Hill Giant" ] ] } ],
   "expect": { "pt": { "Hill Giant": [7, 7] }, "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "ruling: without snow mana no counters are put, but the draw still happens",
   "players": [ { "hand": ["Blessing of Frost"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Craw Wurm"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Blessing of Frost" }, { "resolve": true } ],
   "expect": { "pt": { "Craw Wurm": [6, 4] }, "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "ruling: protection from green does not stop a non-targeting counter distribution",
   "players": [ { "hand": ["Gods Willing", "Blessing of Frost"], "battlefield": ["Plains", "Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Grizzly Bears"], "library": ["Forest"] }, {} ],
   "steps": [
     { "cast": "Gods Willing", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [4] },
     { "cast": "Blessing of Frost" }, { "resolve": true, "answers": [ [ "Grizzly Bears" ] ] }
   ],
   "expect": { "pt": { "Grizzly Bears": [6, 6] }, "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "ruling: a copy of Blessing of Frost has no snow mana spent, so only the original puts counters",
   "players": [ { "hand": ["Twincast", "Blessing of Frost"], "battlefield": ["Island", "Island", "Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Snow-Covered Forest", "Craw Wurm"], "library": ["Forest", "Forest"] }, {} ],
   "steps": [
     { "cast": "Blessing of Frost" },
     { "cast": "Twincast", "targets": [ { "stack": "Blessing of Frost" } ] },
     { "resolve": true, "answers": [ [], [ "Craw Wurm" ] ] }
   ],
   "expect": { "pt": { "Craw Wurm": [10, 8] }, "players": [ { "hand_count": 2 }, {} ] } }
]
