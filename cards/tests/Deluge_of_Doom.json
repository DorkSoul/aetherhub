[
  { "name": "-X/-X where X is the card types in your graveyard",
    "players": [
      { "hand": ["Deluge of Doom"], "battlefield": ["Swamp", "Swamp", "Swamp", "Llanowar Elves"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [ { "cast": "Deluge of Doom" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Deluge of Doom", "Llanowar Elves"], "battlefield_lacks": ["Llanowar Elves"] }, { "battlefield_has": ["Hill Giant"] } ], "pt": { "Hill Giant": [1, 1] } } },
  { "name": "only your graveyard counts: opponent's card types do not",
    "players": [
      { "hand": ["Deluge of Doom"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "graveyard": ["Lightning Bolt", "Grizzly Bears", "Shock"], "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Deluge of Doom" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Llanowar Elves"] } ], "pt": { "Llanowar Elves": [1, 1] } } },
  { "name": "one card type: a 2/2 becomes 1/1 and survives",
    "players": [
      { "hand": ["Deluge of Doom"], "battlefield": ["Swamp", "Swamp", "Swamp"], "graveyard": ["Lightning Bolt"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Deluge of Doom" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [1, 1] } } }
]
