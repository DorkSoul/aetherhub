[
  {
    "name": "each player mills two then you reanimate the lone creature card in a graveyard",
    "players": [
      {
        "hand": ["Extract from Darkness"],
        "battlefield": ["Island", "Swamp", "Forest", "Forest", "Forest"],
        "library": ["Plains", "Plains"]
      },
      {
        "library": ["Forest", "Forest"],
        "graveyard": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Extract from Darkness" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Extract from Darkness", "Plains", "Plains"] },
        { "graveyard": ["Forest", "Forest"] }
      ]
    }
  },
  {
    "name": "the chosen creature may come from an opponent's graveyard",
    "players": [
      {
        "hand": ["Extract from Darkness"],
        "battlefield": ["Island", "Swamp", "Forest", "Forest", "Forest"],
        "graveyard": ["Hill Giant"]
      },
      {
        "graveyard": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Extract from Darkness" },
      { "resolve": true, "answers": [1] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Extract from Darkness", "Forest", "Forest", "Hill Giant"] },
        { "graveyard": ["Forest", "Forest"] }
      ]
    }
  },
  {
    "name": "with no creature card in any graveyard nothing enters the battlefield",
    "players": [
      {
        "hand": ["Extract from Darkness"],
        "battlefield": ["Island", "Swamp", "Forest", "Forest", "Forest"],
        "library": ["Plains", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Extract from Darkness" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Island"], "graveyard": ["Extract from Darkness", "Plains", "Plains"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a creature milled by Extract from Darkness itself can be the one put onto the battlefield",
    "players": [
      { "hand": ["Extract from Darkness"], "battlefield": ["Island", "Swamp", "Forest", "Forest", "Forest"] },
      { "library": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [ { "cast": "Extract from Darkness" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Extract from Darkness"] },
        { "graveyard": ["Forest"] }
      ]
    }
  }
]
