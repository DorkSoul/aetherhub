[
  {
    "name": "forage by sacrificing a Food returns a permanent card from your graveyard",
    "players": [
      { "hand": ["Curious Forager"], "battlefield": ["Forest", "Forest", "Forest", "Food"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Curious Forager" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Curious Forager"], "battlefield_lacks": ["Food"] }, {} ]
    }
  },
  {
    "name": "declining to forage leaves the graveyard alone",
    "players": [
      { "hand": ["Curious Forager"], "battlefield": ["Forest", "Forest", "Forest", "Food"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Curious Forager" },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Food"] }, {} ]
    }
  },
  {
    "name": "ruling: the reflexive return target is chosen as its ability goes on the stack (Sol Ring, not Grizzly Bears)",
    "players": [
      { "hand": ["Curious Forager"], "battlefield": ["Forest", "Forest", "Forest", "Food"], "graveyard": ["Grizzly Bears", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "cast": "Curious Forager" },
      { "resolve": true, "answers": [true, "Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Sol Ring"], "graveyard": ["Grizzly Bears"], "battlefield_has": ["Curious Forager"], "battlefield_lacks": ["Food"] }, {} ]
    }
  },
  {
    "name": "ruling: with fewer than three graveyard cards and no Food there is no forage",
    "players": [
      { "hand": ["Curious Forager"], "battlefield": ["Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "cast": "Curious Forager" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0, "graveyard": ["Grizzly Bears", "Sol Ring"], "battlefield_has": ["Curious Forager"] }, {} ]
    }
  }
]
