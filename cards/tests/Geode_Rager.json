   { "attack": [ { "card": "Hill Giant", "at": "p0" } ], "player": 1, "illegal": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p0" }, { "card": "Hill Giant", "at": "p0" } ], "player": 1 },
   { "block": [], "player": 0 },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "life": 15 }, {} ]
  }
 },
 {
  "name": "ruling: a goaded creature must attack again in the additional combat from Aggravated Assault",
  "players": [
