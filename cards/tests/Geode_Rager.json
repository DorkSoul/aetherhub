   { "advance_to": "Main1", "player": 1 },
   { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
   { "block": [], "player": 0 },
   { "advance_to": "Main2", "player": 1 },
   { "activate": "Aggravated Assault", "player": 1 },
   { "resolve": true },
   { "attack": [], "player": 1, "illegal": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
   { "block": [], "player": 0 },
