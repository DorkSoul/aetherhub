[
 {
  "name": "no equipment: 1/1",
  "players": [{"battlefield": ["Myr Adapter"]}, {}],
  "steps": [],
  "expect": {"pt": {"Myr Adapter": [1, 1]}}
 },
 {
  "name": "gets +1/+1 for an Equipment attached to it",
  "players": [{"battlefield": ["Bonesplitter", "Myr Adapter", "Mountain"]}, {}],
  "steps": [
   {"activate": "Bonesplitter", "targets": ["Myr Adapter"]},
   {"resolve": true}
  ],
  "expect": {"pt": {"Myr Adapter": [4, 2]}, "attached": {"Bonesplitter": "Myr Adapter"}}
 },
 {
  "name": "Equipment attached to another creature does not count",
  "players": [{"battlefield": ["Bonesplitter", "Myr Adapter", "Grizzly Bears", "Mountain"]}, {}],
  "steps": [
   {"activate": "Bonesplitter", "targets": ["Grizzly Bears"]},
   {"resolve": true}
  ],
  "expect": {"pt": {"Myr Adapter": [1, 1], "Grizzly Bears": [4, 2]}}
 }
]
