[
  {
    "name": "gains control of an artifact while it stays on the battlefield",
    "players": [
      {
        "hand": [
          "Master Thief"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Sol Ring"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Master Thief"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Sol Ring",
            "Master Thief"
          ]
        },
        {
          "battlefield_lacks": [
            "Sol Ring"
          ]
        }
      ]
    }
  },
  {
    "name": "control ends when Master Thief leaves the battlefield",
    "players": [
      {
        "hand": [
          "Master Thief"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Sol Ring",
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Master Thief"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "Master Thief"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Sol Ring"
          ]
        },
        {
          "battlefield_has": [
            "Sol Ring"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: Master Thief dies in response to its ETB trigger, so no control is gained",
    "players": [
      {"hand": ["Master Thief"], "battlefield": ["Island", "Island", "Island", "Island"]},
      {"hand": ["Lightning Bolt"], "battlefield": ["Sol Ring", "Mountain"]}
    ],
    "steps": [
      {"cast": "Master Thief"},
      {"resolve": true},
      {"pass": true},
      {"cast": "Lightning Bolt", "player": 1, "targets": ["Master Thief"]},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"graveyard": ["Master Thief"], "battlefield_lacks": ["Sol Ring"]},
        {"battlefield_has": ["Sol Ring"]}
      ]
    }
  }
]
