[
  { "name": "at the first main phase adds U and R to the pool",
    "players": [ { "battlefield": ["Abstract Paintmage"] }, {} ],
    "start": "Upkeep",
    "steps": [ { "advance_to": "Main1" }, { "resolve": true } ],
    "expect": { "players": [ { "restricted_pool": { "U": 1, "R": 1 } }, {} ] } },
  { "name": "the pooled R pays for an instant",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Abstract Paintmage"] }, { "battlefield": ["Grizzly Bears"] } ],
    "start": "Upkeep",
    "steps": [ { "advance_to": "Main1" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "restricted_pool": { "U": 1 } }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "the pooled mana cannot pay for a creature spell",
    "players": [ { "hand": ["Hill Giant"], "battlefield": ["Abstract Paintmage", "Mountain", "Mountain"] }, {} ],
    "start": "Upkeep",
    "steps": [ { "advance_to": "Main1" }, { "resolve": true }, { "cast": "Hill Giant", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Hill Giant"] }, {} ] } }
]
