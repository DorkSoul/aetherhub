  {
    "name": "ruling: with no creature card in any graveyard nothing is imprinted, so the activation copies nothing",
    "players": [
      {
        "hand": ["Dermotaxi"],
        "battlefield": ["Forest", "Forest", "Grizzly Bears", "Hill Giant"]
      },
      {}
    ],
    "steps": [
      { "cast": "Dermotaxi" },
      { "resolve": true },
      { "activate": "Dermotaxi", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dermotaxi", "Grizzly Bears", "Hill Giant"], "exile": [] },
        {}
      ],
      "tapped": { "Grizzly Bears": true, "Hill Giant": true },
      "pt": { "Dermotaxi": [0, 0] }
