  {
    "name": "only one untapped creature: the ability can't be activated",
    "players": [
      {
        "hand": [
          "Dermotaxi"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Grizzly Bears"
        ]
      },
      {
