        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Grizzly Bears",
          "Hill Giant"
        ]
      },
      {
        "graveyard": [
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Dermotaxi"
      },
      {
        "resolve": true
      },
      {
        "activate": "Dermotaxi",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Llanowar Elves": [
          1,
          1
        ]
      }
