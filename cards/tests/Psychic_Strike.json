      { "cast": "Psychic Strike", "player": 1, "targets": [ { "stack": "Carnage Tyrant" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Carnage Tyrant"], "library_count": 18 },
        { "graveyard_has": ["Psychic Strike"] }
