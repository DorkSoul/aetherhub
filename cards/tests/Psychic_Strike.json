      { "hand": ["Carnage Tyrant"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "hand": ["Psychic Strike"], "battlefield": ["Island", "Swamp", "Swamp"] }
    ],
    "steps": [
