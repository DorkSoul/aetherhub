[
 {
  "name": "toughness equals the number of Knights you control",
  "players": [
   {
    "battlefield": [
     "Wintermoor Commander",
     "Benalish Knight"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Main1"
   }
  ],
  "expect": {
   "pt": {
    "Wintermoor Commander": [
     2,
     2
    ]
   }
  }
 },
 {
  "name": "attack trigger gives another Knight indestructible",
  "players": [
   {
    "battlefield": [
     "Wintermoor Commander",
     "Benalish Knight"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Wintermoor Commander",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 18
    }
   ],
   "keywords": {
    "Benalish Knight": [
     "Indestructible"
    ],
    "Wintermoor Commander": [
     "Deathtouch"
    ]
   }
  }
 },
 {
  "name": "ruling: it counts itself, so alone it is a 2/1",
  "players": [ { "battlefield": ["Wintermoor Commander"] }, {} ],
  "steps": [ { "advance_to": "Main1" } ],
  "expect": { "pt": { "Wintermoor Commander": [2, 1] } }
 },
 {
  "name": "ruling: damage stays marked, so losing a Knight makes the marked damage lethal",
  "players": [ { "hand": ["Shock", "Shock"], "battlefield": ["Mountain", "Mountain", "Wintermoor Commander", "Benalish Knight", "Knight of Meadowgrain"] }, {} ],
  "steps": [
   { "cast": "Shock", "targets": ["Wintermoor Commander"] }, { "resolve": true },
   { "cast": "Shock", "targets": ["Knight of Meadowgrain"] }, { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Benalish Knight"], "battlefield_lacks": ["Wintermoor Commander", "Knight of Meadowgrain"] }, {} ] }
 },
 {
  "name": "ruling: two damage does not kill it while three Knights are out",
  "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Wintermoor Commander", "Benalish Knight", "Knight of Meadowgrain"] }, {} ],
  "steps": [ { "cast": "Shock", "targets": ["Wintermoor Commander"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Wintermoor Commander"] }, {} ], "pt": { "Wintermoor Commander": [2, 3] } }
 }
]