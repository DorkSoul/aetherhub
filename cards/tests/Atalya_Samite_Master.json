[
  {
    "name": "X paid with white mana: gain X life, Atalya taps",
    "players": [
      { "battlefield": [{ "name": "Atalya, Samite Master", "sick": false }, "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Atalya, Samite Master", "ability": 0, "answers": [2] },
      { "resolve": true, "answers": [[1]] }
    ],
    "expect": {
      "tapped": { "Atalya, Samite Master": true, "Plains": true },
      "players": [ { "life": 22 }, {} ]
    }
  },
  {
    "name": "X can only be paid with white mana: an Island is not used for X",
    "players": [
      { "battlefield": [{ "name": "Atalya, Samite Master", "sick": false }, "Plains", "Plains", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Atalya, Samite Master", "ability": 0, "answers": [2] },
      { "resolve": true, "answers": [[1]] }
    ],
    "expect": {
      "tapped": { "Island": false },
      "players": [ { "life": 22 }, {} ]
    }
  },
  {
    "name": "prevent X damage to target creature: a 3-damage Bolt deals only 1",
    "players": [
      { "battlefield": [{ "name": "Atalya, Samite Master", "sick": false }, "Plains", "Plains", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Atalya, Samite Master", "ability": 0, "answers": [2] },
      { "resolve": true, "answers": [[0], "Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  },
  {
    "name": "X paid with white mana only: the Island stays untapped while the Plains pays X=1",
    "players": [
      { "battlefield": [{ "name": "Atalya, Samite Master", "sick": false }, "Island", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Atalya, Samite Master", "ability": 0, "answers": [1] },
      { "resolve": true, "answers": [[1]] }
    ],
    "expect": {
      "tapped": { "Island": false },
      "players": [ { "life": 21 }, {} ]
    }
  },
  {
    "name": "ruling: white-only X also applies to the prevention mode (Island not tapped)",
    "players": [
      { "battlefield": [{ "name": "Atalya, Samite Master", "sick": false }, "Plains", "Plains", "Island", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Atalya, Samite Master", "ability": 0, "answers": [2] },
      { "resolve": true, "answers": [[0], "Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Island": false },
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  }
]
