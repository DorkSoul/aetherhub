[
  {
    "name": "islandwalk: unblockable while the defending player controls an Island, damage reveals a random card",
    "players": [
      { "battlefield": [{ "name": "Merfolk Spy", "sick": false }] },
      { "battlefield": ["Island", "Grizzly Bears"], "hand": ["Hill Giant", "Serra Angel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Merfolk Spy", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19, "hand_count": 2, "battlefield": ["Island", "Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "no Island: Grizzly Bears can block, so no combat damage and no reveal",
    "players": [
      { "battlefield": [{ "name": "Merfolk Spy", "sick": false }] },
      { "battlefield": ["Forest", "Grizzly Bears"], "hand": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Merfolk Spy", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Merfolk Spy" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Merfolk Spy"] },
        { "life": 20, "hand_count": 1 }
      ]
    }
  },
  {
    "name": "empty hand: the damage still goes through and nothing is revealed",
    "players": [
      { "battlefield": [{ "name": "Merfolk Spy", "sick": false }] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "attack": [{ "card": "Merfolk Spy", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19, "hand_count": 0 }
      ]
    }
  },
  {
    "name": "ruling: Islandwalk checks the land type Island, so a Tropical Island (Forest Island) makes the Spy unblockable",
    "players": [
      { "battlefield": [{ "name": "Merfolk Spy", "sick": false }] },
      { "battlefield": ["Tropical Island", "Grizzly Bears"], "hand": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Merfolk Spy", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Merfolk Spy" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19, "hand_count": 1 }
      ]
    }
  }
]
