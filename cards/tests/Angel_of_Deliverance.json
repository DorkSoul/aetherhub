[
  {
    "name": "delirium: exiles a creature an opponent controls when it deals damage",
    "players": [
      {
        "battlefield": [
          "Angel of Deliverance"
        ],
        "graveyard": [
          "Grizzly Bears",
          "Lightning Bolt",
          "Plains",
          "Mind Rot"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Angel of Deliverance",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 14,
          "exile": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "without delirium (three card types) there is no trigger",
    "players": [
      {
        "battlefield": [
          "Angel of Deliverance"
        ],
        "graveyard": [
          "Grizzly Bears",
          "Lightning Bolt",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Angel of Deliverance",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 14,
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: four cards of only three card types do not enable delirium",
    "players": [
      { "battlefield": ["Angel of Deliverance"], "graveyard": ["Grizzly Bears", "Hill Giant", "Lightning Bolt", "Mind Rot"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Angel of Deliverance", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 14, "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: supertypes and subtypes do not count as card types for delirium",
    "players": [
      { "battlefield": ["Angel of Deliverance"], "graveyard": ["Grizzly Bears", "Hill Giant", "Plains", "Lightning Bolt"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Angel of Deliverance", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 14, "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: delirium still triggers when the Angel dies to the same combat damage",
    "players": [
      { "battlefield": ["Angel of Deliverance"], "graveyard": ["Grizzly Bears", "Lightning Bolt", "Plains", "Mind Rot"] },
      { "hand": ["Archon's Glory"], "battlefield": ["Lashwhip Predator", "Plains"] }
    ],
    "steps": [
      { "attack": [ { "card": "Angel of Deliverance", "at": "p1" } ] },
      { "block": [ { "blocker": "Lashwhip Predator", "attacker": "Angel of Deliverance" } ] },
      { "pass": true },
      { "cast": "Archon's Glory", "targets": ["Lashwhip Predator"], "player": 1 },
      { "pass": true },
      { "pass": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Angel of Deliverance", "Grizzly Bears", "Lightning Bolt", "Mind Rot", "Plains"] }, { "exile": ["Lashwhip Predator"] } ] }
  }
]
