[
  {
    "name": "regeneration replaces the destruction of the creature",
    "players": [
      { "hand": ["Regenerate"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Regenerate", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Regenerate"] },
        { "graveyard": ["Doom Blade"] }
      ]
    }
  },
  {
    "name": "without a regeneration shield the creature is destroyed",
    "players": [
      { "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        { "graveyard": ["Doom Blade"] }
      ]
    }
  }
]
