[
  {
    "name": "casting a spell that targets a creature you control draws a card and sets base power to hand size",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Ms. Marvel, Kamala Khan", "Forest"] }, {} ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Ms. Marvel, Kamala Khan"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "hand_count": 1 }, {}], "pt": { "Ms. Marvel, Kamala Khan": [4, 7] } }
  },
  {
    "name": "the base power follows the hand size when the effect is resolved",
    "players": [ { "hand": ["Giant Growth", "Island", "Island"], "battlefield": ["Ms. Marvel, Kamala Khan", "Forest"] }, {} ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Ms. Marvel, Kamala Khan"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "hand_count": 3 }, {}], "pt": { "Ms. Marvel, Kamala Khan": [6, 7] } }
  },
  {
    "name": "a spell that targets only an opponent's creature does not trigger it",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Ms. Marvel, Kamala Khan", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "hand_count": 0 }, {}], "pt": { "Ms. Marvel, Kamala Khan": [1, 4] } }
  },
  {
    "name": "no maximum hand size: an eight-card hand is kept through cleanup",
    "players": [ { "hand": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"], "battlefield": ["Ms. Marvel, Kamala Khan"] }, {} ],
    "steps": [ { "advance_to": "Upkeep", "auto": true } ],
    "expect": { "players": [ { "hand_count": 8 }, {} ] }
  }
]
