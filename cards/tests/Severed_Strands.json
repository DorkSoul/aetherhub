[
  { "name": "sacrifice a 3-toughness creature: gain 3 life and destroy target opposing creature",
    "players": [ { "hand": ["Severed Strands"], "battlefield": ["Swamp", "Swamp", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Severed Strands", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Severed Strands", "Hill Giant"], "life": 23 }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "sacrifice a 2-toughness creature: gain 2 life",
    "players": [ { "hand": ["Severed Strands"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Severed Strands", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Severed Strands", "Grizzly Bears"], "life": 22 }, { "graveyard": ["Hill Giant"] } ] } },
  { "name": "cannot target own creature",
    "players": [ { "hand": ["Severed Strands"], "battlefield": ["Swamp", "Swamp", "Hill Giant", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Severed Strands", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Severed Strands"] }, {} ] } },
  { "name": "ruling: an indestructible target is still a legal target and life is still gained",
    "players": [ { "hand": ["Severed Strands"], "battlefield": ["Swamp", "Swamp", "Hill Giant"] }, { "battlefield": ["Darksteel Colossus"] } ],
    "steps": [ { "cast": "Severed Strands", "targets": ["Darksteel Colossus"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Severed Strands", "Hill Giant"], "life": 23 }, { "battlefield_has": ["Darksteel Colossus"], "graveyard": [] } ] } },
  { "name": "ruling: exactly one creature is sacrificed even with two to choose from",
    "players": [ { "hand": ["Severed Strands"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears", "Hill Giant"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "cast": "Severed Strands", "targets": ["Llanowar Elves"], "answers": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Severed Strands", "Grizzly Bears"], "battlefield_has": ["Hill Giant"], "life": 22 }, { "graveyard": ["Llanowar Elves"] } ] } },
  { "name": "ruling: life gained is the sacrificed creature's toughness as it last existed (with counters)",
    "players": [ { "hand": ["Severed Strands"], "battlefield": ["Swamp", "Swamp", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "cast": "Severed Strands", "targets": ["Llanowar Elves"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"], "life": 24 }, { "graveyard": ["Llanowar Elves"] } ] } },
  { "name": "ruling: if the target is gone on resolution the spell does nothing and no life is gained",
    "players": [ { "hand": ["Severed Strands"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Llanowar Elves"] } ],
    "steps": [ { "cast": "Severed Strands", "targets": ["Llanowar Elves"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Llanowar Elves"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears", "Severed Strands"], "life": 20 }, { "graveyard_has": ["Lightning Bolt", "Llanowar Elves"] } ] } }
]
