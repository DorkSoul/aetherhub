[
  {
    "name": "a -1/-1 counter you put with an ability makes an Insect",
    "players": [
      { "hand": ["Serrated Arrows"], "battlefield": ["Nest of Scarabs", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Giant Spider"] }
    ],
    "steps": [
      { "cast": "Serrated Arrows" },
      { "resolve": true },
      { "activate": "Serrated Arrows", "targets": ["Giant Spider"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Giant Spider": { "m1m1": 1 } },
      "players": [
        { "battlefield_has": ["Nest of Scarabs", "Serrated Arrows", "Insect 1-1 Black"] },
        {}
      ]
    }
  },
  {
    "name": "infect damage from combat puts -1/-1 counters you control on a blocker and makes an Insect",
    "players": [
      { "battlefield": ["Nest of Scarabs", "Priests of Norn"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Priests of Norn", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Priests of Norn" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "M1M1": 1 } },
      "players": [
        { "battlefield_has": ["Nest of Scarabs", "Insect 1-1 Black"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "no -1/-1 counter placed means no Insect",
    "players": [
      { "battlefield": ["Nest of Scarabs", "Priests of Norn"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Priests of Norn", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Nest of Scarabs", "Priests of Norn"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: four -1/-1 counters at once make four Insects, even though toughness goes negative",
    "players": [
      { "hand": ["Blight Rot"], "battlefield": ["Nest of Scarabs", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Blight Rot", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Nest of Scarabs", "Insect 1-1 Black", "Insect 1-1 Black", "Insect 1-1 Black", "Insect 1-1 Black"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: an opponent's infect blocker puts the counters, so your Nest makes no Insect",
    "players": [
      { "battlefield": ["Nest of Scarabs", "Grizzly Bears"] },
      { "battlefield": ["Priests of Norn"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Priests of Norn", "attacker": "Grizzly Bears" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "M1M1": 1 } },
      "players": [
        { "battlefield_has": ["Nest of Scarabs", "Grizzly Bears"], "battlefield_lacks": ["Insect 1-1 Black"] },
        { "battlefield_has": ["Priests of Norn"] }
      ]
    }
  }
]
