[
 { "name": "casting an instant draws a card",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Archmage Emeritus", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "copying an instant with Twincast draws a card for the copy",
   "players": [ { "hand": ["Lightning Bolt", "Twincast"], "battlefield": ["Archmage Emeritus", "Island", "Island", "Mountain"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "cast": "Twincast", "targets": [ { "stack": "Lightning Bolt" } ] },
              { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 3 }, {} ] } },
 { "name": "casting a creature spell does not draw",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Archmage Emeritus", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0 }, {} ] } },
 { "name": "an opponent's instant does not draw for you",
   "players": [ { "battlefield": ["Archmage Emeritus"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0 }, {} ] } },
 { "name": "ruling: an effect copying two spells creates two copies, and each copy triggers magecraft",
   "players": [ { "hand": ["Lightning Bolt", "Giant Growth", "Display of Power"], "battlefield": ["Archmage Emeritus", "Mountain", "Mountain", "Mountain", "Forest", "Island"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
              { "cast": "Giant Growth", "targets": ["Archmage Emeritus"] },
              { "cast": "Display of Power", "targets": [ { "stack": "Lightning Bolt" }, { "stack": "Giant Growth" } ], "auto": true },
              { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "hand_count": 5 }, {} ] } }
]
