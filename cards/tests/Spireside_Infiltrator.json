[
  {
    "name": "deals 1 damage to each opponent when it becomes tapped by attacking",
    "players": [ { "battlefield": ["Spireside Infiltrator"] }, {} ],
    "steps": [ { "attack": [ { "card": "Spireside Infiltrator", "at": "p1" } ] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "no trigger without becoming tapped",
    "players": [ { "battlefield": ["Spireside Infiltrator"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "ruling: an effect tapping an already tapped Spireside Infiltrator does not trigger",
    "players": [ { "battlefield": ["Icy Manipulator", "Island", { "name": "Spireside Infiltrator", "tapped": true }] }, {} ],
    "steps": [ { "activate": "Icy Manipulator", "targets": ["Spireside Infiltrator"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20 } ], "tapped": { "Spireside Infiltrator": true } }
  },
  {
    "name": "ruling: an effect tapping an untapped Spireside Infiltrator triggers it",
    "players": [ { "battlefield": ["Icy Manipulator", "Island", "Spireside Infiltrator"] }, {} ],
    "steps": [ { "activate": "Icy Manipulator", "targets": ["Spireside Infiltrator"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19 } ], "tapped": { "Spireside Infiltrator": true } }
  }
]
