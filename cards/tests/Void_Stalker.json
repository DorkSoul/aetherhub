[
  {
    "name": "puts itself and the target creature on top of their owners' libraries",
    "players": [
      { "battlefield": ["Void Stalker", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Void Stalker", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Void Stalker"], "library_count": 21 },
        { "battlefield_lacks": ["Grizzly Bears"], "library_count": 21 }
      ]
    }
  },
  {
    "name": "targeting itself moves only one card to the library",
    "players": [
      { "battlefield": ["Void Stalker", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Void Stalker", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Void Stalker"], "library_count": 21 }, {}]
    }
  },
  {
    "name": "ruling: Stalker killed in response: its ability still puts the targeted creature on top of its owner's library",
    "players": [
      { "battlefield": ["Void Stalker", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Void Stalker", "ability": 0, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Void Stalker"], "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Void Stalker"], "library_count": 20 },
        { "battlefield_lacks": ["Grizzly Bears"], "library_count": 21 }
      ]
    }
  },
  {
    "name": "ruling: target gone in response: the ability does nothing and Void Stalker stays on the battlefield",
    "players": [
      { "battlefield": ["Void Stalker", "Island", "Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Void Stalker", "ability": 0, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Void Stalker"], "library_count": 20 },
        { "graveyard_has": ["Grizzly Bears"], "library_count": 20 }
      ]
    }
  }
]
