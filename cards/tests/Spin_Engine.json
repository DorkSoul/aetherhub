[
  {
    "name": "target creature can't block it this turn",
    "players": [
      { "battlefield": ["Spin Engine", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Spin Engine", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Spin Engine", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Spin Engine" }], "player": 1, "illegal": true },
      { "block": [], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "the restriction covers only Spin Engine, not other attackers",
    "players": [
      { "battlefield": ["Spin Engine", "Hill Giant", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Spin Engine", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "can't activate without red mana",
    "players": [
      { "battlefield": ["Spin Engine", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Spin Engine", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Grizzly Bears"] }]
    }
  }
]
