[
  {
    "name": "flying and vigilance are shared with the other creatures at your upkeep",
    "players": [
      {
        "battlefield": ["Concerted Effort", "Serra Angel", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "keywords": {
        "Grizzly Bears": ["Flying", "Vigilance"]
      }
    }
  },
  {
    "name": "nothing is shared when no creature has the keyword",
    "players": [
      {
        "battlefield": ["Concerted Effort", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"}
    ],
    "expect": {
      "keywords": {
        "Grizzly Bears": []
      }
    }
  },
  {
    "name": "landwalk is shared",
    "players": [
      {
        "battlefield": ["Concerted Effort", "Bull Hippo", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"},
      {"resolve": true}
    ],
    "expect": {
      "keywords": {
        "Grizzly Bears": ["Islandwalk"]
      }
    }
  },
  {
    "name": "protection from black is shared, so Doom Blade cannot target the Bears",
    "players": [
      {
        "hand": ["Doom Blade"],
        "battlefield": ["Concerted Effort", "White Knight", "Grizzly Bears", "Swamp", "Island"]
      },
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"},
      {"resolve": true},
      {"cast": "Doom Blade", "targets": ["Grizzly Bears"], "illegal": true}
    ],
    "expect": {
      "players": [
        {"battlefield": ["Concerted Effort", "White Knight", "Grizzly Bears", "Swamp", "Island"]},
        {}
      ]
    }
  },
  {
    "name": "double strike, trample and the four landwalks are shared at upkeep",
    "players": [
      { "battlefield": ["Concerted Effort", "Grizzly Bears", "Lizard Blades", "Gemrazer", "Boggart Arsonists", "Bog Wraith", "Dwarven Grunt", "Boggart Loggers"] },
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"},
      {"resolve": true},
      {"resolve": true},
      {"resolve": true},
      {"resolve": true},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "keywords": {
        "Grizzly Bears": ["DoubleStrike", "Trample", "Plainswalk", "Swampwalk", "Mountainwalk", "Forestwalk"]
      }
    }
  },
  {
    "name": "fear is shared at upkeep when a creature you control has fear",
    "players": [
      { "battlefield": ["Concerted Effort", "Phobian Phantasm", "Grizzly Bears", "Swamp"] },
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep", "answers": [true]},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "keywords": {
        "Grizzly Bears": ["Fear"]
      }
    }
  },
  {
    "name": "ruling: every creature gets the keywords shared from several creatures at upkeep",
    "players": [
      {"battlefield": ["Concerted Effort", "Serra Angel", "Bull Hippo", "Grizzly Bears"]},
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"},
      {"resolve": true},
      {"resolve": true},
      {"resolve": true}
    ],
    "expect": {
      "keywords": {
        "Grizzly Bears": ["Flying", "Vigilance", "Islandwalk"],
        "Serra Angel": ["Islandwalk"]
      }
    }
  },
  {
    "name": "ruling: flying and vigilance granted at upkeep last the turn even after the creature that had them is removed",
    "players": [
      {"hand": ["Doom Blade"], "battlefield": ["Concerted Effort", "Serra Angel", "Grizzly Bears", "Swamp", "Island"]},
      {}
    ],
    "steps": [
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"},
      {"resolve": true},
      {"resolve": true},
      {"cast": "Doom Blade", "targets": ["Serra Angel"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"graveyard_has": ["Serra Angel", "Doom Blade"]},
        {}
      ],
      "keywords": {
        "Grizzly Bears": ["Flying", "Vigilance"]
      }
    }
  }
]
