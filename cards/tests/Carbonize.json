[
  {
    "name": "3 damage kills a creature and exiles it instead",
    "players": [
      { "hand": ["Carbonize"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Carbonize", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Carbonize"] }, { "exile": ["Hill Giant"] }]
    }
  },
  {
    "name": "3 damage does not kill a 4/4 creature (Serra Angel), which stays on the battlefield",
    "players": [
      { "hand": ["Carbonize"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Carbonize", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Carbonize"] }, { "battlefield_has": ["Serra Angel"] }]
    }
  },
  {
    "name": "a regeneration shield can't save the creature from exile",
    "players": [
      { "hand": ["Carbonize"], "battlefield": ["Mountain", "Mountain", "Mountain", "Swamp", "Drudge Skeletons"] },
      {}
    ],
    "steps": [
      { "activate": "Drudge Skeletons" },
      { "resolve": true },
      { "cast": "Carbonize", "targets": ["Drudge Skeletons"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Carbonize"], "exile": ["Drudge Skeletons"] }, {}]
    }
  },
  {
    "name": "3 damage to a player: life loss, nothing exiled",
    "players": [
      { "hand": ["Carbonize"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Carbonize", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Carbonize"] }, { "life": 17 }]
    }
  },
  {
    "name": "ruling: a creature that dies to later damage this turn (Lightning Bolt after Carbonize) is exiled",
    "players": [
      { "hand": ["Carbonize", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Carbonize", "targets": ["Serra Angel"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Carbonize", "Lightning Bolt"] }, { "exile": ["Serra Angel"] }]
    }
  }
]
