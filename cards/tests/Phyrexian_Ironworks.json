[
  {
    "name": "attacking gives one energy and the energy ability needs three",
    "players": [
      { "battlefield": ["Phyrexian Ironworks", { "name": "Grizzly Bears", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Phyrexian Ironworks", "illegal": true }
    ],
    "expect": {
      "players": [ { "energy": 1, "battlefield_has": ["Phyrexian Ironworks"] }, {} ]
    }
  },
  {
    "name": "three attacks over two turns give three energy; tap and pay EEE makes a 3/3 Golem",
    "players": [
      { "battlefield": ["Phyrexian Ironworks", { "name": "Grizzly Bears", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Phyrexian Ironworks" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "energy": 0, "battlefield_has": ["Phyrexian Ironworks", "Phyrexian Golem 3-3", "Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: energy is not mana and persists across turns",
    "players": [
      { "battlefield": ["Phyrexian Ironworks", { "name": "Grizzly Bears", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "energy": 1, "battlefield_has": ["Phyrexian Ironworks"] }, {} ]
    }
  },
  {
    "name": "ruling: you can't pay more energy than you have (two energy is not enough)",
    "players": [ { "energy": 2, "battlefield": ["Phyrexian Ironworks"] }, {} ],
    "steps": [ { "activate": "Phyrexian Ironworks", "illegal": true } ],
    "expect": {
      "players": [ { "energy": 2, "battlefield_has": ["Phyrexian Ironworks"] }, {} ]
    }
  },
  {
    "name": "ruling: paying exactly three energy leaves none and creates the Golem",
    "players": [ { "energy": 3, "battlefield": ["Phyrexian Ironworks"] }, {} ],
    "steps": [
      { "activate": "Phyrexian Ironworks" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "energy": 0, "battlefield_has": ["Phyrexian Ironworks", "Phyrexian Golem 3-3"] }, {} ]
    }
  }
]
