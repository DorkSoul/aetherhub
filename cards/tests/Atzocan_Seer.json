[
 {
  "name": "sacrifice to return a Dinosaur from the graveyard to hand",
  "players": [
   { "battlefield": ["Atzocan Seer"], "graveyard": ["Ancient Brontodon"] },
   {}
  ],
  "steps": [
   { "activate": "Atzocan Seer", "targets": ["Ancient Brontodon"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Ancient Brontodon"], "battlefield_lacks": ["Atzocan Seer"] }, {} ] }
 },
 {
  "name": "no Dinosaur in graveyard: the sacrifice ability is illegal",
  "players": [
   { "battlefield": ["Atzocan Seer"], "graveyard": ["Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "activate": "Atzocan Seer", "illegal": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Atzocan Seer"] }, {} ] }
 },
 {
  "name": "ruling: the sacrifice ability has no {T}, so it can be activated while the creature is tapped",
  "players": [
   { "battlefield": ["Atzocan Seer"], "graveyard": ["Ancient Brontodon"] },
   {}
  ],
  "steps": [
   { "tap_for_mana": "Atzocan Seer" },
   { "activate": "Atzocan Seer", "targets": ["Ancient Brontodon"] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Ancient Brontodon"], "battlefield_lacks": ["Atzocan Seer"] }, {} ] }
 }
]
