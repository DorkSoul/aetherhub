[
  { "name": "ETB: you and the opponent each get a tapped Powerstone",
    "players": [ { "hand": ["Thran Spider"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Thran Spider" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Thran Spider", "Powerstone"] }, { "battlefield_has": ["Powerstone"] } ] } },
  { "name": "{7}: an artifact from the top four goes to hand, the rest stay in the library",
    "players": [ { "battlefield": ["Thran Spider", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"],
                   "library": ["Grizzly Bears", "Forest", "Ornithopter", "Island"] }, {} ],
    "steps": [ { "activate": "Thran Spider", "ability": 0 }, { "resolve": true, "answers": ["Ornithopter"] } ],
    "expect": { "players": [ { "hand": ["Ornithopter"], "battlefield_has": ["Thran Spider"] }, {} ] } },
  { "name": "{7}: no artifact in the top four, nothing is taken",
    "players": [ { "battlefield": ["Thran Spider", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"],
                   "library": ["Grizzly Bears", "Forest", "Island", "Hill Giant"] }, {} ],
    "steps": [ { "activate": "Thran Spider", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Thran Spider"] }, {} ] } },
  { "name": "ruling: a Powerstone's mana can pay for an activated ability of an artifact permanent (Thran Spider)",
    "players": [ { "battlefield": ["Thran Spider", "Powerstone", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Forest", "Ornithopter", "Island"] }, {} ],
    "steps": [ { "activate": "Thran Spider", "ability": 0 }, { "resolve": true, "answers": ["Ornithopter"] } ],
    "expect": { "players": [ { "hand": ["Ornithopter"], "battlefield_has": ["Thran Spider"] }, {} ] } },
  { "name": "ruling: a Powerstone's mana cannot be spent to cast a nonartifact spell",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Powerstone"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
