[
  {
    "name": "taps the enchanted creature when it enters",
    "players": [
      {
        "hand": [
          "Stuck in Summoner's Sanctum"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Stuck in Summoner's Sanctum",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Stuck in Summoner's Sanctum"
          ]
        },
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ],
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "enchanted creature does not untap in its controller's untap step",
    "players": [
      {
        "hand": [
          "Stuck in Summoner's Sanctum"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Stuck in Summoner's Sanctum",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep",
        "player": 1
      },
      {
        "advance_to": "Main1",
        "player": 1
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ],
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "the enchanted creature's sacrifice mana ability cannot be used: no other source for the Bolt",
    "players": [
      {
        "hand": ["Stuck in Summoner's Sanctum", "Lightning Bolt"],
        "battlefield": ["Island", "Island", "Island", "Skirk Prospector"]
      },
      {}
    ],
    "steps": [
      { "cast": "Stuck in Summoner's Sanctum", "targets": ["Skirk Prospector"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Lightning Bolt"], "battlefield_has": ["Stuck in Summoner's Sanctum", "Skirk Prospector"] }, {} ]
    }
  },
  {
    "name": "ruling: equip is an activated ability (colon in its reminder text), so an enchanted Equipment cannot be equipped",
    "players": [
      {
        "hand": ["Stuck in Summoner's Sanctum"],
        "battlefield": ["Island", "Island", "Island", "Goblin Morningstar", "Grizzly Bears", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Stuck in Summoner's Sanctum", "targets": ["Goblin Morningstar"] },
      { "resolve": true },
      { "activate": "Goblin Morningstar", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Stuck in Summoner's Sanctum", "Goblin Morningstar", "Grizzly Bears"] },
        {}
      ],
      "attached": { "Stuck in Summoner's Sanctum": "Goblin Morningstar" }
    }
  }
]
