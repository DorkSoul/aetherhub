[
 {
  "name": "a creature becoming tapped lets you add a quest counter",
  "players": [
   {
    "battlefield": [
     "Forest",
     "Quest for Renewal",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true,
    "answers": [
     true
    ]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "counters": {
    "Quest for Renewal": {
     "quest": 1
    }
   }
  }
 },
 {
  "name": "declining the quest counter adds nothing",
  "players": [
   {
    "battlefield": [
     "Forest",
     "Quest for Renewal",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true,
    "answers": [
     false
    ]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "counters": {
    "Quest for Renewal": {
     "quest": 0
    }
   }
  }
 },
 {
  "name": "four quest counters untap your creatures during the opponent's untap step",
  "players": [
   {
    "battlefield": [
     "Forest",
     {
      "name": "Quest for Renewal",
      "counters": {
       "quest": 4
      }
     },
     {
      "name": "Grizzly Bears",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": false
   }
  }
 },
 {
  "name": "fewer than four quest counters leave them tapped",
  "players": [
   {
    "battlefield": [
     "Forest",
     {
      "name": "Quest for Renewal",
      "counters": {
       "quest": 3
      }
     },
     {
      "name": "Grizzly Bears",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true
   }
  }
 },
 {
  "name": "ruling: Deep-Slumber Titan (doesn't untap during your untap step) still untaps during the opponent's untap step",
  "players": [
   {
    "battlefield": [
     "Forest",
     {
      "name": "Quest for Renewal",
      "counters": {
       "quest": 4
      }
     },
     {
      "name": "Deep-Slumber Titan",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   }
  ],
  "expect": {
   "tapped": {
    "Deep-Slumber Titan": false
   }
  }
 }
]
