[
  {
    "name": "without raid: 3 damage does not kill a 4-toughness creature",
    "players": [
      { "hand": ["Firecannon Blast"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Firecannon Blast", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Serra Angel"] }]
    }
  },
  {
    "name": "raid: 6 damage kills a 4-toughness creature after attacking this turn",
    "players": [
      { "hand": ["Firecannon Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Firecannon Blast", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Firecannon Blast"] }, { "graveyard": ["Serra Angel"] }]
    }
  },
  {
    "name": "ruling: raid still holds when the attacking creature died in combat",
    "players": [
      { "hand": ["Firecannon Blast"], "battlefield": ["Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Serra Angel", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Grizzly Bears" }], "player": 1 },
      { "advance_to": "Main2" },
      { "cast": "Firecannon Blast", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears", "Firecannon Blast"] }, { "graveyard": ["Serra Angel"], "battlefield_has": ["Hill Giant"] } ]
    }
  }
]
