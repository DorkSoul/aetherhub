[
 {
  "name": "enters: investigate (a Clue token)",
  "players": [ { "hand": ["Persuasive Interrogators"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains", "Island", "Island"] }, {} ],
  "steps": [ { "cast": "Persuasive Interrogators" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Persuasive Interrogators", "Clue"] }, {} ] }
 },
 {
  "name": "sacrificing a Clue: target opponent gets two poison counters",
  "players": [ { "battlefield": ["Persuasive Interrogators", "Clue", "Plains", "Plains"] }, {} ],
  "steps": [ { "activate": "Clue" }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_lacks": ["Clue"] }, { "poison": 2, "life": 20 } ] }
 },
 {
  "name": "no Clue sacrificed: no poison",
  "players": [ { "battlefield": ["Persuasive Interrogators"] }, {} ],
  "steps": [ { "advance_to": "Main1" } ],
  "expect": { "players": [ {}, { "poison": 0, "life": 20 } ] }
 },
 {
  "name": "ruling: sacrificing Wrench (a Clue artifact) for its own draw ability still gives two poison counters",
  "players": [ { "battlefield": ["Persuasive Interrogators", "Wrench", "Plains", "Plains"] }, {} ],
  "steps": [ { "activate": "Wrench", "ability": 0 }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Persuasive Interrogators"], "battlefield_lacks": ["Wrench"] }, { "poison": 2, "life": 20 } ] }
 }
]
