[
  {
    "name": "makes a permanent black: Doom Blade (nonblack creature) can no longer target it",
    "players": [
      { "hand": ["Deathlace", "Doom Blade"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Deathlace", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Doom Blade", "illegal": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Deathlace"] }, {} ]
    }
  },
  {
    "name": "can target a spell on the stack and it still resolves (Lightning Bolt hits its controller)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "hand": ["Deathlace"], "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Deathlace", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "graveyard": ["Deathlace"] } ]
    }
  }
]
