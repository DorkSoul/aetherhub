[
  { "name": "expend 8: return up to one permanent card from your graveyard to hand",
    "players": [ { "hand": ["Harmonize", "Harmonize"], "battlefield": ["Trailtracker Scout", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true }, { "cast": "Harmonize", "answers": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 7 }, {} ] } },
  { "name": "only seven mana spent on spells: no trigger",
    "players": [ { "hand": ["Harmonize", "Divination"], "battlefield": ["Trailtracker Scout", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true }, { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a permanent entering after expend 8 was already reached this turn does not trigger",
    "players": [ { "hand": ["Harmonize", "Harmonize", "Trailtracker Scout"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true }, { "cast": "Harmonize" }, { "resolve": true }, { "cast": "Trailtracker Scout" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Trailtracker Scout"] }, {} ] } },
  { "name": "ruling: expend N triggers only once per turn (a later spend does not trigger again)",
    "players": [ { "hand": ["Harmonize", "Harmonize", "Divination"], "battlefield": ["Trailtracker Scout", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Island", "Island", "Island"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true }, { "cast": "Harmonize", "answers": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Llanowar Elves"] }, {} ] } }
]
