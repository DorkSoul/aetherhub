      { "battlefield": ["Ragost, Deft Gastronaut", "Mountain", "Nutrient Block"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "activate": "Ragost, Deft Gastronaut", "ability": 0 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Island"], "graveyard": ["Nutrient Block"] }, { "life": 17 } ]
    }
  },
  {
    "name": "ruling: a Food already sacrificed for its own ability cannot also pay Ragost's cost",
    "players": [
      { "battlefield": ["Ragost, Deft Gastronaut", "Mountain", "Plains", "Plains", "Nutrient Block"], "library": ["Island"] },
      {}
    ],
    "steps": [
      { "activate": "Nutrient Block", "ability": 0 },
      { "activate": "Ragost, Deft Gastronaut", "ability": 0, "illegal": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 23, "hand": ["Island"], "graveyard": ["Nutrient Block"] }, { "life": 20 } ]
