[
  { "name": "upkeep adds a charge counter",
    "players": [ { "battlefield": ["Shrine of Boundless Growth"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Shrine of Boundless Growth": { "charge": 1 } } } },
  { "name": "sacrificed for one colorless mana per charge counter",
    "players": [ { "hand": ["Shriekhorn"], "battlefield": [ { "name": "Shrine of Boundless Growth", "counters": { "charge": 1 } } ] }, {} ],
    "steps": [ { "cast": "Shriekhorn" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Shriekhorn"], "graveyard": ["Shrine of Boundless Growth"] }, {} ] } },
  { "name": "no charge counters: no mana from the shrine",
    "players": [ { "hand": ["Shriekhorn"], "battlefield": ["Shrine of Boundless Growth"] }, {} ],
    "steps": [ { "cast": "Shriekhorn", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Shriekhorn"] }, {} ] } },
  { "name": "casting a green spell adds a charge counter",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Shrine of Boundless Growth", "Forest", { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Shrine of Boundless Growth": { "charge": 1 } } } },
  { "name": "casting a non-green spell adds no charge counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Shrine of Boundless Growth", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Shrine of Boundless Growth": {} } } }
]
