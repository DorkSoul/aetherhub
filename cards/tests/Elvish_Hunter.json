[
  {
    "name": "target creature stays tapped through its controller's next untap step",
    "players": [ { "battlefield": ["Forest", "Forest", "Elvish Hunter", "Grizzly Bears"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "activate": "Elvish Hunter", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "without the activation the creature untaps normally",
    "players": [ { "battlefield": ["Forest", "Forest", "Elvish Hunter", "Grizzly Bears"] }, {} ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "tapped": { "Grizzly Bears": false } }
  },
  {
    "name": "ruling: any creature may be targeted, even an untapped one",
    "players": [ { "battlefield": ["Forest", "Forest", "Elvish Hunter"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Elvish Hunter", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "tapped": { "Elvish Hunter": true, "Grizzly Bears": false } }
  }
]
