[
 {
  "name": "attacking Dragon taps an opposing nonland permanent",
  "players": [
   {
    "battlefield": [
     "Ojutai, Soul of Winter"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Ojutai, Soul of Winter",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {}
   ],
   "tapped": {
    "Grizzly Bears": true
   }
  }
 },
 {
  "name": "a non-Dragon attacker does not trigger",
  "players": [
   {
    "battlefield": [
     "Ojutai, Soul of Winter",
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Plains"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {}
   ],
   "tapped": {
    "Plains": false
   }
  }
 },
 {
  "name": "ruling: a tapped target stays tapped through its controller's next untap step",
  "players": [
   {
    "battlefield": ["Ojutai, Soul of Winter"]
   },
   {
    "battlefield": [{ "name": "Grizzly Bears", "tapped": true }]
   }
  ],
  "steps": [
   { "attack": [{ "card": "Ojutai, Soul of Winter", "at": "p1" }] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "players": [{}, {}],
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "ruling: the skipped untap applies once, so the creature untaps in the untap step after that",
  "players": [
   {
    "battlefield": ["Ojutai, Soul of Winter"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "attack": [{ "card": "Ojutai, Soul of Winter", "at": "p1" }] },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "players": [{}, {}],
   "tapped": { "Grizzly Bears": false }
  }
 }
]