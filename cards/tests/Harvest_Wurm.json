    "steps": [ { "cast": "Harvest Wurm" }, { "resolve": true, "answers": [[0]] } ],
    "expect": { "players": [ { "battlefield_has": ["Harvest Wurm"], "hand": ["Forest"] }, {} ] } },
  { "name": "choosing to sacrifice sacrifices it even with a basic land available",
    "players": [ { "hand": ["Harvest Wurm"], "battlefield": ["Forest", "Forest"], "graveyard": ["Forest"] }, {} ],
    "steps": [ { "cast": "Harvest Wurm" }, { "resolve": true, "answers": [[1]] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Harvest Wurm"], "graveyard_has": ["Harvest Wurm"] }, {} ] } },
  { "name": "no basic land in graveyard means it is sacrificed",
    "players": [ { "hand": ["Harvest Wurm"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Harvest Wurm" }, { "resolve": true, "answers": [[0]] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Harvest Wurm"], "graveyard_has": ["Harvest Wurm"] }, {} ] } },
  { "name": "ruling: Wurm killed in response: the resolved ability still returns a basic land",
    "players": [ { "hand": ["Harvest Wurm"], "battlefield": ["Forest", "Forest"], "graveyard": ["Forest"] }, { "hand": ["Shock"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Harvest Wurm" },
      { "pass": true },
