[
  { "name": "enchanted artifact creature can't attack",
    "players": [ { "hand": ["Stasis Cocoon"], "battlefield": ["Plains", "Plains"] }, { "battlefield": [{ "name": "Burnished Hart", "sick": false }] } ],
    "steps": [ { "cast": "Stasis Cocoon", "targets": ["Burnished Hart"] }, { "resolve": true },
               { "pass": true }, { "advance_to": "Main1" } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Burnished Hart"] } ] } },
  { "name": "enchanted artifact's mana ability can't be activated",
    "players": [ { "hand": ["Stasis Cocoon"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Stasis Cocoon", "targets": ["Sol Ring"] }, { "resolve": true },
               { "tap_for_mana": "Sol Ring", "illegal": true } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Sol Ring": false } } },
  { "name": "can't enchant a creature (not an artifact)",
    "players": [ { "hand": ["Stasis Cocoon"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Stasis Cocoon", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Stasis Cocoon"] }, {} ] } },
  { "name": "enchanted artifact creature can't attack; the other attacker still deals damage",
    "players": [ { "hand": ["Stasis Cocoon"], "battlefield": ["Plains", "Plains", { "name": "Burnished Hart", "sick": false }, { "name": "Grizzly Bears", "sick": false }] }, {} ],
    "steps": [ { "cast": "Stasis Cocoon", "targets": ["Burnished Hart"] }, { "resolve": true },
               { "attack": [ { "card": "Burnished Hart", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
               { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "enchanted artifact creature can't block; the blocked attacker gets through",
    "players": [ { "hand": ["Stasis Cocoon"], "battlefield": ["Plains", "Plains", { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false }] },
                 { "battlefield": ["Burnished Hart", "Serra Angel"] } ],
    "steps": [ { "cast": "Stasis Cocoon", "targets": ["Burnished Hart"] }, { "resolve": true },
               { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Burnished Hart", "attacker": "Hill Giant" }, { "blocker": "Serra Angel", "attacker": "Grizzly Bears" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "enchanted Sol Ring can't tap for mana (Mind Stone stays uncastable)",
    "players": [ { "hand": ["Stasis Cocoon", "Mind Stone"], "battlefield": ["Plains", "Plains", "Sol Ring"] }, {} ],
    "steps": [ { "cast": "Stasis Cocoon", "targets": ["Sol Ring"] }, { "resolve": true },
               { "cast": "Mind Stone", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Mind Stone"] }, {} ] } },
  { "name": "ruling: an activated ability with a sacrifice cost (colon in its text) cannot be activated on the enchanted artifact",
    "players": [ { "hand": ["Stasis Cocoon"], "battlefield": ["Plains", "Plains"] }, { "battlefield": [{ "name": "Burnished Hart", "sick": false }, "Plains", "Plains", "Plains"] } ],
    "steps": [ { "cast": "Stasis Cocoon", "targets": ["Burnished Hart"] }, { "resolve": true },
               { "pass": true }, { "activate": "Burnished Hart", "ability": 0, "player": 1, "illegal": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Burnished Hart"] } ] } },
  { "name": "ruling contrast: without Cocoon the same Burnished Hart ability can be activated",
    "players": [ {}, { "battlefield": [{ "name": "Burnished Hart", "sick": false }, "Plains", "Plains", "Plains"] } ],
    "steps": [ { "pass": true }, { "activate": "Burnished Hart", "ability": 0, "player": 1 } ],
    "expect": { "players": [ {}, { "graveyard_has": ["Burnished Hart"] } ] } }
]
