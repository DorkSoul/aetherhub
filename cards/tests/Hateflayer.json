[
  { "name": "attacks, then untaps for its ability to deal damage equal to its power",
    "players": [ { "battlefield": ["Hateflayer", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Hateflayer", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "activate": "Hateflayer", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 10 } ],
      "tapped": { "Hateflayer": false }
    }
  },
  { "name": "ruling: an untapped Hateflayer cannot pay its {Q} untap cost",
    "players": [ { "battlefield": ["Hateflayer", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "activate": "Hateflayer", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ],
      "tapped": { "Hateflayer": false }
    }
  },
  { "name": "ruling: summoning sickness stops the {Q} ability even when Hateflayer is tapped",
    "players": [ { "battlefield": [ { "name": "Hateflayer", "tapped": true, "sick": true }, "Mountain", "Mountain", "Mountain" ] }, {} ],
    "steps": [
      { "activate": "Hateflayer", "ability": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ],
      "tapped": { "Hateflayer": true }
    }
  }
]
