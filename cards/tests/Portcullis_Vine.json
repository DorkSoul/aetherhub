[
 { "name": "sacrifices itself to draw a card",
   "players": [ { "battlefield": ["Forest", "Forest", "Portcullis Vine"] }, {} ],
   "steps": [ { "activate": "Portcullis Vine" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard": ["Portcullis Vine"] }, {} ] } },
 { "name": "a creature without defender cannot be sacrificed for the cost",
   "players": [ { "battlefield": ["Forest", "Forest", "Portcullis Vine", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Portcullis Vine" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Grizzly Bears"], "graveyard": ["Portcullis Vine"] }, {} ] } },
 { "name": "needs {2} to activate",
   "players": [ { "battlefield": ["Forest", "Portcullis Vine"] }, {} ],
   "steps": [ { "activate": "Portcullis Vine", "illegal": true } ],
   "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Portcullis Vine"] }, {} ] } },
 { "name": "ruling: Portcullis Vine can be sacrificed to pay the cost of its own ability",
   "players": [ { "battlefield": ["Forest", "Forest", "Portcullis Vine"] }, {} ],
   "steps": [ { "activate": "Portcullis Vine" }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1, "graveyard": ["Portcullis Vine"] }, { "life": 20 } ] } }
]
