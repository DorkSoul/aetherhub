[
  { "name": "is a 2/1 flyer and entering the battlefield does not trigger inspired",
    "players": [ { "hand": ["Siren of the Silent Song"], "battlefield": ["Island", "Swamp", "Forest"] }, { "hand": ["Island"] } ],
    "steps": [ { "cast": "Siren of the Silent Song" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Siren of the Silent Song"] }, { "hand": ["Island"], "library_count": 20 } ], "pt": { "Siren of the Silent Song": [2, 1] }, "keywords": { "Siren of the Silent Song": ["Flying"] } } },
  { "name": "cannot be cast without blue and black mana",
    "players": [ { "hand": ["Siren of the Silent Song"], "battlefield": ["Island", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Siren of the Silent Song", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Siren of the Silent Song"] }, {} ] } },
  { "name": "inspired: the Siren untapping in your untap step makes each opponent discard then mill",
    "players": [ { "battlefield": [ {"name": "Siren of the Silent Song", "tapped": true} ] }, {} ],
    "steps": [ {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"}, {"resolve": true} ],
    "expect": { "players": [ { "battlefield_has": ["Siren of the Silent Song"] }, { "hand_count": 0, "library_count": 18 } ] } },
  { "name": "an untapped Siren does not trigger inspired on your untap step",
    "players": [ { "battlefield": ["Siren of the Silent Song"] }, {} ],
    "steps": [ {"advance_to": "Upkeep"}, {"advance_to": "Upkeep"} ],
    "expect": { "players": [ { "battlefield_has": ["Siren of the Silent Song"] }, { "hand_count": 1, "library_count": 19 } ] } },
  { "name": "ruling: an untap from a spell (Burst of Energy) also makes inspired trigger, opponent discards then mills",
    "players": [ { "hand": ["Burst of Energy"], "battlefield": ["Plains", {"name": "Siren of the Silent Song", "tapped": true}] }, { "hand": ["Island"] } ],
    "steps": [ { "cast": "Burst of Energy", "targets": ["Siren of the Silent Song"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Burst of Energy"], "battlefield_has": ["Siren of the Silent Song"] }, { "hand_count": 0, "library_count": 19 } ], "tapped": { "Siren of the Silent Song": false } } }
]
