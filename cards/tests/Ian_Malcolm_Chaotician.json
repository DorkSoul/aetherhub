   {"advance_to": "Main1", "auto": true},
   {"player": 1, "cast": "Divination"},
   {"resolve": true},
   {"advance_to": "Main1", "auto": true},
   {"player": 2, "cast": "Divination"},
   {"resolve": true},
   {"advance_to": "Main1", "auto": true},
