[
  { "name": "untaps the creatures that attacked this turn",
    "players": [ { "hand": ["Waves of Aggression"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "advance_to": "Main2" },
              { "cast": "Waves of Aggression" },
              { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Waves of Aggression"] }, { "life": 18 } ], "tapped": { "Grizzly Bears": false } } },
  { "name": "creature that did not attack this turn stays tapped",
    "players": [ { "hand": ["Waves of Aggression"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "cast": "Waves of Aggression" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": true } } },
  { "name": "retrace: cast from the graveyard by discarding a land card",
    "players": [ { "graveyard": ["Waves of Aggression"], "hand": ["Mountain"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Waves of Aggression", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Waves of Aggression", "Mountain"] }, {} ] } },
  { "name": "retrace needs a land card to discard: illegal with none in hand",
    "players": [ { "graveyard": ["Waves of Aggression"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Waves of Aggression", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Waves of Aggression"] }, {} ] } },
  { "name": "ruling: retrace follows sorcery timing, so it is illegal in combat",
    "players": [ { "graveyard": ["Waves of Aggression"], "hand": ["Mountain"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Waves of Aggression", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Waves of Aggression"], "hand": ["Mountain"] }, {} ] } },
  { "name": "ruling: after a retrace spell resolves, its caster can cast it again right away",
    "players": [ { "graveyard": ["Waves of Aggression"], "hand": ["Mountain", "Mountain"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Waves of Aggression", "alt": 0, "answers": ["Mountain"] }, { "resolve": true }, { "cast": "Waves of Aggression", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Waves of Aggression", "Mountain"], "hand_count": 0 }, {} ] } }
]
