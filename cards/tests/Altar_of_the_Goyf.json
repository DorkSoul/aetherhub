[
  {
    "name": "lone attacker gets +X/+X, X = card types in all graveyards",
    "players": [
      { "battlefield": ["Altar of the Goyf", "Grizzly Bears"], "graveyard": ["Lightning Bolt"] },
      { "graveyard": ["Sol Ring"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [4, 4] } }
  },
  {
    "name": "two attackers: no trigger",
    "players": [
      { "battlefield": ["Altar of the Goyf", "Grizzly Bears", "Hill Giant"], "graveyard": ["Lightning Bolt"] },
      { "graveyard": ["Sol Ring"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] } }
  },
  {
    "name": "Lhurgoyf creatures you control have trample",
    "players": [ { "battlefield": ["Altar of the Goyf", "Tarmogoyf"] }, {} ],
    "steps": [],
    "expect": { "keywords": { "Tarmogoyf": ["Trample"] } }
  },
  {
    "name": "ruling: Legendary and Aura are not card types (Obosh creature + Mesmerizing Dose enchantment = 2)",
    "players": [
      { "battlefield": ["Altar of the Goyf", "Grizzly Bears"], "graveyard": ["Obosh, the Preypiercer", "Mesmerizing Dose"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [4, 4] } }
  },
  {
    "name": "ruling: kindred is a card type that counts (Altar in a graveyard adds kindred + artifact)",
    "players": [
      { "battlefield": ["Altar of the Goyf", "Grizzly Bears"] },
      { "graveyard": ["Altar of the Goyf"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Grizzly Bears": [4, 4] } }
  }
]
