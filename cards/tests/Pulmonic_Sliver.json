[
  {
    "name": "dying Sliver: may put it on top of its owner's library",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Pulmonic Sliver", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Pulmonic Sliver"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": ["Pulmonic Sliver"],
          "library_count": 21,
          "graveyard": ["Lightning Bolt"]
        },
        {}
      ]
    }
  },
  {
    "name": "declining: the dying Sliver goes to the graveyard",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Pulmonic Sliver", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Pulmonic Sliver"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": ["Pulmonic Sliver"],
          "library_count": 20,
          "graveyard": ["Lightning Bolt", "Pulmonic Sliver"]
        },
        {}
      ]
    }
  },
  {
    "name": "a non-Sliver creature dying is not affected",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Pulmonic Sliver", "Grizzly Bears", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": ["Grizzly Bears"],
          "battlefield_has": ["Pulmonic Sliver"],
          "graveyard": ["Grizzly Bears", "Lightning Bolt"]
        },
        {}
      ]
    }
  },
  {
    "name": "Sliver has flying: Grizzly Bears cannot block it, so it deals 3 (Elves block the ground Giant)",
    "players": [
      { "battlefield": ["Pulmonic Sliver", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "attack": [{ "card": "Pulmonic Sliver", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Pulmonic Sliver" }, { "blocker": "Llanowar Elves", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 17 }] }
  },
  {
    "name": "ruling: two Slivers die at once (Pulmonic and Brood Sliver): each may go on top of its owner's library",
    "players": [ { "battlefield": ["Pulmonic Sliver"] }, { "battlefield": ["Brood Sliver"] } ],
    "steps": [
      { "attack": [{ "card": "Pulmonic Sliver", "at": "p1" }] },
      { "block": [{ "blocker": "Brood Sliver", "attacker": "Pulmonic Sliver" }], "player": 1 },
      { "advance_to": "Main2", "answers": [true, true] }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Pulmonic Sliver"], "library_top": ["Pulmonic Sliver"] },
        { "battlefield_lacks": ["Brood Sliver"], "library_top": ["Brood Sliver"] }
      ]
    }
  }
]
