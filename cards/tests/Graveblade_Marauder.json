[
  {
    "name": "loses life equal to creature cards in your graveyard",
    "players": [
      {
        "battlefield": [
          "Graveblade Marauder"
        ],
        "graveyard": [
          "Grizzly Bears",
          "Hill Giant",
          "Lightning Bolt",
          "Sol Ring"
        ]
      },
      {
        "graveyard": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Graveblade Marauder",
            "at": "p1"
          }
        ]
      },
      {
        "block": [],
        "player": 1
      },
      {
        "advance_to": "Main2",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17
        }
      ]
    }
  },
  {
    "name": "empty graveyard: only combat damage",
    "players": [
      {
        "battlefield": [
          "Graveblade Marauder"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Graveblade Marauder",
            "at": "p1"
          }
        ]
      },
      {
        "block": [],
        "player": 1
      },
      {
        "advance_to": "Main2",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 19
        }
      ]
    }
  },
  {
    "name": "deathtouch kills a big blocker, no trigger",
    "players": [
      {
        "battlefield": [
          "Graveblade Marauder"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Serra Angel"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Graveblade Marauder",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Serra Angel",
            "attacker": "Graveblade Marauder"
          }
        ],
        "player": 1
      },
      {
        "advance_to": "Main2",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 20,
          "graveyard": [
            "Serra Angel"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a creature dying in the same combat damage step counts when the trigger resolves",
    "players": [
      {
        "battlefield": ["Graveblade Marauder", "Grizzly Bears"]
      },
      {
        "battlefield": ["Serra Angel"]
      }
    ],
    "steps": [
      {
        "attack": [
          { "card": "Graveblade Marauder", "at": "p1" },
          { "card": "Grizzly Bears", "at": "p1" }
        ]
      },
      {
        "block": [
          { "blocker": "Serra Angel", "attacker": "Grizzly Bears" }
        ],
        "player": 1
      },
      {
        "advance_to": "Main2",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"] },
        { "life": 18 }
      ]
    }
  }
]