[
 {
  "name": "chosen creature's next damage to me is halved rounded down: 2 becomes 1",
  "players": [
    { "battlefield": ["Grizzly Bears"] },
    { "battlefield": ["Dark Sphere"] }
  ],
  "steps": [
    { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
    { "pass": true },
    { "activate": "Dark Sphere", "player": 1, "ability": 0 },
    { "pass": true, "player": 0 },
    { "resolve": true },
    { "advance_to": "Main2" }
  ],
  "expect": {
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "life": 19, "graveyard": ["Dark Sphere"] } ]
  }
 },
 {
  "name": "without activating Dark Sphere the full 2 damage is dealt",
  "players": [
    { "battlefield": ["Grizzly Bears"] },
    { "battlefield": ["Dark Sphere"] }
  ],
  "steps": [
    { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
    { "advance_to": "Main2" }
  ],
  "expect": {
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "life": 18, "battlefield": ["Dark Sphere"] } ]
  }
 },
 {
  "name": "ruling: two Dark Spheres on the same source apply in sequence (5 -> 3 -> 2)",
  "players": [
    { "battlefield": ["Juggernaut"] },
    { "battlefield": ["Dark Sphere", "Dark Sphere"] }
  ],
  "steps": [
    { "attack": [ { "card": "Juggernaut", "at": "p1" } ] },
    { "pass": true },
    { "activate": "Dark Sphere", "player": 1, "ability": 0 },
    { "activate": "Dark Sphere", "player": 1, "ability": 0 },
    { "pass": true, "player": 0 },
    { "resolve": true },
    { "advance_to": "Main2" }
  ],
  "expect": {
    "players": [ { "battlefield": ["Juggernaut"] }, { "life": 18, "graveyard": ["Dark Sphere", "Dark Sphere"] } ]
  }
 }
]
