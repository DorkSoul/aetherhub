 {
  "name": "ruling: hand size is counted on resolution (casting Lightning Bolt in response lowers it below the power)",
  "players": [
   { "battlefield": ["Noetic Scales", "Hill Giant", "Mountain"], "hand": ["Lightning Bolt", "Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Upkeep", "hold": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "pass": true }, { "pass": true },
   { "resolve": true }
  ],
  "start": "Untap",
  "expect": {
   "players": [
    { "battlefield": ["Noetic Scales", "Mountain"], "hand": ["Plains", "Plains", "Hill Giant"] },
    { "battlefield": [] }
   ]
  }
 },
 {
  "name": "ruling: without a response the Giant stays (power 3 is not greater than hand size 3)",
  "players": [
   { "battlefield": ["Noetic Scales", "Hill Giant"], "hand": ["Lightning Bolt", "Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
