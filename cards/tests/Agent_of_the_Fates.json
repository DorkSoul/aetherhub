[
 {
  "name": "heroic: the targeted spell makes each opponent sacrifice a creature",
  "players": [
   {
    "hand": [
     "Giant Growth"
    ],
    "battlefield": [
     "Forest",
     "Agent of the Fates"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Giant Growth",
    "targets": [
     "Agent of the Fates"
    ]
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Agent of the Fates"
     ]
    },
    {
     "graveyard": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "a spell that does not target it does not trigger heroic",
  "players": [
   {
    "hand": [
     "Giant Growth"
    ],
    "battlefield": [
     "Forest",
     "Agent of the Fates"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Giant Growth",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "battlefield_has": [
      "Grizzly Bears"
     ]
    }
   ]
  }
 },
 {
  "name": "ruling: the heroic trigger resolves before the spell (Giant Growth is still on the stack)",
  "players": [
   { "hand": ["Giant Growth"], "battlefield": ["Forest", "Agent of the Fates"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": ["Agent of the Fates"] },
   { "pass": true },
   { "pass": true, "player": 1 }
  ],
  "expect": { "stack_empty": false, "players": [ {}, { "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "ruling: a copy of a spell that targets it does not trigger heroic again",
  "players": [
   { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Forest", "Island", "Island", "Agent of the Fates"] },
   { "battlefield": ["Grizzly Bears", "Hill Giant"] }
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": ["Agent of the Fates"] },
   { "cast": "Twincast", "targets": [{ "stack": "Giant Growth" }] },
   { "resolve": true, "answers": ["Agent of the Fates", [0]] }
  ],
  "expect": { "players": [ { "battlefield_has": ["Agent of the Fates"] }, { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant"] } ] }
 }
]
