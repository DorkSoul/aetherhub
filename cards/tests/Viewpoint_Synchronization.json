[
  {
    "name": "freerunning after an Assassin dealt combat damage: two basics tapped onto battlefield, one to hand",
    "players": [
      { "hand": ["Viewpoint Synchronization"],
        "battlefield": ["Abyssal Hunter", "Forest", "Forest", "Forest"],
        "library": ["Mountain", "Island", "Plains"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Abyssal Hunter", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "cast": "Viewpoint Synchronization", "alt": 0 },
      { "resolve": true, "answers": [ ["Mountain", "Island"], "Plains" ] }
    ],
    "expect": {
      "tapped": { "Mountain": true, "Island": true },
      "players": [
        { "battlefield_has": ["Mountain", "Island", "Abyssal Hunter"], "hand": ["Plains"] },
        {}
      ]
    }
  },
  {
    "name": "freerunning is not allowed when no Assassin or commander dealt combat damage this turn",
    "players": [
      { "hand": ["Viewpoint Synchronization"],
        "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Viewpoint Synchronization", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Viewpoint Synchronization"] }, {} ]
    }
  },
  {
    "name": "non-Assassin combat damage does not enable freerunning",
    "players": [
      { "hand": ["Viewpoint Synchronization"],
        "battlefield": ["Grizzly Bears", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "cast": "Viewpoint Synchronization", "alt": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Viewpoint Synchronization"] }, {} ]
    }
  },
  {
    "name": "ruling: with only two basics found, both go onto the battlefield tapped and none go to hand",
    "players": [
      { "hand": ["Viewpoint Synchronization"],
        "battlefield": ["Abyssal Hunter", "Forest", "Forest", "Forest"],
        "library": ["Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Abyssal Hunter", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "cast": "Viewpoint Synchronization", "alt": 0 },
      { "resolve": true, "answers": [ ["Mountain", "Island"] ] }
    ],
    "expect": {
      "tapped": { "Mountain": true, "Island": true },
      "players": [
        { "battlefield_has": ["Mountain", "Island", "Abyssal Hunter"], "hand": [] },
        {}
      ]
    }
  },
  {
    "name": "ruling: an Assassin that dealt combat damage can be killed afterwards and freerunning still applies this turn",
    "players": [
      { "hand": ["Viewpoint Synchronization", "Lightning Bolt"],
        "battlefield": ["Abyssal Hunter", "Forest", "Forest", "Forest", "Mountain"],
        "library": ["Mountain", "Island", "Plains"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Abyssal Hunter", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["Abyssal Hunter"] },
      { "resolve": true },
      { "cast": "Viewpoint Synchronization", "alt": 0 },
      { "resolve": true, "answers": [ ["Mountain", "Island"], "Plains" ] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Abyssal Hunter", "Lightning Bolt", "Viewpoint Synchronization"], "hand": ["Plains"] },
        { "life": 19 }
      ]
    }
  }
]
