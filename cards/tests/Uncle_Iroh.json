[
 { "name": "attacking adds R (power 4 is not used: Firebending 1) that lasts until end of combat",
   "players": [ { "battlefield": ["Uncle Iroh"] }, {} ],
   "steps": [ { "attack": [ { "card": "Uncle Iroh", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 1 } }, { "life": 16 } ] } },
 { "name": "Lesson spells cost {1} less",
   "players": [ { "hand": ["Basic Conjuration"], "battlefield": ["Uncle Iroh", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Basic Conjuration" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Basic Conjuration"] }, {} ] } },
 { "name": "boundary: without Uncle Iroh the Lesson costs full price",
   "players": [ { "hand": ["Basic Conjuration"], "battlefield": ["Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Basic Conjuration", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Basic Conjuration"] }, {} ] } },
 { "name": "ruling: firebending mana can pay for a spell in the end of combat step, after combat damage",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Uncle Iroh"] }, {} ],
   "steps": [ { "attack": [ { "card": "Uncle Iroh", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 13 } ] } },
 { "name": "ruling: firebending mana is lost when the second main phase begins",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Uncle Iroh"] }, {} ],
   "steps": [ { "attack": [ { "card": "Uncle Iroh", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "advance_to": "Main2" }, { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "life": 16 } ] } },
 { "name": "ruling: firebending is a triggered ability on the stack when the creature attacks",
   "players": [ { "battlefield": ["Uncle Iroh"] }, {} ],
   "steps": [ { "attack": [ { "card": "Uncle Iroh", "at": "p1" } ] } ],
   "expect": { "stack_empty": false, "players": [ {}, { "life": 20 } ] } },
 { "name": "ruling: mana from another source is lost when combat moves to the next step",
   "players": [ { "battlefield": ["Uncle Iroh", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "BeginCombat" }, { "tap_for_mana": "Mountain" }, { "advance_to": "EndCombat" } ],
   "expect": { "players": [ { "pool": { "R": 0 } }, {} ] } }
]
