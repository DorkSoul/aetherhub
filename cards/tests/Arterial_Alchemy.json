[
  {
    "name": "entering creates a Blood token for the opponent",
    "players": [
      {
        "hand": ["Arterial Alchemy"],
        "battlefield": ["Mountain", "Plains", "Plains"]
      },
      {}
    ],
    "steps": [
      { "cast": "Arterial Alchemy" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Arterial Alchemy", "Blood"] },
        {}
      ]
    }
  },
  {
    "name": "a Blood token you control is Equipment: equip {2} gives +2/+0",
    "players": [
      {
        "hand": ["Arterial Alchemy"],
        "battlefield": ["Mountain", "Plains", "Plains", "Forest", "Forest", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Arterial Alchemy" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Blood", "ability": 32769, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Arterial Alchemy", "Blood"] },
        {}
      ],
      "pt": { "Grizzly Bears": [4, 2] },
      "attached": { "Blood": "Grizzly Bears" }
    }
  },
  {
    "name": "equip {2} needs two more mana: illegal with only three lands",
    "players": [
      {
        "hand": ["Arterial Alchemy"],
        "battlefield": ["Mountain", "Plains", "Plains", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Arterial Alchemy" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Blood", "ability": 32769, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Arterial Alchemy", "Blood"] },
        {}
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: two Arterial Alchemies give an equipped Blood +4/+0, equip still costs {2}",
    "players": [
      {
        "hand": ["Arterial Alchemy", "Arterial Alchemy"],
        "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Plains", "Plains", "Forest", "Forest", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Arterial Alchemy" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Arterial Alchemy" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Blood", "ability": 32769, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Arterial Alchemy", "Arterial Alchemy", "Blood", "Blood"] }, {} ],
      "pt": { "Grizzly Bears": [6, 2] }
