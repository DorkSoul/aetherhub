  {
    "name": "ruling: when the Alchemy leaves, the Blood stops being Equipment and the creature loses the bonus",
    "players": [
      {
        "hand": ["Arterial Alchemy", "Disenchant"],
        "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Plains", "Forest", "Forest", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Arterial Alchemy" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Blood", "ability": 32769, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Disenchant", "targets": ["Arterial Alchemy"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Blood"], "battlefield_lacks": ["Arterial Alchemy"] }, {} ],
