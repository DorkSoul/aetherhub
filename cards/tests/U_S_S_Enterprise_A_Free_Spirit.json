  },
  {
    "name": "at 6 charge counters it flies and has lifelink, so it hits for 5 and gains 5",
    "players": [
      { "battlefield": [{ "name": "U.S.S. Enterprise-A, Free Spirit", "sick": false, "counters": { "charge": 6 } }] },
      { "battlefield": ["Grizzly Bears"] }
