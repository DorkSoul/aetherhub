  },
  {
    "name": "at 5 charge counters it is not a creature and cannot attack",
    "players": [
      { "battlefield": [{ "name": "U.S.S. Enterprise-A, Free Spirit", "sick": false, "counters": { "charge": 5 } }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "U.S.S. Enterprise-A, Free Spirit", "at": "p1" }], "illegal": true }
