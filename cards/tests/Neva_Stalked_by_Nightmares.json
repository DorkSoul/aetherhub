[
  { "name": "ETB returns a creature card from your graveyard to hand",
    "players": [ { "hand": ["Neva, Stalked by Nightmares"], "graveyard": ["Grizzly Bears"], "battlefield": ["Plains", "Swamp", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Neva, Stalked by Nightmares" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Neva, Stalked by Nightmares"] }, {} ] } },
  { "name": "enchantment you control going to the graveyard: +1/+1 counter",
    "players": [ { "hand": ["Disenchant"], "battlefield": ["Neva, Stalked by Nightmares", "Journey to Nowhere", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Disenchant", "targets": ["Journey to Nowhere"] }, { "resolve": true, "auto": true } ],
    "expect": { "pt": { "Neva, Stalked by Nightmares": [3, 3] }, "counters": { "Neva, Stalked by Nightmares": { "p1p1": 1 } } } },
  { "name": "ruling: Neva leaves with its Aura at the same time, so the Aura does not trigger Neva",
    "players": [ { "hand": ["Pacifism", "Lightning Bolt"], "battlefield": ["Neva, Stalked by Nightmares", "Plains", "Plains", "Mountain"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Pacifism" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Neva, Stalked by Nightmares"] }, { "resolve": true, "auto": true } ],
    "expect": { "stack_empty": true, "players": [ { "graveyard_has": ["Neva, Stalked by Nightmares", "Pacifism"] }, {} ] } },
  { "name": "ruling: an Aura put into the graveyard while Neva stays on the battlefield triggers Neva",
    "players": [ { "hand": ["Pacifism", "Naturalize"], "battlefield": ["Neva, Stalked by Nightmares", "Plains", "Plains", "Forest", "Forest"], "library": ["Island", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Naturalize", "targets": ["Pacifism"] }, { "resolve": true, "auto": true } ],
    "expect": { "stack_empty": true, "pt": { "Neva, Stalked by Nightmares": [3, 3] }, "counters": { "Neva, Stalked by Nightmares": { "p1p1": 1 } } } }
]
