[
 { "name": "this turn: creatures can't attack and spells can't target players or permanents",
   "players": [ { "hand": ["Peace Talks", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Mountain", { "name": "Grizzly Bears", "sick": false }] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Peace Talks" },
              { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true },
              { "cast": "Lightning Bolt", "targets": ["Hill Giant"], "illegal": true },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Lightning Bolt"] }, { "life": 20 } ] } },
 { "name": "activated abilities can't target either",
   "players": [ { "hand": ["Peace Talks"], "battlefield": ["Plains", "Plains", { "name": "Prodigal Sorcerer", "sick": false }] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Peace Talks" },
              { "resolve": true },
              { "activate": "Prodigal Sorcerer", "targets": ["Hill Giant"], "illegal": true },
              { "activate": "Prodigal Sorcerer", "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "next turn: the opponent's creatures still can't attack",
   "players": [ { "hand": ["Peace Talks"], "battlefield": ["Plains", "Plains"] }, { "battlefield": [ { "name": "Hill Giant", "sick": false } ] } ],
   "steps": [ { "cast": "Peace Talks" },
              { "resolve": true },
              { "advance_to": "Main1" },
              { "attack": [ { "card": "Hill Giant", "at": "p0" } ], "player": 1, "illegal": true } ],
   "expect": { "turn": 2, "players": [ { "life": 20 }, {} ] } },
 { "name": "the turn after next: attacking and targeting work again",
   "players": [ { "hand": ["Peace Talks"], "battlefield": ["Plains", "Plains", { "name": "Grizzly Bears", "sick": false }] }, { "hand": [], "battlefield": [] } ],
   "steps": [ { "cast": "Peace Talks" },
              { "resolve": true },
              { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep" },
              { "advance_to": "Main1" },
              { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "turn": 3, "players": [ {}, { "life": 18 } ] } },
 { "name": "triggered abilities can still target while it applies",
   "players": [ { "hand": ["Peace Talks", "Fire Imp"], "battlefield": ["Plains", "Plains", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Peace Talks" },
              { "resolve": true },
              { "cast": "Fire Imp" },
              { "resolve": true, "targets": ["Grizzly Bears"] } ],
   "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "ruling: can be cast in the second main phase after your attack",
   "players": [ { "hand": ["Peace Talks"], "battlefield": ["Plains", "Plains", { "name": "Grizzly Bears", "sick": false }] }, {} ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "advance_to": "Main2" },
              { "cast": "Peace Talks" },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Peace Talks"] }, { "life": 18 } ] } }
]
