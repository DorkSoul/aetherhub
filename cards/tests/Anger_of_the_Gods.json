[
 {
  "name": "deals 3 to each creature and exiles those that would die",
  "players": [
   { "hand": ["Anger of the Gods"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant", "Serra Angel"] },
   { "battlefield": ["Savannah Lions"] }
  ],
  "steps": [
   { "cast": "Anger of the Gods" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
     { "graveyard": ["Anger of the Gods"], "exile": ["Grizzly Bears", "Hill Giant"], "battlefield_has": ["Serra Angel"] },
     { "exile": ["Savannah Lions"] }
   ]
  }
 },
 {
  "name": "does not damage planeswalkers",
  "players": [
   { "hand": ["Anger of the Gods"], "battlefield": ["Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
   { "battlefield": ["Test Walker"] }
  ],
  "steps": [
   { "cast": "Anger of the Gods" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
     { "graveyard": ["Anger of the Gods"], "exile": ["Grizzly Bears"] },
     { "battlefield_has": ["Test Walker"] }
   ]
  }
 },
 {
  "name": "ruling: a creature damaged by Anger and killed later that turn is exiled",
  "players": [
   { "hand": ["Anger of the Gods", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "cast": "Anger of the Gods" },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Serra Angel"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Anger of the Gods", "Lightning Bolt"] }, { "exile": ["Serra Angel"] } ]
  }
 }
]
