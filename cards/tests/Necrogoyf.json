[
  {
    "name": "power counts creature cards in all graveyards",
    "players": [
      {
        "battlefield": [
          "Necrogoyf"
        ],
        "graveyard": [
          "Grizzly Bears"
        ]
      },
      {
        "graveyard": [
          "Grizzly Bears",
          "Lightning Bolt"
        ]
      }
    ],
    "steps": [],
    "expect": {
      "players": [
        {},
        {}
      ],
      "pt": {
        "Necrogoyf": [
          2,
          4
        ]
      }
    }
  },
  {
    "name": "opponent's upkeep: the active player discards a card (p0 untouched until its own upkeep)",
    "players": [
      {
        "hand": [
          "Island"
        ],
        "battlefield": [
          "Necrogoyf"
        ]
      },
      {
        "hand": [
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep",
        "answers": [
          "Island"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {
          "hand_count": 1
        }
      ]
    }
  },
  {
    "name": "each player's own upkeep: p0 discards at its next upkeep (after p1's turn, which also draws for p1)",
    "players": [
      {
        "hand": [
          "Island"
        ],
        "battlefield": [
          "Necrogoyf"
        ]
      },
      {
        "hand": [
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep",
        "answers": [
          "Island"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0
        },
        {
          "hand_count": 2
        }
      ]
    }
  },
  {
    "name": "madness: the discarded Necrogoyf is cast for {1}{B}{B} from exile on its owner's upkeep",
    "players": [
      { "hand": ["Necrogoyf"], "battlefield": ["Swamp", "Swamp", "Island"] },
      { "battlefield": ["Necrogoyf"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep", "answers": [true] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Necrogoyf"], "graveyard": [], "exile": [] },
        {}
      ]
    }
  },
  {
    "name": "madness declined: the discarded Necrogoyf goes to the graveyard",
    "players": [
      { "hand": ["Necrogoyf"], "battlefield": ["Swamp", "Swamp", "Island"] },
      { "battlefield": ["Necrogoyf"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Necrogoyf"], "exile": [], "battlefield_lacks": ["Necrogoyf"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a madness card discarded at upkeep still counts as discarded (Megrim deals 2 to its owner)",
    "players": [
      { "hand": ["Necrogoyf"], "battlefield": ["Swamp", "Swamp", "Island"] },
      { "battlefield": ["Necrogoyf", "Megrim"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Necrogoyf"], "exile": [], "life": 18 },
        {}
      ]
    }
  }
]