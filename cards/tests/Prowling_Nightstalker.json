[
  {
    "name": "unblocked when no black creature can block",
    "players": [{ "battlefield": ["Prowling Nightstalker"] }, {}],
    "steps": [{ "attack": [{ "card": "Prowling Nightstalker", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" }],
    "expect": { "players": [{}, { "life": 18 }] }
  },
  {
    "name": "a black creature can block it",
    "players": [{ "battlefield": ["Prowling Nightstalker"] }, { "battlefield": ["Drudge Skeletons"] }],
    "steps": [
      { "attack": [{ "card": "Prowling Nightstalker", "at": "p1" }] },
      { "block": [{ "blocker": "Drudge Skeletons", "attacker": "Prowling Nightstalker" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 20 }], "pt": { "Prowling Nightstalker": [2, 2] } }
  },
  {
    "name": "a non-black creature's block is rejected: Nightstalker is unblocked while the other attacker is blocked",
    "players": [{ "battlefield": ["Prowling Nightstalker", "Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }],
    "steps": [
      { "attack": [{ "card": "Prowling Nightstalker", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Prowling Nightstalker" }, { "blocker": "Llanowar Elves", "attacker": "Hill Giant" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 18 }] }
  }
]
