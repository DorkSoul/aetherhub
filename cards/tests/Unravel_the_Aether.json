[
  { "name": "ruling: if the target is gone on resolution, Unravel does nothing (Bolt kills the Ornithopter in response)",
    "players": [ { "hand": ["Unravel the Aether"], "battlefield": ["Forest", "Forest", "Ornithopter"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Unravel the Aether", "targets": ["Ornithopter"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Ornithopter"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Unravel the Aether", "Ornithopter"], "battlefield_lacks": ["Ornithopter"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "target artifact is shuffled into its owner's library",
    "players": [ { "hand": ["Unravel the Aether"], "battlefield": ["Forest", "Forest", "Ornithopter"] }, {} ],
    "steps": [ { "cast": "Unravel the Aether", "targets": ["Ornithopter"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Ornithopter"] }, {} ] } },
  { "name": "no artifact or enchantment to target: cannot cast",
    "players": [ { "hand": ["Unravel the Aether"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Unravel the Aether", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Unravel the Aether"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
