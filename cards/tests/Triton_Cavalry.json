[
  {
    "name": "heroic: a spell targeting it returns target enchantment to hand",
    "players": [
      {
        "hand": [
          "Giant Growth"
        ],
        "battlefield": [
          "Forest",
          "Triton Cavalry",
          "Absolute Law"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Giant Growth",
        "targets": [
          "Triton Cavalry"
        ]
      },
      {
        "resolve": true,
        "answers": [
          true
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Absolute Law"
          ],
          "battlefield": [
            "Forest",
            "Triton Cavalry"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: heroic trigger resolves before the spell that caused it",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Triton Cavalry", "Absolute Law"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Triton Cavalry"] },
      { "pass": true },
      { "pass": true, "answers": [true] }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ { "hand": ["Absolute Law"], "battlefield_has": ["Triton Cavalry"] }, {} ]
    }
  },
  {
    "name": "ruling: a copy of a spell that targets it does not trigger heroic",
    "players": [
      { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Forest", "Island", "Island", "Triton Cavalry", "Absolute Law"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Triton Cavalry"] },
      { "cast": "Twincast" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ { "battlefield_has": ["Triton Cavalry", "Absolute Law"] }, {} ]
    }
  }
]