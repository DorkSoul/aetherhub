[
 {
  "name": "restricted CC pays for a colorless Eldrazi spell",
  "players": [ { "hand": ["Eldrazi Devastator"], "battlefield": ["Eldrazi Temple", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Eldrazi Devastator" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Eldrazi Devastator"] }, {} ] }
 },
 {
  "name": "restricted CC cannot pay for a colorless non-Eldrazi spell",
  "players": [ { "hand": ["Ugin, the Spirit Dragon"], "battlefield": ["Eldrazi Temple", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Ugin, the Spirit Dragon", "illegal": true } ],
  "expect": { "players": [ { "hand": ["Ugin, the Spirit Dragon"] }, {} ] }
 },
 {
  "name": "the plain {C} ability still pays for a non-Eldrazi spell",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Eldrazi Temple", "Forest"] }, {} ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
 },
 {
  "name": "ruling: restricted CC from Eldrazi Temple cannot pay for an Eldrazi's ability while it is in hand",
  "players": [ { "hand": ["Eldrazi Ravager"], "battlefield": ["Eldrazi Temple"] }, {} ],
  "steps": [ { "activate": "Eldrazi Ravager", "ability": 1, "illegal": true } ],
  "expect": { "players": [ { "hand": ["Eldrazi Ravager"] }, {} ] }
 }
]
