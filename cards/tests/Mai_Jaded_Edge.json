[
  {
    "name": "exhaust for three puts a double strike counter, so Mai has double strike",
    "players": [
      {
        "battlefield": ["Mai, Jaded Edge", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Mai, Jaded Edge",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Mai, Jaded Edge": { "DoubleStrike": 1 }
      },
      "keywords": {
        "Mai, Jaded Edge": ["DoubleStrike", "Prowess"]
      }
    }
  },
  {
    "name": "prowess gives +1/+1 for a noncreature spell",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mai, Jaded Edge", "Mountain"]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": ["p1"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Mai, Jaded Edge": [2, 4]
      },
      "players": [
        {},
        { "life": 17 }
      ]
    }
  },
  {
    "name": "a creature spell does not trigger prowess",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Mai, Jaded Edge", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Mai, Jaded Edge": [1, 3]
      }
    }
  },
  {
    "name": "exhaust can be activated only once",
    "players": [
      {
        "battlefield": ["Mai, Jaded Edge", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Mai, Jaded Edge",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "activate": "Mai, Jaded Edge",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "counters": {
        "Mai, Jaded Edge": { "DoubleStrike": 1 }
      }
    }
  },
  {
    "name": "ruling: exhaust can be activated at instant speed, here in the end step",
    "players": [
      {
        "battlefield": ["Mai, Jaded Edge", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "End" },
      { "activate": "Mai, Jaded Edge", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": {
        "Mai, Jaded Edge": { "DoubleStrike": 1 }
      }
    }
  },
  {
    "name": "ruling: Mai returned to hand and recast is a new object that can exhaust again",
    "players": [
      {
        "hand": ["Escape Detection"],
        "battlefield": ["Mai, Jaded Edge", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "activate": "Mai, Jaded Edge", "ability": 0 },
      { "resolve": true },
      { "cast": "Escape Detection" },
      { "resolve": true },
      { "cast": "Mai, Jaded Edge" },
      { "resolve": true },
      { "activate": "Mai, Jaded Edge", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": {
        "Mai, Jaded Edge": { "DoubleStrike": 1 }
      }
    }
  }
