[
  {
    "name": "colorless spell cast pumps it +1/+0",
    "players": [ { "hand": ["Ornithopter"], "battlefield": ["Kozilek's Sentinel"] }, {} ],
    "steps": [ { "cast": "Ornithopter" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Kozilek's Sentinel": [2, 4] } }
  },
  {
    "name": "a red spell does not pump it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Kozilek's Sentinel", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ], "pt": { "Kozilek's Sentinel": [1, 4] } }
  },
  {
    "name": "ruling: devoid makes it colorless, not red from its {1}{R} cost",
    "players": [ { "hand": ["Kozilek's Sentinel"], "battlefield": ["Mountain", "Forest"] }, {} ],
    "steps": [ { "cast": "Kozilek's Sentinel" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Kozilek's Sentinel"] }, {} ], "colors": { "Kozilek's Sentinel": [] } }
  },
  {
    "name": "ruling: a color from another effect replaces colorless: it is blue, not blue plus colorless",
    "players": [ { "hand": ["Painter's Servant"], "battlefield": ["Forest", "Forest", "Kozilek's Sentinel"] }, {} ],
    "steps": [ { "cast": "Painter's Servant" }, { "resolve": true, "answers": ["U"] } ],
    "expect": { "colors": { "Kozilek's Sentinel": ["U"] } }
  },
  {
    "name": "ruling: devoid also applies on the stack, so a red-only counter does not hit the colorless spell",
    "players": [ { "hand": ["Kozilek's Sentinel"], "battlefield": ["Mountain", "Forest"] }, { "hand": ["Hydroblast"], "battlefield": ["Island"] } ],
    "steps": [ { "cast": "Kozilek's Sentinel" }, { "pass": true }, { "player": 1, "cast": "Hydroblast", "targets": [{ "stack": "Kozilek's Sentinel" }], "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Kozilek's Sentinel"] }, { "graveyard_has": ["Hydroblast"] } ] }
  }
]
