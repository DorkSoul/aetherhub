[
  {
    "name": "opponent loses life equal to Elves you control, counting itself",
    "players": [
      { "hand": ["Shaman of the Pack"], "battlefield": ["Swamp", "Forest", "Forest", "Elves of Deep Shadow"] },
      {}
    ],
    "steps": [
      { "cast": "Shaman of the Pack" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Shaman of the Pack", "Elves of Deep Shadow"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "with no other Elves it causes one life loss",
    "players": [
      { "hand": ["Shaman of the Pack"], "battlefield": ["Swamp", "Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Shaman of the Pack" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Shaman of the Pack"] }, { "life": 19 } ]
    }
  },
  {
    "name": "ruling: Elves are counted as the trigger resolves; Shaman killed in response is not counted",
    "players": [
      { "hand": ["Shaman of the Pack"], "battlefield": ["Swamp", "Forest", "Forest", "Elves of Deep Shadow"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Shaman of the Pack" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Shaman of the Pack"], "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Elves of Deep Shadow"], "battlefield_lacks": ["Shaman of the Pack"], "graveyard": ["Shaman of the Pack"] },
        { "life": 19, "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
