  {
    "name": "ruling: a commander put into hand by Command Beacon is cast from hand without commander tax",
    "commander": true,
    "players": [
      { "command": ["Savannah Lions"], "battlefield": ["Command Beacon", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Command Beacon", "ability": 0 },
      { "resolve": true },
      { "cast": "Savannah Lions" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Savannah Lions"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: with two partner commanders Command Beacon puts only the one chosen into hand",
    "commander": true,
    "players": [
      { "command": ["Savannah Lions", "Grizzly Bears"], "battlefield": ["Command Beacon"] },
      {}
    ],
    "steps": [
      { "activate": "Command Beacon", "ability": 0 },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"], "hand_count": 1, "graveyard": ["Command Beacon"] },
        {}
      ]
    }
  }
