[
  { "name": "mode 1 adds {R} for each card in the opponent's hand",
    "players": [ { "hand": ["Jeska's Will"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "hand": ["Grizzly Bears", "Forest", "Island"] } ],
    "steps": [ { "cast": "Jeska's Will", "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "pool": { "R": 3 }, "graveyard": ["Jeska's Will"] }, {} ] } },
  { "name": "mode 1 with an empty opponent hand adds no mana",
    "players": [ { "hand": ["Jeska's Will"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { } ],
    "steps": [ { "cast": "Jeska's Will", "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "pool": {}, "graveyard": ["Jeska's Will"] }, {} ] } },
  { "name": "mode 2 exiles the top three and you may play one this turn",
    "players": [ { "hand": ["Jeska's Will"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest", "Shock"] }, {} ],
    "steps": [ { "cast": "Jeska's Will", "answers": [1] }, { "resolve": true }, { "play_land": "Island" } ],
    "expect": { "players": [ { "battlefield_has": ["Island"], "library_count": 1 }, {} ] } },
  { "name": "with your commander both modes may be chosen",
    "players": [ { "command": ["Savannah Lions"], "hand": ["Jeska's Will"], "battlefield": ["Plains", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] }, { "hand": ["Grizzly Bears", "Forest"] } ],
    "steps": [ { "cast": "Savannah Lions" }, { "resolve": true }, { "cast": "Jeska's Will", "answers": [[0, 1]] }, { "resolve": true } ],
    "expect": { "players": [ { "pool": { "R": 2 }, "library_count": 0 }, {} ] },
    "commander": true },
  { "name": "ruling: an exiled land can't be played once you have used your land play",
    "players": [ { "hand": ["Jeska's Will", "Forest"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Island", "Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "cast": "Jeska's Will", "answers": [1] }, { "resolve": true }, { "play_land": "Island", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Island", "Grizzly Bears", "Forest"] }, {} ] } },
  { "name": "ruling: exiled cards you don't play remain exiled after the turn ends",
    "players": [ { "hand": ["Jeska's Will"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Island", "Forest"] }, {} ],
    "steps": [ { "cast": "Jeska's Will", "answers": [1] }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears", "Island", "Forest"] }, {} ] } }
]
