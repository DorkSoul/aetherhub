[
  {
    "name": "alone it counts itself: power 1",
    "players": [
      { "battlefield": ["Collective Drone"] },
      {}
    ],
    "steps": [{ "pass": true }],
    "expect": {
      "pt": { "Collective Drone": [1, 2] }
    }
  },
  {
    "name": "power counts the artifact creatures you control",
    "players": [
      { "battlefield": ["Collective Drone", "Ornithopter"] },
      {}
    ],
    "steps": [{ "pass": true }],
    "expect": {
      "pt": { "Collective Drone": [2, 2] }
    }
  },
  {
    "name": "opponent's artifact creatures do not count",
    "players": [
      { "battlefield": ["Collective Drone"] },
      { "battlefield": ["Ornithopter"] }
    ],
    "steps": [{ "pass": true }],
    "expect": {
      "pt": { "Collective Drone": [1, 2] }
    }
  }
]
