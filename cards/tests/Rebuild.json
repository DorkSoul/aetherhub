[
  { "name": "returns all artifacts to their owners' hands and keeps the creatures",
    "players": [ { "hand": ["Rebuild"], "battlefield": ["Island", "Island", "Island", "Sol Ring", "Grizzly Bears"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "cast": "Rebuild" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Sol Ring"], "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Sol Ring"], "graveyard": ["Rebuild"] }, { "hand": ["Sol Ring"], "battlefield_lacks": ["Sol Ring"] } ] } },
  { "name": "cycling draws a card",
    "players": [ { "hand": ["Rebuild"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Rebuild" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Rebuild"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: artifact cards in graveyards are not returned to hand",
    "players": [ { "hand": ["Rebuild"], "battlefield": ["Island", "Island", "Island", "Sol Ring"], "graveyard": ["Arcane Signet"] }, { "graveyard": ["Bloodforged Battle-Axe"] } ],
    "steps": [ { "cast": "Rebuild" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Sol Ring"], "battlefield_lacks": ["Sol Ring"], "graveyard_has": ["Rebuild", "Arcane Signet"] }, { "graveyard_has": ["Bloodforged Battle-Axe"] } ] } }
]
