[
  {
    "name": "destroys target enchantment",
    "players": [ { "hand": ["Clear"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Ardent Plea"] } ],
    "steps": [ { "cast": "Clear", "targets": ["Ardent Plea"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Clear"] }, { "battlefield_lacks": ["Ardent Plea"] } ] }
  },
  {
    "name": "cycling {2} draws a card",
    "players": [ { "hand": ["Clear"], "battlefield": ["Island", "Island"], "library": ["Island"] }, {} ],
    "steps": [ { "activate": "Clear", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Clear"], "hand": ["Island"] }, {} ] }
  },
  {
    "name": "ruling: cycling is an activated ability, not a spell, so an opponent's cast trigger does not see it",
    "players": [ { "hand": ["Clear"], "battlefield": ["Island", "Island"], "library": ["Island"] }, { "battlefield": ["Lunar Force"] } ],
    "steps": [ { "activate": "Clear", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Clear"], "hand": ["Island"] }, { "battlefield_has": ["Lunar Force"] } ] }
  }
]
