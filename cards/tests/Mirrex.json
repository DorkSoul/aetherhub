[
  {
    "name": "any-color mana only the turn Mirrex entered: not on an old land",
    "players": [ { "battlefield": ["Mirrex"] }, {} ],
    "steps": [ { "tap_for_mana": "Mirrex", "color": "U", "illegal": true } ],
    "expect": { "tapped": { "Mirrex": false } }
  },
  {
    "name": "any-color mana is legal the turn it enters",
    "players": [ { "hand": ["Mirrex"] }, {} ],
    "steps": [ { "play_land": "Mirrex" }, { "tap_for_mana": "Mirrex", "color": "U" } ],
    "expect": { "tapped": { "Mirrex": true } }
  },
  {
    "name": "3 and tap: create a Phyrexian Mite toxic token",
    "players": [ { "battlefield": ["Mirrex", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Mirrex", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Phyrexian Mite 1-1 Toxic"] }, {} ] }
  },
  {
    "name": "ruling: ten poison counters loses the game as a state-based action",
    "players": [ { "battlefield": ["Phyrexian Mite 1-1 Toxic"] }, { "poison": 9 } ],
    "steps": [ { "attack": [ { "card": "Phyrexian Mite 1-1 Toxic", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "winner": 0, "players": [ {}, { "poison": 10 } ] }
  },
  {
    "name": "ruling: toxic combat damage to a player deals its power and gives one poison counter",
    "players": [ { "battlefield": ["Phyrexian Mite 1-1 Toxic"] }, {} ],
    "steps": [ { "attack": [ { "card": "Phyrexian Mite 1-1 Toxic", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 19, "poison": 1 } ] }
  },
  {
    "name": "ruling: toxic combat damage to a creature gives no poison counter",
    "players": [ { "battlefield": ["Phyrexian Mite 1-1 Toxic"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "attack": [ { "card": "Phyrexian Mite 1-1 Toxic", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Phyrexian Mite 1-1 Toxic" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20, "poison": 0 } ] }
  },
  {
    "name": "ruling: Gratuitous Violence doubles toxic damage but the poison counter count is unchanged",
    "players": [ { "battlefield": ["Gratuitous Violence", "Phyrexian Mite 1-1 Toxic"] }, {} ],
    "steps": [ { "attack": [ { "card": "Phyrexian Mite 1-1 Toxic", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18, "poison": 1 } ] }
  }
]
