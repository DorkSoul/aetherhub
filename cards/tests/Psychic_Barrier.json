[
  {
    "name": "counters a creature spell and its controller loses 1 life",
    "players": [{ "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }, { "hand": ["Psychic Barrier"], "battlefield": ["Island", "Island"] }],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "cast": "Psychic Barrier", "player": 1, "targets": [{ "stack": "Grizzly Bears" }] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 19, "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Psychic Barrier"] }], "stack_empty": true }
  },
  {
    "name": "cannot target a noncreature spell",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "hand": ["Psychic Barrier"], "battlefield": ["Island", "Island"] }],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Psychic Barrier", "player": 1, "targets": [{ "stack": "Lightning Bolt" }], "illegal": true }
    ],
    "expect": { "players": [{}, { "hand": ["Psychic Barrier"] }] }
  }
]
