[
  {
    "name": "ETB taps an opposing creature which skips its next untap step",
    "players": [
      { "hand": ["Watertrap Weaver"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Watertrap Weaver" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "still tapped at its controller's next untap step",
    "players": [
      { "hand": ["Watertrap Weaver"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Watertrap Weaver" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "can target an already tapped creature",
    "players": [
      { "hand": ["Watertrap Weaver"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Watertrap Weaver" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "no opposing creature: the ETB does nothing",
    "players": [
      { "hand": ["Watertrap Weaver"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Watertrap Weaver" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: an already tapped creature still skips its controller's next untap step",
    "players": [
      { "hand": ["Watertrap Weaver"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Watertrap Weaver" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  }
]
