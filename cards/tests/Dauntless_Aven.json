  {
    "name": "ruling: a creature untapped by the attack trigger does not join the attack",
    "players": [{ "battlefield": ["Dauntless Aven", { "name": "Grizzly Bears", "tapped": true }] }, {}],
    "steps": [
      { "attack": [{ "card": "Dauntless Aven", "at": "p1" }] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 18 }], "tapped": { "Grizzly Bears": false } }
  },
  {
    "name": "ruling: untapping an attacking creature does not remove it from combat",
    "players": [{ "battlefield": ["Dauntless Aven", { "name": "Grizzly Bears", "sick": false }] }, {}],
    "steps": [
      { "attack": [{ "card": "Dauntless Aven", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 16 }] }
