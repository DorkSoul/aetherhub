    "steps": [ { "cast": "Dance of the Dead", "targets": ["Hill Giant"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dance of the Dead", "Hill Giant"] }, {} ], "tapped": { "Hill Giant": false } }
  },
  {
    "name": "upkeep: declining to pay leaves the creature tapped",
    "players": [ { "hand": ["Dance of the Dead"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, { "graveyard": ["Hill Giant"] } ],
    "steps": [ { "cast": "Dance of the Dead", "targets": ["Hill Giant"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dance of the Dead", "Hill Giant"] }, {} ], "tapped": { "Hill Giant": true } }
  },
  {
