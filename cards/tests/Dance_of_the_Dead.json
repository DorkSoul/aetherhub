    "steps": [ { "cast": "Dance of the Dead", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dance of the Dead", "Hill Giant"] }, { "graveyard": [] } ], "pt": { "Hill Giant": [4, 4] }, "tapped": { "Hill Giant": true } }
  },
  {
    "name": "upkeep of the enchanted creature's controller: paying {1}{B} untaps it",
