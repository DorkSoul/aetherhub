    "steps": [ { "cast": "Dance of the Dead", "targets": ["Hill Giant"] }, { "resolve": true }, { "cast": "Disenchant", "targets": ["Dance of the Dead"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Hill Giant", "Dance of the Dead"], "graveyard": ["Dance of the Dead", "Disenchant"] }, { "graveyard": ["Hill Giant"] } ] }
