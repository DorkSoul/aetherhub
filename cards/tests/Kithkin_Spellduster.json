[
  {
    "name": "sacrifice to destroy an enchantment",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Plains",
          "Kithkin Spellduster"
        ]
      },
      {
        "battlefield": [
          "Cindervines"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Kithkin Spellduster",
        "ability": 0,
        "targets": [
          "Cindervines"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Kithkin Spellduster"
          ]
        },
        {
          "graveyard": [
            "Cindervines"
          ]
        }
      ],
      "pt": {
        "Kithkin Spellduster": [
          1,
          2
        ]
      }
    }
  },
  {
    "name": "no enchantment: illegal",
    "players": [
      {
        "battlefield": [
          "Plains",
          "Plains",
          "Kithkin Spellduster"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Kithkin Spellduster",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ]
    }
  },
  {
    "name": "ruling: persist returns it as a new object with a -1/-1 counter (1/2)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Kithkin Spellduster"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Kithkin Spellduster"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Kithkin Spellduster"] }, {}],
      "pt": { "Kithkin Spellduster": [1, 2] }
    }
  },
  {
    "name": "ruling: a persisted creature with a -1/-1 counter does not persist again",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Kithkin Spellduster"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Kithkin Spellduster"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Kithkin Spellduster"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_lacks": ["Kithkin Spellduster"], "graveyard": ["Kithkin Spellduster", "Lightning Bolt", "Lightning Bolt"] }, {}]
    }
  }
]
