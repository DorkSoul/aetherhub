[
  {
    "name": "draws an extra card in your draw step",
    "players": [
      {
        "battlefield": [
          "Grafted Skullcap"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Draw"
      },
      {
        "advance_to": "Draw"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2
        },
        {}
      ]
    }
  },
  {
    "name": "discards your hand at the end step",
    "players": [
      {
        "battlefield": [
          "Grafted Skullcap"
        ],
        "hand": [
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "graveyard": [
            "Forest",
            "Forest"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "without the Skullcap only the normal draw happens",
    "players": [
      {},
      {}
    ],
    "steps": [
      {
        "advance_to": "Draw"
      },
      {
        "advance_to": "Draw"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  }
]
