[
  {
    "name": "dash cost: haste, then returned to hand at the next end step",
    "players": [ { "hand": ["Screamreach Brawler"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Screamreach Brawler", "alt": 0 }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand": ["Screamreach Brawler"], "battlefield_lacks": ["Screamreach Brawler"] }, {} ] }
  },
  {
    "name": "normal cost: stays on the battlefield",
    "players": [ { "hand": ["Screamreach Brawler"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Screamreach Brawler" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Screamreach Brawler"] }, {} ] }
  },
  {
    "name": "ruling: dash creature killed before the end step stays in the graveyard",
    "players": [ { "hand": ["Screamreach Brawler", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Screamreach Brawler", "alt": 0 }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Screamreach Brawler"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_lacks": ["Screamreach Brawler"] }, {} ] }
  },
  {
    "name": "ruling: a dash spell can be countered like any other spell",
    "players": [ { "hand": ["Screamreach Brawler"], "battlefield": ["Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Screamreach Brawler", "alt": 0 }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Screamreach Brawler" }] }, { "pass": true, "player": 1 }, { "pass": true } ],
    "expect": { "players": [ { "graveyard": ["Screamreach Brawler"], "battlefield_lacks": ["Screamreach Brawler"] }, { "graveyard": ["Counterspell"] } ] }
  }
]
