[
  {
    "name": "attacking gives +1/+1 until end of turn",
    "players": [ { "battlefield": ["Soltari Trooper"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Soltari Trooper", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "not attacking leaves it at 1/1",
    "players": [ { "battlefield": ["Soltari Trooper"] }, {} ],
    "steps": [ { "advance_to": "Main2" } ],
    "expect": { "pt": { "Soltari Trooper": [1, 1] } }
  },
  {
    "name": "ruling: a flying creature without shadow cannot block a shadow attacker",
    "players": [ { "battlefield": ["Soltari Trooper"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "attack": [ { "card": "Soltari Trooper", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Soltari Trooper" } ], "illegal": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Soltari Trooper"] }, { "life": 18 } ] }
  },
  {
    "name": "ruling: a creature with shadow can block a shadow attacker",
    "players": [ { "battlefield": ["Soltari Trooper"] }, { "battlefield": ["Soltari Trooper"] } ],
    "steps": [
      { "attack": [ { "card": "Soltari Trooper", "at": "p1" } ] },
      { "block": [ { "blocker": "p1:Soltari Trooper", "attacker": "Soltari Trooper" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Soltari Trooper"] }, { "graveyard_has": ["Soltari Trooper"], "life": 20 } ] }
  }
]
