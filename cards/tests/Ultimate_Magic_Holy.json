[
  { "name": "cast from hand: permanents you control gain indestructible until end of turn",
    "players": [ { "hand": ["Ultimate Magic: Holy"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Ultimate Magic: Holy" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Ultimate Magic: Holy"] }, {} ],
                "keywords": { "Grizzly Bears": ["Indestructible"] } } },
  { "name": "cast from hand: opponent's permanents are not affected",
    "players": [ { "hand": ["Ultimate Magic: Holy"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Ultimate Magic: Holy" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "keywords": { "Grizzly Bears": [] } } },
  { "name": "foretold for {2}, then cast from exile for {2}{W}: damage to you is prevented this turn",
    "players": [ { "hand": ["Ultimate Magic: Holy"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "activate": "Ultimate Magic: Holy", "ability": 0 }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Ultimate Magic: Holy", "alt": 0 }, { "resolve": true }, { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Ultimate Magic: Holy"] }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "cast from hand: damage to you is not prevented",
    "players": [ { "hand": ["Ultimate Magic: Holy"], "battlefield": ["Plains", "Plains", "Plains"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Ultimate Magic: Holy" }, { "resolve": true }, { "pass": true },
               { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, {} ] } },
  { "name": "ruling: foretell is a special action, so it can be taken while a spell is on the stack",
    "players": [ { "hand": ["Ultimate Magic: Holy"], "battlefield": ["Plains", "Plains", "Plains"] },
                 { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
               { "activate": "Ultimate Magic: Holy", "ability": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "exile": ["Ultimate Magic: Holy"], "life": 17 }, { "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "ruling: a foretold instant can be cast as soon as the next player's turn (for its foretell cost)",
    "players": [ { "hand": ["Ultimate Magic: Holy"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Ultimate Magic: Holy", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Upkeep" },
               { "pass": true, "player": 1 }, { "cast": "Ultimate Magic: Holy", "alt": 0, "player": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Ultimate Magic: Holy"], "exile": [] }, {} ], "keywords": { "Grizzly Bears": ["Indestructible"] } } }
]
