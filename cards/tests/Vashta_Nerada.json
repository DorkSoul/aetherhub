[
  {
    "name": "gets a counter at the end step if a creature died this turn",
    "players": [
      { "hand": ["Vendetta"], "battlefield": ["Swamp", "Vashta Nerada"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Vendetta", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Vashta Nerada": [2, 2] },
      "counters": { "Vashta Nerada": { "PlusOnePlusOne": 1 } }
    }
  },
  {
    "name": "no creature died this turn, so no counter",
    "players": [
      { "battlefield": ["Vashta Nerada"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "pt": { "Vashta Nerada": [1, 1] }
    }
  }
]
