  {
    "name": "ruling: toxic gives no poison when its combat damage is dealt to a blocker",
    "players": [
      { "battlefield": ["Necrogen Rotpriest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Necrogen Rotpriest", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Necrogen Rotpriest" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Necrogen Rotpriest"] },
        { "battlefield_has": ["Grizzly Bears"], "poison": 0, "life": 20 }
      ]
    }
  },
  {
