[
  {
    "name": "the opponent's exiled card can be cast by you with mana of any type",
    "players": [
      { "hand": ["Intellect Devourer"], "battlefield": ["Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Merfolk Looter"] }
    ],
    "steps": [
      { "cast": "Intellect Devourer" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Merfolk Looter" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Intellect Devourer", "Merfolk Looter"] },
        { "hand": [], "exile": [] }
      ]
    }
  },
  {
    "name": "the exiled card returns to its owner's hand when Intellect Devourer leaves",
    "players": [
      { "hand": ["Intellect Devourer", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Merfolk Looter"] }
    ],
    "steps": [
      { "cast": "Intellect Devourer" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Intellect Devourer"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Intellect Devourer"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": [], "graveyard": ["Intellect Devourer", "Lightning Bolt", "Lightning Bolt"] },
        { "hand": ["Merfolk Looter"], "exile": [] }
      ]
    }
  },
  {
    "name": "ruling: if Intellect Devourer leaves before its ETB resolves, the opponent exiles nothing",
    "players": [
      { "hand": ["Intellect Devourer", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Merfolk Looter"] }
    ],
    "steps": [
      { "cast": "Intellect Devourer" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Intellect Devourer"] },
      { "cast": "Lightning Bolt", "targets": ["Intellect Devourer"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Intellect Devourer"], "graveyard": ["Intellect Devourer", "Lightning Bolt", "Lightning Bolt"] },
        { "hand": ["Merfolk Looter"], "exile": [] }
      ]
    }
  },
  {
    "name": "ruling: a card played from exile does not return to the opponent when Intellect Devourer leaves",
    "players": [
      { "hand": ["Intellect Devourer", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Merfolk Looter"] }
    ],
    "steps": [
      { "cast": "Intellect Devourer" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Merfolk Looter" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Intellect Devourer"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Intellect Devourer"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Merfolk Looter"], "graveyard": ["Intellect Devourer", "Lightning Bolt", "Lightning Bolt"] },
        { "hand": [], "exile": [] }
      ]
    }
  }
]
