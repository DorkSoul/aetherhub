    "steps": [ { "cast": "Grasp of Phantoms", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grasp of Phantoms"] }, { "battlefield_lacks": ["Grizzly Bears"], "library_count": 21 } ] } },
  { "name": "flashback for {7}{U} exiles it after it resolves",
    "players": [ { "graveyard": ["Grasp of Phantoms"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Grasp of Phantoms", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Grasp of Phantoms"], "graveyard": [] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "ruling: flashback is sorcery speed, so it is illegal during combat",
    "players": [ { "graveyard": ["Grasp of Phantoms"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "BeginCombat" }, { "cast": "Grasp of Phantoms", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Grasp of Phantoms"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: the flashback total cost is {7}{U} not the mana value 4, so seven lands are not enough",
    "players": [ { "graveyard": ["Grasp of Phantoms"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Grasp of Phantoms", "alt": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Grasp of Phantoms"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a flashback spell whose target is killed in response is still exiled",
    "players": [ { "graveyard": ["Grasp of Phantoms"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Grizzly Bears", "sick": false }] } ],
    "steps": [ { "cast": "Grasp of Phantoms", "alt": 0, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Grasp of Phantoms"], "graveyard": [] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } }
