[
  {
    "name": "discarding and tapping prevents the chosen attacker's damage to the target creature",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "hand": ["Shock"], "battlefield": ["Charm Peddler", "Grizzly Bears", "Plains"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "activate": "Charm Peddler", "player": 1, "targets": ["Grizzly Bears"], "answers": ["Shock"] },
      { "resolve": true, "answers": ["Hill Giant"] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20, "battlefield_has": ["Grizzly Bears", "Charm Peddler"], "graveyard": ["Shock"] } ] }
  },
  {
    "name": "without the activation the blocker dies to the attacker",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "hand": ["Shock"], "battlefield": ["Charm Peddler", "Grizzly Bears", "Plains"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 20, "graveyard": ["Grizzly Bears"] } ] }
  }
]
