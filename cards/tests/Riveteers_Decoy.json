[
  { "name": "must be blocked if able",
    "players": [ { "battlefield": ["Riveteers Decoy"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Riveteers Decoy", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Riveteers Decoy"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "blitz: haste, sacrificed at the end step, draws a card when it dies",
    "players": [ { "hand": ["Riveteers Decoy"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Riveteers Decoy", "alt": 0 }, { "resolve": true }, { "attack": [ { "card": "Riveteers Decoy", "at": "p1" } ] }, { "advance_to": "End" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Island"], "battlefield_lacks": ["Riveteers Decoy"], "graveyard": ["Riveteers Decoy"] }, { "life": 17 } ] } },
  { "name": "ruling: a blitz-cast creature spell is still a spell and can be countered",
    "players": [ { "hand": ["Riveteers Decoy"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Riveteers Decoy", "alt": 0 }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Riveteers Decoy" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Riveteers Decoy"], "battlefield_lacks": ["Riveteers Decoy"] }, { "graveyard": ["Counterspell"] } ], "stack_empty": true } },
  { "name": "ruling: a blitzed creature does not have to attack; it is still sacrificed at the end step and draws",
    "players": [ { "hand": ["Riveteers Decoy"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Island"] }, {} ],
    "steps": [ { "cast": "Riveteers Decoy", "alt": 0 }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Island"], "battlefield_lacks": ["Riveteers Decoy"], "graveyard": ["Riveteers Decoy"] }, { "life": 20 } ] } },
  { "name": "ruling: a blitzed creature that dies in combat draws a card (the dies trigger is not only for sacrifice)",
    "players": [ { "hand": ["Riveteers Decoy"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Riveteers Decoy", "alt": 0 }, { "resolve": true }, { "attack": [ { "card": "Riveteers Decoy", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand": ["Island"], "graveyard": ["Riveteers Decoy"] }, { "graveyard": ["Grizzly Bears"] } ] } }
]
