 {
  "name": "ruling: an X spell is countered with its X-based mana value: Blaze for X=3 gives 4 energy",
  "players": [
   { "hand": ["Blaze", "Electrosiphon"], "battlefield": ["Mountain", "Mountain", "Island", "Island", "Forest", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Blaze", "targets": ["p1"], "answers": [3] },
   { "cast": "Electrosiphon", "targets": [{ "stack": "Blaze" }] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "energy": 4, "graveyard": ["Blaze", "Electrosiphon"] }, { "life": 20 } ] }
 },
 {
  "name": "ruling: if its only target is gone on resolution, Electrosiphon does nothing and gives no energy",
  "players": [
   { "hand": ["Grizzly Bears", "Electrosiphon", "Thought Collapse"], "battlefield": ["Forest", "Forest", "Forest", "Island", "Island", "Island", "Island", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "cast": "Electrosiphon", "targets": [{ "stack": "Grizzly Bears" }] },
   { "cast": "Thought Collapse", "targets": [{ "stack": "Grizzly Bears" }] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "energy": 0, "graveyard_has": ["Grizzly Bears", "Electrosiphon", "Thought Collapse"] }, {} ] }
 },
 {
  "name": "ruling: energy counters stay with the player into the opponent's turn",
  "players": [
   { "hand": ["Grizzly Bears", "Electrosiphon"], "battlefield": ["Forest", "Forest", "Island", "Island", "Mountain"] },
   {}
  ],
  "steps": [
