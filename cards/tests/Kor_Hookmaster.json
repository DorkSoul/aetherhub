[
 {
  "name": "ETB taps target opposing creature",
  "players": [
   {
    "hand": ["Kor Hookmaster"],
    "battlefield": ["Plains", "Plains", "Plains"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "cast": "Kor Hookmaster" },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "the tapped creature does not untap during its controller's next untap step",
  "players": [
   {
    "hand": ["Kor Hookmaster"],
    "battlefield": ["Plains", "Plains", "Plains"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "cast": "Kor Hookmaster" },
   { "resolve": true },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "it untaps in the untap step after the skipped one",
  "players": [
   {
    "hand": ["Kor Hookmaster"],
    "battlefield": ["Plains", "Plains", "Plains"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "cast": "Kor Hookmaster" },
   { "resolve": true },
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false }
  }
 },
 {
  "name": "does not target its controller's own creatures",
  "players": [
   {
    "hand": ["Kor Hookmaster"],
    "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"]
   },
   {
    "battlefield": ["Hill Giant"]
   }
  ],
  "steps": [
   { "cast": "Kor Hookmaster" },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Hill Giant": true, "Grizzly Bears": false }
  }
 },
 {
  "name": "ruling: an already tapped creature can be targeted and still skips its controller's next untap step",
  "players": [
   {
    "hand": ["Kor Hookmaster"],
    "battlefield": ["Plains", "Plains", "Plains"]
   },
   {
    "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ]
   }
  ],
  "steps": [
   { "cast": "Kor Hookmaster" },
   { "resolve": true },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": true }
  }
 }
]
