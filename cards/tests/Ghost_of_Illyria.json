    "steps": [ { "cast": "Ghost of Illyria" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Ghost of Illyria", "Grizzly Bears"], "exile": [] }, {} ] } },
