[
  { "name": "ETB exiles an opposing creature until it leaves",
    "players": [ { "hand": ["Alabaster Host Intercessor"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Alabaster Host Intercessor" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Alabaster Host Intercessor"] }, { "exile": ["Grizzly Bears"], "battlefield": [] } ] } },
  { "name": "plainscycling {2}: search for a Plains",
    "players": [ { "hand": ["Alabaster Host Intercessor"], "battlefield": ["Plains", "Plains"], "library": ["Plains"] }, {} ],
    "steps": [ { "activate": "Alabaster Host Intercessor" }, { "resolve": true, "answers": ["Plains"] } ],
    "expect": { "players": [ { "hand": ["Plains"], "graveyard": ["Alabaster Host Intercessor"] }, {} ] } },
  { "name": "ruling: if it leaves before its ETB resolves, the target is not exiled",
    "players": [ { "hand": ["Alabaster Host Intercessor"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
                 { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] } ],
    "steps": [
      { "cast": "Alabaster Host Intercessor" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Alabaster Host Intercessor"] },
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Alabaster Host Intercessor"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Alabaster Host Intercessor"] }, { "graveyard": ["Lightning Bolt", "Lightning Bolt"], "battlefield_has": ["Grizzly Bears"], "exile": [] } ] } }
]
