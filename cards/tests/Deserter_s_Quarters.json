   "steps": [ { "activate": "Deserter's Quarters", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "Upkeep" } ],
   "expect": { "turn": 4, "tapped": { "Grizzly Bears": true, "Deserter's Quarters": true } } },
