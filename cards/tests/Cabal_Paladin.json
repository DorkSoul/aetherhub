[
  {
    "name": "casting a legendary spell deals 2 to each opponent",
    "players": [
      { "hand": ["Brago, King Eternal"], "battlefield": ["Plains", "Island", "Swamp", "Swamp", "Cabal Paladin"] },
      {}
    ],
    "steps": [
      { "cast": "Brago, King Eternal" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  },
  {
    "name": "casting a non-historic spell does not trigger",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Cabal Paladin"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 17 }]
    }
  },
  {
    "name": "ruling: historic trigger still resolves when the spell is countered",
    "players": [
      { "hand": ["Brago, King Eternal"], "battlefield": ["Plains", "Island", "Swamp", "Swamp", "Cabal Paladin"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Brago, King Eternal" },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Brago, King Eternal" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Brago, King Eternal"] },
        { "life": 18, "graveyard_has": ["Counterspell"] }
      ]
    }
  }
]
