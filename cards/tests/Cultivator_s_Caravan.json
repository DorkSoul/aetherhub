   "tapped": { "Hill Giant": true }
  }
 },
 {
  "name": "ruling: destroying the crewed Vehicle does not untap or affect the creature that crewed it",
  "players": [
   { "hand": ["Naturalize"], "battlefield": ["Cultivator's Caravan", "Hill Giant", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "activate": "Cultivator's Caravan" },
   { "resolve": true },
   { "cast": "Naturalize", "targets": ["Cultivator's Caravan"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Cultivator's Caravan"], "battlefield_has": ["Hill Giant"] },
    {}
   ],
   "tapped": { "Hill Giant": true }
  }
 },
 {
  "name": "ruling: a crewed Vehicle can block on the opponent's turn once crewed in the declare attackers step",
  "players": [
   { "battlefield": ["Cultivator's Caravan", "Hill Giant"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "advance_to": "BeginCombat" },
   { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
   { "pass": true, "player": 1 },
   { "activate": "Cultivator's Caravan", "player": 0 },
   { "resolve": true },
   { "block": [ { "blocker": "Cultivator's Caravan", "attacker": "Grizzly Bears" } ], "player": 0 },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "graveyard_has": ["Grizzly Bears"] }
   ]
  }
 }
