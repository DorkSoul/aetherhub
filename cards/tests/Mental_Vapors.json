[
  {
    "name": "target player discards a card; no creature to encode on so it goes to the graveyard",
    "players": [
      { "hand": ["Mental Vapors"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Forest", "Island"] }
    ],
    "steps": [
      { "cast": "Mental Vapors", "targets": ["p1"] },
      { "resolve": true, "answers": [["Island"]] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Mental Vapors"] },
        { "hand": ["Forest"], "graveyard": ["Island"] }
      ]
    }
  },
  {
    "name": "encoded on Grizzly Bears: the spell is exiled instead of going to the graveyard",
    "players": [
      { "hand": ["Mental Vapors"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
      { "hand": ["Forest", "Island"] }
    ],
    "steps": [
      { "cast": "Mental Vapors", "targets": ["p1"] },
      { "resolve": true, "answers": [["Island"], [0]] }
    ],
    "expect": {
      "players": [
        { "exile": ["Mental Vapors"], "graveyard": [] },
        { "hand": ["Forest"], "graveyard": ["Island"] }
      ]
    }
  },
  {
    "name": "ruling: if the encoded creature leaves the battlefield the card stays exiled and is no longer encoded",
    "players": [
      { "hand": ["Mental Vapors", "Doom Blade"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Grizzly Bears"] },
      { "hand": ["Forest", "Island"] }
    ],
    "steps": [
      { "cast": "Mental Vapors", "targets": ["p1"] },
      { "resolve": true, "answers": [["Island"], [0]] },
      { "cast": "Doom Blade", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Mental Vapors"], "graveyard_has": ["Grizzly Bears", "Doom Blade"] },
        { "hand": ["Forest"], "graveyard": ["Island"] }
      ]
    }
  }
]
