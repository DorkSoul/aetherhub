  {
    "name": "{4}, {T}: surveil 1 - keep the top card on top",
    "players": [
      {
        "battlefield": ["University Campus", "Island", "Island", "Island", "Island"],
        "library": ["Serra Angel", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "University Campus", "ability": 0 },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "library_top": ["Serra Angel"], "graveyard": [] },
        {}
      ]
    }
  },
  {
    "name": "{4}, {T}: surveil 1 - put the top card into the graveyard",
    "players": [
      {
        "battlefield": ["University Campus", "Island", "Island", "Island", "Island"],
        "library": ["Serra Angel", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "activate": "University Campus", "ability": 0 },
      { "resolve": true, "answers": [["Serra Angel"]] }
    ],
    "expect": {
      "players": [
        { "library_top": ["Grizzly Bears"], "graveyard": ["Serra Angel"] },
        {}
      ]
    }
  },
  {
    "name": "surveil needs {4} in addition to tapping the Campus",
    "players": [
      {
        "battlefield": ["University Campus", "Island", "Island", "Island"],
        "library": ["Serra Angel"]
      },
      {}
    ],
    "steps": [
      { "activate": "University Campus", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "library_top": ["Serra Angel"], "graveyard": [] },
        {}
      ]
    }
  },
  {
    "name": "enters tapped",
    "players": [
      { "hand": ["University Campus"], "battlefield": ["Plains"] },
      {}
    ],
    "steps": [
      { "play_land": "University Campus" }
    ],
