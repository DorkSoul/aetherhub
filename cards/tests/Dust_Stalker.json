[
  { "name": "returns to hand at the end step when no other colorless creature",
    "players": [ { "hand": ["Dust Stalker"], "battlefield": ["Swamp", "Mountain", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Dust Stalker" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Dust Stalker"], "battlefield_has": [] }, {} ] } },
  { "name": "stays when another colorless creature is controlled",
    "players": [ { "hand": ["Dust Stalker"], "battlefield": ["Swamp", "Mountain", "Plains", "Island", "Wurmcoil Engine"] }, {} ],
    "steps": [ { "cast": "Dust Stalker" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0 }, {} ] } },
  { "name": "Dust Stalker is colorless (devoid) on the battlefield",
    "players": [ { "hand": ["Dust Stalker"], "battlefield": ["Swamp", "Mountain", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Dust Stalker" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dust Stalker"] }, {} ], "colors": { "Dust Stalker": [] } } },
  { "name": "ruling: an aura that makes it black replaces devoid, so its only color is black",
    "players": [ { "hand": ["Sinister Strength"], "battlefield": ["Dust Stalker", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Sinister Strength", "targets": ["Dust Stalker"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dust Stalker", "Sinister Strength"] }, {} ], "colors": { "Dust Stalker": ["B"] }, "pt": { "Dust Stalker": [8, 4] } } },
  { "name": "ruling: gaining a color does not stop the end-step return (it looks for other colorless creatures)",
    "players": [ { "hand": ["Sinister Strength"], "battlefield": ["Dust Stalker", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Sinister Strength", "targets": ["Dust Stalker"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Dust Stalker"], "graveyard_has": ["Sinister Strength"] }, {} ] } },
  { "name": "ruling: in the graveyard its end-step ability does nothing (it works only on the battlefield)",
    "players": [ { "graveyard": ["Dust Stalker"] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "graveyard_has": ["Dust Stalker"], "hand_count": 0 }, {} ] } },
  { "name": "ruling: a colorless creature that arrives in response to the end-step trigger stops it when it resolves",
    "players": [ { "hand": ["Adverse Conditions"], "battlefield": ["Dust Stalker", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "advance_to": "End", "hold": true }, { "cast": "Adverse Conditions" }, { "pass": true }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dust Stalker", "Eldrazi Scion"], "hand_count": 0 }, {} ] } }
]
