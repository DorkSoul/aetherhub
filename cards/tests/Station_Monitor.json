[
  {
    "name": "the second spell each turn creates a Drone",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Shock"
        ],
        "battlefield": [
          "Plains",
          "Island",
          "Mountain",
          "Mountain",
          "Mountain",
          "Station Monitor"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Shock",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Station Monitor",
            "Drone 1-1 Colorless Flying Blocks Only Flyers"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "the first spell each turn creates nothing",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Station Monitor"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Station Monitor"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Drone still comes if the second spell fizzles (its target died in response)",
    "players": [
      { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Plains", "Island", "Mountain", "Mountain", "Station Monitor"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "player": 1, "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Station Monitor", "Drone 1-1 Colorless Flying Blocks Only Flyers"], "graveyard_has": ["Shock"] },
        { "life": 17, "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: Station Monitor itself counts as my first spell, so the next spell I cast is the second",
    "players": [
      { "hand": ["Station Monitor", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Station Monitor" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Station Monitor", "Drone 1-1 Colorless Flying Blocks Only Flyers"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a spell still on the stack counts as cast, so a Shock cast in response is my second spell (Drone)",
    "players": [
      { "hand": ["Lightning Bolt", "Shock"], "battlefield": ["Plains", "Island", "Mountain", "Mountain", "Station Monitor"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Drone 1-1 Colorless Flying Blocks Only Flyers"] },
        { "life": 15 }
      ]
    }
  }
]
