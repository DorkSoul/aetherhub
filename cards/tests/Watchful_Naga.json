[
  {
    "name": "exerted: draws a card and does not untap during the next untap step",
    "players": [
      { "battlefield": ["Watchful Naga"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Watchful Naga", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest", "Grizzly Bears"] },
        {}
      ],
      "tapped": { "Watchful Naga": true }
    }
  },
  {
    "name": "not exerted: no card drawn and it untaps normally",
    "players": [
      { "battlefield": ["Watchful Naga"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Watchful Naga", "at": "p1" } ] },
      { "resolve": true, "answers": [false] },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"] },
        {}
      ],
      "tapped": { "Watchful Naga": false }
    }
  },
  {
    "name": "ruling: a creature exerted while under Threaten's control untaps in its owner's untap step",
    "players": [
      { "hand": ["Threaten"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears"] },
      { "battlefield": ["Watchful Naga"] }
    ],
    "steps": [
      { "cast": "Threaten", "targets": ["Watchful Naga"] },
      { "resolve": true },
      { "attack": [ { "card": "Watchful Naga", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Watchful Naga": false }
    }
  }
]
