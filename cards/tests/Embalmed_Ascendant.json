[
 { "name": "enters and creates a 2/2 black Zombie token",
   "players": [ { "hand": ["Embalmed Ascendant"], "battlefield": ["Plains", "Swamp", "Island"] }, {} ],
   "steps": [ { "cast": "Embalmed Ascendant" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Embalmed Ascendant", "Zombie"] }, {} ], "pt": { "Zombie": [2, 2] } } },
 { "name": "max speed: a creature you control dying drains 1",
   "players": [ { "hand": ["Embalmed Ascendant", "Lightning Bolt"], "battlefield": ["Plains", "Swamp", "Island", "Mountain"] }, {} ],
   "steps": [ { "cast": "Embalmed Ascendant" }, { "resolve": true }, { "resolve": true }, { "set_speed": 4 }, { "cast": "Lightning Bolt", "targets": ["Zombie"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "life": 21 }, { "life": 19 } ] } },
 { "name": "below max speed a creature dying does not drain",
   "players": [ { "hand": ["Embalmed Ascendant", "Lightning Bolt"], "battlefield": ["Plains", "Swamp", "Island", "Mountain"] }, {} ],
   "steps": [ { "cast": "Embalmed Ascendant" }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Zombie"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
 { "name": "start your engines: speed starts at 1 when the Ascendant enters",
   "players": [ { "hand": ["Embalmed Ascendant"], "battlefield": ["Plains", "Swamp", "Island"] }, {} ],
   "steps": [ { "cast": "Embalmed Ascendant" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1, "battlefield_has": ["Embalmed Ascendant", "Zombie"] }, {} ] } },
 { "name": "ruling: speed stays at 1 after the Ascendant leaves the battlefield",
   "players": [ { "hand": ["Embalmed Ascendant", "Lightning Bolt"], "battlefield": ["Plains", "Swamp", "Island", "Mountain"] }, {} ],
   "steps": [ { "cast": "Embalmed Ascendant" }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Embalmed Ascendant"] }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1, "graveyard_has": ["Embalmed Ascendant"] }, {} ] } },
 { "name": "ruling: a player without start your engines has speed 0, and mine does not change theirs",
   "players": [ { "hand": ["Embalmed Ascendant"], "battlefield": ["Plains", "Swamp", "Island"] }, {} ],
   "steps": [ { "cast": "Embalmed Ascendant" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "speed": 1 }, { "speed": 0 } ] } }
]
