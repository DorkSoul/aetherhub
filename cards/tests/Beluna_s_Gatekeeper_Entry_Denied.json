[
  {
    "name": "Entry Denied returns target creature you don't control with mana value 3 or less to hand",
    "players": [
      { "hand": ["Beluna's Gatekeeper // Entry Denied"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Beluna's Gatekeeper // Entry Denied", "face": true, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Beluna's Gatekeeper // Entry Denied"] },
        { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "mana value 4 creature is not a legal target",
    "players": [
      { "hand": ["Beluna's Gatekeeper // Entry Denied"], "battlefield": ["Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Beluna's Gatekeeper // Entry Denied", "face": true, "illegal": true }
    ],
    "expect": {
      "players": [{ "hand": ["Beluna's Gatekeeper // Entry Denied"] }, { "battlefield_has": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: an Adventure whose target is gone on resolution is not exiled, so the creature cannot be cast later",
    "players": [
      { "hand": ["Beluna's Gatekeeper // Entry Denied"], "battlefield": ["Island", "Island"] },
      { "hand": ["Doom Blade"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Beluna's Gatekeeper // Entry Denied", "face": true, "targets": ["p1:Grizzly Bears"] },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Beluna's Gatekeeper // Entry Denied"] },
        { "graveyard_has": ["Grizzly Bears", "Doom Blade"] }
      ]
    }
  },
  {
    "name": "ruling: after the Adventure resolves, the creature can be cast from exile as a permanent spell",
    "players": [
      { "hand": ["Beluna's Gatekeeper // Entry Denied"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Beluna's Gatekeeper // Entry Denied", "face": true, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Beluna's Gatekeeper // Entry Denied" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Beluna's Gatekeeper // Entry Denied"] },
        { "hand": ["Grizzly Bears"] }
      ]
    }
  }
]
