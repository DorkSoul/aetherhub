[
 { "name": "ETB: destroys the target artifact and deals 1 damage (only Ally is itself)",
   "players": [ { "hand": ["Tuktuk Scrapper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Dimir Signet"] } ],
   "steps": [ { "cast": "Tuktuk Scrapper" }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ { "battlefield_has": ["Tuktuk Scrapper"], "life": 20 }, { "graveyard": ["Dimir Signet"], "life": 19 } ] } },
 { "name": "damage equals the number of Allies you control (two Allies)",
   "players": [ { "hand": ["Tuktuk Scrapper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Tuktuk Grunts"] }, { "battlefield": ["Dimir Signet"] } ],
   "steps": [ { "cast": "Tuktuk Scrapper" }, { "resolve": true, "answers": [true, false] } ],
   "expect": { "players": [ { "battlefield_has": ["Tuktuk Scrapper"] }, { "graveyard": ["Dimir Signet"], "life": 18 } ] } },
 { "name": "declining the optional destroy leaves the artifact and deals no damage",
   "players": [ { "hand": ["Tuktuk Scrapper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Dimir Signet"] } ],
   "steps": [ { "cast": "Tuktuk Scrapper" }, { "resolve": true, "answers": [false] } ],
   "expect": { "players": [ { "life": 20 }, { "battlefield_has": ["Dimir Signet"], "life": 20 } ] } },
 { "name": "an indestructible artifact is not put into a graveyard, so no damage",
   "players": [ { "hand": ["Tuktuk Scrapper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Darksteel Plate"] } ],
   "steps": [ { "cast": "Tuktuk Scrapper" }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ { "life": 20 }, { "battlefield_has": ["Darksteel Plate"], "life": 20 } ] } },
 { "name": "ruling: a destroyed token artifact still makes Scrapper damage its controller (token ceases to exist)",
   "players": [ { "hand": ["Tuktuk Scrapper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Treasure"] } ],
   "steps": [ { "cast": "Tuktuk Scrapper" }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ { "battlefield_has": ["Tuktuk Scrapper"], "life": 20 }, { "battlefield_lacks": ["Treasure"], "graveyard": [], "life": 19 } ] } }
]
