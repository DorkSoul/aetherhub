[
  {
    "name": "mode 1: a +1/+1 counter on itself",
    "players": [{ "hand": ["Aven Surveyor"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [{ "cast": "Aven Surveyor" }, { "resolve": true, "answers": [[0]] }],
    "expect": {
      "pt": { "Aven Surveyor": [3, 3] },
      "counters": { "Aven Surveyor": { "p1p1": 1 } }
    }
  },
  {
    "name": "mode 2: return target creature to its owner's hand",
    "players": [
      { "hand": ["Aven Surveyor"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [{ "cast": "Aven Surveyor" }, { "resolve": true, "answers": [[1], [0]] }],
    "expect": {
      "players": [{ "battlefield_has": ["Aven Surveyor"] }, { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "ruling: mode 2 stays chosen when the creature leaves in response, so the bounce still happens",
    "players": [
      { "hand": ["Aven Surveyor"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
      { "hand": ["Doom Blade"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Aven Surveyor" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Aven Surveyor"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true, "answers": [[1]] }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Aven Surveyor"] }, { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }]
    }
  }
]
