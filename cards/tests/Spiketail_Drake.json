[
  { "name": "sacrifice: counter a spell; its controller can't pay {3}",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Spiketail Drake"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Spiketail Drake", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Spiketail Drake", "Lightning Bolt"] }, { "life": 20 } ] } },
  { "name": "sacrifice: the spell resolves if its controller pays {3}",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island", "Island", "Island", "Spiketail Drake"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "activate": "Spiketail Drake", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Spiketail Drake"] }, { "life": 17 } ] } },
  { "name": "ruling: the pay option belongs to the spell's controller (the opponent), not the Drake's controller",
    "players": [ { "battlefield": ["Spiketail Drake"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island", "Island"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "pass": true, "player": 1 },
      { "activate": "Spiketail Drake", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Spiketail Drake"], "life": 17 }, { "graveyard_has": ["Lightning Bolt"], "life": 20 } ] } },
  { "name": "ruling: the opponent who cannot or does not pay sees the spell countered",
    "players": [ { "battlefield": ["Spiketail Drake"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Island", "Island", "Island"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "pass": true, "player": 1 },
      { "activate": "Spiketail Drake", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Spiketail Drake"], "life": 20 }, { "graveyard_has": ["Lightning Bolt"], "life": 20 } ] } }
]
