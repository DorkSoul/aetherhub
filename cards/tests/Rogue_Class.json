[
  { "name": "combat damage exiles the top card; level 3 lets you cast it with any mana; level 2 gives menace",
    "players": [ { "hand": [], "battlefield": [{ "name": "Rogue Class", "counters": { "Level": 2 } }, "Grizzly Bears", "Swamp"] }, { "library": ["Lightning Bolt"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { }, { "life": 15, "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "level 2 only: creatures have menace, exiled card is not castable",
    "players": [ { "battlefield": [{ "name": "Rogue Class", "counters": { "Level": 1 } }, "Grizzly Bears", "Swamp"] }, { "library": ["Lightning Bolt"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true }, { "cast": "Lightning Bolt", "illegal": true } ],
    "expect": { "players": [ { }, { "exile": ["Lightning Bolt"], "life": 18 } ], "pt": {} } },
 { "name": "{1}{U}{B}: level 1 gives creatures you control menace",
   "players": [ { "battlefield": ["Rogue Class", "Island", "Swamp", "Mountain", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Rogue Class", "ability": 0 }, { "resolve": true } ],
   "expect": { "counters": { "Rogue Class": { "Level": 1 } }, "players": [ { "battlefield_has": ["Rogue Class", "Grizzly Bears"] }, {} ], "keywords": { "Grizzly Bears": ["Menace"] } } },
 { "name": "level 1 cannot be bought again with the level 1 ability",
   "players": [ { "battlefield": [{ "name": "Rogue Class", "counters": { "Level": 1 } }, "Island", "Swamp", "Mountain"] }, {} ],
   "steps": [ { "activate": "Rogue Class", "ability": 0, "illegal": true } ],
   "expect": { "counters": { "Rogue Class": { "Level": 1 } } } },
 { "name": "{2}{U}{B}: level 2 from level 1 (level 2 ability needs level 1)",
   "players": [ { "battlefield": [{ "name": "Rogue Class", "counters": { "Level": 1 } }, "Island", "Swamp", "Island", "Swamp"] }, {} ],
   "steps": [ { "activate": "Rogue Class", "ability": 1 }, { "resolve": true } ],
   "expect": { "counters": { "Rogue Class": { "Level": 2 } } } },
 { "name": "the level 2 ability is illegal at level 0",
   "players": [ { "battlefield": ["Rogue Class", "Island", "Swamp", "Island", "Swamp"] }, {} ],
   "steps": [ { "activate": "Rogue Class", "ability": 1, "illegal": true } ],
   "expect": { "counters": {} } },
  { "name": "ruling: gaining level 3 keeps the level 2 menace",
    "players": [ { "battlefield": [{ "name": "Rogue Class", "counters": { "Level": 1 } }, "Grizzly Bears", "Island", "Swamp", "Island", "Swamp"] }, {} ],
    "steps": [ { "activate": "Rogue Class", "ability": 1 }, { "resolve": true } ],
    "expect": { "counters": { "Rogue Class": { "Level": 2 } }, "players": [ { "battlefield_has": ["Rogue Class", "Grizzly Bears"] }, {} ], "keywords": { "Grizzly Bears": ["Menace"] } } },
  { "name": "ruling: at level 3 the level 2 ability cannot be activated again, even with four mana",
    "players": [ { "battlefield": [{ "name": "Rogue Class", "counters": { "Level": 2 } }, "Island", "Swamp", "Island", "Swamp"] }, {} ],
    "steps": [ { "activate": "Rogue Class", "ability": 0, "illegal": true } ],
    "expect": { "counters": { "Rogue Class": { "Level": 2 } } } },
  { "name": "ruling: gaining a level uses the stack, so the level changes only when the ability resolves",
    "players": [ { "battlefield": ["Rogue Class", "Island", "Swamp", "Mountain"] }, {} ],
    "steps": [ { "activate": "Rogue Class", "ability": 0 } ],
    "expect": { "stack_empty": false, "counters": { "Rogue Class": { "Level": 0 } } } }
]
