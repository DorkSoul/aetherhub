[
  { "name": "attacking gets +1/+1 for each other untapped creature you control",
    "players": [ { "battlefield": ["Knotvine Paladin", "Grizzly Bears", "Grizzly Bears"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Knotvine Paladin", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Knotvine Paladin": [4, 4] } } },
  { "name": "alone it only gets the base 2/2",
    "players": [ { "battlefield": ["Knotvine Paladin"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Knotvine Paladin", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Knotvine Paladin": [2, 2] } } },
  { "name": "ruling: the bonus counts untapped creatures at resolution, so attacking creatures do not count",
    "players": [ { "battlefield": ["Knotvine Paladin", "Grizzly Bears", "Llanowar Elves"] }, {} ],
    "steps": [
      { "attack": [ { "card": "Knotvine Paladin", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "pt": { "Knotvine Paladin": [3, 3] } } }
]
