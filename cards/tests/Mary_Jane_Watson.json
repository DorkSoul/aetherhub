[
  {
    "name": "a Spider entering draws a card",
    "players": [
      { "hand": ["Canopy Spider"], "battlefield": ["Mary Jane Watson", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Canopy Spider" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_has": ["Canopy Spider", "Mary Jane Watson"] } ]
    }
  },
  {
    "name": "only once each turn",
    "players": [
      { "hand": ["Canopy Spider", "Canopy Spider"], "battlefield": ["Mary Jane Watson", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Canopy Spider" },
      { "resolve": true },
      { "cast": "Canopy Spider" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 } ]
    }
  },
  {
    "name": "a non-Spider entering does not draw",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Mary Jane Watson", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 } ]
    }
  }
]
