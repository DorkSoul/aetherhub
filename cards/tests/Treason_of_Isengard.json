        {}
      ]
    }
  },
  {
    "name": "casting without a target still amasses 2",
    "players": [
      { "hand": ["Treason of Isengard"], "battlefield": ["Island", "Island", "Island"], "graveyard": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
