        { "graveyard": ["Treason of Isengard", "Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: target removed from the graveyard in response makes Treason do nothing",
    "players": [
      { "hand": ["Treason of Isengard"], "battlefield": ["Island", "Island", "Island", "Tormod's Crypt"], "graveyard": ["Lightning Bolt"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Treason of Isengard", "targets": ["Lightning Bolt"] },
      { "activate": "Tormod's Crypt", "ability": 0, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Lightning Bolt", "Tormod's Crypt"], "library_top": ["Grizzly Bears"], "graveyard_has": ["Treason of Isengard"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a second amass adds counters to the existing Army instead of making another",
    "players": [
      { "hand": ["Treason of Isengard", "Treason of Isengard"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Treason of Isengard" },
      { "resolve": true },
      { "cast": "Treason of Isengard" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Treason of Isengard", "Treason of Isengard"] },
