 {
  "name": "ruling 0: normal cast does not turn a land into a creature",
  "players": [ { "hand": ["Boiling Earth"], "battlefield": ["Mountain", "Mountain", "Forest"] }, { "battlefield": ["Llanowar Elves"] } ],
  "steps": [ { "cast": "Boiling Earth" }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Boiling Earth"], "battlefield_has": ["Forest"] }, { "graveyard": ["Llanowar Elves"] } ], "not_subtypes": { "Forest": ["Elemental"] } }
 },
 {
  "name": "ruling 1: the awakened land keeps its mana ability (Forest taps for G)",
  "players": [ { "hand": ["Boiling Earth", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest"] }, {} ],
  "steps": [ { "cast": "Boiling Earth", "alt": 0, "targets": ["Forest"] }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Forest"] }, {} ], "pt": { "Forest": [4, 4] } }
 },
 {
  "name": "ruling 4: the awakened land creature is colorless",
  "players": [ { "hand": ["Boiling Earth"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Forest"] }, {} ],
  "steps": [ { "cast": "Boiling Earth", "alt": 0, "targets": ["Forest"] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Boiling Earth"] }, {} ], "pt": { "Forest": [4, 4] }, "colors": { "Forest": [] } }
 }
