[
  {
    "name": "ruling: X is the power the creature last had on the battlefield (pumped to 6 before it died)",
    "players": [
      { "hand": ["Titanic Growth", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Kresh the Bloodbraided", "Forest", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Titanic Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "counters": { "Kresh the Bloodbraided": { "PlusOnePlusOne": 6 } },
      "pt": { "Kresh the Bloodbraided": [9, 9] },
      "players": [{ "graveyard_has": ["Lightning Bolt", "Titanic Growth"] }, { "graveyard": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "another creature dying puts counters equal to its power",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Kresh the Bloodbraided", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "counters": { "Kresh the Bloodbraided": { "PlusOnePlusOne": 2 } },
      "pt": { "Kresh the Bloodbraided": [5, 5] },
      "players": [{ "graveyard": ["Shock"] }, { "graveyard": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "Kresh dying itself does not trigger",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Kresh the Bloodbraided"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Kresh the Bloodbraided"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt", "Kresh the Bloodbraided"] }, {}]
    }
  }
]
