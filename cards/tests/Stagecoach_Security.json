[
  { "name": "ETB gives creatures you control +1/+1 until end of turn, opponents' creatures unchanged",
    "players": [ { "hand": ["Stagecoach Security"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
                 { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "cast": "Stagecoach Security" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Stagecoach Security": [5, 6], "Grizzly Bears": [3, 3], "Llanowar Elves": [1, 1] } } },
  { "name": "plot pays {3}{W}; cast free on a later turn",
    "players": [ { "hand": ["Stagecoach Security"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Stagecoach Security", "ability": 0 }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Stagecoach Security", "alt": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Stagecoach Security"] }, {} ] } },
  { "name": "ruling: a creature entering after the ETB resolved is not pumped or given vigilance",
    "players": [ { "hand": ["Stagecoach Security", "Savannah Lions"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Stagecoach Security" }, { "resolve": true }, { "resolve": true }, { "cast": "Savannah Lions" }, { "resolve": true } ],
    "expect": { "pt": { "Stagecoach Security": [5, 6], "Savannah Lions": [2, 1] }, "players": [ { "battlefield_has": ["Savannah Lions"] }, {} ] } },
  { "name": "ruling: a plotted card cannot be cast free on the turn it was plotted",
    "players": [ { "hand": ["Stagecoach Security"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Stagecoach Security", "ability": 0 }, { "resolve": true }, { "cast": "Stagecoach Security", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Stagecoach Security"], "battlefield_lacks": ["Stagecoach Security"] }, {} ] } }
]
