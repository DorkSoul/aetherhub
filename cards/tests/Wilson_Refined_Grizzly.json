 {
  "name": "cannot be countered by an opponent's Broken Concentration",
  "players": [
   {
    "hand": [
     "Wilson, Refined Grizzly"
    ],
    "battlefield": [
     "Forest",
     "Forest"
    ]
   },
   {
    "hand": [
     "Broken Concentration"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Wilson, Refined Grizzly"
   },
   {
    "pass": true
   },
   {
    "cast": "Broken Concentration",
    "player": 1,
    "targets": [
     {
      "stack": "Wilson, Refined Grizzly"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
