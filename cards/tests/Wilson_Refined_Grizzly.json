  "expect": { "players": [ { "battlefield_has": ["Wilson, Refined Grizzly"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
 },
 {
  "name": "ward {2}: opponent who pays {2} lets the Lightning Bolt kill Wilson",
