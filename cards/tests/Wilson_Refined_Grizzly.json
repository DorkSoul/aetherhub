     "battlefield_has": [
      "Wilson, Refined Grizzly"
     ]
    },
    {
     "graveyard_has": [
      "Broken Concentration"
     ]
    }
   ]
  }
 },
 {
  "name": "ward {2}: opponent who cannot pay loses the Lightning Bolt targeting Wilson",
  "players": [
   { "battlefield": ["Wilson, Refined Grizzly"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Wilson, Refined Grizzly"] },
   { "resolve": true, "auto": true }
