[
  { "name": "exiling a 4-mana card adds four counters",
    "players": [ { "library": ["Hill Giant", "Forest"], "battlefield": ["Phyrexian Devourer"] }, {} ],
    "steps": [ { "activate": "Phyrexian Devourer" }, { "resolve": true } ],
    "expect": { "pt": { "Phyrexian Devourer": [5, 5] }, "players": [ { "exile": ["Hill Giant"] }, {} ] } },
  { "name": "a land adds none",
    "players": [ { "library": ["Forest", "Hill Giant"], "battlefield": ["Phyrexian Devourer"] }, {} ],
    "steps": [ { "activate": "Phyrexian Devourer" }, { "resolve": true } ],
    "expect": { "pt": { "Phyrexian Devourer": [1, 1] }, "players": [ { "exile": ["Forest"] }, {} ] } },
  { "name": "reaching power 7 sacrifices it",
    "players": [ { "library": ["Hill Giant"], "battlefield": [ { "name": "Phyrexian Devourer", "counters": { "PlusOnePlusOne": 3 } } ] }, {} ],
    "steps": [ { "activate": "Phyrexian Devourer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Phyrexian Devourer"] }, {} ] } },
  { "name": "ruling: countering the sacrifice trigger while power is 7 makes it trigger again, and it is sacrificed",
    "players": [ { "battlefield": [ { "name": "Phyrexian Devourer", "counters": { "PlusOnePlusOne": 6 } } ] }, { "hand": ["Stifle"], "battlefield": ["Island"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Phyrexian Devourer" } ] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Phyrexian Devourer"] }, { "graveyard": ["Stifle"] } ] } },
  { "name": "ruling: power reduced to 5 before the trigger resolves still means sacrifice",
    "players": [ { "battlefield": [ { "name": "Phyrexian Devourer", "counters": { "PlusOnePlusOne": 6 } } ] }, { "hand": ["Vicious Offering"], "battlefield": ["Swamp", "Swamp"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Vicious Offering", "player": 1, "targets": ["Phyrexian Devourer"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Phyrexian Devourer"] }, { "graveyard": ["Vicious Offering"] } ] } }
]
