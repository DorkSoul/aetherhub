 {
  "name": "chapter I: surveil 1 puts the top card in the graveyard",
  "players": [
   { "hand": ["Summon: G.F. Cerberus"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Hill Giant"] },
   {}
  ],
  "steps": [ { "cast": "Summon: G.F. Cerberus" }, { "resolve": true, "answers": [["Grizzly Bears"]] } ],
  "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "library_top": ["Hill Giant"] }, {} ] }
 },
 {
  "name": "chapter I: surveil 1 keeping the top card leaves the library unchanged",
  "players": [
   { "hand": ["Summon: G.F. Cerberus"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears", "Hill Giant"] },
   {}
  ],
  "steps": [ { "cast": "Summon: G.F. Cerberus" }, { "resolve": true, "answers": [[]] } ],
  "expect": { "players": [ { "graveyard": [], "library_top": ["Grizzly Bears", "Hill Giant"] }, {} ] }
 },
 {
  "name": "ruling: the copy of the next instant may choose new targets",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Summon: G.F. Cerberus", "counters": { "lore": 1 } }, "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true, "answers": ["Grizzly Bears"] }
  ],
  "expect": { "players": [ {}, { "life": 17, "graveyard_has": ["Grizzly Bears"] } ] }
 },
 {
