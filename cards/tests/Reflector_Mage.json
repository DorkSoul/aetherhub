[
  { "name": "returned creature's owner can't cast a spell with the same name",
    "players": [ { "hand": ["Reflector Mage"], "battlefield": ["Plains", "Island", "Island"] }, { "battlefield": ["Spellstutter Sprite", "Island", "Island"] } ],
    "steps": [
      { "cast": "Reflector Mage" },
      { "resolve": true },
      { "resolve": true },
      { "pass": true },
      { "cast": "Spellstutter Sprite", "player": 1, "illegal": true }
    ],
    "expect": { "players": [ { "battlefield": ["Plains", "Island", "Island", "Reflector Mage"] }, { "hand": ["Spellstutter Sprite"], "battlefield": ["Island", "Island"] } ] } },
  { "name": "the owner can still cast other spells",
    "players": [ { "hand": ["Reflector Mage"], "battlefield": ["Plains", "Island", "Island"] }, { "hand": ["Shock"], "battlefield": ["Spellstutter Sprite", "Island", "Mountain"] } ],
    "steps": [
      { "cast": "Reflector Mage" },
      { "resolve": true },
      { "resolve": true },
      { "pass": true },
      { "cast": "Spellstutter Sprite", "player": 1, "illegal": true },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 18, "battlefield": ["Plains", "Island", "Island", "Reflector Mage"] }, { "hand": ["Spellstutter Sprite"], "graveyard": ["Shock"] } ] } },
  { "name": "the restriction does not apply to the controller's own card of that name",
    "players": [ { "hand": ["Reflector Mage", "Spellstutter Sprite"], "battlefield": ["Plains", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Spellstutter Sprite"] } ],
    "steps": [
      { "cast": "Reflector Mage" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Spellstutter Sprite" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield": ["Plains", "Island", "Island", "Island", "Island", "Reflector Mage", "Spellstutter Sprite"] }, { "hand": ["Spellstutter Sprite"] } ] } },
  { "name": "ruling: the restriction does not stop the owner playing a returned creature that is also a land",
    "players": [ { "hand": ["Reflector Mage"], "battlefield": ["Plains", "Island", "Island"] }, { "battlefield": ["Dryad Arbor"] } ],
    "steps": [
      { "cast": "Reflector Mage" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "play_land": "Dryad Arbor", "player": 1 }
    ],
    "expect": { "players": [ { "battlefield_has": ["Reflector Mage"] }, { "battlefield_has": ["Dryad Arbor"] } ] } }
]
