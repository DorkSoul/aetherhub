[
  { "name": "sacrifice a 1-drop Elf: search for an Elf with mana value 2 onto the battlefield",
    "players": [
      { "battlefield": ["Pyre of Heroes", "Llanowar Elves", "Forest", "Forest", "Forest"], "library": ["Elvish Visionary", "Grizzly Bears"] },
      {}
    ],
    "steps": [ { "activate": "Pyre of Heroes" }, { "resolve": true, "answers": ["Elvish Visionary"] } ],
    "expect": {
      "players": [
        { "battlefield_has": ["Pyre of Heroes", "Elvish Visionary"], "battlefield_lacks": ["Llanowar Elves", "Grizzly Bears"], "graveyard_has": ["Llanowar Elves"] },
        {}
      ]
    }
  },
  { "name": "no creature of a shared type with the right mana value: nothing is found",
    "players": [
      { "battlefield": ["Pyre of Heroes", "Llanowar Elves", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Elvish Mystic"] },
      {}
    ],
    "steps": [ { "activate": "Pyre of Heroes" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears", "Elvish Mystic", "Elvish Visionary"], "graveyard_has": ["Llanowar Elves"] },
        {}
      ]
    }
  },
  { "name": "cannot activate without a creature to sacrifice",
    "players": [
      { "battlefield": ["Pyre of Heroes", "Forest", "Forest", "Forest"], "library": ["Elvish Visionary"] },
      {}
    ],
    "steps": [ { "activate": "Pyre of Heroes", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Pyre of Heroes"] }, {} ] }
  },
  { "name": "ruling: the sacrifice is paid as a cost, so the creature is gone before the search resolves",
    "players": [
      { "battlefield": ["Pyre of Heroes", "Llanowar Elves", "Forest", "Forest", "Forest"], "library": ["Elvish Visionary"] },
      {}
    ],
    "steps": [ { "activate": "Pyre of Heroes" } ],
    "expect": {
      "stack_empty": false,
      "players": [
        { "battlefield_has": ["Pyre of Heroes"], "battlefield_lacks": ["Llanowar Elves", "Elvish Visionary"], "graveyard_has": ["Llanowar Elves"] },
        {}
      ]
    }
  }
]
