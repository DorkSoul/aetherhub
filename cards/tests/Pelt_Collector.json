[
  {
    "name": "gets a +1/+1 counter when a bigger creature enters",
    "players": [
      {
        "hand": [
          "Hill Giant"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Pelt Collector"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Hill Giant"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Pelt Collector",
            "Hill Giant"
          ]
        },
        {}
      ],
      "counters": {
        "Pelt Collector": {
          "p1p1": 1
        }
      }
    }
  },
  {
    "name": "creature you control with greater power dies: put a +1/+1 counter on Pelt Collector",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pelt Collector", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Grizzly Bears"] },
        {}
      ],
      "counters": {
        "Pelt Collector": { "p1p1": 1 }
      },
      "pt": { "Pelt Collector": [2, 2] }
    }
  },
  {
    "name": "creature you control with power not greater than Pelt Collector's dies: no counter",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Pelt Collector", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Llanowar Elves"] },
        {}
      ],
      "pt": { "Pelt Collector": [1, 1] }
    }
  },
  {
    "name": "three +1/+1 counters: trample pushes the excess damage over a blocker",
    "players": [
      { "battlefield": [{ "name": "Pelt Collector", "counters": { "p1p1": 3 }, "sick": false }] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "attack": [{ "card": "Pelt Collector", "at": "p1" }] },
      { "block": [{ "blocker": "Savannah Lions", "attacker": "Pelt Collector" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 17, "graveyard": ["Savannah Lions"] }]
    }
  },
  {
    "name": "two +1/+1 counters: no trample, the blocker stops all damage",
    "players": [
      { "battlefield": [{ "name": "Pelt Collector", "counters": { "p1p1": 2 }, "sick": false }] },
      { "battlefield": ["Savannah Lions"] }
    ],
    "steps": [
      { "attack": [{ "card": "Pelt Collector", "at": "p1" }] },
      { "block": [{ "blocker": "Savannah Lions", "attacker": "Pelt Collector" }], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "ruling: a bigger creature that dies before its enter trigger resolves still counts (last known power 3)",
    "players": [
      {
        "hand": ["Hill Giant", "Lightning Bolt"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Pelt Collector"]
      },
      {}
    ],
    "steps": [
      { "cast": "Hill Giant" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Pelt Collector": { "p1p1": 2 } },
      "pt": { "Pelt Collector": [3, 3] },
      "players": [
        { "graveyard_has": ["Hill Giant", "Lightning Bolt"], "battlefield_has": ["Pelt Collector"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a dying creature's power includes its counters: 3 is not greater than Pelt's 3, so no counter",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain", { "name": "Pelt Collector", "counters": { "p1p1": 2 }, "sick": false }, { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }]
      },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Pelt Collector": { "p1p1": 2 } },
      "pt": { "Pelt Collector": [3, 3] },
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: a creature entering with power equal to Pelt Collector's does not trigger the ability",
    "players": [
      { "hand": ["Llanowar Elves"], "battlefield": ["Forest", "Pelt Collector"] },
      {}
    ],
    "steps": [
      { "cast": "Llanowar Elves" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Pelt Collector": { "p1p1": 0 } },
      "pt": { "Pelt Collector": [1, 1] },
      "players": [ { "battlefield_has": ["Pelt Collector", "Llanowar Elves"] }, {} ]
    }
  },
  {
    "name": "ruling: two power-2 creatures die at once, but Pelt Collector gets only one counter",
    "players": [
      {
        "battlefield": ["Pelt Collector", { "name": "Grizzly Bears", "sick": false }, { "name": "Savannah Lions", "sick": false }]
      },
      { "battlefield": ["Hill Giant", "Giant Spider"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" }, { "blocker": "Giant Spider", "attacker": "Savannah Lions" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Pelt Collector": { "p1p1": 1 } },
      "pt": { "Pelt Collector": [2, 2] },
      "players": [
        { "graveyard_has": ["Grizzly Bears", "Savannah Lions"], "battlefield_has": ["Pelt Collector"] },
        { "battlefield_has": ["Hill Giant", "Giant Spider"] }
      ]
    }
  }
]
