[
  {
    "name": "cast face down for {3} as a 2/2, then turn face up for the morph cost",
    "players": [
      { "hand": ["Snowhorn Rider"], "battlefield": ["Forest", "Island", "Mountain", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Snowhorn Rider", "alt": 254 },
      { "resolve": true },
      { "activate": "Snowhorn Rider", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Snowhorn Rider"] }, {} ],
      "pt": { "Snowhorn Rider": [5, 5] },
      "keywords": { "Snowhorn Rider": ["Trample"] }
    }
  },
  {
    "name": "face down it is a 2/2 without abilities",
    "players": [
      { "hand": ["Snowhorn Rider"], "battlefield": ["Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Snowhorn Rider", "alt": 254 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Snowhorn Rider": [2, 2] }
    }
  },
  {
    "name": "ruling: a permanent turned face up keeps the Aura attached (Ward of Piety stays on it)",
    "players": [
      { "hand": ["Snowhorn Rider", "Ward of Piety"], "battlefield": ["Forest", "Island", "Mountain", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Snowhorn Rider", "alt": 254 },
      { "resolve": true },
      { "cast": "Ward of Piety", "targets": ["Snowhorn Rider"] },
      { "resolve": true },
      { "activate": "Snowhorn Rider", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Snowhorn Rider", "Ward of Piety"] }, {} ],
      "pt": { "Snowhorn Rider": [5, 5] }
    }
  },
  {
    "name": "ruling: a face-down spell on the stack cannot be turned face up",
    "players": [
      { "hand": ["Snowhorn Rider"], "battlefield": ["Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Snowhorn Rider", "alt": 254 },
      { "activate": "Snowhorn Rider", "ability": 0, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Snowhorn Rider"] }, {} ],
      "pt": { "Snowhorn Rider": [2, 2] }
    }
  },
  {
    "name": "ruling: a face-down spell is paid for with {3} (two lands are not enough)",
    "players": [
      { "hand": ["Snowhorn Rider"], "battlefield": ["Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Snowhorn Rider", "alt": 254, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Snowhorn Rider"] }, {} ]
    }
  },
  {
    "name": "ruling: a face-down permanent has no abilities, so no trample",
    "players": [
      { "hand": ["Snowhorn Rider"], "battlefield": ["Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Snowhorn Rider", "alt": 254 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Snowhorn Rider": [2, 2] },
      "keywords": { "Snowhorn Rider": [] }
    }
  }
]
