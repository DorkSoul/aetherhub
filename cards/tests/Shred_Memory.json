    "expect": { "players": [ { "graveyard": ["Shred Memory"] }, { "graveyard": [], "exile": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ] }
  },
  { "name": "a set spanning two graveyards keeps only the first owner's cards",
    "players": [ { "hand": ["Shred Memory"], "battlefield": ["Swamp", "Island"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Shred Memory", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Shred Memory"], "exile": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "exile": [] } ] }
  },
  { "name": "transmute {1}{B}{B}: discard it to search for a card with the same mana value (2)",
