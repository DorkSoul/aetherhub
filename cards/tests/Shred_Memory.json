    "steps": [ { "activate": "Shred Memory", "ability": 0 }, { "resolve": true, "answers": ["Grizzly Bears"] } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard_has": ["Shred Memory"] }, {} ] }
  }
]
