  "steps": [ { "tap_for_mana": "Sol Ring" }, { "activate": "Tawnos, Urza's Apprentice", "illegal": true } ],
  "expect": { "players": [ {}, { "life": 20 } ], "tapped": { "Sol Ring": true, "Tawnos, Urza's Apprentice": false } }
