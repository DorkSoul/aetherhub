[
  {
    "name": "exiles the library then shuffles the graveyard into it",
    "players": [
      {
        "hand": [
          "Paradigm Shift"
        ],
        "battlefield": [
          "Island",
          "Island"
        ],
        "graveyard": [
          "Grizzly Bears",
          "Lightning Bolt"
        ],
        "library": [
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Paradigm Shift"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "library_count": 2,
          "graveyard": [
            "Paradigm Shift"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "the spell itself is not shuffled into the library",
    "players": [
      {
        "hand": [
          "Paradigm Shift"
        ],
        "battlefield": [
          "Island",
          "Island"
        ],
        "library": [
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Paradigm Shift"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "library_count": 0,
          "graveyard": [
            "Paradigm Shift"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the spell is not shuffled into its own library",
    "players": [
      {
        "hand": ["Paradigm Shift"],
        "battlefield": ["Island", "Island"],
        "graveyard": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Paradigm Shift" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 1, "library_top": ["Grizzly Bears"], "graveyard_has": ["Paradigm Shift"] },
        {}
      ]
    }
  }
]
