  { "name": "opponent discards their nonland permanent card; a Jace token is created and empowered",
    "players": [ { "hand": ["Solve for Disappointment"], "battlefield": ["Swamp", "Swamp"] }, { "hand": ["Grizzly Bears", "Lightning Bolt"] } ],
    "steps": [ { "cast": "Solve for Disappointment", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "hand": ["Lightning Bolt"], "graveyard_has": ["Grizzly Bears"] } ], "counters": { "Jace": { "loyalty": 1 } } } },
  { "name": "an existing Jace token gets the counter instead of a new one",
    "players": [ { "hand": ["Solve for Disappointment"], "battlefield": ["Swamp", "Swamp", "Jace"] }, { "hand": ["Lightning Bolt"] } ],
    "steps": [ { "cast": "Solve for Disappointment", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Jace"] }, { "hand": ["Lightning Bolt"] } ], "counters": { "Jace": { "loyalty": 1 } } } },
