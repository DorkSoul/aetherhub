    "players": [ { "hand": ["Solve for Disappointment"], "battlefield": ["Swamp", "Swamp"] }, { "hand": ["Lightning Bolt", "Forest"] } ],
    "steps": [ { "cast": "Solve for Disappointment", "targets": ["p1"] }, { "resolve": true } ],
