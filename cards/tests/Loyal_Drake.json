[
  {
    "name": "beginning of combat with your commander on the battlefield draws a card",
    "players": [
      {
        "command": ["Grizzly Bears"],
        "battlefield": ["Loyal Drake", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        {}
      ]
    },
    "commander": true
  },
  {
    "name": "no commander on the battlefield: no card at beginning of combat",
    "players": [
      {
        "battlefield": ["Loyal Drake"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "a commander in the command zone (not on the battlefield) does not count",
    "players": [
      {
        "command": ["Grizzly Bears"],
        "battlefield": ["Loyal Drake"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        {}
      ]
    },
    "commander": true
  },
  {
    "name": "ruling: controlling one of two commanders is enough",
    "players": [
      {
        "command": ["Grizzly Bears", "Pippin, Warden of Isengard"],
        "battlefield": ["Loyal Drake", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {"players": [{"hand_count": 1}, {}]},
    "commander": true
  },
  {
    "name": "ruling: controlling both commanders still draws only one card per combat",
    "players": [
      {
        "command": ["Grizzly Bears", "Pippin, Warden of Isengard"],
        "battlefield": ["Loyal Drake", "Forest", "Forest", "Forest", "Swamp", "Swamp"]
      },
      {}
    ],
    "steps": [
      { "cast": "Pippin, Warden of Isengard" },
      { "resolve": true, "targets": ["p0"], "answers": [false] },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": {"players": [{"hand_count": 1}, {}]},
    "commander": true
  }
]
