[
  {
    "name": "enters with an indestructible counter when cast from hand",
    "players": [
      { "hand": ["Myojin of Roaring Blades"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Myojin of Roaring Blades" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Roaring Blades"] }, {} ],
      "counters": { "Myojin of Roaring Blades": { "indestructible": 1 } }
    }
  },
  {
    "name": "deals 7 damage to each of up to three targets",
    "players": [
      { "battlefield": [ { "name": "Myojin of Roaring Blades", "counters": { "indestructible": 1 } } ] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Myojin of Roaring Blades", "ability": 0, "targets": ["Grizzly Bears", "Hill Giant", "p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 13, "graveyard_has": ["Grizzly Bears", "Hill Giant"] } ],
      "counters": { "Myojin of Roaring Blades": { "indestructible": 0 } }
    }
  },
  {
    "name": "a single target takes 7 damage",
    "players": [
      { "battlefield": [ { "name": "Myojin of Roaring Blades", "counters": { "indestructible": 1 } } ] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Myojin of Roaring Blades", "ability": 0, "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20, "graveyard_has": ["Hill Giant"] } ]
    }
  },
  {
    "name": "indestructible while it has an indestructible counter: Murder does not destroy it",
    "players": [
      { "battlefield": [ { "name": "Myojin of Roaring Blades", "counters": { "indestructible": 1 } } ] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Roaring Blades"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myojin of Roaring Blades"] }, {} ],
      "counters": { "Myojin of Roaring Blades": { "indestructible": 1 } }
    }
  },
  {
    "name": "without a counter Murder destroys it",
    "players": [
      { "battlefield": ["Myojin of Roaring Blades"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Myojin of Roaring Blades"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Myojin of Roaring Blades"] }, {} ] }
  }
]
