  {
    "name": "ruling: a jump-started spell is exiled even when it is countered",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "graveyard": ["Chemister's Insight"],
        "battlefield": ["Island", "Island", "Island", "Island"]
      },
      {
        "hand": ["Counterspell"],
        "battlefield": ["Island", "Island"]
      }
    ],
    "steps": [
      { "cast": "Chemister's Insight", "alt": 0 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Chemister's Insight" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"], "exile": ["Chemister's Insight"], "hand_count": 0 },
        { "graveyard": ["Counterspell"] }
      ]
    }
  }
