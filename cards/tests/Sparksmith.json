[
 {
  "name": "counts every Goblin on the battlefield",
  "players": [
   { "battlefield": ["Sparksmith", "Goblin Piker", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "activate": "Sparksmith", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 18, "battlefield_has": ["Sparksmith", "Goblin Piker"] },
    { "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "lone Goblin deals 1 to creature and to you",
  "players": [
   { "battlefield": ["Sparksmith", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "activate": "Sparksmith", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 19 },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "opponent's Goblins count too",
  "players": [
   { "battlefield": ["Sparksmith", "Mountain"] },
   { "battlefield": ["Grizzly Bears", "Goblin Piker"] }
  ],
  "steps": [
   { "activate": "Sparksmith", "targets": ["Goblin Piker"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 18 },
    { "graveyard": ["Goblin Piker"], "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 }
]
