  {
    "name": "ruling: Play Arcanum reduction pays only generic: an exiled Lightning Strike needs just a Mountain for its {R}",
    "players": [ { "battlefield": ["Urianger Augurelt", "Mountain"], "library": ["Lightning Strike", "Island"] }, {} ],
    "steps": [
      { "activate": "Urianger Augurelt", "ability": 0 },
      { "resolve": true, "answers": ["Lightning Strike"] },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "activate": "Urianger Augurelt", "ability": 1 },
      { "resolve": true },
      { "cast": "Lightning Strike", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22 }, { "life": 17 } ] }
  },
  {
    "name": "ruling: the reduction does not pay colored mana: with only a Swamp, the exiled Lightning Strike is illegal",
    "players": [ { "battlefield": ["Urianger Augurelt", "Swamp"], "library": ["Lightning Strike", "Island"] }, {} ],
    "steps": [
      { "activate": "Urianger Augurelt", "ability": 0 },
