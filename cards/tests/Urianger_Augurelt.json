  {
    "name": "ruling: the gain-2 trigger for casting from exile still resolves when that spell is countered",
    "players": [ { "battlefield": ["Urianger Augurelt", "Forest"], "library": ["Grizzly Bears", "Island"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [
      { "activate": "Urianger Augurelt", "ability": 0 },
      { "resolve": true, "answers": ["Grizzly Bears"] },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "activate": "Urianger Augurelt", "ability": 1 },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 22, "graveyard_has": ["Grizzly Bears"] }, {} ] }
