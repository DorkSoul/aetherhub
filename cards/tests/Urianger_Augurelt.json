  {
    "name": "ruling: a land exiled with Urianger cannot be played once this turn's land drop is used",
    "players": [ { "hand": ["Plains"], "battlefield": ["Urianger Augurelt"], "library": ["Forest", "Island"] }, {} ],
    "steps": [
      { "activate": "Urianger Augurelt", "ability": 0 },
      { "resolve": true, "answers": ["Forest"] },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "play_land": "Plains" },
