  "name": "ruling: X counts the Elves on resolution, so an Elf killed in response is no longer counted",
  "players": [
   {
    "hand": [],
    "battlefield": ["Timberwatch Elf", "Llanowar Elves", "Grizzly Bears"]
   },
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Mountain"]
   }
