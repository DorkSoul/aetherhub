[
 {
  "name": "counters a red spell when you control a red creature",
  "players": [
   { "hand": ["Jaded Response"], "battlefield": ["Island", "Island", "Hill Giant"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
   { "cast": "Jaded Response", "targets": [ { "stack": "Lightning Bolt" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20, "graveyard": ["Jaded Response"] },
    { "graveyard": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "does not counter when no color is shared",
  "players": [
   { "hand": ["Jaded Response"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
   { "cast": "Jaded Response", "targets": [ { "stack": "Lightning Bolt" } ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 17, "graveyard": ["Jaded Response"] },
    { "graveyard": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: colour is checked on resolution: the red creature dies in response, so the Bolt is not countered",
  "players": [
   { "hand": ["Jaded Response"], "battlefield": ["Island", "Island", "Hill Giant"] },
   { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["p0"], "player": 1 },
   { "cast": "Jaded Response", "targets": [ { "stack": "Lightning Bolt" } ] },
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["Hill Giant"], "player": 1 },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 17, "graveyard": ["Jaded Response", "Hill Giant"] },
    { "graveyard": ["Lightning Bolt", "Lightning Bolt"] }
   ]
  }
 }
]
