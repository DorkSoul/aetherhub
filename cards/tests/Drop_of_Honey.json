[
  {
    "name": "at your upkeep destroys the creature with the least power",
    "players": [
      { "battlefield": ["Drop of Honey"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Grizzly Bears"], "battlefield": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "with several creatures tied for least power you choose which one is destroyed",
    "players": [
      { "battlefield": ["Drop of Honey"] },
      { "battlefield": ["Grizzly Bears", "Savannah Lions", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "graveyard": ["Savannah Lions"], "battlefield": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "is sacrificed when there are no creatures on the battlefield",
    "players": [
      { "battlefield": ["Drop of Honey", "Swamp"] },
      { "battlefield": ["Forest"] }
    ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": {
      "players": [
        { "graveyard": ["Drop of Honey"], "battlefield": ["Swamp"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: if the only least-power creature is indestructible, no creature is destroyed",
    "players": [
      { "battlefield": ["Drop of Honey"] },
      { "battlefield": ["Darksteel Colossus"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Drop of Honey"] },
        { "battlefield_has": ["Darksteel Colossus"] }
      ]
    }
  }
]
