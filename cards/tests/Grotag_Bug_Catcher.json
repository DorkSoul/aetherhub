[
  { "name": "alone in its party: attacks as a 2/2",
    "players": [ { "battlefield": ["Grotag Bug-Catcher"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grotag Bug-Catcher", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "pt": { "Grotag Bug-Catcher": [2, 2] } } },
  { "name": "with a Rogue in its party it attacks as a 3/2",
    "players": [ { "battlefield": ["Grotag Bug-Catcher", "Aether Theorist"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grotag Bug-Catcher", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "pt": { "Grotag Bug-Catcher": [3, 2] } } },
  { "name": "ruling: two Rogues count as one party member (Warrior + Rogue = +2)",
    "players": [ { "battlefield": ["Grotag Bug-Catcher", "Aether Theorist", "Aether Theorist"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grotag Bug-Catcher", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "pt": { "Grotag Bug-Catcher": [3, 2] } } },
  { "name": "ruling: the bonus is fixed on resolution; losing a party member later does not change it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Grotag Bug-Catcher", "Aether Theorist", "Mountain"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grotag Bug-Catcher", "at": "p1" } ] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Aether Theorist"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Aether Theorist"] }, {} ], "pt": { "Grotag Bug-Catcher": [3, 2] } } }
