[
  {
    "name": "ETB destroys target Goblin",
    "players": [ { "hand": ["Tivadar of Thorn"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Raging Goblin", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Tivadar of Thorn" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tivadar of Thorn"] }, { "graveyard": ["Raging Goblin"], "battlefield_has": ["Grizzly Bears"] } ],
      "pt": { "Tivadar of Thorn": [2, 2] }
    }
  },
  {
    "name": "ETB with no Goblin on the battlefield destroys nothing",
    "players": [ { "hand": ["Tivadar of Thorn"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Tivadar of Thorn" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tivadar of Thorn"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "protection from red: a blocked red Hill Giant deals no damage to Tivadar",
    "players": [ { "battlefield": ["Tivadar of Thorn"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "attack": [{ "card": "Hill Giant", "at": "p0" }], "player": 1 },
      { "block": [{ "blocker": "Tivadar of Thorn", "attacker": "Hill Giant" }], "player": 0 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Tivadar of Thorn"], "life": 20 },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
]
