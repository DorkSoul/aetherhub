[
  {"name": "entering when it is neither day nor night makes it day; becoming day does not trigger",
   "players": [{"hand": ["Celestus Sanctifier"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island", "Mountain"]}, {}],
   "steps": [{"cast": "Celestus Sanctifier"},
             {"resolve": true},
             {"advance_to": "End"}],
   "expect": {"players": [{"graveyard": [], "battlefield_has": ["Celestus Sanctifier"]}, {}]}},
  {"name": "day becomes night (no spell cast last turn): look at top two, one to graveyard, the other stays on top",
   "players": [{"hand": ["Celestus Sanctifier"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island", "Mountain"]}, {}],
   "steps": [{"cast": "Celestus Sanctifier"},
             {"resolve": true},
             {"advance_to": "End"},
             {"advance_to": "Main1"},
             {"advance_to": "End"},
             {"advance_to": "Main1", "answers": ["Island"]}],
   "expect": {"players": [{"graveyard": ["Island"], "hand": ["Mountain"]}, {}]}},
  {"name": "no change to night when the previous active player cast a spell",
   "players": [{"hand": ["Celestus Sanctifier"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island", "Mountain"]},
               {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}],
   "steps": [{"cast": "Celestus Sanctifier"},
             {"resolve": true},
             {"advance_to": "End"},
             {"advance_to": "Main1", "player": 1},
             {"cast": "Lightning Bolt", "player": 1, "targets": ["p0"]},
             {"resolve": true},
             {"advance_to": "End"},
             {"advance_to": "Main1"}],
   "expect": {"players": [{"graveyard": [], "hand": ["Island"], "life": 17}, {}]}},
  {"name": "ruling: night becomes day only when the previous active player cast two or more spells",
   "players": [{"hand": ["Celestus Sanctifier"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Island", "Mountain", "Plains", "Swamp", "Forest"]},
               {"hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"]}],
   "steps": [{"cast": "Celestus Sanctifier"},
             {"resolve": true},
             {"advance_to": "End"},
             {"advance_to": "Main1"},
             {"advance_to": "End"},
             {"advance_to": "Main1", "answers": ["Island"]},
             {"advance_to": "End"},
             {"advance_to": "Main1", "player": 1},
             {"cast": "Lightning Bolt", "player": 1, "targets": ["p0"]},
             {"resolve": true},
             {"cast": "Lightning Bolt", "player": 1, "targets": ["p0"]},
             {"resolve": true},
             {"advance_to": "End"},
             {"advance_to": "Main1", "answers": ["Swamp"]}],
   "expect": {"players": [{"graveyard": ["Island", "Swamp"], "battlefield_has": ["Celestus Sanctifier"], "life": 14}, {}]}}
