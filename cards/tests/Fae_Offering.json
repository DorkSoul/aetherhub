   { "pass": true },
   { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
