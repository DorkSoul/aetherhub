[
  {
    "name": "Gaze in Wonder taps two target creatures, then the card is exiled",
    "players": [
      { "hand": ["Velvetwing Butterflies // Gaze in Wonder"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Velvetwing Butterflies // Gaze in Wonder", "face": true, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Velvetwing Butterflies // Gaze in Wonder"] }, {} ],
      "tapped": { "Grizzly Bears": true, "Hill Giant": true }
    }
  },
  {
    "name": "Gaze in Wonder with one target taps only that creature",
    "players": [
      { "hand": ["Velvetwing Butterflies // Gaze in Wonder"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Velvetwing Butterflies // Gaze in Wonder", "face": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Hill Giant": false }
    }
  },
  {
    "name": "ruling: after the Adventure resolves the card is exiled, and the creature can be cast from exile",
    "players": [ { "hand": ["Velvetwing Butterflies // Gaze in Wonder"], "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Velvetwing Butterflies // Gaze in Wonder", "face": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Velvetwing Butterflies // Gaze in Wonder" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": [], "battlefield_has": ["Velvetwing Butterflies // Gaze in Wonder"] }, {} ],
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: the creature cast from exile keeps its normal timing (illegal on the opponent's turn)",
    "players": [ { "hand": ["Velvetwing Butterflies // Gaze in Wonder"], "battlefield": ["Plains", "Plains", "Plains", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Velvetwing Butterflies // Gaze in Wonder", "face": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Velvetwing Butterflies // Gaze in Wonder", "illegal": true }
    ],
    "expect": { "players": [ { "exile": ["Velvetwing Butterflies // Gaze in Wonder"] }, {} ] }
  }
]
