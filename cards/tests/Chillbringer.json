[
 {
  "name": "enters tapping an opposing creature",
  "players": [
   {
    "hand": [
     "Chillbringer"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Chillbringer"
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true
   },
   "players": [
    {
     "battlefield_has": [
      "Chillbringer"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "targeting an already tapped creature still skips its next untap step",
  "players": [
   { "hand": ["Chillbringer", "Chillbringer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Chillbringer" }, { "resolve": true }, { "resolve": true },
   { "advance_to": "Main1" }, { "advance_to": "Main1" },
   { "cast": "Chillbringer" }, { "resolve": true }, { "resolve": true },
   { "advance_to": "Main1" }
  ],
  "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "ruling: an already tapped creature stays tapped through its controller's next untap step",
  "players": [
   { "hand": ["Chillbringer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Chillbringer" }, { "resolve": true }, { "resolve": true },
   { "advance_to": "Main2" }, { "advance_to": "Main1" }
  ],
  "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "ruling: the skipped untap is only the next one: the creature untaps at the following untap step",
  "players": [
   { "hand": ["Chillbringer"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Chillbringer" }, { "resolve": true }, { "resolve": true },
   { "advance_to": "Main2" }, { "advance_to": "Main1" },
   { "advance_to": "Main2" }, { "advance_to": "Main1" },
   { "advance_to": "Main2" }, { "advance_to": "Main1" }
  ],
  "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": false } }
 }
]
