[
  { "name": "entering creates a Food token",
    "players": [ { "hand": ["Bakersbane Duo"], "battlefield": ["Forest", "Plains"] }, {} ],
    "steps": [ { "cast": "Bakersbane Duo" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bakersbane Duo", "Food"] }, {} ] } },
  { "name": "expend 4: spending the fourth mana on a spell gives +1/+1 until end of turn",
    "players": [ { "hand": ["Harmonize"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Bakersbane Duo"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bakersbane Duo"] }, {} ], "pt": { "Bakersbane Duo": [3, 3] } } },
  { "name": "expend 4 does not trigger with only three mana spent",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Bakersbane Duo"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bakersbane Duo"] }, {} ], "pt": { "Bakersbane Duo": [2, 2] } } },
  { "name": "ruling: mana spent before it entered does not count toward expend 4",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Bakersbane Duo"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Bakersbane Duo" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bakersbane Duo", "Food"] }, { "life": 8 } ], "pt": { "Bakersbane Duo": [2, 2] } } },
  { "name": "ruling: expend 4 triggers once per turn, not again after more mana is spent",
    "players": [ { "hand": ["Harmonize", "Harmonize"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Bakersbane Duo"] }, {} ],
    "steps": [ { "cast": "Harmonize" }, { "resolve": true }, { "cast": "Harmonize" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bakersbane Duo"] }, {} ], "pt": { "Bakersbane Duo": [3, 3] } } },
  { "name": "ruling: a Food sacrificed for its own ability cannot also pay Maraleaf Rider's Food cost",
    "players": [ { "hand": ["Bakersbane Duo"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Maraleaf Rider", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Bakersbane Duo" }, { "resolve": true }, { "activate": "Food", "ability": 0 }, { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 23, "battlefield_has": ["Bakersbane Duo", "Maraleaf Rider"], "battlefield_lacks": ["Food"] }, {} ] } }
]
