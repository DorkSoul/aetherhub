[
 { "name": "pay 3 life for R to cast a spell",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Treasonous Ogre"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 17, "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
 { "name": "attacking the player tied for the most life: +1/+1 counter",
   "players": [ { "battlefield": [{"name": "Treasonous Ogre", "sick": false}] }, {} ],
   "steps": [ { "attack": [ { "card": "Treasonous Ogre", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "counters": { "Treasonous Ogre": { "p1p1": 1 } } } },
 { "name": "defender with less life than the other player: no counter",
   "players": [ { "battlefield": [{"name": "Treasonous Ogre", "sick": false}] }, { "life": 10 } ],
   "steps": [ { "attack": [ { "card": "Treasonous Ogre", "at": "p1" } ] }, { "resolve": true } ],
   "expect": { "pt": { "Treasonous Ogre": [2, 3] } } },
 { "name": "ruling: the dethrone counter is placed even if the defender no longer has the most life when the trigger resolves",
   "players": [ { "battlefield": [{"name": "Treasonous Ogre", "sick": false}] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "attack": [ { "card": "Treasonous Ogre", "at": "p1" } ] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Treasonous Ogre": { "p1p1": 1 } } } },
 { "name": "ruling: the counter is placed before blockers are declared, so the Ogre survives a 3/3 blocker",
   "players": [ { "battlefield": [{"name": "Treasonous Ogre", "sick": false}] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "attack": [ { "card": "Treasonous Ogre", "at": "p1" } ] }, { "resolve": true }, { "block": [ { "blocker": "Hill Giant", "attacker": "Treasonous Ogre" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Treasonous Ogre"] }, { "graveyard": ["Hill Giant"] } ], "pt": { "Treasonous Ogre": [3, 4] } } },
 { "name": "ruling: attacking a planeswalker does not trigger dethrone, even when its controller has the most life",
   "players": [ { "life": 10, "battlefield": [{"name": "Treasonous Ogre", "sick": false}] }, { "battlefield": ["Jace, Memory Adept"] } ],
   "steps": [ { "attack": [ { "card": "Treasonous Ogre", "at": "Jace, Memory Adept" } ] }, { "advance_to": "Main2" } ],
   "expect": { "pt": { "Treasonous Ogre": [2, 3] } } }
]
