[
  { "name": "every creature able to block the Boar must do so",
    "players": [ { "battlefield": ["Nessian Boar"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Nessian Boar", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Nessian Boar"] }, { "life": 20 } ] } },
  { "name": "the blocking creature's controller draws a card",
    "players": [ { "battlefield": ["Nessian Boar"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Nessian Boar", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Nessian Boar" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "hand_count": 1 } ] } },
  { "name": "ruling: each creature blocking the Boar draws its controller a card",
    "players": [ { "battlefield": ["Nessian Boar"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Nessian Boar", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "hand_count": 2 } ] } },
  { "name": "ruling: a tapped creature does not block the Boar and draws no card",
    "players": [ { "battlefield": ["Nessian Boar"] }, { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }, "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Nessian Boar", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "hand_count": 1, "battlefield_has": ["Grizzly Bears"] } ] } }
]
