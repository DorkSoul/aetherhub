  {
    "name": "ruling: blocked by two creatures, afflict makes the defending player lose 3 life only once",
    "players": [
      { "battlefield": ["Manticore Eternal"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Manticore Eternal", "at": "p1" } ] },
      { "block": [
          { "blocker": "Grizzly Bears", "attacker": "Manticore Eternal" },
          { "blocker": "Hill Giant", "attacker": "Manticore Eternal" }
        ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: afflict loss to 0 life ends the game before a blocker's lifelink damage",
    "players": [
      { "battlefield": ["Manticore Eternal"] },
      { "life": 3, "battlefield": ["Vampire Nighthawk"] }
    ],
    "steps": [
      { "attack": [ { "card": "Manticore Eternal", "at": "p1" } ] },
      { "block": [ { "blocker": "Vampire Nighthawk", "attacker": "Manticore Eternal" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
