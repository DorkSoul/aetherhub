  {
    "name": "flash: can be cast in the main phase after combat",
    "players": [
      {
        "hand": [
          "Merfolk Trickster"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main2"
      },
      {
        "cast": "Merfolk Trickster"
      },
      {
        "resolve": true
      }
