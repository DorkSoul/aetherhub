  {
    "name": "ruling: a */1+ creature that loses its abilities becomes 0/1 (Tarmogoyf with creature and instant in graveyards)",
    "players": [
      {
        "hand": ["Merfolk Trickster"],
        "battlefield": ["Island", "Island"]
      },
      {
        "battlefield": ["Tarmogoyf"],
        "graveyard": ["Grizzly Bears", "Lightning Bolt"]
      }
    ],
    "steps": [
      { "cast": "Merfolk Trickster" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Merfolk Trickster"] }, { "battlefield_has": ["Tarmogoyf"] }],
      "tapped": { "Tarmogoyf": true },
      "pt": { "Tarmogoyf": [0, 1] }
    }
  },
  {
    "name": "ruling: an activated ability already on the stack still resolves after the creature loses its abilities",
    "players": [
      {
        "hand": ["Merfolk Trickster"],
        "battlefield": ["Island", "Island"]
      },
      {
        "battlefield": ["Prodigal Sorcerer"]
      }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Merfolk Trickster" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "activate": "Prodigal Sorcerer", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 19 }, {}],
      "tapped": { "Prodigal Sorcerer": true }
    }
  },
  {
    "name": "ruling: a becomes-tapped trigger still triggers when Trickster taps the creature",
    "players": [
      {
        "hand": ["Merfolk Trickster"],
        "battlefield": ["Island", "Island"]
      },
      {
        "battlefield": ["Chrome Companion"]
      }
    ],
    "steps": [
      { "cast": "Merfolk Trickster" },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "life": 21 }],
      "tapped": { "Chrome Companion": true }
    }
  }
]