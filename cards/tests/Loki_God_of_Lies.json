[
 {
  "name": "casting a pump on a tapped opposing creature steals it, untapped and hasty, so it can attack",
  "players": [
   { "battlefield": [ "Loki, God of Lies", "Forest" ], "hand": [ "Giant Growth" ] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": [ "Grizzly Bears" ] },
   { "resolve": true },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": [ "Loki, God of Lies", "Grizzly Bears" ] },
    { "life": 15 }
   ]
  }
 },
 {
  "name": "control returns at end of turn",
  "players": [
   { "battlefield": [ "Loki, God of Lies", "Forest" ], "hand": [ "Giant Growth" ] },
   { "battlefield": [ "Grizzly Bears" ] }
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": [ "Grizzly Bears" ] },
   { "resolve": true },
   { "resolve": true },
   { "advance_to": "Main1", "player": 0 },
   { "advance_to": "End" },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "players": [
    { "battlefield": [ "Loki, God of Lies", "Forest" ] },
    { "battlefield": [ "Grizzly Bears" ] }
   ]
  }
 },
 {
  "name": "a spell that targets only a player does not trigger Loki",
  "players": [
   { "battlefield": [ "Loki, God of Lies", "Mountain" ], "hand": [ "Lightning Bolt" ] },
   { "battlefield": [ "Grizzly Bears" ] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": [ "p1" ] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "life": 17, "battlefield_has": [ "Grizzly Bears" ] }
   ]
  }
 },
 {
  "name": "targeting your own creature keeps it yours",
  "players": [
   { "battlefield": [ "Loki, God of Lies", "Grizzly Bears", "Forest" ], "hand": [ "Giant Growth" ] },
   {}
  ],
  "steps": [
   { "cast": "Giant Growth", "targets": [ "Grizzly Bears" ] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": [ "Loki, God of Lies", "Grizzly Bears" ], "graveyard": [ "Giant Growth" ] },
    {}
   ]
  }
 }
]
