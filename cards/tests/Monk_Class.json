 {
  "name": "ruling: a level 3 Class keeps its earlier cost reduction (the second spell still costs {1} less)",
  "players": [ { "hand": ["Grizzly Bears", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", { "name": "Monk Class", "counters": { "level": 3 } }] }, {} ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Grizzly Bears"] }, {} ] }
 },
 {
  "name": "ruling: levels are gained one at a time in the same turn (level 2 ability, then level 3 ability)",
  "players": [ { "battlefield": ["Plains", "Plains", "Island", "Island", "Forest", { "name": "Monk Class", "counters": { "level": 1 } }] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "activate": "Monk Class", "ability": 0 }, { "resolve": true, "answers": [["Grizzly Bears"]] }, { "resolve": true }, { "activate": "Monk Class", "ability": 1 }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Monk Class"] }, { "hand": ["Grizzly Bears"] } ], "counters": { "Monk Class": { "level": 3 } } }
 },
 {
  "name": "ruling: two Monk Classes are cumulative (the second spell costs {2} less)",
  "players": [ { "hand": ["Lightning Bolt", "Shimmercreep"], "battlefield": ["Mountain", "Swamp", "Swamp", "Swamp", { "name": "Monk Class", "counters": { "level": 1 } }, { "name": "Monk Class", "counters": { "level": 1 } }] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Shimmercreep" }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Shimmercreep"] }, {} ] }
 },
 {
  "name": "ruling: a Class cast as your first spell discounts your second spell this turn",
  "players": [ { "hand": ["Monk Class", "Grizzly Bears"], "battlefield": ["Plains", "Island", "Forest"] }, {} ],
  "steps": [ { "cast": "Monk Class" }, { "resolve": true }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Monk Class", "Grizzly Bears"] }, {} ] }
 },
 {
  "name": "ruling: a Class cast as your second spell gives no discount to the third spell (its bonus waits for next turn)",
  "players": [ { "hand": ["Lightning Bolt", "Monk Class", "Grizzly Bears"], "battlefield": ["Mountain", "Plains", "Island", "Forest"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Monk Class" }, { "resolve": true }, { "cast": "Grizzly Bears", "illegal": true } ],
  "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Monk Class"] }, {} ] }
 },
 {
  "name": "ruling: a level 3 Class cannot activate its level 2 ability (levels must match)",
  "players": [ { "battlefield": ["Plains", "Island", { "name": "Monk Class", "counters": { "level": 3 } }] }, {} ],
  "steps": [ { "activate": "Monk Class", "ability": 0, "illegal": true } ],
  "expect": { "counters": { "Monk Class": { "level": 3 } } }
 }
