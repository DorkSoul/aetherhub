   { "resolve": true },
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Monk Class", "Grizzly Bears"], "exile": [] }, { "life": 17 } ]
  }
