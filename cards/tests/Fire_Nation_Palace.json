 {
  "name": "enters tapped when you control no basic land",
  "players": [
   {
    "hand": [
     "Fire Nation Palace"
    ],
    "battlefield": [
     "Darkslick Shores"
    ]
   },
   {}
  ],
  "steps": [
   {
    "play_land": "Fire Nation Palace"
   }
