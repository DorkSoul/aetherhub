[
  {
    "name": "nontoken artifact creature's combat damage gives two poison counters",
    "players": [{ "battlefield": [{ "name": "Virulent Silencer", "sick": false }] }, {}],
    "steps": [{ "attack": [{ "card": "Virulent Silencer", "at": "p1" }] }, { "advance_to": "Main2" }],
    "expect": { "players": [{}, { "life": 18, "poison": 2 }] }
  },
  {
    "name": "a nonartifact creature's combat damage gives no poison",
    "players": [{ "battlefield": [{ "name": "Virulent Silencer", "sick": false }, { "name": "Grizzly Bears", "sick": false }] }, {}],
    "steps": [{ "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "advance_to": "Main2" }],
    "expect": { "players": [{}, { "life": 18, "poison": 0 }] }
  },
  {
    "name": "ruling: the tenth poison counter loses the game at once (8 + 2 = 10)",
    "players": [ { "battlefield": [{ "name": "Virulent Silencer", "sick": false }] }, { "poison": 8 } ],
    "steps": [ { "attack": [{ "card": "Virulent Silencer", "at": "p1" }] }, { "advance_to": "Main2" } ],
    "expect": { "winner": 0 }
  },
  {
    "name": "ruling: nine poison counters do not lose the game (7 + 2 = 9)",
    "players": [ { "battlefield": [{ "name": "Virulent Silencer", "sick": false }] }, { "poison": 7 } ],
    "steps": [ { "attack": [{ "card": "Virulent Silencer", "at": "p1" }] }, { "advance_to": "Main2" } ],
    "expect": { "winner": -1, "players": [ {}, { "poison": 9 } ] }
  }
]
