[
 { "name": "a tapped creature stays tapped through its controller's untap step",
   "players": [ { "battlefield": ["Intruder Alarm", { "name": "Grizzly Bears", "tapped": true, "sick": false }] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
   "expect": { "turn": 3, "tapped": { "Grizzly Bears": true } } },
 { "name": "without Intruder Alarm the tapped creature untaps in its controller's untap step",
   "players": [ { "battlefield": [{ "name": "Grizzly Bears", "tapped": true, "sick": false }] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
   "expect": { "turn": 3, "tapped": { "Grizzly Bears": false } } },
 { "name": "a creature entering untaps all creatures",
   "players": [ { "hand": ["Llanowar Elves"], "battlefield": ["Intruder Alarm", "Forest", { "name": "Grizzly Bears", "tapped": true, "sick": false }] }, {} ],
   "steps": [ { "cast": "Llanowar Elves" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": false } } },
 { "name": "a non-creature permanent entering does not untap creatures",
   "players": [ { "hand": ["Plains"], "battlefield": ["Intruder Alarm", { "name": "Grizzly Bears", "tapped": true, "sick": false }] }, {} ],
   "steps": [ { "play_land": "Plains" } ],
   "expect": { "tapped": { "Grizzly Bears": true } } },
 { "name": "ruling: two creatures entering at once each trigger the alarm (two untap triggers)",
   "players": [ { "hand": ["Battle Screech"], "battlefield": ["Intruder Alarm", "Plains", "Plains", "Plains", "Plains", { "name": "Grizzly Bears", "tapped": true, "sick": false }] }, {} ],
   "steps": [ { "cast": "Battle Screech" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true, "player": 1 } ],
   "expect": { "stack_empty": false, "tapped": { "Grizzly Bears": false } } }
]
