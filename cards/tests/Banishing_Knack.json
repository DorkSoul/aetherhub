[
  { "name": "target creature can tap to return an opponent's nonland permanent to hand",
    "players": [ { "hand": ["Banishing Knack"], "battlefield": ["Island", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Banishing Knack", "targets": ["Hill Giant"] }, { "resolve": true },
      { "activate": "Hill Giant", "ability": 32768, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "hand": ["Grizzly Bears"] } ] } },
  { "name": "the granted ability is a tap ability: a tapped creature can't use it again",
    "players": [ { "hand": ["Banishing Knack"], "battlefield": ["Island", "Hill Giant", "Forest"] }, { "battlefield": ["Grizzly Bears", "Serra Angel"] } ],
    "steps": [ { "cast": "Banishing Knack", "targets": ["Hill Giant"] }, { "resolve": true },
      { "activate": "Hill Giant", "ability": 32768, "targets": ["Grizzly Bears"] }, { "resolve": true },
      { "activate": "Hill Giant", "ability": 32768, "targets": ["Serra Angel"], "illegal": true } ],
    "expect": { "players": [ {}, { "hand": ["Grizzly Bears"], "battlefield_has": ["Serra Angel"] } ] } },
  { "name": "only the targeted creature gains the ability",
    "players": [ { "hand": ["Banishing Knack"], "battlefield": ["Island", "Hill Giant", "Grizzly Bears"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Banishing Knack", "targets": ["Hill Giant"] }, { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Serra Angel"], "illegal": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Serra Angel"] } ] } },
  { "name": "ruling: summoning sickness applies to the granted tap ability",
    "players": [ { "hand": ["Banishing Knack"], "battlefield": ["Island", { "name": "Hill Giant", "sick": true }] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Banishing Knack", "targets": ["Hill Giant"] }, { "resolve": true },
      { "activate": "Hill Giant", "ability": 32768, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
