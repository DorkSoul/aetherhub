[
  { "name": "ETB gives two energy counters",
    "players": [ { "hand": ["Thriving Turtle"], "battlefield": ["Island"] }, {} ],
    "steps": [ { "cast": "Thriving Turtle" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 2, "battlefield_has": ["Thriving Turtle"] }, {} ] } },
  { "name": "attack: paying two energy puts a +1/+1 counter on it",
    "players": [ { "battlefield": ["Thriving Turtle", "Bespoke Battlewagon"] }, {} ],
    "steps": [ { "activate": "Bespoke Battlewagon", "ability": 0 }, { "resolve": true },
               { "attack": [ { "card": "Thriving Turtle", "at": "p1" } ] },
               { "resolve": true, "answers": [true] },
               { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "energy": 0 }, { "life": 19 } ], "pt": { "Thriving Turtle": [ 1, 4 ] } } },
  { "name": "attack declining to pay: no counter",
    "players": [ { "battlefield": ["Thriving Turtle", "Bespoke Battlewagon"] }, {} ],
    "steps": [ { "activate": "Bespoke Battlewagon", "ability": 0 }, { "resolve": true },
               { "attack": [ { "card": "Thriving Turtle", "at": "p1" } ] },
               { "resolve": true, "answers": [false] },
               { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "energy": 2 }, { "life": 20 } ], "pt": { "Thriving Turtle": [ 0, 3 ] } } },
  { "name": "ruling: with no energy the attack trigger cannot be paid, so no counter is added and energy stays at 0",
    "players": [ { "battlefield": ["Thriving Turtle"] }, {} ],
    "steps": [ { "attack": [ { "card": "Thriving Turtle", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "energy": 0 }, { "life": 20 } ], "pt": { "Thriving Turtle": [ 0, 3 ] } } }
]
