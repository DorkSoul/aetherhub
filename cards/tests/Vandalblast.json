[
  {
    "name": "single target destroys one artifact you don't control",
    "players": [
      { "hand": ["Vandalblast"], "battlefield": ["Mountain"] },
      { "battlefield": ["Aether Vial", "Alchemist's Vial"] }
    ],
    "steps": [
      { "cast": "Vandalblast", "targets": ["Aether Vial"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Vandalblast"] },
        { "battlefield_has": ["Alchemist's Vial"], "graveyard": ["Aether Vial"] }
      ]
    }
  },
  {
    "name": "overload destroys each artifact you don't control, not your own",
    "players": [
      { "hand": ["Vandalblast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Aether Vial"] },
      { "battlefield": ["Alchemist's Vial", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Vandalblast", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Aether Vial"] },
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Alchemist's Vial"] }
      ]
    }
  },
  {
    "name": "ruling: single-target mode needs a legal target, so it cannot be cast with only your own artifact",
    "players": [
      { "hand": ["Vandalblast"], "battlefield": ["Mountain", "Aether Vial"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Vandalblast", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Vandalblast"], "battlefield_has": ["Aether Vial"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: overload has no target, so it can be cast when there is no artifact to aim at",
    "players": [
      { "hand": ["Vandalblast"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Vandalblast", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Vandalblast"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
