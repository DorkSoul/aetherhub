  },
  {
    "name": "deals 2 to an opponent",
    "players": [
      { "hand": ["Improvised Weaponry"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Improvised Weaponry", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
