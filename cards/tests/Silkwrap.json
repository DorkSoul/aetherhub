 {
  "name": "ruling: Silkwrap destroyed in response to its trigger, the creature is not exiled",
  "players": [
   { "hand": ["Silkwrap", "Disenchant"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Silkwrap" },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "cast": "Disenchant", "targets": ["Silkwrap"] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Silkwrap", "Disenchant"] },
    { "battlefield_has": ["Grizzly Bears"], "exile": [] }
   ]
  }
 },
 {
  "name": "ruling: the Aura on the exiled creature goes to its owner's graveyard",
  "players": [
   { "hand": ["Spider Climb", "Silkwrap"], "battlefield": ["Forest", "Plains", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Spider Climb", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Silkwrap" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Spider Climb"], "battlefield_has": ["Silkwrap"] },
    { "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"] }
   ]
  }
 }
