[
  {
    "name": "destroys all enchantments and gains 2 life for each",
    "players": [
      { "hand": ["Multani's Decree"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Glorious Anthem"] },
      { "battlefield": ["Parallel Lives", "Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Multani's Decree" }, { "resolve": true } ],
    "expect": { "players": [
      { "life": 24, "graveyard": ["Multani's Decree", "Glorious Anthem"] },
      { "life": 20, "graveyard": ["Parallel Lives"], "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "an indestructible enchantment survives and gives no life",
    "players": [
      { "hand": ["Multani's Decree"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Glorious Anthem"] },
      { "battlefield": [ { "name": "Parallel Lives", "counters": { "indestructible": 1 } } ] }
    ],
    "steps": [ { "cast": "Multani's Decree" }, { "resolve": true } ],
    "expect": { "players": [
      { "life": 22, "graveyard": ["Multani's Decree", "Glorious Anthem"] },
      { "life": 20, "battlefield_has": ["Parallel Lives"], "graveyard": [] } ] }
  },
  {
    "name": "no enchantments: no life gained",
    "players": [
      { "hand": ["Multani's Decree"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Multani's Decree" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] }
  }
]
