[
  {
    "name": "becoming blocked untaps it",
    "players": [
      { "battlefield": ["Silkenfist Order"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Silkenfist Order", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Silkenfist Order" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Silkenfist Order": false },
      "pt": { "Silkenfist Order": [3, 5] }
    }
  },
  {
    "name": "an unblocked attacker stays tapped",
    "players": [
      { "battlefield": ["Silkenfist Order"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Silkenfist Order", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Silkenfist Order": true }
    }
  }
]
