    "expect": {
      "players": [
        { "graveyard_has": ["Distract the Guards", "Lightning Bolt", "King's Assassin"], "battlefield_has": ["Human Rogue 1-1 White", "Human Rogue 1-1 White", "Human Rogue 1-1 White"] },
