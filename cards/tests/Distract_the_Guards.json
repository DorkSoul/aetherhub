      {}
    ],
    "steps": [
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "attack": [{ "card": "King's Assassin", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Distract the Guards", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Distract the Guards"], "battlefield_has": ["Human Rogue 1-1 White", "Human Rogue 1-1 White", "Human Rogue 1-1 White"] },
        {}
      ]
    }
  },
  {
    "name": "no combat damage this turn: freerunning cost is not available",
    "players": [
      { "hand": ["Distract the Guards"], "battlefield": ["King's Assassin", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "cast": "Distract the Guards", "alt": 0, "illegal": true }
