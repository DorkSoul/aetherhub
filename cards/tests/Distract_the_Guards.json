    "expect": {
      "players": [
        { "hand": ["Distract the Guards", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: freerunning stays available after the Assassin that dealt combat damage has died",
    "players": [
      { "hand": ["Distract the Guards", "Lightning Bolt"], "battlefield": ["King's Assassin", "Plains", "Plains", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" }, { "advance_to": "Main1" },
      { "attack": [{ "card": "King's Assassin", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["King's Assassin"] },
      { "resolve": true },
      { "cast": "Distract the Guards", "alt": 0 },
