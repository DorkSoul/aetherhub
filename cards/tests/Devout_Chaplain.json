[
 {
  "name": "tapping two other Humans exiles target artifact",
  "players": [
   { "battlefield": ["Devout Chaplain", "Human Soldier", "Human Soldier"] },
   { "battlefield": ["Pristine Talisman"] }
  ],
  "steps": [
   { "activate": "Devout Chaplain", "targets": ["Pristine Talisman"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "exile": ["Pristine Talisman"], "battlefield_lacks": ["Pristine Talisman"] }
   ],
   "tapped": { "Devout Chaplain": true }
  }
 },
 {
  "name": "needs two other untapped Humans",
  "players": [
   { "battlefield": ["Devout Chaplain", "Human Soldier"] },
   { "battlefield": ["Pristine Talisman"] }
  ],
  "steps": [
   { "activate": "Devout Chaplain", "illegal": true }
  ],
  "expect": {
   "players": [
    {},
    { "battlefield_has": ["Pristine Talisman"] }
   ]
  }
 },
 {
  "name": "ruling: summoning-sick Humans can be tapped to pay the cost",
  "players": [
   { "battlefield": ["Devout Chaplain", { "name": "Human Soldier", "sick": true }, { "name": "Human Soldier", "sick": true }] },
   { "battlefield": ["Pristine Talisman"] }
  ],
  "steps": [
   { "activate": "Devout Chaplain", "targets": ["Pristine Talisman"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    {},
    { "exile": ["Pristine Talisman"], "battlefield_lacks": ["Pristine Talisman"] }
   ],
   "tapped": { "Devout Chaplain": true }
  }
 },
 {
  "name": "ruling: the Chaplain itself must have been under your control since your turn began",
  "players": [
   { "battlefield": [ { "name": "Devout Chaplain", "sick": true }, "Human Soldier", "Human Soldier" ] },
   { "battlefield": ["Pristine Talisman"] }
  ],
  "steps": [
   { "activate": "Devout Chaplain", "illegal": true }
  ],
  "expect": {
   "players": [
    {},
    { "battlefield_has": ["Pristine Talisman"] }
   ]
  }
 }
]
