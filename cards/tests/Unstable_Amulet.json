[
 {"name": "enters: you get two energy",
  "players": [{"hand": ["Unstable Amulet"], "battlefield": ["Mountain", "Mountain"]}, {}],
  "steps": [{"cast": "Unstable Amulet"}, {"resolve": true}],
  "expect": {"players": [{"energy": 2, "battlefield_has": ["Unstable Amulet"]}, {}]}},
 {"name": "exile the top card, cast it from exile: Bolt hits and the Amulet pings",
  "players": [{"energy": 2, "battlefield": ["Unstable Amulet", "Mountain"], "library": ["Lightning Bolt", "Forest"]}, {}],
  "steps": [{"activate": "Unstable Amulet"}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{"energy": 0, "graveyard": ["Lightning Bolt"]}, {"life": 16}]}},
 {"name": "a spell cast from hand does not trigger the Amulet",
  "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Unstable Amulet", "Mountain"]}, {}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{}, {"life": 17}]}},
 {"name": "needs two energy",
  "players": [{"energy": 1, "battlefield": ["Unstable Amulet"], "library": ["Lightning Bolt"]}, {}],
  "steps": [{"activate": "Unstable Amulet", "illegal": true}],
  "expect": {"players": [{"energy": 1}, {}]}},
 {"name": "exiling another card ends the permission for the first one",
  "players": [{"energy": 4, "battlefield": ["Unstable Amulet", "Mountain"], "library": ["Lightning Bolt", "Forest", "Shock", "Forest"]}, {}],
  "steps": [{"activate": "Unstable Amulet"}, {"resolve": true}, {"advance_to": "Main1"}, {"advance_to": "Main1"}, {"activate": "Unstable Amulet"}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"], "illegal": true}, {"cast": "Shock", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{"energy": 0, "exile": ["Lightning Bolt"], "graveyard": ["Shock"]}, {"life": 17}]}},
 {"name": "ruling: an exiled land can be played in your main phase with an empty stack",
  "players": [{"energy": 2, "battlefield": ["Unstable Amulet"], "library": ["Forest", "Lightning Bolt"]}, {}],
  "steps": [{"activate": "Unstable Amulet"}, {"resolve": true}, {"play_land": "Forest"}],
  "expect": {"players": [{"energy": 0, "battlefield_has": ["Forest"], "exile": []}, {}]}},
 {"name": "ruling: an exiled land cannot be played on the opponent's turn",
  "players": [{"energy": 2, "battlefield": ["Unstable Amulet"], "library": ["Forest", "Lightning Bolt"]}, {}],
  "steps": [{"activate": "Unstable Amulet"}, {"resolve": true}, {"advance_to": "Main2"}, {"advance_to": "Main1"}, {"pass": true, "player": 1}, {"play_land": "Forest", "illegal": true}],
  "expect": {"players": [{"energy": 0, "exile": ["Forest"], "battlefield_lacks": ["Forest"]}, {}]}},
 {"name": "ruling: the exiled card stays playable after Unstable Amulet leaves the battlefield",
  "players": [{"energy": 2, "hand": ["Ancient Grudge"], "battlefield": ["Unstable Amulet", "Forest", "Mountain", "Mountain"], "library": ["Lightning Bolt", "Forest"]}, {}],
  "steps": [{"activate": "Unstable Amulet"}, {"resolve": true}, {"cast": "Ancient Grudge", "targets": ["Unstable Amulet"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{"graveyard": ["Ancient Grudge", "Unstable Amulet", "Lightning Bolt"], "exile": [], "battlefield_lacks": ["Unstable Amulet"]}, {"life": 17}]}}
]
