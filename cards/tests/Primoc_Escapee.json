[
  {
    "name": "cycling {2} discards it and draws a card",
    "players": [
      {
        "hand": [
          "Primoc Escapee"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Primoc Escapee",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "graveyard": [
            "Primoc Escapee"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "cycling needs two mana",
    "players": [
      {
        "hand": [
          "Primoc Escapee"
        ],
        "battlefield": [
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Primoc Escapee",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Stifle counters the cycling ability, so no card is drawn",
    "players": [
      { "hand": ["Primoc Escapee"], "battlefield": ["Island", "Island"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Primoc Escapee", "ability": 0 },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Primoc Escapee" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Primoc Escapee"] },
        { "graveyard": ["Stifle"] }
      ]
    }
  },
  {
    "name": "ruling: Remove Soul cannot counter cycling (cycling is not a spell)",
    "players": [
      { "hand": ["Primoc Escapee"], "battlefield": ["Island", "Island"] },
      { "hand": ["Remove Soul"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "activate": "Primoc Escapee", "ability": 0 },
      { "pass": true },
      { "cast": "Remove Soul", "player": 1, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Primoc Escapee"] },
        {}
      ]
    }
  }
]
