[
  {
    "name": "opponent searches their library: you gain 1 life and draw a card",
    "players": [
      {"battlefield": ["Archivist of Oghma"], "library": ["Island", "Forest"]},
      {"hand": ["Enlightened Tutor"], "battlefield": ["Plains"], "library": ["Sol Ring"]}
    ],
    "steps": [
      {"pass": true},
      {"cast": "Enlightened Tutor", "player": 1},
      {"resolve": true, "answers": ["Sol Ring"]},
      {"resolve": true}
    ],
    "expect": {"players": [{"life": 21, "hand": ["Island"]}, {"hand": []}]}
  },
  {
    "name": "your own library search does not trigger it",
    "players": [
      {"hand": ["Enlightened Tutor"], "battlefield": ["Archivist of Oghma", "Plains"], "library": ["Sol Ring", "Island"]},
      {}
    ],
    "steps": [
      {"cast": "Enlightened Tutor"},
      {"resolve": true, "answers": ["Sol Ring"]}
    ],
    "expect": {"players": [{"life": 20, "hand": []}, {}]}
  },
  {
    "name": "ruling: you searching an opponent's library (Bribery) does not trigger it",
    "players": [
      {"hand": ["Bribery"], "battlefield": ["Archivist of Oghma", "Island", "Island", "Island", "Island", "Island"]},
      {"library": ["Serra Angel", "Mountain"]}
    ],
    "steps": [
      {"cast": "Bribery", "targets": ["p1"]},
      {"resolve": true, "answers": ["Serra Angel"]}
    ],
    "expect": {"players": [{"life": 20, "hand": []}, {}]}
  }
]
