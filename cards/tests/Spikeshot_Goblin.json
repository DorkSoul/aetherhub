[
 {
  "name": "deals damage equal to its power to a creature",
  "players": [
   { "battlefield": ["Spikeshot Goblin", "Mountain"] },
   { "battlefield": ["Llanowar Elves"] }
  ],
  "steps": [
   { "activate": "Spikeshot Goblin", "targets": ["Llanowar Elves"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Spikeshot Goblin"], "life": 20 },
    { "graveyard": ["Llanowar Elves"] }
   ]
  }
 },
 {
  "name": "can target a player",
  "players": [
   { "battlefield": ["Spikeshot Goblin", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Spikeshot Goblin", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "life": 20 },
    { "life": 19 }
   ]
  }
 },
 {
  "name": "summoning sick Goblin cannot tap",
  "players": [
   { "battlefield": [{ "name": "Spikeshot Goblin", "sick": true }, "Mountain"] },
   { "battlefield": ["Llanowar Elves"] }
  ],
  "steps": [
   { "activate": "Spikeshot Goblin", "targets": ["Llanowar Elves"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Spikeshot Goblin"] },
    { "battlefield_has": ["Llanowar Elves"] }
   ]
  }
 },
 {
  "name": "ruling: damage uses the Goblin's power as it last existed when it left the battlefield",
  "players": [
   { "battlefield": ["Spikeshot Goblin", "Mountain"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "activate": "Spikeshot Goblin", "targets": ["p1"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Spikeshot Goblin"] },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Spikeshot Goblin"] },
    { "life": 19, "graveyard": ["Lightning Bolt"] }
   ]
  }
 }
]
