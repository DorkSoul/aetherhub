[
 { "name": "exiles the target and every other nonland permanent of that player with the same name",
   "players": [ { "hand": ["Deputy of Detention"], "battlefield": ["Plains", "Island", "Island"] }, { "battlefield": ["Grizzly Bears", "Grizzly Bears", "Hill Giant", "Forest"] } ],
   "steps": [ { "cast": "Deputy of Detention" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Deputy of Detention"] }, { "exile": ["Grizzly Bears", "Grizzly Bears"], "battlefield": ["Hill Giant", "Forest"] } ] }
 },
 { "name": "same-named permanents controlled by the Deputy's controller are not exiled",
   "players": [ { "hand": ["Deputy of Detention"], "battlefield": ["Plains", "Island", "Island", "Grizzly Bears"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
   "steps": [ { "cast": "Deputy of Detention" }, { "resolve": true, "targets": ["p1:Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Deputy of Detention"] }, { "exile": ["Grizzly Bears"], "battlefield": ["Hill Giant"] } ] }
 },
 {
  "name": "ruling: Deputy leaves before its trigger resolves, so nothing is exiled",
  "players": [ { "hand": ["Deputy of Detention", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Deputy of Detention" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Deputy of Detention"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Deputy of Detention", "Lightning Bolt"] }, { "battlefield_has": ["Grizzly Bears"], "exile": [] } ] }
 },
 {
  "name": "ruling: the targeted permanent is gone when the trigger resolves, so nothing is exiled",
  "players": [ { "hand": ["Deputy of Detention", "Lightning Bolt"], "battlefield": ["Plains", "Island", "Island", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Deputy of Detention" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Deputy of Detention"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"], "exile": [] } ] }
 },
 {
  "name": "ruling: the Aura on the exiled creature goes to its owner's graveyard and draws a card",
  "players": [ { "hand": ["Reach for the Sky", "Deputy of Detention"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Plains", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Reach for the Sky", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "cast": "Deputy of Detention" }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "hand_count": 1, "graveyard": ["Reach for the Sky"] }, { "exile": ["Grizzly Bears"] } ] }
 }
]
