[
  {
    "name": "enchanted creature is tapped and the Aura can shuffle it away",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          "Island",
          "Island",
          "Island"
        ],
        "hand": [
          "Dramatic Accusation"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Dramatic Accusation",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "activate": "Dramatic Accusation"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Dramatic Accusation"
          ]
        },
        {
          "battlefield": []
        }
      ]
    }
  },
  {
    "name": "the Aura cannot shuffle without UU",
    "players": [
      {
        "battlefield": [
          "Island",
          "Island",
          "Island"
        ],
        "hand": [
          "Dramatic Accusation"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Dramatic Accusation",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "activate": "Dramatic Accusation",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Dramatic Accusation",
            "Island",
            "Island",
            "Island"
          ]
        },
        {
          "battlefield": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "enchanted creature does not untap during its controller's untap step",
    "players": [
      { "hand": ["Dramatic Accusation"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dramatic Accusation", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [{}, {}],
      "tapped": {"Grizzly Bears": true}
    }
  },
  {
    "name": "ruling: only the Aura's controller can activate its shuffle ability",
    "players": [
      { "battlefield": ["Island", "Island", "Island", "Island", "Island"], "hand": ["Dramatic Accusation"] },
      { "battlefield": ["Grizzly Bears", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Dramatic Accusation", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true },
      { "pass": true },
      { "player": 1, "activate": "Dramatic Accusation", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dramatic Accusation"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ],
      "tapped": { "Grizzly Bears": true }
    }
  }
]
