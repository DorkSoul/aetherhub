[
  {
    "name": "untapped Watchdog gives attacking creatures -1/-0 and must block",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Watchdog"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Watchdog", "attacker": "Grizzly Bears" } ] }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [1, 2] }
    }
  },
  {
    "name": "must block: not blocking with Watchdog is not allowed",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Watchdog"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [], "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "must block: with no block declared, Watchdog is forced to block the attacking Bears (no damage)",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Watchdog"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
 {
  "name": "ruling: a tapped Watchdog gives no -1/-0 (the static checks its tapped status)",
  "players": [
    { "battlefield": ["Grizzly Bears"] },
    { "battlefield": [ { "name": "Watchdog", "tapped": true } ] }
  ],
  "steps": [
    { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
    { "block": [] },
    { "advance_to": "Main2" }
