[
  {
    "name": "mode 2 only: 2 damage kills a 2/2",
    "players": [
      { "hand": ["Winterflame"], "battlefield": ["Island", "Mountain", "Plains", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Winterflame", "answers": [1], "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "both modes: tap one creature and damage another",
    "players": [
      { "hand": ["Winterflame"], "battlefield": ["Island", "Mountain", "Plains"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Winterflame", "answers": [[0, 1]], "targets": ["p1:Hill Giant", "p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Grizzly Bears"] } ],
      "tapped": { "Hill Giant": true }
    }
  },
  {
    "name": "ruling: one target illegal on resolution (Grizzly killed in response): the tap mode still happens",
    "players": [
      { "hand": ["Winterflame", "Pharika's Cure"], "battlefield": ["Island", "Mountain", "Plains", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Winterflame", "answers": [[0, 1]], "targets": ["p1:Hill Giant", "p1:Grizzly Bears"] },
      { "cast": "Pharika's Cure", "targets": ["p1:Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 22, "graveyard_has": ["Pharika's Cure"] }, { "graveyard_has": ["Grizzly Bears"] } ],
      "tapped": { "Hill Giant": true }
    }
  },
  {
    "name": "ruling: both modes may target the same creature",
    "players": [
      { "hand": ["Winterflame"], "battlefield": ["Island", "Mountain", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Winterflame", "answers": [[0, 1]], "targets": ["p1:Grizzly Bears", "p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
