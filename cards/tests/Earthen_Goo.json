[
  {
    "name": "gets +1/+1 for each age counter",
    "players": [
      { "battlefield": [ { "name": "Earthen Goo", "counters": { "age": 2 } } ] },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": { "Earthen Goo": [4, 4] }
    }
  },
  {
    "name": "upkeep: pays {R} or {G} for one age counter, becomes 3/3",
    "players": [
      { "battlefield": ["Earthen Goo", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Earthen Goo": { "age": 1 } },
      "pt": { "Earthen Goo": [3, 3] },
      "players": [ { "battlefield_has": ["Earthen Goo"] }, {} ]
    }
  },
  {
    "name": "upkeep: pays with a Forest instead",
    "players": [
      { "battlefield": ["Earthen Goo", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Earthen Goo": { "age": 1 } },
      "players": [ { "battlefield_has": ["Earthen Goo"] }, {} ]
    }
  },
  {
    "name": "ruling: the third age counter is added first, then paid for with three lands (5/5)",
    "players": [
      { "battlefield": [ { "name": "Earthen Goo", "counters": { "age": 2 } }, "Mountain", "Forest", "Mountain" ] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Earthen Goo": { "age": 3 } },
      "pt": { "Earthen Goo": [5, 5] },
      "players": [ { "battlefield_has": ["Earthen Goo"] }, {} ]
    }
  },
  {
    "name": "ruling: no partial payment, with only two lands the Goo is sacrificed",
    "players": [
      { "battlefield": [ { "name": "Earthen Goo", "counters": { "age": 2 } }, "Mountain", "Forest" ] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Earthen Goo"] }, {} ]
    }
  },
  {
    "name": "ruling: declining the cumulative upkeep payment sacrifices the Goo",
    "players": [
      { "battlefield": [ { "name": "Earthen Goo", "counters": { "age": 2 } }, "Mountain", "Forest", "Mountain" ] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": {
      "players": [ { "graveyard": ["Earthen Goo"] }, {} ]
    }
  }
]
