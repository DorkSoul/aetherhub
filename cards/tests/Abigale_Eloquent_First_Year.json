[
  { "name": "ETB gives the other target creature flying, first strike and lifelink counters",
    "players": [ { "hand": ["Abigale, Eloquent First-Year"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Abigale, Eloquent First-Year" }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
    "expect": {
      "counters": { "Grizzly Bears": { "flying": 1, "firststrike": 1, "lifelink": 1 } },
      "keywords": { "Grizzly Bears": ["Flying", "FirstStrike", "Lifelink"], "Abigale, Eloquent First-Year": ["Flying", "FirstStrike", "Lifelink"] }
    }
  },
  { "name": "with no other creature to target nothing happens",
    "players": [ { "hand": ["Abigale, Eloquent First-Year"], "battlefield": ["Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Abigale, Eloquent First-Year" }, { "resolve": true } ],
    "expect": {
      "counters": {},
      "keywords": { "Abigale, Eloquent First-Year": ["Flying", "FirstStrike", "Lifelink"] }
    }
  },
  { "name": "ruling: an ability gained after the loss is kept",
    "players": [ { "hand": ["Abigale, Eloquent First-Year", "Rancor"], "battlefield": ["Plains", "Plains", "Forest", "Serra Angel"] }, {} ],
    "steps": [ { "cast": "Abigale, Eloquent First-Year" }, { "resolve": true, "targets": ["Serra Angel"] }, { "cast": "Rancor", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "keywords": { "Serra Angel": ["Trample"] } }
  },
  { "name": "ruling: the lost abilities stay lost after Abigale leaves the battlefield",
    "players": [ { "hand": ["Abigale, Eloquent First-Year"], "battlefield": ["Plains", "Plains", "Serra Angel"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Abigale, Eloquent First-Year" }, { "resolve": true, "targets": ["Serra Angel"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Abigale, Eloquent First-Year"] }, { "resolve": true }, { "advance_to": "BeginCombat" }, { "attack": [ { "card": "Serra Angel", "at": "p1" } ] } ],
    "expect": { "players": [ {}, {} ], "counters": { "Serra Angel": { "flying": 1 } }, "tapped": { "Serra Angel": true } }
  }
]
