[
  {
    "name": "unblocked: all 5 combat damage goes to the defending player",
    "players": [
      { "battlefield": [{ "name": "Rhox", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Rhox", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 15 } ] }
  },
  {
    "name": "blocked by Grizzly Bears: the damage still goes to the defending player",
    "players": [
      { "battlefield": [{ "name": "Rhox", "sick": false }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rhox", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Rhox" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 15, "battlefield": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "regenerate: the shield saves Rhox from Murder",
    "players": [
      { "battlefield": ["Rhox", "Forest", "Forest", "Forest"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "activate": "Rhox", "ability": 0 },
      { "resolve": true },
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Rhox"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Rhox"] }, {} ]
    }
  },
  {
    "name": "ruling: damage goes all to the player or all to the blockers, not split (two blockers, all to the player)",
    "players": [
      { "battlefield": [{ "name": "Rhox", "sick": false }] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Rhox", "at": "p1" }] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Rhox" }, { "blocker": "Hill Giant", "attacker": "Rhox" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 15, "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ]
    }
  }
]
