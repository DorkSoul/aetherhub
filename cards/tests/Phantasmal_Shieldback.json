[
  {
    "name": "sacrificed when targeted, then its death draws a card",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Phantasmal Shieldback"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Phantasmal Shieldback"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt"] },
        { "graveyard_has": ["Phantasmal Shieldback"], "hand_count": 1 }
      ]
    }
  },
  {
    "name": "untargeted, it stays on the battlefield",
    "players": [ { "battlefield": ["Phantasmal Shieldback"] }, {} ],
    "steps": [],
    "expect": { "players": [ { "battlefield_has": ["Phantasmal Shieldback"] }, {} ] }
  },
  {
    "name": "ruling: Brightmare's ETB whose only target was sacrificed is removed: no tap, no life gain",
    "players": [ { "hand": ["Brightmare"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Phantasmal Shieldback"] } ],
    "steps": [ { "cast": "Brightmare" }, { "resolve": true, "targets": ["Phantasmal Shieldback"] }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20, "battlefield_has": ["Brightmare"] }, { "graveyard_has": ["Phantasmal Shieldback"], "hand_count": 1 } ] }
  }
]
