[
  {
    "name": "active player who cast no spell takes 2 at their end step",
    "players": [ { "battlefield": ["Impatience", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 18 }, { "life": 20 } ] }
  },
  {
    "name": "a player who cast a spell this turn takes no damage",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Impatience", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] }
  },
  {
    "name": "ruling: a countered spell still counts as cast, so its caster takes no end-step damage",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Impatience", "Forest", "Forest"] }, { "hand": ["Essence Scatter"], "battlefield": ["Island", "Island"] } ],
    "steps": [
     { "cast": "Grizzly Bears" },
     { "pass": true },
     { "cast": "Essence Scatter", "player": 1, "targets": [ { "stack": "Grizzly Bears" } ] },
     { "resolve": true },
     { "advance_to": "End" }
    ],
    "expect": { "players": [ { "life": 20, "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Essence Scatter"] } ] }
  }
]
