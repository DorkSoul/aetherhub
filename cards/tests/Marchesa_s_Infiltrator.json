[
  {
    "name": "unblocked combat damage to a player: draw a card",
    "players": [
      { "battlefield": [{"name": "Marchesa's Infiltrator", "sick": false}] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Marchesa's Infiltrator", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 1 }, { "life": 18 } ], "pt": { "Marchesa's Infiltrator": [2, 2] } }
  },
  {
    "name": "blocked creature deals no combat damage to a player: no draw",
    "players": [
      { "battlefield": [{"name": "Marchesa's Infiltrator", "sick": false}] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Marchesa's Infiltrator", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Marchesa's Infiltrator" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 0 }, { "life": 20 } ] }
  },
  {
    "name": "ruling: dethrone counter still added after the defender no longer has the most life",
    "players": [
      { "battlefield": [{"name": "Marchesa's Infiltrator", "sick": false}] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "attack": [ { "card": "Marchesa's Infiltrator", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 1 }, { "life": 15 } ], "pt": { "Marchesa's Infiltrator": [2, 2] } }
  }
]
