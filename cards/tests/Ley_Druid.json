[
  {
    "name": "untaps a tapped land",
    "players": [
      {
        "battlefield": [
          "Ley Druid",
          {
            "name": "Forest",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Ley Druid",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Forest": false,
        "Ley Druid": true
      }
    }
  },
  {
    "name": "untap a land after using it: two Bolts off one Mountain",
    "players": [
      {
        "hand": [
          "Lightning Bolt",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Ley Druid",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "activate": "Ley Druid",
        "targets": [
          "Mountain"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt",
            "Lightning Bolt"
          ]
        },
        {
          "life": 14
        }
      ]
    }
  },
  {
    "name": "can target an opponent's land",
    "players": [
      {
        "battlefield": [
          "Ley Druid"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Island",
            "tapped": true
          }
        ]
      }
    ],
    "steps": [
      {
        "activate": "Ley Druid",
        "targets": [
          "Island"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Island": false
      }
    }
  },
  {
    "name": "ruling: the untap is an ability on the stack: it still resolves after Ley Druid dies in response",
    "players": [
      {
        "battlefield": [
          "Ley Druid",
          {
            "name": "Forest",
            "tapped": true
          }
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Ley Druid",
        "targets": [
          "Forest"
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "Ley Druid"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Forest": false
      },
      "players": [
        {
          "graveyard_has": [
            "Ley Druid"
          ]
        },
        {
          "life": 20,
          "graveyard_has": [
            "Lightning Bolt"
          ]
        }
      ]
    }
  }
]