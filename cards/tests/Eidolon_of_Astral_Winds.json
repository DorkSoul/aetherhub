[
  {
    "name": "enters: chosen creature becomes 4/4 flyer until end of turn",
    "players": [ { "hand": ["Eidolon of Astral Winds"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Eidolon of Astral Winds" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4], "Eidolon of Astral Winds": [2, 4] }, "keywords": { "Grizzly Bears": ["Flying"] } }
  },
  {
    "name": "another enchantment entering triggers it",
    "players": [ { "hand": ["Elderfang Venom"], "battlefield": ["Eidolon of Astral Winds", "Grizzly Bears", "Swamp", "Swamp", "Swamp", "Forest"] }, {} ],
    "steps": [ { "cast": "Elderfang Venom" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 4] } }
  },
  {
    "name": "ruling: +1/+1 counters still apply on top of the base 4/4",
    "players": [ { "hand": ["Eidolon of Astral Winds"], "battlefield": ["Plains", "Plains", "Plains", { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "cast": "Eidolon of Astral Winds" }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [5, 5] }, "counters": { "Grizzly Bears": { "p1p1": 1 } } }
  }
]
