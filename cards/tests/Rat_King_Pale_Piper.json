[
 {"name": "when Rat King leaves the battlefield a Rat token is created",
  "players": [
   {"battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", {"name": "Rat King, Pale Piper", "sick": false}]},
   {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}
  ],
  "steps": [
   {"pass": true},
   {"player": 1, "cast": "Lightning Bolt", "targets": ["Rat King, Pale Piper"]},
   {"resolve": true},
   {"resolve": true}
  ],
  "expect": {"players": [{"graveyard_has": ["Rat King, Pale Piper"], "battlefield_has": ["Rat 1-1"]}, {}]}
 },
 {"name": "sacrifice a token and pay 2 to draw a card",
  "players": [
   {"battlefield": ["Swamp", "Swamp", {"name": "Rat King, Pale Piper", "sick": false}, {"name": "Rat 1-1", "sick": false}]},
   {}
  ],
  "steps": [
   {"activate": "Rat King, Pale Piper"},
   {"resolve": true}
  ],
  "expect": {"players": [{"hand_count": 1, "battlefield_lacks": ["Rat 1-1"]}, {}]}
 },
 {"name": "another nontoken creature you control dying makes a Rat token",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Rat King, Pale Piper", "Grizzly Bears", "Mountain"] }, {} ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Rat King, Pale Piper", "Rat 1-1"] }, {} ] } },
 {"name": "an opponent's creature dying does not make a Rat token for you",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Rat King, Pale Piper", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_lacks": ["Rat 1-1"] }, { "graveyard": ["Grizzly Bears"] } ] } }
]
