[
 { "name": "opponent targets it: may draw two cards",
   "players": [ { "battlefield": ["Warden of the Woods"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Warden of the Woods"] },
              { "resolve": true, "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2, "battlefield": ["Warden of the Woods"] }, { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "your own spell targeting it does not trigger",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Warden of the Woods"] }, {} ],
   "steps": [ { "cast": "Giant Growth", "targets": ["Warden of the Woods"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0 }, {} ], "pt": { "Warden of the Woods": [8, 10] } } },
 { "name": "ruling: a countered Bolt still lets the Warden's trigger draw",
   "players": [ { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Warden of the Woods"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Warden of the Woods"] },
              { "cast": "Counterspell", "targets": [{ "stack": "Lightning Bolt" }] },
              { "pass": true, "player": 1 }, { "pass": true }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ { "hand_count": 2, "battlefield_has": ["Warden of the Woods"], "graveyard": ["Counterspell"] }, { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "ruling: a spell cast after the trigger resolves, before the Bolt, is legal",
   "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Warden of the Woods"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Warden of the Woods"] },
              { "resolve": true, "answers": [true] },
              { "cast": "Giant Growth", "targets": ["Warden of the Woods"] },
              { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 2, "graveyard": ["Giant Growth"] }, { "graveyard": ["Lightning Bolt"] } ], "pt": { "Warden of the Woods": [8, 10] } } }
]
