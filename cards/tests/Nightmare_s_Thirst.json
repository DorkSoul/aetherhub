[
  {
    "name": "gains 1 life, then gives the target -X/-X where X is life gained this turn",
    "players": [
      { "hand": ["Nightmare's Thirst"], "battlefield": ["Swamp", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Nightmare's Thirst", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [1, 1] },
      "players": [{ "life": 21 }, {}]
    }
  },
  {
    "name": "X counts all life gained this turn, including earlier casts",
    "players": [
      { "hand": ["Nightmare's Thirst", "Nightmare's Thirst"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Nightmare's Thirst", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Nightmare's Thirst", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 22, "graveyard_has": ["Grizzly Bears"] }, {}]
    }
  },
  {
    "name": "ruling: X counts life gained this turn, not the net change (after Bolt to own face)",
    "players": [
      { "hand": ["Nightmare's Thirst", "Lightning Bolt"], "battlefield": ["Swamp", "Mountain"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p0"] },
      { "resolve": true },
      { "cast": "Nightmare's Thirst", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 18 }, {}],
      "pt": { "Serra Angel": [3, 3] }
    }
  },
  {
    "name": "ruling: if the target is gone when it resolves, no life is gained",
    "players": [
      { "hand": ["Nightmare's Thirst", "Unsummon"], "battlefield": ["Swamp", "Island"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Nightmare's Thirst", "targets": ["Serra Angel"] },
      { "cast": "Unsummon", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 20 }, { "hand": ["Serra Angel"] }]
    }
  }
]
