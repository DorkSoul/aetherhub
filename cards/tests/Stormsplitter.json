[
  {
    "name": "casting an instant makes a token copy that is exiled at the end step",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Stormsplitter",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Stormsplitter",
            "Stormsplitter"
          ]
        },
        {
          "graveyard": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "casting a creature makes no copy",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Stormsplitter",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Forest",
            "Forest",
            "Grizzly Bears",
            "Stormsplitter"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the copy still enters when Stormsplitter leaves before its trigger resolves",
    "players": [
      { "hand": ["Lightning Bolt", "Swords to Plowshares"], "battlefield": ["Stormsplitter", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Swords to Plowshares", "targets": ["Stormsplitter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 21, "exile": ["Stormsplitter"], "battlefield": ["Mountain", "Plains", "Stormsplitter", "Stormsplitter"] },
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: the copy does not copy whether Stormsplitter is tapped",
    "players": [
      { "hand": ["Lightning Bolt", "Swords to Plowshares"], "battlefield": [ { "name": "Stormsplitter", "tapped": true }, "Mountain", "Plains" ] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Swords to Plowshares", "targets": ["Stormsplitter"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Stormsplitter"], "battlefield_has": ["Stormsplitter", "Stormsplitter"] }, {} ],
      "tapped": { "Stormsplitter": false }
    }
  },
  {
    "name": "ruling: a token copy has the trigger too and makes copies of itself",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Stormsplitter", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Mountain", "Stormsplitter", "Stormsplitter", "Stormsplitter", "Stormsplitter"] },
        { "life": 14 }
      ]
    }
  }
]
