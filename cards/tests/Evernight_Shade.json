[
  {
    "name": "its black ability gives +1/+1 until end of turn",
    "players": [ { "battlefield": ["Swamp", "Evernight Shade"] }, {} ],
    "steps": [ { "activate": "Evernight Shade", "ability": 0 }, { "resolve": true } ],
    "expect": {
      "pt": { "Evernight Shade": [2, 2] },
      "counters": { "Evernight Shade": {} }
    }
  },
  {
    "name": "undying returns it with a +1/+1 counter when it dies without one",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Evernight Shade"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Evernight Shade"] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Evernight Shade"] } ],
      "counters": { "Evernight Shade": { "p1p1": 1 } },
      "pt": { "Evernight Shade": [2, 2] }
    }
  },
  {
    "name": "undying does not return it when it already has a +1/+1 counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": [ { "name": "Evernight Shade", "counters": { "p1p1": 1 } } ] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Evernight Shade"] }, { "resolve": true } ],
    "expect": {
      "players": [ {}, { "graveyard_has": ["Evernight Shade"], "battlefield_lacks": ["Evernight Shade"] } ]
    }
  },
  {
    "name": "ruling: a pump from its black ability is not a counter, so undying still returns it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Swamp", "Mountain", "Evernight Shade"] }, {} ],
    "steps": [ { "activate": "Evernight Shade", "ability": 0 }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Evernight Shade"] }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Evernight Shade"] }, {} ],
      "counters": { "Evernight Shade": { "p1p1": 1 } },
      "pt": { "Evernight Shade": [2, 2] }
    }
  }
]
