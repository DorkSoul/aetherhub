[
  {
    "name": "back face: may cast a creature at instant speed on the opponent's upkeep",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Heliod, the Warped Eclipse", "Forest", "Forest"] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "back face: spells cost {1} less for each card the opponent drew this turn",
    "players": [ { "hand": ["Terror"], "battlefield": ["Heliod, the Warped Eclipse", "Swamp"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Terror", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Terror"] }, { "graveyard": ["Hill Giant"] } ] }
  },
  {
    "name": "enters: returns an enchantment that isn't a God from your graveyard to hand",
    "players": [
      { "hand": ["Heliod, the Radiant Dawn"], "battlefield": ["Plains", "Plains", "Plains", "Plains"], "graveyard": ["Pacifism"] },
      {}
    ],
    "steps": [
      { "cast": "Heliod, the Radiant Dawn" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand": ["Pacifism"], "battlefield_has": ["Heliod, the Radiant Dawn"] }, {} ] }
  },
  {
    "name": "sorcery-speed {3}{U/P}: transforms into Heliod, the Warped Eclipse",
    "players": [
      { "battlefield": ["Heliod, the Radiant Dawn", "Island", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Heliod, the Radiant Dawn" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Heliod, the Warped Eclipse"] }, {} ], "pt": { "Heliod, the Warped Eclipse": [4, 6] } }
  }
]
