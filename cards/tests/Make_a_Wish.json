[
  { "name": "returns two of the graveyard cards to hand (random pair)",
    "players": [ { "hand": ["Make a Wish"], "graveyard": ["Grizzly Bears", "Forest", "Sol Ring"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Make a Wish" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2, "graveyard_has": ["Make a Wish"] }, {} ] } },
  { "name": "a single card in graveyard: only that card returns",
    "players": [ { "hand": ["Make a Wish"], "graveyard": ["Sol Ring"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Make a Wish" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "graveyard_has": ["Make a Wish"] }, {} ] } },
  { "name": "ruling: Make a Wish is not in the graveyard while it resolves, so it cannot return itself",
    "players": [ { "hand": ["Make a Wish"], "graveyard": ["Grizzly Bears", "Sol Ring"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Make a Wish" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears", "Sol Ring"], "hand_count": 2, "graveyard": ["Make a Wish"] }, {} ] } }
]
