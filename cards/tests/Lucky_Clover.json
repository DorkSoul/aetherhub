[
  {
    "name": "casting an Adventure instant copies it: the copy deals damage again",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Lucky Clover", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "casting a non-Adventure instant does not copy",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Lucky Clover", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "casting the Adventure as a creature (not an instant or sorcery) does not copy",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Lucky Clover", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: a copy of an Adventure spell ceases to exist (only the real card is exiled)",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Lucky Clover", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": [], "exile": ["Bonecrusher Giant // Stomp"] }, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: the copy may choose new targets; here it is retargeted to a creature",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Lucky Clover", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ {}, { "life": 18, "battlefield_lacks": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: a copy is not cast, so a second Lucky Clover does not trigger on the copy",
    "players": [
      { "hand": ["Bonecrusher Giant // Stomp"], "battlefield": ["Lucky Clover", "Lucky Clover", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Bonecrusher Giant // Stomp", "face": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "life": 14 } ]
    }
  }
]
