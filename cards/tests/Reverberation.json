[
 { "name": "sorcery damage is dealt to its controller instead",
   "players": [ { "hand": ["Lava Axe"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                { "hand": ["Reverberation"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
   "steps": [
              { "cast": "Lava Axe", "targets": ["p1"] },
              { "pass": true },
              { "cast": "Reverberation", "player": 1, "targets": [{ "stack": "Lava Axe" }] },
              { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "life": 15 }, { "life": 20 } ], "stack_empty": true } },
 { "name": "without Reverberation the sorcery hits its target",
   "players": [ { "hand": ["Lava Axe"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                { "battlefield": ["Island"] } ],
   "steps": [
              { "cast": "Lava Axe", "targets": ["p1"] },
              { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "life": 20 }, { "life": 15 } ] } },
 { "name": "ruling: sorcery damage to several creatures is dealt to its controller as one total",
   "players": [ { "hand": ["Pyroclasm"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
                { "hand": ["Reverberation"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] } ],
   "steps": [
              { "cast": "Pyroclasm" },
              { "pass": true },
              { "cast": "Reverberation", "player": 1, "targets": [{ "stack": "Pyroclasm" }] },
              { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "life": 16, "battlefield_has": ["Grizzly Bears"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ], "stack_empty": true } },
 { "name": "ruling: without Reverberation the sorcery's damage kills both creatures",
   "players": [ { "hand": ["Pyroclasm"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Pyroclasm" }, { "resolve": true, "auto": true } ],
   "expect": { "players": [ { "life": 20, "graveyard_has": ["Grizzly Bears"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] } }
