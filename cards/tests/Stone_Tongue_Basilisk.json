[
  {
    "name": "a creature it damages in combat is destroyed at end of combat",
    "players": [ { "battlefield": ["Stone-Tongue Basilisk"] }, { "battlefield": ["Wall of Frost"] } ],
    "steps": [
      { "attack": [ { "card": "Stone-Tongue Basilisk", "at": "p1" } ] },
      { "block": [ { "blocker": "Wall of Frost", "attacker": "Stone-Tongue Basilisk" } ] },
      { "advance_to": "Main2" },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Wall of Frost"] } ] }
  },
  {
    "name": "threshold (7 cards in graveyard): all creatures able to block it must block",
    "players": [ { "battlefield": ["Stone-Tongue Basilisk"], "graveyard": ["Forest","Forest","Forest","Forest","Forest","Forest","Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Stone-Tongue Basilisk", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Hill Giant"], "life": 20 } ] }
  },
  {
    "name": "six cards in graveyard is not threshold: no forced block",
    "players": [ { "battlefield": ["Stone-Tongue Basilisk"], "graveyard": ["Forest","Forest","Forest","Forest","Forest","Forest"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Stone-Tongue Basilisk", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  }
]
