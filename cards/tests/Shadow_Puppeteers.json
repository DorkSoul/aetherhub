  },
  {
    "name": "ward {2}: the opponent pays 2 on top of Terror, which then destroys it",
    "players": [
      { "battlefield": ["Shadow Puppeteers"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Shadow Puppeteers"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Shadow Puppeteers"] }, { "graveyard": ["Terror"] } ]
    }
  },
  {
