[
  {
    "name": "enters: creates two 1/1 black Faerie Rogue tokens with flying",
    "players": [
      { "hand": ["Shadow Puppeteers"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Shadow Puppeteers" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Shadow Puppeteers", "Faerie Rogue 1-1 Black Flying"] }, {} ],
      "pt": { "Shadow Puppeteers": [4, 4] }
    }
  },
  {
    "name": "a flying creature attacking becomes a 4/4 Dragon when you accept",
    "players": [
      { "battlefield": ["Shadow Puppeteers", "Faerie Rogue 1-1 Flying"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Faerie Rogue 1-1 Flying", "at": "p1" } ] },
      { "block": [], "answers": [true] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ],
      "pt": { "Faerie Rogue 1-1 Flying": [4, 4] }
    }
  },
  {
    "name": "declining the optional ability leaves the attacker at its own size",
    "players": [
      { "battlefield": ["Shadow Puppeteers", "Faerie Rogue 1-1 Flying"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Faerie Rogue 1-1 Flying", "at": "p1" } ] },
      { "block": [], "answers": [false] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 19 } ],
      "pt": { "Faerie Rogue 1-1 Flying": [1, 1] }
    }
  },
  {
    "name": "a non-flying attacker is not affected",
    "players": [
      { "battlefield": ["Shadow Puppeteers", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ward {2}: the opponent has only 1 spare mana after Terror, cannot pay, Terror is countered",
    "players": [
      { "battlefield": ["Shadow Puppeteers"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Shadow Puppeteers"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Shadow Puppeteers"] }, { "graveyard": ["Terror"] } ]
