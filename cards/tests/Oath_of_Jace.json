[
 {
  "name": "enters: draw three, discard two",
  "players": [
   {
    "hand": [
     "Oath of Jace",
     "Forest",
     "Forest"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Oath of Jace"
   },
   {
    "resolve": true,
    "answers": [
     [
      "Forest",
      "Forest"
     ]
    ]
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Oath of Jace"
     ],
     "hand_count": 3
    },
    {}
   ]
  }
 },
 {
  "name": "upkeep scry with no planeswalkers does nothing",
  "players": [
   {
    "battlefield": [
     "Oath of Jace",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "Upkeep"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Oath of Jace"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "upkeep scry 1 with your planeswalker: bottom the top card, then draw the next",
  "players": [ { "battlefield": ["Oath of Jace", "Jace Beleren"], "library": ["Island", "Mountain"] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [[0]] }, { "resolve": true } ],
  "expect": { "players": [ { "library_top": ["Mountain"], "hand_count": 0 }, {} ] }
 },
 {
  "name": "upkeep scry counts only your planeswalkers: an opponent's does not add to it",
  "players": [ { "battlefield": ["Oath of Jace"], "library": ["Island", "Mountain"] }, { "battlefield": ["Jace Beleren"] } ],
  "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
  "expect": { "players": [ { "library_top": ["Island"], "hand_count": 0 }, {} ] }
 },
 {
  "name": "ruling: with no planeswalkers the upkeep scry does not happen (top card unchanged)",
  "players": [ { "battlefield": ["Oath of Jace", "Island"], "library": ["Island", "Mountain"] }, {} ],
  "steps": [ { "advance_to": "Upkeep" }, { "resolve": true } ],
  "expect": { "players": [ { "library_top": ["Island", "Mountain"] }, {} ] }
 },
 {
  "name": "ruling: legend rule keeps one of two Oath of Jace; the other goes to the graveyard",
  "players": [ { "hand": ["Oath of Jace", "Forest", "Forest"], "battlefield": ["Oath of Jace", "Island", "Island", "Island"] }, {} ],
  "steps": [ { "cast": "Oath of Jace" }, { "resolve": true, "answers": [0, ["Forest", "Forest"]] } ],
  "expect": { "players": [ { "battlefield_has": ["Oath of Jace"], "graveyard_has": ["Oath of Jace"] }, {} ] }
 },
 {
  "name": "ruling: a second Oath of Jace still draws three and discards two, even if it is put into the graveyard",
  "players": [ { "hand": ["Oath of Jace", "Forest", "Forest"], "battlefield": ["Oath of Jace", "Island", "Island", "Island"] }, {} ],
  "steps": [ { "cast": "Oath of Jace" }, { "resolve": true, "answers": [0, ["Forest", "Forest"]] } ],
  "expect": { "players": [ { "hand_count": 3 }, {} ] }
 },
 {
  "name": "ruling: Oath of Gideon and Oath of Jace have different names, so both stay",
  "players": [ { "hand": ["Oath of Jace", "Forest", "Forest"], "battlefield": ["Oath of Gideon", "Island", "Island", "Island"] }, {} ],
  "steps": [ { "cast": "Oath of Jace" }, { "resolve": true, "answers": [["Forest", "Forest"]] } ],
  "expect": { "players": [ { "battlefield_has": ["Oath of Gideon", "Oath of Jace"] }, {} ] }
 }
]