 {
  "name": "ruling: the untap-and-hexproof ability can be activated again while the Behemoth is untapped and already hexproof",
  "players": [
   {
    "battlefield": [
     "Trench Behemoth",
     "Forest",
     "Island"
    ]
   },
   {}
  ],
  "steps": [
   { "activate": "Trench Behemoth", "ability": 0, "answers": ["Forest"] },
   { "resolve": true },
   { "activate": "Trench Behemoth", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 2, "battlefield_has": ["Trench Behemoth"], "battlefield_lacks": ["Forest", "Island"] },
    {}
   ],
   "keywords": { "Trench Behemoth": ["Hexproof"] },
   "tapped": { "Trench Behemoth": false }
  }
 },
 {
  "name": "ruling: a land put onto the battlefield by a spell (Cultivate) still triggers landfall, so a second resolve has a trigger to resolve",
  "players": [
   {
    "hand": ["Cultivate"],
    "battlefield": ["Trench Behemoth", "Forest", "Forest", "Forest"],
    "library": ["Mountain", "Island"]
   },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Cultivate" },
   { "resolve": true, "answers": ["Mountain", "Island"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Island"], "battlefield_has": ["Trench Behemoth", "Mountain"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 }
