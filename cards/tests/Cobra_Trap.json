[
  {
    "name": "noncreature permanent destroyed by an opponent's spell: Cobra Trap for {G} makes four Snakes",
    "players": [
      { "hand": ["Cobra Trap"], "battlefield": ["Forest", "Millstone"] },
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Millstone"] },
      { "resolve": true },
      { "cast": "Cobra Trap", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Millstone", "Cobra Trap"], "battlefield_has": ["Snake", "Snake", "Snake", "Snake"] },
        {}
      ]
    }
  },
  {
    "name": "nothing destroyed: no way to cast Cobra Trap with one Forest",
    "players": [
      { "hand": ["Cobra Trap"], "battlefield": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Cobra Trap", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Cobra Trap"] }, {} ] }
  },
  {
    "name": "a creature destroyed by an opponent does not count",
    "players": [
      { "hand": ["Cobra Trap"], "battlefield": ["Forest", "Grizzly Bears"] },
      { "hand": ["Terror"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Terror", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Cobra Trap", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"], "hand": ["Cobra Trap"] }, {} ] }
  },
  {
    "name": "a noncreature permanent destroyed by its own controller does not count",
    "players": [
      { "hand": ["Cobra Trap", "Disenchant"], "battlefield": ["Forest", "Plains", "Plains", "Millstone"] },
      {}
    ],
    "steps": [
      { "cast": "Disenchant", "targets": ["Millstone"] },
      { "resolve": true },
      { "cast": "Cobra Trap", "alt": 0, "illegal": true }
    ],
    "expect": { "players": [ { "graveyard": ["Millstone", "Disenchant"], "hand": ["Cobra Trap"] }, {} ] }
  },
  {
    "name": "ruling: Cobra Trap can be cast for its full mana cost even when the alternative condition is met",
    "players": [
      { "hand": ["Cobra Trap"], "battlefield": ["Forest", "Forest", "Plains", "Plains", "Plains", "Plains", "Millstone"] },
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Disenchant", "player": 1, "targets": ["Millstone"] },
      { "resolve": true },
      { "cast": "Cobra Trap" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Millstone", "Cobra Trap"], "battlefield_has": ["Snake", "Snake", "Snake", "Snake"] },
        {}
      ]
    }
  }
]
