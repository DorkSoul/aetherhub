[
  { "name": "an opponent casting a spell with the chosen name loses 3 life and you draw a card",
    "players": [ { "hand": ["Silverquill Silencer"], "battlefield": ["Plains", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Silverquill Silencer" }, { "resolve": true, "answers": ["Lightning Bolt"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_has": ["Silverquill Silencer"] }, { "life": 17, "graveyard": ["Lightning Bolt"] } ] } },
  { "name": "you casting a spell with the chosen name does not trigger it",
    "players": [ { "hand": ["Silverquill Silencer", "Lightning Bolt"], "battlefield": ["Plains", "Swamp", "Mountain"] }, {} ],
    "steps": [ { "cast": "Silverquill Silencer" }, { "resolve": true, "answers": ["Lightning Bolt"] }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Silverquill Silencer"] }, { "life": 17 } ] } },
  { "name": "ruling: the Silencer's trigger resolves before the spell, so the Bolt is still on the stack",
    "players": [ { "hand": ["Silverquill Silencer"], "battlefield": ["Plains", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Silverquill Silencer" }, { "resolve": true, "answers": ["Lightning Bolt"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "pass": true }, { "pass": true } ],
    "expect": { "stack_empty": false, "players": [ { "life": 20, "hand_count": 1, "battlefield_has": ["Silverquill Silencer"] }, { "life": 17 } ] } }
