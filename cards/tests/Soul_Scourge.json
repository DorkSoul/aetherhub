[
  {
    "name": "target player loses 3, then regains 3 when it leaves",
    "players": [
      { "hand": ["Soul Scourge", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Soul Scourge" },
      { "resolve": true, "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["Soul Scourge"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{ "graveyard": ["Soul Scourge", "Lightning Bolt"] }, { "life": 20 }] }
  },
  {
    "name": "life loss applies while it is on the battlefield",
    "players": [
      { "hand": ["Soul Scourge"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [{ "cast": "Soul Scourge" }, { "resolve": true, "targets": ["p1"] }],
    "expect": { "players": [{ "battlefield_has": ["Soul Scourge"] }, { "life": 17 }] }
  }
]
