[
 { "name": "ETB untaps up to seven lands; bounce ability then affordable",
   "players": [ { "hand": ["Palinchron"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { } ],
   "steps": [ { "cast": "Palinchron" },
              { "resolve": true, "answers": [["Island", "Island", "Island", "Island"]] },
              { "activate": "Palinchron" },
              { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Palinchron"] }, { } ] } },
 { "name": "choosing no lands leaves too few mana for the bounce ability",
   "players": [ { "hand": ["Palinchron"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { } ],
   "steps": [ { "cast": "Palinchron" },
              { "resolve": true },
              { "activate": "Palinchron", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Palinchron"] }, { } ] } },
 { "name": "ruling: untap is up to seven; the eighth tapped land stays tapped",
   "players": [ { "hand": ["Palinchron"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", {"name": "Forest", "tapped": true}] }, { } ],
   "steps": [ { "cast": "Palinchron" },
              { "resolve": true, "answers": [["Island", "Island", "Island", "Island", "Island", "Island", "Island"]] } ],
   "expect": { "players": [ { "battlefield_has": ["Palinchron"] }, { } ], "tapped": { "Forest": true } } },
 { "name": "ruling: Palinchron may untap a tapped land controlled by the opponent",
   "players": [ { "hand": ["Palinchron"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": [ {"name": "Forest", "tapped": true} ] } ],
   "steps": [ { "cast": "Palinchron" },
              { "resolve": true, "answers": [["Forest"]] } ],
   "expect": { "players": [ { "battlefield_has": ["Palinchron"] }, { } ], "tapped": { "Forest": false } } }
