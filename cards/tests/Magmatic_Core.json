[
  { "name": "end step: X = age counters (after the upkeep increment) divided among target creatures",
    "players": [ { "battlefield": [ { "name": "Magmatic Core", "counters": { "Age": 2 } }, "Mountain", "Mountain", "Mountain" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "End", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ], "counters": { "Magmatic Core": { "age": 3 } } } },
  { "name": "one age counter deals only 1 damage (Grizzly Bears survives)",
    "players": [ { "battlefield": [ "Magmatic Core", "Mountain" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "End", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "counters": { "Magmatic Core": { "age": 1 } } } },
  { "name": "cannot pay the cumulative upkeep: sacrificed",
    "players": [ { "battlefield": ["Magmatic Core"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "graveyard_has": ["Magmatic Core"] }, {} ] } },
  { "name": "ruling: choosing zero targets at the end step means no damage at all",
    "players": [ { "battlefield": [ { "name": "Magmatic Core", "counters": { "Age": 2 } }, "Mountain", "Mountain", "Mountain" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "End", "targets": [] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "counters": { "Magmatic Core": { "age": 3 } } } }
]
