[
  {
    "name": "blocking puts a -0/-1 counter on it: toughness drops, power stays 0",
    "players": [
      {
        "battlefield": ["Grizzly Bears"]
      },
      {
        "battlefield": ["Shield Sphere"]
      }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [ { "blocker": "Shield Sphere", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Shield Sphere": { "m0m1": 1 } },
      "pt": { "Shield Sphere": [0, 5] },
      "players": [ { "life": 20 }, { "life": 20 } ]
    }
  },
  {
    "name": "not blocking: no -0/-1 counter, and the attacker hits the player",
    "players": [
      {
        "battlefield": ["Grizzly Bears"]
      },
      {
        "battlefield": ["Shield Sphere"]
      }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Shield Sphere": {} },
      "pt": { "Shield Sphere": [0, 6] },
      "players": [ { "life": 20 }, { "life": 18 } ]
    }
  }
]
