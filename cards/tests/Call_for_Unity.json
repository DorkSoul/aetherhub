[
 {
  "name": "revolt: a permanent you controlled left this turn, so a unity counter at your end step",
  "players": [
   { "hand": ["Doom Blade"], "battlefield": ["Call for Unity", "Swamp", "Swamp", "Grizzly Bears", "Llanowar Elves"] },
   {}
  ],
  "steps": [
   { "cast": "Doom Blade", "targets": ["Llanowar Elves"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Call for Unity": { "unity": 1 } },
   "pt": { "Grizzly Bears": [3, 3] }
  }
 },
 {
  "name": "no revolt when only an opponent's permanent left the battlefield",
  "players": [
