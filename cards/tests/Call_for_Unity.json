   { "battlefield": ["Llanowar Elves"] }
  ],
  "steps": [
   { "cast": "Doom Blade", "targets": ["Llanowar Elves"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [2, 2] }
  }
 },
 {
