  {
    "name": "ruling: a copy of a modal spell has the same mode (2 damage copied)",
    "players": [
      { "hand": ["Izzet Charm"], "battlefield": ["Izzet Guildmage", "Island", "Island", "Island", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
