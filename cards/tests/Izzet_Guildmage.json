  },
  {
    "name": "ruling: an instant with no targets can be copied; the copy draws too",
    "players": [
      { "hand": ["Opt"], "battlefield": ["Izzet Guildmage", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Opt" },
      { "activate": "Izzet Guildmage", "ability": 0, "targets": [{ "stack": "Opt" }] },
      { "resolve": true, "auto": true }
    ],
    "expect": { "players": [ { "hand_count": 2 }, {} ] }
  },
  {
    "name": "ruling: the copy resolves first and makes its own scry choice (copy bottoms the top card, original keeps)",
    "players": [
      { "hand": ["Opt"], "battlefield": ["Izzet Guildmage", "Island", "Island", "Island", "Island"], "library": ["Lightning Bolt", "Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Opt" },
      { "activate": "Izzet Guildmage", "ability": 0, "targets": [{ "stack": "Opt" }] },
      { "resolve": true, "answers": [[0], []] }
    ],
    "expect": { "players": [ { "hand": ["Mountain", "Island"] }, {} ] }
  },
  {
    "name": "ruling: the copy may choose new targets (Bolt copy redirected to the opponent's face)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Izzet Guildmage", "Mountain", "Mountain", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "activate": "Izzet Guildmage", "ability": 0, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true, "answers": ["p1"] }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17, "graveyard": ["Grizzly Bears"] } ] }
  }
]
