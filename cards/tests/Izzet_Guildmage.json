      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Izzet Charm"] }, { "graveyard": ["Hill Giant"] } ]
    }
  },
  {
    "name": "ruling: X counts toward mana value on the stack; Fireball with X=1 (MV 2) can be copied",
    "players": [
      { "hand": ["Fireball"], "battlefield": ["Izzet Guildmage", "Mountain", "Mountain", "Island", "Island", "Island"] },
