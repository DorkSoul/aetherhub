  {
    "name": "ruling: the life loss uses the mana value on the stack, including the chosen X (Fireball X=2 is 3)",
    "players": [
      { "battlefield": ["The Ruinous Powers", "Mountain", "Mountain", "Mountain"] },
      { "library": ["Lightning Bolt", "Fireball"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Fireball", "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["The Ruinous Powers"] },
        { "life": 15 }
      ]
    }
  },
  {
    "name": "ruling: the exiled card keeps normal timing (a creature cannot be cast during combat)",
    "players": [
      { "battlefield": ["The Ruinous Powers", "Mountain", "Mountain"] },
      { "library": ["Lightning Bolt", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        {},
        { "exile": ["Grizzly Bears"], "life": 20 }
      ]
    }
  }
