      {
        "battlefield": [
          "The Ruinous Powers",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "library": [
          "Lightning Bolt",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
