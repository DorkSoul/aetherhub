    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Forest"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "casting a different spell first does not trigger the life loss",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "The Ruinous Powers",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
