[
  {
    "name": "opponent's creature becoming tapped puts a +1/+1 counter on it",
    "players": [
      { "hand": ["Broken Dam"], "battlefield": ["Gideon's Avenger", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Broken Dam", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Gideon's Avenger": { "p1p1": 1 } },
      "pt": { "Gideon's Avenger": [3, 3] }
    }
  },
  {
    "name": "a creature you control becoming tapped does nothing",
    "players": [
      { "hand": ["Broken Dam"], "battlefield": ["Gideon's Avenger", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Broken Dam", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Gideon's Avenger": [2, 2] }
    }
  },
  {
    "name": "ruling: an opponent's creature that enters tapped does not trigger it",
    "players": [
      { "battlefield": ["Gideon's Avenger", "Island"] },
      { "hand": ["Diregraf Ghoul"], "battlefield": ["Swamp"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Diregraf Ghoul", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "battlefield_has": ["Diregraf Ghoul"] }],
      "tapped": { "Diregraf Ghoul": true },
      "pt": { "Gideon's Avenger": [2, 2] }
    }
  }
]
