[
  {
    "name": "blue spells cost one less",
    "players": [
      { "hand": ["Divination"], "battlefield": ["The Water Crystal", "Island", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Divination"], "hand_count": 2 }, {} ] }
  },
  {
    "name": "nonblue spells are not reduced",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["The Water Crystal", "Forest"] },
      {}
    ],
    "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
    "expect": {}
  },
  {
    "name": "activated mill is hand size plus four for the opponent",
    "players": [
      {
        "hand": ["Plains", "Swamp", "Mountain"],
        "battlefield": ["The Water Crystal", "Island", "Tropical Island", "Forest", "Wastes", "Swamp", "Mountain"]
      },
      {}
    ],
    "steps": [ { "activate": "The Water Crystal" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] } ] }
  },
  {
    "name": "ruling: the cost reduction applies to generic mana: Mulldrifter costs {3}{U} with The Water Crystal",
    "players": [ { "hand": ["Mulldrifter"], "battlefield": ["The Water Crystal", "Island", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Mulldrifter" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mulldrifter"] }, {} ] }
  },
  {
    "name": "ruling: the colored part is not reduced: Mulldrifter still needs a blue source",
    "players": [ { "hand": ["Mulldrifter"], "battlefield": ["The Water Crystal", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Mulldrifter", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Mulldrifter"] }, {} ] }
  }
]
