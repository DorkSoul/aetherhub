[
 {
  "name": "a spell cast from hand does not draw",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Vega, the Watcher",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "hand_count": 0,
     "life": 20
    },
    {
     "life": 17
    }
   ]
  }
 },
 { "name": "casting a spell from the graveyard draws a card",
   "players": [ { "hand": ["Flashback"], "battlefield": ["Vega, the Watcher", "Mountain", "Mountain"], "graveyard": ["Lightning Bolt"] }, {} ],
   "steps": [ { "cast": "Flashback", "targets": ["Lightning Bolt"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1 }, { "life": 17 } ] } },
 { "name": "ruling: Vega's draw resolves even if the spell that caused it is countered",
   "players": [ { "hand": ["Flashback"], "battlefield": ["Vega, the Watcher", "Mountain", "Mountain"], "graveyard": ["Lightning Bolt"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Flashback", "targets": ["Lightning Bolt"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 1 }, { "life": 20, "graveyard": ["Counterspell"] } ] } }
]
