[
  {
    "name": "X: creates an X/X Golem and sacrifices the mask",
    "players": [
      { "battlefield": ["Mask of the Jadecrafter", "Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Mask of the Jadecrafter", "answers": [3] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Golem 0-0 Colorless"], "battlefield_lacks": ["Mask of the Jadecrafter"] },
        {}
      ],
      "pt": { "Golem 0-0 Colorless": [3, 3] }
    }
  },
  {
    "name": "unearth returns it to the battlefield",
    "players": [
      { "graveyard": ["Mask of the Jadecrafter"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Mask of the Jadecrafter", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Mask of the Jadecrafter"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a permanent returned by unearth is exiled at the beginning of the next end step",
    "players": [
      { "graveyard": ["Mask of the Jadecrafter"], "battlefield": ["Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Mask of the Jadecrafter", "ability": 1 },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Mask of the Jadecrafter"], "exile": ["Mask of the Jadecrafter"] }, {} ]
    }
  },
  {
    "name": "ruling: an unearthed permanent sacrificed as a cost is exiled instead of going to the graveyard",
    "players": [
      { "graveyard": ["Mask of the Jadecrafter"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Mask of the Jadecrafter", "ability": 1 },
      { "resolve": true },
      { "activate": "Mask of the Jadecrafter", "ability": 0, "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Golem 0-0 Colorless"], "battlefield_lacks": ["Mask of the Jadecrafter"], "exile": ["Mask of the Jadecrafter"], "graveyard": [] }, {} ],
      "pt": { "Golem 0-0 Colorless": [1, 1] }
    }
  }
]
