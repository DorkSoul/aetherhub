[
  {
    "name": "tap: target land becomes an artifact until end of turn (the Myr taps)",
    "players": [
      { "battlefield": ["Myr Landshaper", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Myr Landshaper", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myr Landshaper", "Forest"] }, {} ],
      "tapped": { "Myr Landshaper": true }
    }
  },
  {
    "name": "target must be a land",
    "players": [
      { "battlefield": ["Myr Landshaper", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Myr Landshaper", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Myr Landshaper", "Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "ruling: the targeted Forest keeps its land types, so it still taps for green",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Myr Landshaper", "Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Myr Landshaper", "ability": 0, "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears", "Forest"] }, {} ],
      "tapped": { "Myr Landshaper": true }
    }
  }
]
