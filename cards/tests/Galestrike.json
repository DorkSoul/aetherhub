[
 { "name": "returns a tapped creature and draws a card",
   "players": [ { "hand": ["Galestrike"], "battlefield": ["Island", "Island", "Island"], "library": ["Shock"] },
                { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "cast": "Galestrike", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Shock"], "graveyard": ["Galestrike"] }, { "hand": ["Grizzly Bears"], "battlefield": [] } ] } },
 { "name": "an untapped creature is not a legal target",
   "players": [ { "hand": ["Galestrike"], "battlefield": ["Island", "Island", "Island"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Galestrike", "targets": ["Grizzly Bears"], "illegal": true } ],
   "expect": { "players": [ {}, { "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "ruling: if the target is gone when Galestrike resolves it does nothing and no card is drawn",
   "players": [ { "hand": ["Galestrike"], "battlefield": ["Island", "Island", "Island"], "library": ["Shock"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Grizzly Bears", "tapped": true }] } ],
   "steps": [ { "cast": "Galestrike", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "hand_count": 0, "graveyard": ["Galestrike"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } }
]
