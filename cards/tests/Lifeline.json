[
 { "name": "creature dies with another creature on the battlefield: it returns at the next end step",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lifeline", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "no other creature on the battlefield: nothing returns",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lifeline", "Mountain", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
   "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"], "graveyard_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: works for every player, so an opponent's creature returns under its owner's control",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Lifeline", "Mountain", "Llanowar Elves"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: a creature that has left the graveyard by the end step does not return",
   "players": [ { "hand": ["Lightning Bolt", "Blood Beckoning"], "battlefield": ["Lifeline", "Mountain", "Swamp", "Llanowar Elves", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "cast": "Blood Beckoning" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: the creature still returns if Lifeline leaves the battlefield before its trigger resolves",
   "players": [ { "hand": ["Lightning Bolt", "Shatter"], "battlefield": ["Lifeline", "Mountain", "Mountain", "Mountain", "Llanowar Elves"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Shatter" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Lifeline"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: each creature that dies returns at the end step, with its own delayed trigger",
   "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Lifeline", "Mountain", "Mountain", "Grizzly Bears", "Hill Giant"] }, { "battlefield": ["Llanowar Elves"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Hill Giant"] }, {} ] } }
]
