[
  {
    "name": "repartee: instant targeting a creature puts a +1/+1 counter on each creature you control",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Forest", "Stirring Hopesinger", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Stirring Hopesinger": [2, 4], "Grizzly Bears": [6, 6] }
    }
  },
  {
    "name": "repartee does not trigger for a spell that targets no creature",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Stirring Hopesinger"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Stirring Hopesinger": [1, 3] }
    }
  },
  { "name": "ruling: repartee still triggers when the targeted creature leaves before the spell resolves",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Stirring Hopesinger", "Grizzly Bears"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Giant Growth"] }, { "graveyard": ["Lightning Bolt"] } ], "pt": { "Stirring Hopesinger": [2, 4] } } },
  { "name": "ruling: repartee resolves even when the spell that caused it is countered",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Forest", "Stirring Hopesinger", "Grizzly Bears"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Giant Growth" } ] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Giant Growth"] }, { "graveyard": ["Counterspell"] } ], "pt": { "Stirring Hopesinger": [2, 4], "Grizzly Bears": [3, 3] } } }
]
