 {
  "name": "ruling: declining the may on resolution leaves the target creature unchanged",
  "players": [
   { "battlefield": ["Puppeteer", "Island"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "activate": "Puppeteer", "targets": ["Hill Giant"] },
   { "resolve": true, "answers": [false] }
