  {
    "name": "power 3 creature is legal",
    "players": [
      {
        "battlefield": [
          "Access Tunnel",
          "Plains",
          "Plains",
          "Plains",
          "Hill Giant"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Access Tunnel",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "keywords": {
        "Hill Giant": [
          "Unblockable"
        ]
      }
    }
  },
  {
    "name": "ruling: activating after blockers are declared does not unblock the creature",
    "players": [
      { "battlefield": ["Access Tunnel", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "battlefield": ["Wall of Stone"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Stone", "attacker": "Grizzly Bears" }] },
      { "activate": "Access Tunnel", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "ruling: a power raise after the ability resolves still leaves the creature unblockable",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Access Tunnel", "Plains", "Plains", "Plains", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Wall of Stone"] }
    ],
    "steps": [
      { "activate": "Access Tunnel", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Stone", "attacker": "Grizzly Bears" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 15 }]
    }
  },
  {
    "name": "ruling: a pump in response makes the target too big, so the ability does nothing",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Access Tunnel", "Plains", "Plains", "Plains", "Forest", "Grizzly Bears"] },
      { "battlefield": ["Wall of Stone"] }
    ],
    "steps": [
      { "activate": "Access Tunnel", "targets": ["Grizzly Bears"] },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "block": [{ "blocker": "Wall of Stone", "attacker": "Grizzly Bears" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "tapped": { "Access Tunnel": true }
    }
  }
]
