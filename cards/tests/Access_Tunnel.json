        "battlefield": [
          "Access Tunnel",
          "Plains",
          "Plains",
          "Plains",
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          "Wall of Stone"
        ]
      }
    ],
    "steps": [
      {
        "activate": "Access Tunnel",
        "targets": [
          "Hill Giant"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17
        }
      ]
