[
  {
    "name": "ETB creates a tapped Vibranium when an opponent controls more lands",
    "players": [
      { "hand": ["Dora Milaje Elite"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Forest", "Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Dora Milaje Elite" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dora Milaje Elite", "Vibranium"] },
        {}
      ]
    }
  },
  {
    "name": "no Vibranium when an opponent controls the same number of lands",
    "players": [
      { "hand": ["Dora Milaje Elite"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Dora Milaje Elite" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Dora Milaje Elite"] },
        {}
      ]
    }
  },
  {
    "name": "sacrificing Dora in response makes legendary permanents indestructible until end of turn",
    "players": [
      { "battlefield": ["Dora Milaje Elite", "Disa the Restless"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Disa the Restless"] },
      { "activate": "Dora Milaje Elite", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Disa the Restless"], "graveyard": ["Dora Milaje Elite"] },
        { "graveyard": ["Murder"] }
      ]
    }
  },
  {
    "name": "sacrificing Dora does not protect a nonlegendary creature from destruction",
    "players": [
      { "battlefield": ["Dora Milaje Elite", "Grizzly Bears"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Murder", "player": 1, "targets": ["Grizzly Bears"] },
      { "activate": "Dora Milaje Elite", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"], "graveyard": ["Dora Milaje Elite", "Grizzly Bears"] },
        { "graveyard": ["Murder"] }
      ]
    }
  }
]
