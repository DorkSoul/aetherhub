[
  {
    "name": "attacking manifests dread: one top card face down, the other to the graveyard",
    "players": [
      { "battlefield": [{ "name": "Hauntwoods Shrieker", "sick": false }], "library": ["Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Hauntwoods Shrieker", "at": "p1" }] },
      { "resolve": true, "answers": ["Grizzly Bears"] }
    ],
    "expect": { "players": [ { "graveyard": ["Forest"], "battlefield_has": ["Hauntwoods Shrieker"] }, {} ] }
  },
  {
    "name": "reveal a face-down creature card and turn it face up",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "Forest", "Forest", { "name": "Hill Giant", "face_down": true }] },
      {}
    ],
    "steps": [
      { "activate": "Hauntwoods Shrieker", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": ["yes"] }
    ],
    "expect": { "pt": { "Hill Giant": [3, 3] } }
  },
  {
    "name": "the controller may decline to turn it face up",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "Forest", "Forest", { "name": "Hill Giant", "face_down": true }] },
      {}
    ],
    "steps": [
      { "activate": "Hauntwoods Shrieker", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": ["no"] }
    ],
    "expect": { "pt": { "Hill Giant": [2, 2] } }
  },
  {
    "name": "a face-down noncreature card is revealed but stays face down",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "Forest", "Forest", { "name": "Plains", "face_down": true }] },
      {}
    ],
    "steps": [
      { "activate": "Hauntwoods Shrieker", "targets": ["Plains"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Plains": [2, 2] } }
  },
  {
    "name": "ruling: turning a manifested creature face up is a special action that uses no stack",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Hill Giant", "face_down": true }] },
      {}
    ],
    "steps": [
      { "activate": "Hill Giant" }
    ],
    "expect": { "stack_empty": true, "pt": { "Hill Giant": [3, 3] }, "subtypes": { "Hill Giant": ["Giant"] } }
  },
  {
    "name": "ruling: turning a face-down creature face up does not change whether it is tapped",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "Forest", "Forest", { "name": "Hill Giant", "face_down": true, "tapped": true }] },
      {}
    ],
    "steps": [
      { "activate": "Hauntwoods Shrieker", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": ["yes"] }
    ],
    "expect": { "tapped": { "Hill Giant": true }, "pt": { "Hill Giant": [3, 3] } }
  },
  {
    "name": "ruling: an Aura stays attached when the enchanted face-down creature is turned face up",
    "players": [
      { "hand": ["Eel Umbra"], "battlefield": ["Hauntwoods Shrieker", "Island", "Island", "Forest", "Forest", { "name": "Hill Giant", "face_down": true }] },
      {}
    ],
    "steps": [
      { "cast": "Eel Umbra", "targets": ["Hill Giant"] },
      { "resolve": true },
      { "activate": "Hauntwoods Shrieker", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": ["yes"] }
    ],
    "expect": { "pt": { "Hill Giant": [4, 4] }, "attached": { "Eel Umbra": "Hill Giant" } }
  },
  {
    "name": "ruling: a face-down instant revealed by the Shrieker stays face down",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "Forest", "Forest", { "name": "Lightning Bolt", "face_down": true }] },
      {}
    ],
    "steps": [
      { "activate": "Hauntwoods Shrieker", "targets": ["Lightning Bolt"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Lightning Bolt": [2, 2] } }
  },
  {
    "name": "ruling: a noncreature artifact revealed is not turned face up, even with March of the Machines making it a creature",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "March of the Machines", "Forest", "Forest", { "name": "Lantern of Insight", "face_down": true }] },
      {}
    ],
    "steps": [
      { "activate": "Hauntwoods Shrieker", "targets": ["Lantern of Insight"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Lantern of Insight": [2, 2] } }
  },
  {
    "name": "ruling: turning a manifested creature face up does not trigger its enters-the-battlefield ability",
    "players": [
      { "battlefield": ["Hauntwoods Shrieker", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", { "name": "Jubilation", "face_down": true }, "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Jubilation" }
    ],
    "expect": { "stack_empty": true, "pt": { "Jubilation": [5, 5], "Grizzly Bears": [2, 2] } }
  }
]
