                 { "battlefield": ["Serra Angel"] } ],
    "steps": [ { "cast": "Cinder Cloud", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 16, "graveyard": ["Serra Angel"] } ] } },
  { "name": "destroying a green creature deals no damage",
    "players": [ { "hand": ["Cinder Cloud"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Cinder Cloud", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20, "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "a white creature you control dying damages you",
    "players": [ { "hand": ["Cinder Cloud"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Serra Angel"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Cinder Cloud", "targets": ["Serra Angel"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 16, "graveyard": ["Cinder Cloud", "Serra Angel"] }, { "life": 20 } ] } }
