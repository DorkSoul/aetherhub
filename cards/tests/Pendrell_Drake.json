[
  {
    "name": "cycles for {2} from hand",
    "players": [
      {
        "hand": [
          "Pendrell Drake",
          "Grizzly Bears"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Pendrell Drake",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Pendrell Drake"
          ],
          "hand_count": 2
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Stifle can counter the cycling ability; the card is discarded and no card is drawn",
    "players": [
      {
        "hand": ["Pendrell Drake"],
        "battlefield": ["Island", "Island"],
        "library": ["Forest"]
      },
      {
        "hand": ["Stifle"],
        "battlefield": ["Island"]
      }
    ],
    "steps": [
      { "activate": "Pendrell Drake", "ability": 0 },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [{ "stack": "Pendrell Drake" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Pendrell Drake"], "hand_count": 0, "library_top": ["Forest"] },
        { "graveyard": ["Stifle"] }
      ]
    }
  },
  {
    "name": "ruling: Remove Soul cannot counter cycling (it is not a spell); the card still draws",
    "players": [
      {
        "hand": ["Pendrell Drake"],
        "battlefield": ["Island", "Island"],
        "library": ["Forest"]
      },
      {
        "hand": ["Remove Soul"],
        "battlefield": ["Island", "Island"]
      }
    ],
    "steps": [
      { "activate": "Pendrell Drake", "ability": 0 },
      { "pass": true },
      { "cast": "Remove Soul", "player": 1, "targets": [{ "stack": "Pendrell Drake" }], "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Pendrell Drake"], "hand": ["Forest"] },
        { "hand": ["Remove Soul"] }
      ]
    }
  }
]
