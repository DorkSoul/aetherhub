[
  {
    "name": "three creatures with toughness > power: transforms at beginning of combat",
    "players": [
      { "battlefield": [ { "name": "Catapult Fodder // Catapult Captain", "sick": false }, "Wall of Omens", "Wall of Omens" ] },
      {}
    ],
    "steps": [ { "advance_to": "BeginCombat" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Catapult Captain"] }, {} ] }
  },
  {
    "name": "only two such creatures: no transform",
    "players": [
      { "battlefield": [ { "name": "Catapult Fodder // Catapult Captain", "sick": false }, "Grizzly Bears", "Wall of Omens" ] },
      {}
    ],
    "steps": [ { "advance_to": "BeginCombat" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Catapult Fodder // Catapult Captain"] }, {} ] }
  },
  {
    "name": "Captain: sacrifice a creature, opponent loses life equal to its toughness",
    "players": [
      { "battlefield": [ { "name": "Catapult Fodder // Catapult Captain", "sick": false }, "Wall of Omens", "Wall of Omens", "Swamp", "Swamp", "Swamp" ] },
      {}
    ],
    "steps": [ { "advance_to": "BeginCombat" }, { "resolve": true }, { "activate": "Catapult Captain", "answers": [[0]] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Catapult Captain"] }, { "life": 16 } ] }
  },
  {
    "name": "ruling: each creature must have toughness above its own power: a 2/2 and a 3/3 do not count, so only Fodder qualifies",
    "players": [
      { "battlefield": [ { "name": "Catapult Fodder // Catapult Captain", "sick": false }, "Grizzly Bears", "Hill Giant" ] },
      {}
    ],
    "steps": [ { "advance_to": "BeginCombat" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Catapult Fodder // Catapult Captain"], "battlefield_lacks": ["Catapult Captain"] }, {} ] }
  }
]
