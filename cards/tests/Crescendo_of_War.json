[
  {
    "name": "each upkeep puts a strife counter on it",
    "players": [
      {
        "battlefield": [
          {
            "name": "Crescendo of War"
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Crescendo of War": {
          "strife": 1
        }
      }
    }
  },
  {
    "name": "attacking creatures get +1/+0 per strife counter",
    "players": [
      {
        "battlefield": [
          {
            "name": "Crescendo of War",
            "counters": {
              "strife": 2
            }
          },
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          4,
          2
        ]
      }
    }
  },
  {
    "name": "a creature that is not attacking or blocking gets nothing",
    "players": [
      {
        "battlefield": [
          {
            "name": "Crescendo of War",
            "counters": {
              "strife": 2
            }
          },
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "blocking creatures you control get +1/+0; opponents' attackers get +1/+0 too",
    "players": [
      {
        "battlefield": [
          "Hill Giant"
        ]
      },
      {
        "battlefield": [
          {
            "name": "Crescendo of War",
            "counters": {
              "strife": 2
            }
          },
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Hill Giant",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Grizzly Bears",
            "attacker": "Hill Giant"
          }
        ]
      }
    ],
    "expect": {
      "pt": {
        "Grizzly Bears": [
          4,
          2
        ],
        "Hill Giant": [
          5,
          3
        ]
      }
    }
  }
]
