[
  {
    "name": "training: attacking with a greater-power creature puts a counter on it",
    "players": [
      {
        "battlefield": [
          "Apprentice Sharpshooter",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "attack": [
          {
            "card": "Apprentice Sharpshooter",
            "at": "p1"
          },
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Apprentice Sharpshooter": {
          "p1p1": 1
        }
      },
      "pt": {
        "Apprentice Sharpshooter": [
          2,
          5
        ]
      }
    }
  },
  {
    "name": "training does not trigger when attacking alone",
    "players": [
      {
        "battlefield": [
          "Apprentice Sharpshooter"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "attack": [
          {
            "card": "Apprentice Sharpshooter",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "pt": {
        "Apprentice Sharpshooter": [
          1,
          4
        ]
      }
    }
  },
  {
    "name": "ruling: training checks power at declaration; a pump after attacks adds no counter",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Apprentice Sharpshooter", "Llanowar Elves", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Apprentice Sharpshooter", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" } ] },
      { "cast": "Giant Growth", "targets": ["Apprentice Sharpshooter"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 15 } ],
      "pt": { "Apprentice Sharpshooter": [4, 7] }
    }
  },
  {
    "name": "ruling: the training trigger still counts after the other attacker dies in response",
    "players": [
      { "battlefield": ["Apprentice Sharpshooter", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Apprentice Sharpshooter", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ],
      "counters": { "Apprentice Sharpshooter": { "p1p1": 1 } },
      "pt": { "Apprentice Sharpshooter": [2, 5] }
    }
  }
]
