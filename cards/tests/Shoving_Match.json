  {
    "name": "until end of turn, creatures gain {T}: tap target creature",
    "players": [ { "hand": ["Shoving Match"], "battlefield": ["Island", "Island", "Swamp", "Grizzly Bears"] }, { "battlefield": ["Savannah Lions"] } ],
    "steps": [
      { "cast": "Shoving Match" },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Savannah Lions"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Savannah Lions"] } ], "tapped": { "Savannah Lions": true } }
  },
  {
    "name": "without the spell the granted ability does not exist",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Savannah Lions"] } ],
    "steps": [ { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Savannah Lions"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ], "tapped": { "Savannah Lions": false } }
  }
