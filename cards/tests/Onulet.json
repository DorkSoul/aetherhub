    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 20, "battlefield_has": ["Onulet"] }, { "graveyard": ["Grizzly Bears"] }]
    }
  }
