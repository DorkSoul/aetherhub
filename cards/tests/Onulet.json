[
  {
    "name": "gains 2 life when it dies",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Onulet", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Onulet"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 22, "graveyard_has": ["Onulet"] }, {}]
    }
  },
  {
    "name": "does not trigger when another creature dies",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Onulet", "Mountain"] },
