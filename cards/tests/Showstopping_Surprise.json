[
  { "name": "damages each other creature by the target's power and spares the target",
    "players": [ { "hand": ["Showstopping Surprise"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Hill Giant", "Grizzly Bears"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Showstopping Surprise", "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "pt": { "Hill Giant": [3, 3] },
                "players": [ { "graveyard": ["Grizzly Bears", "Showstopping Surprise"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "turns a face-down target face up and it deals damage equal to its power",
    "players": [ { "hand": ["Showstopping Surprise"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "face_down": true }] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Showstopping Surprise", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "a face-down 2/2 deals 2 to a 3/3 opponent creature, which survives",
    "players": [ { "hand": ["Showstopping Surprise"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "face_down": true }] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Showstopping Surprise", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Hill Giant": [3, 3] } } },
  { "name": "ruling: a face-down creature that cannot be turned up still deals damage equal to its power",
    "players": [ { "hand": ["Showstopping Surprise"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "face_down": true }] },
                 { "battlefield": ["Llanowar Elves", "Hill Giant"] } ],
    "steps": [ { "cast": "Showstopping Surprise", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Hill Giant": [3, 3] }, "players": [ {}, { "graveyard": ["Llanowar Elves"] } ] } }
]
