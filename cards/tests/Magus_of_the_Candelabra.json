[
  {
    "name": "X=2 untaps exactly two target lands",
    "players": [
      { "battlefield": ["Magus of the Candelabra", "Forest", "Mountain", "Plains", "Island"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Forest" },
      { "tap_for_mana": "Mountain" },
      { "activate": "Magus of the Candelabra", "targets": ["Forest", "Mountain"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Candelabra", "Forest", "Mountain", "Plains", "Island"] },
        {}
      ],
      "tapped": { "Magus of the Candelabra": true, "Forest": false, "Mountain": false, "Plains": false }
    }
  },
  {
    "name": "X=1 untaps only the one chosen land, leaves the other tapped",
    "players": [
      { "battlefield": ["Magus of the Candelabra", "Forest", "Mountain", "Plains"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Forest" },
      { "tap_for_mana": "Plains" },
      { "activate": "Magus of the Candelabra", "targets": ["Plains"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Magus of the Candelabra", "Forest", "Mountain", "Plains"] },
        {}
      ],
      "tapped": { "Magus of the Candelabra": true, "Forest": true, "Plains": false }
    }
  }
]
