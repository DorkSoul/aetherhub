[
  {
    "name": "pump once while blocked",
    "players": [
      { "battlefield": ["Grizzled Wolverine", "Mountain", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzled Wolverine", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzled Wolverine" } ] },
      { "activate": "Grizzled Wolverine", "ability": 0 },
      { "resolve": true },
      { "activate": "Grizzled Wolverine", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Grizzled Wolverine": [4, 2] } }
  },
  {
    "name": "not usable when unblocked",
    "players": [
      { "battlefield": ["Grizzled Wolverine", "Mountain"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzled Wolverine", "at": "p1" } ] },
      { "block": [] },
      { "activate": "Grizzled Wolverine", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Grizzled Wolverine": [2, 2] } }
  },
  {
    "name": "not usable outside the declare blockers step",
    "players": [
      { "battlefield": ["Grizzled Wolverine", "Mountain"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Grizzled Wolverine", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Grizzled Wolverine": [2, 2] } }
  },
  {
    "name": "ruling: blocked by two creatures, the single pump still gives only +2/+0",
    "players": [
      { "battlefield": ["Grizzled Wolverine", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzled Wolverine", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Grizzled Wolverine" }, { "blocker": "Hill Giant", "attacker": "Grizzled Wolverine" } ] },
      { "activate": "Grizzled Wolverine", "ability": 0 },
      { "resolve": true },
      { "activate": "Grizzled Wolverine", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Grizzled Wolverine": [4, 2] } }
  }
]
