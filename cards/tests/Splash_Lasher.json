[
 {
  "name": "ETB taps the chosen creature and puts a stun counter on it",
  "players": [
   {
    "hand": [
     "Splash Lasher"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Splash Lasher"
   },
   {
    "resolve": true,
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": true
   },
   "counters": {
    "Grizzly Bears": {
     "stun": 1
    }
   }
  }
 },
 {
  "name": "up to one: choosing no target leaves the creature alone",
  "players": [
   {
    "hand": [
     "Splash Lasher"
    ],
    "battlefield": [
     "Island",
     "Island",
     "Island",
     "Island"
    ]
   },
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Splash Lasher"
   },
   {
    "resolve": true,
    "targets": []
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "tapped": {
    "Grizzly Bears": false
   }
  }
 },
 {
  "name": "offspring paid: a 1/1 token copy enters too",
  "players": [
   { "hand": ["Splash Lasher"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Splash Lasher", "answers": [true] },
   { "resolve": true, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Splash Lasher", "Splash Lasher"] }, { "battlefield_has": ["Grizzly Bears"] } ],
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "ruling: the offspring token is still created if the original leaves before the offspring trigger resolves",
  "players": [
   { "hand": ["Splash Lasher", "Lightning Bolt"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Splash Lasher", "answers": [true] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "cast": "Lightning Bolt", "targets": ["Splash Lasher", "Splash Lasher"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Lightning Bolt", "Splash Lasher"], "battlefield_has": ["Splash Lasher"] },
    {}
   ]
  }
 }
]
