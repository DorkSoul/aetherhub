[
  {
    "name": "tap ability deals 1 damage to each opponent and taps the Analyst",
    "players": [
      { "battlefield": ["Tal Shiar Analyst"] },
      {}
    ],
    "steps": [
      { "activate": "Tal Shiar Analyst" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Tal Shiar Analyst": true },
      "players": [{}, { "life": 19 }]
    }
  },
  {
    "name": "casting a noncreature spell untaps the tapped Analyst",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Tal Shiar Analyst", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Tal Shiar Analyst" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Tal Shiar Analyst": false },
      "players": [{}, { "graveyard": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "casting a creature spell does not untap the Analyst",
    "players": [
      { "hand": ["Llanowar Elves"], "battlefield": ["Tal Shiar Analyst", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Tal Shiar Analyst" },
      { "resolve": true },
      { "cast": "Llanowar Elves" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Tal Shiar Analyst": true }
    }
  }
]
