      { "hand": ["Grizzly Bears", "Hill Giant", "Llanowar Elves", "Savannah Lions", "Serra Angel", "Giant Growth", "Island"],
        "battlefield": ["Library of Alexandria"], "library": ["Mountain"] },
      {}
    ],
    "steps": [ { "activate": "Library of Alexandria" }, { "resolve": true } ],
