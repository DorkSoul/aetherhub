      { "hand_count": 8, "library_count": 0, "battlefield_has": ["Library of Alexandria"] },
      {}
    ] } },
  { "name": "with eight cards in hand the draw ability is not available",
    "players": [
      { "hand": ["Grizzly Bears", "Hill Giant", "Llanowar Elves", "Savannah Lions", "Serra Angel", "Giant Growth", "Island", "Swamp"],
        "battlefield": ["Library of Alexandria"], "library": ["Mountain"] },
      {}
    ],
    "steps": [ { "activate": "Library of Alexandria", "illegal": true } ],
    "expect": { "players": [ { "hand_count": 8, "library_count": 1 }, {} ] } },
  { "name": "with six cards in hand the draw ability is not available",
    "players": [
      { "hand": ["Grizzly Bears", "Hill Giant", "Llanowar Elves", "Savannah Lions", "Serra Angel", "Giant Growth"],
        "battlefield": ["Library of Alexandria"], "library": ["Mountain"] },
      {}
    ],
    "steps": [ { "activate": "Library of Alexandria", "illegal": true } ],
    "expect": { "players": [ { "hand_count": 6, "library_count": 1 }, {} ] } },
  { "name": "taps for one colorless mana",
    "players": [ { "battlefield": ["Library of Alexandria"] }, {} ],
    "steps": [ { "tap_for_mana": "Library of Alexandria" } ],
    "expect": { "players": [ { "pool": { "C": 1 } }, {} ] } }
