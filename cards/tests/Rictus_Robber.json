        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Rictus Robber"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Rictus Robber"
          ],
          "battlefield_lacks": [
            "Zombie Rogue 2-2 Blue Black"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "plot from hand, exiled face up for later",
    "players": [
      {
        "hand": [
          "Rictus Robber"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Rictus Robber",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Rictus Robber"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a card plotted this turn cannot be cast this turn",
    "players": [
      { "hand": ["Rictus Robber"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Rictus Robber", "ability": 0 },
      { "resolve": true },
      { "cast": "Rictus Robber", "illegal": true }
    ],
    "expect": { "players": [ { "exile": ["Rictus Robber"] }, {} ] }
  },
  {
    "name": "ruling: plotted card is cast for free on a later turn",
    "players": [
      { "hand": ["Rictus Robber"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Rictus Robber", "ability": 0 },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Rictus Robber" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Rictus Robber"], "exile": [] }, {} ] }
