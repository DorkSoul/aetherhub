[
  {
    "name": "enters after a creature died this turn and makes a Zombie Rogue",
    "players": [
      {
        "hand": [
          "Rictus Robber",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Rictus Robber"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Rictus Robber",
