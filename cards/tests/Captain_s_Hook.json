[
  {
    "name": "equipped creature gets +2/+0, menace and is a Pirate",
    "players": [
      { "battlefield": ["Captain's Hook", "Grizzly Bears", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Captain's Hook", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 2] },
      "keywords": { "Grizzly Bears": ["Menace"] },
      "attached": { "Captain's Hook": "Grizzly Bears" },
      "subtypes": { "Grizzly Bears": ["Pirate", "Bear"] }
    }
  },
  {
    "name": "equipping another creature destroys the creature it was unattached from",
    "players": [
      { "battlefield": ["Captain's Hook", "Grizzly Bears", "Hill Giant", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Captain's Hook", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Captain's Hook", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Grizzly Bears"], "battlefield_has": ["Hill Giant", "Captain's Hook"] }, {}],
      "pt": { "Hill Giant": [5, 3] },
      "attached": { "Captain's Hook": "Hill Giant" }
    }
  },
  {
    "name": "an unattached Equipment destroys nothing",
    "players": [
      { "battlefield": ["Captain's Hook", "Grizzly Bears", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Captain's Hook", "Grizzly Bears"] }, {}],
      "pt": { "Grizzly Bears": [2, 2] },
      "not_subtypes": { "Grizzly Bears": ["Pirate"] }
    }
  },
  {
    "name": "a creature that is not equipped is not a Pirate, even while the Equipment is on the battlefield",
    "players": [
      { "battlefield": ["Captain's Hook", "Grizzly Bears", "Hill Giant", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Captain's Hook", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "subtypes": { "Hill Giant": ["Pirate"] },
      "not_subtypes": { "Grizzly Bears": ["Pirate"] }
    }
  },
  {
    "name": "ruling: when the equipped creature leaves the battlefield the Equipment stays and its trigger does nothing",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Captain's Hook", "Grizzly Bears", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Captain's Hook", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears", "Lightning Bolt"], "battlefield_has": ["Captain's Hook"] }, {} ]
    }
  }
]
