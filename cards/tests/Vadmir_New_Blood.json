[
  { "name": "targeting an opponent is a crime: +1/+1 counter, once per turn",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Vadmir, New Blood", "Mountain", "Mountain"] }, { "battlefield": [] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vadmir, New Blood"] }, { "life": 14 } ], "pt": { "Vadmir, New Blood": [3, 3] }, "counters": { "Vadmir, New Blood": { "p1p1": 1 } } } },
  { "name": "targeting only your own creature is not a crime",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Vadmir, New Blood", "Mountain", "Grizzly Bears"] }, { "battlefield": [] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p0:Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vadmir, New Blood"] }, { "life": 20 } ], "pt": { "Vadmir, New Blood": [2, 2] } } },
  { "name": "four +1/+1 counters: Vadmir is 6/6",
    "players": [ { "battlefield": [ { "name": "Vadmir, New Blood", "counters": { "p1p1": 4 } } ] }, {} ],
    "steps": [ { "pass": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vadmir, New Blood"] }, {} ], "pt": { "Vadmir, New Blood": [6, 6] } } },
  { "name": "four counters: menace, a single blocker cannot block it (lifelink gains 6)",
    "players": [ { "battlefield": [ { "name": "Vadmir, New Blood", "counters": { "p1p1": 4 } } ] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Vadmir, New Blood", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Vadmir, New Blood" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 26 }, { "life": 14 } ] } },
  { "name": "four counters: lifelink gains the life of the damage dealt",
    "players": [ { "battlefield": [ { "name": "Vadmir, New Blood", "counters": { "p1p1": 4 } } ] }, {} ],
    "steps": [ { "attack": [ { "card": "Vadmir, New Blood", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 26 }, { "life": 14 } ] } },
  { "name": "ruling: crime is committed on cast, even if the spell is countered: +1/+1 counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Vadmir, New Blood", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "battlefield_has": ["Vadmir, New Blood"] }, { "life": 20, "graveyard": ["Counterspell"] } ], "pt": { "Vadmir, New Blood": [3, 3] }, "counters": { "Vadmir, New Blood": { "p1p1": 1 } } } },
  { "name": "ruling: targeting a creature an opponent controls is a crime: +1/+1 counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Vadmir, New Blood", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vadmir, New Blood"] }, { "graveyard": ["Grizzly Bears"] } ], "pt": { "Vadmir, New Blood": [3, 3] }, "counters": { "Vadmir, New Blood": { "p1p1": 1 } } } }
]
