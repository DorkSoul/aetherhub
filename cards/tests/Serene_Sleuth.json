 {
  "name": "ruling: a non-token Clue (Wrench) can be sacrificed to pay for Alquist Proft's ability",
  "players": [ { "battlefield": ["Alquist Proft, Master Sleuth", "Wrench", "Plains", "Island", "Island", "Island"] }, {} ],
  "steps": [ { "activate": "Alquist Proft, Master Sleuth", "answers": [1] }, { "resolve": true } ],
  "expect": { "players": [ { "life": 21, "hand_count": 1, "battlefield_lacks": ["Wrench"], "battlefield_has": ["Alquist Proft, Master Sleuth"] }, {} ] }
 },
 {
  "name": "ruling: a Clue sacrificed for its own draw ability cannot also pay for Alquist Proft",
  "players": [ { "battlefield": ["Alquist Proft, Master Sleuth", "Wrench", "Plains", "Plains", "Plains", "Island", "Island", "Island", "Island"] }, {} ],
  "steps": [ { "activate": "Wrench", "ability": 0 }, { "activate": "Alquist Proft, Master Sleuth", "answers": [0], "illegal": true }, { "resolve": true } ],
  "expect": { "players": [ { "life": 20, "hand_count": 1, "graveyard_has": ["Wrench"], "battlefield_has": ["Alquist Proft, Master Sleuth"] }, {} ] }
 },
