[
  {
    "name": "untaps itself to tap target creature for {1}{W/U}",
    "players": [
      { "battlefield": [{ "name": "Silkbind Faerie", "tapped": true }, "Plains", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Silkbind Faerie", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Silkbind Faerie": false }
    }
  },
  {
    "name": "an untapped faerie cannot pay its {Q} cost",
    "players": [
      { "battlefield": ["Silkbind Faerie", "Plains", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Silkbind Faerie", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: a summoning-sick faerie cannot pay its {Q} cost",
    "players": [
      { "battlefield": [{ "name": "Silkbind Faerie", "tapped": true, "sick": true }, "Plains", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Silkbind Faerie", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false, "Silkbind Faerie": true }
    }
  }
]
