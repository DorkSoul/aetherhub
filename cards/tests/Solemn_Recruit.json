[
 {
  "name": "revolt: a permanent left the battlefield this turn, gets a counter at your end step",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Solemn Recruit", "Grizzly Bears"] },
   { }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Solemn Recruit": { "p1p1": 1 } },
   "pt": { "Solemn Recruit": [3, 3] }
  }
 },
 {
  "name": "no permanent left the battlefield: no counter",
  "players": [
   { "battlefield": ["Plains", "Plains", "Plains", "Solemn Recruit"] },
   { }
  ],
  "steps": [
   { "advance_to": "End" }
  ],
  "expect": {
   "pt": { "Solemn Recruit": [2, 2] }
  }
 },
 {
  "name": "ruling: a permanent leaving after the end step began does not satisfy revolt",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Solemn Recruit", "Grizzly Bears"] }, {} ],
  "steps": [
   { "advance_to": "End" },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Solemn Recruit": [2, 2] }
  }
 },
 {
  "name": "ruling: sacrificing a permanent as a cost satisfies revolt",
  "players": [ { "battlefield": ["Canonized in Blood", "Solemn Recruit", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
  "steps": [
   { "activate": "Canonized in Blood", "ability": 0 },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Solemn Recruit": { "p1p1": 1 } },
   "pt": { "Solemn Recruit": [3, 3] }
  }
 },
 {
  "name": "ruling: several permanents leaving still give only one counter",
  "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Solemn Recruit", "Grizzly Bears", "Grizzly Bears"] }, {} ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Solemn Recruit": { "p1p1": 1 } },
   "pt": { "Solemn Recruit": [3, 3] }
  }
 }
]
