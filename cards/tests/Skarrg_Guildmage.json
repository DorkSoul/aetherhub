[
  { "name": "creatures you control gain trample until end of turn",
    "players": [ { "battlefield": ["Skarrg Guildmage", "Grizzly Bears", "Mountain", "Forest"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [
      { "activate": "Skarrg Guildmage", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 19, "graveyard": ["Llanowar Elves"] } ] } },
  { "name": "target land becomes a 4/4 creature until end of turn and stays a land",
    "players": [ { "battlefield": ["Skarrg Guildmage", "Forest", "Mountain", "Plains"] }, {} ],
    "steps": [ { "activate": "Skarrg Guildmage", "ability": 1, "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "pt": { "Forest": [4, 4] }, "players": [ {}, {} ] } },
  { "name": "cannot animate a land with only two lands available",
    "players": [ { "battlefield": ["Skarrg Guildmage", "Forest", "Mountain"] }, {} ],
    "steps": [ { "activate": "Skarrg Guildmage", "ability": 1, "targets": ["Forest"], "illegal": true } ],
    "expect": { "players": [ {}, {} ] } },
  { "name": "ruling: a land animated after the trample ability resolved does not gain trample",
    "players": [ { "battlefield": ["Skarrg Guildmage", "Grizzly Bears", "Mountain", "Mountain", "Forest", "Forest", "Plains", "Plains", "Island"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [
      { "activate": "Skarrg Guildmage", "ability": 0 },
      { "resolve": true },
      { "activate": "Skarrg Guildmage", "ability": 1, "targets": ["Island"] },
      { "resolve": true },
      { "attack": [ { "card": "Island", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Island" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Island"] }, { "life": 18, "graveyard": ["Llanowar Elves"] } ] } }
]
