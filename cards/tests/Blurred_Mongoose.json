[
  {
    "name": "a counterspell cannot counter it",
    "players": [
      {
        "hand": [
          "Blurred Mongoose"
        ],
        "battlefield": [
          "Forest",
          "Forest"
        ]
      },
      {
        "hand": [
          "Counterspell"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Blurred Mongoose"
      },
      {
        "cast": "Counterspell",
        "player": 1,
        "targets": [
          {
            "stack": "Blurred Mongoose"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Blurred Mongoose"
          ]
        },
        {
          "graveyard_has": [
            "Counterspell"
          ]
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "shroud: a creature-only removal spell has no legal target",
    "players": [
      {
        "battlefield": [
          "Blurred Mongoose"
        ]
      },
      {
        "hand": [
          "Doom Blade"
        ],
        "battlefield": [
          "Swamp",
          "Swamp"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Doom Blade",
        "player": 1,
        "targets": [
          "Blurred Mongoose"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Blurred Mongoose"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a spell can target it on the stack; shroud applies once it is on the battlefield",
    "players": [
      { "hand": ["Blurred Mongoose"], "battlefield": ["Forest", "Forest"] },
      { "hand": ["Counterspell", "Doom Blade"], "battlefield": ["Island", "Island", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Blurred Mongoose" },
      { "cast": "Counterspell", "player": 1, "targets": [ { "stack": "Blurred Mongoose" } ] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Blurred Mongoose"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Blurred Mongoose"] },
        { "graveyard_has": ["Counterspell"], "hand": ["Doom Blade"] }
      ],
      "stack_empty": true
    }
  }
]
