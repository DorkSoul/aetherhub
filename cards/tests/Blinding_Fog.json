  "expect": {
   "players": [ { "graveyard": ["Blinding Fog"] }, { "hand": ["Doom Blade"] } ]
  }
 },
  {
    "name": "ruling: a creature that comes under my control after Blinding Fog still has damage to it prevented this turn",
    "players": [
      { "hand": ["Blinding Fog", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Plains"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Blinding Fog" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Shock"] } ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: a creature that comes under my control after Blinding Fog does not gain hexproof",
    "players": [
      { "hand": ["Blinding Fog", "Grizzly Bears"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Plains"] },
      { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Blinding Fog" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] },
        { "graveyard_has": ["Doom Blade"] }
      ]
    }
  }
]
