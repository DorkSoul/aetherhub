 {
  "name": "does not prevent damage dealt to players",
  "players": [
   {
    "hand": ["Blinding Fog", "Shock"],
    "battlefield": ["Forest", "Forest", "Forest", "Mountain"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "cast": "Blinding Fog" },
   { "resolve": true },
   { "cast": "Shock", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Blinding Fog", "Shock"] }, { "life": 18 } ]
  }
 },
 {
  "name": "creatures the caster controls gain hexproof: opponent cannot target them",
  "players": [
   {
    "hand": ["Blinding Fog"],
    "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"]
   },
   {
    "hand": ["Doom Blade"],
    "battlefield": ["Swamp"]
   }
  ],
  "steps": [
   { "cast": "Blinding Fog" },
   { "resolve": true },
