[
 {
  "name": "entering exiles every graveyard",
  "players": [
   { "hand": [ "Bazaar of Wonders" ], "battlefield": [ "Island", "Island", "Island", "Island", "Island" ], "graveyard": [ "Grizzly Bears" ] },
   { "graveyard": [ "Lightning Bolt", "Hill Giant" ] }
  ],
  "steps": [
   { "cast": "Bazaar of Wonders" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": [ "Bazaar of Wonders" ], "graveyard": [], "exile": [ "Grizzly Bears" ] }, { "graveyard": [], "exile": [ "Lightning Bolt", "Hill Giant" ] } ] }
 },
 {
  "name": "a second spell with the name of a card in a graveyard is countered",
  "players": [
   { "hand": [ "Lightning Bolt", "Lightning Bolt" ], "battlefield": [ "Bazaar of Wonders", "Mountain", "Mountain" ] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": [ "p1" ] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": [ "p1" ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": [ "Lightning Bolt", "Lightning Bolt" ] }, { "life": 17 } ] }
 },
 {
  "name": "the first spell of a name resolves when nothing with that name is in a graveyard or on the battlefield",
  "players": [
   { "hand": [ "Lightning Bolt" ], "battlefield": [ "Bazaar of Wonders", "Mountain" ] },
   { "graveyard": [ "Hill Giant" ] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": [ "p1" ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": [ "Lightning Bolt" ] }, { "life": 17 } ] }
 },
 {
  "name": "a spell with the name of a nontoken permanent on the battlefield is countered",
  "players": [
   { "hand": [ "Grizzly Bears" ], "battlefield": [ "Bazaar of Wonders", "Forest", "Forest" ] },
   { "battlefield": [ "Grizzly Bears" ] }
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_lacks": [ "Grizzly Bears" ], "graveyard": [ "Grizzly Bears" ] }, { "battlefield": [ "Grizzly Bears" ] } ] }
 },
 {
  "name": "an opponent's spell with a graveyard name is countered too",
  "start": "Upkeep",
  "players": [
   { "battlefield": [ "Bazaar of Wonders" ], "graveyard": [ "Lightning Bolt" ] },
   { "hand": [ "Lightning Bolt" ], "battlefield": [ "Mountain" ] }
  ],
  "steps": [
   { "pass": true },
   { "player": 1, "cast": "Lightning Bolt", "targets": [ "p0" ] },
   { "resolve": true }
  ],
  "expect": { "players": [ { "life": 20 }, { "graveyard": [ "Lightning Bolt" ] } ] }
 },
 {
  "name": "world rule: the older world permanent goes to the graveyard (and the entering Bazaar then exiles it)",
  "players": [
   { "hand": [ "Bazaar of Wonders" ], "battlefield": [ "Island", "Island", "Island", "Island", "Island", "Concordant Crossroads" ] },
   {}
  ],
  "steps": [
   { "cast": "Bazaar of Wonders" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": [ "Bazaar of Wonders" ], "battlefield_lacks": [ "Concordant Crossroads" ], "exile": [ "Concordant Crossroads" ] }, {} ] }
 },
 {
  "name": "ruling: a second world permanent entering puts the Bazaar into its owner's graveyard",
  "players": [
   { "hand": [ "Mystic Decree" ], "battlefield": [ "Bazaar of Wonders", "Island", "Island", "Island", "Island" ] },
   {}
  ],
  "steps": [
   { "cast": "Mystic Decree" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": [ "Mystic Decree" ], "battlefield_lacks": [ "Bazaar of Wonders" ], "graveyard_has": [ "Bazaar of Wonders" ] }, {} ] }
 }
]
