[
  { "name": "up to one target creature must attack if able at the beginning of combat",
    "players": [ { "battlefield": ["Boros Battleshaper", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "a targeted creature that can't attack is not declared; the other creature must attack",
    "players": [ { "battlefield": ["Boros Battleshaper", "Grizzly Bears", "Hill Giant"] }, { "battlefield": ["Aardvark Sloth"] } ],
    "steps": [ { "advance_to": "BeginCombat", "targets": ["Hill Giant", "Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ], "illegal": true }, { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 17 } ] } },
  { "name": "with no targets chosen, attacking with nothing is legal",
    "players": [ { "battlefield": ["Boros Battleshaper", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "BeginCombat", "targets": [] }, { "resolve": true }, { "attack": [] } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: a creature forced to block must block if able (opponent's Hill Giant blocks Grizzly Bears)",
    "players": [ { "battlefield": ["Boros Battleshaper", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "advance_to": "BeginCombat", "targets": ["Hill Giant"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] , "player": 1 }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"] }, { "life": 20 } ] } }
]
