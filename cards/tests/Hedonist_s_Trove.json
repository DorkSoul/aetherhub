[
  {
    "name": "ETB exiles the target opponent's graveyard",
    "players": [
      { "hand": ["Hedonist's Trove"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "graveyard": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "cast": "Hedonist's Trove" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hedonist's Trove"] },
        { "graveyard": [], "exile": ["Grizzly Bears", "Forest"] }
      ]
    }
  },
  {
    "name": "may play a land exiled with it",
    "players": [
      { "hand": ["Hedonist's Trove"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "graveyard": ["Forest"] }
    ],
    "steps": [
      { "cast": "Hedonist's Trove" },
      { "resolve": true },
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hedonist's Trove", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "only one nonland spell from the exile each turn",
    "players": [
      { "hand": ["Hedonist's Trove"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest"] },
      { "graveyard": ["Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Hedonist's Trove" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hedonist's Trove", "Grizzly Bears"] },
        { "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "a land can be played on the same turn as a nonland spell from the exile",
    "players": [
      { "hand": ["Hedonist's Trove"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Forest", "Forest"] },
      { "graveyard": ["Grizzly Bears", "Forest"] }
    ],
    "steps": [
      { "cast": "Hedonist's Trove" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hedonist's Trove", "Grizzly Bears", "Forest"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: only one land can be played from the exile per turn",
    "players": [
      { "hand": ["Hedonist's Trove"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "graveyard": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Hedonist's Trove" },
      { "resolve": true },
      { "play_land": "Forest" },
      { "play_land": "Forest", "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hedonist's Trove", "Forest"] },
        { "exile": ["Forest"] }
      ]
    }
  }
]
