[
  { "name": "enters: creates a 1/1 red Goblin token",
    "players": [ { "hand": ["Mogg War Marshal"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Mogg War Marshal" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mogg War Marshal", "Goblin"] }, {} ], "pt": { "Goblin": [1, 1] } } },
  { "name": "dies: creates a Goblin token when it is killed",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Mogg War Marshal" }, "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Mogg War Marshal"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Mogg War Marshal"], "battlefield_has": ["Goblin"] }, {} ] } },
  { "name": "echo: paying {1}{R} keeps the Marshal",
    "players": [ { "hand": ["Mogg War Marshal"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Mogg War Marshal" },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": { "players": [ { "battlefield_has": ["Mogg War Marshal"] }, {} ] } },
  { "name": "echo: not paying sacrifices the Marshal",
    "players": [ { "hand": ["Mogg War Marshal"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Mogg War Marshal" },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": { "players": [ { "graveyard": ["Mogg War Marshal"] }, {} ] } }
]
