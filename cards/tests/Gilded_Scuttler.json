[
 { "name": "ETB taps an opposing creature and puts a stun counter on it",
   "players": [ { "hand": ["Gilded Scuttler"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Gilded Scuttler" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 1 } } } },
 { "name": "stun counter is added even to an already tapped creature",
   "players": [ { "hand": ["Gilded Scuttler"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "cast": "Gilded Scuttler" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 1 } } } },
 { "name": "no opposing creature: nothing happens to own creature",
   "players": [ { "hand": ["Gilded Scuttler"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Gilded Scuttler" }, { "resolve": true } ],
   "expect": { "counters": {}, "tapped": { "Grizzly Bears": false } } },
 { "name": "ruling: the target may already be tapped; it still gets the stun counter",
   "players": [ { "hand": ["Gilded Scuttler"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
   "steps": [ { "cast": "Gilded Scuttler" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true }, "counters": { "Grizzly Bears": { "stun": 1 } } } }
]
