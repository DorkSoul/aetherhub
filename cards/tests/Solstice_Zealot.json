[
  { "name": "enters: you get two energy",
    "players": [ { "hand": ["Solstice Zealot"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Solstice Zealot" }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 2, "battlefield_has": ["Solstice Zealot"] }, {} ] } },
  { "name": "T, pay E: tap target creature",
    "players": [ { "hand": ["Solstice Zealot"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Solstice Zealot" }, { "resolve": true }, { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Solstice Zealot", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 1 }, {} ], "tapped": { "Grizzly Bears": true, "Solstice Zealot": true } } },
  { "name": "cannot activate without energy",
    "players": [ { "battlefield": [ { "name": "Solstice Zealot", "sick": false } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Solstice Zealot", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": false } } },
  { "name": "ruling: energy stays after the turn ends",
    "players": [ { "hand": ["Solstice Zealot"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Solstice Zealot" }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "energy": 2 }, {} ] } }
]
