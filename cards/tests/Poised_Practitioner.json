[
  {
    "name": "second spell each turn puts a +1/+1 counter on it",
    "players": [{ "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Poised Practitioner"] }, {}],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{}, {}], "counters": { "Poised Practitioner": { "p1p1": 1 } } }
  },
  {
    "name": "first spell each turn does not trigger flurry",
    "players": [{ "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Poised Practitioner"] }, {}],
    "steps": [{ "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }],
    "expect": { "players": [{}, {}], "pt": { "Poised Practitioner": [2, 3] } }
  },
  {
    "name": "ruling: a spell cast before the flurry creature counts toward the second spell",
    "players": [{ "hand": ["Poised Practitioner", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Mountain"] }, {}],
    "steps": [
      { "cast": "Poised Practitioner" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "life": 17 }], "counters": { "Poised Practitioner": { "p1p1": 1 } } }
  }
]
