   { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
   { "cast": "Melee" },
   { "resolve": true },
   { "pass": true },
   { "block": [ { "blocker": "Runeclaw Bear", "attacker": "Hill Giant" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Hill Giant", "Grizzly Bears"] }, { "life": 20 } ],
