[
  {
    "name": "valiant: first targeting spell each turn adds a +1/+1 counter, the second does not",
    "players": [
      { "hand": ["Giant Growth", "Giant Growth"], "battlefield": ["Mountain", "Plains", "Forest", "Forest", "Seedglaive Mentor"] },
      {}
    ],
    "steps": [
      { "cast": "Giant Growth", "targets": ["Seedglaive Mentor"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Seedglaive Mentor"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Seedglaive Mentor": [10, 9] }
    }
  },
  {
    "name": "ruling: the valiant trigger resolves before the Shock, so the 4/3 survives 2 damage",
    "players": [
      { "hand": ["Shock"], "battlefield": ["Mountain", "Seedglaive Mentor"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Seedglaive Mentor"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Seedglaive Mentor"] }, {} ],
      "pt": { "Seedglaive Mentor": [4, 3] }
    }
  },
  {
    "name": "ruling: my Shock retargeted by my Redirect to my valiant creature triggers valiant",
    "players": [
      { "hand": ["Shock", "Redirect"], "battlefield": ["Mountain", "Island", "Island", "Seedglaive Mentor"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "cast": "Redirect", "targets": [{ "stack": "Shock" }] },
      { "resolve": true, "answers": ["Seedglaive Mentor"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Seedglaive Mentor"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "pt": { "Seedglaive Mentor": [4, 3] }
    }
  },
  {
    "name": "ruling: a copy of my Shock given a valiant creature as its new target triggers valiant",
    "players": [
      { "hand": ["Shock", "Twincast"], "battlefield": ["Mountain", "Island", "Island", "Seedglaive Mentor"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "cast": "Twincast", "targets": [{ "stack": "Shock" }] },
      { "resolve": true, "answers": ["Seedglaive Mentor"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Seedglaive Mentor"] }, { "graveyard": ["Grizzly Bears"] } ],
      "pt": { "Seedglaive Mentor": [4, 3] }
    }
  }
]
