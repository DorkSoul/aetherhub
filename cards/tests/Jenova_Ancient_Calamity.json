        "targets": ["Grizzly Bears"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "battlefield_has": ["Jenova, Ancient Calamity"]
        },
        {
          "graveyard_has": ["Grizzly Bears"]
        }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: counters use Jenova's power as it last existed when Jenova leaves before its trigger resolves",
    "players": [
      { "battlefield": ["Jenova, Ancient Calamity", "Forest", "Swamp", "Mountain", "Grizzly Bears"] },
      { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Murder", "targets": ["Jenova, Ancient Calamity"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Jenova, Ancient Calamity"] },
        { "graveyard_has": ["Murder"] }
      ],
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "stack_empty": true
    }
  },
  {
    "name": "ruling: a Mutant that dies on your turn draws cards equal to its power as it last existed, counters included",
    "players": [
      { "hand": ["Murder"], "battlefield": ["Jenova, Ancient Calamity", "Swamp", "Swamp", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] },
