[
  {
    "name": "beginning of combat: counters equal to its power on another target creature, which becomes a Mutant",
    "players": [
      {
        "hand": [],
        "battlefield": ["Jenova, Ancient Calamity", "Forest", "Swamp", "Mountain", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
