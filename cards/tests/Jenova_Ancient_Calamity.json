      "stack_empty": true
    }
  },
  {
    "name": "a Mutant you control dies on your turn: draw cards equal to its power (3 with the counter)",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Jenova, Ancient Calamity", "Mountain", "Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "BeginCombat",
        "targets": ["Grizzly Bears"]
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": ["Grizzly Bears"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3,
          "graveyard_has": ["Lightning Bolt", "Grizzly Bears"],
          "battlefield_has": ["Jenova, Ancient Calamity"]
        },
        {}
      ],
      "stack_empty": true
    }
  },
  {
    "name": "up to one: with no target chosen no creature becomes a Mutant or gets counters",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Jenova, Ancient Calamity", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      {
        "advance_to": "BeginCombat"
      },
      {
        "resolve": true
      },
      {
