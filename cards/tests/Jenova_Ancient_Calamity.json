        "advance_to": "BeginCombat",
        "targets": ["Grizzly Bears"]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Jenova, Ancient Calamity", "Grizzly Bears"]
