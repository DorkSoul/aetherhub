[
  { "name": "puts target nonland permanent on top of its owner's library",
    "players": [ { "hand": ["Vanishment"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Vanishment", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Vanishment"] }, { "battlefield_lacks": ["Grizzly Bears"], "library_count": 21, "hand_count": 0 } ] } },
  { "name": "a land is not a legal target",
    "players": [ { "hand": ["Vanishment"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "cast": "Vanishment", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Vanishment"] }, { "battlefield_has": ["Forest"] } ] } },
  { "name": "miracle: first card drawn this turn is cast for {U} and puts a creature on top of its owner's library",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Island"], "library": ["Vanishment", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Vanishment", "Tormenting Voice"] }, { "battlefield_lacks": ["Grizzly Bears"], "library_count": 21 } ] } },
  { "name": "miracle is declined: Vanishment stays in hand and the creature stays",
    "players": [ { "hand": ["Tormenting Voice", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Island"], "library": ["Vanishment", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Tormenting Voice" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Vanishment", "Forest"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
