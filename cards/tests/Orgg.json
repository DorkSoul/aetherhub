[
  { "name": "attacks when the defending player's creatures all have power 2 or less",
    "players": [ { "battlefield": ["Orgg"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Orgg", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 14 } ] } },
  { "name": "Orgg can't block a power 3 attacker, so it goes through",
    "players": [ { "battlefield": ["Hill Giant"] }, { "battlefield": ["Orgg"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "can't attack while the defender has an untapped power-3 creature: Orgg stays home, Grizzly Bears hits (2)",
    "players": [ { "battlefield": [ { "name": "Orgg", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Orgg", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "tapped": { "Orgg": false }, "players": [ {}, { "life": 18 } ] } },
  { "name": "can't block a power-3 attacker: Hill Giant unblocked, Grizzly Bears blocked by Orgg's partner",
    "players": [ { "battlefield": [ { "name": "Hill Giant", "sick": false }, { "name": "Savannah Lions", "sick": false } ] }, { "battlefield": ["Orgg", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
               { "block": [ { "blocker": "Orgg", "attacker": "Hill Giant" }, { "blocker": "Grizzly Bears", "attacker": "Savannah Lions" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17, "battlefield_has": ["Orgg"] } ] } },
  { "name": "ruling: a summoning-sick power-3 creature on the defender's side still stops Orgg attacking",
    "players": [ { "battlefield": [ { "name": "Orgg", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] }, { "battlefield": [ { "name": "Hill Giant", "sick": true } ] } ],
    "steps": [ { "attack": [ { "card": "Orgg", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "tapped": { "Orgg": false }, "players": [ {}, { "life": 18 } ] } }
]
