[
  { "name": "becomes blocked: untaps each creature you control (ExtraCombat untap)",
    "players": [ { "battlefield": ["Anzrag, the Quake-Mole", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Anzrag, the Quake-Mole", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Anzrag, the Quake-Mole" } ] }, { "resolve": true } ],
    "expect": { "tapped": { "Anzrag, the Quake-Mole": false } } },
  { "name": "{3}{R}{R}{G}{G}: must be blocked this turn",
    "players": [ { "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Island", "Island", "Island", "Anzrag, the Quake-Mole"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Anzrag, the Quake-Mole", "ability": 0 }, { "resolve": true }, { "attack": [ { "card": "Anzrag, the Quake-Mole", "at": "p1" } ] }, { "block": [], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Anzrag, the Quake-Mole"] }, {} ] } },
  { "name": "ruling: with no creature able to block, the must-be-blocked effect leaves Anzrag unblocked",
    "players": [ { "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Island", "Island", "Island", "Anzrag, the Quake-Mole"] },
                 { "battlefield": [ { "name": "Hill Giant", "tapped": true } ] } ],
    "steps": [ { "activate": "Anzrag, the Quake-Mole", "ability": 0 }, { "resolve": true },
               { "attack": [ { "card": "Anzrag, the Quake-Mole", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 12 } ] } },
  { "name": "ruling: one blocker satisfies the must-be-blocked effect; the other creatures need not block",
    "players": [ { "battlefield": ["Mountain", "Mountain", "Forest", "Forest", "Island", "Island", "Island", "Anzrag, the Quake-Mole"] },
                 { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Anzrag, the Quake-Mole", "ability": 0 }, { "resolve": true },
               { "attack": [ { "card": "Anzrag, the Quake-Mole", "at": "p1" } ] },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Anzrag, the Quake-Mole" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20, "battlefield_lacks": ["Hill Giant"], "battlefield_has": ["Grizzly Bears"] } ] } }
]
