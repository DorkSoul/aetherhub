[
 {
  "name": "gain life equal to life lost this turn",
  "players": [
   { "hand": ["Blightning", "Forest", "Island"], "battlefield": ["Swamp", "Mountain", "Island", "Children of Korlis"] },
   {}
  ],
  "steps": [
   { "cast": "Blightning", "targets": ["p0"] },
   { "resolve": true },
   { "activate": "Children of Korlis", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20, "graveyard": ["Blightning", "Forest", "Island", "Children of Korlis"] }, {} ]
  }
 },
 {
  "name": "no life lost: gain nothing",
  "players": [
   { "battlefield": ["Children of Korlis"] },
   {}
  ],
  "steps": [
   { "activate": "Children of Korlis", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 20 }, {} ]
  }
 },
 {
  "name": "ruling: life gained is based on total life lost, not net change",
  "players": [
   { "hand": ["Lightning Bolt", "Lightning Helix"], "battlefield": ["Children of Korlis", "Mountain", "Mountain", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p0"] },
   { "resolve": true },
   { "cast": "Lightning Helix", "targets": ["p1"] },
   { "resolve": true },
   { "activate": "Children of Korlis", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 23, "graveyard": ["Lightning Bolt", "Lightning Helix", "Children of Korlis"] }, { "life": 17 } ]
  }
 }
]
