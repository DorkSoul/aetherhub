[
 { "name": "sacrificing another permanent and paying deals 2 damage",
   "players": [ { "battlefield": ["Furnace Celebration", "Mind Stone", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [
     { "activate": "Mind Stone", "targets": ["p1"] }, { "resolve": true, "answers": [true] } ],
   "expect": { "players": [ { "graveyard": ["Mind Stone"], "hand_count": 1 }, { "life": 18 } ], "stack_empty": true } },
 { "name": "declining to pay deals no damage",
   "players": [ { "battlefield": ["Furnace Celebration", "Mind Stone", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [
     { "activate": "Mind Stone", "targets": ["p1"] }, { "resolve": true, "answers": [false] } ],
   "expect": { "players": [ { "graveyard": ["Mind Stone"] }, { "life": 20 } ], "stack_empty": true } },
 { "name": "sacrificing the enchantment itself does not trigger (opponent's sacrifice neither)",
   "players": [ { "battlefield": ["Furnace Celebration", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Mind Stone", "Mountain"] } ],
   "steps": [ { "pass": true }, { "activate": "Mind Stone", "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 20 } ], "stack_empty": true } },
 { "name": "ruling: target that became illegal before the trigger resolves takes no damage and no payment",
   "players": [ { "battlefield": ["Furnace Celebration", "Mind Stone", "Mountain", "Mountain", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
   "steps": [
     { "activate": "Mind Stone", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "hand_count": 1 }, { "graveyard": ["Grizzly Bears", "Lightning Bolt"] } ], "stack_empty": true } }
]
