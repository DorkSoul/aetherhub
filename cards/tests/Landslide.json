[
  { "name": "sacrifice two Mountains to deal 2 damage to target player",
    "players": [ { "hand": ["Landslide"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Landslide", "targets": ["p1"] }, { "resolve": true, "answers": [["Mountain", "Mountain"]] } ],
    "expect": { "players": [ { "graveyard": ["Landslide", "Mountain", "Mountain"], "battlefield": [] }, { "life": 18 } ] } },
  { "name": "sacrificing no Mountains deals no damage",
    "players": [ { "hand": ["Landslide"], "battlefield": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Landslide", "targets": ["p1"] }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "graveyard": ["Landslide"], "battlefield": ["Mountain"] }, { "life": 20 } ] } },
  { "name": "ruling: Mountains are sacrificed during resolution, so countering Landslide sacrifices none",
    "players": [ { "hand": ["Landslide"], "battlefield": ["Mountain", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Landslide", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Landslide" }] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Landslide"], "battlefield": ["Mountain", "Mountain"] }, { "life": 20, "graveyard": ["Counterspell"] } ] } }
]
