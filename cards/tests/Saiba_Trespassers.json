[
  { "name": "channel taps up to two target creatures you don't control",
    "players": [ { "hand": ["Saiba Trespassers"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
    "steps": [ { "activate": "Saiba Trespassers", "ability": 0, "targets": ["Grizzly Bears", "Llanowar Elves"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "graveyard": ["Saiba Trespassers"] }, {} ], "tapped": { "Grizzly Bears": true, "Llanowar Elves": true } } },
  { "name": "channel can target just one creature",
    "players": [ { "hand": ["Saiba Trespassers"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
    "steps": [ { "activate": "Saiba Trespassers", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Saiba Trespassers"] }, {} ], "tapped": { "Grizzly Bears": true, "Llanowar Elves": false } } },
  { "name": "channel works only from hand",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Saiba Trespassers"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Saiba Trespassers", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Saiba Trespassers"] }, {} ], "tapped": { "Grizzly Bears": false } } },
  { "name": "ruling: the discard is paid as a cost, so Saiba is in the graveyard before the channel resolves",
    "players": [ { "hand": ["Saiba Trespassers"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Saiba Trespassers", "ability": 0, "targets": ["Grizzly Bears"] } ],
    "expect": { "players": [ { "hand": [], "graveyard": ["Saiba Trespassers"] }, {} ], "tapped": { "Grizzly Bears": false } } }
]
