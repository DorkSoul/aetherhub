[
  {
    "name": "counts card types among opponents' graveyards only",
    "players": [
      {
        "battlefield": [
          "Nighthawk Scavenger"
        ],
        "graveyard": [
          "Lightning Bolt",
          "Grizzly Bears"
        ]
      },
      {
        "graveyard": [
          "Sol Ring",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Nighthawk Scavenger": [
          3,
          3
        ]
      }
    }
  },
  {
    "name": "cards in your own graveyard do not count",
    "players": [
      {
        "battlefield": [
          "Nighthawk Scavenger"
        ],
        "graveyard": [
          "Lightning Bolt",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Nighthawk Scavenger": [
          1,
          3
        ]
      }
    }
  },
  {
    "name": "counts types, not cards (repeated cards of one type count once)",
    "players": [
      {
        "battlefield": [
          "Nighthawk Scavenger"
        ]
      },
      {
        "graveyard": [
          "Sol Ring",
          "Grizzly Bears",
          "Lightning Bolt",
          "Lightning Bolt"
        ]
      }
    ],
    "steps": [],
    "expect": {
      "pt": {
        "Nighthawk Scavenger": [
          4,
          3
        ]
      }
    }
  },
  {
    "name": "ruling: many cards of the same two types still count each type once (3/3)",
    "players": [
      { "battlefield": ["Nighthawk Scavenger"] },
      { "graveyard": ["Sol Ring", "Sol Ring", "Sol Ring", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] }
    ],
    "steps": [],
    "expect": { "pt": { "Nighthawk Scavenger": [3, 3] } }
  },
  {
    "name": "ruling: subtypes (Rogue, Bird) and the basic supertype are not card types",
    "players": [
      { "battlefield": ["Nighthawk Scavenger"] },
      { "graveyard": ["Aven Interrupter", "Island"] }
    ],
    "steps": [],
    "expect": { "pt": { "Nighthawk Scavenger": [3, 3] } }
  }
]
