[
  {
    "name": "ETB deals 2 damage to any target",
    "players": [ { "hand": ["Twinshot Sniper"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Twinshot Sniper" }, { "resolve": true, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Twinshot Sniper"] }, { "life": 18 } ] }
  },
  {
    "name": "channel: discard for 2 damage to any target",
    "players": [ { "hand": ["Twinshot Sniper"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Twinshot Sniper", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Twinshot Sniper"] }, { "life": 18 } ] }
  },
  {
    "name": "channel needs {1}{R}",
    "players": [ { "hand": ["Twinshot Sniper"], "battlefield": ["Mountain"] }, {} ],
    "steps": [ { "activate": "Twinshot Sniper", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Twinshot Sniper"] }, { "life": 20 } ] }
  },
  {
    "name": "ruling: the discard is the cost, so the card is in the graveyard while the channel ability is on the stack",
    "players": [ { "hand": ["Twinshot Sniper"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Twinshot Sniper", "targets": ["p1"] } ],
    "expect": { "stack_empty": false, "players": [ { "graveyard": ["Twinshot Sniper"], "hand_count": 0 }, { "life": 20 } ] }
  }
]
