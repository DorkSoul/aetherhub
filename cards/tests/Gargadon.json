[
 { "name": "suspend 4 for {1}{R}",
   "players": [ { "hand": ["Gargadon"], "battlefield": ["Mountain", "Mountain"] }, {} ],
   "steps": [ { "activate": "Gargadon" }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Gargadon"], "hand": [] }, {} ] } },
 { "name": "cannot suspend without {1}{R}",
   "players": [ { "hand": ["Gargadon"], "battlefield": ["Mountain"] }, {} ],
   "steps": [ { "activate": "Gargadon", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Gargadon"] }, {} ] } },
 { "name": "ruling: last time counter removed, declining the cast leaves the card exiled",
   "players": [ { "exile": [{ "name": "Gargadon", "counters": { "time": 1 } }], "battlefield": ["Mountain", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
   "expect": { "players": [ { "exile": ["Gargadon"], "battlefield_has": [] }, {} ] } },
 { "name": "ruling: a card cast from suspend has haste and can attack the turn it is cast",
   "players": [ { "exile": [{ "name": "Gargadon", "counters": { "time": 1 } }], "battlefield": ["Mountain", "Mountain"] }, {} ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true }, { "advance_to": "Main1" }, { "attack": [{ "card": "Gargadon", "at": "p1" }] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Gargadon"] }, { "life": 13 } ] } }
]
