[
  { "name": "sacrifice: gain control of a creature with power <= treasure counters",
    "players": [ { "battlefield": [ { "name": "Legacy's Allure", "counters": { "treasure": 2 } } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Legacy's Allure", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Legacy's Allure"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "cannot target a creature with more power than the counters",
    "players": [ { "battlefield": [ { "name": "Legacy's Allure", "counters": { "treasure": 1 } } ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Legacy's Allure", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ] },
  { "name": "your upkeep: may put a treasure counter on it",
    "players": [ { "battlefield": ["Legacy's Allure"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Legacy's Allure": { "treasure": 1 } } } },
  { "name": "your upkeep: declining the treasure counter adds nothing",
    "players": [ { "battlefield": ["Legacy's Allure"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Legacy's Allure"] }, {} ], "counters": { "Legacy's Allure": { "treasure": 0 } } } },
  { "name": "ruling: power raised in response makes the target illegal on resolution; the card stays in the graveyard",
    "players": [ { "hand": ["Giant Growth"], "battlefield": [ { "name": "Legacy's Allure", "counters": { "treasure": 2 } }, "Forest" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Legacy's Allure", "ability": 0, "targets": ["Grizzly Bears"] }, { "cast": "Giant Growth", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Legacy's Allure", "Giant Growth"], "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
