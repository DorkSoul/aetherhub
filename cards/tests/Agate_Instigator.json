[
 {
  "name": "another creature entering deals 1 damage to each opponent",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Agate Instigator", "Forest", "Forest"] },
   {}
  ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Agate Instigator"] }, { "life": 19 } ] }
 },
 {
  "name": "itself entering does not trigger",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
   {}
  ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ {}, { "life": 17 } ] }
 },
 {
  "name": "offspring creates a token copy that triggers the original's damage",
  "players": [
   { "hand": ["Agate Instigator"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [ { "cast": "Agate Instigator", "answers": [true] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Agate Instigator"] }, { "life": 19 } ] }
 },
 {
  "name": "ruling: a countered creature spell with offspring makes no token and no trigger",
  "players": [
   { "hand": ["Agate Instigator"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
   { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Agate Instigator", "answers": [true] },
   { "cast": "Counterspell", "targets": [{ "stack": "Agate Instigator" }], "player": 1 },
   { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Agate Instigator"], "battlefield_lacks": ["Agate Instigator"] }, { "life": 20 } ] }
 }
]
