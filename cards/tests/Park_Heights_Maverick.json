[
  { "name": "dethrone counter when attacking the player tied for most life, then proliferates on combat damage",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false}] }, {} ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "counters": { "Park Heights Maverick": { "p1p1": 2 } }, "players": [ {}, { "life": 17 } ] } },
  { "name": "power 2 creature cannot block it",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false}] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "power 3 creature can block it",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false}] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Park Heights Maverick" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Park Heights Maverick"] }, { "graveyard_has": ["Hill Giant"] } ] } },
  { "name": "power 2 Grizzly Bears cannot block it: Maverick (3/3 after dethrone) unblocked with Hill Giant: 14 life",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false}, {"name": "Hill Giant", "sick": false}] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Park Heights Maverick" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 14 } ] } },
  { "name": "ruling: proliferate gives another counter of each kind a permanent has",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false}] }, { "battlefield": [{"name": "Grizzly Bears", "sick": false, "counters": {"p1p1": 1, "charge": 2}}] } ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "counters": { "Grizzly Bears": { "p1p1": 2, "charge": 3 } }, "players": [ {}, { "life": 17 } ] } },
  { "name": "ruling: proliferate can choose opponent's permanents and players with counters",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false}] }, { "battlefield": [{"name": "Grizzly Bears", "sick": false, "counters": {"p1p1": 1}}], "poison": 1 } ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "counters": { "Park Heights Maverick": { "p1p1": 2 }, "Grizzly Bears": { "p1p1": 2 } }, "players": [ {}, { "life": 17, "poison": 2 } ] } },
  { "name": "ruling: choosing no permanents or players to proliferate adds no counters",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false}] }, { "battlefield": [{"name": "Grizzly Bears", "sick": false, "counters": {"p1p1": 1}}], "poison": 1 } ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" } ] }, { "advance_to": "Main2", "answers": [[]] } ],
    "expect": { "counters": { "Park Heights Maverick": { "p1p1": 1 }, "Grizzly Bears": { "p1p1": 1 } }, "players": [ {}, { "life": 17, "poison": 1 } ] } },
  { "name": "ruling: a lethally blocked Maverick dies before its proliferate resolves, so the counter cannot save it",
    "players": [ { "battlefield": [{"name": "Park Heights Maverick", "sick": false, "counters": {"p1p1": 1}}] }, { "life": 10, "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Park Heights Maverick", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Park Heights Maverick" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard_has": ["Park Heights Maverick"] }, { "graveyard_has": ["Hill Giant"] } ] } }
]
