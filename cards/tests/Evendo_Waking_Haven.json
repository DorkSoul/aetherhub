[
  {
    "name": "station taps another creature and adds charge counters equal to its power",
    "players": [
      {
        "battlefield": [
          "Evendo, Waking Haven",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Evendo, Waking Haven"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true
      },
      "counters": {
        "Evendo, Waking Haven": {
          "charge": 2
        }
      }
    }
  },
  {
    "name": "below 12 charge counters no mana grant",
    "players": [
      {
        "battlefield": [
          {
            "name": "Evendo, Waking Haven",
            "counters": {
              "charge": 11
            },
            "tapped": false
          },
          "Grizzly Bears",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "tap_for_mana": "Forest"
      },
      {
        "activate": "Evendo, Waking Haven",
        "illegal": true,
        "ability": 32768
      }
    ],
    "expect": {
      "tapped": {
        "Evendo, Waking Haven": false
      }
    }
  },
  {
    "name": "station cost taps the creature, not the planet: it stays untapped",
    "players": [
      {
        "battlefield": [
          "Evendo, Waking Haven",
          {
            "name": "Grizzly Bears",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Evendo, Waking Haven",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Evendo, Waking Haven": false,
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "enters tapped when played",
    "players": [ { "hand": ["Evendo, Waking Haven"] }, {} ],
    "steps": [ { "play_land": "Evendo, Waking Haven" } ],
    "expect": { "players": [ { "battlefield_has": ["Evendo, Waking Haven"] }, {} ], "tapped": { "Evendo, Waking Haven": true } }
  },
  {
    "name": "at 12 charge counters, granted {G},{T}: Evendo adds G for each creature you control (2 Forests + Evendo make only 3 without it)",
    "players": [
      {
        "hand": ["Ambassador Oak"],
        "battlefield": [
          { "name": "Evendo, Waking Haven", "counters": { "charge": 12 }, "tapped": false },
          "Forest",
          "Forest",
          "Grizzly Bears",
          "Hill Giant",
          "Savannah Lions"
        ]
      },
      {}
    ],
    "steps": [
      { "cast": "Ambassador Oak" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Ambassador Oak", "Evendo, Waking Haven"] }, {} ] }
  }
]
