[
  {
    "name": "enchanted Forest becomes a Swamp",
    "players": [
      {
        "hand": [
          "Contaminated Ground"
        ],
        "battlefield": [
          "Swamp",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Contaminated Ground",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "attached": {
        "Contaminated Ground": "Forest"
      },
      "players": [
        {
          "life": 20
        },
        {}
      ]
    }
  },
  {
    "name": "tapping the enchanted land makes its controller lose 2 life",
    "players": [
      {
        "hand": [
          "Contaminated Ground"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Contaminated Ground",
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      },
      {
        "tap_for_mana": "Forest"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Forest": true
      },
      "players": [
        {
          "life": 18
        },
        {}
      ]
    }
  },
  {
    "name": "enchanted Forest is a Swamp with no green mana: Grizzly Bears can't be cast",
    "players": [
      { "hand": ["Contaminated Ground", "Grizzly Bears"], "battlefield": ["Swamp", "Swamp", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Contaminated Ground", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "enchanted Forest taps for black: Dark Ritual can be cast with it",
    "players": [
      { "hand": ["Contaminated Ground", "Dark Ritual"], "battlefield": ["Swamp", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Contaminated Ground", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Dark Ritual" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Dark Ritual"], "battlefield_has": ["Contaminated Ground"] }, {} ] }
  },
  {
    "name": "ruling: the enchanted Forest keeps its name",
    "players": [
      { "hand": ["Contaminated Ground"], "battlefield": ["Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Contaminated Ground", "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Contaminated Ground": "Forest" },
      "players": [ { "battlefield_has": ["Forest", "Swamp"] }, {} ]
    }
  },
  {
    "name": "ruling: tapping the enchanted land to pay for a spell costs its controller 2 life",
    "players": [
      { "hand": ["Contaminated Ground", "Grizzly Bears"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Contaminated Ground", "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 18, "battlefield_has": ["Grizzly Bears"] }, {} ]
    }
  }
]
