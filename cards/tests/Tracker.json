[
  { "name": "deals its power to the target and takes its power back",
    "players": [ { "battlefield": ["Forest", "Forest", "Tracker"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Tracker", "ability": 0, "targets": ["Hill Giant"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Tracker"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "needs GG to activate",
    "players": [ { "battlefield": ["Forest", "Tracker"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Tracker", "ability": 0, "targets": ["Hill Giant"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tracker"] }, {} ] } },
  { "name": "ruling: fizzles when its target leaves before the ability resolves, Tracker is not damaged",
    "players": [ { "battlefield": ["Forest", "Forest", "Mountain", "Tracker"], "hand": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Tracker", "ability": 0, "targets": ["Grizzly Bears"] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tracker"], "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: can target itself, dealing its power to itself and dying",
    "players": [ { "battlefield": ["Forest", "Forest", "Tracker"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Tracker", "ability": 0, "targets": ["Tracker"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Tracker"] }, { "battlefield_has": ["Hill Giant"] } ] } }
]
