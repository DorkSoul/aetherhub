[
  {
    "name": "enters and surveils 1 (the card goes to the graveyard)",
    "players": [
      { "hand": ["Nightblade Brigade"], "battlefield": ["Swamp", "Swamp", "Swamp"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Nightblade Brigade" },
      { "resolve": true, "answers": ["Forest"] }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Forest"], "battlefield_has": ["Nightblade Brigade"] }, {}]
    }
  },
  {
    "name": "mobilize: an attacking Warrior token joins the attack",
    "players": [
      { "battlefield": ["Nightblade Brigade"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Nightblade Brigade", "at": "p1" }] },
      { "block": [] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Nightblade Brigade", "Warrior 1-1 R"] }, { "life": 18 }]
    }
  },
  {
    "name": "ruling: tokens entering attacking do not trigger Hellrider's attack trigger",
    "players": [
      { "battlefield": ["Nightblade Brigade", "Hellrider"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Nightblade Brigade", "at": "p1" }, { "card": "Hellrider", "at": "p1" }] },
      { "block": [] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Nightblade Brigade", "Hellrider", "Warrior 1-1 R"] }, { "life": 13 }]
    }
  }
