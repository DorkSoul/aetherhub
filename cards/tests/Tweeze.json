[
  {
    "name": "deals 3 and draws after discarding",
    "players": [ { "hand": ["Tweeze", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Tweeze", "targets": ["p1"] }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "graveyard": ["Tweeze", "Grizzly Bears"], "hand_count": 1 }, { "life": 17 } ] }
  },
  {
    "name": "declining the discard draws nothing",
    "players": [ { "hand": ["Tweeze", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Tweeze", "targets": ["p1"] }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "graveyard": ["Tweeze"], "hand": ["Grizzly Bears"] }, { "life": 17 } ] }
  },
  {
    "name": "empty hand: no discard, no draw",
    "players": [ { "hand": ["Tweeze"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Tweeze", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Tweeze"], "hand_count": 0 }, { "life": 17 } ] }
  },
  {
    "name": "ruling: if the target is gone when Tweeze resolves, no discard or draw happens",
    "players": [ { "hand": ["Tweeze", "Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Tweeze", "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": { "players": [ { "graveyard": ["Tweeze", "Lightning Bolt"], "hand": ["Forest"] }, { "graveyard": ["Grizzly Bears"] } ] }
  }
]
