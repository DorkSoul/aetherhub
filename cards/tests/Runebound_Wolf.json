    "name": "ruling: Wolves are counted when the ability resolves (a Wolf killed in response is not counted)",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": [ { "name": "Runebound Wolf", "sick": false }, "Bounding Wolf", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain" ]
      },
      {}
    ],
    "steps": [
      { "activate": "Runebound Wolf", "ability": 0, "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["Bounding Wolf"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt", "Bounding Wolf"] }, { "life": 19 } ],
      "tapped": { "Runebound Wolf": true }
