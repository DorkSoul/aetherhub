[
  {
    "name": "{T}: target creature with toughness 2 or less gets +1/+1 and flying until end of turn",
    "players": [ { "battlefield": ["Phantasmal Mount", "Grizzly Bears"] }, {} ],
    "steps": [
      { "activate": "Phantasmal Mount", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [3, 3], "Phantasmal Mount": [1, 1] },
      "keywords": { "Grizzly Bears": ["Flying"] },
      "tapped": { "Phantasmal Mount": true }
    }
  },
  {
    "name": "when the Mount leaves the battlefield, the creature it targeted is sacrificed",
    "players": [
      { "battlefield": ["Phantasmal Mount", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Phantasmal Mount", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Phantasmal Mount"] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Phantasmal Mount", "Grizzly Bears"] },
        { "graveyard_has": ["Lightning Bolt"] }
      ]
    }
  },
  {
    "name": "ruling: the Mount's sacrifice still applies after the creature's toughness rises above 2 later",
    "players": [ { "hand": ["Giant Growth"], "battlefield": ["Phantasmal Mount", "Grizzly Bears", "Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "activate": "Phantasmal Mount", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Phantasmal Mount"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Phantasmal Mount", "Grizzly Bears"] }, { "graveyard_has": ["Lightning Bolt"] } ] }
  }
]
