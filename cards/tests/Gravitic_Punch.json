  {
    "name": "ruling: jump-start right after a hard cast works in the same main phase",
    "players": [
      {
        "hand": ["Gravitic Punch", "Mountain"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"]
