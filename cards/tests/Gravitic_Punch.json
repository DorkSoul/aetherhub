  {
    "name": "ruling: jump-start follows sorcery timing: not castable while another spell is on the stack",
    "players": [
      {
        "hand": ["Lightning Bolt", "Mountain"],
        "graveyard": ["Gravitic Punch"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"]
      },
      {}
