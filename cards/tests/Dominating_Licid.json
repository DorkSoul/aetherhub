 {
  "name": "ruling: once it is an Aura enchantment, Disenchant can destroy it and the creature returns",
  "players": [
   {
    "hand": ["Disenchant"],
    "battlefield": ["Dominating Licid", "Island", "Island", "Island", "Plains", "Plains"]
   },
   {
    "battlefield": ["Grizzly Bears"]
   }
  ],
  "steps": [
   { "activate": "Dominating Licid", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Disenchant", "targets": ["Dominating Licid"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Disenchant", "Dominating Licid"], "battlefield_lacks": ["Grizzly Bears"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "ruling: while still a creature, the Licid cannot be targeted by Disenchant",
