    { "hand": ["Disenchant"], "battlefield_has": ["Dominating Licid"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: the controller pays U to end the effect in response, so the enchantment-removal spell has no legal target and fizzles",
  "players": [
   {
    "battlefield": ["Dominating Licid", "Island", "Island", "Island", "Island"]
   },
   {
    "hand": ["Clear"],
    "battlefield": ["Grizzly Bears", "Plains", "Plains"]
   }
  ],
  "steps": [
   { "activate": "Dominating Licid", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "pass": true },
   { "cast": "Clear", "player": 1, "targets": ["Dominating Licid"] },
   { "pass": true, "player": 1 },
   { "activate": "Dominating Licid", "ability": 1 },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Dominating Licid"], "battlefield_lacks": ["Grizzly Bears"] },
    { "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Clear"] }
   ]
  }
 }
