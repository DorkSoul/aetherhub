  {
    "name": "ruling: the trigger still happens when Keeper itself dies to lethal damage in the same combat damage step",
    "players": [
      {
        "battlefield": ["Keeper of Fables", "Llanowar Elves"]
      },
      {
        "battlefield": ["Hill Giant", "Grizzly Bears"]
      }
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Keeper of Fables", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Keeper of Fables" }, { "blocker": "Grizzly Bears", "attacker": "Keeper of Fables" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Keeper of Fables"], "battlefield_has": ["Llanowar Elves"], "library_count": 19 },
        { "life": 19 }
      ]
    }
  },
  {
    "name": "ruling: first-strike and regular combat damage by non-Humans trigger Keeper twice in one combat",
    "players": [
      {
        "battlefield": ["Keeper of Fables", "Knight of Meadowgrain"]
      },
      {}
    ],
    "steps": [
