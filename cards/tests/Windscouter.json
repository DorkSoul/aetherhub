[
 {
  "name": "returns to hand at end of combat after attacking",
  "players": [ { "battlefield": ["Windscouter"] }, {} ],
  "steps": [
    { "attack": [{ "card": "Windscouter", "at": "p1" }] },
    { "block": [] },
    { "advance_to": "EndCombat" },
    { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Windscouter"], "battlefield_lacks": ["Windscouter"] }, {} ] }
 },
 {
  "name": "stays on the battlefield when it has not attacked or blocked",
  "players": [ { "battlefield": ["Windscouter"] }, {} ],
  "steps": [
    { "advance_to": "EndCombat" }
  ],
  "expect": { "players": [ { "battlefield_has": ["Windscouter"] }, {} ] }
 },
 {
  "name": "blocking: returns to hand at end of combat",
  "players": [ { "battlefield": ["Windscouter"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [
    { "advance_to": "Main1" },
    { "attack": [{ "card": "Grizzly Bears", "at": "p0" }], "player": 1 },
    { "block": [{ "blocker": "Windscouter", "attacker": "Grizzly Bears" }], "player": 0 },
    { "resolve": true },
    { "advance_to": "EndCombat" },
    { "resolve": true }
  ],
  "expect": { "players": [ { "hand": ["Windscouter"], "battlefield_lacks": ["Windscouter"] }, { "graveyard": ["Grizzly Bears"] } ] }
 },
 {
  "name": "blocking and dying in combat: the end-of-combat bounce does nothing",
  "players": [ { "battlefield": ["Windscouter"] }, { "battlefield": ["Hill Giant"] } ],
  "steps": [
    { "advance_to": "Main1" },
    { "attack": [{ "card": "Hill Giant", "at": "p0" }], "player": 1 },
    { "block": [{ "blocker": "Windscouter", "attacker": "Hill Giant" }], "player": 0 },
    { "resolve": true },
    { "advance_to": "EndCombat" },
    { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard": ["Windscouter"], "hand_count": 0 }, { "graveyard": ["Hill Giant"] } ] }
 }
]
