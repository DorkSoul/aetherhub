[
  { "name": "enters with energy equal to greatest power; pay EEE: target creature must block if able",
    "players": [ { "hand": ["Peema Aether-Seer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "sick": false }] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Peema Aether-Seer" }, { "resolve": true }, { "resolve": true }, { "activate": "Peema Aether-Seer", "targets": ["Hill Giant"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [], "illegal": true }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "energy": 0, "graveyard": ["Grizzly Bears"] }, {} ] } },
  { "name": "without energy the ability cannot be activated",
    "players": [ { "battlefield": ["Peema Aether-Seer"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Peema Aether-Seer", "targets": ["Hill Giant"], "illegal": true } ],
    "expect": { "players": [ { "energy": 0 }, {} ] } },
  { "name": "ruling: energy equals the greatest power among your creatures (Briar Hydra's 6, not Peema's 3)",
    "players": [ { "hand": ["Peema Aether-Seer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", { "name": "Briar Hydra", "sick": false }] }, {} ],
    "steps": [ { "cast": "Peema Aether-Seer" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 6, "battlefield_has": ["Peema Aether-Seer"] }, {} ] } },
  { "name": "ruling: energy is not tied to Peema, so it stays after Peema dies",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Peema Aether-Seer"], "energy": 3 }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Peema Aether-Seer"] }, { "resolve": true } ],
    "expect": { "players": [ { "energy": 3, "graveyard_has": ["Peema Aether-Seer"] }, {} ] } },
  { "name": "ruling: a tapped creature does not block, even when Peema makes it must-block",
    "players": [ { "battlefield": [ { "name": "Peema Aether-Seer", "sick": false }, { "name": "Grizzly Bears", "sick": false } ], "energy": 3 }, { "battlefield": [ { "name": "Hill Giant", "tapped": true } ] } ],
    "steps": [ { "activate": "Peema Aether-Seer", "targets": ["Hill Giant"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "energy": 0 }, { "life": 18 } ] } },
  { "name": "ruling: two energy cannot pay EEE",
    "players": [ { "battlefield": ["Peema Aether-Seer"], "energy": 2 }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "activate": "Peema Aether-Seer", "targets": ["Hill Giant"], "illegal": true } ],
    "expect": { "players": [ { "energy": 2 }, {} ] } },
  { "name": "ruling: energy counters stay through the end of the turn",
    "players": [ { "battlefield": ["Peema Aether-Seer"], "energy": 3 }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { "energy": 3 }, {} ] } }
]
