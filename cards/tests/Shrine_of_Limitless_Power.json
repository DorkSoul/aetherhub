[
  { "name": "upkeep adds a charge counter",
    "players": [ { "battlefield": ["Shrine of Limitless Power"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Shrine of Limitless Power": { "charge": 1 } } } },
  { "name": "pay 4, tap and sacrifice: target player discards a card per charge counter",
    "players": [ { "battlefield": [ { "name": "Shrine of Limitless Power", "counters": { "charge": 2 } }, "Swamp", "Swamp", "Swamp", "Swamp" ] }, { "hand": ["Island", "Swamp"] } ],
    "steps": [ { "activate": "Shrine of Limitless Power", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Shrine of Limitless Power"] }, { "hand": [], "graveyard": ["Island", "Swamp"] } ] } },
  { "name": "no charge counters: discards nothing",
    "players": [ { "battlefield": ["Shrine of Limitless Power", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Island"] } ],
    "steps": [ { "activate": "Shrine of Limitless Power", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "hand": ["Island"] } ] } },
  { "name": "casting a black spell adds a charge counter",
    "players": [ { "hand": ["Vampire Nighthawk"], "battlefield": ["Shrine of Limitless Power", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Vampire Nighthawk" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vampire Nighthawk"] }, {} ], "counters": { "Shrine of Limitless Power": { "charge": 1 } } } },
  { "name": "casting a red spell does not add a charge counter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Shrine of Limitless Power", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Shrine of Limitless Power": { "charge": 0 } } } },
  { "name": "ruling: activated in the opponent's turn after they drew, it makes them discard the drawn card",
    "players": [ { "battlefield": [ { "name": "Shrine of Limitless Power", "counters": { "charge": 1 } }, "Swamp", "Swamp", "Swamp", "Swamp" ] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "activate": "Shrine of Limitless Power", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Shrine of Limitless Power"] }, { "hand_count": 0 } ] } },
  { "name": "ruling: responding to the opponent's spell does not make them discard the spell",
    "players": [ { "battlefield": [ { "name": "Shrine of Limitless Power", "counters": { "charge": 1 } }, "Swamp", "Swamp", "Swamp", "Swamp" ] },
                 { "hand": ["Lightning Bolt", "Island"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "activate": "Shrine of Limitless Power", "targets": ["p1"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17, "graveyard": ["Shrine of Limitless Power"] }, { "hand_count": 0, "graveyard": ["Island", "Lightning Bolt"] } ] } }
]
