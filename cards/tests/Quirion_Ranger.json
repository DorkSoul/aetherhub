[
  {
    "name": "return a Forest to untap a creature",
    "players": [
      {
        "battlefield": [
          "Quirion Ranger",
          "Forest",
          {
            "name": "Grizzly Bears",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Quirion Ranger",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": false
      },
      "players": [
        {
          "hand": [
            "Forest"
          ],
          "battlefield": [
            "Quirion Ranger",
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "only once each turn",
    "players": [
      {
        "battlefield": [
          "Quirion Ranger",
          "Forest",
          "Forest",
          {
            "name": "Grizzly Bears",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Quirion Ranger",
        "targets": [
          "Grizzly Bears"
        ],
        "answers": [
          "Forest"
        ]
      },
      {
        "resolve": true
      },
      {
        "activate": "Quirion Ranger",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Forest"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "needs a Forest",
    "players": [
      {
        "battlefield": [
          "Quirion Ranger",
          "Mountain",
          {
            "name": "Grizzly Bears",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Quirion Ranger",
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ]
  },
  {
    "name": "ruling: the ability can target an untapped creature",
    "players": [
      { "battlefield": ["Quirion Ranger", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Quirion Ranger", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Hill Giant": false },
      "players": [ { "hand": ["Forest"] }, {} ]
    }
  },
  {
    "name": "ruling: a Forest-subtype land not named Forest pays the cost",
    "players": [
      { "battlefield": ["Quirion Ranger", "Stomping Ground", { "name": "Grizzly Bears", "tapped": true }] },
      {}
    ],
    "steps": [
      { "activate": "Quirion Ranger", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false },
      "players": [ { "hand": ["Stomping Ground"] }, {} ]
    }
  }
]
