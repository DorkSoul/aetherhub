 {
  "name": "ruling: the most recent activation's X applies when the ability is activated again",
  "players": [
   {
    "hand": ["Rancor"],
    "battlefield": ["Destiny Spinner", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Plains"]
   },
   {}
  ],
  "steps": [
   { "activate": "Destiny Spinner", "ability": 0, "targets": ["Plains"] },
   { "resolve": true },
   { "cast": "Rancor", "targets": ["Destiny Spinner"] },
   { "resolve": true },
   { "activate": "Destiny Spinner", "ability": 0, "targets": ["Plains"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, {}],
   "pt": { "Plains": [2, 2] }
  }
 },
 {
  "name": "ruling: a Spinner spell can be countered, its static works only on the battlefield",
  "players": [
   {
    "hand": ["Destiny Spinner"],
    "battlefield": ["Forest", "Forest"]
   },
   {
    "hand": ["Counterspell"],
    "battlefield": ["Island", "Island"]
   }
  ],
  "steps": [
   { "cast": "Destiny Spinner" },
   { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Destiny Spinner" }] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Destiny Spinner"] },
    { "graveyard_has": ["Counterspell"] }
   ]
  }
 },
 {
  "name": "ruling: with no enchantments left when it resolves, the animated land becomes 0/0 and dies",
  "players": [
   {
    "battlefield": ["Destiny Spinner", "Forest", "Forest", "Forest", "Forest", "Plains"]
   },
   {
    "hand": ["Lightning Bolt"],
    "battlefield": ["Mountain"]
   }
  ],
  "steps": [
   { "activate": "Destiny Spinner", "ability": 0, "targets": ["Plains"] },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Destiny Spinner"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Destiny Spinner", "Plains"] },
    { "graveyard_has": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "ruling: X is fixed on resolution, a later enchantment does not change the base P/T",
  "players": [
   {
    "hand": ["Rancor"],
    "battlefield": ["Destiny Spinner", "Forest", "Forest", "Forest", "Forest", "Forest", "Plains"]
   },
   {}
  ],
  "steps": [
   { "activate": "Destiny Spinner", "ability": 0, "targets": ["Plains"] },
   { "resolve": true },
   { "cast": "Rancor", "targets": ["Destiny Spinner"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, {}],
   "pt": { "Plains": [1, 1] }
  }
 },
 {
  "name": "ruling: the animation does not untap a tapped land",
  "players": [
   {
    "battlefield": ["Destiny Spinner", "Forest", "Forest", "Forest", "Forest", { "name": "Plains", "tapped": true }]
   },
   {}
  ],
  "steps": [
   { "activate": "Destiny Spinner", "ability": 0, "targets": ["Plains"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, {}],
   "tapped": { "Plains": true },
   "pt": { "Plains": [1, 1] }
  }
 }
]