 {
  "name": "creature spells you control can't be countered",
  "players": [
   {
    "hand": [
     "Grizzly Bears"
    ],
    "battlefield": [
     "Destiny Spinner",
     "Forest",
     "Forest"
    ]
   },
   {
    "hand": [
     "Counterspell"
    ],
    "battlefield": [
     "Island",
     "Island"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Grizzly Bears"
   },
   {
    "cast": "Counterspell",
    "player": 1,
    "targets": [
     {
      "stack": "Grizzly Bears"
     }
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
