[
  { "name": "exiles the opponent's artifacts while it is on the battlefield",
    "players": [ { "hand": ["Consulate Crackdown"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Mind Stone", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Consulate Crackdown" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Consulate Crackdown"] }, { "battlefield_lacks": ["Mind Stone"], "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "your own artifacts are not exiled",
    "players": [ { "hand": ["Consulate Crackdown"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Mind Stone"] }, {} ],
    "steps": [ { "cast": "Consulate Crackdown" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Consulate Crackdown", "Mind Stone"] }, {} ] } },
  { "name": "ruling: destroying Crackdown returns every exiled artifact to the battlefield",
    "players": [ { "hand": ["Consulate Crackdown"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Forest", "Sylvok Replica"] }, { "battlefield": ["Mind Stone", "Echo Circlet"] } ],
    "steps": [ { "cast": "Consulate Crackdown" }, { "resolve": true }, { "resolve": true }, { "activate": "Sylvok Replica", "targets": ["Consulate Crackdown"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Sylvok Replica", "Consulate Crackdown"] }, { "battlefield_has": ["Mind Stone", "Echo Circlet"] } ] } },
  { "name": "ruling: if Crackdown leaves before its trigger resolves, no artifacts are exiled",
    "players": [ { "hand": ["Consulate Crackdown"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Forest", "Sylvok Replica"] }, { "battlefield": ["Mind Stone", "Echo Circlet"] } ],
    "steps": [ { "cast": "Consulate Crackdown" }, { "resolve": true }, { "activate": "Sylvok Replica", "targets": ["Consulate Crackdown"] }, { "pass": true }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Consulate Crackdown", "Sylvok Replica"] }, { "battlefield_has": ["Mind Stone", "Echo Circlet"] } ] } }
]
