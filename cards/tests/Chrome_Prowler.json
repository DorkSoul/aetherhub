  {
    "name": "flashed in, its ETB taps an opposing creature",
    "players": [
      { "hand": ["Chrome Prowler"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Chrome Prowler" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "players": [ { "battlefield_has": ["Chrome Prowler"] }, {} ]
    }
  },
  {
    "name": "with no opposing creature the ETB does nothing to your own creature",
    "players": [
      { "hand": ["Chrome Prowler"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Chrome Prowler" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false },
      "players": [ { "battlefield_has": ["Chrome Prowler", "Grizzly Bears"] }, {} ]
    }
  }
