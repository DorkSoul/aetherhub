[
  {
    "name": "grants unblockable to target creature until end of turn",
    "players": [ { "battlefield": ["Amphin Pathmage", "Grizzly Bears", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "activate": "Amphin Pathmage", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "keywords": { "Grizzly Bears": ["Unblockable"] } }
  },
  {
    "name": "unblockable creature deals its damage to the player",
    "players": [
      { "battlefield": ["Amphin Pathmage", "Grizzly Bears", "Island", "Island", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Amphin Pathmage", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "ruling: activating after blockers are declared does not change or undo the block",
    "players": [ { "battlefield": ["Amphin Pathmage", "Grizzly Bears", "Island", "Island", "Island"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "activate": "Amphin Pathmage", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ] }
  }
]
