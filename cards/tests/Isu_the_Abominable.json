[
  { "name": "playing a snow land and paying G gives a +1/+1 counter",
    "players": [ { "hand": ["Snow-Covered Forest"], "battlefield": ["Isu the Abominable", "Forest"] }, {} ],
    "steps": [ { "play_land": "Snow-Covered Forest" }, { "resolve": true, "answers": [true] } ],
    "expect": { "pt": { "Isu the Abominable": [6, 6] }, "counters": { "Isu the Abominable": { "p1p1": 1 } } } },
  { "name": "a non-snow land does not trigger it",
    "players": [ { "hand": ["Forest"], "battlefield": ["Isu the Abominable"] }, {} ],
    "steps": [ { "play_land": "Forest" } ],
    "expect": { "pt": { "Isu the Abominable": [5, 5] } } },
  { "name": "declining the payment leaves Isu unchanged",
    "players": [ { "hand": ["Snow-Covered Forest"], "battlefield": ["Isu the Abominable", "Forest"] }, {} ],
    "steps": [ { "play_land": "Snow-Covered Forest" }, { "resolve": true, "answers": [false] } ],
    "expect": { "pt": { "Isu the Abominable": [5, 5] } } },
  { "name": "may play a snow land from the top of the library",
    "players": [ { "battlefield": ["Isu the Abominable"], "library": ["Snow-Covered Forest", "Forest"] }, {} ],
    "steps": [ { "play_land": "Snow-Covered Forest" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Snow-Covered Forest", "Isu the Abominable"] }, {} ] } },
  { "name": "without Isu the snow land on top of the library cannot be played",
    "players": [ { "library": ["Snow-Covered Forest", "Forest"] }, {} ],
    "steps": [ { "play_land": "Snow-Covered Forest", "illegal": true } ],
    "expect": { "players": [ { "battlefield": [] }, {} ] } },
  { "name": "ruling: after a land was already played this turn, a snow land on top of the library cannot be played",
    "players": [ { "hand": ["Forest"], "battlefield": ["Isu the Abominable"], "library": ["Snow-Covered Forest", "Forest"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "play_land": "Snow-Covered Forest", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Forest", "Isu the Abominable"], "battlefield_lacks": ["Snow-Covered Forest"] }, {} ] } }
]
