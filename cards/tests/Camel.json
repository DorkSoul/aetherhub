[
 { "name": "an attacking Camel takes no damage from a blocking Desert",
   "players": [ { "battlefield": [ { "name": "Camel", "sick": false } ] },
                { "battlefield": ["Hostile Desert", "Plains", "Plains"], "graveyard": ["Forest"] } ],
   "steps": [ { "attack": [ { "card": "Camel", "at": "p1" } ] },
              { "pass": true },
              { "activate": "Hostile Desert", "ability": 0, "player": 1 }, { "resolve": true },
              { "block": [ { "blocker": "Hostile Desert", "attacker": "Camel" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Camel"] }, {} ] } },
 { "name": "a creature banded with the Camel takes no damage from the Desert",
   "players": [ { "battlefield": [ { "name": "Camel", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
                { "battlefield": ["Hostile Desert", "Plains", "Plains"], "graveyard": ["Forest"] } ],
   "steps": [ { "attack": [ { "card": "Camel", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
              { "pass": true },
              { "activate": "Hostile Desert", "ability": 0, "player": 1 }, { "resolve": true },
              { "block": [ { "blocker": "Hostile Desert", "attacker": "Grizzly Bears" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Camel", "Grizzly Bears"] }, {} ] } },
 { "name": "an unbanded attacker takes damage from the Desert as usual",
   "players": [ { "battlefield": [ { "name": "Camel", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
                { "battlefield": ["Hostile Desert", "Plains", "Plains"], "graveyard": ["Forest"] } ],
   "steps": [ { "attack": [ { "card": "Camel", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
              { "pass": true },
              { "activate": "Hostile Desert", "ability": 0, "player": 1 }, { "resolve": true },
              { "block": [ { "blocker": "Hostile Desert", "attacker": "Grizzly Bears" } ] },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Camel"], "graveyard": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: blocking one creature of a band blocks the whole band (banded Bears deal no damage to the player)",
