  {
    "name": "Counterspell can target but cannot counter an instant you control",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Taigam, Ojutai Master",
          "Mountain"
        ]
      },
      {
        "hand": [
          "Counterspell"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "pass": true
      },
      {
        "cast": "Counterspell",
        "player": 1,
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt"
          ]
        },
        {
          "life": 17,
          "graveyard": [
            "Counterspell"
          ]
        }
      ]
    }
  },
  {
    "name": "after attacking, an instant cast from hand gains rebound (exiled on resolution)",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          {
            "name": "Taigam, Ojutai Master",
            "sick": false
          },
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Taigam, Ojutai Master",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Lightning Bolt"
          ]
        },
        {}
      ]
    }
