  {
    "name": "ruling: at your next upkeep the rebound spell can be cast free, then goes to the graveyard",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Taigam, Ojutai Master", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Taigam, Ojutai Master", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep", "answers": [true, "p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": [], "graveyard": ["Lightning Bolt"] },
        { "life": 11 }
      ]
    }
  },
  {
    "name": "ruling: declining the rebound cast leaves the card exiled",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Taigam, Ojutai Master", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Taigam, Ojutai Master", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep", "answers": [false] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Lightning Bolt"] },
        { "life": 14 }
      ]
    }
  }
