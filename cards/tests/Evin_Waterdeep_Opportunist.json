[
  {
    "name": "a sacrifice by any player creates a tapped Treasure and Evin gets +2/+0 for it",
    "players": [ { "battlefield": ["Evin, Waterdeep Opportunist", "Ravenous Squirrel", "Grizzly Bears", "Swamp", "Forest", "Island"] }, {} ],
    "steps": [
      { "activate": "Ravenous Squirrel", "ability": 0, "answers": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Treasure"], "graveyard_has": ["Grizzly Bears"] }, {} ],
      "pt": { "Evin, Waterdeep Opportunist": [4, 4] }
    }
  },
  {
    "name": "with no Treasure Evin is a 2/4",
    "players": [ { "hand": ["Evin, Waterdeep Opportunist"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Evin, Waterdeep Opportunist" }, { "resolve": true } ],
    "expect": {
      "pt": { "Evin, Waterdeep Opportunist": [2, 4] },
      "players": [ { "battlefield_lacks": ["Treasure"] }, {} ]
    }
  },
  {
    "name": "ward: an opponent's Shock is countered unless they sacrifice a creature",
    "players": [ { "battlefield": ["Evin, Waterdeep Opportunist"] }, { "hand": ["Shock"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Evin, Waterdeep Opportunist"] },
      { "resolve": true, "auto": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Evin, Waterdeep Opportunist"] }, { "graveyard_has": ["Shock", "Grizzly Bears"] } ]
    }
  }
