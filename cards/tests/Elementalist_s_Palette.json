[
  {
    "name": "casting an X spell puts two charge counters on it",
    "players": [
      { "hand": ["Blaze"], "battlefield": ["Elementalist's Palette", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Blaze", "targets": ["p1"], "answers": [0] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Elementalist's Palette": { "Charge": 2 } },
      "players": [
        { "graveyard": ["Blaze"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "casting a non-X spell puts no charge counters",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Elementalist's Palette", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Elementalist's Palette": { "Charge": 0 } },
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a spell with two {X} symbols puts only two charge counters on the Palette",
    "players": [
      { "hand": ["Walking Ballista"], "battlefield": ["Elementalist's Palette", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Walking Ballista", "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Elementalist's Palette": { "Charge": 2 } },
      "players": [
        { "battlefield_has": ["Walking Ballista"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Palette's colorless mana can pay the generic part of an X cost, not just the X",
    "players": [
      { "hand": ["Blaze"], "battlefield": [{ "name": "Elementalist's Palette", "counters": { "charge": 2 } }, "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Blaze", "targets": ["p1"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Elementalist's Palette": { "Charge": 4 } },
      "tapped": { "Elementalist's Palette": true },
      "players": [
        { "graveyard": ["Blaze"] },
        { "life": 18 }
      ]
    }
  }
]
