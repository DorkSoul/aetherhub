  {"name": "deals 2 damage and draws only if another spell was cast this turn",
   "players": [{"hand": ["Slick Sequence", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Island"]}, {}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Slick Sequence", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 1}, {"life": 15}]}},
  {"name": "no draw when it is the only spell cast this turn",
