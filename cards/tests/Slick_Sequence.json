   "steps": [{"cast": "Slick Sequence", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 0}, {"life": 18}]}},
  {"name": "ruling: another spell cast in response (still on the stack) counts: draw",
   "players": [{"hand": ["Slick Sequence", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Island"]}, {}],
   "steps": [{"cast": "Slick Sequence", "targets": ["p1"]}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 1}, {"life": 15}]}},
  {"name": "ruling: a countered spell still counts as cast this turn: draw",
   "players": [{"hand": ["Lightning Bolt", "Slick Sequence"], "battlefield": ["Mountain", "Mountain", "Island"]}, {"hand": ["Counterspell"], "battlefield": ["Island", "Island"]}],
   "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"pass": true}, {"player": 1, "cast": "Counterspell", "targets": [{"stack": "Lightning Bolt"}]}, {"resolve": true}, {"cast": "Slick Sequence", "targets": ["p1"]}, {"resolve": true}],
   "expect": {"players": [{"hand_count": 1, "graveyard": ["Lightning Bolt", "Slick Sequence"]}, {"life": 18, "graveyard": ["Counterspell"]}]}}
