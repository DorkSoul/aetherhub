[
  {
    "name": "enchanted land pings any target for 1",
    "players": [
      { "hand": ["Barbed Field"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Barbed Field", "targets": ["Forest"] },
      { "resolve": true },
      { "activate": "Forest", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Barbed Field": "Forest" },
      "tapped": { "Forest": true },
      "players": [ {}, { "life": 19 } ]
    }
  },
  {
    "name": "only the enchanted land has the ability",
    "players": [
      { "battlefield": ["Barbed Field", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Forest", "ability": 32768, "targets": ["p1"], "illegal": true }
    ]
  },
  {
    "name": "ruling: colorless enchanted land can target a pro-red creature",
    "players": [
      { "hand": ["Barbed Field"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Forest"] },
      { "battlefield": ["Silver Knight"] }
    ],
    "steps": [
      { "cast": "Barbed Field", "targets": ["Forest"] },
      { "resolve": true },
      { "activate": "Forest", "ability": 32768, "targets": ["Silver Knight"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Barbed Field": "Forest" },
      "tapped": { "Forest": true }
    }
  },
  {
    "name": "ruling: contrast, a red spell cannot target the pro-red creature",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Silver Knight"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Silver Knight"], "illegal": true }
    ]
  }
]
