[
  { "name": "returns an opposing creature that died this turn under your control as a Food",
    "players": [
      { "hand": ["Lightning Bolt", "Supper for Spiders"], "battlefield": ["Mountain", "Swamp", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Supper for Spiders" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt", "Supper for Spiders"], "battlefield": ["Grizzly Bears", "Island", "Mountain", "Swamp"] },
        { "graveyard": [] }
      ]
    }
  },
  { "name": "the returned Food sacrifices for 3 life",
    "players": [
      { "hand": ["Lightning Bolt", "Supper for Spiders"], "battlefield": ["Mountain", "Swamp", "Island", "Plains", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Supper for Spiders" },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23, "graveyard": ["Lightning Bolt", "Supper for Spiders"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  { "name": "a creature put into the graveyard on an earlier turn is not taken",
    "players": [
      { "hand": ["Supper for Spiders"], "battlefield": ["Swamp", "Island"] },
      { "graveyard": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Supper for Spiders" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Supper for Spiders"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  { "name": "ruling: the Food effect lasts indefinitely, the creature is still a Food several turns later",
    "players": [
      { "hand": ["Lightning Bolt", "Supper for Spiders"], "battlefield": ["Mountain", "Swamp", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Supper for Spiders" },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "activate": "Grizzly Bears", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 23 },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  }
]
