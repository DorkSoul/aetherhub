[
  {
    "name": "two goblins with no spell before it",
    "players": [
      {
        "hand": [
          "Empty the Warrens"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Empty the Warrens"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Empty the Warrens"
          ],
          "battlefield": [
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain",
            "Goblin",
            "Goblin"
          ]
        }
      ]
    }
  },
  {
    "name": "storm 1 after one earlier spell: four goblins",
    "players": [
      {
        "hand": [
          "Empty the Warrens",
          "Shock"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Shock",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Empty the Warrens"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Shock",
            "Empty the Warrens"
          ],
          "battlefield": [
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain",
            "Goblin",
            "Goblin",
            "Goblin",
            "Goblin"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "ruling: a countered spell still counts for storm (Shock countered, Empty gets two copies: six goblins)",
    "players": [
      { "hand": ["Empty the Warrens", "Shock"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Shock" }] },
      { "resolve": true },
      { "cast": "Empty the Warrens" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Shock", "Empty the Warrens"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin"] },
        { "graveyard": ["Counterspell"] }
      ]
    }
  },
  {
    "name": "ruling: storm copies are not cast, so a later storm spell does not count them (ten goblins in total)",
    "players": [
      { "hand": ["Shock", "Empty the Warrens", "Empty the Warrens"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Empty the Warrens" },
      { "resolve": true },
      { "cast": "Empty the Warrens" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin", "Goblin"] },
        { "life": 18 }
      ]
    }
  }
]
