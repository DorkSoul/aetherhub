  {
    "name": "ruling: from the graveyard it can only be cast for its escape cost, not its mana cost",
    "players": [
      { "graveyard": ["Sweet Oblivion", "Grizzly Bears", "Hill Giant", "Llanowar Elves", "Forest"], "battlefield": ["Island", "Island"] },
