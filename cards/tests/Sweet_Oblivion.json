      {
        "graveyard": ["Sweet Oblivion", "Grizzly Bears", "Hill Giant", "Llanowar Elves", "Forest"],
        "battlefield": ["Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Sweet Oblivion", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "graveyard": ["Sweet Oblivion"],
          "exile": ["Grizzly Bears", "Hill Giant", "Llanowar Elves", "Forest"]
        },
        {}
      ]
    }
  },
  {
    "name": "escape needs four other cards in the graveyard",
    "players": [
      {
        "graveyard": ["Sweet Oblivion", "Grizzly Bears", "Hill Giant", "Llanowar Elves"],
        "battlefield": ["Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Sweet Oblivion", "alt": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "ruling: the escape total cost is {3}{U}, so three lands are not enough",
    "players": [
      { "graveyard": ["Sweet Oblivion", "Grizzly Bears", "Hill Giant", "Llanowar Elves", "Forest"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Sweet Oblivion", "alt": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Sweet Oblivion"] }, {} ] }
