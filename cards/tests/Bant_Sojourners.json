[
  { "name": "cycle: draw a card and may make a Soldier",
    "players": [ { "hand": ["Bant Sojourners"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Bant Sojourners" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "graveyard": ["Bant Sojourners"], "battlefield_has": ["Soldier"] }, {} ] } },
  { "name": "cycle: declining the Soldier",
    "players": [ { "hand": ["Bant Sojourners"], "battlefield": ["Plains", "Plains", "Plains"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Bant Sojourners" }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "battlefield_lacks": ["Soldier"] }, {} ] } },
  { "name": "cycling needs three mana",
    "players": [ { "hand": ["Bant Sojourners"], "battlefield": ["Plains", "Plains"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Bant Sojourners", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Bant Sojourners"] }, {} ] } },
  { "name": "dies: a Bant Sojourners that dies makes a Soldier for its controller",
    "players": [ { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Bant Sojourners"] } ],
    "steps": [ { "cast": "Murder", "targets": ["Bant Sojourners"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Murder"] }, { "graveyard": ["Bant Sojourners"], "battlefield_has": ["Soldier"] } ] } },
  { "name": "dies: declining the Soldier when it dies",
    "players": [ { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Bant Sojourners"] } ],
    "steps": [ { "cast": "Murder", "targets": ["Bant Sojourners"] }, { "resolve": true, "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Murder"] }, { "graveyard": ["Bant Sojourners"], "battlefield_lacks": ["Soldier"] } ] } },
  { "name": "ruling: the dies trigger is controlled by the player who last controlled the Sojourner",
    "players": [ { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Bant Sojourners"] }, { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "cast": "Control Magic", "player": 1 }, { "resolve": true }, { "pass": true, "player": 1 }, { "cast": "Murder", "targets": ["Bant Sojourners"] }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Murder", "Bant Sojourners"], "battlefield_lacks": ["Soldier"] }, { "battlefield_has": ["Soldier"] } ] } }
]
