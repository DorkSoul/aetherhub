[
  { "name": "puts a card from an opponent's graveyard on the bottom of its owner's library",
    "players": [ { "battlefield": ["Junktroller"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Junktroller", "ability": 0, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "graveyard": [], "library_count": 21 } ], "tapped": { "Junktroller": true } } },
  { "name": "tapping it again is illegal",
    "players": [ { "battlefield": ["Junktroller"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [
      { "activate": "Junktroller", "ability": 0, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Junktroller", "ability": 0, "targets": ["p1:Grizzly Bears"], "illegal": true }
    ],
    "expect": { "players": [ {}, { "graveyard": [] } ] } }
]
