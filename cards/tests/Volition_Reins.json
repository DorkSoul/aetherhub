[
  {
    "name": "steals the enchanted permanent",
    "players": [
      { "hand": ["Volition Reins"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Volition Reins", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Volition Reins", "Grizzly Bears"] }, { "battlefield": [] }],
      "attached": { "Volition Reins": "Grizzly Bears" }
    }
  },
  {
    "name": "untaps the tapped enchanted permanent when it enters",
    "players": [
      { "hand": ["Volition Reins"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Volition Reins", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Volition Reins", "Grizzly Bears"] }, {}],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: an untapped permanent can be targeted and enchanted, and stays untapped",
    "players": [
      { "hand": ["Volition Reins"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Volition Reins", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Volition Reins", "Grizzly Bears"] }, { "battlefield": [] }],
      "attached": { "Volition Reins": "Grizzly Bears" },
      "tapped": { "Grizzly Bears": false }
    }
  }
]
