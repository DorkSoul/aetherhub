[
 {
  "name": "destroying an opponent's enchantment draws nothing",
  "players": [
   { "hand": ["Break the Spell"], "battlefield": ["Plains"] },
   { "battlefield": ["Ghostly Prison"] }
  ],
  "steps": [
   { "cast": "Break the Spell", "targets": ["Ghostly Prison"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 0, "graveyard": ["Break the Spell"] }, { "graveyard": ["Ghostly Prison"] } ]
  }
 },
 {
  "name": "destroying an enchantment you control draws a card",
  "players": [
   { "hand": ["Break the Spell"], "battlefield": ["Plains", "Ghostly Prison"] },
   {}
  ],
  "steps": [
   { "cast": "Break the Spell", "targets": ["Ghostly Prison"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 1, "graveyard": ["Break the Spell", "Ghostly Prison"] }, {} ]
  }
 },
 {
  "name": "the target must be an enchantment",
  "players": [
   { "hand": ["Break the Spell"], "battlefield": ["Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Break the Spell", "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": {
   "players": [ { "hand": ["Break the Spell"] }, { "battlefield": ["Grizzly Bears"] } ]
  }
 },
 {
  "name": "ruling: an indestructible enchantment is not destroyed and no card is drawn",
  "players": [
   { "hand": ["Break the Spell"], "battlefield": ["Plains", "Mogis, God of Slaughter"] },
   {}
  ],
  "steps": [
   { "cast": "Break the Spell", "targets": ["Mogis, God of Slaughter"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 0, "battlefield_has": ["Mogis, God of Slaughter"] }, {} ],
   "keywords": { "Mogis, God of Slaughter": ["Indestructible"] }
  }
 }
]
