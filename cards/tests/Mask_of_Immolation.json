[
  {
    "name": "enters: creates an Elemental and equips it",
    "players": [
      {
        "hand": [
          "Mask of Immolation"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Mask of Immolation"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Mask of Immolation",
            "Elemental"
          ]
        },
        {}
      ],
      "attached": {
        "Mask of Immolation": "Elemental"
      }
    }
  },
  {
    "name": "equipped creature: sacrifice it to deal 1 damage to any target",
    "players": [
      {
        "hand": [
          "Mask of Immolation"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Mask of Immolation"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "activate": "Elemental",
        "ability": 32768,
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Elemental"
          ]
        },
        {
          "life": 19
        }
      ]
    }
  },
  {
    "name": "equip {2}: attaches to a creature you control",
    "players": [
      {
        "battlefield": [
          "Mask of Immolation",
          "Grizzly Bears",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Mask of Immolation",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Mask of Immolation",
            "Grizzly Bears"
          ]
        },
        {}
      ],
      "attached": {
        "Mask of Immolation": "Grizzly Bears"
      }
    }
  },
  {
    "name": "equip needs {2}: one Mountain is not enough",
    "players": [
      {
        "battlefield": [
          "Mask of Immolation",
          "Grizzly Bears",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Mask of Immolation",
        "ability": 0,
        "targets": [
          "Grizzly Bears"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Mask of Immolation",
            "Grizzly Bears"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a red equipped Elemental cannot target a protection-from-red creature",
    "players": [
      { "hand": ["Mask of Immolation"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Silver Knight"] }
    ],
    "steps": [
      { "cast": "Mask of Immolation" },
      { "resolve": true },
      { "resolve": true },
      { "activate": "Elemental", "ability": 32768, "targets": ["Silver Knight"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Mask of Immolation", "Elemental"] }, { "battlefield_has": ["Silver Knight"] } ],
      "attached": { "Mask of Immolation": "Elemental" }
    }
  },
  {
    "name": "ruling: a green equipped Grizzly Bears can sacrifice itself to damage a protection-from-red creature",
    "players": [
      { "battlefield": ["Mask of Immolation", "Grizzly Bears", "Mountain", "Mountain"] },
      { "battlefield": ["Silver Knight"] }
    ],
    "steps": [
      { "activate": "Mask of Immolation", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Silver Knight"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears"] }, { "battlefield_has": ["Silver Knight"] } ]
    }
  }
]
