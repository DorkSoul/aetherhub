[
  {
    "name": "X counts instants and sorceries in graveyard: 4 kills Hill Giant",
    "players": [
      {
        "hand": [
          "Cyclops Electromancer"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ],
        "graveyard": [
          "Lightning Bolt",
          "Shock",
          "Giant Growth",
          "Divination"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Cyclops Electromancer"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Cyclops Electromancer"
          ]
        },
        {
          "graveyard": [
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "creature cards in graveyard are not counted (2 damage does not kill a 3/3)",
    "players": [
      {
        "hand": [
          "Cyclops Electromancer"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ],
        "graveyard": [
          "Lightning Bolt",
          "Shock",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Cyclops Electromancer"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Cyclops Electromancer"
          ]
        },
        {
          "battlefield": [
            "Hill Giant"
          ],
          "graveyard": []
        }
      ]
    }
  },
  {
    "name": "empty graveyard: no kill on Grizzly Bears",
    "players": [
      {
        "hand": [
          "Cyclops Electromancer"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Cyclops Electromancer"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: X is counted when the ETB trigger resolves, so an instant cast in response counts",
    "players": [
      { "hand": ["Cyclops Electromancer", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "graveyard": ["Shock", "Giant Growth"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Cyclops Electromancer" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Cyclops Electromancer"], "graveyard_has": ["Lightning Bolt"] }, { "graveyard": ["Hill Giant"] } ] }
  }
]