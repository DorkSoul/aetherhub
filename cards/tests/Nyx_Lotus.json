[
  { "name": "enters tapped",
    "players": [ { "hand": ["Nyx Lotus"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Nyx Lotus" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Nyx Lotus"] }, {} ], "tapped": { "Nyx Lotus": true } } },
  { "name": "white devotion of Serra Angel: two white mana",
    "players": [ { "battlefield": ["Nyx Lotus", "Serra Angel", "Grizzly Bears"] }, {} ],
    "steps": [ { "tap_for_mana": "Nyx Lotus", "color": "W" } ],
    "expect": { "players": [ { "pool": { "W": 2 } }, {} ], "tapped": { "Nyx Lotus": true } } },
  { "name": "green devotion counts only green symbols",
    "players": [ { "battlefield": ["Nyx Lotus", "Serra Angel", "Grizzly Bears"] }, {} ],
    "steps": [ { "tap_for_mana": "Nyx Lotus", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ] } },
  { "name": "no devotion to the chosen color: no mana",
    "players": [ { "battlefield": ["Nyx Lotus", "Serra Angel"] }, {} ],
    "steps": [ { "tap_for_mana": "Nyx Lotus", "color": "R" } ],
    "expect": { "players": [ { "pool": {} }, {} ], "tapped": { "Nyx Lotus": true } } },
  { "name": "ruling: an Aura I control on an opponent's creature counts toward devotion",
    "players": [ { "hand": ["Pacifism"], "battlefield": ["Nyx Lotus", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "tap_for_mana": "Nyx Lotus", "color": "W" } ],
    "expect": { "players": [ { "pool": { "W": 1 } }, {} ], "attached": { "Pacifism": "Grizzly Bears" } } },
  { "name": "ruling: a {W} in a text box does not count toward devotion",
    "players": [ { "battlefield": ["Nyx Lotus", "Serra Angel", "Bastion Mastodon"] }, {} ],
    "steps": [ { "tap_for_mana": "Nyx Lotus", "color": "W" } ],
    "expect": { "players": [ { "pool": { "W": 2 } }, {} ] } },
  { "name": "ruling: a hybrid {R/W} symbol counts toward white devotion",
    "players": [ { "battlefield": ["Nyx Lotus", "Boros Guildmage"] }, {} ],
    "steps": [ { "tap_for_mana": "Nyx Lotus", "color": "W" } ],
    "expect": { "players": [ { "pool": { "W": 2 } }, {} ] } },
  { "name": "ruling: a hybrid {R/W} symbol also counts toward red devotion",
    "players": [ { "battlefield": ["Nyx Lotus", "Boros Guildmage"] }, {} ],
    "steps": [ { "tap_for_mana": "Nyx Lotus", "color": "R" } ],
    "expect": { "players": [ { "pool": { "R": 2 } }, {} ] } }
]
