[
  {
    "name": "sacrifice ability: 1 damage to any target, then the Aura is sacrificed",
    "players": [
      { "hand": ["Fire Whip"], "battlefield": ["Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Fire Whip", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Fire Whip", "ability": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Fire Whip"] }, { "life": 19 }]
    }
  },
  {
    "name": "enchanted creature gains the tap ability: 1 damage to any target",
    "players": [
      { "hand": ["Fire Whip"], "battlefield": ["Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Fire Whip", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Fire Whip", "Grizzly Bears"] }, { "life": 19 }]
    }
  },
  {
    "name": "ruling: Fire Whip goes to the graveyard when its enchanted creature changes control",
    "players": [
      { "hand": ["Fire Whip"], "battlefield": ["Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Fire Whip", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Control Magic", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Fire Whip"], "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears", "Control Magic"] }]
    }
  },
  {
    "name": "ruling: with two Fire Whips, the second tap ability is unusable once the first has tapped the creature",
    "players": [
      { "hand": ["Fire Whip", "Fire Whip"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "cast": "Fire Whip", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Fire Whip", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768, "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32769, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Fire Whip", "Grizzly Bears"] }, { "life": 19 }]
    }
  }
]
