[
  {
    "name": "deals damage equal to the number of Wizards you control",
    "players": [
      {
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Boros Reckoner"
        ],
        "hand": [
          "Firefist Adept"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Firefist Adept"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Firefist Adept"
          ]
        },
        {
          "graveyard": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "counts only itself when it is the only Wizard",
    "players": [
      {
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ],
        "hand": [
          "Firefist Adept"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Firefist Adept"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: counts Wizards as it resolves, including one already on the battlefield",
    "players": [
      {
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Firefist Adept"],
        "hand": ["Firefist Adept"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Firefist Adept" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Firefist Adept"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  }
