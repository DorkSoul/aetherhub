[
  {
    "name": "tap adds a charge counter",
    "players": [
      {
        "battlefield": [
          "Otherworld Atlas"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Otherworld Atlas",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Otherworld Atlas": {
          "charge": 1
        }
      },
