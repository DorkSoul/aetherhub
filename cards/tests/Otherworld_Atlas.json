  {
    "name": "each player draws one per charge counter",
    "players": [
      {
        "battlefield": [
          {
            "name": "Otherworld Atlas",
            "counters": {
              "charge": 3
            }
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Otherworld Atlas",
        "ability": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3
        },
        {
          "hand_count": 3
        }
      ]
    }
  },
  {
    "name": "no counters means no cards",
    "players": [
      {
        "battlefield": [
          "Otherworld Atlas"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Otherworld Atlas",
        "ability": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
