[
 {
  "name": "makes a saproling by tapping another creature",
  "players": [
   {
    "battlefield": [
     {
      "name": "Selesnya Evangel",
      "sick": false
     },
     "Forest",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Selesnya Evangel"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Selesnya Evangel",
      "Forest",
      "Grizzly Bears",
      "Saproling"
     ]
    },
    {}
   ],
   "tapped": {
    "Grizzly Bears": true,
    "Selesnya Evangel": true
   }
  }
 },
 {
  "name": "needs another untapped creature",
  "players": [
   {
    "battlefield": [
     {
      "name": "Selesnya Evangel",
      "sick": false
     },
     "Forest",
     {
      "name": "Grizzly Bears",
      "tapped": true
     }
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Selesnya Evangel",
    "illegal": true
   }
  ],
  "expect": {}
 },
 {
  "name": "ruling: a summoning-sick creature can be tapped to pay the cost",
  "players": [ { "battlefield": [ { "name": "Selesnya Evangel", "sick": false }, "Forest", { "name": "Grizzly Bears", "sick": true } ] }, {} ],
  "steps": [ { "activate": "Selesnya Evangel" }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Saproling"] }, {} ], "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "ruling: Selesnya Evangel itself must have been under your control since your most recent turn",
  "players": [ { "battlefield": [ { "name": "Selesnya Evangel", "sick": true }, "Forest", "Grizzly Bears" ] }, {} ],
  "steps": [ { "activate": "Selesnya Evangel", "illegal": true } ],
  "expect": { "players": [ { "battlefield_lacks": ["Saproling"] }, {} ] }
 }
]