[
  {
    "name": "puts a +1/+1 counter on the chosen creature and creates a Food",
    "players": [
      { "hand": ["The Art of Tea"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "The Art of Tea", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3] },
      "players": [ { "battlefield_has": ["Food"] }, {} ]
    }
  },
  {
    "name": "with no target chosen it still creates a Food",
    "players": [
      { "hand": ["The Art of Tea"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "The Art of Tea", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "players": [ { "battlefield_has": ["Food"] }, {} ]
    }
  },
  {
    "name": "ruling: if its only target is illegal when it resolves, it does nothing and no Food is created",
    "players": [
      { "hand": ["The Art of Tea"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "The Art of Tea", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Food"], "graveyard": ["Grizzly Bears", "The Art of Tea"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
