[
  {
    "name": "first strike: a 1/1 blocker dies to the first-strike damage and deals none back",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false } ] },
      { "battlefield": [ "Llanowar Elves" ] }
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1" } ] },
      { "block": [ { "blocker": "Llanowar Elves", "attacker": "Pikemen" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Pikemen"] },
        { "graveyard": ["Llanowar Elves"], "life": 20 }
      ]
    }
  },
  {
    "name": "a lone Pikemen with no band connects for 1",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19 }
      ]
    }
  },
  {
    "name": "a band of Pikemen and Grizzly Bears is blocked as a group: blocking the Bears blocks the band",
    "players": [
      {
        "battlefield": [
          { "name": "Pikemen", "sick": false },
          { "name": "Grizzly Bears", "sick": false }
        ]
      },
      { "battlefield": [ "Hill Giant" ] }
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: the attacking player divides the blocker's damage; all 3 to Grizzly Bears",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      { "battlefield": [ "Hill Giant" ] }
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2", "answers": [ "Grizzly Bears=3" ] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears"], "battlefield_has": ["Pikemen"] },
        { "graveyard_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: the attacking player divides the blocker's damage; all 3 to Pikemen, the Bears survive",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      { "battlefield": [ "Hill Giant" ] }
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2", "answers": [ "Pikemen=3" ] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Pikemen"], "battlefield_has": ["Grizzly Bears"] },
        { "graveyard_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: a band takes at most one nonbanding creature: Pikemen, Bears and Hill Giant is an illegal attack",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false }, { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 }, { "card": "Hill Giant", "at": "p1", "band": 1 } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "ruling control: Pikemen plus one nonbanding Hill Giant is a legal band; 1 + 3 damage connects",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false }, { "name": "Hill Giant", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1", "band": 1 }, { "card": "Hill Giant", "at": "p1", "band": 1 } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: banded creatures must attack the same player or planeswalker: Pikemen at p1 and Bears at Test Walker is illegal",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      { "battlefield": [ "Test Walker" ] }
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "Test Walker", "band": 1 } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 20, "battlefield_has": ["Test Walker"] } ]
    }
  },
  {
    "name": "ruling control: a band attacking the same player together is legal; 1 + 2 damage connects",
    "players": [
      { "battlefield": [ { "name": "Pikemen", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      { "battlefield": [ "Test Walker" ] }
    ],
    "steps": [
      { "attack": [ { "card": "Pikemen", "at": "p1", "band": 1 }, { "card": "Grizzly Bears", "at": "p1", "band": 1 } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  }
]
