[
  {
    "name": "sacrificed when you play another land",
    "players": [
      { "hand": ["Forest"], "battlefield": ["City of Traitors"] },
      {}
    ],
    "steps": [
      { "play_land": "Forest" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest"], "graveyard": ["City of Traitors"] },
        {}
      ]
    }
  },
  {
    "name": "taps for two colorless",
    "players": [
      { "battlefield": ["City of Traitors"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "City of Traitors", "color": "C" }
    ],
    "expect": {
      "players": [
        { "pool": { "C": 2 } },
        {}
      ],
      "tapped": { "City of Traitors": true }
    }
  },
  {
    "name": "does not trigger on its own being played",
    "players": [
      { "hand": ["City of Traitors"], "battlefield": ["Forest"] },
      {}
    ],
    "steps": [
      { "play_land": "City of Traitors" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "City of Traitors"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a land put onto the battlefield without being played does not trigger",
    "players": [
      { "hand": ["Rampant Growth"], "battlefield": ["City of Traitors", "Forest", "Forest"], "library": ["Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Rampant Growth" },
      { "resolve": true, "answers": ["Mountain"] }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["City of Traitors", "Mountain"], "graveyard": ["Rampant Growth"] }, {} ]
    }
  }
]
