[
  { "name": "parley: nonland revealed is investigated and drawn by each player",
    "players": [ { "battlefield": ["Innocuous Researcher"], "library": ["Grizzly Bears"] }, { "library": ["Island"] } ],
    "start": "Main1",
    "steps": [ { "attack": [ { "card": "Innocuous Researcher", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Clue"], "hand": ["Grizzly Bears"] }, { "hand": ["Island"] } ] } },
  { "name": "parley: only lands revealed means no clue, but each player still draws",
    "players": [ { "battlefield": ["Innocuous Researcher"], "library": ["Forest"] }, { "library": ["Swamp"] } ],
    "start": "Main1",
    "steps": [ { "attack": [ { "card": "Innocuous Researcher", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Clue"], "hand": ["Forest"] }, { "hand": ["Swamp"] } ] } },
  { "name": "end step: untap lands and cannot cast until your next turn",
    "players": [ { "battlefield": ["Innocuous Researcher", { "name": "Mountain", "tapped": true }], "hand": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
    "start": "Main2",
    "steps": [ { "advance_to": "End", "answers": [true] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, {} ], "tapped": { "Mountain": false } } },
  { "name": "end step: declining leaves lands tapped and spells castable",
    "players": [ { "battlefield": ["Innocuous Researcher", { "name": "Mountain", "tapped": true }, "Mountain"], "hand": ["Lightning Bolt"] }, { "battlefield": ["Grizzly Bears"] } ],
    "start": "Main2",
    "steps": [ { "advance_to": "End", "answers": [false] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: Wrench, a Clue artifact card, can be sacrificed to pay Alquist Proft's Clue cost",
    "players": [ { "battlefield": ["Alquist Proft, Master Sleuth", "Wrench", "Plains", "Island", "Island"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Alquist Proft, Master Sleuth", "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Alquist Proft, Master Sleuth"], "battlefield_lacks": ["Wrench"] }, {} ] } },
  { "name": "ruling: a Clue sacrificed for Alquist Proft cannot also be sacrificed for its own draw ability",
    "players": [ { "battlefield": ["Alquist Proft, Master Sleuth", "Clue", "Plains", "Island", "Island"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Alquist Proft, Master Sleuth", "answers": [0] }, { "resolve": true }, { "activate": "Clue", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Alquist Proft, Master Sleuth"], "battlefield_lacks": ["Clue"] }, {} ] } },
  { "name": "ruling: sacrificing a Clue for any reason (Alquist Proft's cost) triggers 'whenever you sacrifice a Clue'",
    "players": [ { "battlefield": ["Daring Sleuth // Bearer of Overwhelming Truths", "Alquist Proft, Master Sleuth", "Clue", "Plains", "Island", "Island"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Alquist Proft, Master Sleuth", "answers": [0] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bearer of Overwhelming Truths", "Alquist Proft, Master Sleuth"] }, {} ], "pt": { "Bearer of Overwhelming Truths": [3, 2] } } }
]
