[
  {
    "name": "combat damage to a player doubles the enchanted creature's controller's life",
    "players": [
      {
        "hand": [
          "Celestial Mantle"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Celestial Mantle",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 40
        },
        {
          "life": 15
        }
      ]
    }
  },
  {
    "name": "damage to a blocker does not trigger it",
    "players": [
      {
        "hand": [
          "Celestial Mantle"
        ],
        "battlefield": [
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Plains",
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Celestial Mantle",
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Hill Giant",
            "attacker": "Grizzly Bears"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: a negative life total is doubled (Platinum Angel lets the controller stay below 0)",
    "players": [
      { "life": -4, "hand": ["Celestial Mantle"], "battlefield": ["Platinum Angel", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Celestial Mantle", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": -8 }, { "life": 15 } ] }
  },
  {
    "name": "ruling: the doubled player is the creature's controller when the ability resolves (Control Magic)",
    "players": [
      { "hand": ["Celestial Mantle"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      { "hand": ["Control Magic"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Celestial Mantle", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "player": 1, "cast": "Control Magic", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "player": 1, "attack": [ { "card": "Grizzly Bears", "at": "p0" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 15 }, { "life": 40 } ] }
  },
  {
    "name": "ruling: lifelink gain from the same combat damage happens before the doubling resolves",
    "players": [
      { "hand": ["Celestial Mantle"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears", "Dream Trawler"] },
      {}
    ],
    "steps": [
      { "cast": "Celestial Mantle", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Dream Trawler", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 48 }, { "life": 11 } ] }
  },
  {
    "name": "ruling: the life gained equals the doubled total (7 life becomes 14)",
    "players": [
      { "life": 7, "hand": ["Celestial Mantle"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Celestial Mantle", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 14 }, { "life": 15 } ] }
  }
]