   "players": [ { "hand": ["Plains"], "battlefield": ["Toph, Earthbending Master", "Forest"] }, {} ],
   "steps": [ { "play_land": "Plains" }, { "resolve": true }, { "attack": [ { "card": "Toph, Earthbending Master", "at": "p1" } ] }, { "resolve": true, "targets": ["Forest"] }, { "resolve": true }, { "tap_for_mana": "Forest" } ],
   "expect": { "players": [ { "pool": { "G": 1 } }, {} ], "pt": { "Forest": [1, 1] }, "colors": { "Forest": [] } } },
 { "name": "ruling: an earthbent land bounced to hand does not return to the battlefield",
   "players": [ { "hand": ["Forest", "Unsummon"], "battlefield": ["Toph, Earthbending Master", "Island", "Plains"] }, {} ],
   "steps": [ { "play_land": "Forest" }, { "resolve": true }, { "attack": [ { "card": "Toph, Earthbending Master", "at": "p1" } ] }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "cast": "Unsummon", "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Plains"], "battlefield_lacks": ["Plains"] }, {} ] } },
 { "name": "ruling: an earthbent land that dies returns to the battlefield tapped",
   "players": [ { "hand": ["Forest"], "battlefield": ["Toph, Earthbending Master", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "play_land": "Forest" }, { "resolve": true }, { "attack": [ { "card": "Toph, Earthbending Master", "at": "p1" } ] }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Toph, Earthbending Master", "Plains", "Forest"] }, {} ], "tapped": { "Plains": true } } }
