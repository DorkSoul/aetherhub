   "steps": [ { "play_land": "Forest" }, { "resolve": true }, { "attack": [ { "card": "Toph, Earthbending Master", "at": "p1" } ] }, { "resolve": true, "targets": ["Plains"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Toph, Earthbending Master", "Plains"] }, {} ], "pt": { "Plains": [1, 1] }, "counters": { "Plains": { "p1p1": 1 } }, "keywords": { "Plains": ["Haste"] } } },
 { "name": "landfall alone earthbends nothing; the earthbend needs an attack",
   "players": [ { "hand": ["Forest"], "battlefield": ["Toph, Earthbending Master", "Plains"] }, {} ],
   "steps": [ { "play_land": "Forest" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Toph, Earthbending Master", "Plains", "Forest"] }, {} ], "counters": { "Plains": {} } } },
