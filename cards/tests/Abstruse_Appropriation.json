[
 {
  "name": "exiles target nonland permanent, then it can be cast with any mana",
  "players": [
   { "hand": ["Abstruse Appropriation"], "battlefield": ["Plains", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Abstruse Appropriation", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears"] },
    { "battlefield": [] }
   ]
  }
 },
 {
  "name": "target must be a nonland permanent",
  "players": [
   { "hand": ["Abstruse Appropriation"], "battlefield": ["Plains", "Swamp", "Mountain", "Mountain"] },
   { "battlefield": ["Forest"] }
  ],
  "steps": [
   { "cast": "Abstruse Appropriation", "targets": ["Forest"], "illegal": true }
  ],
  "expect": {
   "players": [
    { "hand": ["Abstruse Appropriation"] },
    { "battlefield": ["Forest"] }
   ]
  }
 },
 {
  "name": "ruling: a token exiled this way ceases to exist and cannot be cast",
  "players": [
   { "hand": ["Abstruse Appropriation", "Raise the Alarm"], "battlefield": ["Plains", "Plains", "Swamp", "Swamp", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Raise the Alarm" },
   { "resolve": true },
   { "cast": "Abstruse Appropriation", "targets": ["Soldier"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Soldier"], "exile": [], "graveyard_has": ["Abstruse Appropriation"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: the exiled creature can be cast only when the stack is empty",
  "players": [
   { "hand": ["Abstruse Appropriation", "Shock"], "battlefield": ["Plains", "Swamp", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Abstruse Appropriation", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "cast": "Shock", "targets": ["p1"] },
   { "cast": "Hill Giant", "illegal": true },
   { "resolve": true },
   { "cast": "Hill Giant" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant"] },
    { "life": 18, "battlefield_lacks": ["Hill Giant"] }
   ]
  }
 }
]
