[
  {
    "name": "does not untap during your untap step",
    "players": [
      {
        "battlefield": [
          "Dwarven Patrol"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Dwarven Patrol",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "turn": 3,
      "tapped": {
        "Dwarven Patrol": true
      }
    }
  },
  {
    "name": "casting a nonred spell untaps it",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          "Dwarven Patrol",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Dwarven Patrol",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Main1"
      },
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "turn": 3,
      "tapped": {
        "Dwarven Patrol": false
      }
    }
  },
  {
    "name": "ruling: playing a land does not trigger the untap (lands are not spells)",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Dwarven Patrol"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Dwarven Patrol", "at": "p1" } ] },
      { "advance_to": "Main2" },
      { "play_land": "Forest" }
    ],
    "expect": {
      "tapped": { "Dwarven Patrol": true }
    }
  }
]
