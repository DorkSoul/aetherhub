[
  {
    "name": "cannot block a creature without flying",
    "players": [{ "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Vaporkin"] }],
    "steps": [{ "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "advance_to": "Main2" }],
    "expect": { "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "life": 18, "battlefield_has": ["Vaporkin"] }] }
  },
  {
    "name": "can block a creature with flying",
    "players": [{ "battlefield": ["Serra Angel"] }, { "battlefield": ["Vaporkin"] }],
    "steps": [{ "attack": [{ "card": "Serra Angel", "at": "p1" }] }, { "block": [{ "blocker": "Vaporkin", "attacker": "Serra Angel" }] }, { "advance_to": "Main2" }],
    "expect": { "players": [{ "battlefield_has": ["Serra Angel"] }, { "graveyard": ["Vaporkin"] }] }
  },
  {
    "name": "cannot block a non-flying attacker even with a second blocker available",
    "players": [{ "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Vaporkin", "Hill Giant"] }],
    "steps": [{ "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "block": [{ "blocker": "Vaporkin", "attacker": "Grizzly Bears" }] }, { "advance_to": "Main2" }],
    "expect": { "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "life": 18, "battlefield_has": ["Vaporkin", "Hill Giant"] }] }
  }
]
