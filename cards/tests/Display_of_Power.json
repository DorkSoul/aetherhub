[
 {
  "name": "copies two spells",
  "players": [
   {
    "hand": [
     "Lightning Bolt",
     "Shock"
    ],
    "battlefield": [
     "Mountain",
     "Mountain"
    ]
   },
   {
    "hand": [
     "Display of Power"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Shock",
    "targets": [
     "p1"
    ]
   },
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "pass": true
   },
   {
    "player": 1,
    "cast": "Display of Power",
    "targets": [
     {
      "stack": "Lightning Bolt"
     },
     {
      "stack": "Shock"
     }
    ]
   },
   {
    "resolve": true,
    "auto": true
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Lightning Bolt",
      "Shock"
     ]
    },
    {
     "life": 10,
     "graveyard": [
      "Display of Power"
     ]
    }
   ]
  }
 },
 {
  "name": "copies a single spell",
  "players": [
   {
    "hand": [
     "Lightning Bolt"
    ],
    "battlefield": [
     "Mountain"
    ]
   },
   {
    "hand": [
     "Display of Power"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   }
  ],
  "steps": [
   {
    "cast": "Lightning Bolt",
    "targets": [
     "p1"
    ]
   },
   {
    "pass": true
   },
   {
    "player": 1,
    "cast": "Display of Power",
    "targets": [
     {
      "stack": "Lightning Bolt"
     }
    ]
   },
   {
    "resolve": true,
    "auto": true
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 14
    }
   ]
  }
 },
 {
  "name": "ruling: the copy may be retargeted to another legal target (the copy's controller chooses)",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
   { "hand": ["Display of Power"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "pass": true },
   { "player": 1, "cast": "Display of Power", "targets": [{ "stack": "Lightning Bolt" }] },
   { "resolve": true, "answers": ["p0"] }
  ],
  "expect": { "players": [ { "life": 17 }, { "life": 17 } ] }
 },
 {
  "name": "ruling: the copy has the same X as the original Fireball",
  "players": [
   { "hand": ["Fireball"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "hand": ["Display of Power"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
  ],
  "steps": [
   { "cast": "Fireball", "targets": ["p1"], "answers": [2] },
   { "pass": true },
   { "player": 1, "cast": "Display of Power", "targets": [{ "stack": "Fireball" }] },
   { "resolve": true, "auto": true }
  ],
  "expect": { "players": [ { "life": 20 }, { "life": 16 } ] }
 },
 {
  "name": "ruling: the copy of a split Fireball keeps the division and the additional cost's effect",
  "players": [
   { "hand": ["Fireball"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "hand": ["Display of Power"], "battlefield": ["Mountain", "Mountain", "Mountain", "Hill Giant"] }
  ],
  "steps": [
   { "cast": "Fireball", "targets": ["p1", "Hill Giant"], "answers": [4] },
   { "pass": true },
   { "player": 1, "cast": "Display of Power", "targets": [{ "stack": "Fireball" }] },
   { "resolve": true, "auto": true }
  ],
  "expect": {
   "players": [ { "life": 20 }, { "life": 16, "graveyard_has": ["Hill Giant"] } ]
  }
 },
 {
  "name": "ruling: the copy has the same mode as the original Abrade (damage, not destroy)",
  "players": [
   { "hand": ["Abrade"], "battlefield": ["Mountain", "Mountain"] },
   { "hand": ["Display of Power"], "battlefield": ["Mountain", "Mountain", "Mountain", "Serra Angel"] }
  ],
  "steps": [
   { "cast": "Abrade", "answers": [0], "targets": ["Serra Angel"] },
   { "pass": true },
   { "player": 1, "cast": "Display of Power", "targets": [{ "stack": "Abrade" }] },
   { "resolve": true, "auto": true }
  ],
  "expect": { "players": [ {}, { "graveyard_has": ["Serra Angel"] } ] }
 }
]
