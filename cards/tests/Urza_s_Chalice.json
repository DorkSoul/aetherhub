[
  {
    "name": "paying 1 for an artifact spell gains 1 life",
    "players": [{ "hand": ["Utility Knife"], "battlefield": ["Urza's Chalice", "Plains", "Plains", "Plains"] }, {}],
    "steps": [
      { "cast": "Utility Knife" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 21, "battlefield_has": ["Utility Knife"] }, {}] }
  },
  {
    "name": "declining to pay gains no life",
    "players": [{ "hand": ["Utility Knife"], "battlefield": ["Urza's Chalice", "Plains", "Plains", "Plains"] }, {}],
    "steps": [
      { "cast": "Utility Knife" },
      { "resolve": true, "answers": [false] },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 20 }, {}] }
  },
  {
    "name": "ruling: casting Urza's Chalice itself does not trigger it",
    "players": [{ "hand": ["Urza's Chalice"], "battlefield": ["Plains", "Plains"] }, {}],
    "steps": [
      { "cast": "Urza's Chalice" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "life": 20, "battlefield_has": ["Urza's Chalice"] }, {}] }
  }
]
