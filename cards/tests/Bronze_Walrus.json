[
  {
    "name": "taps for mana of the chosen color",
    "players": [{ "battlefield": ["Bronze Walrus"] }, {}],
    "steps": [{ "tap_for_mana": "Bronze Walrus", "color": "R" }],
    "expect": { "players": [{ "pool": { "R": 1 } }, {}], "tapped": { "Bronze Walrus": true } }
  },
  {
    "name": "enters and scries 2 without changing the battlefield",
    "players": [
      { "hand": ["Bronze Walrus"], "battlefield": ["Mountain", "Mountain", "Mountain"], "library": ["Forest", "Island"] },
      {}
    ],
    "steps": [{ "cast": "Bronze Walrus" }, { "resolve": true, "auto": true }],
    "expect": { "players": [{ "battlefield_has": ["Bronze Walrus"] }, {}], "pt": { "Bronze Walrus": [2, 2] } }
  }
]
