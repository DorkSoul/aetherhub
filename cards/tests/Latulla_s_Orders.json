[
  {
    "name": "enchanted creature hits: controller may destroy an artifact the damaged player controls",
    "players": [
      { "hand": ["Latulla's Orders"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Latulla's Orders", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2", "answers": [true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Latulla's Orders"] },
        { "battlefield_lacks": ["Sol Ring"], "graveyard_has": ["Sol Ring"], "life": 18 }
      ]
    }
  },
  {
    "name": "controller declines: the artifact stays",
    "players": [
      { "hand": ["Latulla's Orders"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Sol Ring"] }
    ],
    "steps": [
      { "cast": "Latulla's Orders", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2", "answers": [false] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "battlefield_has": ["Sol Ring"], "life": 18 }
      ]
    }
  },
  {
    "name": "an artifact the attacked player does not control is not a target",
    "players": [
      { "hand": ["Latulla's Orders"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears", "Sol Ring"] },
      {}
    ],
    "steps": [
      { "cast": "Latulla's Orders", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Sol Ring"] },
        { "life": 18 }
      ]
    }
  }
]
