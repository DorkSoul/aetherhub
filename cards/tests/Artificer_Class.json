[
  { "name": "level 2: reveals the first artifact card into hand",
    "players": [ { "battlefield": ["Island", "Island", { "name": "Artificer Class", "counters": { "level": 1 } }], "library": ["Grizzly Bears", "Sol Ring", "Lightning Bolt"] }, {} ],
    "steps": [ { "activate": "Artificer Class", "ability": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Sol Ring"] }, {} ], "counters": { "Artificer Class": { "level": 2 } } } },
  { "name": "first artifact spell each turn costs 1 less; the second does not",
    "players": [ { "hand": ["Mind Stone", "Mind Stone"], "battlefield": ["Island", { "name": "Artificer Class", "counters": { "level": 1 } }] }, {} ],
    "steps": [ { "cast": "Mind Stone" }, { "resolve": true }, { "cast": "Mind Stone", "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mind Stone"], "hand": ["Mind Stone"] }, {} ] } },
  { "name": "level 3: {5}{U} adds a level counter",
    "players": [ { "battlefield": ["Island", "Plains", "Plains", "Plains", "Plains", "Plains", { "name": "Artificer Class", "counters": { "level": 2 } }] }, {} ],
    "steps": [ { "activate": "Artificer Class", "ability": 1 }, { "resolve": true } ],
    "expect": { "counters": { "Artificer Class": { "level": 3 } } } },
  { "name": "level 3 needs six mana",
    "players": [ { "battlefield": ["Island", "Plains", "Plains", "Plains", "Plains", { "name": "Artificer Class", "counters": { "level": 2 } }] }, {} ],
    "steps": [ { "activate": "Artificer Class", "ability": 1, "illegal": true } ],
    "expect": { "counters": { "Artificer Class": { "level": 2 } } } },
  { "name": "level 3: at your end step create a copy of target artifact you control",
    "players": [ { "battlefield": ["Bonesplitter", { "name": "Artificer Class", "counters": { "level": 3 } }] }, {} ],
    "steps": [ { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bonesplitter", "Bonesplitter"] }, {} ] } },
  { "name": "level 2: no copy at your end step",
    "players": [ { "battlefield": ["Bonesplitter", { "name": "Artificer Class", "counters": { "level": 2 } }] }, {} ],
    "steps": [ { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield_has": ["Bonesplitter"] }, {} ], "stack_empty": true } },
  { "name": "enters the battlefield at level 1",
    "players": [ { "hand": ["Artificer Class"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "cast": "Artificer Class" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Artificer Class"] }, {} ], "counters": { "Artificer Class": { "level": 1 } } } },
  { "name": "ruling: gaining a level is an ability on the stack; the level counter arrives on resolution",
    "players": [ { "battlefield": ["Island", "Island", { "name": "Artificer Class", "counters": { "level": 1 } }] }, {} ],
    "steps": [ { "activate": "Artificer Class", "ability": 0 } ],
    "expect": { "stack_empty": false, "counters": { "Artificer Class": { "level": 1 } } } },
  { "name": "ruling: each level resolves in turn; level 2 then level 3 gain their abilities",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", "Island", { "name": "Artificer Class", "counters": { "level": 1 } }], "library": ["Sol Ring"] }, {} ],
    "steps": [ { "activate": "Artificer Class", "ability": 0 }, { "resolve": true }, { "resolve": true }, { "activate": "Artificer Class", "ability": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Sol Ring"] }, {} ], "counters": { "Artificer Class": { "level": 3 } } } },
  { "name": "ruling: the level 2 ability can't be activated again at level 2",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", { "name": "Artificer Class", "counters": { "level": 2 } }] }, {} ],
    "steps": [ { "activate": "Artificer Class", "ability": 0, "illegal": true } ],
    "expect": { "counters": { "Artificer Class": { "level": 2 } } } },
  { "name": "ruling: the level 3 ability can't be activated at level 1 even with enough mana",
    "players": [ { "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island", "Island", { "name": "Artificer Class", "counters": { "level": 1 } }] }, {} ],
    "steps": [ { "activate": "Artificer Class", "ability": 1, "illegal": true } ],
    "expect": { "counters": { "Artificer Class": { "level": 1 } } } },
  { "name": "ruling: at level 3 the level 1 cost reduction still applies",
    "players": [ { "hand": ["Mind Stone"], "battlefield": ["Island", { "name": "Artificer Class", "counters": { "level": 3 } }] }, {} ],
    "steps": [ { "cast": "Mind Stone" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Mind Stone"], "hand_count": 0 }, {} ], "counters": { "Artificer Class": { "level": 3 } } } }
]
