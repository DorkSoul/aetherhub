[
  { "name": "entering makes each other creature base 1/1 until end of turn",
    "players": [ { "hand": ["Graven Dominator"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Serra Angel"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Graven Dominator" }, { "resolve": true } ],
    "expect": { "pt": { "Serra Angel": [1, 1], "Grizzly Bears": [1, 1], "Graven Dominator": [4, 4] }, "players": [ { "battlefield_has": ["Graven Dominator"] }, {} ] } },
  { "name": "dying with no creature to haunt: it stays in the graveyard",
    "players": [ { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Graven Dominator"] }, {} ],
    "steps": [ { "cast": "Murder", "targets": ["Graven Dominator"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Graven Dominator", "Murder"] }, {} ] } },
  { "name": "dying exiles it haunting the only other creature",
    "players": [ { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp", "Graven Dominator"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Murder", "targets": ["Graven Dominator"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Graven Dominator"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "the haunted creature dying makes each other creature base 1/1",
    "players": [ { "hand": ["Murder", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Mountain", "Graven Dominator", "Serra Angel"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Murder", "targets": ["Graven Dominator"] }, { "resolve": true, "answers": ["Grizzly Bears"] }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Serra Angel": [1, 1] }, "players": [ { "exile": ["Graven Dominator"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a pump resolved before it enters stays on top of the 1/1 base",
    "players": [ { "hand": ["Graven Dominator", "Giant Growth"], "battlefield": ["Forest", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Serra Angel"] }, {} ],
    "steps": [ { "cast": "Giant Growth", "targets": ["Serra Angel"] }, { "resolve": true }, { "cast": "Graven Dominator" }, { "resolve": true } ],
    "expect": { "pt": { "Serra Angel": [4, 4], "Graven Dominator": [4, 4] } } }
]
