[
  {
    "name": "cast: adds one of each color when it enters",
    "players": [ { "hand": ["Iridescent Tiger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Iridescent Tiger" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "pool": { "W": 1, "U": 1, "B": 1, "R": 1, "G": 1 }, "battlefield_has": ["Iridescent Tiger"] }, {} ]
    }
  },
  {
    "name": "needs five mana to cast",
    "players": [ { "hand": ["Iridescent Tiger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Iridescent Tiger", "illegal": true }
    ]
  },
  {
    "name": "ruling: the enters trigger can be responded to with an instant",
    "players": [
      { "hand": ["Iridescent Tiger"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Iridescent Tiger" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 17, "pool": { "W": 1, "U": 1, "B": 1, "R": 1, "G": 1 }, "battlefield_has": ["Iridescent Tiger"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  }
]
