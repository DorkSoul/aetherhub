[
  { "name": "noncreature spell gives prowess +1/+1 until end of turn",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jeskai Student", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Jeskai Student": [2, 4] }, "keywords": { "Jeskai Student": ["Prowess"] } } },
  { "name": "creature spell does not trigger prowess",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Jeskai Student", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Jeskai Student": [1, 3] } } },
  { "name": "ruling: a land played does not trigger prowess",
    "players": [ { "hand": ["Mountain"], "battlefield": ["Jeskai Student"] }, {} ],
    "steps": [ { "play_land": "Mountain" } ],
    "expect": { "pt": { "Jeskai Student": [1, 3] } } },
  { "name": "ruling: prowess resolves before the spell that triggered it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jeskai Student", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "pt": { "Jeskai Student": [2, 4], "Grizzly Bears": [2, 2] } } },
  { "name": "ruling: prowess still resolves when the spell it triggered from fizzles",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jeskai Student", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "pt": { "Jeskai Student": [2, 4] }, "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } }
]
