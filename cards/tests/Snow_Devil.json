  {
    "name": "first strike while blocking with a snow land: the blocker survives the trade",
    "players": [
      { "hand": ["Snow Devil"], "battlefield": ["Snow-Covered Island", "Snow-Covered Forest", "Juggernaut"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Snow Devil", "targets": ["p1:Hill Giant"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [{ "card": "Juggernaut", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Juggernaut" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "graveyard": ["Juggernaut"] }, { "battlefield_has": ["Hill Giant"] }] }
  },
  {
    "name": "no snow land: no first strike, so the enchanted blocker dies in the trade",
    "players": [
      { "hand": ["Snow Devil"], "battlefield": ["Island", "Forest", "Juggernaut"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Snow Devil", "targets": ["p1:Hill Giant"] },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [{ "card": "Juggernaut", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Juggernaut" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "graveyard": ["Juggernaut", "Snow Devil"] }, { "graveyard": ["Hill Giant"] }] }
  }
