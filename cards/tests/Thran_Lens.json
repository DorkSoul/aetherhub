[
  {
    "name": "all permanents are colorless: a green creature counts as colorless",
    "players": [
      { "hand": ["Thran Lens"], "battlefield": ["Reaver Drone", "Grizzly Bears", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Thran Lens" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [{ "life": 20 }, {}]
    }
  },
  {
    "name": "without Thran Lens a green creature is not colorless",
    "players": [
      { "battlefield": ["Reaver Drone", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [{ "life": 19 }, {}]
    }
  },
  {
    "name": "ruling: a later effect can still add colour to a permanent (Painter's Servant makes the green Bears red)",
    "players": [
      { "hand": ["Thran Lens", "Painter's Servant"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Thran Lens" },
      { "resolve": true },
      { "cast": "Painter's Servant" },
      { "resolve": true, "answers": ["R"] }
    ],
    "expect": {
      "players": [ {}, {} ],
      "colors": { "Grizzly Bears": ["R"], "Painter's Servant": ["R"] }
    }
  },
  {
    "name": "ruling: Thran Lens does not make permanents artifacts (Disenchant cannot target the Bears)",
    "players": [
      { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains", "Thran Lens", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Disenchant", "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand": ["Disenchant"] }, {} ]
    }
  }
]
