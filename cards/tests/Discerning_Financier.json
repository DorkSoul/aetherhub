[
  {
    "name": "upkeep: creates a Treasure when an opponent controls more lands",
    "players": [
      {
        "battlefield": [
          "Discerning Financier",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Treasure"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "upkeep: equal land counts create no Treasure",
    "players": [
      {
        "battlefield": [
          "Discerning Financier",
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Treasure"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "{2}{W}: opponent gains control of a Treasure and you draw a card",
    "players": [
      {
        "battlefield": [
          "Discerning Financier",
          "Plains",
          "Plains",
          "Plains",
          "Treasure"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Discerning Financier",
        "targets": [
          "Treasure"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "battlefield_lacks": [
            "Treasure"
          ]
        },
        {
          "battlefield_has": [
            "Treasure"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: if the target Treasure is gone when the ability resolves, it does not resolve and no card is drawn",
    "players": [
      {
        "hand": [],
        "battlefield": [
          "Discerning Financier",
          "Plains",
          "Plains",
          "Plains",
          "Treasure"
        ]
      },
      {
        "hand": ["Shatter"],
        "battlefield": ["Mountain", "Mountain"]
      }
    ],
    "steps": [
      {
        "activate": "Discerning Financier",
        "targets": ["Treasure"]
      },
      { "pass": true },
      {
        "cast": "Shatter",
        "targets": ["Treasure"],
        "player": 1
      },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 0,
          "battlefield_lacks": ["Treasure"],
          "battlefield_has": ["Discerning Financier"]
        },
        {
          "graveyard_has": ["Shatter"]
        }
      ]
    }
  }
]
