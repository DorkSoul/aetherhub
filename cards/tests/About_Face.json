[
 { "name": "a 2/1 Goblin Piker becomes 1/2 until end of turn",
   "players": [ { "hand": ["About Face"], "battlefield": ["Mountain", "Goblin Piker"] }, {} ],
   "steps": [ { "cast": "About Face" }, { "resolve": true } ],
   "expect": { "pt": { "Goblin Piker": [1, 2] } } },
 { "name": "casting it twice on the same creature switches back",
   "players": [ { "hand": ["About Face", "About Face"], "battlefield": ["Mountain", "Mountain", "Goblin Piker"] }, {} ],
   "steps": [ { "cast": "About Face" }, { "resolve": true }, { "cast": "About Face" }, { "resolve": true } ],
   "expect": { "pt": { "Goblin Piker": [2, 1] } } },
 { "name": "no creature to target: the spell cannot be cast",
   "players": [ { "hand": ["About Face"], "battlefield": ["Mountain", "Island"] }, {} ],
   "steps": [ { "cast": "About Face", "illegal": true } ],
   "expect": { "players": [ { "hand_count": 1 }, {} ] } },
 { "name": "ruling: a later +2/+0 from equipment is applied before the switch, so a 2/1 with Bonesplitter becomes 1/4",
   "players": [ { "hand": ["About Face"], "battlefield": ["Mountain", "Mountain", "Goblin Piker", "Bonesplitter"] }, {} ],
   "steps": [ { "cast": "About Face", "targets": ["Goblin Piker"] }, { "resolve": true },
              { "activate": "Bonesplitter", "targets": ["Goblin Piker"] }, { "resolve": true } ],
   "expect": { "pt": { "Goblin Piker": [1, 4] } } },
 { "name": "ruling: nonlethal damage becomes lethal when the switch lowers toughness this turn",
   "players": [ { "hand": ["About Face"], "battlefield": ["Grizzly Bears", "Mountain"] }, { "battlefield": ["Novice Knight"] } ],
   "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
              { "block": [ { "blocker": "Novice Knight", "attacker": "Grizzly Bears" } ], "player": 1 },
              { "advance_to": "Main2" },
              { "cast": "About Face", "targets": ["Novice Knight"] },
              { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Novice Knight"] } ] } }
]
