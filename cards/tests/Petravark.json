    "players": [
      {
        "hand": [
          "Petravark",
          "Terror"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Petravark"
      },
      {
        "resolve": true,
        "targets": [
          "Island"
        ]
      },
      {
        "cast": "Terror",
        "targets": [
          "Petravark"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard_has": [
            "Petravark"
          ]
        },
        {
          "battlefield_has": [
            "Island"
          ]
        }
      ]
    }
  }
