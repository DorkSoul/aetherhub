[
  {
    "name": "ETB exiles target land",
    "players": [
      {
        "hand": [
          "Petravark"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Swamp"
        ]
      },
      {
        "battlefield": [
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Petravark"
      },
      {
