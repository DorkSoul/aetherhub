 {
  "name": "ruling: it is a creature spell, never an instant, so Negate (noncreature spells only) cannot counter it",
  "players": [
   { "hand": ["Defender of Chaos"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   { "hand": ["Negate"], "battlefield": ["Island", "Island"] }
  ],
  "steps": [
   { "cast": "Defender of Chaos" },
   { "cast": "Negate", "player": 1, "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Defender of Chaos"] },
    { "hand": ["Negate"] }
   ]
  }
 }
