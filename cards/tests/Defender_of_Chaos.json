  ],
  "steps": [
   {"advance_to": "Main1"},
   {"advance_to": "Main1"},
   {"attack": [{"card": "Defender of Chaos", "at": "p1"}]},
   {"block": [{"blocker": "p1:Benalish Marshal", "attacker": "Defender of Chaos"}], "player": 1},
   {"advance_to": "Main2"}
  ],
  "expect": {"players": [{}, {"life": 18}]}
 },
 {
  "name": "protection from white: damage from a blocked white creature is prevented",
  "players": [
   {"battlefield": ["Defender of Chaos"]},
   {"battlefield": ["Benalish Marshal"]}
  ],
  "steps": [
   {"advance_to": "Main2"},
   {"advance_to": "Main1", "player": 1},
