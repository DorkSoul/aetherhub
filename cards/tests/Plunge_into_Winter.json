[
  {
    "name": "taps the target creature, then scries and draws",
    "players": [{ "hand": ["Plunge into Winter"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Plunge into Winter", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Plunge into Winter"], "hand_count": 1 }, { "battlefield_has": ["Grizzly Bears"] }], "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "cast with no target still scries and draws",
    "players": [{ "hand": ["Plunge into Winter"], "battlefield": ["Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [{ "cast": "Plunge into Winter", "targets": [] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Plunge into Winter"], "hand_count": 1 }, { "battlefield_has": ["Grizzly Bears"] }], "tapped": { "Grizzly Bears": false } }
  },
  {
    "name": "ruling: a target already tapped on resolution still lets it scry and draw",
    "players": [ { "hand": ["Plunge into Winter"], "battlefield": ["Plains", "Island"], "library": ["Lightning Bolt", "Grizzly Bears"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Plunge into Winter", "targets": ["Grizzly Bears"] }, { "resolve": true, "answers": [[0]] } ],
    "expect": { "players": [ { "graveyard": ["Plunge into Winter"], "hand": ["Grizzly Bears"] }, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "ruling: target illegal on resolution, so no scry and no draw",
    "players": [ { "hand": ["Plunge into Winter"], "battlefield": ["Plains", "Island"], "library": ["Lightning Bolt"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [
      { "cast": "Plunge into Winter", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Plunge into Winter"], "hand_count": 0, "library_top": ["Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] }
  }
]
