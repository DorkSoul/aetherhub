[
 { "name": "for {3}, exiles the top card of your library",
   "players": [ { "battlefield": ["Island", "Island", "Island", "Precognition Field"], "library": ["Lightning Bolt", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Precognition Field" }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Lightning Bolt"] }, {} ] } },
 { "name": "casts an instant from the top of your library",
   "players": [ { "battlefield": ["Mountain", "Precognition Field"], "library": ["Lightning Bolt"] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
 { "name": "cannot cast a creature from the top of your library",
   "players": [ { "battlefield": ["Forest", "Forest", "Precognition Field"], "library": ["Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: a kicked spell cast from the top of the library still pays its kicker cost",
   "players": [ { "battlefield": ["Forest", "Forest", "Mountain", "Precognition Field", "Grizzly Bears"], "library": ["Colossal Growth"] }, {} ],
   "steps": [ { "cast": "Colossal Growth", "answers": [true], "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [6, 6] }, "keywords": { "Grizzly Bears": ["Trample", "Haste"] } } },
 { "name": "ruling: a sorcery on top of the library cannot be cast during combat",
   "start": "BeginCombat",
   "players": [ { "battlefield": ["Swamp", "Swamp", "Swamp", "Precognition Field"], "library": ["Mind Rot"] }, { "hand": ["Island", "Island"] } ],
   "steps": [ { "cast": "Mind Rot", "illegal": true } ],
   "expect": { "players": [ {}, { "hand_count": 2 } ] } },
 { "name": "ruling: the same sorcery on top of the library can be cast in a main phase",
   "players": [ { "battlefield": ["Swamp", "Swamp", "Swamp", "Precognition Field"], "library": ["Mind Rot"] }, { "hand": ["Island", "Island"] } ],
   "steps": [ { "cast": "Mind Rot", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Mind Rot"] }, { "graveyard": ["Island", "Island"] } ] } }
]
