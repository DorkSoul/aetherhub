    "steps": [ { "advance_to": "Main1" }, { "cast": "Bladebrand", "targets": ["Grizzly Bears"], "player": 1 }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 0 }, { "advance_to": "Main2", "player": 1 } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: with an Archetype on each side no creature has deathtouch: the opponent's Ambush Viper blocked by a 3/3 Hill Giant does not kill it",
    "players": [ { "battlefield": ["Archetype of Finality", { "name": "Hill Giant", "sick": false }] }, { "battlefield": ["Archetype of Finality", { "name": "Ambush Viper", "sick": false }] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "attack": [ { "card": "Ambush Viper", "at": "p0" } ], "player": 1 }, { "block": [ { "blocker": "Hill Giant", "attacker": "Ambush Viper" } ], "player": 0 }, { "advance_to": "Main2", "player": 1 } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "graveyard_has": ["Ambush Viper"] } ] } },
  { "name": "ruling: the Archetype's effect covers an opponent's creature that entered later: Ambush Viper cast after the Archetype is out still loses deathtouch",
