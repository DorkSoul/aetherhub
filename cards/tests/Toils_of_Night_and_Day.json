  { "name": "untap one target and decline the second",
    "players": [ { "hand": ["Toils of Night and Day"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, { "name": "Hill Giant", "tapped": true } ] } ],
    "steps": [ { "cast": "Toils of Night and Day", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true, "answers": [true, 1, false] } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": false, "Hill Giant": true } } },
  { "name": "ruling: the two targets must be different permanents (same creature twice is illegal to cast)",
    "players": [ { "hand": ["Toils of Night and Day"], "battlefield": ["Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Toils of Night and Day", "targets": ["Grizzly Bears", "Grizzly Bears"], "illegal": true }, { "cast": "Toils of Night and Day", "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true, "answers": [true, 0, true, 0] } ],
    "expect": { "players": [ {}, {} ], "tapped": { "Grizzly Bears": true, "Hill Giant": true } } }
