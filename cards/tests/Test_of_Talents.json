[
  { "name": "counters the spell and exiles same-named cards from graveyard, hand and library; the player draws one per card exiled from hand",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt", "Shock"], "graveyard": ["Lightning Bolt"], "library": ["Lightning Bolt", "Forest", "Mountain"], "battlefield": ["Mountain"] },
                 { "hand": ["Test of Talents"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Test of Talents", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true, "answers": [["Lightning Bolt"]] } ],
    "expect": { "players": [ { "graveyard": [], "exile": ["Lightning Bolt", "Lightning Bolt", "Lightning Bolt", "Lightning Bolt"], "hand": ["Shock", "Forest"] }, { "life": 20, "graveyard": ["Test of Talents"] } ], "stack_empty": true } },
  { "name": "the controller may choose to exile none of the cards from hand: no cards drawn",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "graveyard": ["Lightning Bolt"], "library": ["Forest", "Mountain"], "battlefield": ["Mountain"] },
                 { "hand": ["Test of Talents"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Test of Talents", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "graveyard": [], "exile": ["Lightning Bolt", "Lightning Bolt"], "hand": ["Lightning Bolt"] }, { "life": 20 } ], "stack_empty": true } },
  { "name": "cannot target a creature spell",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] }, { "hand": ["Test of Talents"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Grizzly Bears" }, { "cast": "Test of Talents", "player": 1, "targets": [{ "stack": "Grizzly Bears" }], "illegal": true } ],
    "expect": { "stack_empty": false } },
  { "name": "ruling: a countered spell goes to the graveyard, so the countered card itself is found and exiled",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                 { "hand": ["Test of Talents"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] },
               { "cast": "Test of Talents", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
               { "resolve": true } ],
    "expect": { "players": [ { "graveyard": [], "exile": ["Lightning Bolt"], "hand": [] }, { "life": 20, "graveyard": ["Test of Talents"] } ], "stack_empty": true } }
]
