[
  {
    "name": "affinity: costs 1 less per artifact you control",
    "players": [{ "hand": ["Utrom Monitor"], "battlefield": ["Urza's Filter", "Utility Knife", "Island", "Island", "Island"] }, {}],
    "steps": [{ "cast": "Utrom Monitor" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Utrom Monitor"] }, {}], "pt": { "Utrom Monitor": [3, 3] } }
  },
  {
    "name": "without artifacts it costs full price",
    "players": [{ "hand": ["Utrom Monitor"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }, {}],
    "steps": [{ "cast": "Utrom Monitor" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Utrom Monitor"] }, {}] }
  },
  {
    "name": "flying: cannot be blocked by a ground creature",
    "players": [{ "battlefield": ["Utrom Monitor"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [{ "card": "Utrom Monitor", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Utrom Monitor" }], "illegal": true }
    ]
  },
  {
    "name": "ruling: affinity lowers the cost paid but mana value stays 5 (Disdainful Stroke counters it)",
    "players": [
      { "hand": ["Utrom Monitor"], "battlefield": ["Urza's Filter", "Utility Knife", "Island", "Island", "Island"] },
      { "hand": ["Disdainful Stroke"], "battlefield": ["Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Utrom Monitor" },
      { "cast": "Disdainful Stroke", "player": 1, "targets": [{ "stack": "Utrom Monitor" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard_has": ["Utrom Monitor"], "battlefield_lacks": ["Utrom Monitor"] }, { "graveyard_has": ["Disdainful Stroke"] }]
    }
  }
]
