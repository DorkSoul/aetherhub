[
 {
  "name": "cycling a card taps target creature an opponent controls",
  "players": [
   {
    "hand": ["Street Wraith"],
    "battlefield": ["Snare Tactician", "Mountain"]
   },
   {
    "battlefield": ["Hill Giant"]
   }
  ],
  "steps": [
   { "activate": "Street Wraith" },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Hill Giant": true }
  }
 },
 {
  "name": "trigger only targets creatures an opponent controls",
  "players": [
   {
    "hand": ["Street Wraith"],
    "battlefield": ["Snare Tactician", "Grizzly Bears", "Mountain"]
   },
   {
    "battlefield": ["Hill Giant"]
   }
  ],
  "steps": [
   { "activate": "Street Wraith" },
   { "resolve": true }
  ],
  "expect": {
   "tapped": { "Hill Giant": true, "Grizzly Bears": false }
  }
 },
 {
  "name": "ruling: no creature to tap, cycling still works and the trigger has no target",
  "players": [
   { "hand": ["Street Wraith"], "battlefield": ["Snare Tactician", "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Street Wraith" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "hand_count": 1, "graveyard": ["Street Wraith"], "battlefield_has": ["Snare Tactician"] },
    {}
   ]
  }
 }
]
