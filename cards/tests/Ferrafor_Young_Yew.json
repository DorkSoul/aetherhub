[
  { "name": "makes a Saproling for each counter among creatures the target player controls",
    "players": [
      { "hand": ["Ferrafor, Young Yew"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] },
      {}
    ],
    "steps": [
      { "cast": "Ferrafor, Young Yew" },
      { "resolve": true, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Ferrafor, Young Yew", "Grizzly Bears", "Saproling 1-1 G", "Saproling 1-1 G"] },
        {}
      ]
    }
  },
  { "name": "counters on the opponent's creatures are not counted",
    "players": [
      { "hand": ["Ferrafor, Young Yew"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": [{ "name": "Grizzly Bears", "counters": { "p1p1": 3 } }] }
    ],
    "steps": [
      { "cast": "Ferrafor, Young Yew" },
      { "resolve": true, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Ferrafor, Young Yew"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  { "name": "tap to double each kind of counter on target creature",
    "players": [
      { "battlefield": ["Ferrafor, Young Yew", { "name": "Grizzly Bears", "counters": { "p1p1": 2, "stun": 1 } }] },
      {}
    ],
    "steps": [
      { "activate": "Ferrafor, Young Yew", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Ferrafor, Young Yew": true },
      "counters": { "Grizzly Bears": { "+1/+1": 4, "stun": 2 } },
      "pt": { "Grizzly Bears": [6, 6] }
    }
  },
  { "name": "ruling: doubling interacts with Hardened Scales (the two doubled counters are one event: +1 from Scales)",
    "players": [
      { "battlefield": ["Ferrafor, Young Yew", "Hardened Scales", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] },
      {}
    ],
    "steps": [
      { "activate": "Ferrafor, Young Yew", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Ferrafor, Young Yew": true },
      "counters": { "Grizzly Bears": { "+1/+1": 5 } },
      "pt": { "Grizzly Bears": [7, 7] }
    }
  },
  { "name": "ruling: the count includes counters of every kind (+1/+1 and stun) among the target player's creatures",
    "players": [
      { "hand": ["Ferrafor, Young Yew"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }, { "name": "Llanowar Elves", "counters": { "stun": 1 } }] },
      {}
    ],
    "steps": [
      { "cast": "Ferrafor, Young Yew" },
      { "resolve": true, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Ferrafor, Young Yew", "Grizzly Bears", "Llanowar Elves", "Saproling 1-1 G", "Saproling 1-1 G", "Saproling 1-1 G"] },
        {}
      ]
    }
  }
]
