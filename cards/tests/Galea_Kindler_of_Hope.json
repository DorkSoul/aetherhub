 {
  "name": "ruling: the permission is only sorcery-speed timing: no cast from the library while another spell is on the stack",
  "players": [
   { "hand": ["Lightning Strike"], "battlefield": ["Galea, Kindler of Hope", "Mountain", "Island", "Plains"], "library": ["Bonesplitter"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Strike", "targets": ["p1"] },
   { "cast": "Bonesplitter", "illegal": true },
   { "resolve": true },
   { "cast": "Bonesplitter" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": ["Bonesplitter"] }, { "life": 17 } ], "attached": { "Bonesplitter": "Galea, Kindler of Hope" } }
