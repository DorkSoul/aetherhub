[
 {
  "name": "an Equipment cast from the top of the library attaches itself on entering",
  "players": [
   {
    "battlefield": [
     "Galea, Kindler of Hope",
     "Grizzly Bears",
     "Plains",
     "Plains"
    ],
    "library": [
     "Bonesplitter"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Bonesplitter"
   },
   {
    "resolve": true,
    "targets": [
     "Grizzly Bears"
    ]
   }
  ],
  "expect": {
   "attached": {
    "Bonesplitter": "Grizzly Bears"
   },
   "pt": {
    "Grizzly Bears": [
     4,
