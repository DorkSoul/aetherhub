[
  {
    "name": "ruling: the card drawn is the revealed card itself when no graveyard card shares its name",
    "players": [ { "battlefield": ["Candles of Leng", "Forest", "Forest", "Forest", "Forest"], "library": ["Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "activate": "Candles of Leng" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "library_top": ["Forest"] }, {} ] }
  },
  {
    "name": "revealed card shares a name with a graveyard card: it goes to the graveyard, no draw",
    "players": [
      { "battlefield": ["Candles of Leng", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"], "library": ["Grizzly Bears", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Candles of Leng" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears", "Grizzly Bears"], "hand_count": 0 }, {} ]
    }
  },
  {
    "name": "revealed card with no matching graveyard name is drawn",
    "players": [
      { "battlefield": ["Candles of Leng", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Grizzly Bears"], "library": ["Forest", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Candles of Leng" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": ["Grizzly Bears"] }, {} ]
    }
  },
  {
    "name": "empty graveyard: the revealed card is drawn",
    "players": [
      { "battlefield": ["Candles of Leng", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Candles of Leng" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": [] }, {} ]
    }
  },
  {
    "name": "needs {4} and {T}: illegal with only three mana",
    "players": [
      { "battlefield": ["Candles of Leng", "Forest", "Forest", "Forest"], "library": ["Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Candles of Leng", "illegal": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, {} ]
    }
  }
]
