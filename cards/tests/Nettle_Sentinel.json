[
  { "name": "does not untap during its controller's untap step",
    "players": [ { "battlefield": [ { "name": "Nettle Sentinel", "tapped": true }, { "name": "Grizzly Bears", "tapped": true } ] }, { } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" } ],
    "expect": { "players": [ { }, { } ], "tapped": { "Nettle Sentinel": true, "Grizzly Bears": false } }
  },
  { "name": "casting a green spell: may untap it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "Nettle Sentinel", "tapped": true }, "Forest", "Forest" ] }, { } ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { } ], "tapped": { "Nettle Sentinel": false } }
  },
  { "name": "casting a green spell: declining keeps it tapped",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "Nettle Sentinel", "tapped": true }, "Forest", "Forest" ] }, { } ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { } ], "tapped": { "Nettle Sentinel": true } }
  },
  { "name": "a non-green spell does not trigger it",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Nettle Sentinel", "tapped": true }, "Mountain" ] }, { } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { }, { "life": 17 } ], "tapped": { "Nettle Sentinel": true } }
  },
  { "name": "ruling: the untap trigger goes on top of the spell, so it resolves first and the spell still resolves afterwards",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "Nettle Sentinel", "tapped": true }, "Forest", "Forest" ] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ], "tapped": { "Nettle Sentinel": false } }
  }
]
