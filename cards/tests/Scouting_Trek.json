    "players": [
      { "hand": ["Scouting Trek"], "battlefield": ["Forest", "Forest"], "library": ["Grizzly Bears", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Scouting Trek" },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
