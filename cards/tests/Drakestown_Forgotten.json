[
  { "name": "enters with a counter for each creature card in all graveyards",
    "players": [ { "hand": ["Drakestown Forgotten"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Drakestown Forgotten" }, { "resolve": true } ],
    "expect": { "pt": { "Drakestown Forgotten": [2, 2] }, "counters": { "Drakestown Forgotten": { "p1p1": 2 } } } },
  { "name": "{2}{B}, remove a counter: target creature gets -1/-1 until end of turn",
    "players": [ { "battlefield": [ { "name": "Drakestown Forgotten", "counters": { "PlusOnePlusOne": 2 } }, "Swamp", "Swamp", "Swamp" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Drakestown Forgotten", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [1, 1], "Drakestown Forgotten": [1, 1] }, "counters": { "Drakestown Forgotten": { "p1p1": 1 } } } },
  { "name": "boundary: with only two lands the {2}{B} cost cannot be paid",
    "players": [ { "battlefield": [ { "name": "Drakestown Forgotten", "counters": { "PlusOnePlusOne": 2 } }, "Swamp", "Swamp" ] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Drakestown Forgotten", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "pt": { "Grizzly Bears": [2, 2] }, "counters": { "Drakestown Forgotten": { "p1p1": 2 } } } },
  { "name": "ruling: a Forgotten entering from a graveyard counts itself for X (X=2 with Grizzly Bears; Animate Dead gives -1/-0)",
    "players": [ { "hand": ["Animate Dead"], "battlefield": ["Swamp", "Swamp"], "graveyard": ["Drakestown Forgotten"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Animate Dead", "targets": ["Drakestown Forgotten"] }, { "resolve": true } ],
    "expect": { "pt": { "Drakestown Forgotten": [1, 2] }, "counters": { "Drakestown Forgotten": { "p1p1": 2 } } } }
]
