[
  {
    "name": "becomes tapped: pay {1}{U} to return target permanent",
    "players": [
      {
        "battlefield": [
          "Surgespanner",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Surgespanner",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "End",
        "targets": [
          "Grizzly Bears"
        ],
        "answers": [
          true
        ]
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "hand": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "declining to pay leaves the target on the battlefield",
    "players": [
      {
        "battlefield": [
          "Surgespanner",
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Surgespanner",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "End",
        "targets": [
          "Grizzly Bears"
        ],
        "answers": [
          false
        ]
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield_has": [
            "Grizzly Bears"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: an effect tapping an already-tapped Surgespanner does not trigger",
    "players": [
      { "battlefield": [ { "name": "Surgespanner", "tapped": true }, "Icy Manipulator", "Island", "Island", "Island" ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "activate": "Icy Manipulator", "targets": ["Surgespanner"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Surgespanner"] }, { "battlefield_has": ["Grizzly Bears"] } ] }
  },
  {
    "name": "ruling: an effect tapping an untapped Surgespanner triggers it (control)",
    "players": [
      { "battlefield": [ "Surgespanner", "Icy Manipulator", "Island", "Island", "Island" ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "activate": "Icy Manipulator", "targets": ["Surgespanner"] }, { "resolve": true, "targets": ["Grizzly Bears"], "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Icy Manipulator"] }, { "hand": ["Grizzly Bears"] } ] }
  }
]