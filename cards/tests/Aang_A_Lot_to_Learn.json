[
  {
    "name": "ruling: vigilance gained after attacking does not untap Aang",
    "players": [
      { "hand": ["Abandon Attachments"], "battlefield": ["Aang, A Lot to Learn", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Aang, A Lot to Learn", "at": "p1" } ] },
      { "cast": "Abandon Attachments" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Abandon Attachments"] }, {} ],
      "keywords": { "Aang, A Lot to Learn": ["Vigilance"] },
      "tapped": { "Aang, A Lot to Learn": true }
    }
  },
  {
    "name": "has vigilance while a Lesson card is in your graveyard",
    "players": [
      { "battlefield": ["Aang, A Lot to Learn"], "graveyard": ["Abandon Attachments"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Aang, A Lot to Learn", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Aang, A Lot to Learn"] }, {} ],
      "keywords": { "Aang, A Lot to Learn": ["Vigilance"] },
      "tapped": { "Aang, A Lot to Learn": false }
    }
  },
  {
    "name": "without a Lesson in graveyard it taps when attacking",
    "players": [
      { "battlefield": ["Aang, A Lot to Learn"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Aang, A Lot to Learn", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "tapped": { "Aang, A Lot to Learn": true }
    }
  },
  {
    "name": "another creature you control dying puts a +1/+1 counter on Aang",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Aang, A Lot to Learn", "Grizzly Bears", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Aang, A Lot to Learn": [4, 3] },
      "counters": { "Aang, A Lot to Learn": { "p1p1": 1 } }
    }
  }
]
