[
  {
    "name": "ETB creates a Clue",
    "players": [ { "hand": ["Tolls of War"], "battlefield": ["Plains", "Swamp"] }, {} ],
    "steps": [ { "cast": "Tolls of War" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tolls of War", "Clue"] }, {} ]
    }
  },
  {
    "name": "sacrificing a permanent on your turn creates an Ally (once each turn)",
    "players": [ { "battlefield": ["Tolls of War", "Clue", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Clue" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Tolls of War", "Ally 1-1"], "battlefield_lacks": ["Clue"] }, {} ]
    }
  },
  {
    "name": "ruling: a Clue token (not an investigate) is an artifact whose sacrifice ability draws a card",
    "players": [ { "battlefield": ["Clue", "Island", "Island"] }, {} ],
    "steps": [ { "activate": "Clue" }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand_count": 1, "battlefield_lacks": ["Clue"] }, {} ]
    }
  }
]
