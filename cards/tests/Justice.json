[
  { "name": "a red instant dealing damage: Justice deals that much to its controller",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Justice"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "stack_empty": true, "players": [ { "life": 17 }, { "life": 17 } ] } },
  { "name": "one red source damaging several creatures at once is one damage of the total",
    "players": [ { "hand": ["Pyroclasm"], "battlefield": ["Mountain", "Mountain"] }, { "battlefield": ["Justice", "Savannah Lions", "Savannah Lions"] } ],
    "steps": [ { "cast": "Pyroclasm" }, { "pass": true }, { "pass": true, "player": 1 }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "stack_empty": true, "players": [ { "life": 16 }, { "life": 20 } ] } },
  { "name": "a red creature dealing combat damage to a player: its controller takes that much too",
    "players": [ { "battlefield": ["Justice"] }, { "battlefield": ["Jackal Pup"] } ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1", "player": 1 }, { "attack": [ { "card": "Jackal Pup", "at": "p0" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 18 }, { "life": 18 } ] } },
  { "name": "a red creature dealing combat damage to a player (attacker is the active player)",
    "players": [ { "battlefield": ["Jackal Pup"] }, { "battlefield": ["Justice"] } ],
    "steps": [ { "attack": [ { "card": "Jackal Pup", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 18 }, { "life": 18 } ] } },
  { "name": "damage from a non-red creature does not trigger it",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Justice"] } ],
    "steps": [ { "advance_to": "Main1" }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "stack_empty": true, "players": [ { "life": 20 }, { "life": 18 } ] } },
  { "name": "upkeep: paying {W}{W} keeps it",
    "players": [ {}, { "battlefield": ["Justice", "Plains", "Plains"] } ],
    "steps": [ { "advance_to": "Upkeep", "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield": ["Justice", "Plains", "Plains"] } ] } },
  { "name": "upkeep: not paying sacrifices it",
    "players": [ {}, { "battlefield": ["Justice", "Plains", "Plains"] } ],
    "steps": [ { "advance_to": "Upkeep", "answers": [false] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield": ["Plains", "Plains"], "graveyard": ["Justice"] } ] } },
  { "name": "ruling: Justice's damage is a separate trigger put on the stack after the red spell's damage (the spell's controller takes it only when the trigger resolves)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }, { "battlefield": ["Justice"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "pass": true }, { "pass": true, "player": 1 } ],
    "expect": { "stack_empty": false, "players": [ { "life": 20 }, { "life": 17 } ] } }
]
