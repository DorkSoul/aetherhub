    "players": [
      {
        "hand": ["Lightning Bolt", "Admiral's Order"],
        "battlefield": ["Mountain", "Island", { "name": "Grizzly Bears", "sick": false }]
      },
      { "battlefield": [{ "name": "Hill Giant", "sick": false }] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "advance_to": "Main2" },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Admiral's Order", "alt": 0, "targets": [ { "stack": "Lightning Bolt" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Lightning Bolt", "Admiral's Order", "Grizzly Bears"] },
        { "life": 20, "battlefield_has": ["Hill Giant"] }
      ]
    }
