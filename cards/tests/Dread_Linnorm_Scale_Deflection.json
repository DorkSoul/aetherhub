[
  {
    "name": "can't be blocked by power 3 or less",
    "players": [
      {
        "battlefield": [
          "Dread Linnorm // Scale Deflection"
        ]
      },
      {
        "battlefield": [
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Dread Linnorm // Scale Deflection",
            "at": "p1"
          }
        ]
      },
      {
        "pass": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 13
        }
      ]
    }
  },
  {
    "name": "Scale Deflection adds two counters, untaps, and gives hexproof",
    "players": [
      {
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Forest"
        ],
        "hand": [
          "Dread Linnorm // Scale Deflection"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Dread Linnorm // Scale Deflection",
        "face": true,
        "targets": [
          "Grizzly Bears"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "exile": [
            "Dread Linnorm // Scale Deflection"
          ]
        },
        {
          "battlefield": [
            "Grizzly Bears"
          ]
        }
      ],
      "pt": {
        "Grizzly Bears": [
          4,
          4
        ]
      }
    }
  },
  {
    "name": "power 3 or less cannot block it: Hill Giant's declared block is dropped, 7 damage connects",
    "players": [
      { "battlefield": ["Dread Linnorm // Scale Deflection"] },
      { "battlefield": ["Hill Giant", "Craw Wurm"] }
    ],
    "steps": [
      { "attack": [ { "card": "Dread Linnorm // Scale Deflection", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Dread Linnorm // Scale Deflection" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 13 } ] }
  },
  {
    "name": "ruling: the Adventure is cast for its own cost, so four Forests are enough even though the creature costs seven",
    "players": [
      { "battlefield": ["Forest", "Forest", "Forest", "Forest"], "hand": ["Dread Linnorm // Scale Deflection"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dread Linnorm // Scale Deflection", "face": true, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Dread Linnorm // Scale Deflection"] }, { "battlefield": ["Grizzly Bears"] } ],
      "pt": { "Grizzly Bears": [4, 4] }
    }
  },
  {
    "name": "ruling: after the Adventure resolves, the creature can be cast from exile in a main phase with an empty stack",
    "players": [
      { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "hand": ["Dread Linnorm // Scale Deflection"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dread Linnorm // Scale Deflection", "face": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Dread Linnorm // Scale Deflection" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Dread Linnorm // Scale Deflection"] }, {} ]
    }
  },
  {
    "name": "ruling: a countered Adventure is not exiled, so its creature side cannot be cast later",
    "players": [
      { "battlefield": ["Forest", "Forest", "Forest", "Forest"], "hand": ["Dread Linnorm // Scale Deflection"] },
      { "battlefield": ["Island", "Island", "Grizzly Bears"], "hand": ["Negate"] }
    ],
    "steps": [
      { "cast": "Dread Linnorm // Scale Deflection", "face": true, "targets": ["Grizzly Bears"] },
      { "cast": "Negate", "player": 1, "targets": [{ "stack": "Scale Deflection" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Dread Linnorm // Scale Deflection"] }, { "battlefield_has": ["Grizzly Bears"] } ]
    }
  }
]
