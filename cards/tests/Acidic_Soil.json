[
  {
    "name": "each player takes damage equal to the lands they control",
    "players": [
      { "hand": ["Acidic Soil"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Plains", "Plains"] }
    ],
    "steps": [
      { "cast": "Acidic Soil" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 17 }, { "life": 18 } ]
    }
  },
  {
    "name": "a player with no lands takes no damage",
    "players": [
      { "hand": ["Acidic Soil"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Acidic Soil" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 17 }, { "life": 20 } ]
    }
  },
  {
    "name": "ruling: lands are counted on resolution; opponent's Strip Mine destroys one of my lands in response, so I take 2",
    "players": [
      { "hand": ["Acidic Soil"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Strip Mine"] }
    ],
    "steps": [
      { "cast": "Acidic Soil" },
      { "activate": "Strip Mine", "player": 1, "targets": ["Mountain"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 18, "graveyard_has": ["Mountain"] }, { "life": 20, "graveyard_has": ["Strip Mine"] } ]
    }
  }
]
