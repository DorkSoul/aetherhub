[
  {
    "name": "cannot attack without another artifact",
    "players": [
      { "battlefield": ["Steelclad Serpent"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Steelclad Serpent", "at": "p1" }], "illegal": true }
    ],
    "expect": {
      "players": [{}, { "life": 20 }]
    }
  },
  {
    "name": "can attack when you control another artifact",
    "players": [
      { "battlefield": ["Steelclad Serpent", "Steamclaw"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Steelclad Serpent", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 16 }]
    }
  },
  {
    "name": "with no other artifact it is dropped from the attack; another attacker still deals damage",
    "players": [
      { "battlefield": [{ "name": "Steelclad Serpent", "sick": false }, { "name": "Grizzly Bears", "sick": false }] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Steelclad Serpent", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }],
      "tapped": { "Steelclad Serpent": false }
    }
  },
  {
    "name": "ruling: two Steelclad Serpents enable each other to attack",
    "players": [
      { "battlefield": [ { "name": "Steelclad Serpent", "sick": false }, { "name": "Steelclad Serpent", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Steelclad Serpent", "at": "p1" }, { "card": "Steelclad Serpent", "at": "p1" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 12 }] }
  },
  {
    "name": "ruling: a blue artifact needs blue mana to cast (six Mountains cannot)",
    "players": [
      { "hand": ["Steelclad Serpent"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Steelclad Serpent", "illegal": true }
    ],
    "expect": { "players": [{ "hand": ["Steelclad Serpent"] }, {}] }
  },
  {
    "name": "ruling: a blue artifact is cast with its coloured mana (five Mountains and an Island)",
    "players": [
      { "hand": ["Steelclad Serpent"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Steelclad Serpent" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Steelclad Serpent"] }, {}] }
  }
]
