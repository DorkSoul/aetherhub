[
  {
    "name": "ruling: choosing no targets is allowed; the spell resolves and you still gain 2 life",
    "players": [
      { "hand": ["Pull from the Grave"], "graveyard": ["Grizzly Bears", "Gurmag Angler"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      {}
    ],
    "steps": [ { "cast": "Pull from the Grave", "targets": [] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 22, "hand_count": 0, "graveyard_has": ["Pull from the Grave"] }, {} ] }
  },
  {
    "name": "ruling: if all chosen targets are illegal on resolution, Pull from the Grave does nothing and you gain no life",
    "players": [
      { "hand": ["Pull from the Grave"], "graveyard": ["Grizzly Bears"], "battlefield": ["Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Tormod's Crypt"] }
    ],
    "steps": [
      { "cast": "Pull from the Grave", "targets": ["Grizzly Bears"] },
      { "activate": "Tormod's Crypt", "player": 1, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": { "players": [
      { "life": 20, "graveyard_has": ["Pull from the Grave"], "exile": ["Grizzly Bears"] },
      { "graveyard_has": ["Tormod's Crypt"], "hand_count": 0 }
    ] }
  },
  {
    "name": "returns two creature cards and gains 2 life",
    "players": [
      {
        "hand": [
          "Pull from the Grave"
        ],
        "graveyard": [
          "Grizzly Bears",
          "Gurmag Angler"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Pull from the Grave",
        "targets": [
          "Grizzly Bears",
          "Gurmag Angler"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Grizzly Bears",
            "Gurmag Angler"
          ],
          "life": 22
        },
        {}
      ]
    }
  },
  {
    "name": "returns only the one chosen creature",
    "players": [
      {
        "hand": [
          "Pull from the Grave"
        ],
        "graveyard": [
          "Grizzly Bears",
          "Gurmag Angler"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Pull from the Grave",
        "targets": [
          "Gurmag Angler"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Gurmag Angler"
          ],
          "graveyard": [
            "Grizzly Bears",
            "Pull from the Grave"
          ],
          "life": 22
        },
        {}
      ]
    }
  }
]
