[
  { "name": "attack and pay {2}: the next instant is copied (new targets allowed) ",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Najal, the Storm Runner", "sick": false }, "Mountain", "Mountain", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Najal, the Storm Runner", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 9 } ] } },
  { "name": "attack and decline the {2}: the next instant is not copied",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Najal, the Storm Runner", "sick": false }, "Mountain", "Mountain", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Najal, the Storm Runner", "at": "p1" } ] },
      { "resolve": true, "answers": [false] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 12 } ] } },
  { "name": "only the next instant or sorcery is copied: a second Bolt is not",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": [ { "name": "Najal, the Storm Runner", "sick": false }, "Mountain", "Mountain", "Mountain", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Najal, the Storm Runner", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt", "Lightning Bolt"] }, { "life": 6 } ] } },
  { "name": "flash for sorceries: Divination can be cast in the opponent's upkeep",
    "players": [ { "hand": ["Divination"], "battlefield": [ { "name": "Najal, the Storm Runner", "sick": false }, "Island", "Island", "Island" ] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Divination" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "graveyard": ["Divination"] }, {} ] } },
  { "name": "without Najal a sorcery cannot be cast in the opponent's upkeep",
    "players": [ { "hand": ["Divination"], "battlefield": [ "Island", "Island", "Island" ] }, {} ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "pass": true, "player": 1 },
      { "cast": "Divination", "illegal": true }
    ],
    "expect": { "players": [ { "hand": ["Divination"] }, {} ] } },
  { "name": "ruling: the copy uses the sacrificed creature's power (additional cost not paid again)",
    "players": [ { "hand": ["Fling"], "battlefield": [ { "name": "Najal, the Storm Runner", "sick": false }, "Hill Giant", "Mountain", "Mountain", "Mountain", "Mountain" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Najal, the Storm Runner", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "cast": "Fling", "targets": ["p1"], "answers": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Hill Giant", "Fling"] }, { "life": 9 } ] } },
  { "name": "ruling: the copy keeps the original's mode (Boros Charm 4 damage mode, original and copy: 4 + 4 damage)",
    "players": [ { "hand": ["Boros Charm"], "battlefield": [ { "name": "Najal, the Storm Runner", "sick": false }, "Mountain", "Mountain", "Mountain", "Plains", "Plains", "Plains" ] }, {} ],
    "steps": [
      { "attack": [ { "card": "Najal, the Storm Runner", "at": "p1" } ] },
      { "resolve": true, "answers": [true] },
      { "cast": "Boros Charm", "targets": ["p1"], "answers": [0] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Boros Charm"] }, { "life": 7 } ] } }
]
