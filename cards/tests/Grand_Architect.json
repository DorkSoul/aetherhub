[
 { "name": "tapping itself pays {C}{C} for an artifact spell (one color: one counter)",
   "players": [ { "hand": ["Skyreach Manta"], "battlefield": ["Grand Architect", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Skyreach Manta" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Skyreach Manta", "Grand Architect"] }, {} ], "pt": { "Skyreach Manta": [1, 1] } } },
 { "name": "the {C}{C} cannot pay for a creature spell",
   "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Grand Architect", "Forest"] }, {} ],
   "steps": [ { "cast": "Grizzly Bears", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Grizzly Bears"] }, {} ] } },
 { "name": "other blue creatures get +1/+1, the Architect does not",
   "players": [ { "battlefield": ["Grand Architect", "Glitch Ghost Surveyor"] }, {} ],
   "steps": [ { "advance_to": "Main1" } ],
   "expect": { "pt": { "Glitch Ghost Surveyor": [3, 3], "Grand Architect": [1, 3] } } },
 { "name": "{U}: target artifact creature becomes blue until end of turn (and so gets the +1/+1)",
   "players": [ { "hand": ["Skyreach Manta"], "battlefield": ["Grand Architect", "Island", "Island", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Skyreach Manta" }, { "resolve": true }, { "activate": "Grand Architect", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Skyreach Manta", "Grand Architect"] }, {} ], "colors": { "Skyreach Manta": ["U"] }, "pt": { "Skyreach Manta": [2, 2] } } },
 { "name": "the blue-making ability needs an artifact creature target (a non-artifact creature is not a legal target)",
   "players": [ { "battlefield": ["Grand Architect", "Island", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Grand Architect", "ability": 0, "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grand Architect", "Grizzly Bears"] }, {} ], "colors": { "Grizzly Bears": ["G"] } } },
 { "name": "ruling: a summoning-sick blue creature can be tapped for the Architect's mana (the Architect itself too)",
   "players": [ { "hand": ["Skyreach Manta"], "battlefield": [ { "name": "Grand Architect", "sick": true }, "Island", "Island", "Island" ] }, {} ],
   "steps": [ { "cast": "Skyreach Manta" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Skyreach Manta", "Grand Architect"] }, {} ], "tapped": { "Grand Architect": true }, "pt": { "Skyreach Manta": [1, 1] } } },
 { "name": "ruling: nonlethal damage on a blue creature becomes lethal when Grand Architect leaves the battlefield",
   "players": [ { "hand": ["Playful Shove", "Playful Shove", "Lightning Bolt"], "battlefield": ["Grand Architect", "Glitch Ghost Surveyor", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [
     { "cast": "Playful Shove", "targets": ["Glitch Ghost Surveyor"] }, { "resolve": true },
     { "cast": "Playful Shove", "targets": ["Glitch Ghost Surveyor"] }, { "resolve": true },
     { "cast": "Lightning Bolt", "targets": ["Grand Architect"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Grand Architect", "Glitch Ghost Surveyor", "Lightning Bolt"] }, {} ] } }
