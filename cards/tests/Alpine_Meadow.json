[
  {
    "name": "enters tapped",
    "players": [ { "hand": ["Alpine Meadow"] }, {} ],
    "steps": [ { "play_land": "Alpine Meadow" } ],
    "expect": {
      "players": [ { "battlefield_has": ["Alpine Meadow"] }, {} ],
      "tapped": { "Alpine Meadow": true }
    }
  },
  {
    "name": "taps for red or white (basic land types)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Alpine Meadow"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: a non-snow Mountain cannot pay {S}; Alpine Meadow (snow) plus a basic Mountain is one {S} only",
    "players": [ { "battlefield": ["Icehide Troll", "Alpine Meadow", "Mountain"] }, {} ],
    "steps": [ { "activate": "Icehide Troll", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Icehide Troll"] }, {} ], "pt": { "Icehide Troll": [2, 3] } }
  },
  {
    "name": "ruling: Alpine Meadow is a snow source, so with Snow-Covered Mountain it pays both {S}",
    "players": [ { "battlefield": ["Icehide Troll", "Alpine Meadow", "Snow-Covered Mountain"] }, {} ],
    "steps": [ { "activate": "Icehide Troll", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Icehide Troll": [4, 3] }, "tapped": { "Icehide Troll": true } }
  },
  {
    "name": "ruling: each {S} is paid by one mana of any colour from a snow source (snow Mountain and Plains)",
    "players": [ { "battlefield": ["Icehide Troll", "Snow-Covered Mountain", "Snow-Covered Plains"] }, {} ],
    "steps": [ { "activate": "Icehide Troll", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Icehide Troll": [4, 3] }, "tapped": { "Icehide Troll": true } }
  }
]
