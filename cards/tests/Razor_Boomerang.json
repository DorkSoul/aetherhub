   "players": [ { "battlefield_has": ["Razor Boomerang", "Grizzly Bears"] }, { "life": 20 } ],
   "attached": {},
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "ruling: Boomerang stays on the battlefield unattached if the targeted creature is gone on resolution",
  "players": [
   { "battlefield": ["Razor Boomerang", "Plains", "Plains", { "name": "Grizzly Bears", "sick": false }] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Soldevi Machinist", "Mountain"] }
  ],
  "steps": [
   { "activate": "Razor Boomerang", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Soldevi Machinist"] },
   { "pass": true },
   { "cast": "Lightning Bolt", "targets": ["Soldevi Machinist"], "player": 1 },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "pass": true, "player": 1 }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Razor Boomerang", "Grizzly Bears"] }, { "graveyard_has": ["Soldevi Machinist", "Lightning Bolt"] } ],
   "attached": {},
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
