 {
  "name": "ruling: the skipped untap is only the next one; they untap in a later untap step",
  "players": [
   {"hand": ["Exhaustion"], "battlefield": ["Island", "Island", "Island"]},
   {"battlefield": [{"name": "Grizzly Bears", "tapped": true}, {"name": "Forest", "tapped": true}]}
  ],
  "steps": [
   {"cast": "Exhaustion", "targets": ["p1"]},
   {"resolve": true},
   {"advance_to": "Main1", "auto": true},
   {"advance_to": "Main1", "auto": true},
