[
 {
  "name": "blocks an equipped creature that survives: the Equipment is destroyed at end of combat",
  "players": [
   { "battlefield": ["Short Sword", "Plains", "Hill Giant"] },
   { "battlefield": ["Corrosive Ooze"] }
  ],
  "steps": [
   { "activate": "Short Sword", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
   { "player": 1, "block": [ { "blocker": "Corrosive Ooze", "attacker": "Hill Giant" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "graveyard": ["Short Sword"], "battlefield": ["Plains", "Hill Giant"] }, { "graveyard": ["Corrosive Ooze"] } ], "pt": { "Hill Giant": [3, 3] } }
 },
 {
  "name": "the equipped creature dies in combat: its Equipment is still destroyed",
  "players": [
   { "battlefield": ["Short Sword", "Plains", "Elite Vanguard"] },
   { "battlefield": ["Corrosive Ooze"] }
  ],
  "steps": [
   { "activate": "Short Sword", "targets": ["Elite Vanguard"] },
   { "resolve": true },
   { "attack": [ { "card": "Elite Vanguard", "at": "p1" } ] },
   { "player": 1, "block": [ { "blocker": "Corrosive Ooze", "attacker": "Elite Vanguard" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "graveyard": ["Elite Vanguard", "Short Sword"], "battlefield": ["Plains"] }, { "graveyard": ["Corrosive Ooze"] } ] }
 },
 {
  "name": "it becomes blocked by an equipped creature: the Equipment is destroyed at end of combat",
  "players": [
   { "battlefield": ["Short Sword", "Plains", "Hill Giant"] },
   { "battlefield": [ { "name": "Corrosive Ooze", "sick": false } ] }
  ],
  "steps": [
   { "activate": "Short Sword", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "advance_to": "Main1", "auto": true },
   { "player": 1, "attack": [ { "card": "Corrosive Ooze", "at": "p0" } ] },
   { "player": 0, "block": [ { "blocker": "Hill Giant", "attacker": "Corrosive Ooze" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "graveyard": ["Short Sword"], "battlefield": ["Plains", "Hill Giant"] }, { "graveyard": ["Corrosive Ooze"] } ] }
 },
 {
  "name": "blocking an unequipped creature leaves other Equipment alone",
  "players": [
   { "battlefield": ["Short Sword", "Plains", "Hill Giant", "Grizzly Bears"] },
   { "battlefield": ["Corrosive Ooze"] }
  ],
  "steps": [
   { "activate": "Short Sword", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "player": 1, "block": [ { "blocker": "Corrosive Ooze", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ { "battlefield_has": ["Short Sword", "Hill Giant"] }, {} ], "attached": { "Short Sword": "Hill Giant" } }
 },
 {
  "name": "ruling: the blocker is removed before damage: the Equipment is still destroyed at end of combat",
  "players": [
   { "battlefield": ["Short Sword", "Plains", "Mountain", "Hill Giant"], "hand": ["Lightning Bolt"] },
   { "battlefield": ["Corrosive Ooze"] }
  ],
  "steps": [
   { "activate": "Short Sword", "targets": ["Hill Giant"] },
   { "resolve": true },
   { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
   { "player": 1, "block": [ { "blocker": "Corrosive Ooze", "attacker": "Hill Giant" } ] },
   { "cast": "Lightning Bolt", "targets": ["Corrosive Ooze"] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Lightning Bolt", "Short Sword"], "battlefield_has": ["Hill Giant"] },
    { "graveyard": ["Corrosive Ooze"] }
   ]
  }
 }
]
