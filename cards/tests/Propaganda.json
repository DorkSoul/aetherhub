  {
    "name": "ruling: two Propagandas make the tax cumulative, so one attacker needs {4}; 3 Mountains cannot attack",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Propaganda", "Propaganda"] }
