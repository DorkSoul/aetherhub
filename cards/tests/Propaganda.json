  {
    "name": "ruling: two Propagandas make the tax cumulative; 4 Mountains pay {4} for one attacker",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Propaganda", "Propaganda"] }
