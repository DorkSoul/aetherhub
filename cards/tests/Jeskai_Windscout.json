[
  { "name": "noncreature spell gives prowess +1/+1 until end of turn",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jeskai Windscout", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Jeskai Windscout": [3, 2] }, "keywords": { "Jeskai Windscout": ["Flying", "Prowess"] } } },
  { "name": "creature spell does not trigger prowess",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Jeskai Windscout", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Jeskai Windscout": [2, 1] } } },
  { "name": "ruling: playing a land does not trigger prowess",
    "players": [ { "hand": ["Plains"], "battlefield": ["Jeskai Windscout"] }, {} ],
    "steps": [ { "play_land": "Plains" } ],
    "expect": { "pt": { "Jeskai Windscout": [2, 1] } } },
  { "name": "ruling: prowess still resolves after the triggering spell is countered",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Jeskai Windscout", "Mountain"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island", "Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Jeskai Windscout"], "graveyard": ["Lightning Bolt"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Jeskai Windscout": [3, 2] } } }
]
