[
 { "name": "pays the upkeep cost, then destroys only creatures whose mana value equals the age counters",
   "players": [ { "battlefield": ["Wave of Terror", "Swamp", "Swamp"] },
                { "battlefield": ["Llanowar Elves", "Grizzly Bears"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "Draw" }, { "resolve": true } ],
   "expect": { "counters": { "Wave of Terror": { "age": 1 } },
               "players": [ { "battlefield_has": ["Wave of Terror"] }, { "battlefield_lacks": ["Llanowar Elves"], "battlefield_has": ["Grizzly Bears"], "graveyard_has": ["Llanowar Elves"] } ] } },
 { "name": "cannot pay the upkeep cost: sacrificed before the draw step",
   "players": [ { "battlefield": ["Wave of Terror"] },
                { "battlefield": ["Llanowar Elves"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
   "expect": { "players": [ { "graveyard_has": ["Wave of Terror"] }, { "battlefield_has": ["Llanowar Elves"] } ] } },
 { "name": "ruling: a zero-mana creature survives the first age counter (destroys only exact mana value)",
   "players": [ { "battlefield": ["Wave of Terror", "Swamp"] },
                { "battlefield": ["Ornithopter"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] }, { "advance_to": "Draw" }, { "resolve": true } ],
   "expect": { "counters": { "Wave of Terror": { "age": 1 } },
               "players": [ { "battlefield_has": ["Wave of Terror"] }, { "battlefield_has": ["Ornithopter"] } ] } }
]
