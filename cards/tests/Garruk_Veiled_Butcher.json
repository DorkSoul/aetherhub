[
  {
    "name": "-2: you and the opponent each sacrifice; you get a 4/4 trample Beast",
    "players": [
      { "battlefield": ["Garruk, Veiled Butcher", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Garruk, Veiled Butcher", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"], "battlefield": ["Garruk, Veiled Butcher", "Beast 4-4 Green Trample"] },
        { "exile": ["Hill Giant"] }
      ],
      "counters": { "Garruk, Veiled Butcher": { "loyalty": 3 } }
    }
  },
  {
    "name": "-2 with no creature of yours: no Beast, opponent still sacrifices",
    "players": [
      { "battlefield": ["Garruk, Veiled Butcher"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Garruk, Veiled Butcher", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Garruk, Veiled Butcher"] },
        { "exile": ["Hill Giant"] }
      ],
      "counters": { "Garruk, Veiled Butcher": { "loyalty": 3 } }
    }
  },
  {
    "name": "replacement: opponent's creature killed by damage is exiled",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Garruk, Veiled Butcher"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "exile": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "replacement does not affect your own creatures",
    "players": [
      { "battlefield": ["Garruk, Veiled Butcher", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "+2 gives up to one target creature -4/-1",
    "players": [
      { "battlefield": ["Garruk, Veiled Butcher"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Garruk, Veiled Butcher", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [-2, 1] },
      "counters": { "Garruk, Veiled Butcher": { "loyalty": 7 } }
    }
  },
  {
    "name": "-3: opponent discards two nonland cards, you draw nothing",
    "players": [
      { "battlefield": ["Garruk, Veiled Butcher"] },
      { "hand": ["Lightning Bolt", "Grizzly Bears", "Island"] }
    ],
    "steps": [
      { "activate": "Garruk, Veiled Butcher", "ability": 2 },
      { "resolve": true, "answers": [["Lightning Bolt", "Grizzly Bears"]] }
    ],
    "expect": {
      "players": [
        { "hand_count": 0 },
        { "hand": ["Island"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] }
      ],
      "counters": { "Garruk, Veiled Butcher": { "loyalty": 2 } }
    }
  },
  {
    "name": "-3: opponent discards a land, so you draw a card",
    "players": [
      { "battlefield": ["Garruk, Veiled Butcher"] },
      { "hand": ["Lightning Bolt", "Grizzly Bears", "Island"] }
    ],
    "steps": [
      { "activate": "Garruk, Veiled Butcher", "ability": 2 },
      { "resolve": true, "answers": [["Island", "Lightning Bolt"]] }
    ],
    "expect": {
      "players": [
        { "hand_count": 1 },
        { "hand": ["Grizzly Bears"], "graveyard": ["Island", "Lightning Bolt"] }
      ],
      "counters": { "Garruk, Veiled Butcher": { "loyalty": 2 } }
    }
  }
