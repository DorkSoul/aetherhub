[
  { "name": "creature with a +1/+1 counter dealing combat damage to a player draws a card",
    "players": [ { "battlefield": [{ "name": "Ray Fillet, Wave Warrior", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [{ "card": "Ray Fillet, Wave Warrior", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, { "life": 19 } ] } },
  { "name": "creature without a counter dealing combat damage draws nothing",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Ray Fillet, Wave Warrior"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "hand_count": 1 }, { "life": 18 } ] } },
  { "name": "evolve: a bigger creature entering adds a +1/+1 counter",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Ray Fillet, Wave Warrior", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Ray Fillet, Wave Warrior": [1, 3] } } },
  { "name": "ruling: evolve compares each stat separately (equal power, greater toughness still triggers)",
    "players": [ { "hand": ["Wall of Wood"], "battlefield": ["Ray Fillet, Wave Warrior", "Forest"] }, {} ],
    "steps": [ { "cast": "Wall of Wood" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Ray Fillet, Wave Warrior": [1, 3] } } },
  { "name": "ruling: a creature with neither greater power nor toughness does not trigger evolve",
    "players": [ { "hand": ["Ornithopter"], "battlefield": ["Ray Fillet, Wave Warrior"] }, {} ],
    "steps": [ { "cast": "Ornithopter" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Ray Fillet, Wave Warrior": [0, 2] } } },
  { "name": "ruling: evolve uses the entering creature's last known stats when it left before the trigger resolved",
    "players": [ { "hand": ["Wall of Wood", "Lightning Bolt"], "battlefield": ["Ray Fillet, Wave Warrior", "Forest", "Mountain"] }, {} ],
    "steps": [ { "cast": "Wall of Wood" }, { "pass": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["Wall of Wood"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Wall of Wood", "Lightning Bolt"] }, {} ], "pt": { "Ray Fillet, Wave Warrior": [1, 3] } } }
]
