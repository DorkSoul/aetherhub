[
  {
    "name": "enters: each targeted player discards a card",
    "players": [
      { "hand": ["Tinybones Joins Up", "Island"], "battlefield": ["Swamp"] },
      { "hand": ["Plains"] }
    ],
    "steps": [
      { "cast": "Tinybones Joins Up" },
      { "resolve": true, "targets": ["p0", "p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Island"], "battlefield_has": ["Tinybones Joins Up"] },
        { "hand_count": 0, "graveyard": ["Plains"] }
      ]
    }
  },
  {
    "name": "enters: a player who is not targeted keeps their hand",
    "players": [
      { "hand": ["Tinybones Joins Up", "Island"], "battlefield": ["Swamp"] },
      { "hand": ["Plains"] }
    ],
    "steps": [
      { "cast": "Tinybones Joins Up" },
      { "resolve": true, "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Island"] },
        { "hand": ["Plains"] }
      ]
    }
  },
  {
    "name": "a legendary creature enters: each targeted player mills a card and loses 1 life",
    "players": [
      { "hand": ["Tinybones, Trinket Thief"], "battlefield": ["Tinybones Joins Up", "Swamp", "Swamp"] },
      { "library": ["Island"] }
    ],
    "steps": [
      { "cast": "Tinybones, Trinket Thief" },
      { "resolve": true, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Tinybones, Trinket Thief"] },
        { "graveyard": ["Island"], "life": 19 }
      ]
    }
  },
  {
    "name": "three targets: each targeted player discards a card",
    "players": [
      { "hand": ["Tinybones Joins Up", "Island"], "battlefield": ["Swamp"] },
      { "hand": ["Plains"] },
      { "hand": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Tinybones Joins Up" },
      { "resolve": true, "targets": ["p0", "p1", "p2"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Island"] },
        { "hand_count": 0, "graveyard": ["Plains"] },
        { "hand_count": 0, "graveyard": ["Mountain"] }
      ]
    }
  },
  {
    "name": "ruling: each targeted player chooses its own card to discard; the chosen cards are discarded",
    "players": [
      { "hand": ["Tinybones Joins Up", "Island", "Forest"], "battlefield": ["Swamp"] },
      { "hand": ["Plains", "Mountain"] }
    ],
    "steps": [
      { "cast": "Tinybones Joins Up" },
      { "resolve": true, "targets": ["p0", "p1"], "answers": ["Island", "Mountain"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Forest"], "graveyard": ["Island"], "battlefield_has": ["Tinybones Joins Up"] },
        { "hand": ["Plains"], "graveyard": ["Mountain"] }
      ]
    }
  }
]
