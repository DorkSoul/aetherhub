[
  {
    "name": "attacking creates a 2/2 Cat Warrior token with forestwalk",
    "players": [
      {
        "battlefield": [
          "Jedit Ojanen of Efrava"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Jedit Ojanen of Efrava",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Cat Warrior 2-2 Green Forestwalk"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "blocking creates a token too",
    "players": [
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Jedit Ojanen of Efrava"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Jedit Ojanen of Efrava",
            "attacker": "Grizzly Bears"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "battlefield_has": [
            "Cat Warrior 2-2 Green Forestwalk"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a token made during the attack trigger can't attack this combat, even with haste",
    "players": [
      {
        "battlefield": [
          { "name": "Jedit Ojanen of Efrava", "sick": false },
          "Fervor"
        ]
      },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Jedit Ojanen of Efrava", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Cat Warrior 2-2 Green Forestwalk"] },
        { "life": 15 }
      ]
    }
  }
]
