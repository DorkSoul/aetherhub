[
  {
    "name": "single-target mode taps one creature you don't control",
    "players": [
      { "hand": ["Blustersquall"], "battlefield": ["Island"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Blustersquall", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Hill Giant": false }
    }
  },
  {
    "name": "overload taps each creature you don't control",
    "players": [
      { "hand": ["Blustersquall"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Blustersquall", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Hill Giant": true }
    }
  },
  {
    "name": "ruling: overloaded spell doesn't target, so it taps a hexproof creature too",
    "players": [
      { "hand": ["Blustersquall"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Slippery Bogle", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Blustersquall", "alt": 0 },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Slippery Bogle": true, "Grizzly Bears": true }
    }
  }
]
