[
  { "name": "Invert switches a 2/1 Goblin Piker to 1/2 until end of turn",
    "players": [ { "hand": ["Invert"], "battlefield": ["Island", "Goblin Piker"] }, {} ],
    "steps": [ { "cast": "Invert", "targets": ["Goblin Piker"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Invert"] }, {} ], "pt": { "Goblin Piker": [1, 2] } } },
  { "name": "Invert with two targets switches each of them",
    "players": [ { "hand": ["Invert"], "battlefield": ["Island", "Goblin Piker", "Giant Spider"] }, {} ],
    "steps": [ { "cast": "Invert", "targets": ["Goblin Piker", "Giant Spider"] }, { "resolve": true } ],
    "expect": { "pt": { "Goblin Piker": [1, 2], "Giant Spider": [4, 2] } } },
  { "name": "up to two: Invert with no targets resolves and changes nothing",
    "players": [ { "hand": ["Invert"], "battlefield": ["Island", "Goblin Piker"] }, {} ],
    "steps": [ { "cast": "Invert", "targets": [] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Invert"] }, {} ], "pt": { "Goblin Piker": [2, 1] } } },
  { "name": "Invent finds an instant and a sorcery from the library",
    "players": [ { "hand": ["Invert"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain"], "library": ["Lightning Bolt", "Cruel Edict", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Invert", "face": true }, { "resolve": true, "answers": ["Lightning Bolt", "Cruel Edict"] } ],
    "expect": { "players": [ { "graveyard": ["Invert"], "hand": ["Lightning Bolt", "Cruel Edict"] }, {} ] } },
  { "name": "Invent with no sorcery in the library finds only the instant",
    "players": [ { "hand": ["Invert"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain"], "library": ["Lightning Bolt", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Invert", "face": true }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"] }, {} ] } }
]
