[
  { "name": "combat damage exiles up to two cards from the damaged player's graveyard",
    "players": [ { "hand": ["Skullsnatcher"], "battlefield": ["Swamp", "Grizzly Bears"] }, { "graveyard": ["Lightning Bolt", "Llanowar Elves", "Forest"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "activate": "Skullsnatcher", "ability": 0 }, { "resolve": true }, { "advance_to": "Main2", "targets": ["Lightning Bolt", "Llanowar Elves"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Skullsnatcher"] }, { "exile": ["Lightning Bolt", "Llanowar Elves"], "graveyard": ["Forest"] } ] } },
  { "name": "ninjutsu costs only B",
    "players": [ { "hand": ["Skullsnatcher"], "battlefield": ["Swamp", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "activate": "Skullsnatcher", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Grizzly Bears"], "battlefield_has": ["Skullsnatcher"] }, {} ] } },
  { "name": "ninjutsu is not available when the attacker is blocked",
    "players": [ { "hand": ["Skullsnatcher"], "battlefield": ["Swamp", "Grizzly Bears"] }, { "battlefield": ["Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] }, { "activate": "Skullsnatcher", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Skullsnatcher"] }, {} ] } },
  { "name": "ruling: up to two targets: zero targets exiles nothing",
    "players": [ { "battlefield": ["Skullsnatcher"] }, { "graveyard": ["Lightning Bolt", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Skullsnatcher", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2", "targets": [] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Skullsnatcher"] }, { "graveyard": ["Lightning Bolt", "Llanowar Elves"], "exile": [] } ] } },
  { "name": "ruling: up to two targets: a single target is exiled",
    "players": [ { "battlefield": ["Skullsnatcher"] }, { "graveyard": ["Lightning Bolt", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Skullsnatcher", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2", "targets": ["Lightning Bolt"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Skullsnatcher"] }, { "exile": ["Lightning Bolt"], "graveyard": ["Llanowar Elves"] } ] } }
]
