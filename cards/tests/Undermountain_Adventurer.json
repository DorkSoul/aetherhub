   "steps": [ { "tap_for_mana": "Undermountain Adventurer", "color": "G" } ],
   "expect": { "players": [ { "pool": { "G": 2 } }, {} ] } },
 { "name": "entering takes the initiative: Undercity's Secret Entrance fetches a basic land",
