   "steps": [ { "cast": "Undermountain Adventurer" }, { "resolve": true, "answers": ["Forest"] } ],
   "expect": { "players": [ { "hand": ["Forest"] }, {} ] } },
 { "name": "after completing a dungeon it taps for six G instead",
