              { "attack": [ { "card": "Grizzly Bears", "at": "p0" } ], "player": 1 },
              { "block": [], "player": 0 },
              { "advance_to": "Main2", "answers": ["Forest"] } ],
   "expect": { "players": [ { "life": 18 }, { "command": ["The Initiative", "Undercity"] } ] } }
