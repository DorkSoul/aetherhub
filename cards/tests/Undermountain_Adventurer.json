   "players": [ { "hand": ["Undermountain Adventurer"], "battlefield": ["Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Undermountain Adventurer" }, { "resolve": true, "answers": ["Forest"] } ],
   "expect": { "players": [ { "command": ["The Initiative", "Undercity"] }, {} ] } },
 { "name": "ruling: taking the initiative again while already in Undercity moves to the next room",
   "players": [ { "hand": ["Undermountain Adventurer", "Undermountain Adventurer"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"], "library": ["Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Undermountain Adventurer" }, { "resolve": true, "answers": ["Forest"] },
