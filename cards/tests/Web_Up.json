[
 {
  "name": "exiles an opposing nonland permanent until it leaves",
  "players": [
   { "hand": ["Web Up"], "battlefield": ["Plains", "Plains", "Plains"] },
   { "battlefield": ["Forest", "Hill Giant"] }
  ],
  "steps": [
   { "cast": "Web Up" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Web Up"] },
    { "exile": ["Hill Giant"], "battlefield_has": ["Forest"], "battlefield_lacks": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "does not target your own nonland permanent",
  "players": [
   { "hand": ["Web Up"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "cast": "Web Up" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears", "Web Up"] },
    { "exile": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "with only a land to target the trigger does nothing",
  "players": [
   { "hand": ["Web Up"], "battlefield": ["Plains", "Plains", "Plains"] },
   { "battlefield": ["Forest"] }
  ],
  "steps": [
   { "cast": "Web Up" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Web Up"] },
    { "battlefield_has": ["Forest"], "exile": [] }
   ]
  }
 }
]
