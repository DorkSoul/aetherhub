[
  {
    "name": "shuffles two chosen cards from hand back and draws two",
    "players": [
      {
        "hand": ["Mountain", "Island", "Forest"],
        "battlefield": ["Credit Voucher", "Plains", "Plains"]
      }
    ],
    "steps": [
      { "activate": "Credit Voucher", "ability": 0 },
      { "resolve": true, "answers": [["Mountain", "Island"]] }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3,
          "graveyard": ["Credit Voucher"]
        }
      ]
    }
  },
  {
    "name": "choosing no cards shuffles nothing and draws nothing",
    "players": [
      {
        "hand": ["Mountain", "Island", "Forest"],
        "battlefield": ["Credit Voucher", "Plains", "Plains"]
      }
    ],
    "steps": [
      { "activate": "Credit Voucher", "ability": 0 },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Mountain", "Island", "Forest"],
          "hand_count": 3,
          "graveyard": ["Credit Voucher"]
        }
      ]
    }
  },
  {
    "name": "needs {2} to activate (one land is not enough)",
    "players": [
      {
        "hand": ["Mountain"],
        "battlefield": ["Credit Voucher", "Plains"]
      }
    ],
    "steps": [
      { "activate": "Credit Voucher", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Mountain"],
          "battlefield": ["Credit Voucher", "Plains"]
        }
      ]
    }
  }
]
