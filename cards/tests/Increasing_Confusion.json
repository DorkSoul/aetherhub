        { "library_count": 18 }
      ]
    }
  },
  {
    "name": "ruling: cast from hand with X=1 mills the top card into the graveyard",
    "players": [
      { "hand": ["Increasing Confusion"], "battlefield": ["Island", "Island"] },
      { "library": ["Grizzly Bears", "Plains"] }
    ],
    "steps": [
      { "cast": "Increasing Confusion", "targets": ["p1"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Increasing Confusion"] },
        { "graveyard_has": ["Grizzly Bears"], "library_top": ["Plains"] }
      ]
    }
  },
  {
    "name": "ruling: flashback from the graveyard mills twice X into the graveyard",
    "players": [
      { "graveyard": ["Increasing Confusion"], "battlefield": ["Island", "Island"] },
      { "library": ["Grizzly Bears", "Plains"] }
    ],
    "steps": [
      { "cast": "Increasing Confusion", "alt": 0, "targets": ["p1"], "answers": [1] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Increasing Confusion"] },
        { "graveyard_has": ["Grizzly Bears", "Plains"] }
      ]
    }
  },
  {
    "name": "ruling: flashback is sorcery-speed, illegal on the opponent's turn",
    "players": [
      { "graveyard": ["Increasing Confusion"], "battlefield": ["Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Increasing Confusion", "alt": 0, "targets": ["p1"], "answers": [1], "illegal": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Increasing Confusion"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: a flashback spell that is countered is still exiled",
    "players": [
      { "graveyard": ["Increasing Confusion"], "battlefield": ["Island", "Island"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Increasing Confusion", "alt": 0, "targets": ["p1"], "answers": [1] },
      { "pass": true },
      { "cast": "Counterspell", "targets": [{ "stack": "Increasing Confusion" }], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "exile": ["Increasing Confusion"] },
        { "graveyard_has": ["Counterspell"], "library_count": 20 }
      ]
