[
  { "name": "cast from hand creates a 4/4 Beast",
    "players": [ { "hand": ["Shadowbeast Sighting"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Shadowbeast Sighting" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Shadowbeast Sighting"], "battlefield_has": ["Beast 4-4"] }, {} ] } },
  { "name": "flashback for 6G from graveyard, then exiled",
    "players": [ { "graveyard": ["Shadowbeast Sighting"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Shadowbeast Sighting", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Shadowbeast Sighting"], "graveyard": [], "battlefield_has": ["Beast 4-4"] }, {} ] } },
  { "name": "flashback needs seven mana",
    "players": [ { "graveyard": ["Shadowbeast Sighting"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Shadowbeast Sighting", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Shadowbeast Sighting"] }, {} ] } },
  { "name": "ruling: flashback is cast with sorcery timing, so not on the opponent's turn",
    "players": [ { "graveyard": ["Shadowbeast Sighting"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Shadowbeast Sighting", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard": ["Shadowbeast Sighting"] }, {} ] } },
  { "name": "ruling: a flashback card put into the graveyard on your turn can be cast right away",
    "players": [ { "hand": ["Shadowbeast Sighting"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Shadowbeast Sighting" }, { "resolve": true }, { "cast": "Shadowbeast Sighting", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Shadowbeast Sighting"], "graveyard": [], "battlefield_has": ["Beast 4-4"] }, {} ] } }
]
