[
  {
    "name": "enters with a charge counter",
    "players": [
      { "hand": ["Tendo Ice Bridge"] },
      {}
    ],
    "steps": [
      { "play_land": "Tendo Ice Bridge" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Tendo Ice Bridge"] },
        {}
      ],
      "counters": { "Tendo Ice Bridge": { "charge": 1 } }
    }
  },
  {
    "name": "taps for colorless",
    "players": [
      { "battlefield": ["Tendo Ice Bridge"] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Tendo Ice Bridge" }
    ],
    "expect": {
      "players": [
        { "pool": { "C": 1 } },
        {}
      ],
      "tapped": { "Tendo Ice Bridge": true }
    }
  },
  {
    "name": "removing a charge counter taps it for one mana of any color",
    "players": [
      { "battlefield": [{ "name": "Tendo Ice Bridge", "counters": { "charge": 1 } }] },
      {}
    ],
    "steps": [
      { "tap_for_mana": "Tendo Ice Bridge", "color": "R" }
    ],
    "expect": {
      "players": [
        { "pool": { "R": 1 } },
        {}
      ],
      "tapped": { "Tendo Ice Bridge": true },
      "counters": { "Tendo Ice Bridge": { "charge": 0 } }
    }
  }
]
