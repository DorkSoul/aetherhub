      { "battlefield": ["Swamp", "Swamp"], "graveyard": ["Sedraxis Specter"] },
      { "battlefield": ["Blessed Spirits"] }
    ],
    "steps": [
      { "activate": "Sedraxis Specter", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Sedraxis Specter", "at": "p1" } ] },
      { "block": [ { "blocker": "Blessed Spirits", "attacker": "Sedraxis Specter" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "exile": ["Sedraxis Specter"], "graveyard": [] },
        { "graveyard": ["Blessed Spirits"] }
