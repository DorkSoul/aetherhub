[
  {
    "name": "taps to give target creature +2/+2 in precombat main",
    "players": [
      { "battlefield": ["Alaborn Veteran", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Alaborn Veteran", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] }
    }
  },
  {
    "name": "cannot activate in second main phase (after attackers)",
    "players": [
      { "battlefield": ["Alaborn Veteran", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "activate": "Alaborn Veteran", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: before attackers in the first combat (beginning of combat) it can be activated",
    "players": [
      { "battlefield": ["Alaborn Veteran", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "activate": "Alaborn Veteran", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [4, 4] },
      "tapped": { "Alaborn Veteran": true }
    }
  },
  {
    "name": "ruling: in an additional combat phase (from Relentless Assault) it can't be activated",
    "players": [
      { "hand": ["Relentless Assault"], "battlefield": ["Alaborn Veteran", "Grizzly Bears", "Mountain", "Mountain", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "cast": "Relentless Assault" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "activate": "Alaborn Veteran", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2] },
      "tapped": { "Alaborn Veteran": false }
    }
  }
]
