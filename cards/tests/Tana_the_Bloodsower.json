[
  {
    "name": "combat damage to a player creates that many Saprolings",
    "players": [
      {
        "battlefield": [
          "Tana, the Bloodsower"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Tana, the Bloodsower",
            "at": "p1"
          }
        ]
      },
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Saproling 1-1 G",
            "Saproling 1-1 G"
          ]
        },
        {
          "life": 18
        }
      ],
      "pt": {
        "Tana, the Bloodsower": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "blocked with no excess trample damage creates no tokens",
    "players": [
      {
        "battlefield": [
          "Tana, the Bloodsower"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Tana, the Bloodsower",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Grizzly Bears",
            "attacker": "Tana, the Bloodsower"
          }
        ]
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Saproling 1-1 G"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: Command Beacon puts the commander the controller chooses when two commanders are out",
    "commander": true,
    "players": [
      { "command": ["Tana, the Bloodsower", "Falthis, Shadowcat Familiar"], "battlefield": ["Command Beacon"] },
      {}
    ],
    "steps": [
      { "activate": "Command Beacon", "ability": 0 },
      { "resolve": true, "answers": ["Falthis, Shadowcat Familiar"] }
    ],
    "expect": {
      "players": [ { "hand": ["Falthis, Shadowcat Familiar"], "command": ["Tana, the Bloodsower"] }, {} ]
    }
  },
  {
    "name": "ruling: casting one commander does not add commander tax to the other",
    "commander": true,
    "players": [
      { "command": ["Tana, the Bloodsower", "Falthis, Shadowcat Familiar"], "battlefield": ["Mountain", "Forest", "Swamp", "Swamp", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Tana, the Bloodsower" },
      { "resolve": true },
      { "cast": "Falthis, Shadowcat Familiar" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Tana, the Bloodsower", "Falthis, Shadowcat Familiar"] }, {} ]
    }
  }
]
