[
  {
    "name": "ruling: an opponent's Pirate is not another Pirate you control; no trigger",
    "players": [ { "hand": ["Dreamcaller Siren"], "battlefield": ["Island", "Island", "Island", "Island"] },
                 { "battlefield": ["Brazen Freebooter", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Dreamcaller Siren" }, { "resolve": true } ],
    "expect": { "tapped": { "Grizzly Bears": false }, "players": [ { "battlefield_has": ["Dreamcaller Siren"] }, { "battlefield_has": ["Brazen Freebooter", "Grizzly Bears"] } ] } },
  {
    "name": "taps up to two nonland permanents when you control another Pirate",
    "players": [
      { "hand": ["Dreamcaller Siren"], "battlefield": ["Island", "Island", "Island", "Island", "Brazen Freebooter"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dreamcaller Siren" },
      { "resolve": true, "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "players": [ { "battlefield_has": ["Dreamcaller Siren", "Brazen Freebooter"] }, {} ]
    }
  },
  {
    "name": "no trigger without another Pirate",
    "players": [
      { "hand": ["Dreamcaller Siren"], "battlefield": ["Island", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dreamcaller Siren" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false },
      "players": [ { "battlefield_has": ["Dreamcaller Siren"] }, {} ]
    }
  },
  {
    "name": "can block only fliers: Siren's declared block of a ground creature is dropped, 2 damage connects",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Dreamcaller Siren", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Dreamcaller Siren", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  },
  {
    "name": "a flying attacker can be blocked by Siren: Serra Angel's 4 damage kills the 3/3",
    "players": [
      { "battlefield": ["Serra Angel"] },
      { "battlefield": ["Dreamcaller Siren"] }
    ],
    "steps": [
      { "attack": [ { "card": "Serra Angel", "at": "p1" } ] },
      { "block": [ { "blocker": "Dreamcaller Siren", "attacker": "Serra Angel" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "graveyard": ["Dreamcaller Siren"] } ] }
  }
]
