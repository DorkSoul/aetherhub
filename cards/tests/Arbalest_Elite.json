[
  {
    "name": "3 damage to an attacking creature",
    "players": [
      { "battlefield": ["Arbalest Elite", "Hill Giant", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "activate": "Arbalest Elite", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Hill Giant"], "battlefield_has": ["Arbalest Elite"] }, {} ],
      "tapped": { "Arbalest Elite": true }
    }
  },
  {
    "name": "only attacking or blocking creatures can be targeted",
    "players": [
      { "battlefield": ["Arbalest Elite", "Hill Giant", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Arbalest Elite", "targets": ["Hill Giant"], "illegal": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Hill Giant"] }, {} ]
    }
  },
  {
    "name": "ruling: if its target is gone on resolution, the skip-untap does not apply",
    "players": [
      { "battlefield": ["Arbalest Elite", "Plains", "Plains", "Plains", "Hill Giant"] },
      { "battlefield": ["Mountain"], "hand": ["Lightning Bolt"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "activate": "Arbalest Elite", "targets": ["Hill Giant"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Hill Giant"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Hill Giant"] }, { "graveyard": ["Lightning Bolt"] } ],
      "tapped": { "Arbalest Elite": false }
    }
  }
]
