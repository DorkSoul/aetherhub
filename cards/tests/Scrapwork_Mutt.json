    "expect": {
      "players": [ { "graveyard": ["Scrapwork Mutt"] }, {} ]
    }
  },
  {
    "name": "ruling: unearthed Mutt killed by Lightning Bolt is exiled instead of going to the graveyard",
    "players": [
      { "hand": ["Lightning Bolt"], "graveyard": ["Scrapwork Mutt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Scrapwork Mutt", "ability": 0 },
      { "resolve": true, "answers": [false] },
      { "cast": "Lightning Bolt", "targets": ["Scrapwork Mutt"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Scrapwork Mutt"], "graveyard": ["Lightning Bolt"] }, {} ]
