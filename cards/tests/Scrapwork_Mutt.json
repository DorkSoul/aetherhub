    "expect": {
      "players": [ { "battlefield_has": ["Scrapwork Mutt"] }, { "life": 18 } ]
    }
  },
  {
    "name": "unearth: it is exiled at the beginning of the end step",
    "players": [
      { "graveyard": ["Scrapwork Mutt"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Scrapwork Mutt", "ability": 0 },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Scrapwork Mutt"] }, {} ]
    }
  },
  {
    "name": "unearth costs {1}{R}: not payable with one Mountain",
    "players": [
      { "graveyard": ["Scrapwork Mutt"], "battlefield": ["Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Scrapwork Mutt", "ability": 0, "illegal": true }
