    "players": [
      {
        "hand": [
          "Scrapwork Mutt",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Scrapwork Mutt"
      },
      {
        "resolve": true,
        "answers": [
          false
