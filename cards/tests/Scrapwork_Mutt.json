  {
    "name": "unearth returns it with haste: it attacks for 2 the turn it comes back",
    "players": [
      { "graveyard": ["Scrapwork Mutt"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Scrapwork Mutt", "ability": 0 },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "attack": [ { "card": "Scrapwork Mutt", "at": "p1" } ] },
      { "advance_to": "Main2" }
