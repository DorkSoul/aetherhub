[
  {
    "name": "destroys an artifact of mana value 4 or less",
    "players": [
      {
        "hand": [
          "Fragmentize"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Sol Ring"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Fragmentize",
        "targets": [
          "Sol Ring"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Fragmentize"
          ]
        },
        {
          "graveyard": [
            "Sol Ring"
          ]
        }
      ]
    }
  },
  {
    "name": "mana value 5 or more is not a legal target",
    "players": [
      {
        "hand": [
          "Fragmentize"
        ],
        "battlefield": [
          "Plains"
        ]
      },
      {
        "battlefield": [
          "Wurmcoil Engine"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Fragmentize",
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Fragmentize"
          ]
        },
        {
          "battlefield_has": [
            "Wurmcoil Engine"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: an X-cost artifact (Hangarback Walker) has mana value 0 and can be targeted",
    "players": [ { "hand": ["Fragmentize"], "battlefield": ["Plains"] }, { "battlefield": [ { "name": "Hangarback Walker", "counters": { "p1p1": 2 } } ] } ],
    "steps": [ { "cast": "Fragmentize", "targets": ["Hangarback Walker"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Fragmentize"] }, { "graveyard_has": ["Hangarback Walker"] } ] }
  },
  {
    "name": "ruling: a token that is not a copy has mana value 0, so Fragmentize can destroy a Thopter token",
    "players": [ { "hand": ["Fragmentize", "Fragmentize"], "battlefield": ["Plains", "Plains"] }, { "battlefield": [ { "name": "Hangarback Walker", "counters": { "p1p1": 1 } } ] } ],
    "steps": [ { "cast": "Fragmentize", "targets": ["Hangarback Walker"] }, { "resolve": true }, { "cast": "Fragmentize", "targets": ["Thopter"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Fragmentize"] }, { "graveyard_has": ["Hangarback Walker"], "battlefield_lacks": ["Thopter"] } ] }
  }
]