[
  {
    "name": "ETB creates a Lander token",
    "players": [
      {
        "hand": [
          "Kav Landseeker"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Kav Landseeker"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Kav Landseeker",
            "Lander",
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "Lander is not sacrificed at the end step of the turn it entered",
    "players": [
      {
        "hand": [
          "Kav Landseeker"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Kav Landseeker"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Kav Landseeker",
            "Lander",
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "Lander is sacrificed at the end step of your next turn",
    "players": [
      {
        "hand": [
          "Kav Landseeker"
        ],
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Kav Landseeker"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Kav Landseeker",
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain"
          ],
          "battlefield_lacks": [
            "Lander"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: a replacement that doubles tokens creates two Landers from the ETB",
    "players": [ { "hand": ["Kav Landseeker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Exalted Sunborn"] }, {} ],
    "steps": [ { "cast": "Kav Landseeker" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Kav Landseeker", "Exalted Sunborn", "Lander", "Lander", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ] }
  },
  {
    "name": "ruling: when tokens were doubled, every Lander is sacrificed at the end step of your next turn",
    "players": [ { "hand": ["Kav Landseeker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Exalted Sunborn"] }, {} ],
    "steps": [ { "cast": "Kav Landseeker" }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Kav Landseeker", "Exalted Sunborn"], "battlefield_lacks": ["Lander"] }, {} ] }
  },
  {
    "name": "ruling: the sacrifice is not a search, so no basic land enters at the end step",
    "players": [ { "hand": ["Kav Landseeker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Kav Landseeker" }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Kav Landseeker", "Mountain", "Mountain", "Mountain", "Mountain"], "battlefield_lacks": ["Lander"] }, {} ] }
  }
]
