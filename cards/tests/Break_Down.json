[
  { "name": "destroys target artifact and creates a Junk",
    "players": [ { "hand": ["Break Down"], "battlefield": ["Forest", "Forest", "Forest", "Mind Stone"] }, {} ],
    "steps": [ { "cast": "Break Down", "targets": ["Mind Stone"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Break Down", "Mind Stone"], "battlefield_has": ["Junk"], "battlefield_lacks": ["Mind Stone"] }, {} ] } },
  { "name": "destroys target enchantment and creates a Junk",
    "players": [ { "hand": ["Break Down"], "battlefield": ["Forest", "Forest", "Forest", "Glorious Anthem"] }, {} ],
    "steps": [ { "cast": "Break Down", "targets": ["Glorious Anthem"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Glorious Anthem"], "battlefield_has": ["Junk"] }, {} ] } },
  { "name": "no artifact or enchantment to target: cannot cast",
    "players": [ { "hand": ["Break Down"], "battlefield": ["Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Break Down", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Break Down"], "battlefield_lacks": ["Junk"] }, {} ] } },
  { "name": "ruling: sacrificed Junk exiles the top card, which can be played this turn (a land)",
    "players": [ { "hand": ["Break Down"], "battlefield": ["Forest", "Forest", "Forest", "Mind Stone"], "library": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Break Down", "targets": ["Mind Stone"] }, { "resolve": true }, { "activate": "Junk", "ability": 0 }, { "resolve": true }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Junk"], "library_top": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: the card exiled with a Junk can be played only in a main phase (not in combat)",
    "players": [ { "hand": ["Break Down"], "battlefield": ["Forest", "Forest", "Forest", "Mind Stone"], "library": ["Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Break Down", "targets": ["Mind Stone"] }, { "resolve": true }, { "activate": "Junk", "ability": 0 }, { "resolve": true },
               { "advance_to": "BeginCombat" }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Junk"], "library_top": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: the only target is gone on resolution: nothing happens, no Junk",
    "players": [ { "hand": ["Break Down"], "battlefield": ["Forest", "Forest", "Forest", "Mind Stone"] }, { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "cast": "Break Down", "targets": ["Mind Stone"] }, { "pass": true }, { "cast": "Shatter", "player": 1, "targets": ["Mind Stone"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Break Down", "Mind Stone"], "battlefield_lacks": ["Junk"] }, { "graveyard_has": ["Shatter"] } ] } }
]
