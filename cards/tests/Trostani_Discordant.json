[
  {
    "name": "end step: each player regains the creatures they own",
    "players": [
      { "battlefield": ["Trostani Discordant", "Forest", "Forest", "Forest", "Island", "Island", "Island", "Plains", "Plains"], "hand": ["Control Magic"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Control Magic", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "creatures you already own stay under your control at your end step",
    "players": [
      { "battlefield": ["Trostani Discordant", "Grizzly Bears"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears", "Trostani Discordant"] },
        {}
      ]
    }
  },
  {
    "name": "other creatures you control get +1/+1",
    "players": [
      { "battlefield": ["Trostani Discordant", "Grizzly Bears", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [],
    "expect": {
      "players": [{}, {}],
      "pt": { "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "enters: create two 1/1 lifelink Soldiers",
    "players": [
      { "hand": ["Trostani Discordant"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Trostani Discordant" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Trostani Discordant", "Soldier 1-1 Lifelink", "Soldier 1-1 Lifelink"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: nonlethal damage stays marked, so it kills the creature once Trostani leaves",
    "players": [
      {"hand": ["Shock", "Doom Blade"], "battlefield": ["Trostani Discordant", "Grizzly Bears", "Mountain", "Swamp", "Swamp"]},
      {}
    ],
    "steps": [
      {"cast": "Shock", "targets": ["Grizzly Bears"]},
      {"resolve": true},
      {"cast": "Doom Blade", "targets": ["Trostani Discordant"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"graveyard": ["Doom Blade", "Grizzly Bears", "Shock", "Trostani Discordant"]}, {}]
    }
  },
  {
    "name": "with Trostani still on the battlefield the 2 damage does not kill the 3/3 Bears",
    "players": [
      {"hand": ["Shock"], "battlefield": ["Trostani Discordant", "Grizzly Bears", "Mountain"]},
      {}
    ],
    "steps": [
      {"cast": "Shock", "targets": ["Grizzly Bears"]},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"battlefield_has": ["Grizzly Bears", "Trostani Discordant"]}, {}]
    }
  }
]
