   "steps": [ { "cast": "Diabolic Edict", "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Possessed Skaab"], "graveyard": ["Diabolic Edict"], "battlefield": ["Swamp", "Swamp"] }, {} ] } },
 { "name": "ruling: a creature exiled instead of dying does not trigger Blood Artist",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Blood Artist", { "name": "Possessed Skaab", "sick": false }] }, {} ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Possessed Skaab"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "exile": ["Possessed Skaab"], "battlefield": ["Blood Artist", "Mountain"] }, { "life": 20 } ] } }
