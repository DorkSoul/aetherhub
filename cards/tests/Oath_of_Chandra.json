[
  {
    "name": "ETB deals 3 damage to target creature an opponent controls",
    "players": [
      { "hand": ["Oath of Chandra"], "battlefield": ["Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Oath of Chandra" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Oath of Chandra"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "end step: no damage when no planeswalker entered this turn",
    "players": [
      { "battlefield": ["Oath of Chandra", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ {}, { "life": 20 } ]
    }
  },
  {
    "name": "end step: 2 damage to each opponent when a planeswalker entered under your control this turn",
    "players": [
      { "hand": ["Ajani Resolute"], "battlefield": ["Oath of Chandra", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Ajani Resolute" },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: the end-step trigger still happens when the Oath entered after the planeswalker",
    "players": [
      { "hand": ["Ajani Resolute", "Oath of Chandra"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Ajani Resolute" },
      { "resolve": true },
      { "cast": "Oath of Chandra" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Ajani Resolute", "Oath of Chandra"] }, { "life": 18, "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: a second copy of a legendary Oath still gets its ETB; the legend rule keeps one",
    "players": [
      { "hand": ["Oath of Chandra"], "battlefield": ["Oath of Chandra", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Oath of Chandra" },
      { "resolve": true, "answers": [0] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Oath of Chandra"], "graveyard_has": ["Oath of Chandra"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
