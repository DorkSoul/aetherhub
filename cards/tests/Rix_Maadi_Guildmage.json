[
  { "name": "target player who lost life this turn loses 1 life",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Rix Maadi Guildmage", "Mountain", "Mountain", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "activate": "Rix Maadi Guildmage", "ability": 1, "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 16 } ] } },
  { "name": "player who lost no life is not a legal target",
    "players": [ { "battlefield": ["Rix Maadi Guildmage", "Mountain", "Swamp"] }, {} ],
    "steps": [ { "activate": "Rix Maadi Guildmage", "ability": 1, "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "target blocking creature gets -1/-1",
    "players": [ { "battlefield": ["Rix Maadi Guildmage", "Mountain", "Swamp", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
               { "activate": "Rix Maadi Guildmage", "ability": 0, "targets": ["Grizzly Bears"] },
               { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [1, 1] } } },
  { "name": "two activations on a blocking creature kill it",
    "players": [ { "battlefield": ["Rix Maadi Guildmage", "Mountain", "Mountain", "Swamp", "Swamp", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
               { "activate": "Rix Maadi Guildmage", "ability": 0, "targets": ["Grizzly Bears"] },
               { "resolve": true },
               { "activate": "Rix Maadi Guildmage", "ability": 0, "targets": ["Grizzly Bears"] },
               { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "-1/-1 targets only a blocking creature: an attacking creature is not a legal target",
    "players": [ { "battlefield": ["Rix Maadi Guildmage", "Mountain", "Swamp", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "activate": "Rix Maadi Guildmage", "ability": 0, "targets": ["Hill Giant"], "illegal": true } ],
    "expect": { "pt": { "Hill Giant": [3, 3] } } },
  { "name": "ruling: a blocking creature stays blocking after the creature it blocked has left combat",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Rix Maadi Guildmage", "Mountain", "Mountain", "Swamp", "Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
               { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
               { "resolve": true },
               { "activate": "Rix Maadi Guildmage", "ability": 0, "targets": ["Grizzly Bears"] },
               { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [1, 1] } } }
]
