[
  {
    "name": "blocking deals damage equal to its power to the attacking creature's controller",
    "players": [
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Meglonoth",
          "Plains"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Meglonoth",
            "attacker": "Grizzly Bears"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 14,
          "graveyard": [
            "Grizzly Bears"
          ]
        },
        {
          "battlefield_has": [
            "Meglonoth"
          ],
          "life": 20
        }
      ]
    }
  },
  {
    "name": "ruling: pump in response to the block trigger: damage uses power on resolution (9)",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Meglonoth", "Forest"], "hand": ["Giant Growth"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Meglonoth", "attacker": "Grizzly Bears" } ] },
      { "pass": true },
      { "cast": "Giant Growth", "targets": ["Meglonoth"], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 11, "graveyard": ["Grizzly Bears"] }, { "battlefield_has": ["Meglonoth"], "graveyard": ["Giant Growth"], "life": 20 } ] }
  },
  {
    "name": "ruling: blocker removed in response: the trigger uses its last-known power (6) and still deals damage",
    "players": [
      { "battlefield": ["Grizzly Bears", "Swamp", "Swamp"], "hand": ["Doom Blade"] },
      { "battlefield": ["Meglonoth"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Meglonoth", "attacker": "Grizzly Bears" } ] },
      { "cast": "Doom Blade", "targets": ["Meglonoth"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "life": 14, "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Meglonoth"] } ] }
  },
  {
    "name": "not blocking: no damage trigger",
    "players": [
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Meglonoth"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {
          "life": 18
        }
      ]
    }
  }
]