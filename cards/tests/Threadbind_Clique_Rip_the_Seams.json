[
  { "name": "Rip the Seams destroys a tapped creature",
    "players": [ { "hand": ["Threadbind Clique // Rip the Seams"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Threadbind Clique // Rip the Seams", "face": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "cannot target an untapped creature",
    "players": [ { "hand": ["Threadbind Clique // Rip the Seams"], "battlefield": ["Plains", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Threadbind Clique // Rip the Seams", "face": true, "illegal": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: a card exiled by Rip the Seams can be cast as the creature later",
    "players": [ { "hand": ["Threadbind Clique // Rip the Seams"], "battlefield": ["Plains", "Plains", "Plains", "Island", "Island", "Island", "Island"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Threadbind Clique // Rip the Seams", "face": true, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Threadbind Clique // Rip the Seams" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Threadbind Clique // Rip the Seams"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: the exiled adventurer cannot be cast as the creature while another spell is on the stack",
    "players": [ { "hand": ["Threadbind Clique // Rip the Seams", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Mountain", "Island", "Island", "Island", "Island"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, "Llanowar Elves" ] } ],
    "steps": [ { "cast": "Threadbind Clique // Rip the Seams", "face": true, "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Lightning Bolt", "targets": ["Llanowar Elves"] },
               { "cast": "Threadbind Clique // Rip the Seams", "illegal": true },
               { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Threadbind Clique // Rip the Seams"] }, { "graveyard": ["Grizzly Bears", "Llanowar Elves"] } ] } },
  { "name": "ruling: if Rip the Seams fizzles it goes to the graveyard and is not exiled",
    "players": [ { "hand": ["Threadbind Clique // Rip the Seams", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Mountain"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Threadbind Clique // Rip the Seams", "face": true, "targets": ["Grizzly Bears"] },
               { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Threadbind Clique // Rip the Seams", "Lightning Bolt"], "exile": [] }, { "graveyard": ["Grizzly Bears"] } ] } }
]
