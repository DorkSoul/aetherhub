      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Just the Wind"] },
        { "battlefield_lacks": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "madness: discarded to Wild Guess, pay U, bounce the creature",
    "players": [
      { "hand": ["Wild Guess", "Just the Wind"], "battlefield": ["Mountain", "Mountain", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Wild Guess" },
      { "resolve": true, "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Wild Guess"] },
        { "battlefield_lacks": ["Grizzly Bears"], "hand_count": 1 }
      ]
    }
  },
  {
    "name": "madness: declining leaves it in the graveyard and the creature stays",
    "players": [
      { "hand": ["Wild Guess", "Just the Wind"], "battlefield": ["Mountain", "Mountain", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Wild Guess" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Just the Wind"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
