[
  {
    "name": "casts a Dragon spell from the top of the library",
    "players": [
      {
        "battlefield": ["Korlessa, Scale Singer", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Shivan Dragon", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Shivan Dragon" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Korlessa, Scale Singer", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Shivan Dragon"], "library_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "a non-Dragon on top of the library cannot be cast",
    "players": [
      {
        "battlefield": ["Korlessa, Scale Singer", "Forest", "Forest", "Forest"],
        "library": ["Grizzly Bears"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield": ["Korlessa, Scale Singer", "Forest", "Forest", "Forest"] }, {}]
    }
  },
  {
    "name": "ruling: a Dragon cast from the top pays its kicker cost (additional cost)",
    "players": [
      {
        "battlefield": ["Korlessa, Scale Singer", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Verix Bladewing"]
      },
      {}
    ],
    "steps": [
      { "cast": "Verix Bladewing", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Verix Bladewing", "Karox Bladewing"] }, {} ]
    }
  },
  {
    "name": "ruling: a card on top of the library cannot be cycled (cycling works only from hand)",
    "players": [
      {
        "battlefield": ["Korlessa, Scale Singer", "Forest", "Forest"],
        "library": ["Capital City"]
      },
      {}
    ],
    "steps": [
      { "activate": "Capital City", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [ { "library_top": ["Capital City"] }, {} ]
    }
  },
  {
    "name": "ruling: without flash a Dragon on top cannot be cast during combat",
    "players": [
      {
        "battlefield": ["Korlessa, Scale Singer", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"],
        "library": ["Shivan Dragon"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Shivan Dragon", "illegal": true }
    ],
    "expect": {
      "players": [ { "library_top": ["Shivan Dragon"] }, {} ]
    }
  },
  {
    "name": "ruling: a Dragon with flash can be cast from the top during combat",
    "players": [
      {
        "battlefield": ["Korlessa, Scale Singer", "Island", "Island", "Island", "Island", "Island", "Island"],
        "library": ["Transcendent Dragon"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" },
      { "cast": "Transcendent Dragon" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Transcendent Dragon"] }, {} ]
    }
  }
]
