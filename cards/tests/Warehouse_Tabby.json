[
 { "name": "an enchantment you control going to the graveyard creates a 1/1 Rat that can't block",
   "players": [ { "hand": ["War Squeak", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Warehouse Tabby", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "War Squeak", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Warehouse Tabby", "Rat 1-1 Cant Block"], "graveyard": ["War Squeak", "Grizzly Bears", "Lightning Bolt"] }, {} ] } },
 { "name": "{1}{B}: gains deathtouch until end of turn",
   "players": [ { "battlefield": ["Swamp", "Swamp", "Warehouse Tabby", "Grizzly Bears"] }, {} ],
   "steps": [ { "activate": "Warehouse Tabby", "ability": 0 }, { "resolve": true } ],
   "expect": { "keywords": { "Warehouse Tabby": ["Deathtouch"] } } },
 { "name": "ruling: a Role token put into the graveyard by the Role rule still triggers Warehouse Tabby",
   "players": [ { "hand": ["Monstrous Rage", "Monstrous Rage"], "battlefield": ["Mountain", "Mountain", "Warehouse Tabby", "Grizzly Bears"] }, {} ],
   "steps": [ { "cast": "Monstrous Rage", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Monstrous Rage", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Warehouse Tabby", "Rat 1-1 Cant Block", "Monster Role"], "graveyard_has": ["Monstrous Rage"] }, {} ], "attached": { "Monster Role": "Grizzly Bears" } } },
 { "name": "ruling: an Aura that dies together with Warehouse Tabby from damage does not trigger it",
   "players": [ { "hand": ["Holy Strength", "Lightning Bolt"], "battlefield": ["Plains", "Mountain", "Warehouse Tabby"] }, {} ],
   "steps": [ { "cast": "Holy Strength", "targets": ["Warehouse Tabby"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Warehouse Tabby"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Warehouse Tabby", "Holy Strength", "Lightning Bolt"], "battlefield_lacks": ["Rat 1-1 Cant Block"] }, {} ] } },
 { "name": "ruling: an Aura destroyed by the same effect that destroys Warehouse Tabby still triggers it",
   "players": [ { "hand": ["Holy Strength", "Akroma's Vengeance"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Warehouse Tabby"] }, {} ],
   "steps": [ { "cast": "Holy Strength", "targets": ["Warehouse Tabby"] }, { "resolve": true },
              { "cast": "Akroma's Vengeance" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Rat 1-1 Cant Block"], "graveyard_has": ["Warehouse Tabby", "Holy Strength"] }, {} ] } }
