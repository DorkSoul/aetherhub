[
  {
    "name": "becoming tapped drains 1: opponent loses 1, you gain 1",
    "players": [
      { "battlefield": ["Night Market Lookout"] },
      {}
    ],
    "steps": [
      { "attack": [{ "card": "Night Market Lookout", "at": "p1" }] },
      { "block": [] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "life": 21 }, { "life": 18 }]
    }
  },
  {
    "name": "ruling: tapped by another effect (Icy Manipulator) triggers the drain",
    "players": [
      { "battlefield": ["Night Market Lookout", "Icy Manipulator", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Icy Manipulator", "ability": 0, "targets": ["Night Market Lookout"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 21 }, { "life": 19 }],
      "tapped": { "Night Market Lookout": true }
    }
  },
  {
    "name": "ruling: an already tapped Lookout tapped again does not trigger",
    "players": [
      { "battlefield": [{ "name": "Night Market Lookout", "tapped": true }, "Icy Manipulator", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Icy Manipulator", "ability": 0, "targets": ["Night Market Lookout"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 20 }, { "life": 20 }],
      "tapped": { "Night Market Lookout": true }
    }
  }
]
