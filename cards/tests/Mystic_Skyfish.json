[
  {
    "name": "gains flying when its controller draws a second card in a turn",
    "players": [ { "hand": ["Divination"], "battlefield": ["Mystic Skyfish", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true }, { "resolve": true } ],
    "expect": { "keywords": { "Mystic Skyfish": ["Flying"] }, "players": [ { "hand_count": 2 }, {} ] }
  },
  {
    "name": "one draw alone does not give flying",
    "players": [ { "hand": ["Mystic Skyfish"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Mystic Skyfish" }, { "resolve": true }, { "advance_to": "Main1", "player": 1 } ],
    "expect": { "pt": { "Mystic Skyfish": [3, 1] }, "players": [ { "hand_count": 0 }, {} ] }
  },
  {
    "name": "flying wears off at end of turn",
    "players": [ { "hand": ["Divination"], "battlefield": ["Mystic Skyfish", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Divination" }, { "resolve": true }, { "resolve": true }, { "advance_to": "Main1", "player": 1 } ],
    "expect": { "pt": { "Mystic Skyfish": [3, 1] } }
  },
  {
    "name": "ruling: a card returned to hand by Regrowth is not drawn, so no flying",
    "players": [ { "hand": ["Regrowth"], "battlefield": ["Mystic Skyfish", "Forest", "Forest"], "graveyard": ["Hill Giant"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Regrowth", "targets": ["Hill Giant"] }, { "resolve": true },
      { "attack": [ { "card": "Mystic Skyfish", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Mystic Skyfish" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 1 }, { "life": 20 } ] }
  }
]
