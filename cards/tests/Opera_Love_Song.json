[
  { "name": "mode 1 exiles the top two cards to play this turn (cast on your turn)",
    "players": [ { "hand": ["Opera Love Song"], "battlefield": ["Mountain", "Mountain"], "library": ["Forest", "Island", "Plains"] }, {} ],
    "steps": [ { "cast": "Opera Love Song", "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Forest", "Island"], "library_count": 1 } ] } },
  { "name": "mode 2 gives one target creature +2/+0 (two targets, the second is the opponent's)",
    "players": [ { "hand": ["Opera Love Song"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Opera Love Song", "answers": [1], "targets": ["Grizzly Bears", "Hill Giant"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 2], "Hill Giant": [5, 3] } } },
  { "name": "ruling: an exiled land can be played in your main phase when a land play is still available",
    "players": [ { "hand": ["Opera Love Song"], "battlefield": ["Mountain", "Mountain"], "library": ["Forest", "Island", "Plains"] }, {} ],
    "steps": [ { "cast": "Opera Love Song", "answers": [0] }, { "resolve": true }, { "play_land": "Forest" } ],
    "expect": { "players": [ { "battlefield_has": ["Forest"], "exile": ["Island"] }, {} ] } },
  { "name": "ruling: an exiled land cannot be played once a land was already played this turn",
    "players": [ { "hand": ["Opera Love Song", "Plains"], "battlefield": ["Mountain", "Mountain"], "library": ["Forest", "Island", "Plains"] }, {} ],
    "steps": [ { "play_land": "Plains" }, { "cast": "Opera Love Song", "answers": [0] }, { "resolve": true }, { "play_land": "Forest", "illegal": true } ],
    "expect": { "players": [ { "exile": ["Forest", "Island"], "battlefield_has": ["Plains"] }, {} ] } }
