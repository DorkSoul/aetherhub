[
  {
    "name": "after activation a non-Wall creature can't block it",
    "players": [
      { "battlefield": ["Varchild's Crusader", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Varchild's Crusader", "ability": 0 },
      { "resolve": true },
      { "attack": [{ "card": "Varchild's Crusader", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Varchild's Crusader" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{}, { "life": 17 }] }
  },
  {
    "name": "after activation a Wall can still block it",
    "players": [
      { "battlefield": ["Varchild's Crusader", "Mountain"] },
      { "battlefield": ["Wall 0-3"] }
    ],
    "steps": [
      { "activate": "Varchild's Crusader", "ability": 0 },
      { "resolve": true },
      { "attack": [{ "card": "Varchild's Crusader", "at": "p1" }] },
      { "block": [{ "blocker": "Wall 0-3", "attacker": "Varchild's Crusader" }] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Varchild's Crusader"] }, { "life": 20 }] }
  },
  {
    "name": "sacrificed at the beginning of the next end step",
    "players": [
      { "battlefield": ["Varchild's Crusader", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Varchild's Crusader", "ability": 0 },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "graveyard": ["Varchild's Crusader"] }, {}] }
  }
]
