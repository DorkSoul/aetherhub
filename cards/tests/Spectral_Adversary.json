    "steps": [ { "cast": "Spectral Adversary" }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Adversary"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Spectral Adversary": [2, 1] } } },
  { "name": "paying once: +1/+1 counter and one other creature phases out",
