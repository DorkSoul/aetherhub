    "steps": [ { "cast": "Spectral Adversary" }, { "resolve": true, "answers": [true, 1, ["Grizzly Bears"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Adversary"] }, { "battlefield_lacks": ["Grizzly Bears"] } ], "pt": { "Spectral Adversary": [3, 2] } } },
  { "name": "paying twice: two counters and up to two other permanents phase out",
    "players": [ { "hand": ["Spectral Adversary"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Spectral Adversary" }, { "resolve": true, "answers": [true, 2, ["Grizzly Bears", "Hill Giant"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Adversary"] }, { "battlefield_lacks": ["Grizzly Bears", "Hill Giant"] } ], "pt": { "Spectral Adversary": [4, 3] } } },
  { "name": "paying once with no other legal target: counter only, the creature itself is never chosen",
    "players": [ { "hand": ["Spectral Adversary"], "battlefield": ["Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Spectral Adversary" }, { "resolve": true, "answers": [true, 1] } ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Adversary"] }, {} ], "pt": { "Spectral Adversary": [3, 2] } } },
  { "name": "ruling: a creature that phases out while attacking is removed from combat",
    "players": [ { "hand": ["Spectral Adversary"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "cast": "Spectral Adversary" }, { "resolve": true, "answers": [true, 1, ["Grizzly Bears"]] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Spectral Adversary"], "battlefield_lacks": ["Grizzly Bears"] }, { "life": 20 } ] } },
