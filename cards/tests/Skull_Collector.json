[
  {
    "name": "upkeep: returns the only black creature you control to hand",
    "players": [
      {
        "battlefield": [
          "Skull Collector"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "battlefield_lacks": [
            "Skull Collector"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "upkeep: you choose which black creature to return",
    "players": [
      {
        "battlefield": [
          "Skull Collector",
          "Skulking Knight"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          "Skulking Knight"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Skull Collector"
          ],
          "battlefield_lacks": [
            "Skulking Knight"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "regenerate {1}{B}: a lethal Bolt is replaced by regeneration (tapped, survives)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Skull Collector", "Swamp", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Skull Collector", "ability": 0 },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Skull Collector"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Skull Collector"], "graveyard": ["Lightning Bolt"] }, {} ],
      "tapped": { "Skull Collector": true }
    }
  },
  {
    "name": "regenerate needs a black mana",
    "players": [
      { "battlefield": ["Skull Collector", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Skull Collector", "ability": 0, "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Skull Collector"] }, {} ] }
  }
]
