[
  {
    "name": "survival: tapped, no Glimmer -> Glimmer token",
    "players": [
      {
        "battlefield": [
          {
            "name": "Glimmer Seeker",
            "sick": false,
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Glimmer Seeker",
            "Glimmer 1-1"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "survival: tapped with a Glimmer -> draw a card",
    "players": [
      {
        "battlefield": [
          {
            "name": "Glimmer Seeker",
            "sick": false,
            "tapped": true
          },
          {
            "name": "Glimmer 1-1",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "survival: untapped does nothing",
    "players": [
      {
        "battlefield": [
          {
            "name": "Glimmer Seeker",
            "sick": false
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Glimmer 1-1"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: survival uses the creature's tapped status as it last was on the battlefield",
    "players": [
      { "battlefield": [ { "name": "Glimmer Seeker", "sick": false, "tapped": true } ] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Glimmer Seeker"], "player": 1 },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Glimmer 1-1"], "battlefield_lacks": ["Glimmer Seeker"], "graveyard": ["Glimmer Seeker"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
