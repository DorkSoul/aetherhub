[
  {
    "name": "prevents noncombat damage to your creature: Shock does nothing",
    "players": [
      {
        "battlefield": ["Mark of Asylum", "Grizzly Bears"]
      },
      {
        "hand": ["Shock"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mark of Asylum", "Grizzly Bears"] },
        { "graveyard": ["Shock"] }
      ]
    }
  },
  {
    "name": "does not prevent noncombat damage to an opponent's creature: Shock kills it",
    "players": [
      {
        "hand": ["Shock"],
        "battlefield": ["Mark of Asylum", "Mountain"]
      },
      {
        "battlefield": ["Grizzly Bears"]
      }
    ],
    "steps": [
      { "cast": "Shock", "targets": ["Grizzly Bears"] },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Shock"] },
        { "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: combat damage is not noncombat damage, so Mark of Asylum does not prevent combat damage to your creature",
    "players": [
      { "battlefield": ["Mark of Asylum", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Grizzly Bears"], "battlefield_has": ["Mark of Asylum"] }, { "battlefield_has": ["Hill Giant"] } ]
    }
  }
]
