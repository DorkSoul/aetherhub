[
  {
    "name": "returns from graveyard to hand for 1RRR",
    "players": [
      { "graveyard": ["Firewing Phoenix"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Firewing Phoenix" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "hand": ["Firewing Phoenix"], "graveyard": [] }, {}]
    }
  },
  {
    "name": "three mana is not enough",
    "players": [
      { "graveyard": ["Firewing Phoenix"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Firewing Phoenix", "illegal": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Firewing Phoenix"] }, {}]
    }
  },
  {
    "name": "ruling: ability works only from the graveyard, not on the battlefield",
    "players": [
      { "battlefield": ["Firewing Phoenix", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Firewing Phoenix", "illegal": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Firewing Phoenix"] }, {}]
    }
  }
]
