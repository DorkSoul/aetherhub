[
  {
    "name": "controller pays G: each player takes 1 and the flying Efreet takes 1",
    "players": [ { "hand": ["Ifh-Bíff Efreet"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Ifh-Bíff Efreet" },
      { "resolve": true },
      { "activate": "Ifh-Bíff Efreet", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 19, "battlefield_has": ["Ifh-Bíff Efreet"] }, { "life": 19 } ]
    }
  },
  {
    "name": "the opponent may activate it too (any player may activate)",
    "players": [ { "battlefield": ["Ifh-Bíff Efreet"] }, { "battlefield": ["Forest"] } ],
    "steps": [
      { "pass": true },
      { "activate": "Ifh-Bíff Efreet", "player": 1, "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 19, "battlefield_has": ["Ifh-Bíff Efreet"] }, { "life": 19 } ]
    }
  },
  {
    "name": "needs a green mana: without a Forest it can't be activated",
    "players": [ { "battlefield": ["Ifh-Bíff Efreet", "Mountain"] }, {} ],
    "steps": [ { "activate": "Ifh-Bíff Efreet", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] }
  }
]
