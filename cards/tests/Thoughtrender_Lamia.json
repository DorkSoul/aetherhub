[
  {
    "name": "entering itself makes each opponent discard a card",
    "players": [
      { "hand": ["Thoughtrender Lamia"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Thoughtrender Lamia" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Thoughtrender Lamia"] }, { "graveyard_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "another enchantment entering makes each opponent discard",
    "players": [
      { "hand": ["Bad Moon"], "battlefield": ["Thoughtrender Lamia", "Swamp", "Swamp"] },
      { "hand": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Bad Moon" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Thoughtrender Lamia", "Bad Moon"] }, { "graveyard_has": ["Grizzly Bears"] }]
    }
  },
  {
    "name": "a creature entering does not trigger constellation",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Thoughtrender Lamia", "Forest", "Forest"] },
      { "hand": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "hand": ["Hill Giant"] }]
    }
  },
  {
    "name": "ruling: an Aura whose target is gone fizzles, so no constellation trigger",
    "players": [ { "hand": ["Unholy Indenture"], "battlefield": ["Thoughtrender Lamia", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt", "Hill Giant"], "battlefield": ["Grizzly Bears", "Mountain"] } ],
    "steps": [ { "cast": "Unholy Indenture", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Thoughtrender Lamia"], "graveyard_has": ["Unholy Indenture"] }, { "hand": ["Hill Giant"] } ] }
  },
  {
    "name": "ruling: a second Thoughtrender Lamia entering also triggers the Lamia on the battlefield (two discards)",
    "players": [ { "hand": ["Thoughtrender Lamia"], "battlefield": ["Thoughtrender Lamia", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "cast": "Thoughtrender Lamia" }, { "resolve": true, "answers": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Thoughtrender Lamia"] }, { "hand_count": 0, "graveyard_has": ["Grizzly Bears", "Hill Giant"] } ] }
  }
]
