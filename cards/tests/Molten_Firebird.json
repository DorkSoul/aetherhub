[
  {
    "name": "dies: returns to the battlefield at the beginning of the next end step",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Molten Firebird"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Molten Firebird"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Molten Firebird"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "dies: its controller skips the next draw step",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Molten Firebird"
        ],
        "library": [
          "Island",
          "Island",
          "Island"
        ]
      },
      {
        "library": [
          "Island",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Molten Firebird"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End",
        "auto": true
      },
      {
        "advance_to": "End",
        "auto": true
      },
      {
        "advance_to": "Main1",
        "auto": true
      }
    ],
    "expect": {
      "turn": 3,
      "players": [
        {
          "hand_count": 0
        },
        {}
      ]
    }
  },
  {
    "name": "without dying the controller draws normally on the next turn",
    "players": [
      {
        "library": [
          "Island",
          "Island",
          "Island"
        ],
        "battlefield": [
          "Molten Firebird"
        ]
      },
      {
        "library": [
          "Island",
          "Island",
          "Island"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "End",
        "auto": true
      },
      {
        "advance_to": "End",
        "auto": true
      },
      {
        "advance_to": "Main1",
        "auto": true
      }
    ],
    "expect": {
      "turn": 3,
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "{4}{R}: exile it, and it does not return",
    "players": [
      {
        "battlefield": [
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Mountain",
          "Molten Firebird"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Molten Firebird"
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Molten Firebird"
          ],
          "exile": [
            "Molten Firebird"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the exile ability can't be activated from the graveyard after the Firebird died",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Molten Firebird"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Molten Firebird"] },
      { "resolve": true },
      { "activate": "Molten Firebird", "illegal": true }
    ],
    "expect": { "players": [ { "graveyard_has": ["Molten Firebird"] }, {} ] }
  }
]