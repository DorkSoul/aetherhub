[
  {
    "name": "X equals the cards in the opponent's hand",
    "players": [ { "library": ["Forest"], "battlefield": ["Bargaining Table", "Island", "Island", "Island"] }, { "hand": ["Forest", "Island"] } ],
    "steps": [ { "activate": "Bargaining Table" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"] }, {} ] }
  },
  {
    "name": "X = 0 costs nothing",
    "players": [ { "library": ["Forest"], "battlefield": ["Bargaining Table"] }, {} ],
    "steps": [ { "activate": "Bargaining Table" }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"] }, {} ] }
  },
  {
    "name": "ruling: X is the opponent's hand size, not the controller's",
    "players": [
      { "hand": ["Forest", "Island", "Grizzly Bears"], "library": ["Forest"], "battlefield": ["Bargaining Table", "Island"] },
      { "hand": ["Forest"] }
    ],
    "steps": [ { "activate": "Bargaining Table" }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 4 }, { "hand_count": 1 } ] }
  }
]
