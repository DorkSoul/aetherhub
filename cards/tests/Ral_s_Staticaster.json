[
 {
  "name": "attacking with a Ral planeswalker out gets +1/+0 per card in hand",
  "players": [
   { "hand": ["Island", "Island"], "battlefield": ["Ral's Staticaster", "Ral, Caller of Storms"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Ral's Staticaster", "at": "p1" } ] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Ral's Staticaster": [5, 3] }
  }
 },
 {
  "name": "without a Ral planeswalker it does not get bigger",
  "players": [
   { "hand": ["Island", "Island"], "battlefield": ["Ral's Staticaster"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Ral's Staticaster", "at": "p1" } ] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Ral's Staticaster": [3, 3] }
  }
 },
 {
  "name": "trigger power is set on resolution and does not shrink when the hand later empties",
  "players": [
   { "hand": ["Island", "Island"], "battlefield": ["Ral's Staticaster", "Ral, Caller of Storms"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Ral's Staticaster", "at": "p1" } ] },
   { "resolve": true },
   { "block": [] },
   { "advance_to": "Main2" },
   { "play_land": "Island" }
  ],
  "expect": {
   "pt": { "Ral's Staticaster": [5, 3] },
   "players": [ { "hand": ["Island"] }, {} ]
  }
 },
 {
  "name": "ruling: losing the Ral planeswalker after the trigger resolves keeps the bonus",
  "players": [
   { "hand": ["Vindicate", "Island", "Island"], "battlefield": ["Ral's Staticaster", "Ral, Caller of Storms", "Plains", "Swamp", "Swamp"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Ral's Staticaster", "at": "p1" } ] },
   { "resolve": true },
   { "block": [] },
   { "advance_to": "Main2" },
   { "cast": "Vindicate", "targets": ["Ral, Caller of Storms"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Ral's Staticaster": [6, 3] },
   "players": [ { "graveyard_has": ["Ral, Caller of Storms"] }, {} ]
  }
 }
]
