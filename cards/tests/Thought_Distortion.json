[
 { "name": "exiles noncreature nonland cards from the opponent's hand and graveyard",
   "players": [ { "hand": ["Thought Distortion"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Lightning Bolt", "Grizzly Bears", "Plains"], "graveyard": ["Shock"] } ],
   "steps": [ { "cast": "Thought Distortion", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Thought Distortion"] }, { "hand_count": 2, "graveyard": [], "exile": ["Lightning Bolt", "Shock"] } ] } },
 { "name": "creature cards in the opponent's graveyard are not exiled",
   "players": [ { "hand": ["Thought Distortion"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains", "Plains", "Plains"] }, { "graveyard": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Thought Distortion", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "graveyard": ["Grizzly Bears"], "exile": [] } ] } },
 { "name": "can't be countered: opponent's Counterspell fails, Bolt is exiled from their hand",
   "players": [ { "hand": ["Thought Distortion"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Counterspell", "Lightning Bolt"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Thought Distortion", "targets": ["p1"] }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{"stack": "Thought Distortion"}] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Thought Distortion"] }, { "exile": ["Counterspell", "Lightning Bolt"], "graveyard": [] } ] } },
 { "name": "ruling: target opponent gains hexproof in response, so Thought Distortion does nothing and goes to the graveyard even though it can't be countered",
   "players": [ { "hand": ["Thought Distortion"], "battlefield": ["Swamp", "Swamp", "Plains", "Plains", "Plains", "Plains"] }, { "hand": ["Dawn's Truce", "Lightning Bolt"], "battlefield": ["Plains", "Plains"], "graveyard": ["Shock"] } ],
   "steps": [ { "cast": "Thought Distortion", "targets": ["p1"] }, { "pass": true }, { "cast": "Dawn's Truce", "player": 1, "answers": [false] }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Thought Distortion"] }, { "hand_count": 1, "exile": [], "graveyard_has": ["Shock"], "life": 20 } ] } }
