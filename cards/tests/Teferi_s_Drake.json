[
  {
    "name": "still on the battlefield during the opponent's turn",
    "players": [ { "battlefield": ["Teferi's Drake"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "battlefield_has": ["Teferi's Drake"] }, {} ] }
  },
  {
    "name": "phases out before its controller's untap step",
    "players": [ { "battlefield": ["Teferi's Drake"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "battlefield_lacks": ["Teferi's Drake"] }, {} ] }
  },
  {
    "name": "phases back in at the untap step after that",
    "players": [ { "battlefield": ["Teferi's Drake"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "battlefield_has": ["Teferi's Drake"] }, {} ] }
  }
]
