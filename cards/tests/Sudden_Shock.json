 {
  "name": "ruling: a spell cast in response to a spell without split second is legal",
  "players": [
   { "hand": ["Lightning Bolt", "Sudden Shock"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "cast": "Sudden Shock", "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 0 }, { "life": 15 } ]
  }
 },
 {
  "name": "ruling: while Sudden Shock is on the stack, Lightning Bolt cannot be cast",
  "players": [
   { "hand": ["Sudden Shock", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Sudden Shock", "targets": ["p1"] },
   { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand": ["Lightning Bolt"] }, { "life": 18 } ]
  }
 },
 {
  "name": "ruling: a Glademuse trigger still triggers while Sudden Shock is on the stack",
  "players": [
   { "battlefield": ["Glademuse"] },
   { "hand": ["Sudden Shock"], "battlefield": ["Mountain", "Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Sudden Shock", "targets": ["p0"], "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "life": 18 }, { "hand_count": 1 } ]
  }
 }
]
