 {
  "name": "ruling: raid counts any attack, however many creatures attacked",
  "players": [
   { "hand": ["Storm Fleet Pyromancer"], "battlefield": ["Grizzly Bears", "Serra Angel", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Serra Angel", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" },
   { "cast": "Storm Fleet Pyromancer" },
   { "resolve": true, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Storm Fleet Pyromancer"] },
    { "life": 12 }
   ]
  }
 },
 {
  "name": "ruling: raid still counts after the attacking creature has died",
  "players": [
   { "hand": ["Storm Fleet Pyromancer", "Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "cast": "Storm Fleet Pyromancer" },
   { "resolve": true, "targets": ["p1"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Storm Fleet Pyromancer"], "graveyard_has": ["Lightning Bolt", "Grizzly Bears"] },
    { "life": 16 }
   ]
  }
