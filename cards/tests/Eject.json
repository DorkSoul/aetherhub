[
  {
    "name": "returns a nonland permanent and draws a card",
    "players": [ { "hand": ["Eject"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Eject", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Eject"], "hand_count": 1 }, { "hand": ["Grizzly Bears"], "battlefield": [] } ] }
  },
  {
    "name": "no nonland permanent to target: cannot cast",
    "players": [ { "hand": ["Eject"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "cast": "Eject", "targets": ["Forest"], "illegal": true } ],
    "expect": {}
  },
  {
    "name": "ruling: the target is gone when Eject resolves, so it does nothing and draws no card",
    "players": [ { "hand": ["Eject"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Eject", "targets": ["Grizzly Bears"] }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Eject"], "hand_count": 0 }, { "graveyard_has": ["Lightning Bolt", "Grizzly Bears"] } ] }
  }
]
