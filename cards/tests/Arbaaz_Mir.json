[
 {
  "name": "its own enters trigger deals 1 to each opponent and gains you 1",
  "players": [ { "hand": ["Arbaaz Mir"], "battlefield": ["Mountain", "Plains"] }, {} ],
  "steps": [ { "cast": "Arbaaz Mir" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 21 }, { "life": 19 } ] }
 },
 {
  "name": "another nontoken artifact entering triggers it",
  "players": [ { "hand": ["Sol Ring"], "battlefield": ["Mountain", "Arbaaz Mir"] }, {} ],
  "steps": [ { "cast": "Sol Ring" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 21, "battlefield_has": ["Sol Ring"] }, { "life": 19 } ] }
 },
 {
  "name": "a nonhistoric creature entering does not trigger it",
  "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Arbaaz Mir"] }, {} ],
  "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 20 }, { "life": 20 } ] }
 },
 {
  "name": "ruling: a legendary artifact is historic once, so it triggers Arbaaz Mir exactly once",
  "players": [ { "hand": ["The One Ring"], "battlefield": ["Arbaaz Mir", "Plains", "Plains", "Plains", "Plains"] }, {} ],
  "steps": [ { "cast": "The One Ring" }, { "resolve": true } ],
  "expect": { "players": [ { "life": 21, "battlefield_has": ["The One Ring"] }, { "life": 19 } ] }
 }
]
