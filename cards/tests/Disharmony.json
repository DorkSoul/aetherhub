[
 { "name": "during declare attackers, steals the attacking Hill Giant: it leaves combat and deals no damage",
   "players": [ { "battlefield": ["Hill Giant"] }, { "hand": ["Disharmony"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "pass": true },
              { "cast": "Disharmony", "player": 1, "targets": ["Hill Giant"] },
              { "resolve": true },
              { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 20, "battlefield_has": ["Hill Giant"] } ] } },
 { "name": "outside combat it cannot be cast",
   "players": [ { "hand": ["Disharmony"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Hill Giant"] } ],
   "steps": [ { "cast": "Disharmony", "illegal": true } ],
   "expect": { "players": [ {}, {} ] } },
 { "name": "after the declare attackers step it can no longer be cast (end of combat): illegal",
   "players": [ { "battlefield": ["Hill Giant"] }, { "hand": ["Disharmony"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] }, { "advance_to": "EndCombat" }, { "pass": true }, { "cast": "Disharmony", "player": 1, "targets": ["Hill Giant"], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 17 } ] } },
 { "name": "ruling: the attacking creature untaps before you gain control of it",
   "players": [ { "battlefield": ["Hill Giant"] }, { "hand": ["Disharmony"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "pass": true },
              { "cast": "Disharmony", "player": 1, "targets": ["Hill Giant"] },
              { "resolve": true },
              { "resolve": true } ],
   "expect": { "players": [ {}, { "life": 20, "battlefield_has": ["Hill Giant"] } ], "tapped": { "Hill Giant": false } } },
 { "name": "ruling: can target a creature you control, which leaves combat and deals no damage",
   "players": [ { "hand": ["Disharmony"], "battlefield": ["Mountain", "Mountain", "Mountain", "Hill Giant"] }, {} ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
              { "cast": "Disharmony", "targets": ["Hill Giant"] },
              { "resolve": true },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Hill Giant"] }, { "life": 20 } ] } },
 { "name": "ruling: cast in the opponent's combat, the stolen attacker can then block another attacker",
   "players": [ { "battlefield": ["Hill Giant", "Savannah Lions"] }, { "hand": ["Disharmony"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
   "steps": [ { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
              { "pass": true },
              { "cast": "Disharmony", "player": 1, "targets": ["Hill Giant"] },
              { "resolve": true },
              { "resolve": true },
              { "block": [ { "blocker": "Hill Giant", "attacker": "Savannah Lions" } ], "player": 1 },
              { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard": ["Savannah Lions"] }, { "life": 20, "battlefield_has": ["Hill Giant"] } ] } }
]
