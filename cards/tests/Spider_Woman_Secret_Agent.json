[
  {
    "name": "ETB taps the opposing creature, which stays tapped through its controller's untap step",
    "players": [
      { "hand": ["Spider-Woman, Secret Agent"], "battlefield": ["Plains", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Spider-Woman, Secret Agent" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "turn": 2, "tapped": { "Grizzly Bears": true, "Spider-Woman, Secret Agent": false } }
  },
  {
    "name": "when Spider-Woman leaves, the creature untaps at its controller's next untap step",
    "players": [
      { "hand": ["Spider-Woman, Secret Agent"], "battlefield": ["Plains", "Island", "Island", "Island"] },
      { "hand": ["Doom Blade"], "battlefield": ["Grizzly Bears", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "cast": "Spider-Woman, Secret Agent" },
      { "resolve": true },
      { "resolve": true },
      { "pass": true },
      { "cast": "Doom Blade", "player": 1, "targets": ["Spider-Woman, Secret Agent"] },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "turn": 2, "tapped": { "Grizzly Bears": false } }
  }
]
