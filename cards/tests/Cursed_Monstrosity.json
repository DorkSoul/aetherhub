[
  {
    "name": "sacrificed when targeted with no land to discard",
    "players": [
      { "hand": ["Brute Force"], "battlefield": ["Mountain"] },
      { "battlefield": ["Cursed Monstrosity"] }
    ],
    "steps": [
      { "cast": "Brute Force", "targets": ["Cursed Monstrosity"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard_has": ["Cursed Monstrosity"] } ]
    }
  },
  {
    "name": "survives when its controller discards a land",
    "players": [
      { "hand": ["Brute Force"], "battlefield": ["Mountain"] },
      { "hand": ["Forest"], "battlefield": ["Cursed Monstrosity"] }
    ],
    "steps": [
      { "cast": "Brute Force", "targets": ["Cursed Monstrosity"] },
      { "resolve": true, "answers": [true], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, { "battlefield_has": ["Cursed Monstrosity"], "graveyard_has": ["Forest"] } ]
    }
  }
]
