[
  { "name": "ETB: any number of Plains are exiled from the library, then shuffle",
    "players": [ { "hand": ["Endless Horizons"], "battlefield": ["Plains", "Plains", "Plains", "Plains"], "library": ["Plains", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Endless Horizons" }, { "resolve": true, "answers": [[0, 1]] } ],
    "expect": { "players": [ { "battlefield_has": ["Endless Horizons"], "exile": ["Plains", "Plains"], "library_count": 1 }, {} ] } },
  { "name": "ETB: choosing no Plains exiles nothing",
    "players": [ { "hand": ["Endless Horizons"], "battlefield": ["Plains", "Plains", "Plains", "Plains"], "library": ["Plains", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Endless Horizons" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "exile": [], "library_count": 3 }, {} ] } },
  { "name": "upkeep: you may put one card exiled with it into your hand",
    "players": [ { "hand": ["Endless Horizons"], "battlefield": ["Plains", "Plains", "Plains", "Plains"], "library": ["Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Endless Horizons" }, { "resolve": true, "answers": [[0]] },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [0] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Plains"], "exile": [] }, {} ] } },
  { "name": "ruling: Plains exiled by it stay exiled after it leaves the battlefield",
    "players": [ { "hand": ["Endless Horizons", "Naturalize"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Forest", "Forest", "Forest", "Forest"], "library": ["Plains", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Endless Horizons" }, { "resolve": true, "answers": [[0, 1]] }, { "cast": "Naturalize", "targets": ["Endless Horizons"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Endless Horizons"], "exile": ["Plains", "Plains"], "library_count": 1 }, {} ] } },
  { "name": "ruling: controller changed, the new controller's upkeep trigger does nothing (owner's Plains stay exiled)",
    "players": [ { "hand": ["Endless Horizons", "Donate"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Island", "Island", "Island", "Island"], "library": ["Plains", "Plains", "Island"] }, {} ],
    "steps": [ { "cast": "Endless Horizons" }, { "resolve": true, "answers": [[0, 1]] }, { "cast": "Donate", "targets": ["p1", "Endless Horizons"] }, { "resolve": true }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Endless Horizons"], "exile": ["Plains", "Plains"], "hand_count": 0 }, { "battlefield_has": ["Endless Horizons"], "hand_count": 0 } ] } }
]
