[
  {
    "name": "flash: exiles a tapped opposing creature until Seal Away leaves",
    "players": [
      { "hand": ["Seal Away"], "battlefield": ["Plains", "Island"] },
      { "battlefield": [{ "name": "Grizzly Bears", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Seal Away" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "exile": ["Grizzly Bears"], "battlefield": [] }] }
  },
  {
    "name": "an untapped creature is not a legal target: nothing is exiled",
    "players": [
      { "hand": ["Seal Away"], "battlefield": ["Plains", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Seal Away" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "battlefield": ["Grizzly Bears"] }] }
  },
  {
    "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard",
    "players": [
      { "hand": ["Pacifism", "Seal Away"], "battlefield": ["Plains", "Plains", "Island", "Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [
      { "cast": "Pacifism", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Seal Away" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Pacifism"], "battlefield_has": ["Seal Away"] },
        { "exile": ["Grizzly Bears"] }
      ]
    }
  }
]
