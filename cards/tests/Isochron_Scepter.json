  {
    "name": "ruling: declining the copy means no copy is cast (the exiled card stays exiled)",
    "players": [
      {
        "hand": ["Isochron Scepter", "Lightning Bolt"],
        "battlefield": ["Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Isochron Scepter" },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "activate": "Isochron Scepter" },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "exile": ["Lightning Bolt"], "hand": [], "graveyard": [] },
        { "life": 20 }
      ],
      "tapped": { "Isochron Scepter": true }
    }
  },
  {
    "name": "ruling: the copy of an {X} spell is cast with X = 0 (Blazing Shoal gives +0/+0)",
    "players": [
      {
        "hand": ["Isochron Scepter", "Blazing Shoal"],
        "battlefield": ["Island", "Island", "Island", "Island"]
      },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Isochron Scepter" },
      { "resolve": true, "answers": ["Blazing Shoal"] },
      { "activate": "Isochron Scepter" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [
        { "exile": ["Blazing Shoal"] },
        {}
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "ruling: Scepter bounced in response to its ability: the copy is still made",
    "players": [
      {
        "hand": ["Isochron Scepter", "Lightning Bolt"],
        "battlefield": ["Island", "Island", "Island", "Island"]
      },
      {
        "hand": ["Into the Roil"],
        "battlefield": ["Island", "Island"]
      }
    ],
    "steps": [
      { "cast": "Isochron Scepter" },
      { "resolve": true, "answers": ["Lightning Bolt"] },
      { "activate": "Isochron Scepter" },
      { "pass": true },
      { "cast": "Into the Roil", "player": 1, "targets": ["Isochron Scepter"] },
      { "resolve": true, "answers": [true, "p1"] }
    ],
    "expect": {
      "players": [
        { "hand": ["Isochron Scepter"], "exile": ["Lightning Bolt"] },
        { "life": 17 }
      ]
    }
  }
