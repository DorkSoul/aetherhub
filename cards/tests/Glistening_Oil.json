  {
    "name": "your upkeep puts a -1/-1 counter on the enchanted creature",
    "players": [
      { "hand": ["Glistening Oil"], "battlefield": ["Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Glistening Oil", "targets": ["Grizzly Bears"] },
