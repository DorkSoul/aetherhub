  {
    "name": "ruling: destroying the Oil itself (not the creature) still returns it to its owner's hand",
    "players": [
      { "hand": ["Glistening Oil"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears"] },
      { "hand": ["Naturalize"], "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [
      { "cast": "Glistening Oil", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Naturalize", "player": 1, "targets": ["Glistening Oil"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Glistening Oil"], "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Glistening Oil"] },
        { "graveyard": ["Naturalize"] }
      ]
    }
  },
  {
    "name": "ruling: the Oil's target is gone when it resolves: Oil goes to the graveyard, no entering, no return trigger",
    "players": [
      { "hand": ["Glistening Oil", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Glistening Oil", "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "resolve": true }
