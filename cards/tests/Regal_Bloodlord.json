[
 { "name": "end step after gaining life creates a Bat",
   "players": [ { "hand": ["Refreshing Rain"], "battlefield": ["Forest", "Regal Bloodlord"] }, { "battlefield": ["Swamp"] } ],
   "steps": [ { "cast": "Refreshing Rain", "targets": ["p0"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Regal Bloodlord", "Bat 1-1 Flying"] }, {} ] } },
 { "name": "no life gained this turn: no Bat",
   "players": [ { "battlefield": ["Regal Bloodlord"] }, {} ],
   "steps": [ { "advance_to": "End" } ],
   "expect": { "players": [ { "battlefield_lacks": ["Bat 1-1 Flying"] }, {} ] } },
 { "name": "ruling: life gained only during the end step does not create a Bat",
   "players": [ { "hand": ["Refreshing Rain"], "battlefield": ["Forest", "Regal Bloodlord"] }, { "battlefield": ["Swamp"] } ],
   "steps": [ { "advance_to": "End" }, { "cast": "Refreshing Rain", "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Bat 1-1 Flying"], "life": 26 }, {} ] } },
 { "name": "ruling: several life gains in one turn still make only one Bat",
   "players": [ { "hand": ["Refreshing Rain", "Refreshing Rain"], "battlefield": ["Forest", "Regal Bloodlord"] }, { "battlefield": ["Swamp"] } ],
   "steps": [ { "cast": "Refreshing Rain", "targets": ["p0"] }, { "resolve": true }, { "cast": "Refreshing Rain", "targets": ["p0"] }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield": ["Forest", "Regal Bloodlord", "Bat 1-1 Flying"], "life": 32 }, {} ] } },
 { "name": "ruling: life gained before Regal Bloodlord entered the battlefield still counts",
   "players": [ { "hand": ["Refreshing Rain", "Regal Bloodlord"], "battlefield": ["Forest", "Plains", "Swamp", "Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Swamp"] } ],
   "steps": [ { "cast": "Refreshing Rain", "targets": ["p0"], "alt": 0 }, { "resolve": true }, { "cast": "Regal Bloodlord" }, { "resolve": true }, { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Regal Bloodlord", "Bat 1-1 Flying"], "life": 26 }, {} ] } }
]
