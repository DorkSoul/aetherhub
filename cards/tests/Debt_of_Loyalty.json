[
 { "name": "regenerating the creature gives you control of it",
   "players": [ { "hand": ["Debt of Loyalty", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Debt of Loyalty", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Debt of Loyalty", "Lightning Bolt"] }, { "battlefield": [] } ], "tapped": { "Grizzly Bears": true } } },
 { "name": "if the shield is not used you do not gain control",
   "players": [ { "hand": ["Debt of Loyalty"], "battlefield": ["Plains", "Plains", "Plains"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Debt of Loyalty", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, { "battlefield": ["Grizzly Bears"] } ] } },
 { "name": "the creature without the shield is destroyed and stays with its owner",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 { "name": "regenerating your own creature keeps it",
   "players": [ { "hand": ["Debt of Loyalty", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Mountain", "Grizzly Bears"] },
                { } ],
   "steps": [ { "cast": "Debt of Loyalty", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield": [] } ], "tapped": { "Grizzly Bears": true } } },
 { "name": "ruling: the shield wears off at end of turn, so a later kill is not regenerated",
   "players": [ { "hand": ["Debt of Loyalty", "Lightning Bolt"], "battlefield": ["Plains", "Plains", "Plains", "Mountain"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Debt of Loyalty", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "advance_to": "Main2" }, { "advance_to": "Main1" },
              { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Debt of Loyalty", "Lightning Bolt"] }, { "graveyard_has": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] } ] } },
 { "name": "ruling: an indestructible creature never regenerates, so Debt of Loyalty does not take it",
   "players": [ { "hand": ["Debt of Loyalty", "Murder"], "battlefield": ["Plains", "Plains", "Plains", "Swamp", "Swamp", "Swamp"] },
                { "battlefield": ["Blightsteel Colossus"] } ],
   "steps": [ { "cast": "Debt of Loyalty", "targets": ["Blightsteel Colossus"] }, { "resolve": true },
              { "cast": "Murder", "targets": ["Blightsteel Colossus"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Debt of Loyalty", "Murder"], "battlefield_lacks": ["Blightsteel Colossus"] }, { "battlefield_has": ["Blightsteel Colossus"] } ] } }
]
