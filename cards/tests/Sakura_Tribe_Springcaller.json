[
 {
  "name": "upkeep adds G that is still in the pool in the second main phase",
  "players": [
   { "battlefield": [ { "name": "Sakura-Tribe Springcaller", "sick": false } ] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "pool": { "G": 1 } },
    {}
   ]
  }
 },
 {
  "name": "the upkeep mana is gone when the turn ends",
