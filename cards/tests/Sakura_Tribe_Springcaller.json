   { "battlefield": [ { "name": "Sakura-Tribe Springcaller", "sick": false } ] },
   {}
  ],
  "steps": [
   { "advance_to": "Upkeep" },
   { "advance_to": "Upkeep" },
   { "resolve": true },
   { "advance_to": "Main2" },
   { "advance_to": "Upkeep", "auto": true }
  ],
  "expect": {
   "turn": 4,
   "players": [
    { "pool": {} },
    {}
   ]
  }
 },
 {
  "name": "the trigger is only for your own upkeep: the opponent's upkeep adds nothing",
