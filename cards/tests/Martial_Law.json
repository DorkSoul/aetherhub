[
  {
    "name": "ruling: a detained creature cannot activate its abilities during the opponent's turn",
    "players": [
      { "battlefield": ["Martial Law", "Island"] },
      { "battlefield": ["Blind Seer", "Island", "Island"] }
    ],
    "start": "Untap",
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "activate": "Blind Seer", "ability": 0, "player": 1, "targets": ["Martial Law"], "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Martial Law"] }, { "battlefield_has": ["Blind Seer"] } ] }
  },
  {
    "name": "control: without Martial Law the same activation is legal",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Blind Seer", "Island", "Island"] }
    ],
    "start": "Untap",
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "activate": "Blind Seer", "ability": 0, "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_has": ["Blind Seer"] } ] }
  },
  {
    "name": "upkeep detain: the opposing Bears can't block Hill Giant",
    "players": [
      { "battlefield": ["Martial Law", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "start": "Untap",
    "steps": [
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "upkeep trigger with no opposing creature does nothing",
    "players": [
      { "battlefield": ["Martial Law", "Grizzly Bears"] },
      { "battlefield": ["Island"] }
    ],
    "start": "Untap",
    "steps": [
      { "advance_to": "Main1" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Martial Law", "Grizzly Bears"] }, {} ] }
  }
]
