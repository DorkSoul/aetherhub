[
  {
    "name": "untapped Thunderstaff prevents 1 combat damage to its controller",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Thunderstaff"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 18 }
      ]
    }
  },
  {
    "name": "pumping attackers taps Thunderstaff, so its prevention no longer applies",
    "players": [
      { "battlefield": ["Hill Giant"] },
      { "battlefield": ["Thunderstaff", "Plains", "Plains"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "pass": true },
      { "activate": "Thunderstaff", "player": 1 },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 16 }
      ]
    }
  },
  {
    "name": "noncombat damage to its controller is not prevented",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Thunderstaff"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: an untapped Thunderstaff prevents 1 damage from each unblocked attacker",
    "players": [
      { "battlefield": ["Hill Giant", "Grizzly Bears"] },
      { "battlefield": ["Thunderstaff"] }
    ],
    "steps": [
      { "attack": [ { "card": "Hill Giant", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17 }
      ]
    }
  }
]
