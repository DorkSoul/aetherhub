[
  {
    "name": "attacks: gets a velocity counter at end of combat",
    "players": [
      {
        "battlefield": [
          "Daredevil Dragster",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Daredevil Dragster",
        "ability": 0
      },
      {
        "resolve": true
      },
      {
        "attack": [
          {
            "card": "Daredevil Dragster",
            "at": "p1"
          }
        ]
      },
      {
        "block": []
      },
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield": [
            "Daredevil Dragster",
            "Grizzly Bears"
          ]
        },
        {
          "life": 16
        }
      ],
      "counters": {
        "Daredevil Dragster": {
          "velocity": 1
        }
