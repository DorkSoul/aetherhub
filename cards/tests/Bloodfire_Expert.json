[
  {
    "name": "prowess: noncreature spell gives +1/+1 until end of turn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Bloodfire Expert", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "pt": { "Bloodfire Expert": [4, 2] }, "players": [ {}, { "life": 17 } ] }
  },
  {
    "name": "creature spell does not trigger prowess",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": [ { "name": "Bloodfire Expert", "sick": false }, "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Bloodfire Expert": [3, 1] } }
  },
  {
    "name": "ruling: prowess resolves before the spell that caused it",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Bloodfire Expert", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": { "pt": { "Bloodfire Expert": [4, 2] }, "players": [ {}, { "life": 20 } ] }
  },
  {
    "name": "ruling: playing a land does not trigger prowess",
    "players": [
      { "hand": ["Mountain"], "battlefield": [ { "name": "Bloodfire Expert", "sick": false } ] },
      {}
    ],
    "steps": [
      { "play_land": "Mountain" }
    ],
    "expect": { "pt": { "Bloodfire Expert": [3, 1] } }
  },
  {
    "name": "ruling: prowess still resolves after the spell that caused it is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [ { "name": "Bloodfire Expert", "sick": false }, "Mountain"], "library": ["Forest"] },
      { "hand": ["Spellshift"], "battlefield": ["Island", "Island", "Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Spellshift", "targets": [{ "stack": "Lightning Bolt" }], "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": { "pt": { "Bloodfire Expert": [4, 2] }, "players": [ { "graveyard": ["Lightning Bolt"] }, { "graveyard": ["Spellshift"] } ] }
  }
]
