[
 { "name": "prevents the next 3 damage to the target this turn",
   "players": [ { "hand": ["Dawnfluke"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Dawnfluke" }, { "resolve": true, "targets": ["p0"] }, { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "battlefield_has": ["Dawnfluke"] }, { "graveyard": ["Lightning Bolt"] } ] } },
 { "name": "evoked: sacrificed when it enters",
   "players": [ { "hand": ["Dawnfluke"], "battlefield": ["Plains"] }, {} ],
   "steps": [ { "cast": "Dawnfluke", "alt": 0 }, { "resolve": true, "targets": ["p0"] } ],
   "expect": { "players": [ { "graveyard": ["Dawnfluke"], "battlefield_lacks": ["Dawnfluke"] }, {} ] } },
 { "name": "ruling: the evoke prevention still applies after Dawnfluke is sacrificed",
   "players": [ { "hand": ["Dawnfluke"], "battlefield": ["Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Dawnfluke", "alt": 0 }, { "resolve": true, "targets": ["p0"] }, { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20, "graveyard": ["Dawnfluke"] }, { "graveyard": ["Lightning Bolt"] } ] } }
]
