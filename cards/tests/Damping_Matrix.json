[
 {
  "name": "creature activated abilities cannot be activated",
  "players": [
   { "hand": [], "battlefield": ["Damping Matrix", "Mountain", "Mountain", "Mountain", { "name": "Bold Impaler", "sick": false }] },
   {}
  ],
  "steps": [
   { "activate": "Bold Impaler", "ability": 0, "illegal": true }
  ],
  "expect": {
   "pt": { "Bold Impaler": [1, 2] }
  }
 },
 {
  "name": "ruling: triggered abilities of creatures are unaffected",
  "players": [
   { "hand": ["Atraxi Warden"], "battlefield": ["Damping Matrix", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
   { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
  ],
  "steps": [
   { "cast": "Atraxi Warden" },
   { "resolve": true, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ {}, { "exile": ["Grizzly Bears"] } ]
  }
 },
 {
  "name": "ruling: mana abilities are not affected",
  "players": [
   { "hand": ["Grizzly Bears"], "battlefield": ["Damping Matrix", { "name": "Llanowar Elves", "sick": false }, "Forest"] },
   {}
  ],
  "steps": [
   { "cast": "Grizzly Bears" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears", "Llanowar Elves"] }, {} ]
  }
 },
 {
  "name": "ruling: equip is an activated ability, so Damping Matrix stops equipping",
  "players": [
   { "battlefield": ["Damping Matrix", "Bonesplitter", { "name": "Grizzly Bears", "sick": false }, "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [2, 2] }
  }
 },
 {
  "name": "control: equip works without Damping Matrix",
  "players": [
   { "battlefield": ["Bonesplitter", { "name": "Grizzly Bears", "sick": false }, "Mountain"] },
   {}
  ],
  "steps": [
   { "activate": "Bonesplitter", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [4, 2] }
  }
 }
]
