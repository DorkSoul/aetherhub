[
  { "name": "gets +2/+0 when you cast a noncreature spell",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Slickshot Show-Off"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "pt": { "Slickshot Show-Off": [3, 2] }, "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 17 } ] } },
  { "name": "creature spells do not trigger it",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Slickshot Show-Off"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "pt": { "Slickshot Show-Off": [1, 2] } } },
  { "name": "plot pays {1}{R} from hand, then cast free on a later turn",
    "players": [ { "hand": ["Slickshot Show-Off"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Slickshot Show-Off", "ability": 0 }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "cast": "Slickshot Show-Off", "alt": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Slickshot Show-Off"] }, {} ] } },
  { "name": "plotted card cannot be cast on the turn it was plotted",
    "players": [ { "hand": ["Slickshot Show-Off"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Slickshot Show-Off", "ability": 0 }, { "resolve": true },
               { "cast": "Slickshot Show-Off", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Slickshot Show-Off"] }, {} ] } },
  { "name": "ruling: plot is only possible in a main phase, not during combat",
    "players": [ { "hand": ["Slickshot Show-Off"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "activate": "Slickshot Show-Off", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Slickshot Show-Off"] }, {} ] } },
  { "name": "ruling: a plotted card on a later turn still cannot be cast in combat",
    "players": [ { "hand": ["Slickshot Show-Off"], "battlefield": ["Mountain", "Mountain"] }, {} ],
    "steps": [ { "activate": "Slickshot Show-Off", "ability": 0 }, { "resolve": true },
               { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "advance_to": "Main1" },
               { "advance_to": "BeginCombat" },
               { "cast": "Slickshot Show-Off", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "exile": ["Slickshot Show-Off"] }, {} ] } }
]
