[
 { "name": "converge: three red mana, one counter",
   "players": [ { "hand": ["Magmablood Archaic"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Magmablood Archaic" }, { "resolve": true } ],
   "expect": { "pt": { "Magmablood Archaic": [3, 3] } } },
 { "name": "your instant gives creatures +1/+0 per color spent on it",
   "players": [ { "hand": ["Magmablood Archaic", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, {} ],
   "steps": [ { "cast": "Magmablood Archaic" }, { "resolve": true },
              { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
   "expect": { "pt": { "Magmablood Archaic": [4, 3] } } },
 { "name": "an opponent's instant does not pump your creatures",
   "players": [ { "hand": ["Magmablood Archaic"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
                { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "cast": "Magmablood Archaic" }, { "resolve": true },
              { "pass": true },
              { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] }, { "resolve": true } ],
   "expect": { "pt": { "Magmablood Archaic": [3, 3] } } },
