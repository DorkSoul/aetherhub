[
  { "name": "ruling: two cumulative upkeep instances each count all age counters when they resolve",
    "players": [ { "hand": ["Decomposition", "Decomposition"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Carrion Feeder"] } ],
    "steps": [ { "cast": "Decomposition", "targets": ["Carrion Feeder"] }, { "resolve": true }, { "cast": "Decomposition", "targets": ["Carrion Feeder"] }, { "resolve": true }, { "advance_to": "Upkeep", "answers": [true, true] } ],
    "expect": { "players": [ {}, { "life": 17 } ], "counters": { "Carrion Feeder": { "age": 2 } } } },
  { "name": "upkeep of the enchanted creature's controller: pay 1 life per age counter",
    "players": [ { "hand": ["Decomposition"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Carrion Feeder"] } ],
    "steps": [ { "cast": "Decomposition", "targets": ["Carrion Feeder"] }, { "resolve": true }, { "advance_to": "Upkeep", "answers": [true] } ],
    "expect": { "players": [ {}, { "life": 19 } ], "counters": { "Carrion Feeder": { "age": 1 } } } },
  { "name": "when enchanted creature dies, its controller loses 2 life",
    "players": [ { "hand": ["Decomposition", "Disfigure"], "battlefield": ["Forest", "Forest", "Swamp"] }, { "battlefield": ["Carrion Feeder"] } ],
    "steps": [ { "cast": "Decomposition", "targets": ["Carrion Feeder"] }, { "resolve": true }, { "cast": "Disfigure", "targets": ["Carrion Feeder"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 18, "graveyard_has": ["Carrion Feeder"] } ] } }
]
