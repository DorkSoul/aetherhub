[
  { "name": "exhaust: {5} puts two +1/+1 counters on it, once",
    "players": [ { "battlefield": [{ "name": "Hog-Monkey", "sick": false }, "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Hog-Monkey", "ability": 0 }, { "resolve": true } ],
    "expect": { "counters": { "Hog-Monkey": { "p1p1": 2 } }, "pt": { "Hog-Monkey": [5, 4] } } },
  { "name": "exhaust can't be activated a second time",
    "players": [ { "battlefield": [{ "name": "Hog-Monkey", "sick": false }, "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Hog-Monkey", "ability": 0 }, { "resolve": true }, { "activate": "Hog-Monkey", "ability": 0, "illegal": true } ],
    "expect": { "counters": { "Hog-Monkey": { "p1p1": 2 } } } },
  { "name": "beginning of combat: a creature with a +1/+1 counter gains menace",
    "players": [ { "battlefield": [{ "name": "Hog-Monkey", "sick": false, "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "keywords": { "Hog-Monkey": ["Menace"] } } },
  { "name": "beginning of combat with no creature that has a +1/+1 counter: no trigger",
    "players": [ { "battlefield": [{ "name": "Hog-Monkey", "sick": false }, "Grizzly Bears"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" } ],
    "expect": { "players": [ {}, {} ], "stack_empty": true } },
  { "name": "beginning of combat: the chosen creature with a counter gains menace, not the others",
    "players": [ { "battlefield": [{ "name": "Hog-Monkey", "sick": false, "counters": { "p1p1": 1 } }, { "name": "Grizzly Bears", "counters": { "p1p1": 1 } }] }, {} ],
    "steps": [ { "advance_to": "BeginCombat", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "keywords": { "Grizzly Bears": ["Menace"] } } },
  { "name": "ruling: exhaust can be activated at instant speed, e.g. during the beginning of combat step",
    "players": [ { "battlefield": [{ "name": "Hog-Monkey", "sick": false }, "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "BeginCombat" }, { "activate": "Hog-Monkey", "ability": 0 }, { "resolve": true } ],
    "expect": { "counters": { "Hog-Monkey": { "p1p1": 2 } }, "pt": { "Hog-Monkey": [5, 4] } } }
]
