    "players": [ { "battlefield": ["Goblin Soothsayer", "Goblin Striker"] }, {} ],
    "steps": [ { "activate": "Goblin Soothsayer", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Goblin Soothsayer", "Goblin Striker"] }, {} ] } }
