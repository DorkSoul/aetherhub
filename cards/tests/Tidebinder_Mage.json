[
  {
    "name": "taps a red or green opposing creature that stays tapped while you control the Mage",
    "players": [
      {
        "hand": [
          "Tidebinder Mage"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Tidebinder Mage"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "once the Mage leaves, the creature untaps in its controller's next untap step",
    "players": [
      {
        "hand": [
          "Tidebinder Mage",
          "Lightning Bolt"
        ],
        "battlefield": [
          "Island",
          "Island",
          "Mountain"
        ]
      },
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Tidebinder Mage"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Tidebinder Mage"
        ]
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Main1"
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": false
      },
      "players": [
        {
          "graveyard": [
            "Lightning Bolt",
            "Tidebinder Mage"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "only a red or green opposing creature is a legal target",
    "players": [
      {
        "hand": [
          "Tidebinder Mage"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {
        "battlefield": [
          "Savannah Lions",
          "Grizzly Bears"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Tidebinder Mage"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Grizzly Bears": true,
        "Savannah Lions": false
      }
    }
  },
  {
    "name": "ruling: an already-tapped target stays tapped and skips its controller's next untap step",
    "players": [
      { "hand": ["Tidebinder Mage"], "battlefield": ["Island", "Island"] },
      { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] }
    ],
    "steps": [ { "cast": "Tidebinder Mage" }, { "resolve": true }, { "resolve": true }, { "advance_to": "Main2" }, { "advance_to": "Main1" } ],
    "expect": { "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "ruling: if the Mage leaves before its ability resolves, the creature is tapped but untaps normally",
    "players": [
      { "hand": ["Tidebinder Mage"], "battlefield": ["Island", "Island"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Tidebinder Mage" },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Tidebinder Mage"], "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false },
      "players": [ { "graveyard": ["Tidebinder Mage"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  }
]