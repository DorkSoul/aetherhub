      { "hand": ["Grizzly Bears"], "battlefield": ["Zameck Guildmage", "Forest", "Island", "Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Zameck Guildmage", "ability": 0 },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3] }
    }
  },
  { "name": "creatures that were already on the battlefield do not get the counter",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Zameck Guildmage", "Forest", "Island", "Forest", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "activate": "Zameck Guildmage", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 0 } },
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  { "name": "remove a +1/+1 counter from a creature you control to draw a card",
    "players": [
      { "battlefield": [{ "name": "Zameck Guildmage", "counters": { "p1p1": 1 } }, "Forest", "Island"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Zameck Guildmage", "ability": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Grizzly Bears"] }, {} ],
      "counters": { "Zameck Guildmage": { "p1p1": 0 } }
    }
  },
  { "name": "the draw ability needs a +1/+1 counter to remove",
    "players": [
      { "battlefield": ["Zameck Guildmage", "Forest", "Island"], "library": ["Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Zameck Guildmage", "ability": 1, "illegal": true }
    ],
    "expect": {
      "players": [ { "hand_count": 0 }, {} ]
    }
  },
  { "name": "ruling: the effect is cumulative: two activations give each entering creature two counters",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Zameck Guildmage", "Forest", "Island", "Forest", "Island", "Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Zameck Guildmage", "ability": 0 },
      { "resolve": true },
      { "activate": "Zameck Guildmage", "ability": 0 },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "pt": { "Grizzly Bears": [4, 4] }
    }
  }
