[
  {
    "name": "dies trigger deals 2 damage to target player",
    "players": [
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Orcish Hellraiser", "Mountain"]
      },
      {}
    ],
    "steps": [
