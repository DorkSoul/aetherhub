          "life": 20,
          "battlefield_has": ["Orcish Hellraiser"]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "echo: paying R keeps the Hellraiser",
    "players": [
      {
        "hand": ["Orcish Hellraiser"],
        "battlefield": ["Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Orcish Hellraiser"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true
        ]
      }
