  {
    "name": "ruling: echo is not triggered again after it was paid (not under control since last upkeep)",
    "players": [
      {
        "hand": ["Orcish Hellraiser"],
        "battlefield": ["Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Orcish Hellraiser" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "advance_to": "End" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Orcish Hellraiser"] },
