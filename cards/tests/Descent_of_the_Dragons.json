[
  {
    "name": "destroying two opposing creatures gives their controller a Dragon each",
    "players": [
      { "hand": ["Descent of the Dragons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Descent of the Dragons", "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Descent of the Dragons"] },
        { "graveyard": ["Grizzly Bears", "Hill Giant"], "battlefield": ["Dragon 4-4 Flying", "Dragon 4-4 Flying"] }
      ]
    }
  },
  {
    "name": "destroying my own creature gives me the Dragon",
    "players": [
      { "hand": ["Descent of the Dragons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Descent of the Dragons", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Descent of the Dragons", "Grizzly Bears"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Dragon 4-4 Flying"] },
        { "battlefield": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "zero targets: no creature is destroyed and no Dragon appears",
    "players": [
      { "hand": ["Descent of the Dragons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Descent of the Dragons", "targets": [] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Descent of the Dragons"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: a targeted creature that regenerates is not destroyed, so its controller gets no Dragon",
    "players": [
      { "hand": ["Descent of the Dragons"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Drudge Skeletons", "Swamp"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Drudge Skeletons", "player": 1 },
      { "resolve": true },
      { "cast": "Descent of the Dragons", "targets": ["Grizzly Bears", "Drudge Skeletons"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Grizzly Bears", "Descent of the Dragons"], "battlefield_has": ["Dragon 4-4 Flying"] },
        { "battlefield_has": ["Drudge Skeletons"], "battlefield_lacks": ["Dragon 4-4 Flying"] }
      ]
    }
  }
]
