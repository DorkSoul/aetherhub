   }
  }
 },
 {
  "name": "sacrificing a Food (to its own ability) makes a tapped Treasure",
  "players": [
   {
    "battlefield": [
     "Nuka-Cola Vending Machine",
     "Food",
     "Forest",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Food"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Nuka-Cola Vending Machine",
      "Treasure",
      "Forest",
      "Forest"
     ],
     "life": 23
    },
    {}
   ],
   "tapped": {
    "Treasure": true
   }
  }
 },
 {
  "name": "sacrificing a non-Food doesn't",
  "players": [
   {
    "battlefield": [
     "Nuka-Cola Vending Machine",
     "Treasure"
    ]
   },
   {}
  ],
  "steps": [
   {
    "tap_for_mana": "Treasure"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Nuka-Cola Vending Machine"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: a Food sacrificed as another card's cost (Maraleaf Rider) still makes a tapped Treasure",
  "players": [
   { "battlefield": ["Nuka-Cola Vending Machine", "Maraleaf Rider", "Food"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Nuka-Cola Vending Machine", "Maraleaf Rider", "Treasure"], "battlefield_lacks": ["Food"] }, {} ],
   "tapped": { "Treasure": true }
  }
 },
 {
  "name": "ruling: sacrificing a nontoken Food artifact (Candy Trail) also makes a tapped Treasure",
  "players": [
   { "battlefield": ["Nuka-Cola Vending Machine", "Candy Trail", "Forest", "Forest"] },
   {}
  ],
  "steps": [
   { "activate": "Candy Trail", "ability": 0 },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Nuka-Cola Vending Machine", "Treasure"], "battlefield_lacks": ["Candy Trail"], "life": 23 }, {} ],
   "tapped": { "Treasure": true }
  }
 }
]