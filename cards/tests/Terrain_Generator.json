  {
    "name": "ruling: a basic put onto the battlefield is not my land play",
    "players": [ { "hand": ["Forest", "Island"], "battlefield": ["Terrain Generator", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Terrain Generator" }, { "resolve": true, "answers": ["Forest"] }, { "play_land": "Island" } ],
    "expect": { "players": [ { "hand": [], "battlefield_has": ["Forest", "Island"] }, {} ] }
