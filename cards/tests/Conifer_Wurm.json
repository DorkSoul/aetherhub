[
  { "name": "pumps by the number of snow permanents you control",
    "players": [ { "battlefield": ["Conifer Wurm", "Snow-Covered Forest", "Snow-Covered Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Conifer Wurm", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Conifer Wurm": [7, 7] } } },
  { "name": "the Wurm itself counts as a snow permanent",
    "players": [ { "battlefield": ["Conifer Wurm", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Conifer Wurm", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Conifer Wurm": [5, 5] } } },
  { "name": "ruling: the Wurm is a snow permanent; opponent's snow permanents are not counted",
    "players": [ { "battlefield": ["Conifer Wurm", "Snow-Covered Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Snow-Covered Forest"] } ],
    "steps": [ { "activate": "Conifer Wurm", "ability": 0 }, { "resolve": true } ],
    "expect": { "pt": { "Conifer Wurm": [6, 6] } } },
  { "name": "ruling: X is fixed on resolution; a snow land played afterwards does not change the bonus",
    "players": [ { "hand": ["Snow-Covered Forest"], "battlefield": ["Conifer Wurm", "Snow-Covered Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Conifer Wurm", "ability": 0 }, { "resolve": true }, { "play_land": "Snow-Covered Forest" } ],
    "expect": { "pt": { "Conifer Wurm": [6, 6] } } }
]
