 {
  "name": "Primordials: {G} regenerates it from a destroy effect",
  "players": [
   { "battlefield": ["Ulvenwald Primordials", "Forest"] },
   { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Murder", "player": 1, "targets": ["Ulvenwald Primordials"] },
   { "activate": "Ulvenwald Primordials", "ability": 0 },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Ulvenwald Primordials"] }, {} ],
   "pt": { "Ulvenwald Primordials": [5, 5] }
  }
 },
 {
  "name": "Primordials: regeneration needs {G}; without it the destroy kills it",
  "players": [
   { "battlefield": ["Ulvenwald Primordials", "Swamp"] },
   { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
  ],
  "steps": [
   { "activate": "Ulvenwald Primordials", "ability": 0, "illegal": true },
   { "pass": true },
   { "cast": "Murder", "player": 1, "targets": ["Ulvenwald Primordials"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard_has": ["Ulvenwald Mystics"] }, {} ]
  }
 },
 {
  "name": "Primordials: two spells cast last turn transform it back at the next upkeep",
  "players": [
   { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Ulvenwald Primordials", "Mountain", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Upkeep" }
  ],
  "expect": {
   "pt": { "Ulvenwald Mystics": [3, 3] }
  }
 },
 {
  "name": "Primordials: only one spell cast last turn does not transform it back",
  "players": [
   { "hand": ["Lightning Bolt"], "battlefield": ["Ulvenwald Primordials", "Mountain"] },
   {}
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["p1"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "advance_to": "Upkeep" }
  ],
  "expect": {
   "pt": { "Ulvenwald Primordials": [5, 5] }
  }
 }
]
