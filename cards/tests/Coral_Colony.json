[
 {"name": "mills cards equal to the number of defender creatures you control",
  "players": [ { "battlefield": ["Island", "Island", "Coral Colony", "Coral Barrier"] }, {} ],
  "steps": [ { "activate": "Coral Colony", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ {}, { "library_count": 18 } ] } },
 {"name": "with no other defenders it mills one card",
  "players": [ { "battlefield": ["Island", "Island", "Coral Colony"] }, {} ],
  "steps": [ { "activate": "Coral Colony", "ability": 0, "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ {}, { "library_count": 19 } ] } },
 {"name": "ruling: the defender count is taken on resolution; a Coral Barrier killed in response is not counted (mills 1)",
  "players": [ { "hand": [], "battlefield": ["Island", "Island", "Coral Colony", "Coral Barrier"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
  "steps": [ { "activate": "Coral Colony", "ability": 0, "targets": ["p1"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Coral Barrier"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard_has": ["Coral Barrier"] }, { "library_count": 19, "graveyard_has": ["Lightning Bolt"] } ] } }
]
