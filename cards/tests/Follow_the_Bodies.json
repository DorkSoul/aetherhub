[
  { "name": "gravestorm copies once for the one permanent put into a graveyard from the battlefield this turn",
    "players": [ { "hand": ["Lightning Bolt", "Follow the Bodies"], "battlefield": ["Mountain", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Follow the Bodies" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Clue", "Clue"], "graveyard_has": ["Lightning Bolt", "Follow the Bodies"] }, { "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "no permanents put into graveyards this turn: no copies, one Clue",
    "players": [ { "hand": ["Follow the Bodies"], "battlefield": ["Island", "Island", "Island"] }, {} ],
    "steps": [
      { "cast": "Follow the Bodies" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Clue"], "graveyard_has": ["Follow the Bodies"] }, {} ] } },
  { "name": "ruling: your own creature put into the graveyard this turn counts for gravestorm",
    "players": [ { "hand": ["Lightning Bolt", "Follow the Bodies"], "battlefield": ["Mountain", "Island", "Island", "Island", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Follow the Bodies" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Clue", "Clue"], "graveyard_has": ["Lightning Bolt", "Follow the Bodies", "Grizzly Bears"] }, {} ] } },
  { "name": "ruling: countering one gravestorm copy leaves the other copy and the original to resolve (one Clue)",
    "players": [ { "hand": ["Lightning Bolt", "Follow the Bodies"], "battlefield": ["Mountain", "Island", "Island", "Island"] }, { "hand": ["Counterspell"], "battlefield": ["Grizzly Bears", "Island", "Island"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Follow the Bodies" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Follow the Bodies" }] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield": ["Mountain", "Island", "Island", "Island", "Clue"], "graveyard_has": ["Lightning Bolt", "Follow the Bodies"] }, { "graveyard_has": ["Counterspell", "Grizzly Bears"] } ] } }
]
