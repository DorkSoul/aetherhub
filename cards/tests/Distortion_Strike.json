[
 {"name": "+1/+0 and can't be blocked until end of turn, then rebounds",
  "players": [
   {"hand": ["Distortion Strike"], "battlefield": ["Island", "Grizzly Bears"], "library": ["Island"]},
   {"battlefield": ["Hill Giant"]}],
  "steps": [
   {"cast": "Distortion Strike", "targets": ["Grizzly Bears"]},
   {"resolve": true}],
  "expect": {"players": [{"exile": ["Distortion Strike"], "graveyard": []}, {}],
             "pt": {"Grizzly Bears": [3, 2]},
             "keywords": {"Grizzly Bears": ["Unblockable"]}}},
 {"name": "rebound recast at the next upkeep gives the same bonus again",
  "players": [
   {"hand": ["Distortion Strike"], "battlefield": ["Island", "Grizzly Bears"], "library": ["Island"]},
   {"battlefield": ["Hill Giant"]}],
  "steps": [
   {"cast": "Distortion Strike", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"advance_to": "Upkeep"},
   {"advance_to": "Upkeep", "answers": [true], "targets": ["Grizzly Bears"]},
   {"resolve": true}],
  "expect": {"players": [{"exile": [], "graveyard": ["Distortion Strike"]}, {}],
             "pt": {"Grizzly Bears": [3, 2]}}},
 {"name": "ruling: the unblockable effect still applies after the target loses all abilities",
  "players": [
   {"hand": ["Distortion Strike"], "battlefield": ["Island", "Grizzly Bears"], "library": ["Island"]},
   {"hand": ["Turn to Frog"], "battlefield": ["Island", "Island", "Hill Giant"]}],
  "steps": [
   {"cast": "Distortion Strike", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"pass": true},
   {"cast": "Turn to Frog", "player": 1, "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"advance_to": "BeginCombat"},
   {"attack": [{"card": "Grizzly Bears", "at": "p1"}]},
   {"block": [{"blocker": "Hill Giant", "attacker": "Grizzly Bears"}], "illegal": true},
   {"advance_to": "Main2"}],
  "expect": {"players": [{}, {"life": 18}]}},
 {"name": "ruling: if the target dies in response, the spell goes to the graveyard and does not rebound",
  "players": [
   {"hand": ["Distortion Strike"], "battlefield": ["Island", "Grizzly Bears"], "library": ["Island"]},
   {"hand": ["Lightning Bolt"], "battlefield": ["Mountain"]}],
  "steps": [
   {"cast": "Distortion Strike", "targets": ["Grizzly Bears"]},
   {"pass": true},
   {"cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"]},
   {"resolve": true}],
  "expect": {"players": [{"exile": [], "graveyard_has": ["Distortion Strike", "Grizzly Bears"]}, {"graveyard": ["Lightning Bolt"]}]}},
 {"name": "ruling: a copy of a rebound spell (made with Twincast) does not rebound",
  "players": [
   {"hand": ["Distortion Strike", "Twincast"], "battlefield": ["Island", "Island", "Island", "Grizzly Bears"], "library": ["Island"]},
   {}],
  "steps": [
   {"cast": "Distortion Strike", "targets": ["Grizzly Bears"]},
   {"cast": "Twincast", "targets": [{"stack": "Distortion Strike"}]},
   {"resolve": true}],
  "expect": {"players": [{"exile": ["Distortion Strike"], "graveyard": ["Twincast"]}, {}]}},
 {"name": "ruling: declining the rebound cast leaves the card exiled for the rest of the game",
  "players": [
   {"hand": ["Distortion Strike"], "battlefield": ["Island", "Grizzly Bears"], "library": ["Island"]},
   {}],
  "steps": [
   {"cast": "Distortion Strike", "targets": ["Grizzly Bears"]},
   {"resolve": true},
   {"advance_to": "Upkeep"},
   {"advance_to": "Upkeep", "answers": [false]},
   {"resolve": true},
   {"advance_to": "Upkeep"},
   {"advance_to": "Upkeep"}],
  "expect": {"players": [{"exile": ["Distortion Strike"], "graveyard": []}, {}]}}
]
