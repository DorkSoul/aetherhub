 {
  "name": "ruling: the enchanted creature returns to its owner at the end step and the Aura stays on it (Control Magic remains attached, controlled by its caster)",
  "players": [
   { "hand": ["Control Magic"], "battlefield": ["Brooding Saurian", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Control Magic", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "End" },
   { "resolve": true }
  ],
  "expect": {
