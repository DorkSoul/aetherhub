[
  {
    "name": "ETB creates two 0/1 Dinosaur Eggs",
    "players": [
      { "hand": ["Palani's Hatcher"], "battlefield": ["Mountain", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Palani's Hatcher" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Forest", "Forest", "Forest", "Forest", "Palani's Hatcher", "Dinosaur Egg 0-1", "Dinosaur Egg 0-1"], "hand": [] },
        {}
      ]
    }
  },
  {
    "name": "beginning of combat with an Egg sacrifices it for a 3/3 Dinosaur",
    "players": [
      { "battlefield": ["Mountain", "Forest", "Palani's Hatcher", "Dinosaur Egg 0-1", "Dinosaur Egg 0-1"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat", "answers": ["Dinosaur Egg 0-1"] }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Forest", "Palani's Hatcher", "Dinosaur Egg 0-1", "Dinosaur 3-3 Vanilla"] },
        {}
      ]
    }
  },
  {
    "name": "no Egg means no 3/3 at beginning of combat",
    "players": [
      { "battlefield": ["Mountain", "Forest", "Palani's Hatcher"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Mountain", "Forest", "Palani's Hatcher"], "battlefield_lacks": ["Dinosaur 3-3 Vanilla"] },
        {}
      ]
    }
  },
  {
    "name": "other Dinosaurs have haste (summoning-sick Dinosaur attacks)",
    "players": [
      { "battlefield": ["Mountain", "Forest", "Palani's Hatcher", { "name": "Dinosaur 3-3 Vanilla", "sick": true }] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Dinosaur 3-3 Vanilla", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17 }
      ]
    }
  },
  {
    "name": "ruling: a non-token Egg creature counts for the beginning-of-combat trigger",
    "players": [
      { "battlefield": ["Mountain", "Forest", "Palani's Hatcher", "Biolume Egg // Biolume Serpent"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Palani's Hatcher", "Dinosaur 3-3 Vanilla"], "battlefield_lacks": ["Biolume Egg // Biolume Serpent"] },
        {}
      ]
    }
  }
]
