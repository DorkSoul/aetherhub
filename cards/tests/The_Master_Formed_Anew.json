[
 { "name": "enters as a copy of a creature card in exile with a takeover counter",
   "players": [ { "hand": ["The Master, Formed Anew"], "battlefield": ["Island", "Swamp"], "exile": [ { "name": "Mulldrifter", "counters": { "takeover": 1 } } ] }, {} ],
   "steps": [ { "cast": "The Master, Formed Anew" }, { "resolve": true, "answers": [0] } ],
   "expect": { "pt": { "Mulldrifter": [2, 2] }, "players": [ { "battlefield_has": ["Mulldrifter"] }, {} ] } },
 { "name": "a creature in exile without a takeover counter cannot be copied",
   "players": [ { "hand": ["The Master, Formed Anew"], "battlefield": ["Island", "Swamp"], "exile": ["Mulldrifter"] }, {} ],
   "steps": [ { "cast": "The Master, Formed Anew" }, { "resolve": true } ],
   "expect": { "pt": { "The Master, Formed Anew": [0, 1] }, "players": [ { "battlefield_has": ["The Master, Formed Anew"] }, {} ] } },
 { "name": "the cast trigger exiles a creature you control and gives it a takeover counter; The Master copies it",
   "players": [ { "hand": ["The Master, Formed Anew"], "battlefield": ["Island", "Swamp", "Mulldrifter"] }, {} ],
   "steps": [ { "cast": "The Master, Formed Anew" }, { "resolve": true, "answers": [0, 0] } ],
   "expect": { "players": [ { "exile": ["Mulldrifter"], "battlefield_has": ["Mulldrifter"] }, {} ] } },
 { "name": "declining the cast trigger leaves the creature alone",
   "players": [ { "hand": ["The Master, Formed Anew"], "battlefield": ["Island", "Swamp", "Mulldrifter"] }, {} ],
   "steps": [ { "cast": "The Master, Formed Anew" }, { "resolve": true } ],
   "expect": { "players": [ { "exile": [], "battlefield_has": ["Mulldrifter", "The Master, Formed Anew"] }, {} ] } },
 { "name": "ruling: choosing Time Lord lets the Cavern's restricted mana pay for The Master",
   "players": [ { "hand": ["Cavern of Souls", "The Master, Formed Anew"], "battlefield": ["Island"] }, {} ],
   "steps": [ { "play_land": "Cavern of Souls" }, { "advance_to": "Main1", "answers": ["Time Lord"] }, { "advance_to": "Main1" }, { "cast": "The Master, Formed Anew" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["The Master, Formed Anew", "Cavern of Souls"] }, {} ] } },
 { "name": "ruling: with a different type chosen (Bear) the Cavern cannot pay for The Master",
   "players": [ { "hand": ["Cavern of Souls", "The Master, Formed Anew"], "battlefield": ["Island"] }, {} ],
   "steps": [ { "play_land": "Cavern of Souls" }, { "advance_to": "Main1", "answers": ["Bear"] }, { "advance_to": "Main1" }, { "cast": "The Master, Formed Anew", "illegal": true } ],
   "expect": { "players": [ { "battlefield_lacks": ["The Master, Formed Anew"], "battlefield_has": ["Cavern of Souls"] }, {} ] } }
]
