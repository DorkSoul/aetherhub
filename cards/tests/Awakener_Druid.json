[
  {
    "name": "ETB makes the target Forest a 4/5 Treefolk",
    "players": [
      {
        "hand": [
          "Awakener Druid"
        ],
        "battlefield": [
          "Forest",
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Awakener Druid"
      },
      {
        "resolve": true,
        "targets": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Forest": [
          4,
          5
        ]
      },
      "players": [
        {
