  {
    "name": "the Forest reverts when the Druid leaves",
    "players": [
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain",
          "Forest",
          "Awakener Druid"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Lightning Bolt",
        "targets": [
          "Awakener Druid"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Lightning Bolt",
            "Awakener Druid"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Druid leaves before its ability resolves: the Forest does not become a creature",
    "players": [
      { "hand": ["Awakener Druid"], "battlefield": ["Forest", "Forest", "Forest"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Awakener Druid" },
      { "resolve": true, "targets": ["Forest"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Awakener Druid"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Awakener Druid"], "battlefield_has": ["Forest"] },
        { "graveyard": ["Lightning Bolt"] }
      ]
    }
  }
]
