  {
    "name": "ruling: the {W} ability cannot target its own controller",
    "players": [ { "battlefield": ["Plains", "Phelddagrif"] }, {} ],
    "steps": [ { "activate": "Phelddagrif", "ability": 1, "targets": ["p0"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] }
  },
  {
    "name": "ruling: the {U} ability cannot target its own controller",
    "players": [ { "battlefield": ["Island", "Phelddagrif"] }, {} ],
    "steps": [ { "activate": "Phelddagrif", "ability": 2, "targets": ["p0"], "illegal": true } ],
