  {
    "name": "{U}: returns to hand and the target opponent may draw a card",
    "players": [ { "battlefield": ["Island", "Phelddagrif"] }, {} ],
    "steps": [
      { "activate": "Phelddagrif", "ability": 2, "targets": ["p1"] },
