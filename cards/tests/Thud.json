[
  { "name": "damage equals the sacrificed creature's power",
    "players": [ { "hand": ["Thud"], "battlefield": ["Mountain", "Hill Giant"] }, {} ],
    "steps": [ { "cast": "Thud", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Hill Giant", "Thud"] }, { "life": 17 } ] } },
  { "name": "a 4-power creature deals 4",
    "players": [ { "hand": ["Thud"], "battlefield": ["Mountain", "Serra Angel"] }, {} ],
    "steps": [ { "cast": "Thud", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Serra Angel", "Thud"] }, { "life": 16 } ] } },
  { "name": "needs a creature to sacrifice",
    "players": [ { "hand": ["Thud"], "battlefield": ["Mountain"] }, {} ],
    "steps": [ { "cast": "Thud", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Thud"] }, { "life": 20 } ] } },
  { "name": "ruling: the sacrificed creature's last known power includes its counters (4/4 Bears deals 4)",
    "players": [ { "hand": ["Thud"], "battlefield": ["Mountain", { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 2 } }] }, {} ],
    "steps": [ { "cast": "Thud", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Thud"] }, { "life": 16 } ] } },
  { "name": "ruling: with two creatures you sacrifice exactly one (the chosen one), the other stays",
    "players": [ { "hand": ["Thud"], "battlefield": ["Mountain", "Hill Giant", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Thud", "targets": ["p1"], "answers": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Grizzly Bears", "Thud"], "battlefield_has": ["Hill Giant"] }, { "life": 18 } ] } }
]
