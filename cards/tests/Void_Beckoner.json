[
  {
    "name": "cycling draws a card and puts a deathtouch counter on a creature you control",
    "players": [ { "hand": ["Void Beckoner"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Void Beckoner" }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": ["Void Beckoner"] }, {} ],
      "keywords": { "Grizzly Bears": ["Deathtouch"] }
    }
  },
  {
    "name": "cycling with no creature to target still draws",
    "players": [ { "hand": ["Void Beckoner"], "battlefield": ["Swamp", "Swamp", "Swamp"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Void Beckoner" }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": ["Void Beckoner"] }, {} ]
    }
  },
  {
    "name": "cannot be cycled with only two lands",
    "players": [ { "hand": ["Void Beckoner"], "battlefield": ["Swamp", "Swamp"], "library": ["Forest"] }, {} ],
    "steps": [ { "activate": "Void Beckoner", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Void Beckoner"] }, {} ] }
  },
  {
    "name": "ruling: a spell-only counter cannot target the cycling ability or its trigger; the cycle still draws",
    "players": [ { "hand": ["Void Beckoner"], "battlefield": ["Swamp", "Swamp", "Swamp", "Grizzly Bears"], "library": ["Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Void Beckoner" }, { "pass": true }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Void Beckoner" }], "illegal": true }, { "resolve": true }, { "resolve": true } ],
    "expect": {
      "players": [ { "hand": ["Forest"], "graveyard": ["Void Beckoner"] }, { "hand": ["Counterspell"] } ],
      "keywords": { "Grizzly Bears": ["Deathtouch"] }
    }
  }
]
