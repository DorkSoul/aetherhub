[
  {
    "name": "taps for black or red",
    "players": [{ "battlefield": ["Sulfurous Mire"] }, {}],
    "steps": [{ "tap_for_mana": "Sulfurous Mire", "color": "R" }],
    "expect": { "players": [{ "pool": { "R": 1 } }, {}] }
  },
  {
    "name": "is a snow land and taps for black",
    "players": [{ "battlefield": ["Sulfurous Mire"] }, {}],
    "steps": [{ "tap_for_mana": "Sulfurous Mire", "color": "B" }],
    "expect": { "players": [{ "pool": { "B": 1 } }, {}] }
  },
  {
    "name": "enters the battlefield tapped",
    "players": [{ "hand": ["Sulfurous Mire"] }, {}],
    "steps": [{ "play_land": "Sulfurous Mire" }],
    "expect": { "players": [{ "battlefield_has": ["Sulfurous Mire"] }, {}], "tapped": { "Sulfurous Mire": true } }
  },
  {
    "name": "ruling: {S} is paid by one mana from a snow source; two Mires pay Icehide Troll's {S}{S}",
    "players": [{ "battlefield": ["Icehide Troll", "Sulfurous Mire", "Sulfurous Mire"] }, {}],
    "steps": [{ "activate": "Icehide Troll" }, { "resolve": true }],
    "expect": { "pt": { "Icehide Troll": [4, 3] } }
  },
  {
    "name": "ruling: a non-snow Forest cannot pay {S}, so one snow Mire plus Forests is not enough",
    "players": [{ "battlefield": ["Icehide Troll", "Sulfurous Mire", "Forest", "Forest"] }, {}],
    "steps": [{ "activate": "Icehide Troll", "illegal": true }],
    "expect": { "pt": { "Icehide Troll": [2, 3] } }
  }
]
