[
  { "name": "alone, the land becomes a 1/1 Elemental creature that is still a land",
    "players": [ { "battlefield": ["Vastwood Animist", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Vastwood Animist", "Forest"] }, {} ], "pt": { "Forest": [1, 1] } } },
  { "name": "with another Ally the land becomes 2/2",
    "players": [ { "battlefield": ["Vastwood Animist", "Kor Ally", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Vastwood Animist", "Kor Ally", "Forest"] }, {} ], "pt": { "Forest": [2, 2] } } },
  { "name": "non-Ally creatures are not counted",
    "players": [ { "battlefield": ["Vastwood Animist", "Grizzly Bears", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Vastwood Animist", "Grizzly Bears", "Forest"] }, {} ], "pt": { "Forest": [1, 1] } } },
  { "name": "cannot target an opponent's land",
    "players": [ { "battlefield": ["Vastwood Animist"] }, { "battlefield": ["Forest"] } ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"], "illegal": true } ],
    "expect": { "players": [ {}, {} ] } },
  { "name": "ruling: animating a land is not a creature entering (Impact Tremors does not trigger)",
    "players": [ { "battlefield": ["Vastwood Animist", "Impact Tremors", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 20 } ], "pt": { "Forest": [1, 1] } } },
  { "name": "control: a creature entering under your control does trigger Impact Tremors",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Impact Tremors", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ {}, { "life": 19 } ] } },
  { "name": "ruling: a land that came under your control this turn is summoning sick once animated and cannot attack",
    "players": [ { "battlefield": ["Vastwood Animist", { "name": "Forest", "sick": true }] }, {} ],
    "steps": [ { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "resolve": true }, { "attack": [ { "card": "Forest", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "control: the same land that is not sick can attack once animated",
    "players": [ { "battlefield": ["Vastwood Animist", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "resolve": true }, { "attack": [ { "card": "Forest", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 19 } ] } },
  { "name": "ruling: X is fixed on resolution; losing an Ally later leaves the Elemental at 2/2",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Vastwood Animist", "Kor Ally", "Forest", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Kor Ally"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vastwood Animist", "Forest"], "battlefield_lacks": ["Kor Ally"], "graveyard_has": ["Lightning Bolt"] }, {} ], "pt": { "Forest": [2, 2] } } },
  { "name": "ruling: with no Allies when it resolves the land becomes 0/0 and dies (the Animist is killed in response)",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Vastwood Animist", "Forest", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "activate": "Vastwood Animist", "ability": 0, "targets": ["Forest"] }, { "cast": "Lightning Bolt", "targets": ["Vastwood Animist"] }, { "pass": true }, { "pass": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Forest", "Vastwood Animist", "Lightning Bolt"], "battlefield_lacks": ["Forest"] }, {} ] } }
]
