[
  {
    "name": "creatures you control become X/X, counting owned instants, sorceries and Adventure cards in graveyard and exile once each",
    "players": [
      {
        "hand": ["Candlekeep Inspiration"],
        "battlefield": ["Hill Giant", "Island", "Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Lightning Bolt"],
        "exile": ["Bonecrusher Giant // Stomp"]
      },
      {}
    ],
    "steps": [
      { "cast": "Candlekeep Inspiration" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Hill Giant": [2, 2] } }
  },
  {
    "name": "cards the opponent owns and non-matching cards do not count",
    "players": [
      {
        "hand": ["Candlekeep Inspiration"],
        "battlefield": ["Hill Giant", "Island", "Forest", "Forest", "Forest", "Forest"],
        "graveyard": ["Lightning Bolt", "Grizzly Bears"],
        "exile": ["Forest"]
      },
      {
        "graveyard": ["Lightning Bolt", "Shock"]
      }
    ],
    "steps": [
      { "cast": "Candlekeep Inspiration" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Hill Giant": [1, 1] } }
  },
  {
    "name": "ruling: X is locked in on resolution, so cards that reach the graveyard afterwards do not change it",
    "players": [
      { "hand": ["Candlekeep Inspiration", "Shock"], "battlefield": ["Hill Giant", "Island", "Forest", "Forest", "Forest", "Forest", "Mountain"], "graveyard": ["Lightning Bolt"], "exile": ["Bonecrusher Giant // Stomp"] },
      {}
    ],
    "steps": [
      { "cast": "Candlekeep Inspiration" },
      { "resolve": true },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Candlekeep Inspiration", "Shock"] }, { "life": 18 } ],
      "pt": { "Hill Giant": [2, 2] }
    }
  },
  {
    "name": "ruling: a creature that enters after Candlekeep Inspiration resolves is not affected",
    "players": [
      { "hand": ["Candlekeep Inspiration", "Llanowar Elves"], "battlefield": ["Hill Giant", "Island", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "graveyard": ["Lightning Bolt"], "exile": ["Bonecrusher Giant // Stomp"] },
      {}
    ],
    "steps": [
      { "cast": "Candlekeep Inspiration" },
      { "resolve": true },
      { "cast": "Llanowar Elves" },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Hill Giant": [2, 2], "Llanowar Elves": [1, 1] }
    }
  }
]
