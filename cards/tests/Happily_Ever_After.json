[
  {
    "name": "when it enters each player gains 5 life and draws a card",
    "players": [
      { "hand": ["Happily Ever After"], "battlefield": ["Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Happily Ever After" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 25, "hand_count": 1 }, { "life": 25, "hand_count": 1 } ]
    }
  },
  {
    "name": "five colors among permanents, six card types among permanents and graveyard, and enough life: you win at upkeep",
    "players": [
      {
        "battlefield": ["Happily Ever After", "Progenitus", "Island"],
        "graveyard": ["Lightning Bolt", "Divination", "Sol Ring"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "winner": 0 }
  },
  {
    "name": "only five card types: no win",
    "players": [
      {
        "battlefield": ["Happily Ever After", "Progenitus", "Island"],
        "graveyard": ["Lightning Bolt", "Divination"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "winner": -1 }
  },
  {
    "name": "a type that is only in an opponent's graveyard doesn't count",
    "players": [
      {
        "battlefield": ["Happily Ever After", "Progenitus", "Island"],
        "graveyard": ["Lightning Bolt", "Divination"]
      },
      { "graveyard": ["Sol Ring"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "winner": -1 }
  },
  {
    "name": "life total below the starting life total: no win",
    "players": [
      {
        "life": 19,
        "battlefield": ["Happily Ever After", "Progenitus", "Island"],
        "graveyard": ["Lightning Bolt", "Divination", "Sol Ring"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "winner": -1 }
  },
  {
    "name": "fewer than five colors: no win",
    "players": [
      {
        "battlefield": ["Happily Ever After", "Grizzly Bears", "Island"],
        "graveyard": ["Lightning Bolt", "Divination", "Sol Ring", "Dismember"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "winner": -1 }
  },
  {
    "name": "ruling: five colors may be spread across several permanents (Serra Angel W, Grizzly Bears G, Malfegor B and R, Air Elemental U)",
    "players": [ { "battlefield": ["Happily Ever After", "Serra Angel", "Grizzly Bears", "Malfegor", "Air Elemental", "Island"], "graveyard": ["Lightning Bolt", "Divination", "Sol Ring"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "winner": 0 }
  },
  {
    "name": "ruling: lands are colorless, so an Island does not supply the missing blue (four colors only: no win)",
    "players": [ { "battlefield": ["Happily Ever After", "Serra Angel", "Grizzly Bears", "Malfegor", "Island"], "graveyard": ["Lightning Bolt", "Divination", "Sol Ring"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
    "expect": { "winner": -1 }
  }
]
