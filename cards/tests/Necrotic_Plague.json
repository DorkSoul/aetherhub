[
  {
    "name": "enchanted creature is sacrificed at its controller's upkeep and the Plague moves to a creature of the Plague controller",
    "players": [
      { "hand": ["Necrotic Plague"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Necrotic Plague", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Necrotic Plague", "Hill Giant"] }, { "graveyard_has": ["Grizzly Bears"] } ],
      "attached": { "Necrotic Plague": "Hill Giant" }
    }
  },
  {
    "name": "the Plague on an opponent's creature does nothing until that upkeep",
    "players": [
      { "hand": ["Necrotic Plague"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Necrotic Plague", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Necrotic Plague"] }, { "battlefield_has": ["Grizzly Bears"] } ],
      "attached": { "Necrotic Plague": "Grizzly Bears" }
    }
  },
  {
    "name": "no creature to move to: the Plague stays in the graveyard",
    "players": [
      { "hand": ["Necrotic Plague"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Necrotic Plague", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Necrotic Plague"] }, { "graveyard_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: Plague returns under its own controller when the creature of the other player dies",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "hand": ["Necrotic Plague"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Llanowar Elves"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "cast": "Necrotic Plague", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, { "battlefield_has": ["Necrotic Plague", "Llanowar Elves"] } ],
      "attached": { "Necrotic Plague": "Llanowar Elves" }
    }
  },
  {
    "name": "ruling: Plague's last ability also triggers when the enchanted creature dies to damage, not sacrifice",
    "players": [
      { "hand": ["Necrotic Plague", "Lightning Bolt"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Mountain", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Necrotic Plague", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Necrotic Plague", "Hill Giant"] }, { "graveyard_has": ["Grizzly Bears"] } ],
      "attached": { "Necrotic Plague": "Hill Giant" }
    }
  }
