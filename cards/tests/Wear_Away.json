[
 { "name": "destroys target artifact",
   "players": [ { "hand": ["Wear Away"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Sol Ring"] } ],
   "steps": [ { "cast": "Wear Away", "targets": ["Sol Ring"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Wear Away"] }, { "battlefield_lacks": ["Sol Ring"], "graveyard": ["Sol Ring"] } ] } },
 { "name": "no artifact or enchantment to target: cannot cast",
   "players": [ { "hand": ["Wear Away"], "battlefield": ["Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Wear Away", "illegal": true } ],
   "expect": { "players": [ { "hand": ["Wear Away"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "spliced onto Unchecked Growth: destroys the artifact too",
   "players": [ { "hand": ["Unchecked Growth", "Wear Away"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Sol Ring"] } ],
   "steps": [ { "cast": "Unchecked Growth", "targets": ["Grizzly Bears"], "answers": [true] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Wear Away"], "graveyard": ["Unchecked Growth"] }, { "battlefield_lacks": ["Sol Ring"] } ] } },
 { "name": "declining the splice: artifact survives, Wear Away stays in hand",
   "players": [ { "hand": ["Unchecked Growth", "Wear Away"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Sol Ring"] } ],
   "steps": [ { "cast": "Unchecked Growth", "targets": ["Grizzly Bears"], "answers": [false] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Wear Away"] }, { "battlefield_has": ["Sol Ring"] } ] } },
 { "name": "ruling: two different Wear Away cards can each be spliced once onto the same Growth; each destroys its own target",
   "players": [ { "hand": ["Unchecked Growth", "Wear Away", "Wear Away"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, { "battlefield": ["Sol Ring", "Arcane Signet"] } ],
   "steps": [ { "cast": "Unchecked Growth", "targets": ["Sol Ring", "Arcane Signet", "Grizzly Bears"], "answers": [true, true] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Wear Away", "Wear Away"], "graveyard": ["Unchecked Growth"] }, { "battlefield_lacks": ["Sol Ring", "Arcane Signet"] } ] } }
