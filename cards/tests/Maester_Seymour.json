[
  {
    "name": "beginning of combat puts counters equal to its power on another creature you control",
    "players": [
      { "battlefield": ["Maester Seymour", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 1 } },
      "pt": { "Grizzly Bears": [3, 3] }
    }
  },
  {
    "name": "no other creature to target: beginning of combat does nothing",
    "players": [
      { "battlefield": ["Maester Seymour"] },
      {}
    ],
    "steps": [
      { "advance_to": "BeginCombat" }
    ],
    "expect": {
      "pt": { "Maester Seymour": [1, 3] }
    }
  },
  {
    "name": "monstrosity X counts the +1/+1 counters among creatures you control",
    "players": [
      { "battlefield": ["Maester Seymour", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }, "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Maester Seymour", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Maester Seymour": { "p1p1": 2 } },
      "pt": { "Maester Seymour": [3, 5] }
    }
  },
  {
    "name": "ruling: monstrosity does nothing if the creature is already monstrous",
    "players": [
      { "battlefield": ["Maester Seymour", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }, "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Maester Seymour", "ability": 0 },
      { "resolve": true },
      { "activate": "Maester Seymour", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Maester Seymour": { "p1p1": 2 } },
      "pt": { "Maester Seymour": [3, 5] }
    }
  }
]
