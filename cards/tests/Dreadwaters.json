[
  {
    "name": "mills a player for the number of lands you control",
    "players": [
      { "hand": ["Dreadwaters"], "battlefield": ["Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Dreadwaters", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Dreadwaters"] },
        { "library_count": 16 }
      ]
    }
  },
  {
    "name": "only lands count",
    "players": [
      { "hand": ["Dreadwaters"], "battlefield": ["Island", "Island", "Island", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Dreadwaters", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {},
        { "library_count": 16 }
      ]
    }
  },
  {
    "name": "can target yourself",
    "players": [
      { "hand": ["Dreadwaters"], "battlefield": ["Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Dreadwaters", "targets": ["p0"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "library_count": 16 },
        { "library_count": 20 }
      ]
    }
  },
  {
    "name": "ruling: X is counted when Dreadwaters resolves (a land destroyed in response reduces the mill)",
    "players": [
      { "hand": ["Dreadwaters"], "battlefield": ["Island", "Island", "Island", "Plains"] },
      { "hand": ["Smashing Success"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Dreadwaters", "targets": ["p1"] },
      { "pass": true },
      { "player": 1, "cast": "Smashing Success", "targets": ["Plains"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Plains"], "graveyard_has": ["Dreadwaters"] },
        { "library_count": 17 }
      ]
    }
  }
]
