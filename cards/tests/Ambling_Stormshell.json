[
  {
    "name": "attack puts three stun counters and draws three",
    "players": [
      {
        "battlefield": [
          "Ambling Stormshell"
        ]
      },
      {}
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Ambling Stormshell",
            "at": "p1"
          }
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 3
        },
        {}
      ],
      "counters": {
        "Ambling Stormshell": {
