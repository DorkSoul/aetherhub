  {
    "name": "ward {2}: opponent has only 2 Swamps, cannot pay, Doom Blade is countered",
    "players": [ { "battlefield": ["Ambling Stormshell"] }, { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Doom Blade", "player": 1, "targets": ["Ambling Stormshell"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ambling Stormshell"] }, { "graveyard_has": ["Doom Blade"] } ] }
  },
  {
    "name": "ward {2}: opponent pays 2 with spare mana, Doom Blade destroys it",
    "players": [ { "battlefield": ["Ambling Stormshell"] }, { "hand": ["Doom Blade"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] } ],
    "steps": [ { "pass": true }, { "cast": "Doom Blade", "player": 1, "targets": ["Ambling Stormshell"] }, { "resolve": true, "auto": true } ],
