        }
      },
      "tapped": {
        "Ambling Stormshell": true
      }
    }
  },
  {
    "name": "casting a Turtle untaps it",
    "players": [
      {
        "hand": [
          "Horned Turtle"
        ],
        "battlefield": [
          {
            "name": "Ambling Stormshell",
            "tapped": true
          },
          "Island",
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Horned Turtle"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Ambling Stormshell": false
      }
    }
  },
  {
    "name": "casting a non-Turtle does not untap it",
    "players": [
      {
        "hand": [
          "Grizzly Bears"
        ],
        "battlefield": [
          {
            "name": "Ambling Stormshell",
            "tapped": true
          },
          "Forest",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Grizzly Bears"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Ambling Stormshell": true
      }
    }
