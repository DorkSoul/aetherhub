[
  { "name": "investigates and gets +1/+1 per Clue you control",
    "players": [ { "hand": ["Confront the Unknown"], "battlefield": ["Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Confront the Unknown", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Clue"], "graveyard": ["Confront the Unknown"] }, {} ], "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "counts every Clue you control, including ones already there",
    "players": [ { "hand": ["Confront the Unknown"], "battlefield": ["Forest", "Clue", "Clue"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Confront the Unknown", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [5, 5] } } },
  { "name": "Clues an opponent controls do not count",
    "players": [ { "hand": ["Confront the Unknown"], "battlefield": ["Forest"] }, { "battlefield": ["Grizzly Bears", "Clue", "Clue"] } ],
    "steps": [ { "cast": "Confront the Unknown", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [3, 3] } } },
  { "name": "ruling: if the only target becomes illegal in response, the spell does not resolve and no Clue is created",
    "players": [ { "hand": ["Confront the Unknown"], "battlefield": ["Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] } ],
    "steps": [ { "cast": "Confront the Unknown", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Clue"], "graveyard": ["Confront the Unknown"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } }
]
