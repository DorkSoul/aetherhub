[
  {
    "name": "casting a creature spell deals 1 damage to the chosen player",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Furious Assault", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Grizzly Bears"] }, { "life": 19 }]
    }
  },
  {
    "name": "a noncreature spell does not trigger it",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Furious Assault", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Lightning Bolt"] }, { "life": 17 }]
    }
  },
  {
    "name": "ruling: each creature spell can target a different player",
    "players": [
      { "hand": ["Grizzly Bears", "Grizzly Bears"], "battlefield": ["Furious Assault", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Grizzly Bears", "targets": ["p0"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "life": 19 }, { "life": 19 }]
    }
  }
]
