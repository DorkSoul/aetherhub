[
  { "name": "when it dies, earthbend 2 onto a land you control",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Earth Village Ruffians", "Mountain", "Plains"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Earth Village Ruffians"] },
      { "resolve": true, "targets": ["Plains"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Earth Village Ruffians", "Lightning Bolt"] }, {} ],
      "pt": { "Plains": [2, 2] },
      "keywords": { "Plains": ["Haste"] },
      "counters": { "Plains": { "p1p1": 2 } }
    }
  },
  { "name": "an earthbent land that dies returns to the battlefield tapped",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Earth Village Ruffians", "Mountain", "Mountain", "Plains"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Earth Village Ruffians"] },
      { "resolve": true, "targets": ["Plains"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Plains"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Plains"] }, {} ],
      "tapped": { "Plains": true }
    }
  },
  { "name": "ruling: earthbend on a land that is already a creature adds two more counters (base still 0/0)",
    "players": [ { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Earth Village Ruffians", "Earth Village Ruffians", "Mountain", "Mountain", "Plains"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Earth Village Ruffians"] },
      { "resolve": true, "targets": ["Plains"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Earth Village Ruffians"] },
      { "resolve": true, "targets": ["Plains"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Plains"] }, {} ],
      "pt": { "Plains": [4, 4] },
      "counters": { "Plains": { "p1p1": 4 } }
    }
  },
  { "name": "ruling: an earthbent Forest keeps its mana ability and can pay for a spell",
    "players": [ { "hand": ["Lightning Bolt", "Giant Growth"], "battlefield": ["Earth Village Ruffians", "Mountain", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Earth Village Ruffians"] },
      { "resolve": true, "targets": ["Forest"] },
      { "resolve": true },
      { "cast": "Giant Growth", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Giant Growth"], "battlefield_has": ["Forest"] }, {} ],
      "tapped": { "Forest": true },
      "pt": { "Grizzly Bears": [5, 5] }
    }
  },
  { "name": "ruling: an earthbent land returned to hand by bounce does not come back to the battlefield",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Earth Village Ruffians", "Mountain", "Forest"] }, { "hand": ["Unsummon"], "battlefield": ["Island"] } ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Earth Village Ruffians"] },
      { "resolve": true, "targets": ["Forest"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Unsummon", "player": 1, "targets": ["Forest"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "hand": ["Forest"], "battlefield_lacks": ["Forest"] }, { "graveyard_has": ["Unsummon"] } ]
    }
  }
]
