[
 {
  "name": "a permanent you control that would die is exiled and returns at the next end step",
  "players": [
   {
    "hand": [
     "Cosmic Intervention",
     "Lightning Bolt"
    ],
    "battlefield": [
     "Grizzly Bears",
     "Plains",
     "Plains",
     "Plains",
     "Plains",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Cosmic Intervention"
   },
   {
    "resolve": true
   },
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_lacks": [
      "Grizzly Bears"
     ],
     "exile": [
      "Grizzly Bears"
     ],
     "graveyard": [
      "Cosmic Intervention",
      "Lightning Bolt"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "the exiled permanent comes back at the beginning of the end step",
  "players": [
   {
    "hand": [
     "Cosmic Intervention",
     "Lightning Bolt"
    ],
    "battlefield": [
     "Grizzly Bears",
     "Plains",
     "Plains",
     "Plains",
     "Plains",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Cosmic Intervention"
   },
   {
    "resolve": true
   },
   {
    "cast": "Lightning Bolt",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Grizzly Bears"
     ],
     "exile": []
    },
    {}
   ]
  }
 },
 {
