[
  { "name": "discover 4 casts the revealed nonland card for free",
    "players": [ { "battlefield": ["Hidden Volcano", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Lightning Bolt", "Forest"] }, { } ],
    "steps": [ { "activate": "Hidden Volcano", "ability": 0 }, { "resolve": true, "answers": [true, "p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Hidden Volcano", "Lightning Bolt"] }, {} ] } },
  { "name": "enters tapped",
    "players": [ { "hand": ["Hidden Volcano"] }, {} ],
    "steps": [ { "play_land": "Hidden Volcano" } ],
    "expect": { "players": [ { "battlefield_has": ["Hidden Volcano"] }, {} ], "tapped": { "Hidden Volcano": true } } },
  { "name": "ruling: discover may put the revealed card into hand instead of casting it",
    "players": [ { "battlefield": ["Hidden Volcano", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Lightning Bolt", "Forest"] }, { } ],
    "steps": [ { "activate": "Hidden Volcano", "ability": 0 }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Lightning Bolt"], "graveyard": ["Hidden Volcano"] }, {} ] } },
  { "name": "ruling: a revealed nonland card above mana value 4 goes to the bottom and discovery continues to the next",
    "players": [ { "battlefield": ["Hidden Volcano", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Serra Angel", "Lightning Bolt"] }, { } ],
    "steps": [ { "activate": "Hidden Volcano", "ability": 0 }, { "resolve": true, "answers": [true, "p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand": [], "graveyard": ["Hidden Volcano", "Lightning Bolt"], "library_count": 21 }, { "life": 17 } ] } },
  { "name": "ruling: a discovered card with no legal target cannot be cast and goes to hand",
    "players": [ { "battlefield": ["Hidden Volcano", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Pacifism", "Forest"] }, { } ],
    "steps": [ { "activate": "Hidden Volcano", "ability": 0 }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ { "hand": ["Pacifism"], "graveyard": ["Hidden Volcano"] }, {} ] } }
]
