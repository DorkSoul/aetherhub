[
 {"name": "casting an instant may draw then discard",
  "players": [{"hand": ["Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Windrider Wizard"]}, {}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true, "answers": [true, "Forest"]}],
  "expect": {"players": [{"hand_count": 1, "graveyard_has": ["Forest", "Lightning Bolt"]}, {"life": 17}]}},
 {"name": "declining the optional draw leaves the hand alone",
  "players": [{"hand": ["Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Windrider Wizard"]}, {}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true, "answers": [false]}],
  "expect": {"players": [{"hand": ["Forest"], "library_count": 20}, {"life": 17}]}},
 {"name": "a non-Wizard creature spell does not trigger",
  "players": [{"hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Windrider Wizard"]}, {}],
  "steps": [{"cast": "Grizzly Bears"}, {"resolve": true}],
  "expect": {"players": [{"hand_count": 0, "library_count": 20}, {}]}},
 {"name": "casting another Wizard creature spell triggers the draw then discard",
  "players": [{"hand": ["Windrider Wizard", "Forest"], "battlefield": ["Island", "Island", "Island", "Windrider Wizard"]}, {}],
  "steps": [{"cast": "Windrider Wizard"}, {"resolve": true, "answers": [true, "Forest"]}],
  "expect": {"players": [{"hand_count": 1, "library_count": 19, "graveyard_has": ["Forest"], "battlefield_has": ["Windrider Wizard"]}, {}]}},
 {"name": "the cast trigger still draws and discards when the Bolt it triggered on is countered",
  "players": [{"hand": ["Lightning Bolt", "Forest"], "battlefield": ["Mountain", "Windrider Wizard"]}, {"hand": ["Counterspell"], "battlefield": ["Island", "Island"]}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"pass": true}, {"cast": "Counterspell", "player": 1, "targets": [{"stack": "Lightning Bolt"}]}, {"resolve": true, "answers": [true, "Forest"]}],
  "expect": {"players": [{"hand_count": 1, "library_count": 19, "graveyard_has": ["Forest", "Lightning Bolt"]}, {"life": 20, "graveyard_has": ["Counterspell"]}]}},
 {"name": "ruling: Relic Amulet is Wizard-themed but not a Wizard spell, so casting it does not trigger the draw",
  "players": [{"hand": ["Relic Amulet", "Forest"], "battlefield": ["Forest", "Forest", "Windrider Wizard"]}, {}],
  "steps": [{"cast": "Relic Amulet"}, {"resolve": true}],
  "expect": {"players": [{"hand": ["Forest"], "library_count": 20, "battlefield_has": ["Relic Amulet", "Windrider Wizard"]}, {}]}}
