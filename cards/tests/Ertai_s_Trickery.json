[
  {
    "name": "counters a kicked spell",
    "players": [
      {
        "hand": ["Burst Lightning"],
        "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {
        "hand": ["Ertai's Trickery"],
        "battlefield": ["Island"]
      }
    ],
    "steps": [
      { "cast": "Burst Lightning", "targets": ["p1"], "answers": [true] },
      { "cast": "Ertai's Trickery", "player": 1, "targets": [{ "stack": "Burst Lightning" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Burst Lightning"] },
        { "graveyard": ["Ertai's Trickery"], "life": 20 }
      ]
    }
  },
  {
    "name": "does not counter an unkicked spell: it resolves normally",
    "players": [
      {
        "hand": ["Burst Lightning"],
        "battlefield": ["Mountain", "Mountain"]
      },
      {
        "hand": ["Ertai's Trickery"],
        "battlefield": ["Island"]
      }
    ],
    "steps": [
      { "cast": "Burst Lightning", "targets": ["p1"] },
      { "cast": "Ertai's Trickery", "player": 1, "targets": [{ "stack": "Burst Lightning" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Burst Lightning"] },
        { "graveyard": ["Ertai's Trickery"], "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: an unkicked creature spell can be targeted but is not countered",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest"] },
      { "hand": ["Ertai's Trickery"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "cast": "Ertai's Trickery", "player": 1, "targets": [{ "stack": "Grizzly Bears" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "graveyard": ["Ertai's Trickery"], "life": 20 } ]
    }
  }
]
