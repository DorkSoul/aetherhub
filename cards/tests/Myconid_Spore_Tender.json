[
  {
    "name": "ETB destroys target artifact",
    "players": [
      { "hand": ["Myconid Spore Tender"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Sol Ring", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Myconid Spore Tender" },
      { "resolve": true, "targets": ["Sol Ring"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Myconid Spore Tender"] },
        { "graveyard_has": ["Sol Ring"], "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "no artifact or enchantment to target: trigger does nothing",
    "players": [
      { "hand": ["Myconid Spore Tender"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Myconid Spore Tender" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Myconid Spore Tender"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
