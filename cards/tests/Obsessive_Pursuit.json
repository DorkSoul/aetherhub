[
  {
    "name": "entering loses 1 life and creates a Clue",
    "players": [
      {
        "hand": [
          "Obsessive Pursuit"
        ],
        "battlefield": [
          "Swamp",
          "Swamp"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Obsessive Pursuit"
      },
      {
        "resolve": true,
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 19,
          "battlefield_has": [
            "Obsessive Pursuit",
            "Clue"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "your upkeep: lose 1 life and create a Clue",
    "players": [ { "battlefield": ["Obsessive Pursuit", "Swamp"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "life": 19, "battlefield_has": ["Clue"] }, {} ] }
  },
  {
    "name": "opponent's upkeep does not trigger it",
    "players": [ { "battlefield": ["Obsessive Pursuit", "Swamp"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "players": [ { "life": 20, "battlefield_lacks": ["Clue"] }, {} ] }
  },
  {
    "name": "attack with three sacrifices this turn: X=3 counters and lifelink",
    "players": [ { "battlefield": ["Obsessive Pursuit", "Grizzly Bears", "Clue", "Clue", "Clue", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "activate": "Clue", "ability": 0 }, { "resolve": true },
      { "activate": "Clue", "ability": 0 }, { "resolve": true },
      { "activate": "Clue", "ability": 0 }, { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 3 } },
      "pt": { "Grizzly Bears": [5, 5] },
      "keywords": { "Grizzly Bears": ["Lifelink"] },
      "players": [ { "life": 25 }, { "life": 15 } ]
    }
  },
  {
    "name": "attack with two sacrifices this turn: X=2 counters and no lifelink",
    "players": [ { "battlefield": ["Obsessive Pursuit", "Grizzly Bears", "Clue", "Clue", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "activate": "Clue", "ability": 0 }, { "resolve": true },
      { "activate": "Clue", "ability": 0 }, { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "pt": { "Grizzly Bears": [4, 4] },
      "players": [ { "life": 20 }, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: a Clue is sacrificed for {2} to draw a card",
    "players": [ { "battlefield": ["Clue", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "activate": "Clue", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 1, "battlefield_lacks": ["Clue"] }, {} ] }
  },
  {
    "name": "ruling: the Clue made by Obsessive Pursuit is not an investigate, so Erdwal Illuminator adds no second Clue",
    "players": [ { "hand": ["Obsessive Pursuit"], "battlefield": ["Erdwal Illuminator", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Obsessive Pursuit" },
      { "resolve": true, "auto": true },
      { "activate": "Clue", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 19, "hand_count": 1, "battlefield_lacks": ["Clue"] }, {} ] }
  }
]
