[
  {
    "name": "opponent keeps up to two creatures and sacrifices the rest at their end step",
    "players": [
      { "battlefield": ["Archfiend of Depravity"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant", "Llanowar Elves"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "End", "answers": [["Grizzly Bears", "Hill Giant"]] }
    ],
    "expect": {
      "turn": 2,
      "players": [
        { "battlefield": ["Archfiend of Depravity"] },
        { "battlefield": ["Grizzly Bears", "Hill Giant"], "graveyard": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "opponent may keep no creatures and sacrifices all of them",
    "players": [
      { "battlefield": ["Archfiend of Depravity"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "End", "answers": [[]] }
    ],
    "expect": {
      "turn": 2,
      "players": [
        { "battlefield": ["Archfiend of Depravity"] },
        { "battlefield": [], "graveyard": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "opponent with two creatures keeps both when choosing two",
    "players": [
      { "battlefield": ["Archfiend of Depravity"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "End", "answers": [["Grizzly Bears", "Hill Giant"]] }
    ],
    "expect": {
      "turn": 2,
      "players": [
        { "battlefield": ["Archfiend of Depravity"] },
        { "battlefield": ["Grizzly Bears", "Hill Giant"], "graveyard": [] }
      ]
    }
  },
  {
    "name": "no trigger on your own end step",
    "players": [
      { "battlefield": ["Archfiend of Depravity", "Grizzly Bears", "Hill Giant", "Llanowar Elves"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" }
    ],
    "expect": {
      "turn": 1,
      "players": [
        { "battlefield": ["Archfiend of Depravity", "Grizzly Bears", "Hill Giant", "Llanowar Elves"] },
        { "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "only the opponent's own creatures are chosen and sacrificed",
    "players": [
      { "battlefield": ["Archfiend of Depravity", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant", "Llanowar Elves"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "End", "answers": [["Hill Giant"]] }
    ],
    "expect": {
      "turn": 2,
      "players": [
        { "battlefield": ["Archfiend of Depravity", "Grizzly Bears"] },
        { "battlefield": ["Hill Giant"], "graveyard": ["Llanowar Elves"] }
      ]
    }
  },
  {
    "name": "ruling: the opponent's choice doesn't target, so a hexproof creature can be spared",
    "players": [
      { "battlefield": ["Archfiend of Depravity"] },
      { "battlefield": ["Troll Ascetic", "Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "End", "answers": [["Troll Ascetic"]] }
    ],
    "expect": {
      "turn": 2,
      "players": [
        { "battlefield": ["Archfiend of Depravity"] },
        { "battlefield": ["Troll Ascetic"], "graveyard": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  }
]
