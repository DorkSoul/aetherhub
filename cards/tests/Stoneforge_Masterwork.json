[
  {
    "name": "equipped creature gets +1/+1 for each other creature sharing a creature type",
    "players": [
      { "battlefield": ["Stoneforge Masterwork", "Forest", "Forest", "Llanowar Elves", "Elvish Mystic", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Stoneforge Masterwork", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Llanowar Elves": [2, 2], "Elvish Mystic": [1, 1], "Grizzly Bears": [2, 2] },
      "attached": { "Stoneforge Masterwork": "Llanowar Elves" }
    }
  },
  {
    "name": "no creature sharing a type gives no bonus",
    "players": [
      { "battlefield": ["Stoneforge Masterwork", "Forest", "Forest", "Grizzly Bears", "Llanowar Elves"] },
      {}
    ],
    "steps": [
      { "activate": "Stoneforge Masterwork", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Grizzly Bears": [2, 2], "Llanowar Elves": [1, 1] },
      "attached": { "Stoneforge Masterwork": "Grizzly Bears" }
    }
  },
  {
    "name": "opponent's creatures sharing a type do not count",
    "players": [
      { "battlefield": ["Stoneforge Masterwork", "Forest", "Forest", "Llanowar Elves"] },
      { "battlefield": ["Elvish Mystic"] }
    ],
    "steps": [
      { "activate": "Stoneforge Masterwork", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Llanowar Elves": [1, 1], "Elvish Mystic": [1, 1] }
    }
  },
  {
    "name": "ruling: the bonus is +1/+1 per creature, not per shared type (two Elvish Mystics sharing both types with the Elf Druid give +2)",
    "players": [
      { "battlefield": ["Stoneforge Masterwork", "Forest", "Forest", "Llanowar Elves", "Elvish Mystic", "Elvish Mystic"] },
      {}
    ],
    "steps": [
      { "activate": "Stoneforge Masterwork", "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Llanowar Elves": [3, 3], "Elvish Mystic": [1, 1] }
    }
  },
  {
    "name": "ruling: the bonus changes as creatures change (Bolt on the Mystic drops the equipped Elf back to 1/1)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Stoneforge Masterwork", "Forest", "Forest", "Mountain", "Llanowar Elves", "Elvish Mystic"] },
      {}
    ],
    "steps": [
      { "activate": "Stoneforge Masterwork", "targets": ["Llanowar Elves"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["Elvish Mystic"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Llanowar Elves": [1, 1] },
      "attached": { "Stoneforge Masterwork": "Llanowar Elves" }
    }
  }
]
