[
  { "name": "gets +2/+0 until end of turn",
    "players": [ { "hand": ["Blessed Defiance"], "battlefield": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Blessed Defiance", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "pt": { "Grizzly Bears": [4, 2] }, "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "gains lifelink: its combat damage gains life",
    "players": [ { "hand": ["Blessed Defiance"], "battlefield": ["Plains", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Blessed Defiance", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 24 }, { "life": 16 } ] } },
  { "name": "when it dies this turn, create a 1/1 flying Spirit",
    "players": [ { "hand": ["Blessed Defiance", "Shock"], "battlefield": ["Plains", "Mountain", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Blessed Defiance", "targets": ["Grizzly Bears"] }, { "resolve": true },
               { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Spirit"], "graveyard_has": ["Shock", "Grizzly Bears"] }, {} ] } },
  { "name": "another creature dying does not make a Spirit",
    "players": [ { "hand": ["Blessed Defiance", "Shock"], "battlefield": ["Plains", "Mountain", "Grizzly Bears"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Blessed Defiance", "targets": ["p0:Grizzly Bears"] }, { "resolve": true },
               { "cast": "Shock", "targets": ["p1:Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Spirit"], "battlefield_has": ["Grizzly Bears"] },
                             { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "only a creature you control can be targeted",
    "players": [ { "hand": ["Blessed Defiance"], "battlefield": ["Plains"] },
                 { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Blessed Defiance", "targets": ["p1:Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Blessed Defiance"] }, {} ] } }
]
