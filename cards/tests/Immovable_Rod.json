[
 { "name": "the target loses all abilities while Immovable Rod stays tapped",
   "players": [ { "battlefield": ["Immovable Rod", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Shore Snapper", "Island"] } ],
   "steps": [ { "activate": "Immovable Rod", "ability": 0, "targets": ["Shore Snapper"] }, { "resolve": true }, { "pass": true },
              { "activate": "Shore Snapper", "ability": 0, "player": 1, "illegal": true } ],
   "expect": { "tapped": { "Immovable Rod": true, "Shore Snapper": false } } },
 { "name": "the target regains its abilities once Immovable Rod untaps at its controller's untap step",
   "players": [ { "battlefield": ["Immovable Rod", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Shore Snapper", "Island"] } ],
   "steps": [ { "activate": "Immovable Rod", "ability": 0, "targets": ["Shore Snapper"] }, { "resolve": true }, { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep", "answers": [false], "auto": true }, { "pass": true },
              { "activate": "Shore Snapper", "ability": 0, "player": 1 } ],
   "expect": { "turn": 3, "tapped": { "Immovable Rod": false } } },
 { "name": "choosing not to untap Immovable Rod keeps the target without abilities",
   "players": [ { "battlefield": ["Immovable Rod", "Plains", "Plains", "Plains", "Plains"] }, { "battlefield": ["Shore Snapper", "Island"] } ],
   "steps": [ { "activate": "Immovable Rod", "ability": 0, "targets": ["Shore Snapper"] }, { "resolve": true }, { "advance_to": "Upkeep" },
              { "advance_to": "Upkeep", "answers": [true], "auto": true }, { "pass": true },
              { "activate": "Shore Snapper", "ability": 0, "player": 1, "illegal": true } ],
   "expect": { "turn": 3, "tapped": { "Immovable Rod": true } } },
 { "name": "ruling: an Equipment that loses its abilities stays attached to the creature it equips",
   "players": [ { "battlefield": ["Immovable Rod", "Adventuring Gear", "Grizzly Bears", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "activate": "Adventuring Gear", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "activate": "Immovable Rod", "ability": 0, "targets": ["Adventuring Gear"] }, { "resolve": true } ],
   "expect": { "tapped": { "Immovable Rod": true }, "attached": { "Adventuring Gear": "Grizzly Bears" } } }
]
