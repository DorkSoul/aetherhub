[
 {
  "name": "may remove a counter from target permanent",
  "players": [
   { "hand": ["Medicine Runner"], "battlefield": ["Forest", "Plains"] },
   { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } } ] }
  ],
  "steps": [
   { "cast": "Medicine Runner" },
   { "resolve": true, "targets": ["Grizzly Bears"], "answers": [true] }
  ],
  "expect": {
   "counters": { "Grizzly Bears": { "p1p1": 0 } }
  }
 },
 {
  "name": "declining the may leaves the counter in place",
  "players": [
   { "hand": ["Medicine Runner"], "battlefield": ["Forest", "Plains"] },
   { "battlefield": [ { "name": "Grizzly Bears", "counters": { "p1p1": 1 } } ] }
  ],
  "steps": [
   { "cast": "Medicine Runner" },
   { "resolve": true, "targets": ["Grizzly Bears"], "answers": [false] }
  ],
  "expect": {
   "counters": { "Grizzly Bears": { "p1p1": 1 } }
  }
 },
 {
  "name": "ruling: a permanent without a counter may still be targeted",
  "players": [
   { "hand": ["Medicine Runner"], "battlefield": ["Forest", "Plains"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Medicine Runner" },
   { "resolve": true, "targets": ["Grizzly Bears"], "answers": [true] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Medicine Runner"] },
    { "battlefield_has": ["Grizzly Bears"] }
   ],
   "pt": { "Grizzly Bears": [2, 2] }
  }
 },
 {
  "name": "ruling: removes a counter of any kind, here a -1/-1 counter",
  "players": [
   { "hand": ["Medicine Runner"], "battlefield": ["Forest", "Plains"] },
   { "battlefield": [ { "name": "Grizzly Bears", "counters": { "m1m1": 1 } } ] }
  ],
  "steps": [
   { "cast": "Medicine Runner" },
   { "resolve": true, "targets": ["Grizzly Bears"], "answers": [true] }
  ],
  "expect": {
   "counters": { "Grizzly Bears": { "m1m1": 0 } },
   "pt": { "Grizzly Bears": [2, 2] }
  }
 }
]
