[
  {
    "name": "deals 3 damage with no artifacts",
    "players": [
      { "hand": ["Welding Sparks"], "battlefield": ["Mountain", "Mountain", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Welding Sparks", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Welding Sparks"] },
        { "graveyard_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "adds 1 damage for each artifact you control",
    "players": [
      { "hand": ["Welding Sparks"], "battlefield": ["Mountain", "Mountain", "Island", "Sol Ring"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Welding Sparks", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Welding Sparks"] },
        { "graveyard_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "3 damage does not kill a 4-toughness creature without artifacts",
    "players": [
      { "hand": ["Welding Sparks"], "battlefield": ["Mountain", "Mountain", "Island"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Welding Sparks", "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Welding Sparks"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling: artifacts are counted on resolution: sacrificing the only artifact in response leaves 3 damage",
    "players": [
      { "hand": ["Welding Sparks"], "battlefield": ["Mountain", "Mountain", "Island", "Island", "Furnace Skullbomb"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Welding Sparks", "targets": ["Serra Angel"] },
      { "activate": "Furnace Skullbomb", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Welding Sparks", "Furnace Skullbomb"] },
        { "battlefield_has": ["Serra Angel"] }
      ]
    }
  },
  {
    "name": "ruling: with no artifacts Welding Sparks deals exactly 3 (kills a 3-toughness Hill Giant)",
    "players": [
      { "hand": ["Welding Sparks"], "battlefield": ["Mountain", "Mountain", "Island"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Welding Sparks", "targets": ["Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Welding Sparks"] },
        { "graveyard_has": ["Hill Giant"] }
      ]
    }
  }
]
