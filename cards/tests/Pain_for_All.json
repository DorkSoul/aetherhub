[
  { "name": "ETB: enchanted creature deals damage equal to its power to another target",
    "players": [ { "hand": ["Pain for All"], "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Pain for All", "targets": ["Hill Giant"] }, { "resolve": true, "targets": ["Grizzly Bears"] } ],
    "expect": { "players": [ { "battlefield_has": ["Hill Giant", "Pain for All"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "enchanted creature dealt damage: that much damage to each opponent",
    "players": [ { "hand": ["Pain for All", "Lightning Strike"], "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Pain for All", "targets": ["Hill Giant"] }, { "resolve": true, "targets": ["Grizzly Bears"] },
               { "cast": "Lightning Strike", "targets": ["Hill Giant"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Hill Giant", "Pain for All", "Lightning Strike"] }, { "life": 17 } ] } },
  { "name": "ruling: two blockers damage the enchanted creature at once; one trigger for the total",
    "players": [ { "hand": ["Pain for All"], "battlefield": ["Hill Giant", "Mountain", "Mountain", "Mountain"] }, { "life": 20, "battlefield": ["Serra Angel", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Pain for All", "targets": ["Hill Giant"] }, { "resolve": true, "targets": ["p1"] },
               { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
               { "block": [ { "blocker": "Serra Angel", "attacker": "Hill Giant" }, { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 11 } ] } }
]
