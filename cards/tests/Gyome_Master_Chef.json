[
  { "name": "end step: one Food per nontoken creature entered, tokens excluded",
    "players": [ { "hand": ["Raise the Alarm", "Grizzly Bears"], "battlefield": ["Gyome, Master Chef", "Plains", "Plains", "Forest", "Forest"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Grizzly Bears" }, { "resolve": true }, { "cast": "Raise the Alarm" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Gyome, Master Chef","Plains","Plains","Forest","Forest","Grizzly Bears","Soldier","Soldier","Food"] }, {} ] } },
  { "name": "no creature entered: no Food",
    "players": [ { "battlefield": ["Gyome, Master Chef"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Gyome, Master Chef"] }, {} ] } },
  { "name": "Food sacrifice and {1}: target creature gains indestructible and is tapped",
    "players": [ { "battlefield": ["Gyome, Master Chef", "Forest", "Food", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Gyome, Master Chef", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "keywords": { "Grizzly Bears": ["Indestructible"] }, "tapped": { "Grizzly Bears": true }, "players": [ { "battlefield_lacks": ["Food"] }, {} ] } },
  { "name": "no mana: the Food ability cannot be activated",
    "players": [ { "battlefield": ["Gyome, Master Chef", "Food", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Gyome, Master Chef", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Food"] }, {} ] } },
  { "name": "ruling: a nontoken creature that entered this turn still counts for the end-step Food after it dies",
    "players": [ { "hand": ["Grizzly Bears", "Lightning Bolt"], "battlefield": ["Gyome, Master Chef", "Forest", "Forest", "Mountain"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Grizzly Bears" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Gyome, Master Chef", "Forest", "Forest", "Mountain", "Food"], "graveyard_has": ["Grizzly Bears"] }, {} ] } },
  { "name": "ruling: Gyome counts itself when it enters this turn: one Food at the end step",
    "players": [ { "hand": ["Gyome, Master Chef"], "battlefield": ["Swamp", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [ { "advance_to": "Main1" }, { "advance_to": "Main1" }, { "cast": "Gyome, Master Chef" }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "battlefield": ["Gyome, Master Chef", "Swamp", "Forest", "Plains", "Plains", "Food"] }, {} ] } },
  { "name": "ruling: the Food ability can target a creature that is already tapped",
    "players": [ { "battlefield": ["Gyome, Master Chef", "Forest", "Food", { "name": "Grizzly Bears", "tapped": true }] }, {} ],
    "steps": [ { "activate": "Gyome, Master Chef", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "keywords": { "Grizzly Bears": ["Indestructible"] }, "tapped": { "Grizzly Bears": true }, "players": [ { "battlefield_lacks": ["Food"] }, {} ] } },
  { "name": "ruling: one Food cannot pay for two abilities: Maraleaf Rider's sacrifice is illegal once Gyome's ability has sacrificed it",
    "players": [ { "battlefield": ["Gyome, Master Chef", "Maraleaf Rider", "Forest", "Forest", "Food", "Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Gyome, Master Chef", "ability": 0, "targets": ["Grizzly Bears"] }, { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Food"] }, {} ] } }
]
