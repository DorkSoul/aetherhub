[
  {
    "name": "counters a spell and makes an X/X Ooze where X is its mana value",
    "players": [
      {
        "hand": [
          "Mystic Genesis"
        ],
        "battlefield": [
          "Forest",
          "Island",
          "Island",
          "Plains",
          "Plains"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "p0"
        ]
      },
      {
        "cast": "Mystic Genesis",
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Ooze 2-2 Green"
          ],
          "graveyard_has": [
            "Mystic Genesis"
          ]
        },
        {
          "graveyard_has": [
            "Lightning Bolt"
          ]
        }
      ],
      "pt": {
        "Ooze 2-2 Green": [
          1,
          1
        ]
      }
    }
  },
  {
    "name": "countered spell does not resolve",
    "players": [
      {
        "hand": [
          "Mystic Genesis"
        ],
        "battlefield": [
          "Forest",
          "Island",
          "Island",
          "Plains",
          "Plains"
        ]
      },
      {
        "hand": [
          "Lightning Bolt"
        ],
        "battlefield": [
          "Mountain"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Lightning Bolt",
        "player": 1,
        "targets": [
          "p0"
        ]
      },
      {
        "cast": "Mystic Genesis",
        "targets": [
          {
            "stack": "Lightning Bolt"
          }
        ]
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 20
        },
        {
          "graveyard_has": [
            "Lightning Bolt"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: targeting a spell that can't be countered still makes the Ooze",
    "players": [
      { "hand": ["Mystic Genesis"], "battlefield": ["Forest", "Island", "Island", "Plains", "Plains"] },
      { "hand": ["Volcanic Fallout"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Volcanic Fallout", "player": 1 },
      { "cast": "Mystic Genesis", "targets": [ { "stack": "Volcanic Fallout" } ] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "battlefield_has": ["Ooze 2-2 Green"] },
        { "life": 18 }
      ],
      "pt": { "Ooze 2-2 Green": [3, 3] }
    }
  },
  {
    "name": "ruling: a Genesis whose target was already countered does not resolve, so no Ooze",
    "players": [
      { "hand": ["Mystic Genesis", "Mystic Genesis"], "battlefield": ["Forest", "Forest", "Island", "Island", "Island", "Island", "Plains", "Plains", "Plains", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "cast": "Mystic Genesis", "targets": [ { "stack": "Lightning Bolt" } ] },
      { "cast": "Mystic Genesis", "targets": [ { "stack": "Lightning Bolt" } ] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "battlefield": ["Forest", "Forest", "Island", "Island", "Island", "Island", "Plains", "Plains", "Plains", "Plains", "Ooze 2-2 Green"], "graveyard": ["Mystic Genesis", "Mystic Genesis"] },
        { "graveyard": ["Lightning Bolt"] }
      ],
      "pt": { "Ooze 2-2 Green": [1, 1] }
    }
  }
]
