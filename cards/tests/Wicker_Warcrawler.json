[
 {
  "name": "attacking puts a -1/-1 counter on it at end of combat",
  "players": [
   { "battlefield": ["Wicker Warcrawler"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Wicker Warcrawler", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "counters": { "Wicker Warcrawler": { "m1m1": 1 } },
   "pt": { "Wicker Warcrawler": [5, 5] }
  }
 },
 {
  "name": "blocking also puts a -1/-1 counter on it",
  "players": [
   { "battlefield": ["Grizzly Bears"] },
   { "battlefield": ["Wicker Warcrawler"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Wicker Warcrawler", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "counters": { "Wicker Warcrawler": { "m1m1": 1 } },
   "pt": { "Wicker Warcrawler": [5, 5] }
  }
 },
 {
  "name": "ruling: the -1/-1 counter comes after combat damage (unblocked attack still deals 6)",
  "players": [
   { "battlefield": ["Wicker Warcrawler"] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Wicker Warcrawler", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "life": 14 } ],
   "counters": { "Wicker Warcrawler": { "m1m1": 1 } },
   "pt": { "Wicker Warcrawler": [5, 5] }
  }
 }
]
