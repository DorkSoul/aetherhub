[
  {
    "name": "a Swamp entering returns it from the graveyard to hand",
    "players": [
      { "hand": ["Swamp"], "graveyard": ["Veilborn Ghoul"] },
      {}
    ],
    "steps": [
      { "play_land": "Swamp" },
      { "resolve": true, "answers": [true] }
    ],
    "expect": {
      "players": [ { "hand": ["Veilborn Ghoul"] }, {} ]
    }
  },
  {
    "name": "a non-Swamp land does not return it",
    "players": [
      { "hand": ["Plains"], "graveyard": ["Veilborn Ghoul"] },
      {}
    ],
    "steps": [
      { "play_land": "Plains" }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ { "graveyard": ["Veilborn Ghoul"] }, {} ]
    }
  },
  {
    "name": "can't block",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Veilborn Ghoul"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Veilborn Ghoul", "attacker": "Grizzly Bears" } ], "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "ruling: a Ghoul already on the battlefield does not trigger when a Swamp enters",
    "players": [
      { "hand": ["Swamp"], "battlefield": ["Veilborn Ghoul"] },
      {}
    ],
    "steps": [
      { "play_land": "Swamp" }
    ],
    "expect": {
      "stack_empty": true,
      "players": [ { "hand_count": 0, "battlefield_has": ["Veilborn Ghoul"] }, {} ]
    }
  }
]
