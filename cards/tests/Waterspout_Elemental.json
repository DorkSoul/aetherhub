  },
  {
    "name": "unkicked: no bounce",
    "players": [
      { "hand": ["Waterspout Elemental"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
