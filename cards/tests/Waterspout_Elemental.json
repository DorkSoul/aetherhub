        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: a copy entering as Clone is not kicked, so it does not bounce",
    "players": [
      { "hand": ["Waterspout Elemental", "Clone"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Waterspout Elemental", "answers": [true] },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Clone" },
      { "resolve": true, "answers": [0] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Waterspout Elemental", "Waterspout Elemental"], "hand_count": 0 },
        {}
      ]
    }
  },
  {
    "name": "ruling: a Waterspout returned by Animate Dead is not kicked, so nothing bounces",
    "players": [
      { "hand": ["Animate Dead"], "battlefield": ["Swamp", "Swamp", "Grizzly Bears"], "graveyard": ["Waterspout Elemental"] },
      { "battlefield": ["Hill Giant"] }
