    "steps": [
      { "cast": "Animate Dead", "targets": ["Waterspout Elemental"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Animate Dead", "Waterspout Elemental", "Grizzly Bears"] },
        { "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
