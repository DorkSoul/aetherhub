[
  { "name": "gain 3 life when the opponent has more life",
    "players": [ { "life": 14, "battlefield": ["Keeper of the Light", "Plains"] }, { "life": 20 } ],
    "steps": [ { "activate": "Keeper of the Light", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "life": 17 }, { "life": 20 } ], "tapped": { "Keeper of the Light": true } }
  },
  { "name": "opponent with less life is not a legal target",
    "players": [ { "life": 20, "battlefield": ["Keeper of the Light", "Plains"] }, { "life": 14 } ],
    "steps": [ { "activate": "Keeper of the Light", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "life": 20 }, { "life": 14 } ] }
  },
  {
    "name": "ruling: ability still resolves when the opponent no longer has more life",
    "players": [
      { "life": 14, "hand": ["Lightning Bolt"], "battlefield": ["Keeper of the Light", "Plains", "Mountain"] },
      { "life": 17 }
    ],
    "steps": [
      { "activate": "Keeper of the Light", "targets": ["p1"] },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [ { "life": 17 }, { "life": 14 } ] }
  }
]
