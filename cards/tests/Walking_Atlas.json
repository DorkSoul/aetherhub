[
  {
    "name": "puts a land from hand onto the battlefield, even after the land drop is used",
    "players": [
      {
        "hand": [
          "Forest",
          "Plains"
        ],
        "battlefield": [
          "Walking Atlas"
        ]
      },
      {}
    ],
    "steps": [
      {
        "play_land": "Plains"
      },
      {
        "activate": "Walking Atlas"
      },
