[
  {
    "name": "ETB search fetches a basic Plains Swamp or Forest into hand",
    "players": [
      { "hand": ["Abzan Monument"], "battlefield": ["Plains", "Plains"], "library": ["Island", "Swamp", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Abzan Monument" },
      { "resolve": true, "answers": ["Swamp"] }
    ],
    "expect": {
      "players": [
        { "hand": ["Swamp"], "battlefield_has": ["Abzan Monument"] },
        {}
      ]
    }
  },
  {
    "name": "ETB search finds nothing when no basic Plains Swamp or Forest is left",
    "players": [
      { "hand": ["Abzan Monument"], "battlefield": ["Plains", "Plains"], "library": ["Island", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Abzan Monument" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": [], "battlefield_has": ["Abzan Monument"] },
        {}
      ]
    }
  },
  {
    "name": "sacrifice: X/X Spirit where X is the greatest toughness among your creatures",
    "players": [
      { "battlefield": ["Abzan Monument", "Plains", "Swamp", "Forest", "Island", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "activate": "Abzan Monument" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Spirit 0-0 White", "Grizzly Bears"], "battlefield_lacks": ["Abzan Monument"], "graveyard_has": ["Abzan Monument"] },
        {}
      ],
      "pt": { "Spirit 0-0 White": [2, 2] }
    }
  },
  {
    "name": "sacrifice with no creatures: X is 0 so the Spirit dies",
    "players": [
      { "battlefield": ["Abzan Monument", "Plains", "Swamp", "Forest", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Abzan Monument" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Spirit 0-0 White", "Abzan Monument"], "graveyard_has": ["Abzan Monument"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: X counts only creatures you control, not the opponent's",
    "players": [
      { "battlefield": ["Abzan Monument", "Plains", "Swamp", "Forest", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Abzan Monument" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Spirit 0-0 White", "Abzan Monument"], "graveyard_has": ["Abzan Monument"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
