[
  {
    "name": "{T}: add {U}",
    "players": [ { "battlefield": ["Tolaria"] }, {} ],
    "steps": [ { "tap_for_mana": "Tolaria" } ],
    "expect": { "players": [ { "pool": { "U": 1 } }, {} ] }
  },
  {
    "name": "during upkeep a banding creature loses banding until end of turn",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Tolaria"] }, { "battlefield": ["Benalish Hero"] } ],
    "steps": [
      { "activate": "Tolaria", "ability": 0, "targets": ["Benalish Hero"] },
      { "resolve": true }
    ],
    "expect": { "keywords": { "Benalish Hero": [] }, "tapped": { "Tolaria": true } }
  },
  {
    "name": "the creature regains banding on the next turn",
    "start": "Upkeep",
    "players": [ { "battlefield": ["Tolaria"] }, { "battlefield": ["Benalish Hero"] } ],
    "steps": [
      { "activate": "Tolaria", "ability": 0, "targets": ["Benalish Hero"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": { "keywords": { "Benalish Hero": ["Banding"] } }
  },
  {
    "name": "cannot be activated outside an upkeep step",
    "players": [ { "battlefield": ["Tolaria"] }, { "battlefield": ["Benalish Hero"] } ],
    "steps": [ { "activate": "Tolaria", "ability": 0, "targets": ["Benalish Hero"], "illegal": true } ],
    "expect": { "keywords": { "Benalish Hero": ["Banding"] } }
  }
]
