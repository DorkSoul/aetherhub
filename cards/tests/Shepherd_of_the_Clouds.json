  }
 },
 {
  "name": "with a Mount, the card returns to the battlefield instead",
  "players": [
   { "hand": ["Shepherd of the Clouds"], "graveyard": ["Grizzly Bears"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Bridled Bighorn"] },
   {}
  ],
  "steps": [
   { "cast": "Shepherd of the Clouds" },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand": [], "graveyard": [], "battlefield_has": ["Shepherd of the Clouds", "Grizzly Bears", "Bridled Bighorn"] }, {} ]
  }
 },
 {
  "name": "with a Mount, a returned Aura enters attached to a creature you choose",
  "players": [
   { "hand": ["Shepherd of the Clouds"], "graveyard": ["Pacifism"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Bridled Bighorn"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Shepherd of the Clouds" },
   { "resolve": true, "answers": [1] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Pacifism", "Shepherd of the Clouds"] }, {} ],
   "attached": { "Pacifism": "Grizzly Bears" }
  }
 },
