[
 {
  "name": "without a Mount, returns the target permanent card from your graveyard to your hand",
  "players": [
   { "hand": ["Shepherd of the Clouds"], "graveyard": ["Grizzly Bears"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
