[
  {
    "name": "when it dies, create a 2/2 Detective token",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Museum Nightwatch"] }, {} ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Museum Nightwatch"] },
      { "resolve": true },
      { "resolve": true, "auto": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Detective"], "battlefield_lacks": ["Museum Nightwatch"] }, {} ], "pt": { "Detective": [2, 2] } }
  },
  {
    "name": "cast face down for {3} as a 2/2 with no abilities",
    "players": [ { "hand": ["Museum Nightwatch"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Museum Nightwatch", "alt": 254 }, { "resolve": true } ],
    "expect": { "pt": { "Museum Nightwatch": [2, 2] } }
  },
  {
    "name": "turn face up for the disguise cost",
    "players": [ { "hand": ["Museum Nightwatch"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Museum Nightwatch", "alt": 254 },
      { "resolve": true },
      { "activate": "Museum Nightwatch", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Museum Nightwatch": [3, 2] } }
  },
  {
    "name": "ruling: a face-down creature has ward {2}; Bolt is countered when its controller cannot pay",
    "players": [ { "hand": ["Museum Nightwatch"], "battlefield": ["Plains", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [
      { "cast": "Museum Nightwatch", "alt": 254 },
      { "resolve": true },
      { "advance_to": "Main1" },
      { "cast": "Lightning Bolt", "targets": ["Museum Nightwatch"], "player": 1 },
      { "resolve": true, "player": 1 }
    ],
    "expect": { "players": [ { "battlefield_has": ["Museum Nightwatch"], "battlefield_lacks": ["Detective"] }, { "graveyard_has": ["Lightning Bolt"] } ], "pt": { "Museum Nightwatch": [2, 2] } }
  },
  {
    "name": "ruling: disguise face up needs {1}{W}; with no mana left it stays a face-down 2/2",
    "players": [ { "hand": ["Museum Nightwatch"], "battlefield": ["Plains", "Plains", "Plains"] }, {} ],
    "steps": [
      { "cast": "Museum Nightwatch", "alt": 254 },
      { "resolve": true },
      { "activate": "Museum Nightwatch", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Museum Nightwatch": [2, 2] } }
  }
]
