[
 {
  "name": "three flyers attack: each player gains control of a permanent chosen by you from the player on their right",
  "players": [
   { "battlefield": ["Inniaz, the Gale Force", "Wind Drake", "Suntail Hawk"] },
   { "battlefield": ["Grizzly Bears", "Hill Giant", "Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Inniaz, the Gale Force", "at": "p1" }, { "card": "Wind Drake", "at": "p1" }, { "card": "Suntail Hawk", "at": "p1" } ] },
   { "resolve": true, "answers": ["Hill Giant", "Suntail Hawk"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant", "Inniaz, the Gale Force", "Wind Drake"], "battlefield_lacks": ["Suntail Hawk"] },
    { "battlefield_has": ["Suntail Hawk", "Grizzly Bears", "Forest"], "battlefield_lacks": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "only two flyers attack: nothing changes hands",
  "players": [
   { "battlefield": ["Inniaz, the Gale Force", "Wind Drake", "Suntail Hawk"] },
   { "battlefield": ["Grizzly Bears", "Hill Giant", "Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Inniaz, the Gale Force", "at": "p1" }, { "card": "Wind Drake", "at": "p1" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Suntail Hawk", "Inniaz, the Gale Force", "Wind Drake"], "battlefield_lacks": ["Hill Giant"] },
    { "battlefield_has": ["Hill Giant", "Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "activated ability gives attacking flyers +1/+1",
  "players": [
   { "battlefield": ["Inniaz, the Gale Force", "Wind Drake", "Island", "Island", "Island"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [ { "card": "Inniaz, the Gale Force", "at": "p1" }, { "card": "Wind Drake", "at": "p1" } ] },
   { "activate": "Inniaz, the Gale Force" },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Inniaz, the Gale Force": [5, 5], "Wind Drake": [3, 3] }
  }
 },
 {
  "name": "ruling: a stolen permanent stays with its new controller after the turn ends (control does not wear off at cleanup)",
  "players": [
   { "battlefield": ["Inniaz, the Gale Force", "Wind Drake", "Suntail Hawk"] },
   { "battlefield": ["Grizzly Bears", "Hill Giant", "Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Inniaz, the Gale Force", "at": "p1" }, { "card": "Wind Drake", "at": "p1" }, { "card": "Suntail Hawk", "at": "p1" } ] },
   { "resolve": true, "answers": ["Hill Giant", "Suntail Hawk"] },
   { "advance_to": "Main2" },
   { "advance_to": "Main1" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant", "Inniaz, the Gale Force"], "battlefield_lacks": ["Suntail Hawk"] },
    { "battlefield_has": ["Suntail Hawk", "Grizzly Bears", "Forest"], "battlefield_lacks": ["Hill Giant"] }
   ]
  }
 },
 {
  "name": "ruling: if the opponent controls no nonland permanents, the player to their left gains nothing",
  "players": [
   { "battlefield": ["Inniaz, the Gale Force", "Wind Drake", "Suntail Hawk"] },
   { "battlefield": ["Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Inniaz, the Gale Force", "at": "p1" }, { "card": "Wind Drake", "at": "p1" }, { "card": "Suntail Hawk", "at": "p1" } ] },
   { "resolve": true, "answers": ["Suntail Hawk"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Inniaz, the Gale Force", "Wind Drake"], "battlefield_lacks": ["Suntail Hawk"] },
    { "battlefield_has": ["Suntail Hawk", "Forest"] }
   ]
  }
 },
 {
  "name": "ruling: a creature given away while attacking is removed from combat and stays tapped",
  "players": [
   { "battlefield": ["Inniaz, the Gale Force", "Wind Drake", "Suntail Hawk"] },
   { "battlefield": ["Grizzly Bears", "Hill Giant", "Forest"] }
  ],
  "steps": [
   { "attack": [ { "card": "Inniaz, the Gale Force", "at": "p1" }, { "card": "Wind Drake", "at": "p1" }, { "card": "Suntail Hawk", "at": "p1" } ] },
   { "resolve": true, "answers": ["Hill Giant", "Suntail Hawk"] },
   { "block": [ { "blocker": "Suntail Hawk", "attacker": "Inniaz, the Gale Force" } ], "player": 1, "illegal": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Hill Giant"] },
    { "battlefield_has": ["Suntail Hawk"] }
   ],
   "tapped": {
    "Suntail Hawk": true
   }
  }
 }
]
