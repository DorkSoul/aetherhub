[
  {
    "name": "cast a creature from the top of the library with any type of mana",
    "players": [ { "library": ["Grizzly Bears", "Forest"], "battlefield": ["Vizier of the Menagerie", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Vizier of the Menagerie"] }, {} ] }
  },
  {
    "name": "noncreature spells still need their colours",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Vizier of the Menagerie", "Plains"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ {}, {} ] }
  },
  {
    "name": "ruling: a creature card on top of the library can be cast in your main phase",
    "start": "Main1",
    "players": [ { "library": ["Grizzly Bears", "Forest"], "battlefield": ["Vizier of the Menagerie", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "library_top": ["Forest"], "graveyard": [] }, {} ] }
  },
  {
    "name": "ruling: a flash creature on top of the library can be cast on the opponent's turn",
    "start": "Main1",
    "players": [ { "library": ["Subtlety", "Forest"], "battlefield": ["Vizier of the Menagerie", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Subtlety" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Subtlety", "Vizier of the Menagerie"], "library_top": ["Forest"] }, {} ] }
  },
  {
    "name": "ruling: a creature without flash on top of the library cannot be cast on the opponent's turn",
    "start": "Main1",
    "players": [ { "library": ["Grizzly Bears", "Forest"], "battlefield": ["Vizier of the Menagerie", "Forest", "Forest"] }, {} ],
    "steps": [
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "pass": true, "player": 1 },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": { "players": [ { "library_top": ["Grizzly Bears"] }, {} ] }
  },
  {
    "name": "ruling: a noncreature card on top of the library cannot be cast from the library",
    "start": "Main1",
    "players": [ { "library": ["Lightning Bolt"], "battlefield": ["Vizier of the Menagerie", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"], "illegal": true } ],
    "expect": { "players": [ { "library_top": ["Lightning Bolt"] }, {} ] }
  },
  {
    "name": "ruling: a creature spell in hand can be paid for with any mana type",
    "start": "Main1",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Vizier of the Menagerie", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Grizzly Bears" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, {} ] }
  }
]
