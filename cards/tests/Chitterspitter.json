[
  {
    "name": "G,T makes a Squirrel",
    "players": [
      {
        "battlefield": [
          "Chitterspitter",
          "Forest"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Chitterspitter"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
