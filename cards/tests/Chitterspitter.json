          "battlefield_has": [
            "Squirrel"
          ]
        },
        {}
      ],
      "tapped": {
        "Chitterspitter": true
      }
    }
  },
  {
    "name": "upkeep: sacrifice a token for an acorn counter, Squirrels grow",
    "players": [
      {
        "battlefield": [
          "Chitterspitter",
          "Squirrel",
          "Squirrel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          true,
          "Squirrel"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {
        "Chitterspitter": {
          "acorn": 1
        }
      },
      "pt": {
        "Squirrel": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "declining the sacrifice gives no counter",
    "players": [
      {
        "battlefield": [
          "Chitterspitter",
          "Squirrel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "End"
      },
      {
        "advance_to": "End"
      },
      {
        "advance_to": "Upkeep",
        "answers": [
          false
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "counters": {},
      "pt": {
        "Squirrel": [
          1,
          1
        ]
      }
    }
  }
