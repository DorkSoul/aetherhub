[
  {
    "name": "dies to Lightning Bolt: creates X Borg tokens where X is its power (2)",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Stratagem Emulator"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Stratagem Emulator"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, { "graveyard": ["Stratagem Emulator"], "battlefield": ["Borg", "Borg"] }]
    }
  },
  {
    "name": "another creature dying does not trigger the Emulator",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": ["Stratagem Emulator", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Stratagem Emulator": [2, 1] },
      "players": [{}, { "graveyard": ["Grizzly Bears"] }]
    }
  }
]
