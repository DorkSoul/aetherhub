[
  { "name": "Cross-Slash destroys a tapped creature",
    "players": [ { "hand": ["Cloud's Limit Break"], "battlefield": ["Plains", "Plains"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, "Hill Giant" ] } ],
    "steps": [ { "cast": "Cloud's Limit Break", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Cloud's Limit Break"] }, { "graveyard": ["Grizzly Bears"], "battlefield": ["Hill Giant"] } ] } },
  { "name": "Cross-Slash cannot target an untapped creature",
    "players": [ { "hand": ["Cloud's Limit Break"], "battlefield": ["Plains", "Plains"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Cloud's Limit Break", "targets": ["Hill Giant"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Cloud's Limit Break"] }, { "battlefield": ["Hill Giant"] } ] } },
  { "name": "Blade Beam destroys one tapped creature per controller",
    "players": [ { "hand": ["Cloud's Limit Break"], "battlefield": ["Plains", "Plains", "Plains", { "name": "Craw Wurm", "tapped": true }, "Hill Giant"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, "Elvish Mystic" ] } ],
    "steps": [ { "cast": "Cloud's Limit Break", "alt": 0, "targets": ["Craw Wurm", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Cloud's Limit Break", "Craw Wurm"], "battlefield": ["Hill Giant","Plains","Plains","Plains"] }, { "graveyard": ["Grizzly Bears"], "battlefield": ["Elvish Mystic"] } ] } },
  { "name": "Blade Beam may target only an opponent's creature",
    "players": [ { "hand": ["Cloud's Limit Break"], "battlefield": ["Plains", "Plains", "Plains", "Craw Wurm"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true } ] } ],
    "steps": [ { "cast": "Cloud's Limit Break", "alt": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield": ["Craw Wurm","Plains","Plains","Plains"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "Omnislash destroys all tapped creatures only",
    "players": [ { "hand": ["Cloud's Limit Break"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains", { "name": "Craw Wurm", "tapped": true }, "Hill Giant"] },
                 { "battlefield": [ { "name": "Grizzly Bears", "tapped": true }, "Elvish Mystic" ] } ],
    "steps": [ { "cast": "Cloud's Limit Break", "alt": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Cloud's Limit Break", "Craw Wurm"], "battlefield": ["Hill Giant","Plains","Plains","Plains","Plains","Plains","Plains"] }, { "graveyard": ["Grizzly Bears"], "battlefield": ["Elvish Mystic"] } ] } },
  { "name": "ruling: Omnislash can be chosen with no tapped creature, so the targeting of the other modes does not matter",
    "players": [ { "hand": ["Cloud's Limit Break"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
                 { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Cloud's Limit Break", "alt": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Cloud's Limit Break"] }, { "battlefield": ["Hill Giant"] } ] } }
]
