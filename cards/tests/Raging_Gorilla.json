[
 {
  "name": "Raging Gorilla gets +2/-2 when it becomes blocked",
  "players": [
   { "battlefield": ["Raging Gorilla"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "attack": [ { "card": "Raging Gorilla", "at": "p1" } ] },
   { "block": [ { "blocker": "Grizzly Bears", "attacker": "Raging Gorilla" } ] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Raging Gorilla"] },
    { "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "blocking: gets +2/-2 until end of turn",
  "players": [
   { "battlefield": ["Raging Gorilla"] },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1" },
   { "attack": [{ "card": "Grizzly Bears", "at": "p0" }], "player": 1 },
   { "block": [{ "blocker": "Raging Gorilla", "attacker": "Grizzly Bears" }], "player": 0 },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Raging Gorilla": [4, 1] }
  }
 },
 {
  "name": "unblocked attack: no pump",
  "players": [
   { "battlefield": ["Raging Gorilla"] },
   {}
  ],
  "steps": [
   { "attack": [{ "card": "Raging Gorilla", "at": "p1" }] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "pt": { "Raging Gorilla": [2, 3] },
   "players": [{}, { "life": 18 }]
  }
 }
]
