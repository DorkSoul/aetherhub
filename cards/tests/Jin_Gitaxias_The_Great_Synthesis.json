[
  {
    "name": "seven cards at activation: transforms Jin into the Saga, chapter I draws a card per card in hand",
    "players": [
      {
        "hand": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"],
        "battlefield": ["Jin-Gitaxias // The Great Synthesis", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Jin-Gitaxias // The Great Synthesis" },
      { "resolve": true },
      { "pass": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["The Great Synthesis"],
          "battlefield_lacks": ["Jin-Gitaxias // The Great Synthesis"],
          "hand_count": 16
        },
        {}
      ]
    }
  },
  {
    "name": "six cards at activation (five in hand plus the turn draw): the transform ability can't be activated",
    "players": [
      {
        "hand": ["Forest", "Forest", "Forest", "Forest", "Forest"],
        "battlefield": ["Jin-Gitaxias // The Great Synthesis", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Jin-Gitaxias // The Great Synthesis", "illegal": true }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": ["Jin-Gitaxias // The Great Synthesis"]
        },
        {}
      ]
    }
  },
  {
    "name": "chapter II returns all non-Phyrexian creatures to their owners' hands",
