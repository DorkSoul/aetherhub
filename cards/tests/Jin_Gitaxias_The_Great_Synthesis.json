      { "hand": ["Forest", "Forest", "Forest", "Forest", "Forest", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Jin-Gitaxias // The Great Synthesis", "Island", "Island", "Island", "Island", "Mountain", "Mountain"] },
