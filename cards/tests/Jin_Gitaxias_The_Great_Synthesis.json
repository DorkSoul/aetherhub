      { "resolve": true },
      { "pass": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": ["Grizzly Bears"],
          "battlefield_has": ["The Great Synthesis"]
        },
        {
          "battlefield_lacks": ["Grizzly Bears"]
        }
      ]
    }
  },
  {
    "name": "chapter III casts the chosen nonland cards from hand without paying their costs",
    "players": [
      {
        "hand": ["Grizzly Bears", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"],
        "battlefield": ["Jin-Gitaxias // The Great Synthesis", "Island", "Island", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "activate": "Jin-Gitaxias // The Great Synthesis" },
      { "resolve": true },
      { "pass": true },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
