   "steps": [ { "cast": "Controlled Instincts", "targets": ["Merfolk of the Pearl Trident"], "illegal": true } ],
   "expect": { "players": [ { "hand": ["Controlled Instincts"] }, {} ] } },
 { "name": "aura falls off as a state-based action when the creature stops being red or green",
