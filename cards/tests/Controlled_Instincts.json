   "expect": { "players": [ { "graveyard_has": ["Controlled Instincts"] }, {} ] } },
 { "name": "ruling: can enchant an untapped green creature",
   "players": [ { "hand": ["Controlled Instincts"], "battlefield": ["Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Controlled Instincts", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
