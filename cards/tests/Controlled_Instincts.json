   "steps": [ { "cast": "Controlled Instincts", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End" }, { "advance_to": "End" }, { "advance_to": "Main1" } ],
   "expect": { "tapped": { "Grizzly Bears": true }, "players": [ { "battlefield_has": ["Controlled Instincts"] }, {} ] } },
