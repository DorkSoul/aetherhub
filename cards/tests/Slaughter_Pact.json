  {
    "name": "ruling: if the target is gone on resolution, the upkeep payment is never required",
    "players": [
      { "hand": ["Slaughter Pact"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Slaughter Pact", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Slaughter Pact"] },
        { "graveyard_has": ["Lightning Bolt", "Grizzly Bears"] }
      ],
      "winner": -1
    }
  },
  {
    "name": "ruling: a target that survives (indestructible) still triggers the upkeep payment",
    "players": [
      { "hand": ["Slaughter Pact"] },
      { "battlefield": ["Darksteel Myr"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Slaughter Pact", "targets": ["Darksteel Myr"] },
      { "resolve": true },
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Slaughter Pact"] },
        { "battlefield_has": ["Darksteel Myr"] }
      ],
      "winner": 1
    }
  }
]
