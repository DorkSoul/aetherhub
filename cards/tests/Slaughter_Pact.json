    "players": [
      {
        "hand": [
          "Slaughter Pact"
        ]
      },
      {
        "battlefield": [
          "Vampire Nighthawk"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Slaughter Pact",
        "targets": [
          "Vampire Nighthawk"
        ],
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand": [
            "Slaughter Pact"
          ]
        },
        {
          "battlefield": [
            "Vampire Nighthawk"
          ]
        }
      ]
    }
