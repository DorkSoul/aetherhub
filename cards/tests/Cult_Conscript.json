    "steps": [{ "cast": "Cult Conscript" }, { "resolve": true }],
    "expect": { "players": [{ "battlefield_has": ["Cult Conscript"] }, {}], "tapped": { "Cult Conscript": true } }
  },
  {
    "name": "returns from the graveyard after a non-Skeleton creature you control died this turn",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Swamp", "Swamp", "Grizzly Bears"], "graveyard": ["Cult Conscript"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Cult Conscript", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Cult Conscript"], "graveyard": ["Lightning Bolt", "Grizzly Bears"] }, {}],
      "tapped": { "Cult Conscript": true }
    }
  },
  {
    "name": "cannot return when only a Skeleton died this turn",
