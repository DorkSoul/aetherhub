[
  { "name": "cast with Forest mana only: opponent may put a creature card from hand onto the battlefield",
    "players": [ { "hand": ["Wumpus Aberration"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
                 { "hand": ["Grizzly Bears", "Lightning Bolt"] } ],
    "steps": [ { "cast": "Wumpus Aberration" }, { "resolve": true, "answers": [["Grizzly Bears"]] } ],
    "expect": { "players": [ { "battlefield_has": ["Wumpus Aberration"] }, { "hand_count": 1, "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "opponent may decline: no creature enters",
    "players": [ { "hand": ["Wumpus Aberration"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
                 { "hand": ["Grizzly Bears", "Lightning Bolt"] } ],
    "steps": [ { "cast": "Wumpus Aberration" }, { "resolve": true, "answers": [[]] } ],
    "expect": { "players": [ { "battlefield_has": ["Wumpus Aberration"] }, { "hand_count": 2, "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "if {C} was spent to cast it, the trigger does nothing and the opponent's creature stays in hand",
    "players": [ { "hand": ["Wumpus Aberration"], "battlefield": ["Forest", "Forest", "Forest", "Wastes"] },
                 { "hand": ["Grizzly Bears", "Lightning Bolt"] } ],
    "steps": [ { "cast": "Wumpus Aberration" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Wumpus Aberration"] }, { "hand_count": 2, "battlefield_lacks": ["Grizzly Bears"] } ] } },
  { "name": "ruling: countering Wumpus in response to its trigger does not stop the trigger",
    "players": [ { "hand": ["Wumpus Aberration"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] },
                 { "hand": ["Counterspell", "Grizzly Bears"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Wumpus Aberration" }, { "pass": true },
               { "cast": "Counterspell", "player": 1 },
               { "resolve": true, "answers": [["Grizzly Bears"]] } ],
    "expect": { "players": [ { "graveyard": ["Wumpus Aberration"] }, { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Counterspell"], "hand_count": 0 } ] } }
]
