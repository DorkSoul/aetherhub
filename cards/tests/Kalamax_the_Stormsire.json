[
  {
    "name": "first instant of the turn, cast while Kalamax is tapped: it is copied and the copy adds a +1/+1 counter",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Kalamax, the Stormsire", "tapped": true }, "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Kalamax, the Stormsire": { "PlusOnePlusOne": 1 } },
      "pt": { "Kalamax, the Stormsire": [5, 5] },
      "players": [ { "graveyard": ["Lightning Bolt"] }, {} ]
    }
  },
  {
    "name": "boundary: Kalamax untapped, so the first instant is not copied",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Kalamax, the Stormsire", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Kalamax, the Stormsire": { "PlusOnePlusOne": 0 } },
      "pt": { "Kalamax, the Stormsire": [4, 4] },
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "boundary: only the first instant each turn is copied",
    "players": [
      { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": [{ "name": "Kalamax, the Stormsire", "tapped": true }, "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Kalamax, the Stormsire": { "PlusOnePlusOne": 1 } },
      "pt": { "Kalamax, the Stormsire": [5, 5] }
    }
  }
]
