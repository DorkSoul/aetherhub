[
  {
    "name": "one 1/1 Snake per card in hand, then epic emblem",
    "players": [
      {"hand": ["Endless Swarm", "Plains", "Island"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains", "Plains", "Island", "Island"]},
      {}
    ],
    "steps": [
      {"cast": "Endless Swarm"},
      {"resolve": true}
    ],
    "expect": {
      "players": [{"battlefield_has": ["Snake", "Snake"], "hand_count": 2}, {}]
    }
  },
  {
    "name": "epic: can't cast spells for the rest of the game",
    "players": [
      {"hand": ["Endless Swarm", "Lightning Bolt", "Plains"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains", "Plains", "Island", "Island"]},
      {}
    ],
    "steps": [
      {"cast": "Endless Swarm"},
      {"resolve": true},
      {"cast": "Lightning Bolt", "illegal": true}
    ],
    "expect": {"players": [{"hand": ["Lightning Bolt", "Plains"]}, {}]}
  },
  {
    "name": "epic upkeep copy: a new batch of Snakes for each card in hand",
    "players": [
      {"hand": ["Endless Swarm", "Plains", "Island"], "battlefield": ["Forest", "Forest", "Forest", "Plains", "Plains", "Plains", "Island", "Island"]},
      {}
    ],
    "steps": [
      {"cast": "Endless Swarm"},
      {"resolve": true},
      {"advance_to": "Upkeep"},
      {"advance_to": "Upkeep"}
    ],
    "expect": {"players": [{"battlefield_has": ["Snake", "Snake", "Snake", "Snake"]}, {}]}
  }
]
