[
  { "name": "{3}: exile the top card of your library, you may play it this turn",
    "players": [ { "battlefield": ["Zuko, Exiled Prince", "Mountain", "Mountain", "Mountain"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "activate": "Zuko, Exiled Prince" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"], "library_count": 0 }, {} ] } },
  { "name": "the exiled card can be cast this turn",
    "players": [ { "battlefield": ["Zuko, Exiled Prince", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Lightning Bolt"] }, {} ],
    "steps": [ { "activate": "Zuko, Exiled Prince" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": [] }, { "life": 17 } ] } },
  { "name": "firebending 3: attacking adds RRR until end of combat",
    "players": [ { "battlefield": ["Zuko, Exiled Prince"] }, {} ],
    "steps": [ { "attack": [ { "card": "Zuko, Exiled Prince", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "pool": { "R": 3 } }, {} ] } },
  { "name": "the firebending mana is gone at the second main phase",
    "players": [ { "battlefield": ["Zuko, Exiled Prince"] }, {} ],
    "steps": [ { "attack": [ { "card": "Zuko, Exiled Prince", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "pool": {} }, {} ] } },
  { "name": "ruling: firebending mana still pays for Zuko's ability after combat damage (before end of combat)",
    "players": [ { "battlefield": ["Zuko, Exiled Prince"], "library": ["Grizzly Bears"] }, {} ],
    "steps": [ { "attack": [ { "card": "Zuko, Exiled Prince", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "EndCombat" }, { "activate": "Zuko, Exiled Prince" }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"], "pool": {} }, {} ] } },
  { "name": "ruling: firebending is a triggered ability on the stack, not an immediate mana ability",
    "players": [ { "battlefield": ["Zuko, Exiled Prince"] }, {} ],
    "steps": [ { "attack": [ { "card": "Zuko, Exiled Prince", "at": "p1" } ] } ],
    "expect": { "stack_empty": false, "players": [ { "pool": {} }, {} ] } },
  { "name": "ruling: ordinary mana empties when the step changes (only firebending mana persists)",
    "players": [ { "battlefield": ["Zuko, Exiled Prince", "Mountain"] }, {} ],
    "steps": [ { "tap_for_mana": "Mountain" }, { "advance_to": "BeginCombat" } ],
    "expect": { "players": [ { "pool": {} }, {} ] } }
]
