[
  {"name": "blue creature spells cost {1} less: Air Elemental costs 4",
   "players": [{"hand": ["Air Elemental"], "battlefield": ["Island", "Island", "Island", "Island", "Kefnet's Monument"]}, {}],
   "steps": [{"cast": "Air Elemental"}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Air Elemental"]}, {}], "pt": {"Air Elemental": [4, 4]}}},
  {"name": "three lands are not enough for the reduced cost",
   "players": [{"hand": ["Air Elemental"], "battlefield": ["Island", "Island", "Island", "Kefnet's Monument"]}, {}],
   "steps": [{"cast": "Air Elemental", "illegal": true}],
   "expect": {"players": [{"hand_count": 1}, {}]}},
  {"name": "casting a creature spell targets an opposing creature, which stays tapped",
   "players": [{"hand": ["Air Elemental"], "battlefield": ["Island", "Island", "Island", "Island", "Kefnet's Monument"]}, {"battlefield": [{"name": "Grizzly Bears", "tapped": true}]}],
   "steps": [{"cast": "Air Elemental"}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Air Elemental"]}, {"battlefield_has": ["Grizzly Bears"]}], "tapped": {"Grizzly Bears": true}}},
  {"name": "ruling: the trigger fires for a non-blue creature spell too: opposing Hill Giant stays tapped through its controller's untap step",
   "players": [{"hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Kefnet's Monument"]}, {"battlefield": [{"name": "Hill Giant", "tapped": true}]}],
   "steps": [{"cast": "Grizzly Bears"}, {"resolve": true}, {"resolve": true}, {"advance_to": "Upkeep"}],
   "expect": {"players": [{"battlefield_has": ["Grizzly Bears"]}, {"battlefield_has": ["Hill Giant"]}], "tapped": {"Hill Giant": true}}},
  {"name": "ruling: the trigger targets an untapped creature without tapping it",
   "players": [{"hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Kefnet's Monument"]}, {"battlefield": ["Hill Giant"]}],
   "steps": [{"cast": "Grizzly Bears"}, {"resolve": true}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Grizzly Bears"]}, {"battlefield_has": ["Hill Giant"]}], "tapped": {"Hill Giant": false}}},
  {"name": "ruling: the trigger still resolves when the creature spell is countered (Hill Giant stays tapped through its untap step)",
   "players": [{"hand": ["Grizzly Bears"], "battlefield": ["Forest", "Forest", "Kefnet's Monument"]}, {"hand": ["Counterspell"], "battlefield": ["Island", "Island", {"name": "Hill Giant", "tapped": true}]}],
   "steps": [{"cast": "Grizzly Bears"}, {"pass": true}, {"cast": "Counterspell", "player": 1}, {"resolve": true}, {"resolve": true}, {"advance_to": "Upkeep"}],
   "expect": {"players": [{"graveyard_has": ["Grizzly Bears"]}, {"graveyard_has": ["Counterspell"]}], "tapped": {"Hill Giant": true}}},
  {"name": "ruling: a multicolor blue creature (Atraxa, W/U/B/G) gets the blue discount: castable for 6 lands",
   "players": [{"hand": ["Atraxa, Grand Unifier"], "battlefield": ["Plains", "Island", "Swamp", "Forest", "Island", "Island", "Kefnet's Monument"]}, {}],
   "steps": [{"cast": "Atraxa, Grand Unifier"}, {"resolve": true}],
   "expect": {"players": [{"battlefield_has": ["Atraxa, Grand Unifier"]}, {}]}}
]
