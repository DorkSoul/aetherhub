[
  {
    "name": "pay 2 and discard a random card: 2 damage to the opponent",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Stormbind", "Mountain", "Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Stormbind", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        { "life": 18 }
      ],
      "tapped": { "Mountain": true, "Forest": true }
    }
  },
  {
    "name": "needs a card in hand to discard",
    "players": [
      {
        "battlefield": ["Stormbind", "Mountain", "Forest"]
      },
      {}
    ],
    "steps": [
      { "activate": "Stormbind", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20 }
      ]
    }
  },
  {
    "name": "needs {2} available",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Stormbind", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Stormbind", "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Grizzly Bears"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "ruling: the random discard is a cost, so Library of Leng cannot put the card on top of the library",
    "players": [
      {
        "hand": ["Grizzly Bears"],
        "battlefield": ["Stormbind", "Mountain", "Forest", "Library of Leng"]
      },
      {}
    ],
    "steps": [
      { "activate": "Stormbind", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        { "life": 18 }
      ]
    }
  }
]
