[
  {
    "name": "taps an opposing creature and removes it from combat on entering",
    "players": [
      { "hand": ["Stunning Strike"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Stunning Strike", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true },
      "attached": { "Stunning Strike": "Grizzly Bears" }
    }
  },
  {
    "name": "enchanted non-legendary creature does not untap during its controller's untap step",
    "players": [
      { "hand": ["Stunning Strike"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Stunning Strike", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "enchanted legendary creature still untaps normally",
    "players": [
      { "hand": ["Stunning Strike"], "battlefield": ["Island", "Island", "Island"] },
      { "battlefield": ["Isamaru, Hound of Konda"] }
    ],
    "steps": [
      { "cast": "Stunning Strike", "targets": ["Isamaru, Hound of Konda"] },
      { "resolve": true },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "tapped": { "Isamaru, Hound of Konda": false }
    }
  }
]
