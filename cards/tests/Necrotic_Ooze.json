[
  {
    "name": "has the activated abilities of a creature card in your graveyard",
    "players": [
      {
        "battlefield": ["Necrotic Ooze", "Mountain"],
        "graveyard": ["Shivan Dragon"]
      },
      {}
    ],
    "steps": [
      { "activate": "Necrotic Ooze", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Necrotic Ooze": [5, 3] }
    }
  },
  {
    "name": "has the activated abilities of a creature card in an opponent's graveyard",
    "players": [
      {
        "battlefield": ["Necrotic Ooze", "Mountain"]
      },
      {
        "graveyard": ["Shivan Dragon"]
      }
    ],
    "steps": [
      { "activate": "Necrotic Ooze", "ability": 32768 },
      { "resolve": true }
    ],
    "expect": {
      "pt": { "Necrotic Ooze": [5, 3] }
    }
  },
  {
    "name": "non-creature cards in graveyards give no abilities",
    "players": [
      {
        "battlefield": ["Necrotic Ooze", "Mountain", "Mountain"],
        "graveyard": ["Shadowspear"]
      },
      {}
    ],
    "steps": [
      { "activate": "Necrotic Ooze", "ability": 32768, "illegal": true }
    ],
    "expect": {
      "pt": { "Necrotic Ooze": [4, 3] }
    }
  },
  {
    "name": "no creature cards in any graveyard means no granted abilities",
    "players": [
      {
        "battlefield": ["Necrotic Ooze", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "activate": "Necrotic Ooze", "ability": 32768, "illegal": true }
    ],
    "expect": {
      "pt": { "Necrotic Ooze": [4, 3] }
    }
  },
  {
    "name": "ruling: the regeneration granted from Cudgel Troll shields Necrotic Ooze itself",
    "players": [
      { "battlefield": ["Necrotic Ooze", "Forest"], "graveyard": ["Cudgel Troll"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "attack": [{ "card": "Necrotic Ooze", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Necrotic Ooze" }] },
      { "activate": "Necrotic Ooze", "ability": 32768 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Necrotic Ooze"] }, { "graveyard_has": ["Hill Giant"] } ]
    }
  }
]
