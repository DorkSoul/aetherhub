  {
    "name": "ruling: the draw trigger resolves before the opponent's spell does",
    "players": [
      { "battlefield": ["Nezahal, Primal Tide"], "library": ["Grizzly Bears"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "pass": true, "player": 1 },
      { "pass": true }
    ],
    "expect": {
      "stack_empty": false,
      "players": [ { "hand_count": 1, "life": 20 }, {} ]
    }
  },
  {
    "name": "ruling: the card drawn from Nezahal can counter the spell that triggered it",
    "players": [
      { "battlefield": ["Nezahal, Primal Tide", "Island", "Island"], "library": ["Counterspell"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "cast": "Shock", "player": 1, "targets": ["p0"] },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Counterspell", "targets": [{ "stack": "Shock" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Counterspell"] },
        { "graveyard": ["Shock"] }
      ]
    }
  },
  {
    "name": "ruling: discard three activated in your turn returns before cleanup, so no hand size limit applies",
    "players": [
      { "hand": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"], "battlefield": ["Nezahal, Primal Tide"] },
      {}
    ],
    "steps": [
      { "activate": "Nezahal, Primal Tide", "auto": true },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [ { "hand_count": 8, "battlefield_has": ["Nezahal, Primal Tide"] }, {} ]
    }
  },
  {
    "name": "ruling: returned Nezahal is a new object with no counters",
    "players": [
      { "hand": ["Shock", "Shock", "Shock"], "battlefield": [{ "name": "Nezahal, Primal Tide", "counters": { "p1p1": 2 } }] },
      {}
    ],
    "steps": [
      { "activate": "Nezahal, Primal Tide", "auto": true },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Nezahal, Primal Tide"] }, {} ],
      "pt": { "Nezahal, Primal Tide": [7, 7] },
      "counters": { "Nezahal, Primal Tide": { "p1p1": 0 } }
    }
  }
