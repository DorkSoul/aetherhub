[
  {
    "name": "enchanted creature can't attack or block",
    "players": [
      { "hand": ["Crystallization"], "battlefield": ["Forest", "Plains", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "cast": "Crystallization", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "attached": { "Crystallization": "Grizzly Bears" },
      "players": [ { "battlefield_has": ["Grizzly Bears", "Crystallization"] }, {} ]
    }
  },
  {
    "name": "targeting the enchanted creature exiles it",
    "players": [
      { "hand": ["Crystallization"], "battlefield": ["Forest", "Plains", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Crystallization", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  },
  {
    "name": "enchanted creature can't attack: its controller's other attacker still gets through",
    "players": [
      { "hand": ["Crystallization"], "battlefield": ["Forest", "Plains", "Grizzly Bears", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "cast": "Crystallization", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "enchanted creature can't block: the declared blocker is dropped, so the attacker is unblocked",
    "players": [
      { "hand": ["Crystallization"], "battlefield": ["Forest", "Plains", "Hill Giant"] },
      { "battlefield": ["Grizzly Bears", "Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Crystallization", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Hill Giant", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Hill Giant" } ], "player": 1 },
      { "advance_to": "Main2", "auto": true }
    ],
    "expect": {
      "players": [ {}, { "life": 17 } ]
    }
  },
  {
    "name": "ruling: exiling the enchanted creature also puts Crystallization into the graveyard",
    "players": [
      { "hand": ["Crystallization"], "battlefield": ["Forest", "Plains", "Grizzly Bears"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Crystallization", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "exile": ["Grizzly Bears"], "graveyard": ["Crystallization"] }, { "graveyard": ["Lightning Bolt"] } ]
    }
  }
]
