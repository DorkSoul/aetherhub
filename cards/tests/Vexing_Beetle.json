[
  { "name": "gets +3/+3 while no opponent controls a creature",
    "players": [ { "hand": ["Vexing Beetle"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Vexing Beetle" }, { "resolve": true } ],
    "expect": { "players": [{}, {}], "pt": { "Vexing Beetle": [6, 6] } } },
  { "name": "base 3/3 when an opponent controls a creature",
    "players": [ { "hand": ["Vexing Beetle"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Vexing Beetle" }, { "resolve": true } ],
    "expect": { "players": [{}, {}], "pt": { "Vexing Beetle": [3, 3], "Grizzly Bears": [2, 2] } } },
  { "name": "cannot be cast with only 4 mana",
    "players": [ { "hand": ["Vexing Beetle"], "battlefield": ["Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Vexing Beetle", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Vexing Beetle"] }, {} ] } },
  { "name": "Counterspell cannot counter the Beetle: it resolves onto the battlefield",
    "players": [ { "hand": ["Vexing Beetle"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "cast": "Vexing Beetle" }, { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Vexing Beetle" }] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Vexing Beetle"] }, { "graveyard": ["Counterspell"] } ] } }
]
