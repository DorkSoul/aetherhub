  "name": "first spell cast in opponent's turn: look at top two, one to hand, other to graveyard",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", { "name": "Nymris, Oona's Trickster", "sick": false }], "library": ["Grizzly Bears", "Island"] }, {} ],
  "steps": [ { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": ["Grizzly Bears"] }, { "resolve": true } ],
