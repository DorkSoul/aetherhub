  "steps": [ { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true, "answers": ["Grizzly Bears"] }, { "resolve": true }, { "pass": true, "player": 1 }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ { "hand": ["Grizzly Bears"], "graveyard": ["Island", "Lightning Bolt", "Lightning Bolt"] }, { "life": 14 } ] }
