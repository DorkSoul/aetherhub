   "steps": [ { "cast": "Point the Way" }, { "resolve": true }, { "activate": "Point the Way", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Point the Way"], "battlefield_has": ["Forest"] }, {} ] } },
 { "name": "speed 4: fetches up to four basic lands",
