   "expect": { "players": [ { "speed": 1, "battlefield_has": ["Point the Way"] }, { "speed": 0 } ] } },
 { "name": "ruling: speed stays 1 after Point the Way is sacrificed",
   "players": [ { "hand": ["Point the Way"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest"] }, {} ],
   "steps": [ { "cast": "Point the Way" }, { "resolve": true }, { "activate": "Point the Way", "ability": 0 }, { "resolve": true } ],
