   "steps": [ { "cast": "Point the Way" }, { "resolve": true }, { "set_speed": 4 }, { "activate": "Point the Way", "ability": 0 }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Point the Way"] }, {} ] } },
 { "name": "start your engines: speed starts at 1 so exactly one basic land is fetched",
   "players": [ { "hand": ["Point the Way"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"], "library": ["Forest", "Forest", "Forest"] }, {} ],
   "steps": [ { "cast": "Point the Way" }, { "resolve": true }, { "resolve": true }, { "activate": "Point the Way", "ability": 0 }, { "resolve": true, "answers": [["Forest"]] } ],
