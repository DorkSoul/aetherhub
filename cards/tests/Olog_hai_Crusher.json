[
 {
  "name": "can block when you control a Goblin",
  "players": [
   {
    "battlefield": [
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Olog-hai Crusher",
     "Goblin Assailant"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "block": [
     {
      "blocker": "Olog-hai Crusher",
      "attacker": "Grizzly Bears"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {
     "graveyard": [
      "Grizzly Bears"
     ]
    },
    {
     "battlefield_has": [
      "Olog-hai Crusher",
      "Goblin Assailant"
     ]
    }
   ]
  }
 },
 {
  "name": "crusher alone can attack and is 4/4 trample",
  "players": [
   {
    "battlefield": [
     "Olog-hai Crusher"
    ]
   },
   {}
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Olog-hai Crusher",
      "at": "p1"
     }
    ]
   },
   {
    "resolve": true
   },
   {
    "advance_to": "Main2"
   }
  ],
  "expect": {
   "players": [
    {},
    {
     "life": 16
    }
   ],
   "pt": {
    "Olog-hai Crusher": [
     4,
     4
    ]
   }
  }
 },
 {
  "name": "no Goblin or Orc: the Crusher cannot block the Bears, which hit for 2",
  "players": [
   { "battlefield": [ { "name": "Grizzly Bears", "sick": false }, { "name": "Hill Giant", "sick": false } ] },
   { "battlefield": ["Olog-hai Crusher", "Savannah Lions"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" } ] },
   { "block": [ { "blocker": "Olog-hai Crusher", "attacker": "Grizzly Bears" }, { "blocker": "Savannah Lions", "attacker": "Hill Giant" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Grizzly Bears", "Hill Giant"] },
    { "life": 18, "battlefield_has": ["Olog-hai Crusher"], "graveyard_has": ["Savannah Lions"] }
   ]
  }
 },
 {
  "name": "ruling: the Goblin does not have to block for the Crusher to be allowed to block",
  "players": [
   { "battlefield": ["Grizzly Bears"] },
   { "battlefield": ["Olog-hai Crusher", "Goblin Assailant"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Olog-hai Crusher", "attacker": "Grizzly Bears" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Grizzly Bears"] },
    { "life": 20, "battlefield_has": ["Olog-hai Crusher", "Goblin Assailant"] }
   ]
  }
 },
 {
  "name": "ruling: a Crusher that already blocks keeps blocking after its Goblin leaves",
  "players": [
   { "battlefield": ["Grizzly Bears"] },
   { "battlefield": ["Olog-hai Crusher", "Goblin Assailant", "Mountain"], "hand": ["Lightning Bolt"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [ { "blocker": "Olog-hai Crusher", "attacker": "Grizzly Bears" } ] },
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Goblin Assailant"] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Grizzly Bears"] },
    { "life": 20, "battlefield_has": ["Olog-hai Crusher"], "graveyard_has": ["Goblin Assailant", "Lightning Bolt"] }
   ]
  }
 }
]