[
  {
    "name": "prowess: casting a noncreature spell gives +1/+1",
    "players": [ { "hand": ["Shock"], "battlefield": ["Dwarven Forge-Chanter", "Mountain"] }, {} ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [ {}, { "life": 18 } ], "pt": { "Dwarven Forge-Chanter": [2, 4] } }
  },
  {
    "name": "casting a creature spell does not trigger prowess",
    "players": [ { "hand": ["Grizzly Bears"], "battlefield": ["Dwarven Forge-Chanter", "Forest", "Forest"] }, {} ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": { "pt": { "Dwarven Forge-Chanter": [1, 3] } }
  },
  {
    "name": "ward: opponent pays 2 life to target it, Bolt resolves and kills it",
    "players": [ { "battlefield": ["Dwarven Forge-Chanter"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Dwarven Forge-Chanter"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "graveyard_has": ["Dwarven Forge-Chanter"] }, { "graveyard_has": ["Lightning Bolt"], "life": 18 } ] }
  },
  { "name": "ruling: prowess resolves before the spell, so a Bolt on Chanter meets a 2/4 and it survives",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Dwarven Forge-Chanter", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Dwarven Forge-Chanter"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Dwarven Forge-Chanter"], "graveyard_has": ["Lightning Bolt"] }, {} ], "pt": { "Dwarven Forge-Chanter": [2, 4] } } },
  { "name": "ruling: prowess still resolves when the Shock it was triggered by fizzles",
    "players": [ { "hand": ["Shock"], "battlefield": ["Dwarven Forge-Chanter", "Mountain"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Shock", "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Shock"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ], "pt": { "Dwarven Forge-Chanter": [2, 4] } } },
  { "name": "ruling: an artifact creature spell does not trigger prowess",
    "players": [ { "hand": ["Clockwork Hydra"], "battlefield": ["Dwarven Forge-Chanter", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Clockwork Hydra" }, { "resolve": true } ],
    "expect": { "pt": { "Dwarven Forge-Chanter": [1, 3] } } },
  { "name": "ruling: playing a land does not trigger prowess",
    "players": [ { "hand": ["Forest"], "battlefield": ["Dwarven Forge-Chanter"] }, {} ],
    "steps": [ { "play_land": "Forest" } ],
    "expect": { "pt": { "Dwarven Forge-Chanter": [1, 3] } } }
]
