[
  {
    "name": "a card that is not a commander you own can't be targeted",
    "commander": true,
    "players": [
      {
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Forest",
          "Sanctum of Eternity",
          "Grizzly Bears"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Sanctum of Eternity",
        "ability": 0,
        "illegal": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Grizzly Bears",
            "Sanctum of Eternity"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "{2},{T}: returns your commander from the battlefield to your hand",
    "commander": true,
    "players": [
      {
        "command": ["Grizzly Bears"],
        "battlefield": ["Sanctum of Eternity", "Forest", "Forest", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "activate": "Sanctum of Eternity", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "command": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: each cast from the command zone raises the commander tax by 2 (too little mana is illegal)",
    "commander": true,
    "players": [
      { "command": ["Grizzly Bears"], "battlefield": ["Sanctum of Eternity", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "activate": "Sanctum of Eternity", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Grizzly Bears", "illegal": true }
    ],
    "expect": {
      "players": [
        { "command": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: the second cast from the command zone costs 4 in total",
    "commander": true,
    "players": [
      { "command": ["Grizzly Bears"], "battlefield": ["Sanctum of Eternity", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "activate": "Sanctum of Eternity", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "command": [] },
        {}
      ]
    }
  },
  {
    "name": "ruling: with the commander in the command zone the bounce ability has no legal target",
    "commander": true,
    "players": [
      { "command": ["Grizzly Bears"], "battlefield": ["Sanctum of Eternity", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "activate": "Sanctum of Eternity", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "command": ["Grizzly Bears"], "battlefield_has": ["Sanctum of Eternity"] },
        {}
      ]
    }
  }
]