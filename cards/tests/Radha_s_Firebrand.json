    "steps": [
      { "activate": "Radha's Firebrand", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Radha's Firebrand": [5, 3] } } },
  { "name": "three basic land types: costs {2}{R}, so three lands are enough",
    "players": [ { "battlefield": ["Radha's Firebrand", "Mountain", "Island", "Forest"] }, {} ],
    "steps": [
      { "activate": "Radha's Firebrand", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "pt": { "Radha's Firebrand": [5, 3] } } },
  { "name": "two basic land types: costs {3}{R}, two lands are not enough",
