    "steps": [
      { "activate": "Radha's Firebrand", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Radha's Firebrand": [3, 1] } } },
  { "name": "activate only once each turn",
    "players": [ { "battlefield": ["Radha's Firebrand", "Mountain", "Island", "Forest", "Plains", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "activate": "Radha's Firebrand", "ability": 0 },
      { "resolve": true },
      { "activate": "Radha's Firebrand", "ability": 0, "illegal": true }
    ],
    "expect": { "pt": { "Radha's Firebrand": [5, 3] } } },
  { "name": "ruling: a power increase after the trigger resolves does not undo can't block",
    "players": [ { "battlefield": ["Radha's Firebrand"] }, { "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains"], "hand": ["Rally the Peasants"] } ],
    "steps": [
      { "attack": [ { "card": "Radha's Firebrand", "at": "p1" } ] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Rally the Peasants", "player": 1 },
      { "resolve": true },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Radha's Firebrand" } ], "illegal": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 17 } ] } },
  { "name": "ruling: a power increase in response to the trigger makes the target illegal, so the defender can block",
    "players": [ { "battlefield": ["Radha's Firebrand"] }, { "battlefield": ["Grizzly Bears", "Plains", "Plains", "Plains"], "hand": ["Rally the Peasants"] } ],
    "steps": [
      { "attack": [ { "card": "Radha's Firebrand", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Rally the Peasants", "player": 1 },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Radha's Firebrand" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Radha's Firebrand"] }, { "graveyard": ["Grizzly Bears", "Rally the Peasants"], "life": 20 } ] } },
