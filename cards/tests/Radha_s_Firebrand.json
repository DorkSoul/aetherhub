    "steps": [
      { "attack": [ { "card": "Radha's Firebrand", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Radha's Firebrand" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "graveyard": ["Radha's Firebrand"] }, { "graveyard": ["Hill Giant"] } ] } },
  { "name": "five basic land types: the domain ability costs only {R}",
