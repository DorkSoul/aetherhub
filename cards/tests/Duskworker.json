[
  {
    "name": "when it becomes blocked it regenerates and survives combat damage",
    "players": [{ "battlefield": ["Duskworker"] }, { "battlefield": ["Hill Giant"] }],
    "steps": [
      { "attack": [{ "card": "Duskworker", "at": "p1" }] },
      { "block": [{ "blocker": "Hill Giant", "attacker": "Duskworker" }] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Duskworker"] }, { "battlefield_has": ["Hill Giant"] }],
      "tapped": { "Duskworker": true }
    }
  },
  {
    "name": "{3}: gets +1/+0 until end of turn",
    "players": [{ "battlefield": ["Duskworker", "Plains", "Plains", "Plains"] }, {}],
    "steps": [
      { "activate": "Duskworker", "ability": 0 },
      { "resolve": true }
    ],
    "expect": { "players": [{}, {}], "pt": { "Duskworker": [3, 2] } }
  },
  {
    "name": "ruling: setting up the regeneration shield does not remove it from combat (the blocker still takes damage)",
    "players": [{ "battlefield": ["Duskworker"] }, { "battlefield": ["Grizzly Bears"] }],
    "steps": [
      { "attack": [{ "card": "Duskworker", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Duskworker" }] },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Duskworker"] }, { "graveyard": ["Grizzly Bears"] }]
    }
  }
]
