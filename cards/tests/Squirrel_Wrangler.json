[
  {
    "name": "sacrifice a land: create two Squirrel tokens",
    "players": [
      {
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Squirrel Wrangler"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Squirrel Wrangler",
        "ability": 0,
        "answers": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Squirrel",
            "Squirrel"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "pump: Squirrels get +1/+1 until end of turn, Wrangler does not",
    "players": [
      {
        "battlefield": [
          "Forest",
          "Forest",
          "Forest",
          "Squirrel Wrangler",
          "Squirrel"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Squirrel Wrangler",
        "ability": 1,
        "answers": [
          "Forest"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Squirrel": [
          2,
          2
        ],
        "Squirrel Wrangler": [
          2,
          2
        ]
      }
    }
  },
  {
    "name": "ruling: a pump activated before token creation affects the Squirrels it creates (pump resolves last)",
    "players": [ { "battlefield": ["Squirrel Wrangler", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Squirrel Wrangler", "ability": 1, "answers": ["Forest"] },
      { "activate": "Squirrel Wrangler", "ability": 0, "answers": ["Forest"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Squirrel": [2, 2] } }
  },
  {
    "name": "ruling: Squirrels created after the pump resolved are not pumped",
    "players": [ { "battlefield": ["Squirrel Wrangler", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [
      { "activate": "Squirrel Wrangler", "ability": 0, "answers": ["Forest"] },
      { "activate": "Squirrel Wrangler", "ability": 1, "answers": ["Forest"] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Squirrel": [1, 1] } }
  }
]
