[
 {
  "name": "another creature of yours dying transforms it into the 3/2 back face",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Mountain", "Bereaved Survivor", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Shock", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Shock", "Grizzly Bears"] }, {} ],
   "pt": { "Dauntless Avenger": [3, 2] }
  }
 },
 {
  "name": "the survivor itself dying does not transform it (it is not another creature)",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Mountain", "Bereaved Survivor"] },
   {}
  ],
  "steps": [
   { "cast": "Shock", "targets": ["Bereaved Survivor"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Shock", "Bereaved Survivor"] }, {} ]
  }
 },
 {
  "name": "attack trigger returns a 2-or-less creature card from the graveyard tapped and attacking",
  "players": [
   { "hand": ["Shock"], "battlefield": ["Mountain", "Bereaved Survivor", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Shock", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "resolve": true },
   { "attack": [ { "card": "Dauntless Avenger", "at": "p1" } ] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Grizzly Bears", "Dauntless Avenger"] }, { "life": 15 } ]
  }
 }
]
