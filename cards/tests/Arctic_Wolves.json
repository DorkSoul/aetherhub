[
  {
    "name": "ETB draws a card",
    "players": [
      { "hand": ["Arctic Wolves"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "cast": "Arctic Wolves" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Arctic Wolves"], "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "pays {2} per age counter: pays once on the first upkeep",
    "players": [
      { "battlefield": ["Arctic Wolves", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] }
    ],
    "expect": {
      "counters": { "Arctic Wolves": { "age": 1 } },
      "players": [ { "battlefield_has": ["Arctic Wolves"] }, {} ]
    }
  },
  {
    "name": "cannot pay: sacrificed",
    "players": [
      { "battlefield": ["Arctic Wolves", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Arctic Wolves"] }, {} ]
    }
  },
  {
    "name": "ruling: cumulative upkeep is not partly payable: the second upkeep costs {4} and two untapped lands sacrifice it",
    "players": [
      { "battlefield": ["Arctic Wolves", "Forest", "Forest", "Forest", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [true] },
      { "advance_to": "Main2" },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [false] }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Arctic Wolves"] }, {} ]
    }
  }
]
