[
 { "name": "end step: exiles another creature you control and returns it untapped",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling", { "name": "Wind Drake", "tapped": true }] }, {} ],
   "steps": [ { "advance_to": "End", "targets": ["Wind Drake"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Thassa, Deep-Dwelling", "Wind Drake"] } ], "tapped": { "Wind Drake": false } } },
 { "name": "end step: choosing no target exiles nothing",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling", { "name": "Wind Drake", "tapped": true }] }, {} ],
   "steps": [ { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Wind Drake"] } ], "tapped": { "Wind Drake": true } } },
 { "name": "{3}{U}: taps another target creature",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling", "Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "activate": "Thassa, Deep-Dwelling", "ability": 0 }, { "resolve": true } ],
   "expect": { "tapped": { "Grizzly Bears": true } } },
 { "name": "with devotion below five Thassa is not a creature: it stays home while Grizzly Bears attacks",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling", "Grizzly Bears"] }, {} ],
   "steps": [ { "attack": [ { "card": "Thassa, Deep-Dwelling", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 18 } ] } },
 { "name": "with devotion five Thassa is a creature and can attack for 6",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling", "Wind Drake", "Wind Drake", "Wind Drake", "Wind Drake"] }, {} ],
   "steps": [ { "attack": [ { "card": "Thassa, Deep-Dwelling", "at": "p1" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 14 } ] } },
 { "name": "ruling: a God that is not a creature loses the creature type and the God subtype",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling"] }, {} ],
   "steps": [ { "advance_to": "Main2" } ],
   "expect": { "not_subtypes": { "Thassa, Deep-Dwelling": ["God"] } } },
 { "name": "ruling: counters stay on a God that is not a creature",
   "players": [ { "battlefield": [ { "name": "Thassa, Deep-Dwelling", "counters": { "PlusOnePlusOne": 1 } }, { "name": "Wind Drake", "tapped": true } ] }, {} ],
   "steps": [ { "advance_to": "End" }, { "resolve": true } ],
   "expect": { "counters": { "Thassa, Deep-Dwelling": { "PlusOnePlusOne": 1 } } } },
 { "name": "ruling: a God entering with devotion five counts as a creature entering (its own mana symbol counts): Soul Warden triggers",
   "players": [ { "hand": ["Thassa, Deep-Dwelling"], "battlefield": ["Soul Warden", "Wind Drake", "Wind Drake", "Wind Drake", "Wind Drake", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Thassa, Deep-Dwelling" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 21 }, {} ] } },
 { "name": "ruling: with devotion only four the God entering is not a creature, so Soul Warden does not trigger",
   "players": [ { "hand": ["Thassa, Deep-Dwelling"], "battlefield": ["Soul Warden", "Wind Drake", "Wind Drake", "Wind Drake", "Island", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "cast": "Thassa, Deep-Dwelling" }, { "resolve": true } ],
   "expect": { "players": [ { "life": 20 }, {} ], "not_subtypes": { "Thassa, Deep-Dwelling": ["God"] } } },
 { "name": "ruling: a creature you gained control of until end of turn is exiled by Thassa's end step trigger and returns under your control",
   "players": [ { "hand": ["Act of Treason"], "battlefield": ["Thassa, Deep-Dwelling", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Act of Treason", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Thassa, Deep-Dwelling", "Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] } ] } },
 { "name": "ruling: a creature returned by Thassa is a new object, so its counters are gone",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling", { "name": "Grizzly Bears", "counters": { "PlusOnePlusOne": 2 } }] }, {} ],
   "steps": [ { "advance_to": "End", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Thassa, Deep-Dwelling", "Grizzly Bears"] }, {} ], "counters": { "Grizzly Bears": { "PlusOnePlusOne": 0 } }, "pt": { "Grizzly Bears": [2, 2] } } },
 { "name": "ruling: an Aura on the exiled creature goes to its owner's graveyard when Thassa returns it",
   "players": [ { "hand": ["Pacifism"], "battlefield": ["Thassa, Deep-Dwelling", "Grizzly Bears", "Plains", "Plains"] }, {} ],
   "steps": [ { "cast": "Pacifism", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "advance_to": "End", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Pacifism"], "battlefield_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: generic mana symbols do not count toward devotion (four Grizzly Bears leave blue devotion at one, so Thassa cannot attack)",
   "players": [ { "battlefield": ["Thassa, Deep-Dwelling", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears", "Grizzly Bears"] }, {} ],
   "steps": [ { "attack": [ { "card": "Thassa, Deep-Dwelling", "at": "p1" } ], "illegal": true } ],
   "expect": { "players": [ {}, { "life": 20 } ] } },
 { "name": "ruling: an Aura you control on an opponent's creature still counts its mana symbols toward your devotion",
   "players": [ { "hand": ["Claustrophobia"], "battlefield": ["Thassa, Deep-Dwelling", "Wind Drake", "Wind Drake", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Claustrophobia", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "attack": [ { "card": "Thassa, Deep-Dwelling", "at": "p1" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ {}, { "life": 14 } ], "attached": { "Claustrophobia": "Grizzly Bears" } } },
 { "name": "ruling: a God that stops being a creature while attacking is removed from combat and deals no damage",
   "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Thassa, Deep-Dwelling", "Wind Drake", "Wind Drake", "Wind Drake", "Wind Drake", "Mountain"] }, {} ],
   "steps": [ { "attack": [ { "card": "Thassa, Deep-Dwelling", "at": "p1" } ] }, { "cast": "Lightning Bolt", "targets": ["Wind Drake"] }, { "resolve": true }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard_has": ["Lightning Bolt"] }, { "life": 20 } ] } },
 { "name": "ruling: Thassa is a creature card in the graveyard, so Raise Dead can return her to hand",
   "players": [ { "hand": ["Raise Dead"], "battlefield": ["Swamp"], "graveyard": ["Thassa, Deep-Dwelling"] }, {} ],
   "steps": [ { "cast": "Raise Dead", "targets": ["Thassa, Deep-Dwelling"] }, { "resolve": true } ],
   "expect": { "players": [ { "hand": ["Thassa, Deep-Dwelling"], "graveyard_has": ["Raise Dead"] }, {} ] } }
]
