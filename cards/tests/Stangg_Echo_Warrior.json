[
 { "name": "attack creates an attacking tapped Stangg Twin",
   "players": [ { "battlefield": ["Stangg, Echo Warrior"] }, {} ],
   "steps": [ { "attack": [ { "card": "Stangg, Echo Warrior", "at": "p1" } ] },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Stangg, Echo Warrior", "Stangg Twin"] }, {} ],
               "pt": { "Stangg Twin": [3, 4] } } },
 { "name": "equipment on Stangg is copied onto Stangg Twin (the copy gives +2/+2 to the Twin)",
   "players": [ { "battlefield": ["Stangg, Echo Warrior", "+2 Mace", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "activate": "+2 Mace", "targets": ["Stangg, Echo Warrior"] },
              { "resolve": true },
              { "attack": [ { "card": "Stangg, Echo Warrior", "at": "p1" } ] },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Stangg, Echo Warrior", "Stangg Twin"] }, {} ],
               "pt": { "Stangg Twin": [5, 6], "Stangg, Echo Warrior": [5, 6] } } },
 { "name": "the copied equipment is sacrificed at the next end step; the Twin stays",
   "players": [ { "battlefield": ["Stangg, Echo Warrior", "+2 Mace", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "activate": "+2 Mace", "targets": ["Stangg, Echo Warrior"] },
              { "resolve": true },
              { "attack": [ { "card": "Stangg, Echo Warrior", "at": "p1" } ] },
              { "resolve": true },
              { "advance_to": "End" },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Stangg, Echo Warrior", "Stangg Twin"] }, {} ],
               "pt": { "Stangg Twin": [3, 4], "Stangg, Echo Warrior": [5, 6] } } },
 { "name": "unequipped Stangg makes no copies and the Twin is not sacrificed",
   "players": [ { "battlefield": ["Stangg, Echo Warrior"] }, {} ],
   "steps": [ { "attack": [ { "card": "Stangg, Echo Warrior", "at": "p1" } ] },
              { "resolve": true },
              { "advance_to": "End" },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Stangg Twin"] }, {} ],
               "pt": { "Stangg Twin": [3, 4] } } },
 { "name": "ruling: the Twin given to the opponent is not sacrificed at the end step even though the copied equipment still is",
   "players": [ { "hand": ["Donate"], "battlefield": ["Stangg, Echo Warrior", "+2 Mace", "Plains", "Plains", "Plains", "Island", "Island", "Island"] }, {} ],
   "steps": [ { "activate": "+2 Mace", "targets": ["Stangg, Echo Warrior"] },
              { "resolve": true },
              { "attack": [ { "card": "Stangg, Echo Warrior", "at": "p1" } ] },
              { "resolve": true },
              { "advance_to": "Main2" },
              { "cast": "Donate", "targets": ["p1", "Stangg Twin"] },
              { "resolve": true },
              { "advance_to": "End" },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Stangg, Echo Warrior"], "battlefield_lacks": ["Stangg Twin"] }, { "battlefield_has": ["Stangg Twin"] } ],
               "pt": { "Stangg Twin": [3, 4] } } },
 { "name": "ruling: with Doubling Season the copied equipment is doubled and every copy is still sacrificed at the end step; the Twins stay",
   "players": [ { "battlefield": ["Stangg, Echo Warrior", "+2 Mace", "Doubling Season", "Plains", "Plains", "Plains"] }, {} ],
   "steps": [ { "activate": "+2 Mace", "targets": ["Stangg, Echo Warrior"] },
              { "resolve": true },
              { "attack": [ { "card": "Stangg, Echo Warrior", "at": "p1" } ] },
              { "resolve": true, "answers": [[0]] },
              { "advance_to": "End" },
              { "resolve": true } ],
   "expect": { "players": [ { "battlefield": ["Stangg, Echo Warrior", "+2 Mace", "Doubling Season", "Plains", "Plains", "Plains", "Stangg Twin"] }, {} ] } }
]
