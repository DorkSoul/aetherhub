[
  {
    "name": "heroic: your spell targeting it adds two +1/+1 counters",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Staunch-Hearted Warrior", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Giant Growth", "targets": ["Staunch-Hearted Warrior"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Staunch-Hearted Warrior": { "p1p1": 2 } },
      "pt": { "Staunch-Hearted Warrior": [7, 7] }
    }
  },
  {
    "name": "an opponent's spell does not trigger heroic",
    "players": [
      { "battlefield": ["Staunch-Hearted Warrior"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "pass": true },
      { "cast": "Lightning Bolt", "targets": ["Staunch-Hearted Warrior"], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Staunch-Hearted Warrior"] }, {} ]
    }
  },
  {
    "name": "ruling: heroic trigger resolves before the spell that caused it",
    "players": [
      { "hand": ["Giant Growth"], "battlefield": ["Staunch-Hearted Warrior", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Giant Growth", "targets": ["Staunch-Hearted Warrior"] },
      { "pass": true },
      { "pass": true, "player": 1 }
    ],
    "expect": {
      "stack_empty": false,
      "counters": { "Staunch-Hearted Warrior": { "p1p1": 2 } },
      "pt": { "Staunch-Hearted Warrior": [4, 4] }
    }
  },
  {
    "name": "ruling: a copy of a heroic spell does not trigger heroic",
    "players": [
      { "hand": ["Giant Growth", "Twincast"], "battlefield": ["Staunch-Hearted Warrior", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "advance_to": "Main1" },
      { "advance_to": "Main1" },
      { "cast": "Giant Growth", "targets": ["Staunch-Hearted Warrior"] },
      { "cast": "Twincast", "targets": [ { "stack": "Giant Growth" } ] },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "stack_empty": true,
      "counters": { "Staunch-Hearted Warrior": { "p1p1": 2 } },
      "pt": { "Staunch-Hearted Warrior": [10, 10] }
    }
  }
]
