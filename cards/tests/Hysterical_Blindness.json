[
  { "name": "opponents' creatures get -4/-0 until end of turn",
    "players": [
      { "hand": ["Hysterical Blindness"], "battlefield": ["Llanowar Elves", "Island", "Island", "Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [ { "cast": "Hysterical Blindness" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Llanowar Elves"] }, { "battlefield_has": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [-2, 2], "Llanowar Elves": [1, 1] } } },
  { "name": "creatures the caster controls are not affected",
    "players": [
      { "hand": ["Hysterical Blindness"], "battlefield": ["Grizzly Bears", "Island", "Island", "Island"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [ { "cast": "Hysterical Blindness" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "pt": { "Grizzly Bears": [2, 2], "Llanowar Elves": [-3, 1] } } },
  { "name": "ruling: the -4/-0 still applies after the creature changes control later in the turn",
    "players": [ { "hand": ["Hysterical Blindness", "Control Magic"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Hysterical Blindness" }, { "resolve": true }, { "cast": "Control Magic", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "battlefield_lacks": ["Grizzly Bears"] } ], "pt": { "Grizzly Bears": [-2, 2] } } }
]
