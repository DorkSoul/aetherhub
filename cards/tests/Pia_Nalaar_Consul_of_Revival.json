[
  {
    "name": "Thopters from a spell cast make a Thopter that can attack (haste)",
    "players": [
      {
        "hand": ["Pia and Kiran Nalaar"],
        "battlefield": ["Pia Nalaar, Consul of Revival", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Pia and Kiran Nalaar" },
      { "resolve": true },
      { "attack": [ { "card": "Thopter", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 19 }
      ]
    }
  },
  {
    "name": "playing a land from hand makes no Thopter",
    "players": [
      {
        "hand": ["Forest"],
        "battlefield": ["Pia Nalaar, Consul of Revival"]
      },
      {}
    ],
    "steps": [
      { "play_land": "Forest" }
    ],
    "expect": {
      "players": [
        {
          "battlefield": ["Pia Nalaar, Consul of Revival", "Forest"]
        },
        {}
      ]
    }
  },
  {
    "name": "casting a spell from exile makes a Thopter",
    "players": [ { "hand": ["Abbot of Keral Keep"], "battlefield": ["Pia Nalaar, Consul of Revival", "Mountain", "Mountain", "Mountain", "Mountain"], "library": ["Lightning Bolt"] }, {} ],
    "steps": [ { "cast": "Abbot of Keral Keep" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Thopter"] }, { "life": 17 } ] }
  },
  {
    "name": "playing a land from exile makes a Thopter",
    "players": [ { "hand": ["Abbot of Keral Keep"], "battlefield": ["Pia Nalaar, Consul of Revival", "Mountain", "Mountain", "Mountain"], "library": ["Forest"] }, {} ],
    "steps": [ { "cast": "Abbot of Keral Keep" }, { "resolve": true }, { "play_land": "Forest" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Thopter", "Forest"] }, {} ] }
  },
  {
    "name": "a spell cast from hand makes no Thopter",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Pia Nalaar, Consul of Revival", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Thopter"] }, { "life": 17 } ] }
  },
  {
    "name": "ruling: a Thopter that already attacked keeps attacking after Pia leaves",
    "players": [
      {
        "hand": ["Pia and Kiran Nalaar"],
        "battlefield": ["Pia Nalaar, Consul of Revival", "Mountain", "Mountain", "Mountain", "Mountain"]
      },
      {
        "hand": ["Lightning Bolt"],
        "battlefield": ["Mountain"]
      }
    ],
    "steps": [
      { "cast": "Pia and Kiran Nalaar" },
      { "resolve": true },
      { "attack": [ { "card": "Thopter", "at": "p1" } ] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Pia Nalaar, Consul of Revival"] },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard_has": ["Pia Nalaar, Consul of Revival"] },
        { "life": 19 }
      ]
    }
  }
]
