[
 { "name": "exiles nonland permanents with mana value 2 or less",
   "players": [ { "hand": ["Temporary Lockdown"], "battlefield": ["Plains", "Plains", "Plains"] },
                { "battlefield": ["Grizzly Bears", "Serra Angel", "Forest"] } ],
   "steps": [ { "cast": "Temporary Lockdown" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Temporary Lockdown"] },
                            { "battlefield_has": ["Serra Angel", "Forest"], "battlefield_lacks": ["Grizzly Bears"], "exile": ["Grizzly Bears"] } ] } },
 { "name": "exiled permanents return when the enchantment leaves the battlefield",
   "players": [ { "hand": ["Temporary Lockdown"], "battlefield": ["Plains", "Plains", "Plains"] },
                { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Temporary Lockdown" }, { "resolve": true }, { "resolve": true },
              { "pass": true },
              { "cast": "Disenchant", "player": 1, "targets": ["Temporary Lockdown"] }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Temporary Lockdown"] },
                            { "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: an Aura with mana value 3 or more on an exiled creature goes to its owner's graveyard",
   "players": [ { "hand": ["Temporary Lockdown", "Arrest"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] },
                { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Arrest", "targets": ["Grizzly Bears"] }, { "resolve": true },
              { "cast": "Temporary Lockdown" }, { "resolve": true }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard": ["Arrest"], "battlefield_has": ["Temporary Lockdown"] },
                            { "exile": ["Grizzly Bears"], "battlefield_lacks": ["Grizzly Bears"] } ] } },
 { "name": "ruling: enchantment removed in response to its enters trigger means nothing is exiled",
   "players": [ { "hand": ["Temporary Lockdown"], "battlefield": ["Plains", "Plains", "Plains"] },
                { "hand": ["Disenchant"], "battlefield": ["Plains", "Plains", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Temporary Lockdown" }, { "resolve": true }, { "pass": true },
              { "cast": "Disenchant", "player": 1, "targets": ["Temporary Lockdown"] },
              { "pass": true, "player": 1 }, { "pass": true }, { "pass": true }, { "pass": true, "player": 1 } ],
   "expect": { "players": [ { "graveyard_has": ["Temporary Lockdown"] }, { "battlefield_has": ["Grizzly Bears"] } ] } }
]
