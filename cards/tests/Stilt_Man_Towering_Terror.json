[
  { "name": "combat damage to a player steals their noncreature nonland permanent",
    "players": [ { "battlefield": ["Stilt-Man, Towering Terror"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "attack": [ { "card": "Stilt-Man, Towering Terror", "at": "p1" } ] }, { "resolve": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Stilt-Man, Towering Terror", "Sol Ring"] }, { "battlefield": [] } ] } },
  { "name": "a Villain's combat damage to a player with only creatures does not trigger",
    "players": [ { "battlefield": ["Stilt-Man, Towering Terror"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Stilt-Man, Towering Terror", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "stack_empty": true, "players": [ { "battlefield_has": ["Stilt-Man, Towering Terror"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "a non-Villain attacker does not trigger",
    "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield": ["Sol Ring"] } ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true } ],
    "expect": { "stack_empty": true, "players": [ { "battlefield": ["Grizzly Bears"] }, { "battlefield_has": ["Sol Ring"] } ] } }
]
