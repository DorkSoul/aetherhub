 {
  "name": "ruling: the cycling ability is not a spell, so Spell Swindle has nothing to counter",
  "players": [
   { "hand": ["Titanoth Rex"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] },
   { "hand": ["Spell Swindle"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] }
  ],
  "steps": [
   { "activate": "Titanoth Rex" },
   { "pass": true },
   { "cast": "Spell Swindle", "player": 1, "illegal": true }
  ],
  "expect": {
   "players": [
    { "graveyard_has": ["Titanoth Rex"] },
    { "hand": ["Spell Swindle"] }
   ]
  }
 },
 {
  "name": "ruling: cycling works even with no creature for the trigger to target",
  "players": [
