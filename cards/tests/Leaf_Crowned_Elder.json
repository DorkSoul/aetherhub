[
  {
    "name": "kinship: a matching creature on top may be revealed and cast free",
    "players": [
      { "battlefield": ["Leaf-Crowned Elder"], "library": ["Burlfist Oak", "Plains", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [["Burlfist Oak"], true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Leaf-Crowned Elder", "Burlfist Oak"], "library_count": 2 },
        {}
      ]
    }
  },
  {
    "name": "kinship: declining to play leaves the matching card on top of the library",
    "players": [
      { "battlefield": ["Leaf-Crowned Elder"], "library": ["Burlfist Oak", "Plains", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [["Burlfist Oak"], false] }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Burlfist Oak"], "library_count": 3 },
        {}
      ]
    }
  },
  {
    "name": "kinship: a card that shares no creature type is not revealed",
    "players": [
      { "battlefield": ["Leaf-Crowned Elder"], "library": ["Grizzly Bears", "Plains", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Grizzly Bears"], "library_count": 3 },
        {}
      ]
    }
  },
  {
    "name": "ruling: not revealing is optional, so the matching card stays on top and nothing is cast",
    "players": [
      { "battlefield": ["Leaf-Crowned Elder"], "library": ["Burlfist Oak", "Plains", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Burlfist Oak"], "library_top": ["Burlfist Oak"], "library_count": 3 },
        {}
      ]
    }
  },
  {
    "name": "ruling: after kinship resolves the looked-at card remains on top of the library",
    "players": [
      { "battlefield": ["Leaf-Crowned Elder"], "library": ["Burlfist Oak", "Plains", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [["Burlfist Oak"], false] }
    ],
    "expect": {
      "players": [
        { "battlefield_lacks": ["Burlfist Oak"], "library_top": ["Burlfist Oak"], "library_count": 3 },
        {}
      ]
    }
  },
  {
    "name": "ruling: two kinship triggers look at the same card (first declines, second takes and casts it)",
    "players": [
      { "battlefield": ["Leaf-Crowned Elder", "Leaf-Crowned Elder"], "library": ["Burlfist Oak", "Plains", "Forest"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[], ["Burlfist Oak"], true] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Leaf-Crowned Elder", "Burlfist Oak"], "library_top": ["Plains"], "library_count": 2 },
        {}
      ]
    }
  }
