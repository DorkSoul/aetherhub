[
 {
  "name": "creature it damaged in combat is exiled instead of dying",
  "players": [
   { "battlefield": ["Kumano's Pupils"] },
   { "battlefield": ["Savannah Lions"] }
  ],
  "steps": [
   { "attack": [ { "card": "Kumano's Pupils", "at": "p1" } ] },
   { "block": [ { "blocker": "Savannah Lions", "attacker": "Kumano's Pupils" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "exile": ["Savannah Lions"] } ]
  }
 },
 {
  "name": "creature damaged by another source dies normally",
  "players": [
   { "battlefield": ["Kumano's Pupils", "Mountain"], "hand": ["Lightning Bolt"] },
   { "battlefield": ["Savannah Lions"] }
  ],
  "steps": [
   { "cast": "Lightning Bolt", "targets": ["Savannah Lions"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ {}, { "graveyard": ["Savannah Lions"] } ]
  }
 },
 {
  "name": "ruling: a creature dealt damage by Pupils is exiled even when it dies at the same time as Pupils",
  "players": [
   { "battlefield": ["Kumano's Pupils"] },
   { "battlefield": ["Hill Giant"] }
  ],
  "steps": [
   { "attack": [ { "card": "Kumano's Pupils", "at": "p1" } ] },
   { "block": [ { "blocker": "Hill Giant", "attacker": "Kumano's Pupils" } ] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ { "graveyard": ["Kumano's Pupils"] }, { "exile": ["Hill Giant"] } ]
  }
 },
 {
  "name": "ruling: Pupils must be on the battlefield when the creature would die, so a later death is not exiled",
  "players": [
   { "battlefield": ["Kumano's Pupils", "Mountain"], "hand": ["Lightning Bolt"] },
   { "battlefield": ["Serra Angel"] }
  ],
  "steps": [
   { "attack": [ { "card": "Kumano's Pupils", "at": "p1" } ] },
   { "block": [ { "blocker": "Serra Angel", "attacker": "Kumano's Pupils" } ] },
   { "advance_to": "Main2" },
   { "cast": "Lightning Bolt", "targets": ["Serra Angel"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Kumano's Pupils", "Lightning Bolt"] }, { "graveyard": ["Serra Angel"] } ]
  }
 }
]
