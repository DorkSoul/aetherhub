  { "name": "enters with five -1/-1 counters and is a 1/1",
    "players": [ { "hand": ["Bristlebane Battler"], "battlefield": ["Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Bristlebane Battler" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bristlebane Battler"] }, {} ], "counters": { "Bristlebane Battler": { "MinusOneMinusOne": 5 } }, "pt": { "Bristlebane Battler": [1, 1] } } },
  { "name": "another creature entering removes one -1/-1 counter",
    "players": [ { "hand": ["Bristlebane Battler", "Llanowar Elves"], "battlefield": ["Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "cast": "Bristlebane Battler" }, { "resolve": true }, { "cast": "Llanowar Elves" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bristlebane Battler", "Llanowar Elves"] }, {} ], "counters": { "Bristlebane Battler": { "MinusOneMinusOne": 4 } }, "pt": { "Bristlebane Battler": [2, 2] } } },
  { "name": "the Battler itself entering does not remove a counter",
    "players": [ { "hand": ["Bristlebane Battler"], "battlefield": ["Forest", "Forest", "Llanowar Elves"] }, {} ],
    "steps": [ { "cast": "Bristlebane Battler" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Bristlebane Battler": { "MinusOneMinusOne": 5 } } } },
  { "name": "ward {2}: the opponent has only 1 spare mana, cannot pay, Bolt is countered",
