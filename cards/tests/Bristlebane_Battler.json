    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Bristlebane Battler"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "battlefield_has": ["Bristlebane Battler"] }, { "graveyard_has": ["Lightning Bolt"], "life": 20 } ], "pt": { "Bristlebane Battler": [1, 1] } } },
  { "name": "ward {2}: the opponent pays 2 with spare mana, Bolt resolves and kills it",
    "players": [ { "battlefield": ["Bristlebane Battler"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Bristlebane Battler"] }, { "resolve": true, "auto": true } ],
    "expect": { "players": [ { "graveyard": ["Bristlebane Battler"] }, { "life": 20 } ] } }
