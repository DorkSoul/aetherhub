[
  {
    "name": "{1}: chosen creature type replaces the target's creature types until end of turn",
    "players": [
      { "battlefield": ["Unnatural Selection", "Swamp", { "name": "Grizzly Bears", "sick": false }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Unnatural Selection", "targets": ["Grizzly Bears"] },
      { "resolve": true, "answers": ["Elf"] }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Unnatural Selection", "Grizzly Bears"] }, {}],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "changing creature type does not change power or toughness of a creature on the opponent's side",
    "players": [
      { "battlefield": ["Unnatural Selection", "Swamp"] },
      { "battlefield": [{ "name": "Hill Giant", "sick": false }] }
    ],
    "steps": [
      { "activate": "Unnatural Selection", "targets": ["Hill Giant"] },
      { "resolve": true, "answers": ["Bear"] }
    ],
    "expect": {
      "pt": { "Hill Giant": [3, 3] }
    }
  }
]
