[
 { "name": "discards every card with the named name from the target's hand",
   "players": [ { "hand": ["Cabal Therapy"], "battlefield": ["Swamp"] },
                { "hand": ["Lightning Bolt", "Lightning Bolt", "Giant Growth"] } ],
   "steps": [ { "cast": "Cabal Therapy", "targets": ["p1"] }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
   "expect": { "players": [ { "graveyard_has": ["Cabal Therapy"] }, { "hand": ["Giant Growth"], "graveyard_has": ["Lightning Bolt", "Lightning Bolt"] } ] } },
 { "name": "a card with another name is not discarded",
   "players": [ { "hand": ["Cabal Therapy"], "battlefield": ["Swamp"] },
                { "hand": ["Lightning Bolt", "Giant Growth"] } ],
   "steps": [ { "cast": "Cabal Therapy", "targets": ["p1"] }, { "resolve": true, "answers": ["Giant Growth"] } ],
   "expect": { "players": [ { }, { "hand": ["Lightning Bolt"], "graveyard_has": ["Giant Growth"] } ] } },
 { "name": "flashback: sacrifice a creature instead of paying the mana cost, then the card is exiled",
   "players": [ { "graveyard": ["Cabal Therapy"], "battlefield": ["Swamp", "Grizzly Bears"] },
                { "hand": ["Lightning Bolt"] } ],
   "steps": [ { "cast": "Cabal Therapy", "alt": 0, "targets": ["p1"] }, { "resolve": true, "answers": ["Lightning Bolt"] } ],
   "expect": { "players": [ { "exile": ["Cabal Therapy"], "graveyard_has": ["Grizzly Bears"] }, { "hand_count": 0, "graveyard_has": ["Lightning Bolt"] } ] } },
 { "name": "flashback needs a creature to sacrifice: without one the cast is illegal",
   "players": [ { "graveyard": ["Cabal Therapy"], "battlefield": ["Swamp"] },
                { "hand": ["Lightning Bolt"] } ],
   "steps": [ { "cast": "Cabal Therapy", "alt": 0, "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Cabal Therapy"] }, { "hand": ["Lightning Bolt"] } ] } },
 { "name": "ruling: flashback is sorcery speed, so it can't be cast during the opponent's turn",
   "players": [ { "graveyard": ["Cabal Therapy"], "battlefield": ["Swamp", "Grizzly Bears"] },
                { "hand": ["Lightning Bolt"] } ],
   "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 },
              { "cast": "Cabal Therapy", "alt": 0, "targets": ["p1"], "illegal": true } ],
   "expect": { "players": [ { "graveyard": ["Cabal Therapy"], "battlefield_has": ["Grizzly Bears"] }, {} ] } },
 { "name": "ruling: a flashback spell that is countered is still exiled",
   "players": [ { "graveyard": ["Cabal Therapy"], "battlefield": ["Swamp", "Grizzly Bears"] },
                { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] } ],
   "steps": [ { "cast": "Cabal Therapy", "alt": 0, "targets": ["p1"] }, { "pass": true },
              { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Cabal Therapy" }] }, { "resolve": true } ],
   "expect": { "players": [ { "exile": ["Cabal Therapy"], "graveyard_has": ["Grizzly Bears"] }, { "graveyard_has": ["Counterspell"] } ] } }
]
