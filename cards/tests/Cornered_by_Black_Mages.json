[
 {"name": "opponent sacrifices a creature and you get a 0/1 Wizard",
  "players": [ { "hand": ["Cornered by Black Mages"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Cornered by Black Mages", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Wizard 0-1"] }, { "graveyard": ["Grizzly Bears"] } ] } },
 {"name": "with no creature to sacrifice the Wizard is still created",
  "players": [ { "hand": ["Cornered by Black Mages"], "battlefield": ["Swamp", "Swamp", "Swamp"] }, { "battlefield": ["Forest"] } ],
  "steps": [ { "cast": "Cornered by Black Mages", "targets": ["p1"] }, { "resolve": true } ],
  "expect": { "players": [ { "battlefield_has": ["Wizard 0-1"] }, {} ] } },
 {"name": "the Wizard pings each opponent when you cast a noncreature spell",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Wizard 0-1"], "life": 20 }, { "life": 20 } ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ { "life": 20 }, { "life": 16 } ] } },
 {"name": "ruling: the Wizard's ping still happens when the spell that caused it is countered",
  "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Wizard 0-1"], "life": 20 }, { "hand": ["Counterspell"], "battlefield": ["Island", "Island"], "life": 20 } ],
  "steps": [ { "cast": "Lightning Bolt", "targets": ["p1"] }, { "cast": "Counterspell", "player": 1, "targets": [{"stack": "Lightning Bolt"}] }, { "resolve": true } ],
  "expect": { "players": [ { "graveyard": ["Lightning Bolt"] }, { "life": 19, "graveyard": ["Counterspell"] } ], "stack_empty": true } }
]
