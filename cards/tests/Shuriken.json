[
  {
    "name": "non-Ninja host: Shuriken deals 2 and its equipped creature's rival target's controller gains control",
    "players": [ { "hand": ["Shuriken"], "battlefield": ["Plains", "Plains", "Plains", "Grizzly Bears"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "cast": "Shuriken" },
      { "resolve": true },
      { "activate": "Shuriken", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "activate": "Grizzly Bears", "ability": 32768, "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Grizzly Bears"], "battlefield_lacks": ["Shuriken"] }, { "battlefield_has": ["Serra Angel", "Shuriken"] } ]
    }
  },
  {
    "name": "Ninja host: the controller of the target does not gain control of Shuriken",
    "players": [ { "hand": ["Shuriken"], "battlefield": ["Plains", "Plains", "Plains", "Ninja of the Deep Hours"] }, { "battlefield": ["Serra Angel"] } ],
    "steps": [
      { "cast": "Shuriken" },
      { "resolve": true },
      { "activate": "Shuriken", "ability": 0, "targets": ["Ninja of the Deep Hours"] },
      { "resolve": true },
      { "activate": "Ninja of the Deep Hours", "ability": 32768, "targets": ["Serra Angel"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Ninja of the Deep Hours", "Shuriken"] }, { "battlefield_has": ["Serra Angel"], "battlefield_lacks": ["Shuriken"] } ]
    }
  },
  {
    "name": "2 damage from Shuriken kills a 2-toughness creature",
    "players": [ { "hand": ["Shuriken"], "battlefield": ["Plains", "Plains", "Plains", "Ninja of the Deep Hours"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Shuriken" },
      { "resolve": true },
      { "activate": "Shuriken", "ability": 0, "targets": ["Ninja of the Deep Hours"] },
      { "resolve": true },
      { "activate": "Ninja of the Deep Hours", "ability": 32768, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Shuriken"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
