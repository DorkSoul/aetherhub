[
  { "name": "upkeep: paid {1}{U} keeps it",
    "players": [ { "hand": ["Drifting Djinn"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Drifting Djinn" }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [true] } ],
    "expect": { "players": [ { "battlefield_has": ["Drifting Djinn"] }, {} ] } },
  { "name": "upkeep: not paid, sacrificed",
    "players": [ { "hand": ["Drifting Djinn"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "cast": "Drifting Djinn" }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "answers": [false] } ],
    "expect": { "players": [ { "graveyard_has": ["Drifting Djinn"] }, {} ] } },
  { "name": "cycling {2}: discard to draw a card",
    "players": [ { "hand": ["Drifting Djinn"], "battlefield": ["Island", "Island"] }, {} ],
    "steps": [ { "activate": "Drifting Djinn" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Drifting Djinn"], "hand_count": 1 }, {} ] } },
  { "name": "ruling: Djinn bounced before its upkeep trigger resolves, so nothing is sacrificed",
    "players": [ { "hand": ["Unsummon"], "battlefield": ["Drifting Djinn", "Island", "Island", "Island"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep", "hold": true }, { "cast": "Unsummon", "targets": ["Drifting Djinn"] }, { "pass": true }, { "pass": true }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ { "hand": ["Drifting Djinn"], "graveyard": ["Unsummon"] }, {} ] } }
]
