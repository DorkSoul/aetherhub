[
  {
    "name": "enters: creates a 2/2 Rebel and attaches to it",
    "players": [
      { "hand": ["Hexplate Wallbreaker"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Hexplate Wallbreaker" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hexplate Wallbreaker", "Rebel 2-2"] },
        {}
      ],
      "attached": { "Hexplate Wallbreaker": "Rebel 2-2" },
      "pt": { "Rebel 2-2": [4, 4] }
    }
  },
  {
    "name": "equip {3}{R} attaches to a creature you control and gives +2/+2",
    "players": [
      { "battlefield": ["Hexplate Wallbreaker", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Hexplate Wallbreaker", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hexplate Wallbreaker", "Grizzly Bears"] },
        {}
      ],
      "attached": { "Hexplate Wallbreaker": "Grizzly Bears" },
      "pt": { "Grizzly Bears": [4, 4] }
    }
  },
  {
    "name": "equip needs four mana: three Mountains is illegal",
    "players": [
      { "battlefield": ["Hexplate Wallbreaker", "Grizzly Bears", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Hexplate Wallbreaker", "ability": 0, "illegal": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hexplate Wallbreaker"] },
        {}
      ],
      "pt": { "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "equipped creature attacks in the first combat: attackers are untapped",
    "players": [
      { "battlefield": ["Hexplate Wallbreaker", "Grizzly Bears", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "activate": "Hexplate Wallbreaker", "ability": 0 },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Hexplate Wallbreaker", "Grizzly Bears"] },
        { "life": 16 }
      ],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: when the Rebel is destroyed the Equipment stays on the battlefield, unattached",
    "players": [
      { "hand": ["Hexplate Wallbreaker", "Flame Slash"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Hexplate Wallbreaker" },
      { "resolve": true },
      { "cast": "Flame Slash", "targets": ["Rebel 2-2"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Hexplate Wallbreaker"], "battlefield_lacks": ["Rebel 2-2"] }, {} ]
    }
  }
]
