  {
    "name": "equipped Bears is unblockable: Serra Angel's block on it is dropped, Hill Giant blocks the Lions",
    "players": [
      {
        "hand": ["Silver Shroud Costume"],
        "battlefield": ["Plains", "Plains", { "name": "Grizzly Bears", "sick": false }, { "name": "Savannah Lions", "sick": false }]
      },
      {
        "battlefield": ["Serra Angel", "Hill Giant"]
      }
    ],
    "steps": [
      { "cast": "Silver Shroud Costume" },
      { "resolve": true, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" }, { "card": "Savannah Lions", "at": "p1" } ] },
      { "block": [ { "blocker": "Serra Angel", "attacker": "Grizzly Bears" }, { "blocker": "Hill Giant", "attacker": "Savannah Lions" } ], "player": 1 },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "attached": { "Silver Shroud Costume": "Grizzly Bears" },
      "players": [
        { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Savannah Lions"] },
        { "life": 18, "battlefield_has": ["Serra Angel", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "ruling: attaching Silver Shroud Costume to an already-blocked creature does not unblock it",
    "players": [
      {
        "hand": ["Silver Shroud Costume"],
        "battlefield": ["Plains", "Plains", { "name": "Grizzly Bears", "sick": false }]
      },
      {
        "battlefield": ["Hill Giant"]
      }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "cast": "Silver Shroud Costume" },
      { "resolve": true },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Grizzly Bears"] },
        { "life": 20, "battlefield_has": ["Hill Giant"] }
      ]
    }
  }
