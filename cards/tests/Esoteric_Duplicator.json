[
  {
    "name": "sacrificing itself and paying {2}: a token copy of it is created at the next end step",
    "players": [
      { "battlefield": ["Esoteric Duplicator", "Island", "Island", "Island", "Island"], "library": ["Swamp"] },
      {}
    ],
    "steps": [
      { "activate": "Esoteric Duplicator", "ability": 0 },
      { "resolve": true, "answers": [true] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Esoteric Duplicator"], "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "declining to pay {2}: no copy",
    "players": [
      { "battlefield": ["Esoteric Duplicator", "Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Esoteric Duplicator", "ability": 0 },
      { "resolve": true, "answers": [false] },
      { "resolve": true },
      { "advance_to": "End" }
    ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Esoteric Duplicator"] }, {} ]
    }
  },
  {
    "name": "sacrificing another artifact: a token copy of that artifact is created at the next end step",
    "players": [
      { "battlefield": ["Esoteric Duplicator", "Golgari Cluestone", "Swamp", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Golgari Cluestone", "ability": 0 },
      { "resolve": true, "answers": [true] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Esoteric Duplicator", "Golgari Cluestone"] }, {} ]
    }
  },
  {
    "name": "ruling: the token copies only the printed characteristics (no counters from the original)",
    "players": [
      { "battlefield": ["Esoteric Duplicator", {"name": "Golgari Cluestone", "counters": {"p1p1": 2}}, "Swamp", "Forest", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "activate": "Golgari Cluestone", "ability": 0 },
      { "resolve": true, "answers": [true] },
      { "resolve": true },
      { "advance_to": "End" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Esoteric Duplicator", "Golgari Cluestone"] }, {} ],
      "counters": { "Golgari Cluestone": { "p1p1": 0 } }
    }
  }
]
