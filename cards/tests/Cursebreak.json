[
  {
    "name": "destroys target enchantment and gains 2 life",
    "players": [
      { "hand": ["Cursebreak"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Curse of Marit Lage"] }
    ],
    "steps": [
      { "cast": "Cursebreak", "targets": ["Curse of Marit Lage"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "graveyard_has": ["Cursebreak"] },
        { "graveyard_has": ["Curse of Marit Lage"] }
      ]
    }
  },
  {
    "name": "needs an enchantment target: no life gain without one",
    "players": [
      { "hand": ["Cursebreak"], "battlefield": ["Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Cursebreak", "illegal": true }
    ],
    "expect": {
      "players": [ { "life": 20, "hand_count": 1 }, {} ]
    }
  },
  {
    "name": "ruling: if the enchantment target is gone on resolution, Cursebreak is countered and no life is gained",
    "players": [
      { "hand": ["Paralyze", "Cursebreak"], "battlefield": ["Swamp", "Plains", "Plains"] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Paralyze", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Cursebreak", "targets": ["Paralyze"] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Cursebreak", "Paralyze"] },
        { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }
      ]
    }
  }
]
