[
  { "name": "remove X counters among your creatures: target creature gets -X/-X",
    "players": [
      { "battlefield": ["Retribution of the Ancients", "Swamp", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Retribution of the Ancients", "ability": 0, "targets": ["Hill Giant"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 0 } },
      "pt": { "Hill Giant": [1, 1], "Grizzly Bears": [2, 2] }
    }
  },
  { "name": "X counters are taken from several of your creatures and the target dies",
    "players": [
      { "battlefield": ["Retribution of the Ancients", "Swamp", { "name": "Hill Giant", "counters": { "p1p1": 1 } }, { "name": "Llanowar Elves", "counters": { "p1p1": 1 } }] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Retribution of the Ancients", "ability": 0, "targets": ["Grizzly Bears"], "answers": [2] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Hill Giant": { "p1p1": 0 }, "Llanowar Elves": { "p1p1": 0 } },
      "players": [ {}, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  { "name": "X of zero costs only B and changes nothing",
    "players": [
      { "battlefield": ["Retribution of the Ancients", "Swamp", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Retribution of the Ancients", "ability": 0, "targets": ["Hill Giant"], "answers": [0] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "pt": { "Hill Giant": [3, 3] }
    }
  },
  { "name": "needs {B} to activate",
    "players": [
      { "battlefield": ["Retribution of the Ancients", "Mountain", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "activate": "Retribution of the Ancients", "ability": 0, "targets": ["Hill Giant"], "answers": [1], "illegal": true }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "p1p1": 2 } },
      "pt": { "Hill Giant": [3, 3] }
    }
  },
  { "name": "ruling: costs are already paid when the opponent responds, so killing the counter creature does not stop the -X/-X",
    "players": [
      { "battlefield": ["Retribution of the Ancients", "Swamp", { "name": "Grizzly Bears", "counters": { "p1p1": 2 } }] },
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Retribution of the Ancients", "ability": 0, "targets": ["Hill Giant"], "answers": [2] },
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Lightning Bolt"] }],
      "pt": { "Hill Giant": [1, 1] }
    }
  }
]
