[
  { "name": "destroys the artifact and puts a land from hand onto the battlefield",
    "players": [ { "hand": ["Broken Bond", "Forest"], "battlefield": ["Forest", "Forest", "Mind Stone"] }, {} ],
    "steps": [ { "cast": "Broken Bond", "targets": ["Mind Stone"] }, { "resolve": true, "answers": ["Forest"] } ],
    "expect": { "players": [ { "hand": [], "battlefield_has": ["Forest", "Forest", "Forest"], "graveyard_has": ["Mind Stone", "Broken Bond"], "battlefield_lacks": ["Mind Stone"] }, {} ] } },
  { "name": "may decline: no land is put onto the battlefield",
    "players": [ { "hand": ["Broken Bond", "Forest"], "battlefield": ["Forest", "Forest", "Glorious Anthem"] }, {} ],
    "steps": [ { "cast": "Broken Bond", "targets": ["Glorious Anthem"] }, { "resolve": true, "answers": [] } ],
    "expect": { "players": [ { "hand": ["Forest"], "graveyard_has": ["Glorious Anthem"] }, {} ] } },
  { "name": "needs an artifact or enchantment target",
    "players": [ { "hand": ["Broken Bond", "Forest"], "battlefield": ["Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Broken Bond", "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "hand": ["Broken Bond", "Forest"] }, {} ] } },
  { "name": "ruling: the land put onto the battlefield does not count as a land drop",
    "players": [ { "hand": ["Broken Bond", "Forest", "Forest"], "battlefield": ["Forest", "Mind Stone"] }, {} ],
    "steps": [ { "play_land": "Forest" }, { "cast": "Broken Bond", "targets": ["Mind Stone"] }, { "resolve": true, "answers": ["Forest"] } ],
    "expect": { "players": [ { "hand": [], "battlefield_has": ["Forest", "Forest", "Forest"], "battlefield_lacks": ["Mind Stone"] }, {} ] } },
  { "name": "ruling: if the target is gone on resolution, no land is put onto the battlefield",
    "players": [ { "hand": ["Broken Bond", "Forest"], "battlefield": ["Forest", "Forest", "Mind Stone"] }, { "hand": ["Shatter"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "cast": "Broken Bond", "targets": ["Mind Stone"] }, { "pass": true }, { "cast": "Shatter", "player": 1, "targets": ["Mind Stone"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "hand": ["Forest"], "graveyard_has": ["Mind Stone", "Broken Bond"], "battlefield_lacks": ["Mind Stone"] }, { "graveyard_has": ["Shatter"] } ] } }
]
