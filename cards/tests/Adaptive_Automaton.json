[
 {
  "name": "it is the chosen type and pumps others of that type",
  "players": [
   {
    "hand": [
     "Adaptive Automaton"
    ],
    "battlefield": [
     "Grizzly Bears",
     "Elvish Champion",
     "Plains",
     "Plains",
     "Plains"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Adaptive Automaton"
   },
   {
    "resolve": true,
    "answers": [
     "Bear"
    ]
   }
  ],
  "expect": {
   "pt": {
    "Grizzly Bears": [
     3,
     3
    ],
    "Adaptive Automaton": [
     2,
     2
    ]
   }
  }
 },
 {
  "name": "a second Automaton choosing Bear is a Bear too, so the first one gets the pump",
  "players": [
   {
    "hand": ["Adaptive Automaton", "Adaptive Automaton"],
    "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"]
   },
   {}
  ],
  "steps": [
   {"cast": "Adaptive Automaton"},
   {"resolve": true, "answers": ["Bear"]},
   {"cast": "Adaptive Automaton"},
   {"resolve": true, "answers": ["Bear"]}
  ],
  "expect": {
   "pt": {
    "Adaptive Automaton": [3, 3]
   }
  }
 },
 {
  "name": "ruling: a Construct only gets the pump if Construct was the chosen type",
  "players": [
   { "hand": ["Adaptive Automaton"], "battlefield": ["Brass Man", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [ { "cast": "Adaptive Automaton" }, { "resolve": true, "answers": ["Human"] } ],
  "expect": { "pt": { "Brass Man": [1,3], "Adaptive Automaton": [2,2] } }
 },
 {
  "name": "ruling: choosing Construct pumps the other Construct",
  "players": [
   { "hand": ["Adaptive Automaton"], "battlefield": ["Brass Man", "Plains", "Plains", "Plains"] },
   {}
  ],
  "steps": [ { "cast": "Adaptive Automaton" }, { "resolve": true, "answers": ["Construct"] } ],
  "expect": { "pt": { "Brass Man": [2,4], "Adaptive Automaton": [2,2] } }
 }
]