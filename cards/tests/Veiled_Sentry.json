        "pass": true
      },
      {
        "cast": "Impulse",
        "player": 1
      },
      {
        "resolve": true
      },
      {
        "pass": true
      },
      {
        "cast": "Dark Ritual",
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
