  {
    "name": "ruling: a spell countered before its trigger resolves still sets P/T from its mana value (2)",
    "players": [
      {"battlefield": ["Veiled Sentry", "Island", "Island"], "hand": ["Counterspell"]},
      {"battlefield": ["Island", "Island"], "hand": ["Impulse"]}
    ],
    "steps": [
      {"pass": true},
      {"cast": "Impulse", "player": 1},
      {"pass": true, "player": 1},
      {"cast": "Counterspell", "targets": [{"stack": "Impulse"}]},
      {"pass": true},
      {"pass": true, "player": 1},
      {"resolve": true}
    ],
    "expect": {
      "pt": {"Veiled Sentry": [2, 2]},
      "players": [
        {"battlefield_has": ["Veiled Sentry"], "graveyard": ["Counterspell"]},
        {"graveyard": ["Impulse"]}
      ]
    }
  },
  {
    "name": "ruling: the Sentry is already a creature while the spell is still on the stack (Lightning Bolt can target it)",
    "players": [
      {"battlefield": ["Veiled Sentry", "Mountain"], "hand": ["Lightning Bolt"]},
      {"battlefield": ["Island", "Island"], "hand": ["Impulse"]}
    ],
    "steps": [
      {"pass": true},
      {"cast": "Impulse", "player": 1},
      {"pass": true, "player": 1},
      {"pass": true},
      {"pass": true, "player": 1},
      {"cast": "Lightning Bolt", "targets": ["Veiled Sentry"]},
      {"pass": true},
      {"pass": true, "player": 1},
      {"resolve": true}
    ],
    "expect": {
      "players": [
        {"graveyard": ["Lightning Bolt", "Veiled Sentry"]},
        {"graveyard": ["Impulse"]}
      ]
    }
  },
  {
    "name": "ruling: once it is a creature it is no longer an enchantment, so Naturalize cannot target it",
    "players": [
      {"battlefield": ["Veiled Sentry", "Forest", "Forest"], "hand": ["Naturalize"]},
      {"battlefield": ["Island", "Island"], "hand": ["Impulse"]}
    ],
    "steps": [
      {"pass": true},
      {"cast": "Impulse", "player": 1},
      {"resolve": true},
      {"cast": "Naturalize", "targets": ["Veiled Sentry"], "illegal": true}
    ],
    "expect": {
      "pt": {"Veiled Sentry": [2, 2]},
      "players": [
        {"battlefield_has": ["Veiled Sentry"], "hand": ["Naturalize"]},
        {"graveyard": ["Impulse"]}
      ]
    }
  }
