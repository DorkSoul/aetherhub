[
  {
    "name": "an opponent's spell makes it a creature with P/T equal to that spell's mana value (Impulse, mana value 2)",
    "players": [
      {
        "battlefield": [
          "Veiled Sentry"
        ]
      },
      {
        "battlefield": [
          "Island",
          "Island"
        ],
        "hand": [
          "Impulse"
        ]
      }
    ],
    "steps": [
      {
        "pass": true
      },
      {
        "cast": "Impulse",
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "pt": {
        "Veiled Sentry": [
          2,
          2
        ]
      },
      "players": [
        {
          "battlefield": [
            "Veiled Sentry"
          ]
        },
        {
          "graveyard": [
            "Impulse"
          ]
        }
      ]
    }
  },
  {
