[
  {
    "name": "ingest: combat damage to a player exiles the top card of their library",
    "players": [{ "battlefield": ["Salvage Drone"] }, { "library": ["Island"] }],
    "steps": [
      { "attack": [{ "card": "Salvage Drone", "at": "p1" }] },
      { "advance_to": "Main2" },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "exile": ["Island"], "life": 19 }] }
  },
  {
    "name": "when it dies, you may draw a card, then discard a card",
    "players": [
      { "hand": ["Forest"], "battlefield": ["Salvage Drone"], "library": ["Island"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Salvage Drone", "at": "p1" }] },
      { "block": [{ "blocker": "Grizzly Bears", "attacker": "Salvage Drone" }] },
      { "advance_to": "Main2", "answers": [true, "Island"] }
    ],
    "expect": { "players": [{ "graveyard_has": ["Salvage Drone"], "hand": ["Forest"], "hand_count": 1 }, {}] }
  },
  {
    "name": "ruling: devoid makes the card colorless, not colored by its {U} mana cost",
    "players": [{ "battlefield": ["Salvage Drone"] }, {}],
    "steps": [],
    "expect": { "players": [{}, {}], "colors": { "Salvage Drone": [] } }
  }
]
