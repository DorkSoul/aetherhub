[
  {
    "name": "destroys an opponent's nonbasic land; its controller may fetch a basic; you get a Treasure",
    "players": [
      { "battlefield": ["Volatile Fault", "Plains"] },
      { "battlefield": ["Ghost Quarter"], "library": ["Mountain", "Island"] }
    ],
    "steps": [
      { "activate": "Volatile Fault", "ability": 0, "targets": ["Ghost Quarter"] },
      { "resolve": true, "answers": [true, "Island"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Volatile Fault"], "battlefield": ["Plains", "Treasure"] },
        { "graveyard": ["Ghost Quarter"], "battlefield": ["Island"] }
      ]
    }
  },
  {
    "name": "the controller of the destroyed land may decline the search (you still get the Treasure)",
    "players": [
      { "battlefield": ["Volatile Fault", "Plains"] },
      { "battlefield": ["Ghost Quarter"], "library": ["Mountain", "Island"] }
    ],
    "steps": [
      { "activate": "Volatile Fault", "ability": 0, "targets": ["Ghost Quarter"] },
      { "resolve": true, "answers": [false] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Volatile Fault"], "battlefield": ["Plains", "Treasure"] },
        { "graveyard": ["Ghost Quarter"], "battlefield": [] }
      ]
    }
  },
  {
    "name": "taps for colorless mana",
    "players": [
      { "battlefield": ["Volatile Fault"], "hand": ["Sol Ring"] },
      {}
    ],
    "steps": [
      { "cast": "Sol Ring" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Volatile Fault", "Sol Ring"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: destroy fails on an indestructible land, but its controller may still search and you still get a Treasure",
    "players": [
      { "battlefield": ["Volatile Fault", "Plains"] },
      { "battlefield": ["Darksteel Citadel"], "library": ["Mountain", "Island"] }
    ],
    "steps": [
      { "activate": "Volatile Fault", "ability": 0, "targets": ["Darksteel Citadel"] },
      { "resolve": true, "answers": [true, "Island"] }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Volatile Fault"], "battlefield_has": ["Treasure", "Plains"] },
        { "battlefield_has": ["Darksteel Citadel", "Island"] }
      ]
    }
  }
]
