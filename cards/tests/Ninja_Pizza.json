[
  {
    "name": "creates a Food token in your second main phase",
    "players": [
      {
        "battlefield": [
          "Forest",
          "Ninja Pizza"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Food"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "opponent's Ninja Pizza makes no Food for you",
    "players": [
      {
        "battlefield": [
          "Forest"
        ]
      },
      {
        "battlefield": [
          "Ninja Pizza"
        ]
      }
    ],
    "steps": [
      {
        "advance_to": "Main2"
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Food"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "a Food you control taps and sacrifices for one mana of any colour",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Ninja Pizza"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "resolve": true }, { "cast": "Lightning Bolt", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Food"] }, { "life": 17 } ] }
  },
  {
    "name": "ruling: a non-token Food (Pizza Face) can be sacrificed to pay Maraleaf Rider's cost",
    "players": [
      { "battlefield": ["Maraleaf Rider", "Pizza Face, Gastromancer"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Maraleaf Rider", "ability": 0, "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Maraleaf Rider"], "graveyard": ["Pizza Face, Gastromancer"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  }
]
