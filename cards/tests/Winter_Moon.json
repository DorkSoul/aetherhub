[
  {
    "name": "untaps one nonbasic land, the other stays tapped",
    "players": [
      {
        "battlefield": [
          "Winter Moon",
          {
            "name": "Blazemire Verge",
            "tapped": true
          },
          {
            "name": "Blazemire Verge",
            "tapped": true
          }
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Untap",
        "auto": true
      },
      {
        "advance_to": "Untap",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Winter Moon"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "basic lands are not limited",
