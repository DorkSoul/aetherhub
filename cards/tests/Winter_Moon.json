        "advance_to": "Untap",
        "auto": true
      },
      {
        "advance_to": "Untap",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Winter Moon"
          ]
        },
        {}
      ],
      "tapped": {
        "Forest": false,
        "Island": false,
        "Blazemire Verge": false
      }
    }
  },
