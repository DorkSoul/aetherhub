[
  {
    "name": "tap: 1 damage to each opponent",
    "players": [
      {
        "battlefield": [
          "Thermo-Alchemist"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "activate": "Thermo-Alchemist"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 19
        }
      ],
      "tapped": {
        "Thermo-Alchemist": true
      }
    }
  },
  {
    "name": "casting an instant untaps it",
    "players": [
      {
        "battlefield": [
          "Thermo-Alchemist",
          "Mountain"
        ],
        "hand": [
          "Shock"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "activate": "Thermo-Alchemist"
      },
      {
        "resolve": true
      },
      {
        "cast": "Shock",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {
          "life": 17
        }
      ],
      "tapped": {
        "Thermo-Alchemist": false
      }
    }
  },
  {
    "name": "casting a creature does not untap it",
    "players": [
      {
        "battlefield": [
          "Thermo-Alchemist",
          "Plains",
          "Plains"
        ],
        "hand": [
          "Savannah Lions"
        ]
      },
      {}
    ],
    "steps": [
      {
        "advance_to": "Main1"
      },
      {
        "advance_to": "Main1"
      },
      {
        "activate": "Thermo-Alchemist"
      },
      {
        "resolve": true
      },
      {
        "cast": "Savannah Lions"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "tapped": {
        "Thermo-Alchemist": true
      }
    }
  },
  {
    "name": "ruling: the trigger resolves before the spell, so Thermo can tap again in response",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Thermo-Alchemist", "tapped": true }, "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "activate": "Thermo-Alchemist", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 16 }
      ],
      "tapped": {
        "Thermo-Alchemist": true
      }
    }
  },
  {
    "name": "ruling: the untap trigger still resolves when the instant is countered",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": [{ "name": "Thermo-Alchemist", "tapped": true }, "Mountain"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "targets": [{ "stack": "Lightning Bolt" }] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 20, "graveyard": ["Counterspell"] }
      ],
      "tapped": {
        "Thermo-Alchemist": false
      }
    }
  }
]