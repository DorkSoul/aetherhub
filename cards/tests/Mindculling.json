    "steps": [ { "cast": "Mindculling", "targets": ["p1"] }, { "resolve": true } ],
    "expect": { "players": [ { "hand_count": 2 }, { "hand_count": 0 } ] } },
  { "name": "ruling: opponent with one card discards it and you still draw two",
    "players": [ { "hand": ["Mindculling"], "battlefield": ["Island", "Island", "Island", "Island", "Island", "Island"] }, { "hand": ["Forest"] } ],
    "steps": [ { "cast": "Mindculling", "targets": ["p1"] }, { "resolve": true } ],
