  }
 },
 {
  "name": "ruling: as an enchantment (above 10 life) it cannot be targeted by creature removal",
  "players": [
   { "hand": ["Doom Blade"], "battlefield": ["Opal Avenger", "Swamp", "Plains"] },
   {}
  ],
  "steps": [
   { "cast": "Doom Blade", "targets": ["Opal Avenger"], "illegal": true }
