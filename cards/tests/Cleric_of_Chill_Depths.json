[
  {
    "name": "blocked creature does not untap during its controller's next untap step",
    "players": [
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Cleric of Chill Depths"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Cleric of Chill Depths",
            "attacker": "Grizzly Bears"
          }
        ],
        "player": 1
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Grizzly Bears": true
      }
    }
  },
  {
    "name": "blocked creature stays tapped after the Cleric's block (control: no Cleric)",
    "players": [
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Llanowar Elves"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [],
        "player": 1
      },
      {
        "resolve": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      },
      {
        "advance_to": "Upkeep",
        "auto": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Grizzly Bears": false
      }
    }
  },
  {
    "name": "blocking Cleric itself stays untapped",
    "players": [
      {
        "battlefield": [
          "Grizzly Bears"
        ]
      },
      {
        "battlefield": [
          "Cleric of Chill Depths"
        ]
      }
    ],
    "steps": [
      {
        "attack": [
          {
            "card": "Grizzly Bears",
            "at": "p1"
          }
        ]
      },
      {
        "block": [
          {
            "blocker": "Cleric of Chill Depths",
            "attacker": "Grizzly Bears"
          }
        ],
        "player": 1
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {},
        {}
      ],
      "tapped": {
        "Cleric of Chill Depths": false
      }
    }
  },
  {
    "name": "ruling: a blocked vigilance attacker is untapped, so the Cleric's ability does not tap it",
    "players": [
      { "battlefield": ["Action News Crew"] },
      { "battlefield": ["Cleric of Chill Depths"] }
    ],
    "steps": [
      { "attack": [ { "card": "Action News Crew", "at": "p1" } ] },
      { "block": [ { "blocker": "Cleric of Chill Depths", "attacker": "Action News Crew" } ], "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [ {}, {} ],
      "tapped": { "Action News Crew": false }
    }
  },
  {
    "name": "ruling: the blocked creature still does not untap after the Cleric leaves the battlefield",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Grizzly Bears", "Mountain"] },
      { "battlefield": ["Cleric of Chill Depths"] }
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [ { "blocker": "Cleric of Chill Depths", "attacker": "Grizzly Bears" } ], "player": 1 },
      { "cast": "Lightning Bolt", "targets": ["Cleric of Chill Depths"] },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [ {}, { "graveyard": ["Cleric of Chill Depths"] } ],
      "tapped": { "Grizzly Bears": true }
    }
  }
]