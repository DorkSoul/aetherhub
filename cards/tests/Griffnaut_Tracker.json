[
  { "name": "ETB: exiles up to two target cards from one graveyard",
    "players": [ { "hand": ["Griffnaut Tracker"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "graveyard": ["Grizzly Bears", "Hill Giant", "Lightning Bolt"] } ],
    "steps": [
      { "cast": "Griffnaut Tracker" },
      { "resolve": true, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Griffnaut Tracker"] }, { "graveyard": ["Lightning Bolt"], "exile": ["Grizzly Bears", "Hill Giant"] } ] }
  },
  { "name": "ETB with cards in both graveyards: only the first owner's card is exiled",
    "players": [ { "hand": ["Griffnaut Tracker"], "battlefield": ["Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"] } ],
    "steps": [
      { "cast": "Griffnaut Tracker" },
      { "resolve": true, "targets": ["Grizzly Bears", "Hill Giant"] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "exile": ["Grizzly Bears"] }, { "graveyard": ["Hill Giant"], "exile": [] } ] }
  },
  { "name": "ETB with no targets chosen exiles nothing",
    "players": [ { "hand": ["Griffnaut Tracker"], "battlefield": ["Plains", "Plains", "Plains", "Plains"] }, { "graveyard": ["Grizzly Bears"] } ],
    "steps": [
      { "cast": "Griffnaut Tracker" },
      { "resolve": true, "targets": [] },
      { "resolve": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Griffnaut Tracker"] }, { "graveyard": ["Grizzly Bears"] } ] }
  }
]
