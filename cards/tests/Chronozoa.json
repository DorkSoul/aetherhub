[
  {
    "name": "enters with three time counters",
    "players": [
      { "hand": ["Chronozoa"], "battlefield": ["Island", "Island", "Island", "Island"] },
      {}
    ],
    "steps": [
      { "cast": "Chronozoa" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Chronozoa": { "time": 3 } },
      "pt": { "Chronozoa": [3, 3] }
    }
  },
  {
    "name": "upkeep removes a time counter and it stays",
    "players": [
      { "battlefield": [ { "name": "Chronozoa", "counters": { "time": 3 } } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Chronozoa": { "time": 2 } },
      "players": [ { "battlefield_has": ["Chronozoa"] }, {} ]
    }
  },
  {
    "name": "last time counter removed: sacrificed with no counters, so two copies are created",
    "players": [
      { "battlefield": [ { "name": "Chronozoa", "counters": { "time": 1 } } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Chronozoa"], "battlefield_has": ["Chronozoa", "Chronozoa"] },
        {}
      ]
    }
  },
  {
    "name": "dies with time counters on it: no copies",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] },
      { "battlefield": [ { "name": "Chronozoa", "counters": { "time": 2 } } ] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["Chronozoa"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"], "battlefield": ["Mountain"] },
        { "graveyard": ["Chronozoa"], "battlefield": [] }
      ],
      "stack_empty": true
    }
  },
  {
    "name": "ruling: each copy enters with three time counters and has the Vanishing and flying abilities",
    "players": [
      { "battlefield": [ { "name": "Chronozoa", "counters": { "time": 1 } } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Chronozoa"], "battlefield_has": ["Chronozoa", "Chronozoa"] },
        {}
      ],
      "counters": { "Chronozoa": { "time": 3 } },
      "keywords": { "Chronozoa": ["Flying"] }
    }
  },
  {
    "name": "ruling: the copies lose a time counter at their controller's next upkeep (Vanishing copied)",
    "players": [
      { "battlefield": [ { "name": "Chronozoa", "counters": { "time": 1 } } ] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true },
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chronozoa", "Chronozoa"] },
        {}
      ],
      "counters": { "Chronozoa": { "time": 2 } }
    }
  }
]
