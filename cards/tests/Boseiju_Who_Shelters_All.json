[
  {
    "name": "instant paid with Boseiju mana can't be countered",
    "players": [
      { "hand": ["Searing Spear"], "battlefield": ["Boseiju, Who Shelters All", "Mountain"] },
      { "hand": ["Abjure"], "battlefield": ["Island", "Air Elemental"] }
    ],
    "steps": [
      { "cast": "Searing Spear", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Abjure", "player": 1, "targets": [{ "stack": "Searing Spear" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "graveyard_has": ["Searing Spear"] },
        { "life": 17, "graveyard_has": ["Abjure", "Air Elemental"] }
      ]
    }
  },
  {
    "name": "instant paid with a Mountain can still be countered",
    "players": [
      { "hand": ["Searing Spear"], "battlefield": ["Mountain", "Mountain"] },
      { "hand": ["Abjure"], "battlefield": ["Island", "Air Elemental"] }
    ],
    "steps": [
      { "cast": "Searing Spear", "targets": ["p1"] },
      { "pass": true },
      { "cast": "Abjure", "player": 1, "targets": [{ "stack": "Searing Spear" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Searing Spear"] },
        { "life": 20, "graveyard_has": ["Abjure", "Air Elemental"] }
      ]
    }
  },
  {
    "name": "enters tapped when played",
    "players": [ { "hand": ["Boseiju, Who Shelters All"] }, {} ],
    "steps": [ { "play_land": "Boseiju, Who Shelters All" } ],
    "expect": { "tapped": { "Boseiju, Who Shelters All": true } }
  },
  {
    "name": "control: a copy of a spell paid with a Mountain can be countered",
    "players": [
      { "hand": ["Searing Spear", "Twincast"], "battlefield": ["Mountain", "Mountain", "Island", "Island"] },
      { "hand": ["Abjure"], "battlefield": ["Island", "Air Elemental"] }
    ],
    "steps": [
      { "cast": "Searing Spear", "targets": ["p1"] },
      { "cast": "Twincast", "targets": [{ "stack": "Searing Spear" }] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "cast": "Abjure", "player": 1, "targets": [{ "stack": "Searing Spear" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 20, "graveyard_has": ["Searing Spear", "Twincast"] },
        { "life": 17, "graveyard_has": ["Abjure", "Air Elemental"] }
      ]
    }
  },
  {
    "name": "ruling: Boseiju mana spent on a kicker cost makes the kicked instant uncounterable",
    "players": [
      { "hand": ["Burst Lightning"], "battlefield": ["Boseiju, Who Shelters All", "Mountain", "Island", "Island", "Island"] },
      { "hand": ["Abjure"], "battlefield": ["Island", "Air Elemental"] }
    ],
    "steps": [
      { "cast": "Burst Lightning", "targets": ["p1"], "answers": [true] },
      { "pass": true },
      { "cast": "Abjure", "player": 1, "targets": [{ "stack": "Burst Lightning" }] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 18, "graveyard_has": ["Burst Lightning"] },
        { "life": 16, "graveyard_has": ["Abjure", "Air Elemental"] }
      ]
    }
  }
]
