   "players": [ { "battlefield": ["Xanathar, Guild Kingpin", "Mountain", "Swamp"] }, { "library": ["Grizzly Bears", "Forest", "Forest"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "Main1" }, { "cast": "Grizzly Bears" }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "library_top": ["Forest"] } ] } },
 { "name": "the top land of the opponent's library can be played",
   "start": "Untap",
   "players": [ { "battlefield": ["Xanathar, Guild Kingpin"] }, { "library": ["Forest", "Island", "Island"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "Main1" }, { "play_land": "Forest" } ],
   "expect": { "players": [ { "battlefield_has": ["Forest"] }, { "library_top": ["Island"] } ] } },
 { "name": "the targeted opponent can't cast spells this turn",
   "start": "Untap",
   "players": [ { "battlefield": ["Xanathar, Guild Kingpin"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "resolve": true }, { "pass": true }, { "player": 1, "cast": "Lightning Bolt", "targets": ["p0"], "illegal": true } ] },
 { "name": "without the upkeep trigger the opponent's top card cannot be cast",
   "players": [ { "battlefield": ["Xanathar, Guild Kingpin", "Mountain", "Swamp"] }, { "library": ["Grizzly Bears", "Forest", "Forest"] } ],
   "steps": [ { "cast": "Grizzly Bears", "illegal": true } ] },
 { "name": "ruling: the top land of the opponent's library still needs an unused land drop",
   "start": "Untap",
   "players": [ { "hand": ["Island"], "battlefield": ["Xanathar, Guild Kingpin"] }, { "library": ["Forest", "Island", "Island"] } ],
   "steps": [ { "advance_to": "Upkeep" }, { "resolve": true }, { "advance_to": "Main1" }, { "play_land": "Island" }, { "play_land": "Forest", "illegal": true } ],
   "expect": { "players": [ { "battlefield_has": ["Island"], "battlefield_lacks": ["Forest"] }, { "library_top": ["Forest"] } ] } }
