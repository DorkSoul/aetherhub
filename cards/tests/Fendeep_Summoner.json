[
  {
    "name": "taps to make up to two Swamps 3/5 Treefolk Warriors until end of turn",
    "players": [
      { "battlefield": [ { "name": "Fendeep Summoner", "sick": false }, "Swamp", "Watery Grave" ] },
      {}
    ],
    "steps": [
      { "activate": "Fendeep Summoner", "targets": ["Swamp", "Watery Grave"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Fendeep Summoner": true },
      "pt": { "Swamp": [3, 5], "Watery Grave": [3, 5] }
    }
  },
  {
    "name": "a single target is enough",
    "players": [
      { "battlefield": [ { "name": "Fendeep Summoner", "sick": false }, "Swamp", "Watery Grave" ] },
      {}
    ],
    "steps": [
      { "activate": "Fendeep Summoner", "targets": ["Watery Grave"] },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Fendeep Summoner": true },
      "pt": { "Watery Grave": [3, 5] }
    }
  },
  {
    "name": "with no target chosen it only taps",
    "players": [
      { "battlefield": [ { "name": "Fendeep Summoner", "sick": false }, "Swamp", "Mountain" ] },
      {}
    ],
    "steps": [
      { "activate": "Fendeep Summoner" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Fendeep Summoner": true },
      "players": [ { "battlefield_has": ["Fendeep Summoner", "Swamp", "Mountain"] }, {} ]
    }
  },
  {
    "name": "ruling: an animated Swamp is still a Swamp and can tap for black mana",
    "players": [
      { "hand": ["Fendeep Summoner"], "battlefield": [ { "name": "Fendeep Summoner", "sick": false }, "Swamp", "Swamp", "Swamp", "Swamp", "Watery Grave" ] },
      {}
    ],
    "steps": [
      { "activate": "Fendeep Summoner", "targets": ["Watery Grave"] },
      { "resolve": true },
      { "cast": "Fendeep Summoner" },
      { "resolve": true }
    ],
    "expect": { "players": [ { "hand_count": 0, "battlefield_has": ["Fendeep Summoner", "Watery Grave"] }, {} ] }
  },
  {
    "name": "contrast: a summoning-sick Fendeep Summoner cannot use its {T} ability",
    "players": [
      { "battlefield": [ { "name": "Fendeep Summoner", "sick": true }, "Swamp" ] },
      {}
    ],
    "steps": [
      { "activate": "Fendeep Summoner", "targets": ["Swamp"], "illegal": true }
    ],
    "expect": { "players": [ { "battlefield_has": ["Fendeep Summoner", "Swamp"] }, {} ] }
  }
]
