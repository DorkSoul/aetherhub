[{"name":"another Elf entering gives a counter",
"players":[{"hand":["Elvish Ranger"],"battlefield":["Elvish Vanguard","Forest","Forest","Forest"]},{}],
"steps":[{"cast":"Elvish Ranger"},{"resolve":true}],
"expect":{"counters":{"Elvish Vanguard":{"p1p1":1}},"pt":{"Elvish Vanguard":[2,2]}}},
{"name":"opponent's Elf also triggers",
"players":[{"battlefield":["Elvish Vanguard"]},{"hand":["Elvish Ranger"],"battlefield":["Forest","Forest","Forest"]}],
"steps":[{"advance_to":"Main1"},{"cast":"Elvish Ranger","player":1},{"resolve":true}],
"expect":{"counters":{"Elvish Vanguard":{"p1p1":1}}}},
{"name":"non-Elf entering does nothing",
"players":[{"hand":["Hill Giant"],"battlefield":["Elvish Vanguard","Mountain","Mountain","Mountain","Mountain"]},{}],
"steps":[{"cast":"Hill Giant"},{"resolve":true}],
"expect":{"pt":{"Elvish Vanguard":[1,1]}}},
{"name":"ruling: Vanguard returning at the same time as another Elf still triggers",
"players":[{"hand":["Ghostly Flicker"],"battlefield":["Elvish Vanguard","Elvish Ranger","Island","Island","Island"]},{}],
"steps":[{"cast":"Ghostly Flicker","targets":["Elvish Vanguard","Elvish Ranger"]},{"resolve":true}],
"expect":{"players":[{"battlefield_has":["Elvish Vanguard","Elvish Ranger"]},{}],"counters":{"Elvish Vanguard":{"p1p1":1}},"pt":{"Elvish Vanguard":[2,2]}}}]
