[
  {
    "name": "enters with a charge counter",
    "players": [ { "hand": ["Dragonspark Reactor"], "battlefield": ["Mountain", "Plains"] }, {} ],
    "steps": [ { "cast": "Dragonspark Reactor" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Dragonspark Reactor"] }, {} ],
      "counters": { "Dragonspark Reactor": { "Charge": 1 } }
    }
  },
  {
    "name": "sacrificed to deal damage equal to its charge counters",
    "players": [
      { "hand": ["Dragonspark Reactor"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dragonspark Reactor" },
      { "resolve": true },
      { "activate": "Dragonspark Reactor", "targets": ["p1", "Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Dragonspark Reactor"] }, { "life": 19, "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: the creature target is optional; with only the player targeted it deals damage to the player alone",
    "players": [
      { "hand": ["Dragonspark Reactor"], "battlefield": ["Mountain", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dragonspark Reactor" },
      { "resolve": true },
      { "activate": "Dragonspark Reactor", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Dragonspark Reactor"] }, { "life": 19, "battlefield_has": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: if the creature target becomes illegal, the damage to the player still happens",
    "players": [
      { "hand": ["Dragonspark Reactor", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Plains", "Plains", "Plains", "Plains", "Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Dragonspark Reactor" },
      { "resolve": true },
      { "activate": "Dragonspark Reactor", "targets": ["p1", "Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Dragonspark Reactor", "Lightning Bolt"] }, { "life": 19, "graveyard": ["Grizzly Bears"] } ]
    }
  }
]
