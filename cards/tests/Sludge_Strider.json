[
  { "name": "paying {1} when another artifact enters drains 1",
    "players": [ { "hand": ["Sliversmith"], "battlefield": ["Sludge Strider", "Plains", "Island", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Sliversmith" },
      { "resolve": true, "targets": ["p1"], "answers": [true] }
    ],
    "expect": { "players": [ { "life": 21, "battlefield_has": ["Sliversmith"] }, { "life": 19 } ] } },
  { "name": "declining to pay drains nothing",
    "players": [ { "hand": ["Sliversmith"], "battlefield": ["Sludge Strider", "Plains", "Island", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Sliversmith" },
      { "resolve": true, "targets": ["p1"], "answers": [false] }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "another artifact leaves the battlefield: pay {1} to drain 1",
    "players": [ { "hand": ["Vindicate"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Sludge Strider", "Sol Ring"] }, {} ],
    "steps": [
      { "cast": "Vindicate", "targets": ["Sol Ring"] },
      { "resolve": true, "targets": ["p1"], "answers": [true] }
    ],
    "expect": { "players": [ { "life": 21, "battlefield_has": ["Sludge Strider"] }, { "life": 19 } ] } },
  { "name": "another artifact leaves the battlefield: declining to pay drains nothing",
    "players": [ { "hand": ["Vindicate"], "battlefield": ["Plains", "Swamp", "Island", "Island", "Sludge Strider", "Sol Ring"] }, {} ],
    "steps": [
      { "cast": "Vindicate", "targets": ["Sol Ring"] },
      { "resolve": true, "targets": ["p1"], "answers": [false] }
    ],
    "expect": { "players": [ { "life": 20 }, { "life": 20 } ] } },
  { "name": "ruling: Sludge Strider and another artifact you control leaving simultaneously still triggers for the other artifact",
    "players": [ { "hand": ["Wrath of God"], "battlefield": ["Plains", "Plains", "Island", "Swamp", "Island", "Sludge Strider", "Ornithopter"] }, {} ],
    "steps": [
      { "cast": "Wrath of God" },
      { "resolve": true, "targets": ["p1"], "answers": [true] }
    ],
    "expect": { "players": [ { "life": 21, "graveyard_has": ["Sludge Strider", "Ornithopter"] }, { "life": 19 } ] } },
  { "name": "ruling: a 0-toughness artifact creature entering and dying triggers Sludge Strider twice",
    "players": [ { "hand": ["Psychosis Crawler"], "battlefield": ["Sludge Strider", "Plains", "Plains", "Island", "Island", "Island", "Swamp", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Psychosis Crawler" },
      { "resolve": true, "targets": ["p1", "p1"], "answers": [true, true] }
    ],
    "expect": { "players": [ { "life": 22, "battlefield_has": ["Sludge Strider"], "graveyard_has": ["Psychosis Crawler"] }, { "life": 18 } ] } }
]
