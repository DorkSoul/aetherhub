[
  {
    "name": "first strike combat damage to a creature destroys it before regular damage",
    "players": [ { "battlefield": [ { "name": "Voracious Cobra", "sick": false } ] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Voracious Cobra", "at": "p1" } ] },
      { "block": [ { "blocker": "Hill Giant", "attacker": "Voracious Cobra" } ] },
      { "advance_to": "FirstStrikeDamage" },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Voracious Cobra"] }, { "graveyard": ["Hill Giant"] } ] }
  },
  {
    "name": "combat damage to a player does not destroy anything",
    "players": [ { "battlefield": [ { "name": "Voracious Cobra", "sick": false } ] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [
      { "attack": [ { "card": "Voracious Cobra", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 18, "battlefield_has": ["Hill Giant"] } ] }
  }
]
