[
  {
    "name": "upkeep returns the only instant or sorcery from graveyard to hand",
    "start": "Untap",
    "players": [
      { "battlefield": ["Exalted Flamer of Tzeentch"], "graveyard": ["Lightning Bolt", "Grizzly Bears"], "library": ["Forest", "Forest"] },
      { "library": ["Forest", "Forest"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Lightning Bolt"], "graveyard": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "upkeep with no instant or sorcery in graveyard returns nothing",
    "start": "Untap",
    "players": [
      { "battlefield": ["Exalted Flamer of Tzeentch"], "graveyard": ["Grizzly Bears"], "library": ["Forest", "Forest"] },
      { "library": ["Forest", "Forest"] }
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Grizzly Bears"] },
        {}
      ]
    }
  },
  {
    "name": "casting an instant pings each opponent for 1",
    "players": [
      { "hand": ["Lightning Bolt"], "battlefield": ["Exalted Flamer of Tzeentch", "Mountain"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Lightning Bolt"] },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "casting a creature does not ping",
    "players": [
      { "hand": ["Grizzly Bears"], "battlefield": ["Exalted Flamer of Tzeentch", "Forest", "Forest"] },
      { "battlefield": [] }
    ],
    "steps": [
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Grizzly Bears"] },
        { "life": 20 }
      ]
    }
  }
]
