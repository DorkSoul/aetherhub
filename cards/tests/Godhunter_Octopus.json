[
  { "name": "attacks when the defending player controls an enchantment",
    "players": [ { "battlefield": ["Godhunter Octopus"] }, { "battlefield": ["Intangible Virtue"] } ],
    "steps": [ { "attack": [ { "card": "Godhunter Octopus", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ] } },
  { "name": "can't attack when the defending player controls no enchantment or enchanted permanent",
    "players": [ { "battlefield": ["Godhunter Octopus"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [ { "card": "Godhunter Octopus", "at": "p1" } ], "illegal": true } ],
    "expect": { "players": [ {}, { "life": 20 } ] } },
  { "name": "barred from attacking: with Grizzly Bears also attacking, only the Bears hit",
    "players": [ { "battlefield": ["Godhunter Octopus", "Grizzly Bears"] }, { "battlefield": ["Island"] } ],
    "steps": [ { "attack": [ { "card": "Godhunter Octopus", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] } },
  { "name": "ruling: once declared as an attacker it keeps attacking after the defender's enchantment is gone",
    "players": [ { "hand": ["Disenchant"], "battlefield": ["Godhunter Octopus", "Plains", "Mountain"] }, { "battlefield": ["Intangible Virtue"] } ],
    "steps": [ { "attack": [ { "card": "Godhunter Octopus", "at": "p1" } ] }, { "cast": "Disenchant", "targets": ["p1:Intangible Virtue"] }, { "pass": true }, { "pass": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "graveyard": ["Disenchant"] }, { "life": 15, "graveyard_has": ["Intangible Virtue"] } ] } }
]
