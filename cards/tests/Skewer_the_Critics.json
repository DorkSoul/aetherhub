[
  {
    "name": "spectacle {R} after an opponent lost life this turn",
    "players": [
      { "hand": ["Lightning Bolt", "Skewer the Critics"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Skewer the Critics", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Lightning Bolt", "Skewer the Critics"] }, { "life": 14 } ]
    }
  },
  {
    "name": "spectacle cost not usable when no opponent lost life this turn",
    "players": [
      { "hand": ["Skewer the Critics"], "battlefield": ["Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Skewer the Critics", "alt": 0, "targets": ["p1"], "illegal": true }
    ],
    "expect": {
      "players": [ { "hand_count": 1 }, { "life": 20 } ]
    }
  },
  {
    "name": "normal cost deals 3 damage to a creature",
    "players": [
      { "hand": ["Skewer the Critics"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Skewer the Critics", "targets": ["Grizzly Bears"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Skewer the Critics"] }, { "graveyard": ["Grizzly Bears"] } ]
    }
  },
  {
    "name": "ruling: damage to a player makes that player lose that much life",
    "players": [
      { "hand": ["Skewer the Critics"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Skewer the Critics", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard": ["Skewer the Critics"] }, { "life": 17 } ]
    }
  },
  {
    "name": "ruling: spectacle does not allow casting the sorcery on an opponent's turn",
    "players": [
      {},
      { "hand": ["Lightning Bolt", "Skewer the Critics"], "battlefield": ["Mountain", "Mountain"] }
    ],
    "steps": [
      { "pass": true },
      { "cast": "Lightning Bolt", "player": 1, "targets": ["p0"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Skewer the Critics", "player": 1, "alt": 0, "targets": ["p0"], "illegal": true }
    ],
    "expect": {
      "players": [ { "life": 17 }, { "hand_count": 1 } ]
    }
  },
  {
    "name": "ruling: spectacle still works after the opponent gets back the life it lost",
    "players": [
      { "hand": ["Lightning Bolt", "Skewer the Critics"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] },
      { "hand": ["Tendrils of Corruption"], "battlefield": ["Swamp", "Swamp", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "pass": true },
      { "cast": "Tendrils of Corruption", "player": 1, "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Skewer the Critics", "alt": 0, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Skewer the Critics"] }, { "life": 16 } ]
    }
  }
]
