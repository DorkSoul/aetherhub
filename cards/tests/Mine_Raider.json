[
 {
  "name": "creates a Treasure when another outlaw is controlled",
  "players": [
   {
    "hand": [
     "Mine Raider"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain",
     "Bigfin Bouncer"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Mine Raider"
   },
   {
    "resolve": true
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Mine Raider",
      "Treasure",
      "Bigfin Bouncer"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "no Treasure without another outlaw",
  "players": [
   {
    "hand": [
     "Mine Raider"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Mine Raider"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Mine Raider"
     ],
     "battlefield_lacks": [
      "Treasure"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "ruling: an outlaw card in the graveyard does not count, so no Treasure",
  "players": [
   {
    "hand": ["Mine Raider"],
    "graveyard": ["Mine Raider"],
    "battlefield": ["Mountain", "Mountain", "Mountain"]
   },
   {}
  ],
  "steps": [
   { "cast": "Mine Raider" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Mine Raider"], "battlefield_lacks": ["Treasure"] },
    {}
   ]
  }
 },
 {
  "name": "ruling: Mine Raider is a Rogue, so it counts as an outlaw for a second Mine Raider (Treasure created)",
  "players": [
   {
    "hand": ["Mine Raider"],
    "battlefield": ["Mountain", "Mountain", "Mountain", "Mine Raider"]
   },
   {}
  ],
  "steps": [
   { "cast": "Mine Raider" },
   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Mine Raider", "Mine Raider", "Treasure"] },
    {}
   ]
  }
 }
]
