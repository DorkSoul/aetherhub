[
  {
    "name": "exiles target card from a graveyard",
    "players": [
      {
        "hand": [
          "Coffin Purge"
        ],
        "battlefield": [
          "Swamp"
        ]
      },
      {
        "graveyard": [
          "Lightning Bolt"
        ]
      }
    ],
    "steps": [
