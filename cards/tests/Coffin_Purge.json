          ]
        }
      ]
    }
  },
  {
    "name": "flashback {B} from the graveyard exiles the spell afterward",
    "players": [
      {
        "graveyard": [
          "Coffin Purge"
        ],
        "battlefield": [
          "Swamp"
        ]
      },
      {
        "graveyard": [
          "Lightning Bolt"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Coffin Purge",
        "alt": 0,
        "targets": [
          "Lightning Bolt"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [],
          "exile": [
            "Coffin Purge"
          ]
        },
        {
          "graveyard": [],
          "exile": [
            "Lightning Bolt"
          ]
        }
      ]
    }
  },
  {
    "name": "ruling: a flashback spell that fizzles is still exiled",
    "players": [
      { "hand": ["Coffin Purge"], "battlefield": ["Swamp", "Swamp"], "graveyard": ["Coffin Purge"] },
      { "graveyard": ["Lightning Bolt"] }
    ],
    "steps": [
      { "cast": "Coffin Purge", "targets": ["Lightning Bolt"] },
      { "cast": "Coffin Purge", "alt": 0, "targets": ["Lightning Bolt"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Coffin Purge"], "exile": ["Coffin Purge"] },
        { "graveyard": [], "exile": ["Lightning Bolt"] }
      ]
    }
  }
