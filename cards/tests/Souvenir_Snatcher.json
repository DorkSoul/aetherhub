[
 {
  "name": "mutate over Grizzly Bears: gain control of the noncreature artifact",
  "players": [
   { "hand": ["Souvenir Snatcher"], "battlefield": ["Grizzly Bears", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "cast": "Souvenir Snatcher", "alt": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Souvenir Snatcher", "Sol Ring"] },
    { "battlefield_lacks": ["Sol Ring"] }
   ]
  }
 },
 {
  "name": "cast normally: no mutate trigger, the opponent keeps the artifact",
  "players": [
   { "hand": ["Souvenir Snatcher"], "battlefield": ["Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "cast": "Souvenir Snatcher" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Souvenir Snatcher"], "battlefield_lacks": ["Sol Ring"] },
    { "battlefield_has": ["Sol Ring"] }
   ]
  }
 },
 {
  "name": "ruling: control of the snatched artifact lasts through cleanup and after Souvenir Snatcher leaves",
  "players": [
   { "hand": ["Souvenir Snatcher", "Lightning Bolt", "Shock"], "battlefield": ["Grizzly Bears", "Island", "Island", "Island", "Island", "Island", "Island", "Mountain", "Mountain"] },
   { "battlefield": ["Sol Ring"] }
  ],
  "steps": [
   { "cast": "Souvenir Snatcher", "alt": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true] },
   { "advance_to": "End" },
   { "cast": "Lightning Bolt", "targets": ["Souvenir Snatcher"] },
   { "resolve": true },
   { "cast": "Shock", "targets": ["Souvenir Snatcher"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Sol Ring"], "battlefield_lacks": ["Souvenir Snatcher"] },
    { "battlefield_lacks": ["Sol Ring"] }
   ]
  }
 },
 {
  "name": "ruling: a snatched artifact that becomes an artifact creature (crewed Vehicle) stays under your control",
  "players": [
   { "hand": ["Souvenir Snatcher"], "battlefield": ["Grizzly Bears", "Island", "Island", "Island", "Island", "Island", "Island"] },
   { "battlefield": ["Smuggler's Copter"] }
  ],
  "steps": [
   { "cast": "Souvenir Snatcher", "alt": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true, "answers": [true] },
   { "activate": "Smuggler's Copter" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Souvenir Snatcher", "Smuggler's Copter"] },
    { "battlefield_lacks": ["Smuggler's Copter"] }
   ]
  }
 }
]
