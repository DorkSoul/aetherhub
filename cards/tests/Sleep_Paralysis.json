[
 {
  "name": "enchanted creature becomes tapped",
  "players": [ { "hand": ["Sleep Paralysis"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Sleep Paralysis", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true }, "attached": { "Sleep Paralysis": "Grizzly Bears" } }
 },
 {
  "name": "can enchant a flier (no flying restriction)",
  "players": [ { "hand": ["Sleep Paralysis"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Serra Angel"] } ],
  "steps": [ { "cast": "Sleep Paralysis", "targets": ["Serra Angel"] }, { "resolve": true }, { "resolve": true } ],
  "expect": { "players": [ {}, {} ], "tapped": { "Serra Angel": true } }
 },
 {
  "name": "cannot target a noncreature permanent",
  "players": [ { "hand": ["Sleep Paralysis"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Sol Ring"] } ],
  "steps": [ { "cast": "Sleep Paralysis", "illegal": true } ],
  "expect": { "players": [ { "hand": ["Sleep Paralysis"] }, {} ] }
 },
 {
  "name": "enchanted creature does not untap during its controller's untap step",
  "players": [ { "hand": ["Sleep Paralysis"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
  "steps": [ { "cast": "Sleep Paralysis", "targets": ["Grizzly Bears"] }, { "resolve": true }, { "resolve": true }, { "advance_to": "Upkeep" } ],
  "expect": { "players": [ {}, { "battlefield_has": ["Grizzly Bears"] } ], "tapped": { "Grizzly Bears": true } }
 },
 {
  "name": "ruling: target gone in response, the Aura does not resolve or enter (no ETB tap)",
  "players": [ { "hand": ["Sleep Paralysis"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
  "steps": [
    { "cast": "Sleep Paralysis", "targets": ["Grizzly Bears"] },
    { "pass": true },
    { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 },
    { "pass": true, "player": 1 },
    { "pass": true },
    { "resolve": true }
  ],
  "expect": { "players": [ { "graveyard_has": ["Sleep Paralysis"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] } ] }
 }
]
