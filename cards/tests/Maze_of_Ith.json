    ]
   },
   {
    "battlefield": [
     "Maze of Ith"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "pass": true
   },
   {
    "player": 1,
    "activate": "Maze of Ith",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   },
   {
    "block": []
   },
   {
    "advance_to": "Main2"
   }
