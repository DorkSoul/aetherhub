   {
    "battlefield": [
     "Grizzly Bears"
    ]
   },
   {
    "battlefield": [
     "Maze of Ith",
     "Hill Giant"
    ]
   }
  ],
  "steps": [
   {
    "attack": [
     {
      "card": "Grizzly Bears",
      "at": "p1"
     }
    ]
   },
   {
    "pass": true
   },
   {
    "player": 1,
    "activate": "Maze of Ith",
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   },
   {
    "block": [
     {
      "blocker": "Hill Giant",
      "attacker": "Grizzly Bears"
     }
    ]
   },
   {
    "advance_to": "Main2"
   }
