 {
  "name": "ruling: activated after combat damage is dealt, it only untaps the attacker",
  "players": [
   { "battlefield": ["Grizzly Bears"] },
   { "battlefield": ["Maze of Ith"] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "block": [] },
   { "advance_to": "CombatDamage" },
   { "pass": true },
   { "player": 1, "activate": "Maze of Ith", "targets": ["Grizzly Bears"] },
   { "resolve": true },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "tapped": { "Grizzly Bears": false, "Maze of Ith": true },
   "players": [
    {},
    { "life": 18 }
   ]
  }
 },
 {
  "name": "ruling: an untapped (vigilance) attacker can be targeted and its damage is still prevented",
  "players": [
