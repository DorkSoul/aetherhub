   { "resolve": true },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Blood Knight"], "graveyard": ["Hate Mirage", "Lightning Bolt"] },
    { "battlefield": ["Blood Knight"], "graveyard": ["Grizzly Bears"] }
   ]
  }
 },
