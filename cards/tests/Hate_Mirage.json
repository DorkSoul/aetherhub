    { "battlefield_has": ["Hanged Executioner"] }
   ]
  }
 },
 {
  "name": "ruling: a target that became illegal is skipped, so only one token copy is created",
  "players": [
   { "hand": ["Hate Mirage", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
   { "battlefield": ["Grizzly Bears", "Blood Knight"] }
  ],
  "steps": [
   { "cast": "Hate Mirage", "targets": ["Grizzly Bears", "Blood Knight"] },
