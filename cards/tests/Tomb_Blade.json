[
  { "name": "paying the sacrifice instead of losing life",
    "players": [ { "battlefield": ["Tomb Blade"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Tomb Blade", "at": "p1" } ] }, { "block": [] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true, "answers": [true] } ],
    "expect": { "players": [ {}, { "life": 15, "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "declining the sacrifice loses life equal to creatures controlled",
    "players": [ { "battlefield": ["Tomb Blade"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Tomb Blade", "at": "p1" } ] }, { "block": [] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true, "answers": [false] } ],
    "expect": { "players": [ {}, { "life": 13, "battlefield_has": ["Grizzly Bears", "Hill Giant"] } ] } },
  { "name": "unearth {6}{B}{B} with eight mana returns it to the battlefield with haste",
    "players": [ { "graveyard": ["Tomb Blade"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Tomb Blade", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Tomb Blade"] }, {} ], "keywords": { "Tomb Blade": ["Flying", "Haste"] } } },
  { "name": "unearth with seven mana is not possible",
    "players": [ { "graveyard": ["Tomb Blade"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Tomb Blade", "ability": 0, "illegal": true } ],
    "expect": { "players": [ { "graveyard_has": ["Tomb Blade"] }, {} ] } },
  { "name": "unearthed Tomb Blade that dies is exiled instead of going to the graveyard",
    "players": [ { "graveyard": ["Tomb Blade"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain"] } ],
    "steps": [ { "activate": "Tomb Blade", "ability": 0 }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Tomb Blade"] }, { "resolve": true }, { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Tomb Blade"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Tomb Blade"], "graveyard": [] }, { "graveyard": ["Lightning Bolt", "Lightning Bolt"] } ] } },
  { "name": "ruling: an unearthed Tomb Blade is exiled at the beginning of the end step",
    "players": [ { "graveyard": ["Tomb Blade"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {} ],
    "steps": [ { "activate": "Tomb Blade", "ability": 0 }, { "resolve": true }, { "advance_to": "End" } ],
    "expect": { "players": [ { "exile": ["Tomb Blade"], "graveyard": [] }, {} ] } },
  { "name": "ruling: Stifle on the unearth ability counters it, so the card stays in the graveyard",
    "players": [ { "graveyard": ["Tomb Blade"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Stifle"], "battlefield": ["Island", "Island"] } ],
    "steps": [ { "activate": "Tomb Blade", "ability": 0 }, { "pass": true }, { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Tomb Blade" } ] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Tomb Blade"], "battlefield_lacks": ["Tomb Blade"] }, { "graveyard": ["Stifle"] } ] } },
  { "name": "ruling: if the card leaves the graveyard in response, the unearth ability does nothing",
    "players": [ { "graveyard": ["Tomb Blade"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "battlefield": ["Tormod's Crypt"] } ],
    "steps": [ { "activate": "Tomb Blade", "ability": 0 }, { "pass": true }, { "activate": "Tormod's Crypt", "player": 1, "targets": ["p0"] }, { "pass": true }, { "pass": true, "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Tomb Blade"], "battlefield_lacks": ["Tomb Blade"] }, { "graveyard": ["Tormod's Crypt"] } ] } },
  { "name": "ruling: an unearthed Tomb Blade that is bounced is exiled instead of returning to hand",
    "players": [ { "graveyard": ["Tomb Blade"], "battlefield": ["Swamp", "Swamp", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, { "hand": ["Unsummon"], "battlefield": ["Island"] } ],
    "steps": [ { "activate": "Tomb Blade", "ability": 0 }, { "resolve": true }, { "pass": true }, { "cast": "Unsummon", "player": 1, "targets": ["Tomb Blade"] }, { "resolve": true } ],
    "expect": { "players": [ { "exile": ["Tomb Blade"], "hand_count": 0 }, { "graveyard": ["Unsummon"] } ] } }
]
