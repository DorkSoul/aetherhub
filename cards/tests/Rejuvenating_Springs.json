[
  { "name": "enters tapped with one opponent",
    "players": [ { "hand": ["Rejuvenating Springs"] }, {} ],
    "steps": [ { "play_land": "Rejuvenating Springs" } ],
    "expect": { "tapped": { "Rejuvenating Springs": true }, "players": [ { "battlefield": ["Rejuvenating Springs"] }, {} ] } },
  { "name": "enters untapped with two opponents",
    "players": [ { "hand": ["Rejuvenating Springs"] }, {}, {} ],
    "steps": [ { "play_land": "Rejuvenating Springs" } ],
    "expect": { "tapped": { "Rejuvenating Springs": false }, "players": [ { "battlefield": ["Rejuvenating Springs"] }, {}, {} ] } },
  { "name": "taps for green or blue",
    "players": [ { "battlefield": ["Rejuvenating Springs", "Forest"] }, {} ],
    "steps": [ { "tap_for_mana": "Rejuvenating Springs", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ] } },
  { "name": "ruling: a land put onto the battlefield tapped by an effect stays tapped with two opponents",
    "players": [ { "hand": ["Cultivator Colossus", "Rejuvenating Springs"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest", "Forest", "Forest"] }, {}, {} ],
    "steps": [ { "cast": "Cultivator Colossus" }, { "resolve": true, "answers": [["Rejuvenating Springs"]] } ],
    "expect": { "tapped": { "Rejuvenating Springs": true }, "players": [ { "battlefield_has": ["Rejuvenating Springs"] }, {}, {} ] } },
  { "name": "ruling: a conceded opponent no longer counts",
    "players": [ { "hand": ["Rejuvenating Springs"] }, {}, {} ],
    "steps": [ { "concede": true, "player": 2 }, { "play_land": "Rejuvenating Springs" } ],
    "expect": { "tapped": { "Rejuvenating Springs": true }, "players": [ { "battlefield": ["Rejuvenating Springs"] }, {} ] } }
]
