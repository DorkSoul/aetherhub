[
  { "name": "hard cast: Reveillark stays on the battlefield",
    "players": [ { "hand": ["Reveillark"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Reveillark" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Reveillark"] }, {} ] } },
  { "name": "evoke: sacrificed on entering, then returns a power 2 creature card from the graveyard",
    "players": [ { "hand": ["Reveillark"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Reveillark", "alt": 0 }, { "resolve": true, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Reveillark"] }, {} ] } },
  { "name": "leaves-the-battlefield trigger ignores creature cards with power above 2",
    "players": [ { "hand": ["Reveillark"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "graveyard": ["Hill Giant"] }, {} ],
    "steps": [ { "cast": "Reveillark", "alt": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Reveillark", "Hill Giant"] }, {} ] } },
  { "name": "ruling: evoke does not change timing, so on the opponent's turn the creature cannot be cast with evoke",
    "players": [ { "hand": ["Reveillark"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "advance_to": "Main2" }, { "advance_to": "Main1" }, { "pass": true, "player": 1 }, { "cast": "Reveillark", "alt": 0, "illegal": true } ],
    "expect": { "players": [ { "hand": ["Reveillark"] }, {} ] } },
  { "name": "ruling: a cost increase also raises the evoke cost (Sphere of Resistance makes evoke cost 7)",
    "players": [ { "hand": ["Reveillark"], "battlefield": ["Sphere of Resistance", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"] }, {} ],
    "steps": [ { "cast": "Reveillark", "alt": 0 }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Reveillark"], "battlefield_has": ["Sphere of Resistance"] }, {} ] } },
  { "name": "ruling: a creature cast without paying its mana cost cannot use evoke, so it stays on the battlefield",
    "players": [ { "hand": ["Super State"], "battlefield": ["Wildsear, Scouring Maw", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"], "library": ["Reveillark"] }, {} ],
    "steps": [ { "cast": "Super State" }, { "resolve": true, "answers": [true] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Reveillark"] }, {} ] } },
  { "name": "ruling: the leaves-the-battlefield trigger may target zero creature cards (up to two), so nothing returns",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Reveillark"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Reveillark"] }, { "resolve": true, "targets": [] } ],
    "expect": { "players": [ { "battlefield_lacks": ["Grizzly Bears", "Llanowar Elves"], "graveyard_has": ["Reveillark", "Grizzly Bears", "Llanowar Elves"] }, {} ] } },
  { "name": "ruling: the leaves-the-battlefield trigger may target two creature cards with power 2 or less",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Reveillark"], "graveyard": ["Grizzly Bears", "Llanowar Elves"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Reveillark"] }, { "resolve": true, "targets": ["Grizzly Bears", "Llanowar Elves"] } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears", "Llanowar Elves"], "graveyard_has": ["Reveillark"] }, {} ] } }
]
