[
 {
  "name": "ETB creates a 2/2 Rebel and attaches to it",
  "players": [
   {
    "hand": [
     "Vulshok Splitter"
    ],
    "battlefield": [
     "Mountain",
     "Mountain",
     "Mountain",
     "Mountain"
    ]
   },
   {}
  ],
  "steps": [
   {
    "cast": "Vulshok Splitter"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield_has": [
      "Vulshok Splitter",
      "Rebel 2-2"
     ]
    },
    {}
   ],
   "pt": {
    "Rebel 2-2": [
     4,
     2
    ]
   }
  }
 },
 {
  "name": "equip {2}{R} moves it to a creature you control",
  "players": [
   {
    "battlefield": [
     "Vulshok Splitter",
     "Mountain",
     "Mountain",
     "Mountain",
     "Grizzly Bears"
    ]
   },
   {}
  ],
  "steps": [
   {
    "activate": "Vulshok Splitter",
    "ability": 0,
    "targets": [
     "Grizzly Bears"
    ]
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {},
    {}
   ],
   "pt": {
    "Grizzly Bears": [
     4,
     2
    ]
   }
  }
 },
 {
  "name": "ruling: destroying the Rebel leaves the Equipment on the battlefield",
  "players": [
   { "hand": ["Vulshok Splitter"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] },
   { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
  ],
  "steps": [
   { "cast": "Vulshok Splitter" },
   { "resolve": true },
   { "pass": true },
   { "cast": "Murder", "player": 1, "targets": ["Rebel 2-2"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Vulshok Splitter"], "battlefield_lacks": ["Rebel 2-2"] },
    { "graveyard": ["Murder"] }
   ]
  }
 },
 {
  "name": "ruling: after the Rebel dies, paying equip moves the Equipment to another creature",
  "players": [
   { "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"], "hand": ["Vulshok Splitter"] },
   { "hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
  ],
  "steps": [
   { "cast": "Vulshok Splitter" },
   { "resolve": true },
   { "pass": true },
   { "cast": "Murder", "player": 1, "targets": ["Rebel 2-2"] },
   { "resolve": true },
   { "activate": "Vulshok Splitter", "ability": 0, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [4, 2] },
   "players": [
    { "battlefield_has": ["Vulshok Splitter", "Grizzly Bears"], "battlefield_lacks": ["Rebel 2-2"] },
    { "graveyard": ["Murder"] }
   ]
  }
 }
]
