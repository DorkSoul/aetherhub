[
 { "name": "flying creatures lose flying and keep their other keywords",
   "players": [ { "hand": ["Mystic Decree"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Serra Angel"] } ],
   "steps": [ { "cast": "Mystic Decree" }, { "resolve": true } ],
   "expect": { "keywords": { "Serra Angel": ["Vigilance"] }, "pt": { "Serra Angel": [4, 4] } } },
 { "name": "islandwalk creatures lose islandwalk",
   "players": [ { "hand": ["Mystic Decree"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Cold-Eyed Selkie"] } ],
   "steps": [ { "cast": "Mystic Decree" }, { "resolve": true } ],
   "expect": { "keywords": { "Cold-Eyed Selkie": [] } } },
 { "name": "creatures without flying are unaffected",
   "players": [ { "hand": ["Mystic Decree"], "battlefield": ["Island", "Island", "Island", "Island"] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Mystic Decree" }, { "resolve": true } ],
   "expect": { "pt": { "Grizzly Bears": [2, 2] }, "keywords": { "Grizzly Bears": [] } } },
 { "name": "islandwalk is lost: the Island-controlling defender can block the attacker",
   "players": [ { "hand": ["Mystic Decree"], "battlefield": ["Island", "Island", "Island", "Island", { "name": "Cold-Eyed Selkie", "sick": false }] }, { "battlefield": ["Island", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Mystic Decree" }, { "resolve": true }, { "attack": [ { "card": "Cold-Eyed Selkie", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Cold-Eyed Selkie" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "graveyard_has": ["Cold-Eyed Selkie"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } },
 { "name": "flying is lost: a ground creature can block the former flier",
   "players": [ { "hand": ["Mystic Decree"], "battlefield": ["Island", "Island", "Island", "Island", { "name": "Serra Angel", "sick": false }] }, { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Mystic Decree" }, { "resolve": true }, { "attack": [ { "card": "Serra Angel", "at": "p1" } ] }, { "block": [ { "blocker": "Grizzly Bears", "attacker": "Serra Angel" } ] }, { "advance_to": "Main2" } ],
   "expect": { "players": [ { "battlefield_has": ["Serra Angel"] }, { "life": 20, "graveyard_has": ["Grizzly Bears"] } ] } },
 { "name": "ruling: a second world permanent puts the first one into its owner's graveyard, and the new one stays",
   "players": [ { "hand": ["Mystic Decree"], "battlefield": ["Island", "Island", "Island", "Island", "Mystic Decree"] }, {} ],
   "steps": [ { "cast": "Mystic Decree" }, { "resolve": true } ],
   "expect": { "players": [ { "graveyard_has": ["Mystic Decree"], "battlefield_has": ["Mystic Decree"] }, {} ] } }
