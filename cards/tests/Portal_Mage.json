   { "resolve": true, "answers": [ "yes", "p2" ] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 20 }, { "life": 18 } ] }
 },
 {
  "name": "the attacker can be redirected to a planeswalker",
  "players": [
   { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] },
   { "hand": [ "Portal Mage" ], "battlefield": [ "Island", "Island", "Island" ] },
   { "battlefield": [ { "name": "Jace Beleren", "counters": { "Loyalty": 5 } } ] }
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "pass": true },
   { "player": 1, "cast": "Portal Mage" },
   { "resolve": true, "answers": [ "yes", "Jace Beleren" ] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 20 }, { "life": 20 } ], "counters": { "Jace Beleren": { "Loyalty": 3 } } }
 },
 {
  "name": "declining the reselection leaves the attacker attacking the original player",
  "players": [
   { "battlefield": [ { "name": "Grizzly Bears", "sick": false } ] },
   { "hand": [ "Portal Mage" ], "battlefield": [ "Island", "Island", "Island" ] },
   {}
  ],
  "steps": [
   { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
   { "pass": true },
   { "player": 1, "cast": "Portal Mage" },
   { "resolve": true, "answers": [ "no" ] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": { "players": [ {}, { "life": 18 }, { "life": 20 } ] }
 },
 {
  "name": "cast in the main phase there is no reselection (the trigger needs the declare attackers step)",
  "players": [
   { "hand": [ "Portal Mage" ], "battlefield": [ "Island", "Island", "Island", { "name": "Grizzly Bears", "sick": false } ] },
   {}
  ],
  "steps": [
   { "cast": "Portal Mage" },
   { "resolve": true }
  ],
  "expect": { "players": [ { "battlefield_has": [ "Portal Mage" ] }, {} ] }
 },
 {
  "name": "ruling: reselecting the attack does not fire the attacker's own attack trigger again (Goblin Guide)",
  "players": [
   { "battlefield": [ { "name": "Goblin Guide", "sick": false } ] },
   { "hand": [ "Portal Mage" ], "battlefield": [ "Island", "Island", "Island" ], "library": [ "Forest", "Mountain" ] },
   { "battlefield": [ { "name": "Jace Beleren", "counters": { "Loyalty": 5 } } ] }
  ],
  "steps": [
   { "attack": [ { "card": "Goblin Guide", "at": "p1" } ] },
   { "pass": true },
   { "pass": true, "player": 1 },
   { "pass": true },
   { "player": 1, "cast": "Portal Mage" },
   { "resolve": true, "answers": [ "yes", "Jace Beleren" ] },
   { "block": [] },
   { "advance_to": "Main2" }
  ],
  "expect": {
   "players": [ {}, { "hand": [ "Forest" ], "library_top": [ "Mountain" ], "life": 20 }, {} ],
   "counters": { "Jace Beleren": { "Loyalty": 3 } }
  }
 }
]
