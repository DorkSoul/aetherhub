  "steps": [ { "activate": "Chandra, Torch of Defiance", "ability": 0 }, { "resolve": true, "answers": [false] } ],
  "expect": { "players": [ { "exile": ["Lightning Bolt"] }, { "life": 18 } ], "counters": { "Chandra, Torch of Defiance": { "loyalty": 5 } } }
