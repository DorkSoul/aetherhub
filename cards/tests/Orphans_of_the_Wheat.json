[
  {
    "name": "attack: tap an untapped creature to get +1/+1",
    "players": [
      { "battlefield": [ { "name": "Orphans of the Wheat", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Orphans of the Wheat", "at": "p1" } ] },
      { "resolve": true, "answers": [ ["Grizzly Bears"] ] }
    ],
    "expect": { "pt": { "Orphans of the Wheat": [3, 2] }, "tapped": { "Grizzly Bears": true } }
  },
  {
    "name": "attack: tapping no creatures gives no bonus",
    "players": [
      { "battlefield": [ { "name": "Orphans of the Wheat", "sick": false }, { "name": "Grizzly Bears", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Orphans of the Wheat", "at": "p1" } ] },
      { "resolve": true }
    ],
    "expect": { "pt": { "Orphans of the Wheat": [2, 1] }, "tapped": { "Grizzly Bears": false } }
  },
  {
    "name": "ruling: a summoning-sick creature can be tapped for the attack trigger",
    "players": [
      { "battlefield": [ { "name": "Orphans of the Wheat", "sick": false }, { "name": "Grizzly Bears", "sick": true } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Orphans of the Wheat", "at": "p1" } ] },
      { "resolve": true, "answers": [ ["Grizzly Bears"] ] }
    ],
    "expect": { "pt": { "Orphans of the Wheat": [3, 2] }, "tapped": { "Grizzly Bears": true } }
  }
]
