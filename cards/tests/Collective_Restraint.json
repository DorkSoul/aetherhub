[
  {
    "name": "each attacker costs {X} where X is the basic land types among your lands",
    "players": [
      { "battlefield": ["Grizzly Bears", "Hill Giant", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Collective Restraint", "Island", "Plains"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }, { "card": "Hill Giant", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 15 }]
    }
  },
  {
    "name": "one basic land type makes each attacker cost {1}, however many lands you control",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain"] },
      { "battlefield": ["Collective Restraint", "Plains", "Plains", "Plains"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  },
  {
    "name": "an attacker that cannot pay the domain cost does not attack",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain"] },
      { "battlefield": ["Collective Restraint", "Island", "Plains"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "tapped": { "Grizzly Bears": false }
    }
  },
  {
    "name": "ruling: a creature that can't attack you can still attack your planeswalker, free of the tax",
    "players": [
      { "battlefield": ["Grizzly Bears"] },
      { "battlefield": ["Collective Restraint", "Island", "Plains", { "name": "Ajani, Sleeper Agent", "counters": { "loyalty": 4 } }] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "Ajani, Sleeper Agent" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 20 }],
      "counters": { "Ajani, Sleeper Agent": { "loyalty": 2 } }
    }
  },
  {
    "name": "ruling: Desert is not a basic land type, so it adds nothing to domain",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain"] },
      { "battlefield": ["Collective Restraint", "Island", "Desert"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  },
  {
    "name": "ruling: domain counts basic land types, not lands or lands of one type",
    "players": [
      { "battlefield": ["Grizzly Bears", "Mountain", "Mountain"] },
      { "battlefield": ["Collective Restraint", "Plains", "Plains", "Plains", "Island"] }
    ],
    "steps": [
      { "attack": [{ "card": "Grizzly Bears", "at": "p1" }] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [{}, { "life": 18 }]
    }
  }
]
