[
 {
  "name": "chapter I: opponent returns their creature with the greatest mana value to hand",
  "players": [
   {
    "hand": ["Summon: Valefor"],
    "battlefield": ["Island", "Island", "Island", "Island", "Island"]
   },
   { "battlefield": ["Grizzly Bears", "Serra Angel"] }
  ],
  "steps": [
   { "cast": "Summon: Valefor" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Summon: Valefor"] },
    { "battlefield_has": ["Grizzly Bears"], "hand": ["Serra Angel"] }
   ]
  }
 },
 {
  "name": "chapter I ignores the caster's own creatures, even ones with greater mana value",
  "players": [
   {
    "hand": ["Summon: Valefor"],
    "battlefield": ["Island", "Island", "Island", "Island", "Island", "Serra Angel"]
   },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Summon: Valefor" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Summon: Valefor", "Serra Angel"] },
    { "hand": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "chapter I: opponent with tied greatest mana value chooses one of them",
  "players": [
   {
    "hand": ["Summon: Valefor"],
    "battlefield": ["Island", "Island", "Island", "Island", "Island"]
   },
   { "battlefield": ["Grizzly Bears", "Grizzly Bears", "Llanowar Elves"] }
  ],
  "steps": [
   { "cast": "Summon: Valefor" },
   { "resolve": true, "player": 1, "answers": ["Grizzly Bears"] }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Summon: Valefor"] },
    { "battlefield_has": ["Grizzly Bears", "Llanowar Elves"], "hand": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "chapter I in a three-player game: each opponent returns only their own greatest-MV creature",
  "players": [
   {
    "hand": ["Summon: Valefor"],
    "battlefield": ["Island", "Island", "Island", "Island", "Island"]
   },
   { "battlefield": ["Grizzly Bears", "Serra Angel"] },
   { "battlefield": ["Llanowar Elves", "Grizzly Bears"] }
  ],
  "steps": [
   { "cast": "Summon: Valefor" },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "battlefield_has": ["Summon: Valefor"] },
    { "battlefield_has": ["Grizzly Bears"], "hand": ["Serra Angel"] },
    { "battlefield_has": ["Llanowar Elves"], "hand": ["Grizzly Bears"] }
   ]
  }
 },
 {
  "name": "chapter II: tap up to one target creature and put a stun counter on it",
  "players": [
   {
    "battlefield": [
     { "name": "Summon: Valefor", "counters": { "lore": 1 } }
    ]
   },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Summon: Valefor": { "Lore": 2 }, "Grizzly Bears": { "Stun": 1 } },
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "chapter III: tap up to one target creature and put a stun counter on it",
  "players": [
   {
    "battlefield": [
     { "name": "Summon: Valefor", "counters": { "lore": 2 } }
    ]
   },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "counters": { "Summon: Valefor": { "Lore": 3 }, "Grizzly Bears": { "Stun": 1 } },
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "chapter IV: tap target creature, stun it, then the Saga is sacrificed",
  "players": [
   {
    "battlefield": [
     { "name": "Summon: Valefor", "counters": { "lore": 3 } }
    ]
   },
   { "battlefield": ["Grizzly Bears"] }
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "graveyard": ["Summon: Valefor"] }, { "battlefield_has": ["Grizzly Bears"] } ],
   "counters": { "Grizzly Bears": { "Stun": 1 } },
   "tapped": { "Grizzly Bears": true }
  }
 },
 {
  "name": "chapter III with no creature to target: nothing happens and the Saga stays",
  "players": [
   {
    "battlefield": [
     { "name": "Summon: Valefor", "counters": { "lore": 2 } }
    ]
   },
   {}
  ],
  "steps": [
   { "advance_to": "Main1" },
   { "advance_to": "Main1" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "battlefield_has": ["Summon: Valefor"] }, {} ],
   "counters": { "Summon: Valefor": { "Lore": 3 } }
  }
 },
 {"name": "ruling: the Saga's Flying applies with no lore counters",
  "players": [{"battlefield": ["Summon: Valefor"]}, {}],
  "steps": [{"pass": true}],
  "expect": {"players": [{"battlefield_has": ["Summon: Valefor"]}, {}], "keywords": {"Summon: Valefor": ["Flying"]}}},
 {"name": "ruling: entering puts the first lore counter on the Saga, so chapter I triggers",
  "players": [{"hand": ["Summon: Valefor"], "battlefield": ["Island", "Island", "Island", "Island", "Island"]}, {}],
  "steps": [{"cast": "Summon: Valefor"}, {"resolve": true}],
  "expect": {"players": [{"battlefield_has": ["Summon: Valefor"]}, {}], "counters": {"Summon: Valefor": {"Lore": 1}}}},
 {"name": "ruling: a third lore counter triggers only chapters II-IV; chapter I does not trigger again",
  "players": [{"battlefield": [{"name": "Summon: Valefor", "counters": {"lore": 2}}]}, {"battlefield": ["Serra Angel", "Grizzly Bears"]}],
  "steps": [{"advance_to": "Main1"}, {"advance_to": "Main1", "targets": ["Grizzly Bears"]}, {"resolve": true}],
  "expect": {"players": [{"battlefield_has": ["Summon: Valefor"]}, {"battlefield_has": ["Serra Angel", "Grizzly Bears"]}], "counters": {"Summon: Valefor": {"Lore": 3}, "Grizzly Bears": {"Stun": 1}}, "tapped": {"Grizzly Bears": true}}},
 {"name": "ruling: an X creature has mana value 0 on the battlefield, so it ties with a 0-value token for chapter I",
  "players": [{"hand": ["Summon: Valefor"], "battlefield": ["Island", "Island", "Island", "Island", "Island"]}, {"battlefield": [{"name": "Walking Ballista", "counters": {"p1p1": 1}}, "Eldrazi Spawn"]}],
  "steps": [{"cast": "Summon: Valefor"}, {"resolve": true, "player": 1, "answers": ["Eldrazi Spawn"]}],
  "expect": {"players": [{"battlefield_has": ["Summon: Valefor"]}, {"battlefield_has": ["Walking Ballista"], "battlefield_lacks": ["Eldrazi Spawn"]}]}},
 {"name": "ruling: a chapter ability already on the stack resolves after the Saga has left the battlefield",
  "players": [{"hand": ["Lightning Bolt", "Shock"], "battlefield": [{"name": "Summon: Valefor", "counters": {"lore": 1}}, "Mountain", "Mountain"]}, {"battlefield": ["Grizzly Bears"]}],
  "steps": [{"advance_to": "Main1"}, {"advance_to": "Main1", "targets": ["Grizzly Bears"]}, {"cast": "Lightning Bolt", "targets": ["Summon: Valefor"]}, {"cast": "Shock", "targets": ["Summon: Valefor"]}, {"resolve": true}],
  "expect": {"players": [{"graveyard": ["Lightning Bolt", "Shock", "Summon: Valefor"]}, {}], "counters": {"Grizzly Bears": {"Stun": 1}}, "tapped": {"Grizzly Bears": true}}}
]
