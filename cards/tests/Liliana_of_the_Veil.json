[
  {
    "name": "+1: each player discards a card",
    "players": [
      { "battlefield": ["Liliana of the Veil"], "hand": ["Island"] },
      { "hand": ["Mountain"] }
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Liliana of the Veil": { "loyalty": 4 } },
      "players": [
        { "hand": [], "graveyard": ["Island"] },
        { "hand": [], "graveyard": ["Mountain"] }
      ]
    }
  },
  {
    "name": "-2: target player sacrifices a creature",
    "players": [
      { "battlefield": ["Liliana of the Veil"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 1, "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Liliana of the Veil": { "loyalty": 1 } },
      "players": [
        {},
        { "battlefield": [], "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "-6: the target player sacrifices the pile they choose (first pile)",
    "players": [
      { "battlefield": [{ "name": "Liliana of the Veil", "counters": { "loyalty": 6 } }] },
      { "battlefield": ["Grizzly Bears", "Island", "Forest", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 2, "targets": ["p1"] },
      { "resolve": true, "answers": [["Grizzly Bears", "Island"], 0] }
    ],
    "expect": {
      "players": [
        { "battlefield": [], "graveyard": ["Liliana of the Veil"] },
        { "battlefield": ["Forest", "Hill Giant"], "graveyard": ["Grizzly Bears", "Island"] }
      ]
    }
  },
  {
    "name": "-6: the target player sacrifices the other pile instead",
    "players": [
      { "battlefield": [{ "name": "Liliana of the Veil", "counters": { "loyalty": 6 } }] },
      { "battlefield": ["Grizzly Bears", "Island", "Forest", "Hill Giant"] }
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 2, "targets": ["p1"] },
      { "resolve": true, "answers": [["Grizzly Bears", "Island"], 1] }
    ],
    "expect": {
      "players": [
        { "battlefield": [], "graveyard": ["Liliana of the Veil"] },
        { "battlefield": ["Grizzly Bears", "Island"], "graveyard": ["Forest", "Hill Giant"] }
      ]
    }
  },
  {
    "name": "-6 needs 6 loyalty",
    "players": [
      { "battlefield": ["Liliana of the Veil"] },
      { "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 2, "targets": ["p1"], "illegal": true }
    ],
    "expect": {}
  },
  {
    "name": "ruling: the active player chooses the discard, then the discards happen together",
    "players": [
      { "battlefield": ["Liliana of the Veil"], "hand": ["Lightning Bolt", "Shock"] },
      { "hand": ["Grizzly Bears"] }
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 0 },
      { "resolve": true, "answers": ["Lightning Bolt"] }
    ],
    "expect": {
      "counters": { "Liliana of the Veil": { "loyalty": 4 } },
      "players": [
        { "hand": ["Shock"], "graveyard": ["Lightning Bolt"] },
        { "hand": [], "graveyard": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: +1 can be activated even when no player can discard",
    "players": [
      { "battlefield": ["Liliana of the Veil"] },
      {}
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 0 },
      { "resolve": true }
    ],
    "expect": {
      "counters": { "Liliana of the Veil": { "loyalty": 4 } },
      "players": [
        { "hand": [] },
        { "hand": [] }
      ]
    }
  },
  {
    "name": "ruling: the -6 pile may be empty; choosing the empty pile sacrifices nothing",
    "players": [
      { "battlefield": [{ "name": "Liliana of the Veil", "counters": { "loyalty": 6 } }] },
      { "battlefield": ["Grizzly Bears", "Island"] }
    ],
    "steps": [
      { "activate": "Liliana of the Veil", "ability": 2, "targets": ["p1"] },
      { "resolve": true, "answers": [[], 0] }
    ],
    "expect": {
      "players": [
        {},
        { "battlefield": ["Grizzly Bears", "Island"] }
      ]
    }
  }
]
