[
  { "name": "sacrifice: -2/-2 to a creature and two Elf Warrior tokens",
    "players": [ { "battlefield": ["Skemfar Elderhall", "Swamp", "Swamp", "Forest", "Plains", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Skemfar Elderhall", "ability": 0, "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Elf Warrior 1-1 Green"], "battlefield_lacks": ["Skemfar Elderhall"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "cannot activate with only four other mana sources",
    "players": [ { "battlefield": ["Skemfar Elderhall", "Swamp", "Swamp", "Forest", "Plains"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "activate": "Skemfar Elderhall", "ability": 0, "targets": ["Grizzly Bears"], "illegal": true } ],
    "expect": { "players": [ { "battlefield_has": ["Skemfar Elderhall"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "enters tapped when played",
    "players": [ { "hand": ["Skemfar Elderhall"], "battlefield": ["Forest"] }, {} ],
    "steps": [ { "play_land": "Skemfar Elderhall" } ],
    "expect": { "players": [ { "battlefield_has": ["Skemfar Elderhall"] }, {} ], "tapped": { "Skemfar Elderhall": true } } },
  { "name": "ruling: if the only target is gone when the ability resolves, no tokens are created",
    "players": [ { "battlefield": ["Skemfar Elderhall", "Swamp", "Swamp", "Forest", "Plains", "Plains"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
    "steps": [ { "activate": "Skemfar Elderhall", "ability": 0, "targets": ["Grizzly Bears"] }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_lacks": ["Skemfar Elderhall", "Elf Warrior 1-1 Green"], "graveyard": ["Skemfar Elderhall"] }, { "graveyard": ["Lightning Bolt", "Grizzly Bears"] } ] } },
  { "name": "ruling: with no target chosen the ability still creates the Elf Warrior tokens",
    "players": [ { "battlefield": ["Skemfar Elderhall", "Swamp", "Swamp", "Forest", "Plains", "Plains"] }, {} ],
    "steps": [ { "activate": "Skemfar Elderhall", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Elf Warrior 1-1 Green"], "battlefield_lacks": ["Skemfar Elderhall"] }, {} ] } }
]
