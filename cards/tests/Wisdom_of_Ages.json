[
  {
    "name": "returns only instant and sorcery cards from your graveyard, then exiles itself",
    "players": [
      {
        "hand": ["Wisdom of Ages"],
        "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain"],
        "graveyard": ["Lightning Bolt", "Divination", "Grizzly Bears"]
      },
      {
        "graveyard": ["Lightning Bolt"]
      }
    ],
    "steps": [
      { "cast": "Wisdom of Ages" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        {
          "hand": ["Lightning Bolt", "Divination"],
          "graveyard": ["Grizzly Bears"],
          "exile": ["Wisdom of Ages"]
        },
        {
          "graveyard": ["Lightning Bolt"]
        }
      ]
    }
  },
  {
    "name": "cannot be cast with only six mana",
    "players": [
      {
        "hand": ["Wisdom of Ages"],
        "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Wisdom of Ages", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Wisdom of Ages"] },
        {}
      ]
    }
  },
  {
    "name": "exiled Wisdom of Ages keeps the hand size unlimited: 8 cards survive my cleanup",
    "players": [
      {
        "hand": ["Wisdom of Ages", "Plains", "Plains", "Plains", "Plains", "Plains", "Plains"],
        "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain", "Mountain"],
        "graveyard": ["Lightning Bolt", "Divination"]
      },
      {}
    ],
    "steps": [
      { "cast": "Wisdom of Ages" },
      { "resolve": true },
      { "advance_to": "Upkeep", "auto": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 8, "exile": ["Wisdom of Ages"] },
        {}
      ]
    }
  }
]
