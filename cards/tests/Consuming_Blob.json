[
 {
  "name": "P/T from card types in your graveyard only",
  "players": [
   {
    "battlefield": [
     "Consuming Blob"
    ],
    "graveyard": [
     "Grizzly Bears",
     "Lightning Bolt"
    ]
   },
   {
    "graveyard": [
     "Forest"
    ]
   }
  ],
  "steps": [],
  "expect": {
   "pt": {
    "Consuming Blob": [
     2,
     3
    ]
   }
  }
 },
 {
  "name": "empty graveyard: 0/1",
  "players": [
   {
    "battlefield": [
     "Consuming Blob"
    ]
   },
   {}
  ],
  "steps": [],
  "expect": {
   "pt": {
    "Consuming Blob": [
     0,
     1
    ]
   }
  }
 },
 {
  "name": "same type twice counts once",
  "players": [
   {
    "battlefield": [
     "Consuming Blob"
    ],
    "graveyard": [
     "Grizzly Bears",
     "Hill Giant"
    ]
   },
   {}
  ],
  "steps": [],
  "expect": {
   "pt": {
    "Consuming Blob": [
     1,
     2
    ]
   }
  }
 },
 {
  "name": "end step creates an Ooze token",
  "players": [
   {
    "battlefield": [
     "Consuming Blob"
    ],
    "graveyard": [
     "Grizzly Bears",
     "Lightning Bolt",
     "Forest"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Consuming Blob",
      "Ooze 0-0 Graveyard Types"
     ]
    },
    {}
   ]
  }
 },
 {
  "name": "not at the opponent's end step",
  "players": [
   {
    "battlefield": [
     "Consuming Blob"
    ]
   },
   {}
  ],
  "steps": [
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   },
   {
    "advance_to": "End"
   },
   {
    "resolve": true
   }
  ],
  "expect": {
   "players": [
    {
     "battlefield": [
      "Consuming Blob",
      "Ooze 0-0 Graveyard Types"
     ]
    },
    {}
   ]
  }
 },
 { "name": "ruling: counts card types, not cards: two artifact cards in graveyard give 1/2",
   "players": [ { "battlefield": ["Consuming Blob"], "graveyard": ["Giant's Boulder", "Giant's Boulder"] }, {} ],
   "steps": [],
   "expect": { "pt": { "Consuming Blob": [1, 2] } } },
 { "name": "ruling: a spell entering the graveyard raises toughness before damage is checked, so Shock does not kill it",
   "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Consuming Blob"], "graveyard": ["Forest"] }, {} ],
   "steps": [ { "cast": "Shock", "targets": ["Consuming Blob"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Consuming Blob"], "graveyard_has": ["Shock", "Forest"] }, {} ], "pt": { "Consuming Blob": [2, 3] } } },
 { "name": "ruling: the Ooze token has the same P/T rule and survives the same way",
   "players": [ { "hand": ["Shock"], "battlefield": ["Mountain", "Ooze 0-0 Graveyard Types"], "graveyard": ["Forest"] }, {} ],
   "steps": [ { "cast": "Shock", "targets": ["Ooze 0-0 Graveyard Types"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ooze 0-0 Graveyard Types"], "graveyard_has": ["Shock", "Forest"] }, {} ], "pt": { "Ooze 0-0 Graveyard Types": [2, 3] } } },
 { "name": "ruling: supertypes are not card types: a basic Forest in graveyard gives 1/2",
   "players": [ { "battlefield": ["Consuming Blob"], "graveyard": ["Forest"] }, {} ],
   "steps": [],
   "expect": { "pt": { "Consuming Blob": [1, 2] } } }
]