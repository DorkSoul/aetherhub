[
  {
    "name": "creates one Elf Warrior for each Elf you control",
    "players": [ { "hand": ["Elven Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Llanowar Elves", "Elvish Mystic"] }, {} ],
    "steps": [ { "cast": "Elven Ambush" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_has": ["Elf Warrior", "Elf Warrior", "Llanowar Elves", "Elvish Mystic"], "graveyard": ["Elven Ambush"] }, {} ],
      "pt": { "Elf Warrior": [1, 1] }
    }
  },
  {
    "name": "with no Elves it creates no tokens",
    "players": [ { "hand": ["Elven Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Grizzly Bears"] }, {} ],
    "steps": [ { "cast": "Elven Ambush" }, { "resolve": true } ],
    "expect": {
      "players": [ { "battlefield_lacks": ["Elf Warrior"], "graveyard": ["Elven Ambush"] }, {} ]
    }
  },
  {
    "name": "ruling: the Elf count is taken as Elven Ambush resolves (an Elf shocked in response is not counted)",
    "players": [
      { "hand": ["Elven Ambush"], "battlefield": ["Forest", "Forest", "Forest", "Forest", "Llanowar Elves", "Llanowar Elves"] },
      { "hand": ["Shock"], "battlefield": ["Mountain"] }
    ],
    "steps": [
      { "cast": "Elven Ambush" },
      { "pass": true },
      { "cast": "Shock", "player": 1, "targets": ["Llanowar Elves"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield": ["Forest", "Forest", "Forest", "Forest", "Llanowar Elves", "Elf Warrior"], "graveyard_has": ["Llanowar Elves", "Elven Ambush"] },
        { "graveyard": ["Shock"] }
      ]
    }
  }
]
