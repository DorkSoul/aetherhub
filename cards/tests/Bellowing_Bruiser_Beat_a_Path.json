[
  {
    "name": "Beat a Path: up to two target creatures can't block this turn; the card goes to exile",
    "players": [
      { "hand": ["Bellowing Bruiser // Beat a Path"], "battlefield": ["Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "cast": "Bellowing Bruiser // Beat a Path", "face": true, "targets": ["p1:Grizzly Bears", "p1:Hill Giant"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "exile": ["Bellowing Bruiser // Beat a Path"] }, {}],
      "keywords": { "Grizzly Bears": ["CantBlock"], "Hill Giant": ["CantBlock"] }
    }
  },
  {
    "name": "Beat a Path then cast the creature from exile for {4}{R}",
    "players": [
      { "hand": ["Bellowing Bruiser // Beat a Path"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Bellowing Bruiser // Beat a Path", "face": true, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Bellowing Bruiser // Beat a Path" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{ "battlefield_has": ["Bellowing Bruiser // Beat a Path"], "exile": [] }, {}],
      "pt": { "Bellowing Bruiser // Beat a Path": [4, 4] }
    }
  },
  {
    "name": "ruling: if one of two Beat a Path targets becomes illegal, the other can't block and the card is still exiled",
    "players": [{ "hand": ["Bellowing Bruiser // Beat a Path", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] }],
    "steps": [
      { "cast": "Bellowing Bruiser // Beat a Path", "face": true, "targets": ["p1:Grizzly Bears", "p1:Hill Giant"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "exile": ["Bellowing Bruiser // Beat a Path"] }, { "graveyard": ["Grizzly Bears"] }], "keywords": { "Hill Giant": ["CantBlock"] } }
  },
  {
    "name": "ruling: an Adventure spell with all targets illegal goes to the graveyard, not exile",
    "players": [{ "hand": ["Bellowing Bruiser // Beat a Path", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears", "Hill Giant"] }],
    "steps": [
      { "cast": "Bellowing Bruiser // Beat a Path", "face": true, "targets": ["p1:Grizzly Bears", "p1:Hill Giant"] },
      { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"] },
      { "cast": "Lightning Bolt", "targets": ["Hill Giant"] },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "resolve": true }
    ],
    "expect": { "players": [{ "graveyard": ["Lightning Bolt", "Lightning Bolt", "Bellowing Bruiser // Beat a Path"], "exile": [] }, { "graveyard": ["Grizzly Bears", "Hill Giant"] }] }
  },
  {
    "name": "ruling: the creature half cast from exile can't be cast while a spell is on the stack",
    "players": [{ "hand": ["Bellowing Bruiser // Beat a Path", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] }, { "battlefield": ["Grizzly Bears"], "life": 20 }],
    "steps": [
      { "cast": "Bellowing Bruiser // Beat a Path", "face": true, "targets": ["p1:Grizzly Bears"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "cast": "Bellowing Bruiser // Beat a Path", "illegal": true },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Bellowing Bruiser // Beat a Path" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Bellowing Bruiser // Beat a Path"], "exile": [] }, { "life": 17 }] }
  }
]
