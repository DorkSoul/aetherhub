[
  {
    "name": "opponent's spell makes you discard it: 4 damage to the chosen target",
    "players": [
      { "hand": ["Guerrilla Tactics"] },
      { "hand": ["Mind Rot"], "battlefield": ["Swamp", "Swamp", "Swamp"] }
    ],
    "steps": [
      { "advance_to": "End" }, { "advance_to": "Main1" }, { "cast": "Mind Rot", "player": 1, "targets": ["p0"] },
      { "resolve": true, "answers": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Guerrilla Tactics"] },
        { "life": 16, "graveyard": ["Mind Rot"] }
      ]
    }
  },
  {
    "name": "discarding it to your own spell's cost does not trigger it",
    "players": [
      { "hand": ["Wild Guess", "Guerrilla Tactics"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Wild Guess" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Guerrilla Tactics", "Wild Guess"] },
        { "life": 20 }
      ]
    }
  },
  {
    "name": "front half deals 2 damage to any target",
    "players": [
      { "hand": ["Guerrilla Tactics"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Guerrilla Tactics", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Guerrilla Tactics"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: an opponent's optional discard still triggers it: discarding it deals 4 damage",
    "players": [
      { "hand": ["Guerrilla Tactics"] },
      { "hand": ["Mishra's Command"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" }, { "advance_to": "Main1" },
      { "cast": "Mishra's Command", "player": 1, "answers": [[0, 3], 1], "targets": ["p0"] },
      { "resolve": true, "answers": [["Guerrilla Tactics"]], "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Guerrilla Tactics"], "life": 20 },
        { "life": 16 }
      ]
    }
  },
  {
    "name": "ruling: an opponent's optional discard that you decline does not trigger it",
    "players": [
      { "hand": ["Guerrilla Tactics"] },
      { "hand": ["Mishra's Command"], "battlefield": ["Mountain", "Mountain", "Grizzly Bears"] }
    ],
    "steps": [
      { "advance_to": "End" }, { "advance_to": "Main1" },
      { "cast": "Mishra's Command", "player": 1, "answers": [[0, 3], 1], "targets": ["p0"] },
      { "resolve": true, "answers": [[]] }
    ],
    "expect": {
      "players": [
        { "hand": ["Guerrilla Tactics"], "life": 20 },
        { "life": 20 }
      ]
    }
  }
]
