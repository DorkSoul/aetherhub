  { "name": "cannot pay the cumulative upkeep: sacrificed",
    "players": [ { "battlefield": ["Mesmeric Trance"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" } ],
