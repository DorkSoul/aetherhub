  { "name": "creatures sharing a power count once",
    "players": [ { "battlefield": ["Loot, the Nexus", "Grizzly Bears", "Giant Spider"] }, {} ],
    "steps": [ { "tap_for_mana": "Loot, the Nexus", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ] } },
  { "name": "alone it makes one mana (its own power counts)",
    "players": [ { "battlefield": ["Loot, the Nexus"] }, {} ],
    "steps": [ { "tap_for_mana": "Loot, the Nexus", "color": "G" } ],
    "expect": { "players": [ { "pool": { "G": 1 } }, {} ] } }
