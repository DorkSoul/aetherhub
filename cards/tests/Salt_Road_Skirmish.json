  {
    "name": "ruling: target made illegal in response: nothing resolves, no Warriors",
    "players": [{ "hand": ["Salt Road Skirmish"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Grizzly Bears"] }],
    "steps": [
      { "cast": "Salt Road Skirmish" },
      { "pass": true },
