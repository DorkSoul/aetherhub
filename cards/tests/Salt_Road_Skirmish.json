      { "resolve": true }
    ],
    "expect": {
      "players": [{ "graveyard": ["Salt Road Skirmish"], "battlefield_lacks": ["Warrior 1-1 R"] }, { "graveyard_has": ["Grizzly Bears", "Lightning Bolt"] }]
