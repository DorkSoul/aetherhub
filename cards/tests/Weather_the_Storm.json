[
  {
    "name": "gains 3 life",
    "players": [
      {
        "hand": [
          "Weather the Storm"
        ],
        "battlefield": [
          "Forest",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Weather the Storm"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 23,
          "graveyard_has": [
            "Weather the Storm"
          ]
        },
        {
          "life": 20
        }
      ]
    }
  },
  {
    "name": "storm copies for each earlier spell (each copy gains 3)",
    "players": [
      {
        "hand": [
          "Shock",
          "Weather the Storm"
        ],
        "battlefield": [
          "Mountain",
          "Forest",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Shock",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      },
      {
        "cast": "Weather the Storm"
      },
      {
        "resolve": true
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "life": 26,
          "graveyard_has": [
            "Shock",
            "Weather the Storm"
          ]
        },
        {
          "life": 18
        }
      ]
    }
  },
  {
    "name": "ruling: a spell cast after storm is put on the stack is not counted by the copies",
    "players": [
      {
        "hand": ["Shock", "Shock", "Weather the Storm"],
        "battlefield": ["Mountain", "Mountain", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Weather the Storm" },
      { "cast": "Shock", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 26 }, { "life": 16 } ]
    }
  },
  {
    "name": "ruling: storm copies are not cast, so 'whenever you cast a spell' triggers do not see them",
    "players": [
      {
        "hand": ["Tablet of the Guilds", "Weather the Storm"],
        "battlefield": ["Forest", "Forest", "Island", "Island"]
      },
      {}
    ],
    "steps": [
      { "cast": "Tablet of the Guilds" },
      { "resolve": true, "answers": ["G", "U"] },
      { "cast": "Weather the Storm" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "life": 27 }, {} ]
    }
  }
]
