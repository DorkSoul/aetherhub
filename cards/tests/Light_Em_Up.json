    "steps": [ { "cast": "Light 'Em Up", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Light 'Em Up"], "battlefield": ["Mountain", "Mountain", "Llanowar Elves"] }, { "graveyard": ["Grizzly Bears"] } ] } },
  { "name": "ruling: the copy is not cast, so a cast trigger (Guttersnipe) fires only once",
