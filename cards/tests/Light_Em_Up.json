    "steps": [ { "cast": "Light 'Em Up", "targets": ["Grizzly Bears"], "answers": [true, ["Hill Giant"]] }, { "pass": true }, { "resolve": true, "answers": [["Grizzly Bears"]] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Light 'Em Up", "Hill Giant"], "battlefield_has": ["Guttersnipe"] }, { "graveyard": ["Grizzly Bears"], "life": 18 } ] } }
