  { "name": "casualty with a power-2 creature: sacrifice it, the copy hits a new target",
    "players": [ { "hand": ["Light 'Em Up"], "battlefield": ["Mountain", "Mountain", "Hill Giant"] }, { "battlefield": ["Grizzly Bears", "Llanowar Elves"] } ],
    "steps": [ { "cast": "Light 'Em Up", "targets": ["Grizzly Bears"], "answers": [true] }, { "pass": true }, { "resolve": true, "answers": [["Llanowar Elves"]] } ],
    "expect": { "players": [ { "graveyard": ["Light 'Em Up", "Hill Giant"] }, { "graveyard": ["Grizzly Bears", "Llanowar Elves"] } ] } },
  { "name": "casualty cannot use a power-1 creature",
