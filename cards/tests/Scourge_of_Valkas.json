[
  {
    "name": "ruling: the entering Dragon's trigger counts all Dragons you control at resolution",
    "players": [
      { "hand": ["Dragon Whelp"], "battlefield": ["Scourge of Valkas", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Dragon Whelp" },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scourge of Valkas", "Dragon Whelp"] },
        { "life": 18 }
      ]
    }
  },
  {
    "name": "ruling: X counts only Dragons you control, not the opponent's Dragons",
    "players": [
      { "hand": ["Scourge of Valkas"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "battlefield": ["Shivan Dragon"] }
    ],
    "steps": [
      { "cast": "Scourge of Valkas" },
      { "resolve": true, "targets": ["p1"] }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Scourge of Valkas"] },
        { "life": 19, "battlefield_has": ["Shivan Dragon"] }
      ]
    }
  },
  {
    "name": "{R}: Scourge gets +1/+0 until end of turn",
    "players": [ { "battlefield": ["Scourge of Valkas", "Mountain"] }, {} ],
    "steps": [ { "activate": "Scourge of Valkas", "ability": 0 }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Scourge of Valkas"] }, {} ], "pt": { "Scourge of Valkas": [5, 4] } }
  }
]
