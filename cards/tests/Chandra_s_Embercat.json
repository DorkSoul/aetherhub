        { "battlefield_has": ["Chandra's Embercat"] },
        { "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "its mana pays for a Chandra planeswalker spell",
    "players": [
      { "hand": ["Chandra, the Firebrand"], "battlefield": [{ "name": "Chandra's Embercat", "sick": false }, "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Chandra, the Firebrand" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Chandra, the Firebrand"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: its mana cannot pay for Chandra's Regulator (an artifact, not a Chandra planeswalker spell)",
    "players": [
      { "hand": ["Chandra's Regulator"], "battlefield": [{ "name": "Chandra's Embercat", "sick": false }, "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Chandra's Regulator", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Chandra's Regulator"], "battlefield_has": ["Chandra's Embercat"] },
        {}
      ]
    }
  }
