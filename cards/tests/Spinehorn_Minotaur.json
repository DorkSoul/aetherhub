[
  {
    "name": "ruling: cards put into hand by a search do not count as drawn",
    "players": [
      { "hand": ["Demonic Tutor", "Demonic Tutor"], "battlefield": ["Spinehorn Minotaur", "Swamp", "Swamp", "Swamp", "Swamp"], "library": ["Forest", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Demonic Tutor" },
      { "resolve": true, "answers": ["Forest"] },
      { "cast": "Demonic Tutor" },
      { "resolve": true, "answers": ["Mountain"] },
      { "attack": [ { "card": "Spinehorn Minotaur", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "hand_count": 2 }, { "life": 18 } ] }
  },
  {
    "name": "ruling: cards drawn before it entered still give double strike",
    "players": [
      { "hand": ["Divination", "Spinehorn Minotaur"], "battlefield": ["Island", "Island", "Island", "Mountain", "Mountain", "Mountain"], "library": ["Mountain", "Forest", "Swamp"] },
      {}
    ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "cast": "Spinehorn Minotaur" },
      { "resolve": true }
    ],
    "expect": {
      "players": [{}, {}],
      "keywords": { "Spinehorn Minotaur": ["DoubleStrike"] }
    }
  },
  {
    "name": "double strike once two cards have been drawn this turn",
    "players": [ { "hand": ["Divination"], "battlefield": ["Island", "Island", "Island", "Spinehorn Minotaur"], "library": ["Mountain", "Forest", "Swamp"] }, {} ],
    "steps": [
      { "cast": "Divination" },
      { "resolve": true },
      { "attack": [ { "card": "Spinehorn Minotaur", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "life": 16 } ] }
  },
  {
    "name": "no double strike without two draws",
    "players": [ { "battlefield": ["Spinehorn Minotaur"] }, {} ],
    "steps": [ { "attack": [ { "card": "Spinehorn Minotaur", "at": "p1" } ] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ] }
  }
]
