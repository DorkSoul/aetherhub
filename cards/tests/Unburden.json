[
  {
    "name": "target player discards two cards",
    "players": [
      {
        "hand": [
          "Unburden"
        ],
        "battlefield": [
          "Swamp",
          "Swamp",
          "Swamp"
        ]
      },
      {
        "hand": [
          "Grizzly Bears",
          "Hill Giant"
        ]
      }
    ],
    "steps": [
      {
        "cast": "Unburden",
        "targets": [
          "p1"
        ]
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "graveyard": [
            "Unburden"
          ]
        },
        {
          "hand_count": 0,
          "graveyard": [
            "Grizzly Bears",
            "Hill Giant"
          ]
        }
      ]
    }
  },
  {
    "name": "cycling {2} discards it to draw a card",
    "players": [
      {
        "hand": [
          "Unburden"
        ],
        "battlefield": [
          "Plains",
          "Plains"
        ]
      },
      {}
    ],
    "steps": [
      {
        "activate": "Unburden",
        "ability": 0
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1,
          "graveyard": [
            "Unburden"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: Stifle can counter cycling (an activated ability): no card is drawn",
    "players": [
      { "hand": ["Unburden"], "battlefield": ["Plains", "Plains"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Unburden", "ability": 0 },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Unburden" } ] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 0, "graveyard": ["Unburden"] },
        { "graveyard": ["Stifle"] }
      ]
    }
  },
  {
    "name": "ruling: cycling is not a spell, so Counterspell has nothing to counter",
    "players": [
      { "hand": ["Unburden"], "battlefield": ["Plains", "Plains"] },
      { "hand": ["Counterspell"], "battlefield": ["Island", "Island"] }
    ],
    "steps": [
      { "activate": "Unburden", "ability": 0 },
      { "pass": true },
      { "cast": "Counterspell", "player": 1, "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 1, "graveyard": ["Unburden"] },
        { "hand_count": 1 }
      ]
    }
  }
]