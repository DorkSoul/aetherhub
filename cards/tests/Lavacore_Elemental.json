[
  {
    "name": "enters with a time counter",
    "players": [ { "hand": ["Lavacore Elemental"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lavacore Elemental" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Lavacore Elemental"] }, {} ], "counters": { "Lavacore Elemental": { "time": 1 } } }
  },
  {
    "name": "combat damage to a player from your creature adds a time counter",
    "players": [ { "battlefield": ["Lavacore Elemental", { "name": "Grizzly Bears" }] }, {} ],
    "steps": [ { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 18 } ], "counters": { "Lavacore Elemental": { "time": 2 } } }
  },
  {
    "name": "sacrificed when the last time counter is removed in upkeep",
    "players": [ { "hand": ["Lavacore Elemental"], "battlefield": ["Mountain", "Mountain", "Mountain"] }, {} ],
    "steps": [ { "cast": "Lavacore Elemental" }, { "resolve": true }, { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lavacore Elemental"] }, {} ] }
  },
  {
    "name": "ruling: it triggers its own ability when it deals combat damage",
    "players": [ { "battlefield": ["Lavacore Elemental"] }, {} ],
    "steps": [ { "attack": [ { "card": "Lavacore Elemental", "at": "p1" } ] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 15 } ], "counters": { "Lavacore Elemental": { "time": 2 } } }
  },
  {
    "name": "ruling: each creature dealing combat damage to a player triggers it once",
    "players": [ { "battlefield": ["Lavacore Elemental", { "name": "Grizzly Bears" }, { "name": "Llanowar Elves" }] }, {} ],
    "steps": [ { "attack": [ { "card": "Lavacore Elemental", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" }, { "card": "Llanowar Elves", "at": "p1" } ] }, { "resolve": true }, { "block": [] }, { "advance_to": "Main2" } ],
    "expect": { "players": [ {}, { "life": 12 } ], "counters": { "Lavacore Elemental": { "time": 4 } } }
  }
]
