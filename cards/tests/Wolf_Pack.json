[
  {
    "name": "blocked attacker assigns its combat damage to the defending player",
    "players": [
      { "battlefield": [ { "name": "Wolf Pack", "sick": false } ] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Wolf Pack", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Wolf Pack" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 13, "battlefield": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "unblocked attacker deals its 7 combat damage normally",
    "players": [
      { "battlefield": [ { "name": "Wolf Pack", "sick": false } ] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Wolf Pack", "at": "p1" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 13 }
      ]
    }
  },
  {
    "name": "ruling: a blocker with protection from green does not stop the damage going to the defending player",
    "players": [
      { "battlefield": [ { "name": "Wolf Pack", "sick": false } ] },
      { "battlefield": ["Mirran Crusader"] }
    ],
    "steps": [
      { "attack": [ { "card": "Wolf Pack", "at": "p1" } ] },
      { "block": [ { "blocker": "Mirran Crusader", "attacker": "Wolf Pack" } ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        { "battlefield_has": ["Wolf Pack"] },
        { "life": 13, "battlefield_has": ["Mirran Crusader"] }
      ]
    }
  },
  {
    "name": "ruling: a double-blocked attacker assigns all its damage to the defending player (not split), so the blockers take none",
    "players": [
      { "battlefield": [ { "name": "Wolf Pack", "sick": false } ] },
      { "battlefield": ["Grizzly Bears", "Hill Giant"] }
    ],
    "steps": [
      { "attack": [ { "card": "Wolf Pack", "at": "p1" } ] },
      { "block": [
        { "blocker": "Grizzly Bears", "attacker": "Wolf Pack" },
        { "blocker": "Hill Giant", "attacker": "Wolf Pack" }
      ] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 13, "battlefield_has": ["Grizzly Bears", "Hill Giant"] }
      ]
    }
  }
]
