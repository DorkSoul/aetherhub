[
  { "name": "unblocked: lifelink gains life equal to damage dealt",
    "players": [ { "battlefield": ["Beloved Princess"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "attack": [ { "card": "Beloved Princess", "at": "p1" } ] },
               { "block": [] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 21 }, { "life": 19 } ] } },
  { "name": "blocked by a power 2 creature: lifelink still gains life",
    "players": [ { "battlefield": ["Beloved Princess"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Beloved Princess", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Beloved Princess" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Beloved Princess"] }, { "life": 20 } ] } },
  { "name": "can't be blocked by power 3 or greater: Hill Giant's block is illegal, Princess connects",
    "players": [ { "battlefield": ["Beloved Princess", "Grizzly Bears"] }, { "battlefield": ["Hill Giant", "Llanowar Elves"] } ],
    "steps": [ { "attack": [ { "card": "Beloved Princess", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
               { "block": [ { "blocker": "Hill Giant", "attacker": "Beloved Princess" }, { "blocker": "Llanowar Elves", "attacker": "Grizzly Bears" } ] },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 21, "battlefield_has": ["Beloved Princess"] }, { "life": 19 } ] } },
  { "name": "ruling: a blocker that gets power 3 after blocking does not unblock the Princess (no damage to the player)",
    "players": [ { "battlefield": ["Beloved Princess"] }, { "hand": ["Ajani's Presence"], "battlefield": ["Plains", "Grizzly Bears"] } ],
    "steps": [ { "attack": [ { "card": "Beloved Princess", "at": "p1" } ] },
               { "block": [ { "blocker": "Grizzly Bears", "attacker": "Beloved Princess" } ] },
               { "pass": true },
               { "player": 1, "cast": "Ajani's Presence", "targets": ["Grizzly Bears"] },
               { "resolve": true },
               { "advance_to": "Main2" } ],
    "expect": { "players": [ { "life": 21, "graveyard": ["Beloved Princess"] }, { "life": 20, "battlefield_has": ["Grizzly Bears"] } ] } }
