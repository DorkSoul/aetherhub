[
  {
    "name": "ruling: speed is tracked per player (your speed does not change the opponent's; no speed counts as 0)",
    "players": [
      {
        "battlefield": [
          "Risen Necroregent"
        ]
      },
      {}
    ],
    "steps": [
      {
        "set_speed": 4
      }
    ],
    "expect": {
      "players": [
        {
          "speed": 4
        },
        {
          "speed": 0
        }
      ]
    }
  },
  {
    "name": "max speed: creates a Zombie at your end step",
    "players": [
      {
        "battlefield": [
          "Risen Necroregent"
        ]
      },
      {}
    ],
    "steps": [
      {
        "set_speed": 4
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_has": [
            "Zombie"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "below max speed: no Zombie at your end step",
    "players": [
      {
        "battlefield": [
          "Risen Necroregent"
        ]
      },
      {}
    ],
    "steps": [
      {
        "set_speed": 3
      },
      {
        "advance_to": "End"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "battlefield_lacks": [
            "Zombie"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "start your engines: casting it gives its controller speed 1",
    "players": [ { "hand": ["Risen Necroregent"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Swamp"] }, {} ],
    "steps": [ { "cast": "Risen Necroregent" }, { "resolve": true } ],
    "expect": { "players": [ { "speed": 1, "battlefield_has": ["Risen Necroregent"] }, {} ] }
  }
]
