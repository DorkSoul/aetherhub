[
  {
    "name": "draws one card plus one per Take Inventory in the graveyard",
    "players": [
      {
        "hand": [
          "Take Inventory"
        ],
        "battlefield": [
          "Island",
          "Island"
        ],
        "graveyard": [
          "Take Inventory"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Take Inventory"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 2,
          "graveyard": [
            "Take Inventory",
            "Take Inventory"
          ]
        },
        {}
      ]
    }
  },
  {
    "name": "with no copy in the graveyard it draws just one card",
    "players": [
      {
        "hand": [
          "Take Inventory"
        ],
        "battlefield": [
          "Island",
          "Island"
        ]
      },
      {}
    ],
    "steps": [
      {
        "cast": "Take Inventory"
      },
      {
        "resolve": true
      }
    ],
    "expect": {
      "players": [
        {
          "hand_count": 1
        },
        {}
      ]
    }
  },
  {
    "name": "ruling: the Take Inventory being cast is not in the graveyard, so only the two copies already there add draws",
    "players": [
      {
        "hand": ["Take Inventory"],
        "battlefield": ["Island", "Island"],
        "graveyard": ["Take Inventory", "Take Inventory"]
      },
      {}
    ],
    "steps": [
      { "cast": "Take Inventory" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 3 },
        {}
      ]
    }
  }
]
