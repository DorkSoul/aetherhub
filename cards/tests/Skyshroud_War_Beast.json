[
  { "name": "P/T equals the nonbasic lands the chosen opponent controls, not the controller's own",
    "players": [
      { "hand": ["Skyshroud War Beast"], "battlefield": ["Forest", "Forest", "Scrubland", "Scrubland"] },
      { "battlefield": ["Scrubland", "Scrubland", "Scrubland", "Forest"] }
    ],
    "steps": [ { "cast": "Skyshroud War Beast" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Skyshroud War Beast"] }, {} ], "pt": { "Skyshroud War Beast": [3, 3] } } },
  { "name": "basic lands of the chosen opponent do not count",
    "players": [
      { "hand": ["Skyshroud War Beast"], "battlefield": ["Forest", "Forest", "Scrubland", "Scrubland", "Scrubland"] },
      { "battlefield": ["Forest", "Mountain", "Scrubland"] }
    ],
    "steps": [ { "cast": "Skyshroud War Beast" }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Skyshroud War Beast"] }, {} ], "pt": { "Skyshroud War Beast": [1, 1] } } },
  { "name": "an opponent with no nonbasic lands makes it a 0/0 that dies",
    "players": [
      { "hand": ["Skyshroud War Beast"], "battlefield": ["Forest", "Forest", "Scrubland", "Scrubland", "Scrubland"] },
      { "battlefield": ["Forest", "Forest"] }
    ],
    "steps": [ { "cast": "Skyshroud War Beast" }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard_has": ["Skyshroud War Beast"] }, {} ] } },
  { "name": "ruling: P/T is recalculated when a nonbasic land enters the chosen opponent's battlefield",
    "players": [
      { "hand": ["Skyshroud War Beast"], "battlefield": ["Forest", "Forest"] },
      { "hand": ["Scrubland"], "battlefield": ["Scrubland", "Scrubland"] }
    ],
    "steps": [ { "cast": "Skyshroud War Beast" }, { "resolve": true }, { "advance_to": "Main1" }, { "play_land": "Scrubland", "player": 1 } ],
    "expect": { "players": [ { "battlefield_has": ["Skyshroud War Beast"] }, {} ], "pt": { "Skyshroud War Beast": [3, 3] } } }
]
