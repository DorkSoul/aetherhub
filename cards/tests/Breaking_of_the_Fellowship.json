[
  { "name": "the opponent's creature deals damage equal to its power to another creature that player controls",
    "players": [ { "hand": ["Breaking of the Fellowship"], "battlefield": ["Mountain", "Island"] }, { "battlefield": ["Hill Giant", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Breaking of the Fellowship", "targets": ["Hill Giant", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ {}, { "battlefield_has": ["Hill Giant"], "graveyard_has": ["Grizzly Bears"] } ] } },
  { "name": "cannot be cast unless the opponent controls a second creature to target",
    "players": [ { "hand": ["Breaking of the Fellowship"], "battlefield": ["Mountain", "Island"] }, { "battlefield": ["Hill Giant"] } ],
    "steps": [ { "cast": "Breaking of the Fellowship", "illegal": true } ],
    "expect": { "players": [ { "hand_count": 1 }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: The Ring tempts you even with no creature of yours (the emblem is still created)",
    "players": [ { "hand": ["Breaking of the Fellowship"], "battlefield": ["Mountain", "Island"] }, { "battlefield": ["Hill Giant", "Ornithopter"] } ],
    "steps": [ { "cast": "Breaking of the Fellowship", "targets": ["Hill Giant", "Ornithopter"] }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 1"] }, { "graveyard_has": ["Ornithopter"], "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "ruling: a second tempt replaces the emblem with The Ring 2 (only one Ring emblem exists)",
    "players": [ { "hand": ["Breaking of the Fellowship", "Breaking of the Fellowship"], "battlefield": ["Mountain", "Island", "Mountain", "Island"] }, { "battlefield": ["Hill Giant", "Ornithopter", "Grizzly Bears"] } ],
    "steps": [ { "cast": "Breaking of the Fellowship", "targets": ["Hill Giant", "Ornithopter"] }, { "resolve": true }, { "cast": "Breaking of the Fellowship", "targets": ["Hill Giant", "Grizzly Bears"] }, { "resolve": true } ],
    "expect": { "players": [ { "command": ["The Ring 2"] }, { "graveyard_has": ["Ornithopter", "Grizzly Bears"] } ] } },
  { "name": "ruling: the lone creature becomes Ring-bearer and cannot be blocked by a creature with greater power",
    "players": [ { "hand": ["Breaking of the Fellowship"], "battlefield": ["Mountain", "Island", { "name": "Grizzly Bears", "sick": false }] }, { "battlefield": ["Hill Giant", "Ornithopter"] } ],
    "steps": [ { "cast": "Breaking of the Fellowship", "targets": ["Hill Giant", "Ornithopter"] }, { "resolve": true }, { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] }, { "block": [ { "blocker": "Hill Giant", "attacker": "Grizzly Bears" } ], "illegal": true }, { "advance_to": "Main2" } ],
    "expect": { "players": [ { "battlefield_has": ["Grizzly Bears"] }, { "life": 18, "battlefield_has": ["Hill Giant"] } ] } }
]
