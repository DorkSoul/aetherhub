[
 {
  "name": "opponent can't flashback a spell from their graveyard",
  "players": [
   { "battlefield": ["Drannith Magistrate"] },
   { "graveyard": ["Lingering Souls"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lingering Souls", "alt": 0, "player": 1, "illegal": true }
  ],
  "expect": {
   "players": [
    {},
    { "graveyard": ["Lingering Souls"] }
   ]
  }
 },
 {
  "name": "opponent can still cast a spell from their hand",
  "players": [
   { "battlefield": ["Drannith Magistrate", "Grizzly Bears"] },
   { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] }
  ],
  "steps": [
   { "pass": true },
   { "cast": "Lightning Bolt", "player": 1, "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "players": [
    { "graveyard": ["Grizzly Bears"] },
    { "graveyard": ["Lightning Bolt"] }
   ]
  }
 },
 {
  "name": "opponent cannot cast a flashback spell from their graveyard during their own turn",
  "players": [
   { "battlefield": ["Drannith Magistrate"] },
   { "graveyard": ["Lingering Souls"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1", "player": 1 },
   { "cast": "Lingering Souls", "alt": 0, "player": 1, "illegal": true }
  ],
  "expect": {
   "players": [{}, { "graveyard": ["Lingering Souls"] }]
  }
 },
 {
  "name": "control: without Drannith Magistrate the opponent can flash back Lingering Souls on their own turn",
  "players": [
   {},
   { "graveyard": ["Lingering Souls"], "battlefield": ["Swamp", "Swamp"] }
  ],
  "steps": [
   { "advance_to": "Main2" },
   { "advance_to": "Main1", "player": 1 },
   { "cast": "Lingering Souls", "alt": 0, "player": 1 },
   { "resolve": true }
  ],
  "expect": {
   "players": [{}, { "exile": ["Lingering Souls"] }]
  }
 },
 {
  "name": "ruling: the opponent may still play a land from the graveyard (Drannith only stops spells)",
  "players": [
   { "battlefield": ["Drannith Magistrate"] },
   { "battlefield": ["Crucible of Worlds"], "graveyard": ["Forest"] }
  ],
  "steps": [
