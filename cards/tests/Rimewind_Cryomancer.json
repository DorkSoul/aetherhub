[
  {
    "name": "with four snow permanents counters an opponent's crew ability",
    "players": [
      { "battlefield": ["Rimewind Cryomancer", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island"] },
      { "battlefield": ["Bomat Bazaar Barge", "Hill Giant"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Bomat Bazaar Barge", "ability": 0, "player": 1 },
      { "activate": "Rimewind Cryomancer" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Hill Giant": true, "Rimewind Cryomancer": true },
      "players": [{}, { "battlefield_has": ["Bomat Bazaar Barge"] }]
    }
  },
  {
    "name": "with only three snow permanents it cannot be activated",
    "players": [
      { "battlefield": ["Rimewind Cryomancer", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island"] },
      { "battlefield": ["Bomat Bazaar Barge", "Hill Giant"] }
    ],
    "steps": [
      { "pass": true },
      { "activate": "Bomat Bazaar Barge", "ability": 0, "player": 1 },
      { "activate": "Rimewind Cryomancer", "illegal": true },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Rimewind Cryomancer": false }
    }
  },
  {
    "name": "ruling: an equip ability (a keyword activated ability written with a colon) can be countered",
    "players": [
      { "battlefield": ["Rimewind Cryomancer", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Snow-Covered Island", "Bonesplitter", "Hill Giant"] },
      {}
    ],
    "steps": [
      { "activate": "Bonesplitter", "ability": 0, "targets": ["Hill Giant"] },
      { "activate": "Rimewind Cryomancer" },
      { "resolve": true }
    ],
    "expect": {
      "tapped": { "Rimewind Cryomancer": true },
      "pt": { "Hill Giant": [3, 3] }
    }
  }
]
