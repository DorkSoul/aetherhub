[
  {
    "name": "cycling {2} discards it and draws a card",
    "players": [
      { "hand": ["Barkhide Mauler"], "battlefield": ["Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Barkhide Mauler" },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Barkhide Mauler"], "hand_count": 1 },
        {}
      ]
    }
  },
  {
    "name": "cycling needs {2}",
    "players": [
      { "hand": ["Barkhide Mauler"], "battlefield": ["Plains"] },
      {}
    ],
    "steps": [
      { "activate": "Barkhide Mauler", "illegal": true }
    ],
    "expect": {
      "players": [
        { "hand": ["Barkhide Mauler"] },
        {}
      ]
    }
  },
  {
    "name": "ruling: Stifle can counter the cycling ability, which is an activated ability",
    "players": [
      { "hand": ["Barkhide Mauler"], "battlefield": ["Plains", "Plains"] },
      { "hand": ["Stifle"], "battlefield": ["Island"] }
    ],
    "steps": [
      { "activate": "Barkhide Mauler" },
      { "pass": true },
      { "cast": "Stifle", "player": 1, "targets": [ { "stack": "Barkhide Mauler" } ] },
      { "pass": true, "player": 1 },
      { "pass": true }
    ],
    "expect": {
      "players": [
        { "graveyard": ["Barkhide Mauler"], "hand_count": 0 },
        { "graveyard": ["Stifle"] }
      ]
    }
  }
