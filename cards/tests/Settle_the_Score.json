[
 { "name": "exiles target creature and puts two loyalty counters on your planeswalker",
   "players": [ { "hand": ["Settle the Score"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Ajani, the Greathearted"] },
     { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Settle the Score", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ajani, the Greathearted"] }, { "exile": ["Grizzly Bears"] } ],
     "counters": { "Ajani, the Greathearted": { "loyalty": 7 } } } },
 { "name": "without a planeswalker the creature is still exiled",
   "players": [ { "hand": ["Settle the Score"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"] },
     { "battlefield": ["Grizzly Bears"] } ],
   "steps": [ { "cast": "Settle the Score", "targets": ["Grizzly Bears"] }, { "resolve": true } ],
   "expect": { "players": [ {}, { "exile": ["Grizzly Bears"] } ] } },
 { "name": "ruling: if the target is gone when it resolves, the spell does nothing and no loyalty is added",
   "players": [ { "hand": ["Settle the Score"], "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp", "Ajani, the Greathearted"] },
     { "hand": ["Shock"], "battlefield": ["Mountain", "Grizzly Bears"] } ],
   "steps": [ { "cast": "Settle the Score", "targets": ["Grizzly Bears"] }, { "pass": true },
     { "cast": "Shock", "player": 1, "targets": ["Grizzly Bears"] }, { "pass": true, "player": 1 }, { "resolve": true } ],
   "expect": { "players": [ { "battlefield_has": ["Ajani, the Greathearted"], "graveyard": ["Settle the Score"] }, { "graveyard": ["Grizzly Bears", "Shock"] } ],
     "counters": { "Ajani, the Greathearted": { "loyalty": 5 } } } }
]
