[
  {
    "name": "target artifact creature must block it this turn",
    "players": [
      { "battlefield": ["Auriok Siege Sled", "Plains"] },
      { "battlefield": ["Ornithopter", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Auriok Siege Sled", "at": "p1" }] },
      { "activate": "Auriok Siege Sled", "ability": 0, "targets": ["Ornithopter"] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 20, "graveyard": ["Ornithopter"] }
      ]
    }
  },
  {
    "name": "target artifact creature can't block it this turn",
    "players": [
      { "battlefield": ["Auriok Siege Sled", "Plains"] },
      { "battlefield": ["Ornithopter", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Auriok Siege Sled", "at": "p1" }] },
      { "activate": "Auriok Siege Sled", "ability": 1, "targets": ["Ornithopter"] },
      { "resolve": true },
      { "block": [{ "blocker": "Ornithopter", "attacker": "Auriok Siege Sled" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "battlefield_has": ["Ornithopter"] }
      ]
    }
  },
  {
    "name": "no block is forced without activating the ability",
    "players": [
      { "battlefield": ["Auriok Siege Sled"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Auriok Siege Sled", "at": "p1" }] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "battlefield_has": ["Grizzly Bears"] }
      ]
    }
  },
  {
    "name": "ruling: both abilities on the same creature: it can't block the Sled",
    "players": [
      { "battlefield": ["Auriok Siege Sled", "Plains", "Plains"] },
      { "battlefield": ["Ornithopter", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [{ "card": "Auriok Siege Sled", "at": "p1" }] },
      { "activate": "Auriok Siege Sled", "ability": 0, "targets": ["Ornithopter"] },
      { "resolve": true },
      { "activate": "Auriok Siege Sled", "ability": 1, "targets": ["Ornithopter"] },
      { "resolve": true },
      { "block": [{ "blocker": "Ornithopter", "attacker": "Auriok Siege Sled" }], "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [
        {},
        { "life": 17, "battlefield_has": ["Ornithopter"] }
      ]
    }
  }
]
