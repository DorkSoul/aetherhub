[
  {
    "name": "cast from hand: each player discards their hand and draws seven",
    "players": [
      { "hand": ["Reforge the Soul", "Island"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      { "hand": ["Plains", "Swamp"] }
    ],
    "steps": [ { "cast": "Reforge the Soul" }, { "resolve": true } ],
    "expect": {
      "players": [
        { "hand_count": 7, "graveyard_has": ["Island", "Reforge the Soul"] },
        { "hand_count": 7, "graveyard_has": ["Plains", "Swamp"] }
      ]
    }
  },
  {
    "name": "miracle: first card drawn this turn, pay {1}{R} and cast it",
    "players": [
      { "library": ["Reforge the Soul"], "hand": ["Island"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Draw" },
      { "advance_to": "Draw", "answers": [true] },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "hand_count": 7, "graveyard_has": ["Island", "Reforge the Soul"] },
        {}
      ]
    }
  },
  {
    "name": "miracle: declining keeps Reforge the Soul in hand, no discard",
    "players": [
      { "library": ["Reforge the Soul"], "hand": ["Island"], "battlefield": ["Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Draw" },
      { "advance_to": "Draw", "answers": [false] }
    ],
    "expect": {
      "players": [
        { "hand": ["Island", "Reforge the Soul"], "graveyard": [] },
        {}
      ]
    }
  }
]
