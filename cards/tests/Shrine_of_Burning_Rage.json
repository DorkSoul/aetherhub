[
  {
    "name": "two red spells add two charge counters; sacrifice deals that much damage",
    "players": [
      { "hand": ["Shrine of Burning Rage", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "cast": "Shrine of Burning Rage" },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "cast": "Lightning Bolt", "targets": ["p1"] },
      { "resolve": true },
      { "activate": "Shrine of Burning Rage", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Shrine of Burning Rage", "Lightning Bolt"] }, { "life": 12 } ],
      "tapped": {}
    }
  },
  {
    "name": "no counters: sacrifice deals no damage",
    "players": [
      { "hand": ["Shrine of Burning Rage"], "battlefield": ["Plains", "Plains", "Plains", "Plains", "Plains"] },
      {}
    ],
    "steps": [
      { "cast": "Shrine of Burning Rage" },
      { "resolve": true },
      { "activate": "Shrine of Burning Rage", "targets": ["p1"] },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Shrine of Burning Rage"] }, { "life": 20 } ]
    }
  },
  {
    "name": "upkeep adds a charge counter",
    "players": [ { "battlefield": ["Shrine of Burning Rage"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" }, { "advance_to": "Upkeep" }, { "resolve": true } ],
    "expect": { "players": [ {}, {} ], "counters": { "Shrine of Burning Rage": { "charge": 1 } } }
  },
  {
    "name": "opponent's upkeep does not add a charge counter",
    "players": [ { "battlefield": ["Shrine of Burning Rage"] }, {} ],
    "steps": [ { "advance_to": "Upkeep" } ],
    "expect": { "players": [ {}, {} ], "counters": { "Shrine of Burning Rage": { "charge": 0 } } }
  }
]
