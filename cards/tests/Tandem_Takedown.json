    "steps": [ { "cast": "Tandem Takedown", "targets": ["Grizzly Bears", "Talas Merchant", "Hill Giant"] }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Grizzly Bears"], "player": 1 }, { "pass": true }, { "cast": "Lightning Bolt", "targets": ["Talas Merchant"], "player": 1 }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Tandem Takedown", "Grizzly Bears", "Talas Merchant"] }, { "battlefield_has": ["Hill Giant"] } ] } },
  { "name": "two of your creatures each get +1/+0 and deal damage equal to their power to another creature",
