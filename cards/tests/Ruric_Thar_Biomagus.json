[
  {
    "name": "opponent's Lightning Bolt targets it: its controller draws a card",
    "players": [ { "battlefield": ["Ruric Thar, Biomagus"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain"] } ],
    "steps": [ { "pass": true }, { "cast": "Lightning Bolt", "player": 1, "targets": ["Ruric Thar, Biomagus"] }, { "resolve": true }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Ruric Thar, Biomagus"], "hand_count": 1 }, { "graveyard": ["Lightning Bolt"] } ] }
  },
  {
    "name": "its own controller targeting it does not draw",
    "players": [ { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Ruric Thar, Biomagus"] }, {} ],
    "steps": [ { "cast": "Lightning Bolt", "targets": ["Ruric Thar, Biomagus"] }, { "resolve": true } ],
    "expect": { "players": [ { "graveyard": ["Lightning Bolt"], "hand_count": 0 }, {} ] }
  }
]
