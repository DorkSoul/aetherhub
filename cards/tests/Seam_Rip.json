[
  {
    "name": "exiles an opposing nonland permanent with mana value 2 or less",
    "players": [
      { "hand": ["Seam Rip"], "battlefield": ["Plains"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Seam Rip" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "exile": ["Grizzly Bears"], "battlefield": [] }] }
  },
  {
    "name": "mana value 3 or more is not a legal choice: nothing is exiled",
    "players": [
      { "hand": ["Seam Rip"], "battlefield": ["Plains"] },
      { "battlefield": ["Serra Angel"] }
    ],
    "steps": [
      { "cast": "Seam Rip" },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "battlefield": ["Serra Angel"] }] }
  },
  {
    "name": "ruling: Seam Rip destroyed in response to its trigger: the Grizzly Bears is not exiled",
    "players": [
      { "hand": ["Seam Rip", "Naturalize"], "battlefield": ["Plains", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Seam Rip" },
      { "pass": true },
      { "pass": true, "player": 1 },
      { "cast": "Naturalize", "targets": ["Seam Rip"] },
      { "resolve": true },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "battlefield_has": ["Grizzly Bears"], "exile": [] }] }
  },
  {
    "name": "ruling: when Seam Rip leaves, the exiled Grizzly Bears returns to the battlefield",
    "players": [
      { "hand": ["Seam Rip", "Naturalize"], "battlefield": ["Plains", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Seam Rip" },
      { "resolve": true },
      { "resolve": true },
      { "cast": "Naturalize", "targets": ["Seam Rip"] },
      { "resolve": true }
    ],
    "expect": { "players": [{}, { "battlefield_has": ["Grizzly Bears"], "exile": [] }] }
  }
]
