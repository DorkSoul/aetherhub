[
  { "name": "destroys the target flyer and damages each opposing flyer",
    "players": [ { "hand": ["Sagittars' Volley"], "battlefield": ["Forest", "Forest", "Forest", "Sage Aven"] }, { "battlefield": ["Sage of the Skies", "Sage Owl"] } ],
    "steps": [ { "cast": "Sagittars' Volley", "targets": ["Sage of the Skies"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sage Aven"], "graveyard": ["Sagittars' Volley"] }, { "graveyard": ["Sage of the Skies", "Sage Owl"] } ] } },
  { "name": "your own flyers are not damaged",
    "players": [ { "hand": ["Sagittars' Volley"], "battlefield": ["Forest", "Forest", "Forest", "Sage Owl"] }, { "battlefield": ["Sage of the Skies"] } ],
    "steps": [ { "cast": "Sagittars' Volley", "targets": ["Sage of the Skies"] }, { "resolve": true } ],
    "expect": { "players": [ { "battlefield_has": ["Sage Owl"] }, { "graveyard": ["Sage of the Skies"] } ] } },
  { "name": "needs a creature with flying to target",
    "players": [ { "hand": ["Sagittars' Volley"], "battlefield": ["Forest", "Forest", "Forest"] }, { "battlefield": ["Grizzly Bears"] } ],
    "steps": [ { "cast": "Sagittars' Volley", "illegal": true } ],
    "expect": { "players": [ { "hand": ["Sagittars' Volley"] }, { "battlefield_has": ["Grizzly Bears"] } ] } },
  { "name": "ruling: if the target is gone when the spell resolves, it does not resolve and no flyer is damaged",
    "players": [ { "hand": ["Sagittars' Volley"], "battlefield": ["Forest", "Forest", "Forest"] }, { "hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Sage of the Skies", "Sage Owl"] } ],
    "steps": [ { "cast": "Sagittars' Volley", "targets": ["Sage of the Skies"] }, { "pass": true, "player": 0 }, { "player": 1, "cast": "Lightning Bolt", "targets": ["Sage of the Skies"] }, { "pass": true, "player": 1 }, { "pass": true, "player": 0 }, { "pass": true, "player": 0 }, { "pass": true, "player": 1 } ],
    "expect": { "players": [ { "graveyard": ["Sagittars' Volley"] }, { "graveyard": ["Lightning Bolt", "Sage of the Skies"], "battlefield_has": ["Sage Owl"] } ] } }
]
