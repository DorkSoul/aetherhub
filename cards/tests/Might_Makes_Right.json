[
  {
    "name": "steals the opposing creature at the beginning of combat when you have the greatest power",
    "players": [
      { "hand": ["Might Makes Right"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Might Makes Right" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Might Makes Right", "Llanowar Elves"] }, { "battlefield": [] }] }
  },
  {
    "name": "no trigger when an opponent controls a creature with greatest power",
    "players": [
      { "hand": ["Might Makes Right"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [
      { "cast": "Might Makes Right" },
      { "resolve": true },
      { "advance_to": "BeginCombat" }
    ],
    "expect": { "players": [{ "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Might Makes Right"] }, { "battlefield": ["Hill Giant"] }] }
  },
  {
    "name": "ruling: a tie for greatest power on the opponent's side means no trigger",
    "players": [
      { "hand": ["Might Makes Right"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [
      { "cast": "Might Makes Right" },
      { "resolve": true },
      { "advance_to": "BeginCombat" }
    ],
    "expect": { "players": [{ "battlefield_has": ["Might Makes Right"], "battlefield_lacks": ["Llanowar Elves"] }, { "battlefield_has": ["Grizzly Bears"] }] }
  },
  {
    "name": "ruling: several of your creatures tied for greatest power still count as the greatest",
    "players": [
      { "hand": ["Might Makes Right"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears", "Grizzly Bears"] },
      { "battlefield": ["Llanowar Elves"] }
    ],
    "steps": [
      { "cast": "Might Makes Right" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Llanowar Elves", "Grizzly Bears", "Might Makes Right"] }, { "battlefield_lacks": ["Llanowar Elves"] }] }
  },
  {
    "name": "ruling: a tapped opposing creature can be taken and is untapped",
    "players": [
      { "hand": ["Might Makes Right"], "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Mountain", "Grizzly Bears"] },
      { "battlefield": [{ "name": "Llanowar Elves", "tapped": true }] }
    ],
    "steps": [
      { "cast": "Might Makes Right" },
      { "resolve": true },
      { "advance_to": "BeginCombat" },
      { "resolve": true }
    ],
    "expect": { "players": [{ "battlefield_has": ["Llanowar Elves"] }, { "battlefield_lacks": ["Llanowar Elves"] }], "tapped": { "Llanowar Elves": false } }
  }
]
