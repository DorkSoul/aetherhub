[
  {
    "name": "attacking with a God gives an experience counter; the end step puts that many +1/+1 counters on target creature",
    "players": [
      { "battlefield": ["Kratos, Stoic Father", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Kratos, Stoic Father", "at": "p1" } ] },
      { "advance_to": "End", "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "counters": { "Grizzly Bears": { "+1/+1": 1 } },
      "pt": { "Grizzly Bears": [3, 3], "Kratos, Stoic Father": [4, 4] }
    }
  },
  {
    "name": "attacking without a God gives no experience counter",
    "players": [
      { "battlefield": ["Kratos, Stoic Father", "Grizzly Bears"] },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "advance_to": "End", "targets": ["Kratos, Stoic Father"] }
    ],
    "expect": {
      "pt": { "Kratos, Stoic Father": [4, 4], "Grizzly Bears": [2, 2] }
    }
  },
  {
    "name": "a God dying gives an experience counter",
    "players": [
      {
        "hand": ["Doom Blade"],
        "battlefield": ["Kratos, Stoic Father", "Atreus, Impulsive Son", "Grizzly Bears", "Swamp", "Swamp"]
      },
      {}
    ],
    "steps": [
      { "cast": "Doom Blade", "targets": ["Atreus, Impulsive Son"] },
      { "resolve": true },
      { "advance_to": "End", "targets": ["Grizzly Bears"] }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Atreus, Impulsive Son"] }, {} ],
      "counters": { "Grizzly Bears": { "+1/+1": 1 } }
    }
  },
  {
    "name": "a creature that is not a God dying gives no experience counter",
    "players": [
      {
        "hand": ["Doom Blade"],
        "battlefield": ["Kratos, Stoic Father", "Grizzly Bears", "Swamp", "Swamp"]
      },
      {}
    ],
    "steps": [
      { "cast": "Doom Blade", "targets": ["Grizzly Bears"] },
      { "resolve": true },
      { "advance_to": "End", "targets": ["Kratos, Stoic Father"] }
    ],
    "expect": {
      "players": [ { "graveyard_has": ["Grizzly Bears"] }, {} ],
      "pt": { "Kratos, Stoic Father": [4, 4] }
    }
  }
