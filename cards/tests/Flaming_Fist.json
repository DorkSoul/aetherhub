[
  {
    "name": "commander creature you own gains double strike when it attacks",
    "commander": true,
    "players": [
      {
        "command": ["Raging Goblin"],
        "battlefield": ["Flaming Fist", "Mountain"]
      },
      {}
    ],
    "steps": [
      { "cast": "Raging Goblin" },
      { "resolve": true },
      { "attack": [ { "card": "Raging Goblin", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "a non-commander attacker does not gain double strike",
    "commander": true,
    "players": [
      {
        "battlefield": ["Flaming Fist", { "name": "Grizzly Bears", "sick": false }]
      },
      {}
    ],
    "steps": [
      { "attack": [ { "card": "Grizzly Bears", "at": "p1" } ] },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 18 } ]
    }
  },
  {
    "name": "ruling: with two commander creatures you own, each of them gains double strike when it attacks",
    "commander": true,
    "players": [
      {
        "command": ["Raging Goblin", "Grizzly Bears"],
        "battlefield": ["Flaming Fist", "Mountain", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Raging Goblin" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "advance_to": "End" },
      { "advance_to": "Main1" },
      { "attack": [ { "card": "Raging Goblin", "at": "p1" }, { "card": "Grizzly Bears", "at": "p1" } ] },
      { "resolve": true },
      { "block": [] },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ {}, { "life": 14 } ]
    }
  },
  {
    "name": "ruling: the commander tax of one commander is not charged when casting the other commander for the first time",
    "commander": true,
    "players": [
      {
        "command": ["Raging Goblin", "Grizzly Bears"],
        "battlefield": ["Flaming Fist", "Mountain", "Forest", "Forest"]
      },
      {}
    ],
    "steps": [
      { "cast": "Raging Goblin" },
      { "resolve": true },
      { "cast": "Grizzly Bears" },
      { "resolve": true }
    ],
    "expect": {
      "players": [ { "battlefield_has": ["Raging Goblin", "Grizzly Bears"] }, {} ]
    }
  }
]
