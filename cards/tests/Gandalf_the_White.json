  {
    "name": "ruling: an opponent's legendary creature entering makes my Soul Warden trigger twice (+2 life); I need not control it",
    "players": [
      { "battlefield": ["Gandalf the White", "Soul Warden"] },
      { "hand": ["Pashalik Mons"], "battlefield": ["Mountain", "Mountain", "Mountain"] }
    ],
    "steps": [
      { "advance_to": "Main2" },
      { "advance_to": "Main1" },
      { "cast": "Pashalik Mons", "player": 1 },
      { "resolve": true }
    ],
    "expect": {
      "players": [
        { "life": 22, "battlefield_has": ["Gandalf the White", "Soul Warden"] },
        { "battlefield_has": ["Pashalik Mons"] }
      ]
    }
  },
