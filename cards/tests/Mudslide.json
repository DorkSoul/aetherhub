[
  {
    "name": "tapped creature without flying does not untap in its controller untap step",
    "players": [
      { "battlefield": ["Mudslide", { "name": "Grizzly Bears", "tapped": true }, "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Untap", "auto": true }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "upkeep: choosing tapped creatures and paying {2} each untaps them",
    "players": [
      { "battlefield": ["Mudslide", { "name": "Grizzly Bears", "tapped": true }, { "name": "Hill Giant", "tapped": true }, "Mountain", "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[0, 1], true] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": false, "Hill Giant": false }
    }
  },
  {
    "name": "upkeep: choosing a creature but not paying leaves it tapped",
    "players": [
      { "battlefield": ["Mudslide", { "name": "Grizzly Bears", "tapped": true }, "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[0], false] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "upkeep: declining to choose leaves creatures tapped",
    "players": [
      { "battlefield": ["Mudslide", { "name": "Grizzly Bears", "tapped": true }, "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[], false] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true }
    }
  },
  {
    "name": "ruling: choosing two tapped creatures but only enough mana for one: none are paid for, none untap",
    "players": [
      { "battlefield": ["Mudslide", { "name": "Grizzly Bears", "tapped": true }, { "name": "Hill Giant", "tapped": true }, "Mountain", "Mountain", "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Upkeep" },
      { "advance_to": "Upkeep", "answers": [[0, 1], true] }
    ],
    "expect": {
      "tapped": { "Grizzly Bears": true, "Hill Giant": true }
    }
  },
  {
    "name": "tapped creature with flying untaps normally",
    "players": [
      { "battlefield": ["Mudslide", { "name": "Serra Angel", "tapped": true }, "Mountain"] },
      {}
    ],
    "steps": [
      { "advance_to": "Untap", "auto": true }
    ],
    "expect": {
      "tapped": { "Serra Angel": false }
    }
  }
]
