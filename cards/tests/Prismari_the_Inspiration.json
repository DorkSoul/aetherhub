[
 {"name": "the first instant you cast gets no storm copies",
  "players": [{"hand": ["Lightning Bolt"], "battlefield": ["Mountain", "Prismari, the Inspiration", "Swamp", "Swamp", "Swamp", "Swamp", "Island", "Island"]}, {}],
  "steps": [{"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"resolve": true}],
  "expect": {"players": [{}, {"life": 17}]}},
 {"name": "the second spell copies once for each spell cast before it this turn",
  "players": [{"hand": ["Shock", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Prismari, the Inspiration", "Swamp", "Swamp", "Swamp", "Swamp", "Island", "Island"]}, {}],
  "steps": [{"cast": "Shock", "targets": ["p1"]}, {"resolve": true}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"resolve": true}, {"resolve": true}],
  "expect": {"players": [{}, {"life": 12}]}},
 {"name": "ward: the opponent pays 5 life, so Murder destroys Prismari",
  "players": [{"battlefield": ["Prismari, the Inspiration"]}, {"hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"]}],
  "steps": [{"pass": true}, {"cast": "Murder", "player": 1, "targets": ["Prismari, the Inspiration"]}, {"resolve": true, "auto": true}],
  "expect": {"players": [{"graveyard_has": ["Prismari, the Inspiration"]}, {"graveyard_has": ["Murder"], "life": 15}]}},
 {"name": "ward: the opponent at 4 life cannot pay 5 life, so Murder is countered and Prismari survives",
  "players": [{"battlefield": ["Prismari, the Inspiration"]}, {"hand": ["Murder"], "battlefield": ["Swamp", "Swamp", "Swamp"], "life": 4}],
  "steps": [{"pass": true}, {"cast": "Murder", "player": 1, "targets": ["Prismari, the Inspiration"]}, {"resolve": true, "auto": true}],
  "expect": {"players": [{"battlefield_has": ["Prismari, the Inspiration"]}, {"graveyard_has": ["Murder"], "life": 4}]}},
 {"name": "ruling: a spell with its own storm and Prismari's storm gets a copy from each instance",
  "players": [{"hand": ["Shock", "Tendrils of Agony"], "battlefield": ["Mountain", "Swamp", "Swamp", "Island", "Island", "Prismari, the Inspiration"]}, {}],
  "steps": [{"cast": "Shock", "targets": ["p1"]}, {"resolve": true}, {"cast": "Tendrils of Agony", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{"life": 26}, {"life": 12}]}},
 {"name": "ruling: a storm copy can be countered on its own, and the other copy and the original still resolve",
  "players": [{"hand": ["Shock", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Prismari, the Inspiration"]}, {"hand": ["Counterspell"], "battlefield": ["Island", "Island"]}],
  "steps": [{"cast": "Shock", "targets": ["p1"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"pass": true}, {"pass": true, "player": 1}, {"pass": true}, {"cast": "Counterspell", "player": 1, "targets": [{"stack": "Lightning Bolt"}]}, {"resolve": true}],
  "expect": {"players": [{}, {"life": 15, "graveyard_has": ["Counterspell"]}]}},
 {"name": "ruling: a countered spell still counts for storm",
  "players": [{"hand": ["Shock", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Prismari, the Inspiration"]}, {"hand": ["Counterspell"], "battlefield": ["Island", "Island"]}],
  "steps": [{"cast": "Shock", "targets": ["p1"]}, {"pass": true}, {"cast": "Counterspell", "player": 1, "targets": [{"stack": "Shock"}]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{}, {"life": 11}]}},
 {"name": "ruling: storm copies are not cast, so they do not count for later storm spells",
  "players": [{"hand": ["Shock", "Lightning Bolt", "Lightning Bolt"], "battlefield": ["Mountain", "Mountain", "Mountain", "Prismari, the Inspiration"]}, {}],
  "steps": [{"cast": "Shock", "targets": ["p1"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}, {"cast": "Lightning Bolt", "targets": ["p1"]}, {"resolve": true}],
  "expect": {"players": [{}, {"life": 3}]}}
]
