[
 {
  "name": "target creature becomes a 4/4 until end of turn",
  "players": [
   { "hand": ["Startling Development"], "battlefield": ["Island", "Island", "Grizzly Bears"] },
   {}
  ],
  "steps": [
   { "cast": "Startling Development", "targets": ["Grizzly Bears"] },
   { "resolve": true }
  ],
  "expect": {
   "pt": { "Grizzly Bears": [4, 4] }
  }
 },
 {
  "name": "no creature to target: cannot cast",
  "players": [
   { "hand": ["Startling Development"], "battlefield": ["Island", "Island"] },
   {}
  ],
  "steps": [
   { "cast": "Startling Development", "illegal": true }
  ],
  "expect": {}
 },
 {
  "name": "cycling {1}: discard to draw a card",
  "players": [
   { "hand": ["Startling Development"], "battlefield": ["Island"] },
   {}
  ],
  "steps": [
   { "activate": "Startling Development" },
   { "resolve": true }
  ],
  "expect": {
   "players": [ { "hand_count": 1, "graveyard_has": ["Startling Development"] }, {} ]
  }
 },
 {
  "name": "ruling: earlier +2/+2 landfall pump still applies after becoming a 4/4",
  "players": [ { "hand": ["Island", "Startling Development"], "battlefield": ["Island", "Island", "Steppe Lynx"] }, {} ],
  "steps": [
    { "play_land": "Island" },
    { "resolve": true },
    { "cast": "Startling Development", "targets": ["Steppe Lynx"] },
    { "resolve": true }
  ],
  "expect": { "pt": { "Steppe Lynx": [6, 6] } }
 },
 {
  "name": "ruling: creature keeps its landfall ability after becoming a Serpent",
  "players": [ { "hand": ["Island", "Startling Development"], "battlefield": ["Island", "Island", "Steppe Lynx"] }, {} ],
  "steps": [
    { "cast": "Startling Development", "targets": ["Steppe Lynx"] },
    { "resolve": true },
    { "play_land": "Island" },
    { "resolve": true }
  ],
  "expect": { "pt": { "Steppe Lynx": [6, 6] } }
 }
]
