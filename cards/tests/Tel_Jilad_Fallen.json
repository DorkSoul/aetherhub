[
  {
    "name": "infect damage kills Juggernaut; artifact damage to Fallen is prevented",
    "players": [
      { "battlefield": ["Juggernaut"] },
      { "battlefield": ["Tel-Jilad Fallen"] }
    ],
    "steps": [
      { "attack": [ { "card": "Juggernaut", "at": "p1" } ] },
      { "block": [ { "blocker": "Tel-Jilad Fallen", "attacker": "Juggernaut" } ] },
      { "pass": true },
      { "advance_to": "Main2" }
    ],
    "expect": {
      "players": [ { "graveyard": ["Juggernaut"] }, { "battlefield_has": ["Tel-Jilad Fallen"] } ]
    }
  },
  {
    "name": "ruling: artifact creatures cannot block a creature with protection from artifacts",
    "players": [
      { "battlefield": ["Tel-Jilad Fallen"] },
      { "battlefield": ["Ornithopter"] }
    ],
    "steps": [
      { "attack": [ { "card": "Tel-Jilad Fallen", "at": "p1" } ] },
      { "block": [ { "blocker": "Ornithopter", "attacker": "Tel-Jilad Fallen" } ], "player": 1, "illegal": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ {}, { "battlefield_has": ["Ornithopter"] } ] }
  },
  {
    "name": "ruling: prevented infect damage puts no -1/-1 counters on the creature it would hit",
    "players": [
      { "battlefield": ["Tel-Jilad Fallen"] },
      { "hand": ["Fog"], "battlefield": ["Forest", "Grizzly Bears"] }
    ],
    "steps": [
      { "attack": [ { "card": "Tel-Jilad Fallen", "at": "p1" } ] },
      { "block": [ { "blocker": "Grizzly Bears", "attacker": "Tel-Jilad Fallen" } ], "player": 1 },
      { "pass": true },
      { "cast": "Fog", "player": 1 },
      { "pass": true, "player": 1 },
      { "resolve": true },
      { "advance_to": "Main2" }
    ],
    "expect": { "players": [ { "battlefield_has": ["Tel-Jilad Fallen"] }, { "battlefield_has": ["Grizzly Bears"], "graveyard": ["Fog"] } ], "pt": { "Grizzly Bears": [2, 2] } }
  }
]
