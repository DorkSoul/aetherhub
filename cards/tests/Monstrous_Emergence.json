[
  {
    "name": "chosen creature's power is the damage",
    "players": [
      { "hand": ["Monstrous Emergence"], "battlefield": ["Hill Giant", "Forest", "Forest"] },
      { "battlefield": ["Grizzly Bears"] }
    ],
    "steps": [{ "cast": "Monstrous Emergence", "targets": ["Grizzly Bears"] }, { "resolve": true }],
    "expect": { "players": [{}, { "graveyard": ["Grizzly Bears"] }] }
  },
  {
    "name": "revealing a creature card from hand uses its power",
    "players": [
      { "hand": ["Monstrous Emergence", "Air Elemental"], "battlefield": ["Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Monstrous Emergence", "targets": ["Hill Giant"] }, { "resolve": true }],
    "expect": { "players": [{ "hand": ["Air Elemental"] }, { "graveyard": ["Hill Giant"] }] }
  },
  {
    "name": "cannot be cast with no creature to choose or reveal",
    "players": [
      { "hand": ["Monstrous Emergence"], "battlefield": ["Forest", "Forest"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Monstrous Emergence", "targets": ["Hill Giant"], "illegal": true }],
    "expect": { "players": [{}, {}] }
  },
  {
    "name": "ruling: damage uses the chosen creature's last known power if it left before resolution",
    "players": [
      { "hand": ["Monstrous Emergence", "Doom Blade"], "battlefield": ["Air Elemental", "Forest", "Forest", "Swamp", "Swamp"] },
      { "battlefield": ["Hill Giant"] }
    ],
    "steps": [{ "cast": "Monstrous Emergence", "targets": ["Hill Giant"] }, { "cast": "Doom Blade", "targets": ["Air Elemental"] }, { "resolve": true }],
    "expect": { "players": [{ "graveyard": ["Monstrous Emergence", "Doom Blade", "Air Elemental"] }, { "graveyard": ["Hill Giant"] }] }
  }
]
