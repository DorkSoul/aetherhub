{
  "name": "Vizier of the Anointed",
  "mana_cost": "{3}{U}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "power": 2,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": {
            "types": ["Creature"],
            "any_of": [
              { "has_keyword_word": "embalm" },
              { "has_keyword_word": "eternalize" }
            ]
          },
          "to": "Graveyard",
          "shuffle": true
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": {
        "type": "AbilityActivated",
        "by": "You",
        "filter": {
          "any_of": [
            { "has_keyword_word": "embalm" },
            { "has_keyword_word": "eternalize" }
          ]
        }
      },
      "effects": [
        {
          "type": "Draw",
          "who": { "type": "You" },
          "n": { "type": "Fixed", "n": 1 }
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you may search your library for a creature card with eternalize or embalm, put that card into your graveyard, then shuffle.\nWhenever you activate an eternalize or embalm ability, draw a card."
