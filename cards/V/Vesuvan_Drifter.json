{
  "name": "Vesuvan Drifter",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "subtypes": ["Shapeshifter"],
  "power": 2,
  "toughness": 4,
  "keywords": ["Flying"],
  "abilities": [
    { "type": "Static", "effect": { "type": "TopCardVisible" } },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "BeginCombat" },
      "optional": true,
      "effects": [
        { "type": "RevealTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": {
            "type": "SelIs",
            "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 },
            "filter": { "types": ["Creature"] }
          },
          "then": [
            {
              "type": "BecomeCopy",
              "what": { "type": "This" },
              "of": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 },
              "duration": "UntilEndOfTurn",
              "except": [ { "type": "AddKeyword", "keyword": "Flying" } ]
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Flying\nYou may look at the top card of your library any time.\nAt the beginning of each combat, you may reveal the top card of your library. If you reveal a creature card this way, this creature becomes a copy of that card until end of turn, except it has flying."
}
