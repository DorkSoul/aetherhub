{
  "name": "Varchild, Betrayer of Kjeldor",
  "mana_cost": "{2}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Knight"],
  "colors": ["R"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "CombatDamageToPlayer", "filter": { "this": true } },
      "effects": [
        { "type": "CreateToken", "token": "Survivor 1-1 Red", "n": { "type": "EventAmount" }, "controller": { "type": "TriggerPlayer" } }
      ]
    },
    {
      "type": "Static",
      "effect": { "type": "CantBlock", "affects": { "subtypes": ["Survivor"], "controller": "Opponent" } }
    },
    {
      "type": "Static",
      "effect": { "type": "CantAttackController", "affects": { "subtypes": ["Survivor"], "controller": "Opponent" } }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "LeavesBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "GainControl", "what": { "type": "All", "filter": { "subtypes": ["Survivor"] } }, "duration": "Forever" }
      ]
    }
  ],
  "oracle_text": "Whenever Varchild deals combat damage to a player, that player creates that many 1/1 red Survivor creature tokens.\nSurvivors your opponents control can't block, and they can't attack you or planeswalkers you control.\nWhen Varchild leaves the battlefield, gain control of all Survivors."
}
