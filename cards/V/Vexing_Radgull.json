{
  "name": "Vexing Radgull",
  "mana_cost": "{1}{U}",
  "types": ["Creature"],
  "subtypes": ["Bird", "Mutant"],
  "power": 1,
  "toughness": 2,
  "keywords": ["Flying"],
  "abilities": [
    { "type": "Triggered",
      "trigger": { "type": "CombatDamageToPlayer", "filter": { "this": true } },
      "effects": [
        { "type": "If",
          "cond": { "type": "Compare",
                    "a": { "type": "PlayerCounters", "kind": "Rad", "who": { "type": "TriggerPlayer" } },
                    "cmp": { "op": "Eq", "n": 0 } },
          "then": [ { "type": "AddCounters", "what": { "type": "TriggerPlayer" }, "kind": "Rad", "n": { "type": "Fixed", "n": 2 } } ],
          "else": [ { "type": "Proliferate" } ] }
      ] }
  ],
  "oracle_text": "Flying\nWhenever this creature deals combat damage to a player, that player gets two rad counters if they don't have any rad counters. Otherwise, proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"
}
