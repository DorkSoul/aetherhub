{
  "name": "Violent Echoes",
  "mana_cost": "{2}{R}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature", "Planeswalker"] } },
          "label": "target creature or planeswalker"
        }
      ],
      "effects": [
        {
          "type": "DealDamage",
          "to": { "type": "Target", "idx": 0 },
          "amount": { "type": "Fixed", "n": 6 }
        },
        {
          "type": "If",
          "cond": {
            "type": "CompareAmounts",
            "a": { "type": "LastExcessDamage" },
            "b": { "type": "Fixed", "n": 0 },
            "op": "Gt"
          },
          "then": [
            {
              "type": "If",
              "cond": {
                "type": "Compare",
                "a": {
                  "type": "Count",
                  "filter": { "name": "Jace", "token": true, "controller": "You" }
                },
                "cmp": { "op": "Eq", "n": 0 }
              },
              "then": [
                { "type": "CreateToken", "token": "Jace", "n": { "type": "Fixed", "n": 1 } }
              ]
            },
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Battlefield",
              "filter": { "name": "Jace", "token": true, "controller": "You" },
              "min": 1,
              "max": 1,
              "then": [
                {
                  "type": "AddCounters",
                  "what": { "type": "Remembered" },
                  "kind": "Loyalty",
                  "n": { "type": "LastExcessDamage" }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Violent Echoes deals 6 damage to target creature or planeswalker. If excess damage was dealt to that permanent this way, empower Jace X, where X is that excess damage. (Put that many loyalty counters on a Jace token you control. If you don't control one, first create a blue Jace planeswalker token with \"[−1]: Surveil 1\" and \"[−3]: Draw a card.\")"
}
