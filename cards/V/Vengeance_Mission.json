{
  "name": "Vengeance Mission",
  "mana_cost": "{2}{B}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "Dies",
        "filter": { "types": ["Creature"] }
      },
      "targets": [
        {
          "what": { "type": "Player", "filter": "Opponent" },
          "label": "target opponent"
        }
      ],
      "effects": [
        {
          "type": "AddCounters",
          "what": { "type": "This" },
          "kind": "Quest",
          "n": { "type": "Fixed", "n": 1 }
        },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "CountersOn", "kind": "Quest", "of": { "type": "This" } },
            "cmp": { "op": "Ge", "n": 7 }
          },
          "then": [
            { "type": "LoseLife", "who": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 2 } }
          ],
          "else": [
            { "type": "LoseLife", "who": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever a creature dies, put a quest counter on this enchantment. Target opponent loses 1 life. That player loses 2 life instead if there are seven or more quest counters on this enchantment."
}
