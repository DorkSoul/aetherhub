{
  "name": "Voice of Many",
  "mana_cost": "{2}{G}{G}",
  "types": ["Creature"],
  "subtypes": ["Elf", "Druid"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "EachOpponent" },
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "CompareAmounts",
                "a": { "type": "Count", "filter": { "types": ["Creature"] }, "zone": "Battlefield", "player": { "type": "EachObject" } },
                "b": { "type": "Count", "filter": { "types": ["Creature"] }, "zone": "Battlefield", "player": { "type": "You" } },
                "op": "Lt"
              },
              "then": [ { "type": "Draw", "who": { "type": "You" } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, draw a card for each opponent who controls fewer creatures than you."
}
