{
  "name": "Vindictive Triumph",
  "mana_cost": "{W}{B}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature", "Planeswalker"] } },
          "label": "target creature or planeswalker"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "ManaValueOf", "of": { "type": "Remembered" } },
            "cmp": { "op": "Le", "n": 3 }
          },
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "tapped": true, "under_your_control": true, "remember": true },
            { "type": "Delayed", "at": "NextEndStep", "effects": [{ "type": "Exile", "what": { "type": "Remembered" } }] }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile target creature or planeswalker. If that permanent's mana value was 3 or less, return it to the battlefield tapped under your control. Exile it at the beginning of the next end step."
}
