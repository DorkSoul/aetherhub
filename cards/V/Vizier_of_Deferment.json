{
  "name": "Vizier of Deferment",
  "mana_cost": "{2}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "power": 2,
  "toughness": 2,
  "keywords": ["Flash"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": {
              "types": ["Creature"],
              "any_of": [{ "attacked_this_turn": true }, { "blocked_this_turn": true }]
            }
          },
          "label": "target creature that attacked or blocked this turn"
        }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "Delayed",
          "at": "NextEndStep",
          "effects": [{ "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" }]
        }
      ]
    }
  ],
  "oracle_text": "Flash\nWhen this creature enters, you may exile target creature if it attacked or blocked this turn. Return that card to the battlefield under its owner's control at the beginning of the next end step."
}
