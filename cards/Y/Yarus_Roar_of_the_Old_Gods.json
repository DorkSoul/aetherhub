{
  "name": "Yarus, Roar of the Old Gods",
  "mana_cost": "{2}{R}{G}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Centaur", "Druid"],
  "colors": ["R", "G"],
  "power": 4,
  "toughness": 4,
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "GrantKeyword",
        "affects": { "types": ["Creature"], "controller": "You", "other": true },
        "keyword": "Haste"
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "CombatDamageToPlayer", "batched": true, "filter": { "face_down": true, "controller": "You" } },
      "effects": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "face_down": true, "controller": "You" } },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "TriggerSource" }, "filter": { "not_types": ["Instant", "Sorcery"] } },
          "then": [
            { "type": "Move", "what": { "type": "TriggerSource" }, "from": "Graveyard", "to": "Battlefield", "face_down": true, "remember": true },
            { "type": "TurnFaceUp", "what": { "type": "Remembered" } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Other creatures you control have haste.\nWhenever one or more face-down creatures you control deal combat damage to a player, draw a card.\nWhenever a face-down creature you control dies, return it to the battlefield face down under its owner's control if it's a permanent card, then turn it face up."
}
