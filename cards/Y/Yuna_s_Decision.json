              "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Creature"], "controller": "You" }, "at_least": 1 },
              "then": [
                { "type": "Sacrifice", "who": { "type": "You" }, "filter": { "types": ["Creature"] }, "n": { "type": "Fixed", "n": 1 } },
                { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
                {
                  "type": "May",
                  "effects": [
                    { "type": "Choose", "who": { "type": "You" }, "zone": "Hand", "filter": { "types": ["Creature"] }, "min": 1, "max": 1, "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ] }
                  ]
                },
                {
                  "type": "May",
                  "effects": [
                    { "type": "Choose", "who": { "type": "You" }, "zone": "Hand", "filter": { "types": ["Land"] }, "min": 1, "max": 1, "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ] }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Find Another Way — Return one or two target permanent cards from your graveyard to your hand.",
          "targets": [ { "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "not_types": ["Instant", "Sorcery"] }, "whose": "You" }, "min": 1, "max": 2, "label": "one or two permanent cards in your graveyard" } ],
          "effects": [ { "type": "Move", "what": { "type": "Targets" }, "to": "Hand" } ]
        }
      ]
