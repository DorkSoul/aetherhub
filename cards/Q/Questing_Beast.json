{
  "name": "Questing Beast",
  "mana_cost": "{2}{G}{G}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Beast"],
  "power": 4,
  "toughness": 4,
  "keywords": ["Vigilance", "Deathtouch", "Haste"],
  "abilities": [
    {
      "type": "Static",
      "effect": {
        "type": "CantBeBlockedBy",
        "affects": { "this": true },
        "by": { "types": ["Creature"], "power": { "op": "Le", "n": 2 } }
      }
    },
    {
      "type": "Static",
      "effect": {
        "type": "SourceDamageCantBePrevented",
        "filter": { "types": ["Creature"], "controller": "You" },
        "combat_only": true
      }
    },
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Planeswalker"], "controlled_by": { "type": "TriggerPlayer" } } }, "label": "target planeswalker that player controls" }
      ],
      "effects": [
        { "type": "DealDamage", "to": { "type": "Target", "idx": 0 }, "amount": { "type": "EventAmount" } }
      ]
    }
  ],
  "oracle_text": "Vigilance, deathtouch, haste\nQuesting Beast can't be blocked by creatures with power 2 or less.\nCombat damage that would be dealt by creatures you control can't be prevented.\nWhenever Questing Beast deals combat damage to an opponent, it deals that much damage to target planeswalker that player controls."
}
