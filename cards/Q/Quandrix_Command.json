{
  "name": "Quandrix Command",
  "mana_cost": "{1}{G}{U}",
  "types": ["Instant"],
  "colors": ["G", "U"],
  "abilities": [
    {
      "type": "Modal",
      "choose_min": 2,
      "choose_max": 2,
      "modes": [
        {
          "text": "Return target creature or planeswalker to its owner's hand.",
          "targets": [{ "what": { "type": "Permanent", "filter": { "any_of": [{ "types": ["Creature"] }, { "types": ["Planeswalker"] }] } }, "label": "target creature or planeswalker" }],
          "effects": [{ "type": "Bounce", "what": { "type": "Target", "idx": 0 } }]
        },
        {
          "text": "Counter target artifact or enchantment spell.",
          "targets": [{ "what": { "type": "Spell", "filter": { "any_of": [{ "types": ["Artifact"] }, { "types": ["Enchantment"] }] } }, "label": "target artifact or enchantment spell" }],
          "effects": [{ "type": "CounterSpell", "what": { "type": "Target", "idx": 0 } }]
        },
        {
          "text": "Put two +1/+1 counters on target creature.",
          "targets": [{ "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }],
          "effects": [{ "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 } }]
        },
        {
          "text": "Target player shuffles up to three target cards from their graveyard into their library.",
          "targets": [
            { "what": { "type": "Player", "filter": "Any" }, "label": "target player" },
            { "what": { "type": "CardIn", "zone": "Graveyard", "filter": {}, "whose": "Any" }, "min": 0, "max": 3, "same_graveyard": true, "label": "up to three target cards from their graveyard" }
          ],
          "effects": [
            { "type": "Move", "what": { "type": "Targets" }, "from": "Graveyard", "to": "Library" },
            { "type": "Shuffle", "who": { "type": "Target", "idx": 0 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose two —\n• Return target creature or planeswalker to its owner's hand.\n• Counter target artifact or enchantment spell.\n• Put two +1/+1 counters on target creature.\n• Target player shuffles up to three target cards from their graveyard into their library."
}
