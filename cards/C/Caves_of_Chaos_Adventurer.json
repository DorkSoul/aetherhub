{
  "name": "Caves of Chaos Adventurer",
  "mana_cost": "{3}{R}",
  "types": ["Creature"],
  "subtypes": ["Human", "Barbarian"],
  "power": 5,
  "toughness": 3,
  "keywords": ["Trample"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "TakeInitiative", "who": { "type": "You" } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        {
          "type": "LookAtTop",
          "who": { "type": "You" },
          "n": { "type": "Fixed", "n": 1 },
          "take": 1,
          "all": true,
          "filter": {},
          "to": "Exile",
          "rest": "Library"
        },
        {
          "type": "If",
          "cond": { "type": "CompletedDungeon", "at_least": 1 },
          "then": [
            { "type": "GrantPlayFromExile", "what": { "type": "Remembered" }, "window": "ThisTurn", "free": true }
          ],
          "else": [
            { "type": "GrantPlayFromExile", "what": { "type": "Remembered" }, "window": "ThisTurn" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Trample\nWhen this creature enters, you take the initiative.\nWhenever this creature attacks, exile the top card of your library. If you've completed a dungeon, you may play that card this turn without paying its mana cost. Otherwise, you may play that card this turn."
}
