{
  "name": "Curse of Echoes",
  "mana_cost": "{4}{U}",
  "types": ["Enchantment"],
  "subtypes": ["Aura", "Curse"],
  "abilities": [
    { "type": "EnchantPlayer" },
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "Enchanted",
        "filter": {
          "any_of": [ { "types": ["Instant"] }, { "types": ["Sorcery"] } ]
        }
      },
      "effects": [
        {
          "type": "ForEachPlayer",
          "players": { "type": "EachOpponentOfTriggerPlayer" },
          "effects": [
            {
              "type": "May",
              "who": { "type": "EachObject" },
              "effects": [
                {
                  "type": "CopySpell",
                  "what": { "type": "TriggerSource" },
                  "new_targets": true,
                  "by": { "type": "EachObject" }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Enchant player\nWhenever enchanted player casts an instant or sorcery spell, each other player may copy that spell and may choose new targets for the copy they control."
}
