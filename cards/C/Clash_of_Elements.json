{
  "name": "Clash of Elements",
  "mana_cost": "{1}{U}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "not_types": ["Land"] } }, "label": "target nonland permanent" }
      ],
      "effects": [
        {
          "type": "May",
          "who": { "type": "OwnerOf", "of": { "type": "Target", "idx": 0 } },
          "effects": [
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library", "top_of_library": true, "position": 0 },
            { "type": "DealDamage", "to": { "type": "OwnerOf", "of": { "type": "Target", "idx": 0 } }, "amount": { "type": "Fixed", "n": 2 } }
          ],
          "otherwise": [
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library", "top_of_library": false }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose target nonland permanent. Its owner may put it on top of their library. If they do, Clash of Elements deals 2 damage to them. If they didn't put the card on top of their library, they put it on the bottom."
}
