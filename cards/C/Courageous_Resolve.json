{
  "name": "Courageous Resolve",
  "mana_cost": "{2}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } },
          "label": "up to one target creature you control",
          "min": 0,
          "max": 1
        }
      ],
      "effects": [
        {
          "type": "GrantProtection",
          "what": { "type": "Target", "idx": 0 },
          "from": { "type": "Opponents" },
          "duration": "UntilEndOfTurn"
        },
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "LifeAtMost", "n": 5, "who": { "type": "You" } },
          "then": [
            { "type": "Restrict", "who": { "type": "You" }, "what": "CantLoseLife", "duration": "UntilEndOfTurn" },
            { "type": "GrantStatic", "what": { "type": "You" }, "effect": { "type": "CantLoseGame", "who": "You" }, "duration": "UntilEndOfTurn" },
            { "type": "GrantStatic", "what": { "type": "You" }, "effect": { "type": "CantWinGame", "who": "Opponent" }, "duration": "UntilEndOfTurn" }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Up to one target creature you control gains protection from each of your opponents until end of turn. Draw a card. (It can't be blocked, targeted, dealt damage, enchanted, or equipped by anything controlled by those players.)\nFateful hour — If you have 5 or less life, you can't lose life this turn, you can't lose the game this turn, and your opponents can't win the game this turn."
}
