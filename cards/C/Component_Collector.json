{
  "name": "Component Collector",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "subtypes": ["Homunculus"],
  "power": 1,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "BecomeDay" } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "DayNightChanged" },
      "optional": true,
      "targets": [
        { "what": { "type": "Permanent", "filter": { "not_types": ["Land"] } }, "label": "target nonland permanent" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "tapped": true } },
          "then": [ { "type": "Untap", "what": { "type": "Target", "idx": 0 } } ],
          "else": [ { "type": "Tap", "what": { "type": "Target", "idx": 0 } } ]
        }
      ]
    }
  ],
  "oracle_text": "If it's neither day nor night, it becomes day as this creature enters.\nWhenever day becomes night or night becomes day, you may tap or untap target nonland permanent."
}
