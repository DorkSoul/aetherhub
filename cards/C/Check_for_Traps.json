{
  "name": "Check for Traps",
  "mana_cost": "{1}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {"type": "Spell",
     "targets": [{"what": {"type": "Player", "filter": "Opponent"}, "label": "target opponent"}],
     "effects": [
       {"type": "Choose", "who": {"type": "You"}, "from": {"type": "Target", "idx": 0}, "zone": "Hand", "filter": {"not_types": ["Land"]}, "min": 1, "max": 1,
        "then": [
          {"type": "Move", "what": {"type": "Remembered"}, "to": "Exile"},
          {"type": "If", "cond": {"type": "RememberedIs", "filter": {"any_of": [{"types": ["Instant"]}, {"keywords": ["Flash"]}]}},
           "then": [{"type": "LoseLife", "who": {"type": "Target", "idx": 0}, "n": {"type": "Fixed", "n": 1}}],
           "else": [{"type": "LoseLife", "who": {"type": "You"}, "n": {"type": "Fixed", "n": 1}}]}
        ]}
     ]}
  ],
  "oracle_text": "Target opponent reveals their hand. You choose a nonland card from it. Exile that card. If an instant card or a card with flash is exiled this way, they lose 1 life. Otherwise, you lose 1 life."
