{
  "name": "Cruel Grimnarch",
  "mana_cost": "{5}{B}",
  "types": ["Creature"],
  "subtypes": ["Phyrexian", "Cleric"],
  "power": 5,
  "toughness": 5,
  "keywords": ["Deathtouch"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "EachOpponent" },
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "Compare",
                "a": { "type": "HandSize", "who": { "type": "EachObject" } },
                "cmp": { "n": 0, "op": "Eq" }
              },
              "then": [
                { "type": "GainLife", "n": { "type": "Fixed", "n": 4 }, "who": { "type": "You" } }
              ],
              "else": []
            },
            {
              "type": "Discard",
              "who": { "type": "EachObject" },
              "n": { "type": "Fixed", "n": 1 }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Deathtouch\nWhen this creature enters, each opponent discards a card. For each opponent who can't, you gain 4 life."
}
