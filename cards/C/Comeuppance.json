{
  "name": "Comeuppance",
  "mana_cost": "{3}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "AddReplacement",
          "what": {
            "type": "Damage",
            "source": { "types": ["Creature"], "controller": "Opponent" },
            "to": "You",
            "prevent": true,
            "then": [ { "type": "DealDamage", "to": { "type": "TriggerSource" }, "amount": { "type": "EventAmount" } } ]
          }
        },
        {
          "type": "AddReplacement",
          "what": {
            "type": "Damage",
            "source": { "not_types": ["Creature"], "controller": "Opponent" },
            "to": "You",
            "prevent": true,
            "then": [ { "type": "DealDamage", "to": { "type": "ControllerOf", "of": { "type": "TriggerSource" } }, "amount": { "type": "EventAmount" } } ]
          }
        },
        {
          "type": "AddReplacement",
          "what": {
            "type": "Damage",
            "source": { "types": ["Creature"], "controller": "Opponent" },
            "to_filter": { "types": ["Planeswalker"], "controller": "You" },
            "prevent": true,
            "then": [ { "type": "DealDamage", "to": { "type": "TriggerSource" }, "amount": { "type": "EventAmount" } } ]
          }
        },
        {
          "type": "AddReplacement",
          "what": {
            "type": "Damage",
            "source": { "not_types": ["Creature"], "controller": "Opponent" },
            "to_filter": { "types": ["Planeswalker"], "controller": "You" },
            "prevent": true,
            "then": [ { "type": "DealDamage", "to": { "type": "ControllerOf", "of": { "type": "TriggerSource" } }, "amount": { "type": "EventAmount" } } ]
          }
        }
      ]
    }
  ],
  "oracle_text": "Prevent all damage that would be dealt to you and planeswalkers you control this turn by sources you don't control. If damage from a creature source is prevented this way, Comeuppance deals that much damage to that creature. If damage from a noncreature source is prevented this way, Comeuppance deals that much damage to the source's controller."
}
