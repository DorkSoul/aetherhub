{
  "name": "Chain Stasis",
  "mana_cost": "{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        {
          "type": "May",
          "who": { "type": "You" },
          "effects": [
            {
              "type": "If",
              "cond": { "type": "TargetIs", "idx": 0, "filter": { "tapped": true } },
              "then": [ { "type": "Untap", "what": { "type": "Target", "idx": 0 } } ],
              "else": [ { "type": "Tap", "what": { "type": "Target", "idx": 0 } } ]
            }
          ]
        },
        {
          "type": "MayPay",
          "payer": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } },
          "cost": [ { "type": "Mana", "cost": "{2}{U}" } ],
          "effects": [
            {
              "type": "May",
              "who": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } },
              "effects": [
                {
                  "type": "CopySpell",
                  "what": { "type": "This" },
                  "new_targets": true,
                  "by": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "You may tap or untap target creature. Then that creature's controller may pay {2}{U}. If the player does, they may copy this spell and may choose a new target for that copy."
}
