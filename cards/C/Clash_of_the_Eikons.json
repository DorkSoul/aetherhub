{
  "name": "Clash of the Eikons",
  "mana_cost": "{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Modal",
      "choose_min": 1,
      "choose_max": 3,
      "allow_repeat": false,
      "modes": [
        {
          "text": "Target creature you control fights target creature an opponent controls.",
          "targets": [
            { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "creature you control" },
            { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } }, "label": "creature an opponent controls" }
          ],
          "effects": [
            { "type": "Fight", "a": { "type": "Target", "idx": 0 }, "b": { "type": "Target", "idx": 1 } }
          ]
        },
        {
          "text": "Remove a lore counter from target Saga you control. (Removing lore counters doesn't cause chapter abilities to trigger.)",
          "targets": [
            { "what": { "type": "Permanent", "filter": { "types": ["Enchantment"], "subtypes": ["Saga"], "controller": "You" } }, "label": "target Saga you control" }
          ],
          "effects": [
            { "type": "RemoveCounters", "kind": "Lore", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Target", "idx": 0 } }
          ]
        },
        {
          "text": "Put a lore counter on target Saga you control.",
          "targets": [
            { "what": { "type": "Permanent", "filter": { "types": ["Enchantment"], "subtypes": ["Saga"], "controller": "You" } }, "label": "target Saga you control" }
          ],
          "effects": [
            { "type": "AddCounters", "kind": "Lore", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Target", "idx": 0 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose one or more —\n• Target creature you control fights target creature an opponent controls.\n• Remove a lore counter from target Saga you control. (Removing lore counters doesn't cause chapter abilities to trigger.)\n• Put a lore counter on target Saga you control."
}
