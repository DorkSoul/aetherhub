{
  "name": "Callous Bloodmage",
  "mana_cost": "{2}{B}",
  "types": ["Creature"],
  "subtypes": ["Vampire", "Warlock"],
  "power": 2,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "modes": [
            {
              "text": "Create a 1/1 black and green Pest creature token with \"When this token dies, you gain 1 life.\"",
              "effects": [
                {
                  "type": "CreateToken",
                  "token": "Pest 1-1",
                  "n": { "type": "Fixed", "n": 1 },
                  "controller": { "type": "You" },
                  "tapped": false,
                  "attacking": false
                }
              ]
            },
            {
              "text": "You draw a card and you lose 1 life.",
              "effects": [
                { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
                { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
              ]
            },
            {
              "text": "Exile target player's graveyard.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [
                    { "what": { "type": "Player", "filter": "Any" }, "label": "target player" }
                  ],
                  "effects": [
                    {
                      "type": "Exile",
                      "what": { "type": "AllOfPlayer", "player": { "type": "Target", "idx": 0 }, "zone": "Graveyard" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, choose one —\n• Create a 1/1 black and green Pest creature token with \"When this token dies, you gain 1 life.\"\n• You draw a card and you lose 1 life.\n• Exile target player's graveyard."
