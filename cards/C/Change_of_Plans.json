{
  "name": "Change of Plans",
  "mana_cost": "{X}{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } },
          "min": 0,
          "max": 1,
          "max_x": true,
          "exact_x": true,
          "label": "X target creatures you control"
        }
      ],
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "Targets" },
          "effects": [
            { "type": "Draw", "who": { "type": "ControllerOf", "of": { "type": "EachObject" } }, "n": { "type": "Fixed", "n": 1 } },
            { "type": "Discard", "who": { "type": "ControllerOf", "of": { "type": "EachObject" } }, "n": { "type": "Fixed", "n": 1 } },
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "not_types": ["Land"] } },
              "then": [ { "type": "AddCounters", "what": { "type": "EachObject" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } } ],
              "else": []
            }
          ]
        },
        {
          "type": "ForEach",
          "objects": { "type": "Targets" },
          "effects": [
            {
              "type": "May",
              "effects": [ { "type": "PhaseOut", "what": { "type": "EachObject" } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Each of X target creatures you control connive. You may have any number of them phase out. (To have a creature connive, draw a card, then discard a card. If you discarded a nonland card, put a +1/+1 counter on that creature. Treat phased-out permanents and anything attached to them as though they don't exist until their controller's next turn.)"
}
