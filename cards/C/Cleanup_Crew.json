{
  "name": "Cleanup Crew",
  "mana_cost": "{4}{G}{G}",
  "types": ["Creature"],
  "subtypes": ["Human", "Citizen"],
  "power": 6,
  "toughness": 6,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 1,
          "modes": [
            {
              "text": "Destroy target artifact.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Artifact"] } }, "label": "target artifact" } ],
                  "effects": [ { "type": "Destroy", "what": { "type": "Target", "idx": 0 } } ]
                }
              ]
            },
            {
              "text": "Destroy target enchantment.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Enchantment"] } }, "label": "target enchantment" } ],
                  "effects": [ { "type": "Destroy", "what": { "type": "Target", "idx": 0 } } ]
                }
              ]
            },
            {
              "text": "Exile target card from a graveyard.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [ { "what": { "type": "CardIn", "zone": "Graveyard", "filter": {}, "whose": "Any" }, "label": "target card from a graveyard" } ],
                  "effects": [ { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Exile" } ]
                }
              ]
            },
            {
              "text": "You gain 4 life.",
              "effects": [ { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 4 } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, choose one —\n• Destroy target artifact.\n• Destroy target enchantment.\n• Exile target card from a graveyard.\n• You gain 4 life."
