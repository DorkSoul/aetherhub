{
  "name": "Covetous Elegy",
  "mana_cost": "{4}{W}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "EachPlayer" },
          "zone": "Battlefield",
          "filter": { "types": ["Creature"], "controller": "You" },
          "min": 0,
          "max": 2,
          "then": [
            {
              "type": "Sacrifice",
              "who": { "type": "EachPlayer" },
              "filter": { "types": ["Creature"], "not_among_remembered": true },
              "n": { "type": "Fixed", "n": 99 }
            },
            {
              "type": "CreateToken",
              "token": "Treasure",
              "n": { "type": "Count", "filter": { "types": ["Creature"], "controller": "Opponent" }, "zone": "Battlefield" },
              "tapped": true
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Each player chooses up to two creatures they control, then sacrifices the rest. Then you create a tapped Treasure token for each creature your opponents control."
}
