{
  "name": "Court of Garenbrig",
  "mana_cost": "{1}{G}{G}",
  "types": ["Enchantment"],
  "abilities": [
    { "type": "Triggered", "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "BecomeMonarch", "who": { "type": "You" } } ] },
    { "type": "Triggered", "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "You" },
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "min": 0, "max": 2, "label": "up to two target creatures" } ],
      "effects": [
        { "type": "DivideCounters", "kind": "PlusOnePlusOne", "total": { "type": "Fixed", "n": 2 } },
        { "type": "If", "cond": { "type": "Monarch", "who": { "type": "You" } },
          "then": [ { "type": "ForEach", "objects": { "type": "All", "filter": { "types": ["Creature"], "controller": "You" } },
            "effects": [ { "type": "AddCounters", "what": { "type": "EachObject" }, "kind": "PlusOnePlusOne", "n": { "type": "CountersOn", "kind": "PlusOnePlusOne", "of": { "type": "EachObject" } } } ] } ],
          "else": [] }
      ] }
  ],
  "oracle_text": "When this enchantment enters, you become the monarch.\nAt the beginning of your upkeep, distribute two +1/+1 counters among up to two target creatures. Then if you're the monarch, double the number of +1/+1 counters on each creature you control."
