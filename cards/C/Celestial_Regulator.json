{
  "name": "Celestial Regulator",
  "mana_cost": "{1}{W}{U}",
  "types": ["Creature"],
  "subtypes": ["Angel", "Advisor"],
  "power": 2,
  "toughness": 3,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } },
          "label": "target creature you don't control"
        }
      ],
      "effects": [
        { "type": "Tap", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "types": ["Creature"], "has_any_counter": true }, "at_least": 1 },
          "then": [ { "type": "SkipNextUntap", "what": { "type": "Target", "idx": 0 } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Flying\nWhen this creature enters, choose target creature you don't control and tap it. If you control a creature with a counter on it, the chosen creature doesn't untap during its controller's next untap step."
