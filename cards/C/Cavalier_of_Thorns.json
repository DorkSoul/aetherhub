{
  "name": "Cavalier of Thorns",
  "mana_cost": "{2}{G}{G}{G}",
  "types": ["Creature"],
  "subtypes": ["Elemental", "Knight"],
  "colors": ["G"],
  "power": 5,
  "toughness": 6,
  "keywords": ["Reach"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "RevealTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 5 } },
        { "type": "StoreRemembered", "slot": 0 },
        { "type": "ClearRemembered" },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "Count", "filter": { "types": ["Land"], "among_stored": 0 }, "zone": "Library", "player": { "type": "You" } },
            "cmp": { "n": 1, "op": "Ge" }
          },
          "then": [
            {
              "type": "Choose",
              "who": { "type": "You" },
              "zone": "Library",
              "filter": { "types": ["Land"], "among_stored": 0 },
              "min": 1,
              "max": 1,
              "then": [
                { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" }
              ]
            }
          ]
        },
        {
          "type": "Move",
          "what": { "type": "All", "zone": "Library", "filter": { "among_stored": 0, "not_among_remembered": true } },
          "to": "Graveyard",
          "from": "Library"
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Dies", "filter": { "this": true } },
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "whose": "You", "filter": { "other": true } },
          "label": "another target card from your graveyard"
        }
      ],
      "effects": [
        {
          "type": "May",
          "effects": [
            { "type": "Move", "what": { "type": "This" }, "to": "Exile", "from": "Graveyard" },
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library", "top_of_library": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Reach\nWhen this creature enters, reveal the top five cards of your library. Put a land card from among them onto the battlefield and the rest into your graveyard.\nWhen this creature dies, you may exile it. If you do, put another target card from your graveyard on top of your library."
}
