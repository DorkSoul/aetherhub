{
  "name": "Chief Montgomery Scott",
  "mana_cost": "{2}{G}{U}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Artificer"],
  "power": 3,
  "toughness": 3,
  "abilities": [
    {
      "type": "Activated",
      "cost": [{ "type": "Mana", "cost": "{6}" }, { "type": "Tap" }],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Hand",
          "filter": {
            "any_of": [
              { "types": ["Creature"] },
              { "types": ["Artifact"], "subtypes": ["Spacecraft"] }
            ]
          },
          "min": 0,
          "max": 1,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "remember": true },
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "types": ["Creature"] } },
              "then": [
                {
                  "type": "AddCounters",
                  "what": { "type": "Remembered" },
                  "kind": "PlusOnePlusOne",
                  "n": { "type": "DistinctNames", "filter": { "types": ["Land"], "controller": "You" }, "zone": "Battlefield" }
                }
              ],
              "else": [
                {
                  "type": "AddCounters",
                  "what": { "type": "Remembered" },
                  "kind": "Charge",
                  "n": { "type": "DistinctNames", "filter": { "types": ["Land"], "controller": "You" }, "zone": "Battlefield" }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Strange new worlds — {6}, {T}: You may put a creature or Spacecraft card from your hand onto the battlefield. It enters with X additional +1/+1 counters on it if it's a creature and X additional charge counters on it if it's a Spacecraft, where X is the number of differently named lands you control."
}
