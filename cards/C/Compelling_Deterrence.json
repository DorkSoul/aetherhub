{
  "name": "Compelling Deterrence",
  "mana_cost": "{1}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "not_types": ["Land"] } }, "label": "target nonland permanent" }
      ],
      "effects": [
        { "type": "Bounce", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "filter": { "subtypes": ["Zombie"], "controller": "You" }, "at_least": 1 },
          "then": [
            { "type": "Discard", "who": { "type": "OwnerOf", "of": { "type": "Target", "idx": 0 } }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Return target nonland permanent to its owner's hand. Then that player discards a card if you control a Zombie."
}
