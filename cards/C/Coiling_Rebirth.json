{
  "name": "Coiling Rebirth",
  "mana_cost": "{3}{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    { "type": "Kicker", "cost": [] },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Creature"] }, "whose": "You" },
          "label": "target creature card in your graveyard"
        }
      ],
      "effects": [
        { "type": "If", "cond": { "type": "Kicked" }, "then": [ { "type": "Draw", "who": { "type": "EachOpponent" }, "n": { "type": "Fixed", "n": 1 } } ] },
        { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Battlefield", "remember": true },
        {
          "type": "If",
          "cond": {
            "type": "All",
            "cs": [
              { "type": "Kicked" },
              { "type": "RememberedIs", "filter": { "not_supertypes": ["Legendary"] } }
            ]
          },
          "then": [
            {
              "type": "CopyPermanent",
              "what": { "type": "Remembered" },
              "n": { "type": "Fixed", "n": 1 },
              "except": [ { "type": "SetPT", "power": 1, "toughness": 1 } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Gift a card (You may promise an opponent a gift as you cast this spell. If you do, they draw a card before its other effects.)\nReturn target creature card from your graveyard to the battlefield. Then if the gift was promised and that creature isn't legendary, create a token that's a copy of that creature, except it's 1/1."
}
