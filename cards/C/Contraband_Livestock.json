          "outcomes": [
            { "min": 1, "max": 9, "effects": [ { "type": "CreateToken", "token": "Ox 4-4 Green", "controller": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "n": { "type": "Fixed", "n": 1 } } ] },
            { "min": 10, "max": 19, "effects": [ { "type": "CreateToken", "token": "Boar 2-2", "controller": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "n": { "type": "Fixed", "n": 1 } } ] },
            { "min": 20, "max": 20, "effects": [ { "type": "CreateToken", "token": "Goat 0-1 White", "controller": { "type": "ControllerOf", "of": { "type": "Target", "idx": 0 } }, "n": { "type": "Fixed", "n": 1 } } ] }
          ]
        }
      ]
    }
