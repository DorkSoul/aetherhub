{
  "name": "Clinging Mists",
  "mana_cost": "{2}{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "PreventDamage", "combat_only": true },
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "LifeAtLeast", "who": { "type": "You" }, "n": 6 } },
          "then": [
            { "type": "Tap", "what": { "type": "All", "filter": { "attacking": true }, "zone": "Battlefield" } },
            { "type": "SkipNextUntap", "what": { "type": "All", "filter": { "attacking": true }, "zone": "Battlefield" } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Prevent all combat damage that would be dealt this turn.\nFateful hour — If you have 5 or less life, tap all attacking creatures. Those creatures don't untap during their controller's next untap step."
}
