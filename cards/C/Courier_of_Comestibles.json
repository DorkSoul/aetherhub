{
  "name": "Courier of Comestibles",
  "mana_cost": "{1}{G}",
  "types": ["Creature"],
  "subtypes": ["Human", "Citizen"],
  "power": 1,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "Count", "filter": { "subtypes": ["Food"] }, "zone": "Library", "player": { "type": "You" } },
            "cmp": { "op": "Ge", "n": 1 }
          },
          "then": [
            {
              "type": "May",
              "effects": [
                {
                  "type": "SearchLibrary",
                  "who": { "type": "You" },
                  "filter": { "subtypes": ["Food"] },
                  "n": { "type": "Fixed", "n": 1 },
                  "to": "Hand",
                  "reveal": true,
                  "shuffle": true
                }
              ],
              "otherwise": [
                { "type": "CreateToken", "token": "Food", "n": { "type": "Fixed", "n": 1 } }
              ]
            }
          ],
          "else": [
            { "type": "CreateToken", "token": "Food", "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you may search your library for a Food card, reveal it, put it into your hand, then shuffle. If you don't put a card into your hand this way, create a Food token. (It's an artifact with \"{2}, {T}, Sacrifice this token: You gain 3 life.\")"
}
