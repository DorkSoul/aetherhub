{
  "name": "Charismatic Conqueror",
  "mana_cost": "{1}{W}",
  "types": ["Creature"],
  "subtypes": ["Vampire", "Soldier"],
  "power": 2,
  "toughness": 2,
  "keywords": ["Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "types": ["Artifact", "Creature"], "controller": "Opponent", "tapped": false } },
      "effects": [
        {
          "type": "May",
          "who": { "type": "ControllerOf", "of": { "type": "TriggerObject" } },
          "effects": [ { "type": "Tap", "what": { "type": "TriggerObject" } } ],
          "otherwise": [ { "type": "CreateToken", "token": "Vampire 1-1 Lifelink", "n": { "type": "Fixed", "n": 1 } } ]
        }
      ]
    }
  ],
  "oracle_text": "Vigilance\nWhenever an artifact or creature an opponent controls enters untapped, they may tap that permanent. If they don't, you create a 1/1 white Vampire creature token with lifelink."
}
