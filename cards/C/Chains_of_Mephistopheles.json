{
  "name": "Chains of Mephistopheles",
  "mana_cost": "{1}{B}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "Draw",
        "who": "Any",
        "except_first_in_draw_step": true,
        "instead": [
          {
            "type": "If",
            "cond": {
              "type": "Compare",
              "a": { "type": "HandSize", "who": { "type": "TriggerPlayer" } },
              "cmp": { "op": "Ge", "n": 1 }
            },
            "then": [
              { "type": "Discard", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 } },
              { "type": "Draw", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 }, "plain": true }
            ],
            "else": [
              { "type": "Mill", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 } }
            ]
          }
        ]
      }
    }
  ],
  "oracle_text": "If a player would draw a card except the first one they draw in each of their draw steps, that player discards a card instead. If the player discards a card this way, they draw a card. If the player doesn't discard a card this way, they mill a card."
}
