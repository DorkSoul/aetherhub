{
  "name": "Chain Assassination",
  "mana_cost": "{2}{B}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "AlternativeCost",
      "cost": [{ "type": "Mana", "cost": "{1}{B}" }],
      "condition": {
        "type": "AnyOf",
        "cs": [
          { "type": "DealtCombatDamageThisTurn", "filter": { "types": ["Creature"], "subtypes": ["Assassin"], "controller": "You" } },
          { "type": "DealtCombatDamageThisTurn", "filter": { "commander": true, "owner": "You" } }
        ]
      }
    },
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" } ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "CreaturesDiedThisTurn" }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [ { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } } ]
        },
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } }
      ]
    }
  ],
  "oracle_text": "Freerunning {1}{B} (You may cast this spell for its freerunning cost if you dealt combat damage to a player this turn with an Assassin or commander.)\nDestroy target creature. If another creature died this turn, draw a card."
}
