{
  "name": "Cosmic Intervention",
  "mana_cost": "{3}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "AddReplacement",
          "what": {
            "type": "ZoneChange",
            "from": "Battlefield",
            "to": "Graveyard",
            "instead": "Exile",
            "filter": { "controller": "You" },
            "then": [
              {
                "type": "Move",
                "what": { "type": "TriggerObject" },
                "to": "Exile",
                "remember": true
              },
              {
                "type": "Delayed",
                "at": "NextEndStep",
                "effects": [
                  { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" }
                ]
              }
            ]
          }
        }
      ]
    },
    { "type": "Foretell", "cost": "{1}{W}" }
  ],
  "oracle_text": "If a permanent you control would be put into a graveyard from the battlefield this turn, exile it instead. Return it to the battlefield under its owner's control at the beginning of the next end step.\nForetell {1}{W} (During your turn, you may pay {2} and exile this card from your hand face down. Cast it on a later turn for its foretell cost.)"
}
