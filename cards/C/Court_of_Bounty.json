{
  "name": "Court of Bounty",
  "mana_cost": "{2}{G}{G}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {"type": "EntersBattlefield", "filter": {"this": true}},
      "effects": [{"type": "BecomeMonarch", "who": {"type": "You"}}]
    },
    {
      "type": "Triggered",
      "trigger": {"type": "BeginningOfStep", "step": "Upkeep", "whose": "You"},
      "effects": [
        {
          "type": "If",
          "cond": {"type": "Monarch", "who": {"type": "You"}},
          "then": [
            {
              "type": "Choose",
              "who": {"type": "You"},
              "zone": "Hand",
              "filter": {"types": ["Creature", "Land"]},
              "min": 0,
              "max": 1,
              "then": [{"type": "Move", "what": {"type": "Remembered"}, "to": "Battlefield"}]
            }
          ],
          "else": [
            {
              "type": "Choose",
              "who": {"type": "You"},
              "zone": "Hand",
              "filter": {"types": ["Land"]},
              "min": 0,
              "max": 1,
              "then": [{"type": "Move", "what": {"type": "Remembered"}, "to": "Battlefield"}]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this enchantment enters, you become the monarch.\nAt the beginning of your upkeep, you may put a land card from your hand onto the battlefield. If you're the monarch, instead you may put a creature or land card from your hand onto the battlefield."
}
