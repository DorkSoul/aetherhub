{
  "name": "Contract Hero",
  "mana_cost": "{2}{R}",
  "types": ["Creature"],
  "subtypes": ["Human", "Mercenary", "Hero"],
  "power": 2,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "CreateToken", "token": "Treasure", "n": { "type": "Fixed", "n": 1 } } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        {
          "type": "MayPay",
          "payer": { "type": "You" },
          "cost": [
            {
              "type": "Or",
              "options": [
                [ { "type": "Sacrifice", "filter": { "types": ["Artifact"] }, "n": 1 } ],
                [ { "type": "Discard", "n": 1 } ]
              ]
            }
          ],
          "effects": [
            { "type": "Pump", "what": { "type": "This" }, "power": { "type": "Fixed", "n": 2 }, "toughness": { "type": "Fixed", "n": 0 }, "duration": "UntilEndOfTurn" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, create a Treasure token. (It's an artifact with \"{T}, Sacrifice this token: Add one mana of any color.\")\nWhenever this creature attacks, you may sacrifice an artifact or discard a card. If you do, this creature gets +2/+0 until end of turn."
}
