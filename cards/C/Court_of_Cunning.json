{
  "name": "Court of Cunning",
  "mana_cost": "{1}{U}{U}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {"type": "EntersBattlefield", "filter": {"this": true}},
      "effects": [{"type": "BecomeMonarch", "who": {"type": "You"}}]
    },
    {
      "type": "Triggered",
      "trigger": {"type": "BeginningOfStep", "step": "Upkeep", "whose": "You"},
      "targets": [
        {"what": {"type": "Player", "filter": "Any"}, "min": 0, "max": 255, "label": "any number of target players"}
      ],
      "effects": [
        {
          "type": "If",
          "cond": {"type": "Monarch", "who": {"type": "You"}},
          "then": [{"type": "Mill", "who": {"type": "Targets"}, "n": {"type": "Fixed", "n": 10}}],
          "else": [{"type": "Mill", "who": {"type": "Targets"}, "n": {"type": "Fixed", "n": 2}}]
        }
      ]
    }
  ],
  "oracle_text": "When this enchantment enters, you become the monarch.\nAt the beginning of your upkeep, any number of target players each mill two cards. If you're the monarch, each of those players mills ten cards instead. (To mill a card, a player puts the top card of their library into their graveyard.)"
}
