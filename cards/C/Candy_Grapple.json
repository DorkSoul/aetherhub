{
  "name": "Candy Grapple",
  "mana_cost": "{1}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [{ "type": "Sacrifice", "filter": { "any_of": [{ "types": ["Artifact"] }, { "types": ["Enchantment"] }, { "token": true }] }, "n": 1 }],
      "multi": false
    },
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Kicked" },
          "then": [{ "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": -5 }, "toughness": { "type": "Fixed", "n": -5 }, "duration": "UntilEndOfTurn" }],
          "else": [{ "type": "Pump", "what": { "type": "Target", "idx": 0 }, "power": { "type": "Fixed", "n": -3 }, "toughness": { "type": "Fixed", "n": -3 }, "duration": "UntilEndOfTurn" }]
        }
      ]
    }
  ],
  "oracle_text": "Bargain (You may sacrifice an artifact, enchantment, or token as you cast this spell.)\nTarget creature gets -3/-3 until end of turn. If this spell was bargained, that creature gets -5/-5 until end of turn instead."
}
