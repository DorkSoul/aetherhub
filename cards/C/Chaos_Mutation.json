{
  "name": "Chaos Mutation",
  "mana_cost": "{3}{U}{R}",
  "types": ["Instant"],
  "colors": ["U", "R"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } },
          "min": 0,
          "max": 1,
          "label": "creature you control"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "min": 0,
          "max": 1,
          "per_opponent": true,
          "label": "creature each opponent controls"
        }
      ],
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "Targets" },
          "effects": [
            { "type": "Exile", "what": { "type": "EachObject" } },
            {
              "type": "RevealUntil",
              "who": { "type": "ControllerOf", "of": { "type": "EachObject" } },
              "filter": { "types": ["Creature"] },
              "count": { "type": "Fixed", "n": 1 },
              "to": "Battlefield",
              "rest": "Library",
              "rest_random": true
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Exile any number of target creatures controlled by different players. For each creature exiled this way, its controller reveals cards from the top of their library until they reveal a creature card, puts that card onto the battlefield, then puts the rest on the bottom of their library in a random order."
}
