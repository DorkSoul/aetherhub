{
  "name": "Chandra's Defeat",
  "mana_cost": "{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": {
              "any_of": [
                { "types": ["Creature"], "colors": ["R"] },
                { "types": ["Planeswalker"], "colors": ["R"] }
              ]
            }
          },
          "label": "target red creature or red planeswalker"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "types": ["Planeswalker"], "subtypes": ["Chandra"] } },
          "then": [
            {
              "type": "May",
              "effects": [
                {
                  "type": "Choose",
                  "who": { "type": "You" },
                  "zone": "Hand",
                  "filter": {},
                  "min": 1,
                  "max": 1,
                  "then": [
                    { "type": "Move", "what": { "type": "Remembered" }, "to": "Graveyard", "discard": true },
                    { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "DealDamage", "source": { "type": "This" }, "to": { "type": "Target", "idx": 0 }, "amount": { "type": "Fixed", "n": 5 } }
      ]
    }
  ],
  "oracle_text": "Chandra's Defeat deals 5 damage to target red creature or red planeswalker. If that permanent is a Chandra planeswalker, you may discard a card. If you do, draw a card."
}
