{
  "name": "Crypt Champion",
  "mana_cost": "{3}{B}",
  "types": ["Creature"],
  "subtypes": ["Zombie"],
  "power": 2,
  "toughness": 2,
  "keywords": ["DoubleStrike"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "EachPlayer" },
          "zone": "Graveyard",
          "filter": { "types": ["Creature"], "mana_value": { "op": "Le", "n": 3 } },
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "ForEach",
              "objects": { "type": "Remembered" },
              "effects": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ]
            }
          ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "ManaSpentOf", "of": { "type": "This" }, "mana": "R" }, "cmp": { "op": "Eq", "n": 0 } },
          "then": [ { "type": "Sacrifice", "who": { "type": "You" }, "filter": { "this": true } } ]
        }
      ]
    }
  ],
  "oracle_text": "Double strike\nWhen this creature enters, each player puts a creature card with mana value 3 or less from their graveyard onto the battlefield.\nWhen this creature enters, sacrifice it unless {R} was spent to cast it."
