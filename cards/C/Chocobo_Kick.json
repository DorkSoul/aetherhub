{
  "name": "Chocobo Kick",
  "mana_cost": "{1}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Kicker",
      "cost": [
        { "type": "ReturnToHand", "filter": { "types": ["Land"], "controller": "You" }, "n": 1 }
