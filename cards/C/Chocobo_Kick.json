          ],
          "else": [
            { "type": "DealDamage", "source": { "type": "Target", "idx": 0 }, "to": { "type": "Target", "idx": 1 }, "amount": { "type": "PowerOf", "of": { "type": "Target", "idx": 0 } } }
          ]
        }
