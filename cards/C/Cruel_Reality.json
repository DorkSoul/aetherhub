{
  "name": "Cruel Reality",
  "mana_cost": "{5}{B}{B}",
  "types": ["Enchantment"],
  "subtypes": ["Aura", "Curse"],
  "abilities": [
    { "type": "EnchantPlayer" },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "Enchanted" },
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": {
              "type": "Count",
              "filter": { "any_of": [ { "types": ["Creature"] }, { "types": ["Planeswalker"] } ] },
              "zone": "Battlefield",
              "player": { "type": "EnchantedPlayer" }
            },
            "cmp": { "op": "Ge", "n": 1 }
          },
          "then": [
            {
              "type": "Sacrifice",
              "who": { "type": "EnchantedPlayer" },
              "filter": { "any_of": [ { "types": ["Creature"] }, { "types": ["Planeswalker"] } ] },
              "n": { "type": "Fixed", "n": 1 }
            }
          ],
          "else": [ { "type": "LoseLife", "n": { "type": "Fixed", "n": 5 }, "who": { "type": "EnchantedPlayer" } } ]
        }
      ]
    }
  ],
  "oracle_text": "Enchant player\nAt the beginning of enchanted player's upkeep, that player sacrifices a creature or planeswalker of their choice. If the player can't, they lose 5 life."
}
