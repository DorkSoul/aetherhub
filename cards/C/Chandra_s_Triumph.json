          },
          "then": [
            {
              "type": "DealDamage",
              "to": { "type": "Target", "idx": 0 },
              "amount": { "type": "Fixed", "n": 5 },
              "source": { "type": "This" }
            }
          ],
          "else": [
            {
              "type": "DealDamage",
              "to": { "type": "Target", "idx": 0 },
              "amount": { "type": "Fixed", "n": 3 },
              "source": { "type": "This" }
            }
          ]
        }
      ]
