{
  "name": "Surtland Elementalist",
  "mana_cost": "{5}{U}{U}",
  "types": ["Creature"],
  "subtypes": ["Giant", "Wizard"],
  "power": 8,
  "toughness": 8,
  "abilities": [
    {
      "type": "AdditionalCost",
      "cost": [ { "type": "Or", "options": [
        [ { "type": "Reveal", "filter": { "subtypes": ["Giant"] } } ],
        [ { "type": "Mana", "cost": "{2}" } ]
      ] } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "this": true } },
      "effects": [
        { "type": "May", "effects": [
          { "type": "Choose", "who": { "type": "You" }, "zone": "Hand",
            "filter": { "any_of": [ { "types": ["Instant"] }, { "types": ["Sorcery"] } ] },
            "min": 1, "max": 1,
            "then": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": false } ] }
        ] }
      ]
    }
  ],
  "oracle_text": "As an additional cost to cast this spell, reveal a Giant card from your hand or pay {2}.\nWhenever this creature attacks, you may cast an instant or sorcery spell from your hand without paying its mana cost."
}
