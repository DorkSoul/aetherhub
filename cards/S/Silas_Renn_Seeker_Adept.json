{
  "name": "Silas Renn, Seeker Adept",
  "mana_cost": "{1}{U}{B}",
  "types": ["Artifact", "Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human"],
  "power": 2,
  "toughness": 2,
  "keywords": ["Deathtouch"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Artifact"] }, "whose": "You" },
          "min": 1,
          "max": 1,
          "label": "target artifact card in your graveyard"
        }
      ],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Graveyard",
          "filter": { "types": ["Artifact"], "same_name_as": { "type": "Target", "idx": 0 } },
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "MayPlayThisTurn",
              "zone": "Graveyard",
              "filter": { "among_remembered": true }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Deathtouch\nWhenever Silas Renn deals combat damage to a player, choose target artifact card in your graveyard. You may cast that card this turn.\nPartner (You can have two commanders if both have partner.)"
}
