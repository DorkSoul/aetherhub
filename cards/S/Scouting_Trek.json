{
  "name": "Scouting Trek",
  "mana_cost": "{1}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Library",
          "filter": { "types": ["Land"], "supertypes": ["Basic"] },
          "min": 0,
          "max": 255,
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Exile" },
            { "type": "Shuffle", "who": { "type": "You" } },
            { "type": "Move", "what": { "type": "Remembered" }, "from": "Exile", "to": "Library", "top_of_library": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Search your library for any number of basic land cards, reveal those cards, then shuffle and put them on top."
}
