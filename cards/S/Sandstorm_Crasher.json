{
  "name": "Sandstorm Crasher",
  "mana_cost": "{3}{R}",
  "types": ["Creature"],
  "subtypes": ["Minotaur", "Berserker", "Wizard"],
  "power": 3,
  "toughness": 4,
  "keywords": ["Trample"],
  "abilities": [
    {
      "type": "Triggered",
