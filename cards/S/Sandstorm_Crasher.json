      "optional": true,
      "effects": [
        { "type": "Exert", "what": { "type": "This" } },
        {
          "type": "Reflexive",
          "targets": [
            {
              "what": {
                "type": "Permanent",
                "filter": { "types": ["Creature"], "controller": "You" }
              },
              "label": "target creature you control"
            }
          ],
          "effects": [
            {
              "type": "CopyPermanent",
              "what": { "type": "Target", "idx": 0 },
              "n": { "type": "Fixed", "n": 1 },
              "tapped": true,
              "attacking": true
            },
            {
              "type": "Delayed",
              "at": "NextEndStep",
              "effects": [
                {
                  "type": "Sacrifice",
                  "who": { "type": "You" },
                  "filter": { "among_remembered": true },
                  "n": { "type": "RememberedCount" }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Trample\nYou may exert this creature as it attacks. When you do, create a tapped and attacking token that's a copy of target creature you control. Sacrifice the token at the beginning of the next end step. (An exerted creature won't untap during your next untap step.)"
