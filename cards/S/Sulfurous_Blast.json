{
  "name": "Sulfurous Blast",
  "mana_cost": "{2}{R}{R}",
  "types": ["Instant"],
  "abilities": [
    { "type": "Spell",
      "effects": [
        { "type": "If",
          "cond": { "type": "All", "cs": [{ "type": "YourTurn" }, { "type": "AnyOf", "cs": [{ "type": "InStep", "step": "Main1" }, { "type": "InStep", "step": "Main2" }] }] },
          "then": [
            { "type": "DealDamage", "to": { "type": "All", "filter": { "types": ["Creature"] } }, "amount": { "type": "Fixed", "n": 3 } },
            { "type": "DealDamage", "to": { "type": "EachPlayer" }, "amount": { "type": "Fixed", "n": 3 } }
          ],
          "else": [
            { "type": "DealDamage", "to": { "type": "All", "filter": { "types": ["Creature"] } }, "amount": { "type": "Fixed", "n": 2 } },
            { "type": "DealDamage", "to": { "type": "EachPlayer" }, "amount": { "type": "Fixed", "n": 2 } }
          ] }
      ] }
  ],
  "oracle_text": "Sulfurous Blast deals 2 damage to each creature and each player. If you cast this spell during your main phase, Sulfurous Blast deals 3 damage to each creature and each player instead."
}
