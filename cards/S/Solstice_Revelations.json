{
  "name": "Solstice Revelations",
  "mana_cost": "{2}{R}",
  "types": ["Instant"],
  "subtypes": ["Lesson"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        { "type": "RevealUntil", "who": { "type": "You" }, "filter": { "not_types": ["Land"] }, "count": { "type": "Fixed", "n": 1 }, "to": "Exile", "rest": "Exile" },
        {
          "type": "If",
          "cond": {
            "type": "RememberedIs",
            "filter": { "mana_value_vs": { "op": "Lt", "amount": { "type": "Count", "filter": { "subtypes": ["Mountain"], "controller": "You" }, "zone": "Battlefield" } } }
          },
          "then": [ { "type": "CastFree", "what": { "type": "Remembered" }, "may": true } ]
        },
        { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand", "from": "Exile" }
      ]
    },
    { "type": "AlternativeCost", "cost": [ { "type": "Mana", "cost": "{6}{R}" } ], "from": "Graveyard", "exile_after": true }
  ],
  "oracle_text": "Exile cards from the top of your library until you exile a nonland card. You may cast that card without paying its mana cost if the spell's mana value is less than the number of Mountains you control. If you don't cast that card this way, put it into your hand.\nFlashback {6}{R} (You may cast this card from your graveyard for its flashback cost. Then exile it.)"
}
