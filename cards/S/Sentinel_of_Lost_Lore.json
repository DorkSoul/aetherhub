{
  "name": "Sentinel of Lost Lore",
  "mana_cost": "{1}{G}{G}",
  "types": ["Creature"],
  "subtypes": ["Elf", "Knight"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "ChooseModes",
          "choose_min": 1,
          "choose_max": 3,
          "modes": [
            {
              "text": "Return target card you own in exile that has an Adventure to your hand.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [
                    {
                      "what": { "type": "CardIn", "zone": "Exile", "filter": { "has_adventure": true, "owner": "You" }, "whose": "You" },
                      "label": "card you own in exile that has an Adventure"
                    }
                  ],
                  "effects": [
                    { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" }
                  ]
                }
              ]
            },
            {
              "text": "Put target card you don't own in exile that has an Adventure on the bottom of its owner's library.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [
                    {
                      "what": { "type": "CardIn", "zone": "Exile", "filter": { "has_adventure": true, "owner": "Opponent" }, "whose": "Opponent" },
                      "label": "card you don't own in exile that has an Adventure"
                    }
                  ],
                  "effects": [
                    { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library", "top_of_library": false }
                  ]
                }
              ]
            },
            {
              "text": "Exile target player's graveyard.",
              "effects": [
                {
                  "type": "Reflexive",
                  "targets": [
                    { "what": { "type": "Player", "filter": "Any" }, "label": "target player" }
                  ],
                  "effects": [
                    {
                      "type": "Move",
                      "what": { "type": "AllOfPlayer", "player": { "type": "Target", "idx": 0 }, "zone": "Graveyard", "filter": {} },
                      "to": "Exile"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, choose one or more —\n• Return target card you own in exile that has an Adventure to your hand.\n• Put target card you don't own in exile that has an Adventure on the bottom of its owner's library.\n• Exile target player's graveyard."
}
