{
  "name": "Splitting the Powerstone",
  "mana_cost": "{2}{U}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "AdditionalCost",
      "cost": [
        {
          "type": "Sacrifice",
          "filter": { "types": ["Artifact"], "controller": "You" }
        }
      ]
    },
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "supertypes": ["Legendary"] } },
          "then": [
            {
              "type": "Draw",
              "who": { "type": "You" },
              "n": { "type": "Fixed", "n": 1 }
            }
          ]
        },
        {
          "type": "CreateToken",
          "token": "Powerstone",
          "n": { "type": "Fixed", "n": 2 },
          "tapped": true
        }
      ]
    }
  ],
  "oracle_text": "As an additional cost to cast this spell, sacrifice an artifact.\nCreate two tapped Powerstone tokens. If the sacrificed artifact was legendary, draw a card. (The tokens are artifacts with \"{T}: Add {C}. This mana can't be spent to cast a nonartifact spell.\")"
}
