{
  "name": "Soulfire Eruption",
  "mana_cost": "{6}{R}{R}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "AnyOf",
            "kinds": [
              { "type": "Permanent", "filter": { "types": ["Creature", "Planeswalker"] } },
              { "type": "Player", "filter": "Any" }
            ]
          },
          "min": 0,
          "max": 255,
          "label": "any number of target creatures, planeswalkers and/or players"
        }
      ],
      "effects": [
