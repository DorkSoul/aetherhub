        { "type": "StoreRemembered", "slot": 0 },
        {
          "type": "ForEach",
          "objects": { "type": "Targets" },
          "effects": [
            { "type": "Move", "what": { "type": "TopOfLibrary", "who": { "type": "You" }, "n": 1 }, "to": "Exile", "remember": true },
