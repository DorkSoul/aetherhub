{
  "name": "Sewers of Estark",
  "mana_cost": "{2}{B}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"] } },
          "label": "target creature"
        }
      ],
      "effects": [
        { "type": "Remember", "what": { "type": "Target", "idx": 0 } },
        { "type": "StoreRemembered", "slot": 0, "append": false },
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "Target", "idx": 0 }, "filter": { "attacking": true } },
          "then": [
            {
              "type": "GrantStatic",
              "what": { "type": "Target", "idx": 0 },
              "effect": { "type": "CantBeBlockedBy", "affects": {}, "by": { "types": ["Creature"] } },
              "duration": "UntilEndOfTurn"
            }
          ]
        },
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "Target", "idx": 0 }, "filter": { "blocking": true } },
          "then": [
            { "type": "AddReplacement", "what": { "type": "Damage", "source": {}, "bind_source": { "type": "Target", "idx": 0 }, "prevent": true, "combat": true } },
            {
              "type": "ForEach",
              "objects": { "type": "All", "filter": { "types": ["Creature"], "blocked_by_stored": 0 }, "zone": "Battlefield" },
              "effects": [ { "type": "AddReplacement", "what": { "type": "Damage", "source": {}, "bind_source": { "type": "EachObject" }, "prevent": true, "combat": true } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Choose target creature. If it's attacking, it can't be blocked this turn. If it's blocking, prevent all combat damage that would be dealt this combat by it and each creature it's blocking."
}
