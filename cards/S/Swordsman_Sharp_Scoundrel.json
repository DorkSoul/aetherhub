{
  "name": "Swordsman, Sharp Scoundrel",
  "mana_cost": "{1}{B}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Human", "Hero", "Villain"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "subtypes": ["Villain"], "controller": "You", "other": true } },
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact"], "subtypes": ["Equipment"], "controller": "You" } },
          "min": 0, "max": 1, "label": "up to one target Equipment you control"
        },
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } },
          "label": "target creature you control"
        }
      ],
      "effects": [
        { "type": "Attach", "what": { "type": "Target", "idx": 0 }, "to": { "type": "Target", "idx": 1 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "filter": { "equipped": true, "controller": "You" } },
      "effects": [
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Discard", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "not_types": ["Land"] } },
          "then": [
            { "type": "AddCounters", "what": { "type": "TriggerSource" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Whenever another Villain you control enters, attach up to one target Equipment you control to target creature you control.\nWhenever an equipped creature you control attacks, it connives. (Draw a card, then discard a card. If you discarded a nonland card, put a +1/+1 counter on that creature.)"
}
