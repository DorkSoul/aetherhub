{
  "name": "Smashing Success",
  "mana_cost": "{3}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": { "any_of": [{ "types": ["Artifact"] }, { "types": ["Land"] }] }
          },
          "label": "target artifact or land"
        }
      ],
      "effects": [
        {
          "type": "Destroy",
          "what": { "type": "Target", "idx": 0 },
          "remember": true
        },
        {
          "type": "If",
          "cond": {
            "type": "RememberedIs",
            "filter": { "types": ["Artifact"] }
          },
          "then": [
            { "type": "CreateToken", "token": "Treasure" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Destroy target artifact or land. If an artifact is destroyed this way, create a Treasure token. (It's an artifact with \"{T}, Sacrifice this token: Add one mana of any color.\")"
}
