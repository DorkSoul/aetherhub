{
  "name": "Shrewd Negotiation",
  "mana_cost": "{4}{U}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Artifact"], "controller": "You" } },
          "label": "target artifact you control"
        },
        {
          "what": {
            "type": "Permanent",
            "filter": { "any_of": [{ "types": ["Artifact"] }, { "types": ["Creature"] }], "controller": "Opponent" }
          },
          "distinct": true,
          "label": "target artifact or creature you don't control"
        }
      ],
      "effects": [
        { "type": "ExchangeControl", "a": { "type": "Target", "idx": 0 }, "b": { "type": "Target", "idx": 1 }, "duration": "Forever" }
      ]
    }
  ],
  "oracle_text": "Exchange control of target artifact you control and target artifact or creature you don't control."
}
