{
  "name": "Spawnbroker",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "subtypes": ["Human", "Wizard"],
  "power": 1,
  "toughness": 1,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "optional": true,
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" },
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent", "power_vs": { "op": "Le", "amount": { "type": "PowerOf", "of": { "type": "Target", "idx": 0 } } } } }, "label": "target creature with power less than or equal to that creature's power an opponent controls" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "CompareAmounts", "a": { "type": "PowerOf", "of": { "type": "Target", "idx": 1 } }, "b": { "type": "PowerOf", "of": { "type": "Target", "idx": 0 } }, "op": "Le" },
          "then": [
            { "type": "ExchangeControl", "a": { "type": "Target", "idx": 0 }, "b": { "type": "Target", "idx": 1 }, "duration": "Forever" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, you may exchange control of target creature you control and target creature with power less than or equal to that creature's power an opponent controls."
}
