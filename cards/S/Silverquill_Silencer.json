{
  "name": "Silverquill Silencer",
  "mana_cost": "{W}{B}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "power": 3,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "ChooseCardName", "kind": "Nonland" } ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "by": "Opponent", "filter": { "chosen_name": true } },
      "effects": [
        { "type": "LoseLife", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 3 } },
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }
      ]
    }
  ],
  "oracle_text": "As this creature enters, choose a nonland card name.\nWhenever an opponent casts a spell with the chosen name, they lose 3 life and you draw a card."
}
