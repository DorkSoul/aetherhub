{
  "name": "Solve for Disappointment",
  "mana_cost": "{1}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [ { "what": { "type": "Player", "filter": "Opponent" }, "label": "target opponent" } ],
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "from": { "type": "Target", "idx": 0 },
          "zone": "Hand",
          "filter": { "not_types": ["Land", "Instant", "Sorcery"] },
          "min": 1,
          "max": 1,
          "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Graveyard", "discard": true } ]
        },
        {
          "type": "If",
          "cond": { "type": "Not", "c": { "type": "Control", "who": { "type": "You" }, "filter": { "subtypes": ["Jace"], "token": true }, "at_least": 1 } },
          "then": [ { "type": "CreateToken", "token": "Jace", "n": { "type": "Fixed", "n": 1 } } ]
        },
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "filter": { "subtypes": ["Jace"], "token": true, "controller": "You" },
          "min": 1,
          "max": 1,
          "then": [ { "type": "AddCounters", "kind": "Loyalty", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Remembered" } } ]
        }
      ]
    }
  ],
  "oracle_text": "Target opponent reveals their hand. You choose a nonland permanent card from it. That player discards that card.\nEmpower Jace 1. (Put a loyalty counter on a Jace token you control. If you don't control one, first create a blue Jace planeswalker token with \"[−1]: Surveil 1\" and \"[−3]: Draw a card.\")"
}
