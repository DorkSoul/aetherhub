{
  "name": "Sweep Away",
  "mana_cost": "{2}{U}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "attacking": true } },
          "then": [
            {
              "type": "ChooseModes",
              "choose_min": 1,
              "choose_max": 1,
              "modes": [
                {
                  "text": "Return the creature to its owner's hand.",
                  "effects": [ { "type": "Bounce", "what": { "type": "Target", "idx": 0 } } ]
                },
                {
                  "text": "Put the creature on top of its owner's library.",
                  "effects": [
                    { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Library", "top_of_library": true }
                  ]
                }
              ]
            }
          ],
          "else": [
            { "type": "Bounce", "what": { "type": "Target", "idx": 0 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Return target creature to its owner's hand. If that creature is attacking, you may put it on top of its owner's library instead."
}
