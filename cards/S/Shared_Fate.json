{
  "name": "Shared Fate",
  "mana_cost": "{4}{U}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Replace",
      "what": {
        "type": "Draw",
        "who": "Any",
        "instead": [
          { "type": "ChoosePlayer", "who": { "type": "TriggerPlayer" }, "opponent": true },
          { "type": "Exile", "what": { "type": "TopOfLibrary", "who": { "type": "ChosenPlayer" }, "n": 1, "filter": {} }, "face_down": true },
          { "type": "SetExiledBy", "what": { "type": "Remembered" }, "who": { "type": "TriggerPlayer" } }
        ]
      }
    },
    { "type": "Static", "effect": { "type": "MayPlayFrom", "zone": "Exile", "filter": { "exiled_with_this": true }, "exiler": true } }
  ],
  "oracle_text": "If a player would draw a card, that player exiles the top card of one of their opponents' libraries face down instead.\nEach player may look at cards they exiled with this enchantment, and they may play lands and cast spells from among those cards."
}
