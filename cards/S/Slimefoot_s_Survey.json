{
  "name": "Slimefoot's Survey",
  "mana_cost": "{4}{G}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "SearchLibrary",
          "who": { "type": "You" },
          "filter": {
            "types": ["Land"],
            "any_of": [
              { "subtypes": ["Plains"] },
              { "subtypes": ["Island"] },
              { "subtypes": ["Swamp"] },
              { "subtypes": ["Mountain"] },
              { "subtypes": ["Forest"] }
            ]
          },
          "n": { "type": "Fixed", "n": 2 },
          "to": "Battlefield",
          "tapped": true,
          "reveal": true,
          "shuffle": true
        },
        {
          "type": "LookAtTop",
          "who": { "type": "You" },
          "n": { "type": "Domain", "who": { "type": "You" } },
          "filter": {},
          "take": 1,
          "must": false,
          "to": "Library",
          "rest": "Library",
          "random_rest": true
        }
      ]
    }
  ],
  "oracle_text": "Domain — Search your library for up to two land cards that each have a basic land type, put them onto the battlefield tapped, then shuffle. Look at the top X cards of your library, where X is the number of basic land types among lands you control. Put up to one of them on top of your library and the rest on the bottom of your library in a random order."
