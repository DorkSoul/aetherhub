{
  "name": "Shackle Slinger",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "subtypes": ["Human", "Soldier"],
  "power": 3,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "SpellCast", "filter": {}, "by": "You" },
      "condition": {
        "type": "Compare",
        "a": { "type": "SpellsCastThisTurn", "who": { "type": "You" } },
        "cmp": { "op": "Eq", "n": 2 }
      },
      "once_per_turn": true,
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } }, "label": "target creature an opponent controls" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "tapped": true } },
          "then": [ { "type": "AddCounters", "what": { "type": "Target", "idx": 0 }, "kind": "Stun", "n": { "type": "Fixed", "n": 1 } } ],
          "else": [ { "type": "Tap", "what": { "type": "Target", "idx": 0 } } ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever you cast your second spell each turn, choose target creature an opponent controls. If it's tapped, put a stun counter on it. Otherwise, tap it. (If a permanent with a stun counter would become untapped, remove one from it instead.)"
}
