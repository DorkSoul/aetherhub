{
  "name": "Silvan Reveler",
  "mana_cost": "{2}{G}{U}",
  "types": ["Creature"],
  "subtypes": ["Elf", "Citizen"],
  "power": 3,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        { "type": "Discard", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "types": ["Land"] } },
          "then": [{ "type": "Move", "what": { "type": "Remembered" }, "from": "Graveyard", "to": "Battlefield", "tapped": true }]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "Landfall" },
      "from": "Graveyard",
      "effects": [
        {
          "type": "MayPay",
          "payer": { "type": "You" },
          "cost": [{ "type": "Mana", "cost": "{1}{G}{U}" }],
          "effects": [{ "type": "Move", "what": { "type": "This" }, "from": "Graveyard", "to": "Hand" }]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, draw a card, then discard a card. If you discard a land card this way, put it from your graveyard onto the battlefield tapped.\nLandfall — Whenever a land you control enters, you may pay {1}{G}{U}. If you do, return this card from your graveyard to your hand."
}
