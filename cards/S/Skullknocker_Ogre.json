{
  "name": "Skullknocker Ogre",
  "mana_cost": "{3}{R}",
  "types": ["Creature"],
  "subtypes": ["Ogre"],
  "power": 4,
  "toughness": 3,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "DealsDamage", "filter": { "this": true }, "to": "Opponent" },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "HandSize", "who": { "type": "TriggerPlayer" } }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [
            { "type": "Discard", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 }, "random": true },
            { "type": "Draw", "who": { "type": "TriggerPlayer" }, "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever this creature deals damage to an opponent, that player discards a card at random. If the player does, they draw a card."
}
