{
  "name": "Shape of the Wiitigo",
  "mana_cost": "{3}{G}{G}{G}",
  "types": ["Enchantment"],
  "subtypes": ["Aura"],
  "colors": ["G"],
  "abilities": [
    { "type": "Attach", "to": { "types": ["Creature"] } },
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [
        { "type": "AddCounters", "what": { "type": "AttachedTo" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 6 } }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "Upkeep", "whose": "You" },
      "effects": [
        {
          "type": "If",
          "cond": { "type": "SelIs", "what": { "type": "AttachedTo" }, "filter": { "attacked_or_blocked_since_upkeep": true } },
          "then": [
            { "type": "AddCounters", "what": { "type": "AttachedTo" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } }
          ],
          "else": [
            { "type": "RemoveCounters", "what": { "type": "AttachedTo" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Enchant creature\nWhen this Aura enters, put six +1/+1 counters on enchanted creature.\nAt the beginning of your upkeep, put a +1/+1 counter on enchanted creature if it attacked or blocked since your last upkeep. Otherwise, remove a +1/+1 counter from it."
}
