{
  "name": "Swindler's Scheme",
  "mana_cost": "{2}{U}",
  "types": ["Enchantment"],
  "colors": ["U"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": {
        "type": "SpellCast",
        "by": "Opponent",
        "filter": { "cast_from": "Hand" }
      },
      "effects": [
        {
          "type": "May",
          "effects": [
            {
              "type": "RevealTop",
              "who": { "type": "You" },
              "n": { "type": "Fixed", "n": 1 }
            },
            {
              "type": "If",
              "cond": {
                "type": "RememberedIs",
                "filter": { "shares_card_type_with": { "type": "TriggerObject" } }
              },
              "then": [
                { "type": "CounterSpell", "what": { "type": "TriggerObject" } },
                {
                  "type": "CastFree",
                  "what": { "type": "Remembered" },
                  "by": { "type": "TriggerPlayer" },
                  "may": true
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever an opponent casts a spell from their hand, you may reveal the top card of your library. If it shares a card type with that spell, counter that spell and that opponent may cast the revealed card without paying its mana cost."
}
