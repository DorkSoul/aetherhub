{
  "name": "Surveyor's Scope",
  "mana_cost": "{2}",
  "types": ["Artifact"],
  "abilities": [
    {
      "type": "Activated",
      "cost": [{ "type": "Tap" }, { "type": "ExileSelf" }],
      "effects": [
        {
          "type": "ForEach",
          "objects": { "type": "EachOpponent" },
          "effects": [
            {
              "type": "If",
              "cond": {
                "type": "Compare",
                "a": {
                  "type": "Minus",
                  "a": { "type": "Count", "filter": { "types": ["Land"] }, "player": { "type": "EachObject" } },
                  "b": { "type": "Count", "filter": { "types": ["Land"] }, "player": { "type": "You" } }
                },
                "cmp": { "n": 2, "op": "Ge" }
              },
              "then": [
                {
                  "type": "SearchLibrary",
                  "who": { "type": "You" },
                  "filter": { "types": ["Land"], "supertypes": ["Basic"] },
                  "n": { "type": "Fixed", "n": 1 },
                  "to": "Battlefield",
                  "shuffle": false
                }
              ]
            }
          ]
        },
        { "type": "Shuffle", "who": { "type": "You" } }
      ]
    }
  ],
  "oracle_text": "{T}, Exile this artifact: Search your library for up to X basic land cards, where X is the number of players who control at least two more lands than you. Put those cards onto the battlefield, then shuffle."
}
