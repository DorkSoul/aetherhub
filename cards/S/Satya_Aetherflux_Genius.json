              "effects": [ { "type": "Sacrifice", "who": { "type": "You" }, "filter": { "among_remembered": true, "token": true }, "n": { "type": "Count", "filter": { "among_remembered": true, "token": true } } } ]
            }
          ]
        }
      ]
    }
