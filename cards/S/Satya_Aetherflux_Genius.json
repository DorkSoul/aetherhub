      "effects": [
        { "type": "CopyPermanent", "what": { "type": "Target", "idx": 0 }, "n": { "type": "Fixed", "n": 1 }, "tapped": true, "attacking": true },
        { "type": "GainEnergy", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } },
        {
          "type": "Delayed",
          "at": "NextEndStep",
