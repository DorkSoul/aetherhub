{
  "name": "Shredder's Technique",
  "mana_cost": "{2}{B}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Static",
      "effect": { "type": "CastAsThoughFlash", "filter": { "this": true }, "whose": "You" }
    },
    {
      "type": "CastOnlyIf",
      "condition": {
        "type": "AnyOf",
        "cs": [
          { "type": "SorcerySpeed" },
          { "type": "CastWithAlt", "index": 0 }
        ]
      }
    },
    {
      "type": "AlternativeCost",
      "cost": [
        { "type": "Mana", "cost": "{B}" },
        {
          "type": "ReturnToHand",
          "n": 1,
          "filter": {
            "types": ["Creature"],
            "controller": "You",
            "attacking": true,
            "unblocked": true
          }
        }
      ],
      "condition": { "type": "InStep", "step": "DeclareBlockers" },
      "exile_after": false,
      "flash": true
