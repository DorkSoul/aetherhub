                { "types": ["Enchantment"] }
              ]
            }
          },
          "label": "target creature or enchantment"
        }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 }, "remember": true },
        {
          "type": "If",
          "cond": {
            "type": "All",
            "cs": [
              { "type": "RememberedIs", "filter": { "types": ["Enchantment"] } },
              { "type": "Compare", "a": { "type": "RememberedCount" }, "cmp": { "op": "Ge", "n": 1 } }
            ]
          },
          "then": [
            { "type": "LoseLife", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 } }
          ]
        }
      ]
    }
