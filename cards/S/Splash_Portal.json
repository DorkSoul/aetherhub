{
  "name": "Splash Portal",
  "mana_cost": "{U}",
  "types": ["Sorcery"],
  "colors": ["U"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You" } }, "label": "target creature you control" }
      ],
      "effects": [
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
        { "type": "Move", "what": { "type": "Remembered" }, "from": "Exile", "to": "Battlefield", "remember": true },
        {
          "type": "If",
          "cond": {
            "type": "RememberedIs",
            "filter": { "any_of": [{ "subtypes": ["Bird"] }, { "subtypes": ["Frog"] }, { "subtypes": ["Otter"] }, { "subtypes": ["Rat"] }] }
          },
          "then": [{ "type": "Draw", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 1 } }],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Exile target creature you control, then return it to the battlefield under its owner's control. If that creature is a Bird, Frog, Otter, or Rat, draw a card."
}
