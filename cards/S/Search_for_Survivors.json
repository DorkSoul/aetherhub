{
  "name": "Search for Survivors",
  "mana_cost": "{2}{R}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [],
      "effects": [
        {
          "type": "ChoosePlayer",
          "opponent": true,
          "who": { "type": "You" }
        },
        {
          "type": "Choose",
          "who": { "type": "ChosenPlayer" },
          "from": { "type": "You" },
          "zone": "Graveyard",
          "filter": {},
          "min": 1,
          "max": 1,
          "random": true,
          "then": [
            {
              "type": "If",
              "cond": { "type": "RememberedIs", "filter": { "types": ["Creature"] } },
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ],
              "else": [ { "type": "Exile", "what": { "type": "Remembered" } } ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Reorder your graveyard at random. An opponent chooses a card at random in your graveyard. If it's a creature card, put it onto the battlefield. Otherwise, exile it."
}
