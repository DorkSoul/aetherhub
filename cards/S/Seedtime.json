{
  "name": "Seedtime",
  "mana_cost": "{1}{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "CastOnlyIf",
      "condition": { "type": "YourTurn" }
    },
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "CastThisTurn",
            "filter": { "colors": ["U"], "controller": "Opponent" },
            "at_least": 1
          },
          "then": [ { "type": "ExtraTurn", "who": { "type": "You" } } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Cast this spell only during your turn.\nTake an extra turn after this one if an opponent cast a blue spell this turn."
}
