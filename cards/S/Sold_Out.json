{
  "name": "Sold Out",
  "mana_cost": "{3}{B}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"] } }, "label": "target creature" }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "TargetIs", "idx": 0, "filter": { "types": ["Creature"], "was_dealt_damage_this_turn": true } },
          "then": [
            { "type": "CreateToken", "token": "Clue", "n": { "type": "Fixed", "n": 1 }, "controller": { "type": "You" } }
          ]
        },
        { "type": "Exile", "what": { "type": "Target", "idx": 0 } }
      ]
    }
  ],
  "oracle_text": "Exile target creature. If it was dealt damage this turn, create a Clue token. (It's an artifact with \"{2}, Sacrifice this token: Draw a card.\")"
}
