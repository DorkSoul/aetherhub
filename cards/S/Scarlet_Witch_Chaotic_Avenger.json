{
  "name": "Scarlet Witch, Chaotic Avenger",
  "mana_cost": "{2}{U}{R}",
  "types": ["Creature"],
  "supertypes": ["Legendary"],
  "subtypes": ["Mutant", "Warlock", "Hero"],
  "power": 3,
  "toughness": 3,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "effects": [
        { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 2 }, "take": 2, "all": true, "to": "Exile", "filter": {}, "rest": "Graveyard" },
        { "type": "Choose", "who": { "type": "You" }, "zone": "Exile", "min": 0, "max": 1,
          "filter": { "exiled_with_this": true, "any_of": [ { "subtypes": ["Hero"] }, { "not_types": ["Creature", "Land"] } ] },
          "then": [ { "type": "CastFree", "what": { "type": "Remembered" } } ] }
      ]
    }
  ],
  "oracle_text": "Flying\nWhenever Scarlet Witch deals combat damage to a player, look at the top two cards of your library, then exile them face down. Then you may cast a Hero or noncreature spell from among cards exiled with Scarlet Witch without paying its mana cost."
