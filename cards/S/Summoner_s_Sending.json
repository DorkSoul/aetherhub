{
  "name": "Summoner's Sending",
  "mana_cost": "{1}{W}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "BeginningOfStep", "step": "End", "whose": "You" },
      "optional": true,
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Creature"] }, "whose": "Any" },
          "label": "target creature card in a graveyard"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "ManaValueOf", "of": { "type": "Target", "idx": 0 } },
            "cmp": { "op": "Ge", "n": 4 }
          },
          "then": [
            { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
            { "type": "CreateToken", "token": "Spirit 1-1 White Flying" },
            { "type": "AddCounters", "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 }, "what": { "type": "Remembered" } }
          ],
          "else": [
            { "type": "Exile", "what": { "type": "Target", "idx": 0 } },
            { "type": "CreateToken", "token": "Spirit 1-1 White Flying" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "At the beginning of your end step, you may exile target creature card from a graveyard. If you do, create a 1/1 white Spirit creature token with flying. Put a +1/+1 counter on it if the exiled card's mana value is 4 or greater."
}
