{
  "name": "See the Truth",
  "mana_cost": "{1}{U}",
  "types": ["Sorcery"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "If",
          "cond": { "type": "All", "cs": [ { "type": "WasCast" }, { "type": "Not", "c": { "type": "CastFrom", "zone": "Hand" } } ] },
          "then": [
            { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 }, "filter": {}, "rest": "Library", "take": 3, "all": true }
          ],
          "else": [
            { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 3 }, "filter": {}, "rest": "Library", "take": 1, "must": true }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Look at the top three cards of your library. Put one of those cards into your hand and the rest on the bottom of your library in any order. If this spell was cast from anywhere other than your hand, put each of those cards into your hand instead."
