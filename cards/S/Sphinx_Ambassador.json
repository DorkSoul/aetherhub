{
  "name": "Sphinx Ambassador",
  "mana_cost": "{5}{U}{U}",
  "types": ["Creature"],
  "subtypes": ["Sphinx"],
  "power": 5,
  "toughness": 5,
  "keywords": ["Flying"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "DealsCombatDamage", "filter": { "this": true }, "to": "Player" },
      "effects": [
        { "type": "Choose", "who": { "type": "You" }, "from": { "type": "TriggerPlayer" }, "zone": "Library", "min": 1, "max": 1,
          "then": [
            { "type": "ChooseCardName", "kind": "Any", "who": { "type": "TriggerPlayer" } },
            { "type": "If",
              "cond": { "type": "All", "cs": [
                { "type": "RememberedIs", "filter": { "types": ["Creature"] } },
                { "type": "Not", "c": { "type": "RememberedIs", "filter": { "chosen_name": true } } }
              ] },
              "then": [
                { "type": "May", "effects": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield", "under_your_control": true } ] }
              ] }
          ] },
        { "type": "Shuffle", "who": { "type": "TriggerPlayer" } }
      ]
    }
  ],
  "oracle_text": "Flying\nWhenever Sphinx Ambassador deals combat damage to a player, search that player's library for a card, then that player chooses a card name. If you searched for a creature card that doesn't have that name, you may put it onto the battlefield under your control. Then that player shuffles."
}
