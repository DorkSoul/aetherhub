{
  "name": "Scion of Stygia",
  "mana_cost": "{2}{U}",
  "types": ["Creature"],
  "subtypes": ["Tiefling", "Shaman"],
  "power": 2,
  "toughness": 1,
  "keywords": ["Flash"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        { "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } }, "label": "target creature an opponent controls" }
      ],
      "effects": [
        {
          "type": "RollDie",
          "sides": 20,
          "outcomes": [
            {
              "min": 1,
              "max": 9,
              "effects": [{ "type": "Tap", "what": { "type": "Target", "idx": 0 } }]
            },
            {
              "min": 10,
              "max": 20,
              "effects": [
                { "type": "Tap", "what": { "type": "Target", "idx": 0 } },
                { "type": "SkipNextUntap", "what": { "type": "Target", "idx": 0 } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Flash\nCone of Cold — When this creature enters, choose target creature an opponent controls, then roll a d20.\n1—9 | Tap that creature.\n10—20 | Tap that creature. It doesn't untap during its controller's next untap step."
}
