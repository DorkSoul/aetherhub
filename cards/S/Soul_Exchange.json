{
  "name": "Soul Exchange",
  "mana_cost": "{B}{B}",
  "types": ["Sorcery"],
  "abilities": [
    { "type": "AdditionalCost", "cost": [ { "type": "ExileFromBattlefield", "filter": { "types": ["Creature"], "controller": "You" }, "n": 1 } ] },
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "CardIn", "zone": "Graveyard", "filter": { "types": ["Creature"] }, "whose": "You" },
          "min": 1,
          "max": 1,
          "label": "target creature card from your graveyard"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "RememberedIs", "filter": { "subtypes": ["Thrull"] } },
          "then": [
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Battlefield", "remember": true },
            { "type": "AddCounters", "what": { "type": "Remembered" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 } }
          ],
          "else": [
            { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Battlefield" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "As an additional cost to cast this spell, exile a creature you control.\nReturn target creature card from your graveyard to the battlefield. Put a +2/+2 counter on that creature if the exiled creature was a Thrull."
}
