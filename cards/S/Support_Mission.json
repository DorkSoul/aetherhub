{
  "name": "Support Mission",
  "mana_cost": "{2}{G}",
  "types": ["Enchantment"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "types": ["Creature"], "controller": "You" } },
      "effects": [
        { "type": "AddCounters", "what": { "type": "This" }, "kind": "Quest", "n": { "type": "Fixed", "n": 1 } },
        {
          "type": "If",
          "cond": {
            "type": "Compare",
            "a": { "type": "CountersOn", "kind": "Quest", "of": { "type": "This" } },
            "cmp": { "op": "Ge", "n": 5 }
          },
          "then": [
            { "type": "AddCounters", "what": { "type": "TriggerObject" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 2 } }
          ],
          "else": [
            { "type": "AddCounters", "what": { "type": "TriggerObject" }, "kind": "PlusOnePlusOne", "n": { "type": "Fixed", "n": 1 } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Whenever a creature you control enters, put a quest counter on this enchantment. Put a +1/+1 counter on that creature. If this enchantment has five or more quest counters on it, instead put two +1/+1 counters on that creature."
}
