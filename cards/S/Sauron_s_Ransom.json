{
 "name": "Sauron's Ransom",
 "mana_cost": "{1}{U}{B}",
 "types": ["Instant"],
 "colors": ["U", "B"],
 "abilities": [
  {
   "type": "Spell",
   "effects": [
    { "type": "ChoosePlayer", "who": { "type": "You" }, "opponent": true },
    { "type": "LookAtTop", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 4 }, "filter": {}, "take": 4, "all": true, "to": "Exile", "rest": "Library" },
    { "type": "StoreRemembered", "slot": 1 },
    { "type": "Choose", "who": { "type": "ChosenPlayer" }, "from": { "type": "You" }, "zone": "Exile",
      "filter": { "among_stored": 1 }, "min": 0, "max": 4,
      "then": [ { "type": "StoreRemembered", "slot": 0 } ] },
    { "type": "May", "who": { "type": "You" },
      "effects": [
        { "type": "Move", "what": { "type": "Stored", "slot": 0 }, "to": "Hand" },
        { "type": "Move", "what": { "type": "All", "filter": { "among_stored": 1, "not_among_stored": 0 }, "zone": "Exile" }, "to": "Graveyard" }
      ],
      "otherwise": [
        { "type": "Move", "what": { "type": "Stored", "slot": 0 }, "to": "Graveyard" },
        { "type": "Move", "what": { "type": "All", "filter": { "among_stored": 1, "not_among_stored": 0 }, "zone": "Exile" }, "to": "Hand" }
      ]
    },
    { "type": "RingTempts" }
   ]
  }
 ],
 "oracle_text": "Choose an opponent. They look at the top four cards of your library and separate them into a face-down pile and a face-up pile. Put one pile into your hand and the other into your graveyard. The Ring tempts you."
}
