{
  "name": "Shellshock",
  "mana_cost": "{X}{R}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "Opponent" } },
          "min": 0,
          "max": 1,
          "per_opponent": true,
          "label": "creature an opponent controls"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "X" }, "cmp": { "op": "Ge", "n": 1 } },
          "then": [
            { "type": "DealDamage", "amount": { "type": "X" }, "to": { "type": "Targets" } },
            {
              "type": "ForEach",
              "objects": { "type": "Targets" },
              "effects": [ { "type": "CreateToken", "token": "Mutagen", "controller": { "type": "You" } } ]
            }
          ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "For each opponent, choose up to one target creature that player controls. Shellshock deals X damage to each of those creatures. You create a Mutagen token for each creature dealt damage this way. (They're artifacts with \"{1}, {T}, Sacrifice this token: Put a +1/+1 counter on target creature. Activate only as a sorcery.\")"
}
