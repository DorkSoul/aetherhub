{
  "name": "Shepherd of the Clouds",
  "mana_cost": "{4}{W}",
  "types": ["Creature"],
  "subtypes": ["Pegasus"],
  "colors": ["W"],
  "power": 4,
  "toughness": 3,
  "keywords": ["Flying", "Vigilance"],
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "targets": [
        {
