          "label": "target permanent card with mana value 3 or less in your graveyard"
        }
      ],
      "effects": [
        {
          "type": "If",
          "cond": { "type": "Control", "who": { "type": "You" }, "at_least": 1, "filter": { "subtypes": ["Mount"] } },
          "then": [ { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Battlefield", "choose_host": true } ],
          "else": [ { "type": "Move", "what": { "type": "Target", "idx": 0 }, "to": "Hand" } ]
        }
      ]
    }
  ],
  "oracle_text": "Flying, vigilance\nWhen this creature enters, return target permanent card with mana value 3 or less from your graveyard to your hand. Return that card to the battlefield instead if you control a Mount."
