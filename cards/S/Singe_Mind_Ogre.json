      "effects": [
        {
          "type": "Choose",
          "who": { "type": "Target", "idx": 0 },
          "zone": "Hand",
          "min": 1,
          "max": 1,
          "random": true,
          "then": [
            { "type": "Reveal", "what": { "type": "Remembered" } },
            { "type": "LoseLife", "who": { "type": "Target", "idx": 0 }, "n": { "type": "ManaValueOf", "of": { "type": "Remembered" } } }
          ]
        }
      ]
    }
  ],
  "oracle_text": "When this creature enters, target player reveals a card at random from their hand, then loses life equal to that card's mana value."
