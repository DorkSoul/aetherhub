{
  "name": "Singe-Mind Ogre",
  "mana_cost": "{2}{B}{R}",
  "types": ["Creature"],
  "subtypes": ["Ogre", "Mutant"],
  "power": 3,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
