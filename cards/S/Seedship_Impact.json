{
  "name": "Seedship Impact",
  "mana_cost": "{1}{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "targets": [
        {
          "what": {
            "type": "Permanent",
            "filter": { "any_of": [{ "types": ["Artifact"] }, { "types": ["Enchantment"] }] }
          },
          "label": "target artifact or enchantment"
        }
      ],
      "effects": [
        { "type": "Destroy", "what": { "type": "Target", "idx": 0 } },
        {
          "type": "If",
          "cond": { "type": "Compare", "a": { "type": "ManaValueOf", "of": { "type": "Target", "idx": 0 } }, "cmp": { "op": "Le", "n": 2 } },
          "then": [ { "type": "CreateToken", "token": "Lander" } ],
          "else": []
        }
      ]
    }
  ],
  "oracle_text": "Destroy target artifact or enchantment. If its mana value was 2 or less, create a Lander token. (It's an artifact with \"{2}, {T}, Sacrifice this token: Search your library for a basic land card, put it onto the battlefield tapped, then shuffle.\")"
}
