{
  "name": "Shaun, Father of Synths",
  "mana_cost": "{3}{U}{R}",
  "types": ["Creature"],
  "subtypes": ["Human", "Scientist"],
  "supertypes": ["Legendary"],
  "power": 3,
  "toughness": 4,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "Attacks", "batched": true, "one_per_declaration": true, "filter": { "controller": "You", "types": ["Creature"] } },
      "optional": true,
      "targets": [
        {
          "what": { "type": "Permanent", "filter": { "types": ["Creature"], "controller": "You", "attacking": true, "supertypes": ["Legendary"], "other": true } },
          "label": "target attacking legendary creature you control other than Shaun"
        }
      ],
      "effects": [
        {
          "type": "CopyPermanent",
          "what": { "type": "Target", "idx": 0 },
          "n": { "type": "Fixed", "n": 1 },
          "tapped": true,
          "attacking": true,
          "except": [
            { "type": "NotLegendary" },
            { "type": "AddType", "card_type": "Artifact" },
            { "type": "AddType", "card_type": "Creature" },
            { "type": "AddSubtype", "subtype": "Synth" }
          ]
        }
      ]
    },
    {
      "type": "Triggered",
      "trigger": { "type": "LeavesBattlefield", "filter": { "this": true } },
      "effects": [
        {
          "type": "Exile",
          "what": { "type": "All", "filter": { "subtypes": ["Synth"], "token": true, "controller": "You" } }
        }
      ]
    }
  ],
  "oracle_text": "Whenever you attack, you may create a tapped and attacking token that's a copy of target attacking legendary creature you control other than Shaun, except it's not legendary and it's a Synth artifact creature in addition to its other types.\nWhen Shaun leaves the battlefield, exile all Synth tokens you control."
