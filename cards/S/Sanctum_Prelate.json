{
  "name": "Sanctum Prelate",
  "mana_cost": "{1}{W}{W}",
  "types": ["Creature"],
  "subtypes": ["Human", "Cleric"],
  "power": 2,
  "toughness": 2,
  "abilities": [
    {
      "type": "Triggered",
      "trigger": { "type": "EntersBattlefield", "filter": { "this": true } },
      "effects": [ { "type": "ChooseNumber", "who": { "type": "You" }, "min": 0, "max": 99 } ]
    },
    {
      "type": "Static",
      "effect": {
        "type": "CantCastCards",
        "who": "Any",
        "filter": {
          "not_types": ["Creature"],
          "mana_value_vs": { "amount": { "type": "ChosenNumber" }, "op": "Eq" }
        }
      }
    }
  ],
  "oracle_text": "As this creature enters, choose a number.\nNoncreature spells with mana value equal to the chosen number can't be cast."
}
