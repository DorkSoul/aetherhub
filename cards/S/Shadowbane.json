{
  "name": "Shadowbane",
  "mana_cost": "{1}{W}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Battlefield",
          "also_zones": ["Stack", "Hand", "Graveyard", "Exile", "Command"],
          "min": 1,
          "max": 1,
          "then": [
            {
              "type": "AddReplacement",
              "what": {
                "type": "Damage",
                "source": {},
                "to_filter": { "types": ["Creature"], "controller": "You" },
                "to_filter_or_you": true,
                "prevent": true,
                "once": true,
                "bind_source": { "type": "Remembered" },
                "then": [
                  {
                    "type": "If",
                    "cond": { "type": "SelIs", "what": { "type": "TriggerSource" }, "filter": { "colors": ["B"] } },
                    "then": [
                      { "type": "GainLife", "who": { "type": "You" }, "n": { "type": "EventAmount" } }
                    ],
                    "else": []
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "oracle_text": "The next time a source of your choice would deal damage to you and/or creatures you control this turn, prevent that damage. If damage from a black source is prevented this way, you gain that much life."
}
