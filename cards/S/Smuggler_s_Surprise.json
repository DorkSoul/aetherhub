{
  "name": "Smuggler's Surprise",
  "mana_cost": "{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Modal",
      "choose_min": 1,
      "choose_max": 3,
      "modes": [
        {
          "text": "Mill four cards. You may put up to two creature and/or land cards from among the milled cards into your hand.",
          "cost": [ { "type": "Mana", "cost": "{2}" } ],
          "effects": [
            { "type": "Mill", "who": { "type": "You" }, "n": { "type": "Fixed", "n": 4 } },
            { "type": "Choose", "who": { "type": "You" }, "zone": "Graveyard", "min": 0, "max": 2,
              "filter": { "among_remembered": true, "any_of": [ { "types": ["Creature"] }, { "types": ["Land"] } ] },
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand" } ] }
          ]
        },
        {
          "text": "You may put up to two creature cards from your hand onto the battlefield.",
          "cost": [ { "type": "Mana", "cost": "{4}{G}" } ],
          "effects": [
            { "type": "Choose", "who": { "type": "You" }, "zone": "Hand", "min": 0, "max": 2,
              "filter": { "types": ["Creature"] },
              "then": [ { "type": "Move", "what": { "type": "Remembered" }, "to": "Battlefield" } ] }
          ]
        },
        {
          "text": "Creatures you control with power 4 or greater gain hexproof and indestructible until end of turn.",
          "cost": [ { "type": "Mana", "cost": "{1}" } ],
          "effects": [
            { "type": "GrantStatic",
              "what": { "type": "All", "filter": { "types": ["Creature"], "controller": "You", "power": { "op": "Ge", "n": 4 } }, "zone": "Battlefield" },
              "effect": { "type": "GrantKeyword", "affects": {}, "keyword": "Hexproof" },
              "duration": "UntilEndOfTurn" },
            { "type": "GrantStatic",
              "what": { "type": "All", "filter": { "types": ["Creature"], "controller": "You", "power": { "op": "Ge", "n": 4 } }, "zone": "Battlefield" },
              "effect": { "type": "GrantKeyword", "affects": {}, "keyword": "Indestructible" },
              "duration": "UntilEndOfTurn" }
          ]
        }
      ]
    }
  ],
  "oracle_text": "Spree (Choose one or more additional costs.)\n+ {2} — Mill four cards. You may put up to two creature and/or land cards from among the milled cards into your hand.\n+ {4}{G} — You may put up to two creature cards from your hand onto the battlefield.\n+ {1} — Creatures you control with power 4 or greater gain hexproof and indestructible until end of turn."
}
