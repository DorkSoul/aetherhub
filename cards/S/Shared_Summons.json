{
  "name": "Shared Summons",
  "mana_cost": "{3}{G}{G}",
  "types": ["Instant"],
  "abilities": [
    {
      "type": "Spell",
      "effects": [
        {
          "type": "Choose",
          "who": { "type": "You" },
          "zone": "Library",
          "filter": { "types": ["Creature"] },
          "min": 0,
          "max": 2,
          "distinct": "Name",
          "then": [
            { "type": "Move", "what": { "type": "Remembered" }, "to": "Hand", "from": "Library" }
          ]
        },
        { "type": "Shuffle", "who": { "type": "You" } }
      ]
    }
  ],
  "oracle_text": "Search your library for up to two creature cards with different names, reveal them, put them into your hand, then shuffle."
}
